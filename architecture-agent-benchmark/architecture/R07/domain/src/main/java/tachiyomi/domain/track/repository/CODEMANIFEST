Imports:
  - Types:
      - Track
    From: domain/src/main/java/tachiyomi/domain/track/model

Annotations: |
  This cell is the storage port for tracker sync records, consumed by track-related
  interactors and implemented by data/track.

  Use `Track` from Imports throughout.

---

"TrackRepository()":
  location: TrackRepository.kt
  annotations: |
    Storage port for `Track` rows, keyed by row id or by owning manga id.
  methods:
    "getTrackById(id: Long) -> track:Track?": |
      Single track record by id, or null if it doesn't exist.
    "getTracksByMangaId(mangaId: Long) -> tracks:List<Track>": |
      All track records for one manga (at most one per tracker service).
    "getTracksAsFlow() -> tracks:Flow<List<Track>>": |
      Reactive stream of every track record across the whole library.
    "getTracksByMangaIdAsFlow(mangaId: Long) -> tracks:Flow<List<Track>>": |
      Reactive equivalent of getTracksByMangaId.
    "delete(mangaId: Long, trackerId: Long)": |
      Remove the track record, if any, linking `mangaId` to the tracker identified by
      `trackerId`.
    "insert(track: Track)": |
      Insert or replace one track record.
    "insertAll(tracks: List<Track>)": |
      Insert or replace many track records as a single unit of work.

---

Author: Goga
CreatedAt: 26/08/26
Description: |
  Storage port for the track aggregate. Implemented by data/track; consumed by track
  interactors and, indirectly, by the Tracker/BaseTracker extension point when it persists a
  remote sync result locally.
