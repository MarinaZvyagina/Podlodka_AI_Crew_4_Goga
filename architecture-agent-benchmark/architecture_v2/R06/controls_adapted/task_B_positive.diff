+// CheckAttachedLimit is a read-only pre-check for the configured
+// MaxAttachedKeys limit. It deliberately does not share Attach's error
+// contract: Attach must keep returning only ErrLeaseNotFound so that the
+// panic-on-error invariant at its call site in the storage layer's apply
+// path remains valid. Callers that want the limit enforced must call this
+// before the write reaches Attach.
+func (le *lessor) CheckAttachedLimit(id LeaseID, key string) error {
+	if le.maxAttachedKeys <= 0 {
+		return nil
+	}
+
+	le.mu.RLock()
+	l := le.leaseMap[id]
+	le.mu.RUnlock()
+	if l == nil {
+		// Lease existence is validated separately (see Lookup); nothing to
+		// enforce here if the lease is unknown.
+		return nil
+	}
+
+	item := LeaseItem{Key: key}
+	l.mu.RLock()
+	defer l.mu.RUnlock()
+	if _, attached := l.itemSet[item]; attached {
+		// Re-attaching a key already on the lease never increases the
+		// distinct key count, so it must never be rejected.
+		return nil
+	}
+	if len(l.itemSet) >= le.maxAttachedKeys {
+		return ErrTooManyAttachedKeys
+	}
+	return nil
+}
+
