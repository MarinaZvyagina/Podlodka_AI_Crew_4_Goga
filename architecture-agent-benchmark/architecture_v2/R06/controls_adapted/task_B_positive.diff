+// TestLessorCheckAttachedLimit ensures CheckAttachedLimit rejects a new key
+// once a lease is at the configured MaxAttachedKeys, allows re-attaching a
+// key already on the lease regardless of the limit, and never mutates lessor
+// state (Attach is unaffected and still only returns ErrLeaseNotFound).
+func TestLessorCheckAttachedLimit(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL, MaxAttachedKeys: 2})
+	defer le.Stop()
+	le.SetRangeDeleter(func() TxnDelete { return newFakeDeleter(be) })
+
+	l, err := le.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("could not grant lease (%v)", err)
+	}
+
+	// under the limit: attaching two distinct keys must be allowed.
+	if err := le.CheckAttachedLimit(l.ID, "foo"); err != nil {
+		t.Fatalf("expected nil, got %v", err)
+	}
+	if err := le.Attach(l.ID, []LeaseItem{{Key: "foo"}}); err != nil {
+		t.Fatalf("failed to attach: %v", err)
+	}
+	if err := le.CheckAttachedLimit(l.ID, "bar"); err != nil {
+		t.Fatalf("expected nil, got %v", err)
+	}
+	if err := le.Attach(l.ID, []LeaseItem{{Key: "bar"}}); err != nil {
+		t.Fatalf("failed to attach: %v", err)
+	}
+
+	// at the limit: re-attaching an existing key must still be allowed.
+	if err := le.CheckAttachedLimit(l.ID, "foo"); err != nil {
+		t.Fatalf("re-attaching an existing key must not be rejected, got %v", err)
+	}
+
+	// at the limit: a genuinely new key must be rejected.
+	if err := le.CheckAttachedLimit(l.ID, "baz"); !errors.Is(err, ErrTooManyAttachedKeys) {
+		t.Fatalf("expected ErrTooManyAttachedKeys, got %v", err)
+	}
+
+	// CheckAttachedLimit must never mutate lessor state.
+	l = le.Lookup(l.ID)
+	if len(l.itemSet) != 2 {
+		t.Fatalf("len(l.itemSet) = %d, want 2 (CheckAttachedLimit must not mutate state)", len(l.itemSet))
+	}
+
+	// unknown lease: CheckAttachedLimit is not the existence check (that's
+	// Lookup's job), so it must not error here.
+	if err := le.CheckAttachedLimit(999, "foo"); err != nil {
+		t.Fatalf("expected nil for unknown lease, got %v", err)
+	}
+
+	// Attach's error contract must remain untouched by the limit: it still
+	// only ever returns ErrLeaseNotFound, even past the limit. The limit is
+	// enforced solely via CheckAttachedLimit, one layer up.
+	if err := le.Attach(l.ID, []LeaseItem{{Key: "baz"}}); err != nil {
+		t.Fatalf("Attach must not enforce the limit itself, got %v", err)
+	}
+	if err := le.Attach(999, []LeaseItem{{Key: "qux"}}); !errors.Is(err, ErrLeaseNotFound) {
+		t.Fatalf("expected ErrLeaseNotFound, got %v", err)
+	}
+}
+
+// TestLessorCheckAttachedLimitUnlimited ensures a zero (default) MaxAttachedKeys
+// preserves current unlimited behavior.
+func TestLessorCheckAttachedLimitUnlimited(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL})
+	defer le.Stop()
+	le.SetRangeDeleter(func() TxnDelete { return newFakeDeleter(be) })
+
+	l, err := le.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("could not grant lease (%v)", err)
+	}
+
+	for i := 0; i < 1000; i++ {
+		key := fmt.Sprintf("key-%d", i)
+		if err := le.CheckAttachedLimit(l.ID, key); err != nil {
+			t.Fatalf("expected nil (unlimited), got %v", err)
+		}
+		if err := le.Attach(l.ID, []LeaseItem{{Key: key}}); err != nil {
+			t.Fatalf("failed to attach: %v", err)
+		}
+	}
+}
