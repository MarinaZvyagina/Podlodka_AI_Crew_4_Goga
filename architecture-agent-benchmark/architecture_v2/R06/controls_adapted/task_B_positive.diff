+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package txn
+
+import (
+	"errors"
+	"testing"
+
+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+// limitedLessor wraps lease.FakeLessor to let tests control the result of
+// CheckAttachedLimit independently of the (always-nil) FakeLessor default,
+// without needing a real backend-backed lessor.
+type limitedLessor struct {
+	lease.FakeLessor
+	checkErr        error
+	checkCalledWith []struct {
+		id  lease.LeaseID
+		key string
+	}
+}
+
+func (l *limitedLessor) CheckAttachedLimit(id lease.LeaseID, key string) error {
+	l.checkCalledWith = append(l.checkCalledWith, struct {
+		id  lease.LeaseID
+		key string
+	}{id, key})
+	return l.checkErr
+}
+
+// TestCheckLeaseAttachedKeysLimit verifies that the pre-apply lease-limit
+// check (a) is skipped when no lease is provided, (b) delegates to
+// lessor.CheckAttachedLimit for the request's key/lease otherwise, and (c)
+// propagates the resulting error unchanged, so that a violation is caught
+// before the write ever reaches mvcc.TxnWrite.Put (and therefore before
+// lease.Lessor.Attach).
+func TestCheckLeaseAttachedKeysLimit(t *testing.T) {
+	tcs := []struct {
+		name      string
+		p         *pb.PutRequest
+		checkErr  error
+		wantErr   error
+		wantCalls int
+	}{
+		{
+			name:      "no lease: limit check is skipped entirely",
+			p:         &pb.PutRequest{Key: []byte("foo"), Lease: int64(lease.NoLease)},
+			checkErr:  lease.ErrTooManyAttachedKeys,
+			wantErr:   nil,
+			wantCalls: 0,
+		},
+		{
+			name:      "under limit: no error propagated",
+			p:         &pb.PutRequest{Key: []byte("foo"), Lease: 1},
+			checkErr:  nil,
+			wantErr:   nil,
+			wantCalls: 1,
+		},
+		{
+			name:      "at limit: error propagated unchanged",
+			p:         &pb.PutRequest{Key: []byte("foo"), Lease: 1},
+			checkErr:  lease.ErrTooManyAttachedKeys,
+			wantErr:   lease.ErrTooManyAttachedKeys,
+			wantCalls: 1,
+		},
+	}
+
+	for _, tc := range tcs {
+		t.Run(tc.name, func(t *testing.T) {
+			ll := &limitedLessor{checkErr: tc.checkErr}
+			err := checkLeaseAttachedKeysLimit(ll, tc.p)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("checkLeaseAttachedKeysLimit() = %v, want %v", err, tc.wantErr)
+			}
+			if len(ll.checkCalledWith) != tc.wantCalls {
+				t.Fatalf("CheckAttachedLimit called %d times, want %d", len(ll.checkCalledWith), tc.wantCalls)
+			}
+			if tc.wantCalls > 0 {
+				got := ll.checkCalledWith[0]
+				if got.id != lease.LeaseID(tc.p.Lease) || got.key != string(tc.p.Key) {
+					t.Fatalf("CheckAttachedLimit called with (%v, %q), want (%v, %q)", got.id, got.key, lease.LeaseID(tc.p.Lease), string(tc.p.Key))
+				}
+			}
+		})
+	}
+}
+
+// TestPutRejectsOverLimitBeforeStorageLayer ensures Put() surfaces the
+// lease-limit error before ever calling into the storage layer's
+// TxnWrite.Put/Attach, i.e. checkLeaseAttachedKeysLimit runs as a pre-apply
+// validation step exactly like checkLease.
+func TestPutRejectsOverLimitBeforeStorageLayer(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { betesting.Close(t, b) })
+	ll := &limitedLessor{
+		FakeLessor: lease.FakeLessor{LeaseSet: map[lease.LeaseID]struct{}{1: {}}},
+		checkErr:   lease.ErrTooManyAttachedKeys,
+	}
+	kv := mvcc.NewStore(zaptest.NewLogger(t), b, ll, mvcc.StoreConfig{})
+	t.Cleanup(func() { kv.Close() })
+
+	p := &pb.PutRequest{Key: []byte("newkey"), Value: []byte("v"), Lease: 1}
+	resp, _, err := Put(t.Context(), zaptest.NewLogger(t), ll, kv, p)
+	if !errors.Is(err, lease.ErrTooManyAttachedKeys) {
+		t.Fatalf("Put() err = %v, want ErrTooManyAttachedKeys", err)
+	}
+	if resp != nil {
+		t.Fatalf("Put() resp = %v, want nil on rejection", resp)
+	}
+
+	// The key must not have been written: a later unrelated read confirms
+	// the rejected write had no partial effect.
+	rr, err := kv.Range(t.Context(), []byte("newkey"), nil, mvcc.RangeOptions{})
+	if err != nil {
+		t.Fatalf("unexpected error reading back: %v", err)
+	}
+	if len(rr.KVs) != 0 {
+		t.Fatalf("expected rejected put to not be applied, found %d KVs", len(rr.KVs))
+	}
+}
