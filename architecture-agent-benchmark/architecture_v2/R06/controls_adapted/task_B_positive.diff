+// TestV3LeaseAttachedKeysLimit exercises the configured maximum-number-of-
+// distinct-keys-per-lease limit end to end, through real client Put RPCs
+// against a running (embedded) cluster, i.e. through the full apply path
+// (pre-apply validation -> raft -> mvcc storage layer), not just a unit
+// test of the lease package in isolation.
+//
+// It asserts:
+//   - Puts attaching new keys up to the configured limit succeed.
+//   - A Put attaching one more *new* key past the limit fails with a clean,
+//     typed gRPC error (not a stream/connection failure, and not a crash).
+//   - A Put that re-attaches a key already on the lease (no increase in
+//     distinct key count) is never rejected, even though the lease is at
+//     the limit.
+//   - The server remains healthy afterward and continues to serve unrelated
+//     Put/Range requests normally.
+func TestV3LeaseAttachedKeysLimit(t *testing.T) {
+	integration.BeforeTest(t)
+
+	const limit = 3
+	clus := integration.NewCluster(t, &integration.ClusterConfig{
+		Size:                    1,
+		MaxAttachedKeysPerLease: limit,
+	})
+	defer clus.Terminate(t)
+
+	cli := clus.Client(0)
+	ctx := t.Context()
+
+	lresp, err := cli.Grant(ctx, 100)
+	require.NoError(t, err)
+	leaseID := lresp.ID
+
+	// Attach `limit` distinct new keys to the lease: must all succeed.
+	for i := 0; i < limit; i++ {
+		key := fmt.Sprintf("key-%d", i)
+		_, err := cli.Put(ctx, key, "v", clientv3.WithLease(leaseID))
+		require.NoErrorf(t, err, "put %d (under limit) should succeed", i)
+	}
+
+	// Re-attaching an already-attached key must never be rejected, even
+	// though the lease is now exactly at the limit.
+	_, err = cli.Put(ctx, "key-0", "v2", clientv3.WithLease(leaseID))
+	require.NoError(t, err, "re-attaching an already-attached key must not be rejected")
+
+	// A Put attaching a brand-new key past the limit must fail with a
+	// clean, typed gRPC error - not a stream/connection failure, and it
+	// must not silently succeed or partially apply. Assert the specific
+	// error, not just "any error", to rule out the request instead failing
+	// because the connection/stream broke (e.g. the server crashing).
+	_, err = cli.Put(ctx, "key-new", "v", clientv3.WithLease(leaseID))
+	require.Error(t, err, "put of a new key past the limit must fail")
+	require.Truef(t, errors.Is(err, rpctypes.ErrTooManyAttachedKeys),
+		"expected a clean rpctypes.ErrTooManyAttachedKeys, got: %v", err)
+	// clientv3 translates gRPC status errors into the rpctypes.EtcdError
+	// sentinel type (see client/v3/client.go's use of rpctypes.Error); a
+	// stream/connection failure would surface as a raw gRPC status error
+	// that is *not* found in the rpctypes catalogue and would therefore not
+	// satisfy the errors.Is check above.
+	etcdErr, ok := err.(rpctypes.EtcdError)
+	require.True(t, ok, "expected a cataloged rpctypes.EtcdError, not a raw connection/stream failure: %T", err)
+	require.Equal(t, codes.ResourceExhausted, etcdErr.Code())
+
+	getResp, getErr := cli.Get(ctx, "key-new")
+	require.NoError(t, getErr, "server must still be responsive after the rejection")
+	require.Empty(t, getResp.Kvs, "rejected put must not have been (partially) applied")
+
+	// The server must remain healthy and keep serving unrelated requests
+	// normally: no crash, no hang, no corrupted state.
+	putCtx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	_, err = cli.Put(putCtx, "unrelated-key", "unrelated-value")
+	require.NoError(t, err, "server must remain healthy and serve unrelated Puts after the rejection")
+
+	getResp, err = cli.Get(ctx, "unrelated-key")
+	require.NoError(t, err)
+	require.Len(t, getResp.Kvs, 1)
+	require.Equal(t, "unrelated-value", string(getResp.Kvs[0].Value))
+
+	// A lease under the limit is unaffected: grant a second lease and
+	// confirm normal attach behavior (below the limit) still works.
+	lresp2, err := cli.Grant(ctx, 100)
+	require.NoError(t, err)
+	for i := 0; i < limit-1; i++ {
+		key := fmt.Sprintf("lease2-key-%d", i)
+		_, err := cli.Put(ctx, key, "v", clientv3.WithLease(lresp2.ID))
+		require.NoErrorf(t, err, "put %d on a lease under the limit should succeed", i)
+	}
+}
