+def _validate_capital_settings(conf: dict[str, Any]) -> None:
+    """
+    `available_capital` and `tradable_balance_ratio` cannot be used together -
+    only one of them is used to determine the starting capital, and the other is
+    silently ignored.
+    :raise: ConfigurationError if config validation failed
+    """
+    if "available_capital" in conf and "tradable_balance_ratio" in conf:
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in the "
+            "configuration. Only one of these settings is used to determine the "
+            "starting capital - `available_capital` takes precedence and "
+            "`tradable_balance_ratio` will be ignored. Please remove one of these settings."
+        )
+
