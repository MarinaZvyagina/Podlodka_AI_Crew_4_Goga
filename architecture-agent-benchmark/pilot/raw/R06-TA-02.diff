index fae3716..f867d28 100644
--- a/server/auth/store_test.go
+++ b/server/auth/store_test.go
@@ -1140,6 +1140,49 @@ func TestUserNoPasswordAdd(t *testing.T) {
 	require.ErrorIsf(t, err, ErrAuthFailed, "expected %v, got %v", ErrAuthFailed, err)
 }
 
+func TestUserAddWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// a blank plaintext password, no NoPassword opt-in
+	ua := &pb.AuthUserAddRequest{Name: "emptypass1", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// an explicit hash of the empty string, no NoPassword opt-in
+	ua = &pb.AuthUserAddRequest{Name: "emptypass2", HashedPassword: encodePassword(""), Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err = as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// old-log style plaintext blank password
+	ua = &pb.AuthUserAddRequest{Name: "emptypass3", Password: "", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err = as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+}
+
+func TestUserChangePasswordWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// existing user "foo" has a real password; changing it to blank must be rejected
+	_, err := as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo"})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo", HashedPassword: encodePassword("")})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a passwordless account must keep working with a blank password change
+	ua := &pb.AuthUserAddRequest{Name: "nopass", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "nopass"})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
