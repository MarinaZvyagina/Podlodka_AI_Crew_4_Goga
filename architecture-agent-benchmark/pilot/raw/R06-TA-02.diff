+// isPasswordEmpty reports whether the given (already hashed) password
+// represents a blank password, either because no password bytes were
+// provided at all, or because the hash is a bcrypt hash of the empty string.
+func isPasswordEmpty(hashedPassword []byte) bool {
+	if len(hashedPassword) == 0 {
+		return true
+	}
+	return bcrypt.CompareHashAndPassword(hashedPassword, []byte("")) == nil
+}
