+def _validate_capital_conflict(conf: dict[str, Any]) -> None:
+    """
+    available_capital and tradable_balance_ratio both control starting capital.
+    Only one of them is ever applied - warn eagerly instead of silently ignoring one.
+    """
+    raw_conf = conf.get("original_config", conf)
+    if "available_capital" in raw_conf and "tradable_balance_ratio" in raw_conf:
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in the "
+            "configuration. Only one of these settings is used to determine your starting "
+            "capital - the other will be silently ignored. Please remove one of these settings."
+        )
+
