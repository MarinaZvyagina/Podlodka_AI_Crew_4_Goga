+def test_validate_capital_conflict(default_conf):
+    conf = deepcopy(default_conf)
+    conf["available_capital"] = 1000
+    # `original_config` mirrors what the user actually put in their config file(s)/env.
+    conf["original_config"] = {
+        "available_capital": 1000,
+        "tradable_balance_ratio": conf["tradable_balance_ratio"],
+    }
+    with pytest.raises(
+        OperationalException,
+        match=r".*Both `available_capital` and `tradable_balance_ratio`.*",
+    ):
+        validate_config_consistency(conf)
+
+    del conf["original_config"]["tradable_balance_ratio"]
+    # Only available_capital was explicitly set by the user - passes.
+    validate_config_consistency(conf)
+
+
+def test_validate_capital_conflict_ignores_schema_default(default_conf):
+    # tradable_balance_ratio can end up in `conf` via the schema-validation default (0.99) from
+    # an earlier validation pass (e.g. during backtesting/hyperopt config setup) even though the
+    # user never set it. The check must rely on the raw user-provided config (`original_config`),
+    # not the post-default `conf`, or it would misfire for every available_capital-only user.
+    conf = deepcopy(default_conf)
+    conf["available_capital"] = 1000
+    conf["original_config"] = {"available_capital": 1000}
+    # conf["tradable_balance_ratio"] is still present (fixture default), standing in for a
+    # schema-injected default from an earlier validation pass.
+    assert "tradable_balance_ratio" in conf
+
+    validate_config_consistency(conf)
+
+
