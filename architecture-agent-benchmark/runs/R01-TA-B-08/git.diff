+    # Both explicitly set - should raise
+    conf = deepcopy(default_conf)
+    conf["available_capital"] = 1000
+    conf["tradable_balance_ratio"] = 0.5
+    with pytest.raises(
+        OperationalException,
+        match=r"Both `available_capital` and `tradable_balance_ratio` are set.*",
+    ):
