+++ b/tests/test_configuration.py
@@ -1072,6 +1072,24 @@ def test_validate_edge_removal(default_conf):
         validate_config_consistency(default_conf)
 
 
+def test_validate_capital_settings(default_conf):
+    # default_conf only sets tradable_balance_ratio - should pass.
+    validate_config_consistency(default_conf)
+
+    conf = deepcopy(default_conf)
+    del conf["tradable_balance_ratio"]
+    conf["available_capital"] = 1000
+    # available_capital alone - should pass.
+    validate_config_consistency(conf)
+
+    conf["tradable_balance_ratio"] = 0.99
+    with pytest.raises(
+        ConfigurationError,
+        match=r"Both `available_capital` and `tradable_balance_ratio` are set in the config\.",
+    ):
+        validate_config_consistency(conf)
+
+
