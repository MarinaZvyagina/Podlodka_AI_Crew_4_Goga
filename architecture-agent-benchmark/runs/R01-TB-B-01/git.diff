+    def _get_underlying_currency(self, pair: str) -> str:
+        """
+        Return the currency exposure to `pair` should be grouped under for
+        concentration-risk purposes - the pair's quote (settlement) currency.
+        """
+        return self._exchange.get_pair_quote_currency(pair)
+
+    def get_currency_exposure(self, currency: str, exclude_pair: str | None = None) -> float:
+        """
+        Sum of stake_amount currently committed to open trades whose pair shares the
+        given underlying currency.
+        :param currency: Underlying (quote) currency to sum exposure for.
+        :param exclude_pair: Pair to exclude from the sum - used to avoid double-counting
+        the trade currently being sized/adjusted.
+        """
+        return sum(
+            trade.stake_amount
+            for trade in Trade.get_trades_proxy(is_open=True)
+            if trade.pair != exclude_pair and self._get_underlying_currency(trade.pair) == currency
+        )
+
+    def _max_stake_for_currency_exposure(
+        self, pair: str, trade_amount: float | None
+    ) -> float | None:
+        """
+        Determine the highest stake amount `pair` may use without pushing the combined
+        exposure to its underlying currency above `max_currency_exposure`.
+        :return: None if the limit is disabled (not configured, or >= 1), else the
+        maximum stake amount allowed by the limit.
+        """
+        ratio = self._config.get("max_currency_exposure", 1.0)
+        if not ratio or ratio >= 1:
+            return None
+        currency = self._get_underlying_currency(pair)
+        currency_cap = ratio * self.get_total_stake_amount()
+        other_exposure = self.get_currency_exposure(currency, exclude_pair=pair)
+        return max(0.0, currency_cap - other_exposure - (trade_amount or 0))
+
