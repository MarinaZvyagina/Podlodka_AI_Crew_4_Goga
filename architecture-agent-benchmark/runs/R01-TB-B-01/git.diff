+def test_backtest__enter_trade_currency_exposure(default_conf, fee, mocker) -> None:
+    """
+    Backtesting must reduce the entry stake amount the same way live/dry-run does
+    (via the shared `Wallets.validate_stake_amount`) once combined exposure to a
+    pair's underlying currency would exceed `max_currency_exposure`.
+    """
+    mocker.patch(f"{EXMS}.get_fee", fee)
+    mocker.patch(f"{EXMS}.get_min_pair_stake_amount", return_value=0.00001)
+    mocker.patch(f"{EXMS}.get_max_pair_stake_amount", return_value=float("inf"))
+    patch_exchange(mocker)
+    default_conf["stake_amount"] = 300
+    default_conf["max_open_trades"] = 2
+    # No trades open yet - total tradable capital is 1000 (dry_run_wallet) * 0.99 = 990.
+    default_conf["max_currency_exposure"] = 0.3
+    backtesting = Backtesting(default_conf)
+    backtesting._set_strategy(backtesting.strategylist[0])
+    pair = "UNITTEST/BTC"
+    row = [
+        pd.Timestamp(year=2020, month=1, day=1, hour=5, minute=0),
+        1,  # Buy
+        0.001,  # Open
+        0.0011,  # Close
+        0,  # Sell
+        0.00099,  # Low
+        0.0012,  # High
+        "",  # Buy Signal Name
+    ]
+    trade = backtesting._enter_trade(pair, row=row, direction="long")
+    assert isinstance(trade, LocalTrade)
+    # Capped to 30% of 990 (297), matching what the live/dry-run path computes for the
+    # exact same config in test_execute_entry_respects_currency_exposure (test_wallets.py).
+    assert trade.stake_amount == 297.0
+    LocalTrade.bt_trades_open.pop()
