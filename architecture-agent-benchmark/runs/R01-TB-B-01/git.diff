+@pytest.mark.usefixtures("init_persistence")
+@pytest.mark.parametrize("use_db", [True, False])
+def test_get_currency_exposure(mocker, default_conf, fee, use_db):
+    Trade.use_db = use_db
+    Trade.reset_trades()
+
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    assert freqtrade.wallets.get_currency_exposure("BTC") == 0
+
+    create_mock_trades(fee, use_db=use_db)
+    # Open trades are ETH/BTC, ETC/BTC, XRP/BTC and LTC/BTC - all quoted in BTC.
+    assert pytest.approx(freqtrade.wallets.get_currency_exposure("BTC")) == 0.004
+    assert freqtrade.wallets.get_currency_exposure("USDT") == 0
+    # Excluding one of the open pairs removes its stake from the sum.
+    assert pytest.approx(freqtrade.wallets.get_currency_exposure("BTC", "ETH/BTC")) == 0.003
+
+    Trade.use_db = True
+
+
+@pytest.mark.parametrize(
+    "max_currency_exposure,total_stake,other_exposure,trade_amount,expected",
+    [
+        (1.0, 100, 40, None, None),  # Limit disabled (default) - no cap applied.
+        (0.5, 100, 0, None, 50),  # Nothing else open yet - half of total stake available.
+        (0.5, 100, 40, None, 10),  # 40 already committed to this currency elsewhere.
+        (0.5, 100, 60, None, 0),  # Already over the cap - no room left.
+        (0.5, 100, 30, 10, 10),  # Existing stake on this trade is added back.
+    ],
+)
+def test_max_stake_for_currency_exposure(
+    mocker,
+    default_conf,
+    max_currency_exposure,
+    total_stake,
+    other_exposure,
+    trade_amount,
+    expected,
+):
+    default_conf["max_currency_exposure"] = max_currency_exposure
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=total_stake)
+    mocker.patch("freqtrade.wallets.Wallets.get_currency_exposure", return_value=other_exposure)
+
+    result = freqtrade.wallets._max_stake_for_currency_exposure("ETH/BTC", trade_amount)
+    assert result == expected
+
+
+def test_validate_stake_amount_currency_exposure(mocker, default_conf, caplog):
+    default_conf["max_currency_exposure"] = 0.5
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=1000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=100)
+    # 40 already committed to BTC via other open trades - only 10 of stake left for BTC.
+    mocker.patch("freqtrade.wallets.Wallets.get_currency_exposure", return_value=40)
+
+    res = freqtrade.wallets.validate_stake_amount("ETH/BTC", 20, 1, 10000, None)
+    assert res == 10
+    assert log_has_re(r".*Limited by max_currency_exposure for BTC\.", caplog)
+
