     assert res == expected
 
 
+@pytest.mark.parametrize(
+    "max_currency_exposure,existing_exposure,stake_amount,trade_amount,expected",
+    [
+        (None, 0, 100, None, 100),  # Disabled - no cap applied.
+        (0.5, 0, 100, None, 100),  # Well within the cap.
+        (0.5, 400, 200, None, 100),  # Exceeds cap - reduced to fit (total_stake=1000).
+        (0.5, 500, 200, None, 0),  # No headroom left at all.
+        (0.2, 150, 100, None, 50),  # Reduced to fit a tighter cap.
+        # Position adjustment: existing_exposure already includes this trade's own stake.
+        (0.5, 450, 100, 50, 50),
+    ],
+)
+def test_validate_stake_amount_max_currency_exposure(
+    mocker,
+    default_conf,
+    max_currency_exposure,
+    existing_exposure,
+    stake_amount,
+    trade_amount,
+    expected,
+):
+    if max_currency_exposure is not None:
+        default_conf["max_currency_exposure"] = max_currency_exposure
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=10000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+    mocker.patch(
+        "freqtrade.wallets.Wallets._get_currency_exposure", return_value=existing_exposure
+    )
+
+    res = freqtrade.wallets.validate_stake_amount(
+        "XRP/USDT", stake_amount, None, 10000, trade_amount
+    )
+    assert res == expected
+
+
+def test_get_currency_exposure(mocker, default_conf, fee):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    create_mock_trades_usdt(fee)
+
+    mocker.patch(
+        f"{EXMS}.get_pair_quote_currency",
+        side_effect=lambda pair: pair.split("/")[1].split(":")[0],
+    )
+
+    open_pairs = {t.pair for t in Trade.get_open_trades()}
+    expected = sum(t.stake_amount for t in Trade.get_open_trades())
+
+    for pair in open_pairs:
+        assert freqtrade.wallets._get_currency_exposure(pair) == expected
+
+    assert freqtrade.wallets._get_currency_exposure("BTC/BUSD") == 0
+
