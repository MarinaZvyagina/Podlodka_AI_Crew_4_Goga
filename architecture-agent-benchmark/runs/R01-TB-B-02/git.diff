+    def _get_currency_exposure(self, pair: str) -> float:
+        """
+        Sum of stake_amount currently committed to open trades that share the same
+        underlying (quote) currency as `pair`. For an already-open trade (position
+        adjustment), this includes that trade's own currently committed stake.
+        """
+        currency = self._exchange.get_pair_quote_currency(pair)
+        return sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if self._exchange.get_pair_quote_currency(trade.pair) == currency
+        )
+
+    def _get_max_currency_exposure_stake(self, pair: str, max_allowed_stake: float) -> float:
+        """
+        Limit max_allowed_stake so that adding stake_amount for `pair` cannot push the combined
+        exposure to its underlying (quote) currency above `max_currency_exposure`.
+        """
+        max_currency_exposure = self._config.get("max_currency_exposure")
+        if not max_currency_exposure:
+            return max_allowed_stake
+
+        currency = self._exchange.get_pair_quote_currency(pair)
+        max_currency_stake = self.get_total_stake_amount() * max_currency_exposure
+        currency_headroom = max(max_currency_stake - self._get_currency_exposure(pair), 0)
+
+        if currency_headroom < max_allowed_stake:
+            self._local_log(
+                f"Stake amount for pair {pair} is capped by max_currency_exposure "
+                f"({max_currency_exposure:.1%} of tradable capital already committed to "
+                f"{currency}), adjusting max stake to {currency_headroom}."
+            )
+            return currency_headroom
+        return max_allowed_stake
+
