+@pytest.mark.parametrize(
+    "max_currency_exposure,total_stake,committed,stake_amount,trade_amount,expected",
+    [
+        # Disabled (default) - no additional cap applied.
+        (1.0, 1000, 900, 500, None, 500),
+        # 50% of 1000 = 500 max for USDT. 300 already committed -> 200 of headroom.
+        (0.5, 1000, 300, 500, None, 200),
+        # Requested stake already fits under the remaining headroom.
+        (0.5, 1000, 300, 100, None, 100),
+        # No headroom left at all -> trade skipped (below min-stake floor).
+        (0.5, 1000, 500, 100, None, 0),
+        # Position-adjustment: trade_amount is already part of `committed`, incremental
+        # stake is capped to the remaining headroom for the currency.
+        (0.5, 1000, 400, 300, 200, 100),
+    ],
+)
+def test_validate_stake_amount_currency_exposure(
+    mocker,
+    default_conf,
+    max_currency_exposure,
+    total_stake,
+    committed,
+    stake_amount,
+    trade_amount,
+    expected,
+):
+    default_conf["max_currency_exposure"] = max_currency_exposure
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=10000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=total_stake)
+    mocker.patch(
+        "freqtrade.persistence.models.Trade.total_open_trades_stakes_for_currency",
+        return_value=committed,
+    )
+    res = freqtrade.wallets.validate_stake_amount(
+        "XRP/USDT", stake_amount, 11, 10000, trade_amount
+    )
+    assert res == expected
+
