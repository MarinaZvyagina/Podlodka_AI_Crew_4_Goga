@@ -218,6 +218,49 @@ def test_validate_stake_amount(
     assert res == expected
 
 
+@pytest.mark.parametrize(
+    "max_underlying_currency_exposure,open_trades,pair,trade_amount,expected",
+    [
+        # No limit configured - unaffected by open USDT exposure.
+        (None, [("ETH/USDT", 300)], "XRP/USDT", None, 500),
+        # Limit configured, but headroom is large enough - not binding.
+        (0.7, [("ETH/USDT", 100)], "XRP/USDT", None, 500),
+        # Limit binding - stake is resized down to the remaining headroom.
+        (0.3, [("ETH/USDT", 250)], "XRP/USDT", None, 50),
+        # Headroom fully consumed by other open trades in the same currency - skip trade.
+        (0.3, [("ETH/USDT", 300)], "XRP/USDT", None, 0),
+        # Open trade uses a different underlying currency - does not count towards the limit.
+        (0.3, [("ETH/BTC", 300)], "XRP/USDT", None, 300),
+        # Position adjustment - the trade's own stake must be excluded from the exposure sum.
+        (0.3, [("XRP/USDT", 200)], "XRP/USDT", 200, 300),
+    ],
+)
+def test_validate_stake_amount_max_underlying_currency_exposure(
+    mocker,
+    default_conf,
+    max_underlying_currency_exposure,
+    open_trades,
+    pair,
+    trade_amount,
+    expected,
+) -> None:
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    if max_underlying_currency_exposure is not None:
+        freqtrade.config["max_underlying_currency_exposure"] = max_underlying_currency_exposure
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=1000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+    mocker.patch(
+        "freqtrade.persistence.Trade.get_open_trades",
+        return_value=[
+            MagicMock(pair=trade_pair, stake_amount=stake) for trade_pair, stake in open_trades
+        ],
+    )
+
+    res = freqtrade.wallets.validate_stake_amount(pair, 500, 10, 10000, trade_amount)
+    assert res == expected
+
