+    def _get_underlying_currency_exposure(
+        self, pair: str, exclude_amount: float | None = None
+    ) -> tuple[str, float]:
+        """
+        Calculate the stake amount currently committed to open trades that share the same
+        underlying (quote / settlement) currency as `pair`.
+        :param pair: Pair to determine the underlying currency for.
+        :param exclude_amount: Stake amount to subtract from the total - used to avoid
+            double-counting the trade currently being sized when adjusting an existing position.
+        :return: Tuple of (underlying currency, currently committed stake amount)
+        """
+        currency = self._exchange.get_pair_quote_currency(pair)
+        exposure = sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if self._exchange.get_pair_quote_currency(trade.pair) == currency
+        )
+        if exclude_amount:
+            exposure -= exclude_amount
+        return currency, exposure
+
