+def test_strategy_override_max_single_currency_exposure(caplog, default_conf):
+    caplog.set_level(logging.INFO)
+    default_conf.update({"strategy": CURRENT_TEST_STRATEGY, "max_single_currency_exposure": 0.3})
+    strategy = StrategyResolver.load_strategy(default_conf)
+
+    assert strategy.max_single_currency_exposure == 0.3
+    assert log_has(
+        "Override strategy 'max_single_currency_exposure' with value from the configuration: 0.3.",
+        caplog,
+    )
+
+
+def test_strategy_max_single_currency_exposure_default_disabled(default_conf):
+    default_conf.update({"strategy": CURRENT_TEST_STRATEGY})
+    strategy = StrategyResolver.load_strategy(default_conf)
+
+    assert strategy.max_single_currency_exposure is None
+
+
+@pytest.mark.parametrize("value", [0, -0.1, 1.1])
+def test_strategy_max_single_currency_exposure_invalid(default_conf, value):
+    default_conf.update({"strategy": CURRENT_TEST_STRATEGY, "max_single_currency_exposure": value})
+    with pytest.raises(OperationalException, match=r".*max_single_currency_exposure.*"):
+        StrategyResolver.load_strategy(default_conf)
+
