+@pytest.mark.parametrize(
+    "stake_amount,min_stake,total_stake,open_currency_stake,max_exposure,expected,log_msg",
+    [
+        # No existing exposure - stake amount unaffected.
+        (100, 10, 1000, 0, 0.3, 100, None),
+        # Existing exposure + stake would exceed the cap -> resized down.
+        (200, 10, 1000, 250, 0.3, 50, r".*would push combined exposure.*"),
+        # Resized amount would fall below the exchange minimum -> trade skipped.
+        (200, 60, 1000, 280, 0.3, 0, r".*below the exchange minimum.*"),
+        # Exposure to the currency is already at the cap -> trade skipped.
+        (100, 10, 1000, 300, 0.3, 0, r".*below the exchange minimum.*"),
+        # No cap configured -> behaves exactly as without the feature.
+        (100, 10, 1000, 900, None, 100, None),
+    ],
+)
+def test_validate_stake_amount_currency_exposure(
+    mocker,
+    default_conf,
+    caplog,
+    stake_amount,
+    min_stake,
+    total_stake,
+    open_currency_stake,
+    max_exposure,
+    expected,
+    log_msg,
+):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    mocker.patch.multiple(EXMS, get_pair_base_currency=MagicMock(return_value="BTC"))
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=10000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=total_stake)
+    mocker.patch(
+        "freqtrade.wallets.Wallets._get_currency_open_stake",
+        return_value=open_currency_stake,
+    )
+    res = freqtrade.wallets.validate_stake_amount(
+        "BTC/USDT",
+        stake_amount,
+        min_stake,
+        10000,
+        None,
+        max_single_currency_exposure=max_exposure,
+    )
+    assert res == expected
+    if log_msg:
+        assert log_has_re(log_msg, caplog)
+
+
+def test_get_currency_open_stake(mocker, default_conf, fee):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    create_mock_trades_usdt(fee)
+
+    open_trades = Trade.get_trades_proxy(is_open=True)
+    btc_pairs = [t for t in open_trades if t.safe_base_currency == "BTC"]
+    expected = sum(t.stake_amount for t in btc_pairs)
+
+    assert freqtrade.wallets._get_currency_open_stake("BTC") == expected
+    assert freqtrade.wallets._get_currency_open_stake("NONEXISTENT") == 0
+
