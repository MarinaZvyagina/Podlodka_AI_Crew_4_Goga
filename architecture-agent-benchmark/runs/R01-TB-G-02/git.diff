diff --git a/tests/test_wallets.py b/tests/test_wallets.py
index 9c0c018..8f6629d 100644
--- a/tests/test_wallets.py
+++ b/tests/test_wallets.py
@@ -218,6 +218,65 @@ def test_validate_stake_amount(
     assert res == expected
 
 
+@pytest.mark.parametrize(
+    "max_currency_exposure,total_stake,current_currency_stake,stake_amount,min_stake,expected,logmsg",
+    [
+        # No cap configured - behaves exactly like before.
+        (None, 1000, 480, 100, 10, 100, None),
+        # Headroom (20) below requested stake (100) - resize down to headroom.
+        (0.5, 1000, 480, 100, 10, 20, r".*limited by the maximum USDT exposure"),
+        # Headroom (400) above requested stake (100) - untouched, no log.
+        (0.5, 1000, 100, 100, 10, 100, None),
+        # No headroom left at all - trade is skipped (below min-stake).
+        (0.5, 1000, 500, 100, 10, 0, r".*limited by the maximum USDT exposure"),
+        # Currency exposure already above cap - trade is skipped, no negative stake.
+        (0.5, 1000, 600, 100, 10, 0, r".*limited by the maximum USDT exposure"),
+    ],
+)
+def test_validate_stake_amount_max_currency_exposure(
+    mocker,
+    default_conf_usdt,
+    caplog,
+    max_currency_exposure,
+    total_stake,
+    current_currency_stake,
+    stake_amount,
+    min_stake,
+    expected,
+    logmsg,
+):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf_usdt)
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=100000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=total_stake)
+    mocker.patch(
+        "freqtrade.wallets.Wallets.get_currency_stake_amount",
+        return_value=current_currency_stake,
+    )
+    res = freqtrade.wallets.validate_stake_amount(
+        "XRP/USDT",
+        stake_amount,
+        min_stake,
+        10000,
+        None,
+        max_currency_exposure=max_currency_exposure,
+    )
+    assert res == expected
+    if logmsg:
+        assert log_has_re(logmsg, caplog)
+    else:
+        assert not log_has_re(r".*limited by the maximum", caplog)
+
+
+def test_get_currency_stake_amount(mocker, default_conf_usdt, fee):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf_usdt)
+    create_mock_trades_usdt(fee)
+
+    # 4 open trades of 20.0 USDT each - see conftest_trades_usdt.py
+    assert freqtrade.wallets.get_currency_stake_amount("USDT") == 80.0
+    assert freqtrade.wallets.get_currency_stake_amount("BTC") == 0.0
+
+
