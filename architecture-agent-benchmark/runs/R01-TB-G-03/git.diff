+def test_backtest__enter_trade_currency_exposure(default_conf, fee, mocker) -> None:
+    default_conf["use_exit_signal"] = False
+    mocker.patch(f"{EXMS}.get_fee", fee)
+    mocker.patch(f"{EXMS}.get_min_pair_stake_amount", return_value=0.00001)
+    mocker.patch(f"{EXMS}.get_max_pair_stake_amount", return_value=float("inf"))
+    patch_exchange(mocker)
+    default_conf["max_open_trades"] = 2
+    default_conf["max_currency_exposure"] = 0.3
+    backtesting = Backtesting(default_conf)
+    backtesting._set_strategy(backtesting.strategylist[0])
+    backtesting.strategy.custom_stake_amount = lambda **kwargs: 100
+    pair = "UNITTEST/BTC"
+    row = [
+        pd.Timestamp(year=2020, month=1, day=1, hour=5, minute=0),
+        1,  # Buy
+        0.001,  # Open
+        0.0011,  # Close
+        0,  # Sell
+        0.00099,  # Low
+        0.0012,  # High
+        "",  # Buy Signal Name
+    ]
+    total_stake = backtesting.wallets.get_total_stake_amount()
+    max_currency_stake = total_stake * 0.3
+
+    # An already-open trade for the same underlying (base) currency eats into the
+    # allowance for any further trade in that currency.
+    existing_stake = 250.0
+    existing_trade = LocalTrade(
+        pair=pair,
+        base_currency="UNITTEST",
+        stake_currency="BTC",
+        open_rate=0.001,
+        open_date=row[0],
+        stake_amount=existing_stake,
+        amount=existing_stake / 0.001,
+        fee_open=fee.return_value,
+        fee_close=fee.return_value,
+        is_open=True,
+        exchange="binance",
+    )
+    LocalTrade.bt_trades_open.append(existing_trade)
+    backtesting.wallets.update()
+
+    trade = backtesting._enter_trade(pair, row=row, direction="long")
+    assert trade is not None
+    assert trade.stake_amount == pytest.approx(max_currency_stake - existing_stake)
+    LocalTrade.bt_trades_open.pop()  # Remove the newly-entered trade
+
+    LocalTrade.bt_trades_open.pop()  # Remove the pre-existing trade
+
+    # Without the pre-existing trade eating into the allowance, the full requested
+    # stake fits under the cap.
+    backtesting.wallets.update()
+    trade = backtesting._enter_trade(pair, row=row, direction="long")
+    assert trade is not None
+    assert trade.stake_amount == 100
+
