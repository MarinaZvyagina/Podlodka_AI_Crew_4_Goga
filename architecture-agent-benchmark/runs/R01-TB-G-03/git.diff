+    def _get_max_stake_for_currency_exposure(self, pair: str) -> float | None:
+        """
+        Determine how much additional stake may be committed to trades sharing this pair's
+        underlying (base) currency, without breaching the configured `max_currency_exposure`.
+        :param pair: Pair to check.
+        :return: None if no (meaningful) cap is configured, otherwise the maximum additional
+        stake amount that may be committed to this currency across all open trades.
+        """
+        max_exposure_ratio = self._config.get("max_currency_exposure", 1.0)
+        if not max_exposure_ratio or max_exposure_ratio >= 1.0:
+            # Disabled, or a ratio of 100%+ can never be more restrictive than the
+            # existing overall stake-amount limits.
+            return None
+
+        # Fall back to parsing the pair, mirroring Trade.safe_base_currency, so pairs missing
+        # from the exchange's market metadata still group correctly with existing open trades.
+        currency = self._exchange.get_pair_base_currency(pair) or pair.split("/")[0]
+        max_currency_stake = self.get_total_stake_amount() * max_exposure_ratio
+        current_exposure = sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if trade.safe_base_currency == currency
+        )
+        return max(max_currency_stake - current_exposure, 0)
+
