index 9c0c018..af49675 100644
--- a/tests/test_wallets.py
+++ b/tests/test_wallets.py
@@ -218,6 +218,57 @@ def test_validate_stake_amount(
     assert res == expected
 
 
+@pytest.mark.parametrize(
+    "max_currency_exposure,total_stake,existing_exposure,expected",
+    [
+        (None, 1000, 0, None),  # Not configured - disabled.
+        (1.0, 1000, 0, None),  # 100% - equivalent to disabled.
+        (0.3, 1000, 0, 300),  # No existing exposure - full share available.
+        (0.3, 1000, 250, 50),  # Existing exposure reduces the remaining share.
+        (0.3, 1000, 400, 0),  # Existing exposure already exceeds the cap.
+    ],
+)
+def test_get_max_stake_for_currency_exposure(
+    mocker, default_conf, max_currency_exposure, total_stake, existing_exposure, expected
+):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    if max_currency_exposure is not None:
+        freqtrade.config["max_currency_exposure"] = max_currency_exposure
+
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=total_stake)
+    open_trade = MagicMock(safe_base_currency="ETH", stake_amount=existing_exposure)
+    other_currency_trade = MagicMock(safe_base_currency="BTC", stake_amount=99999)
+    mocker.patch(
+        "freqtrade.wallets.Trade.get_open_trades",
+        return_value=[open_trade, other_currency_trade],
+    )
+
+    res = freqtrade.wallets._get_max_stake_for_currency_exposure("ETH/USDT")
+    assert res == expected
+
+
+def test_validate_stake_amount_currency_exposure(mocker, default_conf):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    freqtrade.config["max_currency_exposure"] = 0.3
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=10000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+    open_trade = MagicMock(safe_base_currency="ETH", stake_amount=250)
+    mocker.patch("freqtrade.wallets.Trade.get_open_trades", return_value=[open_trade])
+
+    # Exposure limit (300 - 250 = 50) is more restrictive than max_stake_amount / availability.
+    res = freqtrade.wallets.validate_stake_amount("ETH/USDT", 100, 10, 10000, None)
+    assert res == 50
+
+    # A pair with a different underlying currency is unaffected by ETH's exposure.
+    res = freqtrade.wallets.validate_stake_amount("XRP/USDT", 100, 10, 10000, None)
+    assert res == 100
+
+    # If the exposure headroom is below min-stake, the trade is skipped entirely.
+    res = freqtrade.wallets.validate_stake_amount("ETH/USDT", 100, 60, 10000, None)
+    assert res == 0
+
+
