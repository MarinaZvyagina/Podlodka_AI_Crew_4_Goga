@@ -346,6 +346,42 @@ class Wallets:
         free = self.get_free(self._stake_currency)
         return min(self.get_total_stake_amount() - Trade.total_open_trades_stakes(), free)
 
+    def get_underlying_currency_exposure(self, pair: str) -> float:
+        """
+        Sum of stake_amount currently committed to all open trades that share
+        `pair`'s underlying (settlement/quote) currency.
+        """
+        currency = self._exchange.get_pair_underlying_currency(pair)
+        return sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if self._exchange.get_pair_underlying_currency(trade.pair) == currency
+        )
+
+    def get_available_stake_amount_for_underlying_currency(self, pair: str) -> float:
+        """
+        Return the maximum additional stake amount that can be committed to `pair`
+        without pushing the combined exposure to its underlying currency above the
+        strategy-configured `max_underlying_currency_exposure` share of total capital.
+        :return: float("inf") if no (or no effective) limit is configured.
+        """
+        limit = self._config.get("max_underlying_currency_exposure", 1.0)
+        if limit is None or limit >= 1:
+            return float("inf")
+
+        max_allowed = self.get_total_stake_amount() * limit
+        committed = self.get_underlying_currency_exposure(pair)
+        available = max(0.0, max_allowed - committed)
+        if committed > 0:
+            currency = self._exchange.get_pair_underlying_currency(pair)
+            self._local_log(
+                f"Underlying currency exposure for {currency} is {committed:.8f}, "
+                f"limit is {max_allowed:.8f} ({limit:.0%} of total capital) "
+                f"-> {available:.8f} additional stake available for {pair}.",
+                level="debug",
+            )
+        return available
+
     def _calculate_unlimited_stake_amount(
         self, available_amount: float, val_tied_up: float, max_open_trades: IntOrInf
     ) -> float:
