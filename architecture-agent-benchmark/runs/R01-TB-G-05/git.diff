+def test_get_underlying_currency_exposure(mocker, default_conf):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    mocker.patch(
+        f"{EXMS}.get_pair_quote_currency",
+        side_effect=lambda pair: pair.split("/")[1].split(":")[0],
+    )
+    open_trades = [
+        MagicMock(safe_quote_currency="USDT", stake_amount=100),
+        MagicMock(safe_quote_currency="USDT", stake_amount=50),
+        MagicMock(safe_quote_currency="BTC", stake_amount=10),
+    ]
+    mocker.patch(
+        "freqtrade.persistence.trade_model.Trade.get_open_trades",
+        return_value=open_trades,
+    )
+
+    currency, committed = freqtrade.wallets._get_underlying_currency_exposure("ETH/USDT")
+    assert currency == "USDT"
+    assert committed == 150
+
+    currency, committed = freqtrade.wallets._get_underlying_currency_exposure("ETH/BTC")
+    assert currency == "BTC"
+    assert committed == 10
+
+
+@pytest.mark.parametrize(
+    "max_currency_exposure,committed_stake,total_stake,stake_amount,expected",
+    [
+        (None, 0, 1000, 100, 100),  # Feature disabled - untouched
+        (0.5, 0, 1000, 100, 100),  # Nothing committed yet - well under the limit
+        (0.5, 400, 1000, 200, 100),  # Would breach the 500 limit - capped to headroom
+        (0.5, 500, 1000, 100, 0),  # Already at the limit - trade skipped
+        (0.2, 150, 1000, 100, 50),  # Capped down to remaining headroom
+    ],
+)
+def test_validate_stake_amount_max_currency_exposure(
+    mocker,
