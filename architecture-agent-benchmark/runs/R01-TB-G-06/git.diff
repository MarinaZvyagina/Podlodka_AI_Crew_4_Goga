+    def _max_stake_for_currency_exposure(
+        self, pair: str, exclude_trade: LocalTrade | None
+    ) -> tuple[float, str]:
+        """
+        Calculate the remaining stake headroom for `pair`'s underlying (settlement) currency
+        before the configured `max_currency_exposure` (a fraction of total tradable capital) is
+        reached, considering all other currently open trades sharing that currency.
+        :param exclude_trade: the trade being (re-)sized, if any - excluded from the currently
+            committed amount so DCA/position-adjustment isn't double-counted.
+        :return: Tuple of (remaining stake headroom - float('inf') if unrestricted, currency)
+        """
+        currency = self._exchange.get_pair_settle_currency(pair)
+        max_currency_exposure = self._config.get("max_currency_exposure")
+        if not max_currency_exposure:
+            return float("inf"), currency
+
+        committed = sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if (exclude_trade is None or trade.id != exclude_trade.id)
+            and self._exchange.get_pair_settle_currency(trade.pair) == currency
+        )
+        headroom = max_currency_exposure * self.get_total_stake_amount() - committed
+        return max(headroom, 0.0), currency
+
