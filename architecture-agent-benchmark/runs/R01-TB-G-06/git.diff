+def test_max_stake_for_currency_exposure_disabled(mocker, default_conf):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    headroom, currency = freqtrade.wallets._max_stake_for_currency_exposure("ETH/USDT", None)
