+def test_max_stake_for_currency_exposure(mocker, default_conf):
+    default_conf["max_currency_exposure"] = 0.5
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+    mocker.patch(f"{EXMS}.get_pair_settle_currency", return_value="USDT")
+
+    trade1 = MagicMock(id=1, pair="ETH/USDT", stake_amount=300)
+    trade2 = MagicMock(id=2, pair="BTC/USDT", stake_amount=100)
+    mocker.patch(
+        "freqtrade.persistence.models.Trade.get_open_trades", return_value=[trade1, trade2]
+    )
+
+    # limit = 0.5 * 1000 = 500; committed = 300 + 100 = 400 -> headroom 100
+    headroom, currency = freqtrade.wallets._max_stake_for_currency_exposure("XRP/USDT", None)
+    assert headroom == 100
+    assert currency == "USDT"
+
+    # Excluding trade1 (as when resizing that very trade) frees up its committed stake
+    headroom, _ = freqtrade.wallets._max_stake_for_currency_exposure("ETH/USDT", trade1)
+    assert headroom == 400  # 500 - trade2's 100
+
+    # No open trades left in that currency at all if committed exceeds the limit
+    trade2.stake_amount = 600
+    headroom, _ = freqtrade.wallets._max_stake_for_currency_exposure("XRP/USDT", None)
+    assert headroom == 0
+
+
+def test_validate_stake_amount_currency_exposure(mocker, default_conf, caplog):
+    default_conf["max_currency_exposure"] = 0.5
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=10000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+    mocker.patch(f"{EXMS}.get_pair_settle_currency", return_value="USDT")
+
+    other_trade = MagicMock(id=1, pair="ETH/USDT", stake_amount=400)
+    mocker.patch(
+        "freqtrade.persistence.models.Trade.get_open_trades", return_value=[other_trade]
+    )
+
+    # limit = 0.5 * 1000 = 500; already committed 400 -> only 100 of headroom remains
+    res = freqtrade.wallets.validate_stake_amount("XRP/USDT", 200, 11, 10000, None)
+    assert res == 100
+    assert log_has_re(
+        r"Stake amount for pair XRP/USDT is too big .* due to the configured USDT currency "
+        r"exposure limit\.",
+        caplog,
+    )
+
+    # Requesting less than the remaining headroom is unaffected.
+    res = freqtrade.wallets.validate_stake_amount("XRP/USDT", 50, 11, 10000, None)
+    assert res == 50
+
+    # No headroom left at all -> trade is skipped (returns 0).
+    other_trade.stake_amount = 500
+    res = freqtrade.wallets.validate_stake_amount("XRP/USDT", 200, 11, 10000, None)
+    assert res == 0
+
+
+def test_validate_stake_amount_currency_exposure_excludes_own_trade(mocker, default_conf):
