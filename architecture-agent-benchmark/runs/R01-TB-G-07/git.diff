+def test_backtest__enter_trade_max_currency_exposure(default_conf, fee, mocker) -> None:
+    default_conf["use_exit_signal"] = False
+    mocker.patch(f"{EXMS}.get_fee", fee)
+    mocker.patch(f"{EXMS}.get_min_pair_stake_amount", return_value=0.00001)
+    mocker.patch(f"{EXMS}.get_max_pair_stake_amount", return_value=float("inf"))
+    patch_exchange(mocker)
+    default_conf["stake_amount"] = 300
+    default_conf["max_open_trades"] = 3
+    default_conf["max_currency_exposure"] = 0.5
+    backtesting = Backtesting(default_conf)
+    backtesting._set_strategy(backtesting.strategylist[0])
+    pair = "LTC/BTC"
+    row = [
+        pd.Timestamp(year=2020, month=1, day=1, hour=5, minute=0),
+        1,  # Buy
+        0.001,  # Open
+        0.0011,  # Close
+        0,  # Sell
+        0.00099,  # Low
+        0.0012,  # High
+        "",  # Buy Signal Name
+    ]
+    # (1000 dry_run_wallet * 0.99 tradable_balance_ratio) * 0.5 max_currency_exposure = 495
+    trade1 = backtesting._enter_trade(pair, row=row, direction="long")
+    assert trade1 is not None
+    assert trade1.stake_amount == 300
+    backtesting.wallets.update()
+
+    # Only 195 of headroom left under the currency cap (both pairs settle in BTC).
+    trade2 = backtesting._enter_trade("ETH/BTC", row=row, direction="long")
+    assert trade2 is not None
+    assert trade2.stake_amount == pytest.approx(195)
+    backtesting.wallets.update()
+
+    # Currency cap fully used up - no room for a 3rd BTC-settled trade.
+    trade3 = backtesting._enter_trade("XRP/BTC", row=row, direction="long")
+    assert trade3 is None
+    LocalTrade.bt_trades_open.remove(trade1)
+    LocalTrade.bt_trades_open.remove(trade2)
+
+
