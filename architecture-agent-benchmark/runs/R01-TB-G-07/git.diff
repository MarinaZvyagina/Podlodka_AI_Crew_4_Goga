+def test_get_currency_exposure_stake(mocker, default_conf):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    trades = [
+        MagicMock(pair="BTC/USDT", stake_amount=100),
+        MagicMock(pair="ETH/USDT", stake_amount=50),
+        MagicMock(pair="ETH/BTC", stake_amount=30),
+    ]
+    mocker.patch(
+        "freqtrade.persistence.models.Trade.get_trades_proxy", return_value=trades
+    )
+    mocker.patch.multiple(
+        EXMS,
+        get_pair_quote_currency=MagicMock(side_effect=lambda pair: pair.split("/")[1]),
+    )
+
+    assert freqtrade.wallets.get_currency_exposure_stake("USDT") == 150
+    assert freqtrade.wallets.get_currency_exposure_stake("BTC") == 30
+    assert freqtrade.wallets.get_currency_exposure_stake("EUR") == 0
+
+
+@pytest.mark.parametrize(
+    "max_currency_exposure,total_stake,current_exposure,stake_amount,min_stake,expected",
+    [
+        (1.0, 1000, 0, 200, 10, 200),  # disabled (default) - no effect
+        (0.5, 1000, 0, 600, 10, 500),  # resized down to fit under the 50% cap
+        (0.5, 1000, 400, 200, 10, 100),  # existing exposure eats into headroom
+        (0.5, 1000, 500, 200, 10, 0),  # no headroom left - trade skipped
+        (0.2, 1000, 0, 100, 250, 0),  # headroom below min_stake - trade skipped
+    ],
+)
+def test_validate_stake_amount_max_currency_exposure(
+    mocker,
+    default_conf,
+    max_currency_exposure,
+    total_stake,
+    current_exposure,
+    stake_amount,
+    min_stake,
+    expected,
+):
+    default_conf["max_currency_exposure"] = max_currency_exposure
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    mocker.patch(
+        "freqtrade.wallets.Wallets.get_available_stake_amount", return_value=total_stake
+    )
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=total_stake)
+    mocker.patch(
+        "freqtrade.wallets.Wallets.get_currency_exposure_stake", return_value=current_exposure
+    )
+
+    res = freqtrade.wallets.validate_stake_amount(
+        "XRP/USDT", stake_amount, min_stake, 10000, None
+    )
+    assert res == expected
+
+
