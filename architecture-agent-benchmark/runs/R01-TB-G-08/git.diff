+    def _get_currency_exposure(self, currency: str) -> float:
+        """
+        Sum of stake_amount currently committed to open trades sharing the given
+        underlying (base) currency.
+        """
+        return sum(
+            trade.stake_amount
+            for trade in Trade.get_trades_proxy(is_open=True)
+            if self._exchange.get_pair_base_currency(trade.pair) == currency
+        )
+
+    def _limit_stake_for_currency_exposure(self, pair: str, max_allowed_stake: float) -> float:
+        """
+        Reduce max_allowed_stake so that committing it to `pair` cannot push the combined
+        stake_amount of all open trades sharing its underlying currency above the
+        configured `max_currency_exposure` share of tradable capital.
+        """
+        max_currency_exposure = self._config.get("max_currency_exposure")
+        if not max_currency_exposure:
+            return max_allowed_stake
+
+        underlying = self._exchange.get_pair_base_currency(pair)
+        exposure_limit = self.get_total_stake_amount() * max_currency_exposure
+        headroom = max(exposure_limit - self._get_currency_exposure(underlying), 0)
+
+        if headroom < max_allowed_stake:
+            self._local_log(
+                f"Stake amount for pair {pair} is limited to {headroom:.8f} by "
+                f"max_currency_exposure ({max_currency_exposure:.2%} of tradable capital "
+                f"for underlying currency {underlying})."
+            )
+        return min(max_allowed_stake, headroom)
+
