+    [
+        # No trades open yet for BTC - full amount fits under the 300 cap.
+        ("BTC/USDT", 200, [], 200),
+        # 250 of the 300 BTC cap is already used - stake is capped to the remaining 50.
+        ("BTC/USDT", 200, [("BTC/USDT", 250)], 50),
+        # BTC cap is already exhausted - trade is fully rejected.
+        ("BTC/USDT", 200, [("BTC/USDT", 300)], 0),
+        # ETH exposure is untouched by BTC trades - not affected by the BTC cap.
+        ("ETH/USDT", 200, [("BTC/USDT", 300)], 200),
+        # Exposure is summed across multiple trades sharing the same underlying.
+        ("BTC/USDT", 200, [("BTC/USDT", 100), ("BTC/USDT", 100)], 100),
+    ],
+)
+def test_validate_stake_amount_max_currency_exposure(
+    mocker, default_conf, pair, requested_stake, open_trades, expected
+):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    freqtrade.config["max_currency_exposure"] = 0.3
+    freqtrade.wallets._config["max_currency_exposure"] = 0.3
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=10000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+    mocker.patch(
+        "freqtrade.exchange.Exchange.get_pair_base_currency",
+        side_effect=lambda p: p.split("/")[0],
+    )
+    mocker.patch(
+        "freqtrade.persistence.Trade.get_trades_proxy",
+        return_value=[
+            SimpleNamespace(pair=trade_pair, stake_amount=stake)
+            for trade_pair, stake in open_trades
+        ],
+    )
+
+    res = freqtrade.wallets.validate_stake_amount(pair, requested_stake, None, 10000, None)
+    assert res == expected
