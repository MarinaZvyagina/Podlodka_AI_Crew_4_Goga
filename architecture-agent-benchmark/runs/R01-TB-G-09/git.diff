+def test_get_currency_exposure_stake(mocker, default_conf, fee):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    open_trades = [
+        Trade(
+            pair="BTC/USDT",
+            stake_amount=50.0,
+            amount=1.0,
+            open_rate=50.0,
+            is_open=True,
+            fee_open=fee.return_value,
+        ),
+        Trade(
+            pair="ETH/USDT",
+            stake_amount=30.0,
+            amount=1.0,
+            open_rate=30.0,
+            is_open=True,
+            fee_open=fee.return_value,
+        ),
+        Trade(
+            pair="ETH/BTC",
+            stake_amount=10.0,
+            amount=1.0,
+            open_rate=10.0,
+            is_open=True,
+            fee_open=fee.return_value,
+        ),
+    ]
+    mocker.patch("freqtrade.persistence.models.Trade.get_open_trades", return_value=open_trades)
+
+    assert freqtrade.wallets._get_currency_exposure_stake("USDT") == 80.0
+    assert freqtrade.wallets._get_currency_exposure_stake("BTC") == 10.0
+    assert freqtrade.wallets._get_currency_exposure_stake("ETH") == 0.0
+
+
+@pytest.mark.parametrize(
+    "stake_amount,total_stake,currency_exposure,min_stake,expected",
+    [
+        (100, 1000, 0, 11, 100),  # Well within the 50% cap (500)
+        (100, 1000, 480, 11, 20),  # Only 20 left under the cap - resized down
+        (100, 1000, 500, 11, 0),  # Cap already exhausted - trade skipped
+        (100, 1000, 495, 11, 0),  # Resized amount (5) below min_stake - trade skipped
+        (100, 1000, 495, None, 5),  # Same, but no min_stake set - keep the resized amount
+    ],
+)
+def test_validate_stake_amount_currency_exposure_cap(
+    mocker,
+    default_conf,
+    stake_amount,
+    total_stake,
+    currency_exposure,
+    min_stake,
+    expected,
+):
+    default_conf["max_currency_exposure"] = 0.5
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=stake_amount)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=total_stake)
+    mocker.patch(
+        "freqtrade.wallets.Wallets._get_currency_exposure_stake",
+        return_value=currency_exposure,
+    )
+
+    res = freqtrade.wallets.validate_stake_amount("XRP/USDT", stake_amount, min_stake, 10000, None)
+    assert res == expected
+
+
+def test_validate_stake_amount_currency_exposure_cap_disabled(mocker, default_conf):
+    # max_currency_exposure is unset - the cap must not interfere with normal sizing.
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=1000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+    mocker.patch(
