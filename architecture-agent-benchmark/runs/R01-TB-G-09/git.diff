+    def _get_currency_exposure_stake(self, currency: str) -> float:
+        """
+        Sum of stake_amount currently committed to open trades sharing the given
+        quote/settlement currency.
+        """
+        return sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if trade.safe_quote_currency == currency
+        )
+
+    def _apply_currency_exposure_cap(
+        self, pair: str, stake_amount: float, max_currency_exposure: float
+    ) -> float:
+        """
+        Limit stake_amount so that the combined stake of all currently open trades sharing
+        the pair's quote/settlement currency (including this proposed stake) does not exceed
+        the configured share of total tradable capital.
+        :return: (possibly reduced) stake_amount, or 0 if the cap is already exhausted.
+        """
+        quote_currency = self._exchange.get_pair_quote_currency(pair)
+        currency_cap = self.get_total_stake_amount() * max_currency_exposure
+        currency_exposure = self._get_currency_exposure_stake(quote_currency)
+        allowed_increment = currency_cap - currency_exposure
+
+        if allowed_increment <= 0:
+            self._local_log(
+                f"Stake amount for pair {pair} skipped, {quote_currency} exposure "
+                f"({currency_exposure:.8f}) is already at or above the configured "
+                f"exposure cap ({currency_cap:.8f})."
+            )
+            return 0
+        if stake_amount > allowed_increment:
+            self._local_log(
+                f"Stake amount for pair {pair} is too big for the remaining {quote_currency} "
+                f"exposure allowance ({stake_amount:.8f} > {allowed_increment:.8f}), "
+                f"adjusting to {allowed_increment:.8f}."
+            )
+            stake_amount = allowed_increment
+        return stake_amount
+
