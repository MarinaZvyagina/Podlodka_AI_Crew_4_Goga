+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses_perpair(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 500,
+            "stop_duration": 60,
+            "trade_limit": 3,
+            "only_per_pair": True,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .* consecutive losses\."
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # Winning trade - does not count towards the streak.
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        min_ago_open=100,
+        min_ago_close=50,
+        profit_rate=1.1,
+    )
+    # 1st loss
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=90,
+        min_ago_close=40,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert not PairLocks.is_pair_locked("XRP/BTC")
+
+    # 2nd consecutive loss
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=80,
+        min_ago_close=30,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert not PairLocks.is_pair_locked("XRP/BTC")
+    assert not log_has_re(message, caplog)
+
+    # 3rd consecutive loss - triggers the lock.
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=70,
+        min_ago_close=20,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    assert freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert PairLocks.is_pair_locked("XRP/BTC")
+    assert log_has_re(message, caplog)
+
+    # only_per_pair disables the bot-wide (global) lock.
+    assert not freqtrade.protections.global_stop()
+    assert not PairLocks.is_global_lock()
