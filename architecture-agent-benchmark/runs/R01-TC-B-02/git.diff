+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses_perpair(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 1000,
+            "stop_duration": 60,
+            "trade_limit": 3,
+            "only_per_pair": True,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped for .*"
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 1st losing trade
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=500,
+        min_ago_close=400,
+        profit_rate=0.9,
+    )
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+
+    # A winning trade must reset the streak
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        min_ago_open=350,
+        min_ago_close=300,
+        profit_rate=1.1,
+    )
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+
+    # 2 losing trades after the winning trade - not enough yet (limit is 3)
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=250,
+        min_ago_close=200,
+        profit_rate=0.9,
+    )
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=150,
+        min_ago_close=100,
+        profit_rate=0.9,
+    )
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert not log_has_re(message, caplog)
+
+    # Other pairs' losses must not count towards this pair's streak
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=90,
+        min_ago_close=80,
+        profit_rate=0.9,
+    )
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+
+    # 3rd consecutive losing trade on XRP/BTC -> locks the pair
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=50,
+        min_ago_close=30,
+        profit_rate=0.9,
+    )
+    assert freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_pair_locked("XRP/BTC")
+    assert not PairLocks.is_global_lock()
+
+    # Once the cooldown period elapses, trading is allowed again automatically
+    end_time = PairLocks.get_pair_longest_lock("XRP/BTC").lock_end_time + timedelta(minutes=5)
+    freqtrade.protections.stop_per_pair("XRP/BTC", end_time)
+    assert not PairLocks.is_pair_locked("XRP/BTC", end_time)
+
