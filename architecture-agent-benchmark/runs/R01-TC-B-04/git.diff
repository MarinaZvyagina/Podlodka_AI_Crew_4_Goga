+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses_perpair(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 400,
+            "stop_duration": 60,
+            "trade_limit": 3,
+            "required_profit": 0.0,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*"
+    pair = "XRP/BTC"
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2 losing trades in a row - not enough yet (trade_limit is 3)
+    for min_ago in (300, 200):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.STOP_LOSS.value,
+            min_ago_open=min_ago + 30,
+            min_ago_close=min_ago,
+            profit_rate=0.9,
+        )
+    Trade.commit()
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 3rd loss in a row - now locked, both per pair and globally
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=40,
+        min_ago_close=10,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    assert freqtrade.protections.stop_per_pair(pair)
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_pair_locked(pair)
+    caplog.clear()
+    assert freqtrade.protections.global_stop()
+    assert PairLocks.is_global_lock()
+
+
+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses_reset_by_win(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 400,
+            "stop_duration": 60,
+            "trade_limit": 2,
+            "only_per_pair": True,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    pair = "XRP/BTC"
+
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=230,
+        min_ago_close=200,
+        profit_rate=0.9,
+    )
+    # Winning trade breaks the streak
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        min_ago_open=130,
+        min_ago_close=100,
+        profit_rate=1.15,
+    )
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=60,
+        min_ago_close=30,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+
+    # Only 1 loss since the last win - not locked
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not PairLocks.is_pair_locked(pair)
+    # only_per_pair is set - never locks globally
+    assert not freqtrade.protections.global_stop()
+
