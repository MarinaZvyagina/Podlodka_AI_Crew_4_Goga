+@pytest.mark.parametrize("is_short", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_max_losing_streak(mocker, default_conf, fee, caplog, is_short):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxLosingStreak",
+            "lookback_period": 1000,
+            "stop_duration": 40,
+            "trade_limit": 3,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*consecutive losses.*"
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=200,
+        min_ago_close=90,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # Winning trade breaks the streak.
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        min_ago_open=180,
+        min_ago_close=70,
+        profit_rate=1.1,
+        is_short=is_short,
+    )
+    generate_mock_trade(
+        "BCH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=150,
+        min_ago_close=50,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    # Only 1 loss since the winning trade - not a streak of 3 yet.
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    generate_mock_trade(
+        "LTC/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=120,
+        min_ago_close=30,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    # 2 losses since the winning trade - still not a streak of 3.
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    generate_mock_trade(
+        "NEO/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=90,
+        min_ago_close=10,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+
+    assert freqtrade.protections.global_stop()
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_global_lock()
+
+    # Test 5m after lock-period - this should try and relock the pair, but end-time
+    # should be the previous end-time
+    end_time = PairLocks.get_pair_longest_lock("*").lock_end_time + timedelta(minutes=5)
+    freqtrade.protections.global_stop(end_time)
+    assert not PairLocks.is_global_lock(end_time)
+
+
+@pytest.mark.parametrize("only_per_pair", [False, True])
+@pytest.mark.parametrize("only_per_side", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_max_losing_streak_perpair(mocker, default_conf, fee, caplog, only_per_pair, only_per_side):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxLosingStreak",
+            "lookback_period": 60,
+            "trade_limit": 2,
+            "stop_duration": 60,
+            "only_per_pair": only_per_pair,
+            "only_per_side": only_per_side,
+        }
+    ]
+    check_side = "long" if only_per_side else "*"
+    is_short = False
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*consecutive losses.*"
+    pair = "XRP/BTC"
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=200,
+        min_ago_close=30,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+    # This trade does not count, as it's closed too long ago
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=250,
+        min_ago_close=100,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    # Trade does not count for per pair stop as it's the wrong pair.
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=240,
+        min_ago_close=30,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    # 3 Trades closed - but the 2nd has been closed too long ago.
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert freqtrade.protections.global_stop() != only_per_pair
+    if not only_per_pair:
+        assert log_has_re(message, caplog)
+    else:
+        assert not log_has_re(message, caplog)
+
+    caplog.clear()
+
+    # Trade does not count potentially, as it's in the wrong direction
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=150,
+        min_ago_close=25,
+        profit_rate=0.9,
+        is_short=not is_short,
+    )
+    freqtrade.protections.stop_per_pair(pair)
+    assert freqtrade.protections.global_stop() != only_per_pair
+    assert PairLocks.is_pair_locked(pair, side=check_side) != (only_per_side and only_per_pair)
+    assert PairLocks.is_global_lock(side=check_side) != only_per_pair
+    if only_per_side:
+        assert not PairLocks.is_pair_locked(pair, side="*")
+        assert not PairLocks.is_global_lock(side="*")
+
+    caplog.clear()
+
+    # 2nd Trade that counts with correct pair
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=180,
+        min_ago_close=31,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+
+    freqtrade.protections.stop_per_pair(pair)
+    assert freqtrade.protections.global_stop() != only_per_pair
+    assert PairLocks.is_pair_locked(pair, side=check_side)
+    assert PairLocks.is_global_lock(side=check_side) != only_per_pair
+    if only_per_side:
+        assert not PairLocks.is_pair_locked(pair, side="*")
+        assert not PairLocks.is_global_lock(side="*")
+
+
