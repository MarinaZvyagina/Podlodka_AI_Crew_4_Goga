+@pytest.mark.usefixtures("init_persistence")
+def test_consecutive_losses_guard(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {"method": "ConsecutiveLossesGuard", "trade_limit": 3, "stop_duration": 60}
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*consecutive losses.*"
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2 losing trades - not enough to trigger the guard yet.
+    for i in range(2):
+        generate_mock_trade(
+            "XRP/BTC",
+            fee.return_value,
+            False,
+            exit_reason=ExitType.EXIT_SIGNAL.value,
+            min_ago_open=200 - i * 10,
+            min_ago_close=100 - i * 10,
+            profit_rate=0.9,
+        )
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # A winning trade resets the streak - even though 2 losses preceded it.
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=90,
+        min_ago_close=80,
+        profit_rate=1.1,
+    )
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 3 losses in a row (across different pairs) - should now trigger the bot-wide guard.
+    for i, pair in enumerate(["XRP/BTC", "ETH/BTC", "LTC/BTC"]):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.EXIT_SIGNAL.value,
+            min_ago_open=70 - i * 10,
+            min_ago_close=60 - i * 10,
+            profit_rate=0.9,
+        )
+
+    assert freqtrade.protections.global_stop()
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_global_lock()
+
+
+@pytest.mark.parametrize("only_per_pair", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_consecutive_losses_guard_perpair(mocker, default_conf, fee, caplog, only_per_pair):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "ConsecutiveLossesGuard",
+            "trade_limit": 2,
+            "stop_duration": 60,
+            "only_per_pair": only_per_pair,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*consecutive losses.*"
+    pair = "XRP/BTC"
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # A single loss on the other pair does not affect `pair`'s streak.
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=100,
+        min_ago_close=90,
+        profit_rate=0.9,
+    )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=80,
+        min_ago_close=70,
+        profit_rate=0.9,
+    )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=60,
+        min_ago_close=50,
+        profit_rate=0.9,
+    )
+
+    assert freqtrade.protections.stop_per_pair(pair)
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_pair_locked(pair)
+    assert not PairLocks.is_pair_locked("ETH/BTC")
+    assert freqtrade.protections.global_stop() != only_per_pair
+    assert PairLocks.is_global_lock() != only_per_pair
+
