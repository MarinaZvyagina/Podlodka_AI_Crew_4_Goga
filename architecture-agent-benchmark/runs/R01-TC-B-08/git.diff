+@pytest.mark.parametrize("only_per_pair", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses(mocker, default_conf, fee, caplog, only_per_pair):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 1000,
+            "stop_duration": 60,
+            "trade_limit": 3,
+            "only_per_pair": only_per_pair,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped for .*"
+    pair = "XRP/BTC"
+    other_pair = "ETH/BTC"
+
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # A winning trade resets/prevents a streak.
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        min_ago_open=500,
+        min_ago_close=400,
+        profit_rate=1.15,
+    )
+    Trade.commit()
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not PairLocks.is_pair_locked(pair)
+    assert not PairLocks.is_global_lock()
+
+    # 2 losses in a row - not enough yet (trade_limit=3)
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=300,
+        min_ago_close=200,
+        profit_rate=0.9,
+    )
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=150,
+        min_ago_close=100,
+        profit_rate=0.95,
+    )
+    Trade.commit()
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # A loss on another pair only extends the bot-wide streak, not the per-pair one.
+    generate_mock_trade(
+        other_pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=90,
+        min_ago_close=30,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert freqtrade.protections.global_stop() != only_per_pair
+    # A global lock (bot-wide streak) also blocks entries on `pair`.
+    assert PairLocks.is_pair_locked(pair) != only_per_pair
+    assert PairLocks.is_global_lock() != only_per_pair
+    if not only_per_pair:
+        assert log_has_re(message, caplog)
+    caplog.clear()
+
+    # 3rd consecutive loss for `pair` -> per-pair lock triggers too.
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=20,
+        min_ago_close=10,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    assert freqtrade.protections.stop_per_pair(pair)
+    assert PairLocks.is_pair_locked(pair)
+    assert log_has_re(message, caplog)
+
+
