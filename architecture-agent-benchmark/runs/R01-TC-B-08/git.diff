@@ -0,0 +1,99 @@
+import logging
+from datetime import datetime, timedelta
+from typing import Any
+
+from freqtrade.constants import Config, LongShort
+from freqtrade.persistence import LocalTrade, Trade
+from freqtrade.plugins.protections import IProtection, ProtectionReturn
+
+
+logger = logging.getLogger(__name__)
+
+
+class MaxConsecutiveLosses(IProtection):
+    has_global_stop: bool = True
+    has_local_stop: bool = True
+
+    def __init__(self, config: Config, protection_config: dict[str, Any]) -> None:
+        super().__init__(config, protection_config)
+
+        self._trade_limit = protection_config.get("trade_limit", 3)
+        self._disable_global_stop = protection_config.get("only_per_pair", False)
+
+    def short_desc(self) -> str:
+        """
+        Short method description - used for startup-messages
+        """
+        return (
+            f"{self.name} - Max consecutive losses, locks trading after "
+            f"{self._trade_limit} consecutive losses within {self.lookback_period_str}."
+        )
+
+    def _reason(self, streak_len: int) -> str:
+        """
+        LockReason to use
+        """
+        return (
+            f"{streak_len} consecutive losses in a row, locking {self.unlock_reason_time_element}."
+        )
+
+    def _max_consecutive_losses(
+        self, date_now: datetime, pair: str | None
+    ) -> ProtectionReturn | None:
+        """
+        Evaluate the most recent trades for a losing-streak, either for a single pair
+        (pair is set) or across all pairs (pair is None).
+        """
+        look_back_until = date_now - timedelta(minutes=self._lookback_period)
+        trades = Trade.get_trades_proxy(pair=pair, is_open=False, close_date=look_back_until)
+        if len(trades) < self._trade_limit:
+            # Not enough closed trades to form the required streak.
+            return None
+
+        trades_sorted: list[LocalTrade] = sorted(trades, key=lambda t: t.close_date)  # type: ignore
+
+        streak: list[LocalTrade] = []
+        for trade in reversed(trades_sorted):
+            if trade.close_profit is not None and trade.close_profit < 0:
+                streak.append(trade)
+            else:
+                break
+
+        if len(streak) < self._trade_limit:
+            return None
+
+        self.log_once(
+            f"Trading stopped for {pair or 'all pairs'} due to {len(streak)} consecutive losses.",
+            logger.info,
+        )
+        until = self.calculate_lock_end(streak)
+
+        return ProtectionReturn(
+            lock=True,
+            until=until,
+            reason=self._reason(len(streak)),
+        )
+
+    def global_stop(
+        self, date_now: datetime, side: LongShort, starting_balance: float
+    ) -> ProtectionReturn | None:
+        """
+        Stops trading (position entering) for all pairs
+        This must evaluate to true for the whole period of the "cooldown period".
+        :return: Tuple of [bool, until, reason].
+            If true, all pairs will be locked with <reason> until <until>
+        """
+        if self._disable_global_stop:
+            return None
+        return self._max_consecutive_losses(date_now, None)
+
+    def stop_per_pair(
+        self, pair: str, date_now: datetime, side: LongShort, starting_balance: float
+    ) -> ProtectionReturn | None:
+        """
+        Stops trading (position entering) for this pair
+        This must evaluate to true for the whole period of the "cooldown period".
+        :return: Tuple of [bool, until, reason].
+            If true, this pair will be locked with <reason> until <until>
+        """
+        return self._max_consecutive_losses(date_now, pair)
