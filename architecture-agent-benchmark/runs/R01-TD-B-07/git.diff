+@pytest.mark.parametrize("exchange_name", EXCHANGES)
+def test_fetch_ticker_cache(default_conf, mocker, exchange_name, time_machine):
+    tick = {"symbol": "ETH/BTC", "bid": 0.00001098, "ask": 0.00001099, "last": 0.0001}
+    api_mock = MagicMock()
+    api_mock.fetch_ticker = MagicMock(return_value=tick)
+    api_mock.markets = {"ETH/BTC": {"active": True}, "XRP/BTC": {"active": True}}
+    exchange = get_patched_exchange(mocker, default_conf, api_mock, exchange=exchange_name)
+    time_machine.move_to(dt_now(), tick=False)
+
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert ticker == tick
+    assert api_mock.fetch_ticker.call_count == 1
+
+    # Requesting the same pair again within the cache window must not hit the exchange again.
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert ticker == tick
+    assert api_mock.fetch_ticker.call_count == 1
+
+    # A different pair is not cached and still goes out to the exchange.
+    exchange.fetch_ticker(pair="XRP/BTC")
+    assert api_mock.fetch_ticker.call_count == 2
+
+    # Once the cache window has passed, the ticker is fetched again.
+    time_machine.move_to(dt_now() + timedelta(seconds=5), tick=False)
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert ticker == tick
+    assert api_mock.fetch_ticker.call_count == 3
+
+
