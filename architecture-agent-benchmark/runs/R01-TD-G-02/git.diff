diff --git a/freqtrade/exchange/exchange.py b/freqtrade/exchange/exchange.py
index 69c9993..caa0acb 100644
--- a/freqtrade/exchange/exchange.py
+++ b/freqtrade/exchange/exchange.py
@@ -241,6 +241,10 @@ class Exchange:
         # Shouldn't be too high either, as it'll freeze UI updates in case of open orders.
         self._exit_rate_cache: FtTTLCache = FtTTLCache(maxsize=100, ttl=300)
         self._entry_rate_cache: FtTTLCache = FtTTLCache(maxsize=100, ttl=300)
+        # Very short-lived cache for single-pair ticker fetches, to avoid hammering the
+        # exchange when multiple call-sites (e.g. entry and exit pricing) request the
+        # current price for the same pair within the same iteration.
+        self._fetch_ticker_cache: FtTTLCache = FtTTLCache(maxsize=1000, ttl=2)
 
         # Holds candles
         self._klines: dict[PairWithTimeframe, DataFrame] = {}
@@ -2163,10 +2167,16 @@ class Exchange:
 
     @retrier
     def fetch_ticker(self, pair: str) -> Ticker:
+        with self._cache_lock:
+            ticker = self._fetch_ticker_cache.get(pair)
+        if ticker:
+            return ticker
         try:
             if pair not in self.markets or self.markets[pair].get("active", False) is False:
                 raise ExchangeError(f"Pair {pair} not available")
             data: Ticker = self._api.fetch_ticker(pair)
+            with self._cache_lock:
+                self._fetch_ticker_cache[pair] = data
             return data
         except ccxt.DDoSProtection as e:
             raise DDosProtection(e) from e
