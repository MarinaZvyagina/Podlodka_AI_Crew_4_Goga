diff --git a/freqtrade/exchange/exchange.py b/freqtrade/exchange/exchange.py
index 69c9993..ce2cc53 100644
--- a/freqtrade/exchange/exchange.py
+++ b/freqtrade/exchange/exchange.py
@@ -235,6 +235,12 @@ class Exchange:
         self._cache_lock = Lock()
         # Cache for 10 minutes ...
         self._fetch_tickers_cache: FtTTLCache = FtTTLCache(maxsize=4, ttl=60 * 10)
+        # Short-lived cache for single-pair ticker lookups (current price).
+        # Avoids repeated round-trips to the exchange when the same pair's price is
+        # requested multiple times in quick succession (e.g. by different parts of the
+        # bot within the same iteration), while still refreshing often enough that
+        # trading decisions aren't made on stale prices.
+        self._fetch_ticker_cache: FtTTLCache = FtTTLCache(maxsize=1000, ttl=2)
         # Cache values for 300 to avoid frequent polling of the exchange for prices
         # Caching only applies to RPC methods, so prices for open trades are still
         # refreshed once every iteration.
@@ -2164,9 +2170,15 @@ class Exchange:
     @retrier
     def fetch_ticker(self, pair: str) -> Ticker:
         try:
+            with self._cache_lock:
+                cached_ticker = self._fetch_ticker_cache.get(pair)
+            if cached_ticker is not None:
+                return cached_ticker
             if pair not in self.markets or self.markets[pair].get("active", False) is False:
                 raise ExchangeError(f"Pair {pair} not available")
             data: Ticker = self._api.fetch_ticker(pair)
+            with self._cache_lock:
+                self._fetch_ticker_cache[pair] = data
             return data
         except ccxt.DDoSProtection as e:
             raise DDosProtection(e) from e
