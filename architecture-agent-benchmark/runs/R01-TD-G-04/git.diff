+@pytest.mark.parametrize("exchange_name", EXCHANGES)
+def test_fetch_ticker_cache(default_conf, mocker, exchange_name, time_machine):
+    api_mock = MagicMock()
+    api_mock.fetch_ticker = MagicMock(
+        return_value={"symbol": "ETH/BTC", "bid": 1, "ask": 2, "last": 1.5}
+    )
+    api_mock.markets = {"ETH/BTC": {"active": True}, "LTC/BTC": {"active": True}}
+    exchange = get_patched_exchange(mocker, default_conf, api_mock, exchange=exchange_name)
+
+    start_dt = datetime(2026, 1, 1, tzinfo=UTC)
+    time_machine.move_to(start_dt, tick=False)
+
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert api_mock.fetch_ticker.call_count == 1
+    assert ticker["bid"] == 1
+
+    # A second request for the same pair moments later reuses the cached ticker
+    # instead of hitting the exchange again.
+    time_machine.move_to(start_dt + timedelta(seconds=1), tick=False)
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert api_mock.fetch_ticker.call_count == 1
+    assert ticker["bid"] == 1
+
+    # A different pair is not affected by the cache.
+    exchange.fetch_ticker(pair="LTC/BTC")
+    assert api_mock.fetch_ticker.call_count == 2
+
+    # Once the short cache TTL has elapsed, the ticker is fetched again.
+    time_machine.move_to(start_dt + timedelta(seconds=5), tick=False)
+    exchange.fetch_ticker(pair="ETH/BTC")
+    assert api_mock.fetch_ticker.call_count == 3
+
+
