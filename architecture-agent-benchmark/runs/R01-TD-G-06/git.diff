+def test_fetch_ticker_cached(default_conf, mocker, time_machine):
+    api_mock = MagicMock()
+    tick = {"symbol": "ETH/BTC", "bid": 0.00001098, "ask": 0.00001099, "last": 0.0001}
+    api_mock.fetch_ticker = MagicMock(return_value=tick)
+    api_mock.markets = {"ETH/BTC": {"active": True}, "LTC/BTC": {"active": True}}
+    start_dt = datetime(2026, 1, 1, tzinfo=UTC)
+    time_machine.move_to(start_dt, tick=False)
+    exchange = get_patched_exchange(mocker, default_conf, api_mock)
+
+    # First call goes to the exchange
+    exchange.fetch_ticker(pair="ETH/BTC")
+    assert api_mock.fetch_ticker.call_count == 1
+
+    # Second call, moments later, is served from the short-lived cache
+    time_machine.move_to(start_dt + timedelta(seconds=1), tick=False)
+    exchange.fetch_ticker(pair="ETH/BTC")
+    assert api_mock.fetch_ticker.call_count == 1
+
+    # A different pair is not cached and goes to the exchange
+    exchange.fetch_ticker(pair="LTC/BTC")
+    assert api_mock.fetch_ticker.call_count == 2
+
+    # Once the cache expires, the exchange is queried again
+    time_machine.move_to(start_dt + timedelta(seconds=3), tick=False)
+    exchange.fetch_ticker(pair="ETH/BTC")
+    assert api_mock.fetch_ticker.call_count == 3
+
+
 @pytest.mark.parametrize("exchange_name", EXCHANGES)
 def test___now_is_time_to_refresh(default_conf, mocker, exchange_name, time_machine):
     exchange = get_patched_exchange(mocker, default_conf, exchange=exchange_name)
