     caplog.clear()
+    # Bypass the short-lived ticker cache to verify the entry-rate cache itself
+    # (rather than the lower-level ticker cache) is what's being refreshed here.
+    exchange._fetch_ticker_cache.clear()
 
     assert exchange.get_rates("ETH/BTC", refresh=True, is_short=False)[0] == expected
     assert not log_has("Using cached buy rate for ETH/BTC.", caplog)
