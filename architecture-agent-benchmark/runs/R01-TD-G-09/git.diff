         exchange.fetch_ticker(pair="XRP/ETH")
 
 
+@pytest.mark.parametrize("exchange_name", EXCHANGES)
+def test_fetch_ticker_cached(default_conf, mocker, exchange_name):
+    tick1 = {"symbol": "ETH/BTC", "bid": 0.00001098, "ask": 0.00001099, "last": 0.0001}
+    tick2 = {"symbol": "ETH/BTC", "bid": 0.5, "ask": 1, "last": 42}
+    api_mock = MagicMock()
+    api_mock.fetch_ticker = MagicMock(side_effect=[tick1, tick2])
+    api_mock.markets = {"ETH/BTC": {"active": True}}
+    exchange = get_patched_exchange(mocker, default_conf, api_mock, exchange=exchange_name)
+
+    # Uncached calls always hit the exchange.
+    assert exchange.fetch_ticker(pair="ETH/BTC")["bid"] == 0.00001098
+    assert exchange.fetch_ticker(pair="ETH/BTC")["bid"] == 0.5
+    assert api_mock.fetch_ticker.call_count == 2
+
+    exchange._fetch_ticker_cache.clear()
+    api_mock.fetch_ticker.reset_mock()
+    api_mock.fetch_ticker.side_effect = [tick1, tick2]
+    # First cached call populates the cache, second reuses it.
+    assert exchange.fetch_ticker(pair="ETH/BTC", cached=True)["bid"] == 0.00001098
+    assert exchange.fetch_ticker(pair="ETH/BTC", cached=True)["bid"] == 0.00001098
+    assert api_mock.fetch_ticker.call_count == 1
+
+    # Once the cache is cleared (simulating expiry), a fresh value is fetched again.
+    exchange._fetch_ticker_cache.clear()
+    assert exchange.fetch_ticker(pair="ETH/BTC", cached=True)["bid"] == 0.5
+    assert api_mock.fetch_ticker.call_count == 2
+
+
 @pytest.mark.parametrize("exchange_name", EXCHANGES)
