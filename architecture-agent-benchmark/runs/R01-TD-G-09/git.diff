+        # Short-lived cache for single-pair tickers, to avoid back-to-back requests for the
+        # same pair's current price (e.g. entry-confirmation and exit-decision logic asking
+        # moments apart) from each triggering a separate round-trip to the exchange.
+        self._fetch_ticker_cache: FtTTLCache = FtTTLCache(maxsize=1000, ttl=2)
         # Cache values for 300 to avoid frequent polling of the exchange for prices
