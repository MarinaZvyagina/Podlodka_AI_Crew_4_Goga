diff --git a/tests/pytests/unit/beacons/test_diskusage.py b/tests/pytests/unit/beacons/test_diskusage.py
index 94fff2f..ee3d0f9 100644
--- a/tests/pytests/unit/beacons/test_diskusage.py
+++ b/tests/pytests/unit/beacons/test_diskusage.py
@@ -210,3 +210,43 @@ def test_diskusage_windows_match_regex(
                 {"diskusage": 50, "mount": "D:\\"},
             ]
             assert ret == _expected
+
+
+def test_diskusage_min_match(stub_disk_partition):
+    usage = namedtuple("usage", "total used free percent")(1000, 30, 970, 3)
+    disk_usage_mock = Mock(return_value=usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        config = [{"/": {"min": "5%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == [{"diskusage": 3, "mount": "/", "match": "min"}]
+
+
+def test_diskusage_min_nomatch(stub_disk_partition):
+    usage = namedtuple("usage", "total used free percent")(1000, 500, 500, 50)
+    disk_usage_mock = Mock(return_value=usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        config = [{"/": {"min": "5%"}}]
+
+        ret = diskusage.beacon(config)
+        assert ret == []
+
+
+def test_diskusage_min_and_max(stub_disk_partition):
+    usage = namedtuple("usage", "total used free percent")(1000, 750, 250, 75)
+    disk_usage_mock = Mock(return_value=usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        # max is exceeded, min is not breached: only the max alert should fire
+        config = [{"/": {"min": "5%", "max": "70%"}}]
+
+        ret = diskusage.beacon(config)
+        assert ret == [{"diskusage": 75, "mount": "/"}]
