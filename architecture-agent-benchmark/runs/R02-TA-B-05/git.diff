+def _to_percent(value):
+    """
+    Normalize a threshold value (e.g. "50%", 50, 50.0) to a float percentage
+    """
+    if isinstance(value, str) and "%" in value:
+        value = re.sub("%", "", value)
+    return float(value)
+
+
 def validate(config):
     """
     Validate the beacon configuration
@@ -83,6 +92,22 @@ def beacon(config):
     which means that if a regular expression matches another defined mount point,
     it will override the previously defined threshold.
 
+    A mount can also be configured with a ``min`` threshold, which emits a
+    beacon when usage drops *below* the given percentage instead of rising
+    above it. This is useful for mounts that are normally busy, where a sudden
+    drop in usage usually means the filesystem failed to mount rather than
+    that space was actually freed. ``min`` and ``max`` (equivalent to the
+    plain percentage form above) can be combined and are independent of each
+    other.
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /mnt/nfs:
+                min: 5%
+                max: 50%
+
     """
     whitelist = []
     config = salt.utils.beacons.remove_hidden_options(config, whitelist)
@@ -118,9 +143,26 @@ def beacon(config):
 
                 current_usage = _current_usage.percent
                 monitor_usage = mounts[mount]
-                if isinstance(monitor_usage, str) and "%" in monitor_usage:
-                    monitor_usage = re.sub("%", "", monitor_usage)
-                monitor_usage = float(monitor_usage)
-                if current_usage >= monitor_usage:
+
+                if isinstance(monitor_usage, dict):
+                    max_usage = monitor_usage.get("max")
+                    min_usage = monitor_usage.get("min")
+
+                    if max_usage is not None and current_usage >= _to_percent(
+                        max_usage
+                    ):
+                        ret.append({"diskusage": current_usage, "mount": _mount})
+
+                    if min_usage is not None and current_usage < _to_percent(
+                        min_usage
+                    ):
+                        ret.append(
+                            {
+                                "diskusage": current_usage,
+                                "mount": _mount,
+                                "match": "min",
+                            }
+                        )
+                elif current_usage >= _to_percent(monitor_usage):
                     ret.append({"diskusage": current_usage, "mount": _mount})
