@@ -40,6 +40,17 @@ def validate(config):
     # Configuration for diskusage beacon should be a list of dicts
     if not isinstance(config, list):
         return False, "Configuration for diskusage beacon must be a list."
+
+    for mounts in config:
+        for mount in mounts:
+            monitor = mounts[mount]
+            if isinstance(monitor, dict):
+                if "minimum" not in monitor and "maximum" not in monitor:
+                    return (
+                        False,
+                        "Configuration for diskusage beacon mount {} must "
+                        "include a minimum and/or a maximum.".format(mount),
+                    )
     return True, "Valid beacon configuration"
 
 
@@ -83,6 +94,24 @@ def beacon(config):
     which means that if a regular expression matches another defined mount point,
     it will override the previously defined threshold.
 
+    A mount can also be configured with a ``minimum`` and/or a ``maximum``
+    threshold instead of a single high-water-mark percentage. ``maximum``
+    behaves exactly like the plain percentage form above: a beacon fires
+    when usage is at or above it. ``minimum`` fires a beacon when usage is
+    at or below it, which is useful for catching a mount that normally runs
+    busy but has silently failed to mount (an unmounted directory usually
+    reports as nearly empty).
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /mnt/nfs:
+                minimum: 10%
+                maximum: 90%
+            - /mnt/backup:
+                minimum: 5%
+
     """
     whitelist = []
     config = salt.utils.beacons.remove_hidden_options(config, whitelist)
