@@ -43,6 +43,15 @@ def validate(config):
     return True, "Valid beacon configuration"
 
 
+def _to_percent(value):
+    """
+    Normalize a threshold value (e.g. ``50``, ``"50"`` or ``"50%"``) to a float
+    """
+    if isinstance(value, str) and "%" in value:
+        value = re.sub("%", "", value)
+    return float(value)
+
+
 def beacon(config):
     r"""
     Monitor the disk usage of the minion
@@ -83,6 +92,24 @@ def beacon(config):
     which means that if a regular expression matches another defined mount point,
     it will override the previously defined threshold.
 
+    A mount can also be configured to alert when its usage drops below a
+    minimum, in addition to or instead of the maximum threshold above. This is
+    useful for mounts that are normally busy: a sudden drop to near-zero usage
+    usually means the filesystem failed to mount, and what is being measured
+    is really just the empty directory on the root filesystem. To configure
+    this, use a mapping with ``minimum`` and/or ``maximum`` keys instead of a
+    single value.
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /mnt/nfs:
+                minimum: 10%
+                maximum: 50%
+
+    ``minimum`` and ``maximum`` may each be used on their own.
+
     """
     whitelist = []
     config = salt.utils.beacons.remove_hidden_options(config, whitelist)
