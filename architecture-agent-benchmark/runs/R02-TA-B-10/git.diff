+def test_low_usage_config_missing_min_and_max():
+    config = [{"/": {}}]
+
+    ret = diskusage.validate(config)
+    assert ret == (
+        False,
+        "Configuration for diskusage beacon: mount / must specify a min, a"
+        " max, or both.",
+    )
+
+
+def test_diskusage_min_triggers_below_threshold(stub_disk_partition):
+    stub_usage = [
+        namedtuple("usage", "total used free percent")(1000, 50, 950, 5),
+        namedtuple("usage", "total used free percent")(100, 75, 25, 75),
+    ]
+    disk_usage_mock = Mock(side_effect=stub_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        config = [{"/": {"min": "10%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == [{"diskusage": 5, "mount": "/", "type": "low"}]
+
+
+def test_diskusage_min_no_trigger_above_threshold(stub_disk_usage, stub_disk_partition):
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        config = [{"/": {"min": "10%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == []
+
+
+def test_diskusage_min_and_max_together(stub_disk_partition):
+    stub_usage = [
+        namedtuple("usage", "total used free percent")(1000, 50, 950, 5),
+        namedtuple("usage", "total used free percent")(100, 75, 25, 75),
+    ]
+    disk_usage_mock = Mock(side_effect=stub_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        config = [{"/": {"min": "10%", "max": "80%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == [{"diskusage": 5, "mount": "/", "type": "low"}]
+
+
+def test_diskusage_max_dict_style_matches_scalar_output(
+    stub_disk_usage, stub_disk_partition
+):
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        config = [{"/": {"max": "50%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == [{"diskusage": 50, "mount": "/"}]
