@@ -40,9 +40,30 @@ def validate(config):
     # Configuration for diskusage beacon should be a list of dicts
     if not isinstance(config, list):
         return False, "Configuration for diskusage beacon must be a list."
+
+    for mounts in config:
+        for mount, monitor_usage in mounts.items():
+            if not isinstance(monitor_usage, dict):
+                continue
+            if not {"above", "below"} & set(monitor_usage):
+                return (
+                    False,
+                    f"Configuration for diskusage beacon: mount {mount} must "
+                    "define 'above' and/or 'below'.",
+                )
+
     return True, "Valid beacon configuration"
 
 
+def _to_percent(value):
+    """
+    Normalize a configured threshold (e.g. ``"63%"``, ``63``) to a float.
+    """
+    if isinstance(value, str) and "%" in value:
+        value = re.sub("%", "", value)
+    return float(value)
+
+
 def beacon(config):
     r"""
     Monitor the disk usage of the minion
@@ -83,6 +104,22 @@ def beacon(config):
     which means that if a regular expression matches another defined mount point,
     it will override the previously defined threshold.
 
+    A mount can also alert when its usage drops *below* a threshold, which is
+    useful for catching a filesystem that silently failed to mount (leaving an
+    empty directory on the root filesystem in its place) on a mount point that
+    is normally busy. To configure this, replace the scalar threshold with a
+    mapping that has an ``above`` and/or a ``below`` key. ``above`` behaves
+    exactly like the plain scalar form used today.
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /: 63%
+            - /mnt/nfs:
+                above: 50%
+                below: 10%
+
     """
     whitelist = []
     config = salt.utils.beacons.remove_hidden_options(config, whitelist)
@@ -118,9 +155,25 @@ def beacon(config):
 
                 current_usage = _current_usage.percent
                 monitor_usage = mounts[mount]
-                if isinstance(monitor_usage, str) and "%" in monitor_usage:
-                    monitor_usage = re.sub("%", "", monitor_usage)
-                monitor_usage = float(monitor_usage)
-                if current_usage >= monitor_usage:
+
+                if isinstance(monitor_usage, dict):
+                    above = monitor_usage.get("above")
+                    below = monitor_usage.get("below")
+                else:
+                    # Preserve today's behavior: a bare scalar is a
+                    # "usage rose above this threshold" alert.
+                    above = monitor_usage
+                    below = None
+
+                if above is not None and current_usage >= _to_percent(above):
                     ret.append({"diskusage": current_usage, "mount": _mount})
+
+                if below is not None and current_usage <= _to_percent(below):
+                    ret.append(
+                        {
+                            "diskusage": current_usage,
+                            "mount": _mount,
+                            "match": "below",
+                        }
+                    )
     return ret
diff --git a/tests/pytests/unit/beacons/test_diskusage.py b/tests/pytests/unit/beacons/test_diskusage.py
