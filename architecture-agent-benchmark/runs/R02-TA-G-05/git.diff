@@ -83,6 +93,28 @@ def beacon(config):
     which means that if a regular expression matches another defined mount point,
     it will override the previously defined threshold.
 
+    A mount can also be configured to alert when its usage drops below an
+    expected minimum, in addition to (or instead of) the existing "usage rose
+    above a maximum" alerting. This is useful for catching a mount that
+    normally runs busy but suddenly shows very low usage, which is often a
+    sign that the filesystem failed to mount and the path is actually just an
+    empty directory on the root filesystem. To configure this, use a mapping
+    with ``maximum`` and/or ``minimum`` keys instead of a bare percentage:
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /mnt/nfs:
+                minimum: 10%
+            - /mnt/data:
+                maximum: 90%
+                minimum: 5%
+
+    Any mount configured with a bare percentage, as in the earlier examples,
+    keeps behaving exactly as before and is only checked against a maximum
+    threshold.
+
     """
     whitelist = []
     config = salt.utils.beacons.remove_hidden_options(config, whitelist)
