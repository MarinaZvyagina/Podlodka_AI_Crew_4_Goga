+def _to_float(value):
+    """
+    Normalize a configured threshold (which may be a percent string like
+    "63%" or a bare number) to a float.
+    """
+    if isinstance(value, str) and "%" in value:
+        value = re.sub("%", "", value)
+    return float(value)
