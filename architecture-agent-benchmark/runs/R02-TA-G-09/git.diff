+def test_diskusage_min_usage_match(stub_disk_usage, stub_disk_partition):
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        config = [{"/": {"min": "60%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == [{"diskusage": 50, "mount": "/", "type": "low"}]
+
+
+def test_diskusage_min_usage_nomatch(stub_disk_usage, stub_disk_partition):
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        config = [{"/": {"min": "10%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == []
+
+
+def test_diskusage_min_usage_no_percent(stub_disk_usage, stub_disk_partition):
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        config = [{"/": {"min": 60}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == [{"diskusage": 50, "mount": "/", "type": "low"}]
+
+
+def test_diskusage_min_and_max_usage(stub_disk_usage, stub_disk_partition):
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        # / reports 50% usage: below max (90%) and above min (10%), so
+        # neither threshold should fire.
+        config = [{"/": {"min": "10%", "max": "90%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == []
+
+
+def test_diskusage_max_usage_dict_still_matches(stub_disk_usage, stub_disk_partition):
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        config = [{"/": {"max": "50%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == [{"diskusage": 50, "mount": "/"}]
+
