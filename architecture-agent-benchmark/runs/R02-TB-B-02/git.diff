+    def beacon_status(self, name=None):
+        """
+        Return the last time each configured beacon actually executed and
+        whether that execution raised an error.
+
+        A beacon that is configured but has not fired yet (e.g. it is
+        waiting on its first interval, or beacons were only just enabled)
+        reports ``last_run: None`` rather than a stale or fabricated value.
+
+        name: Restrict the status to a single beacon, if given.
+        """
+        beacons = self._get_beacons()
+
+        if name is not None:
+            if name not in beacons:
+                with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+                    evt.fire_event(
+                        {
+                            "complete": False,
+                            "comment": f"Beacon {name} is not configured.",
+                        },
+                        tag="/salt/minion/minion_beacon_status_complete",
+                    )
+                return True
+            names = [name]
+        else:
+            names = [_name for _name in beacons if _name != "enabled"]
+
+        status = {}
+        for _name in names:
+            info = self.status_store.get(_name)
+            if info is None:
+                status[_name] = {
+                    "last_run": None,
+                    "last_error": None,
+                    "last_error_message": None,
+                }
+            else:
+                status[_name] = dict(info)
+
+        # Fire the complete event back along with the beacon status
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacons": status},
+                tag="/salt/minion/minion_beacon_status_complete",
+            )
+
+        return True
+
