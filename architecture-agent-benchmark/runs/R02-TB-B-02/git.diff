+@pytest.mark.slow_test
+def test_status():
+    """
+    Test querying beacon status.
+    """
+    event_returns = [
+        {
+            "complete": True,
+            "tag": "/salt/minion/minion_beacon_status_complete",
+            "beacons": {
+                "ps": {
+                    "last_run": 1234567890.0,
+                    "last_error": False,
+                    "last_error_message": None,
+                },
+                "inotify": {
+                    "last_run": None,
+                    "last_error": None,
+                    "last_error_message": None,
+                },
+            },
+        },
+    ]
+
+    mock = MagicMock(return_value=True)
+    with patch.dict(beacons.__salt__, {"event.fire": mock}):
+        with patch.object(SaltEvent, "get_event", side_effect=event_returns):
+            ret = beacons.status()
+            assert ret["ps"]["last_error"] is False
+            assert ret["inotify"]["last_run"] is None
+
+
