+def test_beacon_process_records_status_on_success(minion_opts):
+    """
+    Test that process() records a last_run timestamp and no error for a
+    beacon that fires successfully.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {"status": [{"time": ["all"]}]}
+
+    beacon_mock = MagicMock(return_value=[])
+    beacon_mock.__globals__ = {}
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.beacons["status.beacon"] = beacon_mock
+
+    assert beacon.status_store == {}
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    assert "status" in beacon.status_store
+    info = beacon.status_store["status"]
+    assert info["last_run"] is not None
+    assert info["last_error"] is False
+    assert info["last_error_message"] is None
+
+
+def test_beacon_process_records_status_on_error(minion_opts):
+    """
+    Test that process() records a last_run timestamp and the error message
+    for a beacon whose beacon() function raises.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+    beacon_mock = MagicMock(side_effect=Exception("Global Thermonuclear War"))
+    beacon_mock.__globals__ = {}
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.beacons["ps.beacon"] = beacon_mock
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    info = beacon.status_store["watch_apache"]
+    assert info["last_run"] is not None
+    assert info["last_error"] is True
+    assert info["last_error_message"] == "Global Thermonuclear War"
+
+
