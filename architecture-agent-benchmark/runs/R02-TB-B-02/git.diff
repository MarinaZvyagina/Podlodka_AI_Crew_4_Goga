         return {"beacons": {}}
 
 
+def status(name=None, **kwargs):
+    """
+    Return when each configured beacon last actually executed, and whether
+    that execution raised an error. This is live data collected by the
+    running minion as beacons fire, not something read from logs or
+    requiring a new probe cycle.
+
+    A beacon that is configured but has not fired yet reports ``last_run``
+    as ``None`` rather than a stale or fabricated value.
+
+    :param name:    Restrict the status to a single beacon, default is to
+                    report on all configured beacons.
+    :return:        Dict keyed by beacon name, each containing ``last_run``
+                    (epoch timestamp, or ``None`` if the beacon has not
+                    fired yet), ``last_error`` (``True``/``False``, or
+                    ``None`` if the beacon has not fired yet), and
+                    ``last_error_message`` (the error string, or ``None``).
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+
+        salt '*' beacons.status ps
+    """
+    beacon_status = None
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {"func": "status", "name": name}, "manage_beacons"
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacon_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                if event_ret and event_ret["complete"]:
+                    beacon_status = event_ret["beacons"]
+                elif event_ret:
+                    return {"result": False, "comment": event_ret["comment"]}
+                else:
+                    return {
+                        "result": False,
+                        "comment": (
+                            "Did not receive the beacon status complete event"
+                            " before the timeout of {}s".format(
+                                kwargs.get("timeout", default_event_wait)
+                            )
+                        ),
+                    }
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        return {
+            "result": False,
+            "comment": "Event module not available. Beacon status failed.",
+        }
+
+    if beacon_status is None:
+        return {}
+    return beacon_status
+
+
