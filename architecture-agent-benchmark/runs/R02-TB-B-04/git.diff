+def test_beacon_process_records_status(minion_opts):
+    """
+    Test that a successful beacon run records a last_fired time and a
+    ``None`` last_error in beacon_status.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+    beacon = salt.beacons.Beacon(minion_opts, [])
+
+    with patch("salt.beacons.time.time", return_value=12345.0):
+        beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    assert beacon.beacon_status["watch_apache"] == {
+        "last_fired": 12345.0,
+        "last_error": None,
+    }
+
+
+def test_beacon_process_records_error_status(minion_opts):
+    """
+    Test that a beacon run that raises an exception records a last_fired
+    time and the error message in beacon_status.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+    beacon_mock = MagicMock(side_effect=Exception("Global Thermonuclear War"))
+    beacon_mock.__globals__ = {}
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.beacons["ps.beacon"] = beacon_mock
+
+    with patch("salt.beacons.time.time", return_value=12345.0):
+        beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    assert beacon.beacon_status["watch_apache"] == {
+        "last_fired": 12345.0,
+        "last_error": "Global Thermonuclear War",
+    }
+
+
+def test_list_beacon_status_never_fired(minion_opts):
+    """
+    Test that a configured beacon that has never fired reports
+    last_fired/last_error as None instead of a stale or made-up value.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
