+    beacon = salt.beacons.Beacon(minion_opts, [])
+
+    with patch("salt.utils.event.get_event") as get_event_mock:
+        beacon.list_beacon_status()
+
+    evt = get_event_mock.return_value.__enter__.return_value
+    fired_event = evt.fire_event.call_args[0][0]
+    assert fired_event == {
+        "complete": True,
+        "beacon_status": {
+            "watch_apache": {"last_fired": None, "last_error": None}
