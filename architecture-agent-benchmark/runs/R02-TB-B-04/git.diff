         return {"beacons": {}}
 
 
+def status(name=None, return_yaml=True, **kwargs):
+    """
+    Return the last time each configured beacon fired and whether that
+    last run raised an error. This reflects live beacon activity in the
+    running minion process, without needing to wait for another probe
+    cycle, read log files, or restart the minion.
+
+    :param name:            Name of a specific beacon to return status for.
+                            If not passed, status is returned for every
+                            currently configured beacon.
+
+    :param return_yaml:     Whether to return YAML formatted output,
+                           default ``True``
+
+    :return:                Dictionary, keyed by beacon name, of
+                           ``last_fired`` (epoch time of the last execution)
+                           and ``last_error`` (the error raised by the last
+                           execution, or ``None`` if it succeeded). A beacon
+                           that has not fired yet has both fields set to
+                           ``None``.
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+        salt '*' beacons.status name=inotify
+
+    """
+    beacon_status = None
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {"func": "status", "name": name}, "manage_beacons"
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacon_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                log.debug("event_ret %s", event_ret)
+                if event_ret and event_ret["complete"]:
+                    beacon_status = event_ret["beacon_status"]
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+        return ret
+
+    if beacon_status is None:
+        beacon_status = {}
+
+    if return_yaml:
+        tmp = {"beacons": beacon_status}
+        return salt.utils.yaml.safe_dump(tmp, default_flow_style=False)
+    else:
+        return beacon_status
+
+
