+def status(**kwargs):
+    """
+    Return the last-run status of the beacons currently configured on the minion
+
+    For every configured beacon this reports the epoch time it was last
+    actually fired, and the error message from that execution if it failed
+    (for example because a watched file was deleted, a monitored process
+    stopped existing, or a dependency the beacon relies on started
+    erroring out). This reflects live beacon activity on the running
+    minion, not log files, and does not require waiting for a new beacon
+    cycle or restarting the minion. Beacons that have not fired yet report
+    ``last_run`` as ``None``.
+
+    :return:                Dictionary keyed by beacon name, each containing
+                             ``last_run`` (epoch time or ``None``) and
+                             ``last_error`` (error string or ``None``).
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+
+    """
+    beacon_status = None
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"]({"func": "status"}, "manage_beacons")
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacons_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                log.debug("event_ret %s", event_ret)
+                if event_ret and event_ret["complete"]:
+                    beacon_status = event_ret["beacons"]
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+        return ret
+
+    return beacon_status if beacon_status is not None else {}
+
+
