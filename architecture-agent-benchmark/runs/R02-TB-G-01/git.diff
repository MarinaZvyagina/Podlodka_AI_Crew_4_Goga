+    def beacon_status(self):
+        """
+        Return the last-run status of every currently configured beacon
+
+        For each configured beacon this reports the epoch time it was last
+        actually fired and the error (if any) that firing produced. Beacons
+        that have not fired yet report ``last_run`` and ``last_error`` as
+        ``None`` rather than a stale or made up value.
+        """
+        configured = self._get_beacons()
+
+        status = {}
+        for mod in configured:
+            if mod == "enabled":
+                continue
+            entry = self.status_map.get(mod)
+            if entry is None:
+                status[mod] = {"last_run": None, "last_error": None}
+            else:
+                status[mod] = dict(entry)
+
+        # Fire the complete event back along with the beacon status
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacons": status},
+                tag="/salt/minion/minion_beacons_status_complete",
+            )
+
+        return True
+
