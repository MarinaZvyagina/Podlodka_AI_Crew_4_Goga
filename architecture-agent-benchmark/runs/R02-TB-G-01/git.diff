+def test_beacon_process_records_status(minion_opts):
+    """
+    Test that a successful beacon run records a last_run timestamp
+    and no error in the status map.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    assert beacon.status_map == {}
+
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    assert "watch_apache" in beacon.status_map
+    entry = beacon.status_map["watch_apache"]
+    assert entry["last_run"] is not None
+    assert entry["last_error"] is None
+
+
+def test_beacon_process_records_error_status(minion_opts):
+    """
+    Test that a beacon run which raises records the error message
+    and a last_run timestamp in the status map.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+    beacon_mock = MagicMock(side_effect=Exception("Global Thermonuclear War"))
+    beacon_mock.__globals__ = {}
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.beacons["ps.beacon"] = beacon_mock
+
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    entry = beacon.status_map["watch_apache"]
+    assert entry["last_run"] is not None
+    assert entry["last_error"] == "Global Thermonuclear War"
+
+
