+def test_beacons_refresh_preserves_beacon_status(minion_opts):
+    """
+    Tests that 'beacons_refresh' preserves the beacon_status map so
+    last-run/error tracking for beacons.list_status is not reset by a
+    pillar/grains-triggered refresh.
+    """
+    with patch("salt.minion.Minion.ctx", MagicMock(return_value={})), patch(
+        "salt.utils.process.SignalHandlingProcess.start",
+        MagicMock(return_value=True),
+    ), patch(
+        "salt.utils.process.SignalHandlingProcess.join",
+        MagicMock(return_value=True),
+    ):
+        minion = None
+        try:
+            minion = salt.minion.Minion(
+                minion_opts,
+                io_loop=tornado.ioloop.IOLoop.current(),
+            )
+            minion.schedule = salt.utils.schedule.Schedule(
+                minion_opts, {}, returners={}
+            )
+
+            minion.module_refresh()
+            assert hasattr(minion, "beacons")
+            assert hasattr(minion.beacons, "beacon_status")
+
+            test_status_map = {
+                "status": {"last_run_time": 100.0, "last_error": None},
+                "diskusage": {"last_run_time": 200.0, "last_error": "boom"},
+            }
+            minion.beacons.beacon_status = test_status_map.copy()
+
+            old_beacons = minion.beacons
+
+            minion.beacons_refresh()
+
+            assert minion.beacons is not old_beacons
+
+            assert minion.beacons.beacon_status == test_status_map
+
+        finally:
+            if minion is not None:
+                minion.destroy()
+
+
