+    def list_status(self, include_pillar=True, include_opts=True):
+        """
+        Return the last execution time and error status of each configured
+        beacon item, as tracked live by the running beacon loop.
+
+        include_pillar: Whether to include beacons that are
+                        configured in pillar, default is True.
+
+        include_opts:   Whether to include beacons that are
+                        configured in opts, default is True.
+        """
+        beacons = self._get_beacons(
+            include_pillar=include_pillar, include_opts=include_opts
+        )
+
+        status = {}
+        for name in beacons:
+            if name == "enabled":
+                continue
+            if name in self.beacon_status:
+                status[name] = dict(self.beacon_status[name])
+            else:
+                # The beacon is configured but has not fired yet, so there
+                # is no real execution data to report.
+                status[name] = {"last_run_time": None, "last_error": None}
+
+        # Fire the complete event back along with the beacon status
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacon_status": status},
+                tag="/salt/minion/minion_beacons_status_complete",
+            )
+
+        return True
+
