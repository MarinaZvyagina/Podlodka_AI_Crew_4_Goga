diff --git a/salt/modules/beacons.py b/salt/modules/beacons.py
index e482abc..a5c4565 100644
--- a/salt/modules/beacons.py
+++ b/salt/modules/beacons.py
@@ -123,6 +123,78 @@ def list_available(return_yaml=True, **kwargs):
         return {"beacons": {}}
 
 
+def list_status(return_yaml=True, include_pillar=True, include_opts=True, **kwargs):
+    """
+    Show whether each of the beacons currently configured on the minion is
+    actually firing, by reporting the last time it executed and whether
+    that execution raised an error.
+
+    This is read live from the running beacon loop, so it reflects real
+    activity as it happens: it does not wait for a new probe cycle, does
+    not read log files, and does not require restarting the minion or
+    touching the beacon configuration. A beacon that is configured but has
+    not fired even once yet is reported with ``last_run_time`` and
+    ``last_error`` both set to ``None``.
+
+    :param return_yaml:    Whether to return YAML formatted output,
+                           default ``True``
+
+    :param include_pillar: Whether to include beacons that are
+                           configured in pillar, default is ``True``.
+
+    :param include_opts:   Whether to include beacons that are
+                           configured in opts, default is ``True``.
+
+    :return:               Dictionary keyed by beacon name, each containing
+                           ``last_run_time`` (epoch seconds of the last
+                           execution, or ``None`` if it has never run) and
+                           ``last_error`` (the error message from the last
+                           execution, or ``None`` if it succeeded or has
+                           never run).
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.list_status
+
+    """
+    beacon_status = None
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {
+                    "func": "list_status",
+                    "include_pillar": include_pillar,
+                    "include_opts": include_opts,
+                },
+                "manage_beacons",
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacons_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                log.debug("event_ret %s", event_ret)
+                if event_ret and event_ret["complete"]:
+                    beacon_status = event_ret["beacon_status"]
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+        return ret
+
+    if return_yaml:
+        tmp = {"beacon_status": beacon_status}
+        return salt.utils.yaml.safe_dump(tmp, default_flow_style=False)
+    else:
+        return beacon_status
+
+
