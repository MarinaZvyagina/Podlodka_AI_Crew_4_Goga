+    def beacon_status(self, name=None):
+        """
+        Return, for each currently configured beacon, the timestamp of its
+        last actual execution and the error (if any) that execution raised.
+
+        A beacon that is configured but has not fired yet is reported with
+        ``last_run`` and ``last_error`` both set to ``None``, rather than
+        being omitted or given a made-up value.
+
+        name: Only report on this beacon, if given.
+        """
+        beacons = self._get_beacons()
+
+        status = {}
+        for mod in beacons:
+            if mod == "enabled":
+                continue
+            if name and mod != name:
+                continue
+            entry = self.status_map.get(mod)
+            if entry is None:
+                status[mod] = {"last_run": None, "last_error": None}
+            else:
+                status[mod] = dict(entry)
+
+        # Fire the complete event back along with the status of the beacons
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacons": status},
+                tag="/salt/minion/minion_beacon_status_complete",
+            )
+
+        return True
