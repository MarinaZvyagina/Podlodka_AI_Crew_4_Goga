+    def beacon_status(self, name=None, fire_event=False):
+        """
+        Return the last time the specified beacon actually fired and
+        whether that firing raised an error.
+
+        If name is not given, status is returned for every currently
+        configured beacon. A beacon that is configured but has not fired
+        yet is reported with a last_fired of None, rather than being
+        omitted or given a made-up value.
+        """
+        configured = self._get_beacons()
+        if name:
+            mods = [name] if name in configured else []
+        else:
+            mods = [mod for mod in configured if mod != "enabled"]
+
+        data = {
+            mod: self.status.get(mod, {"last_fired": None, "last_error": None})
+            for mod in mods
+        }
+
+        if fire_event:
+            # Fire the complete event back along with the beacon status
+            with salt.utils.event.get_event(
+                "minion", opts=self.opts, listen=False
+            ) as evt:
+                evt.fire_event(
+                    {"complete": True, "beacons": data},
+                    tag="/salt/minion/minion_beacon_status_complete",
+                )
+            return True
+
+        return data
