+            "beacons": {
+                "ps": {
+                    "last_fired": datetime.datetime(2026, 8, 27, 12, 0, 0),
+                    "last_error": None,
+                },
+                "inotify": {"last_fired": None, "last_error": None},
+            },
+        },
