+def test_beacon_status_records_last_fired_on_success(minion_opts):
+    """
+    Test that process() records a last_fired timestamp and a None
+    last_error for a beacon that fires successfully.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    assert "watch_apache" in beacon.status
+    assert isinstance(beacon.status["watch_apache"]["last_fired"], datetime.datetime)
+    assert beacon.status["watch_apache"]["last_error"] is None
+
+
