+def status(name=None, time_fmt="%Y-%m-%dT%H:%M:%S", **kwargs):
+    """
+    Show when the specified beacon last actually fired and whether that
+    firing raised an error. This reflects live beacon activity tracked by
+    the running minion process, not log files, so it is accurate as of the
+    beacon's most recent execution and does not require waiting for a new
+    probe cycle.
+
+    :param name:      Name of the beacon to check, optional. If not given,
+                       status is returned for every beacon currently
+                       configured on the minion.
+    :param time_fmt:  The strftime format used for ``last_fired``, default
+                       ``"%Y-%m-%dT%H:%M:%S"``.
+    :return:          Dictionary keyed by beacon name. Each value has
+                      ``last_fired`` (timestamp of the beacon's last
+                      execution, or ``None`` if it has never fired) and
+                      ``last_error`` (the error raised by the last
+                      execution, or ``None`` if it succeeded or has never
+                      fired).
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+
+        salt '*' beacons.status ps
+    """
+
+    def _convert(data_dict):
+        return {
+            key: (
+                value.strftime(time_fmt)
+                if isinstance(value, datetime.datetime)
+                else value
+            )
+            for key, value in data_dict.items()
+        }
+
+    beacon_status = {}
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {"func": "status", "name": name}, "manage_beacons"
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacon_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                if event_ret and event_ret["complete"]:
+                    beacon_status = {
+                        bname: _convert(bdata)
+                        for bname, bdata in event_ret["beacons"].items()
+                    }
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+        return ret
+
+    return beacon_status
+
+
