@@ -0,0 +1,326 @@
+r"""
+SQLite3
+=======
+
+SQLite3 plugin for the Salt caching subsystem.
+
+.. versionadded:: 3009.0
+
+This backend is meant for small, single-master deployments where an
+operator wants the minion data cache (grains, mine data, job returns, and
+similar) to survive a restart of the master, but does not want to stand up
+and operate a separate database service such as Redis or MySQL just to get
+that durability. It stores all cached data in a single ordinary file on
+disk using :mod:`sqlite3 <python:sqlite3>`, which ships with every standard
+Python installation -- no extra services or third-party packages required.
+
+Because the data lives in one local file, this backend is only suitable
+for a single master reading and writing that file (or the file living on
+shared storage a single active master accesses at a time). Deployments
+that need multiple masters or syndics to share cache data concurrently
+should use one of the networked backends (``consul``, ``etcd``, ``etcd3``,
+``mysql``, ``redis``) instead.
+
+To enable this cache plugin, set the master ``cache`` config value to
+``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+Optional configuration (defaults shown):
+
+.. code-block:: yaml
+
+    # Path to the SQLite database file. Defaults to a file named
+    # ``cache.sqlite3`` inside the master's ``cachedir``.
+    sqlite3.file: /var/cache/salt/master/cache.sqlite3
+
+    # Number of seconds a write will wait for a lock held by another
+    # process before giving up. Only matters if something else besides
+    # the master (e.g. a syndic sharing the same cachedir) touches the
+    # same file concurrently.
+    sqlite3.timeout: 5.0
+
+The database is created automatically, along with its containing
+directory, the first time the cache is used. A single table holds every
+bank/key pair, so restarting the master does not lose any previously
+cached data.
+"""
+
+import logging
+import os
+import sqlite3
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+_DEFAULT_TIMEOUT = 5.0
+_TABLE = "cache"
+
+# Guards creation/teardown of the module-level connection so concurrent
+# threads within the same process don't race to open/close it, and
+# serializes access to the connection itself since sqlite3 connections
+# opened with check_same_thread=False are not safe for concurrent use.
+_lock = threading.Lock()
+
+
+def __virtual__():
+    return __virtualname__
+
+
+def _default_file():
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    return os.path.join(cachedir, "cache.sqlite3")
+
+
+def _cache_file(kwargs=None):
+    if kwargs and kwargs.get("sqlite3_file"):
+        return kwargs["sqlite3_file"]
+    return __opts__.get("sqlite3.file", _default_file())
+
+
+def init_kwargs(kwargs):
+    """
+    Return the canonical keyword arguments for this cache driver.
+    """
+    return {"sqlite3_file": _cache_file(kwargs)}
+
+
+def get_storage_id(kwargs):
+    """
+    Return a unique identifier for this cache driver instance.
+    """
+    return ("sqlite3", _cache_file(kwargs))
+
+
+def _connect(sqlite3_file):
+    """
+    Return the module-level connection for ``sqlite3_file``, opening (and
+    creating the schema for) a new one if needed or if the configured path
+    changed.
+    """
+    with _lock:
+        conn = __context__.get("sqlite3_conn")
+        if conn is not None and __context__.get("sqlite3_file") == sqlite3_file:
+            return conn
+
+        if conn is not None:
+            try:
+                conn.close()
+            except sqlite3.Error:
+                pass
+
+        directory = os.path.dirname(sqlite3_file)
+        if directory and not os.path.isdir(directory):
+            try:
+                os.makedirs(directory)
+            except OSError as exc:
+                raise SaltCacheError(
+                    f"sqlite3 cache: could not create cache directory "
+                    f"{directory}: {exc}"
+                ) from exc
+
+        timeout = __opts__.get("sqlite3.timeout", _DEFAULT_TIMEOUT)
+        try:
+            conn = sqlite3.connect(
+                sqlite3_file,
+                timeout=timeout,
+                isolation_level=None,  # autocommit: each statement commits itself
+                check_same_thread=False,
+            )
+            try:
+                # Lets concurrent readers proceed while a write is in
+                # flight. Not fatal if the filesystem doesn't support it
+                # (e.g. some network mounts); fall back to the default
+                # rollback journal in that case.
+                conn.execute("PRAGMA journal_mode=WAL")
+            except sqlite3.Error:
+                log.debug(
+                    "sqlite3 cache: could not enable WAL mode for %s",
+                    sqlite3_file,
+                    exc_info=True,
+                )
+            conn.execute("PRAGMA synchronous=NORMAL")
+            conn.execute(
+                f"""
+                CREATE TABLE IF NOT EXISTS {_TABLE} (
+                    bank TEXT NOT NULL,
+                    key TEXT NOT NULL,
+                    data BLOB NOT NULL,
+                    updated INTEGER NOT NULL,
+                    PRIMARY KEY (bank, key)
+                )
+                """
+            )
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f"sqlite3 cache: error opening {sqlite3_file}: {exc}"
+            ) from exc
+
+        __context__["sqlite3_conn"] = conn
+        __context__["sqlite3_file"] = sqlite3_file
+        return conn
+
+
+def store(bank, key, data, sqlite3_file=None, **kwargs):
+    """
+    Store a key value.
+    """
+    if sqlite3_file is None:
+        sqlite3_file = _cache_file()
+    conn = _connect(sqlite3_file)
+    payload = salt.payload.dumps(data)
+    now = int(time.time())
+    try:
+        with _lock:
+            conn.execute(
+                f"INSERT OR REPLACE INTO {_TABLE} "
+                "(bank, key, data, updated) VALUES (?, ?, ?, ?)",
+                (bank, key, payload, now),
+            )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"sqlite3 cache: error storing {bank}/{key}: {exc}"
+        ) from exc
+
+
+def fetch(bank, key, sqlite3_file=None, **kwargs):
+    """
+    Fetch a key value.
+    """
+    if sqlite3_file is None:
+        sqlite3_file = _cache_file()
+    conn = _connect(sqlite3_file)
+    try:
+        with _lock:
+            row = conn.execute(
+                f"SELECT data FROM {_TABLE} WHERE bank=? AND key=?", (bank, key)
+            ).fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"sqlite3 cache: error fetching {bank}/{key}: {exc}"
+        ) from exc
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key, sqlite3_file=None, **kwargs):
+    """
+    Return the Unix epoch of the last update for this bank/key, or ``None``
+    if it doesn't exist.
+    """
+    if sqlite3_file is None:
+        sqlite3_file = _cache_file()
+    conn = _connect(sqlite3_file)
+    try:
+        with _lock:
+            row = conn.execute(
+                f"SELECT updated FROM {_TABLE} WHERE bank=? AND key=?", (bank, key)
+            ).fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"sqlite3 cache: error reading timestamp for {bank}/{key}: {exc}"
+        ) from exc
+    return int(row[0]) if row else None
+
+
+def flush(bank, key=None, sqlite3_file=None, **kwargs):
+    """
+    Remove the key from the cache bank with all the key content. If no key
+    is specified, remove the entire bank.
+    """
+    if sqlite3_file is None:
+        sqlite3_file = _cache_file()
+    conn = _connect(sqlite3_file)
+    try:
+        with _lock:
+            if key is None:
+                cur = conn.execute(f"DELETE FROM {_TABLE} WHERE bank=?", (bank,))
+            else:
+                cur = conn.execute(
+                    f"DELETE FROM {_TABLE} WHERE bank=? AND key=?", (bank, key)
+                )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"sqlite3 cache: error flushing {bank}/{key}: {exc}"
+        ) from exc
+    return cur.rowcount > 0
+
+
+def list_(bank, sqlite3_file=None, **kwargs):
+    """
+    Return an iterable object containing all entries stored in the
+    specified bank.
+    """
+    if sqlite3_file is None:
+        sqlite3_file = _cache_file()
+    conn = _connect(sqlite3_file)
+    try:
+        with _lock:
+            rows = conn.execute(
+                f"SELECT key FROM {_TABLE} WHERE bank=?", (bank,)
+            ).fetchall()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"sqlite3 cache: error listing bank {bank}: {exc}"
+        ) from exc
+    return [row[0] for row in rows]
+
+
+def list_all(bank, sqlite3_file=None, include_data=False, **kwargs):
+    """
+    Return ``{key: data}`` for every entry in the bank in a single query.
+    """
+    if sqlite3_file is None:
+        sqlite3_file = _cache_file()
+    conn = _connect(sqlite3_file)
+    try:
+        with _lock:
+            if include_data:
+                rows = conn.execute(
+                    f"SELECT key, data FROM {_TABLE} WHERE bank=?", (bank,)
+                ).fetchall()
+                return {row[0]: salt.payload.loads(row[1]) for row in rows}
+            rows = conn.execute(
+                f"SELECT key FROM {_TABLE} WHERE bank=?", (bank,)
+            ).fetchall()
+            return {row[0]: {} for row in rows}
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"sqlite3 cache: error listing bank {bank}: {exc}"
+        ) from exc
+
+
+def contains(bank, key, sqlite3_file=None, **kwargs):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    if sqlite3_file is None:
+        sqlite3_file = _cache_file()
+    conn = _connect(sqlite3_file)
+    try:
+        with _lock:
+            if key is None:
+                row = conn.execute(
+                    f"SELECT 1 FROM {_TABLE} WHERE bank=? LIMIT 1", (bank,)
+                ).fetchone()
+            else:
+                row = conn.execute(
+                    f"SELECT 1 FROM {_TABLE} WHERE bank=? AND key=? LIMIT 1",
+                    (bank, key),
+                ).fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"sqlite3 cache: error checking {bank}/{key}: {exc}"
+        ) from exc
+    return row is not None
