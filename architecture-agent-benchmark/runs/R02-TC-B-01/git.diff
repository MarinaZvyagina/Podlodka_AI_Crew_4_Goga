@@ -0,0 +1,60 @@
+import logging
+import shutil
+from pathlib import Path
+
+import pytest
+
+import salt.cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def cache(minion_opts):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    cache = salt.cache.factory(opts)
+    try:
+        yield cache
+    finally:
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_data_survives_a_restart(minion_opts):
+    """
+    The whole point of the sqlite3 backend is that data stored before a
+    master restart is still there afterwards. Simulate a restart by
+    creating a brand new Cache object (and thus a brand new sqlite3
+    connection) pointed at the same cachedir, and confirm it can see what
+    the first one wrote.
+    """
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    try:
+        first = salt.cache.factory(opts)
+        first.store("grains", "myminion", {"os": "Linux", "num_cpus": 4})
+
+        second = salt.cache.factory(opts)
+        assert second.fetch("grains", "myminion") == {
+            "os": "Linux",
+            "num_cpus": 4,
+        }
+        assert second.list("grains") == ["myminion"]
+    finally:
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
+
+
+def test_default_file_lives_in_cachedir(minion_opts):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    try:
+        cache = salt.cache.factory(opts)
+        cache.store("bank", "key", "data")
+        assert (Path(opts["cachedir"]) / "cache.sqlite3").exists()
+    finally:
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
