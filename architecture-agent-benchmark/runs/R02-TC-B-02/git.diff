@@ -0,0 +1,273 @@
+"""
+Cache data in a single SQLite3 database file.
+
+.. versionadded:: 3008.0
+
+The ``sqlite3`` cache module stores the minion data cache (cached grains,
+mine data, job returns, etc.) in one SQLite database file instead of a
+directory tree of files (``localfs``) or an external database service
+(``mysql``, ``redis``, ...). It only relies on the ``sqlite3`` module from
+the Python standard library, so no additional services or third-party
+packages need to be installed.
+
+Because the data is written to a file on disk, it survives a restart of the
+master process, same as ``localfs``.
+
+To enable this cache backend, set the master ``cache`` config value to
+``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+The following values can optionally be set in the master config to control
+where and how the database is created. These are the defaults:
+
+.. code-block:: yaml
+
+    sqlite3.database: <cachedir>/cache.sqlite3
+    sqlite3.table_name: cache
+    sqlite3.timeout: 30
+
+.. warning::
+
+    The ``sqlite3.table_name`` value is interpolated directly into SQL
+    statements. Salt treats this value, which comes from the master
+    configuration file, as trusted input.
+"""
+
+import logging
+import os
+import sqlite3
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+import salt.utils.path
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+_DEFAULT_TABLE_NAME = "cache"
+_DEFAULT_TIMEOUT = 30
+
+
+def __virtual__():
+    return __virtualname__
+
+
+def __cachedir(kwargs=None):
+    if kwargs and "cachedir" in kwargs:
+        return kwargs["cachedir"]
+    return __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+
+
+def init_kwargs(kwargs):
+    return {"cachedir": __cachedir(kwargs)}
+
+
+def get_storage_id(kwargs):
+    return ("sqlite3", _database_path(__cachedir(kwargs)))
+
+
+def _database_path(cachedir):
+    return __opts__.get("sqlite3.database") or salt.utils.path.join(
+        cachedir, "cache.sqlite3"
+    )
+
+
+def _table_name():
+    return __opts__.get("sqlite3.table_name", _DEFAULT_TABLE_NAME)
+
+
+def _connect(db_path):
+    base = os.path.dirname(db_path)
+    if base and not os.path.isdir(base):
+        try:
+            os.makedirs(base)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"The cache directory, {base}, could not be created: {exc}"
+            )
+
+    timeout = __opts__.get("sqlite3.timeout", _DEFAULT_TIMEOUT)
+    try:
+        conn = sqlite3.connect(
+            db_path,
+            timeout=timeout,
+            isolation_level=None,
+            check_same_thread=False,
+        )
+        # WAL mode plus a busy timeout lets multiple master worker
+        # processes hit the same database file concurrently instead of
+        # raising "database is locked" on the first writer collision.
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute(f"PRAGMA busy_timeout={int(timeout * 1000)}")
+        conn.execute(
+            "CREATE TABLE IF NOT EXISTS {} ("
+            "bank TEXT NOT NULL, "
+            "cache_key TEXT NOT NULL, "
+            "data BLOB, "
+            "last_update REAL NOT NULL, "
+            "PRIMARY KEY(bank, cache_key))".format(_table_name())
+        )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f'There was an error connecting to the cache database "{db_path}": {exc}'
+        )
+    return conn
+
+
+def _get_conn(cachedir):
+    """
+    Return the (connection, lock) pair for this database file, connecting
+    lazily and caching the result for the lifetime of the process.
+
+    The lock serializes access to the connection: it was opened with
+    ``check_same_thread=False`` so a single master worker process can
+    share it across threads, and sqlite3 connections are not safe for
+    concurrent use without external locking.
+    """
+    db_path = _database_path(cachedir)
+    clients = __context__.setdefault("sqlite3_clients", {})
+    if db_path not in clients:
+        clients[db_path] = (_connect(db_path), threading.Lock())
+    return clients[db_path]
+
+
+def store(bank, key, data, cachedir):
+    """
+    Store information in the cache database.
+    """
+    conn, lock = _get_conn(cachedir)
+    payload = salt.payload.dumps(data)
+    try:
+        with lock:
+            conn.execute(
+                "INSERT OR REPLACE INTO {} "
+                "(bank, cache_key, data, last_update) VALUES (?, ?, ?, ?)".format(
+                    _table_name()
+                ),
+                (bank, key, payload, time.time()),
+            )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f'There was an error writing the cache entry "{bank}/{key}": {exc}'
+        )
+
+
+def fetch(bank, key, cachedir):
+    """
+    Fetch information from the cache database.
+    """
+    conn, lock = _get_conn(cachedir)
+    try:
+        with lock:
+            cur = conn.execute(
+                "SELECT data FROM {} WHERE bank=? AND cache_key=?".format(
+                    _table_name()
+                ),
+                (bank, key),
+            )
+            row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f'There was an error reading the cache entry "{bank}/{key}": {exc}'
+        )
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key, cachedir):
+    """
+    Return the epoch of the last update for this cache entry.
+    """
+    conn, lock = _get_conn(cachedir)
+    try:
+        with lock:
+            cur = conn.execute(
+                "SELECT last_update FROM {} WHERE bank=? AND cache_key=?".format(
+                    _table_name()
+                ),
+                (bank, key),
+            )
+            row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f'There was an error reading the update time for "{bank}/{key}": {exc}'
+        )
+    if row is None:
+        return None
+    return int(row[0])
+
+
+def flush(bank, key=None, cachedir=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key
+    is specified, remove the entire bank.
+    """
+    if cachedir is None:
+        cachedir = __cachedir()
+    conn, lock = _get_conn(cachedir)
+    try:
+        with lock:
+            if key is None:
+                cur = conn.execute(
+                    "DELETE FROM {} WHERE bank=?".format(_table_name()), (bank,)
+                )
+            else:
+                cur = conn.execute(
+                    "DELETE FROM {} WHERE bank=? AND cache_key=?".format(
+                        _table_name()
+                    ),
+                    (bank, key),
+                )
+            rowcount = cur.rowcount
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f'There was an error removing "{bank}/{key}": {exc}')
+    return rowcount > 0
+
+
+def list_(bank, cachedir):
+    """
+    Return an iterable object containing all entries stored in the
+    specified bank.
+    """
+    conn, lock = _get_conn(cachedir)
+    try:
+        with lock:
+            cur = conn.execute(
+                "SELECT cache_key FROM {} WHERE bank=?".format(_table_name()), (bank,)
+            )
+            return [row[0] for row in cur.fetchall()]
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f'There was an error listing the bank "{bank}": {exc}')
+
+
+def contains(bank, key, cachedir):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    conn, lock = _get_conn(cachedir)
+    try:
+        with lock:
+            if key is None:
+                cur = conn.execute(
+                    "SELECT 1 FROM {} WHERE bank=? LIMIT 1".format(_table_name()),
+                    (bank,),
+                )
+            else:
+                cur = conn.execute(
+                    "SELECT 1 FROM {} WHERE bank=? AND cache_key=? LIMIT 1".format(
+                        _table_name()
+                    ),
+                    (bank, key),
+                )
+            return cur.fetchone() is not None
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f'There was an error checking the cache "{bank}": {exc}')
