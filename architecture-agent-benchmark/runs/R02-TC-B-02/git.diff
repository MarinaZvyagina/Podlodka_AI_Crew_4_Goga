@@ -0,0 +1,57 @@
+import logging
+import os
+import shutil
+
+import pytest
+
+import salt.cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def cache(minion_opts):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    cache = salt.cache.factory(opts)
+    try:
+        yield cache
+    finally:
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_data_survives_a_master_restart(minion_opts):
+    """
+    The whole point of the sqlite3 cache is that data written before a
+    master restart is still there afterwards. Simulate a restart by
+    throwing away the Cache object (and its cached db connection in
+    __context__) and creating a brand new one pointed at the same
+    cachedir/database file.
+    """
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    try:
+        first = salt.cache.factory(opts)
+        first.store("minions/alpha", "grains", {"os": "Linux"})
+
+        second = salt.cache.factory(opts)
+        assert second is not first
+        assert second.fetch("minions/alpha", "grains") == {"os": "Linux"}
+    finally:
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
+
+
+def test_default_database_lives_under_cachedir(minion_opts):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    try:
+        cache = salt.cache.factory(opts)
+        cache.store("bank", "key", "value")
+        assert os.path.isfile(os.path.join(opts["cachedir"], "cache.sqlite3"))
+    finally:
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
