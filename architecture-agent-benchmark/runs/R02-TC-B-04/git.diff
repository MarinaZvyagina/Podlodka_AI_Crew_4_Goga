@@ -0,0 +1,210 @@
+"""
+Minion data cache plugin for SQLite3.
+
+.. versionadded:: 3009.0
+
+This driver stores cached data (grains, mine data, job returns, etc.) in a
+single SQLite database file on disk. Unlike the ``redis``, ``mysql``,
+``etcd``, and ``consul`` drivers, it requires no separate database service
+and no third-party python package: the ``sqlite3`` module is part of the
+Python standard library, so this driver works out of the box on any master.
+
+Data written with this driver survives a restart of the master process,
+since it is persisted to a regular file instead of being held in memory.
+
+.. warning::
+
+    The ``sqlite3.table_name`` value is directly added into certain
+    queries. Salt treats this as trusted input.
+
+By default the database file is created inside the master's
+:conf_master:`cachedir`. The following values can be set in the master
+config to override the defaults:
+
+.. code-block:: yaml
+
+    sqlite3.database: /var/cache/salt/master/cache.sqlite3
+    sqlite3.table_name: cache
+    sqlite3.timeout: 5.0
+
+To use SQLite3 as a minion data cache backend, set the master ``cache``
+config value to ``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+"""
+
+import logging
+import os
+import sqlite3
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+from salt.exceptions import SaltCacheError
+
+_DEFAULT_DATABASE_NAME = "cache.sqlite3"
+_DEFAULT_TABLE_NAME = "cache"
+_DEFAULT_TIMEOUT = 5.0
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+
+def __virtual__():
+    return __virtualname__
+
+
+def _database_path():
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    return __opts__.get(
+        "sqlite3.database", os.path.join(cachedir, _DEFAULT_DATABASE_NAME)
+    )
+
+
+def _table_name():
+    return __opts__.get("sqlite3.table_name", _DEFAULT_TABLE_NAME)
+
+
+def _init_client():
+    """
+    Open (or create) the SQLite database and make sure the cache table
+    exists. The connection and a lock guarding it are cached in
+    ``__context__`` so subsequent calls in the same process reuse them.
+    """
+    if __context__.get("sqlite3_client") is not None:
+        return
+
+    database = _database_path()
+    db_dir = os.path.dirname(database)
+    if db_dir and not os.path.isdir(db_dir):
+        try:
+            os.makedirs(db_dir)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"The cache directory, {db_dir}, could not be created: {exc}"
+            )
+
+    timeout = __opts__.get("sqlite3.timeout", _DEFAULT_TIMEOUT)
+    try:
+        conn = sqlite3.connect(
+            database,
+            timeout=timeout,
+            isolation_level=None,
+            check_same_thread=False,
+        )
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute("PRAGMA synchronous=NORMAL")
+        conn.execute(
+            "CREATE TABLE IF NOT EXISTS {} ("
+            "bank TEXT NOT NULL, "
+            "ckey TEXT NOT NULL, "
+            "data BLOB, "
+            "last_update INTEGER NOT NULL, "
+            "PRIMARY KEY (bank, ckey))".format(_table_name())
+        )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Could not initialize the sqlite3 cache: {exc}")
+
+    __context__["sqlite3_client"] = conn
+    __context__["sqlite3_lock"] = threading.Lock()
+
+
+def _execute(query, args=()):
+    conn = __context__["sqlite3_client"]
+    lock = __context__["sqlite3_lock"]
+    try:
+        with lock:
+            return conn.execute(query, args)
+    except sqlite3.Error as exc:
+        if len(query) > 150:
+            query = query[:150] + "<...>"
+        raise SaltCacheError(f"Error running {query} - args: {args}: {exc}")
+
+
+def store(bank, key, data):
+    """
+    Store a key value.
+    """
+    _init_client()
+    payload = salt.payload.dumps(data)
+    _execute(
+        "REPLACE INTO {} (bank, ckey, data, last_update) VALUES (?, ?, ?, ?)".format(
+            _table_name()
+        ),
+        (bank, key, payload, int(time.time())),
+    )
+
+
+def fetch(bank, key):
+    """
+    Fetch a key value.
+    """
+    _init_client()
+    cur = _execute(
+        f"SELECT data FROM {_table_name()} WHERE bank=? AND ckey=?", (bank, key)
+    )
+    row = cur.fetchone()
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def flush(bank, key=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key
+    is specified, remove the entire bank with all keys inside.
+    """
+    _init_client()
+    if key is None:
+        cur = _execute(f"DELETE FROM {_table_name()} WHERE bank=?", (bank,))
+    else:
+        cur = _execute(
+            f"DELETE FROM {_table_name()} WHERE bank=? AND ckey=?", (bank, key)
+        )
+    return cur.rowcount > 0
+
+
+def list_(bank):
+    """
+    Return an iterable object containing all entries stored in the
+    specified bank.
+    """
+    _init_client()
+    cur = _execute(f"SELECT ckey FROM {_table_name()} WHERE bank=?", (bank,))
+    return [row[0] for row in cur.fetchall()]
+
+
+def contains(bank, key):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    _init_client()
+    if key is None:
+        cur = _execute(
+            f"SELECT 1 FROM {_table_name()} WHERE bank=? LIMIT 1", (bank,)
+        )
+    else:
+        cur = _execute(
+            f"SELECT 1 FROM {_table_name()} WHERE bank=? AND ckey=? LIMIT 1",
+            (bank, key),
+        )
+    return cur.fetchone() is not None
+
+
+def updated(bank, key):
+    """
+    Return the integer Unix epoch update timestamp of the specified bank
+    and key.
+    """
+    _init_client()
+    cur = _execute(
+        f"SELECT last_update FROM {_table_name()} WHERE bank=? AND ckey=?",
+        (bank, key),
+    )
+    row = cur.fetchone()
+    return int(row[0]) if row else None
