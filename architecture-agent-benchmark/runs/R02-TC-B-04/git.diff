@@ -0,0 +1,47 @@
+import logging
+import shutil
+
+import pytest
+
+import salt.cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def cache(minion_opts):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    cache = salt.cache.factory(opts)
+    try:
+        yield cache
+    finally:
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_data_survives_master_restart(minion_opts):
+    """
+    The whole point of the sqlite3 driver is that cached data (grains,
+    mine data, job returns, ...) is still there after the master process
+    is restarted. Simulate that by throwing away the ``Cache`` instance
+    (and with it, the cached sqlite3 connection held in the loader's
+    ``__context__``) and building a brand new one pointed at the same
+    cachedir.
+    """
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    try:
+        first = salt.cache.factory(opts)
+        first.store("minions/web1", "data", {"grains": {"os": "Linux"}})
+        first.destroy()
+
+        second = salt.cache.factory(opts)
+        assert second.fetch("minions/web1", "data") == {"grains": {"os": "Linux"}}
+        assert second.contains("minions/web1", "data")
+    finally:
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
