@@ -0,0 +1,109 @@
+"""
+unit tests for the sqlite3_cache cache
+"""
+
+import os
+
+import pytest
+
+import salt.cache.sqlite3_cache as sqlite3_cache
+from salt.exceptions import SaltCacheError
+from tests.support.mock import patch
+
+
+@pytest.fixture
+def configure_loader_modules(tmp_path):
+    opts = {"cachedir": str(tmp_path), "__cli": "salt-master"}
+    return {sqlite3_cache: {"__opts__": opts, "__context__": {}}}
+
+
+def test_store_and_fetch():
+    """
+    Data stored can be fetched back and deserialized correctly.
+    """
+    sqlite3_cache.store("bank", "key", {"foo": "bar"})
+    assert sqlite3_cache.fetch("bank", "key") == {"foo": "bar"}
+
+
+def test_fetch_missing_returns_empty_dict():
+    assert sqlite3_cache.fetch("bank", "missing") == {}
+
+
+def test_store_overwrite():
+    sqlite3_cache.store("bank", "key", {"v": 1})
+    sqlite3_cache.store("bank", "key", {"v": 2})
+    assert sqlite3_cache.fetch("bank", "key") == {"v": 2}
+
+
+def test_list_and_contains():
+    sqlite3_cache.store("bank", "k1", "a")
+    sqlite3_cache.store("bank", "k2", "b")
+    assert set(sqlite3_cache.list_("bank")) == {"k1", "k2"}
+    assert sqlite3_cache.contains("bank", "k1") is True
+    assert sqlite3_cache.contains("bank", None) is True
+    assert sqlite3_cache.contains("bank", "nope") is False
+    assert sqlite3_cache.contains("ghost", None) is False
+
+
+def test_flush_key_and_bank():
+    sqlite3_cache.store("bank", "k1", "a")
+    sqlite3_cache.store("bank", "k2", "b")
+
+    assert sqlite3_cache.flush("bank", "k1") is True
+    assert sqlite3_cache.flush("bank", "k1") is False
+    assert sqlite3_cache.fetch("bank", "k1") == {}
+    assert sqlite3_cache.fetch("bank", "k2") == "b"
+
+    assert sqlite3_cache.flush("bank", key=None) is True
+    assert sqlite3_cache.list_("bank") == []
+
+
+def test_updated():
+    assert sqlite3_cache.updated("bank", "key") is None
+    sqlite3_cache.store("bank", "key", "data")
+    ts = sqlite3_cache.updated("bank", "key")
+    assert isinstance(ts, int)
+
+
+def test_database_created_on_disk(tmp_path):
+    sqlite3_cache.store("bank", "key", "data")
+    db_path = os.path.join(str(tmp_path), sqlite3_cache._DEFAULT_DATABASE_NAME)
+    assert os.path.isfile(db_path)
+
+
+def test_data_persists_across_reconnect(tmp_path):
+    """
+    Simulate a master restart: closing out the cached connection/context
+    and reconnecting to the same database file should still see
+    previously stored data.
+    """
+    sqlite3_cache.store("bank", "key", {"still": "here"})
+
+    # Simulate process restart by dropping the cached connection/lock.
+    sqlite3_cache.__context__.clear()
+
+    assert sqlite3_cache.fetch("bank", "key") == {"still": "here"}
+
+
+def test_custom_database_path(tmp_path):
+    custom_db = str(tmp_path / "custom" / "mycache.db")
+    with patch.dict(sqlite3_cache.__opts__, {"sqlite3.database": custom_db}):
+        sqlite3_cache.store("bank", "key", "data")
+    assert os.path.isfile(custom_db)
+
+
+def test_custom_table_name(tmp_path):
+    with patch.dict(sqlite3_cache.__opts__, {"sqlite3.table_name": "mytable"}):
+        sqlite3_cache.store("bank", "key", "data")
+        assert sqlite3_cache.fetch("bank", "key") == "data"
+
+
+def test_query_error_raises_saltcacheerror():
+    sqlite3_cache.store("bank", "key", "data")
+    with patch.object(
+        sqlite3_cache,
+        "_table_name",
+        return_value="not a real table; drop garbage",
+    ):
+        with pytest.raises(SaltCacheError):
+            sqlite3_cache.fetch("bank", "key")
