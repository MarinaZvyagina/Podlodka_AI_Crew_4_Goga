@@ -0,0 +1,218 @@
+"""
+Minion data cache plugin for SQLite3.
+
+.. versionadded:: 3009.0
+
+This cache plugin uses the ``sqlite3`` module that ships with every standard
+Python install, so it gives a small, single-node master durable, on-disk
+cache storage (surviving a restart of the master process) without having to
+stand up a separate database service such as Redis, MySQL, or etcd.
+
+By default the database file lives inside the master's ``cachedir``, at
+``<cachedir>/cache.sqlite3``. This can be overridden along with a handful of
+other options in the master config. These are the defaults:
+
+.. code-block:: yaml
+
+    sqlite3.database: <cachedir>/cache.sqlite3
+    sqlite3.table_name: cache
+    sqlite3.timeout: 5.0
+
+``sqlite3.timeout`` is the number of seconds SQLite will wait for a lock
+held by another process (e.g. another master worker) before giving up.
+
+To use sqlite3 as a minion data cache backend, set the master ``cache``
+config value to ``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+"""
+
+import logging
+import os
+import sqlite3
+import threading
+
+import salt.payload
+import salt.syspaths
+import salt.utils.path
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+_DEFAULT_DATABASE_FILE = "cache.sqlite3"
+_DEFAULT_TABLE_NAME = "cache"
+_DEFAULT_TIMEOUT = 5.0
+
+
+def __virtual__():
+    """
+    sqlite3 ships with the Python standard library, so this driver is
+    always available.
+    """
+    return __virtualname__
+
+
+def _database_path():
+    database = __opts__.get("sqlite3.database")
+    if database:
+        return database
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    return salt.utils.path.join(cachedir, _DEFAULT_DATABASE_FILE)
+
+
+def _table_name():
+    return __opts__.get("sqlite3.table_name", _DEFAULT_TABLE_NAME)
+
+
+def _init_client():
+    """
+    Open (and memoize) the sqlite3 connection, creating the on-disk database
+    and its table if they don't already exist.
+    """
+    if __context__.get("sqlite3_client") is not None:
+        return __context__["sqlite3_client"]
+
+    database = _database_path()
+    base = os.path.dirname(database)
+    if base and not os.path.isdir(base):
+        try:
+            os.makedirs(base)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"The cache directory, {base}, could not be created: {exc}"
+            )
+
+    timeout = __opts__.get("sqlite3.timeout", _DEFAULT_TIMEOUT)
+    try:
+        conn = sqlite3.connect(
+            database,
+            timeout=timeout,
+            isolation_level=None,
+            check_same_thread=False,
+        )
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute("PRAGMA synchronous=NORMAL")
+        conn.execute(
+            f"""
+            CREATE TABLE IF NOT EXISTS {_table_name()} (
+                bank TEXT NOT NULL,
+                key TEXT NOT NULL,
+                data BLOB,
+                last_update REAL NOT NULL,
+                PRIMARY KEY (bank, key)
+            )
+            """
+        )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Could not initialize sqlite3 cache {database}: {exc}")
+
+    __context__["sqlite3_client"] = conn
+    __context__["sqlite3_lock"] = threading.Lock()
+    return conn
+
+
+def store(bank, key, data):
+    """
+    Store a key value.
+    """
+    conn = _init_client()
+    data = salt.payload.dumps(data)
+    query = (
+        f"INSERT OR REPLACE INTO {_table_name()} "
+        "(bank, key, data, last_update) VALUES (?, ?, ?, strftime('%s','now'))"
+    )
+    try:
+        with __context__["sqlite3_lock"]:
+            conn.execute(query, (bank, key, data))
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error storing {bank} {key}: {exc}")
+
+
+def fetch(bank, key):
+    """
+    Fetch a key value.
+    """
+    conn = _init_client()
+    query = f"SELECT data FROM {_table_name()} WHERE bank=? AND key=?"
+    try:
+        with __context__["sqlite3_lock"]:
+            row = conn.execute(query, (bank, key)).fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error fetching {bank} {key}: {exc}")
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def flush(bank, key=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key is
+    specified, remove the entire bank with all keys and sub-banks inside.
+    """
+    conn = _init_client()
+    if key is None:
+        query = f"DELETE FROM {_table_name()} WHERE bank=?"
+        args = (bank,)
+    else:
+        query = f"DELETE FROM {_table_name()} WHERE bank=? AND key=?"
+        args = (bank, key)
+    try:
+        with __context__["sqlite3_lock"]:
+            cur = conn.execute(query, args)
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error flushing {bank} {key}: {exc}")
+    return cur.rowcount > 0
+
+
+def list_(bank):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank.
+    """
+    conn = _init_client()
+    query = f"SELECT key FROM {_table_name()} WHERE bank=?"
+    try:
+        with __context__["sqlite3_lock"]:
+            rows = conn.execute(query, (bank,)).fetchall()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error listing {bank}: {exc}")
+    return [row[0] for row in rows]
+
+
+def contains(bank, key=None):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    conn = _init_client()
+    if key is None:
+        query = f"SELECT 1 FROM {_table_name()} WHERE bank=? LIMIT 1"
+        args = (bank,)
+    else:
+        query = f"SELECT 1 FROM {_table_name()} WHERE bank=? AND key=? LIMIT 1"
+        args = (bank, key)
+    try:
+        with __context__["sqlite3_lock"]:
+            row = conn.execute(query, args).fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error checking {bank} {key}: {exc}")
+    return row is not None
+
+
+def updated(bank, key):
+    """
+    Return the integer Unix epoch update timestamp of the specified bank and
+    key.
+    """
+    conn = _init_client()
+    query = f"SELECT last_update FROM {_table_name()} WHERE bank=? AND key=?"
+    try:
+        with __context__["sqlite3_lock"]:
+            row = conn.execute(query, (bank, key)).fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error fetching update time for {bank} {key}: {exc}")
+    return int(row[0]) if row else None
