+import logging
+
+import pytest
+
+import salt.cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def cache(minion_opts, tmp_path):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    opts["sqlite3.database"] = str(tmp_path / "cache.sqlite3")
+    return salt.cache.factory(opts)
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_data_survives_reconnect(cache, minion_opts, tmp_path):
+    """
+    The whole point of a disk-backed cache is that data outlives the
+    process. Simulate a master restart by dropping the cached connection
+    and creating a fresh Cache object against the same database file.
+    """
+    cache.store("bank", "key", {"still": "here"})
+
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    opts["sqlite3.database"] = str(tmp_path / "cache.sqlite3")
+    new_cache = salt.cache.factory(opts)
+
+    assert new_cache.fetch("bank", "key") == {"still": "here"}
