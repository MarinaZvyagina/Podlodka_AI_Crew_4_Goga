@@ -0,0 +1,109 @@
+"""
+unit tests for the sqlite3_cache cache
+"""
+
+import logging
+
+import pytest
+
+import salt.cache.sqlite3_cache as sqlite3_cache
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def configure_loader_modules(tmp_path):
+    return {
+        sqlite3_cache: {
+            "__opts__": {
+                "cachedir": str(tmp_path),
+                "sqlite3.database": str(tmp_path / "cache.sqlite3"),
+            },
+            "__context__": {},
+        }
+    }
+
+
+def test_database_path_defaults_under_cachedir(tmp_path):
+    with pytest.MonkeyPatch.context() as mp:
+        mp.setitem(sqlite3_cache.__opts__, "sqlite3.database", None)
+        mp.setitem(sqlite3_cache.__opts__, "cachedir", str(tmp_path))
+        assert sqlite3_cache._database_path() == str(tmp_path / "cache.sqlite3")
+
+
+def test_database_path_honors_explicit_config(tmp_path):
+    custom = str(tmp_path / "somewhere" / "salt-cache.db")
+    with pytest.MonkeyPatch.context() as mp:
+        mp.setitem(sqlite3_cache.__opts__, "sqlite3.database", custom)
+        assert sqlite3_cache._database_path() == custom
+
+
+def test_store_fetch_roundtrip():
+    sqlite3_cache.store(bank="minions/alpha", key="data", data={"foo": "bar"})
+    assert sqlite3_cache.fetch(bank="minions/alpha", key="data") == {"foo": "bar"}
+
+
+def test_fetch_missing_returns_empty_dict():
+    assert sqlite3_cache.fetch(bank="ghost", key="nope") == {}
+
+
+def test_creates_database_file_on_disk(tmp_path):
+    db_path = tmp_path / "cache.sqlite3"
+    assert not db_path.exists()
+    sqlite3_cache.store(bank="bank", key="key", data="value")
+    assert db_path.exists()
+
+
+def test_data_persists_across_reconnect(tmp_path):
+    sqlite3_cache.store(bank="bank", key="key", data={"persisted": True})
+
+    # Simulate a restart: drop the memoized connection so the next call
+    # re-opens the on-disk database from scratch.
+    sqlite3_cache.__context__.pop("sqlite3_client", None)
+    sqlite3_cache.__context__.pop("sqlite3_lock", None)
+
+    assert sqlite3_cache.fetch(bank="bank", key="key") == {"persisted": True}
+
+
+def test_flush_single_key_leaves_siblings():
+    sqlite3_cache.store(bank="bank", key="keep", data=1)
+    sqlite3_cache.store(bank="bank", key="drop", data=2)
+    assert sqlite3_cache.flush(bank="bank", key="drop") is True
+    assert sqlite3_cache.fetch(bank="bank", key="drop") == {}
+    assert sqlite3_cache.fetch(bank="bank", key="keep") == 1
+
+
+def test_flush_missing_key_returns_false():
+    assert sqlite3_cache.flush(bank="bank", key="missing") is False
+
+
+def test_list_and_contains():
+    sqlite3_cache.store(bank="bank", key="a", data=1)
+    sqlite3_cache.store(bank="bank", key="b", data=2)
+    assert set(sqlite3_cache.list_(bank="bank")) == {"a", "b"}
+    assert sqlite3_cache.contains(bank="bank", key="a") is True
+    assert sqlite3_cache.contains(bank="bank", key="missing") is False
+    assert sqlite3_cache.contains(bank="bank") is True
+    assert sqlite3_cache.contains(bank="ghost") is False
+
+
+def test_updated_returns_none_for_missing_key():
+    assert sqlite3_cache.updated(bank="bank", key="missing") is None
+
+
+def test_updated_returns_int_epoch():
+    sqlite3_cache.store(bank="bank", key="key", data=1)
+    assert isinstance(sqlite3_cache.updated(bank="bank", key="key"), int)
+
+
+def test_store_wraps_sqlite_errors(tmp_path):
+    # Point the "database" at a directory: sqlite3.connect() will fail to
+    # open it, and that failure should surface as SaltCacheError, not a
+    # raw sqlite3.Error.
+    bogus = tmp_path / "not-a-file"
+    bogus.mkdir()
+    sqlite3_cache.__opts__["sqlite3.database"] = str(bogus)
+    sqlite3_cache.__context__.pop("sqlite3_client", None)
+    with pytest.raises(SaltCacheError):
+        sqlite3_cache.store(bank="bank", key="key", data="value")
