@@ -0,0 +1,287 @@
+"""
+Cache data in a local SQLite3 database file.
+
+.. versionadded:: 3008.0
+
+This cache module stores minion data (grains, mine data, job returns, etc.)
+in a single SQLite3 database file on disk. Unlike the ``consul``, ``redis``,
+``etcd`` and ``mysql`` cache modules, it does not require setting up and
+maintaining a separate database service -- everything it needs ships with a
+standard Python installation.
+
+This makes it a good fit for small, single-master deployments that want
+their cached minion data to survive a restart of the master, but don't want
+the operational overhead of running a separate database service.
+
+Like the ``mysql`` and ``redis`` drivers, this backend is safe to share
+between multiple ``salt-master`` worker processes on the same host; it is
+not intended to be shared between multiple masters the way a networked
+backend such as ``consul`` or ``redis`` can be.
+
+The following values can optionally be set in the master config. These are
+the defaults:
+
+.. code-block:: yaml
+
+    sqlite3.database: <cachedir>/cache.sqlite3
+    sqlite3.timeout: 5.0
+
+To use SQLite3 as a minion data cache backend, set the master ``cache``
+config value to ``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+"""
+
+import logging
+import os
+import time
+
+import salt.payload
+import salt.syspaths
+from salt.exceptions import SaltCacheError
+
+try:
+    import sqlite3
+
+    HAS_SQLITE3 = True
+except ImportError:
+    HAS_SQLITE3 = False
+
+log = logging.getLogger(__name__)
+
+_TABLE_NAME = "cache"
+_DEFAULT_TIMEOUT = 5.0
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+
+def __virtual__():
+    """
+    Confirm that the sqlite3 module is available. This ships with the Python
+    standard library, so it should always be true, but some minimal Python
+    builds omit it.
+    """
+    if not HAS_SQLITE3:
+        return (
+            False,
+            "No python sqlite3 library installed (this normally ships with "
+            "the Python standard library).",
+        )
+    return __virtualname__
+
+
+def _database_path():
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    return __opts__.get("sqlite3.database") or os.path.join(
+        cachedir, "cache.sqlite3"
+    )
+
+
+def _timeout():
+    return __opts__.get("sqlite3.timeout", _DEFAULT_TIMEOUT)
+
+
+def _normalize_bank(bank):
+    return bank.rstrip("/")
+
+
+def _escape_like(value):
+    """
+    Escape a string for safe use as a LIKE prefix (paired with ESCAPE '\\').
+    """
+    return value.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+
+
+def _connect():
+    db_path = _database_path()
+    db_dir = os.path.dirname(db_path)
+    if db_dir and not os.path.isdir(db_dir):
+        try:
+            os.makedirs(db_dir)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"The sqlite3 cache directory, {db_dir}, could not be created: {exc}"
+            )
+
+    try:
+        conn = sqlite3.connect(db_path, timeout=_timeout(), isolation_level=None)
+        conn.execute(f"PRAGMA busy_timeout = {int(_timeout() * 1000)}")
+        context_key = f"sqlite3_cache.initialized.{db_path}"
+        if not __context__.get(context_key):
+            conn.execute(
+                f"""CREATE TABLE IF NOT EXISTS {_TABLE_NAME} (
+                    bank TEXT NOT NULL,
+                    key TEXT NOT NULL,
+                    data BLOB,
+                    last_update INTEGER NOT NULL,
+                    PRIMARY KEY (bank, key)
+                )"""
+            )
+            __context__[context_key] = True
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"There was an error connecting to the sqlite3 cache database, {db_path}: {exc}"
+        )
+    return conn
+
+
+def store(bank, key, data):
+    """
+    Store a key value.
+    """
+    bank = _normalize_bank(bank)
+    payload = salt.payload.dumps(data)
+    conn = _connect()
+    try:
+        conn.execute(
+            f"INSERT OR REPLACE INTO {_TABLE_NAME} (bank, key, data, last_update) "
+            "VALUES (?, ?, ?, ?)",
+            (bank, key, payload, int(time.time())),
+        )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"There was an error writing to {bank}/{key}: {exc}")
+    finally:
+        conn.close()
+
+
+def fetch(bank, key):
+    """
+    Fetch a key value.
+    """
+    bank = _normalize_bank(bank)
+    conn = _connect()
+    try:
+        cur = conn.execute(
+            f"SELECT data FROM {_TABLE_NAME} WHERE bank = ? AND key = ?", (bank, key)
+        )
+        row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"There was an error reading {bank}/{key}: {exc}")
+    finally:
+        conn.close()
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key):
+    """
+    Return the Unix Epoch timestamp of when the specified bank/key was last
+    updated, or None if it wasn't found in the cache.
+    """
+    bank = _normalize_bank(bank)
+    conn = _connect()
+    try:
+        cur = conn.execute(
+            f"SELECT last_update FROM {_TABLE_NAME} WHERE bank = ? AND key = ?",
+            (bank, key),
+        )
+        row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"There was an error reading the update time for {bank}/{key}: {exc}"
+        )
+    finally:
+        conn.close()
+    return int(row[0]) if row else None
+
+
+def flush(bank, key=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key is
+    specified, remove the entire bank with all keys and sub-banks inside.
+    """
+    bank = _normalize_bank(bank)
+    subbank_pattern = _escape_like(bank + "/") + "%"
+    conn = _connect()
+    try:
+        if key is None:
+            cur = conn.execute(
+                f"SELECT 1 FROM {_TABLE_NAME} WHERE bank = ? "
+                "OR bank LIKE ? ESCAPE '\\' LIMIT 1",
+                (bank, subbank_pattern),
+            )
+            if cur.fetchone() is None:
+                return False
+            conn.execute(
+                f"DELETE FROM {_TABLE_NAME} WHERE bank = ? OR bank LIKE ? ESCAPE '\\'",
+                (bank, subbank_pattern),
+            )
+        else:
+            cur = conn.execute(
+                f"SELECT 1 FROM {_TABLE_NAME} WHERE bank = ? AND key = ?", (bank, key)
+            )
+            if cur.fetchone() is None:
+                return False
+            conn.execute(
+                f"DELETE FROM {_TABLE_NAME} WHERE bank = ? AND key = ?", (bank, key)
+            )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"There was an error removing {bank}/{key or ''}: {exc}")
+    finally:
+        conn.close()
+    return True
+
+
+def list_(bank):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank, including immediate sub-banks (matching the behavior of the
+    ``localfs`` driver).
+    """
+    bank = _normalize_bank(bank)
+    subbank_pattern = _escape_like(bank + "/") + "%"
+    conn = _connect()
+    try:
+        ret = set()
+        cur = conn.execute(
+            f"SELECT key FROM {_TABLE_NAME} WHERE bank = ?", (bank,)
+        )
+        for (key,) in cur.fetchall():
+            ret.add(key)
+
+        cur = conn.execute(
+            f"SELECT DISTINCT bank FROM {_TABLE_NAME} WHERE bank LIKE ? ESCAPE '\\'",
+            (subbank_pattern,),
+        )
+        prefix_len = len(bank) + 1
+        for (subbank,) in cur.fetchall():
+            ret.add(subbank[prefix_len:].split("/", 1)[0])
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"There was an error listing {bank}: {exc}")
+    finally:
+        conn.close()
+    return list(ret)
+
+
+def contains(bank, key=None):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    bank = _normalize_bank(bank)
+    conn = _connect()
+    try:
+        if key is None:
+            cur = conn.execute(
+                f"SELECT 1 FROM {_TABLE_NAME} WHERE bank = ? LIMIT 1", (bank,)
+            )
+            if cur.fetchone() is not None:
+                return True
+            subbank_pattern = _escape_like(bank + "/") + "%"
+            cur = conn.execute(
+                f"SELECT 1 FROM {_TABLE_NAME} WHERE bank LIKE ? ESCAPE '\\' LIMIT 1",
+                (subbank_pattern,),
+            )
+            return cur.fetchone() is not None
+        cur = conn.execute(
+            f"SELECT 1 FROM {_TABLE_NAME} WHERE bank = ? AND key = ? LIMIT 1",
+            (bank, key),
+        )
+        return cur.fetchone() is not None
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"There was an error checking {bank}/{key or ''}: {exc}")
+    finally:
+        conn.close()
