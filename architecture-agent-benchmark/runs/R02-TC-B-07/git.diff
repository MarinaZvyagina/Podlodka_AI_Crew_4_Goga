@@ -0,0 +1,153 @@
+"""
+Unit tests for the sqlite3_cache cache module.
+"""
+
+import os
+
+import pytest
+
+import salt.cache.sqlite3_cache as sqlite3_cache
+from salt.exceptions import SaltCacheError
+from tests.support.mock import MagicMock, patch
+
+
+@pytest.fixture
+def configure_loader_modules(tmp_path):
+    return {
+        sqlite3_cache: {
+            "__opts__": {"cachedir": str(tmp_path), "sqlite3.timeout": 1.0},
+        }
+    }
+
+
+def test_store_and_fetch_roundtrip():
+    sqlite3_cache.store(bank="bank", key="key", data={"some": "data"})
+    assert sqlite3_cache.fetch(bank="bank", key="key") == {"some": "data"}
+
+
+def test_fetch_missing_key_returns_empty_dict():
+    assert sqlite3_cache.fetch(bank="nonexistent", key="whatever") == {}
+
+
+def test_store_overwrites_existing_key():
+    sqlite3_cache.store(bank="bank", key="key", data="one")
+    sqlite3_cache.store(bank="bank", key="key", data="two")
+    assert sqlite3_cache.fetch(bank="bank", key="key") == "two"
+
+
+def test_updated_returns_none_for_missing_key():
+    assert sqlite3_cache.updated(bank="bank", key="key") is None
+
+
+def test_updated_returns_int_after_store():
+    sqlite3_cache.store(bank="bank", key="key", data="data")
+    assert isinstance(sqlite3_cache.updated(bank="bank", key="key"), int)
+
+
+def test_contains_key_and_bank():
+    assert sqlite3_cache.contains(bank="bank", key="key") is False
+    assert sqlite3_cache.contains(bank="bank") is False
+
+    sqlite3_cache.store(bank="bank", key="key", data="data")
+
+    assert sqlite3_cache.contains(bank="bank", key="key") is True
+    assert sqlite3_cache.contains(bank="bank", key="otherkey") is False
+    assert sqlite3_cache.contains(bank="bank") is True
+
+
+def test_contains_via_subbank():
+    sqlite3_cache.store(bank="minions/alpha", key="data", data="grains")
+    assert sqlite3_cache.contains(bank="minions") is True
+    assert sqlite3_cache.contains(bank="minions", key="alpha") is False
+
+
+def test_list_returns_keys_and_subbanks():
+    sqlite3_cache.store(bank="minions/alpha", key="data", data="grains-a")
+    sqlite3_cache.store(bank="minions/beta", key="data", data="grains-b")
+    sqlite3_cache.store(bank="minions", key="toplevel", data="stuff")
+
+    listing = sorted(sqlite3_cache.list_(bank="minions"))
+    assert listing == ["alpha", "beta", "toplevel"]
+
+    assert sqlite3_cache.list_(bank="minions/alpha") == ["data"]
+    assert sqlite3_cache.list_(bank="nonexistent") == []
+
+
+def test_flush_single_key():
+    sqlite3_cache.store(bank="bank", key="key1", data="one")
+    sqlite3_cache.store(bank="bank", key="key2", data="two")
+
+    assert sqlite3_cache.flush(bank="bank", key="key1") is True
+    assert sqlite3_cache.contains(bank="bank", key="key1") is False
+    assert sqlite3_cache.contains(bank="bank", key="key2") is True
+
+
+def test_flush_missing_key_returns_false():
+    assert sqlite3_cache.flush(bank="bank", key="nope") is False
+    assert sqlite3_cache.flush(bank="nonexistent") is False
+
+
+def test_flush_bank_removes_subbanks():
+    sqlite3_cache.store(bank="minions/alpha", key="data", data="grains-a")
+    sqlite3_cache.store(bank="minions/beta", key="data", data="grains-b")
+
+    assert sqlite3_cache.flush(bank="minions") is True
+    assert sqlite3_cache.list_(bank="minions") == []
+    assert sqlite3_cache.contains(bank="minions/alpha") is False
+
+
+def test_bank_names_with_like_wildcards_do_not_leak(tmp_path):
+    """
+    Bank names containing ``%`` or ``_`` must be treated literally, not as
+    SQL LIKE wildcards, when computing sub-bank membership.
+    """
+    sqlite3_cache.store(bank="wild%card", key="key", data="should-not-leak")
+    sqlite3_cache.store(bank="wildXcard/sub", key="key", data="unrelated")
+
+    assert sqlite3_cache.list_(bank="wild%card") == ["key"]
+    assert sqlite3_cache.contains(bank="wild%card") is True
+    assert sqlite3_cache.contains(bank="wildXcard") is True
+    assert "key" not in sqlite3_cache.list_(bank="wildXcard")
+
+
+def test_database_file_is_created_on_disk(tmp_path):
+    sqlite3_cache.store(bank="bank", key="key", data="data")
+    assert os.path.isfile(os.path.join(str(tmp_path), "cache.sqlite3"))
+
+
+def test_custom_database_path(tmp_path):
+    custom_db = str(tmp_path / "subdir" / "custom.sqlite3")
+    with patch.dict(sqlite3_cache.__opts__, {"sqlite3.database": custom_db}):
+        sqlite3_cache.store(bank="bank", key="key", data="data")
+        assert os.path.isfile(custom_db)
+        assert sqlite3_cache.fetch(bank="bank", key="key") == "data"
+
+
+def test_store_error_wrapped_in_saltcacheerror():
+    with patch.object(
+        sqlite3_cache,
+        "_connect",
+        MagicMock(side_effect=SaltCacheError("boom")),
+    ):
+        with pytest.raises(SaltCacheError):
+            sqlite3_cache.store(bank="bank", key="key", data="data")
+
+
+def test_data_persists_across_separate_connections():
+    """
+    Regression check for the master-restart durability requirement: data
+    stored via one connection must be readable via a brand new connection
+    (simulating a master restart), since this driver does not keep an
+    in-memory cache of the data.
+    """
+    sqlite3_cache.store(bank="bank", key="key", data={"persisted": True})
+    conn = sqlite3_cache._connect()
+    try:
+        cur = conn.execute(
+            "SELECT bank, key FROM cache WHERE bank = ? AND key = ?",
+            ("bank", "key"),
+        )
+        assert cur.fetchone() == ("bank", "key")
+    finally:
+        conn.close()
+    assert sqlite3_cache.fetch(bank="bank", key="key") == {"persisted": True}
