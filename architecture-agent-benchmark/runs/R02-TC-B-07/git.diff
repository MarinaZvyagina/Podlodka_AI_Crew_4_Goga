@@ -0,0 +1,36 @@
+import logging
+import shutil
+
+import pytest
+
+import salt.cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def cache(minion_opts):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    cache = salt.cache.factory(opts)
+    try:
+        yield cache
+    finally:
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_cache_survives_new_connection(cache):
+    """
+    Data stored through the cache must be readable via a brand new
+    connection to the same database file, so that it survives a restart
+    of the master process.
+    """
+    cache.store(bank="minions/alpha", key="data", data={"grain": "value"})
+
+    new_cache = salt.cache.factory(cache.opts)
+    assert new_cache.fetch(bank="minions/alpha", key="data") == {"grain": "value"}
diff --git a/tests/pytests/unit/cache/test_sqlite3_cache.py b/tests/pytests/unit/cache/test_sqlite3_cache.py
