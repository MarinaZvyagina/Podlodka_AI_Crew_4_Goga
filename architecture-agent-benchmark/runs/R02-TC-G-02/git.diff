+++ b/tests/pytests/functional/cache/test_sqlite3.py
@@ -0,0 +1,43 @@
+import logging
+
+import pytest
+
+import salt.cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def cache(minion_opts, tmp_path):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    opts["sqlite3.database_file"] = str(tmp_path / "cache.sqlite3")
+    cache = salt.cache.factory(opts)
+    return cache
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_data_survives_a_simulated_master_restart(minion_opts, tmp_path):
+    """
+    The point of the sqlite3 driver is that cached data is still there
+    after the master process restarts. Simulate a restart by building a
+    brand new Cache/loader (as happens on every fresh master start) against
+    the same on-disk database file and confirming previously stored data is
+    still readable.
+    """
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    opts["sqlite3.database_file"] = str(tmp_path / "cache.sqlite3")
+
+    before_restart = salt.cache.factory(opts)
+    before_restart.store("minions/web-01", "data", {"os": "CentOS"})
+    before_restart.store("minions/web-01", "grains", {"cpuarch": "x86_64"})
+
+    after_restart = salt.cache.factory(opts)
+    assert after_restart.fetch("minions/web-01", "data") == {"os": "CentOS"}
+    assert after_restart.fetch("minions/web-01", "grains") == {"cpuarch": "x86_64"}
+    assert set(after_restart.list("minions/web-01")) == {"data", "grains"}
