@@ -0,0 +1,273 @@
+"""
+Minion data cache plugin for SQLite3.
+
+.. versionadded:: 3008.0
+
+This plugin stores the cache in a single SQLite3 database file on disk. It is
+intended for single-master setups where an operator wants the cached minion
+data (grains, mine data, job returns, etc.) to survive a restart of the
+master without having to install and operate a separate database service.
+
+The :mod:`sqlite3 <python:sqlite3>` module is part of the Python standard
+library, so no additional packages need to be installed to use this cache
+driver.
+
+To use the sqlite3 driver as the minion data cache backend, set the master
+``cache`` config value to ``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+The following values can optionally be set in the master config:
+
+.. code-block:: yaml
+
+    sqlite3.database_file: /var/cache/salt/master/cache.sqlite3
+    sqlite3.table_name: cache
+    sqlite3.timeout: 30
+
+database_file:
+    Path to the SQLite3 database file. Defaults to ``cache.sqlite3`` inside
+    the master's ``cachedir``.
+
+table_name:
+    Name of the table used to store the cache entries. Defaults to ``cache``.
+
+timeout:
+    Number of seconds to wait for the database to become free of locks held
+    by other connections (e.g. other master worker processes) before giving
+    up. Defaults to ``30``.
+
+.. warning::
+
+    The ``sqlite3.table_name`` value is interpolated directly into the SQL
+    statements used by this driver. Salt treats it as trusted input.
+"""
+
+import logging
+import os
+import sqlite3
+import threading
+import time
+
+import salt.payload
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+_DEFAULT_DATABASE_FILE = "cache.sqlite3"
+_DEFAULT_TABLE_NAME = "cache"
+_DEFAULT_TIMEOUT = 30
+
+# Connections are cached per-process in __context__. Guard access to the
+# connection with a lock since a single process could call into this module
+# from more than one thread.
+_lock = threading.Lock()
+
+
+def __virtual__():
+    return __virtualname__
+
+
+def _database_file():
+    return __opts__.get(
+        "sqlite3.database_file",
+        os.path.join(__opts__.get("cachedir", ""), _DEFAULT_DATABASE_FILE),
+    )
+
+
+def _table_name():
+    return __opts__.get("sqlite3.table_name", _DEFAULT_TABLE_NAME)
+
+
+def _connection():
+    """
+    Return the cached SQLite3 connection for this process, creating it (and
+    the backing table) on first use.
+    """
+    ctx = __context__.setdefault("sqlite3_cache", {})
+    conn = ctx.get("conn")
+    if conn is not None:
+        return conn, ctx["table"]
+
+    database_file = _database_file()
+    database_dir = os.path.dirname(database_file)
+    if database_dir and not os.path.isdir(database_dir):
+        try:
+            os.makedirs(database_dir)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"Could not create the sqlite3 cache directory {database_dir}: {exc}"
+            )
+
+    table = _table_name()
+    try:
+        conn = sqlite3.connect(
+            database_file,
+            timeout=__opts__.get("sqlite3.timeout", _DEFAULT_TIMEOUT),
+            check_same_thread=False,
+            isolation_level=None,
+        )
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute("PRAGMA synchronous=NORMAL")
+        conn.execute(
+            f"""CREATE TABLE IF NOT EXISTS {table} (
+                bank TEXT NOT NULL,
+                cache_key TEXT NOT NULL,
+                data BLOB,
+                last_update INTEGER NOT NULL,
+                PRIMARY KEY (bank, cache_key)
+            )"""
+        )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"Could not open the sqlite3 cache database {database_file}: {exc}"
+        )
+
+    ctx["conn"] = conn
+    ctx["table"] = table
+    return conn, table
+
+
+def _like_escape(value):
+    """
+    Escape LIKE wildcard characters (``%`` and ``_``) so bank names
+    containing them are matched literally.
+    """
+    return value.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+
+
+def _subbank_like_pattern(bank):
+    return _like_escape(bank.rstrip("/")) + "/%"
+
+
+def store(bank, key, data):
+    """
+    Store a key value.
+    """
+    conn, table = _connection()
+    raw = salt.payload.dumps(data)
+    with _lock:
+        try:
+            conn.execute(
+                f"INSERT OR REPLACE INTO {table} "
+                "(bank, cache_key, data, last_update) VALUES (?, ?, ?, ?)",
+                (bank, key, raw, int(time.time())),
+            )
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Could not write the cache key {bank}/{key}: {exc}")
+
+
+def fetch(bank, key):
+    """
+    Fetch a key value.
+    """
+    conn, table = _connection()
+    try:
+        row = conn.execute(
+            f"SELECT data FROM {table} WHERE bank=? AND cache_key=?", (bank, key)
+        ).fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Could not read the cache key {bank}/{key}: {exc}")
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key):
+    """
+    Return the Unix Epoch timestamp of when the key was last updated. Return
+    None if key is not found.
+    """
+    conn, table = _connection()
+    try:
+        row = conn.execute(
+            f"SELECT last_update FROM {table} WHERE bank=? AND cache_key=?",
+            (bank, key),
+        ).fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"Could not read the update time of the cache key {bank}/{key}: {exc}"
+        )
+    return None if row is None else int(row[0])
+
+
+def flush(bank, key=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key is
+    specified, remove the entire bank with all keys and sub-banks inside.
+    """
+    conn, table = _connection()
+    with _lock:
+        try:
+            if key is None:
+                subbank_prefix = _subbank_like_pattern(bank)
+                exists = conn.execute(
+                    f"SELECT 1 FROM {table} WHERE bank=? OR bank LIKE ? ESCAPE '\\' "
+                    "LIMIT 1",
+                    (bank, subbank_prefix),
+                ).fetchone()
+                if exists is None:
+                    return False
+                conn.execute(
+                    f"DELETE FROM {table} WHERE bank=? OR bank LIKE ? ESCAPE '\\'",
+                    (bank, subbank_prefix),
+                )
+                return True
+            cur = conn.execute(
+                f"DELETE FROM {table} WHERE bank=? AND cache_key=?", (bank, key)
+            )
+            return cur.rowcount > 0
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Could not flush the cache bank {bank}: {exc}")
+
+
+def list_(bank):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank.
+    """
+    conn, table = _connection()
+    try:
+        entries = {
+            row[0]
+            for row in conn.execute(
+                f"SELECT cache_key FROM {table} WHERE bank=?", (bank,)
+            ).fetchall()
+        }
+        subbank_prefix = bank.rstrip("/") + "/"
+        for (subbank,) in conn.execute(
+            f"SELECT DISTINCT bank FROM {table} WHERE bank LIKE ? ESCAPE '\\'",
+            (_subbank_like_pattern(bank),),
+        ).fetchall():
+            entries.add(subbank[len(subbank_prefix) :].split("/", 1)[0])
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Could not list the cache bank {bank}: {exc}")
+    return list(entries)
+
+
+def contains(bank, key=None):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    conn, table = _connection()
+    try:
+        if key is None:
+            subbank_prefix = _subbank_like_pattern(bank)
+            row = conn.execute(
+                f"SELECT 1 FROM {table} WHERE bank=? OR bank LIKE ? ESCAPE '\\' "
+                "LIMIT 1",
+                (bank, subbank_prefix),
+            ).fetchone()
+        else:
+            row = conn.execute(
+                f"SELECT 1 FROM {table} WHERE bank=? AND cache_key=? LIMIT 1",
+                (bank, key),
+            ).fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Could not check the cache bank {bank}: {exc}")
+    return row is not None
diff --git a/tests/pytests/functional/cache/test_sqlite3.py b/tests/pytests/functional/cache/test_sqlite3.py
