index 0000000..b429d3d
--- /dev/null
+++ b/tests/pytests/unit/cache/test_sqlite3_cache.py
@@ -0,0 +1,133 @@
+"""
+Validate the functions in the sqlite3 cache
+"""
+
+import pytest
+
+import salt.cache.sqlite3_cache as sqlite3_cache
+from salt.exceptions import SaltCacheError
+from tests.support.mock import patch
+
+
+@pytest.fixture
+def configure_loader_modules():
+    return {sqlite3_cache: {}}
+
+
+@pytest.fixture
+def dbfile(tmp_path):
+    return str(tmp_path / "cache.sqlite3")
+
+
+def test_store_and_fetch(dbfile):
+    sqlite3_cache.store("bank", "key", "payload data", dbfile=dbfile)
+    assert sqlite3_cache.fetch("bank", "key", dbfile=dbfile) == "payload data"
+
+
+def test_fetch_missing_key_returns_empty_dict(dbfile):
+    assert sqlite3_cache.fetch("bank", "nope", dbfile=dbfile) == {}
+
+
+def test_store_overwrite(dbfile):
+    sqlite3_cache.store("bank", "key", {"v": 1}, dbfile=dbfile)
+    sqlite3_cache.store("bank", "key", {"v": 2}, dbfile=dbfile)
+    assert sqlite3_cache.fetch("bank", "key", dbfile=dbfile) == {"v": 2}
+
+
+def test_updated_missing_key_returns_none(dbfile):
+    assert sqlite3_cache.updated("bank", "nope", dbfile=dbfile) is None
+
+
+def test_updated_success(dbfile):
+    sqlite3_cache.store("bank", "key", "data", dbfile=dbfile)
+    assert isinstance(sqlite3_cache.updated("bank", "key", dbfile=dbfile), int)
+
+
+def test_flush_missing_key_returns_false(dbfile):
+    assert sqlite3_cache.flush("bank", key="nope", dbfile=dbfile) is False
+
+
+def test_flush_existing_key_returns_true(dbfile):
+    sqlite3_cache.store("bank", "key", "data", dbfile=dbfile)
+    assert sqlite3_cache.flush("bank", key="key", dbfile=dbfile) is True
+    assert sqlite3_cache.fetch("bank", "key", dbfile=dbfile) == {}
+
+
+def test_flush_entire_bank(dbfile):
+    sqlite3_cache.store("bank", "k1", "a", dbfile=dbfile)
+    sqlite3_cache.store("bank", "k2", "b", dbfile=dbfile)
+    assert sqlite3_cache.flush("bank", key=None, dbfile=dbfile) is True
+    assert sqlite3_cache.list_("bank", dbfile=dbfile) == []
+
+
+def test_list_success(dbfile):
+    sqlite3_cache.store("bank", "key", "data", dbfile=dbfile)
+    assert sqlite3_cache.list_("bank", dbfile=dbfile) == ["key"]
+
+
+def test_list_empty_bank_returns_empty_list(dbfile):
+    assert sqlite3_cache.list_("ghost", dbfile=dbfile) == []
+
+
+def test_contains(dbfile):
+    sqlite3_cache.store("bank", "key", "data", dbfile=dbfile)
+    assert sqlite3_cache.contains("bank", None, dbfile=dbfile) is True
+    assert sqlite3_cache.contains("bank", "key", dbfile=dbfile) is True
+    assert sqlite3_cache.contains("bank", "nope", dbfile=dbfile) is False
+    assert sqlite3_cache.contains("ghost", None, dbfile=dbfile) is False
+
+
+def test_list_all_with_data(dbfile):
+    sqlite3_cache.store("bank", "k1", {"a": 1}, dbfile=dbfile)
+    sqlite3_cache.store("bank", "k2", {"b": 2}, dbfile=dbfile)
+    result = sqlite3_cache.list_all("bank", include_data=True, dbfile=dbfile)
+    assert result == {"k1": {"a": 1}, "k2": {"b": 2}}
+
+
+def test_list_all_without_data(dbfile):
+    sqlite3_cache.store("bank", "k1", {"a": 1}, dbfile=dbfile)
+    result = sqlite3_cache.list_all("bank", include_data=False, dbfile=dbfile)
+    assert result == {"k1": {}}
+
+
+def test_mix_of_utf8_and_non_utf8_can_be_round_tripped(dbfile):
+    data = {
+        "unicode": "áéí",
+        "bytes": b"\xfe\x99\x00\xff",
+    }
+    sqlite3_cache.store("bank", "key", data, dbfile=dbfile)
+    assert sqlite3_cache.fetch("bank", "key", dbfile=dbfile) == data
+
+
+def test_data_survives_new_connection(dbfile):
+    """
+    Simulate a master restart: data written through one connection must be
+    readable after the module's cached connection is dropped and a fresh
+    one is opened against the same file.
+    """
+    sqlite3_cache.store("bank", "key", {"still": "here"}, dbfile=dbfile)
+    sqlite3_cache.__context__.pop("sqlite3_client", None)
+    sqlite3_cache.__context__.pop("sqlite3_dbfile", None)
+    assert sqlite3_cache.fetch("bank", "key", dbfile=dbfile) == {"still": "here"}
+
+
+def test_dbfile_defaults_to_cachedir(tmp_path):
+    cachedir = str(tmp_path)
+    with patch.dict(sqlite3_cache.__opts__, {"cachedir": cachedir}):
+        assert sqlite3_cache.init_kwargs({"cachedir": cachedir}) == {
+            "dbfile": str(tmp_path / "cache.sqlite3")
+        }
+
+
+def test_dbfile_override_via_opts(tmp_path):
+    override = str(tmp_path / "custom.db")
+    with patch.dict(sqlite3_cache.__opts__, {"sqlite3.database": override}):
+        assert sqlite3_cache.init_kwargs({}) == {"dbfile": override}
+
+
+def test_store_error_wraps_in_saltcacheerror(dbfile):
+    sqlite3_cache.store("bank", "key", "data", dbfile=dbfile)
+    conn = sqlite3_cache._connect(dbfile)
+    conn.close()
+    with pytest.raises(SaltCacheError):
+        sqlite3_cache.store("bank", "key2", "data", dbfile=dbfile)
