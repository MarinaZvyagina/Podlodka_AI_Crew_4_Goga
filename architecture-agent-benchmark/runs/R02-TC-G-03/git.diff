+++ b/salt/cache/sqlite3_cache.py
@@ -0,0 +1,273 @@
+"""
+Minion data cache plugin for SQLite3.
+
+.. versionadded:: 3009.0
+
+This cache module keeps all of the master's cached minion data (grains,
+mine data, job returns, etc.) in a single SQLite database file on disk, so
+that it survives a restart of the master process. It requires no external
+services or third-party libraries -- ``sqlite3`` ships with every standard
+Python installation.
+
+By default the database file is created as ``cache.sqlite3`` inside the
+master's ``cachedir``. This can be overridden:
+
+.. code-block:: yaml
+
+    sqlite3.database: /var/cache/salt/master/cache.sqlite3
+    # How long, in seconds, to wait for a lock held by another process
+    # before giving up. Defaults to 5 seconds.
+    sqlite3.timeout: 5
+
+To use SQLite3 as the minion data cache backend, set the master ``cache``
+config value to ``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+"""
+
+import errno
+import logging
+import os
+import sqlite3
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+import salt.utils.path
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+
+def __virtual__():
+    """
+    The module is named ``sqlite3_cache.py`` to avoid shadowing the stdlib
+    ``sqlite3`` module on import, but it should be selectable via the
+    ``cache: sqlite3`` config value, so rename it here.
+    """
+    return __virtualname__
+
+
+_DEFAULT_DB_FILENAME = "cache.sqlite3"
+_TABLE_NAME = "cache"
+
+# sqlite3 connections may only safely be used by the thread that created
+# them unless serialized by the caller; a single lock per connection is
+# cheap and keeps every statement here correct regardless of how many
+# threads a given master process happens to be running.
+_LOCK = threading.Lock()
+
+
+def __dbfile(kwargs=None):
+    if kwargs and kwargs.get("dbfile"):
+        return kwargs["dbfile"]
+    override = __opts__.get("sqlite3.database")
+    if override:
+        return override
+    cachedir = (kwargs or {}).get("cachedir") or __opts__.get(
+        "cachedir", salt.syspaths.CACHE_DIR
+    )
+    return salt.utils.path.join(cachedir, _DEFAULT_DB_FILENAME)
+
+
+def init_kwargs(kwargs):
+    return {"dbfile": __dbfile(kwargs)}
+
+
+def get_storage_id(kwargs):
+    return ("sqlite3", __dbfile(kwargs))
+
+
+def _connect(dbfile):
+    """
+    Return a connection to ``dbfile``, creating and configuring it on the
+    first call for this process. The connection is cached in
+    ``__context__`` so subsequent calls are cheap.
+    """
+    if dbfile is None:
+        dbfile = __dbfile()
+
+    conn = __context__.get("sqlite3_client")
+    if conn is not None and __context__.get("sqlite3_dbfile") == dbfile:
+        return conn
+
+    directory = os.path.dirname(dbfile)
+    if directory and not os.path.isdir(directory):
+        try:
+            os.makedirs(directory)
+        except OSError as exc:
+            if exc.errno != errno.EEXIST:
+                raise SaltCacheError(
+                    f"The cache directory, {directory}, could not be created: {exc}"
+                )
+
+    timeout = float(__opts__.get("sqlite3.timeout", 5))
+    try:
+        conn = sqlite3.connect(
+            dbfile,
+            timeout=timeout,
+            check_same_thread=False,
+            isolation_level=None,
+        )
+        # WAL keeps readers and a writer from blocking each other, and
+        # survives a master restart just as well as the default journal
+        # mode; busy_timeout keeps concurrent master worker processes from
+        # raising "database is locked" the moment they collide.
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute("PRAGMA synchronous=NORMAL")
+        conn.execute(f"PRAGMA busy_timeout={int(timeout * 1000)}")
+        conn.execute(
+            f"CREATE TABLE IF NOT EXISTS {_TABLE_NAME} ("
+            "bank TEXT NOT NULL, "
+            "key TEXT NOT NULL, "
+            "data BLOB, "
+            "last_update INTEGER NOT NULL, "
+            "PRIMARY KEY (bank, key))"
+        )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error opening cache database {dbfile}: {exc}")
+
+    __context__["sqlite3_client"] = conn
+    __context__["sqlite3_dbfile"] = dbfile
+    return conn
+
+
+def store(bank, key, data, dbfile=None):
+    """
+    Store a key value.
+    """
+    conn = _connect(dbfile)
+    payload = salt.payload.dumps(data)
+    now = int(time.time())
+    with _LOCK:
+        try:
+            conn.execute(
+                f"INSERT OR REPLACE INTO {_TABLE_NAME} "
+                "(bank, key, data, last_update) VALUES (?, ?, ?, ?)",
+                (bank, key, payload, now),
+            )
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error storing {bank} {key}: {exc}")
+
+
+def fetch(bank, key, dbfile=None):
+    """
+    Fetch a key value.
+    """
+    conn = _connect(dbfile)
+    with _LOCK:
+        try:
+            cur = conn.execute(
+                f"SELECT data FROM {_TABLE_NAME} WHERE bank=? AND key=?",
+                (bank, key),
+            )
+            row = cur.fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error fetching {bank} {key}: {exc}")
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key, dbfile=None):
+    """
+    Return the integer Unix epoch update timestamp of the specified bank and
+    key.
+    """
+    conn = _connect(dbfile)
+    with _LOCK:
+        try:
+            cur = conn.execute(
+                f"SELECT last_update FROM {_TABLE_NAME} WHERE bank=? AND key=?",
+                (bank, key),
+            )
+            row = cur.fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error reading update time for {bank} {key}: {exc}")
+    return int(row[0]) if row else None
+
+
+def flush(bank, key=None, dbfile=None):
+    """
+    Remove the key from the cache bank with all the key content. If ``key``
+    is ``None``, remove the entire bank.
+    """
+    conn = _connect(dbfile)
+    with _LOCK:
+        try:
+            if key is None:
+                cur = conn.execute(f"DELETE FROM {_TABLE_NAME} WHERE bank=?", (bank,))
+            else:
+                cur = conn.execute(
+                    f"DELETE FROM {_TABLE_NAME} WHERE bank=? AND key=?", (bank, key)
+                )
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error flushing {bank} {key}: {exc}")
+    return cur.rowcount > 0
+
+
+def list_(bank, dbfile=None):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank.
+    """
+    conn = _connect(dbfile)
+    with _LOCK:
+        try:
+            cur = conn.execute(f"SELECT key FROM {_TABLE_NAME} WHERE bank=?", (bank,))
+            rows = cur.fetchall()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error listing {bank}: {exc}")
+    return [row[0] for row in rows]
+
+
+def contains(bank, key, dbfile=None):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    conn = _connect(dbfile)
+    with _LOCK:
+        try:
+            if key is None:
+                cur = conn.execute(
+                    f"SELECT 1 FROM {_TABLE_NAME} WHERE bank=? LIMIT 1", (bank,)
+                )
+            else:
+                cur = conn.execute(
+                    f"SELECT 1 FROM {_TABLE_NAME} WHERE bank=? AND key=? LIMIT 1",
+                    (bank, key),
+                )
+            row = cur.fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error checking {bank} {key}: {exc}")
+    return row is not None
+
+
+def list_all(bank, include_data=False, dbfile=None):
+    """
+    Return ``{key: data}`` for every entry in ``bank`` in a single pass.
+    """
+    conn = _connect(dbfile)
+    with _LOCK:
+        try:
+            if include_data:
+                cur = conn.execute(
+                    f"SELECT key, data FROM {_TABLE_NAME} WHERE bank=?", (bank,)
+                )
+                rows = cur.fetchall()
+            else:
+                cur = conn.execute(
+                    f"SELECT key FROM {_TABLE_NAME} WHERE bank=?", (bank,)
+                )
+                rows = [(row[0], None) for row in cur.fetchall()]
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error listing {bank}: {exc}")
+    if not include_data:
+        return {row[0]: {} for row in rows}
+    return {row[0]: salt.payload.loads(row[1]) for row in rows}
