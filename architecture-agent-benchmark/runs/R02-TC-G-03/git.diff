+import logging
+import shutil
+
+import pytest
+
+import salt.cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def cache(minion_opts):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    cache = salt.cache.factory(opts)
+    try:
+        yield cache
+    finally:
+        cache.destroy()
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_data_survives_master_restart(minion_opts, tmp_path):
+    """
+    The whole point of the sqlite3 backend is that cached data survives a
+    restart of the master process. Simulate that by dropping the ``Cache``
+    instance (and with it, its cached sqlite3 connection) and building a
+    brand new one pointed at the same cachedir/database file.
+    """
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    opts["cachedir"] = str(tmp_path)
+
+    cache_before_restart = salt.cache.factory(opts)
+    cache_before_restart.store("minions/web1", "data", {"grain": "value"})
+    cache_before_restart.destroy()
+    del cache_before_restart
+
+    cache_after_restart = salt.cache.factory(opts)
+    try:
+        assert cache_after_restart.fetch("minions/web1", "data") == {
+            "grain": "value"
+        }
+    finally:
+        cache_after_restart.destroy()
