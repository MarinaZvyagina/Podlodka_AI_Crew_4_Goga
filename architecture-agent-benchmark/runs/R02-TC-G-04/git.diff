index 0000000..7e3699c
--- /dev/null
+++ b/salt/cache/sqlite3_cache.py
@@ -0,0 +1,265 @@
+"""
+Minion data cache backed by a single SQLite3 database file.
+
+.. versionadded:: 3009.0
+
+This cache module lets a Salt Master persist its minion data cache (cached
+grains, mine data, job returns, etc.) in one ordinary SQLite3 database file
+on disk, without having to install and operate a separate database service
+such as MySQL, Redis, Consul or etcd. It only relies on the ``sqlite3``
+module, which ships as part of a standard Python installation, so there is
+nothing extra to install. Data stored this way survives a restart of the
+master process.
+
+The following values can be set in the master config to control the
+behavior of this module. These are the defaults:
+
+.. code-block:: yaml
+
+    sqlite3.database: <cachedir>/cache.sqlite3
+    sqlite3.table_name: cache
+    sqlite3.timeout: 5.0
+
+.. warning::
+
+    The ``sqlite3.table_name`` value is directly added into certain
+    queries. Salt treats this as trusted input.
+
+To use sqlite3 as the minion data cache backend, set the master ``cache``
+config value to ``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+"""
+
+import logging
+import os
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+from salt.exceptions import SaltCacheError
+
+try:
+    import sqlite3
+
+    HAS_SQLITE3 = True
+except ImportError:
+    HAS_SQLITE3 = False
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+_DEFAULT_TABLE_NAME = "cache"
+_DEFAULT_TIMEOUT = 5.0
+
+# Guards creation of the (process-wide, cached-in-__context__) connection so
+# concurrent threads in the same process don't race to open/create it.
+_init_lock = threading.Lock()
+
+
+def __virtual__():
+    if not HAS_SQLITE3:
+        return (
+            False,
+            "No python sqlite3 module found (sqlite3 support may not be "
+            "compiled into this Python).",
+        )
+    return __virtualname__
+
+
+def force_reconnect():
+    """
+    Drop the cached database connection so the next cache operation reopens
+    the database file.
+    """
+    conn = __context__.pop("sqlite3_client", None)
+    if conn is not None:
+        conn.close()
+    __context__.pop("sqlite3_query_lock", None)
+
+
+def _table_name():
+    return __opts__.get("sqlite3.table_name", _DEFAULT_TABLE_NAME)
+
+
+def _database_path():
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    return __opts__.get("sqlite3.database", os.path.join(cachedir, "cache.sqlite3"))
+
+
+def _init_client():
+    """
+    Open (creating if necessary) the sqlite3 cache database and its table,
+    and cache the connection in __context__ for reuse by this process.
+    """
+    if __context__.get("sqlite3_client") is not None:
+        return __context__["sqlite3_client"]
+
+    with _init_lock:
+        if __context__.get("sqlite3_client") is not None:
+            return __context__["sqlite3_client"]
+
+        path = _database_path()
+        dirname = os.path.dirname(path)
+        if dirname and not os.path.isdir(dirname):
+            try:
+                os.makedirs(dirname)
+            except OSError as exc:
+                raise SaltCacheError(
+                    f"The sqlite3 cache directory, {dirname}, could not be "
+                    f"created: {exc}"
+                )
+
+        timeout = __opts__.get("sqlite3.timeout", _DEFAULT_TIMEOUT)
+        try:
+            conn = sqlite3.connect(
+                path,
+                timeout=timeout,
+                isolation_level=None,
+                check_same_thread=False,
+            )
+            # WAL allows readers/writers from other master worker processes
+            # to share this same database file safely.
+            conn.execute("PRAGMA journal_mode=WAL")
+            conn.execute(
+                f"CREATE TABLE IF NOT EXISTS {_table_name()} ("
+                "bank TEXT NOT NULL, "
+                "ckey TEXT NOT NULL, "
+                "data BLOB, "
+                "last_update INTEGER NOT NULL, "
+                "expires_at INTEGER, "
+                "PRIMARY KEY (bank, ckey))"
+            )
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f"Error opening sqlite3 cache database {path}: {exc}"
+            )
+
+        __context__["sqlite3_client"] = conn
+        __context__["sqlite3_query_lock"] = threading.Lock()
+        return conn
+
+
+def _execute(query, args=()):
+    """
+    Run a single query against the cache database, serialized against other
+    callers in this process, and return the cursor.
+    """
+    conn = _init_client()
+    lock = __context__["sqlite3_query_lock"]
+    try:
+        with lock:
+            return conn.execute(query, args)
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error running sqlite3 cache query {query!r}: {exc}")
+
+
+def store(bank, key, data, expires=None):
+    """
+    Store a key value.
+    """
+    now = int(time.time())
+    expires_at = now + int(expires) if expires else None
+    payload = salt.payload.dumps(data)
+    query = (
+        f"REPLACE INTO {_table_name()} "
+        "(bank, ckey, data, last_update, expires_at) VALUES (?, ?, ?, ?, ?)"
+    )
+    _execute(query, (bank, key, payload, now, expires_at))
+
+
+def fetch(bank, key):
+    """
+    Fetch a key value.
+    """
+    now = int(time.time())
+    query = (
+        f"SELECT data FROM {_table_name()} WHERE bank=? AND ckey=? "
+        "AND (expires_at IS NULL OR expires_at > ?)"
+    )
+    row = _execute(query, (bank, key, now)).fetchone()
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def flush(bank, key=None):
+    """
+    Remove the key from the cache bank with all the key content. If key is
+    omitted, remove the entire bank.
+    """
+    if key is None:
+        query = f"DELETE FROM {_table_name()} WHERE bank=?"
+        args = (bank,)
+    else:
+        query = f"DELETE FROM {_table_name()} WHERE bank=? AND ckey=?"
+        args = (bank, key)
+    return _execute(query, args).rowcount > 0
+
+
+def list_(bank):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank.
+    """
+    now = int(time.time())
+    query = (
+        f"SELECT ckey FROM {_table_name()} WHERE bank=? "
+        "AND (expires_at IS NULL OR expires_at > ?)"
+    )
+    return [row[0] for row in _execute(query, (bank, now)).fetchall()]
+
+
+def contains(bank, key=None):
+    """
+    Checks if the specified bank contains the specified key. If key is
+    omitted, checks whether the bank itself has any entries.
+    """
+    now = int(time.time())
+    if key is None:
+        query = (
+            f"SELECT COUNT(*) FROM {_table_name()} WHERE bank=? "
+            "AND (expires_at IS NULL OR expires_at > ?)"
+        )
+        args = (bank, now)
+    else:
+        query = (
+            f"SELECT COUNT(*) FROM {_table_name()} WHERE bank=? AND ckey=? "
+            "AND (expires_at IS NULL OR expires_at > ?)"
+        )
+        args = (bank, key, now)
+    row = _execute(query, args).fetchone()
+    return bool(row and row[0])
+
+
+def updated(bank, key):
+    """
+    Return the integer Unix epoch update timestamp of the specified bank and
+    key, or None if it does not exist.
+    """
+    now = int(time.time())
+    query = (
+        f"SELECT last_update FROM {_table_name()} WHERE bank=? AND ckey=? "
+        "AND (expires_at IS NULL OR expires_at > ?)"
+    )
+    row = _execute(query, (bank, key, now)).fetchone()
+    if row is None:
+        return None
+    return int(row[0])
+
+
+def clean_expired(bank, *args, **kwargs):
+    """
+    Remove all expired keys from the specified bank.
+    """
+    now = int(time.time())
+    query = (
+        f"DELETE FROM {_table_name()} "
+        "WHERE bank=? AND expires_at IS NOT NULL AND expires_at <= ?"
+    )
+    _execute(query, (bank, now))
