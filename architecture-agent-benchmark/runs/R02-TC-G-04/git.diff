diff --git a/salt/cache/CODEMANIFEST b/salt/cache/CODEMANIFEST
index 30c742a..ff4dc70 100644
--- a/salt/cache/CODEMANIFEST
+++ b/salt/cache/CODEMANIFEST
@@ -73,6 +73,28 @@ Annotations: |
       Delete the on-disk entry for `key` in `bank` (or the whole `bank` directory if `key` is
       omitted).
 
+"Cache::Sqlite3Backend()":
+  location: sqlite3_cache.py
+  annotations: |
+    An alternative single-file cache backend driver, selected via `cache: sqlite3`: stores all
+    banks/keys as rows in one table of a single on-disk SQLite database file, using only the
+    `sqlite3` module from the Python standard library. Gives durable, restart-surviving storage
+    without operating a separate database service, for deployments that don't want the per-key
+    filesystem layout of `LocalFSBackend` or a networked backend. Supports the `store` `expires`
+    kwarg natively (an `expires_at` column) and implements `clean_expired`, rather than relying
+    on `Cache`'s generic envelope-based expiry fallback.
+  methods:
+    "store(bank: str, key: str, data: object, expires: int | None)": |
+      Serialize `data` and upsert it as a row keyed by `bank`/`key`, recording `last_update` and,
+      if `expires` is given, an absolute `expires_at` epoch.
+    "fetch(bank: str, key: str) -> data:object": |
+      Read and deserialize the row for `bank`/`key`, or an empty value if it doesn't exist or has
+      expired.
+    "flush(bank: str, key: str | None)": |
+      Delete the row(s) for `key` in `bank` (or all rows in `bank` if `key` is omitted).
+    "clean_expired(bank: str)": |
+      Delete all rows in `bank` whose `expires_at` has passed.
+
 ---
 
 Author: Goga
diff --git a/salt/cache/sqlite3_cache.py b/salt/cache/sqlite3_cache.py
