@@ -0,0 +1,39 @@
+import logging
+
+import pytest
+
+import salt.cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def cache(minion_opts, tmp_path):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    opts["sqlite3.database"] = str(tmp_path / "cache.sqlite3")
+    cache = salt.cache.factory(opts)
+    try:
+        yield cache
+    finally:
+        cache.modules["sqlite3.force_reconnect"]()
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_cache_persists_across_a_simulated_master_restart(cache):
+    """
+    The whole point of the sqlite3 backend is that a master restart doesn't
+    lose previously cached data. Dropping and reopening the connection to
+    the same database file stands in for a process restart.
+    """
+    cache.store("minions/test-minion", "data", {"grains": {"os": "TestOS"}})
+
+    cache.modules["sqlite3.force_reconnect"]()
+
+    assert cache.fetch("minions/test-minion", "data") == {
+        "grains": {"os": "TestOS"}
+    }
diff --git a/tests/pytests/unit/cache/test_sqlite3_cache.py b/tests/pytests/unit/cache/test_sqlite3_cache.py
new file mode 100644
index 0000000..350e633
--- /dev/null
+++ b/tests/pytests/unit/cache/test_sqlite3_cache.py
@@ -0,0 +1,149 @@
+"""
+unit tests for the sqlite3_cache cache
+"""
+
+import time
+
+import pytest
+
+import salt.cache.sqlite3_cache as sqlite3_cache
+from salt.exceptions import SaltCacheError
+
+
+@pytest.fixture
+def db_path(tmp_path):
+    return str(tmp_path / "cache.sqlite3")
+
+
+@pytest.fixture
+def configure_loader_modules(db_path):
+    return {sqlite3_cache: {"__opts__": {"sqlite3.database": db_path}}}
+
+
+def test_virtual_requires_sqlite3_module():
+    with pytest.MonkeyPatch().context() as mp:
+        mp.setattr(sqlite3_cache, "HAS_SQLITE3", False)
+        result = sqlite3_cache.__virtual__()
+    assert result[0] is False
+
+
+def test_store_and_fetch_round_trip():
+    sqlite3_cache.store("bank", "key", {"hello": "world"})
+    assert sqlite3_cache.fetch("bank", "key") == {"hello": "world"}
+
+
+def test_fetch_missing_key_returns_empty_dict():
+    assert sqlite3_cache.fetch("bank", "missing") == {}
+
+
+def test_store_overwrites_existing_value():
+    sqlite3_cache.store("bank", "key", "first")
+    sqlite3_cache.store("bank", "key", "second")
+    assert sqlite3_cache.fetch("bank", "key") == "second"
+
+
+def test_list_returns_keys_in_bank():
+    sqlite3_cache.store("bank", "k1", "v1")
+    sqlite3_cache.store("bank", "k2", "v2")
+    sqlite3_cache.store("other", "k3", "v3")
+    assert set(sqlite3_cache.list_("bank")) == {"k1", "k2"}
+
+
+def test_list_empty_bank_returns_empty_list():
+    assert sqlite3_cache.list_("nonexistent") == []
+
+
+def test_contains_key_and_bank():
+    sqlite3_cache.store("bank", "key", "value")
+    assert sqlite3_cache.contains("bank", "key") is True
+    assert sqlite3_cache.contains("bank", None) is True
+    assert sqlite3_cache.contains("bank", "nope") is False
+    assert sqlite3_cache.contains("nope", None) is False
+
+
+def test_flush_single_key():
+    sqlite3_cache.store("bank", "k1", "v1")
+    sqlite3_cache.store("bank", "k2", "v2")
+    assert sqlite3_cache.flush("bank", "k1") is True
+    assert sqlite3_cache.fetch("bank", "k1") == {}
+    assert sqlite3_cache.fetch("bank", "k2") == "v2"
+
+
+def test_flush_missing_key_returns_false():
+    assert sqlite3_cache.flush("bank", "missing") is False
+
+
+def test_flush_entire_bank():
+    sqlite3_cache.store("bank", "k1", "v1")
+    sqlite3_cache.store("bank", "k2", "v2")
+    assert sqlite3_cache.flush("bank", None) is True
+    assert sqlite3_cache.list_("bank") == []
+
+
+def test_updated_returns_recent_epoch():
+    before = int(time.time())
+    sqlite3_cache.store("bank", "key", "value")
+    after = int(time.time())
+    ts = sqlite3_cache.updated("bank", "key")
+    assert before <= ts <= after
+
+
+def test_updated_missing_key_returns_none():
+    assert sqlite3_cache.updated("bank", "missing") is None
+
+
+def test_store_with_expires_is_fetchable_before_expiry():
+    sqlite3_cache.store("bank", "key", "value", expires=3600)
+    assert sqlite3_cache.fetch("bank", "key") == "value"
+    assert sqlite3_cache.contains("bank", "key") is True
+
+
+def test_store_with_expires_is_gone_after_expiry():
+    sqlite3_cache.store("bank", "key", "value", expires=-1)
+    assert sqlite3_cache.fetch("bank", "key") == {}
+    assert sqlite3_cache.contains("bank", "key") is False
+    assert sqlite3_cache.list_("bank") == []
+    assert sqlite3_cache.updated("bank", "key") is None
+
+
+def test_clean_expired_removes_only_expired_entries():
+    sqlite3_cache.store("bank", "expired", "old", expires=-1)
+    sqlite3_cache.store("bank", "fresh", "new", expires=3600)
+    sqlite3_cache.store("bank", "no_expiry", "forever")
+
+    sqlite3_cache.clean_expired("bank")
+
+    assert sqlite3_cache.fetch("bank", "expired") == {}
+    assert sqlite3_cache.fetch("bank", "fresh") == "new"
+    assert sqlite3_cache.fetch("bank", "no_expiry") == "forever"
+
+
+def test_data_persists_across_reconnect(db_path):
+    """
+    A restart of the master process means a fresh Python process re-opening
+    the same database file. Simulate that by dropping the cached connection
+    and confirm previously stored data can still be read back.
+    """
+    sqlite3_cache.store("bank", "key", {"still": "here"})
+
+    sqlite3_cache.force_reconnect()
+
+    assert sqlite3_cache.fetch("bank", "key") == {"still": "here"}
+
+
+def test_custom_table_name_is_used(db_path):
+    with pytest.MonkeyPatch().context() as mp:
+        mp.setitem(sqlite3_cache.__opts__, "sqlite3.table_name", "custom_cache")
+        sqlite3_cache.store("bank", "key", "value")
+
+    conn = sqlite3_cache.__context__["sqlite3_client"]
+    cur = conn.execute(
+        "SELECT data FROM custom_cache WHERE bank=? AND ckey=?", ("bank", "key")
+    )
+    assert cur.fetchone() is not None
+
+
+def test_query_error_raises_saltcacheerror():
+    sqlite3_cache._init_client()
+    with pytest.raises(SaltCacheError):
+        sqlite3_cache._execute("SELECT * FROM no_such_table")
