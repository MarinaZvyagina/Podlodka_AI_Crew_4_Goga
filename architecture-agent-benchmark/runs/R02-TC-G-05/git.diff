@@ -0,0 +1,296 @@
+"""
+Cache data in a local SQLite3 database.
+
+.. versionadded:: 3008.0
+
+The ``sqlite3`` cache module stores the minion data cache (grains, mine
+data, job returns, etc.) in a single SQLite database file on disk. Unlike
+``localfs`` this survives being queried concurrently by many master worker
+processes without the directory-per-key overhead, and unlike ``mysql``,
+``redis``, ``consul`` or ``etcd`` it requires no separate database service
+or third-party python package -- only the ``sqlite3`` module from the
+Python standard library.
+
+This is intended for small, single-node Salt masters that want their
+cached minion data to survive a restart of the master without having to
+stand up and operate an external database.
+
+To enable this cache plugin, set the master ``cache`` config value to
+``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+By default the database file is created inside the master's
+:conf_master:`cachedir` as ``salt_cache.sqlite3``. An alternate location can
+be configured with ``sqlite3.database``:
+
+.. code-block:: yaml
+
+    sqlite3.database: /var/cache/salt/master/salt_cache.sqlite3
+
+Additional options:
+
+.. code-block:: yaml
+
+    # How long, in milliseconds, a connection will wait for a lock held by
+    # another process/thread before giving up. Default 5000.
+    sqlite3.busy_timeout: 5000
+"""
+
+import errno
+import logging
+import os
+import time
+
+try:
+    import sqlite3
+
+    HAS_SQLITE3 = True
+except ImportError:
+    HAS_SQLITE3 = False
+
+import salt.payload
+import salt.syspaths
+import salt.utils.path
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+_DEFAULT_DB_FILENAME = "salt_cache.sqlite3"
+_DEFAULT_BUSY_TIMEOUT = 5000  # milliseconds
+
+_TABLE_NAME = "cache"
+
+
+def __virtual__():
+    """
+    Confirm that the sqlite3 module (part of the Python standard library) is
+    available.
+    """
+    if not HAS_SQLITE3:
+        return (
+            False,
+            "Could not import the sqlite3 module, is it included in this "
+            "Python install?",
+        )
+    return __virtualname__
+
+
+def __cachedir(kwargs=None):
+    if kwargs and "cachedir" in kwargs:
+        return kwargs["cachedir"]
+    return __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+
+
+def _db_path(kwargs=None):
+    if kwargs and kwargs.get("db_path"):
+        return kwargs["db_path"]
+    configured = __opts__.get("sqlite3.database")
+    if configured:
+        return configured
+    return salt.utils.path.join(__cachedir(kwargs), _DEFAULT_DB_FILENAME)
+
+
+def init_kwargs(kwargs):
+    return {"db_path": _db_path(kwargs)}
+
+
+def get_storage_id(kwargs):
+    return ("sqlite3", _db_path(kwargs))
+
+
+def _busy_timeout():
+    return int(__opts__.get("sqlite3.busy_timeout", _DEFAULT_BUSY_TIMEOUT))
+
+
+def _connect(db_path):
+    directory = os.path.dirname(db_path)
+    if directory and not os.path.isdir(directory):
+        try:
+            os.makedirs(directory)
+        except OSError as exc:
+            if exc.errno != errno.EEXIST:
+                raise SaltCacheError(
+                    f"The cache directory, {directory}, could not be created: {exc}"
+                )
+    try:
+        conn = sqlite3.connect(
+            db_path,
+            timeout=_busy_timeout() / 1000.0,
+            isolation_level=None,
+            check_same_thread=False,
+        )
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute("PRAGMA synchronous=NORMAL")
+        conn.execute(f"PRAGMA busy_timeout={_busy_timeout()}")
+        conn.execute(
+            f"CREATE TABLE IF NOT EXISTS {_TABLE_NAME} ("
+            "bank TEXT NOT NULL, "
+            "cache_key TEXT NOT NULL, "
+            "data BLOB, "
+            "updated INTEGER NOT NULL, "
+            "PRIMARY KEY (bank, cache_key))"
+        )
+        conn.execute(
+            f"CREATE INDEX IF NOT EXISTS cache_bank_idx ON {_TABLE_NAME} (bank)"
+        )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f'Could not open the cache database "{db_path}": {exc}')
+    return conn
+
+
+def _get_conn(db_path):
+    connections = __context__.setdefault("sqlite3_connections", {})
+    conn = connections.get(db_path)
+    if conn is None:
+        conn = connections[db_path] = _connect(db_path)
+    return conn
+
+
+def _sub_bank_prefix(bank):
+    # A sub-bank of "foo" is stored with a bank column of "foo/bar", never
+    # "foobar", so the LIKE pattern must anchor on the separator.
+    return bank + "/%"
+
+
+def store(bank, key, data, db_path):
+    """
+    Store information in the database.
+    """
+    conn = _get_conn(db_path)
+    try:
+        value = salt.payload.dumps(data)
+        conn.execute(
+            f"INSERT OR REPLACE INTO {_TABLE_NAME} "
+            "(bank, cache_key, data, updated) VALUES (?, ?, ?, ?)",
+            (bank, key, value, int(time.time())),
+        )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f'There was an error writing the cache key "{bank}/{key}": {exc}'
+        )
+
+
+def fetch(bank, key, db_path):
+    """
+    Fetch information from the database.
+    """
+    conn = _get_conn(db_path)
+    try:
+        cur = conn.execute(
+            f"SELECT data FROM {_TABLE_NAME} WHERE bank=? AND cache_key=?",
+            (bank, key),
+        )
+        row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f'There was an error reading the cache key "{bank}/{key}": {exc}'
+        )
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key, db_path):
+    """
+    Return the epoch of the last update for this cache key.
+    """
+    conn = _get_conn(db_path)
+    try:
+        cur = conn.execute(
+            f"SELECT updated FROM {_TABLE_NAME} WHERE bank=? AND cache_key=?",
+            (bank, key),
+        )
+        row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f'There was an error reading the mtime for "{bank}/{key}": {exc}'
+        )
+    if row is None:
+        return None
+    return int(row[0])
+
+
+def flush(bank, key=None, db_path=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key is
+    specified, remove the entire bank with all keys and sub-banks inside.
+    """
+    if db_path is None:
+        db_path = _db_path()
+    conn = _get_conn(db_path)
+    try:
+        if key is None:
+            cur = conn.execute(
+                f"SELECT 1 FROM {_TABLE_NAME} WHERE bank=? OR bank LIKE ? LIMIT 1",
+                (bank, _sub_bank_prefix(bank)),
+            )
+            if cur.fetchone() is None:
+                return False
+            conn.execute(
+                f"DELETE FROM {_TABLE_NAME} WHERE bank=? OR bank LIKE ?",
+                (bank, _sub_bank_prefix(bank)),
+            )
+            return True
+        else:
+            cur = conn.execute(
+                f"DELETE FROM {_TABLE_NAME} WHERE bank=? AND cache_key=?",
+                (bank, key),
+            )
+            return cur.rowcount > 0
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f'There was an error removing "{bank}/{key}": {exc}')
+
+
+def list_(bank, db_path):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank, including the names of any direct sub-banks.
+    """
+    conn = _get_conn(db_path)
+    try:
+        cur = conn.execute(
+            f"SELECT cache_key FROM {_TABLE_NAME} WHERE bank=?", (bank,)
+        )
+        ret = [row[0] for row in cur.fetchall()]
+
+        prefix = _sub_bank_prefix(bank)
+        cur = conn.execute(
+            f"SELECT DISTINCT bank FROM {_TABLE_NAME} WHERE bank LIKE ?", (prefix,)
+        )
+        sub_banks = set()
+        offset = len(bank) + 1
+        for (sub_bank,) in cur.fetchall():
+            sub_banks.add(sub_bank[offset:].split("/", 1)[0])
+        ret.extend(sub_banks)
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f'There was an error listing the bank "{bank}": {exc}')
+    return ret
+
+
+def contains(bank, key, db_path):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    conn = _get_conn(db_path)
+    try:
+        if key is None:
+            cur = conn.execute(
+                f"SELECT 1 FROM {_TABLE_NAME} WHERE bank=? OR bank LIKE ? LIMIT 1",
+                (bank, _sub_bank_prefix(bank)),
+            )
+        else:
+            cur = conn.execute(
+                f"SELECT 1 FROM {_TABLE_NAME} WHERE bank=? AND cache_key=? LIMIT 1",
+                (bank, key),
+            )
+        return cur.fetchone() is not None
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f'There was an error checking for "{bank}/{key}": {exc}'
+        )
