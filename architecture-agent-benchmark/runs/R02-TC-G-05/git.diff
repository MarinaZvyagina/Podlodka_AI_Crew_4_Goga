@@ -0,0 +1,169 @@
+"""
+Unit tests for salt.cache.sqlite3_cache
+"""
+
+import pytest
+
+import salt.cache
+import salt.cache.sqlite3_cache as sqlite3_cache
+
+pytestmark = [
+    pytest.mark.skipif(
+        not sqlite3_cache.HAS_SQLITE3, reason="No sqlite3 module available"
+    ),
+]
+
+
+@pytest.fixture
+def db_path(tmp_path):
+    return str(tmp_path / "salt_cache.sqlite3")
+
+
+@pytest.fixture
+def configure_loader_modules(tmp_path):
+    return {sqlite3_cache: {"__opts__": {"cachedir": str(tmp_path)}}}
+
+
+def test_store_fetch_roundtrip(db_path):
+    sqlite3_cache.store("bank", "key", {"foo": "bar"}, db_path)
+    assert sqlite3_cache.fetch("bank", "key", db_path) == {"foo": "bar"}
+
+
+def test_fetch_missing_key_returns_empty(db_path):
+    assert sqlite3_cache.fetch("bank", "does-not-exist", db_path) == {}
+
+
+def test_fetch_missing_bank_returns_empty(db_path):
+    assert sqlite3_cache.fetch("ghost-bank", "key", db_path) == {}
+
+
+def test_store_overwrite(db_path):
+    sqlite3_cache.store("bank", "key", {"v": 1}, db_path)
+    sqlite3_cache.store("bank", "key", {"v": 2}, db_path)
+    assert sqlite3_cache.fetch("bank", "key", db_path) == {"v": 2}
+
+
+def test_updated_returns_none_for_missing_key(db_path):
+    assert sqlite3_cache.updated("bank", "key", db_path) is None
+
+
+def test_updated_returns_epoch_after_store(db_path):
+    sqlite3_cache.store("bank", "key", "data", db_path)
+    updated = sqlite3_cache.updated("bank", "key", db_path)
+    assert isinstance(updated, int)
+    assert updated > 0
+
+
+def test_contains_key(db_path):
+    assert sqlite3_cache.contains("bank", "key", db_path) is False
+    sqlite3_cache.store("bank", "key", "data", db_path)
+    assert sqlite3_cache.contains("bank", "key", db_path) is True
+
+
+def test_contains_bank_without_key(db_path):
+    assert sqlite3_cache.contains("bank", None, db_path) is False
+    sqlite3_cache.store("bank", "key", "data", db_path)
+    assert sqlite3_cache.contains("bank", None, db_path) is True
+
+
+def test_list_returns_keys(db_path):
+    sqlite3_cache.store("bank", "key1", "data1", db_path)
+    sqlite3_cache.store("bank", "key2", "data2", db_path)
+    assert sorted(sqlite3_cache.list_("bank", db_path)) == ["key1", "key2"]
+
+
+def test_list_empty_bank_returns_empty_list(db_path):
+    assert sqlite3_cache.list_("ghost-bank", db_path) == []
+
+
+def test_list_includes_direct_sub_banks(db_path):
+    sqlite3_cache.store("minions", "top-level-key", "data", db_path)
+    sqlite3_cache.store("minions/alpha", "data", {"id": "alpha"}, db_path)
+    sqlite3_cache.store("minions/alpha/mine", "func", "result", db_path)
+    sqlite3_cache.store("minions/beta", "data", {"id": "beta"}, db_path)
+
+    listing = sqlite3_cache.list_("minions", db_path)
+    assert sorted(listing) == ["alpha", "beta", "top-level-key"]
+
+
+def test_flush_single_key(db_path):
+    sqlite3_cache.store("bank", "key1", "data1", db_path)
+    sqlite3_cache.store("bank", "key2", "data2", db_path)
+
+    assert sqlite3_cache.flush("bank", "key1", db_path) is True
+    assert sqlite3_cache.contains("bank", "key1", db_path) is False
+    assert sqlite3_cache.contains("bank", "key2", db_path) is True
+
+
+def test_flush_missing_key_returns_false(db_path):
+    assert sqlite3_cache.flush("bank", "does-not-exist", db_path) is False
+
+
+def test_flush_missing_bank_returns_false(db_path):
+    assert sqlite3_cache.flush("ghost-bank", None, db_path) is False
+
+
+def test_flush_entire_bank_removes_sub_banks(db_path):
+    sqlite3_cache.store("minions/alpha", "data", {"id": "alpha"}, db_path)
+    sqlite3_cache.store("minions/alpha/mine", "func", "result", db_path)
+    sqlite3_cache.store("minions/beta", "data", {"id": "beta"}, db_path)
+
+    assert sqlite3_cache.flush("minions/alpha", None, db_path) is True
+
+    assert sqlite3_cache.contains("minions/alpha", "data", db_path) is False
+    assert sqlite3_cache.contains("minions/alpha/mine", "func", db_path) is False
+    # sibling bank is untouched
+    assert sqlite3_cache.contains("minions/beta", "data", db_path) is True
+
+
+def test_data_survives_new_connection(db_path):
+    """
+    Simulates a master restart: a fresh module-level __context__ (a new
+    connection to the same file) must still see previously stored data.
+    """
+    sqlite3_cache.store("bank", "key", {"persisted": True}, db_path)
+
+    # Drop the cached connection to force a brand new sqlite3.connect() the
+    # next time a cache function runs, exactly like a fresh master process.
+    sqlite3_cache.__context__.pop("sqlite3_connections", None)
+
+    assert sqlite3_cache.fetch("bank", "key", db_path) == {"persisted": True}
+
+
+def test_various_value_types_roundtrip(db_path):
+    values = [
+        "plain string",
+        12345,
+        [1, 2, 3],
+        {"a": {"b": [1, 2, {"c": True}]}},
+        {"unicode": "áéíóú", "cjk": "中文", "emoji": "🔥"},
+        {"raw": b"\xfe\x99\x00\xff"},
+    ]
+    for i, value in enumerate(values):
+        key = f"key{i}"
+        sqlite3_cache.store("bank", key, value, db_path)
+        assert sqlite3_cache.fetch("bank", key, db_path) == value
+
+
+def test_via_cache_facade(tmp_path):
+    """
+    End-to-end through salt.cache.Cache, the way the master actually uses
+    the driver, including restart-persistence via a brand new Cache/loader.
+    """
+    opts = {
+        "cache": "sqlite3",
+        "cachedir": str(tmp_path),
+        "memcache_expire_seconds": 0,
+    }
+
+    cache = salt.cache.factory(opts)
+    cache.store("minions/alpha", "data", {"id": "alpha"})
+    assert cache.fetch("minions/alpha", "data") == {"id": "alpha"}
+    cache.destroy()
+
+    # A brand new Cache (and therefore a brand new loader/module/connection)
+    # simulates restarting the master process.
+    restarted_cache = salt.cache.factory(opts)
+    assert restarted_cache.fetch("minions/alpha", "data") == {"id": "alpha"}
+    assert restarted_cache.contains("minions/alpha", "data") is True
+    restarted_cache.destroy()
