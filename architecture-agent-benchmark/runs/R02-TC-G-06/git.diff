@@ -0,0 +1,49 @@
+import logging
+import shutil
+
+import pytest
+
+import salt.cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def cache(minion_opts, tmp_path):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    opts["sqlite3_cache.database_file"] = str(tmp_path / "cache.sqlite3")
+    cache = salt.cache.factory(opts)
+    try:
+        yield cache
+    finally:
+        cache.modules[f"{cache.driver}.force_reconnect"]()
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_restart_survives_data(minion_opts, tmp_path):
+    """
+    Data stored by one Cache instance must be readable by a brand new
+    Cache instance pointed at the same database file, simulating a master
+    restart.
+    """
+    database_file = str(tmp_path / "cache.sqlite3")
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    opts["sqlite3_cache.database_file"] = database_file
+
+    first = salt.cache.factory(opts)
+    first.store("minions/alpha", "data", {"os": "linux"})
+    first.modules[f"{first.driver}.force_reconnect"]()
+
+    second = salt.cache.factory(opts)
+    try:
+        assert second.fetch("minions/alpha", "data") == {"os": "linux"}
+    finally:
+        second.modules[f"{second.driver}.force_reconnect"]()
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
