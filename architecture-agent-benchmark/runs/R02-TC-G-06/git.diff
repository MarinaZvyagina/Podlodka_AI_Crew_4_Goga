@@ -0,0 +1,101 @@
+"""
+unit tests for the sqlite3_cache cache
+"""
+
+import logging
+
+import pytest
+
+import salt.cache.sqlite3_cache as sqlite3_cache
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def configure_loader_modules(tmp_path):
+    return {
+        sqlite3_cache: {
+            "__opts__": {
+                "cachedir": str(tmp_path),
+                "sqlite3_cache.database_file": str(tmp_path / "cache.sqlite3"),
+            },
+            "__context__": {},
+        }
+    }
+
+
+def test_store_and_fetch():
+    sqlite3_cache.store("minions/minion1", "key1", {"foo": "bar"})
+    assert sqlite3_cache.fetch("minions/minion1", "key1") == {"foo": "bar"}
+
+
+def test_fetch_missing_key_returns_empty_dict():
+    assert sqlite3_cache.fetch("minions/minion1", "nope") == {}
+
+
+def test_store_overwrites_existing_key():
+    sqlite3_cache.store("bank", "key1", "first")
+    sqlite3_cache.store("bank", "key1", "second")
+    assert sqlite3_cache.fetch("bank", "key1") == "second"
+
+
+def test_contains():
+    assert sqlite3_cache.contains("bank", "key1") is False
+    sqlite3_cache.store("bank", "key1", "value")
+    assert sqlite3_cache.contains("bank", "key1") is True
+    assert sqlite3_cache.contains("bank", None) is True
+    assert sqlite3_cache.contains("otherbank", None) is False
+
+
+def test_list():
+    sqlite3_cache.store("bank", "key1", "value1")
+    sqlite3_cache.store("bank", "key2", "value2")
+    assert sorted(sqlite3_cache.list_("bank")) == ["key1", "key2"]
+    assert sqlite3_cache.list_("emptybank") == []
+
+
+def test_flush_single_key():
+    sqlite3_cache.store("bank", "key1", "value1")
+    sqlite3_cache.store("bank", "key2", "value2")
+    assert sqlite3_cache.flush("bank", "key1") is True
+    assert sqlite3_cache.list_("bank") == ["key2"]
+
+
+def test_flush_entire_bank():
+    sqlite3_cache.store("bank", "key1", "value1")
+    sqlite3_cache.store("bank", "key2", "value2")
+    assert sqlite3_cache.flush("bank", None) is True
+    assert sqlite3_cache.list_("bank") == []
+
+
+def test_flush_nonexistent_key_returns_false():
+    assert sqlite3_cache.flush("bank", "nope") is False
+
+
+def test_updated_returns_none_for_missing_key():
+    assert sqlite3_cache.updated("bank", "nope") is None
+
+
+def test_updated_returns_epoch_after_store():
+    import time
+
+    before = int(time.time())
+    sqlite3_cache.store("bank", "key1", "value1")
+    after = int(time.time())
+    result = sqlite3_cache.updated("bank", "key1")
+    assert before <= result <= after
+
+
+def test_data_survives_reconnect():
+    sqlite3_cache.store("bank", "key1", {"persisted": True})
+    sqlite3_cache.force_reconnect()
+    assert sqlite3_cache.fetch("bank", "key1") == {"persisted": True}
+
+
+def test_error_wrapped_as_saltcacheerror():
+    sqlite3_cache.store("bank", "key1", "value1")
+    with pytest.raises(SaltCacheError):
+        # Force a broken connection so the next query raises sqlite3.Error.
+        sqlite3_cache.__context__["sqlite3_client"].close()
+        sqlite3_cache.fetch("bank", "key1")
