+"""
+Cache data in a single SQLite database file.
+
+.. versionadded:: 3009.0
+
+The ``sqlite3`` Minion cache module stores banks/keys/values in one ordinary
+SQLite database file on disk, using only the ``sqlite3`` module that ships
+with a standard Python installation. It is meant for small, single-node Salt
+Masters that want cached minion data (grains, mine data, job returns, etc.)
+to survive a restart of the master process, without having to install and
+operate a separate database service such as MySQL or Redis.
+
+.. warning::
+
+    The ``sqlite3_cache.table_name`` value is directly added into certain
+    queries. Salt treats this as trusted input.
+
+The database file (and its parent directory) are created automatically if
+they do not already exist, as is the backing table.
+
+The following values can be set in the master config. These are the
+defaults:
+
+.. code-block:: yaml
+
+    sqlite3_cache.database_file: <cachedir>/cache.sqlite3
+    sqlite3_cache.table_name: cache
+    # Number of seconds to wait for a write lock before giving up.
+    sqlite3_cache.timeout: 5.0
+
+To use ``sqlite3`` as the minion data cache backend, set the master ``cache``
+config value to ``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+"""
+
+import logging
+import os
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+from salt.exceptions import SaltCacheError
+
+try:
+    import sqlite3
+except ImportError:
+    sqlite3 = None
+
+_DEFAULT_CACHE_TABLE_NAME = "cache"
+_DEFAULT_TIMEOUT = 5.0
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+
+def __virtual__():
+    """
+    Confirm that the stdlib sqlite3 module is available.
+    """
+    if sqlite3 is None:
+        return False, "No python sqlite3 client installed."
+    return True
+
+
+def force_reconnect():
+    """
+    Force a reconnection to the sqlite3 database, by removing the client
+    from Salt's __context__.
+    """
+    conn = __context__.pop("sqlite3_client", None)
+    if conn is not None:
+        conn.close()
+    __context__.pop("sqlite3_table_name", None)
+    __context__.pop("sqlite3_lock", None)
+
+
+def _database_file():
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    default = os.path.join(cachedir, "cache.sqlite3")
+    return __opts__.get("sqlite3_cache.database_file", default)
+
+
+def _create_table(conn, table_name, lock):
+    query = """CREATE TABLE IF NOT EXISTS "{}" (
+        bank TEXT NOT NULL,
+        cache_key TEXT NOT NULL,
+        data BLOB,
+        last_update INTEGER NOT NULL,
+        PRIMARY KEY (bank, cache_key)
+    )""".format(
+        table_name
+    )
+    with lock:
+        conn.execute(query)
+
+
+def _init_client():
+    """
+    Initialize the sqlite3 connection and create the table if needed.
+    """
+    if __context__.get("sqlite3_client") is not None:
+        return
+
+    database_file = _database_file()
+    table_name = __opts__.get("sqlite3_cache.table_name", _DEFAULT_CACHE_TABLE_NAME)
+    timeout = __opts__.get("sqlite3_cache.timeout", _DEFAULT_TIMEOUT)
+
+    db_dir = os.path.dirname(database_file)
+    if db_dir and not os.path.isdir(db_dir):
+        try:
+            os.makedirs(db_dir)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"Unable to create sqlite3 cache directory {db_dir}: {exc}"
+            )
+
+    try:
+        conn = sqlite3.connect(
+            database_file,
+            timeout=timeout,
+            isolation_level=None,
+            check_same_thread=False,
+        )
+        conn.execute("PRAGMA journal_mode=WAL")
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"Unable to open sqlite3 cache database {database_file}: {exc}"
+        )
+
+    log.info("sqlite3_cache: using database file %s", database_file)
+    __context__["sqlite3_client"] = conn
+    __context__["sqlite3_table_name"] = table_name
+    __context__["sqlite3_lock"] = threading.Lock()
+    _create_table(conn, table_name, __context__["sqlite3_lock"])
+
+
+def store(bank, key, data):
+    """
+    Store a key value.
+    """
+    _init_client()
+    conn = __context__["sqlite3_client"]
+    lock = __context__["sqlite3_lock"]
+    table_name = __context__["sqlite3_table_name"]
+    blob = salt.payload.dumps(data)
+    query = 'INSERT OR REPLACE INTO "{}" (bank, cache_key, data, last_update) VALUES (?, ?, ?, ?)'.format(
+        table_name
+    )
+    try:
+        with lock:
+            conn.execute(query, (bank, key, blob, int(time.time())))
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error storing {bank}/{key} in sqlite3 cache: {exc}")
+
+
+def fetch(bank, key):
+    """
+    Fetch a key value.
+    """
+    _init_client()
+    conn = __context__["sqlite3_client"]
+    lock = __context__["sqlite3_lock"]
+    table_name = __context__["sqlite3_table_name"]
+    query = f'SELECT data FROM "{table_name}" WHERE bank = ? AND cache_key = ?'
+    try:
+        with lock:
+            row = conn.execute(query, (bank, key)).fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error fetching {bank}/{key} from sqlite3 cache: {exc}")
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def flush(bank, key=None):
+    """
+    Remove the key from the cache bank with all the key content. If key is
+    None, remove the entire bank.
+    """
+    _init_client()
+    conn = __context__["sqlite3_client"]
+    lock = __context__["sqlite3_lock"]
+    table_name = __context__["sqlite3_table_name"]
+    if key is None:
+        query = f'DELETE FROM "{table_name}" WHERE bank = ?'
+        args = (bank,)
+    else:
+        query = f'DELETE FROM "{table_name}" WHERE bank = ? AND cache_key = ?'
+        args = (bank, key)
+    try:
+        with lock:
+            cur = conn.execute(query, args)
+            removed = cur.rowcount > 0
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error flushing {bank}/{key} from sqlite3 cache: {exc}")
+    return removed
+
+
+def list_(bank):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank.
+    """
+    _init_client()
+    conn = __context__["sqlite3_client"]
+    lock = __context__["sqlite3_lock"]
+    table_name = __context__["sqlite3_table_name"]
+    query = f'SELECT cache_key FROM "{table_name}" WHERE bank = ?'
+    try:
+        with lock:
+            rows = conn.execute(query, (bank,)).fetchall()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error listing bank {bank} in sqlite3 cache: {exc}")
+    return [row[0] for row in rows]
+
+
+def contains(bank, key=None):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    _init_client()
+    conn = __context__["sqlite3_client"]
+    lock = __context__["sqlite3_lock"]
+    table_name = __context__["sqlite3_table_name"]
+    if key is None:
+        query = f'SELECT 1 FROM "{table_name}" WHERE bank = ? LIMIT 1'
+        args = (bank,)
+    else:
+        query = f'SELECT 1 FROM "{table_name}" WHERE bank = ? AND cache_key = ? LIMIT 1'
+        args = (bank, key)
+    try:
+        with lock:
+            row = conn.execute(query, args).fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error checking {bank}/{key} in sqlite3 cache: {exc}")
+    return row is not None
+
+
+def updated(bank, key):
+    """
+    Return the integer Unix epoch update timestamp of the specified bank and
+    key.
+    """
+    _init_client()
+    conn = __context__["sqlite3_client"]
+    lock = __context__["sqlite3_lock"]
+    table_name = __context__["sqlite3_table_name"]
+    query = f'SELECT last_update FROM "{table_name}" WHERE bank = ? AND cache_key = ?'
+    try:
+        with lock:
+            row = conn.execute(query, (bank, key)).fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"Error reading update time for {bank}/{key} in sqlite3 cache: {exc}"
+        )
+    return int(row[0]) if row else None
