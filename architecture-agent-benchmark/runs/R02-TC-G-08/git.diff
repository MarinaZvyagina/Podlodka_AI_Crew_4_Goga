+++ b/salt/cache/sqlite_cache.py
@@ -0,0 +1,219 @@
+"""
+Cache data in a single SQLite database file.
+
+.. versionadded:: 3009.0
+
+The ``sqlite_cache`` module stores minion data cache entries (cached grains,
+mine data, job returns, and similar) in a single ordinary SQLite database
+file on disk. It uses only the :py:mod:`sqlite3` module from the Python
+standard library, so no extra services or third-party packages need to be
+installed.
+
+This makes it a good fit for small, single-node Salt masters that want
+durable, persistent cache storage that survives a restart of the master
+process, without the operational overhead of running a separate database
+service such as Redis or MySQL.
+
+To enable this cache module, set the master ``cache`` config value to
+``sqlite``:
+
+.. code-block:: yaml
+
+    cache: sqlite
+
+By default the database file is created at ``<cachedir>/cache.sqlite``
+(``/var/cache/salt/master/cache.sqlite`` on most platforms). The location
+can be overridden in the master config:
+
+.. code-block:: yaml
+
+    sqlite_cache.database: /var/cache/salt/master/cache.sqlite
+"""
+
+import logging
+import os
+import sqlite3
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite"
+__func_alias__ = {"list_": "list"}
+
+_TABLE = "cache"
+_BUSY_TIMEOUT_MS = 30_000
+
+# One connection per database file, kept open for the life of the process.
+# Guarded by a lock since sqlite3 connections are not safe for concurrent
+# use from multiple threads. Keyed by (pid, database) so that a forked
+# worker process opens its own connection rather than reusing a handle
+# inherited from its parent.
+_connections = {}
+_lock = threading.Lock()
+
+
+def __virtual__():
+    return __virtualname__
+
+
+def _database_path(kwargs=None):
+    if kwargs and kwargs.get("database"):
+        return kwargs["database"]
+    configured = __opts__.get("sqlite_cache.database")
+    if configured:
+        return configured
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    return os.path.join(cachedir, "cache.sqlite")
+
+
+def init_kwargs(kwargs):
+    return {"database": _database_path(kwargs)}
+
+
+def get_storage_id(kwargs):
+    return ("sqlite", _database_path(kwargs))
+
+
+def _connect(database):
+    directory = os.path.dirname(database)
+    if directory:
+        os.makedirs(directory, exist_ok=True)
+    conn = sqlite3.connect(database, timeout=30, isolation_level=None)
+    conn.execute("PRAGMA journal_mode=WAL")
+    conn.execute(f"PRAGMA busy_timeout={_BUSY_TIMEOUT_MS}")
+    conn.execute(
+        f"""
+        CREATE TABLE IF NOT EXISTS {_TABLE} (
+            bank TEXT NOT NULL,
+            key TEXT NOT NULL,
+            data BLOB,
+            updated INTEGER NOT NULL,
+            PRIMARY KEY (bank, key)
+        )
+        """
+    )
+    return conn
+
+
+def _get_conn(database):
+    ident = (os.getpid(), database)
+    with _lock:
+        conn = _connections.get(ident)
+        if conn is None:
+            try:
+                conn = _connect(database)
+            except sqlite3.Error as exc:
+                raise SaltCacheError(
+                    f'There was an error opening the cache database "{database}": {exc}'
+                )
+            _connections[ident] = conn
+        return conn
+
+
+def store(bank, key, data, database):
+    """
+    Store information in the cache database.
+    """
+    conn = _get_conn(database)
+    try:
+        raw = salt.payload.dumps(data)
+        conn.execute(
+            f"INSERT OR REPLACE INTO {_TABLE} (bank, key, data, updated) VALUES (?, ?, ?, ?)",
+            (bank, key, raw, int(time.time())),
+        )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f'There was an error writing the cache entry "{bank}/{key}": {exc}'
+        )
+
+
+def fetch(bank, key, database):
+    """
+    Fetch information from the cache database.
+    """
+    conn = _get_conn(database)
+    try:
+        cur = conn.execute(
+            f"SELECT data FROM {_TABLE} WHERE bank = ? AND key = ?", (bank, key)
+        )
+        row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f'There was an error reading the cache entry "{bank}/{key}": {exc}'
+        )
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key, database):
+    """
+    Return the epoch of the last update for this cache entry.
+    """
+    conn = _get_conn(database)
+    try:
+        cur = conn.execute(
+            f"SELECT updated FROM {_TABLE} WHERE bank = ? AND key = ?", (bank, key)
+        )
+        row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f'There was an error reading the cache entry "{bank}/{key}": {exc}'
+        )
+    if row is None:
+        return None
+    return int(row[0])
+
+
+def flush(bank, key=None, database=None):
+    """
+    Remove the key from the cache bank with all the key content.
+    """
+    if database is None:
+        database = _database_path()
+    conn = _get_conn(database)
+    try:
+        if key is None:
+            cur = conn.execute(f"DELETE FROM {_TABLE} WHERE bank = ?", (bank,))
+        else:
+            cur = conn.execute(
+                f"DELETE FROM {_TABLE} WHERE bank = ? AND key = ?", (bank, key)
+            )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f'There was an error removing "{bank}/{key}": {exc}')
+    return cur.rowcount > 0
+
+
+def list_(bank, database):
+    """
+    Return an iterable object containing all entries stored in the specified bank.
+    """
+    conn = _get_conn(database)
+    try:
+        cur = conn.execute(f"SELECT key FROM {_TABLE} WHERE bank = ?", (bank,))
+        return [row[0] for row in cur.fetchall()]
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f'There was an error listing bank "{bank}": {exc}')
+
+
+def contains(bank, key, database):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    conn = _get_conn(database)
+    try:
+        if key is None:
+            cur = conn.execute(f"SELECT 1 FROM {_TABLE} WHERE bank = ? LIMIT 1", (bank,))
+        else:
+            cur = conn.execute(
+                f"SELECT 1 FROM {_TABLE} WHERE bank = ? AND key = ? LIMIT 1",
+                (bank, key),
+            )
+        return cur.fetchone() is not None
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f'There was an error reading "{bank}/{key}": {exc}')
diff --git a/tests/pytests/functional/cache/test_sqlite.py b/tests/pytests/functional/cache/test_sqlite.py
