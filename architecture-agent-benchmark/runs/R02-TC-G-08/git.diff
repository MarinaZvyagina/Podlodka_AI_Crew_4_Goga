index 0000000..6169e49
--- /dev/null
+++ b/tests/pytests/unit/cache/test_sqlite_cache.py
@@ -0,0 +1,140 @@
+"""
+Validate the functions in the sqlite_cache cache module.
+"""
+
+import sqlite3
+
+import pytest
+
+import salt.cache.sqlite_cache as sqlite_cache
+from salt.exceptions import SaltCacheError
+from tests.support.mock import MagicMock, patch
+
+
+@pytest.fixture
+def configure_loader_modules():
+    return {sqlite_cache: {}}
+
+
+@pytest.fixture(autouse=True)
+def _clear_connections():
+    # Each test gets its own database file (tmp_path), but the module-level
+    # connection registry is keyed by (pid, database) and would otherwise
+    # leak open connections between tests.
+    yield
+    for conn in sqlite_cache._connections.values():
+        conn.close()
+    sqlite_cache._connections.clear()
+
+
+@pytest.fixture
+def database(tmp_path):
+    return str(tmp_path / "cache.sqlite")
+
+
+def test_store_and_fetch(database):
+    sqlite_cache.store("bank", "key", "payload data", database)
+    assert sqlite_cache.fetch("bank", "key", database) == "payload data"
+
+
+def test_fetch_missing_key_returns_empty_dict(database):
+    assert sqlite_cache.fetch("bank", "missing", database) == {}
+
+
+def test_store_overwrites_existing_key(database):
+    sqlite_cache.store("bank", "key", "one", database)
+    sqlite_cache.store("bank", "key", "two", database)
+    assert sqlite_cache.fetch("bank", "key", database) == "two"
+
+
+def test_updated_returns_none_for_missing_key(database):
+    assert sqlite_cache.updated("bank", "missing", database) is None
+
+
+def test_updated_returns_int_after_store(database):
+    sqlite_cache.store("bank", "key", "data", database)
+    assert isinstance(sqlite_cache.updated("bank", "key", database), int)
+
+
+def test_list_returns_stored_keys(database):
+    sqlite_cache.store("bank", "key1", "a", database)
+    sqlite_cache.store("bank", "key2", "b", database)
+    assert set(sqlite_cache.list_("bank", database)) == {"key1", "key2"}
+
+
+def test_list_empty_bank_returns_empty_list(database):
+    assert sqlite_cache.list_("bank", database) == []
+
+
+def test_contains_key(database):
+    sqlite_cache.store("bank", "key", "data", database)
+    assert sqlite_cache.contains("bank", "key", database) is True
+    assert sqlite_cache.contains("bank", "missing", database) is False
+
+
+def test_contains_bank(database):
+    assert sqlite_cache.contains("bank", None, database) is False
+    sqlite_cache.store("bank", "key", "data", database)
+    assert sqlite_cache.contains("bank", None, database) is True
+
+
+def test_flush_key(database):
+    sqlite_cache.store("bank", "key", "data", database)
+    assert sqlite_cache.flush("bank", "key", database=database) is True
+    assert sqlite_cache.fetch("bank", "key", database) == {}
+
+
+def test_flush_missing_key_returns_false(database):
+    assert sqlite_cache.flush("bank", "missing", database=database) is False
+
+
+def test_flush_bank_removes_all_keys(database):
+    sqlite_cache.store("bank", "key1", "a", database)
+    sqlite_cache.store("bank", "key2", "b", database)
+    assert sqlite_cache.flush("bank", key=None, database=database) is True
+    assert sqlite_cache.list_("bank", database) == []
+
+
+def test_data_survives_reconnect(database):
+    """
+    A restart of the master closes and reopens the sqlite connection.
+    Data stored before the "restart" must be readable afterward from the
+    same database file.
+    """
+    sqlite_cache.store("minions/alpha", "data", {"os": "Linux"}, database)
+
+    for conn in sqlite_cache._connections.values():
+        conn.close()
+    sqlite_cache._connections.clear()
+
+    assert sqlite_cache.fetch("minions/alpha", "data", database) == {"os": "Linux"}
+
+
+def test_store_error_raises_saltcacheerror(database):
+    sqlite_cache.store("bank", "key", "data", database)
+    broken_conn = MagicMock()
+    broken_conn.execute.side_effect = sqlite3.Error("boom")
+    with patch.object(sqlite_cache, "_get_conn", MagicMock(return_value=broken_conn)):
+        with pytest.raises(SaltCacheError):
+            sqlite_cache.store("bank", "key2", "data", database)
+
+
+def test_fetch_error_raises_saltcacheerror(database):
+    broken_conn = MagicMock()
+    broken_conn.execute.side_effect = sqlite3.Error("boom")
+    with patch.object(sqlite_cache, "_get_conn", MagicMock(return_value=broken_conn)):
+        with pytest.raises(SaltCacheError):
+            sqlite_cache.fetch("bank", "key", database)
+
+
+def test_init_kwargs_defaults_to_cachedir(tmp_path):
+    with patch.dict(sqlite_cache.__opts__, {"cachedir": str(tmp_path)}):
+        kwargs = sqlite_cache.init_kwargs({})
+        assert kwargs["database"] == str(tmp_path / "cache.sqlite")
+
+
+def test_init_kwargs_honors_explicit_database_opt(tmp_path):
+    explicit = str(tmp_path / "custom.sqlite")
+    with patch.dict(sqlite_cache.__opts__, {"sqlite_cache.database": explicit}):
+        kwargs = sqlite_cache.init_kwargs({})
+        assert kwargs["database"] == explicit
