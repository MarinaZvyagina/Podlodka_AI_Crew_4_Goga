+++ b/tests/pytests/functional/cache/test_sqlite.py
@@ -0,0 +1,63 @@
+import logging
+import shutil
+
+import pytest
+
+import salt.cache
+import salt.cache.sqlite_cache as sqlite_cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def cache(minion_opts, tmp_path):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite"
+    opts["cachedir"] = str(tmp_path)
+    cache = salt.cache.factory(opts)
+    try:
+        yield cache
+    finally:
+        for conn in sqlite_cache._connections.values():
+            conn.close()
+        sqlite_cache._connections.clear()
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_data_persists_across_master_restart(minion_opts, tmp_path):
+    """
+    The whole point of the sqlite cache backend is that an operator can
+    restart the master and still have their previously cached data
+    available. Simulate a restart by closing every connection this
+    process holds open and building a brand new Cache instance pointed at
+    the same on-disk database file.
+    """
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite"
+    opts["cachedir"] = str(tmp_path)
+
+    try:
+        first = salt.cache.factory(opts)
+        first.store("minions/alpha", "grains", {"os": "Linux"})
+        first.store("minions/alpha", "mine", {"network.interfaces": {}})
+
+        # Simulate the master process exiting and starting back up: drop
+        # every open sqlite connection so the next Cache instance has to
+        # read the file from disk rather than an in-memory handle.
+        for conn in sqlite_cache._connections.values():
+            conn.close()
+        sqlite_cache._connections.clear()
+
+        second = salt.cache.factory(opts)
+        assert second.fetch("minions/alpha", "grains") == {"os": "Linux"}
+        assert second.fetch("minions/alpha", "mine") == {"network.interfaces": {}}
+    finally:
+        for conn in sqlite_cache._connections.values():
+            conn.close()
+        sqlite_cache._connections.clear()
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
diff --git a/tests/pytests/unit/cache/test_sqlite_cache.py b/tests/pytests/unit/cache/test_sqlite_cache.py
