@@ -0,0 +1,250 @@
+"""
+Minion data cache plugin for SQLite.
+
+.. versionadded:: 3008.2
+
+This plugin stores cached data (grains, mine data, job returns, etc.) in a
+single SQLite database file on disk. Unlike the ``mysql``, ``redis``,
+``etcd``, and ``consul`` cache drivers, no separate database service needs
+to be installed or run: the ``sqlite3`` module ships with the Python
+standard library, so a stock Python installation is all that's required.
+As with ``localfs``, data written through this driver survives a restart
+of the master.
+
+To use sqlite as a minion data cache backend, set the master ``cache``
+config value to ``sqlite``:
+
+.. code-block:: yaml
+
+    cache: sqlite
+
+Optionally, the following values can be set in the master config. These are
+the defaults:
+
+.. code-block:: yaml
+
+    sqlite.database: <cachedir>/cache.sqlite3
+    sqlite.table_name: cache
+    sqlite.timeout: 5.0
+
+.. warning::
+
+    The ``sqlite.table_name`` value is interpolated directly into SQL
+    statements. Salt treats this as trusted input, coming from the master
+    configuration rather than from any external, untrusted source.
+"""
+
+import logging
+import os
+import time
+
+import salt.payload
+import salt.syspaths
+import salt.utils.path
+from salt.exceptions import SaltCacheError
+
+try:
+    import sqlite3
+
+    HAS_SQLITE3 = True
+except ImportError:
+    HAS_SQLITE3 = False
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite"
+__func_alias__ = {"list_": "list"}
+
+_DEFAULT_TABLE_NAME = "cache"
+_DEFAULT_TIMEOUT = 5.0
+
+
+def __virtual__():
+    """
+    Confirm that the sqlite3 module (part of the Python standard library) is
+    available.
+    """
+    if not HAS_SQLITE3:
+        return False, "No python sqlite3 client installed."
+    return __virtualname__
+
+
+def _default_database():
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    return salt.utils.path.join(cachedir, "cache.sqlite3")
+
+
+def _get_conn():
+    """
+    Return the cached sqlite3 connection for this process, opening (and
+    initializing the schema for) one if it doesn't exist yet.
+    """
+    conn = __context__.get("sqlite_client")
+    if conn is not None:
+        return conn
+
+    database = __opts__.get("sqlite.database") or _default_database()
+    table_name = __opts__.get("sqlite.table_name", _DEFAULT_TABLE_NAME)
+    timeout = __opts__.get("sqlite.timeout", _DEFAULT_TIMEOUT)
+
+    directory = os.path.dirname(database)
+    if directory and not os.path.isdir(directory):
+        try:
+            os.makedirs(directory)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"The sqlite cache directory, {directory}, could not be created: {exc}"
+            )
+
+    try:
+        conn = sqlite3.connect(
+            database,
+            timeout=timeout,
+            isolation_level=None,
+            check_same_thread=False,
+        )
+        # WAL journaling plus a busy timeout lets multiple master worker
+        # processes share the single database file without "database is
+        # locked" errors under normal contention.
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute(f"PRAGMA busy_timeout={int(timeout * 1000)}")
+        conn.execute(
+            f"""
+            CREATE TABLE IF NOT EXISTS {table_name} (
+                bank TEXT NOT NULL,
+                cache_key TEXT NOT NULL,
+                data BLOB,
+                last_update INTEGER NOT NULL,
+                PRIMARY KEY (bank, cache_key)
+            )
+            """
+        )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"Could not initialize the sqlite cache database {database}: {exc}"
+        )
+
+    __context__["sqlite_client"] = conn
+    __context__["sqlite_table_name"] = table_name
+    return conn
+
+
+def store(bank, key, data):
+    """
+    Store a key value.
+    """
+    conn = _get_conn()
+    table_name = __context__["sqlite_table_name"]
+    blob = salt.payload.dumps(data)
+    try:
+        conn.execute(
+            f"INSERT OR REPLACE INTO {table_name} "
+            "(bank, cache_key, data, last_update) VALUES (?, ?, ?, ?)",
+            (bank, key, blob, int(time.time())),
+        )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"There was an error storing {bank}/{key}: {exc}")
+
+
+def fetch(bank, key):
+    """
+    Fetch a key value.
+    """
+    conn = _get_conn()
+    table_name = __context__["sqlite_table_name"]
+    try:
+        row = conn.execute(
+            f"SELECT data FROM {table_name} WHERE bank=? AND cache_key=?",
+            (bank, key),
+        ).fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"There was an error fetching {bank}/{key}: {exc}")
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key):
+    """
+    Return the epoch of the last update for this cache entry, or None if it
+    doesn't exist.
+    """
+    conn = _get_conn()
+    table_name = __context__["sqlite_table_name"]
+    try:
+        row = conn.execute(
+            f"SELECT last_update FROM {table_name} WHERE bank=? AND cache_key=?",
+            (bank, key),
+        ).fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"There was an error reading {bank}/{key}: {exc}")
+    return int(row[0]) if row else None
+
+
+def flush(bank, key=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key is
+    specified remove the entire bank with all keys and sub-banks inside.
+    """
+    conn = _get_conn()
+    table_name = __context__["sqlite_table_name"]
+    try:
+        if key is None:
+            existed = (
+                conn.execute(
+                    f"SELECT 1 FROM {table_name} WHERE bank=? LIMIT 1", (bank,)
+                ).fetchone()
+                is not None
+            )
+            conn.execute(f"DELETE FROM {table_name} WHERE bank=?", (bank,))
+        else:
+            existed = (
+                conn.execute(
+                    f"SELECT 1 FROM {table_name} WHERE bank=? AND cache_key=? LIMIT 1",
+                    (bank, key),
+                ).fetchone()
+                is not None
+            )
+            conn.execute(
+                f"DELETE FROM {table_name} WHERE bank=? AND cache_key=?", (bank, key)
+            )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"There was an error removing {bank}/{key or ''}: {exc}")
+    return existed
+
+
+def list_(bank):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank.
+    """
+    conn = _get_conn()
+    table_name = __context__["sqlite_table_name"]
+    try:
+        rows = conn.execute(
+            f"SELECT cache_key FROM {table_name} WHERE bank=?", (bank,)
+        ).fetchall()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"There was an error listing {bank}: {exc}")
+    return [row[0] for row in rows]
+
+
+def contains(bank, key=None):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    conn = _get_conn()
+    table_name = __context__["sqlite_table_name"]
+    try:
+        if key is None:
+            row = conn.execute(
+                f"SELECT 1 FROM {table_name} WHERE bank=? LIMIT 1", (bank,)
+            ).fetchone()
+        else:
+            row = conn.execute(
+                f"SELECT 1 FROM {table_name} WHERE bank=? AND cache_key=? LIMIT 1",
+                (bank, key),
+            ).fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"There was an error checking {bank}/{key or ''}: {exc}")
+    return row is not None
