@@ -0,0 +1,94 @@
+"""
+unit tests for the sqlite_cache cache
+"""
+
+import logging
+
+import pytest
+
+import salt.cache.sqlite_cache as sqlite_cache
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def configure_loader_modules(tmp_path):
+    opts = {"sqlite.database": str(tmp_path / "cache.sqlite3")}
+    return {sqlite_cache: {"__opts__": opts, "__context__": {}}}
+
+
+def test_store_and_fetch():
+    sqlite_cache.store(bank="minions/minion", key="key1", data={"foo": "bar"})
+    assert sqlite_cache.fetch(bank="minions/minion", key="key1") == {"foo": "bar"}
+
+
+def test_fetch_missing_returns_empty_dict():
+    assert sqlite_cache.fetch(bank="minions/minion", key="nope") == {}
+
+
+def test_store_overwrites_existing_key():
+    sqlite_cache.store(bank="bank", key="key", data={"v": 1})
+    sqlite_cache.store(bank="bank", key="key", data={"v": 2})
+    assert sqlite_cache.fetch(bank="bank", key="key") == {"v": 2}
+
+
+def test_updated_returns_int_epoch():
+    sqlite_cache.store(bank="bank", key="key", data="value")
+    assert isinstance(sqlite_cache.updated(bank="bank", key="key"), int)
+
+
+def test_updated_missing_returns_none():
+    assert sqlite_cache.updated(bank="bank", key="nope") is None
+
+
+def test_flush_existing_key_returns_true():
+    sqlite_cache.store(bank="bank", key="key", data="value")
+    assert sqlite_cache.flush(bank="bank", key="key") is True
+    assert sqlite_cache.fetch(bank="bank", key="key") == {}
+
+
+def test_flush_missing_key_returns_false():
+    assert sqlite_cache.flush(bank="bank", key="nope") is False
+
+
+def test_flush_entire_bank():
+    sqlite_cache.store(bank="bank", key="k1", data="v1")
+    sqlite_cache.store(bank="bank", key="k2", data="v2")
+    assert sqlite_cache.flush(bank="bank") is True
+    assert sqlite_cache.list_(bank="bank") == []
+
+
+def test_list_returns_keys_for_bank_only():
+    sqlite_cache.store(bank="bank_a", key="k1", data="v1")
+    sqlite_cache.store(bank="bank_b", key="k2", data="v2")
+    assert sqlite_cache.list_(bank="bank_a") == ["k1"]
+
+
+def test_contains_key():
+    sqlite_cache.store(bank="bank", key="key", data="value")
+    assert sqlite_cache.contains(bank="bank", key="key") is True
+    assert sqlite_cache.contains(bank="bank", key="nope") is False
+
+
+def test_contains_bank():
+    assert sqlite_cache.contains(bank="ghost", key=None) is False
+    sqlite_cache.store(bank="real", key="k", data="v")
+    assert sqlite_cache.contains(bank="real", key=None) is True
+
+
+def test_database_directory_created(tmp_path):
+    nested_db = tmp_path / "does" / "not" / "exist" / "cache.sqlite3"
+    sqlite_cache.__opts__["sqlite.database"] = str(nested_db)
+    sqlite_cache.store(bank="bank", key="key", data="value")
+    assert nested_db.exists()
+
+
+def test_virtual_name_selects_sqlite_driver():
+    assert sqlite_cache.__virtualname__ == "sqlite"
+
+
+@pytest.mark.skipif(
+    not sqlite_cache.HAS_SQLITE3, reason="No python sqlite3 client installed."
+)
+def test_virtual_returns_virtualname():
+    assert sqlite_cache.__virtual__() == "sqlite"
