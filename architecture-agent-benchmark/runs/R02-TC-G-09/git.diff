+import logging
+
+import pytest
+
+import salt.cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def cache(minion_opts, tmp_path):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite"
+    opts["sqlite.database"] = str(tmp_path / "cache.sqlite3")
+    cache = salt.cache.factory(opts)
+    return cache
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_data_persists_across_new_connections(minion_opts, tmp_path):
+    """
+    The whole point of this backend is that a restarted master (a fresh
+    process, hence a fresh sqlite3 connection) still sees previously
+    cached data.
+    """
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite"
+    opts["sqlite.database"] = str(tmp_path / "cache.sqlite3")
+
+    first_cache = salt.cache.factory(opts)
+    first_cache.store("persistent/bank", "key", {"still": "here"})
+    first_cache.destroy()
+
+    # A brand new Cache/loader instance against the same database file
+    # stands in for a restarted master process reconnecting to its cache.
+    second_cache = salt.cache.factory(opts)
+    assert second_cache.fetch("persistent/bank", "key") == {"still": "here"}
