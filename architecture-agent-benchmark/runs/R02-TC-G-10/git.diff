--- /dev/null
+++ b/salt/cache/sqlite3_cache.py
@@ -0,0 +1,386 @@
+"""
+Cache data in a single SQLite3 database file.
+
+.. versionadded:: 3009.0
+
+``sqlite3`` is a drop-in replacement for the ``localfs`` cache backend that
+keeps every bank/key entry in one on-disk database file instead of one file
+per key. It exists for small, single-node masters that want their minion
+data cache (grains, mine data, job returns, tokens, etc.) to survive a
+master restart without standing up a separate service such as Redis or
+MySQL: the ``sqlite3`` module is part of the Python standard library, so
+there is nothing extra to install.
+
+Enable it as the master's cache driver:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+Configuration (all optional, set in ``/etc/salt/master``):
+
+.. code-block:: yaml
+
+    # Path to the database file. Defaults to <cachedir>/cache.sqlite3
+    sqlite3_cache_database: /var/cache/salt/master/cache.sqlite3
+
+    # Milliseconds to wait for a write lock held by another master worker
+    # process before giving up. See sqlite3's "PRAGMA busy_timeout".
+    sqlite3_cache_busy_timeout: 5000
+
+Storage model
+-------------
+
+A single table holds every bank/key pair::
+
+    CREATE TABLE cache (
+        bank TEXT NOT NULL,
+        key TEXT NOT NULL,
+        data BLOB NOT NULL,
+        updated INTEGER NOT NULL,
+        expires_at INTEGER,
+        PRIMARY KEY (bank, key)
+    )
+
+``bank`` is stored verbatim (it may itself contain ``/`` for nested banks,
+e.g. ``minions/myminion``). Listing/flushing/checking a bank also considers
+rows whose ``bank`` starts with ``<bank>/``, so ``cache.list("minions")``
+returns minion IDs the same way it does for :mod:`~salt.cache.localfs`.
+
+The database is opened in WAL mode with a configurable busy timeout so that
+the master's several worker processes can share one file without tripping
+over each other's writes.
+"""
+
+import logging
+import os
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+from salt.exceptions import SaltCacheError
+
+try:
+    import sqlite3
+
+    HAS_SQLITE3 = True
+except ImportError:
+    HAS_SQLITE3 = False
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+# {db_path: sqlite3.Connection}, one connection per (process, db file).
+_CONNECTIONS = {}
+_LOCK = threading.RLock()
+
+_DEFAULT_BUSY_TIMEOUT_MS = 5000
+
+
+def __virtual__():
+    """
+    The sqlite3 module ships with Python; this only fails to load on Python
+    builds compiled without it.
+    """
+    if not HAS_SQLITE3:
+        return (False, "The Python sqlite3 module is not available.")
+    return __virtualname__
+
+
+def __cachedir(kwargs=None):
+    if kwargs and "cachedir" in kwargs:
+        return kwargs["cachedir"]
+    return __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+
+
+def init_kwargs(kwargs):
+    return {"cachedir": __cachedir(kwargs)}
+
+
+def get_storage_id(kwargs):
+    return ("sqlite3", _db_path(__cachedir(kwargs)))
+
+
+def _db_path(cachedir):
+    configured = __opts__.get("sqlite3_cache_database")
+    if configured:
+        return configured
+    return os.path.join(cachedir or __cachedir(), "cache.sqlite3")
+
+
+def _get_conn(cachedir=None):
+    """
+    Return the per-process connection for this database file, opening
+    (and initializing the schema for) it on first use.
+    """
+    db_path = _db_path(cachedir)
+    with _LOCK:
+        conn = _CONNECTIONS.get(db_path)
+        if conn is not None:
+            return conn
+
+        db_dir = os.path.dirname(db_path)
+        if db_dir:
+            try:
+                os.makedirs(db_dir, exist_ok=True)
+            except OSError as exc:
+                raise SaltCacheError(
+                    f"The sqlite3 cache directory, {db_dir}, could not be "
+                    f"created: {exc}"
+                )
+
+        try:
+            conn = sqlite3.connect(db_path, check_same_thread=False)
+            busy_timeout = __opts__.get(
+                "sqlite3_cache_busy_timeout", _DEFAULT_BUSY_TIMEOUT_MS
+            )
+            conn.execute(f"PRAGMA busy_timeout = {int(busy_timeout)}")
+            conn.execute("PRAGMA journal_mode = WAL")
+            conn.execute("PRAGMA synchronous = NORMAL")
+            conn.execute(
+                """CREATE TABLE IF NOT EXISTS cache (
+                    bank TEXT NOT NULL,
+                    key TEXT NOT NULL,
+                    data BLOB NOT NULL,
+                    updated INTEGER NOT NULL,
+                    expires_at INTEGER,
+                    PRIMARY KEY (bank, key)
+                )"""
+            )
+            conn.commit()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f'There was an error opening the sqlite3 cache database '
+                f'"{db_path}": {exc}'
+            )
+
+        _CONNECTIONS[db_path] = conn
+        return conn
+
+
+def _bank_bounds(bank):
+    """
+    Return the ``(lower, upper)`` bounds that select every row whose bank is
+    a strict sub-bank of ``bank`` (e.g. ``minions/foo`` under ``minions``),
+    or ``None`` for the root bank (``""``), which has no useful bound and
+    must be matched against every row instead.
+    """
+    if bank == "":
+        return None
+    return (f"{bank}/", f"{bank}0")
+
+
+def store(bank, key, data, cachedir=None, expires=None, **kwargs):
+    """
+    Store information in the database.
+    """
+    bank = bank.rstrip("/")
+    conn = _get_conn(cachedir)
+    now = int(time.time())
+    expires_at = now + int(expires) if expires else None
+    try:
+        payload = salt.payload.dumps(data)
+    except TypeError as exc:
+        raise SaltCacheError(f"Could not serialize cache data: {exc}")
+
+    with _LOCK:
+        try:
+            conn.execute(
+                "INSERT OR REPLACE INTO cache (bank, key, data, updated, expires_at) "
+                "VALUES (?, ?, ?, ?, ?)",
+                (bank, key, payload, now, expires_at),
+            )
+            conn.commit()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f'There was an error writing the cache entry "{bank}/{key}": {exc}'
+            )
+
+
+def fetch(bank, key, cachedir=None, **kwargs):
+    """
+    Fetch information from the database.
+    """
+    bank = bank.rstrip("/")
+    conn = _get_conn(cachedir)
+    with _LOCK:
+        try:
+            row = conn.execute(
+                "SELECT data, expires_at FROM cache WHERE bank=? AND key=?",
+                (bank, key),
+            ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f'There was an error reading the cache entry "{bank}/{key}": {exc}'
+            )
+    if row is None:
+        return {}
+    data, expires_at = row
+    if expires_at is not None and expires_at <= int(time.time()):
+        return {}
+    return salt.payload.loads(data)
+
+
+def updated(bank, key, cachedir=None, **kwargs):
+    """
+    Return the epoch of the last update for this cache entry.
+    """
+    bank = bank.rstrip("/")
+    conn = _get_conn(cachedir)
+    with _LOCK:
+        try:
+            row = conn.execute(
+                "SELECT updated, expires_at FROM cache WHERE bank=? AND key=?",
+                (bank, key),
+            ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f'There was an error reading the cache entry "{bank}/{key}": {exc}'
+            )
+    if row is None:
+        return None
+    ts, expires_at = row
+    if expires_at is not None and expires_at <= int(time.time()):
+        return None
+    return int(ts)
+
+
+def flush(bank, key=None, cachedir=None, **kwargs):
+    """
+    Remove the key from the cache bank with all the key content, or the
+    whole bank (and its sub-banks) if key is omitted.
+    """
+    bank = bank.rstrip("/")
+    conn = _get_conn(cachedir)
+    with _LOCK:
+        try:
+            if key is None:
+                bounds = _bank_bounds(bank)
+                if bounds is None:
+                    cur = conn.execute("DELETE FROM cache")
+                else:
+                    lower, upper = bounds
+                    cur = conn.execute(
+                        "DELETE FROM cache WHERE bank=? OR (bank>=? AND bank<?)",
+                        (bank, lower, upper),
+                    )
+            else:
+                cur = conn.execute(
+                    "DELETE FROM cache WHERE bank=? AND key=?", (bank, key)
+                )
+            conn.commit()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f'There was an error removing "{bank}/{key}": {exc}')
+    return cur.rowcount > 0
+
+
+def list_(bank, cachedir=None, **kwargs):
+    """
+    Return an iterable object containing the direct keys and immediate
+    sub-bank names stored in the specified bank.
+    """
+    bank = bank.rstrip("/")
+    conn = _get_conn(cachedir)
+    now = int(time.time())
+    seen = set()
+    ret = []
+    with _LOCK:
+        try:
+            for key, expires_at in conn.execute(
+                "SELECT key, expires_at FROM cache WHERE bank=?", (bank,)
+            ):
+                if expires_at is not None and expires_at <= now:
+                    continue
+                if key not in seen:
+                    seen.add(key)
+                    ret.append(key)
+
+            bounds = _bank_bounds(bank)
+            if bounds is None:
+                rows = conn.execute("SELECT DISTINCT bank FROM cache")
+                prefix = ""
+            else:
+                lower, upper = bounds
+                rows = conn.execute(
+                    "SELECT DISTINCT bank FROM cache WHERE bank>=? AND bank<?",
+                    (lower, upper),
+                )
+                prefix = lower
+            for (subbank,) in rows:
+                if not subbank or subbank == bank:
+                    continue
+                child = subbank[len(prefix) :].split("/", 1)[0]
+                if child and child not in seen:
+                    seen.add(child)
+                    ret.append(child)
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f'There was an error listing bank "{bank}": {exc}')
+    return ret
+
+
+def contains(bank, key, cachedir=None, **kwargs):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    bank = bank.rstrip("/")
+    conn = _get_conn(cachedir)
+    now = int(time.time())
+    with _LOCK:
+        try:
+            if key is not None:
+                row = conn.execute(
+                    "SELECT expires_at FROM cache WHERE bank=? AND key=?",
+                    (bank, key),
+                ).fetchone()
+                if row is None:
+                    return False
+                expires_at = row[0]
+                return not (expires_at is not None and expires_at <= now)
+
+            bounds = _bank_bounds(bank)
+            if bounds is None:
+                row = conn.execute("SELECT 1 FROM cache LIMIT 1").fetchone()
+            else:
+                lower, upper = bounds
+                row = conn.execute(
+                    "SELECT 1 FROM cache WHERE bank=? OR (bank>=? AND bank<?) LIMIT 1",
+                    (bank, lower, upper),
+                ).fetchone()
+            return row is not None
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f'There was an error checking bank "{bank}" key "{key}": {exc}'
+            )
+
+
+def clean_expired(bank, cachedir=None, **kwargs):
+    """
+    Remove entries in bank (and its sub-banks) whose ``expires`` has
+    already passed.
+    """
+    bank = bank.rstrip("/")
+    conn = _get_conn(cachedir)
+    now = int(time.time())
+    with _LOCK:
+        try:
+            bounds = _bank_bounds(bank)
+            if bounds is None:
+                conn.execute(
+                    "DELETE FROM cache WHERE expires_at IS NOT NULL AND expires_at<=?",
+                    (now,),
+                )
+            else:
+                lower, upper = bounds
+                conn.execute(
+                    "DELETE FROM cache WHERE (bank=? OR (bank>=? AND bank<?)) "
+                    "AND expires_at IS NOT NULL AND expires_at<=?",
+                    (bank, lower, upper, now),
+                )
+            conn.commit()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f'There was an error cleaning expired entries in bank "{bank}": {exc}'
+            )
