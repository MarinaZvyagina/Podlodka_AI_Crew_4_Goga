@@ -0,0 +1,105 @@
+"""
+Functional tests for the salt.cache sqlite3 driver.
+
+These exercise the full salt.cache.Cache() public API backed by the real
+sqlite3_cache driver with a real opts dict and a real on-disk database
+file -- the same path production code takes.
+"""
+
+import logging
+
+import pytest
+
+import salt.cache
+import salt.cache.sqlite3_cache
+import salt.config
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture(autouse=True)
+def _reset_connections():
+    salt.cache.sqlite3_cache._CONNECTIONS.clear()
+    yield
+    for conn in salt.cache.sqlite3_cache._CONNECTIONS.values():
+        conn.close()
+    salt.cache.sqlite3_cache._CONNECTIONS.clear()
+
+
+@pytest.fixture
+def cache(minion_opts, tmp_path):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    opts["cachedir"] = str(tmp_path)
+    return salt.cache.factory(opts)
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_data_survives_a_simulated_master_restart(minion_opts, tmp_path):
+    """
+    The whole point of this backend: data cached before a master restart
+    must still be readable afterwards. Simulate a restart by dropping the
+    in-process connection and building a brand new Cache instance pointed
+    at the same cachedir.
+    """
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    opts["cachedir"] = str(tmp_path)
+
+    before_restart = salt.cache.factory(opts)
+    before_restart.store("minions/myminion", "data", {"grain": "value"})
+    before_restart.store("minions/myminion", "mine", {"fn": "result"})
+
+    # Simulate the master process exiting: drop the cached connection.
+    for conn in salt.cache.sqlite3_cache._CONNECTIONS.values():
+        conn.close()
+    salt.cache.sqlite3_cache._CONNECTIONS.clear()
+
+    after_restart = salt.cache.factory(opts)
+    assert after_restart.fetch("minions/myminion", "data") == {"grain": "value"}
+    assert after_restart.fetch("minions/myminion", "mine") == {"fn": "result"}
+    assert set(after_restart.list("minions")) == {"myminion"}
+
+
+def test_clean_expired_does_not_drop_unexpired_entries_69307(cache):
+    """
+    Same regression as test_localfs.py's 69307 test, but exercised against
+    the native ``clean_expired`` implementation (Cache.clean_expired calls
+    straight into sqlite3_cache.clean_expired rather than falling back to
+    the generic envelope sweep). A freshly stored entry with a far-future
+    expiry, and a plain entry with no expiry at all, must both survive.
+    """
+    bank = "tokens"
+    key_with_expiry = "tok-with-expiry"
+    key_plain = "tok-plain"
+
+    cache.store(bank, key_plain, {"name": "alice"})
+    cache.store(bank, key_with_expiry, {"name": "bob"}, expires=12 * 3600)
+
+    assert cache.contains(bank, key_plain)
+    assert cache.contains(bank, key_with_expiry)
+
+    cache.clean_expired(bank)
+
+    assert cache.contains(bank, key_plain)
+    assert cache.contains(bank, key_with_expiry)
+
+
+def test_clean_expired_removes_expired_entries(cache):
+    bank = "tokens"
+    cache.store(bank, "dead", {"name": "carol"}, expires=-1)
+    cache.clean_expired(bank)
+    assert cache.fetch(bank, "dead") == {}
+
+
+def test_default_master_cache_driver_is_unchanged():
+    """
+    Deployments that don't opt into sqlite3 must keep using localfs exactly
+    as before -- guard that adding the sqlite3 driver didn't change the
+    default.
+    """
+    assert salt.config.DEFAULT_MASTER_OPTS["cache"] == "localfs"
