+"""
+Validate the functions in the sqlite3_cache cache driver.
+"""
+
+import time
+from pathlib import Path
+
+import pytest
+
+import salt.cache.sqlite3_cache as sqlite3_cache
+from salt.exceptions import SaltCacheError
+from tests.support.mock import patch
+
+
+@pytest.fixture
+def configure_loader_modules():
+    return {sqlite3_cache: {}}
+
+
+@pytest.fixture(autouse=True)
+def _reset_connections():
+    # Each test gets its own tmp_path/cachedir, so make sure no connection
+    # from a previous test (keyed by a now-reused or now-deleted path) leaks
+    # in via the module-level connection cache.
+    sqlite3_cache._CONNECTIONS.clear()
+    yield
+    for conn in sqlite3_cache._CONNECTIONS.values():
+        conn.close()
+    sqlite3_cache._CONNECTIONS.clear()
+
+
+@pytest.fixture
+def cachedir(tmp_path):
+    d = str(tmp_path)
+    with patch.dict(sqlite3_cache.__opts__, {"cachedir": d}):
+        yield d
+
+
+def test_virtual():
+    assert sqlite3_cache.__virtual__() == "sqlite3"
+
+
+def test_init_kwargs(cachedir):
+    assert sqlite3_cache.init_kwargs({}) == {"cachedir": cachedir}
+    assert sqlite3_cache.init_kwargs({"cachedir": "/other"}) == {"cachedir": "/other"}
+
+
+def test_store_creates_database_file(cachedir):
+    sqlite3_cache.store(bank="bank", key="key", data="payload", cachedir=cachedir)
+    assert (Path(cachedir) / "cache.sqlite3").exists()
+
+
+def test_store_fetch_roundtrip(cachedir):
+    sqlite3_cache.store(bank="bank", key="key", data={"a": 1}, cachedir=cachedir)
+    assert sqlite3_cache.fetch(bank="bank", key="key", cachedir=cachedir) == {"a": 1}
+
+
+def test_fetch_missing_returns_empty_dict(cachedir):
+    assert sqlite3_cache.fetch(bank="bank", key="nope", cachedir=cachedir) == {}
+
+
+def test_store_overwrite(cachedir):
+    sqlite3_cache.store(bank="bank", key="key", data="one", cachedir=cachedir)
+    sqlite3_cache.store(bank="bank", key="key", data="two", cachedir=cachedir)
+    assert sqlite3_cache.fetch(bank="bank", key="key", cachedir=cachedir) == "two"
+
+
+def test_updated_returns_recent_epoch(cachedir):
+    before = int(time.time()) - 2
+    sqlite3_cache.store(bank="bank", key="key", data="x", cachedir=cachedir)
+    after = int(time.time()) + 2
+    ts = sqlite3_cache.updated(bank="bank", key="key", cachedir=cachedir)
+    assert before <= ts <= after
+
+
+def test_updated_missing_returns_none(cachedir):
+    assert sqlite3_cache.updated(bank="bank", key="nope", cachedir=cachedir) is None
+
+
+def test_flush_key(cachedir):
+    sqlite3_cache.store(bank="bank", key="k1", data="a", cachedir=cachedir)
+    sqlite3_cache.store(bank="bank", key="k2", data="b", cachedir=cachedir)
+    assert sqlite3_cache.flush(bank="bank", key="k1", cachedir=cachedir) is True
+    assert sqlite3_cache.fetch(bank="bank", key="k1", cachedir=cachedir) == {}
+    assert sqlite3_cache.fetch(bank="bank", key="k2", cachedir=cachedir) == "b"
+
+
+def test_flush_missing_key_returns_false(cachedir):
+    assert sqlite3_cache.flush(bank="bank", key="nope", cachedir=cachedir) is False
+
+
+def test_flush_entire_bank_removes_subbanks(cachedir):
+    sqlite3_cache.store(
+        bank="minions/id1", key="data", data={"g": 1}, cachedir=cachedir
+    )
+    sqlite3_cache.store(
+        bank="minions/id2", key="data", data={"g": 2}, cachedir=cachedir
+    )
+    sqlite3_cache.flush(bank="minions", key=None, cachedir=cachedir)
+    assert sqlite3_cache.fetch(bank="minions/id1", key="data", cachedir=cachedir) == {}
+    assert sqlite3_cache.fetch(bank="minions/id2", key="data", cachedir=cachedir) == {}
+
+
+def test_list_direct_keys(cachedir):
+    sqlite3_cache.store(bank="bank", key="a", data=1, cachedir=cachedir)
+    sqlite3_cache.store(bank="bank", key="b", data=2, cachedir=cachedir)
+    assert set(sqlite3_cache.list_(bank="bank", cachedir=cachedir)) == {"a", "b"}
+
+
+def test_list_subbanks_like_minions(cachedir):
+    sqlite3_cache.store(bank="minions/id1", key="data", data={}, cachedir=cachedir)
+    sqlite3_cache.store(bank="minions/id2", key="data", data={}, cachedir=cachedir)
+    assert set(sqlite3_cache.list_(bank="minions", cachedir=cachedir)) == {
+        "id1",
+        "id2",
+    }
+
+
+def test_list_empty_bank_returns_empty(cachedir):
+    assert sqlite3_cache.list_(bank="ghost", cachedir=cachedir) == []
+
+
+def test_contains_key(cachedir):
+    sqlite3_cache.store(bank="bank", key="key", data="x", cachedir=cachedir)
+    assert sqlite3_cache.contains(bank="bank", key="key", cachedir=cachedir) is True
+    assert sqlite3_cache.contains(bank="bank", key="nope", cachedir=cachedir) is False
+
+
+def test_contains_bank_existence_via_subbank(cachedir):
+    assert sqlite3_cache.contains(bank="minions", key=None, cachedir=cachedir) is False
+    sqlite3_cache.store(bank="minions/id1", key="data", data={}, cachedir=cachedir)
+    assert sqlite3_cache.contains(bank="minions", key=None, cachedir=cachedir) is True
+
+
+def test_store_native_expires_hides_data_after_expiry(cachedir):
+    sqlite3_cache.store(
+        bank="tokens", key="tok", data={"name": "alice"}, cachedir=cachedir, expires=-1
+    )
+    assert sqlite3_cache.fetch(bank="tokens", key="tok", cachedir=cachedir) == {}
+    assert sqlite3_cache.contains(bank="tokens", key="tok", cachedir=cachedir) is False
+    assert sqlite3_cache.updated(bank="tokens", key="tok", cachedir=cachedir) is None
+
+
+def test_store_native_expires_keeps_data_before_expiry(cachedir):
+    sqlite3_cache.store(
+        bank="tokens",
+        key="tok",
+        data={"name": "alice"},
+        cachedir=cachedir,
+        expires=3600,
+    )
+    assert sqlite3_cache.fetch(bank="tokens", key="tok", cachedir=cachedir) == {
+        "name": "alice"
+    }
+
+
+def test_clean_expired_purges_only_expired_rows(cachedir):
+    sqlite3_cache.store(
+        bank="tokens", key="dead", data="x", cachedir=cachedir, expires=-1
+    )
+    sqlite3_cache.store(
+        bank="tokens", key="alive", data="y", cachedir=cachedir, expires=3600
+    )
+    sqlite3_cache.store(bank="tokens", key="plain", data="z", cachedir=cachedir)
+
+    sqlite3_cache.clean_expired(bank="tokens", cachedir=cachedir)
+
+    conn = sqlite3_cache._get_conn(cachedir)
+    rows = {
+        row[0]
+        for row in conn.execute("SELECT key FROM cache WHERE bank='tokens'")
+    }
+    assert rows == {"alive", "plain"}
+
+
+def test_persistence_across_reconnect(cachedir):
+    """
+    The whole point of this backend is that data survives a master restart.
+    Simulate that by dropping the in-process connection and reopening the
+    same database file.
+    """
+    sqlite3_cache.store(
+        bank="minions/myminion", key="data", data={"os": "linux"}, cachedir=cachedir
+    )
+    for conn in sqlite3_cache._CONNECTIONS.values():
+        conn.close()
+    sqlite3_cache._CONNECTIONS.clear()
+
+    assert sqlite3_cache.fetch(
+        bank="minions/myminion", key="data", cachedir=cachedir
+    ) == {"os": "linux"}
+
+
+def test_serialization_error_raises_saltcacheerror(cachedir):
+    class Unserializable:
+        pass
+
+    with pytest.raises(SaltCacheError):
+        sqlite3_cache.store(
+            bank="bank", key="key", data=Unserializable(), cachedir=cachedir
+        )
