+def test_usage_caches_within_context():
+    """
+    disk.usage should only shell out to ``df`` once per unique set of
+    flags within the same Salt run, reusing the cached result on
+    subsequent calls. A fresh ``__context__`` (a new, independent run)
+    must not reuse a previous run's cached result.
+    """
+    df_output = (
+        "Filesystem     1024-blocks     Used Available Capacity Mounted on\n"
+        "/dev/sda1         10000     2000      8000      20% /\n"
+    )
+    mock_cmd = MagicMock(return_value=df_output)
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch(
+        "os.path.isfile", MagicMock(return_value=True)
+    ), patch.dict(disk.__salt__, {"cmd.run": mock_cmd}):
+        first = disk.usage()
+        second = disk.usage()
+        assert first == second
+        assert first is not second
+        assert mock_cmd.call_count == 1
+
+        # Mutating a previously returned result must not corrupt the cache.
+        first["/"]["used"] = "tampered"
+        assert disk.usage()["/"]["used"] != "tampered"
+        assert mock_cmd.call_count == 1
+
+        # Different flags are a different call signature, not a cache hit.
+        disk.usage(args="h")
+        assert mock_cmd.call_count == 2
+
+        # A fresh __context__ simulates a new, independent Salt run and
+        # must not reuse stale results left over from the previous one.
+        disk.__context__.clear()
+        disk.usage()
+        assert mock_cmd.call_count == 3
+
+
