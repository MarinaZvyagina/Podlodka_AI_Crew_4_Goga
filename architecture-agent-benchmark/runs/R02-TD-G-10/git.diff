diff --git a/changelog/70129.changed.md b/changelog/70129.changed.md
new file mode 100644
index 0000000..74905c8
--- /dev/null
+++ b/changelog/70129.changed.md
@@ -0,0 +1 @@
+``disk.usage`` now caches its result in ``__context__``, keyed by the flags passed, so repeated calls with the same arguments within a single Salt run no longer re-run ``df``. The cache does not persist across separate Salt runs.
diff --git a/salt/modules/disk.py b/salt/modules/disk.py
index f766769..1885290 100644
--- a/salt/modules/disk.py
+++ b/salt/modules/disk.py
@@ -87,6 +87,12 @@ def usage(args=None):
 
         Default for SunOS changed to 1 kilobyte blocks
 
+    .. versionchanged:: 3009.0
+
+        The result is now cached in the ``__context__`` dunder per set of
+        ``args``, so repeated calls within the same run no longer re-run
+        ``df``. The cache does not persist across separate Salt runs.
+
     CLI Example:
 
     .. code-block:: bash
@@ -113,6 +119,11 @@ def usage(args=None):
         cmd = "df"
     if flags:
         cmd += f" -{flags}"
+
+    cache_key = f"disk.usage.{cmd}"
+    if cache_key in __context__:
+        return __context__[cache_key]
+
     ret = {}
     out = __salt__["cmd.run"](cmd, python_shell=False).splitlines()
     oldline = None
@@ -157,6 +168,7 @@ def usage(args=None):
         except IndexError:
             log.error("Problem parsing disk usage information")
             ret = {}
+    __context__[cache_key] = ret
     return ret
 
 
diff --git a/tests/pytests/unit/modules/test_disk.py b/tests/pytests/unit/modules/test_disk.py
index 11b2170..1271393 100644
--- a/tests/pytests/unit/modules/test_disk.py
+++ b/tests/pytests/unit/modules/test_disk.py
@@ -162,6 +162,54 @@ def test_usage_none():
             assert "" == disk.usage(args=None)
 
 
+def test_usage_is_cached_within_a_run():
+    df_output = (
+        "Filesystem     1K-blocks    Used Available Capacity Mounted on\n"
+        "/dev/sda1        1000000  500000    500000      50% /"
+    )
+    mock_cmd = MagicMock(return_value=df_output)
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch(
+        "os.path.isfile", return_value=True
+    ), patch.dict(disk.__salt__, {"cmd.run": mock_cmd}):
+        first = disk.usage()
+        second = disk.usage()
+
+        assert first == second
+        mock_cmd.assert_called_once()
+
+
+def test_usage_cache_is_keyed_by_args():
+    df_output = (
+        "Filesystem     1K-blocks    Used Available Capacity Mounted on\n"
+        "/dev/sda1        1000000  500000    500000      50% /"
+    )
+    mock_cmd = MagicMock(return_value=df_output)
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch(
+        "os.path.isfile", return_value=True
+    ), patch.dict(disk.__salt__, {"cmd.run": mock_cmd}):
+        disk.usage()
+        disk.usage(args="h")
+
+        assert mock_cmd.call_count == 2
+
+
+def test_usage_cache_does_not_persist_across_runs():
+    df_output = (
+        "Filesystem     1K-blocks    Used Available Capacity Mounted on\n"
+        "/dev/sda1        1000000  500000    500000      50% /"
+    )
+    mock_cmd = MagicMock(return_value=df_output)
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch(
+        "os.path.isfile", return_value=True
+    ), patch.dict(disk.__salt__, {"cmd.run": mock_cmd}):
+        disk.usage()
+        # __context__ is reset between separate Salt runs
+        disk.__context__.clear()
+        disk.usage()
+
+        assert mock_cmd.call_count == 2
+
+
