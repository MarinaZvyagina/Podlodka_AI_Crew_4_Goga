index 0000000..4778dd0
--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,85 @@
+import {
+  DEFAULT_SHUTDOWN_MESSAGE,
+  SHUTDOWN_EVENT,
+} from '@nestjs/websockets/internal';
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('close', () => {
+    const createClient = (readyState: number) => ({
+      readyState,
+      send: vi.fn((_data: string, cb: Function) => cb()),
+      terminate: vi.fn(),
+    });
+
+    it('should send a shutdown notice to every open client before terminating them', async () => {
+      const openClient = createClient(1 /* OPEN */);
+      const closingClient = createClient(2 /* CLOSING */);
+      const close = vi.fn((cb: Function) => cb());
+      const fakeServer = {
+        clients: new Set([openClient, closingClient]),
+        close,
+      } as any;
+
+      await adapter.close(fakeServer);
+
+      expect(openClient.send).toHaveBeenCalledTimes(1);
+      const [payload] = openClient.send.mock.calls[0];
+      expect(JSON.parse(payload)).toEqual({
+        event: SHUTDOWN_EVENT,
+        data: DEFAULT_SHUTDOWN_MESSAGE,
+      });
+
+      // Only connections that are actually open should be notified
+      expect(closingClient.send).not.toHaveBeenCalled();
+
+      // Existing hard-close behavior for all clients must be preserved
+      expect(openClient.terminate).toHaveBeenCalled();
+      expect(closingClient.terminate).toHaveBeenCalled();
+
+      // The notice must be flushed (send callback resolved) before termination
+      const sendOrder = openClient.send.mock.invocationCallOrder[0];
+      const terminateOrder = openClient.terminate.mock.invocationCallOrder[0];
+      expect(sendOrder).toBeLessThan(terminateOrder);
+    });
+
+    it('should not throw when there are no connected clients', async () => {
+      const close = vi.fn((cb: Function) => cb());
+      const fakeServer = { clients: new Set(), close } as any;
+
+      await expect(adapter.close(fakeServer)).resolves.toBeUndefined();
+      expect(close).toHaveBeenCalled();
+    });
+
+    it('should not throw when the server exposes no clients collection', async () => {
+      const close = vi.fn((cb: Function) => cb());
+      const fakeServer = { close } as any;
+
+      await expect(adapter.close(fakeServer)).resolves.toBeUndefined();
+    });
+
+    it('should resolve even if sending the notice throws for a given client', async () => {
+      const throwingClient = {
+        readyState: 1,
+        send: vi.fn(() => {
+          throw new Error('socket already closing');
+        }),
+        terminate: vi.fn(),
+      };
+      const close = vi.fn((cb: Function) => cb());
+      const fakeServer = {
+        clients: new Set([throwingClient]),
+        close,
+      } as any;
+
+      await expect(adapter.close(fakeServer)).resolves.toBeUndefined();
+      expect(throwingClient.terminate).toHaveBeenCalled();
+    });
+  });
+});
diff --git a/packages/websockets/adapters/ws-adapter.ts b/packages/websockets/adapters/ws-adapter.ts
index 411b158..0b40d40 100644
--- a/packages/websockets/adapters/ws-adapter.ts
+++ b/packages/websockets/adapters/ws-adapter.ts
@@ -47,6 +47,19 @@ export abstract class AbstractWsAdapter<
   }
 
   public async close(server: TServer) {
+    await this.notifyShutdown(server);
+    await this.closeServer(server);
+  }
+
+  /**
+   * Broadcasts a heads-up to every connected client right before the server
+   * is closed, so a graceful shutdown doesn't look like a dropped connection
+   * on the client side. No-op by default; platform adapters (e.g. `IoAdapter`,
+   * `WsAdapter`) implement the library-specific broadcast.
+   */
+  protected async notifyShutdown(_server: TServer): Promise<void> {}
+
+  protected async closeServer(server: TServer) {
     const isCallable = server && isFunction(server.close);
     isCallable && (await new Promise(resolve => server.close(resolve)));
   }
