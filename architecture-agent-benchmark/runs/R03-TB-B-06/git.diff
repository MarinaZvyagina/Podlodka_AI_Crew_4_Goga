diff --git a/packages/platform-ws/test/ws-adapter.spec.ts b/packages/platform-ws/test/ws-adapter.spec.ts
new file mode 100644
index 0000000..b0404b3
--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,66 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('close', () => {
+    const createFakeClient = (readyState: number) => ({
+      readyState,
+      send: vi.fn((_data, cb) => cb()),
+      terminate: vi.fn(),
+    });
+
+    it('should send a shutdown notice to open clients before terminating them', async () => {
+      const openClient = createFakeClient(1 /* OPEN */);
+      const closingClient = createFakeClient(2 /* CLOSING */);
+      const fakeServer = {
+        clients: new Set([openClient, closingClient]),
+        close: vi.fn(cb => cb()),
+      };
+
+      await adapter.close(fakeServer as any);
+
+      expect(openClient.send).toHaveBeenCalledWith(
+        JSON.stringify({
+          event: 'shutdown',
+          data: { message: 'Server is shutting down' },
+        }),
+        expect.any(Function),
+      );
+      expect(closingClient.send).not.toHaveBeenCalled();
+      expect(openClient.terminate).toHaveBeenCalled();
+      expect(closingClient.terminate).toHaveBeenCalled();
+    });
+
+    it('should notify before terminating, not after', async () => {
+      const client = createFakeClient(1 /* OPEN */);
+      const callOrder: string[] = [];
+      client.send.mockImplementation((_data, cb) => {
+        callOrder.push('send');
+        cb();
+      });
+      client.terminate.mockImplementation(() => callOrder.push('terminate'));
+      const fakeServer = {
+        clients: new Set([client]),
+        close: vi.fn(cb => cb()),
+      };
+
+      await adapter.close(fakeServer as any);
+
+      expect(callOrder).toEqual(['send', 'terminate']);
+    });
+
+    it('should not fail when there are no connected clients', async () => {
+      const fakeServer = {
+        clients: new Set(),
+        close: vi.fn(cb => cb()),
+      };
+
+      await expect(adapter.close(fakeServer as any)).resolves.toBeUndefined();
+    });
+  });
+});
