+import { AbstractWsAdapter } from '../../adapters/ws-adapter.js';
+
+class TestAdapter extends AbstractWsAdapter {
+  public create() {
+    return {} as any;
+  }
+  public bindMessageHandlers() {}
+}
+
+describe('AbstractWsAdapter', () => {
+  let adapter: TestAdapter;
+
+  beforeEach(() => {
+    adapter = new TestAdapter();
+  });
+
+  describe('close', () => {
+    it('should close the server without sending any notice by default', async () => {
+      const fakeServer = { close: vi.fn(cb => cb()) };
+
+      await adapter.close(fakeServer as any);
+
+      expect(fakeServer.close).toHaveBeenCalled();
+    });
+
+    it('should do nothing when the server has no close method', async () => {
+      await expect(adapter.close({} as any)).resolves.toBeUndefined();
+    });
+  });
+});
