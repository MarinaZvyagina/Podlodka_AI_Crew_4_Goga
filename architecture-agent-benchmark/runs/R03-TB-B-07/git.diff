diff --git a/packages/platform-ws/test/ws-adapter.spec.ts b/packages/platform-ws/test/ws-adapter.spec.ts
new file mode 100644
index 0000000..3b0616c
--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,76 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+function createFakeClient(readyState = 1) {
+  return {
+    readyState,
+    send: vi.fn((_data: string, cb: Function) => cb()),
+    terminate: vi.fn(),
+  };
+}
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('close', () => {
+    it('should send a "shutdown" message to every open client before terminating it', async () => {
+      const client = createFakeClient();
+      const server = {
+        clients: [client],
+        close: vi.fn((cb: Function) => cb()),
+      };
+
+      await adapter.close(server as any);
+
+      expect(client.send).toHaveBeenCalledWith(
+        JSON.stringify({ event: 'shutdown' }),
+        expect.any(Function),
+      );
+      expect(client.terminate).toHaveBeenCalled();
+
+      const sendOrder = client.send.mock.invocationCallOrder[0];
+      const terminateOrder = client.terminate.mock.invocationCallOrder[0];
+      expect(sendOrder).toBeLessThan(terminateOrder);
+    });
+
+    it('should terminate the connection even if the client is not open, without sending a message', async () => {
+      const client = createFakeClient(3); // CLOSED_STATE
+      const server = {
+        clients: [client],
+        close: vi.fn((cb: Function) => cb()),
+      };
+
+      await adapter.close(server as any);
+
+      expect(client.send).not.toHaveBeenCalled();
+      expect(client.terminate).toHaveBeenCalled();
+    });
+
+    it('should terminate the connection even if sending the shutdown message throws', async () => {
+      const client = createFakeClient();
+      client.send.mockImplementation(() => {
+        throw new Error('socket hang up');
+      });
+      const server = {
+        clients: [client],
+        close: vi.fn((cb: Function) => cb()),
+      };
+
+      await expect(adapter.close(server as any)).resolves.not.toThrow();
+      expect(client.terminate).toHaveBeenCalled();
+    });
+
+    it('should not throw and should still close the server when there are no clients', async () => {
+      const server = {
+        clients: [],
+        close: vi.fn((cb: Function) => cb()),
+      };
+
+      await expect(adapter.close(server as any)).resolves.not.toThrow();
+      expect(server.close).toHaveBeenCalled();
+    });
+  });
+});
