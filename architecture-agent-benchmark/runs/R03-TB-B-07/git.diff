@@ -0,0 +1,80 @@
+import { INestApplication } from '@nestjs/common';
+import { WsAdapter } from '@nestjs/platform-ws';
+import { Test } from '@nestjs/testing';
+import { io } from 'socket.io-client';
+import WebSocket from 'ws';
+import { ApplicationGateway } from '../src/app.gateway.js';
+
+async function createNestApp(...gateways: any[]): Promise<INestApplication> {
+  const testingModule = await Test.createTestingModule({
+    providers: gateways,
+  }).compile();
+  return testingModule.createNestApplication();
+}
+
+describe('WebSocket shutdown notification', () => {
+  let app: INestApplication;
+
+  afterEach(async () => {
+    // "close" is idempotent to call twice; guards against tests that
+    // already closed the app as part of the assertion.
+    await app?.close();
+  });
+
+  it('notifies connected socket.io clients before the connection is dropped on shutdown', async () => {
+    app = await createNestApp(ApplicationGateway);
+    await app.listen(3000);
+
+    const client = io('http://localhost:8080');
+    await new Promise<void>(resolve => client.on('connect', resolve));
+
+    const shutdownMessage = new Promise<void>(resolve =>
+      client.on('shutdown', () => resolve()),
+    );
+    const disconnected = new Promise<void>(resolve =>
+      client.on('disconnect', () => resolve()),
+    );
+
+    const closePromise = app.close();
+
+    await shutdownMessage;
+    await disconnected;
+    await closePromise;
+  });
+
+  it('notifies connected "ws" clients before the connection is dropped on shutdown', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [ApplicationGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    app.useWebSocketAdapter(new WsAdapter(app) as any);
+    await app.listen(3000);
+
+    const client = new WebSocket('ws://localhost:8080');
+    await new Promise(resolve => client.on('open', resolve));
+
+    const shutdownMessage = new Promise<void>(resolve => {
+      client.on('message', data => {
+        const parsed = JSON.parse(data.toString());
+        if (parsed.event === 'shutdown') {
+          resolve();
+        }
+      });
+    });
+    const closed = new Promise<void>(resolve =>
+      client.on('close', () => resolve()),
+    );
+
+    await app.close();
+
+    await shutdownMessage;
+    await closed;
+  });
+
+  it('does not fail shutdown when no clients are connected', async () => {
+    app = await createNestApp(ApplicationGateway);
+    await app.listen(3000);
+
+    await expect(app.close()).resolves.not.toThrow();
+  });
+});
