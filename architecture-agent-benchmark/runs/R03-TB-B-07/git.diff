   public async close(server: Server): Promise<void> {
+    await this.notifyShutdown(server);
+
     if (this.forceCloseConnections && server.httpServer === this.httpServer) {
       return;
     }
 
     return super.close(server);
   }
+
+  /**
+   * Notifies every client currently connected to the given server (or
+   * namespace) that it is about to go away.
+   *
+   * `Server#close()` (called right after this) tears down every socket's
+   * underlying transport synchronously and discards any packet that has not
+   * reached the wire yet, so the broadcast above would otherwise be silently
+   * dropped. There is no public, version-stable way to know exactly when a
+   * broadcast packet has actually been flushed to every client's socket, so
+   * a short, fixed grace period - negligible next to a real shutdown grace
+   * period measured in seconds - is used to let it get there instead.
+   */
+  protected async notifyShutdown(server: Server): Promise<void> {
+    if (!this.getConnectedSocketsCount(server)) {
+      return;
+    }
+    server.emit(SHUTDOWN_EVENT);
+    await new Promise(resolve => setTimeout(resolve, 100));
+  }
+
+  private getConnectedSocketsCount(server: Server): number {
+    const namespace: any =
+      server?.sockets instanceof Map ? server : server?.sockets;
+    return namespace?.sockets instanceof Map ? namespace.sockets.size : 0;
+  }
 }
