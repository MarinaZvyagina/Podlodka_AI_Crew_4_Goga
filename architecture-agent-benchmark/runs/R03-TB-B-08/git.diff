+  /**
+   * Sends a heads-up message to a still-connected client and then
+   * terminates its connection, so it can tell a deliberate shutdown apart
+   * from a dropped connection.
+   */
+  protected notifyClientOfShutdown(client: any): Promise<void> {
+    return new Promise<void>(resolve => {
+      const terminate = () => {
+        client.terminate();
+        resolve();
+      };
