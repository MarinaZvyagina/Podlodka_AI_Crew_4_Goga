+  /**
+   * Broadcasts the shutdown notification, then gracefully disconnects each
+   * connected socket so the underlying transport flushes the packet before
+   * the connection is torn down. `Server#close()` discards any packet still
+   * queued when it force-closes sockets, so a plain `emit` immediately
+   * followed by `close` would drop the message.
+   */
+  private async notifyShutdown(server: Server | Namespace): Promise<void> {
+    const notification = this.shutdownNotification;
+    if (!notification) {
+      return;
+    }
+    const sockets = Array.from(this.getConnectedSockets(server).values());
+    if (!sockets.length) {
+      return;
+    }
+    server.emit(notification.event, notification.data);
