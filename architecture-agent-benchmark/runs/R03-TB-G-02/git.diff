+    // `socket.disconnect(true)` resolves the socket-level DISCONNECT_EVENT
+    // synchronously, before the underlying engine.io transport has actually
+    // flushed and closed. Waiting on the transport's own `close` event
+    // ensures the packet is written before `Server#close()` runs, which
+    // would otherwise force-discard anything still queued.
+    await Promise.race([
+      Promise.all(
+        sockets.map(
+          socket =>
+            new Promise<void>(resolve => {
+              socket.conn.once('close', () => resolve());
+              socket.disconnect(true);
+            }),
+        ),
+      ),
+      new Promise(resolve => setTimeout(resolve, SHUTDOWN_NOTIFICATION_TIMEOUT)),
+    ]);
+  }
