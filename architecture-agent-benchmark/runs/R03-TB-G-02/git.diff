+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import { io } from 'socket.io-client';
+import { ApplicationGateway } from '../src/app.gateway.js';
+
+async function createNestApp(
+  options: Record<string, any>,
+  ...gateways: any[]
+): Promise<INestApplication> {
+  const testingModule = await Test.createTestingModule({
+    providers: gateways,
+  }).compile();
+  return testingModule.createNestApplication(options);
+}
+
+describe('WebSocketGateway shutdown notification (IoAdapter)', () => {
+  let app: INestApplication;
+
+  afterEach(async () => {
+    if (app) {
+      await app.close();
+    }
+  });
+
+  it('should notify connected clients before closing when enabled', async () => {
+    app = await createNestApp(
+      { notifyWsClientsOnShutdown: true },
+      ApplicationGateway,
+    );
+    await app.listen(3000);
+
+    const ws = io('http://localhost:8080', { reconnection: false });
+    await new Promise<void>(resolve => ws.on('connect', () => resolve()));
+
+    const notification = new Promise<any>(resolve =>
+      ws.on('shutdown', data => resolve(data)),
+    );
+
+    await app.close();
+    app = undefined as any;
+
+    const data = await notification;
+    expect(data).toEqual({ message: 'Server is shutting down' });
+    ws.close();
+  });
+
+  it('should support a custom event name and payload', async () => {
+    app = await createNestApp(
+      {
+        notifyWsClientsOnShutdown: {
+          event: 'server:closing',
+          data: { reason: 'deploy' },
+        },
+      },
+      ApplicationGateway,
+    );
+    await app.listen(3000);
+
+    const ws = io('http://localhost:8080', { reconnection: false });
+    await new Promise<void>(resolve => ws.on('connect', () => resolve()));
+
+    const notification = new Promise<any>(resolve =>
+      ws.on('server:closing', data => resolve(data)),
+    );
+
+    await app.close();
+    app = undefined as any;
+
+    const data = await notification;
+    expect(data).toEqual({ reason: 'deploy' });
+    ws.close();
+  });
+
+  it('should not send anything when disabled (default)', async () => {
+    app = await createNestApp({}, ApplicationGateway);
+    await app.listen(3000);
+
+    const ws = io('http://localhost:8080', { reconnection: false });
+    await new Promise<void>(resolve => ws.on('connect', () => resolve()));
+
+    let received = false;
+    ws.onAny(() => (received = true));
+
+    await app.close();
+    app = undefined as any;
+
+    expect(received).toBe(false);
+    ws.close();
+  });
+
+  it('should close cleanly when no clients are connected', async () => {
+    app = await createNestApp(
+      { notifyWsClientsOnShutdown: true },
+      ApplicationGateway,
+    );
+    await app.listen(3000);
+
+    await expect(app.close()).resolves.toBeUndefined();
+    app = undefined as any;
+  });
+});
