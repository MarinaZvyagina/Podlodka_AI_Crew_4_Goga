+  /**
+   * `Server#sockets` is the default namespace object, while
+   * `Namespace#sockets` is the `Map` of connected sockets for that namespace.
+   */
+  private getConnectedSockets(
+    server: Server | Namespace,
+  ): Map<string, Socket> {
+    const { sockets } = server;
+    return sockets instanceof Map ? sockets : sockets.sockets;
+  }
 }
