diff --git a/packages/platform-ws/test/ws-adapter.spec.ts b/packages/platform-ws/test/ws-adapter.spec.ts
new file mode 100644
index 0000000..a838b52
--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,90 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+enum READY_STATE {
+  CONNECTING_STATE = 0,
+  OPEN_STATE = 1,
+  CLOSING_STATE = 2,
+  CLOSED_STATE = 3,
+}
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    // WsAdapter's constructor eagerly loads the "ws" package; no server is
+    // needed for the "close" unit tests below.
+    adapter = new WsAdapter();
+  });
+
+  describe('close', () => {
+    const createFakeClient = (readyState: READY_STATE) => ({
+      readyState,
+      send: vi.fn((_data: string, cb?: Function) => cb?.()),
+      terminate: vi.fn(),
+    });
+
+    const createFakeServer = (clients: any[]) => ({
+      clients,
+      close: vi.fn((cb?: Function) => cb?.()),
+    });
+
+    it('should send a shutdown notice to each open client before terminating it', async () => {
+      const client = createFakeClient(READY_STATE.OPEN_STATE);
+      const server = createFakeServer([client]);
+
+      await adapter.close(server as any);
+
+      expect(client.send).toHaveBeenCalledWith(
+        JSON.stringify({ event: 'shutdown' }),
+        expect.any(Function),
+      );
+      expect(client.terminate).toHaveBeenCalledTimes(1);
+      // The client must be notified before it's torn down.
+      const sendOrder = client.send.mock.invocationCallOrder[0];
+      const terminateOrder = client.terminate.mock.invocationCallOrder[0];
+      expect(sendOrder).toBeLessThan(terminateOrder);
+    });
+
+    it('should terminate non-open clients without attempting to send a notice', async () => {
+      const connecting = createFakeClient(READY_STATE.CONNECTING_STATE);
+      const closing = createFakeClient(READY_STATE.CLOSING_STATE);
+      const server = createFakeServer([connecting, closing]);
+
+      await adapter.close(server as any);
+
+      expect(connecting.send).not.toHaveBeenCalled();
+      expect(connecting.terminate).toHaveBeenCalledTimes(1);
+      expect(closing.send).not.toHaveBeenCalled();
+      expect(closing.terminate).toHaveBeenCalledTimes(1);
+    });
+
+    it('should still terminate the client if sending the shutdown notice throws', async () => {
+      const client = createFakeClient(READY_STATE.OPEN_STATE);
+      client.send.mockImplementation(() => {
+        throw new Error('socket hang up');
+      });
+      const server = createFakeServer([client]);
+
+      await adapter.close(server as any);
+
+      expect(client.terminate).toHaveBeenCalledTimes(1);
+    });
+
+    it('should close the underlying server once every client has been notified', async () => {
+      const client = createFakeClient(READY_STATE.OPEN_STATE);
+      const server = createFakeServer([client]);
+
+      await adapter.close(server as any);
+
+      expect(server.close).toHaveBeenCalledTimes(1);
+    });
+
+    it('is a no-op broadcast when there are no connected clients', async () => {
+      const server = createFakeServer([]);
+
+      await adapter.close(server as any);
+
+      expect(server.close).toHaveBeenCalledTimes(1);
+    });
+  });
+});
