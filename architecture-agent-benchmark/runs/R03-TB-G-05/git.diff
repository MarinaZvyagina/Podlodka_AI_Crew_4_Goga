   public async close(server: Server): Promise<void> {
+    await this.notifyClientsOfShutdown(server);
+
     if (this.forceCloseConnections && server.httpServer === this.httpServer) {
       return;
     }
 
     return super.close(server);
   }
+
+  /**
+   * Gives still-connected clients a heads-up that this instance is going
+   * away, right before their connection is closed as part of shutdown.
+   * Uses the "local" broadcast flag so that, when a distributed adapter
+   * (e.g. Redis) is in use, only clients connected to this instance are
+   * notified, not the whole cluster.
+   */
+  private async notifyClientsOfShutdown(
+    server: Server | Namespace,
+  ): Promise<void> {
+    const localSockets = await server.local.fetchSockets();
