diff --git a/packages/platform-ws/test/ws-adapter.spec.ts b/packages/platform-ws/test/ws-adapter.spec.ts
new file mode 100644
index 0000000..c64e44e
--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,51 @@
+import * as http from 'http';
+import { AddressInfo } from 'net';
+import WebSocket from 'ws';
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+describe('WsAdapter', () => {
+  describe('close', () => {
+    it('notifies connected clients before terminating their connections', async () => {
+      const httpServer = http.createServer();
+      const adapter = new WsAdapter(httpServer);
+      const wsServer = adapter.create(0, { server: httpServer, path: '/' });
+
+      await new Promise<void>(resolve => httpServer.listen(0, resolve));
+      const { port } = httpServer.address() as AddressInfo;
+
+      const client = new WebSocket(`ws://localhost:${port}`);
+      await new Promise<void>((resolve, reject) => {
+        client.once('open', () => resolve());
+        client.once('error', reject);
+      });
+
+      const received: any[] = [];
+      const closed = new Promise<{ code: number }>(resolve => {
+        client.on('message', data => received.push(JSON.parse(data.toString())));
+        client.once('close', code => resolve({ code }));
+      });
+
+      await adapter.close(wsServer);
+      await closed;
+      await new Promise<void>(resolve => httpServer.close(() => resolve()));
+
+      expect(received).toHaveLength(1);
+      expect(received[0]).toEqual({
+        event: 'shutdown',
+        data: 'The server is shutting down. This connection will be closed.',
+      });
+    });
+
+    it('does not throw when there are no connected clients', async () => {
+      const httpServer = http.createServer();
+      const adapter = new WsAdapter(httpServer);
+      const wsServer = adapter.create(0, { server: httpServer, path: '/' });
+
+      await new Promise<void>(resolve => httpServer.listen(0, resolve));
+
+      await expect(adapter.close(wsServer)).resolves.toBeUndefined();
+
+      await new Promise<void>(resolve => httpServer.close(() => resolve()));
+    });
+  });
+});
