+      const finish = () => {
+        clearTimeout(timer);
+        resolve();
+      };
+      socket.conn.once('close', finish);
+
+      socket.emit(SHUTDOWN_EVENT, SHUTDOWN_MESSAGE);
+      socket.disconnect(true);
+    });
+  }
+
+  private static readonly SHUTDOWN_GRACE_PERIOD = 300;
