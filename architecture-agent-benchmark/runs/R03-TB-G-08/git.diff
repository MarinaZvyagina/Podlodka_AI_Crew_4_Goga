@@ -0,0 +1,131 @@
+import * as http from 'http';
+import { AddressInfo } from 'net';
+import { io as ioClient, Socket as ClientSocket } from 'socket.io-client';
+import { IoAdapter } from '../adapters/io-adapter.js';
+
+describe('IoAdapter', () => {
+  describe('close', () => {
+    let httpServer: http.Server;
+    let client: ClientSocket;
+
+    afterEach(async () => {
+      client?.close();
+      await new Promise<void>(resolve => httpServer.close(() => resolve()));
+    });
+
+    it('notifies connected clients before disconnecting them', async () => {
+      httpServer = http.createServer();
+      const adapter = new IoAdapter(httpServer);
+      const server = adapter.createIOServer(0);
+
+      await new Promise<void>(resolve => httpServer.listen(0, resolve));
+      const { port } = httpServer.address() as AddressInfo;
+
+      client = ioClient(`http://localhost:${port}`);
+      await new Promise<void>((resolve, reject) => {
+        client.once('connect', () => resolve());
+        client.once('connect_error', reject);
+      });
+
+      const shutdownMessage = new Promise<any>(resolve =>
+        client.once('shutdown', data => resolve(data)),
+      );
+
+      await adapter.close(server);
+
+      await expect(shutdownMessage).resolves.toBe(
+        'The server is shutting down. This connection will be closed.',
+      );
+    });
+
+    it('notifies clients stuck on the long-polling transport', async () => {
+      httpServer = http.createServer();
+      const adapter = new IoAdapter(httpServer);
+      const server = adapter.createIOServer(0);
+
+      await new Promise<void>(resolve => httpServer.listen(0, resolve));
+      const { port } = httpServer.address() as AddressInfo;
+
+      client = ioClient(`http://localhost:${port}`, {
+        transports: ['polling'],
+        upgrade: false,
+      });
+      await new Promise<void>((resolve, reject) => {
+        client.once('connect', () => resolve());
+        client.once('connect_error', reject);
+      });
+
+      const shutdownMessage = new Promise<any>(resolve =>
+        client.once('shutdown', data => resolve(data)),
+      );
+
+      await adapter.close(server);
+
+      await expect(shutdownMessage).resolves.toBe(
+        'The server is shutting down. This connection will be closed.',
+      );
+    });
+
+    it('notifies clients connected to a custom namespace', async () => {
+      httpServer = http.createServer();
+      const adapter = new IoAdapter(httpServer);
+      const rootServer = adapter.createIOServer(0);
+      const server = rootServer.of('/chat');
+
+      await new Promise<void>(resolve => httpServer.listen(0, resolve));
+      const { port } = httpServer.address() as AddressInfo;
+
+      client = ioClient(`http://localhost:${port}/chat`);
+      await new Promise<void>((resolve, reject) => {
+        client.once('connect', () => resolve());
+        client.once('connect_error', reject);
+      });
+
+      const shutdownMessage = new Promise<any>(resolve =>
+        client.once('shutdown', data => resolve(data)),
+      );
+
+      await adapter.close(server);
+
+      await expect(shutdownMessage).resolves.toBe(
+        'The server is shutting down. This connection will be closed.',
+      );
+    });
+
+    it('still notifies clients when forceCloseConnections is enabled', async () => {
+      httpServer = http.createServer();
+      const adapter = new IoAdapter(httpServer);
+      adapter.forceCloseConnections = true;
+      const server = adapter.createIOServer(0);
+
+      await new Promise<void>(resolve => httpServer.listen(0, resolve));
+      const { port } = httpServer.address() as AddressInfo;
+
+      client = ioClient(`http://localhost:${port}`);
+      await new Promise<void>((resolve, reject) => {
+        client.once('connect', () => resolve());
+        client.once('connect_error', reject);
+      });
+
+      const shutdownMessage = new Promise<any>(resolve =>
+        client.once('shutdown', data => resolve(data)),
+      );
+
+      await adapter.close(server);
+
+      await expect(shutdownMessage).resolves.toBe(
+        'The server is shutting down. This connection will be closed.',
+      );
+    });
+
+    it('does not throw when there are no connected clients', async () => {
+      httpServer = http.createServer();
+      const adapter = new IoAdapter(httpServer);
+      const server = adapter.createIOServer(0);
+
+      await new Promise<void>(resolve => httpServer.listen(0, resolve));
+
+      await expect(adapter.close(server)).resolves.toBeUndefined();
+    });
+  });
+});
