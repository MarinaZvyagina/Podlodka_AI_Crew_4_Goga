+  /**
+   * Sends a heads-up message to every currently connected client, letting it
+   * know the server is going away, and gracefully disconnects it.
+   *
+   * `Server#close` discards the underlying engine.io transports without
+   * waiting for their write buffers to flush, so clients are disconnected
+   * here first (via the public, graceful `Socket#disconnect` API). Each
+   * disconnection is given a short, bounded window to actually complete
+   * before `Server#close` is allowed to forcibly tear down whatever is left,
+   * so the notification isn't lost to that race.
+   */
+  protected async notifyClientsOfShutdown(server: Server | Namespace) {
+    // `Server#sockets` is itself the default `Namespace`, whose `sockets`
+    // property holds the actual map of locally connected clients.
