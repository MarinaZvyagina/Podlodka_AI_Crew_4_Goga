+import { Body, Controller, Get, Post } from '@nestjs/common';
+import { MaintenanceModeService } from '../maintenance/maintenance-mode.service.js';
+
+class SetMaintenanceModeDto {
+  enabled: boolean;
+}
+
+/**
+ * Deliberately not marked with @Maintenance(), so operators can always
+ * flip the switch back off even while the rest of the API is down.
+ */
+@Controller('admin/maintenance')
+export class AdminController {
+  constructor(private readonly maintenanceMode: MaintenanceModeService) {}
+
+  @Get()
+  status() {
+    return { enabled: this.maintenanceMode.isEnabled() };
+  }
+
+  @Post()
+  set(@Body() { enabled }: SetMaintenanceModeDto) {
+    enabled ? this.maintenanceMode.enable() : this.maintenanceMode.disable();
+    return { enabled: this.maintenanceMode.isEnabled() };
+  }
+}
