+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../../src/app.module.js';
+
+describe('E2E Maintenance Mode Sample', () => {
+  let app: INestApplication;
+
+  beforeAll(async () => {
+    const modRef = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = modRef.createNestApplication();
+    await app.init();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  afterEach(async () => {
+    await request(app.getHttpServer())
+      .post('/admin/maintenance')
+      .send({ enabled: false });
+  });
+
+  it('serves every route normally while maintenance mode is off', async () => {
+    await request(app.getHttpServer()).get('/cats').expect(200);
+    await request(app.getHttpServer()).post('/cats/migrate').expect(201);
+    await request(app.getHttpServer()).get('/reports/daily').expect(200);
+  });
+
+  it('blocks only the marked routes once maintenance mode is switched on', async () => {
+    await request(app.getHttpServer())
+      .post('/admin/maintenance')
+      .send({ enabled: true })
+      .expect(201, { enabled: true });
+
+    await request(app.getHttpServer()).get('/cats').expect(200);
+    await request(app.getHttpServer()).post('/cats/migrate').expect(503);
+    await request(app.getHttpServer()).get('/reports/daily').expect(503);
+    await request(app.getHttpServer()).get('/reports/weekly').expect(503);
+  });
+
+  it('the admin endpoint itself stays reachable during maintenance, to switch it back off', async () => {
+    await request(app.getHttpServer())
+      .post('/admin/maintenance')
+      .send({ enabled: true });
+
+    await request(app.getHttpServer())
+      .post('/admin/maintenance')
+      .send({ enabled: false })
+      .expect(201, { enabled: false });
+
+    await request(app.getHttpServer()).post('/cats/migrate').expect(201);
+  });
+});
