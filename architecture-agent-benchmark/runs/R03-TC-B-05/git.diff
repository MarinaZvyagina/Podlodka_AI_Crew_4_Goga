@@ -0,0 +1,11 @@
+import { SetMetadata } from '@nestjs/common';
+
+export const MAINTENANCE_METADATA_KEY = 'maintenance:affected';
+
+/**
+ * Marks an HTTP route handler, an entire controller, or a WebSocket
+ * `@SubscribeMessage()` handler as affected by maintenance mode. While
+ * maintenance mode is switched on, calls to anything carrying this
+ * decorator are rejected by `MaintenanceGuard` before their logic runs.
+ */
+export const Maintenance = () => SetMetadata(MAINTENANCE_METADATA_KEY, true);
diff --git a/sample/37-maintenance-mode/src/maintenance/guards/maintenance.guard.spec.ts b/sample/37-maintenance-mode/src/maintenance/guards/maintenance.guard.spec.ts
new file mode 100644
index 0000000..d429c62
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/guards/maintenance.guard.spec.ts
@@ -0,0 +1,90 @@
+import { ExecutionContext, ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MAINTENANCE_METADATA_KEY } from '../decorators/maintenance.decorator.js';
+import { MaintenanceModeService } from '../maintenance-mode.service.js';
+import { MaintenanceGuard } from './maintenance.guard.js';
+
+/**
+ * Builds a bare-bones ExecutionContext, standing in for either an HTTP
+ * route or a WS `@SubscribeMessage()` handler: the guard only ever looks
+ * at getHandler()/getClass()/getType(), so no real server or socket is
+ * needed.
+ */
+const createContext = (
+  handlerAffected?: boolean,
+  classAffected?: boolean,
+  type: 'http' | 'ws' = 'http',
+): ExecutionContext => {
+  const handler = () => undefined;
+  class Controller {}
+
+  if (handlerAffected !== undefined) {
+    Reflect.defineMetadata(MAINTENANCE_METADATA_KEY, handlerAffected, handler);
+  }
+  if (classAffected !== undefined) {
+    Reflect.defineMetadata(MAINTENANCE_METADATA_KEY, classAffected, Controller);
+  }
+
+  return {
+    getHandler: () => handler,
+    getClass: () => Controller,
+    getType: () => type,
+  } as ExecutionContext;
+};
+
+describe('MaintenanceGuard', () => {
+  let guard: MaintenanceGuard;
+  let maintenanceMode: MaintenanceModeService;
+
+  beforeEach(() => {
+    maintenanceMode = new MaintenanceModeService();
+    guard = new MaintenanceGuard(new Reflector(), maintenanceMode);
+  });
+
+  it('allows an unmarked handler even while maintenance mode is on', () => {
+    maintenanceMode.enable();
+    expect(guard.canActivate(createContext())).toBe(true);
+  });
+
+  it('allows a marked handler while maintenance mode is off', () => {
+    expect(guard.canActivate(createContext(true))).toBe(true);
+  });
+
+  it('blocks a marked handler while maintenance mode is on', () => {
+    maintenanceMode.enable();
+    expect(() => guard.canActivate(createContext(true))).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('blocks every handler of a marked controller while maintenance mode is on', () => {
+    maintenanceMode.enable();
+    expect(() =>
+      guard.canActivate(createContext(undefined, true)),
+    ).toThrow(ServiceUnavailableException);
+  });
+
+  it('lets a handler-level marking override a permissive class-level one', () => {
+    maintenanceMode.enable();
+    expect(() =>
+      guard.canActivate(createContext(true, false)),
+    ).toThrow(ServiceUnavailableException);
+  });
+
+  it('blocks a marked WS message handler with a WsException instead of an HttpException', () => {
+    maintenanceMode.enable();
+    expect(() =>
+      guard.canActivate(createContext(true, undefined, 'ws')),
+    ).toThrow(WsException);
+  });
+
+  it('re-allows a marked handler once maintenance mode is switched back off', () => {
+    maintenanceMode.enable();
+    const context = createContext(true);
+    expect(() => guard.canActivate(context)).toThrow(ServiceUnavailableException);
+
+    maintenanceMode.disable();
+    expect(guard.canActivate(context)).toBe(true);
+  });
+});
diff --git a/sample/37-maintenance-mode/src/maintenance/guards/maintenance.guard.ts b/sample/37-maintenance-mode/src/maintenance/guards/maintenance.guard.ts
new file mode 100644
index 0000000..e64a481
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/guards/maintenance.guard.ts
@@ -0,0 +1,49 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MAINTENANCE_METADATA_KEY } from '../decorators/maintenance.decorator.js';
+import { MaintenanceModeService } from '../maintenance-mode.service.js';
+
+const MAINTENANCE_MESSAGE =
+  'This operation is temporarily unavailable due to maintenance.';
+
+/**
+ * Applies uniformly to HTTP routes and WebSocket message handlers, since
+ * both expose the same `ExecutionContext#getHandler()`/`getClass()` and
+ * are guarded through the same Nest guards pipeline. The rejection is
+ * raised as a `WsException` under the `ws` context type so that Nest's
+ * built-in WS exception filter reports the actual message to the client,
+ * instead of the generic message it substitutes for HTTP exceptions.
+ *
+ * Register it with `@UseGuards(MaintenanceGuard)` on every controller or
+ * gateway that uses `@Maintenance()` (global registration via `APP_GUARD`
+ * does not reach WebSocket message handlers).
+ */
+@Injectable()
+export class MaintenanceGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceMode: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isAffected = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_METADATA_KEY,
+      [context.getHandler(), context.getClass()],
+    );
+
+    if (!isAffected || !this.maintenanceMode.isEnabled()) {
+      return true;
+    }
+
+    if (context.getType() === 'ws') {
+      throw new WsException(MAINTENANCE_MESSAGE);
+    }
+    throw new ServiceUnavailableException(MAINTENANCE_MESSAGE);
+  }
+}
