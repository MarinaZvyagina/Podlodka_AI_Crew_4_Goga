+import { UseGuards } from '@nestjs/common';
+import {
+  MessageBody,
+  SubscribeMessage,
+  WebSocketGateway,
+} from '@nestjs/websockets';
+import { Maintenance } from '../maintenance/decorators/maintenance.decorator.js';
+import { MaintenanceGuard } from '../maintenance/guards/maintenance.guard.js';
+
+@UseGuards(MaintenanceGuard)
+@WebSocketGateway({
+  cors: {
+    origin: '*',
+  },
+})
+export class EventsGateway {
+  @SubscribeMessage('ping')
+  ping(@MessageBody() data: unknown) {
+    return { status: 'pong', received: data };
+  }
+
+  @SubscribeMessage('migrateData')
+  @Maintenance()
+  migrateData(@MessageBody() data: unknown) {
+    return { status: 'migrated', received: data };
+  }
+}
