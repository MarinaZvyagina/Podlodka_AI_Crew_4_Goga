+import { Module } from '@nestjs/common';
+import { MaintenanceGuard } from './guards/maintenance.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Import this into any module whose controllers or gateways use
+ * `@Maintenance()`, then add `@UseGuards(MaintenanceGuard)` to those
+ * classes so the guard actually runs (see MaintenanceGuard's doc comment
+ * for why this is explicit rather than global).
+ */
+@Module({
+  providers: [MaintenanceModeService, MaintenanceGuard],
+  exports: [MaintenanceModeService, MaintenanceGuard],
+})
+export class MaintenanceModule {}
