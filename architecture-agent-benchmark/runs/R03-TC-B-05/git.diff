+import { Controller, Get, UseGuards } from '@nestjs/common';
+import { Maintenance } from '../maintenance/decorators/maintenance.decorator.js';
+import { MaintenanceGuard } from '../maintenance/guards/maintenance.guard.js';
+
+/**
+ * The whole controller depends on data touched by the migration, so it
+ * is marked at the class level: every route on it is affected.
+ */
+@UseGuards(MaintenanceGuard)
+@Maintenance()
+@Controller('reports')
+export class ReportsController {
+  @Get('daily')
+  daily() {
+    return { report: 'daily-report-data' };
+  }
+
+  @Get('weekly')
+  weekly() {
+    return { report: 'weekly-report-data' };
+  }
+}
