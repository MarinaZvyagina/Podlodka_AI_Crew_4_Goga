+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import { io, Socket } from 'socket.io-client';
+import request from 'supertest';
+import { AppModule } from '../../src/app.module.js';
+
+describe('EventsGateway (e2e)', () => {
+  let app: INestApplication;
+  let socket: Socket;
+
+  beforeAll(async () => {
+    const moduleRef = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = moduleRef.createNestApplication();
+    await app.listen(3001);
+  });
+
+  beforeEach(() => {
+    return new Promise<void>(resolve => {
+      socket = io('http://localhost:3001');
+      socket.on('connect', () => resolve());
+    });
+  });
+
+  afterEach(async () => {
+    socket.disconnect();
+    await request(app.getHttpServer())
+      .post('/admin/maintenance')
+      .send({ enabled: false });
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('answers an unmarked message while maintenance mode is off', () => {
+    return new Promise<void>((resolve, reject) => {
+      socket.emit('ping', 'hi', response => {
+        try {
+          expect(response).toEqual({ status: 'pong', received: 'hi' });
+          resolve();
+        } catch (err) {
+          reject(err);
+        }
+      });
+    });
+  });
+
+  it('answers a marked message while maintenance mode is off', () => {
+    return new Promise<void>((resolve, reject) => {
+      socket.emit('migrateData', { x: 1 }, response => {
+        try {
+          expect(response.status).toEqual('migrated');
+          resolve();
+        } catch (err) {
+          reject(err);
+        }
+      });
+    });
+  });
+
+  it('rejects a marked message with a clear error once maintenance mode is on, but still answers unmarked ones', async () => {
+    await request(app.getHttpServer())
+      .post('/admin/maintenance')
+      .send({ enabled: true })
+      .expect(201, { enabled: true });
+
+    await new Promise<void>((resolve, reject) => {
+      socket.emit('ping', 'hi', response => {
+        try {
+          expect(response).toEqual({ status: 'pong', received: 'hi' });
+          resolve();
+        } catch (err) {
+          reject(err);
+        }
+      });
+    });
+
+    await new Promise<void>((resolve, reject) => {
+      socket.once('exception', payload => {
+        try {
+          expect(payload.message).toContain('maintenance');
+          resolve();
+        } catch (err) {
+          reject(err);
+        }
+      });
+      socket.emit('migrateData', { x: 1 }, () => {
+        reject(new Error('migrateData should not have been acknowledged'));
+      });
+    });
+  });
+});
