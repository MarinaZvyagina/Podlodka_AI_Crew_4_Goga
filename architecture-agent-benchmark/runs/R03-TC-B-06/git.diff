+import { Controller, Get, UseGuards } from '@nestjs/common';
+import { AffectedByMaintenance } from '../maintenance-mode/maintenance-mode.decorator.js';
+import { MaintenanceModeGuard } from '../maintenance-mode/maintenance-mode.guard.js';
+import { CatsService } from './cats.service.js';
+
+@UseGuards(MaintenanceModeGuard)
+@Controller('cats')
+export class CatsController {
+  constructor(private readonly catsService: CatsService) {}
+
+  // Unaffected by the migration - keeps working normally during maintenance.
+  @Get()
+  findAll(): string[] {
+    return this.catsService.findAll();
+  }
+
+  // Depends on data being migrated - turned away while maintenance mode is on.
+  @Get('migrated')
+  @AffectedByMaintenance()
+  findAllMigrated(): string[] {
+    return this.catsService.findAllMigrated();
+  }
+}
