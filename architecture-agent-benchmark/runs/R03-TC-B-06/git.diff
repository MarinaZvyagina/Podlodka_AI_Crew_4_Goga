+import { Global, Module } from '@nestjs/common';
+import { MaintenanceModeController } from './maintenance-mode.controller.js';
+import { MaintenanceModeGuard } from './maintenance-mode.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * `@Global()` so any controller or gateway in the app can pull in
+ * `MaintenanceModeGuard` with `@UseGuards(MaintenanceModeGuard)` without
+ * importing this module directly. The guard is applied explicitly rather
+ * than registered as an `APP_GUARD`: Nest's global enhancers only wire up
+ * through the HTTP request pipeline, not through WebSocket gateways, so a
+ * provider-token-based global guard would silently never run for
+ * `@SubscribeMessage()` handlers. Explicit `@UseGuards()` is the one
+ * mechanism that actually covers both transports.
+ */
+@Global()
+@Module({
+  controllers: [MaintenanceModeController],
+  providers: [MaintenanceModeService, MaintenanceModeGuard],
+  exports: [MaintenanceModeService, MaintenanceModeGuard],
+})
+export class MaintenanceModeModule {}
