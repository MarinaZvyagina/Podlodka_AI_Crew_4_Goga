@@ -0,0 +1,12 @@
+import { SetMetadata } from '@nestjs/common';
+
+export const AFFECTED_BY_MAINTENANCE_KEY = 'affectedByMaintenance';
+
+/**
+ * Marks an HTTP route handler, a WebSocket `@SubscribeMessage` handler, or an
+ * entire controller/gateway class as affected by maintenance mode. While
+ * maintenance mode is enabled, `MaintenanceModeGuard` rejects calls to
+ * anything carrying this metadata before their handler logic runs.
+ */
+export const AffectedByMaintenance = (): ClassDecorator & MethodDecorator =>
+  SetMetadata(AFFECTED_BY_MAINTENANCE_KEY, true);
diff --git a/sample/37-maintenance-mode/src/maintenance-mode/maintenance-mode.guard.spec.ts b/sample/37-maintenance-mode/src/maintenance-mode/maintenance-mode.guard.spec.ts
new file mode 100644
index 0000000..6011b4b
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance-mode/maintenance-mode.guard.spec.ts
@@ -0,0 +1,129 @@
+import { ExecutionContext, ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { AffectedByMaintenance } from './maintenance-mode.decorator.js';
+import { MaintenanceModeGuard } from './maintenance-mode.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+// Fixture classes carrying the same metadata a real controller or gateway
+// would have, so the guard can be exercised without booting an app, an HTTP
+// server, or a socket connection.
+class PlainController {
+  untouchedHandler() {}
+
+  @AffectedByMaintenance()
+  migrationDependentHandler() {}
+}
+
+@AffectedByMaintenance()
+class FullyAffectedController {
+  anyHandler() {}
+}
+
+function createExecutionContext(
+  handler: (...args: unknown[]) => unknown,
+  controllerClass: new (...args: unknown[]) => unknown,
+): ExecutionContext {
+  return {
+    getHandler: () => handler,
+    getClass: () => controllerClass,
+  } as unknown as ExecutionContext;
+}
+
+describe('MaintenanceModeGuard', () => {
+  let guard: MaintenanceModeGuard;
+  let maintenanceModeService: MaintenanceModeService;
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(new Reflector(), maintenanceModeService);
+  });
+
+  it('allows an unmarked handler through while maintenance mode is on', () => {
+    maintenanceModeService.enable();
+
+    const context = createExecutionContext(
+      PlainController.prototype.untouchedHandler,
+      PlainController,
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('allows a marked handler through while maintenance mode is off', () => {
+    const context = createExecutionContext(
+      PlainController.prototype.migrationDependentHandler,
+      PlainController,
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('rejects a marked handler while maintenance mode is on', () => {
+    maintenanceModeService.enable();
+
+    const context = createExecutionContext(
+      PlainController.prototype.migrationDependentHandler,
+      PlainController,
+    );
+
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('rejects every handler of a class-level marked controller while maintenance mode is on', () => {
+    maintenanceModeService.enable();
+
+    const context = createExecutionContext(
+      FullyAffectedController.prototype.anyHandler,
+      FullyAffectedController,
+    );
+
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('lets a marked handler work again once maintenance mode is switched back off', () => {
+    maintenanceModeService.enable();
+    const context = createExecutionContext(
+      PlainController.prototype.migrationDependentHandler,
+      PlainController,
+    );
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+
+    maintenanceModeService.disable();
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('applies the exact same check to a WebSocket message handler as to an HTTP one', () => {
+    // `@SubscribeMessage()` handlers are plain class methods too, so marking
+    // one with `@AffectedByMaintenance()` produces metadata this guard reads
+    // in exactly the same way - no WS-specific branch is needed.
+    class SocketGateway {
+      @AffectedByMaintenance()
+      onMigrationDependentMessage() {}
+
+      onRegularMessage() {}
+    }
+
+    maintenanceModeService.enable();
+
+    const affected = createExecutionContext(
+      SocketGateway.prototype.onMigrationDependentMessage,
+      SocketGateway,
+    );
+    const unaffected = createExecutionContext(
+      SocketGateway.prototype.onRegularMessage,
+      SocketGateway,
+    );
+
+    expect(() => guard.canActivate(affected)).toThrow(
+      ServiceUnavailableException,
+    );
+    expect(guard.canActivate(unaffected)).toBe(true);
+  });
+});
