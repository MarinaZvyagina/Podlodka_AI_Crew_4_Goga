+import { Controller, Post } from '@nestjs/common';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Internal admin endpoint used to flip maintenance mode on/off at runtime.
+ * In a real deployment this would sit behind whatever admin authentication
+ * the rest of the API already uses.
+ */
+@Controller('admin/maintenance-mode')
+export class MaintenanceModeController {
+  constructor(
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  @Post('enable')
+  enable() {
+    this.maintenanceModeService.enable();
+    return { maintenanceMode: true };
+  }
+
+  @Post('disable')
+  disable() {
+    this.maintenanceModeService.disable();
+    return { maintenanceMode: false };
+  }
+}
