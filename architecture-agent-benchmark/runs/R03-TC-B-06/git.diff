index 0000000..3eaec02
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance-mode/maintenance-mode.guard.ts
@@ -0,0 +1,39 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { AFFECTED_BY_MAINTENANCE_KEY } from './maintenance-mode.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Rejects calls to any handler (or handlers of a class) marked with
+ * `@AffectedByMaintenance()` while maintenance mode is enabled. Because it
+ * relies only on `ExecutionContext`, the very same guard covers HTTP route
+ * handlers and WebSocket message handlers - there is no separate mechanism
+ * for the two transports.
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isAffected = this.reflector.getAllAndOverride<boolean>(
+      AFFECTED_BY_MAINTENANCE_KEY,
+      [context.getHandler(), context.getClass()],
+    );
+
+    if (!isAffected || !this.maintenanceModeService.isEnabled()) {
+      return true;
+    }
+
+    throw new ServiceUnavailableException(
+      'This part of the API is temporarily unavailable for maintenance. Please try again later.',
+    );
+  }
+}
