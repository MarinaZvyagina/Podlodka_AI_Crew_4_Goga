+import { MAINTENANCE_MODE_METADATA } from '../../constants.js';
+import { MaintenanceMode } from '../../decorators/core/maintenance-mode.decorator.js';
+
+describe('@MaintenanceMode', () => {
+  @MaintenanceMode()
+  class AffectedController {}
+
+  class MixedController {
+    @MaintenanceMode()
+    public affectedHandler() {}
+
+    public unaffectedHandler() {}
+  }
+
+  class OverriddenController {
+    @MaintenanceMode(false)
+    public exemptHandler() {}
+  }
+
+  it('should mark a class as affected by default', () => {
+    expect(Reflect.getMetadata(MAINTENANCE_MODE_METADATA, AffectedController)).toBe(
+      true,
+    );
+  });
+
+  it('should mark a decorated method as affected by default', () => {
+    expect(
+      Reflect.getMetadata(
+        MAINTENANCE_MODE_METADATA,
+        MixedController.prototype.affectedHandler,
+      ),
+    ).toBe(true);
+  });
+
+  it('should leave an undecorated method without metadata', () => {
+    expect(
+      Reflect.getMetadata(
+        MAINTENANCE_MODE_METADATA,
+        MixedController.prototype.unaffectedHandler,
+      ),
+    ).toBeUndefined();
+  });
+
+  it('should allow explicitly opting a method out', () => {
+    expect(
+      Reflect.getMetadata(
+        MAINTENANCE_MODE_METADATA,
+        OverriddenController.prototype.exemptHandler,
+      ),
+    ).toBe(false);
+  });
+});
