@@ -0,0 +1,20 @@
+import { MAINTENANCE_MODE_METADATA } from '../../constants.js';
+import { type CustomDecorator, SetMetadata } from './set-metadata.decorator.js';
+
+/**
+ * Marks a controller, gateway, route handler, or WebSocket message handler
+ * as affected by maintenance mode. While maintenance mode is enabled (see
+ * `MaintenanceModeService`), calls to a marked target are rejected by
+ * `MaintenanceModeGuard` before their handler logic runs; everything else
+ * keeps working normally.
+ *
+ * Applying it to a method overrides the value applied to its class, so a
+ * single handler can be exempted from (or added to) a class-wide marking.
+ *
+ * @param affected whether the target is affected by maintenance mode
+ * @see [Maintenance mode](https://docs.nestjs.com/guards)
+ *
+ * @publicApi
+ */
+export const MaintenanceMode = (affected = true): CustomDecorator<string> =>
+  SetMetadata(MAINTENANCE_MODE_METADATA, affected);
