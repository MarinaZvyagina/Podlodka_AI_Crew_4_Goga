diff --git a/packages/core/maintenance/maintenance-mode.guard.ts b/packages/core/maintenance/maintenance-mode.guard.ts
new file mode 100644
index 0000000..904d816
--- /dev/null
+++ b/packages/core/maintenance/maintenance-mode.guard.ts
@@ -0,0 +1,49 @@
+import {
+  type CanActivate,
+  type ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { MAINTENANCE_MODE_METADATA } from '@nestjs/common/internal';
+import { Reflector } from '../services/reflector.service.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Rejects calls to handlers marked with `@MaintenanceMode()` while
+ * `MaintenanceModeService` reports maintenance mode as enabled, before any
+ * of the handler's own logic runs. Unmarked handlers are never affected.
+ *
+ * Because it implements the transport-agnostic `CanActivate` contract, the
+ * same guard and the same `@MaintenanceMode()` decorator protect both HTTP
+ * route handlers/controllers and WebSocket message handlers/gateways.
+ *
+ * @example
+ * ```ts
+ * providers: [{ provide: APP_GUARD, useClass: MaintenanceModeGuard }]
+ * ```
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly maintenanceModeService: MaintenanceModeService,
+    private readonly reflector: Reflector,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    if (!this.maintenanceModeService.isEnabled()) {
+      return true;
+    }
+    const isAffected = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_MODE_METADATA,
+      [context.getHandler(), context.getClass()],
+    );
+    if (!isAffected) {
+      return true;
+    }
+    throw new ServiceUnavailableException(
+      'This operation is temporarily unavailable due to scheduled maintenance.',
+    );
+  }
+}
diff --git a/packages/core/maintenance/maintenance-mode.service.ts b/packages/core/maintenance/maintenance-mode.service.ts
new file mode 100644
index 0000000..9e8bc3a
--- /dev/null
+++ b/packages/core/maintenance/maintenance-mode.service.ts
@@ -0,0 +1,28 @@
+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the application-wide maintenance mode flag.
+ *
+ * Inject this service anywhere (e.g. an admin endpoint) to toggle
+ * maintenance mode at runtime, without redeploying. Combine with
+ * `@MaintenanceMode()` and `MaintenanceModeGuard` to reject calls to marked
+ * handlers while maintenance mode is enabled.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  enable(): void {
+    this.enabled = true;
+  }
+
+  disable(): void {
+    this.enabled = false;
+  }
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+}
diff --git a/packages/core/test/maintenance/maintenance-mode.guard.spec.ts b/packages/core/test/maintenance/maintenance-mode.guard.spec.ts
new file mode 100644
index 0000000..8cbccea
--- /dev/null
+++ b/packages/core/test/maintenance/maintenance-mode.guard.spec.ts
@@ -0,0 +1,86 @@
+import type { ExecutionContext } from '@nestjs/common';
+import { MaintenanceMode, ServiceUnavailableException } from '@nestjs/common';
+import { MaintenanceModeGuard } from '../../maintenance/maintenance-mode.guard.js';
+import { MaintenanceModeService } from '../../maintenance/maintenance-mode.service.js';
+import { Reflector } from '../../services/reflector.service.js';
+
+describe('MaintenanceModeGuard', () => {
+  class AffectedController {
+    @MaintenanceMode()
+    affectedHandler() {}
+
+    unaffectedHandler() {}
+  }
+
+  @MaintenanceMode()
+  class AffectedGateway {
+    @MaintenanceMode(false)
+    exemptHandler() {}
+  }
+
+  let maintenanceModeService: MaintenanceModeService;
+  let guard: MaintenanceModeGuard;
+
+  const createContext = (
+    handler: Function,
+    klass: Function,
+  ): ExecutionContext =>
+    ({
+      getHandler: () => handler,
+      getClass: () => klass,
+    }) as ExecutionContext;
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(maintenanceModeService, new Reflector());
+  });
+
+  describe('when maintenance mode is disabled', () => {
+    it('should allow a marked handler through', () => {
+      const context = createContext(
+        AffectedController.prototype.affectedHandler,
+        AffectedController,
+      );
+      expect(guard.canActivate(context)).toBe(true);
+    });
+  });
+
+  describe('when maintenance mode is enabled', () => {
+    beforeEach(() => maintenanceModeService.enable());
+
+    it('should reject a handler marked with @MaintenanceMode()', () => {
+      const context = createContext(
+        AffectedController.prototype.affectedHandler,
+        AffectedController,
+      );
+      expect(() => guard.canActivate(context)).toThrow(
+        ServiceUnavailableException,
+      );
+    });
+
+    it('should allow an unmarked handler through', () => {
+      const context = createContext(
+        AffectedController.prototype.unaffectedHandler,
+        AffectedController,
+      );
+      expect(guard.canActivate(context)).toBe(true);
+    });
+
+    it('should allow a handler explicitly exempted via @MaintenanceMode(false)', () => {
+      const context = createContext(
+        AffectedGateway.prototype.exemptHandler,
+        AffectedGateway,
+      );
+      // handler-level @MaintenanceMode(false) overrides the class marking
+      expect(guard.canActivate(context)).toBe(true);
+    });
+
+    it('should reject other handlers of a class-level marked gateway', () => {
+      const otherHandler = function otherHandler() {};
+      const context = createContext(otherHandler, AffectedGateway);
+      expect(() => guard.canActivate(context)).toThrow(
+        ServiceUnavailableException,
+      );
+    });
+  });
+});
