+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the process-wide maintenance mode flag. Inject this service wherever
+ * the flag needs to be toggled at runtime (e.g. from an internal admin
+ * endpoint or a CLI command triggered during a migration) - no redeploy
+ * required. `MaintenanceModeGuard` reads `isEnabled()` to decide whether to
+ * reject calls to handlers marked with `@AffectedByMaintenance()`.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  enable(): void {
+    this.enabled = true;
+  }
+
+  disable(): void {
+    this.enabled = false;
+  }
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+}
