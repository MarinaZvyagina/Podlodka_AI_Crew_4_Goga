@@ -0,0 +1,127 @@
+import type { ExecutionContext } from '@nestjs/common';
+import { ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import {
+  MaintenanceModeGuard,
+  MAINTENANCE_MODE_MESSAGE,
+} from '../src/maintenance-mode.guard.js';
+import { MaintenanceModeService } from '../src/maintenance-mode.service.js';
+import {
+  MigrationController,
+  ReportsController,
+} from '../src/demo-http.controller.js';
+import { MigrationGateway } from '../src/demo.gateway.js';
+
+/**
+ * Builds a minimal `ExecutionContext` stand-in - just enough for the guard
+ * to reflect metadata off, with no server or socket involved.
+ */
+function createContext(
+  handler: (...args: any[]) => any,
+  klass: Function,
+  type: 'http' | 'ws' = 'http',
+): ExecutionContext {
+  return {
+    getHandler: () => handler,
+    getClass: () => klass,
+    getType: () => type,
+  } as unknown as ExecutionContext;
+}
+
+describe('MaintenanceModeGuard', () => {
+  let guard: MaintenanceModeGuard;
+  let maintenanceModeService: MaintenanceModeService;
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(new Reflector(), maintenanceModeService);
+  });
+
+  describe('when maintenance mode is disabled', () => {
+    it('lets marked and unmarked HTTP handlers through', () => {
+      const controller = new MigrationController();
+
+      expect(
+        guard.canActivate(
+          createContext(controller.migrateNow, MigrationController),
+        ),
+      ).toBe(true);
+      expect(
+        guard.canActivate(createContext(controller.health, MigrationController)),
+      ).toBe(true);
+    });
+  });
+
+  describe('when maintenance mode is enabled', () => {
+    beforeEach(() => maintenanceModeService.enable());
+
+    it('blocks a method-level marked HTTP handler', () => {
+      const controller = new MigrationController();
+
+      expect(() =>
+        guard.canActivate(
+          createContext(controller.migrateNow, MigrationController),
+        ),
+      ).toThrow(ServiceUnavailableException);
+    });
+
+    it('leaves an unmarked handler on the same controller unaffected', () => {
+      const controller = new MigrationController();
+
+      expect(
+        guard.canActivate(createContext(controller.health, MigrationController)),
+      ).toBe(true);
+    });
+
+    it('blocks every handler of a class-level marked controller', () => {
+      const controller = new ReportsController();
+
+      expect(() =>
+        guard.canActivate(createContext(controller.list, ReportsController)),
+      ).toThrow(ServiceUnavailableException);
+    });
+
+    it('throws a WsException (not an HTTP exception) for a marked WS message handler', () => {
+      const gateway = new MigrationGateway();
+
+      expect(() =>
+        guard.canActivate(
+          createContext(gateway.syncData, MigrationGateway, 'ws'),
+        ),
+      ).toThrow(WsException);
+    });
+
+    it('leaves an unmarked WS message handler on the same gateway unaffected', () => {
+      const gateway = new MigrationGateway();
+
+      expect(
+        guard.canActivate(createContext(gateway.ping, MigrationGateway, 'ws')),
+      ).toBe(true);
+    });
+
+    it('carries a clear maintenance message on the thrown exception', () => {
+      const controller = new MigrationController();
+
+      try {
+        guard.canActivate(
+          createContext(controller.migrateNow, MigrationController),
+        );
+        throw new Error('expected guard to throw');
+      } catch (error) {
+        expect((error as Error).message).toBe(MAINTENANCE_MODE_MESSAGE);
+      }
+    });
+
+    it('is disabled again once maintenance mode is switched off', () => {
+      maintenanceModeService.disable();
+      const controller = new MigrationController();
+
+      expect(
+        guard.canActivate(
+          createContext(controller.migrateNow, MigrationController),
+        ),
+      ).toBe(true);
+    });
+  });
+});
