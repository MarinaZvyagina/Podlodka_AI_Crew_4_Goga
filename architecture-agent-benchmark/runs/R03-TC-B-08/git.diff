+import { Controller, Get, UseGuards } from '@nestjs/common';
+import { AffectedByMaintenance } from './affected-by-maintenance.decorator.js';
+import { MaintenanceModeGuard } from './maintenance-mode.guard.js';
+
+/**
+ * Only the `migrateNow` handler is affected by maintenance mode; `health`
+ * keeps responding normally regardless of the flag.
+ */
+@UseGuards(MaintenanceModeGuard)
+@Controller('migration')
+export class MigrationController {
+  @Get('health')
+  health() {
+    return { status: 'ok' };
+  }
+
+  @Get('run')
+  @AffectedByMaintenance()
+  migrateNow() {
+    return { status: 'migrated' };
+  }
+}
+
+/**
+ * The whole controller depends on the data migration, so it's marked at the
+ * class level - every handler in it is affected by maintenance mode.
+ */
+@UseGuards(MaintenanceModeGuard)
+@AffectedByMaintenance()
+@Controller('reports')
+export class ReportsController {
+  @Get()
+  list() {
+    return [];
+  }
+}
