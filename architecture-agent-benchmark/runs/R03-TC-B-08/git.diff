@@ -0,0 +1,14 @@
+import { SetMetadata } from '@nestjs/common';
+import { MAINTENANCE_MODE_METADATA } from './maintenance-mode.constants.js';
+
+/**
+ * Marks a route handler, a WebSocket message handler, or an entire
+ * controller/gateway as affected by maintenance mode. While maintenance mode
+ * is enabled (see `MaintenanceModeService`), calls to anything marked with
+ * this decorator are rejected by `MaintenanceModeGuard` before their handler
+ * body runs. Everything left unmarked keeps working normally.
+ *
+ * @publicApi
+ */
+export const AffectedByMaintenance = (): ClassDecorator & MethodDecorator =>
+  SetMetadata(MAINTENANCE_MODE_METADATA, true);
