+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MAINTENANCE_MODE_METADATA } from './maintenance-mode.constants.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+export const MAINTENANCE_MODE_MESSAGE =
+  'This operation is temporarily unavailable due to scheduled maintenance. Please try again shortly.';
+
+/**
+ * Rejects calls to any handler (or any handler of any controller/gateway)
+ * marked with `@AffectedByMaintenance()` while maintenance mode is enabled,
+ * before its logic runs. Unmarked handlers are always let through, and
+ * marked handlers work normally again as soon as maintenance mode is
+ * disabled.
+ *
+ * Reads metadata off the handler first, falling back to its class, so a
+ * single method or an entire controller/gateway can be marked.
+ *
+ * Works uniformly for both HTTP routes and WebSocket message handlers since
+ * both go through the same guard pipeline over `ExecutionContext` - only the
+ * exception raised is adapted to the transport so callers get a clear error
+ * either way.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isAffectedByMaintenance = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_MODE_METADATA,
+      [context.getHandler(), context.getClass()],
+    );
+
+    if (!isAffectedByMaintenance || !this.maintenanceModeService.isEnabled()) {
+      return true;
+    }
+
+    if (context.getType() === 'ws') {
+      throw new WsException(MAINTENANCE_MODE_MESSAGE);
+    }
+    throw new ServiceUnavailableException(MAINTENANCE_MODE_MESSAGE);
+  }
+}
