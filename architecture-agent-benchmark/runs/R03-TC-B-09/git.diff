+import { Module } from '@nestjs/common';
+import { APP_GUARD } from '@nestjs/core';
+import { MaintenanceAdminController } from './maintenance-admin.controller.js';
+import { MaintenanceModeGuard } from './maintenance-mode.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+@Module({
+  controllers: [MaintenanceAdminController],
+  providers: [
+    MaintenanceModeService,
+    // Applied globally so it runs in front of every HTTP route and every
+    // gateway that also has it bound (see EventsGateway). It only ever
+    // rejects calls that are both marked with `@AffectedByMaintenance()`
+    // and made while maintenance mode is on - everything else passes
+    // straight through.
+    { provide: APP_GUARD, useClass: MaintenanceModeGuard },
+  ],
+  exports: [MaintenanceModeService],
+})
+export class MaintenanceModule {}
