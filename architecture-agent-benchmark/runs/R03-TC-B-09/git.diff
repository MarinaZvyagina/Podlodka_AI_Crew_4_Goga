@@ -0,0 +1,57 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MAINTENANCE_AFFECTED_KEY } from './affected-by-maintenance.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+const MAINTENANCE_MESSAGE =
+  'This operation is temporarily unavailable due to scheduled maintenance. Please try again later.';
+
+/**
+ * Rejects calls to whatever is decorated with `@AffectedByMaintenance()`
+ * while `MaintenanceModeService` reports maintenance mode as on, and leaves
+ * everything else untouched.
+ *
+ * Register it globally (e.g. via `APP_GUARD`) to cover every HTTP route, and
+ * add `@UseGuards(MaintenanceModeGuard)` to any gateway whose messages need
+ * the same protection - `ExecutionContext` already abstracts over both
+ * transports, so it's the exact same guard and the exact same
+ * `@AffectedByMaintenance()` metadata either way; no separate WS-specific
+ * mechanism is needed.
+ *
+ * Because it depends only on `Reflector` and `MaintenanceModeService`, it can
+ * be instantiated directly in a unit test with fakes/mocks for both, and
+ * exercised against a hand-built `ExecutionContext` - no HTTP server or
+ * socket connection required.
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceMode: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    if (!this.maintenanceMode.isEnabled()) {
+      return true;
+    }
+
+    const isAffected = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_AFFECTED_KEY,
+      [context.getHandler(), context.getClass()],
+    );
+    if (!isAffected) {
+      return true;
+    }
+
+    if (context.getType() === 'ws') {
+      throw new WsException(MAINTENANCE_MESSAGE);
+    }
+    throw new ServiceUnavailableException(MAINTENANCE_MESSAGE);
+  }
+}
