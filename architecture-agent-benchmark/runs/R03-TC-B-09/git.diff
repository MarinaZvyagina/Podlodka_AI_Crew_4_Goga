@@ -0,0 +1,47 @@
+import { SetMetadata } from '@nestjs/common';
+
+/**
+ * Reflector key read by `MaintenanceModeGuard`. Exported so tests and other
+ * guards can inspect the metadata directly without going through the guard.
+ */
+export const MAINTENANCE_AFFECTED_KEY = 'maintenance:affected';
+
+/**
+ * Marks an HTTP route handler, an entire HTTP controller, or a WebSocket
+ * `@SubscribeMessage()` handler as one that must be rejected while
+ * maintenance mode is switched on.
+ *
+ * Because it's plain Nest metadata (`SetMetadata`), it carries no knowledge
+ * of transport, host, or adapter - the same decorator is read by
+ * `MaintenanceModeGuard` regardless of whether it decorates an HTTP method,
+ * an HTTP controller class, or a gateway's message handler.
+ *
+ * @example Whole controller
+ * ```ts
+ * @AffectedByMaintenance()
+ * @Controller('migration')
+ * export class MigrationController {}
+ * ```
+ *
+ * @example Single handler
+ * ```ts
+ * @Controller('orders')
+ * export class OrdersController {
+ *   @AffectedByMaintenance()
+ *   @Post('bulk-reindex')
+ *   reindex() {}
+ * }
+ * ```
+ *
+ * @example WebSocket message handler
+ * ```ts
+ * @WebSocketGateway()
+ * export class OrdersGateway {
+ *   @AffectedByMaintenance()
+ *   @SubscribeMessage('reindex')
+ *   handleReindex() {}
+ * }
+ * ```
+ */
+export const AffectedByMaintenance = () =>
+  SetMetadata(MAINTENANCE_AFFECTED_KEY, true);
