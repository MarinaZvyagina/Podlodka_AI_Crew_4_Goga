@@ -0,0 +1,28 @@
+import { Injectable, Logger } from '@nestjs/common';
+
+/**
+ * Holds the process-wide maintenance mode flag.
+ *
+ * It's a plain singleton provider - toggled from inside the running app
+ * (an admin endpoint, a CLI command, a message from an ops queue, ...)
+ * rather than by redeploying with a different config value.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private readonly logger = new Logger(MaintenanceModeService.name);
+  private enabled = false;
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+
+  enable(): void {
+    this.enabled = true;
+    this.logger.warn('Maintenance mode ENABLED - marked handlers will now reject calls');
+  }
+
+  disable(): void {
+    this.enabled = false;
+    this.logger.log('Maintenance mode DISABLED - marked handlers resumed normal operation');
+  }
+}
