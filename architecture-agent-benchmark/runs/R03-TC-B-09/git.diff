+import { UseGuards } from '@nestjs/common';
+import { SubscribeMessage, WebSocketGateway } from '@nestjs/websockets';
+import { AffectedByMaintenance } from '../maintenance/affected-by-maintenance.decorator.js';
+import { MaintenanceModeGuard } from '../maintenance/maintenance-mode.guard.js';
+
+@UseGuards(MaintenanceModeGuard)
+@WebSocketGateway()
+export class EventsGateway {
+  @SubscribeMessage('ping')
+  onPing(): { event: string; data: string } {
+    // Unmarked - keeps working normally during maintenance.
+    return { event: 'pong', data: 'ok' };
+  }
+
+  @AffectedByMaintenance()
+  @SubscribeMessage('reindex')
+  onReindex(): { event: string; data: unknown } {
+    // Same underlying migration as MigrationController - rejected while
+    // maintenance mode is on, using the exact same decorator.
+    return { event: 'reindex', data: { started: true } };
+  }
+}
