+import { Controller, Get, Post } from '@nestjs/common';
+import { AffectedByMaintenance } from '../maintenance/affected-by-maintenance.decorator.js';
+
+@Controller()
+export class AppController {
+  @Get('health')
+  health() {
+    // Unmarked - always available, maintenance mode or not.
+    return { status: 'ok' };
+  }
+
+  @AffectedByMaintenance()
+  @Post('users/reindex')
+  reindexUsers() {
+    // Depends on the in-flight data migration; rejected while maintenance
+    // mode is on.
+    return { reindexed: true };
+  }
+}
