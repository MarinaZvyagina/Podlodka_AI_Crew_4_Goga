+import { Controller, Get, Post } from '@nestjs/common';
+import { AffectedByMaintenance } from '../maintenance/affected-by-maintenance.decorator.js';
+
+/**
+ * Every handler in this controller depends on the same in-flight migration,
+ * so the whole class is marked rather than repeating the decorator on each
+ * method.
+ */
+@AffectedByMaintenance()
+@Controller('migration')
+export class MigrationController {
+  @Get('status')
+  status() {
+    return { migrating: true };
+  }
+
+  @Post('retry')
+  retry() {
+    return { retried: true };
+  }
+}
