+import { Controller, HttpCode, Post } from '@nestjs/common';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Internal control surface for maintenance mode. In a real app this would
+ * sit behind an admin-only auth guard; omitted here to keep the sample
+ * focused on the maintenance mechanism itself.
+ */
+@Controller('internal/maintenance')
+export class MaintenanceAdminController {
+  constructor(private readonly maintenanceMode: MaintenanceModeService) {}
+
+  @Post('enable')
+  @HttpCode(200)
+  enable() {
+    this.maintenanceMode.enable();
+    return { maintenanceMode: true };
+  }
+
+  @Post('disable')
+  @HttpCode(200)
+  disable() {
+    this.maintenanceMode.disable();
+    return { maintenanceMode: false };
+  }
+}
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.spec.ts b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.spec.ts
new file mode 100644
index 0000000..7effc76
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.spec.ts
@@ -0,0 +1,134 @@
+import { ServiceUnavailableException, type ExecutionContext } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { AffectedByMaintenance } from './affected-by-maintenance.decorator.js';
+import { MaintenanceModeGuard } from './maintenance-mode.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+// Plain classes standing in for a real controller/gateway. No Nest module,
+// no HTTP server, no socket - just objects with decorated methods so the
+// guard has real Reflect metadata to read.
+class PartiallyMarkedController {
+  @AffectedByMaintenance()
+  affectedHandler() {}
+
+  normalHandler() {}
+}
+
+@AffectedByMaintenance()
+class FullyMarkedController {
+  anyHandler() {}
+}
+
+class GatewayLike {
+  @AffectedByMaintenance()
+  onReindex() {}
+
+  onPing() {}
+}
+
+/** Minimal hand-built `ExecutionContext` - only what the guard reads. */
+function createContext(options: {
+  target: object;
+  handlerName: string;
+  type?: 'http' | 'ws';
+}): ExecutionContext {
+  const handler = (options.target as Record<string, () => void>)[
+    options.handlerName
+  ];
+  return {
+    getType: () => options.type ?? 'http',
+    getHandler: () => handler,
+    getClass: () => options.target.constructor,
+  } as ExecutionContext;
+}
+
+describe('MaintenanceModeGuard', () => {
+  let reflector: Reflector;
+  let maintenanceMode: MaintenanceModeService;
+  let guard: MaintenanceModeGuard;
+
+  beforeEach(() => {
+    reflector = new Reflector();
+    maintenanceMode = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(reflector, maintenanceMode);
+  });
+
+  it('lets a marked handler through while maintenance mode is off', () => {
+    const context = createContext({
+      target: new PartiallyMarkedController(),
+      handlerName: 'affectedHandler',
+    });
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks a marked handler once maintenance mode is switched on', () => {
+    maintenanceMode.enable();
+    const context = createContext({
+      target: new PartiallyMarkedController(),
+      handlerName: 'affectedHandler',
+    });
+
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('leaves an unmarked handler on the same controller unaffected', () => {
+    maintenanceMode.enable();
+    const context = createContext({
+      target: new PartiallyMarkedController(),
+      handlerName: 'normalHandler',
+    });
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks every handler when the whole controller is marked', () => {
+    maintenanceMode.enable();
+    const context = createContext({
+      target: new FullyMarkedController(),
+      handlerName: 'anyHandler',
+    });
+
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('resumes normal operation once maintenance mode is switched back off', () => {
+    maintenanceMode.enable();
+    const context = createContext({
+      target: new PartiallyMarkedController(),
+      handlerName: 'affectedHandler',
+    });
+    expect(() => guard.canActivate(context)).toThrow();
+
+    maintenanceMode.disable();
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks a marked WebSocket message handler with a WsException, not an HTTP one', () => {
+    maintenanceMode.enable();
+    const context = createContext({
+      type: 'ws',
+      target: new GatewayLike(),
+      handlerName: 'onReindex',
+    });
+
+    expect(() => guard.canActivate(context)).toThrow(WsException);
+  });
+
+  it('leaves an unmarked WebSocket message handler unaffected', () => {
+    maintenanceMode.enable();
+    const context = createContext({
+      type: 'ws',
+      target: new GatewayLike(),
+      handlerName: 'onPing',
+    });
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+});
