+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../../src/app.module.js';
+
+describe('E2E Maintenance Mode Sample', () => {
+  let app: INestApplication;
+
+  beforeAll(async () => {
+    const modRef = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = modRef.createNestApplication();
+    await app.init();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('serves the marked endpoint normally by default', async () => {
+    await request(app.getHttpServer()).post('/users/reindex').expect(201);
+  });
+
+  it('leaves unmarked endpoints untouched even while marked ones are blocked', async () => {
+    await request(app.getHttpServer())
+      .post('/internal/maintenance/enable')
+      .expect(200);
+
+    await request(app.getHttpServer()).post('/users/reindex').expect(503);
+    await request(app.getHttpServer()).get('/health').expect(200);
+
+    await request(app.getHttpServer())
+      .post('/internal/maintenance/disable')
+      .expect(200);
+  });
+
+  it('blocks every handler on a class-level marked controller, then recovers', async () => {
+    await request(app.getHttpServer())
+      .post('/internal/maintenance/enable')
+      .expect(200);
+
+    await request(app.getHttpServer()).get('/migration/status').expect(503);
+    await request(app.getHttpServer()).post('/migration/retry').expect(503);
+
+    await request(app.getHttpServer())
+      .post('/internal/maintenance/disable')
+      .expect(200);
+
+    await request(app.getHttpServer()).get('/migration/status').expect(200);
+  });
+});
