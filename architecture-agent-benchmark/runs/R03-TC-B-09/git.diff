@@ -0,0 +1,86 @@
+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { io, type Socket } from 'socket.io-client';
+import { AppModule } from '../../src/app.module.js';
+
+describe('EventsGateway (e2e)', () => {
+  let app: INestApplication;
+  let url: string;
+
+  beforeAll(async () => {
+    const moduleRef = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = moduleRef.createNestApplication();
+    await app.listen(0);
+    url = await app.getUrl();
+  }, 30000);
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  function connect(): Promise<Socket> {
+    return new Promise((resolve, reject) => {
+      const socket = io(url, { transports: ['websocket'] });
+      socket.on('connect', () => resolve(socket));
+      socket.on('connect_error', reject);
+    });
+  }
+
+  /** Sends `event`, resolving with whichever of `expectResponseEvents` arrives first. */
+  function send(
+    socket: Socket,
+    event: string,
+    ...expectResponseEvents: string[]
+  ): Promise<{ event: string; data: unknown }> {
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => {
+        reject(new Error(`Timeout waiting for a response to "${event}"`));
+      }, 5000);
+
+      for (const responseEvent of expectResponseEvents) {
+        socket.once(responseEvent, data => {
+          clearTimeout(timer);
+          resolve({ event: responseEvent, data });
+        });
+      }
+      socket.emit(event, {});
+    });
+  }
+
+  it('handles the marked message normally by default', async () => {
+    const socket = await connect();
+
+    const response = await send(socket, 'reindex', 'reindex', 'exception');
+    expect(response).toEqual({ event: 'reindex', data: { started: true } });
+
+    socket.close();
+  });
+
+  it('rejects the marked message while unmarked ones keep working', async () => {
+    await request(app.getHttpServer())
+      .post('/internal/maintenance/enable')
+      .expect(200);
+
+    const socket = await connect();
+
+    const pong = await send(socket, 'ping', 'pong', 'exception');
+    expect(pong).toEqual({ event: 'pong', data: 'ok' });
+
+    const rejected = await send(socket, 'reindex', 'reindex', 'exception');
+    expect(rejected.event).toBe('exception');
+    expect(rejected.data).toMatchObject({ status: 'error' });
+
+    await request(app.getHttpServer())
+      .post('/internal/maintenance/disable')
+      .expect(200);
+
+    const response = await send(socket, 'reindex', 'reindex', 'exception');
+    expect(response).toEqual({ event: 'reindex', data: { started: true } });
+
+    socket.close();
+  });
+});
