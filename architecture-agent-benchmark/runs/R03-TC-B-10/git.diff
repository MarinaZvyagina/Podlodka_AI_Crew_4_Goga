+import { Controller, Get, Post } from '@nestjs/common';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Lets an operator flip maintenance mode on/off from inside the running
+ * application (e.g. behind an internal/admin-only route), instead of
+ * requiring a redeploy.
+ */
+@Controller('maintenance')
+export class MaintenanceModeController {
+  constructor(private readonly maintenanceMode: MaintenanceModeService) {}
+
+  @Get()
+  status() {
+    return { enabled: this.maintenanceMode.isEnabled() };
+  }
+
+  @Post('enable')
+  enable() {
+    this.maintenanceMode.enable();
+    return { enabled: true };
+  }
+
+  @Post('disable')
+  disable() {
+    this.maintenanceMode.disable();
+    return { enabled: false };
+  }
+}
diff --git a/integration/maintenance-mode/src/maintenance-mode.guard.spec.ts b/integration/maintenance-mode/src/maintenance-mode.guard.spec.ts
new file mode 100644
index 0000000..8313100
--- /dev/null
+++ b/integration/maintenance-mode/src/maintenance-mode.guard.spec.ts
@@ -0,0 +1,131 @@
+import { ExecutionContext, ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { Maintenance } from './maintenance.decorator.js';
+import { MaintenanceModeGuard } from './maintenance-mode.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * A minimal stand-in for `ExecutionContext`: the guard only ever calls
+ * `getHandler`/`getClass`/`getType`, so nothing here needs a real HTTP
+ * request or an open socket.
+ */
+function createExecutionContext(options: {
+  handler: Function;
+  cls: Function;
+  type?: 'http' | 'ws';
+}): ExecutionContext {
+  return {
+    getHandler: () => options.handler,
+    getClass: () => options.cls,
+    getType: () => options.type ?? 'http',
+  } as ExecutionContext;
+}
+
+class PlainController {
+  handler() {}
+}
+
+class HandlerMarkedController {
+  @Maintenance()
+  handler() {}
+
+  unmarkedHandler() {}
+}
+
+@Maintenance()
+class ClassMarkedController {
+  handler() {}
+}
+
+describe('MaintenanceModeGuard', () => {
+  let maintenanceMode: MaintenanceModeService;
+  let guard: MaintenanceModeGuard;
+
+  beforeEach(() => {
+    maintenanceMode = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(new Reflector(), maintenanceMode);
+  });
+
+  it('allows an unmarked handler through, regardless of maintenance mode', () => {
+    const context = createExecutionContext({
+      handler: PlainController.prototype.handler,
+      cls: PlainController,
+    });
+
+    expect(guard.canActivate(context)).toBe(true);
+
+    maintenanceMode.enable();
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('allows a marked handler through while maintenance mode is off', () => {
+    const context = createExecutionContext({
+      handler: HandlerMarkedController.prototype.handler,
+      cls: HandlerMarkedController,
+    });
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks a method-marked handler once maintenance mode is on', () => {
+    maintenanceMode.enable();
+    const context = createExecutionContext({
+      handler: HandlerMarkedController.prototype.handler,
+      cls: HandlerMarkedController,
+    });
+
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('leaves other handlers on the same controller unaffected', () => {
+    maintenanceMode.enable();
+    const context = createExecutionContext({
+      handler: HandlerMarkedController.prototype.unmarkedHandler,
+      cls: HandlerMarkedController,
+    });
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks every handler of a class-marked controller once maintenance mode is on', () => {
+    maintenanceMode.enable();
+    const context = createExecutionContext({
+      handler: ClassMarkedController.prototype.handler,
+      cls: ClassMarkedController,
+    });
+
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('rejects a marked WebSocket message handler with a WsException, not an HTTP exception', () => {
+    maintenanceMode.enable();
+    const context = createExecutionContext({
+      handler: HandlerMarkedController.prototype.handler,
+      cls: HandlerMarkedController,
+      type: 'ws',
+    });
+
+    expect(() => guard.canActivate(context)).toThrow(WsException);
+    expect(() => guard.canActivate(context)).not.toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('resumes normal operation for the same handler once maintenance mode is switched off', () => {
+    const context = createExecutionContext({
+      handler: HandlerMarkedController.prototype.handler,
+      cls: HandlerMarkedController,
+    });
+
+    maintenanceMode.enable();
+    expect(() => guard.canActivate(context)).toThrow();
+
+    maintenanceMode.disable();
+    expect(guard.canActivate(context)).toBe(true);
+  });
+});
diff --git a/integration/maintenance-mode/src/maintenance-mode.guard.ts b/integration/maintenance-mode/src/maintenance-mode.guard.ts
new file mode 100644
index 0000000..fd65e5b
--- /dev/null
+++ b/integration/maintenance-mode/src/maintenance-mode.guard.ts
@@ -0,0 +1,45 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { Maintenance } from './maintenance.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Rejects calls to any handler marked with `@Maintenance()` while maintenance
+ * mode is on, and lets every unmarked handler through unaffected. Because it
+ * only relies on `ExecutionContext`/`Reflector`, the same guard covers HTTP
+ * route handlers and WebSocket message handlers without any transport-specific
+ * branching in application code.
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceMode: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    if (!this.maintenanceMode.isEnabled()) {
+      return true;
+    }
+
+    const isAffected = this.reflector.getAllAndOverride(Maintenance, [
+      context.getHandler(),
+      context.getClass(),
+    ]);
+    if (!isAffected) {
+      return true;
+    }
+
+    const message = 'Service temporarily unavailable for maintenance';
+    if (context.getType() === 'ws') {
+      throw new WsException(message);
+    }
+    throw new ServiceUnavailableException(message);
+  }
+}
