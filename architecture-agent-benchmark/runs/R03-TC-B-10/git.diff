+
+/**
+ * Demonstrates marking an entire controller: every handler here reads from
+ * the table being migrated, so all of them are blocked during maintenance.
+ */
+@Controller('reports')
+@Maintenance()
+export class ReportsController {
+  @Get()
+  findAll() {
+    return ['q1-report', 'q2-report'];
+  }
+
+  @Get('summary')
+  summary() {
+    return { total: 2 };
+  }
+}
