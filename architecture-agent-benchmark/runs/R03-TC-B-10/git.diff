+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../src/app.module.js';
+
+describe('Maintenance mode (e2e)', () => {
+  let app: INestApplication;
+  let server;
+
+  beforeEach(async () => {
+    const module = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = module.createNestApplication();
+    server = app.getHttpServer();
+    await app.init();
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  it('serves every endpoint normally while maintenance mode is off', async () => {
+    await request(server).get('/cats').expect(200);
+    await request(server).post('/cats/migrate-breeds').expect(201);
+    await request(server).get('/reports').expect(200);
+  });
+
+  it('blocks only the marked endpoints once maintenance mode is switched on, leaving the rest untouched', async () => {
+    await request(server).post('/maintenance/enable').expect(201);
+
+    await request(server).get('/cats').expect(200);
+    await request(server).post('/cats/migrate-breeds').expect(503);
+    await request(server).get('/reports').expect(503);
+    await request(server).get('/reports/summary').expect(503);
+  });
+
+  it('resumes normal operation for the marked endpoints once maintenance mode is switched off', async () => {
+    await request(server).post('/maintenance/enable').expect(201);
+    await request(server).post('/cats/migrate-breeds').expect(503);
+
+    await request(server).post('/maintenance/disable').expect(201);
+    await request(server).post('/cats/migrate-breeds').expect(201);
+  });
+});
