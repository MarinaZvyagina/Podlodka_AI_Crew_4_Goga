+import { Controller, Get, Post } from '@nestjs/common';
+import { Maintenance } from '../maintenance.decorator.js';
+
+/**
+ * Demonstrates marking a single handler: `findAll` keeps working during
+ * maintenance, `migrateBreeds` depends on the migration and is blocked.
+ */
+@Controller('cats')
+export class CatsController {
+  @Get()
+  findAll() {
+    return ['felix', 'garfield'];
+  }
+
+  @Post('migrate-breeds')
+  @Maintenance()
+  migrateBreeds() {
+    return { migrated: true };
+  }
+}
