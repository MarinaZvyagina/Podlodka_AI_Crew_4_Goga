+++ b/integration/maintenance-mode/src/maintenance.decorator.ts
@@ -0,0 +1,13 @@
+import { Reflector } from '@nestjs/core';
+
+/**
+ * Marks a route handler, a WebSocket message handler, or an entire
+ * controller/gateway as affected by maintenance mode. `MaintenanceModeGuard`
+ * rejects calls to anything carrying this metadata while maintenance mode is
+ * on, before the handler's own logic runs. Applying it to a class marks every
+ * handler in that class; applying it to a method overrides the class-level
+ * setting for that one handler.
+ */
+export const Maintenance = Reflector.createDecorator<void, boolean>({
+  transform: () => true,
+});
