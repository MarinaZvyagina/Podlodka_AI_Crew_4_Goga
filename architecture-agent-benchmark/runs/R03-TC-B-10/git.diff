+import { SubscribeMessage, WebSocketGateway } from '@nestjs/websockets';
+import { Maintenance } from '../maintenance.decorator.js';
+
+/**
+ * Demonstrates the same `@Maintenance()` marker applied to a WebSocket
+ * message handler instead of an HTTP route: `ping` keeps working, while
+ * `liveReportUpdates` streams data derived from the table being migrated.
+ */
+@WebSocketGateway()
+export class EventsGateway {
+  @SubscribeMessage('ping')
+  onPing() {
+    return { event: 'pong', data: {} };
+  }
+
+  @SubscribeMessage('liveReportUpdates')
+  @Maintenance()
+  onLiveReportUpdates() {
+    return { event: 'liveReportUpdates', data: {} };
+  }
+}
