+import { Injectable, Logger } from '@nestjs/common';
+
+/**
+ * Holds the maintenance mode on/off flag in memory. Toggling it (e.g. from an
+ * admin endpoint) takes effect immediately for every subsequent request or
+ * WebSocket message, with no redeploy required.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private readonly logger = new Logger(MaintenanceModeService.name);
+  private enabled = false;
+
+  enable(): void {
+    this.enabled = true;
+    this.logger.warn('Maintenance mode enabled');
+  }
+
+  disable(): void {
+    this.enabled = false;
+    this.logger.log('Maintenance mode disabled');
+  }
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+}
