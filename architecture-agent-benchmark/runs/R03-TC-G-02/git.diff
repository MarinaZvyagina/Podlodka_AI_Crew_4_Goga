@@ -0,0 +1,15 @@
+import { SetMetadata } from '@nestjs/common';
+
+export const MAINTENANCE_KEY = 'maintenance';
+
+/**
+ * Marks a route handler, a WebSocket message handler, or an entire
+ * controller/gateway as affected by maintenance mode. Apply it at the
+ * handler level to protect a single endpoint, or at the class level to
+ * protect every handler in that controller/gateway.
+ *
+ * Marking alone has no effect - `MaintenanceModeGuard` is what turns
+ * marked handlers away while `MaintenanceModeService` reports the mode
+ * as enabled.
+ */
+export const Maintenance = () => SetMetadata(MAINTENANCE_KEY, true);
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts
new file mode 100644
index 0000000..542fde9
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts
@@ -0,0 +1,114 @@
+import { ExecutionContext } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { Maintenance } from './maintenance.decorator.js';
+import { MaintenanceModeGuard } from './maintenance.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+class MigrationController {
+  @Maintenance()
+  affectedHandler() {}
+
+  safeHandler() {}
+}
+
+@Maintenance()
+class LegacyReportsController {
+  anyHandler() {}
+}
+
+function createExecutionContext(
+  handler: Function,
+  controller: Function,
+  type: 'http' | 'ws' = 'http',
+): ExecutionContext {
+  return {
+    getHandler: () => handler,
+    getClass: () => controller,
+    getType: () => type,
+  } as unknown as ExecutionContext;
+}
+
+describe('MaintenanceModeGuard', () => {
+  let guard: MaintenanceModeGuard;
+  let maintenanceMode: MaintenanceModeService;
+
+  beforeEach(() => {
+    maintenanceMode = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(new Reflector(), maintenanceMode);
+  });
+
+  describe('when maintenance mode is off', () => {
+    it('lets a marked handler through', () => {
+      const context = createExecutionContext(
+        MigrationController.prototype.affectedHandler,
+        MigrationController,
+      );
+
+      expect(guard.canActivate(context)).toBe(true);
+    });
+
+    it('lets an unmarked handler through', () => {
+      const context = createExecutionContext(
+        MigrationController.prototype.safeHandler,
+        MigrationController,
+      );
+
+      expect(guard.canActivate(context)).toBe(true);
+    });
+  });
+
+  describe('when maintenance mode is on', () => {
+    beforeEach(() => {
+      maintenanceMode.enable();
+    });
+
+    it('blocks a handler marked with @Maintenance()', () => {
+      const context = createExecutionContext(
+        MigrationController.prototype.affectedHandler,
+        MigrationController,
+      );
+
+      expect(() => guard.canActivate(context)).toThrow();
+    });
+
+    it('leaves an unmarked handler on the same controller untouched', () => {
+      const context = createExecutionContext(
+        MigrationController.prototype.safeHandler,
+        MigrationController,
+      );
+
+      expect(guard.canActivate(context)).toBe(true);
+    });
+
+    it('blocks every handler on a controller marked at the class level', () => {
+      const context = createExecutionContext(
+        LegacyReportsController.prototype.anyHandler,
+        LegacyReportsController,
+      );
+
+      expect(() => guard.canActivate(context)).toThrow();
+    });
+
+    it('throws a WsException for a marked WebSocket message handler', () => {
+      const context = createExecutionContext(
+        MigrationController.prototype.affectedHandler,
+        MigrationController,
+        'ws',
+      );
+
+      expect(() => guard.canActivate(context)).toThrow(WsException);
+    });
+
+    it('turns marked handlers back on once maintenance mode is disabled', () => {
+      maintenanceMode.disable();
+
+      const context = createExecutionContext(
+        MigrationController.prototype.affectedHandler,
+        MigrationController,
+      );
+
+      expect(guard.canActivate(context)).toBe(true);
+    });
+  });
+});
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
new file mode 100644
index 0000000..60b7e3c
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
@@ -0,0 +1,48 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MAINTENANCE_KEY } from './maintenance.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+export const MAINTENANCE_MODE_MESSAGE =
+  'This endpoint is temporarily unavailable for maintenance. Please try again later.';
+
+/**
+ * Rejects calls to any handler (HTTP or WebSocket) marked with
+ * `@Maintenance()` while `MaintenanceModeService` reports maintenance
+ * mode as enabled. Unmarked handlers are always let through, and marked
+ * handlers behave normally whenever maintenance mode is off.
+ *
+ * Register this guard globally (see `MaintenanceModule`) so it inspects
+ * every request/message, rather than applying `@UseGuards` to each
+ * protected controller/gateway individually.
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceMode: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isMarkedForMaintenance = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_KEY,
+      [context.getHandler(), context.getClass()],
+    );
+
+    if (!isMarkedForMaintenance || !this.maintenanceMode.isEnabled()) {
+      return true;
+    }
+
+    if (context.getType() === 'ws') {
+      throw new WsException(MAINTENANCE_MODE_MESSAGE);
+    }
+
+    throw new ServiceUnavailableException(MAINTENANCE_MODE_MESSAGE);
+  }
+}
