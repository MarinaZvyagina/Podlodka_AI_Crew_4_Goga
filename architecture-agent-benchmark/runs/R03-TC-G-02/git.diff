+import { Controller, Get } from '@nestjs/common';
+import { Maintenance } from '../maintenance/maintenance.decorator.js';
+
+@Controller('migration')
+export class MigrationController {
+  @Get('safe')
+  safe() {
+    return { status: 'ok' };
+  }
+
+  @Get('affected')
+  @Maintenance()
+  affected() {
+    return { status: 'ok' };
+  }
+}
+
+/**
+ * Every handler here depends on the table being migrated, so the whole
+ * controller is marked at once instead of annotating each method.
+ */
+@Controller('legacy-reports')
+@Maintenance()
+export class LegacyReportsController {
+  @Get()
+  list() {
+    return { reports: [] };
+  }
+
+  @Get('summary')
+  summary() {
+    return { total: 0 };
+  }
+}
