+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import { WsAdapter } from '@nestjs/platform-ws';
+import request from 'supertest';
+import { AppModule } from '../../src/app.module.js';
+import { MaintenanceModeService } from '../../src/maintenance/maintenance-mode.service.js';
+
+describe('Maintenance mode (e2e)', () => {
+  let app: INestApplication;
+  let maintenanceMode: MaintenanceModeService;
+
+  beforeAll(async () => {
+    const moduleRef = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = moduleRef.createNestApplication();
+    app.useWebSocketAdapter(new WsAdapter(app));
+    await app.init();
+
+    maintenanceMode = app.get(MaintenanceModeService);
+  });
+
+  afterEach(() => {
+    maintenanceMode.disable();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('serves the marked endpoint normally while maintenance mode is off', () => {
+    return request(app.getHttpServer()).get('/migration/affected').expect(200);
+  });
+
+  it('rejects the marked endpoint once maintenance mode is toggled on via the admin route', async () => {
+    await request(app.getHttpServer()).post('/maintenance/enable').expect(201);
+
+    await request(app.getHttpServer()).get('/migration/affected').expect(503);
+
+    return request(app.getHttpServer()).get('/migration/safe').expect(200);
+  });
+
+  it('protects every handler on a class-level @Maintenance() controller', async () => {
+    await request(app.getHttpServer()).post('/maintenance/enable').expect(201);
+
+    return request(app.getHttpServer()).get('/legacy-reports').expect(503);
+  });
+
+  it('serves the marked endpoint again after maintenance mode is disabled', async () => {
+    await request(app.getHttpServer()).post('/maintenance/enable').expect(201);
+    await request(app.getHttpServer()).post('/maintenance/disable').expect(201);
+
+    return request(app.getHttpServer()).get('/migration/affected').expect(200);
+  });
+});
