+import { Controller, Post } from '@nestjs/common';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Lets an operator flip maintenance mode on/off from within the running
+ * application (e.g. curl'd by an admin, or wired up behind an internal-only
+ * auth guard) instead of redeploying. Deliberately left off `@Maintenance()`
+ * so it keeps working while maintenance mode is on - otherwise there would
+ * be no way to turn it back off.
+ */
+@Controller('maintenance')
+export class AdminController {
+  constructor(private readonly maintenanceMode: MaintenanceModeService) {}
+
+  @Post('enable')
+  enable() {
+    this.maintenanceMode.enable();
+    return { maintenanceMode: this.maintenanceMode.isEnabled() };
+  }
+
+  @Post('disable')
+  disable() {
+    this.maintenanceMode.disable();
+    return { maintenanceMode: this.maintenanceMode.isEnabled() };
+  }
+}
