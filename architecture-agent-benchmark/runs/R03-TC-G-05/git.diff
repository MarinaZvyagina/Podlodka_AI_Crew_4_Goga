+import { ExecutionContext, ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { AffectedByMaintenance } from './affected-by-maintenance.decorator.js';
+import { MaintenanceModeGuard } from './maintenance-mode.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+class UnaffectedController {
+  ping() {}
+}
+
+class AffectedController {
+  @AffectedByMaintenance()
+  migrateData() {}
+
+  ping() {}
+}
+
+@AffectedByMaintenance()
+class FullyAffectedGateway {
+  broadcast() {}
+}
+
+function createContext(
+  handler: Function,
+  klass: Function,
+  type: 'http' | 'ws' = 'http',
+): ExecutionContext {
+  return {
+    getHandler: () => handler,
+    getClass: () => klass,
+    getType: () => type,
+  } as unknown as ExecutionContext;
+}
+
+describe('MaintenanceModeGuard', () => {
+  let guard: MaintenanceModeGuard;
+  let maintenanceModeService: MaintenanceModeService;
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(new Reflector(), maintenanceModeService);
+  });
+
+  it('allows unmarked handlers even while maintenance mode is on', () => {
+    maintenanceModeService.enable();
+    const context = createContext(
+      UnaffectedController.prototype.ping,
+      UnaffectedController,
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('allows a marked handler while maintenance mode is off', () => {
+    const context = createContext(
+      AffectedController.prototype.migrateData,
+      AffectedController,
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks a marked HTTP handler while maintenance mode is on', () => {
+    maintenanceModeService.enable();
+    const context = createContext(
+      AffectedController.prototype.migrateData,
+      AffectedController,
+    );
+
+    expect(() => guard.canActivate(context)).toThrow(ServiceUnavailableException);
+  });
+
+  it('leaves other handlers on the same controller unaffected', () => {
+    maintenanceModeService.enable();
+    const context = createContext(
+      AffectedController.prototype.ping,
+      AffectedController,
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks every handler on a controller/gateway marked at the class level', () => {
+    maintenanceModeService.enable();
+    const context = createContext(
+      FullyAffectedGateway.prototype.broadcast,
+      FullyAffectedGateway,
+    );
+
+    expect(() => guard.canActivate(context)).toThrow(ServiceUnavailableException);
+  });
+
+  it('blocks a marked WebSocket handler with a WsException while maintenance mode is on', () => {
+    maintenanceModeService.enable();
+    const context = createContext(
+      AffectedController.prototype.migrateData,
+      AffectedController,
+      'ws',
+    );
+
+    expect(() => guard.canActivate(context)).toThrow(WsException);
+  });
+
+  it('restores normal behaviour once maintenance mode is switched back off', () => {
+    maintenanceModeService.enable();
+    maintenanceModeService.disable();
+    const context = createContext(
+      AffectedController.prototype.migrateData,
+      AffectedController,
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+});
