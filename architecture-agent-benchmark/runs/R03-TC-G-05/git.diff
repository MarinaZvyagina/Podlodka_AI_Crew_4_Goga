+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the application's maintenance-mode flag in memory so it can be
+ * toggled at runtime (e.g. from an admin endpoint) without a redeploy.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+
+  enable(): void {
+    this.enabled = true;
+  }
+
+  disable(): void {
+    this.enabled = false;
+  }
+}
