+import { Reflector } from '@nestjs/core';
+
+/**
+ * Marks a route handler, WebSocket message handler, or an entire
+ * controller/gateway as affected by maintenance mode. `MaintenanceModeGuard`
+ * rejects calls to anything marked with this decorator while maintenance
+ * mode is enabled, and lets them through otherwise.
+ */
+export const AffectedByMaintenance = Reflector.createDecorator<boolean>();
