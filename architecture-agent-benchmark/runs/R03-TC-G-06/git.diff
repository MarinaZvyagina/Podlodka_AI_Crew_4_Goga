+import { Controller, Get, Post } from '@nestjs/common';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * In-app control surface for maintenance mode. In a real app this would
+ * typically be locked down to admins/operators, and could just as well be
+ * triggered by a CLI command, a signal handler, or a feature-flag callback
+ * instead of an HTTP endpoint - the point is that it flips a flag inside
+ * the running process rather than requiring a redeploy.
+ */
+@Controller('maintenance')
+export class MaintenanceModeController {
+  constructor(
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  @Get()
+  status() {
+    return { enabled: this.maintenanceModeService.isEnabled() };
+  }
+
+  @Post('enable')
+  enable() {
+    this.maintenanceModeService.enable();
+    return { enabled: true };
+  }
+
+  @Post('disable')
+  disable() {
+    this.maintenanceModeService.disable();
+    return { enabled: false };
+  }
+}
