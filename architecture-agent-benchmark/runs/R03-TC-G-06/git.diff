@@ -0,0 +1,48 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MAINTENANCE_MODE_KEY } from './maintenance-mode.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+const MAINTENANCE_MESSAGE =
+  'This operation is temporarily unavailable due to scheduled maintenance. Please try again later.';
+
+/**
+ * Single guard that enforces maintenance mode for both HTTP route handlers
+ * and WebSocket message handlers. It only ever blocks handlers (or
+ * controllers/gateways) explicitly marked with @AffectedByMaintenanceMode();
+ * everything else is let through untouched, even while maintenance mode is
+ * enabled.
+ *
+ * Register it as a global guard (see MaintenanceModeModule) so marking a
+ * handler with the decorator is the only thing a developer has to do.
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isAffected = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_MODE_KEY,
+      [context.getHandler(), context.getClass()],
+    );
+
+    if (!isAffected || !this.maintenanceModeService.isEnabled()) {
+      return true;
+    }
+
+    if (context.getType() === 'ws') {
+      throw new WsException(MAINTENANCE_MESSAGE);
+    }
+
+    throw new ServiceUnavailableException(MAINTENANCE_MESSAGE);
+  }
+}
