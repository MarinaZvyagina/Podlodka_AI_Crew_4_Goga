--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.decorator.ts
@@ -0,0 +1,14 @@
+import { SetMetadata } from '@nestjs/common';
+
+export const MAINTENANCE_MODE_KEY = 'affectedByMaintenanceMode';
+
+/**
+ * Marks an HTTP route handler, an entire HTTP controller, a WebSocket
+ * gateway, or an individual @SubscribeMessage() handler as affected by
+ * maintenance mode. While maintenance mode is enabled, calls to anything
+ * carrying this decorator are rejected by MaintenanceModeGuard before the
+ * decorated method body runs. Everything without this decorator keeps
+ * working normally regardless of maintenance mode.
+ */
+export const AffectedByMaintenanceMode = () =>
+  SetMetadata(MAINTENANCE_MODE_KEY, true);
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.spec.ts b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.spec.ts
new file mode 100644
