+import { Controller, Get } from '@nestjs/common';
+import { AffectedByMaintenanceMode } from '../maintenance/maintenance-mode.decorator.js';
+
+// Every route on this controller reads from the table being migrated, so
+// the whole controller is marked at once instead of decorating each route.
+@AffectedByMaintenanceMode()
+@Controller('legacy-search')
+export class LegacySearchController {
+  @Get()
+  search() {
+    return { results: [] };
+  }
+}
