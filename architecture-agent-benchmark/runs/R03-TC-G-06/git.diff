@@ -0,0 +1,100 @@
+import { ExecutionContext, ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MAINTENANCE_MODE_KEY } from './maintenance-mode.decorator.js';
+import { MaintenanceModeGuard } from './maintenance-mode.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Builds a bare-bones ExecutionContext without booting Nest, opening a
+ * socket, or hitting a real route. `handlerMetadata`/`classMetadata`
+ * stand in for what @AffectedByMaintenanceMode() would have attached via
+ * Reflect metadata on a real method/class.
+ */
+function createContext(options: {
+  type: 'http' | 'ws';
+  handlerMetadata?: boolean;
+  classMetadata?: boolean;
+}): ExecutionContext {
+  const handler = () => undefined;
+  if (options.handlerMetadata !== undefined) {
+    Reflect.defineMetadata(MAINTENANCE_MODE_KEY, options.handlerMetadata, handler);
+  }
+
+  class TargetClass {}
+  if (options.classMetadata !== undefined) {
+    Reflect.defineMetadata(MAINTENANCE_MODE_KEY, options.classMetadata, TargetClass);
+  }
+
+  return {
+    getHandler: () => handler,
+    getClass: () => TargetClass,
+    getType: () => options.type,
+    getArgs: () => [],
+    getArgByIndex: () => undefined,
+    switchToHttp: () => ({}) as any,
+    switchToWs: () => ({}) as any,
+    switchToRpc: () => ({}) as any,
+  } as ExecutionContext;
+}
+
+describe('MaintenanceModeGuard', () => {
+  let guard: MaintenanceModeGuard;
+  let maintenanceModeService: MaintenanceModeService;
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(new Reflector(), maintenanceModeService);
+  });
+
+  it('lets an unmarked HTTP handler through even while maintenance mode is enabled', () => {
+    maintenanceModeService.enable();
+    const context = createContext({ type: 'http', handlerMetadata: undefined });
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('lets a marked HTTP handler through while maintenance mode is disabled', () => {
+    const context = createContext({ type: 'http', handlerMetadata: true });
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks a marked HTTP handler once maintenance mode is enabled', () => {
+    maintenanceModeService.enable();
+    const context = createContext({ type: 'http', handlerMetadata: true });
+
+    expect(() => guard.canActivate(context)).toThrow(ServiceUnavailableException);
+  });
+
+  it('stops blocking a marked HTTP handler as soon as maintenance mode is disabled again', () => {
+    maintenanceModeService.enable();
+    const context = createContext({ type: 'http', handlerMetadata: true });
+    expect(() => guard.canActivate(context)).toThrow(ServiceUnavailableException);
+
+    maintenanceModeService.disable();
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks every handler of a controller marked at the class level', () => {
+    maintenanceModeService.enable();
+    const context = createContext({ type: 'http', classMetadata: true });
+
+    expect(() => guard.canActivate(context)).toThrow(ServiceUnavailableException);
+  });
+
+  it('blocks a marked WebSocket message handler with a WsException, not an HttpException', () => {
+    maintenanceModeService.enable();
+    const context = createContext({ type: 'ws', handlerMetadata: true });
+
+    expect(() => guard.canActivate(context)).toThrow(WsException);
+  });
+
+  it('lets an unmarked WebSocket message handler through while maintenance mode is enabled', () => {
+    maintenanceModeService.enable();
+    const context = createContext({ type: 'ws', handlerMetadata: undefined });
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+});
