+import {
+  MessageBody,
+  SubscribeMessage,
+  WebSocketGateway,
+} from '@nestjs/websockets';
+import { AffectedByMaintenanceMode } from '../maintenance/maintenance-mode.decorator.js';
+
+@WebSocketGateway()
+export class EventsGateway {
+  // Cheap health check, has nothing to do with the migration - stays up.
+  @SubscribeMessage('ping')
+  ping(): string {
+    return 'pong';
+  }
+
+  // Rebuilds a search index that lives in the table under migration, so it
+  // gets the same decorator as the equivalent HTTP route would.
+  @AffectedByMaintenanceMode()
+  @SubscribeMessage('rebuildIndex')
+  rebuildIndex(@MessageBody() data: unknown) {
+    return { status: 'index rebuild started', data };
+  }
+}
