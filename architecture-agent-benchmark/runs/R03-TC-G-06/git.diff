+import { Injectable, Logger } from '@nestjs/common';
+
+/**
+ * Holds the runtime maintenance-mode flag. Toggling it (e.g. from an admin
+ * endpoint, a CLI command wired into the running process, or any other
+ * in-app trigger) takes effect immediately for every request/message that
+ * comes in afterwards - no redeploy needed.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private readonly logger = new Logger(MaintenanceModeService.name);
+  private enabled = false;
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+
+  enable(): void {
+    this.enabled = true;
+    this.logger.warn('Maintenance mode enabled');
+  }
+
+  disable(): void {
+    this.enabled = false;
+    this.logger.log('Maintenance mode disabled');
+  }
+}
