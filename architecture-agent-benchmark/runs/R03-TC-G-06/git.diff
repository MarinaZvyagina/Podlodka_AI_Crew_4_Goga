+import { Controller, Get, Post } from '@nestjs/common';
+import { AffectedByMaintenanceMode } from '../maintenance/maintenance-mode.decorator.js';
+
+@Controller('reports')
+export class ReportsController {
+  // Untouched by maintenance mode - reads from data that isn't part of
+  // the migration keep working the whole time.
+  @Get()
+  findAll() {
+    return [{ id: 1, name: 'Q1 summary' }];
+  }
+
+  // The rebuild job depends on the table currently being migrated, so it
+  // gets rejected outright while maintenance mode is on.
+  @AffectedByMaintenanceMode()
+  @Post('rebuild')
+  rebuild() {
+    return { status: 'rebuild started' };
+  }
+}
