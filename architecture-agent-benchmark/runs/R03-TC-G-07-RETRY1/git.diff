new file mode 100644
index 0000000..90665bf
--- /dev/null
+++ b/packages/core/services/maintenance-mode.service.ts
@@ -0,0 +1,28 @@
+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the application's maintenance mode state. Inject this service
+ * anywhere (e.g. an admin controller or a management endpoint) to flip
+ * maintenance mode on or off at runtime, without redeploying.
+ *
+ * `MaintenanceModeGuard` consults `isEnabled()` on every call to a handler
+ * marked with `@MaintenanceMode()` to decide whether to reject it.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  public enable(): void {
+    this.enabled = true;
+  }
+
+  public disable(): void {
+    this.enabled = false;
+  }
+
+  public isEnabled(): boolean {
+    return this.enabled;
+  }
+}
diff --git a/packages/core/test/guards/maintenance-mode.guard.spec.ts b/packages/core/test/guards/maintenance-mode.guard.spec.ts
new file mode 100644
index 0000000..65961e0
--- /dev/null
+++ b/packages/core/test/guards/maintenance-mode.guard.spec.ts
@@ -0,0 +1,75 @@
+import { MaintenanceMode, ServiceUnavailableException } from '@nestjs/common';
+import { ExecutionContextHost } from '../../helpers/execution-context-host.js';
+import { MaintenanceModeGuard } from '../../guards/maintenance-mode.guard.js';
+import { MaintenanceModeService } from '../../services/maintenance-mode.service.js';
+import { Reflector } from '../../services/reflector.service.js';
+
+describe('MaintenanceModeGuard', () => {
+  class TestController {
+    @MaintenanceMode()
+    affectedHandler() {}
+
+    unaffectedHandler() {}
+  }
+
+  let maintenanceModeService: MaintenanceModeService;
+  let guard: MaintenanceModeGuard;
+
+  const createContext = (handlerName: keyof TestController) =>
+    new ExecutionContextHost(
+      [],
+      TestController,
+      TestController.prototype[handlerName],
+    );
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(new Reflector(), maintenanceModeService);
+  });
+
+  describe('when maintenance mode is disabled', () => {
+    it('should allow a handler marked with @MaintenanceMode()', () => {
+      expect(guard.canActivate(createContext('affectedHandler'))).toBe(true);
+    });
+
+    it('should allow an unmarked handler', () => {
+      expect(guard.canActivate(createContext('unaffectedHandler'))).toBe(true);
+    });
+  });
+
+  describe('when maintenance mode is enabled', () => {
+    beforeEach(() => {
+      maintenanceModeService.enable();
+    });
+
+    it('should block a handler marked with @MaintenanceMode()', () => {
+      expect(() => guard.canActivate(createContext('affectedHandler'))).toThrow(
+        ServiceUnavailableException,
+      );
+    });
+
+    it('should still allow an unmarked handler', () => {
+      expect(guard.canActivate(createContext('unaffectedHandler'))).toBe(true);
+    });
+  });
+
+  describe('when only the controller is marked with @MaintenanceMode()', () => {
+    @MaintenanceMode()
+    class AffectedController {
+      someHandler() {}
+    }
+
+    it('should block every handler on that controller once enabled', () => {
+      maintenanceModeService.enable();
+      const context = new ExecutionContextHost(
+        [],
+        AffectedController,
+        AffectedController.prototype.someHandler,
+      );
+
+      expect(() => guard.canActivate(context)).toThrow(
+        ServiceUnavailableException,
+      );
+    });
+  });
+});
