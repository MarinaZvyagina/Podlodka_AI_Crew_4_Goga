diff --git a/packages/core/guards/maintenance-mode.guard.ts b/packages/core/guards/maintenance-mode.guard.ts
new file mode 100644
index 0000000..7b2ff03
--- /dev/null
+++ b/packages/core/guards/maintenance-mode.guard.ts
@@ -0,0 +1,44 @@
+import {
+  type CanActivate,
+  type ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { MAINTENANCE_MODE_METADATA } from '@nestjs/common/internal';
+import { MaintenanceModeService } from '../services/maintenance-mode.service.js';
+import { Reflector } from '../services/reflector.service.js';
+
+/**
+ * Rejects calls to any handler decorated with `@MaintenanceMode()` while
+ * `MaintenanceModeService` reports maintenance mode as enabled; every other
+ * handler is left untouched. Register it as a global guard so it runs for
+ * both HTTP routes and WebSocket message handlers, since both are gated
+ * through the same `CanActivate` mechanism.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    if (!this.maintenanceModeService.isEnabled()) {
+      return true;
+    }
+
+    const isAffected = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_MODE_METADATA,
+      [context.getHandler(), context.getClass()],
+    );
+    if (!isAffected) {
+      return true;
+    }
+
+    throw new ServiceUnavailableException(
+      'This endpoint is temporarily unavailable due to maintenance.',
+    );
+  }
+}
