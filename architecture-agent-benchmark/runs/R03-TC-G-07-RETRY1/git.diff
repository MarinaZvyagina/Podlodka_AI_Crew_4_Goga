@@ -0,0 +1,19 @@
+import { MAINTENANCE_MODE_METADATA } from '../../constants.js';
+import { SetMetadata } from './set-metadata.decorator.js';
+
+/**
+ * Decorator that marks a controller, an individual route handler, or a
+ * WebSocket message handler as affected by maintenance mode.
+ *
+ * When maintenance mode is enabled, calls to handlers carrying this metadata
+ * are rejected before their logic runs; handlers without it are never
+ * affected, regardless of the maintenance mode state. Applying it to a
+ * controller marks every handler in that controller.
+ *
+ * @see [Guards](https://docs.nestjs.com/guards)
+ *
+ * @publicApi
+ */
+export function MaintenanceMode(): ClassDecorator & MethodDecorator {
+  return SetMetadata(MAINTENANCE_MODE_METADATA, true);
+}
