+import { MaintenanceMode } from '../../decorators/core/maintenance-mode.decorator.js';
+import { MAINTENANCE_MODE_METADATA } from '../../constants.js';
+
+describe('@MaintenanceMode', () => {
+  describe('when applied to a method', () => {
+    class Test {
+      @MaintenanceMode()
+      affectedHandler() {}
+
+      unaffectedHandler() {}
+    }
+
+    it('should attach maintenance mode metadata to the decorated method', () => {
+      expect(
+        Reflect.getMetadata(MAINTENANCE_MODE_METADATA, Test.prototype.affectedHandler),
+      ).toBe(true);
+    });
+
+    it('should leave other methods untouched', () => {
+      expect(
+        Reflect.getMetadata(MAINTENANCE_MODE_METADATA, Test.prototype.unaffectedHandler),
+      ).toBeUndefined();
+    });
+  });
+
+  describe('when applied to a class', () => {
+    @MaintenanceMode()
+    class AffectedController {}
+
+    class UnaffectedController {}
+
+    it('should attach maintenance mode metadata to the decorated class', () => {
+      expect(
+        Reflect.getMetadata(MAINTENANCE_MODE_METADATA, AffectedController),
+      ).toBe(true);
+    });
+
+    it('should leave other classes untouched', () => {
+      expect(
+        Reflect.getMetadata(MAINTENANCE_MODE_METADATA, UnaffectedController),
+      ).toBeUndefined();
+    });
+  });
+});
