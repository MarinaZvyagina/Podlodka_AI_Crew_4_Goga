@@ -0,0 +1,19 @@
+import { Controller, Get } from '@nestjs/common';
+import { MaintenanceMode } from './maintenance-mode.decorator.js';
+
+@Controller()
+export class AppController {
+  // Depends on data touched by the migration, so it must stop serving
+  // requests while maintenance mode is on.
+  @Get('reports')
+  @MaintenanceMode()
+  getReports() {
+    return { data: 'reports' };
+  }
+
+  // Unaffected by the migration; keeps working during maintenance.
+  @Get('health')
+  getHealth() {
+    return { status: 'ok' };
+  }
+}
