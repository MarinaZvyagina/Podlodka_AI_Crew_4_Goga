+import {
+  MessageBody,
+  SubscribeMessage,
+  WebSocketGateway,
+} from '@nestjs/websockets';
+import { MaintenanceMode } from './maintenance-mode.decorator.js';
+
+@WebSocketGateway()
+export class EventsGateway {
+  // Reads from the same store the migration is rewriting; blocked during
+  // maintenance using the exact same decorator as the HTTP routes above.
+  @MaintenanceMode()
+  @SubscribeMessage('getReport')
+  getReport(@MessageBody() data: unknown) {
+    return { event: 'report', data };
+  }
+
+  @SubscribeMessage('ping')
+  ping() {
+    return { event: 'pong', data: {} };
+  }
+}
