+import type { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../src/app.module.js';
+import { MaintenanceModeService } from '../src/maintenance-mode.service.js';
+
+describe('Maintenance mode (e2e)', () => {
+  let app: INestApplication;
+  let maintenanceModeService: MaintenanceModeService;
+
+  beforeEach(async () => {
+    const moduleRef = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = moduleRef.createNestApplication();
+    maintenanceModeService = moduleRef.get(MaintenanceModeService);
+    await app.init();
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  it('serves both marked and unmarked routes normally while maintenance mode is off', async () => {
+    await request(app.getHttpServer()).get('/reports').expect(200);
+    await request(app.getHttpServer()).get('/health').expect(200);
+    await request(app.getHttpServer()).get('/migration/status').expect(200);
+  });
+
+  it('rejects a method-marked route and a class-marked controller once maintenance mode is on, while leaving unmarked routes untouched', async () => {
+    maintenanceModeService.enable();
+
+    await request(app.getHttpServer()).get('/reports').expect(503);
+    await request(app.getHttpServer()).get('/migration/status').expect(503);
+    await request(app.getHttpServer()).get('/health').expect(200);
+  });
+
+  it('can be toggled at runtime through the admin endpoint, without restarting the app', async () => {
+    await request(app.getHttpServer())
+      .post('/admin/maintenance-mode/enable')
+      .expect(201);
+    await request(app.getHttpServer()).get('/reports').expect(503);
+
+    await request(app.getHttpServer())
+      .post('/admin/maintenance-mode/disable')
+      .expect(201);
+    await request(app.getHttpServer()).get('/reports').expect(200);
+  });
+});
