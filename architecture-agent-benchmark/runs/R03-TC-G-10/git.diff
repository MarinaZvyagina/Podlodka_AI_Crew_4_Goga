+import { SetMetadata } from '@nestjs/common';
+import { MAINTENANCE_MODE_KEY } from './maintenance-mode.constants.js';
+
+/**
+ * Marks a controller/gateway, an individual HTTP route handler, or an
+ * individual WebSocket `@SubscribeMessage` handler as affected by
+ * maintenance mode. `MaintenanceModeGuard` rejects calls to anything carrying
+ * this metadata while maintenance mode is switched on, before the handler
+ * body runs; undecorated handlers are never affected.
+ */
+export const MaintenanceMode = (): ClassDecorator & MethodDecorator =>
+  SetMetadata(MAINTENANCE_MODE_KEY, true);
diff --git a/integration/maintenance-mode/src/maintenance-mode.guard.ts b/integration/maintenance-mode/src/maintenance-mode.guard.ts
new file mode 100644
index 0000000..bea6dcc
--- /dev/null
+++ b/integration/maintenance-mode/src/maintenance-mode.guard.ts
@@ -0,0 +1,46 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MAINTENANCE_MODE_KEY } from './maintenance-mode.constants.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+export const MAINTENANCE_MODE_MESSAGE =
+  'This part of the API is temporarily unavailable for maintenance.';
+
+/**
+ * Rejects calls to handlers marked with `@MaintenanceMode()` while
+ * `MaintenanceModeService` reports maintenance mode as enabled. Handlers
+ * without the metadata are always allowed through, regardless of the flag.
+ *
+ * Works unchanged for HTTP routes and WebSocket message handlers: both go
+ * through the same `CanActivate`/`ExecutionContext` pipeline, so a single
+ * guard instance covers both transports.
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isAffected = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_MODE_KEY,
+      [context.getHandler(), context.getClass()],
+    );
+
+    if (!isAffected || !this.maintenanceModeService.isEnabled()) {
+      return true;
+    }
+
+    if (context.getType() === 'http') {
+      throw new ServiceUnavailableException(MAINTENANCE_MODE_MESSAGE);
+    }
+    throw new WsException(MAINTENANCE_MODE_MESSAGE);
+  }
+}
