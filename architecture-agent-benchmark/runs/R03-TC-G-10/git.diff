+import { Global, Module } from '@nestjs/common';
+import { APP_GUARD } from '@nestjs/core';
+import { MaintenanceModeGuard } from './maintenance-mode.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Registers `MaintenanceModeGuard` as a global guard (via `APP_GUARD`), so it
+ * runs for every HTTP route and every WebSocket message handler in the
+ * application without each controller/gateway needing its own `@UseGuards`.
+ * The guard only ever blocks handlers carrying `@MaintenanceMode()`.
+ */
+@Global()
+@Module({
+  providers: [
+    MaintenanceModeService,
+    { provide: APP_GUARD, useClass: MaintenanceModeGuard },
+  ],
+  exports: [MaintenanceModeService],
+})
+export class MaintenanceModeModule {}
