+import { Controller, Get, Post } from '@nestjs/common';
+import { MaintenanceMode } from './maintenance-mode.decorator.js';
+
+// Every handler in this controller depends on the in-flight migration, so
+// the class itself is marked instead of decorating each method.
+@Controller('migration')
+@MaintenanceMode()
+export class MigrationController {
+  @Get('status')
+  status() {
+    return { status: 'running' };
+  }
+
+  @Post('retry')
+  retry() {
+    return { retried: true };
+  }
+}
diff --git a/integration/maintenance-mode/test/maintenance-mode.guard.spec.ts b/integration/maintenance-mode/test/maintenance-mode.guard.spec.ts
new file mode 100644
index 0000000..50a4ac9
--- /dev/null
+++ b/integration/maintenance-mode/test/maintenance-mode.guard.spec.ts
@@ -0,0 +1,101 @@
+import type { ExecutionContext } from '@nestjs/common';
+import { ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MAINTENANCE_MODE_KEY } from '../src/maintenance-mode.constants.js';
+import {
+  MAINTENANCE_MODE_MESSAGE,
+  MaintenanceModeGuard,
+} from '../src/maintenance-mode.guard.js';
+import { MaintenanceModeService } from '../src/maintenance-mode.service.js';
+
+/**
+ * Builds a bare `ExecutionContext`-shaped object, with no HTTP server or
+ * socket behind it, so the guard can be exercised in isolation.
+ */
+function createContext(options: {
+  type?: 'http' | 'ws';
+  handlerMarked?: boolean;
+  classMarked?: boolean;
+}): ExecutionContext {
+  const handler = function affectedHandler() {};
+  class Controller {}
+
+  if (options.handlerMarked) {
+    Reflect.defineMetadata(MAINTENANCE_MODE_KEY, true, handler);
+  }
+  if (options.classMarked) {
+    Reflect.defineMetadata(MAINTENANCE_MODE_KEY, true, Controller);
+  }
+
+  return {
+    getHandler: () => handler,
+    getClass: () => Controller as any,
+    getType: () => options.type ?? 'http',
+    getArgs: () => [],
+    getArgByIndex: () => undefined,
+    switchToHttp: () => ({}) as any,
+    switchToRpc: () => ({}) as any,
+    switchToWs: () => ({}) as any,
+  } as ExecutionContext;
+}
+
+describe('MaintenanceModeGuard', () => {
+  let maintenanceModeService: MaintenanceModeService;
+  let guard: MaintenanceModeGuard;
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(new Reflector(), maintenanceModeService);
+  });
+
+  it('allows an unmarked handler through even while maintenance mode is on', () => {
+    maintenanceModeService.enable();
+    expect(guard.canActivate(createContext({}))).toBe(true);
+  });
+
+  it('allows a marked handler through while maintenance mode is off', () => {
+    expect(guard.canActivate(createContext({ handlerMarked: true }))).toBe(
+      true,
+    );
+  });
+
+  it('blocks a method-marked HTTP handler while maintenance mode is on', () => {
+    maintenanceModeService.enable();
+    const context = createContext({ handlerMarked: true, type: 'http' });
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('blocks every handler of a class-marked controller while maintenance mode is on', () => {
+    maintenanceModeService.enable();
+    const context = createContext({ classMarked: true, type: 'http' });
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('blocks a marked WebSocket message handler using the same metadata, but raises a WsException', () => {
+    maintenanceModeService.enable();
+    const context = createContext({ handlerMarked: true, type: 'ws' });
+    expect(() => guard.canActivate(context)).toThrow(WsException);
+  });
+
+  it('re-allows a marked handler once maintenance mode is switched back off', () => {
+    maintenanceModeService.enable();
+    const context = createContext({ handlerMarked: true });
+    expect(() => guard.canActivate(context)).toThrow();
+
+    maintenanceModeService.disable();
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('reports a clear maintenance-specific message', () => {
+    maintenanceModeService.enable();
+    const context = createContext({ handlerMarked: true });
+    expect(() => guard.canActivate(context)).toThrow(
+      MAINTENANCE_MODE_MESSAGE,
+    );
+  });
+});
