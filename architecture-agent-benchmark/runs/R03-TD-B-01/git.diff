+import { NestExpressApplication } from '@nestjs/platform-express';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../src/app.module.js';
+import { REQUEST_ID_HEADER } from '../src/request-id.middleware.js';
+
+const UUID_V4_REGEX =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+
+describe('Request Id (Express)', () => {
+  let app: NestExpressApplication;
+
+  beforeEach(async () => {
+    const module = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = module.createNestApplication<NestExpressApplication>();
+    await app.init();
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  it('generates a request id and returns it in the response header', async () => {
+    const response = await request(app.getHttpServer()).get('/').expect(200);
+
+    expect(response.headers[REQUEST_ID_HEADER]).toMatch(UUID_V4_REGEX);
+  });
+
+  it('exposes the same request id to application code as the response header', async () => {
+    const response = await request(app.getHttpServer()).get('/').expect(200);
+
+    expect(response.body.requestId).toEqual(
+      response.headers[REQUEST_ID_HEADER],
+    );
+  });
+
+  it('reuses an incoming request id instead of generating a new one', async () => {
+    const incomingId = 'incoming-correlation-id-123';
+
+    const response = await request(app.getHttpServer())
+      .get('/')
+      .set(REQUEST_ID_HEADER, incomingId)
+      .expect(200);
+
+    expect(response.headers[REQUEST_ID_HEADER]).toEqual(incomingId);
+    expect(response.body.requestId).toEqual(incomingId);
+  });
+
+  it('assigns a different id to each request when none is provided', async () => {
+    const first = await request(app.getHttpServer()).get('/').expect(200);
+    const second = await request(app.getHttpServer()).get('/').expect(200);
+
+    expect(first.headers[REQUEST_ID_HEADER]).not.toEqual(
+      second.headers[REQUEST_ID_HEADER],
+    );
+  });
+});
