+import {
+  Module,
+  type MiddlewareConsumer,
+  type NestModule,
+} from '@nestjs/common';
+import { RequestIdMiddleware } from './request-id.middleware.js';
+
+/**
+ * Registers `RequestIdMiddleware` for every route of the application.
+ * Import this module once (typically in the root module) to guarantee
+ * that all HTTP responses carry a correlation id, on either the Express
+ * or Fastify adapter.
+ *
+ * @publicApi
+ */
+@Module({})
+export class RequestIdModule implements NestModule {
+  configure(consumer: MiddlewareConsumer) {
+    consumer.apply(RequestIdMiddleware).forRoutes('*');
+  }
+}
