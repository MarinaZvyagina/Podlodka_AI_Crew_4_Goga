+import { randomUUID } from 'crypto';
+import { Injectable, type NestMiddleware } from '@nestjs/common';
+import { RequestIdStorage } from './request-id.storage.js';
+
+/**
+ * Name of the header used to read/write the correlation id.
+ * Header lookups are performed against the lower-cased form since Node
+ * normalizes incoming header names to lower case on both the Express and
+ * Fastify adapters (the latter runs connect-style middleware against the
+ * raw `http.IncomingMessage`/`http.ServerResponse` via `@fastify/middie`).
+ */
+export const REQUEST_ID_HEADER = 'x-request-id';
+
+interface RawRequest {
+  headers: Record<string, string | string[] | undefined>;
+}
+
+interface RawResponse {
+  setHeader(name: string, value: string): unknown;
+}
+
+/**
+ * Ensures every response carries a `X-Request-Id` header, reusing the id
+ * supplied by the caller (if any) so a single id can be traced across a
+ * chain of internal calls, and generating a new one otherwise.
+ *
+ * The resolved id is also stashed in `RequestIdStorage` for the duration
+ * of the request, so application code can retrieve it without parsing it
+ * back out of the response.
+ *
+ * Works identically regardless of the underlying HTTP adapter (Express or
+ * Fastify) because it only relies on the connect-style `(req, res, next)`
+ * signature and the plain `headers` object / `setHeader` method that both
+ * adapters expose to global middleware.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class RequestIdMiddleware implements NestMiddleware<
+  RawRequest,
+  RawResponse
+> {
+  use(req: RawRequest, res: RawResponse, next: (error?: any) => void): void {
+    const requestId = this.getIncomingRequestId(req) ?? randomUUID();
+    res.setHeader(REQUEST_ID_HEADER, requestId);
+    RequestIdStorage.run(requestId, () => next());
+  }
+
+  private getIncomingRequestId(req: RawRequest): string | undefined {
+    const header = req.headers?.[REQUEST_ID_HEADER];
+    const value = Array.isArray(header) ? header[0] : header;
+    return value?.trim() || undefined;
+  }
+}
