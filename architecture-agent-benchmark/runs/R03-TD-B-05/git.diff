@@ -0,0 +1,34 @@
+import { RequestIdStorage } from '../../middleware/request-id.storage.js';
+
+describe('RequestIdStorage', () => {
+  it('should return undefined outside of a run() context', () => {
+    expect(RequestIdStorage.get()).toBeUndefined();
+  });
+
+  it('should expose the id passed to run() while the callback executes', () => {
+    RequestIdStorage.run('abc-123', () => {
+      expect(RequestIdStorage.get()).toBe('abc-123');
+    });
+  });
+
+  it('should isolate ids across concurrent async contexts', async () => {
+    const observed: string[] = [];
+
+    await Promise.all([
+      RequestIdStorage.run('first', async () => {
+        await new Promise(resolve => setTimeout(resolve, 10));
+        observed.push(RequestIdStorage.get()!);
+      }),
+      RequestIdStorage.run('second', async () => {
+        observed.push(RequestIdStorage.get()!);
+      }),
+    ]);
+
+    expect(observed.sort()).toEqual(['first', 'second']);
+  });
+
+  it('should not leak the id once run() has completed', () => {
+    RequestIdStorage.run('temporary', () => {});
+    expect(RequestIdStorage.get()).toBeUndefined();
+  });
+});
