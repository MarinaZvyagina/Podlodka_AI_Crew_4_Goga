+import { Controller, Get, INestApplication, Module } from '@nestjs/common';
+import {
+  REQUEST_ID_HEADER,
+  RequestIdModule,
+  RequestIdStorage,
+} from '@nestjs/core';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+
+const UUID_V4 =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+
+@Controller()
+class RequestIdController {
+  @Get('request-id')
+  getRequestId() {
+    return { requestId: RequestIdStorage.get() };
+  }
+}
+
+@Module({
+  imports: [RequestIdModule],
+  controllers: [RequestIdController],
+})
+class RequestIdTestModule {}
+
+describe('RequestIdModule', () => {
+  let app: INestApplication;
+
+  beforeEach(async () => {
+    app = await Test.createTestingModule({
+      imports: [RequestIdTestModule],
+    })
+      .compile()
+      .then(module => module.createNestApplication());
+
+    await app.init();
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  it('generates and returns a request id header when the caller sends none', async () => {
+    const response = await request(app.getHttpServer()).get('/request-id');
+
+    expect(response.headers[REQUEST_ID_HEADER]).toMatch(UUID_V4);
+  });
+
+  it('reuses the caller-supplied request id instead of generating a new one', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/request-id')
+      .set(REQUEST_ID_HEADER, 'caller-supplied-id');
+
+    expect(response.headers[REQUEST_ID_HEADER]).toBe('caller-supplied-id');
+  });
+
+  it('exposes the same request id to application code as is sent on the response header', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/request-id')
+      .set(REQUEST_ID_HEADER, 'traced-across-the-chain');
+
+    expect(response.headers[REQUEST_ID_HEADER]).toBe('traced-across-the-chain');
+    expect(response.body.requestId).toBe('traced-across-the-chain');
+  });
+});
