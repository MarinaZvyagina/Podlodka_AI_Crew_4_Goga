+import {
+  REQUEST_ID_HEADER,
+  RequestIdMiddleware,
+} from '../../middleware/request-id.middleware.js';
+import { RequestIdStorage } from '../../middleware/request-id.storage.js';
+
+describe('RequestIdMiddleware', () => {
+  let middleware: RequestIdMiddleware;
+
+  beforeEach(() => {
+    middleware = new RequestIdMiddleware();
+  });
+
+  const createRes = () => ({
+    headers: {} as Record<string, string>,
+    setHeader(name: string, value: string) {
+      this.headers[name] = value;
+    },
+  });
+
+  it('should generate a new id and set it on the response when none was supplied', () => {
+    const req = { headers: {} };
+    const res = createRes();
+    const next = vi.fn();
+
+    middleware.use(req, res, next);
+
+    expect(res.headers[REQUEST_ID_HEADER]).toBeDefined();
+    expect(typeof res.headers[REQUEST_ID_HEADER]).toBe('string');
+    expect(next).toHaveBeenCalledTimes(1);
+  });
+
+  it('should reuse the incoming request id instead of generating a new one', () => {
+    const req = { headers: { [REQUEST_ID_HEADER]: 'incoming-id' } };
+    const res = createRes();
+    const next = vi.fn();
+
+    middleware.use(req, res, next);
+
+    expect(res.headers[REQUEST_ID_HEADER]).toBe('incoming-id');
+  });
+
+  it('should use the first value when the incoming header is duplicated', () => {
+    const req = { headers: { [REQUEST_ID_HEADER]: ['first-id', 'second-id'] } };
+    const res = createRes();
+    const next = vi.fn();
+
+    middleware.use(req, res, next);
+
+    expect(res.headers[REQUEST_ID_HEADER]).toBe('first-id');
+  });
+
+  it('should generate a new id when the incoming header is blank', () => {
+    const req = { headers: { [REQUEST_ID_HEADER]: '   ' } };
+    const res = createRes();
+    const next = vi.fn();
+
+    middleware.use(req, res, next);
+
+    expect(res.headers[REQUEST_ID_HEADER].trim()).not.toBe('');
+    expect(res.headers[REQUEST_ID_HEADER]).not.toBe('   ');
+  });
+
+  it('should make the resolved id available through RequestIdStorage while next() runs', () => {
+    const req = { headers: { [REQUEST_ID_HEADER]: 'traced-id' } };
+    const res = createRes();
+    let observedDuringNext: string | undefined;
+
+    middleware.use(req, res, () => {
+      observedDuringNext = RequestIdStorage.get();
+    });
+
+    expect(observedDuringNext).toBe('traced-id');
+    expect(RequestIdStorage.get()).toBeUndefined();
+  });
+});
