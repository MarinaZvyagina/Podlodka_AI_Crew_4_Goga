@@ -0,0 +1,37 @@
+import { AsyncLocalStorage } from 'async_hooks';
+
+export interface RequestIdStore {
+  requestId: string;
+}
+
+/**
+ * Provides access to the correlation/request id of the request currently
+ * being handled, from anywhere in application code (services, handlers,
+ * interceptors, etc.) without needing a reference to the underlying
+ * request or response object.
+ *
+ * Backed by `AsyncLocalStorage`, so the value follows the request's
+ * asynchronous execution context regardless of which HTTP adapter
+ * (Express or Fastify) is serving the request.
+ *
+ * @publicApi
+ */
+export class RequestIdStorage {
+  private static readonly storage = new AsyncLocalStorage<RequestIdStore>();
+
+  /**
+   * Runs `callback` within an async context carrying the given request id.
+   */
+  public static run<T>(requestId: string, callback: () => T): T {
+    return this.storage.run({ requestId }, callback);
+  }
+
+  /**
+   * Returns the request id associated with the current async execution
+   * context, or `undefined` if called outside of a request (or before the
+   * `RequestIdMiddleware` has run).
+   */
+  public static get(): string | undefined {
+    return this.storage.getStore()?.requestId;
+  }
+}
