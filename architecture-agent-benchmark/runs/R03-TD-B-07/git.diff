+import { AsyncLocalStorage } from 'node:async_hooks';
+
+export interface RequestIdStore {
+  requestId: string;
+}
+
+/**
+ * Propagates the current request's correlation id across the asynchronous
+ * call chain that handles it, independently of which HTTP adapter
+ * (Express or Fastify) is in use and regardless of whether the underlying
+ * request/response objects are mutated or replaced downstream.
+ */
+export const requestIdStorage = new AsyncLocalStorage<RequestIdStore>();
+
+/**
+ * Returns the correlation id of the request currently being handled, i.e.
+ * the same value that was written to the response header by
+ * `RequestIdMiddleware`. Returns `undefined` when called outside of a
+ * request handled by that middleware.
+ *
+ * @publicApi
+ */
+export function getRequestId(): string | undefined {
+  return requestIdStorage.getStore()?.requestId;
+}
