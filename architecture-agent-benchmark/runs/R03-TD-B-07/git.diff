+import {
+  Controller,
+  Get,
+  INestApplication,
+  MiddlewareConsumer,
+  Module,
+  NestModule,
+  RequestIdMiddleware,
+  getRequestId,
+} from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+
+@Controller()
+class RequestIdTestController {
+  @Get('request-id')
+  getId() {
+    return { requestId: getRequestId() };
+  }
+}
+
+@Module({
+  controllers: [RequestIdTestController],
+})
+class RequestIdTestModule implements NestModule {
+  configure(consumer: MiddlewareConsumer) {
+    consumer.apply(RequestIdMiddleware).forRoutes('*');
+  }
+}
+
+describe('Request id (ExpressAdapter)', () => {
+  let app: INestApplication;
+
+  beforeEach(async () => {
+    app = (
+      await Test.createTestingModule({
+        imports: [RequestIdTestModule],
+      }).compile()
+    ).createNestApplication();
+
+    await app.init();
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  it('generates a request id and returns it in the response header', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/request-id')
+      .expect(200);
+
+    const headerValue = response.headers['x-request-id'];
+    expect(typeof headerValue).toBe('string');
+    expect(headerValue.length).toBeGreaterThan(0);
+    expect(response.body.requestId).toBe(headerValue);
+  });
+
+  it('reuses an incoming request id instead of generating a new one', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/request-id')
+      .set('x-request-id', 'caller-supplied-id')
+      .expect(200);
+
+    expect(response.headers['x-request-id']).toBe('caller-supplied-id');
+    expect(response.body.requestId).toBe('caller-supplied-id');
+  });
+
+  it('generates a different id for each unrelated request', async () => {
+    const first = await request(app.getHttpServer()).get('/request-id');
+    const second = await request(app.getHttpServer()).get('/request-id');
+
+    expect(first.headers['x-request-id']).not.toBe(
+      second.headers['x-request-id'],
+    );
+  });
+});
