@@ -0,0 +1,76 @@
+import { getRequestId } from '../../context/request-id-storage.js';
+import {
+  REQUEST_ID_HEADER,
+  RequestIdMiddleware,
+} from '../../middleware/request-id.middleware.js';
+
+describe('RequestIdMiddleware', () => {
+  let middleware: RequestIdMiddleware;
+  let setHeader: ReturnType<typeof vi.fn>;
+
+  beforeEach(() => {
+    middleware = new RequestIdMiddleware();
+    setHeader = vi.fn();
+  });
+
+  it('should generate a new id and set it as the response header when none was provided', () => {
+    let idSeenByNext: string | undefined;
+    const req = { headers: {} };
+    const res = { setHeader };
+    const next = () => {
+      idSeenByNext = getRequestId();
+    };
+
+    middleware.use(req, res, next);
+
+    expect(setHeader).toHaveBeenCalledTimes(1);
+    const [headerName, headerValue] = setHeader.mock.calls[0];
+    expect(headerName).toBe(REQUEST_ID_HEADER);
+    expect(typeof headerValue).toBe('string');
+    expect(headerValue.length).toBeGreaterThan(0);
+    expect(idSeenByNext).toBe(headerValue);
+  });
+
+  it('should reuse the incoming request id instead of generating a new one', () => {
+    let idSeenByNext: string | undefined;
+    const req = { headers: { [REQUEST_ID_HEADER]: 'incoming-id' } };
+    const res = { setHeader };
+    const next = () => {
+      idSeenByNext = getRequestId();
+    };
+
+    middleware.use(req, res, next);
+
+    expect(setHeader).toHaveBeenCalledWith(REQUEST_ID_HEADER, 'incoming-id');
+    expect(idSeenByNext).toBe('incoming-id');
+  });
+
+  it('should generate a new id when the incoming header is present but empty', () => {
+    const req = { headers: { [REQUEST_ID_HEADER]: '' } };
+    const res = { setHeader };
+
+    middleware.use(req, res, () => {});
+
+    const [, headerValue] = setHeader.mock.calls[0];
+    expect(headerValue).not.toBe('');
+  });
+
+  it('should call next', () => {
+    const req = { headers: {} };
+    const res = { setHeader };
+    const next = vi.fn();
+
+    middleware.use(req, res, next);
+
+    expect(next).toHaveBeenCalledTimes(1);
+  });
+
+  it('should not leak the id outside of the request context', () => {
+    const req = { headers: { [REQUEST_ID_HEADER]: 'scoped-id' } };
+    const res = { setHeader };
+
+    middleware.use(req, res, () => {});
+
+    expect(getRequestId()).toBeUndefined();
+  });
+});
