+import {
+  Controller,
+  Get,
+  MiddlewareConsumer,
+  Module,
+  NestModule,
+  RequestIdMiddleware,
+  getRequestId,
+} from '@nestjs/common';
+import {
+  FastifyAdapter,
+  NestFastifyApplication,
+} from '@nestjs/platform-fastify';
+import { Test } from '@nestjs/testing';
+
+@Controller()
+class RequestIdTestController {
+  @Get('request-id')
+  getId() {
+    return { requestId: getRequestId() };
+  }
+}
+
+@Module({
+  controllers: [RequestIdTestController],
+})
+class RequestIdTestModule implements NestModule {
+  configure(consumer: MiddlewareConsumer) {
+    consumer.apply(RequestIdMiddleware).forRoutes('*');
+  }
+}
+
+describe('Request id (FastifyAdapter)', () => {
+  let app: NestFastifyApplication;
+
+  beforeEach(async () => {
+    app = (
+      await Test.createTestingModule({
+        imports: [RequestIdTestModule],
+      }).compile()
+    ).createNestApplication<NestFastifyApplication>(new FastifyAdapter());
+
+    await app.init();
+    await app.getHttpAdapter().getInstance().ready();
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  it('generates a request id and returns it in the response header', async () => {
+    const response = await app.inject({
+      method: 'GET',
+      url: '/request-id',
+    });
+
+    expect(response.statusCode).toBe(200);
+    const headerValue = response.headers['x-request-id'];
+    expect(typeof headerValue).toBe('string');
+    expect((headerValue as string).length).toBeGreaterThan(0);
+    expect(JSON.parse(response.payload).requestId).toBe(headerValue);
+  });
+
+  it('reuses an incoming request id instead of generating a new one', async () => {
+    const response = await app.inject({
+      method: 'GET',
+      url: '/request-id',
+      headers: { 'x-request-id': 'caller-supplied-id' },
+    });
+
+    expect(response.statusCode).toBe(200);
+    expect(response.headers['x-request-id']).toBe('caller-supplied-id');
+    expect(JSON.parse(response.payload).requestId).toBe('caller-supplied-id');
+  });
+
+  it('generates a different id for each unrelated request', async () => {
+    const first = await app.inject({ method: 'GET', url: '/request-id' });
+    const second = await app.inject({ method: 'GET', url: '/request-id' });
+
+    expect(first.headers['x-request-id']).not.toBe(
+      second.headers['x-request-id'],
+    );
+  });
+});
