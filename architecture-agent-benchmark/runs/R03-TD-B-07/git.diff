@@ -0,0 +1,38 @@
+import {
+  getRequestId,
+  requestIdStorage,
+} from '../../context/request-id-storage.js';
+
+describe('requestIdStorage', () => {
+  describe('getRequestId', () => {
+    it('should return undefined when called outside of a request context', () => {
+      expect(getRequestId()).toBeUndefined();
+    });
+
+    it('should return the id stored for the current asynchronous context', async () => {
+      await requestIdStorage.run({ requestId: 'abc-123' }, async () => {
+        expect(getRequestId()).toBe('abc-123');
+
+        await new Promise(resolve => setTimeout(resolve, 0));
+        expect(getRequestId()).toBe('abc-123');
+      });
+    });
+
+    it('should isolate ids between concurrent contexts', async () => {
+      const results: Array<string | undefined> = [];
+
+      await Promise.all([
+        requestIdStorage.run({ requestId: 'first' }, async () => {
+          await new Promise(resolve => setTimeout(resolve, 10));
+          results.push(getRequestId());
+        }),
+        requestIdStorage.run({ requestId: 'second' }, async () => {
+          await new Promise(resolve => setTimeout(resolve, 0));
+          results.push(getRequestId());
+        }),
+      ]);
+
+      expect(results.sort()).toEqual(['first', 'second']);
+    });
+  });
+});
diff --git a/packages/common/test/middleware/request-id.middleware.spec.ts b/packages/common/test/middleware/request-id.middleware.spec.ts
