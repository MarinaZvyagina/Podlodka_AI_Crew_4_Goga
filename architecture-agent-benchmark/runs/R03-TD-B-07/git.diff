+import { randomUUID } from 'node:crypto';
+import { Injectable } from '../decorators/core/index.js';
+import { requestIdStorage } from '../context/request-id-storage.js';
+import { NestMiddleware } from '../interfaces/middleware/nest-middleware.interface.js';
+
+/**
+ * Name of the header used to carry the request correlation id, both when
+ * reading it from an incoming request and when writing it to the outgoing
+ * response. Lowercase, since Node.js normalizes incoming header names to
+ * lowercase and header names are case-insensitive on the wire.
+ */
+export const REQUEST_ID_HEADER = 'x-request-id';
+
+/**
+ * Ensures every response carries a request correlation id header.
+ *
+ * If the incoming request already carries a `x-request-id` header (for
+ * example, forwarded by an upstream internal service), that value is
+ * reused so a single id can be traced across a chain of calls. Otherwise a
+ * new id is generated.
+ *
+ * The resolved id is written to the response header and, for the duration
+ * of the request, made available to application code via `getRequestId()`.
+ *
+ * Behaves identically on the Express and Fastify adapters: Nest's
+ * middleware pipeline hands both adapters the underlying Node.js
+ * `http.IncomingMessage`/`http.ServerResponse`, and the id is propagated
+ * through `AsyncLocalStorage` rather than by mutating the request object,
+ * so it remains reachable even where a platform later wraps the request in
+ * its own object (e.g. `FastifyRequest`).
+ *
+ * @publicApi
+ */
+@Injectable()
+export class RequestIdMiddleware implements NestMiddleware {
+  use(
+    req: Record<string, any>,
+    res: Record<string, any>,
+    next: (error?: any) => void,
+  ) {
+    const incomingRequestId = req.headers?.[REQUEST_ID_HEADER];
+    const requestId =
+      (Array.isArray(incomingRequestId)
+        ? incomingRequestId[0]
+        : incomingRequestId) || randomUUID();
+
+    res.setHeader(REQUEST_ID_HEADER, requestId);
+    requestIdStorage.run({ requestId }, next);
+  }
+}
