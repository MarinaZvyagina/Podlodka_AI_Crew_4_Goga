+  public enableRequestId(options: RequestIdOptions = {}): this {
+    const headerName = options.header ?? 'X-Request-Id';
+    const lookupName = headerName.toLowerCase();
+    const generateId = options.generator ?? randomUUID;
+
+    this.getHttpAdapter().setOnRequestHook(
+      (req: any, res: any, done: (err?: Error) => void) => {
+        const incomingValue = req?.headers?.[lookupName];
+        const requestId =
+          (Array.isArray(incomingValue) ? incomingValue[0] : incomingValue) ||
+          generateId();
+
+        this.httpAdapter.setHeader(res, headerName, requestId);
+        RequestIdStorage.run(requestId, () => done());
+      },
+    );
+    return this;
