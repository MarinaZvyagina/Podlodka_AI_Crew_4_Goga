+/**
+ * @publicApi
+ */
+export interface RequestIdOptions {
+  /**
+   * The name of the HTTP header used to read an inbound request id from,
+   * and to expose the (possibly generated) request id on the response.
+   * Header lookups are case-insensitive.
+   *
+   * @default 'X-Request-Id'
+   */
+  header?: string;
+
+  /**
+   * Factory used to generate a new request id when the incoming request
+   * doesn't already carry one under `header`.
+   *
+   * @default crypto.randomUUID
+   */
+  generator?: () => string;
+}
