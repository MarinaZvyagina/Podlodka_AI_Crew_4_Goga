+import { NestExpressApplication } from '@nestjs/platform-express';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../src/app.module.js';
+
+describe('Request id (Express Application)', () => {
+  let app: NestExpressApplication;
+
+  beforeEach(async () => {
+    const moduleFixture = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = moduleFixture.createNestApplication<NestExpressApplication>();
+    app.enableRequestId();
+
+    await app.init();
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  it('should generate a request id and return it in the response header', async () => {
+    const response = await request(app.getHttpServer()).get('/').expect(200);
+
+    const requestId = response.headers['x-request-id'];
+    expect(requestId).toBeTruthy();
+  });
+
+  it('should expose the same id to application code that ends up in the response header', async () => {
+    const response = await request(app.getHttpServer()).get('/').expect(200);
+
+    expect(response.body.requestId).toEqual(response.headers['x-request-id']);
+  });
+
+  it('should reuse an inbound request id instead of generating a new one', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/')
+      .set('X-Request-Id', 'caller-supplied-id')
+      .expect(200);
+
+    expect(response.headers['x-request-id']).toEqual('caller-supplied-id');
+    expect(response.body.requestId).toEqual('caller-supplied-id');
+  });
+
+  it('should generate different ids for unrelated requests', async () => {
+    const first = await request(app.getHttpServer()).get('/').expect(200);
+    const second = await request(app.getHttpServer()).get('/').expect(200);
+
+    expect(first.headers['x-request-id']).not.toEqual(
+      second.headers['x-request-id'],
+    );
+  });
+});
