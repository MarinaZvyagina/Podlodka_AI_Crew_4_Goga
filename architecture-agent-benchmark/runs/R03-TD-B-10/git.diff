@@ -0,0 +1,45 @@
+import { RequestIdStorage } from '../../helpers/request-id-storage.js';
+
+describe('RequestIdStorage', () => {
+  it('should return undefined when accessed outside of a run() call', () => {
+    expect(RequestIdStorage.get()).toBeUndefined();
+  });
+
+  it('should expose the id passed to run() for the duration of the callback', () => {
+    const result = RequestIdStorage.run('req-1', () => RequestIdStorage.get());
+    expect(result).toEqual('req-1');
+  });
+
+  it('should propagate the id across async continuations started within run()', async () => {
+    const result = await RequestIdStorage.run('req-2', async () => {
+      await Promise.resolve();
+      await new Promise(resolve => setImmediate(resolve));
+      return RequestIdStorage.get();
+    });
+    expect(result).toEqual('req-2');
+  });
+
+  it('should isolate concurrent runs from each other', async () => {
+    const runA = RequestIdStorage.run('req-a', async () => {
+      await new Promise(resolve => setTimeout(resolve, 10));
+      return RequestIdStorage.get();
+    });
+    const runB = RequestIdStorage.run('req-b', async () => {
+      await new Promise(resolve => setTimeout(resolve, 1));
+      return RequestIdStorage.get();
+    });
+
+    expect(await runB).toEqual('req-b');
+    expect(await runA).toEqual('req-a');
+  });
+
+  it('should return to the previous value once the callback returns', () => {
+    RequestIdStorage.run('outer', () => {
+      RequestIdStorage.run('inner', () => {
+        expect(RequestIdStorage.get()).toEqual('inner');
+      });
+      expect(RequestIdStorage.get()).toEqual('outer');
+    });
+    expect(RequestIdStorage.get()).toBeUndefined();
+  });
+});
