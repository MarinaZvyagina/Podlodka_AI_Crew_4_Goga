@@ -0,0 +1,24 @@
+import { AsyncLocalStorage } from 'async_hooks';
+
+/**
+ * Holds the id of the request currently being handled, so that application
+ * code (services, controllers, etc.) can retrieve the exact same id that was
+ * reused/generated for the incoming request and written to the response
+ * header, without needing access to the request or response objects.
+ *
+ * Populated by `NestApplication#enableRequestId()` identically regardless of
+ * the underlying HTTP adapter.
+ *
+ * @publicApi
+ */
+export class RequestIdStorage {
+  private static readonly storage = new AsyncLocalStorage<string>();
+
+  static run<T>(id: string, callback: () => T): T {
+    return this.storage.run(id, callback);
+  }
+
+  static get(): string | undefined {
+    return this.storage.getStore();
+  }
+}
