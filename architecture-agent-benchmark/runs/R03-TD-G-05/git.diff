@@ -0,0 +1,42 @@
+import { RequestIdStorage } from '../../../middleware/request-id/request-id.storage.js';
+
+describe('RequestIdStorage', () => {
+  it('returns undefined outside of a run() context', () => {
+    expect(RequestIdStorage.get()).toBeUndefined();
+  });
+
+  it('exposes the bound ID for the duration of the callback', () => {
+    RequestIdStorage.run('id-1', () => {
+      expect(RequestIdStorage.get()).toBe('id-1');
+    });
+  });
+
+  it('propagates the ID across async continuations started within run()', async () => {
+    const observed = await RequestIdStorage.run('id-2', async () => {
+      await new Promise(resolve => setTimeout(resolve, 0));
+      return RequestIdStorage.get();
+    });
+
+    expect(observed).toBe('id-2');
+  });
+
+  it('keeps concurrent runs isolated from one another', async () => {
+    const run = (id: string) =>
+      RequestIdStorage.run(id, async () => {
+        await new Promise(resolve => setTimeout(resolve, Math.random() * 5));
+        return RequestIdStorage.get();
+      });
+
+    const [a, b, c] = await Promise.all([run('a'), run('b'), run('c')]);
+
+    expect(a).toBe('a');
+    expect(b).toBe('b');
+    expect(c).toBe('c');
+  });
+
+  it('does not leak the ID once run() has completed', () => {
+    RequestIdStorage.run('id-3', () => undefined);
+
+    expect(RequestIdStorage.get()).toBeUndefined();
+  });
+});
