+import { NestExpressApplication } from '@nestjs/platform-express';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../src/app.module.js';
+
+describe('RequestId (Express)', () => {
+  let app: NestExpressApplication;
+
+  beforeEach(async () => {
+    const module = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = module.createNestApplication<NestExpressApplication>();
+    await app.init();
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  it('generates an ID and returns it via the response header when the caller sends none', async () => {
+    const response = await request(app.getHttpServer()).get('/').expect(200);
+
+    const headerValue = response.headers['x-request-id'];
+    expect(headerValue).toEqual(expect.any(String));
+    expect(headerValue.length).toBeGreaterThan(0);
+  });
+
+  it('exposes the same ID to application code as the one sent in the response header', async () => {
+    const response = await request(app.getHttpServer()).get('/').expect(200);
+
+    const headerValue = response.headers['x-request-id'];
+    expect(response.body.fromHandler).toEqual(headerValue);
+    expect(response.body.fromDownstream).toEqual(headerValue);
+  });
+
+  it('reuses an inbound ID instead of generating a new one', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/')
+      .set('X-Request-Id', 'caller-supplied-id')
+      .expect(200);
+
+    expect(response.headers['x-request-id']).toEqual('caller-supplied-id');
+    expect(response.body.fromHandler).toEqual('caller-supplied-id');
+    expect(response.body.fromDownstream).toEqual('caller-supplied-id');
+  });
+
+  it('does not leak the ID between concurrent requests', async () => {
+    const [first, second] = await Promise.all([
+      request(app.getHttpServer()).get('/').set('X-Request-Id', 'req-a'),
+      request(app.getHttpServer()).get('/').set('X-Request-Id', 'req-b'),
+    ]);
+
+    expect(first.headers['x-request-id']).toEqual('req-a');
+    expect(first.body.fromDownstream).toEqual('req-a');
+    expect(second.headers['x-request-id']).toEqual('req-b');
+    expect(second.body.fromDownstream).toEqual('req-b');
+  });
+});
