@@ -0,0 +1,13 @@
+import { Injectable } from '@nestjs/common';
+import { RequestIdStorage } from '@nestjs/core';
+
+@Injectable()
+export class DownstreamService {
+  // Reads the request ID after crossing an async boundary, several ticks
+  // away from the middleware/handler, to prove the value survives async
+  // continuations rather than only being readable synchronously.
+  async getRequestId(): Promise<string | undefined> {
+    await new Promise(resolve => setTimeout(resolve, 5));
+    return RequestIdStorage.get();
+  }
+}
