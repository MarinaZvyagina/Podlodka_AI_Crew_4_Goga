@@ -0,0 +1,75 @@
+import { createRequestIdMiddleware } from '../../../middleware/request-id/request-id.middleware.js';
+import { RequestIdStorage } from '../../../middleware/request-id/request-id.storage.js';
+
+function createMockResponse() {
+  const headers: Record<string, string> = {};
+  return {
+    headers,
+    setHeader(name: string, value: string) {
+      headers[name] = value;
+    },
+  };
+}
+
+describe('createRequestIdMiddleware', () => {
+  it('generates an ID and sets it on the response when the request carries none', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = { headers: {} };
+    const res = createMockResponse();
+    const next = vi.fn();
+
+    middleware(req, res, next);
+
+    expect(res.headers['X-Request-Id']).toEqual(expect.any(String));
+    expect(res.headers['X-Request-Id'].length).toBeGreaterThan(0);
+    expect(next).toHaveBeenCalledTimes(1);
+  });
+
+  it('reuses the inbound ID instead of generating a new one', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = { headers: { 'x-request-id': 'inbound-id' } };
+    const res = createMockResponse();
+
+    middleware(req, res, () => undefined);
+
+    expect(res.headers['X-Request-Id']).toBe('inbound-id');
+  });
+
+  it('makes the ID available to code running inside next() via RequestIdStorage', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = { headers: { 'x-request-id': 'inbound-id' } };
+    const res = createMockResponse();
+
+    let observed: string | undefined;
+    middleware(req, res, () => {
+      observed = RequestIdStorage.get();
+    });
+
+    expect(observed).toBe('inbound-id');
+  });
+
+  it('respects a custom header name for both reading and writing', () => {
+    const middleware = createRequestIdMiddleware({
+      header: 'X-Correlation-Id',
+    });
+    const req = { headers: { 'x-correlation-id': 'corr-1' } };
+    const res = createMockResponse();
+
+    middleware(req, res, () => undefined);
+
+    expect(res.headers['X-Correlation-Id']).toBe('corr-1');
+    expect(res.headers['X-Request-Id']).toBeUndefined();
+  });
+
+  it('respects a custom ID generator', () => {
+    const middleware = createRequestIdMiddleware({
+      generator: () => 'fixed-id',
+    });
+    const req = { headers: {} };
+    const res = createMockResponse();
+
+    middleware(req, res, () => undefined);
+
+    expect(res.headers['X-Request-Id']).toBe('fixed-id');
+  });
+});
