+import { randomStringGenerator } from '@nestjs/common/internal';
+import { RequestIdStorage } from './request-id.storage.js';
+
+export interface RequestIdMiddlewareOptions {
+  /**
+   * Name of the header the request ID is read from (if present on the
+   * incoming request) and written to on the outgoing response.
+   * @default 'X-Request-Id'
+   */
+  header?: string;
+  /**
+   * Used to produce a new ID whenever the incoming request doesn't already
+   * carry one.
+   */
+  generator?: () => string;
+}
+
+const DEFAULT_HEADER = 'X-Request-Id';
+
+/**
+ * Creates framework-agnostic (Express/Fastify) middleware that:
+ *  - reuses the request ID supplied by the caller via `header`, if any, so
+ *    a single ID can be traced across a chain of internal calls;
+ *  - otherwise generates a new one;
+ *  - writes it to the same header on every response;
+ *  - exposes it to application code for the remainder of the request via
+ *    {@link RequestIdStorage}.
+ *
+ * Register it as early as possible, e.g. `app.use(createRequestIdMiddleware())`
+ * before any other middleware, so the ID is available for the whole request
+ * lifecycle (including errors raised by later middleware).
+ *
+ * @publicApi
+ */
+export function createRequestIdMiddleware(
+  options: RequestIdMiddlewareOptions = {},
+) {
+  const header = options.header ?? DEFAULT_HEADER;
+  const lookupHeader = header.toLowerCase();
+  const generator = options.generator ?? randomStringGenerator;
+
+  return function requestIdMiddleware(
+    req: { headers?: Record<string, string | string[] | undefined> },
+    res: { setHeader(name: string, value: string): unknown },
+    next: (error?: any) => void,
+  ) {
+    const inboundValue = req.headers?.[lookupHeader];
+    const inboundId = Array.isArray(inboundValue)
+      ? inboundValue[0]
+      : inboundValue;
+    const requestId = inboundId || generator();
+
+    res.setHeader(header, requestId);
+    RequestIdStorage.run(requestId, next);
+  };
+}
diff --git a/packages/core/middleware/request-id/request-id.storage.ts b/packages/core/middleware/request-id/request-id.storage.ts
new file mode 100644
index 0000000..606b6a5
--- /dev/null
+++ b/packages/core/middleware/request-id/request-id.storage.ts
@@ -0,0 +1,40 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+
+/**
+ * Makes the ID of the request currently being handled available to
+ * application code, regardless of which HTTP adapter (Express or Fastify)
+ * is in use and without having to thread it through function signatures or
+ * re-read it from the response.
+ *
+ * Backed by `AsyncLocalStorage` rather than a property on the request
+ * object: Fastify's Express-compatibility middleware layer runs against the
+ * raw Node request/response, which are distinct objects from the
+ * `FastifyRequest`/`FastifyReply` instances seen by controllers, guards,
+ * interceptors, etc. A value stashed on the raw request would not be
+ * visible there. The async context, by contrast, propagates through the
+ * entire continuation regardless of which request object a given layer is
+ * holding.
+ *
+ * @publicApi
+ */
+export class RequestIdStorage {
+  private static readonly storage = new AsyncLocalStorage<string>();
+
+  private constructor() {}
+
+  /**
+   * Runs `callback` with `requestId` bound as the current request's ID for
+   * the remainder of its async execution context.
+   */
+  public static run<T>(requestId: string, callback: () => T): T {
+    return this.storage.run(requestId, callback);
+  }
+
+  /**
+   * Returns the ID of the request currently being handled, or `undefined`
+   * if called outside of a request initiated through `RequestIdMiddleware`.
+   */
+  public static get(): string | undefined {
+    return this.storage.getStore();
+  }
+}
diff --git a/packages/core/test/middleware/request-id/request-id.middleware.spec.ts b/packages/core/test/middleware/request-id/request-id.middleware.spec.ts
