@@ -0,0 +1,42 @@
+import { RequestIdStorage } from '../../middleware/request-id-storage.js';
+
+describe('RequestIdStorage', () => {
+  it('should return undefined outside of a run() context', () => {
+    expect(RequestIdStorage.get()).toBeUndefined();
+  });
+
+  it('should expose the requestId bound by run() to the callback', () => {
+    RequestIdStorage.run('abc-123', () => {
+      expect(RequestIdStorage.get()).toEqual('abc-123');
+    });
+  });
+
+  it('should thread the requestId through async continuations started inside run()', async () => {
+    await RequestIdStorage.run('async-request-id', async () => {
+      await Promise.resolve();
+      await new Promise(resolve => setImmediate(resolve));
+      expect(RequestIdStorage.get()).toEqual('async-request-id');
+    });
+  });
+
+  it('should not leak the requestId once run() has returned', () => {
+    RequestIdStorage.run('leaked?', () => {});
+    expect(RequestIdStorage.get()).toBeUndefined();
+  });
+
+  it('should isolate concurrent run() contexts from each other', async () => {
+    const observed: Array<string | undefined> = [];
+
+    await Promise.all([
+      RequestIdStorage.run('first', async () => {
+        await new Promise(resolve => setTimeout(resolve, 10));
+        observed.push(RequestIdStorage.get());
+      }),
+      RequestIdStorage.run('second', async () => {
+        observed.push(RequestIdStorage.get());
+      }),
+    ]);
+
+    expect(observed.sort()).toEqual(['first', 'second']);
+  });
+});
diff --git a/packages/core/test/middleware/request-id.middleware.spec.ts b/packages/core/test/middleware/request-id.middleware.spec.ts
