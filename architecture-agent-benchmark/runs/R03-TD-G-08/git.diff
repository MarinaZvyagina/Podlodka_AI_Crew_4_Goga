+import { NestExpressApplication } from '@nestjs/platform-express';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../src/app.module.js';
+
+describe('Request id (Express)', () => {
+  let app: NestExpressApplication;
+
+  beforeEach(async () => {
+    app = (
+      await Test.createTestingModule({
+        imports: [AppModule],
+      }).compile()
+    ).createNestApplication<NestExpressApplication>();
+
+    await app.init();
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  it('should generate a request id header when the caller sends none', async () => {
+    const response = await request(app.getHttpServer()).get('/').expect(200);
+
+    expect(response.headers['x-request-id']).toBeDefined();
+    expect(response.headers['x-request-id'].length).toBeGreaterThan(0);
+  });
+
+  it('should reuse the inbound x-request-id header instead of generating a new one', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/')
+      .set('x-request-id', 'caller-supplied-id')
+      .expect(200);
+
+    expect(response.headers['x-request-id']).toEqual('caller-supplied-id');
+  });
+
+  it('should generate a different request id for each request without one', async () => {
+    const [first, second] = await Promise.all([
+      request(app.getHttpServer()).get('/').expect(200),
+      request(app.getHttpServer()).get('/').expect(200),
+    ]);
+
+    expect(first.headers['x-request-id']).not.toEqual(
+      second.headers['x-request-id'],
+    );
+  });
+
+  it('should expose the same id to application code that ends up on the response header', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/')
+      .set('x-request-id', 'traced-through-app-code')
+      .expect(200);
+
+    expect(response.body.requestId).toEqual('traced-through-app-code');
+    expect(response.body.requestId).toEqual(response.headers['x-request-id']);
+  });
+});
