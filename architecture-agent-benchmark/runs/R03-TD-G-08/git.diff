@@ -0,0 +1,71 @@
+import { Injectable } from '@nestjs/common';
+import type { NestMiddleware } from '@nestjs/common';
+import { randomStringGenerator } from '@nestjs/common/internal';
+import { RequestIdStorage } from './request-id-storage.js';
+
+/**
+ * Header used both to read an inbound request id (so a chain of internal
+ * calls can share one id) and to write it back on the outgoing response.
+ */
+export const REQUEST_ID_HEADER = 'x-request-id';
+
+/**
+ * A request id may have been generated by any upstream caller, so its shape
+ * isn't under our control. Reject anything that isn't a plausible token
+ * before reflecting it back on a response header: control characters would
+ * make `res.setHeader` throw (turning a malformed inbound header into an
+ * outage), and an unbounded length would let a caller inflate every log line
+ * and response derived from it.
+ */
+const MAX_REQUEST_ID_LENGTH = 200;
+// eslint-disable-next-line no-control-regex
+const INVALID_REQUEST_ID_CHARS = /[\x00-\x1f\x7f]/;
+
+function isValidInboundRequestId(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length <= MAX_REQUEST_ID_LENGTH &&
+    !INVALID_REQUEST_ID_CHARS.test(value)
+  );
+}
+
+/**
+ * Gives every request a request/correlation id: reuses the inbound
+ * `x-request-id` header when the caller already provides one (so the same id
+ * can be traced across a chain of internal calls), otherwise generates one.
+ *
+ * The id is written to the response header under the same name, and made
+ * available to the rest of the request-handling pipeline via
+ * `RequestIdStorage.get()`, so application code can log it without parsing
+ * it back out of the response.
+ *
+ * Register it the same way regardless of the underlying HTTP adapter
+ * (Express or Fastify):
+ *
+ * ```ts
+ * export class AppModule implements NestModule {
+ *   configure(consumer: MiddlewareConsumer) {
+ *     consumer.apply(RequestIdMiddleware).forRoutes('*');
+ *   }
+ * }
+ * ```
+ *
+ * @publicApi
+ */
+@Injectable()
+export class RequestIdMiddleware implements NestMiddleware {
+  use(
+    req: Record<string, any>,
+    res: Record<string, any>,
+    next: (error?: any) => void,
+  ) {
+    const inboundRequestId = req.headers?.[REQUEST_ID_HEADER];
+    const requestId = isValidInboundRequestId(inboundRequestId)
+      ? inboundRequestId
+      : randomStringGenerator();
+
+    res.setHeader(REQUEST_ID_HEADER, requestId);
+    RequestIdStorage.run(requestId, next);
+  }
+}
diff --git a/packages/core/test/middleware/request-id-storage.spec.ts b/packages/core/test/middleware/request-id-storage.spec.ts
