@@ -0,0 +1,108 @@
+import {
+  REQUEST_ID_HEADER,
+  RequestIdMiddleware,
+} from '../../middleware/request-id.middleware.js';
+import { RequestIdStorage } from '../../middleware/request-id-storage.js';
+
+describe('RequestIdMiddleware', () => {
+  let middleware: RequestIdMiddleware;
+  let res: { setHeader: (name: string, value: string) => void };
+  let setHeaderSpy: (name: string, value: string) => void;
+
+  beforeEach(() => {
+    middleware = new RequestIdMiddleware();
+    setHeaderSpy = vi.fn();
+    res = { setHeader: setHeaderSpy };
+  });
+
+  it('should generate a request id when none was provided', () => {
+    const next = vi.fn();
+
+    middleware.use({ headers: {} }, res, next);
+
+    expect(next).toHaveBeenCalledTimes(1);
+    expect(setHeaderSpy).toHaveBeenCalledTimes(1);
+    const [headerName, generatedId] = (setHeaderSpy as any).mock.calls[0];
+    expect(headerName).toEqual(REQUEST_ID_HEADER);
+    expect(typeof generatedId).toEqual('string');
+    expect(generatedId.length).toBeGreaterThan(0);
+  });
+
+  it('should generate a different request id on every call', () => {
+    middleware.use({ headers: {} }, res, () => {});
+    middleware.use({ headers: {} }, res, () => {});
+
+    const [, firstId] = (setHeaderSpy as any).mock.calls[0];
+    const [, secondId] = (setHeaderSpy as any).mock.calls[1];
+    expect(firstId).not.toEqual(secondId);
+  });
+
+  it('should reuse an inbound x-request-id header instead of generating a new one', () => {
+    const next = vi.fn();
+
+    middleware.use(
+      { headers: { [REQUEST_ID_HEADER]: 'incoming-id-from-caller' } },
+      res,
+      next,
+    );
+
+    expect(setHeaderSpy).toHaveBeenCalledWith(
+      REQUEST_ID_HEADER,
+      'incoming-id-from-caller',
+    );
+    expect(next).toHaveBeenCalledTimes(1);
+  });
+
+  it('should fall back to generating an id when the inbound header is empty', () => {
+    middleware.use({ headers: { [REQUEST_ID_HEADER]: '' } }, res, () => {});
+
+    const [, id] = (setHeaderSpy as any).mock.calls[0];
+    expect(id).not.toEqual('');
+    expect(id.length).toBeGreaterThan(0);
+  });
+
+  it('should fall back to generating an id when the inbound header contains control characters', () => {
+    middleware.use(
+      { headers: { [REQUEST_ID_HEADER]: 'bad\r\nvalue' } },
+      res,
+      () => {},
+    );
+
+    const [, id] = (setHeaderSpy as any).mock.calls[0];
+    expect(id).not.toEqual('bad\r\nvalue');
+  });
+
+  it('should fall back to generating an id when the inbound header is implausibly long', () => {
+    const overlong = 'a'.repeat(500);
+
+    middleware.use(
+      { headers: { [REQUEST_ID_HEADER]: overlong } },
+      res,
+      () => {},
+    );
+
+    const [, id] = (setHeaderSpy as any).mock.calls[0];
+    expect(id).not.toEqual(overlong);
+  });
+
+  it('should make the request id readable from RequestIdStorage while next() runs', () => {
+    let observed: string | undefined;
+    const next = () => {
+      observed = RequestIdStorage.get();
+    };
+
+    middleware.use({ headers: { [REQUEST_ID_HEADER]: 'trace-me' } }, res, next);
+
+    expect(observed).toEqual('trace-me');
+  });
+
+  it('should not leak the request id outside of the next() continuation', () => {
+    middleware.use(
+      { headers: { [REQUEST_ID_HEADER]: 'trace-me' } },
+      res,
+      () => {},
+    );
+
+    expect(RequestIdStorage.get()).toBeUndefined();
+  });
+});
