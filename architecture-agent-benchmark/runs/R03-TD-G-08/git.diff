@@ -0,0 +1,37 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+
+export interface RequestIdStore {
+  requestId: string;
+}
+
+/**
+ * Tracks the request/correlation id for the request currently being handled,
+ * so application code (services, interceptors, exception filters, ...) can
+ * read the exact same id that was written to the response header, without
+ * needing access to the request or response object.
+ *
+ * Backed by `AsyncLocalStorage`, which threads the store through the async
+ * continuation started by `run` regardless of which HTTP adapter (Express,
+ * Fastify, ...) invoked it.
+ *
+ * @publicApi
+ */
+export class RequestIdStorage {
+  private static readonly storage = new AsyncLocalStorage<RequestIdStore>();
+
+  /**
+   * Runs `callback` with `requestId` bound to the current async context.
+   */
+  public static run<T>(requestId: string, callback: () => T): T {
+    return this.storage.run({ requestId }, callback);
+  }
+
+  /**
+   * Returns the request id bound to the current async context, or
+   * `undefined` if called outside of a request handled by
+   * `RequestIdMiddleware`.
+   */
+  public static get(): string | undefined {
+    return this.storage.getStore()?.requestId;
+  }
+}
