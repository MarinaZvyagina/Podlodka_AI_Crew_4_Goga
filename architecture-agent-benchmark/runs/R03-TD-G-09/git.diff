+import {
+  Controller,
+  Get,
+  INestApplication,
+  MiddlewareConsumer,
+  Module,
+  NestModule,
+} from '@nestjs/common';
+import { RequestIdMiddleware, getRequestId } from '@nestjs/core';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+
+@Controller()
+class TestController {
+  @Get('request-id')
+  getId() {
+    return { id: getRequestId() };
+  }
+}
+
+@Module({ controllers: [TestController] })
+class TestModule implements NestModule {
+  configure(consumer: MiddlewareConsumer) {
+    consumer.apply(RequestIdMiddleware).forRoutes('*');
+  }
+}
+
+describe('Request id (ExpressAdapter)', () => {
+  let app: INestApplication;
+
+  beforeEach(async () => {
+    const module = await Test.createTestingModule({
+      imports: [TestModule],
+    }).compile();
+
+    app = module.createNestApplication();
+    await app.init();
+  });
+
+  afterEach(() => app.close());
+
+  it('should generate a request id and expose the same value in the response header and to the route handler', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/request-id')
+      .expect(200);
+
+    const headerId = response.headers['x-request-id'];
+    expect(headerId).toBeDefined();
+    expect(response.body.id).toEqual(headerId);
+  });
+
+  it('should reuse an incoming X-Request-Id header instead of generating a new one', async () => {
+    const incomingId = 'client-supplied-id-123';
+
+    const response = await request(app.getHttpServer())
+      .get('/request-id')
+      .set('X-Request-Id', incomingId)
+      .expect(200);
+
+    expect(response.headers['x-request-id']).toEqual(incomingId);
+    expect(response.body.id).toEqual(incomingId);
+  });
+
+  it('should generate different ids for unrelated requests', async () => {
+    const [a, b] = await Promise.all([
+      request(app.getHttpServer()).get('/request-id'),
+      request(app.getHttpServer()).get('/request-id'),
+    ]);
+
+    expect(a.body.id).not.toEqual(b.body.id);
+  });
+});
