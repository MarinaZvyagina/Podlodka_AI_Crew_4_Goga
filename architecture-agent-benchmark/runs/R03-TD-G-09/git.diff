+import { AsyncLocalStorage } from 'async_hooks';
+
+const requestIdStorage = new AsyncLocalStorage<string>();
+
+/**
+ * Runs `callback` within a context that associates it (and everything it
+ * triggers asynchronously downstream, e.g. guards, interceptors and route
+ * handlers) with the given request id.
+ */
+export function runWithRequestId<T>(requestId: string, callback: () => T): T {
+  return requestIdStorage.run(requestId, callback);
+}
+
+/**
+ * Returns the request id associated with the currently executing request,
+ * regardless of which HTTP adapter (Express or Fastify) handled it.
+ *
+ * Returns `undefined` when called outside of a request initiated through
+ * `RequestIdMiddleware`.
+ */
+export function getRequestId(): string | undefined {
+  return requestIdStorage.getStore();
+}
