@@ -0,0 +1,78 @@
+import {
+  getRequestId,
+  REQUEST_ID_HEADER,
+} from '../../middleware/request-id/index.js';
+import { RequestIdMiddleware } from '../../middleware/request-id/request-id.middleware.js';
+
+describe('RequestIdMiddleware', () => {
+  let middleware: RequestIdMiddleware;
+  let res: { setHeader: (name: string, value: string) => void };
+  let setHeaderSpy: ReturnType<typeof vi.fn>;
+
+  beforeEach(() => {
+    middleware = new RequestIdMiddleware();
+    setHeaderSpy = vi.fn();
+    res = { setHeader: setHeaderSpy };
+  });
+
+  it('should generate a new request id when none was provided', () => {
+    return new Promise<void>(resolve => {
+      const req = { headers: {} };
+
+      middleware.use(req, res, () => {
+        const generatedId = setHeaderSpy.mock.calls[0][1];
+        expect(setHeaderSpy).toHaveBeenCalledWith(
+          REQUEST_ID_HEADER,
+          generatedId,
+        );
+        expect(generatedId).toEqual(expect.any(String));
+        expect(generatedId.length).toBeGreaterThan(0);
+        expect(getRequestId()).toEqual(generatedId);
+        resolve();
+      });
+    });
+  });
+
+  it('should reuse the incoming request id header instead of generating one', () => {
+    return new Promise<void>(resolve => {
+      const incomingId = 'incoming-correlation-id';
+      const req = { headers: { 'x-request-id': incomingId } };
+
+      middleware.use(req, res, () => {
+        expect(setHeaderSpy).toHaveBeenCalledWith(
+          REQUEST_ID_HEADER,
+          incomingId,
+        );
+        expect(getRequestId()).toEqual(incomingId);
+        resolve();
+      });
+    });
+  });
+
+  it('should generate two different ids across two unrelated requests', () => {
+    const ids: Array<string | undefined> = [];
+
+    return Promise.all([
+      new Promise<void>(resolve => {
+        middleware.use({ headers: {} }, res, () => {
+          ids.push(getRequestId());
+          resolve();
+        });
+      }),
+      new Promise<void>(resolve => {
+        middleware.use({ headers: {} }, res, () => {
+          ids.push(getRequestId());
+          resolve();
+        });
+      }),
+    ]).then(() => {
+      expect(ids[0]).toBeDefined();
+      expect(ids[1]).toBeDefined();
+      expect(ids[0]).not.toEqual(ids[1]);
+    });
+  });
+
+  it('should not expose a request id outside of a request context', () => {
+    expect(getRequestId()).toBeUndefined();
+  });
+});
