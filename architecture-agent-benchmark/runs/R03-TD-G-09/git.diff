@@ -0,0 +1,33 @@
+import { Injectable, type NestMiddleware } from '@nestjs/common';
+import { randomUUID } from 'crypto';
+import { REQUEST_ID_HEADER } from './request-id.constants.js';
+import { runWithRequestId } from './request-id-storage.js';
+
+/**
+ * Ensures every request is tagged with a request/correlation id:
+ * - reuses the incoming `X-Request-Id` header when the caller already
+ *   provides one (so the id stays stable across a chain of internal calls);
+ * - otherwise generates a new one;
+ * - reflects it back on the `X-Request-Id` response header;
+ * - exposes it to the rest of the request's async call chain via
+ *   `getRequestId()`, so application code doesn't need to read it back off
+ *   the response.
+ *
+ * Implemented as plain (req, res, next) middleware — rather than relying on
+ * any HTTP-adapter-specific API — so it behaves identically regardless of
+ * whether the app runs on `@nestjs/platform-express` or
+ * `@nestjs/platform-fastify`.
+ */
+@Injectable()
+export class RequestIdMiddleware implements NestMiddleware {
+  use(req: any, res: any, next: (error?: any) => void) {
+    const incomingHeader = req.headers?.[REQUEST_ID_HEADER.toLowerCase()];
+    const incomingId = Array.isArray(incomingHeader)
+      ? incomingHeader[0]
+      : incomingHeader;
+    const requestId = incomingId || randomUUID();
+
+    res.setHeader(REQUEST_ID_HEADER, requestId);
+    runWithRequestId(requestId, next);
+  }
+}
diff --git a/packages/core/test/middleware/request-id.middleware.spec.ts b/packages/core/test/middleware/request-id.middleware.spec.ts
