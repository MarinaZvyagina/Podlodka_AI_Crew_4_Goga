diff --git a/packages/excalidraw/tests/filename.test.ts b/packages/excalidraw/tests/filename.test.ts
new file mode 100644
index 0000000..539184d
--- /dev/null
+++ b/packages/excalidraw/tests/filename.test.ts
@@ -0,0 +1,26 @@
+import { sanitizeFilename } from "@excalidraw/common";
+
+describe("sanitizeFilename", () => {
+  it("leaves already-safe names untouched", () => {
+    expect(sanitizeFilename("my drawing")).toBe("my drawing");
+    expect(sanitizeFilename("My-Drawing_2024")).toBe("My-Drawing_2024");
+  });
+
+  it("replaces characters forbidden on Windows/macOS/Linux", () => {
+    expect(sanitizeFilename('a/b\\c:d*e?f"g<h>i|j')).toBe(
+      "a_b_c_d_e_f_g_h_i_j",
+    );
+  });
+
+  it("strips trailing dots and spaces", () => {
+    expect(sanitizeFilename("My Drawing.")).toBe("My Drawing");
+    expect(sanitizeFilename("My Drawing   ")).toBe("My Drawing");
+    expect(sanitizeFilename("My Drawing . . ")).toBe("My Drawing");
+  });
+
+  it("falls back to a default name when empty or whitespace-only", () => {
+    expect(sanitizeFilename("")).toBe("Untitled");
+    expect(sanitizeFilename("   ")).toBe("Untitled");
+    expect(sanitizeFilename("...")).toBe("Untitled");
+  });
+});
