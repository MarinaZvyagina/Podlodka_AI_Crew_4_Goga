+  describe("sanitizeFilename()", () => {
+    it("should replace characters illegal on Windows/macOS/Linux", () => {
+      expect(sanitizeFilename('a/b\\c:d*e?f"g<h>i|j')).toEqual(
+        "a_b_c_d_e_f_g_h_i_j",
+      );
+    });
+
+    it("should trim leading/trailing whitespace", () => {
+      expect(sanitizeFilename("  my drawing  ")).toEqual("my drawing");
+    });
+
+    it("should strip trailing dots (silently stripped by Windows)", () => {
+      expect(sanitizeFilename("my drawing...")).toEqual("my drawing");
+      expect(sanitizeFilename("my drawing. .")).toEqual("my drawing");
+    });
+
+    it("should preserve dots and spaces in the middle of the name", () => {
+      expect(sanitizeFilename("v1.2 final draft")).toEqual("v1.2 final draft");
+    });
+
+    it("should fall back to the default name when nothing safe remains", () => {
+      expect(sanitizeFilename("")).toEqual("Untitled");
+      expect(sanitizeFilename("   ")).toEqual("Untitled");
+      expect(sanitizeFilename("...")).toEqual("Untitled");
+    });
+
+    it("should support a custom fallback", () => {
+      expect(sanitizeFilename("   ", "fallback")).toEqual("fallback");
