+// characters reserved on Windows/macOS/Linux filesystems
+const ILLEGAL_FILENAME_CHARS_REGEX = /["*/:<>?\\|]/g;
+
+/**
+ * Turns a user-supplied drawing name into a filename that's safe to save
+ * on Windows, macOS, and Linux: illegal characters are replaced, and
+ * leading/trailing whitespace and trailing dots (which Windows silently
+ * strips) are removed. Falls back to `fallback` if nothing safe remains.
+ */
+export const sanitizeFilename = (
+  name: string,
+  fallback: string = DEFAULT_FILENAME,
+): string => {
+  const sanitized = name
+    .replace(ILLEGAL_FILENAME_CHARS_REGEX, "_")
+    .replace(/^\s+/, "")
+    .replace(/[.\s]+$/, "");
+
+  return sanitized || fallback;
+};
+
 /** hack for Array.isArray type guard not working with readonly value[] */
 export const isReadonlyArray = (value?: any): value is readonly any[] => {
   return Array.isArray(value);
