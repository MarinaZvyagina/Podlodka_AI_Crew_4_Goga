--- /dev/null
+++ b/packages/common/src/filename.ts
@@ -0,0 +1,22 @@
+import { DEFAULT_FILENAME } from "./constants";
+
+// characters reserved by Windows/macOS/Linux filesystems, plus ASCII control characters
+// eslint-disable-next-line no-control-regex
+const INVALID_FILENAME_CHARS_REGEX = /[<>:"/\\|?*\x00-\x1f]/g;
+
+// Windows silently strips trailing dots/spaces when saving, which would
+// otherwise desync the displayed name from what actually lands on disk
+const TRAILING_DOTS_OR_SPACES_REGEX = /[.\s]+$/;
+
+/**
+ * Returns a name sanitized for safe usage as a file name (without extension)
+ * on common desktop operating systems (Windows, macOS, Linux).
+ */
+export const sanitizeFilename = (name: string): string => {
+  const sanitized = name
+    .replace(INVALID_FILENAME_CHARS_REGEX, "_")
+    .replace(TRAILING_DOTS_OR_SPACES_REGEX, "")
+    .trim();
+
+  return sanitized || DEFAULT_FILENAME;
+};
