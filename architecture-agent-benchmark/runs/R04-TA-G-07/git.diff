+// chars disallowed (or unsafe) in file names on Windows, macOS and/or Linux,
+// plus ASCII control characters
+// eslint-disable-next-line no-control-regex
+const UNSAFE_FILENAME_CHARS_REGEX = /[<>:"/\\|?*\x00-\x1f]/g;
+// Windows silently strips trailing dots/spaces, which can otherwise cause
+// the saved file name to mismatch what the user typed
+const TRAILING_UNSAFE_CHARS_REGEX = /[.\s]+$/;
+
+/**
+ * Sanitizes a user-supplied drawing name so it can be safely used as a file
+ * name on common desktop OSes. Returns an empty string if nothing safe is
+ * left, letting the caller fall back to a default name.
+ */
+export const getSafeFilename = (name: string): string => {
+  return name
+    .replace(UNSAFE_FILENAME_CHARS_REGEX, "_")
+    .trim()
+    .replace(TRAILING_UNSAFE_CHARS_REGEX, "")
+    .trim();
+};
+
