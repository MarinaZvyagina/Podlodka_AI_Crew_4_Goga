+// characters disallowed in file names on Windows/macOS/Linux
+const ILLEGAL_FILENAME_CHARACTERS_REGEX = /[/\\:*?"<>|]/g;
+
+/**
+ * Turns a user-supplied name into a name that's safe to use as a file name
+ * on Windows, macOS, and Linux by stripping illegal characters and trailing
+ * dots/spaces (which Windows silently drops, so leaving them in would make
+ * the saved file name mismatch what was typed). Falls back to
+ * `DEFAULT_FILENAME` if nothing safe remains (e.g. empty or all spaces).
+ */
+export const sanitizeFilename = (name: string): string => {
+  const sanitized = name
+    .replace(ILLEGAL_FILENAME_CHARACTERS_REGEX, "")
+    .replace(/[.\s]+$/, "");
+
+  return sanitized || DEFAULT_FILENAME;
+};
