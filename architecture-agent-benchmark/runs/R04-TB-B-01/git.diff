+import { polygonArea } from "@excalidraw/math";
+
+import { isPathALoop } from "./utils";
+
+import type { ExcalidrawElement } from "./types";
+
+/**
+ * Returns the area enclosed by the element, in the element's own
+ * (unrotated) local coordinate space, or `null` if the element doesn't
+ * enclose a region (e.g. text, arrows, or open lines/freedraw paths).
+ *
+ * Rotation doesn't change the enclosed area, so `element.angle` is
+ * intentionally ignored.
+ */
+export const getElementArea = (element: ExcalidrawElement): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      // a diamond is a rhombus whose diagonals equal the bounding box's
+      // width and height, so its area is exactly half of the rectangle's
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    case "line":
+    case "freedraw":
+      return isPathALoop(element.points) ? polygonArea(element.points) : null;
+    default:
+      return null;
+  }
+};
