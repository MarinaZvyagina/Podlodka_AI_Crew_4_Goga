diff --git a/packages/element/tests/area.test.ts b/packages/element/tests/area.test.ts
new file mode 100644
index 0000000..f7299d0
--- /dev/null
+++ b/packages/element/tests/area.test.ts
@@ -0,0 +1,122 @@
+import { API } from "@excalidraw/excalidraw/tests/helpers/api";
+
+import type { LocalPoint } from "@excalidraw/math";
+
+import { getElementArea } from "../src/area";
+
+describe("Test getElementArea", () => {
+  it("returns width * height for a rectangle", () => {
+    const element = API.createElement({
+      type: "rectangle",
+      width: 100,
+      height: 50,
+    });
+
+    expect(getElementArea(element)).toBe(5000);
+  });
+
+  it("is unaffected by rotation", () => {
+    const element = API.createElement({
+      type: "rectangle",
+      width: 100,
+      height: 50,
+      angle: 0.7 as any,
+    });
+
+    expect(getElementArea(element)).toBe(5000);
+  });
+
+  it("returns half the bounding box area for a diamond", () => {
+    const element = API.createElement({
+      type: "diamond",
+      width: 100,
+      height: 50,
+    });
+
+    expect(getElementArea(element)).toBe(2500);
+  });
+
+  it("returns pi/4 * width * height for an ellipse", () => {
+    const element = API.createElement({
+      type: "ellipse",
+      width: 100,
+      height: 50,
+    });
+
+    expect(getElementArea(element)).toBeCloseTo((Math.PI * 100 * 50) / 4);
+  });
+
+  it("returns null for a text element", () => {
+    const element = API.createElement({ type: "text", text: "hello" });
+
+    expect(getElementArea(element)).toBeNull();
+  });
+
+  it("returns null for an arrow", () => {
+    const element = API.createElement({
+      type: "arrow",
+      points: [
+        [0, 0],
+        [100, 100],
+      ] as LocalPoint[],
+    });
+
+    expect(getElementArea(element)).toBeNull();
+  });
+
+  it("returns null for an open line", () => {
+    const element = API.createElement({
+      type: "line",
+      points: [
+        [0, 0],
+        [100, 0],
+        [100, 100],
+      ] as LocalPoint[],
+    });
+
+    expect(getElementArea(element)).toBeNull();
+  });
+
+  it("returns the polygon area for a closed line", () => {
+    const element = API.createElement({
+      type: "line",
+      points: [
+        [0, 0],
+        [100, 0],
+        [100, 100],
+        [0, 100],
+        [0, 0],
+      ] as LocalPoint[],
+    });
+
+    expect(getElementArea(element)).toBe(10000);
+  });
+
+  it("returns null for an open freedraw path", () => {
+    const element = API.createElement({
+      type: "freedraw",
+      points: [
+        [0, 0],
+        [100, 0],
+        [100, 100],
+      ] as LocalPoint[],
+    });
+
+    expect(getElementArea(element)).toBeNull();
+  });
+
+  it("returns the polygon area for a closed freedraw path", () => {
+    const element = API.createElement({
+      type: "freedraw",
+      points: [
+        [0, 0],
+        [100, 0],
+        [100, 100],
+        [0, 100],
+        [0, 0],
+      ] as LocalPoint[],
+    });
+
+    expect(getElementArea(element)).toBe(10000);
+  });
+});
diff --git a/packages/excalidraw/components/Stats/Area.tsx b/packages/excalidraw/components/Stats/Area.tsx
