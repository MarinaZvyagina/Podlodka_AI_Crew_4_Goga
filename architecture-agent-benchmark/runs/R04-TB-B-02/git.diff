+/**
+ * The area enclosed by an element, in the element's own (unrotated) local
+ * coordinate space, so it stays correct regardless of the element's angle.
+ * Returns null for elements that don't enclose a region (e.g. open lines,
+ * arrows, text).
+ */
+export const getElementArea = (element: ExcalidrawElement): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      // a diamond is a rhombus inscribed in its bounding box, whose
+      // diagonals equal the box's width and height
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    case "line":
+      return isLineElement(element) &&
+        element.polygon &&
+        isValidPolygon(element.points)
+        ? polygonArea(element.points)
+        : null;
+    case "freedraw":
+      return isPathALoop(element.points) ? polygonArea(element.points) : null;
+    default:
+      return null;
+  }
+};
