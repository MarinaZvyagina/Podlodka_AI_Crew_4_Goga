+/**
+ * The area enclosed by an element's outline, or `null` when the element
+ * doesn't enclose a region (e.g. an open line/freedraw path, an arrow, or
+ * text). Rotation-invariant since it's computed from the element's own
+ * (unrotated) geometry.
+ */
+export const getElementArea = (
+  element: ExcalidrawElement,
+  elementsMap: ElementsMap,
+): number | null => {
+  switch (element.type) {
+    case "rectangle":
+    case "diamond":
+    case "ellipse":
+    case "line":
+    case "freedraw":
+      break;
+    default:
+      return null;
+  }
+
+  const shape = getElementShape(element, elementsMap);
+
+  switch (shape.type) {
+    case "polygon":
+      return polygonArea(shape.data);
+    case "ellipse":
+      return Math.PI * shape.data.halfWidth * shape.data.halfHeight;
+    default:
+      return null;
+  }
+};
