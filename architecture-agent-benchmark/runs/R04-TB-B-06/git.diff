diff --git a/packages/excalidraw/components/Stats/Area.tsx b/packages/excalidraw/components/Stats/Area.tsx
new file mode 100644
index 0000000..42d6301
--- /dev/null
+++ b/packages/excalidraw/components/Stats/Area.tsx
@@ -0,0 +1,32 @@
+import { round } from "@excalidraw/math";
+
+import { getElementArea } from "@excalidraw/element";
+
+import type {
+  ElementsMap,
+  NonDeletedExcalidrawElement,
+} from "@excalidraw/element/types";
+
+import { t } from "../../i18n";
+
+interface AreaProps {
+  element: NonDeletedExcalidrawElement;
+  elementsMap: ElementsMap;
+}
+
+const Area = ({ element, elementsMap }: AreaProps) => {
+  const area = getElementArea(element, elementsMap);
+
+  if (area === null) {
+    return null;
+  }
+
+  return (
+    <div className="drag-input-container" data-testid="stats-area">
+      <div className="drag-input-label">{t("stats.area")}</div>
+      <div className="drag-input">{round(area, 2)}</div>
+    </div>
+  );
+};
+
+export default Area;
