+import { round } from "@excalidraw/math";
+import { polygonArea } from "@excalidraw/math";
+
+import { isValidPolygon } from "@excalidraw/element";
+
+import type { NonDeletedExcalidrawElement } from "@excalidraw/element/types";
+
+import { t } from "../../i18n";
+
+/**
+ * Returns the enclosed area of the element in its own (unrotated) local
+ * coordinate space, or `null` if the element doesn't represent a closed
+ * region (e.g. an open line, an arrow, or a text label). Area is rotation
+ * invariant, so callers don't need to account for `element.angle`.
+ */
+export const getElementArea = (
+  element: NonDeletedExcalidrawElement,
+): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return Math.PI * (element.width / 2) * (element.height / 2);
+    case "freedraw":
+      return polygonArea(element.points);
+    case "line":
+      return isValidPolygon(element.points)
+        ? polygonArea(element.points)
+        : null;
+    default:
+      return null;
+  }
+};
+
+const Area = ({ element }: { element: NonDeletedExcalidrawElement }) => {
+  const area = getElementArea(element);
+
+  if (area === null) {
+    return null;
+  }
+
+  return (
+    <>
+      <div>{t("stats.area")}</div>
+      <div>{round(area, 2)}</div>
+    </>
+  );
+};
+
+export default Area;
