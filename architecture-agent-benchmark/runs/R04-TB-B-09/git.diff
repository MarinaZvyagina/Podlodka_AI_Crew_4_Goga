+describe("getElementArea", () => {
+  it("computes area for a rectangle", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(rectangle)).toBe(5000);
+  });
+
+  it("computes area for a diamond as half its bounding box", () => {
+    const diamond = API.createElement({
+      type: "diamond",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(diamond)).toBe(2500);
+  });
+
+  it("computes area for an ellipse", () => {
+    const ellipse = API.createElement({
+      type: "ellipse",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(ellipse)).toBeCloseTo(Math.PI * 50 * 25, 5);
+  });
+
+  it("reports the same area for a rotated shape as for the unrotated one", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 50,
+    });
+    const rotatedRectangle = API.createElement({
+      type: "rectangle",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 50,
+      angle: degreesToRadians(45 as Degrees),
+    });
+    expect(getElementArea(rotatedRectangle)).toBe(getElementArea(rectangle));
+  });
+
+  it("computes area for a closed freedraw outline via the shoelace formula", () => {
+    const freedraw = API.createElement({
+      type: "freedraw",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 100,
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+      ],
+    });
+    expect(getElementArea(freedraw)).toBe(10000);
+  });
+
+  it("computes area for a closed (polygon) line", () => {
+    const closedLine = API.createElement({
+      type: "line",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 100,
+      polygon: true,
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+        pointFrom(0, 0),
+      ],
+    });
+    expect(getElementArea(closedLine)).toBe(10000);
+  });
+
+  it("returns null for an open line", () => {
+    const openLine = API.createElement({
+      type: "line",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 100,
+      polygon: false,
+      points: [pointFrom(0, 0), pointFrom(100, 0), pointFrom(100, 100)],
+    });
+    expect(getElementArea(openLine)).toBe(null);
+  });
+
+  it("returns null for an arrow", () => {
+    const arrow = API.createElement({
+      type: "arrow",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 100,
+    });
+    expect(getElementArea(arrow)).toBe(null);
+  });
+
+  it("returns null for a text element", () => {
+    const text = API.createElement({
+      type: "text",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 25,
+    });
+    expect(getElementArea(text)).toBe(null);
+  });
+});
