--- /dev/null
+++ b/packages/excalidraw/components/Stats/Area.tsx
@@ -0,0 +1,63 @@
+import { polygonArea, round } from "@excalidraw/math";
+
+import {
+  isFreeDrawElement,
+  isLineElement,
+  isPathALoop,
+  isValidPolygon,
+} from "@excalidraw/element";
+
+import type { NonDeletedExcalidrawElement } from "@excalidraw/element/types";
+
+interface AreaProps {
+  element: NonDeletedExcalidrawElement;
+}
+
+const getElementArea = (
+  element: NonDeletedExcalidrawElement,
+): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    case "line":
+      return isLineElement(element) &&
+        element.polygon &&
+        isValidPolygon(element.points)
+        ? polygonArea(element.points)
+        : null;
+    case "freedraw":
+      return isFreeDrawElement(element) && isPathALoop(element.points)
+        ? polygonArea(element.points)
+        : null;
+    default:
+      return null;
+  }
+};
+
+const Area = ({ element }: AreaProps) => {
+  const area = getElementArea(element);
+
+  if (area === null) {
+    return null;
+  }
+
+  return (
+    <div className="drag-input-container" data-testid="stats-area">
+      <div className="drag-input-label">A</div>
+      <input
+        className="drag-input"
+        autoComplete="off"
+        spellCheck="false"
+        readOnly
+        tabIndex={-1}
+        value={round(area, 2)}
+      />
+    </div>
+  );
+};
+
+export default Area;
