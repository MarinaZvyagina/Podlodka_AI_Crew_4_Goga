+/**
+ * Returns the enclosed area of an element in its own (unrotated) local
+ * coordinate space, or `null` if the element doesn't enclose a region
+ * (e.g. an open line, an arrow, or text). Since area is invariant under
+ * rotation, this is also the element's area at its current angle.
+ */
+export const getElementArea = (
+  element: NonDeletedExcalidrawElement,
+): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    case "line":
+    case "freedraw":
+      return isPathALoop(element.points) ? polygonArea(element.points) : null;
+    default:
+      return null;
+  }
+};
