+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+        pointFrom(0, 0),
+      ],
+    });
+    expect(getAreaValue(closedFreedraw)).toBe("10000");
+
+    const openFreedraw = API.createElement({
+      type: "freedraw",
+      points: [pointFrom(0, 0), pointFrom(100, 0), pointFrom(100, 100)],
+    });
+    expect(getAreaValue(openFreedraw)).toBe(null);
+  });
+
+  it("omits area for elements with no enclosed region, like arrows and text", () => {
