+
+  beforeAll(() => {
+    mockBoundingClientRect();
+  });
+
+  afterAll(() => {
+    restoreOriginalGetBoundingClientRect();
+  });
+
+  const getAreaValue = (element: ExcalidrawElement) => {
+    API.setElements([element]);
+    API.setSelectedElements([element] as NonDeletedExcalidrawElement[]);
+    elementStats = stats?.querySelector("#elementStats");
+    const areaRow = queryByTestId(elementStats!, "stats-area");
+    return areaRow?.lastElementChild?.textContent ?? null;
+  };
+
+  it("reports width * height for a rectangle, unaffected by rotation", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 200,
+      height: 100,
+    });
+    expect(getAreaValue(rectangle)).toBe("20000");
+
+    const rotatedRectangle = API.createElement({
+      type: "rectangle",
+      width: 200,
+      height: 100,
+      angle: degreesToRadians(45 as Degrees),
+    });
+    expect(getAreaValue(rotatedRectangle)).toBe("20000");
+  });
+
+  it("reports (width * height) / 2 for a diamond", () => {
+    const diamond = API.createElement({
+      type: "diamond",
+      width: 200,
+      height: 100,
+    });
+    expect(getAreaValue(diamond)).toBe("10000");
+  });
+
+  it("reports π * width * height / 4 for an ellipse", () => {
+    const ellipse = API.createElement({
+      type: "ellipse",
+      width: 200,
+      height: 100,
+    });
+    expect(getAreaValue(ellipse)).toBe(
+      round((Math.PI * 200 * 100) / 4, 2).toString(),
+    );
+  });
+
+  it("reports area for a closed line but omits it for an open line", () => {
+    const closedLine = API.createElement({
+      type: "line",
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+        pointFrom(0, 0),
+      ],
+    });
+    expect(getAreaValue(closedLine)).toBe("10000");
+
+    const openLine = API.createElement({
+      type: "line",
+      points: [pointFrom(0, 0), pointFrom(100, 0), pointFrom(100, 100)],
+    });
+    expect(getAreaValue(openLine)).toBe(null);
+  });
+
+  it("reports area for a closed (looped) freedraw shape but omits it for an open one", () => {
