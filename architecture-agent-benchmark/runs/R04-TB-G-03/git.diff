+/**
+ * The area enclosed by an element, or `null` if the element doesn't enclose
+ * a region (e.g. an open line, an arrow, or text). Computed from the
+ * element's local (unrotated) geometry, so it's unaffected by rotation.
+ *
+ * Line and freedraw elements only enclose a region once their endpoints
+ * meet, matching the same check ({@link isPathALoop}) the renderer uses to
+ * decide whether to fill them.
+ */
+export const getElementArea = (element: ExcalidrawElement): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    case "line":
+    case "freedraw":
+      return isPathALoop(element.points) ? polygonArea(element.points) : null;
+    default:
+      return null;
+  }
+};
