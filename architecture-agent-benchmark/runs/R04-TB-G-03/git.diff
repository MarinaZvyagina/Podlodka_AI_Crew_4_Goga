+describe("getElementArea", () => {
+  it("should compute a rectangle's area from width and height", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(rectangle)).toBeCloseTo(5000, EPSILON_DIGITS);
+  });
+
+  it("should be unaffected by rotation", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 100,
+      height: 50,
+      angle: Math.PI / 4,
+    });
+    expect(getElementArea(rectangle)).toBeCloseTo(5000, EPSILON_DIGITS);
+  });
+
+  it("should compute a diamond's area as half the bounding box", () => {
+    const diamond = API.createElement({
+      type: "diamond",
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(diamond)).toBeCloseTo(2500, EPSILON_DIGITS);
+  });
+
+  it("should compute an ellipse's area", () => {
+    const ellipse = API.createElement({
+      type: "ellipse",
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(ellipse)).toBeCloseTo(
+      Math.PI * 50 * 25,
+      EPSILON_DIGITS,
+    );
+  });
+
+  it("should compute a closed line's (polygon) area", () => {
+    const square: readonly LocalPoint[] = [
+      pointFrom(0, 0),
+      pointFrom(100, 0),
+      pointFrom(100, 100),
+      pointFrom(0, 100),
+      pointFrom(0, 0),
+    ];
+    const line = API.createElement({
+      type: "line",
+      points: square,
+      polygon: true,
+    });
+    expect(getElementArea(line)).toBeCloseTo(10000, EPSILON_DIGITS);
+  });
+
+  it("should return null for an open line", () => {
+    const line = API.createElement({
+      type: "line",
+      points: [pointFrom(0, 0), pointFrom(100, 0), pointFrom(100, 100)],
+    });
+    expect(getElementArea(line)).toBeNull();
+  });
+
+  it("should compute a closed (looped) freedraw shape's area", () => {
+    const square: readonly LocalPoint[] = [
+      pointFrom(0, 0),
+      pointFrom(100, 0),
+      pointFrom(100, 100),
+      pointFrom(0, 100),
+      pointFrom(0, 0),
+    ];
+    const freedraw = API.createElement({
+      type: "freedraw",
+      points: square,
+    });
+    expect(getElementArea(freedraw)).toBeCloseTo(10000, EPSILON_DIGITS);
+  });
+
+  it("should return null for an open freedraw shape", () => {
+    const freedraw = API.createElement({
+      type: "freedraw",
+      points: [pointFrom(0, 0), pointFrom(100, 0), pointFrom(100, 100)],
+    });
+    expect(getElementArea(freedraw)).toBeNull();
+  });
+
+  it("should return null for an arrow", () => {
+    const arrow = API.createElement({
+      type: "arrow",
+      points: [pointFrom(0, 0), pointFrom(100, 0), pointFrom(0, 0)],
+    });
+    expect(getElementArea(arrow)).toBeNull();
+  });
+
+  it("should return null for a text element", () => {
+    const text = API.createElement({ type: "text", text: "hello" });
+    expect(getElementArea(text)).toBeNull();
+  });
+});
