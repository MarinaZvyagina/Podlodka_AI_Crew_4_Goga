+describe("stats area", () => {
+  beforeEach(async () => {
+    localStorage.clear();
+    renderStaticScene.mockClear();
+    reseed(7);
+    setDateTimeForTests("201933152653");
+
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+
+    API.setElements([]);
+
+    fireEvent.contextMenu(GlobalTestState.interactiveCanvas, {
+      button: 2,
+      clientX: 1,
+      clientY: 1,
+    });
+    const contextMenu = UI.queryContextMenu();
+    fireEvent.click(queryByTestId(contextMenu!, "stats")!);
+    stats = UI.queryStats();
+  });
+
+  beforeAll(() => {
+    mockBoundingClientRect();
+  });
+
+  afterAll(() => {
+    restoreOriginalGetBoundingClientRect();
+  });
+
+  const selectAndGetAreaText = (element: ExcalidrawElement) => {
+    API.setElements([element]);
+    API.setSelectedElements([element] as NonDeletedExcalidrawElement[]);
+    elementStats = stats?.querySelector("#elementStats");
+    return queryByTestId(elementStats!, "stats-area")?.textContent;
+  };
+
+  it("shows width x height for a rectangle", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 200,
+      height: 100,
+    });
+    expect(selectAndGetAreaText(rectangle)).toBe("20000");
+  });
+
+  it("stays the same when a rectangle is rotated", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 200,
+      height: 100,
+      angle: 45,
+    });
+    expect(selectAndGetAreaText(rectangle)).toBe("20000");
+  });
+
+  it("is half of width x height for a diamond", () => {
+    const diamond = API.createElement({
+      type: "diamond",
+      width: 200,
+      height: 100,
+    });
+    expect(selectAndGetAreaText(diamond)).toBe("10000");
+  });
+
+  it("is pi * (w/2) * (h/2) for an ellipse", () => {
+    const ellipse = API.createElement({
+      type: "ellipse",
+      width: 200,
+      height: 100,
+    });
+    expect(selectAndGetAreaText(ellipse)).toBe(
+      String(Math.round(((Math.PI * 200 * 100) / 4) * 100) / 100),
+    );
+  });
+
+  it("is shown for a closed (polygon) line", () => {
+    const line = API.createElement({
+      type: "line",
+      polygon: true,
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+        pointFrom(0, 0),
+      ],
+    });
+    expect(selectAndGetAreaText(line)).toBe("10000");
+  });
+
+  it("is shown for a closed (looped) freedraw shape", () => {
+    const freedraw = API.createElement({
+      type: "freedraw",
+      points: [
+        pointFrom(0, 0),
+        pointFrom(50, 0),
+        pointFrom(50, 50),
+        pointFrom(0, 50),
+        pointFrom(0, 0),
+      ],
+    });
+    expect(selectAndGetAreaText(freedraw)).toBe("2500");
+  });
+
+  it("is omitted for an open line", () => {
+    const line = API.createElement({
+      type: "line",
+      points: [pointFrom(0, 0), pointFrom(100, 100)],
+    });
+    expect(selectAndGetAreaText(line)).toBeUndefined();
+  });
+
+  it("is omitted for an open (non-looped) freedraw shape", () => {
+    const freedraw = API.createElement({
+      type: "freedraw",
+      points: [pointFrom(0, 0), pointFrom(50, 0), pointFrom(50, 50)],
+    });
+    expect(selectAndGetAreaText(freedraw)).toBeUndefined();
+  });
+
+  it("is omitted for an arrow", () => {
+    const arrow = API.createElement({ type: "arrow" });
+    expect(selectAndGetAreaText(arrow)).toBeUndefined();
+  });
+
+  it("is omitted for a text element", () => {
+    const text = API.createElement({ type: "text", text: "Hello!" });
+    expect(selectAndGetAreaText(text)).toBeUndefined();
+  });
+});
