+import { polygonArea, round } from "@excalidraw/math";
+
+import { isPathALoop } from "@excalidraw/element";
+
+import type { NonDeletedExcalidrawElement } from "@excalidraw/element/types";
+
+import { t } from "../../i18n";
+
+interface AreaProps {
+  element: NonDeletedExcalidrawElement;
+}
+
+// area, in local (unrotated) coordinates, for shapes that enclose a region;
+// `undefined` for shapes without a meaningful area (e.g. open lines, text)
+const getElementArea = (
+  element: NonDeletedExcalidrawElement,
+): number | undefined => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      // a diamond is a rhombus whose diagonals are the bounding box sides
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    case "line":
+    case "freedraw":
+      if (isPathALoop(element.points)) {
+        return polygonArea(element.points);
+      }
+      return undefined;
+    default:
+      return undefined;
+  }
+};
+
+const Area = ({ element }: AreaProps) => {
+  const area = getElementArea(element);
+
+  if (area === undefined) {
+    return null;
+  }
+
+  return (
+    <>
+      <div>{t("stats.area")}</div>
+      <div data-testid="stats-area">{round(area, 2)}</div>
+    </>
+  );
+};
+
+export default Area;
