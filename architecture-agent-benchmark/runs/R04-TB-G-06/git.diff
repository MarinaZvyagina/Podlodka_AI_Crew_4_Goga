+const AREA_SUPPORTED_ELEMENT_TYPES = new Set<ExcalidrawElement["type"]>([
+  "rectangle",
+  "diamond",
+  "ellipse",
+  "line",
+  "freedraw",
+]);
+
+/**
+ * get the area enclosed by an excalidraw element's outline, in canvas units
+ * squared, or `null` if the element doesn't enclose a region (e.g. an open
+ * line/freedraw stroke, a linear arrow, or a non-shape element like text).
+ *
+ * the result is rotation-invariant, matching the element's actual outline
+ * regardless of its `angle`.
+ */
+export const getElementArea = (
+  element: ExcalidrawElement,
+  elementsMap: ElementsMap,
+): number | null => {
+  if (!AREA_SUPPORTED_ELEMENT_TYPES.has(element.type)) {
+    return null;
+  }
+
+  const shape = getElementShape(element, elementsMap);
+
+  switch (shape.type) {
+    case "polygon":
+      return polygonArea(shape.data);
+    case "ellipse":
+      return Math.PI * shape.data.halfWidth * shape.data.halfHeight;
+    default:
+      return null;
+  }
+};
