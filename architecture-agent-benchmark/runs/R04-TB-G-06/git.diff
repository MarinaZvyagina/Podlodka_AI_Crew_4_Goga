diff --git a/packages/element/tests/getElementArea.test.ts b/packages/element/tests/getElementArea.test.ts
new file mode 100644
index 0000000..e54aff3
--- /dev/null
+++ b/packages/element/tests/getElementArea.test.ts
@@ -0,0 +1,167 @@
+import { pointFrom, degreesToRadians } from "@excalidraw/math";
+
+import { arrayToMap } from "@excalidraw/common";
+
+import { API } from "@excalidraw/excalidraw/tests/helpers/api";
+
+import { getElementArea } from "../src/shape";
+
+import type { ExcalidrawElement } from "../src/types";
+
+const area = (element: ExcalidrawElement) =>
+  getElementArea(element, arrayToMap([element]));
+
+describe("getElementArea", () => {
+  it("computes a rectangle's area", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 100,
+      height: 50,
+    });
+    expect(area(rectangle)).toBeCloseTo(5000, 5);
+  });
+
+  it("is unaffected by rotation", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 100,
+      height: 50,
+      angle: degreesToRadians(37 as any),
+    });
+    expect(area(rectangle)).toBeCloseTo(5000, 5);
+  });
+
+  it("computes a diamond's area as half its bounding box", () => {
+    const diamond = API.createElement({
+      type: "diamond",
+      width: 100,
+      height: 50,
+    });
+    expect(area(diamond)).toBeCloseTo((100 * 50) / 2, 5);
+  });
+
+  it("computes an ellipse's area", () => {
+    const ellipse = API.createElement({
+      type: "ellipse",
+      width: 100,
+      height: 50,
+    });
+    expect(area(ellipse)).toBeCloseTo(Math.PI * 50 * 25, 3);
+  });
+
+  it("reports a rotated ellipse's true area, not its larger bounding box", () => {
+    const rotatedEllipse = API.createElement({
+      type: "ellipse",
+      width: 100,
+      height: 50,
+      angle: degreesToRadians(45 as any),
+    });
+    expect(area(rotatedEllipse)).toBeCloseTo(Math.PI * 50 * 25, 3);
+  });
+
+  it("computes a closed, filled freedraw stroke's area", () => {
+    const freedraw = API.createElement({
+      type: "freedraw",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 100,
+      backgroundColor: "#ffffff",
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+        pointFrom(0, 0),
+      ],
+    });
+    expect(area(freedraw)).toBeCloseTo(10000, 5);
+  });
+
+  it("omits area for an open freedraw stroke", () => {
+    const freedraw = API.createElement({
+      type: "freedraw",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 100,
+      backgroundColor: "#ffffff",
+      points: [pointFrom(0, 0), pointFrom(100, 0), pointFrom(100, 100)],
+    });
+    expect(area(freedraw)).toBeNull();
+  });
+
+  it("omits area for a closed but unfilled freedraw stroke", () => {
+    const freedraw = API.createElement({
+      type: "freedraw",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 100,
+      backgroundColor: "transparent",
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+        pointFrom(0, 0),
+      ],
+    });
+    expect(area(freedraw)).toBeNull();
+  });
+
+  it("computes a closed, filled line's area", () => {
+    const line = API.createElement({
+      type: "line",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 100,
+      backgroundColor: "#ffffff",
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+        pointFrom(0, 0),
+      ],
+    });
+    expect(area(line)).toBeCloseTo(10000, 5);
+  });
+
+  it("omits area for an open line", () => {
+    const line = API.createElement({
+      type: "line",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 100,
+      points: [pointFrom(0, 0), pointFrom(100, 100)],
+    });
+    expect(area(line)).toBeNull();
+  });
+
+  it("omits area for an arrow", () => {
+    const arrow = API.createElement({
+      type: "arrow",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 100,
+      backgroundColor: "#ffffff",
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+        pointFrom(0, 0),
+      ],
+    });
+    expect(area(arrow)).toBeNull();
+  });
+
+  it("omits area for a text element", () => {
+    const text = API.createElement({ type: "text", width: 100, height: 20 });
+    expect(area(text)).toBeNull();
+  });
+});
