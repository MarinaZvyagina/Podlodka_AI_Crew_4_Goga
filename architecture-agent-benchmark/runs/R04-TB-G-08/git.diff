+++ b/packages/excalidraw/components/Stats/Area.ts
@@ -0,0 +1,70 @@
+import {
+  pointFrom,
+  pointRotateRads,
+  polygonArea,
+  polygonFromPoints,
+} from "@excalidraw/math";
+
+import {
+  getElementAbsoluteCoords,
+  isFreeDrawElement,
+  isLineElement,
+  isPathALoop,
+  isValidPolygon,
+} from "@excalidraw/element";
+
+import type { ElementsMap, ExcalidrawElement } from "@excalidraw/element/types";
+
+import type { GlobalPoint } from "@excalidraw/math";
+
+/** whether the element outlines a region with a well-defined, non-misleading area */
+export const elementEnclosesArea = (element: ExcalidrawElement): boolean => {
+  switch (element.type) {
+    case "rectangle":
+    case "diamond":
+    case "ellipse":
+      return true;
+    default:
+      if (isLineElement(element)) {
+        return element.polygon && isValidPolygon(element.points);
+      }
+      if (isFreeDrawElement(element)) {
+        return isPathALoop(element.points);
+      }
+      return false;
+  }
+};
+
+/** area covered by the element, invariant to rotation */
+export const getElementArea = (
+  element: ExcalidrawElement,
+  elementsMap: ElementsMap,
+): number => {
+  if (element.type === "rectangle") {
+    return element.width * element.height;
+  }
+
+  if (element.type === "diamond") {
+    return (element.width * element.height) / 2;
+  }
+
+  if (element.type === "ellipse") {
+    return Math.PI * (element.width / 2) * (element.height / 2);
+  }
+
+  if (isLineElement(element) || isFreeDrawElement(element)) {
+    const [, , , , cx, cy] = getElementAbsoluteCoords(element, elementsMap);
+    const center = pointFrom<GlobalPoint>(cx, cy);
+    const points = element.points.map(([px, py]) =>
+      pointRotateRads(
+        pointFrom<GlobalPoint>(element.x + px, element.y + py),
+        center,
+        element.angle,
+      ),
+    );
+
+    return polygonArea(polygonFromPoints(points));
+  }
+
+  return 0;
+};
