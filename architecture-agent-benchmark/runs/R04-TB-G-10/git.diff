index 0000000..e68ce4e
--- /dev/null
+++ b/packages/excalidraw/components/Stats/Area.tsx
@@ -0,0 +1,34 @@
+import { round } from "@excalidraw/math";
+
+import { getElementArea } from "@excalidraw/element";
+
+import type { NonDeletedExcalidrawElement } from "@excalidraw/element/types";
+
+import { t } from "../../i18n";
+import { InlineIcon } from "../InlineIcon";
+import { areaIcon } from "../icons";
+
+interface AreaProps {
+  element: NonDeletedExcalidrawElement;
+}
+
+const Area = ({ element }: AreaProps) => {
+  const area = getElementArea(element);
+
+  if (area === null) {
+    return null;
+  }
+
+  return (
+    <div className="drag-input-container" data-testid="stats-area">
+      <div className="drag-input-label" title={t("stats.area")}>
+        <InlineIcon icon={areaIcon} />
+      </div>
+      <div className="drag-input" aria-label={t("stats.area")}>
+        {round(area, 2)}
+      </div>
+    </div>
+  );
+};
+
+export default Area;
