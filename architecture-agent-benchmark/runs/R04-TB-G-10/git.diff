+/**
+ * The enclosed area of an element, in the same units as `width`/`height`,
+ * or `null` if the element doesn't enclose a region (e.g. an open line,
+ * an arrow, or text). Rotation doesn't change enclosed area, so this is
+ * computed straight from each shape's local geometry regardless of `angle`.
+ */
+export const getElementArea = (element: ExcalidrawElement): number | null => {
+  if (isLineElement(element)) {
+    return element.polygon && isValidPolygon(element.points)
+      ? polygonArea(element.points)
+      : null;
+  }
+
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    case "freedraw":
+      return isPathALoop(element.points) ? polygonArea(element.points) : null;
+    default:
+      return null;
+  }
+};
