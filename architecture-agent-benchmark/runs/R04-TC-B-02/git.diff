diff --git a/packages/excalidraw/actions/actionToggleShapeCaptions.tsx b/packages/excalidraw/actions/actionToggleShapeCaptions.tsx
new file mode 100644
index 0000000..26c92f4
--- /dev/null
+++ b/packages/excalidraw/actions/actionToggleShapeCaptions.tsx
@@ -0,0 +1,30 @@
+import { CODES, KEYS } from "@excalidraw/common";
+
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { eyeIcon } from "../components/icons";
+
+import { register } from "./register";
+
+export const actionToggleShapeCaptions = register({
+  name: "toggleShapeCaptions",
+  icon: eyeIcon,
+  label: "labels.toggleCaptions",
+  viewMode: true,
+  trackEvent: {
+    category: "canvas",
+    predicate: (appState) => !appState.showBoundTextCaptions,
+  },
+  perform(elements, appState) {
+    return {
+      appState: {
+        ...appState,
+        showBoundTextCaptions: !this.checked!(appState),
+      },
+      captureUpdate: CaptureUpdateAction.EVENTUALLY,
+    };
+  },
+  checked: (appState) => appState.showBoundTextCaptions,
+  keyTest: (event) =>
+    !event[KEYS.CTRL_OR_CMD] && event.altKey && event.code === CODES.C,
+});
