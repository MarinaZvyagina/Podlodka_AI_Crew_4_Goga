new file mode 100644
index 0000000..a902e86
--- /dev/null
+++ b/packages/excalidraw/actions/actionToggleBoundTextCaptions.tsx
@@ -0,0 +1,33 @@
+import { CODES, KEYS } from "@excalidraw/common";
+
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { eyeClosedIcon } from "../components/icons";
+
+import { register } from "./register";
+
+export const actionToggleBoundTextCaptions = register({
+  name: "boundTextCaptions",
+  icon: eyeClosedIcon,
+  label: "labels.toggleCaptions",
+  viewMode: true,
+  trackEvent: {
+    category: "canvas",
+    predicate: (appState) => appState.boundTextCaptionsEnabled,
+  },
+  perform(elements, appState) {
+    return {
+      appState: {
+        ...appState,
+        boundTextCaptionsEnabled: !this.checked!(appState),
+      },
+      captureUpdate: CaptureUpdateAction.EVENTUALLY,
+    };
+  },
+  checked: (appState) => appState.boundTextCaptionsEnabled,
+  keyTest: (event) =>
+    !event[KEYS.CTRL_OR_CMD] &&
+    event.altKey &&
+    !event.shiftKey &&
+    event.code === CODES.C,
+});
