@@ -0,0 +1,259 @@
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { Keyboard } from "../tests/helpers/ui";
+import { render } from "../tests/test-utils";
+
+import { actionSnapToGrid } from "./actionSnapToGrid";
+
+const { h } = window;
+
+const GRID_SIZE = 20;
+
+describe("snap to grid action", () => {
+  it("snaps the position and size of the selected element to the grid", async () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 103,
+      y: 108,
+      width: 74,
+      height: 66,
+    });
+    await render(
+      <Excalidraw
+        initialData={{ elements: [rect], appState: { gridSize: GRID_SIZE } }}
+      />,
+    );
+    API.setSelectedElements([rect]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated = API.getElement(rect);
+    expect(updated.x % GRID_SIZE).toBe(0);
+    expect(updated.y % GRID_SIZE).toBe(0);
+    expect(updated.width % GRID_SIZE).toBe(0);
+    expect(updated.height % GRID_SIZE).toBe(0);
+    expect(updated.x).toBe(100);
+    expect(updated.y).toBe(100);
+    expect(updated.width).toBe(80);
+    expect(updated.height).toBe(60);
+  });
+
+  it("snaps every shape independently when nothing is selected", async () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 11,
+      y: 9,
+      width: 41,
+      height: 39,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 202,
+      y: 198,
+      width: 21,
+      height: 19,
+    });
+    await render(
+      <Excalidraw
+        initialData={{
+          elements: [rect1, rect2],
+          appState: { gridSize: GRID_SIZE },
+        }}
+      />,
+    );
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated1 = API.getElement(rect1);
+    const updated2 = API.getElement(rect2);
+
+    expect(updated1.x).toBe(20);
+    expect(updated1.y).toBe(0);
+    expect(updated1.width).toBe(40);
+    expect(updated1.height).toBe(40);
+
+    expect(updated2.x).toBe(200);
+    expect(updated2.y).toBe(200);
+    expect(updated2.width).toBe(20);
+    expect(updated2.height).toBe(20);
+  });
+
+  it("snaps only the selected elements, leaving others untouched", async () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 11,
+      y: 9,
+      width: 41,
+      height: 39,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 202,
+      y: 198,
+      width: 21,
+      height: 19,
+    });
+    await render(
+      <Excalidraw
+        initialData={{
+          elements: [rect1, rect2],
+          appState: { gridSize: GRID_SIZE },
+        }}
+      />,
+    );
+    API.setSelectedElements([rect1]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated1 = API.getElement(rect1);
+    const updated2 = API.getElement(rect2);
+
+    expect(updated1.x).toBe(20);
+    expect(updated1.y).toBe(0);
+
+    expect(updated2.x).toBe(202);
+    expect(updated2.y).toBe(198);
+    expect(updated2.width).toBe(21);
+    expect(updated2.height).toBe(19);
+  });
+
+  it("snaps multiple selected shapes independently, not as a group", async () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 11,
+      y: 9,
+      width: 41,
+      height: 39,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 202,
+      y: 198,
+      width: 21,
+      height: 19,
+    });
+    await render(
+      <Excalidraw
+        initialData={{
+          elements: [rect1, rect2],
+          appState: { gridSize: GRID_SIZE },
+        }}
+      />,
+    );
+    API.setSelectedElements([rect1, rect2]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated1 = API.getElement(rect1);
+    const updated2 = API.getElement(rect2);
+
+    // each element snaps to its own nearest grid line, independent of the
+    // other element's offset within the (non-existent) group
+    expect(updated1.x).toBe(20);
+    expect(updated1.y).toBe(0);
+    expect(updated2.x).toBe(200);
+    expect(updated2.y).toBe(200);
+  });
+
+  it("undoes the snap in a single step", async () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 103,
+      y: 108,
+      width: 74,
+      height: 66,
+    });
+    await render(
+      <Excalidraw
+        handleKeyboardGlobally={true}
+        initialData={{ elements: [rect], appState: { gridSize: GRID_SIZE } }}
+      />,
+    );
+    API.setSelectedElements([rect]);
+
+    API.executeAction(actionSnapToGrid);
+    expect(API.getElement(rect).x).toBe(100);
+    expect(API.getUndoStack().length).toBe(1);
+
+    Keyboard.undo();
+
+    const reverted = API.getElement(rect);
+    expect(reverted.x).toBe(103);
+    expect(reverted.y).toBe(108);
+    expect(reverted.width).toBe(74);
+    expect(reverted.height).toBe(66);
+  });
+
+  it("moves bound text along with its container after the container snaps, instead of snapping it independently", async () => {
+    const container = API.createElement({
+      type: "rectangle",
+      x: 101,
+      y: 99,
+      width: 121,
+      height: 81,
+    });
+    const text = API.createElement({
+      type: "text",
+      containerId: container.id,
+      width: 60,
+      height: 25,
+      fontSize: 20,
+      text: "hi",
+    });
+    await render(
+      <Excalidraw
+        initialData={{
+          elements: [container, text],
+          appState: { gridSize: GRID_SIZE },
+        }}
+      />,
+    );
+    h.app.scene.mutateElement(container, {
+      boundElements: [{ type: "text", id: text.id }],
+    });
+    API.setSelectedElements([container]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updatedContainer = API.getElement(container);
+    const updatedText = API.getElement(text);
+
+    expect(updatedContainer.x % GRID_SIZE).toBe(0);
+    expect(updatedContainer.y % GRID_SIZE).toBe(0);
+    expect(updatedContainer.width % GRID_SIZE).toBe(0);
+    expect(updatedContainer.height % GRID_SIZE).toBe(0);
+
+    // the bound text is still attached to (and contained within) its
+    // container, and moved along with it rather than being left behind
+    // at its pre-snap position
+    expect(updatedText.containerId).toBe(container.id);
+    expect(updatedText.x).toBeGreaterThanOrEqual(updatedContainer.x);
+    expect(updatedText.y).toBeGreaterThanOrEqual(updatedContainer.y);
+    expect(updatedText.x + updatedText.width).toBeLessThanOrEqual(
+      updatedContainer.x + updatedContainer.width,
+    );
+  });
+
+  it("bumps the element version so the change is collaboration-syncable", async () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 103,
+      y: 108,
+      width: 74,
+      height: 66,
+    });
+    await render(
+      <Excalidraw
+        initialData={{ elements: [rect], appState: { gridSize: GRID_SIZE } }}
+      />,
+    );
+    API.setSelectedElements([rect]);
+
+    const versionBefore = h.elements[0].version;
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect).version).toBeGreaterThan(versionBefore);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..8956b58
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,109 @@
+import { getNonDeletedElements } from "@excalidraw/element";
+import { isBoundToContainer } from "@excalidraw/element";
+import { resizeSingleElement } from "@excalidraw/element";
+import { updateBoundElements } from "@excalidraw/element";
+import { CaptureUpdateAction } from "@excalidraw/element";
+import { arrayToMap } from "@excalidraw/common";
+
+import type { Scene } from "@excalidraw/element";
+import type {
+  ExcalidrawElement,
+  NonDeletedExcalidrawElement,
+} from "@excalidraw/element/types";
+
+import { gridIcon } from "../components/icons";
+
+import { register } from "./register";
+
+/**
+ * Snaps each target element's position and size to the grid independently
+ * (not as a group), mirroring what a user would get by nudging/resizing the
+ * element by hand with grid snapping enabled.
+ */
+const snapElementsToGrid = (
+  elements: readonly ExcalidrawElement[],
+  targetElements: readonly NonDeletedExcalidrawElement[],
+  scene: Scene,
+  gridSize: number,
+): ExcalidrawElement[] => {
+  const elementsMap = scene.getNonDeletedElementsMap();
+
+  const updatedElements = targetElements
+    // bound text position/size is derived from its container, so it's
+    // snapped implicitly when the container is resized below
+    .filter((element) => !isBoundToContainer(element))
+    .map((element) => {
+      const snappedX = Math.round(element.x / gridSize) * gridSize;
+      const snappedY = Math.round(element.y / gridSize) * gridSize;
+
+      const movedElement = scene.mutateElement(element, {
+        x: snappedX,
+        y: snappedY,
+      });
+
+      updateBoundElements(movedElement, scene);
+
+      const nextWidth = Math.max(
+        gridSize,
+        Math.round(movedElement.width / gridSize) * gridSize,
+      );
+      const nextHeight = Math.max(
+        gridSize,
+        Math.round(movedElement.height / gridSize) * gridSize,
+      );
+
+      if (
+        nextWidth !== movedElement.width ||
+        nextHeight !== movedElement.height
+      ) {
+        resizeSingleElement(
+          nextWidth,
+          nextHeight,
+          movedElement,
+          movedElement,
+          elementsMap,
+          scene,
+          "se",
+        );
+      }
+
+      return movedElement;
+    });
+
+  const updatedElementsMap = arrayToMap(updatedElements);
+
+  return elements.map(
+    (element) => updatedElementsMap.get(element.id) || element,
+  );
+};
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  trackEvent: { category: "element" },
+  perform: (elements, appState, _, app) => {
+    const selectedElements = app.scene.getSelectedElements(appState);
+    const targetElements =
+      selectedElements.length > 0
+        ? selectedElements
+        : getNonDeletedElements(elements).filter(
+            (element) => !element.locked && !isBoundToContainer(element),
+          );
+
+    if (targetElements.length === 0) {
+      return false;
+    }
+
+    return {
+      elements: snapElementsToGrid(
+        elements,
+        targetElements,
+        app.scene,
+        appState.gridSize,
+      ),
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
