--- /dev/null
+++ b/packages/element/src/snapToGrid.ts
@@ -0,0 +1,147 @@
+import { getGridPoint, MIN_WIDTH_OR_HEIGHT } from "@excalidraw/common";
+
+import type { AppState, NullableGridSize } from "@excalidraw/excalidraw/types";
+
+import { updateBoundElements } from "./binding";
+import { getCommonBoundingBox } from "./bounds";
+import { getSelectedElementsByGroup } from "./groups";
+import { resizeSingleElement } from "./resizeElements";
+import {
+  isBoundToContainer,
+  isFrameLikeElement,
+  isFreeDrawElement,
+  isLinearElement,
+} from "./typeChecks";
+
+import { getNonDeletedElements } from ".";
+
+import type { Scene } from "./Scene";
+import type { NonDeletedExcalidrawElement } from "./types";
+
+// elements whose size isn't a plain "bounding box" (their geometry is defined
+// by `points`, or they have special resize semantics) are only repositioned,
+// never resized, so we don't risk distorting them or unbinding arrows
+const isResizableToGrid = (element: NonDeletedExcalidrawElement) =>
+  !isLinearElement(element) &&
+  !isFreeDrawElement(element) &&
+  !isFrameLikeElement(element);
+
+const snapValueToGrid = (value: number, gridSize: number) =>
+  Math.max(Math.round(value / gridSize) * gridSize, gridSize);
+
+/**
+ * Snaps the position (and, where safe, size) of each selected "unit" to the
+ * grid independently — a unit is either a standalone element (plus its bound
+ * text, if any) or an explicit multi-element group, mirroring how alignment
+ * treats groups as a single rigid body.
+ */
+export const snapElementsToGrid = (
+  selectedElements: readonly NonDeletedExcalidrawElement[],
+  scene: Scene,
+  appState: Readonly<Pick<AppState, "selectedGroupIds" | "editingGroupId">>,
+  gridSize: number,
+): NonDeletedExcalidrawElement[] => {
+  const groups = getSelectedElementsByGroup(
+    [...selectedElements],
+    scene.getNonDeletedElementsMap(),
+    appState,
+  ).map(getNonDeletedElements);
+
+  return groups.flatMap((group) => {
+    const primaryElements = group.filter(
+      (element) => !isBoundToContainer(element),
+    );
+
+    return primaryElements.length === 1
+      ? snapSingleElementToGrid(primaryElements[0], group, scene, gridSize)
+      : snapGroupToGrid(group, scene, gridSize);
+  });
+};
+
+const snapGroupToGrid = (
+  group: readonly NonDeletedExcalidrawElement[],
+  scene: Scene,
+  gridSize: number,
+) => {
+  const { minX, minY } = getCommonBoundingBox(group);
+  const [snappedMinX, snappedMinY] = getGridPoint(
+    minX,
+    minY,
+    gridSize as NullableGridSize,
+  );
+  const translation = { x: snappedMinX - minX, y: snappedMinY - minY };
+
+  if (translation.x === 0 && translation.y === 0) {
+    return [...group];
+  }
+
+  return group.map((element) => {
+    const updated = scene.mutateElement(element, {
+      x: element.x + translation.x,
+      y: element.y + translation.y,
+    });
+    updateBoundElements(element, scene, { simultaneouslyUpdated: group });
+    return updated;
+  });
+};
+
+const snapSingleElementToGrid = (
+  element: NonDeletedExcalidrawElement,
+  group: readonly NonDeletedExcalidrawElement[],
+  scene: Scene,
+  gridSize: number,
+) => {
+  const [snappedX, snappedY] = getGridPoint(
+    element.x,
+    element.y,
+    gridSize as NullableGridSize,
+  );
+  const translation = { x: snappedX - element.x, y: snappedY - element.y };
+
+  let latest = element;
+
+  if (translation.x !== 0 || translation.y !== 0) {
+    latest = scene.mutateElement(latest, {
+      x: latest.x + translation.x,
+      y: latest.y + translation.y,
+    });
+
+    // bound text (and any other dependent riding in the same unit) moves
+    // rigidly with its container instead of snapping to its own grid point
+    group.forEach((dependent) => {
+      if (dependent.id !== element.id) {
+        scene.mutateElement(dependent, {
+          x: dependent.x + translation.x,
+          y: dependent.y + translation.y,
+        });
+      }
+    });
+
+    updateBoundElements(latest, scene, { simultaneouslyUpdated: group });
+  }
+
+  if (isResizableToGrid(latest)) {
+    const nextWidth = Math.max(
+      snapValueToGrid(latest.width, gridSize),
+      MIN_WIDTH_OR_HEIGHT,
+    );
+    const nextHeight = Math.max(
+      snapValueToGrid(latest.height, gridSize),
+      MIN_WIDTH_OR_HEIGHT,
+    );
+
+    if (nextWidth !== latest.width || nextHeight !== latest.height) {
+      resizeSingleElement(
+        nextWidth,
+        nextHeight,
+        latest,
+        latest,
+        scene.getNonDeletedElementsMap(),
+        scene,
+        "se",
+      );
+    }
+  }
+
+  return [...group];
+};
diff --git a/packages/excalidraw/actions/actionSnapToGrid.test.tsx b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
new file mode 100644
index 0000000..e284846
