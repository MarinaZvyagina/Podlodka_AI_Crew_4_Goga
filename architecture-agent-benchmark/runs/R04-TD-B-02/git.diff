+++ b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
@@ -0,0 +1,96 @@
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { Keyboard, UI } from "../tests/helpers/ui";
+import { render } from "../tests/test-utils";
+
+import { actionSnapToGrid } from "./actionSnapToGrid";
+
+const { h } = window;
+
+describe("snap to grid action", () => {
+  beforeEach(async () => {
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+  });
+
+  it("snaps position and size of each selected element independently to the grid", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 41,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 101,
+      y: 8,
+      width: 34,
+      height: 96,
+    });
+    const [origX1, origX2] = [rect1.x, rect2.x];
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([rect1, rect2]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated1 = h.elements.find((el) => el.id === rect1.id)!;
+    const updated2 = h.elements.find((el) => el.id === rect2.id)!;
+
+    // gridSize defaults to 20 — every snapped coordinate is a multiple of it
+    expect(updated1.x % 20).toBe(0);
+    expect(updated1.y % 20).toBe(0);
+    expect(updated1.width % 20).toBe(0);
+    expect(updated1.height % 20).toBe(0);
+
+    expect(updated2.x % 20).toBe(0);
+    expect(updated2.y % 20).toBe(0);
+    expect(updated2.width % 20).toBe(0);
+    expect(updated2.height % 20).toBe(0);
+
+    // each shape rounds to its own nearest grid line, not a shared delta
+    expect(updated1.x - origX1).not.toBe(updated2.x - origX2);
+  });
+
+  it("applies to every element on the canvas when nothing is selected", () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 13,
+      y: 19,
+      width: 44,
+      height: 58,
+    });
+    API.setElements([rect]);
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated = h.elements.find((el) => el.id === rect.id)!;
+    expect(updated.x % 20).toBe(0);
+    expect(updated.y % 20).toBe(0);
+    expect(updated.width % 20).toBe(0);
+    expect(updated.height % 20).toBe(0);
+  });
+
+  it("is undoable in a single step", () => {
+    const rect = UI.createElement("rectangle", {
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 41,
+    });
+    API.setSelectedElements([rect]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const snapped = h.elements.find((el) => el.id === rect.id)!;
+    expect(snapped.x).not.toBe(12);
+
+    Keyboard.undo();
+
+    const reverted = h.elements.find((el) => el.id === rect.id)!;
+    expect(reverted.x).toBe(12);
+    expect(reverted.y).toBe(27);
+    expect(reverted.width).toBe(53);
+    expect(reverted.height).toBe(41);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..9c5a35b
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,53 @@
+import { arrayToMap } from "@excalidraw/common";
+
+import {
+  CaptureUpdateAction,
+  getNonDeletedElements,
+  snapElementsToGrid,
+  updateFrameMembershipOfSelectedElements,
+} from "@excalidraw/element";
+
+import { gridIcon } from "../components/icons";
+
+import { register } from "./register";
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  keywords: ["grid", "snap", "align"],
+  trackEvent: { category: "element" },
+  predicate: (elements) => getNonDeletedElements(elements).length > 0,
+  perform: (elements, appState, _, app) => {
+    const selectedElements = app.scene.getSelectedElements(appState);
+    const targetElements =
+      selectedElements.length > 0
+        ? selectedElements
+        : app.scene.getNonDeletedElements();
+
+    if (targetElements.length === 0) {
+      return false;
+    }
+
+    const updatedElements = snapElementsToGrid(
+      targetElements,
+      app.scene,
+      appState,
+      appState.gridSize,
+    );
+
+    const updatedElementsMap = arrayToMap(updatedElements);
+
+    return {
+      appState,
+      elements: updateFrameMembershipOfSelectedElements(
+        elements.map(
+          (element) => updatedElementsMap.get(element.id) || element,
+        ),
+        appState,
+        app,
+      ),
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
