diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..459868a
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,113 @@
+import { CODES, KEYS, getGridPoint } from "@excalidraw/common";
+
+import {
+  CaptureUpdateAction,
+  getNonDeletedElements,
+  getBoundTextElement,
+  handleBindTextResize,
+  updateBoundElements,
+  isFreeDrawElement,
+  isLinearElement,
+  isTextElement,
+} from "@excalidraw/element";
+
+import type { NonDeletedExcalidrawElement } from "@excalidraw/element/types";
+
+import { magnetIcon } from "../components/icons";
+
+import { getSelectedElements } from "../scene";
+
+import { register } from "./register";
+
+import type { AppClassProperties, NullableGridSize } from "../types";
+
+// text/linear/freedraw elements have geometry (font metrics, point arrays)
+// that isn't safely representable by an arbitrary width/height, so for those
+// we only snap their position, matching what dragging them would do
+const canSnapSize = (element: NonDeletedExcalidrawElement) =>
+  !isTextElement(element) &&
+  !isLinearElement(element) &&
+  !isFreeDrawElement(element);
+
+const snapElementToGrid = (
+  element: NonDeletedExcalidrawElement,
+  gridSize: NullableGridSize,
+  app: AppClassProperties,
+  simultaneouslyUpdated: readonly NonDeletedExcalidrawElement[],
+) => {
+  const [nextX, nextY] = getGridPoint(element.x, element.y, gridSize);
+
+  if (!canSnapSize(element)) {
+    if (nextX !== element.x || nextY !== element.y) {
+      app.scene.mutateElement(element, { x: nextX, y: nextY });
+      updateBoundElements(element, app.scene, { simultaneouslyUpdated });
+    }
+    return;
+  }
+
+  const [nextX2, nextY2] = getGridPoint(
+    element.x + element.width,
+    element.y + element.height,
+    gridSize,
+  );
+
+  const nextWidth = nextX2 - nextX;
+  const nextHeight = nextY2 - nextY;
+
+  const width = nextWidth > 0 ? nextWidth : element.width;
+  const height = nextHeight > 0 ? nextHeight : element.height;
+
+  if (
+    nextX === element.x &&
+    nextY === element.y &&
+    width === element.width &&
+    height === element.height
+  ) {
+    return;
+  }
+
+  app.scene.mutateElement(element, { x: nextX, y: nextY, width, height });
+
+  if (getBoundTextElement(element, app.scene.getNonDeletedElementsMap())) {
+    handleBindTextResize(element, app.scene, "nw");
+  }
+
+  updateBoundElements(element, app.scene, { simultaneouslyUpdated });
+};
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: magnetIcon,
+  trackEvent: { category: "element" },
+  predicate: (elements) => getNonDeletedElements(elements).length > 0,
+  perform: (elements, appState, _, app) => {
+    const nonDeletedElements = getNonDeletedElements(elements);
+    const selectedElements = getSelectedElements(nonDeletedElements, appState, {
+      includeBoundTextElement: false,
+      includeElementsInFrames: true,
+    });
+    const targetElements =
+      selectedElements.length > 0 ? selectedElements : nonDeletedElements;
+
+    const gridSize = appState.gridSize as NullableGridSize;
+
+    targetElements
+      // bound text snaps together with its container
+      .filter((element) => !(isTextElement(element) && element.containerId))
+      .forEach((element) =>
+        snapElementToGrid(element, gridSize, app, targetElements),
+      );
+
+    return {
+      elements,
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+  keyTest: (event) =>
+    !event[KEYS.CTRL_OR_CMD] &&
+    event.altKey &&
+    !event.shiftKey &&
+    event.code === CODES.G,
+});
