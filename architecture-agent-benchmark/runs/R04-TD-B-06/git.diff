diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..709e5d8
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,118 @@
+import { getGridPoint } from "@excalidraw/common";
+
+import {
+  CaptureUpdateAction,
+  getNonDeletedElements,
+  isBoundToContainer,
+  isElbowArrow,
+  isFrameLikeElement,
+  resizeSingleElement,
+  updateFrameMembershipOfSelectedElements,
+} from "@excalidraw/element";
+
+import type {
+  ExcalidrawElement,
+  NonDeletedExcalidrawElement,
+} from "@excalidraw/element/types";
+
+import { getSelectedElements } from "../scene";
+
+import { gridIcon } from "../components/icons";
+
+import { register } from "./register";
+
+import type { AppClassProperties, AppState, NullableGridSize } from "../types";
+
+// snaps a single element's position and size to the grid, matching what a
+// user would get by dragging its "nw" then "se" resize handles with grid
+// snapping on: the top-left corner moves to the nearest grid line first
+// (opposite corner held fixed), then the bottom-right corner does the same
+// (now-snapped top-left corner held fixed).
+const snapElementToGrid = (
+  element: NonDeletedExcalidrawElement,
+  gridSize: NullableGridSize,
+  app: AppClassProperties,
+) => {
+  const elementsMap = app.scene.getNonDeletedElementsMap();
+
+  const origX = element.x;
+  const origY = element.y;
+  const [snappedX, snappedY] = getGridPoint(origX, origY, gridSize);
+  const [snappedRight, snappedBottom] = getGridPoint(
+    origX + element.width,
+    origY + element.height,
+    gridSize,
+  );
+
+  resizeSingleElement(
+    origX + element.width - snappedX,
+    origY + element.height - snappedY,
+    element,
+    element,
+    elementsMap,
+    app.scene,
+    "nw",
+  );
+
+  resizeSingleElement(
+    snappedRight - snappedX,
+    snappedBottom - snappedY,
+    element,
+    element,
+    elementsMap,
+    app.scene,
+    "se",
+  );
+};
+
+const snapSelectedElementsToGrid = (
+  elements: readonly ExcalidrawElement[],
+  appState: Readonly<AppState>,
+  app: AppClassProperties,
+) => {
+  const nonDeletedElements = getNonDeletedElements(elements);
+
+  const selectedElements = getSelectedElements(nonDeletedElements, appState, {
+    includeElementsInFrames: true,
+  });
+
+  const targetElements = (
+    selectedElements.length ? selectedElements : nonDeletedElements
+  ).filter(
+    (element) =>
+      !isBoundToContainer(element) &&
+      !isFrameLikeElement(element) &&
+      !isElbowArrow(element),
+  );
+
+  if (!targetElements.length) {
+    return elements;
+  }
+
+  const gridSize = appState.gridSize as NullableGridSize;
+  targetElements.forEach((element) =>
+    snapElementToGrid(element, gridSize, app),
+  );
+
+  const elementsMap = app.scene.getNonDeletedElementsMap();
+
+  return updateFrameMembershipOfSelectedElements(
+    elements.map((element) => elementsMap.get(element.id) ?? element),
+    appState,
+    app,
+  );
+};
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  trackEvent: { category: "element" },
+  perform: (elements, appState, _, app) => {
+    return {
+      elements: snapSelectedElementsToGrid(elements, appState, app),
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
