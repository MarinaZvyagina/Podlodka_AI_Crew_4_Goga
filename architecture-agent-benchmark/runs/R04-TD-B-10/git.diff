diff --git a/packages/excalidraw/tests/snapToGrid.test.tsx b/packages/excalidraw/tests/snapToGrid.test.tsx
new file mode 100644
index 0000000..47b1272
--- /dev/null
+++ b/packages/excalidraw/tests/snapToGrid.test.tsx
@@ -0,0 +1,142 @@
+import { DEFAULT_GRID_SIZE } from "@excalidraw/common";
+
+import type { NonDeletedExcalidrawElement } from "@excalidraw/element/types";
+
+import { actionSnapToGrid } from "../actions";
+import { Excalidraw } from "../index";
+
+import { API } from "./helpers/api";
+import { Keyboard, UI } from "./helpers/ui";
+import { render, unmountComponent } from "./test-utils";
+
+beforeEach(async () => {
+  unmountComponent();
+  localStorage.clear();
+  sessionStorage.clear();
+
+  await render(<Excalidraw handleKeyboardGlobally={true} />);
+});
+
+const snapped = (value: number) =>
+  Math.round(value / DEFAULT_GRID_SIZE) * DEFAULT_GRID_SIZE;
+
+const enableGridMode = () =>
+  API.setAppState({
+    gridModeEnabled: true,
+    gridSize: DEFAULT_GRID_SIZE,
+  });
+
+describe("snap to grid", () => {
+  it("snaps position and size of the selected element to the grid", () => {
+    // created with grid mode off, so the shape lands off-grid, like a
+    // freehand drawing or a pasted shape would
+    const rect = UI.createElement("rectangle", {
+      x: 7,
+      y: 13,
+      width: 37,
+      height: 44,
+    });
+
+    const expectedX = snapped(7);
+    const expectedY = snapped(13);
+    const expectedWidth = snapped(7 + 37) - expectedX;
+    const expectedHeight = snapped(13 + 44) - expectedY;
+
+    enableGridMode();
+    API.executeAction(actionSnapToGrid);
+
+    const element = rect.get();
+    expect(element.x).toBe(expectedX);
+    expect(element.y).toBe(expectedY);
+    expect(element.width).toBe(expectedWidth);
+    expect(element.height).toBe(expectedHeight);
+  });
+
+  it("snaps every element on the canvas when nothing is selected", () => {
+    const rect1 = UI.createElement("rectangle", {
+      x: 3,
+      y: 3,
+      width: 30,
+      height: 30,
+    });
+    const rect2 = UI.createElement("rectangle", {
+      x: 111,
+      y: 122,
+      width: 41,
+      height: 19,
+    });
+
+    enableGridMode();
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const element1 = rect1.get();
+    const element2 = rect2.get();
+
+    expect(element1.x).toBe(snapped(3));
+    expect(element1.y).toBe(snapped(3));
+    expect(element2.x).toBe(snapped(111));
+    expect(element2.y).toBe(snapped(122));
+  });
+
+  it("snaps multiple selected elements independently, not as a single group", () => {
+    const rect1 = UI.createElement("rectangle", {
+      x: 4,
+      y: 4,
+      width: 30,
+      height: 30,
+    });
+    const rect2 = UI.createElement("rectangle", {
+      x: 96,
+      y: 4,
+      width: 30,
+      height: 30,
+    });
+
+    enableGridMode();
+    API.setSelectedElements([
+      rect1.get(),
+      rect2.get(),
+    ] as NonDeletedExcalidrawElement[]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const element1 = rect1.get();
+    const element2 = rect2.get();
+
+    // each element rounds to its own nearest grid line independently,
+    // rather than preserving the original 92px gap between them
+    expect(element1.x).toBe(snapped(4));
+    expect(element2.x).toBe(snapped(96));
+  });
+
+  it("reverts the snap in a single undo step", () => {
+    const rect = UI.createElement("rectangle", {
+      x: 7,
+      y: 13,
+      width: 37,
+      height: 44,
+    });
+
+    const original = {
+      x: rect.get().x,
+      y: rect.get().y,
+      width: rect.get().width,
+      height: rect.get().height,
+    };
+
+    enableGridMode();
+    API.executeAction(actionSnapToGrid);
+
+    expect(rect.get().x).not.toBe(original.x);
+
+    Keyboard.undo();
+
+    const restored = rect.get();
+    expect(restored.x).toBe(original.x);
+    expect(restored.y).toBe(original.y);
+    expect(restored.width).toBe(original.width);
+    expect(restored.height).toBe(original.height);
+  });
+});
