diff --git a/packages/element/src/snapToGrid.ts b/packages/element/src/snapToGrid.ts
new file mode 100644
index 0000000..72c74f4
--- /dev/null
+++ b/packages/element/src/snapToGrid.ts
@@ -0,0 +1,82 @@
+import { getGridPoint } from "@excalidraw/common";
+
+import type { NullableGridSize } from "@excalidraw/excalidraw/types";
+
+import { updateBoundElements } from "./binding";
+import { resizeSingleElement } from "./resizeElements";
+import { getBoundTextElement } from "./textElement";
+import { isArrowElement, isBoundToContainer } from "./typeChecks";
+
+import type { Scene } from "./Scene";
+import type { NonDeletedExcalidrawElement } from "./types";
+
+/**
+ * Snaps each element's position and size to the nearest grid line
+ * independently, as if it had been dragged (and, if needed, resized) by
+ * a tiny amount with grid snapping enabled.
+ */
+export const snapElementsToGrid = (
+  targetElements: readonly NonDeletedExcalidrawElement[],
+  gridSize: NullableGridSize,
+  scene: Scene,
+): NonDeletedExcalidrawElement[] => {
+  const elementsMap = scene.getNonDeletedElementsMap();
+
+  return targetElements.map((element) => {
+    // bound text is repositioned/resized together with its container instead
+    // of being snapped independently
+    if (isBoundToContainer(element)) {
+      return element;
+    }
+
+    const [snappedX, snappedY] = getGridPoint(element.x, element.y, gridSize);
+    const [snappedX2, snappedY2] = getGridPoint(
+      element.x + element.width,
+      element.y + element.height,
+      gridSize,
+    );
+
+    const deltaX = snappedX - element.x;
+    const deltaY = snappedY - element.y;
+
+    if (deltaX !== 0 || deltaY !== 0) {
+      scene.mutateElement(element, { x: snappedX, y: snappedY });
+
+      const boundText = getBoundTextElement(element, elementsMap);
+      if (boundText) {
+        scene.mutateElement(boundText, {
+          x: boundText.x + deltaX,
+          y: boundText.y + deltaY,
+        });
+      }
+
+      updateBoundElements(element, scene);
+    }
+
+    // resizing an arrow's bounding box unbinds its endpoints even when its
+    // size doesn't actually change, so bound arrows are only repositioned
+    if (!isArrowElement(element)) {
+      const snappedWidth = snappedX2 - snappedX;
+      const snappedHeight = snappedY2 - snappedY;
+
+      if (
+        snappedWidth > 0 &&
+        snappedHeight > 0 &&
+        (snappedWidth !== element.width || snappedHeight !== element.height)
+      ) {
+        resizeSingleElement(
+          snappedWidth,
+          snappedHeight,
+          element,
+          element,
+          elementsMap,
+          scene,
+          "se",
+          { shouldMaintainAspectRatio: false, shouldResizeFromCenter: false },
+        );
+      }
+    }
+
+    return element;
+  });
+};
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..9765032
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,58 @@
+import { getNonDeletedElements } from "@excalidraw/element";
+import { snapElementsToGrid } from "@excalidraw/element";
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { KEYS, arrayToMap } from "@excalidraw/common";
+
+import type { ExcalidrawElement } from "@excalidraw/element/types";
+
+import { getSelectedElements } from "../scene";
+import { isGridModeEnabled } from "../snapping";
+
+import { register } from "./register";
+
+import type { AppClassProperties, AppState } from "../types";
+
+const snapToGridSelectedOrAllElements = (
+  elements: readonly ExcalidrawElement[],
+  appState: Readonly<AppState>,
+  app: AppClassProperties,
+) => {
+  const nonDeletedElements = getNonDeletedElements(elements);
+  const selectedElements = getSelectedElements(nonDeletedElements, appState);
+
+  const targetElements = (
+    selectedElements.length > 0 ? selectedElements : nonDeletedElements
+  ).filter((element) => !element.locked);
+
+  const updatedElements = snapElementsToGrid(
+    targetElements,
+    app.getEffectiveGridSize(),
+    app.scene,
+  );
+
+  const updatedElementsMap = arrayToMap(updatedElements);
+
+  return elements.map(
+    (element) => updatedElementsMap.get(element.id) || element,
+  );
+};
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  keywords: ["grid", "align", "snap"],
+  trackEvent: { category: "element" },
+  predicate: (elements, appState, appProps, app) =>
+    isGridModeEnabled(app) &&
+    getNonDeletedElements(elements).some((element) => !element.locked),
+  perform: (elements, appState, _, app) => {
+    return {
+      elements: snapToGridSelectedOrAllElements(elements, appState, app),
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+  keyTest: (event) =>
+    event[KEYS.CTRL_OR_CMD] && event.altKey && event.key === KEYS.G,
+});
