new file mode 100644
index 0000000..3034f80
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,94 @@
+import { MIN_WIDTH_OR_HEIGHT, getGridPoint } from "@excalidraw/common";
+
+import {
+  CaptureUpdateAction,
+  getNonDeletedElements,
+  isBoundToContainer,
+  resizeSingleElement,
+  updateBoundElements,
+} from "@excalidraw/element";
+
+import { arrayToMap } from "@excalidraw/common";
+
+import type {
+  NonDeletedExcalidrawElement,
+  NonDeletedSceneElementsMap,
+} from "@excalidraw/element/types";
+
+import type { Scene } from "@excalidraw/element";
+
+import { getSelectedElements } from "../scene";
+
+import { gridIcon } from "../components/icons";
+
+import { register } from "./register";
+
+import type { NullableGridSize } from "../types";
+
+const snapElementToGrid = (
+  element: NonDeletedExcalidrawElement,
+  gridSize: NullableGridSize,
+  elementsMap: NonDeletedSceneElementsMap,
+  scene: Scene,
+) => {
+  const [nextX, nextY] = getGridPoint(element.x, element.y, gridSize);
+  if (nextX !== element.x || nextY !== element.y) {
+    scene.mutateElement(element, { x: nextX, y: nextY });
+    updateBoundElements(element, scene);
+  }
+
+  const [snappedWidth, snappedHeight] = getGridPoint(
+    element.width,
+    element.height,
+    gridSize,
+  );
+  const nextWidth = Math.max(MIN_WIDTH_OR_HEIGHT, snappedWidth);
+  const nextHeight = Math.max(MIN_WIDTH_OR_HEIGHT, snappedHeight);
+
+  if (nextWidth !== element.width || nextHeight !== element.height) {
+    resizeSingleElement(
+      nextWidth,
+      nextHeight,
+      element,
+      element,
+      elementsMap,
+      scene,
+      "se",
+    );
+  }
+};
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  keywords: ["grid", "align", "snap"],
+  trackEvent: { category: "element" },
+  predicate: (elements) => getNonDeletedElements(elements).length > 0,
+  perform: (elements, appState, _, app) => {
+    const nonDeletedElements = getNonDeletedElements(elements);
+    const selectedElements = getSelectedElements(nonDeletedElements, appState, {
+      includeElementsInFrames: true,
+    });
+    const targetElements = (
+      selectedElements.length > 0 ? selectedElements : nonDeletedElements
+    ).filter((element) => !isBoundToContainer(element));
+
+    const gridSize = appState.gridSize as NullableGridSize;
+    const elementsMap = app.scene.getNonDeletedElementsMap();
+
+    targetElements.forEach((element) => {
+      snapElementToGrid(element, gridSize, elementsMap, app.scene);
+    });
+
+    const targetElementsMap = arrayToMap(targetElements);
+
+    return {
+      elements: elements.map(
+        (element) => targetElementsMap.get(element.id) || element,
+      ),
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
