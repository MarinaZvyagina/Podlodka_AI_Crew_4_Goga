diff --git a/packages/excalidraw/tests/snapToGrid.test.tsx b/packages/excalidraw/tests/snapToGrid.test.tsx
new file mode 100644
index 0000000..c97df53
--- /dev/null
+++ b/packages/excalidraw/tests/snapToGrid.test.tsx
@@ -0,0 +1,165 @@
+import { pointFrom } from "@excalidraw/math";
+
+import type { LocalPoint } from "@excalidraw/math";
+
+import type { ExcalidrawLinearElement } from "@excalidraw/element/types";
+
+import { actionSnapToGrid } from "../actions";
+import { Excalidraw } from "../index";
+
+import { API } from "./helpers/api";
+import { Keyboard, UI } from "./helpers/ui";
+import { GlobalTestState, render, waitFor } from "./test-utils";
+
+beforeEach(async () => {
+  localStorage.clear();
+
+  Object.assign(document, {
+    elementFromPoint: () => GlobalTestState.canvas,
+  });
+  await render(<Excalidraw handleKeyboardGlobally={true} />);
+  API.setAppState({ gridSize: 20 });
+});
+
+describe("snap to grid action", () => {
+  it("snaps the position and size of a selected rectangle to the nearest grid line", async () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      x: 13,
+      y: 27,
+      width: 91,
+      height: 48,
+    });
+    API.setElements([rectangle]);
+    API.setSelectedElements([rectangle]);
+
+    API.executeAction(actionSnapToGrid);
+
+    await waitFor(() => {
+      const el = API.getElement(rectangle);
+      expect(el.x).toBe(20);
+      expect(el.y).toBe(20);
+      expect(el.width).toBe(100);
+      expect(el.height).toBe(40);
+    });
+  });
+
+  it("snaps each selected shape independently, not as a single group", async () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      x: 13,
+      y: 13,
+      width: 100,
+      height: 100,
+    });
+    const ellipse = API.createElement({
+      type: "ellipse",
+      x: 209,
+      y: 4,
+      width: 40,
+      height: 40,
+    });
+    API.setElements([rectangle, ellipse]);
+    API.setSelectedElements([rectangle, ellipse]);
+
+    API.executeAction(actionSnapToGrid);
+
+    await waitFor(() => {
+      const el1 = API.getElement(rectangle);
+      const el2 = API.getElement(ellipse);
+      expect([el1.x, el1.y]).toEqual([20, 20]);
+      expect([el2.x, el2.y]).toEqual([200, 0]);
+    });
+  });
+
+  it("applies to every element on the canvas when nothing is selected", async () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      x: 13,
+      y: 13,
+      width: 100,
+      height: 100,
+    });
+    const ellipse = API.createElement({
+      type: "ellipse",
+      x: 209,
+      y: 4,
+      width: 40,
+      height: 40,
+    });
+    API.setElements([rectangle, ellipse]);
+    API.clearSelection();
+
+    API.executeAction(actionSnapToGrid);
+
+    await waitFor(() => {
+      const el1 = API.getElement(rectangle);
+      const el2 = API.getElement(ellipse);
+      expect([el1.x, el1.y]).toEqual([20, 20]);
+      expect([el2.x, el2.y]).toEqual([200, 0]);
+    });
+  });
+
+  it("is undoable in a single step", async () => {
+    const rectangle = UI.createElement("rectangle", {
+      x: 13,
+      y: 27,
+      width: 91,
+      height: 48,
+    });
+
+    API.executeAction(actionSnapToGrid);
+
+    await waitFor(() => {
+      const el = API.getElement(rectangle);
+      expect(el.x).toBe(20);
+      expect(el.y).toBe(20);
+    });
+
+    Keyboard.undo();
+
+    await waitFor(() => {
+      const el = API.getElement(rectangle);
+      expect(el.x).toBe(13);
+      expect(el.y).toBe(27);
+      expect(el.width).toBe(91);
+      expect(el.height).toBe(48);
+    });
+  });
+
+  it("keeps a bound arrow attached to a snapped rectangle", async () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      x: 13,
+      y: 13,
+      width: 100,
+      height: 100,
+    });
+    const arrow = API.createElement({
+      type: "arrow",
+      x: 113,
+      y: 63,
+      width: 100,
+      height: 0,
+      points: [pointFrom<LocalPoint>(0, 0), pointFrom<LocalPoint>(100, 0)],
+      endBinding: {
+        elementId: rectangle.id,
+        fixedPoint: [0.5, 0.5],
+        mode: "orbit",
+      },
+    }) as ExcalidrawLinearElement;
+
+    API.setElements([rectangle, arrow]);
+    API.setSelectedElements([rectangle]);
+
+    API.executeAction(actionSnapToGrid);
+
+    await waitFor(() => {
+      const snappedRectangle = API.getElement(rectangle);
+      const snappedArrow = API.getElement(arrow) as ExcalidrawLinearElement;
+      expect(snappedRectangle.x).toBe(20);
+      expect(snappedRectangle.y).toBe(20);
+      expect(snappedArrow.endBinding?.elementId).toBe(rectangle.id);
+    });
+  });
+});
