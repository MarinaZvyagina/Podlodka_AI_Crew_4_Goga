diff --git a/packages/excalidraw/tests/snapToGrid.test.tsx b/packages/excalidraw/tests/snapToGrid.test.tsx
new file mode 100644
index 0000000..39f9ba9
--- /dev/null
+++ b/packages/excalidraw/tests/snapToGrid.test.tsx
@@ -0,0 +1,135 @@
+import { vi } from "vitest";
+
+import { actionSnapToGrid } from "../actions";
+import { Excalidraw } from "../index";
+
+import { API } from "./helpers/api";
+import { Keyboard, Pointer, UI } from "./helpers/ui";
+import { GlobalTestState, render, unmountComponent } from "./test-utils";
+
+import type { NormalizedZoomValue } from "../types";
+
+const { h } = window;
+const mouse = new Pointer("mouse");
+
+beforeEach(async () => {
+  unmountComponent();
+
+  mouse.reset();
+  localStorage.clear();
+  sessionStorage.clear();
+  vi.clearAllMocks();
+
+  Object.assign(document, {
+    elementFromPoint: () => GlobalTestState.canvas,
+  });
+  await render(<Excalidraw autoFocus={true} handleKeyboardGlobally={true} />);
+  API.setAppState({
+    zoom: { value: 1 as NormalizedZoomValue },
+  });
+});
+
+// grid mode is enabled *after* elements are created, mirroring the ticket's
+// scenario: shapes are drawn freehand, then grid snapping is turned on
+const enableGridMode = () => {
+  API.setAppState({ gridModeEnabled: true, gridSize: 20 });
+};
+
+describe("snap to grid", () => {
+  it("snaps the position and size of the selected element to the grid", async () => {
+    const rect = UI.createElement("rectangle", {
+      x: 5,
+      y: 7,
+      width: 53,
+      height: 41,
+    });
+
+    enableGridMode();
+    API.executeAction(actionSnapToGrid);
+
+    expect(rect.x).toBeCloseTo(0);
+    expect(rect.y).toBeCloseTo(0);
+    expect(rect.width).toBeCloseTo(60);
+    expect(rect.height).toBeCloseTo(40);
+  });
+
+  it("snaps multiple selected elements independently, not as a group", async () => {
+    const rect1 = UI.createElement("rectangle", {
+      x: 5,
+      y: 5,
+      width: 30,
+      height: 30,
+    });
+    const rect2 = UI.createElement("rectangle", {
+      x: 112,
+      y: 8,
+      width: 30,
+      height: 30,
+    });
+
+    mouse.select([rect1, rect2]);
+    enableGridMode();
+    API.executeAction(actionSnapToGrid);
+
+    // each element snaps to its own nearest grid line
+    expect(rect1.x).toBeCloseTo(0);
+    expect(rect1.y).toBeCloseTo(0);
+    expect(rect2.x).toBeCloseTo(120);
+    expect(rect2.y).toBeCloseTo(0);
+  });
+
+  it("snaps every element on the canvas when nothing is selected", async () => {
+    const rect1 = UI.createElement("rectangle", {
+      x: 5,
+      y: 5,
+      width: 30,
+      height: 30,
+    });
+    const rect2 = UI.createElement("rectangle", {
+      x: 112,
+      y: 8,
+      width: 30,
+      height: 30,
+    });
+
+    API.setAppState({ selectedElementIds: {} });
+    expect(API.getSelectedElements().length).toBe(0);
+
+    enableGridMode();
+    API.executeAction(actionSnapToGrid);
+
+    expect(rect1.x).toBeCloseTo(0);
+    expect(rect1.y).toBeCloseTo(0);
+    expect(rect2.x).toBeCloseTo(120);
+    expect(rect2.y).toBeCloseTo(0);
+  });
+
+  it("reverts the snap in a single undo step", async () => {
+    const rect1 = UI.createElement("rectangle", {
+      x: 5,
+      y: 5,
+      width: 30,
+      height: 30,
+    });
+    const rect2 = UI.createElement("rectangle", {
+      x: 112,
+      y: 8,
+      width: 30,
+      height: 30,
+    });
+
+    mouse.select([rect1, rect2]);
+    enableGridMode();
+    API.executeAction(actionSnapToGrid);
+
+    expect(rect1.x).toBeCloseTo(0);
+    expect(rect2.x).toBeCloseTo(120);
+
+    Keyboard.undo();
+
+    expect(h.elements[0].x).toBeCloseTo(5);
+    expect(h.elements[0].y).toBeCloseTo(5);
+    expect(h.elements[1].x).toBeCloseTo(112);
+    expect(h.elements[1].y).toBeCloseTo(8);
+  });
+});
