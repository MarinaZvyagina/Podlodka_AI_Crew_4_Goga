+import { getGridPoint } from "@excalidraw/common";
+
+import type { NullableGridSize } from "@excalidraw/excalidraw/types";
+
+import { updateBoundElements } from "./binding";
+import { resizeSingleElement } from "./resizeElements";
+import { getBoundTextElement } from "./textElement";
+import { isBoundToContainer } from "./typeChecks";
+
+import type { Scene } from "./Scene";
+import type { NonDeletedExcalidrawElement } from "./types";
+
+/**
+ * Snaps the position and size of each given element to the current grid,
+ * independently of the others (as opposed to snapping the selection's
+ * common bounding box as a whole).
+ */
+export const snapElementsToGrid = (
+  elements: readonly NonDeletedExcalidrawElement[],
+  gridSize: NullableGridSize,
+  scene: Scene,
+): NonDeletedExcalidrawElement[] => {
+  if (!gridSize) {
+    return elements as NonDeletedExcalidrawElement[];
+  }
+
+  const elementsMap = scene.getNonDeletedElementsMap();
+  // bound text elements are snapped together with their container below
+  const targetElements = elements.filter(
+    (element) => !isBoundToContainer(element),
+  );
+
+  return targetElements.map((element) => {
+    const snappedWidth = Math.max(
+      gridSize,
+      Math.round(element.width / gridSize) * gridSize,
+    );
+    const snappedHeight = Math.max(
+      gridSize,
+      Math.round(element.height / gridSize) * gridSize,
+    );
+
+    if (snappedWidth !== element.width || snappedHeight !== element.height) {
+      // resize anchored at the top-left corner (accounting for rotation),
+      // same as dragging the bottom-right handle with grid snapping on
+      resizeSingleElement(
+        snappedWidth,
+        snappedHeight,
+        element,
+        element,
+        elementsMap,
+        scene,
+        "se",
+      );
+    }
+
+    const [snappedX, snappedY] = getGridPoint(element.x, element.y, gridSize);
+    const dx = snappedX - element.x;
+    const dy = snappedY - element.y;
+
+    if (dx !== 0 || dy !== 0) {
+      const boundTextElement = getBoundTextElement(element, elementsMap);
+
+      scene.mutateElement(element, { x: snappedX, y: snappedY });
+
+      if (boundTextElement) {
+        scene.mutateElement(boundTextElement, {
+          x: boundTextElement.x + dx,
+          y: boundTextElement.y + dy,
+        });
+      }
+
+      updateBoundElements(element, scene, {
+        simultaneouslyUpdated: targetElements,
+      });
+    }
+
+    return element;
+  });
+};
diff --git a/packages/excalidraw/actions/actionSnapToGrid.tsx b/packages/excalidraw/actions/actionSnapToGrid.tsx
