diff --git a/packages/excalidraw/actions/actionSnapToGrid.test.tsx b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
new file mode 100644
index 0000000..db0d5a8
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
@@ -0,0 +1,121 @@
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { Keyboard, UI } from "../tests/helpers/ui";
+import { render } from "../tests/test-utils";
+
+import { actionSnapToGrid } from "./actionSnapToGrid";
+
+const { h } = window;
+
+describe("snap to grid", () => {
+  beforeEach(async () => {
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+  });
+
+  it("snaps position and size of the selected element to the nearest grid line", () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 41,
+    });
+
+    API.setElements([rect]);
+    API.setSelectedElements([rect]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated = API.getElement(rect);
+    // gridSize defaults to 20
+    expect(updated.x).toBe(20);
+    expect(updated.y).toBe(20);
+    expect(updated.x + updated.width).toBe(60);
+    expect(updated.y + updated.height).toBe(60);
+  });
+
+  it("snaps every element on canvas when nothing is selected, independently", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 12,
+      width: 15,
+      height: 15,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 111,
+      y: 8,
+      width: 15,
+      height: 15,
+    });
+
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated1 = API.getElement(rect1);
+    const updated2 = API.getElement(rect2);
+
+    expect(updated1.x).toBe(20);
+    expect(updated1.y).toBe(20);
+    expect(updated2.x).toBe(120);
+    expect(updated2.y).toBe(0);
+  });
+
+  it("snaps each selected shape independently, not as a single group", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 12,
+      width: 20,
+      height: 20,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 211,
+      y: 12,
+      width: 20,
+      height: 20,
+    });
+
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([rect1, rect2]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated1 = API.getElement(rect1);
+    const updated2 = API.getElement(rect2);
+
+    // if snapping preserved the relative offset between the two shapes
+    // (like a group transform would), updated2.x would be 220 (=200+20);
+    // independent per-shape snapping rounds each one to the nearest line
+    expect(updated1.x).toBe(20);
+    expect(updated2.x).toBe(220);
+  });
+
+  it("undoes the snap in a single step", () => {
+    // drawn (rather than teleported in via API.setElements) so the
+    // pre-snap state is properly committed to history, same as any
+    // shape a real user would have on the canvas
+    const rect = UI.createElement("rectangle", {
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 41,
+    });
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect).x).toBe(20);
+
+    Keyboard.undo();
+
+    const reverted = API.getElement(rect);
+    expect(reverted.x).toBe(12);
+    expect(reverted.y).toBe(27);
+    expect(reverted.width).toBe(53);
+    expect(reverted.height).toBe(41);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..3db3e7d
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,98 @@
+import {
+  CODES,
+  KEYS,
+  getGridPoint,
+  MIN_WIDTH_OR_HEIGHT,
+} from "@excalidraw/common";
+
+import {
+  CaptureUpdateAction,
+  getNonDeletedElements,
+  isBoundToContainer,
+  isTextElement,
+  resizeSingleElement,
+  updateFrameMembershipOfSelectedElements,
+} from "@excalidraw/element";
+
+import { gridIcon } from "../components/icons";
+
+import { getSelectedElements } from "../scene";
+
+import { register } from "./register";
+
+import type { NullableGridSize } from "../types";
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  keywords: ["grid", "snap", "align to grid"],
+  trackEvent: { category: "element" },
+  predicate: (elements) => getNonDeletedElements(elements).length > 0,
+  perform: (elements, appState, _, app) => {
+    const nonDeletedElements = getNonDeletedElements(elements);
+    const selectedElements = getSelectedElements(nonDeletedElements, appState, {
+      includeElementsInFrames: true,
+    });
+
+    // elements bound to a container (labels) snap along with their
+    // container, not independently
+    const elementsToSnap = (
+      selectedElements.length > 0 ? selectedElements : nonDeletedElements
+    ).filter((element) => !isBoundToContainer(element));
+
+    if (elementsToSnap.length === 0) {
+      return false;
+    }
+
+    const gridSize = appState.gridSize as NullableGridSize;
+    const scene = app.scene;
+    const elementsMap = scene.getNonDeletedElementsMap();
+
+    elementsToSnap.forEach((element) => {
+      const [x1, y1] = getGridPoint(element.x, element.y, gridSize);
+      const [x2, y2] = getGridPoint(
+        element.x + element.width,
+        element.y + element.height,
+        gridSize,
+      );
+
+      const snapped = scene.mutateElement(element, { x: x1, y: y1 });
+
+      // text size is derived from font metrics, not freely resizable the
+      // way other shapes are, so only its position snaps
+      if (isTextElement(snapped)) {
+        return;
+      }
+
+      const nextWidth = Math.max(x2 - x1, MIN_WIDTH_OR_HEIGHT);
+      const nextHeight = Math.max(y2 - y1, MIN_WIDTH_OR_HEIGHT);
+
+      if (nextWidth === snapped.width && nextHeight === snapped.height) {
+        return;
+      }
+
+      resizeSingleElement(
+        nextWidth,
+        nextHeight,
+        snapped,
+        snapped,
+        elementsMap,
+        scene,
+        "se",
+      );
+    });
+
+    return {
+      elements: updateFrameMembershipOfSelectedElements(
+        elements,
+        appState,
+        app,
+      ),
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+  keyTest: (event) =>
+    event[KEYS.CTRL_OR_CMD] && event.shiftKey && event.code === CODES.QUOTE,
+});
