diff --git a/packages/excalidraw/tests/snapToGrid.test.tsx b/packages/excalidraw/tests/snapToGrid.test.tsx
new file mode 100644
index 0000000..de0467a
--- /dev/null
+++ b/packages/excalidraw/tests/snapToGrid.test.tsx
@@ -0,0 +1,120 @@
+import { KEYS } from "@excalidraw/common";
+
+import { actionSnapToGrid } from "../actions";
+import { Excalidraw } from "../index";
+
+import { API } from "./helpers/api";
+import { Keyboard, Pointer, UI } from "./helpers/ui";
+import { render, unmountComponent } from "./test-utils";
+
+const { h } = window;
+const mouse = new Pointer("mouse");
+
+beforeEach(async () => {
+  unmountComponent();
+  mouse.reset();
+  await render(<Excalidraw autoFocus={true} handleKeyboardGlobally={true} />);
+});
+
+describe("snap to grid", () => {
+  it("snaps the position and size of the selected shape to the grid", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      x: 13,
+      y: 27,
+      width: 97,
+      height: 41,
+    });
+    API.setElements([rectangle]);
+    API.setAppState({ selectedElementIds: { [rectangle.id]: true } });
+
+    API.executeAction(actionSnapToGrid);
+
+    const gridSize = h.state.gridSize;
+    const snapped = h.elements[0];
+    expect(snapped.x % gridSize).toBe(0);
+    expect(snapped.y % gridSize).toBe(0);
+    expect(snapped.width % gridSize).toBe(0);
+    expect(snapped.height % gridSize).toBe(0);
+    expect(snapped.x).toBe(Math.round(13 / gridSize) * gridSize);
+    expect(snapped.y).toBe(Math.round(27 / gridSize) * gridSize);
+  });
+
+  it("snaps multiple selected shapes independently, not as a group", () => {
+    const rectangle1 = API.createElement({
+      type: "rectangle",
+      x: 4,
+      y: 4,
+      width: 50,
+      height: 50,
+    });
+    const rectangle2 = API.createElement({
+      type: "rectangle",
+      x: 111,
+      y: 8,
+      width: 33,
+      height: 33,
+    });
+    API.setElements([rectangle1, rectangle2]);
+    API.setAppState({
+      selectedElementIds: { [rectangle1.id]: true, [rectangle2.id]: true },
+    });
+
+    API.executeAction(actionSnapToGrid);
+
+    const gridSize = h.state.gridSize;
+    const [snapped1, snapped2] = h.elements;
+
+    // each shape rounds to its own nearest grid line independently
+    expect(snapped1.x).toBe(Math.round(4 / gridSize) * gridSize);
+    expect(snapped2.x).toBe(Math.round(111 / gridSize) * gridSize);
+    // the gap between the two shapes is not preserved as it would be for a
+    // rigid group transform
+    expect(snapped2.x - snapped1.x).not.toBe(111 - 4);
+  });
+
+  it("snaps every shape on the canvas when nothing is selected", () => {
+    const rectangle1 = API.createElement({
+      type: "rectangle",
+      x: 6,
+      y: 6,
+      width: 41,
+      height: 41,
+    });
+    const rectangle2 = API.createElement({
+      type: "rectangle",
+      x: 202,
+      y: 19,
+      width: 22,
+      height: 22,
+    });
+    API.setElements([rectangle1, rectangle2]);
+    API.setAppState({ selectedElementIds: {} });
+
+    API.executeAction(actionSnapToGrid);
+
+    const gridSize = h.state.gridSize;
+    for (const element of h.elements) {
+      expect(element.x % gridSize).toBe(0);
+      expect(element.y % gridSize).toBe(0);
+    }
+  });
+
+  it("undoes the snap in a single step", () => {
+    UI.createElement("rectangle", { x: 13, y: 27, width: 97, height: 41 });
+
+    API.executeAction(actionSnapToGrid);
+
+    const gridSize = h.state.gridSize;
+    expect(h.elements[0].x).toBe(Math.round(13 / gridSize) * gridSize);
+
+    Keyboard.withModifierKeys({ ctrl: true }, () => {
+      Keyboard.keyPress(KEYS.Z);
+    });
+
+    expect(h.elements[0].x).toBe(13);
+    expect(h.elements[0].y).toBe(27);
+    expect(h.elements[0].width).toBe(97);
+    expect(h.elements[0].height).toBe(41);
+  });
+});
