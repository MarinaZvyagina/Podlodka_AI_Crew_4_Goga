@@ -0,0 +1,55 @@
+import { getNonDeletedElements } from "@excalidraw/element";
+import { isBoundToContainer } from "@excalidraw/element";
+import { snapElementsToGrid } from "@excalidraw/element";
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import type { ExcalidrawElement } from "@excalidraw/element/types";
+
+import { getSelectedElements } from "../scene";
+
+import { gridIcon } from "../components/icons";
+
+import { register } from "./register";
+
+import type { AppState } from "../types";
+
+const getSnapToGridTargetElements = (
+  elements: readonly ExcalidrawElement[],
+  appState: AppState,
+) => {
+  const nonDeletedElements = getNonDeletedElements(elements);
+  const selectedElements = getSelectedElements(nonDeletedElements, appState);
+
+  if (selectedElements.length > 0) {
+    return selectedElements;
+  }
+
+  // nothing selected: snap every shape on the canvas
+  return nonDeletedElements.filter(
+    (element) => !element.locked && !isBoundToContainer(element),
+  );
+};
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  trackEvent: { category: "element" },
+  predicate: (elements, appState) =>
+    getSnapToGridTargetElements(elements, appState).length > 0,
+  perform: (elements, appState, _, app) => {
+    const targetElements = getSnapToGridTargetElements(elements, appState);
+
+    snapElementsToGrid(targetElements, appState.gridSize, app.scene);
+
+    const elementsMap = app.scene.getNonDeletedElementsMap();
+
+    return {
+      elements: elements.map(
+        (element) => elementsMap.get(element.id) ?? element,
+      ),
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
