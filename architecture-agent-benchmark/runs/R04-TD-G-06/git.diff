@@ -0,0 +1,131 @@
+import { getGridPoint, MIN_WIDTH_OR_HEIGHT } from "@excalidraw/common";
+
+import type { NullableGridSize } from "@excalidraw/excalidraw/types";
+
+import { updateBoundElements } from "./binding";
+import { getFrameChildren } from "./frame";
+import { resizeSingleElement } from "./resizeElements";
+import { getBoundTextElement } from "./textElement";
+import {
+  isBindingElement,
+  isElbowArrow,
+  isFrameLikeElement,
+} from "./typeChecks";
+
+import type { Scene } from "./Scene";
+import type { NonDeletedExcalidrawElement } from "./types";
+
+const snapValueToGrid = (value: number, gridSize: number) =>
+  Math.max(MIN_WIDTH_OR_HEIGHT, Math.round(value / gridSize) * gridSize);
+
+const snapElementPosition = (
+  element: NonDeletedExcalidrawElement,
+  gridSize: number,
+  scene: Scene,
+) => {
+  const [nextX, nextY] = getGridPoint(
+    element.x,
+    element.y,
+    gridSize as NullableGridSize,
+  );
+  const deltaX = nextX - element.x;
+  const deltaY = nextY - element.y;
+
+  if (deltaX === 0 && deltaY === 0) {
+    return;
+  }
+
+  scene.mutateElement(element, { x: nextX, y: nextY });
+  updateBoundElements(element, scene);
+
+  const elementsMap = scene.getNonDeletedElementsMap();
+
+  const boundTextElement = getBoundTextElement(element, elementsMap);
+  if (boundTextElement) {
+    scene.mutateElement(boundTextElement, {
+      x: boundTextElement.x + deltaX,
+      y: boundTextElement.y + deltaY,
+    });
+  }
+
+  if (isFrameLikeElement(element)) {
+    (
+      getFrameChildren(elementsMap, element.id) as NonDeletedExcalidrawElement[]
+    ).forEach((child) => {
+      scene.mutateElement(child, {
+        x: child.x + deltaX,
+        y: child.y + deltaY,
+      });
+      updateBoundElements(child, scene);
+    });
+  }
+};
+
+const snapElementSize = (
+  element: NonDeletedExcalidrawElement,
+  gridSize: number,
+  scene: Scene,
+) => {
+  // interactive resizing is disabled for elbow arrows; their geometry is
+  // auto-routed between their bindings, not directly settable
+  if (isElbowArrow(element)) {
+    return;
+  }
+
+  const nextWidth = snapValueToGrid(element.width, gridSize);
+  const nextHeight = snapValueToGrid(element.height, gridSize);
+
+  if (nextWidth === element.width && nextHeight === element.height) {
+    return;
+  }
+
+  const elementsMap = scene.getNonDeletedElementsMap();
+
+  // handle "se" keeps the top-left corner anchored (accounting for rotation),
+  // matching the result of dragging the bottom-right resize handle
+  resizeSingleElement(
+    nextWidth,
+    nextHeight,
+    element,
+    element,
+    elementsMap,
+    scene,
+    "se",
+  );
+};
+
+/**
+ * Snaps each element's position and size to the nearest grid line
+ * independently, in place. Elements are not treated as a group: each one
+ * snaps based on its own bounds.
+ */
+export const snapElementsToGrid = (
+  targetElements: readonly NonDeletedExcalidrawElement[],
+  gridSize: number,
+  scene: Scene,
+): NonDeletedExcalidrawElement[] => {
+  // a frame's children move along with it (see snapElementPosition), so
+  // avoid snapping them a second time when both are targeted at once
+  const frameIdsInTargets = new Set(
+    targetElements.filter(isFrameLikeElement).map((element) => element.id),
+  );
+
+  const elementsToSnap = targetElements.filter(
+    (element) => !(element.frameId && frameIdsInTargets.has(element.frameId)),
+  );
+
+  elementsToSnap.forEach((element) => {
+    // bound arrows derive their geometry from the shapes they're attached
+    // to, which are snapped independently and carry the arrow along via
+    // updateBoundElements
+    const isBoundArrow =
+      isBindingElement(element) && (element.startBinding || element.endBinding);
+
+    if (!isBoundArrow) {
+      snapElementPosition(element, gridSize, scene);
+      snapElementSize(element, gridSize, scene);
+    }
+  });
+
+  return elementsToSnap;
+};
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
