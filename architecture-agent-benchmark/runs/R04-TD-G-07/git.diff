diff --git a/packages/element/src/snapToGrid.ts b/packages/element/src/snapToGrid.ts
new file mode 100644
index 0000000..6939719
--- /dev/null
+++ b/packages/element/src/snapToGrid.ts
@@ -0,0 +1,109 @@
+import { getGridPoint, MIN_WIDTH_OR_HEIGHT } from "@excalidraw/common";
+
+import type { NullableGridSize } from "@excalidraw/excalidraw/types";
+
+import { updateBoundElements } from "./binding";
+import { getElementBounds } from "./bounds";
+import { getBoundTextElement, handleBindTextResize } from "./textElement";
+import {
+  isBoundToContainer,
+  isElbowArrow,
+  isFreeDrawElement,
+  isLinearElement,
+  isTextElement,
+} from "./typeChecks";
+
+import type { Scene } from "./Scene";
+import type { NonDeletedExcalidrawElement } from "./types";
+
+/**
+ * Snaps each of the given elements to the grid independently (position for
+ * every element, plus size for elements whose bounding box isn't derived
+ * from points/font metrics), as opposed to snapping the selection as a
+ * single rigid group the way dragging does.
+ */
+export const snapElementsToGrid = (
+  targetElements: readonly NonDeletedExcalidrawElement[],
+  scene: Scene,
+  gridSize: NullableGridSize,
+): NonDeletedExcalidrawElement[] => {
+  if (!gridSize) {
+    return [];
+  }
+
+  const elementsMap = scene.getNonDeletedElementsMap();
+  const updatedElements: NonDeletedExcalidrawElement[] = [];
+
+  for (const element of targetElements) {
+    // bound text snaps together with its container instead of independently
+    if (isBoundToContainer(element)) {
+      continue;
+    }
+
+    // fully-bound elbow arrows are routed automatically from the elements
+    // they connect to and shouldn't be repositioned directly
+    if (isElbowArrow(element) && element.startBinding && element.endBinding) {
+      continue;
+    }
+
+    const [x1, y1, x2, y2] = getElementBounds(element, elementsMap, true);
+    const [snappedX1, snappedY1] = getGridPoint(x1, y1, gridSize);
+
+    // multi-point (linear/freedraw) and text elements have a size that's
+    // derived from their points or font metrics rather than being freely
+    // resizable, so only their position is snapped
+    if (
+      isLinearElement(element) ||
+      isFreeDrawElement(element) ||
+      isTextElement(element)
+    ) {
+      const dx = snappedX1 - x1;
+      const dy = snappedY1 - y1;
+      if (dx === 0 && dy === 0) {
+        continue;
+      }
+
+      const updatedElement = scene.mutateElement(element, {
+        x: element.x + dx,
+        y: element.y + dy,
+      });
+      updateBoundElements(element, scene, {
+        simultaneouslyUpdated: targetElements,
+      });
+      updatedElements.push(updatedElement);
+      continue;
+    }
+
+    const [snappedX2, snappedY2] = getGridPoint(x2, y2, gridSize);
+    const nextWidth = Math.max(snappedX2 - snappedX1, MIN_WIDTH_OR_HEIGHT);
+    const nextHeight = Math.max(snappedY2 - snappedY1, MIN_WIDTH_OR_HEIGHT);
+
+    if (
+      snappedX1 === x1 &&
+      snappedY1 === y1 &&
+      nextWidth === element.width &&
+      nextHeight === element.height
+    ) {
+      continue;
+    }
+
+    const updatedElement = scene.mutateElement(element, {
+      x: snappedX1,
+      y: snappedY1,
+      width: nextWidth,
+      height: nextHeight,
+    });
+
+    updateBoundElements(element, scene, {
+      simultaneouslyUpdated: targetElements,
+    });
+
+    if (getBoundTextElement(element, elementsMap)) {
+      handleBindTextResize(element, scene, "se", false);
+    }
+
+    updatedElements.push(updatedElement);
+  }
+
+  return updatedElements;
+};
diff --git a/packages/element/tests/snapToGrid.test.tsx b/packages/element/tests/snapToGrid.test.tsx
new file mode 100644
index 0000000..5ddc9b8
--- /dev/null
+++ b/packages/element/tests/snapToGrid.test.tsx
@@ -0,0 +1,198 @@
+import { actionSnapToGrid } from "@excalidraw/excalidraw/actions";
+import { defaultLang, setLanguage } from "@excalidraw/excalidraw/i18n";
+import { Excalidraw } from "@excalidraw/excalidraw";
+
+import { API } from "@excalidraw/excalidraw/tests/helpers/api";
+import { Keyboard, UI } from "@excalidraw/excalidraw/tests/helpers/ui";
+import {
+  act,
+  unmountComponent,
+  render,
+} from "@excalidraw/excalidraw/tests/test-utils";
+
+import type { NonDeletedExcalidrawElement } from "@excalidraw/element/types";
+
+describe("snapping existing shapes to the grid", () => {
+  beforeEach(async () => {
+    unmountComponent();
+
+    await act(() => {
+      return setLanguage(defaultLang);
+    });
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+
+    API.setAppState({ gridSize: 20, gridModeEnabled: false });
+  });
+
+  it("snaps a selected shape's position and size to the nearest grid lines", () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 27,
+      width: 91,
+      height: 48,
+    });
+    API.setElements([rect]);
+    API.setSelectedElements([rect]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated = API.getElement(rect);
+    expect(updated.x).toEqual(20);
+    expect(updated.y).toEqual(20);
+    expect(updated.width).toEqual(80);
+    expect(updated.height).toEqual(60);
+  });
+
+  it("leaves an already grid-aligned shape untouched", () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 20,
+      y: 40,
+      width: 100,
+      height: 60,
+    });
+    API.setElements([rect]);
+    API.setSelectedElements([rect]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated = API.getElement(rect);
+    expect(updated.x).toEqual(20);
+    expect(updated.y).toEqual(40);
+    expect(updated.width).toEqual(100);
+    expect(updated.height).toEqual(60);
+    expect(updated.version).toEqual(rect.version);
+  });
+
+  it("snaps every selected shape independently rather than as a single group", () => {
+    const rectA = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 12,
+      width: 41,
+      height: 41,
+    });
+    const rectB = API.createElement({
+      type: "rectangle",
+      x: 207,
+      y: 3,
+      width: 41,
+      height: 41,
+    });
+    API.setElements([rectA, rectB]);
+    API.setSelectedElements([rectA, rectB]);
+
+    API.executeAction(actionSnapToGrid);
+
+    // each rectangle's own bounding box snaps to its own nearest grid
+    // lines, independent of the other rectangle's offset
+    expect(API.getElement(rectA).x).toEqual(20);
+    expect(API.getElement(rectA).y).toEqual(20);
+    expect(API.getElement(rectB).x).toEqual(200);
+    expect(API.getElement(rectB).y).toEqual(0);
+  });
+
+  it("applies to every shape on the canvas when nothing is selected", () => {
+    const rectA = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 12,
+      width: 41,
+      height: 41,
+    });
+    const rectB = API.createElement({
+      type: "rectangle",
+      x: 207,
+      y: 3,
+      width: 41,
+      height: 41,
+    });
+    API.setElements([rectA, rectB]);
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rectA).x).toEqual(20);
+    expect(API.getElement(rectA).y).toEqual(20);
+    expect(API.getElement(rectB).x).toEqual(200);
+    expect(API.getElement(rectB).y).toEqual(0);
+  });
+
+  it("keeps a bound text inside its container after snapping the container", () => {
+    const container = API.createElement({
+      type: "rectangle",
+      id: "container",
+      x: 12,
+      y: 12,
+      width: 91,
+      height: 48,
+      boundElements: [{ type: "text", id: "bound-text" }],
+    });
+    const boundText = API.createElement({
+      type: "text",
+      id: "bound-text",
+      x: 20,
+      y: 25,
+      width: 60,
+      height: 20,
+      containerId: container.id,
+      text: "hi",
+    });
+    API.setElements([container, boundText]);
+    API.setSelectedElements([container]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updatedContainer = API.getElement(container);
+    const updatedText = API.getElement(boundText);
+
+    expect(updatedContainer.x).toEqual(20);
+    expect(updatedContainer.y).toEqual(20);
+
+    // the label stays horizontally/vertically centered within its
+    // (now snapped) container
+    expect(updatedText.x).toBeGreaterThanOrEqual(updatedContainer.x);
+    expect(updatedText.x + updatedText.width).toBeLessThanOrEqual(
+      updatedContainer.x + updatedContainer.width,
+    );
+    expect(updatedText.y).toBeGreaterThanOrEqual(updatedContainer.y);
+    expect(updatedText.y + updatedText.height).toBeLessThanOrEqual(
+      updatedContainer.y + updatedContainer.height,
+    );
+  });
+
+  it("undoes the whole snap in a single step", () => {
+    // built via the real draw flow (not API.setElements) so the history
+    // store has a committed baseline to undo back to
+    const rectA = UI.createElement("rectangle", {
+      x: 12,
+      y: 12,
+      width: 41,
+      height: 41,
+    });
+    const rectB = UI.createElement("rectangle", {
+      x: 207,
+      y: 3,
+      width: 41,
+      height: 41,
+    });
+    API.setSelectedElements([
+      rectA.get(),
+      rectB.get(),
+    ] as NonDeletedExcalidrawElement[]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rectA.get()).x).toEqual(20);
+    expect(API.getElement(rectB.get()).x).toEqual(200);
+
+    Keyboard.undo();
+
+    expect(API.getElement(rectA.get()).x).toEqual(12);
+    expect(API.getElement(rectA.get()).y).toEqual(12);
+    expect(API.getElement(rectA.get()).width).toEqual(41);
+    expect(API.getElement(rectB.get()).x).toEqual(207);
+    expect(API.getElement(rectB.get()).y).toEqual(3);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..024b112
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,57 @@
+import { arrayToMap } from "@excalidraw/common";
+
+import {
+  CaptureUpdateAction,
+  snapElementsToGrid,
+  updateFrameMembershipOfSelectedElements,
+} from "@excalidraw/element";
+
+import type { ExcalidrawElement } from "@excalidraw/element/types";
+
+import { magnetIcon } from "../components/icons";
+
+import { register } from "./register";
+
+import type { AppClassProperties, AppState, NullableGridSize } from "../types";
+
+const snapSelectionToGrid = (
+  elements: readonly ExcalidrawElement[],
+  appState: Readonly<AppState>,
+  app: AppClassProperties,
+) => {
+  const selectedElements = app.scene.getSelectedElements(appState);
+  const targetElements =
+    selectedElements.length > 0
+      ? selectedElements
+      : app.scene.getNonDeletedElements();
+
+  const updatedElements = snapElementsToGrid(
+    targetElements,
+    app.scene,
+    appState.gridSize as NullableGridSize,
+  );
+  const updatedElementsMap = arrayToMap(updatedElements);
+
+  return updateFrameMembershipOfSelectedElements(
+    elements.map((element) => updatedElementsMap.get(element.id) || element),
+    appState,
+    app,
+  );
+};
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: magnetIcon,
+  keywords: ["grid", "snap", "align"],
+  trackEvent: { category: "element" },
+  predicate: (elements, appState, appProps, app) =>
+    app.scene.getNonDeletedElements().length > 0,
+  perform: (elements, appState, _, app) => {
+    return {
+      appState,
+      elements: snapSelectionToGrid(elements, appState, app),
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
