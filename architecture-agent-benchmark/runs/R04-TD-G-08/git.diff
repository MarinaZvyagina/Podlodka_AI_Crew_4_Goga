diff --git a/packages/excalidraw/actions/actionSnapToGrid.test.tsx b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
new file mode 100644
index 0000000..ce8b252
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
@@ -0,0 +1,169 @@
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { Keyboard } from "../tests/helpers/ui";
+import { render } from "../tests/test-utils";
+
+import { actionSnapToGrid } from "./actionSnapToGrid";
+
+const { h } = window;
+
+describe("snap to grid", () => {
+  it("snaps position and size of the selected element to the configured grid", async () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 13,
+      y: 27,
+      width: 47,
+      height: 33,
+    });
+
+    await render(
+      <Excalidraw handleKeyboardGlobally initialData={{ elements: [rect] }} />,
+    );
+    API.setAppState({ gridSize: 20 });
+    API.setSelectedElements([API.getElement(rect)]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated = API.getElement(rect);
+    expect(updated.x).toBe(20);
+    expect(updated.y).toBe(20);
+    expect(updated.width).toBe(40);
+    expect(updated.height).toBe(40);
+  });
+
+  it("applies to every element when nothing is selected", async () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 11,
+      y: 11,
+      width: 20,
+      height: 20,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 91,
+      y: 91,
+      width: 20,
+      height: 20,
+    });
+
+    await render(
+      <Excalidraw
+        handleKeyboardGlobally
+        initialData={{ elements: [rect1, rect2] }}
+      />,
+    );
+    API.setAppState({ gridSize: 20 });
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect1).x).toBe(20);
+    expect(API.getElement(rect1).y).toBe(20);
+    expect(API.getElement(rect2).x).toBe(100);
+    expect(API.getElement(rect2).y).toBe(100);
+  });
+
+  it("snaps multiple selected shapes independently, not as a group", async () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 9,
+      y: 9,
+      width: 20,
+      height: 20,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 34,
+      y: 34,
+      width: 20,
+      height: 20,
+    });
+
+    await render(
+      <Excalidraw
+        handleKeyboardGlobally
+        initialData={{ elements: [rect1, rect2] }}
+      />,
+    );
+    API.setAppState({ gridSize: 20 });
+    API.setSelectedElements([API.getElement(rect1), API.getElement(rect2)]);
+
+    API.executeAction(actionSnapToGrid);
+
+    // rect1 is closer to 0, rect2 is closer to 40 - if they moved as a rigid
+    // group the offset between them (25) would be preserved instead of each
+    // snapping independently.
+    expect(API.getElement(rect1).x).toBe(0);
+    expect(API.getElement(rect1).y).toBe(0);
+    expect(API.getElement(rect2).x).toBe(40);
+    expect(API.getElement(rect2).y).toBe(40);
+  });
+
+  it("undoes the snap in a single step", async () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 13,
+      y: 27,
+      width: 47,
+      height: 33,
+    });
+
+    await render(
+      <Excalidraw handleKeyboardGlobally initialData={{ elements: [rect] }} />,
+    );
+    API.setAppState({ gridSize: 20 });
+    API.setSelectedElements([API.getElement(rect)]);
+
+    expect(h.history.isUndoStackEmpty).toBe(true);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect).x).toBe(20);
+
+    Keyboard.undo();
+
+    const reverted = API.getElement(rect);
+    expect(reverted.x).toBe(13);
+    expect(reverted.y).toBe(27);
+    expect(reverted.width).toBe(47);
+    expect(reverted.height).toBe(33);
+  });
+
+  it("moves bound text along with its container", async () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 13,
+      y: 27,
+      width: 100,
+      height: 60,
+      boundElements: [{ id: "bound-text", type: "text" }],
+    });
+    const text = API.createElement({
+      type: "text",
+      id: "bound-text",
+      x: rect.x + 10,
+      y: rect.y + 10,
+      containerId: rect.id,
+      text: "hello",
+    });
+
+    await render(
+      <Excalidraw
+        handleKeyboardGlobally
+        initialData={{ elements: [rect, text] }}
+      />,
+    );
+    API.setAppState({ gridSize: 20 });
+    API.setSelectedElements([API.getElement(rect)]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updatedRect = API.getElement(rect);
+    const updatedText = API.getElement(text);
+
+    expect(updatedText.x).toBe(updatedRect.x + 10);
+    expect(updatedText.y).toBe(updatedRect.y + 10);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..f323a66
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,124 @@
+import {
+  getGridPoint,
+  MIN_WIDTH_OR_HEIGHT,
+  arrayToMap,
+} from "@excalidraw/common";
+
+import {
+  CaptureUpdateAction,
+  getNonDeletedElements,
+  getBoundTextElement,
+  isBoundToContainer,
+  resizeSingleElement,
+  updateBoundElements,
+  updateFrameMembershipOfSelectedElements,
+} from "@excalidraw/element";
+
+import type {
+  ExcalidrawElement,
+  NonDeletedExcalidrawElement,
+} from "@excalidraw/element/types";
+
+import { getSelectedElements } from "../scene";
+
+import { register } from "./register";
+
+import type { AppClassProperties, AppState, NullableGridSize } from "../types";
+
+const snapElementsToGrid = (
+  elements: readonly ExcalidrawElement[],
+  appState: Readonly<AppState>,
+  app: AppClassProperties,
+): readonly ExcalidrawElement[] => {
+  const gridSize = appState.gridSize as NullableGridSize;
+  const nonDeleted = getNonDeletedElements(elements);
+  const selected = getSelectedElements(nonDeleted, appState);
+  const targets: NonDeletedExcalidrawElement[] = (
+    selected.length > 0 ? selected : nonDeleted
+  ).filter((element) => !isBoundToContainer(element));
+
+  if (targets.length === 0) {
+    return elements;
+  }
+
+  const scene = app.scene;
+
+  targets.forEach((element) => {
+    const [nextX, nextY] = getGridPoint(element.x, element.y, gridSize);
+    const dx = nextX - element.x;
+    const dy = nextY - element.y;
+
+    if (dx !== 0 || dy !== 0) {
+      scene.mutateElement(element, { x: nextX, y: nextY });
+
+      const boundText = getBoundTextElement(
+        element,
+        scene.getNonDeletedElementsMap(),
+      );
+      if (boundText) {
+        scene.mutateElement(boundText, {
+          x: boundText.x + dx,
+          y: boundText.y + dy,
+        });
+      }
+
+      updateBoundElements(element, scene, { simultaneouslyUpdated: targets });
+    }
+
+    // 0-width/height is a valid, common shape (e.g. a perfectly horizontal or
+    // vertical line/arrow) - only clamp away from 0 when rounding shrank an
+    // originally non-zero dimension, rather than forcing every axis-aligned
+    // linear element to grow a pixel.
+    const nextWidth =
+      element.width === 0
+        ? 0
+        : Math.max(
+            MIN_WIDTH_OR_HEIGHT,
+            Math.round(element.width / appState.gridSize) * appState.gridSize,
+          );
+    const nextHeight =
+      element.height === 0
+        ? 0
+        : Math.max(
+            MIN_WIDTH_OR_HEIGHT,
+            Math.round(element.height / appState.gridSize) * appState.gridSize,
+          );
+
+    if (nextWidth !== element.width || nextHeight !== element.height) {
+      resizeSingleElement(
+        nextWidth,
+        nextHeight,
+        element,
+        element,
+        scene.getNonDeletedElementsMap(),
+        scene,
+        "se",
+        { shouldMaintainAspectRatio: false, shouldResizeFromCenter: false },
+      );
+    }
+  });
+
+  const updatedElementsMap = arrayToMap(scene.getNonDeletedElements());
+
+  return elements.map(
+    (element) => updatedElementsMap.get(element.id) || element,
+  );
+};
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  trackEvent: { category: "element" },
+  predicate: (elements) => getNonDeletedElements(elements).length > 0,
+  perform: (elements, appState, _, app) => {
+    return {
+      elements: updateFrameMembershipOfSelectedElements(
+        snapElementsToGrid(elements, appState, app),
+        appState,
+        app,
+      ),
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
