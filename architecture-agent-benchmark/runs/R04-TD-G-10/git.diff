index 0000000..0e71b5f
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,109 @@
+import { getGridPoint } from "@excalidraw/common";
+
+import {
+  CaptureUpdateAction,
+  getBoundTextElement,
+  getNonDeletedElements,
+  isBoundToContainer,
+  resizeSingleElement,
+  updateBoundElements,
+} from "@excalidraw/element";
+
+import type {
+  ExcalidrawElement,
+  NonDeletedExcalidrawElement,
+} from "@excalidraw/element/types";
+
+import { getSelectedElements } from "../scene";
+
+import { gridIcon } from "../components/icons";
+
+import { register } from "./register";
+
+import type { AppClassProperties, AppState, NullableGridSize } from "../types";
+
+const snapElementsToGrid = (
+  elements: readonly ExcalidrawElement[],
+  appState: Readonly<AppState>,
+  app: AppClassProperties,
+): readonly ExcalidrawElement[] => {
+  const gridSize = appState.gridSize as NullableGridSize;
+  if (!gridSize) {
+    return elements;
+  }
+
+  const nonDeletedElements = getNonDeletedElements(elements);
+  const selectedElements = getSelectedElements(nonDeletedElements, appState);
+
+  // each shape snaps independently based on its own position/size, so we
+  // never treat the selection as a single group
+  const targets = (
+    selectedElements.length ? selectedElements : nonDeletedElements
+  ).filter((element) => !element.locked && !isBoundToContainer(element));
+
+  const elementsMap = app.scene.getNonDeletedElementsMap();
+
+  // snap size first so the position snap below has the final say on where
+  // the (now grid-sized) top-left corner ends up
+  targets.forEach((element) => {
+    const nextWidth = getSnappedDimension(element.width, gridSize);
+    const nextHeight = getSnappedDimension(element.height, gridSize);
+
+    if (nextWidth !== element.width || nextHeight !== element.height) {
+      resizeSingleElement(
+        nextWidth,
+        nextHeight,
+        element,
+        element,
+        elementsMap,
+        app.scene,
+        "nw",
+      );
+    }
+  });
+
+  targets.forEach((element) => {
+    const [nextX, nextY] = getGridPoint(element.x, element.y, gridSize);
+    if (nextX === element.x && nextY === element.y) {
+      return;
+    }
+
+    const dx = nextX - element.x;
+    const dy = nextY - element.y;
+
+    app.scene.mutateElement(element, { x: nextX, y: nextY });
+
+    const boundTextElement = getBoundTextElement(element, elementsMap);
+    if (boundTextElement) {
+      app.scene.mutateElement(boundTextElement, {
+        x: boundTextElement.x + dx,
+        y: boundTextElement.y + dy,
+      });
+    }
+
+    updateBoundElements(element as NonDeletedExcalidrawElement, app.scene, {
+      simultaneouslyUpdated: targets as NonDeletedExcalidrawElement[],
+    });
+  });
+
+  return elements;
+};
+
+// a dimension of exactly 0 (e.g. a perfectly horizontal/vertical line or
+// arrow) is left untouched instead of being inflated to a full grid cell
+const getSnappedDimension = (value: number, gridSize: number): number =>
+  value === 0 ? 0 : Math.max(gridSize, Math.round(value / gridSize) * gridSize);
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  trackEvent: { category: "element" },
+  perform: (elements, appState, _, app) => {
+    return {
+      elements: snapElementsToGrid(elements, appState, app),
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
