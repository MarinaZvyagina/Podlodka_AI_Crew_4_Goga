index 0000000..1a92a26
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
@@ -0,0 +1,134 @@
+import { pointFrom } from "@excalidraw/math";
+
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { Keyboard, UI } from "../tests/helpers/ui";
+import { render } from "../tests/test-utils";
+
+import { actionSnapToGrid } from "./actionSnapToGrid";
+
+const { h } = window;
+
+describe("snap to grid action", () => {
+  it("snaps position and size of the selected element to the grid", async () => {
+    await render(
+      <Excalidraw
+        initialData={{ elements: [] }}
+        handleKeyboardGlobally={true}
+      />,
+    );
+
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 11,
+      y: 22,
+      width: 33,
+      height: 44,
+    });
+    API.setElements([rect]);
+    API.setSelectedElements([rect]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const el = h.elements.find((el) => el.id === rect.id)!;
+    expect(el.x % h.state.gridSize).toBe(0);
+    expect(el.y % h.state.gridSize).toBe(0);
+    expect(el.width % h.state.gridSize).toBe(0);
+    expect(el.height % h.state.gridSize).toBe(0);
+  });
+
+  it("applies to every shape when nothing is selected, snapping each independently", async () => {
+    await render(
+      <Excalidraw
+        initialData={{ elements: [] }}
+        handleKeyboardGlobally={true}
+      />,
+    );
+
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 11,
+      y: 22,
+      width: 33,
+      height: 44,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 108,
+      y: 130,
+      width: 15,
+      height: 15,
+    });
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const el1 = h.elements.find((el) => el.id === rect1.id)!;
+    const el2 = h.elements.find((el) => el.id === rect2.id)!;
+
+    expect(el1.x % h.state.gridSize).toBe(0);
+    expect(el1.y % h.state.gridSize).toBe(0);
+    expect(el2.x % h.state.gridSize).toBe(0);
+    expect(el2.y % h.state.gridSize).toBe(0);
+
+    // each shape snapped independently, not as a single group: the two
+    // shapes' relative offset (originally 97,108, not a multiple of the
+    // grid) should change once each shape rounds to its own nearest line
+    expect([el2.x - el1.x, el2.y - el1.y]).not.toEqual([97, 108]);
+  });
+
+  it("undoes the snap in a single step", async () => {
+    await render(
+      <Excalidraw
+        initialData={{ elements: [] }}
+        handleKeyboardGlobally={true}
+      />,
+    );
+
+    const rect = UI.createElement("rectangle", {
+      x: 11,
+      y: 22,
+      width: 33,
+      height: 44,
+    });
+
+    API.executeAction(actionSnapToGrid);
+
+    const snapped = h.elements.find((el) => el.id === rect.id)!;
+    expect(snapped.x).not.toBe(11);
+
+    Keyboard.undo();
+
+    const reverted = h.elements.find((el) => el.id === rect.id)!;
+    expect(reverted.x).toBe(11);
+    expect(reverted.y).toBe(22);
+    expect(reverted.width).toBe(33);
+    expect(reverted.height).toBe(44);
+  });
+
+  it("leaves a perfectly horizontal line's zero height untouched", async () => {
+    await render(
+      <Excalidraw
+        initialData={{ elements: [] }}
+        handleKeyboardGlobally={true}
+      />,
+    );
+
+    const line = API.createElement({
+      type: "line",
+      x: 11,
+      y: 22,
+      width: 33,
+      height: 0,
+      points: [pointFrom(0, 0), pointFrom(33, 0)],
+    });
+    API.setElements([line]);
+    API.setSelectedElements([line]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const el = h.elements.find((el) => el.id === line.id)!;
+    expect(el.height).toBe(0);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
