+func TestScraperGroupUpdateMaxScrapeTargets(t *testing.T) {
+	f := func(jobName string, maxScrapeTargets, targetsCount, wantActive, wantDropped int) {
+		t.Helper()
+		pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+		globalStopChan = make(chan struct{})
+		defer close(globalStopChan)
+
+		randName := rand.Int()
+		sg := newScraperGroup(fmt.Sprintf("static_configs_%d", randName), pushData, globalStopChan)
+		defer sg.stop()
+
+		var sb strings.Builder
+		fmt.Fprintf(&sb, "scrape_configs:\n- job_name: %s\n", jobName)
+		if maxScrapeTargets > 0 {
+			fmt.Fprintf(&sb, "  max_scrape_targets: %d\n", maxScrapeTargets)
+		}
+		sb.WriteString("  static_configs:\n    - targets:\n")
+		for i := range targetsCount {
+			fmt.Fprintf(&sb, "        - localhost:%d\n", 20000+i)
+		}
+
+		var cfg Config
+		if err := cfg.parseData([]byte(sb.String()), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sws := cfg.getStaticScrapeWork()
+		if len(sws) != targetsCount {
+			t.Fatalf("unexpected number of discovered targets; got %d; want %d", len(sws), targetsCount)
+		}
+
+		sg.update(sws)
+
+		if got := len(sg.m); got != wantActive {
+			t.Fatalf("unexpected number of active scrapers; got %d; want %d", got, wantActive)
+		}
+		gotDropped := 0
+		for _, dt := range droppedTargetsMap.getTargetsList() {
+			if dt.originalLabels.getJob() == jobName && dt.dropReason == targetDropReasonTargetsLimit {
+				gotDropped++
+			}
+		}
+		if gotDropped != wantDropped {
+			t.Fatalf("unexpected number of targets dropped because of max_scrape_targets; got %d; want %d", gotDropped, wantDropped)
+		}
+	}
+
+	// A job under the configured limit must have all of its targets scraped, with nothing excluded.
+	f("under-limit-job", 5, 3, 3, 0)
+
+	// A job over the configured limit must be truncated to the limit, with the rest excluded and visible as dropped targets.
+	f("over-limit-job", 2, 5, 2, 3)
+
+	// The default (max_scrape_targets unset) must mean unlimited - all targets get scraped.
+	f("unlimited-job", 0, 10, 10, 0)
+}
