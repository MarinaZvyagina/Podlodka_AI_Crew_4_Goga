+func TestTargetStatusMapRegisterMaxScrapeTargets(t *testing.T) {
+	newTarget := func(jobName, address string, maxScrapeTargets int) *scrapeWork {
+		return &scrapeWork{
+			Config: &ScrapeWork{
+				jobNameOriginal:  jobName,
+				MaxScrapeTargets: maxScrapeTargets,
+				OriginalLabels: newCompressedLabels(promutil.NewLabelsFromMap(map[string]string{
+					"__address__": address,
+				})),
+			},
+		}
+	}
+
+	// A job under the limit must have all of its targets registered.
+	t.Run("under limit", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		for i := range 3 {
+			sw := newTarget("under-limit-job", fmt.Sprintf("host%d:80", i), 5)
+			if !tsm.Register(sw) {
+				t.Fatalf("target %d must be registered, since the job is under its max_scrape_targets limit", i)
+			}
+		}
+		if got := len(tsm.m); got != 3 {
+			t.Fatalf("unexpected number of registered targets; got %d; want 3", got)
+		}
+	})
+
+	// A job over the limit must have only the first N targets registered; the rest must be rejected.
+	t.Run("over limit", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		const limit = 2
+		const total = 5
+		var registered, rejected int
+		for i := range total {
+			sw := newTarget("over-limit-job", fmt.Sprintf("host%d:80", i), limit)
+			if tsm.Register(sw) {
+				registered++
+			} else {
+				rejected++
+			}
+		}
+		if registered != limit {
+			t.Fatalf("unexpected number of registered targets; got %d; want %d", registered, limit)
+		}
+		if rejected != total-limit {
+			t.Fatalf("unexpected number of rejected targets; got %d; want %d", rejected, total-limit)
+		}
+		if got := len(tsm.m); got != limit {
+			t.Fatalf("unexpected number of tracked targets; got %d; want %d", got, limit)
+		}
+	})
+
+	// The default MaxScrapeTargets=0 must mean unlimited.
+	t.Run("default is unlimited", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		const total = 1000
+		for i := range total {
+			sw := newTarget("unlimited-job", fmt.Sprintf("host%d:80", i), 0)
+			if !tsm.Register(sw) {
+				t.Fatalf("target %d must be registered, since max_scrape_targets is unset (unlimited)", i)
+			}
+		}
+		if got := len(tsm.m); got != total {
+			t.Fatalf("unexpected number of registered targets; got %d; want %d", got, total)
+		}
+	})
+
+	// The limit must be scoped per job - a job at its limit must not affect other jobs.
+	t.Run("limit is per job", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		for i := range 2 {
+			if !tsm.Register(newTarget("job-a", fmt.Sprintf("a%d:80", i), 2)) {
+				t.Fatalf("job-a target %d must be registered", i)
+			}
+		}
+		if tsm.Register(newTarget("job-a", "a-extra:80", 2)) {
+			t.Fatalf("job-a is at its limit; extra target must be rejected")
+		}
+		if !tsm.Register(newTarget("job-b", "b0:80", 2)) {
+			t.Fatalf("job-b must be unaffected by job-a hitting its limit")
+		}
+	})
+}
