+func TestTargetStatusMapRegisterTargetLimit(t *testing.T) {
+	newTarget := func(jobName string, addr string, targetLimit int) *scrapeWork {
+		return &scrapeWork{
+			Config: &ScrapeWork{
+				jobNameOriginal: jobName,
+				TargetLimit:     targetLimit,
+				OriginalLabels: newCompressedLabels(promutil.NewLabelsFromMap(map[string]string{
+					"__address__": addr,
+				})),
+			},
+		}
+	}
+
+	// A job under the limit must register all of its targets.
+	t.Run("under limit", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		for i := range 3 {
+			sw := newTarget("foo", fmt.Sprintf("host%d:80", i), 5)
+			if !tsm.Register(sw) {
+				t.Fatalf("unexpected registration failure for target %d", i)
+			}
+		}
+		if n := tsm.downByJob["foo"]; n != 3 {
+			t.Fatalf("unexpected number of registered targets for job=foo; got %d; want 3", n)
+		}
+	})
+
+	// A job over the limit must have only up to the limit registered; the rest must be rejected.
+	t.Run("over limit", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		const limit = 3
+		const total = 10
+		var registered, rejected int
+		for i := range total {
+			sw := newTarget("foo", fmt.Sprintf("host%d:80", i), limit)
+			if tsm.Register(sw) {
+				registered++
+			} else {
+				rejected++
+			}
+		}
+		if registered != limit {
+			t.Fatalf("unexpected number of registered targets; got %d; want %d", registered, limit)
+		}
+		if rejected != total-limit {
+			t.Fatalf("unexpected number of rejected targets; got %d; want %d", rejected, total-limit)
+		}
+		if n := tsm.downByJob["foo"]; n != limit {
+			t.Fatalf("unexpected number of active targets for job=foo; got %d; want %d", n, limit)
+		}
+	})
+
+	// The default behavior (TargetLimit=0) must be unlimited.
+	t.Run("unlimited by default", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		const total = 50
+		for i := range total {
+			sw := newTarget("foo", fmt.Sprintf("host%d:80", i), 0)
+			if !tsm.Register(sw) {
+				t.Fatalf("unexpected registration failure for target %d with unlimited target_limit", i)
+			}
+		}
+		if n := tsm.downByJob["foo"]; n != total {
+			t.Fatalf("unexpected number of registered targets for job=foo; got %d; want %d", n, total)
+		}
+	})
+
+	// A target_limit for one job must not affect targets belonging to a different job.
+	t.Run("limit is scoped per job", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		for i := range 3 {
+			if !tsm.Register(newTarget("foo", fmt.Sprintf("foo-host%d:80", i), 3)) {
+				t.Fatalf("unexpected registration failure for job=foo target %d", i)
+			}
+		}
+		for i := range 3 {
+			if !tsm.Register(newTarget("bar", fmt.Sprintf("bar-host%d:80", i), 3)) {
+				t.Fatalf("unexpected registration failure for job=bar target %d", i)
+			}
+		}
+		if n := tsm.downByJob["foo"]; n != 3 {
+			t.Fatalf("unexpected number of active targets for job=foo; got %d; want 3", n)
+		}
+		if n := tsm.downByJob["bar"]; n != 3 {
+			t.Fatalf("unexpected number of active targets for job=bar; got %d; want 3", n)
+		}
+	})
