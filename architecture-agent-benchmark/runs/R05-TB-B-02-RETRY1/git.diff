+// TestScraperGroupUpdateTargetLimit verifies that scraperGroup.update() enforces the per-job
+// target_limit: a job under the limit keeps all of its targets active, a job over the limit is
+// truncated to the limit with the excess visible via droppedTargetsMap, and target_limit is
+// unlimited by default.
+func TestScraperGroupUpdateTargetLimit(t *testing.T) {
+	pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+	globalStopChan = make(chan struct{})
+	defer close(globalStopChan)
+
+	f := func(targetLimitLine string, targetCount, wantActive int) {
+		t.Helper()
+
+		jobName := fmt.Sprintf("job_%d", rand.Int())
+		targets := make([]string, targetCount)
+		for i := range targets {
+			targets[i] = fmt.Sprintf("%q", fmt.Sprintf("host%d:80", i))
+		}
+		cfgData := fmt.Sprintf(`
+scrape_configs:
+- job_name: %s
+%s  static_configs:
+  - targets: [%s]
+`, jobName, targetLimitLine, strings.Join(targets, ","))
+
+		var cfg Config
+		if err := cfg.parseData([]byte(cfgData), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sws := cfg.getStaticScrapeWork()
+		if len(sws) != targetCount {
+			t.Fatalf("unexpected number of parsed scrape works; got %d; want %d", len(sws), targetCount)
+		}
+
+		sg := newScraperGroup(fmt.Sprintf("static_configs_%d", rand.Int()), pushData, globalStopChan)
+		defer sg.stop()
+
+		sg.update(sws)
+
+		if n := len(sg.m); n != wantActive {
+			t.Fatalf("unexpected number of active scrapers; got %d; want %d", n, wantActive)
+		}
+
+		gotDropped := 0
+		for _, dt := range droppedTargetsMap.getTargetsList() {
+			if dt.dropReason == targetDropReasonTargetLimit && dt.originalLabels.getJob() == jobName {
+				gotDropped++
+			}
+		}
+		wantDropped := targetCount - wantActive
+		if gotDropped != wantDropped {
+			t.Fatalf("unexpected number of targets dropped because of target_limit; got %d; want %d", gotDropped, wantDropped)
+		}
+	}
+
+	// A job under the limit must be unaffected: all targets stay active and none is dropped.
+	f("  target_limit: 10\n", 3, 3)
+
+	// A job over the limit must be truncated to the limit, with the excess reported as dropped.
+	f("  target_limit: 2\n", 5, 2)
+
+	// target_limit is unlimited by default.
+	f("", 7, 7)
+}
+
+// TestScraperGroupUpdateTargetLimitAcrossSDMechanisms verifies that the per-job target_limit
+// is enforced across independent service discovery mechanisms, since each one drives its own
+// scraperGroup and they only share state via tsmGlobal.
+func TestScraperGroupUpdateTargetLimitAcrossSDMechanisms(t *testing.T) {
+	pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+	globalStopChan = make(chan struct{})
+	defer close(globalStopChan)
+
+	jobName := fmt.Sprintf("job_%d", rand.Int())
+	const targetLimit = 3
+
+	cfgData := fmt.Sprintf(`
+scrape_configs:
+- job_name: %s
+  target_limit: %d
+  static_configs:
+  - targets: ["a0:80","a1:80"]
+`, jobName, targetLimit)
+	var cfg Config
+	if err := cfg.parseData([]byte(cfgData), "test-scrape.yaml"); err != nil {
+		t.Fatalf("cannot parse config: %s", err)
+	}
+	swsA := cfg.getStaticScrapeWork()
+	if len(swsA) != 2 {
+		t.Fatalf("unexpected number of scrape works in group A; got %d; want 2", len(swsA))
+	}
+
+	// Build a second, independent batch of ScrapeWork for the same job_name, simulating targets
+	// discovered by a different service discovery mechanism (e.g. kubernetes_sd_configs).
+	swc, err := getScrapeWorkConfig(cfg.ScrapeConfigs[0], "", &cfg.Global)
+	if err != nil {
+		t.Fatalf("cannot build scrape work config: %s", err)
+	}
+	var swsB []*ScrapeWork
+	for _, addr := range []string{"b0:80", "b1:80", "b2:80"} {
+		sw, err := swc.getScrapeWork(addr, nil, nil)
+		if err != nil {
+			t.Fatalf("cannot build scrape work for %s: %s", addr, err)
+		}
+		if sw == nil {
+			t.Fatalf("unexpected nil scrape work for target %s", addr)
+		}
+		swsB = append(swsB, sw)
+	}
+
+	sgA := newScraperGroup(fmt.Sprintf("static_configs_%d", rand.Int()), pushData, globalStopChan)
+	defer sgA.stop()
+	sgB := newScraperGroup(fmt.Sprintf("kubernetes_sd_configs_%d", rand.Int()), pushData, globalStopChan)
+	defer sgB.stop()
+
+	sgA.update(swsA)
+	sgB.update(swsB)
+
+	total := len(sgA.m) + len(sgB.m)
+	if total != targetLimit {
+		t.Fatalf("unexpected total number of active targets across both service discovery mechanisms; got %d; want %d", total, targetLimit)
+	}
+}
