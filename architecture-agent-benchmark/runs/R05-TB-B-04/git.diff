diff --git a/lib/promscrape/scraper_test.go b/lib/promscrape/scraper_test.go
index 8a03fc4..f63ce4a 100644
--- a/lib/promscrape/scraper_test.go
+++ b/lib/promscrape/scraper_test.go
@@ -3,6 +3,7 @@ package promscrape
 import (
 	"fmt"
 	"math/rand"
+	"strings"
 	"testing"
 
 	"github.com/VictoriaMetrics/VictoriaMetrics/lib/auth"
@@ -79,3 +80,65 @@ scrape_configs:
     - targets:
         - localhost:8429`, true)
 }
+
+// TestScraperGroupMaxScrapeTargets verifies that scraperGroup.update() enforces
+// ScrapeWork.MaxScrapeTargets (the per-job_name target count cap) uniformly, regardless
+// of which service discovery mechanism produced the targets - static_configs is used here
+// only because it is the simplest one to drive directly in a test.
+func TestScraperGroupMaxScrapeTargets(t *testing.T) {
+	// f discovers targetsCount targets for a job configured with the given max_scrape_targets
+	// (0 means "not set" - falls back to the flag/global default, which is unlimited in tests)
+	// and returns the number of scrapers actually started and the number of targets dropped
+	// because of the limit.
+	f := func(maxScrapeTargets, targetsCount int) (started, dropped int) {
+		t.Helper()
+		pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+		globalStopChan = make(chan struct{})
+		defer close(globalStopChan)
+
+		randName := rand.Int()
+		jobName := fmt.Sprintf("job-%d", randName)
+		sg := newScraperGroup(fmt.Sprintf("static_configs_%d", randName), pushData, globalStopChan)
+		defer sg.stop()
+
+		var sb strings.Builder
+		fmt.Fprintf(&sb, "scrape_configs:\n- job_name: %s\n", jobName)
+		if maxScrapeTargets > 0 {
+			fmt.Fprintf(&sb, "  max_scrape_targets: %d\n", maxScrapeTargets)
+		}
+		sb.WriteString("  static_configs:\n  - targets:\n")
+		for i := 0; i < targetsCount; i++ {
+			fmt.Fprintf(&sb, "    - host-%d-%d:8429\n", randName, i)
+		}
+
+		var cfg Config
+		if err := cfg.parseData([]byte(sb.String()), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sws := cfg.getStaticScrapeWork()
+		sg.update(sws)
+
+		started = len(sg.m)
+		for _, dt := range droppedTargetsMap.getTargetsList() {
+			if dt.originalLabels.getJob() == jobName && dt.dropReason == targetDropReasonJobTargetLimit {
+				dropped++
+			}
+		}
+		return started, dropped
+	}
+
+	// A job under the limit must be unaffected: all targets are started and none are dropped.
+	if started, dropped := f(10, 5); started != 5 || dropped != 0 {
+		t.Fatalf("job under the limit: unexpected started=%d, dropped=%d; want started=5, dropped=0", started, dropped)
+	}
+
+	// A job over the limit must be truncated to max_scrape_targets, with the rest reported as dropped.
+	if started, dropped := f(5, 12); started != 5 || dropped != 7 {
+		t.Fatalf("job over the limit: unexpected started=%d, dropped=%d; want started=5, dropped=7", started, dropped)
+	}
+
+	// The default behavior (max_scrape_targets unset) must remain unlimited.
+	if started, dropped := f(0, 20); started != 20 || dropped != 0 {
+		t.Fatalf("default (unlimited) behavior: unexpected started=%d, dropped=%d; want started=20, dropped=0", started, dropped)
+	}
+}
