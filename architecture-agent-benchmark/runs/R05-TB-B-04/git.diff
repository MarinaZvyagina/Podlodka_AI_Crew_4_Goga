diff --git a/lib/promscrape/targetstatus.go b/lib/promscrape/targetstatus.go
index aa75dfc..eb514b1 100644
--- a/lib/promscrape/targetstatus.go
+++ b/lib/promscrape/targetstatus.go
@@ -166,6 +166,31 @@ func (tsm *targetStatusMap) Register(sw *scrapeWork) {
 	tsm.mu.Unlock()
 }
 
+// TryRegister atomically checks whether sw's job_name (sw.Config.jobNameOriginal) has fewer than
+// sw.Config.MaxScrapeTargets active targets and, if so, registers sw the same way as Register.
+//
+// It returns false without registering sw if the job already has sw.Config.MaxScrapeTargets active targets,
+// possibly discovered via other service discovery mechanisms. sw.Config.MaxScrapeTargets <= 0 means there is no limit.
+//
+// The check-and-register is performed atomically under tsm.mu, so this is safe to call concurrently
+// for the same job_name from independent service discovery mechanisms without exceeding the limit.
+func (tsm *targetStatusMap) TryRegister(sw *scrapeWork) bool {
+	jobName := sw.Config.jobNameOriginal
+	maxScrapeTargets := sw.Config.MaxScrapeTargets
+
+	tsm.mu.Lock()
+	if maxScrapeTargets > 0 && tsm.upByJob[jobName]+tsm.downByJob[jobName] >= maxScrapeTargets {
+		tsm.mu.Unlock()
+		return false
+	}
+	tsm.m[sw] = &targetStatus{
+		sw: sw,
+	}
+	tsm.downByJob[jobName]++
+	tsm.mu.Unlock()
+	return true
+}
+
 func (tsm *targetStatusMap) Unregister(sw *scrapeWork) {
 	jobName := sw.Config.jobNameOriginal
 
