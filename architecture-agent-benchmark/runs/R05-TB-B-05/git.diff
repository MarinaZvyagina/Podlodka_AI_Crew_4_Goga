+// limitScrapeWork truncates the newly discovered scrape targets for sc (located at dst[dstLen:])
+// down to sc.swc.maxScrapeTargets targets if the limit is set and exceeded.
+//
+// This protects vmagent from a misbehaving service discovery source (e.g. a cloud API, orchestrator
+// or catalog) which suddenly returns an abnormally big number of targets for a single job_name,
+// regardless of which service discovery mechanism produced these targets.
+//
+// Excess targets are registered as dropped targets, so they become visible at /targets
+// and /service-discovery pages the same way as targets dropped because of relabeling or sharding.
+func (sc *ScrapeConfig) limitScrapeWork(dst []*ScrapeWork, dstLen int) []*ScrapeWork {
+	maxTargets := sc.swc.maxScrapeTargets
+	if maxTargets <= 0 {
+		return dst
+	}
+	jobTargets := dst[dstLen:]
+	if len(jobTargets) <= maxTargets {
+		return dst
+	}
+	// Sort the targets in a deterministic order, so the same subset of targets is kept
+	// across config reloads as long as the set of discovered targets doesn't change.
+	sort.Slice(jobTargets, func(i, j int) bool {
+		return jobTargets[i].key() < jobTargets[j].key()
+	})
+	dropped := jobTargets[maxTargets:]
+	for _, sw := range dropped {
+		droppedTargetsMap.Register(sw.OriginalLabels, sw.RelabelConfigs, targetDropReasonJobTargetLimit, nil)
+	}
+	logger.Warnf("job_name=%q: dropping %d out of %d discovered scrape targets because their number exceeds the configured limit of %d targets; "+
+		"see -promscrape.maxScrapeTargetsPerJob and max_scrape_targets at https://docs.victoriametrics.com/victoriametrics/sd_configs/#scrape_configs",
+		sc.swc.jobName, len(dropped), len(jobTargets), maxTargets)
+	return dst[:dstLen+maxTargets]
+}
+
