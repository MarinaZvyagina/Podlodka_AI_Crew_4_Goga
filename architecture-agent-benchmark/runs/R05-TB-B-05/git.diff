diff --git a/lib/promscrape/config_test.go b/lib/promscrape/config_test.go
index 73ac545..7c92b83 100644
--- a/lib/promscrape/config_test.go
+++ b/lib/promscrape/config_test.go
@@ -1707,3 +1707,82 @@ scrape_configs:
 	})
 
 }
+
+func TestScrapeConfigMaxScrapeTargets(t *testing.T) {
+	getDroppedTargetsCountForJob := func(jobName string) int {
+		n := 0
+		for _, dt := range droppedTargetsMap.getTargetsList() {
+			if dt.dropReason == targetDropReasonJobTargetLimit && dt.originalLabels.getJob() == jobName {
+				n++
+			}
+		}
+		return n
+	}
+
+	f := func(data, jobName string, expectedURLs []string, expectedDroppedCount int) {
+		t.Helper()
+		sws, err := getStaticScrapeWork([]byte(data), "non-existing-file")
+		if err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		var gotURLs []string
+		for _, sw := range sws {
+			gotURLs = append(gotURLs, sw.ScrapeURL)
+		}
+		if !reflect.DeepEqual(gotURLs, expectedURLs) {
+			t.Fatalf("unexpected scrape target urls for job_name=%s;\ngot\n%v\nwant\n%v", jobName, gotURLs, expectedURLs)
+		}
+		if n := getDroppedTargetsCountForJob(jobName); n != expectedDroppedCount {
+			t.Fatalf("unexpected number of targets dropped because of the job target limit for job_name=%s; got %d; want %d", jobName, n, expectedDroppedCount)
+		}
+	}
+
+	// A job with fewer targets than max_scrape_targets is unaffected.
+	f(`
+scrape_configs:
+- job_name: under_limit
+  max_scrape_targets: 5
+  static_configs:
+  - targets: ["host1:80", "host2:80"]
+`, "under_limit", []string{"http://host1:80/metrics", "http://host2:80/metrics"}, 0)
+
+	// A job with more targets than max_scrape_targets is truncated, and the excess targets
+	// are registered as dropped targets, so they become visible at /targets and /service-discovery.
+	f(`
+scrape_configs:
+- job_name: over_limit
+  max_scrape_targets: 3
+  static_configs:
+  - targets: ["host1:80", "host2:80", "host3:80", "host4:80", "host5:80"]
+`, "over_limit", []string{"http://host1:80/metrics", "http://host2:80/metrics", "http://host3:80/metrics"}, 2)
+
+	// The default behavior is unlimited: no targets are dropped when max_scrape_targets isn't set
+	// and -promscrape.maxScrapeTargetsPerJob is left at its default value of 0.
+	f(`
+scrape_configs:
+- job_name: unlimited_by_default
+  static_configs:
+  - targets: ["host1:80", "host2:80", "host3:80", "host4:80", "host5:80"]
+`, "unlimited_by_default", []string{
+		"http://host1:80/metrics", "http://host2:80/metrics", "http://host3:80/metrics", "http://host4:80/metrics", "http://host5:80/metrics",
+	}, 0)
+
+	// -promscrape.maxScrapeTargetsPerJob sets the default limit for jobs without their own max_scrape_targets,
+	// while a per-job max_scrape_targets value overrides it, including explicitly disabling the limit with 0.
+	defaultMaxScrapeTargetsPerJob := *maxScrapeTargetsPerJob
+	*maxScrapeTargetsPerJob = 2
+	f(`
+scrape_configs:
+- job_name: global_default_limit
+  static_configs:
+  - targets: ["host1:80", "host2:80", "host3:80"]
+`, "global_default_limit", []string{"http://host1:80/metrics", "http://host2:80/metrics"}, 1)
+	f(`
+scrape_configs:
+- job_name: explicit_unlimited_override
+  max_scrape_targets: 0
+  static_configs:
+  - targets: ["host1:80", "host2:80", "host3:80"]
+`, "explicit_unlimited_override", []string{"http://host1:80/metrics", "http://host2:80/metrics", "http://host3:80/metrics"}, 0)
+	*maxScrapeTargetsPerJob = defaultMaxScrapeTargetsPerJob
+}
