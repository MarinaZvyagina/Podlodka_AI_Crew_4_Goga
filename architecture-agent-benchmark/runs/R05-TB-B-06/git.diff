@@ -166,6 +166,30 @@ func (tsm *targetStatusMap) Register(sw *scrapeWork) {
 	tsm.mu.Unlock()
 }
 
+// RegisterIfBelowLimit registers sw the same way Register does, but only if the number of currently
+// active targets for sw's job_name is below sw.Config.MaxScrapeTargets.
+//
+// The active targets count is shared across all service discovery mechanisms feeding the given job_name,
+// so the limit is enforced uniformly no matter which mechanism (or mix of mechanisms) produced the target.
+//
+// It returns false without registering sw if the job_name has already reached its limit.
+// sw.Config.MaxScrapeTargets <= 0 means "no limit".
+func (tsm *targetStatusMap) RegisterIfBelowLimit(sw *scrapeWork) bool {
+	jobName := sw.Config.jobNameOriginal
+	limit := sw.Config.MaxScrapeTargets
+
+	tsm.mu.Lock()
+	defer tsm.mu.Unlock()
+	if limit > 0 && tsm.upByJob[jobName]+tsm.downByJob[jobName] >= limit {
+		return false
+	}
+	tsm.m[sw] = &targetStatus{
+		sw: sw,
+	}
+	tsm.downByJob[jobName]++
+	return true
+}
