+func TestTargetStatusMapRegisterIfBelowLimit(t *testing.T) {
+	newSW := func(jobName string, maxScrapeTargets int) *scrapeWork {
+		return &scrapeWork{
+			Config: &ScrapeWork{
+				jobNameOriginal:  jobName,
+				MaxScrapeTargets: maxScrapeTargets,
+				OriginalLabels: newCompressedLabels(promutil.NewLabelsFromMap(map[string]string{
+					"__address__": "host:80",
+				})),
+			},
+		}
+	}
+
+	// A job under its limit must accept every target.
+	tsm := newTargetStatusMap()
+	for i := 0; i < 3; i++ {
+		if !tsm.RegisterIfBelowLimit(newSW("under-limit", 5)) {
+			t.Fatalf("target %d unexpectedly rejected for a job under its limit", i)
+		}
+	}
+	if n := tsm.upByJob["under-limit"] + tsm.downByJob["under-limit"]; n != 3 {
+		t.Fatalf("unexpected active target count for job under its limit; got %d; want 3", n)
+	}
+
+	// A job over its limit must be truncated at the configured maximum.
+	tsm = newTargetStatusMap()
+	var accepted, rejected int
+	for i := 0; i < 5; i++ {
+		if tsm.RegisterIfBelowLimit(newSW("over-limit", 2)) {
+			accepted++
+		} else {
+			rejected++
+		}
+	}
+	if accepted != 2 {
+		t.Fatalf("unexpected number of accepted targets for job over its limit; got %d; want 2", accepted)
+	}
+	if rejected != 3 {
+		t.Fatalf("unexpected number of rejected targets for job over its limit; got %d; want 3", rejected)
+	}
+
+	// MaxScrapeTargets=0 (the default) means unlimited.
+	tsm = newTargetStatusMap()
+	for i := 0; i < 1000; i++ {
+		if !tsm.RegisterIfBelowLimit(newSW("unlimited", 0)) {
+			t.Fatalf("target %d unexpectedly rejected for a job with no configured limit", i)
+		}
+	}
+	if n := tsm.upByJob["unlimited"] + tsm.downByJob["unlimited"]; n != 1000 {
+		t.Fatalf("unexpected active target count for unlimited job; got %d; want 1000", n)
+	}
+}
