+func TestScraperGroupMaxScrapeTargetsPerJob(t *testing.T) {
+	defaultMaxScrapeTargetsPerJob := *maxScrapeTargetsPerJob
+	defer func() { *maxScrapeTargetsPerJob = defaultMaxScrapeTargetsPerJob }()
+	*maxScrapeTargetsPerJob = 2
+
+	pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+	globalStopChan = make(chan struct{})
+	defer close(globalStopChan)
+
+	randName := rand.Int()
+	jobName := fmt.Sprintf("many-targets-%d", randName)
+	sg := newScraperGroup(fmt.Sprintf("static_configs_%d", randName), pushData, globalStopChan)
+	defer sg.stop()
+
+	var cfg Config
+	cfgData := fmt.Sprintf(`
+scrape_configs:
+- job_name: %s
+  static_configs:
+    - targets:
+        - localhost:8951
+        - localhost:8952
+        - localhost:8953
+        - localhost:8954`, jobName)
+	if err := cfg.parseData([]byte(cfgData), "test-scrape.yaml"); err != nil {
+		t.Fatalf("cannot parse config: %s", err)
+	}
+	sws := cfg.getStaticScrapeWork()
+	if len(sws) != 4 {
+		t.Fatalf("unexpected number of discovered ScrapeWork items; got %d; want 4", len(sws))
+	}
+
+	sg.update(sws)
+
+	// Only -promscrape.maxScrapeTargetsPerJob targets must be actually started, regardless
+	// of the number of targets discovered for the job_name.
+	sg.mLock.Lock()
+	gotActive := len(sg.m)
+	sg.mLock.Unlock()
+	if gotActive != 2 {
+		t.Fatalf("unexpected number of active scrapers for a job over its limit; got %d; want 2", gotActive)
+	}
+
+	// The excess targets must be visible as dropped because of the per-job targets limit -
+	// this is the same droppedTargetsMap used for rendering /service-discovery and /api/v1/targets.
+	var droppedForJob int
+	for _, dt := range droppedTargetsMap.getTargetsList() {
+		if dt.originalLabels.getJob() == jobName {
+			if dt.dropReason != targetDropReasonTargetsLimit {
+				t.Fatalf("unexpected drop reason for job %s; got %q; want %q", jobName, dt.dropReason, targetDropReasonTargetsLimit)
+			}
+			droppedForJob++
+		}
+	}
+	if droppedForJob != 2 {
+		t.Fatalf("unexpected number of dropped targets for job over its limit; got %d; want 2", droppedForJob)
+	}
+}
