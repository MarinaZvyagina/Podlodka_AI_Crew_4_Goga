+func TestDroppedTargetsGetTotalTargetsByJobAndReason(t *testing.T) {
+	dtm := &droppedTargets{
+		m: make(map[uint64]droppedTarget),
+	}
+	dtm.Register(newCompressedLabels(promutil.MustNewLabelsFromString(`{job="a",instance="host1:80"}`)), nil, targetDropReasonMaxScrapeTargets, nil)
+	dtm.Register(newCompressedLabels(promutil.MustNewLabelsFromString(`{job="a",instance="host2:80"}`)), nil, targetDropReasonMaxScrapeTargets, nil)
+	dtm.Register(newCompressedLabels(promutil.MustNewLabelsFromString(`{job="a",instance="host3:80"}`)), nil, targetDropReasonRelabeling, nil)
+	dtm.Register(newCompressedLabels(promutil.MustNewLabelsFromString(`{job="b",instance="host4:80"}`)), nil, targetDropReasonMaxScrapeTargets, nil)
+
+	f := func(jobName string, reason targetDropReason, want int) {
+		t.Helper()
+		got := dtm.getTotalTargetsByJobAndReason(jobName, reason)
+		if got != want {
+			t.Fatalf("unexpected count for job=%q reason=%q; got %d; want %d", jobName, reason, got, want)
+		}
+	}
+	f("a", targetDropReasonMaxScrapeTargets, 2)
+	f("a", targetDropReasonRelabeling, 1)
+	f("b", targetDropReasonMaxScrapeTargets, 1)
+	f("c", targetDropReasonMaxScrapeTargets, 0)
+}
+
+// TestJobTargetsStatusesMaxScrapeTargetsVisibility verifies that jobs which exceeded
+// their max_scrape_targets limit are surfaced via getTargetsStatusByJob(), which feeds
+// the /targets, /service-discovery and /api/v1/targets endpoints.
+func TestJobTargetsStatusesMaxScrapeTargetsVisibility(t *testing.T) {
+	jobName := "test_max_scrape_targets_job_xyz"
+
+	tsm := newTargetStatusMap()
+	tsm.Register(&scrapeWork{
+		Config: &ScrapeWork{
+			jobNameOriginal: jobName,
+			OriginalLabels: newCompressedLabels(promutil.NewLabelsFromMap(map[string]string{
+				"__address__": "host1:80",
+				"job":         jobName,
+			})),
+		},
+	})
+
+	excludedLabels := promutil.NewLabelsFromMap(map[string]string{
+		"__address__": "host2:80",
+		"job":         jobName,
+	})
+	droppedTargetsMap.Register(newCompressedLabels(excludedLabels), nil, targetDropReasonMaxScrapeTargets, nil)
+
+	tsr := tsm.getTargetsStatusByJob(&requestFilter{})
+	var jts *jobTargetsStatuses
+	for _, j := range tsr.jobTargetsStatuses {
+		if j.jobName == jobName {
+			jts = j
+		}
+	}
+	if jts == nil {
+		t.Fatalf("expected job %q to be present in jobTargetsStatuses", jobName)
+	}
+	if jts.targetsLimitExceededCount != 1 {
+		t.Fatalf("unexpected targetsLimitExceededCount; got %d; want 1", jts.targetsLimitExceededCount)
+	}
+}
