+// limitScrapeWorks truncates the targets discovered for sc (occupying dst[dstLen:]) down to
+// sc.swc.maxScrapeTargets, if the limit is set and exceeded.
+//
+// This protects vmagent from being overloaded when a misconfigured service discovery mechanism
+// suddenly returns an excessive number of targets for a single job_name. The excess targets are
+// registered as dropped, so operators can notice the truncation at /service-discovery and /api/v1/targets.
+func (sc *ScrapeConfig) limitScrapeWorks(dst []*ScrapeWork, dstLen int) []*ScrapeWork {
+	maxTargets := sc.swc.maxScrapeTargets
+	if maxTargets <= 0 || len(dst)-dstLen <= maxTargets {
+		return dst
+	}
+	excess := dst[dstLen+maxTargets:]
+	for _, sw := range excess {
+		droppedTargetsMap.Register(sw.OriginalLabels, sw.RelabelConfigs, targetDropReasonMaxScrapeTargets, nil)
+	}
+	logger.Warnf("job_name=%q discovered %d targets, which exceeds max_scrape_targets=%d; dropping the excess %d targets; "+
+		"see https://docs.victoriametrics.com/victoriametrics/vmagent/#limiting-the-number-of-targets-per-job",
+		sc.swc.jobName, len(dst)-dstLen, maxTargets, len(excess))
+	return dst[:dstLen+maxTargets]
+}
