+func TestGetStaticScrapeWorkMaxScrapeTargets(t *testing.T) {
+	f := func(data string, expectedSws []*ScrapeWork) {
+		t.Helper()
+		sws, err := getStaticScrapeWork([]byte(data), "non-exsiting-file")
+		if err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		checkEqualScrapeWorks(t, sws, expectedSws)
+	}
+	newSW := func(jobName, addr string) *ScrapeWork {
+		return &ScrapeWork{
+			ScrapeURL:      "http://" + addr + "/metrics",
+			ScrapeInterval: defaultScrapeInterval,
+			ScrapeTimeout:  defaultScrapeTimeout,
+			MaxScrapeSize:  maxScrapeSize.N,
+			Labels: promutil.NewLabelsFromMap(map[string]string{
+				"instance": addr,
+				"job":      jobName,
+			}),
+			jobNameOriginal: jobName,
+		}
+	}
+
+	// A job under its configured max_scrape_targets limit must keep all of its targets unaffected.
+	f(`
+scrape_configs:
+- job_name: under
+  max_scrape_targets: 5
+  static_configs:
+  - targets: ["a:1", "b:1"]
+`, []*ScrapeWork{
+		newSW("under", "a:1"),
+		newSW("under", "b:1"),
+	})
+
+	// A job over its configured max_scrape_targets limit must be truncated down to the limit,
+	// and the excess targets must be registered as dropped targets with targetDropReasonMaxScrapeTargets,
+	// so they remain visible at /service-discovery and /api/v1/targets.
+	dtBefore := droppedTargetsMap.getTotalTargetsByJobAndReason("over", targetDropReasonMaxScrapeTargets)
+	f(`
+scrape_configs:
+- job_name: over
+  max_scrape_targets: 2
+  static_configs:
+  - targets: ["a:1", "b:1", "c:1", "d:1"]
+`, []*ScrapeWork{
+		newSW("over", "a:1"),
+		newSW("over", "b:1"),
+	})
+	if n := droppedTargetsMap.getTotalTargetsByJobAndReason("over", targetDropReasonMaxScrapeTargets) - dtBefore; n != 2 {
+		t.Fatalf("unexpected number of newly dropped targets because of max_scrape_targets; got %d; want 2", n)
+	}
+
+	// max_scrape_targets is unlimited (0/unset) by default, so existing setups aren't affected
+	// regardless of the number of discovered targets.
+	f(`
+scrape_configs:
+- job_name: unlimited
+  static_configs:
+  - targets: ["a:1", "b:1", "c:1"]
+`, []*ScrapeWork{
+		newSW("unlimited", "a:1"),
+		newSW("unlimited", "b:1"),
+		newSW("unlimited", "c:1"),
+	})
+
+	// The global max_scrape_targets sets a default limit for all jobs, while a job-level
+	// max_scrape_targets overrides the global default.
+	f(`
+global:
+  max_scrape_targets: 1
+scrape_configs:
+- job_name: global-default
+  static_configs:
+  - targets: ["a:1", "b:1"]
+- job_name: job-override
+  max_scrape_targets: 5
+  static_configs:
+  - targets: ["a:1", "b:1"]
+`, []*ScrapeWork{
+		newSW("global-default", "a:1"),
+		newSW("job-override", "a:1"),
+		newSW("job-override", "b:1"),
+	})
+}
