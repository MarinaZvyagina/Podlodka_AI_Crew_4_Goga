+func TestScraperGroupUpdateMaxScrapeTargets(t *testing.T) {
+	f := func(maxScrapeTargets, targetsCount int) (activeTargets, droppedTargetsDelta int) {
+		t.Helper()
+		pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+		globalStopChan = make(chan struct{})
+		defer close(globalStopChan)
+
+		jobName := fmt.Sprintf("job_%d", rand.Int())
+		sg := newScraperGroup(fmt.Sprintf("static_configs_%d", rand.Int()), pushData, globalStopChan)
+		defer sg.stop()
+
+		var sb []byte
+		sb = append(sb, fmt.Sprintf("scrape_configs:\n- job_name: %s\n", jobName)...)
+		if maxScrapeTargets > 0 {
+			sb = append(sb, fmt.Sprintf("  max_scrape_targets: %d\n", maxScrapeTargets)...)
+		}
+		sb = append(sb, "  static_configs:\n  - targets:\n"...)
+		for i := 0; i < targetsCount; i++ {
+			sb = append(sb, fmt.Sprintf("    - host%d:80\n", i)...)
+		}
+
+		var cfg Config
+		if err := cfg.parseData(sb, "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sws := cfg.getStaticScrapeWork()
+
+		droppedBefore := droppedTargetsMap.getTotalTargets()
+		sg.update(sws)
+		droppedAfter := droppedTargetsMap.getTotalTargets()
+
+		return len(sg.m), droppedAfter - droppedBefore
+	}
+
+	// Default (unlimited): a job with a large number of targets must have all of them scraped.
+	activeTargets, droppedDelta := f(0, 50)
+	if activeTargets != 50 {
+		t.Fatalf("unexpected number of active targets for unlimited job; got %d; want 50", activeTargets)
+	}
+	if droppedDelta != 0 {
+		t.Fatalf("unexpected number of newly dropped targets for unlimited job; got %d; want 0", droppedDelta)
+	}
+
+	// Under the limit: the job must be unaffected.
+	activeTargets, droppedDelta = f(10, 5)
+	if activeTargets != 5 {
+		t.Fatalf("unexpected number of active targets for job under the limit; got %d; want 5", activeTargets)
+	}
+	if droppedDelta != 0 {
+		t.Fatalf("unexpected number of newly dropped targets for job under the limit; got %d; want 0", droppedDelta)
+	}
+
+	// Over the limit: only max_scrape_targets targets must be scraped, and the rest
+	// must become visible as newly dropped targets.
+	activeTargets, droppedDelta = f(3, 10)
+	if activeTargets != 3 {
+		t.Fatalf("unexpected number of active targets for job over the limit; got %d; want 3", activeTargets)
+	}
+	if droppedDelta != 7 {
+		t.Fatalf("unexpected number of newly dropped targets for job over the limit; got %d; want 7", droppedDelta)
+	}
+}
