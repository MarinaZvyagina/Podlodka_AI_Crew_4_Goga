 func (tsm *targetStatusMap) Register(sw *scrapeWork) {
+	tsm.tryRegister(sw, 0)
+}
+
+// jobTargetsCount returns the current number of active (registered) targets for the given job.
+func (tsm *targetStatusMap) jobTargetsCount(jobName string) int {
+	tsm.mu.Lock()
+	n := tsm.upByJob[jobName] + tsm.downByJob[jobName]
+	tsm.mu.Unlock()
+	return n
+}
+
+// tryRegister registers sw for scraping and returns true, unless the job identified by
+// sw.Config.jobNameOriginal already has maxTargets active targets registered, in which case
+// it returns false and the caller must not start scraping sw.
+//
+// maxTargets<=0 means "no limit".
+//
+// This provides a safety net against a single scrape job (job_name) accumulating an unbounded
+// number of active targets, regardless of which service discovery mechanism(s) produced them.
+func (tsm *targetStatusMap) tryRegister(sw *scrapeWork, maxTargets int) bool {
 	jobName := sw.Config.jobNameOriginal
 
 	tsm.mu.Lock()
+	defer tsm.mu.Unlock()
+	if maxTargets > 0 && tsm.upByJob[jobName]+tsm.downByJob[jobName] >= maxTargets {
+		return false
+	}
 	tsm.m[sw] = &targetStatus{
 		sw: sw,
 	}
 	tsm.downByJob[jobName]++
-	tsm.mu.Unlock()
+	return true
 }
 
