+// limitScrapeWorksByJob drops the tail of sws exceeding the per-job MaxScrapeTargets limit, if any of sws has it set.
+//
+// The limit is applied on top of jobs' currently active target count (tsmGlobal.ActiveTargetsCount), so it is enforced
+// consistently for a job regardless of which service discovery mechanism(s) - or which scraperGroup - contributed targets
+// for that job. Targets, which don't fit into the limit, are registered at droppedTargetsMap, so operators can see
+// which jobs are over the limit and how many targets are excluded because of it at /targets and /api/v1/targets pages.
+func limitScrapeWorksByJob(sws []*ScrapeWork) []*ScrapeWork {
+	hasLimit := false
+	for _, sw := range sws {
+		if sw.MaxScrapeTargets > 0 {
+			hasLimit = true
+			break
+		}
+	}
+	if !hasLimit {
+		return sws
+	}
+
+	// Sort sws by (jobNameOriginal, ScrapeURL), so the set of targets accepted for a capped job
+	// is stable across discovery rounds regardless of the order returned by service discovery.
+	sort.Slice(sws, func(i, j int) bool {
+		a, b := sws[i], sws[j]
+		if a.jobNameOriginal != b.jobNameOriginal {
+			return a.jobNameOriginal < b.jobNameOriginal
+		}
+		return a.ScrapeURL < b.ScrapeURL
+	})
+
+	activeCounts := make(map[string]int)
+	dst := sws[:0]
+	for _, sw := range sws {
+		if sw.MaxScrapeTargets <= 0 {
+			dst = append(dst, sw)
+			continue
+		}
+		jobName := sw.jobNameOriginal
+		n, ok := activeCounts[jobName]
+		if !ok {
+			n = tsmGlobal.ActiveTargetsCount(jobName)
+		}
+		if n >= sw.MaxScrapeTargets {
+			droppedTargetsMap.Register(sw.OriginalLabels, sw.RelabelConfigs, targetDropReasonMaxScrapeTargets, nil)
+			activeCounts[jobName] = n
+			continue
+		}
+		activeCounts[jobName] = n + 1
+		dst = append(dst, sw)
+	}
+	return dst
+}
