+func TestScraperGroupMaxScrapeTargets(t *testing.T) {
+	// f starts a scraperGroup, applies cfgData to it and verifies that exactly wantActive targets
+	// out of the discovered ones end up actually scraped for jobName, and that the rest are visible
+	// as dropped targets (with the max_scrape_targets reason) at the target status page.
+	f := func(cfgData, jobName string, wantActive int) {
+		t.Helper()
+
+		pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+		globalStopChan = make(chan struct{})
+		defer close(globalStopChan)
+
+		randName := rand.Int()
+		sg := newScraperGroup(fmt.Sprintf("static_configs_%d", randName), pushData, globalStopChan)
+		defer sg.stop()
+
+		var cfg Config
+		if err := cfg.parseData([]byte(cfgData), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sws := cfg.getStaticScrapeWork()
+		wantDropped := len(sws) - wantActive
+
+		droppedBefore := droppedTargetsMap.getTotalTargets()
+		sg.update(sws)
+
+		if n := len(sg.m); n != wantActive {
+			t.Fatalf("unexpected number of started scrapers for job_name=%q; got %d; want %d", jobName, n, wantActive)
+		}
+		if n := tsmGlobal.ActiveTargetsCount(jobName); n != wantActive {
+			t.Fatalf("unexpected ActiveTargetsCount for job_name=%q; got %d; want %d", jobName, n, wantActive)
+		}
+		if n := droppedTargetsMap.getTotalTargets() - droppedBefore; n != wantDropped {
+			t.Fatalf("unexpected number of newly dropped targets for job_name=%q; got %d; want %d", jobName, n, wantDropped)
+		}
+
+		tsr := tsmGlobal.getTargetsStatusByJob(&requestFilter{originalJobName: jobName})
+		tlsByJob := tsr.getTargetLabelsByJob()
+		if wantDropped == 0 {
+			for _, tlj := range tlsByJob {
+				if tlj.jobName == jobName && tlj.droppedTargets != 0 {
+					t.Fatalf("unexpected droppedTargets at status page for job_name=%q; got %d; want 0", jobName, tlj.droppedTargets)
+				}
+			}
+			return
+		}
+		var found bool
+		for _, tlj := range tlsByJob {
+			if tlj.jobName != jobName {
+				continue
+			}
+			found = true
+			if tlj.activeTargets != wantActive {
+				t.Fatalf("unexpected activeTargets at status page for job_name=%q; got %d; want %d", jobName, tlj.activeTargets, wantActive)
+			}
+			if tlj.droppedTargets != wantDropped {
+				t.Fatalf("unexpected droppedTargets at status page for job_name=%q; got %d; want %d", jobName, tlj.droppedTargets, wantDropped)
+			}
+			for _, tl := range tlj.targets {
+				if tl.dropReason != "" && tl.dropReason != targetDropReasonMaxScrapeTargets {
+					t.Fatalf("unexpected dropReason for job_name=%q; got %q; want %q", jobName, tl.dropReason, targetDropReasonMaxScrapeTargets)
+				}
+			}
+		}
+		if !found {
+			t.Fatalf("job_name=%q is missing from the target status page", jobName)
+		}
+	}
+
+	// A job under the configured limit must be unaffected: all discovered targets are scraped.
+	f(`
+scrape_configs:
+- job_name: under-limit
+  max_scrape_targets: 10
+  static_configs:
+  - targets: ["h1:1", "h2:1", "h3:1"]`, "under-limit", 3)
+
+	// A job over the configured limit must be truncated to the limit, with the rest visible as dropped.
+	f(`
+scrape_configs:
+- job_name: over-limit
+  max_scrape_targets: 2
+  static_configs:
+  - targets: ["h1:1", "h2:1", "h3:1", "h4:1"]`, "over-limit", 2)
+
+	// The default behavior (max_scrape_targets unset) must remain unlimited.
+	f(`
+scrape_configs:
+- job_name: unlimited
+  static_configs:
+  - targets: ["h1:1", "h2:1", "h3:1", "h4:1", "h5:1"]`, "unlimited", 5)
+}
