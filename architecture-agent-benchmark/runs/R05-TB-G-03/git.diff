+func TestTargetStatusMapRegisterMaxTargetsPerJob(t *testing.T) {
+	newScrapeWorkForJob := func(jobName, address string, maxTargetsPerJob int) *scrapeWork {
+		return &scrapeWork{
+			Config: &ScrapeWork{
+				jobNameOriginal:  jobName,
+				MaxTargetsPerJob: maxTargetsPerJob,
+				OriginalLabels: newCompressedLabels(promutil.NewLabelsFromMap(map[string]string{
+					"__address__": address,
+					"job":         jobName,
+				})),
+			},
+		}
+	}
+
+	// A job with a target count under its configured limit must have all of its targets registered.
+	t.Run("UnderLimit", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		for i := 0; i < 3; i++ {
+			sw := newScrapeWorkForJob("under-limit", fmt.Sprintf("host%d:80", i), 5)
+			if !tsm.Register(sw) {
+				t.Fatalf("target %d must be registered, since the job is under its max_targets_per_job limit", i)
+			}
+		}
+		if n := tsm.upByJob["under-limit"] + tsm.downByJob["under-limit"]; n != 3 {
+			t.Fatalf("unexpected number of active targets for job; got %d; want 3", n)
+		}
+	})
+
+	// A job with a target count over its configured limit must have only maxTargetsPerJob targets registered;
+	// the rest must be rejected so the caller can report them as dropped targets.
+	t.Run("OverLimit", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		const maxTargetsPerJob = 3
+		const totalTargets = 10
+		registered := 0
+		rejected := 0
+		for i := 0; i < totalTargets; i++ {
+			sw := newScrapeWorkForJob("over-limit", fmt.Sprintf("host%d:80", i), maxTargetsPerJob)
+			if tsm.Register(sw) {
+				registered++
+			} else {
+				rejected++
+			}
+		}
+		if registered != maxTargetsPerJob {
+			t.Fatalf("unexpected number of registered targets; got %d; want %d", registered, maxTargetsPerJob)
+		}
+		if rejected != totalTargets-maxTargetsPerJob {
+			t.Fatalf("unexpected number of rejected targets; got %d; want %d", rejected, totalTargets-maxTargetsPerJob)
+		}
+		if n := tsm.upByJob["over-limit"] + tsm.downByJob["over-limit"]; n != maxTargetsPerJob {
+			t.Fatalf("unexpected number of active targets for job; got %d; want %d", n, maxTargetsPerJob)
+		}
+	})
+
+	// The default value of max_targets_per_job (0) must mean "unlimited", so every target gets registered.
+	t.Run("DefaultUnlimited", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		const totalTargets = 1000
+		for i := 0; i < totalTargets; i++ {
+			sw := newScrapeWorkForJob("unlimited", fmt.Sprintf("host%d:80", i), 0)
