+// TestScraperGroupUpdateRespectsMaxTargetsPerJob verifies that scraperGroup.update()
+// starts scrapers for at most max_targets_per_job targets of a job, regardless of how many
+// targets were discovered for it, and that the excess targets are reported as dropped targets.
+func TestScraperGroupUpdateRespectsMaxTargetsPerJob(t *testing.T) {
+	f := func(maxTargetsPerJob, totalTargets, wantStarted int) {
+		t.Helper()
+
+		pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+		globalStopChan = make(chan struct{})
+		defer close(globalStopChan)
+
+		randName := rand.Int()
+		sg := newScraperGroup(fmt.Sprintf("static_configs_%d", randName), pushData, globalStopChan)
+		defer sg.stop()
+
+		var targets strings.Builder
+		for i := 0; i < totalTargets; i++ {
+			fmt.Fprintf(&targets, "        - host%d_%d:80\n", randName, i)
+		}
+		cfgData := fmt.Sprintf(`
+scrape_configs:
+- job_name: many-targets-job_%d
+  max_targets_per_job: %d
+  static_configs:
+    - targets:
+%s`, randName, maxTargetsPerJob, targets.String())
+
+		var cfg Config
+		if err := cfg.parseData([]byte(cfgData), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sws := cfg.getStaticScrapeWork()
+		if len(sws) != totalTargets {
+			t.Fatalf("unexpected number of discovered scrape targets; got %d; want %d", len(sws), totalTargets)
+		}
+
+		droppedBefore := droppedTargetsMap.getTotalTargets()
+		sg.update(sws)
+
+		if len(sg.m) != wantStarted {
+			t.Fatalf("unexpected number of started scrapers; got %d; want %d", len(sg.m), wantStarted)
+		}
+		if n := sg.activeScrapers.Get(); n != uint64(wantStarted) {
+			t.Fatalf("unexpected number of active scrapers; got %d; want %d", n, wantStarted)
+		}
+		activeTargets := tsmGlobal.StatusByGroup(sg.name, true) + tsmGlobal.StatusByGroup(sg.name, false)
+		if activeTargets != wantStarted {
+			t.Fatalf("unexpected number of targets registered in tsmGlobal; got %d; want %d", activeTargets, wantStarted)
+		}
+		wantDropped := totalTargets - wantStarted
+		if got := droppedTargetsMap.getTotalTargets() - droppedBefore; got != wantDropped {
+			t.Fatalf("unexpected number of newly dropped targets; got %d; want %d", got, wantDropped)
+		}
+	}
+
+	// A job with fewer targets than its max_targets_per_job limit must have all of its targets scraped.
+	f(5, 3, 3)
+
+	// A job with more targets than its max_targets_per_job limit must have only the limit's worth of targets
+	// scraped; the rest must show up as dropped targets.
+	f(3, 10, 3)
+
+	// max_targets_per_job=0 (the default) means unlimited: every discovered target must be scraped.
+	f(0, 10, 10)
+}
