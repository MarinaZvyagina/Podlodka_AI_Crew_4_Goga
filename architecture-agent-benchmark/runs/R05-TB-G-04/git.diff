+
+// newStaticScrapeConfigData returns a scrape config with targetsCount static targets for jobName.
+// If maxScrapeTargets > 0, it is set as the job's max_scrape_targets override.
+func newStaticScrapeConfigData(jobName string, maxScrapeTargets, targetsCount int) string {
+	var sb strings.Builder
+	fmt.Fprintf(&sb, "scrape_configs:\n- job_name: %s\n", jobName)
+	if maxScrapeTargets > 0 {
+		fmt.Fprintf(&sb, "  max_scrape_targets: %d\n", maxScrapeTargets)
+	}
+	sb.WriteString("  static_configs:\n  - targets:\n")
+	for i := range targetsCount {
+		fmt.Fprintf(&sb, "    - '127.0.0.1:%d'\n", 10000+i)
+	}
+	return sb.String()
+}
+
+// updateScraperGroupForJob parses a static scrape config for jobName with the given max_scrape_targets
+// override and targetsCount targets, feeds it through scraperGroup.update() and returns the resulting
+// number of started scrapers, the number of targets tsmGlobal considers active for the job, and the
+// number of targets tsmGlobal reports as excluded because of the job's scrape target limit.
+func updateScraperGroupForJob(t *testing.T, jobName string, maxScrapeTargets, targetsCount int) (started, active, overLimit int) {
+	t.Helper()
+
+	pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+	globalStopChan = make(chan struct{})
+	defer close(globalStopChan)
+
+	sg := newScraperGroup(fmt.Sprintf("static_configs_%d", rand.Int()), pushData, globalStopChan)
+	defer sg.stop()
+
+	var cfg Config
+	data := newStaticScrapeConfigData(jobName, maxScrapeTargets, targetsCount)
+	if err := cfg.parseData([]byte(data), "test-scrape.yaml"); err != nil {
+		t.Fatalf("cannot parse config: %s", err)
+	}
+	sws := cfg.getStaticScrapeWork()
+	sg.update(sws)
+
+	started = len(sg.m)
+	active = tsmGlobal.ActiveTargetsCount(jobName)
+
+	tsr := tsmGlobal.getTargetsStatusByJob(&requestFilter{originalJobName: jobName})
+	for _, jts := range tsr.jobTargetsStatuses {
+		if jts.jobName == jobName {
+			overLimit = jts.overLimitCount
+		}
+	}
+	return started, active, overLimit
+}
+
+// droppedForTargetsLimit returns how many entries in droppedTargetsMap belong to jobName
+// and were dropped because of the per-job scrape targets limit.
+func droppedForTargetsLimit(jobName string) int {
+	n := 0
+	for _, dt := range droppedTargetsMap.getTargetsList() {
+		if dt.dropReason == targetDropReasonTargetsLimitExceeded && dt.originalLabels.getJob() == jobName {
+			n++
+		}
+	}
+	return n
+}
+
+func TestScraperGroupUpdateMaxScrapeTargets(t *testing.T) {
+	t.Run("job under the limit is unaffected", func(t *testing.T) {
+		jobName := fmt.Sprintf("under-limit-%d", rand.Int())
+		started, active, overLimit := updateScraperGroupForJob(t, jobName, 10, 5)
+		if started != 5 {
+			t.Fatalf("unexpected number of started scrapers; got %d; want 5", started)
+		}
+		if active != 5 {
+			t.Fatalf("unexpected number of active targets; got %d; want 5", active)
+		}
+		if overLimit != 0 {
+			t.Fatalf("unexpected overLimitCount; got %d; want 0", overLimit)
+		}
+		if n := droppedForTargetsLimit(jobName); n != 0 {
+			t.Fatalf("unexpected number of targets dropped because of the limit; got %d; want 0", n)
+		}
+	})
+
+	t.Run("job over the limit is truncated and visible", func(t *testing.T) {
+		jobName := fmt.Sprintf("over-limit-%d", rand.Int())
+		started, active, overLimit := updateScraperGroupForJob(t, jobName, 5, 20)
+		if started != 5 {
+			t.Fatalf("unexpected number of started scrapers; got %d; want 5", started)
+		}
+		if active != 5 {
+			t.Fatalf("unexpected number of active targets; got %d; want 5", active)
+		}
+		if overLimit != 15 {
+			t.Fatalf("unexpected overLimitCount; got %d; want 15", overLimit)
+		}
+		if n := droppedForTargetsLimit(jobName); n != 15 {
+			t.Fatalf("unexpected number of targets dropped because of the limit; got %d; want 15", n)
+		}
+	})
+
+	t.Run("default is unlimited", func(t *testing.T) {
+		jobName := fmt.Sprintf("unlimited-%d", rand.Int())
+		started, active, overLimit := updateScraperGroupForJob(t, jobName, 0, 20)
+		if started != 20 {
+			t.Fatalf("unexpected number of started scrapers; got %d; want 20", started)
+		}
+		if active != 20 {
+			t.Fatalf("unexpected number of active targets; got %d; want 20", active)
+		}
+		if overLimit != 0 {
+			t.Fatalf("unexpected overLimitCount; got %d; want 0", overLimit)
+		}
+		if n := droppedForTargetsLimit(jobName); n != 0 {
+			t.Fatalf("unexpected number of targets dropped because of the limit; got %d; want 0", n)
+		}
+	})
+}
