diff --git a/lib/promscrape/scraper_test.go b/lib/promscrape/scraper_test.go
index 8a03fc4..c67a125 100644
--- a/lib/promscrape/scraper_test.go
+++ b/lib/promscrape/scraper_test.go
@@ -79,3 +79,111 @@ scrape_configs:
     - targets:
         - localhost:8429`, true)
 }
+
+func TestScraperGroupUpdateMaxScrapeTargetsPerJob(t *testing.T) {
+	pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+	globalStopChan = make(chan struct{})
+	defer close(globalStopChan)
+
+	scrapeConfigPath := "test-scrape.yaml"
+
+	newGroup := func(name string) *scraperGroup {
+		sg := newScraperGroup(name, pushData, globalStopChan)
+		return sg
+	}
+
+	// Job under the limit: every discovered target must be scraped.
+	t.Run("under_limit", func(t *testing.T) {
+		sg := newGroup(fmt.Sprintf("static_configs_%d", rand.Int()))
+		defer sg.stop()
+
+		var cfg Config
+		if err := cfg.parseData([]byte(`
+scrape_configs:
+- job_name: under-limit
+  max_scrape_targets_per_job: 5
+  static_configs:
+  - targets: ["h1:80", "h2:80", "h3:80"]
+`), scrapeConfigPath); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sg.update(cfg.getStaticScrapeWork())
+
+		if got := len(sg.m); got != 3 {
+			t.Fatalf("unexpected number of active scrapers; got %d; want 3", got)
+		}
+		if got := tsmGlobal.upByJob["under-limit"] + tsmGlobal.downByJob["under-limit"]; got != 3 {
+			t.Fatalf("unexpected number of registered targets; got %d; want 3", got)
+		}
+	})
+
+	// Job over the limit: only max_scrape_targets_per_job targets are scraped, the rest are truncated
+	// and must be visible via the dropped-targets status.
+	t.Run("over_limit", func(t *testing.T) {
+		sg := newGroup(fmt.Sprintf("static_configs_%d", rand.Int()))
+		defer sg.stop()
+
+		var cfg Config
+		if err := cfg.parseData([]byte(`
+scrape_configs:
+- job_name: over-limit
+  max_scrape_targets_per_job: 2
+  static_configs:
+  - targets: ["h1:80", "h2:80", "h3:80", "h4:80"]
+`), scrapeConfigPath); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sg.update(cfg.getStaticScrapeWork())
+
+		if got := len(sg.m); got != 2 {
+			t.Fatalf("unexpected number of active scrapers; got %d; want 2", got)
+		}
+		if got := tsmGlobal.upByJob["over-limit"] + tsmGlobal.downByJob["over-limit"]; got != 2 {
+			t.Fatalf("unexpected number of registered targets; got %d; want 2", got)
+		}
+
+		tsr := tsmGlobal.getTargetsStatusByJob(&requestFilter{})
+		var found bool
+		for _, jts := range tsr.jobTargetsStatuses {
+			if jts.jobName != "over-limit" {
+				continue
+			}
+			found = true
+			if jts.targetsTruncated != 2 {
+				t.Fatalf("unexpected targetsTruncated for over-limit job; got %d; want 2", jts.targetsTruncated)
+			}
+		}
+		if !found {
+			t.Fatalf("over-limit job is missing from the targets status")
+		}
+	})
+
+	// Default behavior: no max_scrape_targets_per_job configured means unlimited targets.
+	t.Run("default_unlimited", func(t *testing.T) {
+		sg := newGroup(fmt.Sprintf("static_configs_%d", rand.Int()))
+		defer sg.stop()
+
+		targets := make([]string, 20)
+		for i := range targets {
+			targets[i] = fmt.Sprintf("h%d:80", i)
+		}
+		targetsYAML := ""
+		for _, target := range targets {
+			targetsYAML += fmt.Sprintf("    - %q\n", target)
+		}
+		var cfg Config
+		if err := cfg.parseData([]byte(fmt.Sprintf(`
+scrape_configs:
+- job_name: unlimited
+  static_configs:
+  - targets:
+%s`, targetsYAML)), scrapeConfigPath); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sg.update(cfg.getStaticScrapeWork())
+
+		if got := len(sg.m); got != len(targets) {
+			t.Fatalf("unexpected number of active scrapers; got %d; want %d", got, len(targets))
+		}
+	})
