+func TestTargetStatusMapRegisterMaxScrapeTargetsPerJob(t *testing.T) {
+	newSW := func(job string, maxTargets int, addr string) *scrapeWork {
+		return &scrapeWork{
+			Config: &ScrapeWork{
+				jobNameOriginal:        job,
+				MaxScrapeTargetsPerJob: maxTargets,
+				OriginalLabels: newCompressedLabels(promutil.NewLabelsFromMap(map[string]string{
+					"__address__": addr,
+					"job":         job,
+				})),
+			},
+		}
+	}
+
+	// Default behavior: MaxScrapeTargetsPerJob=0 means unlimited - every target must be registered.
+	t.Run("default_unlimited", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		for i := 0; i < 50; i++ {
+			sw := newSW("unlimited", 0, fmt.Sprintf("host%d:80", i))
+			if !tsm.Register(sw) {
+				t.Fatalf("target %d must be registered when the job has no configured limit", i)
+			}
+		}
+		if n := tsm.upByJob["unlimited"] + tsm.downByJob["unlimited"]; n != 50 {
+			t.Fatalf("unexpected number of registered targets; got %d; want 50", n)
+		}
+	})
+
+	// Job under the limit: all discovered targets fit and none are rejected.
+	t.Run("under_limit", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		for i := 0; i < 3; i++ {
+			sw := newSW("under-limit", 5, fmt.Sprintf("host%d:80", i))
+			if !tsm.Register(sw) {
+				t.Fatalf("target %d must be registered since the job is under its limit", i)
+			}
+		}
+		if n := tsm.upByJob["under-limit"] + tsm.downByJob["under-limit"]; n != 3 {
+			t.Fatalf("unexpected number of registered targets; got %d; want 3", n)
+		}
+	})
+
+	// Job over the limit: only the first MaxScrapeTargetsPerJob targets are registered, the rest are rejected.
+	t.Run("over_limit", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		var registered, rejected int
+		for i := 0; i < 10; i++ {
+			sw := newSW("over-limit", 4, fmt.Sprintf("host%d:80", i))
+			if tsm.Register(sw) {
+				registered++
+			} else {
+				rejected++
+			}
+		}
+		if registered != 4 {
+			t.Fatalf("unexpected number of registered targets; got %d; want 4", registered)
+		}
+		if rejected != 6 {
+			t.Fatalf("unexpected number of rejected targets; got %d; want 6", rejected)
+		}
+		if n := tsm.upByJob["over-limit"] + tsm.downByJob["over-limit"]; n != 4 {
+			t.Fatalf("unexpected number of active targets; got %d; want 4", n)
+		}
+
+		// Freeing up a slot by unregistering a target must allow a new registration to succeed.
+		var freed *scrapeWork
+		tsm.mu.Lock()
+		for sw := range tsm.m {
+			freed = sw
+			break
+		}
+		tsm.mu.Unlock()
+		tsm.Unregister(freed)
+		sw := newSW("over-limit", 4, "hostRetry:80")
+		if !tsm.Register(sw) {
+			t.Fatalf("target must be registered once capacity is freed up")
+		}
+	})
+}
