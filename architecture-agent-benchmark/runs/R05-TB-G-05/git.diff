+func TestGetTargetsStatusByJobTargetsTruncated(t *testing.T) {
+	tsm := newTargetStatusMap()
+
+	origDropped := droppedTargetsMap
+	droppedTargetsMap = &droppedTargets{
+		m: make(map[uint64]droppedTarget),
+	}
+	defer func() {
+		droppedTargetsMap = origDropped
+	}()
+
+	// 2 active (registered) targets for job "over-limit".
+	for i := 0; i < 2; i++ {
+		tsm.Register(&scrapeWork{
+			Config: &ScrapeWork{
+				jobNameOriginal: "over-limit",
+				OriginalLabels: newCompressedLabels(promutil.NewLabelsFromMap(map[string]string{
+					"__address__": fmt.Sprintf("host%d:80", i),
+					"job":         "over-limit",
+				})),
+			},
+		})
+	}
+	// 3 targets dropped because of the per-job cap.
+	for i := 0; i < 3; i++ {
+		labels := promutil.NewLabelsFromMap(map[string]string{
+			"__address__": fmt.Sprintf("dropped%d:80", i),
+			"job":         "over-limit",
+		})
+		droppedTargetsMap.Register(newCompressedLabels(labels), nil, targetDropReasonTooManyTargets, nil)
+	}
+	// An unrelated drop for a different reason must not be counted as truncated.
+	droppedTargetsMap.Register(newCompressedLabels(promutil.NewLabelsFromMap(map[string]string{
+		"__address__": "dup:80",
+		"job":         "over-limit",
+	})), nil, targetDropReasonDuplicate, nil)
+
+	tsr := tsm.getTargetsStatusByJob(&requestFilter{})
+	if len(tsr.jobTargetsStatuses) != 1 {
+		t.Fatalf("unexpected number of jobs; got %d; want 1", len(tsr.jobTargetsStatuses))
+	}
+	jts := tsr.jobTargetsStatuses[0]
+	if jts.jobName != "over-limit" {
+		t.Fatalf("unexpected job name; got %q; want %q", jts.jobName, "over-limit")
+	}
+	if jts.targetsTotal != 2 {
+		t.Fatalf("unexpected targetsTotal; got %d; want 2", jts.targetsTotal)
+	}
+	if jts.targetsTruncated != 3 {
+		t.Fatalf("unexpected targetsTruncated; got %d; want 3", jts.targetsTruncated)
+	}
+}
