+func TestTargetStatusMapTryRegisterMaxScrapeTargets(t *testing.T) {
+	newSW := func(jobName string, maxScrapeTargets int, addr string) *scrapeWork {
+		return &scrapeWork{
+			Config: &ScrapeWork{
+				jobNameOriginal:  jobName,
+				MaxScrapeTargets: maxScrapeTargets,
+				OriginalLabels: newCompressedLabels(promutil.NewLabelsFromMap(map[string]string{
+					"__address__": addr,
+				})),
+			},
+		}
+	}
+
+	// The default (unlimited) behavior: MaxScrapeTargets=0 must accept any number of targets.
+	t.Run("unlimited", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		for i := 0; i < 10; i++ {
+			sw := newSW("unlimited-job", 0, fmt.Sprintf("host%d:80", i))
+			if !tsm.TryRegister(sw) {
+				t.Fatalf("target %d must be accepted when MaxScrapeTargets is unlimited", i)
+			}
+		}
+	})
+
+	// A job under its limit must be unaffected - every target gets accepted.
+	t.Run("under_limit", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		const limit = 5
+		for i := 0; i < 3; i++ {
+			sw := newSW("under-limit-job", limit, fmt.Sprintf("host%d:80", i))
+			if !tsm.TryRegister(sw) {
+				t.Fatalf("target %d must be accepted since job is under the limit of %d", i, limit)
+			}
+		}
+	})
+
+	// A job over its limit must be truncated - only the first `limit` targets are accepted,
+	// and the excess must be rejected.
+	t.Run("over_limit", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		const limit = 3
+		var accepted, rejected int
+		for i := 0; i < 10; i++ {
+			sw := newSW("over-limit-job", limit, fmt.Sprintf("host%d:80", i))
+			if tsm.TryRegister(sw) {
+				accepted++
+			} else {
+				rejected++
+			}
+		}
+		if accepted != limit {
+			t.Fatalf("unexpected number of accepted targets; got %d; want %d", accepted, limit)
+		}
+		if rejected != 10-limit {
+			t.Fatalf("unexpected number of rejected targets; got %d; want %d", rejected, 10-limit)
+		}
+	})
+
+	// Different jobs must have independent limits.
+	t.Run("independent_jobs", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		for i := 0; i < 2; i++ {
+			if !tsm.TryRegister(newSW("job-a", 2, fmt.Sprintf("a%d:80", i))) {
+				t.Fatalf("job-a target %d must be accepted", i)
+			}
+		}
+		if tsm.TryRegister(newSW("job-a", 2, "a-extra:80")) {
+			t.Fatalf("job-a is at its limit; the extra target must be rejected")
+		}
+		if !tsm.TryRegister(newSW("job-b", 2, "b0:80")) {
+			t.Fatalf("job-b must not be affected by job-a reaching its limit")
+		}
+	})
+}
