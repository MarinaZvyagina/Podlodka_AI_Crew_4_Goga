+
+// TestScraperGroupUpdateMaxScrapeTargets verifies that sg.update() enforces the per-job
+// max_scrape_targets cap uniformly for all the targets of a job, regardless of the fact
+// that in production every service discovery mechanism feeds its own independent
+// scraperGroup.update() call - the cap is enforced through the shared tsmGlobal state.
+func TestScraperGroupUpdateMaxScrapeTargets(t *testing.T) {
+	// Isolate droppedTargetsMap for this test, so assertions don't depend on state left behind by other tests.
+	prevDroppedTargetsMap := droppedTargetsMap
+	droppedTargetsMap = &droppedTargets{m: make(map[uint64]droppedTarget)}
+	defer func() { droppedTargetsMap = prevDroppedTargetsMap }()
+
+	f := func(jobName string, targetsCount, maxScrapeTargets, wantAccepted, wantDropped int) {
+		t.Helper()
+		pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+		globalStopChan = make(chan struct{})
+		defer close(globalStopChan)
+
+		sg := newScraperGroup(fmt.Sprintf("static_configs_%s", jobName), pushData, globalStopChan)
+		defer sg.stop()
+
+		var targets []string
+		for i := 0; i < targetsCount; i++ {
+			targets = append(targets, fmt.Sprintf("host-%s-%d:8429", jobName, i))
+		}
+		cfgData := fmt.Sprintf(`
+scrape_configs:
+- job_name: %s
+  max_scrape_targets: %d
+  static_configs:
+    - targets: %s`, jobName, maxScrapeTargets, "["+strings.Join(targets, ", ")+"]")
+
+		var cfg Config
+		if err := cfg.parseData([]byte(cfgData), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sws := cfg.getStaticScrapeWork()
+		if len(sws) != targetsCount {
+			t.Fatalf("unexpected number of discovered targets; got %d; want %d", len(sws), targetsCount)
+		}
+
+		droppedBefore := droppedTargetsMap.getTotalTargets()
+		sg.update(sws)
+
+		if len(sg.m) != wantAccepted {
+			t.Fatalf("unexpected number of active scrapers for job=%s; got %d; want %d", jobName, len(sg.m), wantAccepted)
+		}
+		gotDropped := droppedTargetsMap.getTotalTargets() - droppedBefore
+		if gotDropped != wantDropped {
+			t.Fatalf("unexpected number of newly dropped targets for job=%s; got %d; want %d", jobName, gotDropped, wantDropped)
+		}
+	}
+
+	// A job under the limit must be unaffected: all of its targets are accepted and none are dropped.
+	f("under-limit", 3, 10, 3, 0)
+
+	// A job over the limit must be truncated: only max_scrape_targets are accepted, the rest show up as dropped.
+	f("over-limit", 10, 4, 4, 6)
+
+	// The default (max_scrape_targets unset, i.e. 0) means unlimited: every discovered target is accepted.
+	f("unlimited", 7, 0, 7, 0)
+}
