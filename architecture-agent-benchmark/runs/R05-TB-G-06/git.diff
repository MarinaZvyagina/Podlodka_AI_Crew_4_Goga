 func (tsm *targetStatusMap) Register(sw *scrapeWork) {
+	tsm.mu.Lock()
+	tsm.registerLocked(sw)
+	tsm.mu.Unlock()
+}
+
+// TryRegister registers sw as an active target unless the job it belongs to
+// (sw.Config.jobNameOriginal) has already reached its sw.Config.MaxScrapeTargets limit.
+//
+// It returns false if sw was rejected because of the limit; in this case the caller
+// must not proceed with scraping sw.
+func (tsm *targetStatusMap) TryRegister(sw *scrapeWork) bool {
 	jobName := sw.Config.jobNameOriginal
+	maxScrapeTargets := sw.Config.MaxScrapeTargets
 
 	tsm.mu.Lock()
+	defer tsm.mu.Unlock()
+	if maxScrapeTargets > 0 && tsm.upByJob[jobName]+tsm.downByJob[jobName] >= maxScrapeTargets {
+		return false
+	}
+	tsm.registerLocked(sw)
+	return true
+}
+
+// registerLocked registers sw as an active target.
+//
+// tsm.mu must be locked when calling this function.
+func (tsm *targetStatusMap) registerLocked(sw *scrapeWork) {
+	jobName := sw.Config.jobNameOriginal
 	tsm.m[sw] = &targetStatus{
 		sw: sw,
 	}
 	tsm.downByJob[jobName]++
-	tsm.mu.Unlock()
 }
 
