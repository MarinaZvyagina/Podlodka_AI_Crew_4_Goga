diff --git a/lib/promscrape/scraper_test.go b/lib/promscrape/scraper_test.go
index 8a03fc4..e463a0c 100644
--- a/lib/promscrape/scraper_test.go
+++ b/lib/promscrape/scraper_test.go
@@ -79,3 +79,121 @@ scrape_configs:
     - targets:
         - localhost:8429`, true)
 }
+
+func TestScraperGroupUpdateMaxScrapeTargetsPerJob(t *testing.T) {
+	newSG := func(jobName string) (*scraperGroup, string) {
+		pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+		globalStopChan = make(chan struct{})
+		randName := rand.Int()
+		sg := newScraperGroup(fmt.Sprintf("static_configs_%d", randName), pushData, globalStopChan)
+		return sg, jobName
+	}
+	staticTargetsConfig := func(jobName string, maxScrapeTargets, targetsCount int) string {
+		cfg := fmt.Sprintf("scrape_configs:\n- job_name: %s\n", jobName)
+		if maxScrapeTargets > 0 {
+			cfg += fmt.Sprintf("  max_scrape_targets: %d\n", maxScrapeTargets)
+		}
+		cfg += "  static_configs:\n  - targets:\n"
+		for i := 0; i < targetsCount; i++ {
+			cfg += fmt.Sprintf("    - host-%02d:8429\n", i)
+		}
+		return cfg
+	}
+
+	// A job under the configured limit must be scraped in full and reported as having no excluded targets.
+	t.Run("UnderLimit", func(t *testing.T) {
+		sg, jobName := newSG(fmt.Sprintf("under-limit-%d", rand.Int()))
+		defer func() {
+			sg.stop()
+			close(globalStopChan)
+		}()
+
+		var cfg Config
+		if err := cfg.parseData([]byte(staticTargetsConfig(jobName, 5, 3)), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sg.update(cfg.getStaticScrapeWork())
+
+		if n := len(sg.m); n != 3 {
+			t.Fatalf("unexpected number of active scrapers; got %d; want 3", n)
+		}
+		if n := tsmGlobal.countForJob(jobName); n != 3 {
+			t.Fatalf("unexpected number of registered targets for job; got %d; want 3", n)
+		}
+		if n := tsmGlobal.excludedTargetsForJob(jobName); n != 0 {
+			t.Fatalf("unexpected number of excluded targets for job; got %d; want 0", n)
+		}
+	})
+
+	// A job over the configured limit must be truncated to the limit, with the excess visible
+	// both as dropped targets and via the excluded-targets counter.
+	t.Run("OverLimit", func(t *testing.T) {
+		sg, jobName := newSG(fmt.Sprintf("over-limit-%d", rand.Int()))
+		defer func() {
+			sg.stop()
+			close(globalStopChan)
+		}()
+
+		var cfg Config
+		if err := cfg.parseData([]byte(staticTargetsConfig(jobName, 2, 5)), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sg.update(cfg.getStaticScrapeWork())
+
+		if n := len(sg.m); n != 2 {
+			t.Fatalf("unexpected number of active scrapers; got %d; want 2", n)
+		}
+		if n := tsmGlobal.countForJob(jobName); n != 2 {
+			t.Fatalf("unexpected number of registered targets for job; got %d; want 2", n)
+		}
+		if n := tsmGlobal.excludedTargetsForJob(jobName); n != 3 {
+			t.Fatalf("unexpected number of excluded targets for job; got %d; want 3", n)
+		}
+
+		// The excess targets must be visible as dropped targets with the "too many targets" reason.
+		var gotDropped int
+		for _, dt := range droppedTargetsMap.getTargetsList() {
+			if dt.originalLabels.getJob() == jobName {
+				gotDropped++
+				if dt.dropReason != targetDropReasonTooManyTargets {
+					t.Fatalf("unexpected drop reason; got %q; want %q", dt.dropReason, targetDropReasonTooManyTargets)
+				}
+			}
+		}
+		if gotDropped != 3 {
+			t.Fatalf("unexpected number of dropped targets in droppedTargetsMap; got %d; want 3", gotDropped)
+		}
+
+		// Re-running discovery with the same set of targets must keep selecting the same subset
+		// deterministically instead of flapping between refreshes.
+		sg.update(cfg.getStaticScrapeWork())
+		if n := len(sg.m); n != 2 {
+			t.Fatalf("unexpected number of active scrapers after re-update; got %d; want 2", n)
+		}
+		if n := tsmGlobal.excludedTargetsForJob(jobName); n != 3 {
+			t.Fatalf("unexpected number of excluded targets after re-update; got %d; want 3", n)
+		}
+	})
+
+	// By default the limit is disabled (unlimited), so all the discovered targets must be scraped.
+	t.Run("DefaultUnlimited", func(t *testing.T) {
+		sg, jobName := newSG(fmt.Sprintf("unlimited-%d", rand.Int()))
+		defer func() {
+			sg.stop()
+			close(globalStopChan)
+		}()
+
+		var cfg Config
+		if err := cfg.parseData([]byte(staticTargetsConfig(jobName, 0, 50)), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sg.update(cfg.getStaticScrapeWork())
+
+		if n := len(sg.m); n != 50 {
+			t.Fatalf("unexpected number of active scrapers; got %d; want 50", n)
+		}
+		if n := tsmGlobal.excludedTargetsForJob(jobName); n != 0 {
+			t.Fatalf("unexpected number of excluded targets for job; got %d; want 0", n)
+		}
+	})
+}
