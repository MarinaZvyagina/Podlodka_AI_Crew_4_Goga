diff --git a/lib/promscrape/discovery/scaleway/api.go b/lib/promscrape/discovery/scaleway/api.go
new file mode 100644
index 0000000..ffd5dc1
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api.go
@@ -0,0 +1,140 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/url"
+	"strings"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+var configMap = discoveryutil.NewConfigMap()
+
+// serversPerPage is the maximum number of servers requested per API page.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+const serversPerPage = 100
+
+type apiConfig struct {
+	client *discoveryutil.Client
+	port   int
+	zone   string
+
+	secretKey string
+
+	// listQueryParams contains url-encoded optional project/organization filters.
+	listQueryParams string
+}
+
+func newAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	if sdc.SecretKey == nil {
+		return nil, fmt.Errorf("missing `secret_key` option")
+	}
+
+	apiServer := sdc.APIURL
+	if apiServer == "" {
+		apiServer = "https://api.scaleway.com"
+	}
+	if !strings.Contains(apiServer, "://") {
+		scheme := "http"
+		if sdc.HTTPClientConfig.TLSConfig != nil {
+			scheme = "https"
+		}
+		apiServer = scheme + "://" + apiServer
+	}
+
+	zone := sdc.Zone
+	if zone == "" {
+		zone = "fr-par-1"
+	}
+
+	ac, err := sdc.HTTPClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse auth config: %w", err)
+	}
+	proxyAC, err := sdc.ProxyClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse proxy auth config: %w", err)
+	}
+	client, err := discoveryutil.NewClient(apiServer, ac, sdc.ProxyURL, proxyAC, &sdc.HTTPClientConfig)
+	if err != nil {
+		return nil, fmt.Errorf("cannot create HTTP client for %q: %w", apiServer, err)
+	}
+
+	qp := url.Values{}
+	if sdc.ProjectID != "" {
+		qp.Set("project", sdc.ProjectID)
+	}
+	if sdc.OrganizationID != "" {
+		qp.Set("organization", sdc.OrganizationID)
+	}
+
+	port := sdc.Port
+	if port == 0 {
+		port = 80
+	}
+
+	cfg := &apiConfig{
+		client:          client,
+		port:            port,
+		zone:            zone,
+		secretKey:       sdc.SecretKey.String(),
+		listQueryParams: qp.Encode(),
+	}
+	return cfg, nil
+}
+
+func getAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	v, err := configMap.Get(sdc, func() (any, error) { return newAPIConfig(sdc, baseDir) })
+	if err != nil {
+		return nil, err
+	}
+	return v.(*apiConfig), nil
+}
+
+// getInstances retrieves all the instances for the given cfg by paginating over the Scaleway Instances API.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+func getInstances(cfg *apiConfig) ([]instance, error) {
+	modifyRequest := func(req *http.Request) {
+		req.Header.Set("X-Auth-Token", cfg.secretKey)
+	}
+	getAPIResponse := func(path string) ([]byte, error) {
+		return cfg.client.GetAPIResponseWithReqParams(path, modifyRequest)
+	}
+	return fetchInstances(getAPIResponse, cfg.zone, cfg.listQueryParams)
+}
+
+// fetchInstances paginates over the Scaleway Instances API via getAPIResponse and returns all the discovered instances.
+func fetchInstances(getAPIResponse func(path string) ([]byte, error), zone, listQueryParams string) ([]instance, error) {
+	var instances []instance
+
+	page := 1
+	for {
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?%s&page=%d&per_page=%d", zone, listQueryParams, page, serversPerPage)
+		data, err := getAPIResponse(path)
+		if err != nil {
+			return nil, fmt.Errorf("cannot query Scaleway API for %q: %w", path, err)
+		}
+		resp, err := parseAPIResponse(data)
+		if err != nil {
+			return nil, err
+		}
+		instances = append(instances, resp.Servers...)
+		if len(resp.Servers) < serversPerPage || len(instances) >= resp.TotalCount {
+			break
+		}
+		page++
+	}
+	return instances, nil
+}
+
+func parseAPIResponse(data []byte) (*listServersResponse, error) {
+	var resp listServersResponse
+	if err := json.Unmarshal(data, &resp); err != nil {
+		return nil, fmt.Errorf("cannot parse Scaleway API response: %q; err: %w", data, err)
+	}
+	return &resp, nil
+}
diff --git a/lib/promscrape/discovery/scaleway/api_test.go b/lib/promscrape/discovery/scaleway/api_test.go
new file mode 100644
index 0000000..25de4a8
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api_test.go
@@ -0,0 +1,118 @@
+package scaleway
+
+import (
+	"fmt"
+	"reflect"
+	"testing"
+)
+
+func TestParseAPIResponse(t *testing.T) {
+	f := func(data string, responseExpected *listServersResponse) {
+		t.Helper()
+
+		response, err := parseAPIResponse([]byte(data))
+		if err != nil {
+			t.Fatalf("unexpected parseAPIResponse() error: %s", err)
+		}
+		if !reflect.DeepEqual(response, responseExpected) {
+			t.Fatalf("unexpected response\ngot\n%v\nwant\n%v", response, responseExpected)
+		}
+	}
+
+	data := `
+{
+  "servers": [
+    {
+      "id": "11111111-1111-1111-1111-111111111111",
+      "name": "foobar",
+      "arch": "x86_64",
+      "commercial_type": "DEV1-S",
+      "state": "running",
+      "hostname": "foobar",
+      "organization": "org-1",
+      "project": "project-1",
+      "private_ip": "10.10.10.10",
+      "public_ip": {
+        "id": "22222222-2222-2222-2222-222222222222",
+        "address": "100.100.100.100"
+      },
+      "tags": ["web", "prod"],
+      "zone": "fr-par-1"
+    }
+  ],
+  "total_count": 1
+}`
+
+	responseExpected := &listServersResponse{
+		Servers: []instance{
+			{
+				ID:             "11111111-1111-1111-1111-111111111111",
+				Name:           "foobar",
+				Arch:           "x86_64",
+				CommercialType: "DEV1-S",
+				State:          "running",
+				Hostname:       "foobar",
+				Organization:   "org-1",
+				Project:        "project-1",
+				PrivateIP:      "10.10.10.10",
+				PublicIP: &publicIP{
+					Address: "100.100.100.100",
+				},
+				Tags: []string{"web", "prod"},
+				Zone: "fr-par-1",
+			},
+		},
+		TotalCount: 1,
+	}
+	f(data, responseExpected)
+}
+
+func TestFetchInstances(t *testing.T) {
+	f := func(getAPIResponse func(string) ([]byte, error), expectedInstanceCount int) {
+		t.Helper()
+
+		instances, err := fetchInstances(getAPIResponse, "fr-par-1", "")
+		if err != nil {
+			t.Fatalf("fetchInstances() error: %s", err)
+		}
+		if len(instances) != expectedInstanceCount {
+			t.Fatalf("unexpected instances count; got %d; want %d\ninstances:\n%v", len(instances), expectedInstanceCount, instances)
+		}
+	}
+
+	// single, non-full page: pagination must stop after the first request.
+	getAPIResponse := func(_ string) ([]byte, error) {
+		return []byte(`{"servers": [
+			{"id": "1", "name": "srv-1", "state": "running", "private_ip": "10.0.0.1"},
+			{"id": "2", "name": "srv-2", "state": "running", "private_ip": "10.0.0.2"}
+		], "total_count": 2}`), nil
+	}
+	f(getAPIResponse, 2)
+
+	// two full pages followed by a partial page.
+	getAPIResponse = func(path string) ([]byte, error) {
+		switch {
+		case containsPage(path, 1), containsPage(path, 2):
+			return []byte(makeServersPageJSON(serversPerPage, 2*serversPerPage+3)), nil
+		default:
+			return []byte(makeServersPageJSON(3, 2*serversPerPage+3)), nil
+		}
+	}
+	f(getAPIResponse, 2*serversPerPage+3)
+}
+
+func containsPage(path string, page int) bool {
+	return path == fmt.Sprintf("/instance/v1/zones/fr-par-1/servers?&page=%d&per_page=%d", page, serversPerPage)
+}
+
+func makeServersPageJSON(serverCount, totalCount int) string {
+	data := `{"servers": [`
+	for i := 0; i < serverCount; i++ {
+		if i > 0 {
+			data += ","
+		}
+		data += `{"id": "srv", "name": "srv", "state": "running", "private_ip": "10.0.0.1"}`
+	}
+	data += fmt.Sprintf(`], "total_count": %d}`, totalCount)
+	return data
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway.go b/lib/promscrape/discovery/scaleway/scaleway.go
new file mode 100644
index 0000000..4dce721
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway.go
@@ -0,0 +1,138 @@
+package scaleway
+
+import (
+	"flag"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/proxy"
+)
+
+// SDCheckInterval defines interval for targets refresh.
+var SDCheckInterval = flag.Duration("promscrape.scalewaySDCheckInterval", 30*time.Second, "Interval for checking for changes in Scaleway Instances. "+
+	"This works only if scaleway_sd_configs is configured in '-promscrape.config' file. "+
+	"See https://docs.victoriametrics.com/victoriametrics/sd_configs/#scaleway_sd_configs for details")
+
+// SDConfig represents service discovery config for Scaleway Instances.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type SDConfig struct {
+	// APIURL is an optional Scaleway API server to query. By default, https://api.scaleway.com is used.
+	APIURL string `yaml:"api_url,omitempty"`
+
+	// Zone is the Scaleway zone to discover instances in, e.g. fr-par-1. By default, fr-par-1 is used.
+	Zone string `yaml:"zone,omitempty"`
+
+	// ProjectID restricts discovery to instances belonging to the given Scaleway project.
+	ProjectID string `yaml:"project_id,omitempty"`
+
+	// OrganizationID restricts discovery to instances belonging to the given Scaleway organization.
+	OrganizationID string `yaml:"organization_id,omitempty"`
+
+	// SecretKey is the Scaleway API secret key used for authenticating requests via the X-Auth-Token header.
+	//
+	// See https://www.scaleway.com/en/docs/identity-and-access-management/iam/how-to/create-api-keys/
+	SecretKey *promauth.Secret `yaml:"secret_key,omitempty"`
+
+	// Port is an optional port to scrape metrics from. By default, port 80 is used.
+	Port int `yaml:"port,omitempty"`
+
+	HTTPClientConfig  promauth.HTTPClientConfig  `yaml:",inline"`
+	ProxyURL          *proxy.URL                 `yaml:"proxy_url,omitempty"`
+	ProxyClientConfig promauth.ProxyClientConfig `yaml:",inline"`
+}
+
+// GetLabels returns Scaleway instance labels according to sdc.
+func (sdc *SDConfig) GetLabels(baseDir string) ([]*promutil.Labels, error) {
+	cfg, err := getAPIConfig(sdc, baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot get API config: %w", err)
+	}
+	instances, err := getInstances(cfg)
+	if err != nil {
+		return nil, err
+	}
+	return addInstanceLabels(instances, cfg.port), nil
+}
+
+// MustStop stops further usage for sdc.
+func (sdc *SDConfig) MustStop() {
+	v := configMap.Delete(sdc)
+	if v != nil {
+		cfg := v.(*apiConfig)
+		cfg.client.Stop()
+	}
+}
+
+// instance represents a Scaleway Instance server object.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type instance struct {
+	ID             string    `json:"id"`
+	Name           string    `json:"name"`
+	Arch           string    `json:"arch"`
+	CommercialType string    `json:"commercial_type"`
+	State          string    `json:"state"`
+	Hostname       string    `json:"hostname"`
+	Organization   string    `json:"organization"`
+	Project        string    `json:"project"`
+	PrivateIP      string    `json:"private_ip"`
+	PublicIP       *publicIP `json:"public_ip"`
+	Tags           []string  `json:"tags"`
+	Zone           string    `json:"zone"`
+}
+
+type publicIP struct {
+	Address string `json:"address"`
+}
+
+// listServersResponse is the response for
+// https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type listServersResponse struct {
+	Servers    []instance `json:"servers"`
+	TotalCount int        `json:"total_count"`
+}
+
+// addInstanceLabels builds target labels from Scaleway Instances API data.
+func addInstanceLabels(instances []instance, port int) []*promutil.Labels {
+	ms := make([]*promutil.Labels, 0, len(instances))
+	for _, inst := range instances {
+		var publicIPv4 string
+		if inst.PublicIP != nil {
+			publicIPv4 = inst.PublicIP.Address
+		}
+
+		// Prefer public IPv4 for __address__, falling back to the private IPv4
+		// when the instance has no public IP so targets aren't emitted with an empty host.
+		addrHost := publicIPv4
+		if addrHost == "" {
+			addrHost = inst.PrivateIP
+		}
+		if addrHost == "" {
+			continue
+		}
+
+		m := promutil.NewLabels(12)
+		m.Add("__address__", discoveryutil.JoinHostPort(addrHost, port))
+		m.Add("__meta_scaleway_instance_id", inst.ID)
+		m.Add("__meta_scaleway_instance_name", inst.Name)
+		m.Add("__meta_scaleway_instance_zone", inst.Zone)
+		m.Add("__meta_scaleway_instance_status", inst.State)
+		m.Add("__meta_scaleway_instance_type", inst.CommercialType)
+		m.Add("__meta_scaleway_instance_arch", inst.Arch)
+		m.Add("__meta_scaleway_instance_hostname", inst.Hostname)
+		m.Add("__meta_scaleway_instance_public_ipv4", publicIPv4)
+		m.Add("__meta_scaleway_instance_private_ipv4", inst.PrivateIP)
+		m.Add("__meta_scaleway_instance_project_id", inst.Project)
+		m.Add("__meta_scaleway_instance_organization_id", inst.Organization)
+		if len(inst.Tags) > 0 {
+			m.Add("__meta_scaleway_instance_tags", ","+strings.Join(inst.Tags, ",")+",")
+		}
+		ms = append(ms, m)
+	}
+	return ms
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway_test.go b/lib/promscrape/discovery/scaleway/scaleway_test.go
new file mode 100644
index 0000000..6e45fac
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway_test.go
@@ -0,0 +1,92 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func TestAddInstanceLabels(t *testing.T) {
+	f := func(instances []instance, labelssExpected []*promutil.Labels) {
+		t.Helper()
+
+		labelss := addInstanceLabels(instances, 9100)
+		discoveryutil.TestEqualLabelss(t, labelss, labelssExpected)
+	}
+
+	instances := []instance{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "foobar",
+			Arch:           "x86_64",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Hostname:       "foobar",
+			Organization:   "org-1",
+			Project:        "project-1",
+			PrivateIP:      "10.10.10.10",
+			PublicIP: &publicIP{
+				Address: "100.100.100.100",
+			},
+			Tags: []string{"web", "prod"},
+			Zone: "fr-par-1",
+		},
+	}
+	labelssExpected := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "100.100.100.100:9100",
+			"__meta_scaleway_instance_id":              "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":            "foobar",
+			"__meta_scaleway_instance_zone":            "fr-par-1",
+			"__meta_scaleway_instance_status":          "running",
+			"__meta_scaleway_instance_type":            "DEV1-S",
+			"__meta_scaleway_instance_arch":            "x86_64",
+			"__meta_scaleway_instance_hostname":        "foobar",
+			"__meta_scaleway_instance_public_ipv4":     "100.100.100.100",
+			"__meta_scaleway_instance_private_ipv4":    "10.10.10.10",
+			"__meta_scaleway_instance_project_id":      "project-1",
+			"__meta_scaleway_instance_organization_id": "org-1",
+			"__meta_scaleway_instance_tags":            ",web,prod,",
+		}),
+	}
+	f(instances, labelssExpected)
+
+	// instance without a public IP falls back to the private IP for __address__
+	instancesNoPublicIP := []instance{
+		{
+			ID:             "22222222-2222-2222-2222-222222222222",
+			Name:           "internal-only",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			PrivateIP:      "10.10.10.20",
+			Zone:           "nl-ams-1",
+		},
+	}
+	labelssExpectedNoPublicIP := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "10.10.10.20:9100",
+			"__meta_scaleway_instance_id":              "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_name":            "internal-only",
+			"__meta_scaleway_instance_zone":            "nl-ams-1",
+			"__meta_scaleway_instance_status":          "running",
+			"__meta_scaleway_instance_type":            "DEV1-S",
+			"__meta_scaleway_instance_arch":            "",
+			"__meta_scaleway_instance_hostname":        "",
+			"__meta_scaleway_instance_public_ipv4":     "",
+			"__meta_scaleway_instance_private_ipv4":    "10.10.10.20",
+			"__meta_scaleway_instance_project_id":      "",
+			"__meta_scaleway_instance_organization_id": "",
+		}),
+	}
+	f(instancesNoPublicIP, labelssExpectedNoPublicIP)
+
+	// instance without any IP address is skipped
+	instancesNoIP := []instance{
+		{
+			ID:   "33333333-3333-3333-3333-333333333333",
+			Name: "no-ip",
+		},
+	}
+	f(instancesNoIP, nil)
+}
