+				"project": "fake-project-id",
+				"tags": ["mock", "tags"],
+				"commercial_type": "DEV1-S",
+				"state": "running",
+				"hostname": "scaleway-sd",
+				"zone": "fr-par-1",
+				"arch": "x86_64",
+				"private_ip": "10.0.0.1",
+				"public_ip": {
+					"id": "fake-ip-id",
+					"address": "51.15.0.1",
+					"dynamic": false
+				}
+			}],
+			"total_count": 1
+		}`
+		return []byte(resp)
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:         client,
+		secretKey: "fake-secret-key",
+	}
+
+	instances, err := getInstances(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+
+	if gotAuthToken != "fake-secret-key" {
+		t.Fatalf("unexpected X-Auth-Token header; got %q; want %q", gotAuthToken, "fake-secret-key")
+	}
+
+	expectedInstances := []Instance{
+		{
+			ID:             "fake-id-07f7-4b68-88ac-fake-id",
+			Name:           "scaleway-sd",
+			Organization:   "fake-org-id",
+			Project:        "fake-project-id",
+			Tags:           []string{"mock", "tags"},
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Hostname:       "scaleway-sd",
+			Zone:           "fr-par-1",
+			Arch:           "x86_64",
+			PrivateIP:      "10.0.0.1",
+			PublicIP: &ServerIP{
+				ID:      "fake-ip-id",
+				Address: "51.15.0.1",
+				Dynamic: false,
+			},
+		},
+	}
+	if !reflect.DeepEqual(instances, expectedInstances) {
+		t.Fatalf("unexpected result\ngot\n%#v\nwant\n%#v", instances, expectedInstances)
+	}
+}
+
+func TestGetInstances_Failure(t *testing.T) {
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		return []byte("some error")
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c: client,
+	}
+
+	if _, err := getInstances(cfg); err == nil {
+		t.Fatalf("expecting non-nil error from getInstances()")
+	}
+}
+
+func TestGetInstances_Paging(t *testing.T) {
+	requestCount := 0
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		if requestCount == 0 {
+			requestCount++
+			return []byte(mockListServersSuccessPage0Resp)
+		}
+		return []byte(mockListServersSuccessPage1Resp)
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c: client,
+	}
+
+	instances, err := getInstances(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+	if !reflect.DeepEqual(expectSuccessPagingInstances, instances) {
+		t.Fatalf("unexpected getInstances() result\ngot\n%#v\nwant\n%#v", instances, expectSuccessPagingInstances)
+	}
+}
+
+// ------------ Test dataset ------------
+var (
+	// mockListServersSuccessPage0Resp contains a full page of `perPage` servers,
+	// which triggers a follow-up request for the next page.
+	mockListServersSuccessPage0Resp = genServersPageResp(0, perPage, 2*perPage)
+	// mockListServersSuccessPage1Resp contains the remaining server on the 2nd page.
+	mockListServersSuccessPage1Resp = genServersPageResp(perPage, 1, 2*perPage)
+
+	expectSuccessPagingInstances = append(genExpectedInstances(0, perPage), genExpectedInstances(perPage, 1)...)
+)
+
+// genServersPageResp generates a ListServersResponse JSON payload containing `count` servers,
+// numbered starting from `startIdx`, with the given `totalCount`.
+func genServersPageResp(startIdx, count, totalCount int) string {
+	var sb strings.Builder
+	sb.WriteString(`{"servers": [`)
+	for i := 0; i < count; i++ {
+		if i > 0 {
+			sb.WriteString(",")
+		}
+		fmt.Fprintf(&sb, `{
+			"id": "fake-id-%d",
+			"name": "scaleway-sd-%d",
+			"organization": "fake-org-id",
+			"project": "fake-project-id",
+			"tags": [],
+			"commercial_type": "DEV1-S",
+			"state": "running",
+			"hostname": "scaleway-sd-%d",
+			"zone": "fr-par-1",
+			"arch": "x86_64",
+			"private_ip": "10.0.0.1",
+			"public_ip": {
+				"id": "fake-ip-id-%d",
+				"address": "51.15.0.1",
+				"dynamic": false
+			}
+		}`, startIdx+i, startIdx+i, startIdx+i, startIdx+i)
+	}
+	fmt.Fprintf(&sb, `], "total_count": %d}`, totalCount)
+	return sb.String()
+}
+
+// genExpectedInstances generates the []Instance slice matching genServersPageResp's output.
+func genExpectedInstances(startIdx, count int) []Instance {
+	instances := make([]Instance, 0, count)
+	for i := 0; i < count; i++ {
+		idx := startIdx + i
+		instances = append(instances, Instance{
+			ID:             fmt.Sprintf("fake-id-%d", idx),
+			Name:           fmt.Sprintf("scaleway-sd-%d", idx),
+			Organization:   "fake-org-id",
+			Project:        "fake-project-id",
+			Tags:           []string{},
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Hostname:       fmt.Sprintf("scaleway-sd-%d", idx),
+			Zone:           "fr-par-1",
+			Arch:           "x86_64",
+			PrivateIP:      "10.0.0.1",
+			PublicIP: &ServerIP{
+				ID:      fmt.Sprintf("fake-ip-id-%d", idx),
+				Address: "51.15.0.1",
+				Dynamic: false,
+			},
+		})
+	}
+	return instances
+}
