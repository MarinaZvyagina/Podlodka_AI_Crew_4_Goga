+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	f := func(sdc *SDConfig) {
+		t.Helper()
+		baseDir := "."
+		_, err := newAPIConfig(sdc, baseDir)
+		if err == nil {
+			t.Fatalf("expecting non-nil error")
+		}
+	}
+
+	// missing project
+	f(&SDConfig{
+		SecretKey: &promauth.Secret{S: "foobar"},
+	})
+
+	// missing secret_key
+	f(&SDConfig{
+		Project: "fake-project-id",
+	})
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		Project:   "fake-project-id",
+		SecretKey: &promauth.Secret{S: "foobar"},
+	}
+	baseDir := "."
+	ac, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	if ac.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want 80", ac.port)
+	}
+}
+
+func TestNewAPIConfig_DefaultZone(t *testing.T) {
+	sdc := &SDConfig{
+		Project:   "fake-project-id",
+		SecretKey: &promauth.Secret{S: "foobar"},
+	}
+	baseDir := "."
+	ac, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	if ac.c.APIServer() != "https://api.scaleway.com/instance/v1/zones/"+defaultZone {
+		t.Fatalf("unexpected api server; got %q", ac.c.APIServer())
+	}
+}
diff --git a/lib/promscrape/discovery/scaleway/instance.go b/lib/promscrape/discovery/scaleway/instance.go
new file mode 100644
index 0000000..8fecd34
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/instance.go
@@ -0,0 +1,76 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+)
+
+// perPage is the maximum number of Instances Scaleway returns per page.
+const perPage = 100
+
+// ListServersResponse is the response structure of the Scaleway Instance list servers API.
+//
+// See: https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type ListServersResponse struct {
+	Servers    []Instance `json:"servers"`
+	TotalCount int        `json:"total_count"`
+}
+
+// Instance represents a Scaleway Instance (server).
+//
+// See: https://github.com/scaleway/scaleway-sdk-go/blob/master/api/instance/v1/instance_sdk.go
+type Instance struct {
+	ID             string    `json:"id"`
+	Name           string    `json:"name"`
+	Organization   string    `json:"organization"`
+	Project        string    `json:"project"`
+	Tags           []string  `json:"tags"`
+	CommercialType string    `json:"commercial_type"`
+	State          string    `json:"state"`
+	Hostname       string    `json:"hostname"`
+	Zone           string    `json:"zone"`
+	Arch           string    `json:"arch"`
+	PrivateIP      string    `json:"private_ip"`
+	PublicIP       *ServerIP `json:"public_ip"`
+}
+
+// ServerIP represents an IP address attached to a Scaleway Instance.
+//
+// See: https://github.com/scaleway/scaleway-sdk-go/blob/master/api/instance/v1/instance_sdk.go
+type ServerIP struct {
+	ID      string `json:"id"`
+	Address string `json:"address"`
+	Dynamic bool   `json:"dynamic"`
+}
+
+// getInstances retrieves Instances from the Scaleway Instance HTTP API.
+func getInstances(cfg *apiConfig) ([]Instance, error) {
+	var instances []Instance
+
+	page := 1
+	for {
+		// See: https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+		path := fmt.Sprintf("/servers?%s&page=%d&per_page=%d", cfg.listQueryParams, page, perPage)
+		data, err := cfg.c.GetAPIResponseWithReqParams(path, func(req *http.Request) {
+			req.Header.Set("X-Auth-Token", cfg.secretKey)
+		})
+		if err != nil {
+			return nil, fmt.Errorf("cannot get Scaleway response from %q: %w", path, err)
+		}
+
+		var resp ListServersResponse
+		if err := json.Unmarshal(data, &resp); err != nil {
+			return nil, fmt.Errorf("cannot unmarshal ListServersResponse obtained from %q: %w; response=%q", path, err, data)
+		}
+
+		instances = append(instances, resp.Servers...)
+
+		if len(resp.Servers) < perPage || len(instances) >= resp.TotalCount {
+			break
+		}
+		page++
+	}
+
+	return instances, nil
+}
