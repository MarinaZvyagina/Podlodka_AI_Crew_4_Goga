+package scaleway
+
+import (
+	"net/http"
+	"reflect"
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+func strPtr(s string) *string {
+	return &s
+}
+
+func TestGetInstances_Success(t *testing.T) {
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		const resp = `{
+			"servers": [{
+				"id": "11111111-1111-1111-1111-111111111111",
+				"name": "scaleway-sd",
+				"hostname": "scaleway-sd",
+				"arch": "x86_64",
+				"boot_type": "local",
+				"commercial_type": "DEV1-S",
+				"organization": "22222222-2222-2222-2222-222222222222",
+				"project": "33333333-3333-3333-3333-333333333333",
+				"state": "running",
+				"zone": "fr-par-1",
+				"tags": ["foo", "bar"],
+				"public_ip": {
+					"id": "44444444-4444-4444-4444-444444444444",
+					"address": "51.15.0.1",
+					"dynamic": false
+				},
+				"private_ip": "10.0.0.1"
+			}],
+			"total_count": 1
+		}`
+		return []byte(resp)
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:         client,
+		secretKey: "some-secret-key",
+	}
+
+	instances, err := getInstances(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+
+	expectedInstances := []Instance{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "scaleway-sd",
+			Hostname:       "scaleway-sd",
+			Arch:           "x86_64",
+			BootType:       "local",
+			CommercialType: "DEV1-S",
+			Organization:   "22222222-2222-2222-2222-222222222222",
+			Project:        "33333333-3333-3333-3333-333333333333",
+			State:          "running",
+			Zone:           "fr-par-1",
+			Tags:           []string{"foo", "bar"},
+			PublicIP: &PublicIP{
+				ID:      "44444444-4444-4444-4444-444444444444",
+				Address: "51.15.0.1",
+				Dynamic: false,
+			},
+			PrivateIP: strPtr("10.0.0.1"),
+		},
+	}
+	if !reflect.DeepEqual(instances, expectedInstances) {
+		t.Fatalf("unexpected result\ngot\n%#v\nwant\n%#v", instances, expectedInstances)
+	}
+}
+
+func TestGetInstances_AuthHeader(t *testing.T) {
+	var gotToken string
+	s := newMockScalewayServer(func(r *http.Request) []byte {
+		gotToken = r.Header.Get("X-Auth-Token")
+		return []byte(`{"servers": [], "total_count": 0}`)
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:         client,
+		secretKey: "my-secret-key",
+	}
+
+	if _, err := getInstances(cfg); err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+	if gotToken != "my-secret-key" {
+		t.Fatalf("unexpected X-Auth-Token header; got %q; want %q", gotToken, "my-secret-key")
+	}
+}
+
+func TestGetInstances_Failure(t *testing.T) {
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		return []byte("some error")
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c: client,
+	}
+
+	if _, err := getInstances(cfg); err == nil {
+		t.Fatalf("expecting non-nil error from getInstances()")
+	}
+}
+
+func TestGetInstances_Paging(t *testing.T) {
+	requestCount := 0
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		if requestCount == 0 {
+			requestCount++
+			return []byte(mockListInstancesPage0Resp)
+		}
+		return []byte(mockListInstancesPage1Resp)
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c: client,
+	}
+
+	instances, err := getInstances(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+	if !reflect.DeepEqual(expectPagingInstances, instances) {
+		t.Fatalf("unexpected getInstances() result\ngot\n%#v\nwant\n%#v", instances, expectPagingInstances)
+	}
+}
+
+// ------------ Test dataset ------------
+var (
+	mockListInstancesPage0Resp = genPageResp("1-11111111-1111-1111-1111-111111111111", 150)
+	mockListInstancesPage1Resp = genPageResp("2-11111111-1111-1111-1111-111111111111", 150)
+
+	expectPagingInstances = []Instance{
+		{
+			ID:             "1-11111111-1111-1111-1111-111111111111",
+			Name:           "scaleway-sd",
+			Hostname:       "scaleway-sd",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Zone:           "fr-par-1",
+			PrivateIP:      strPtr("10.0.0.1"),
+		},
+		{
+			ID:             "2-11111111-1111-1111-1111-111111111111",
+			Name:           "scaleway-sd",
+			Hostname:       "scaleway-sd",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Zone:           "fr-par-1",
+			PrivateIP:      strPtr("10.0.0.1"),
+		},
+	}
+)
+
+func genPageResp(id string, totalCount int) string {
+	return `{
+		"servers": [{
+			"id": "` + id + `",
+			"name": "scaleway-sd",
+			"hostname": "scaleway-sd",
+			"commercial_type": "DEV1-S",
+			"state": "running",
+			"zone": "fr-par-1",
+			"private_ip": "10.0.0.1"
+		}],
+		"total_count": 2
+	}`
+}
diff --git a/lib/promscrape/discovery/scaleway/mock_server_test.go b/lib/promscrape/discovery/scaleway/mock_server_test.go
new file mode 100644
index 0000000..0d9d968
