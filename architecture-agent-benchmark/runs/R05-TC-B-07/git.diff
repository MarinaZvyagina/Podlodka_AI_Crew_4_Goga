+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "10.0.0.1:80",
+			"__meta_scaleway_instance_id":              "55555555-5555-5555-5555-555555555555",
+			"__meta_scaleway_instance_name":            "scaleway-sd-no-public-ip",
+			"__meta_scaleway_instance_hostname":        "scaleway-sd-no-public-ip",
