@@ -0,0 +1,46 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	f := func(sdc *SDConfig) {
+		t.Helper()
+		if _, err := newAPIConfig(sdc, "."); err == nil {
+			t.Fatalf("expecting non-nil error")
+		}
+	}
+
+	// missing secret_key
+	f(&SDConfig{
+		Project: "some-project",
+	})
+
+	// missing project_id and organization_id
+	f(&SDConfig{
+		SecretKey: promauth.NewSecret("some-secret-key"),
+	})
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		Project:   "some-project",
+		SecretKey: promauth.NewSecret("some-secret-key"),
+	}
+	ac, err := newAPIConfig(sdc, ".")
+	if err != nil {
+		t.Fatalf("newAPIConfig() failed: %s", err)
+	}
+	if ac.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want %d", ac.port, 80)
+	}
+	if ac.zone != "fr-par-1" {
+		t.Fatalf("unexpected default zone; got %q; want %q", ac.zone, "fr-par-1")
+	}
+	if ac.secretKey != "some-secret-key" {
+		t.Fatalf("unexpected secretKey; got %q; want %q", ac.secretKey, "some-secret-key")
+	}
+}
diff --git a/lib/promscrape/discovery/scaleway/instance.go b/lib/promscrape/discovery/scaleway/instance.go
new file mode 100644
index 0000000..adf2fa8
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/instance.go
@@ -0,0 +1,76 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+)
+
+// perPage is the maximum page size accepted by the Scaleway list instances API.
+const perPage = 100
+
+// listInstancesResponse is the response structure of the Scaleway list servers API.
+//
+// See: https://www.scaleway.com/en/developers/api/instance/#path-instances-list-instances
+type listInstancesResponse struct {
+	Servers    []Instance `json:"servers"`
+	TotalCount int        `json:"total_count"`
+}
+
+// Instance represents a Scaleway Instance (server).
+//
+// See: https://www.scaleway.com/en/developers/api/instance/#path-instances-list-instances
+type Instance struct {
+	ID             string    `json:"id"`
+	Name           string    `json:"name"`
+	Hostname       string    `json:"hostname"`
+	Arch           string    `json:"arch"`
+	BootType       string    `json:"boot_type"`
+	CommercialType string    `json:"commercial_type"`
+	Organization   string    `json:"organization"`
+	Project        string    `json:"project"`
+	State          string    `json:"state"`
+	Zone           string    `json:"zone"`
+	Tags           []string  `json:"tags"`
+	PublicIP       *PublicIP `json:"public_ip"`
+	PrivateIP      *string   `json:"private_ip"`
+}
+
+// PublicIP represents a public IP address attached to a Scaleway Instance.
+type PublicIP struct {
+	ID      string `json:"id"`
+	Address string `json:"address"`
+	Dynamic bool   `json:"dynamic"`
+}
+
+// getInstances retrieves instances from the Scaleway HTTP API.
+func getInstances(cfg *apiConfig) ([]Instance, error) {
+	var instances []Instance
+
+	setAuthHeader := func(req *http.Request) {
+		req.Header.Set("X-Auth-Token", cfg.secretKey)
+	}
+
+	page := 1
+	for {
+		// See: https://www.scaleway.com/en/developers/api/instance/#path-instances-list-instances
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?%s&per_page=%d&page=%d", cfg.zone, cfg.listQueryParams, perPage, page)
+		data, err := cfg.c.GetAPIResponseWithReqParams(path, setAuthHeader)
+		if err != nil {
+			return nil, fmt.Errorf("cannot get Scaleway response from %q: %w", path, err)
+		}
+
+		var resp listInstancesResponse
+		if err := json.Unmarshal(data, &resp); err != nil {
+			return nil, fmt.Errorf("cannot unmarshal listInstancesResponse obtained from %q: %w; response=%q", path, err, data)
+		}
+		instances = append(instances, resp.Servers...)
+
+		if len(resp.Servers) == 0 || len(instances) >= resp.TotalCount {
+			break
+		}
+		page++
+	}
+
+	return instances, nil
+}
