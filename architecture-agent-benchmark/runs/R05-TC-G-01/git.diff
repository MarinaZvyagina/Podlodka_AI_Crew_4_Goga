@@ -0,0 +1,74 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func TestGetServerLabels(t *testing.T) {
+	input := []Server{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "scw-sd-test",
+			Hostname:       "scw-sd-test",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Zone:           "fr-par-1",
+			Organization:   "22222222-2222-2222-2222-222222222222",
+			Project:        "33333333-3333-3333-3333-333333333333",
+			Tags:           []string{"foo", "bar"},
+			PrivateIP:      "10.0.0.1",
+			PublicIP:       &PublicIP{Address: "51.15.0.1"},
+		},
+		{
+			// Instance without a public IP: __address__ must fall back to the private IP.
+			ID:             "44444444-4444-4444-4444-444444444444",
+			Name:           "scw-sd-test-private-only",
+			Hostname:       "scw-sd-test-private-only",
+			CommercialType: "DEV1-M",
+			State:          "running",
+			Zone:           "nl-ams-1",
+			PrivateIP:      "10.0.0.2",
+		},
+		{
+			// Instance without any IP address must be skipped entirely.
+			ID:   "55555555-5555-5555-5555-555555555555",
+			Name: "scw-sd-test-no-ip",
+			Zone: "pl-waw-1",
+		},
+	}
+
+	expect := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "51.15.0.1:80",
+			"__meta_scaleway_instance_id":              "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":            "scw-sd-test",
+			"__meta_scaleway_instance_hostname":        "scw-sd-test",
+			"__meta_scaleway_instance_type":            "DEV1-S",
+			"__meta_scaleway_instance_status":          "running",
+			"__meta_scaleway_instance_zone":            "fr-par-1",
+			"__meta_scaleway_instance_organization_id": "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_project_id":      "33333333-3333-3333-3333-333333333333",
+			"__meta_scaleway_instance_private_ipv4":    "10.0.0.1",
+			"__meta_scaleway_instance_public_ipv4":     "51.15.0.1",
+			"__meta_scaleway_instance_tags":            ",foo,bar,",
+		}),
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "10.0.0.2:80",
+			"__meta_scaleway_instance_id":              "44444444-4444-4444-4444-444444444444",
+			"__meta_scaleway_instance_name":            "scw-sd-test-private-only",
+			"__meta_scaleway_instance_hostname":        "scw-sd-test-private-only",
+			"__meta_scaleway_instance_type":            "DEV1-M",
+			"__meta_scaleway_instance_status":          "running",
+			"__meta_scaleway_instance_zone":            "nl-ams-1",
+			"__meta_scaleway_instance_organization_id": "",
+			"__meta_scaleway_instance_project_id":      "",
+			"__meta_scaleway_instance_private_ipv4":    "10.0.0.2",
+			"__meta_scaleway_instance_public_ipv4":     "",
+		}),
+	}
+	labels := getServerLabels(input, 80)
+	discoveryutil.TestEqualLabelss(t, labels, expect)
+}
