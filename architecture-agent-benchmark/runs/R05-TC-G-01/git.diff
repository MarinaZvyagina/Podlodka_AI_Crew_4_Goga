@@ -0,0 +1,45 @@
+package scaleway
+
+import (
+	"testing"
+)
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{}
+	baseDir := "."
+	cfg, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	if cfg.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want 80", cfg.port)
+	}
+	if cfg.zone != defaultZone {
+		t.Fatalf("unexpected default zone; got %q; want %q", cfg.zone, defaultZone)
+	}
+	if cfg.listQueryParams != "" {
+		t.Fatalf("unexpected listQueryParams; got %q; want empty", cfg.listQueryParams)
+	}
+}
+
+func TestNewAPIConfig_CustomZonePortAndProject(t *testing.T) {
+	sdc := &SDConfig{
+		Zone:    "nl-ams-1",
+		Port:    9100,
+		Project: "11111111-1111-1111-1111-111111111111",
+	}
+	baseDir := "."
+	cfg, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	if cfg.zone != "nl-ams-1" {
+		t.Fatalf("unexpected zone; got %q; want nl-ams-1", cfg.zone)
+	}
+	if cfg.port != 9100 {
+		t.Fatalf("unexpected port; got %d; want 9100", cfg.port)
+	}
+	if cfg.listQueryParams != "project=11111111-1111-1111-1111-111111111111" {
+		t.Fatalf("unexpected listQueryParams; got %q", cfg.listQueryParams)
+	}
+}
diff --git a/lib/promscrape/discovery/scaleway/instance.go b/lib/promscrape/discovery/scaleway/instance.go
new file mode 100644
index 0000000..07aa0c7
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/instance.go
@@ -0,0 +1,66 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+)
+
+// serversPerPage is the number of servers requested per API call.
+const serversPerPage = 100
+
+// ListServersResponse is the response of Scaleway's list servers API.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-instances-list-all-instances
+type ListServersResponse struct {
+	Servers    []Server `json:"servers"`
+	TotalCount int      `json:"total_count"`
+}
+
+// Server represents a Scaleway Instance.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-instances-list-all-instances
+type Server struct {
+	ID             string    `json:"id"`
+	Name           string    `json:"name"`
+	Hostname       string    `json:"hostname"`
+	CommercialType string    `json:"commercial_type"`
+	State          string    `json:"state"`
+	Zone           string    `json:"zone"`
+	Organization   string    `json:"organization"`
+	Project        string    `json:"project"`
+	Tags           []string  `json:"tags"`
+	PrivateIP      string    `json:"private_ip"`
+	PublicIP       *PublicIP `json:"public_ip"`
+}
+
+// PublicIP represents the public IP address attached to a Scaleway Instance.
+type PublicIP struct {
+	Address string `json:"address"`
+}
+
+// getServers retrieves the list of servers in the zone configured in cfg from the Scaleway Instances API.
+func getServers(cfg *apiConfig) ([]Server, error) {
+	var servers []Server
+
+	page := 1
+	for {
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?%s&per_page=%d&page=%d", cfg.zone, cfg.listQueryParams, serversPerPage, page)
+		data, err := cfg.c.GetAPIResponse(path)
+		if err != nil {
+			return nil, fmt.Errorf("cannot get Scaleway response from %q: %w", path, err)
+		}
+
+		var resp ListServersResponse
+		if err := json.Unmarshal(data, &resp); err != nil {
+			return nil, fmt.Errorf("cannot unmarshal ListServersResponse obtained from %q: %w; response=%q", path, err, data)
+		}
+
+		servers = append(servers, resp.Servers...)
+		if len(resp.Servers) == 0 || len(servers) >= resp.TotalCount {
+			break
+		}
+		page++
+	}
+
+	return servers, nil
+}
