@@ -0,0 +1,23 @@
+package scaleway
+
+import (
+	"net/http"
+	"net/http/httptest"
+)
+
+type mockScalewayServer struct {
+	*httptest.Server
+	responseFunc func() []byte
+}
+
+func newMockScalewayServer(responseFunc func() []byte) *mockScalewayServer {
+	var s mockScalewayServer
+	s.responseFunc = responseFunc
+	s.Server = httptest.NewServer(http.HandlerFunc(s.handler))
+	return &s
+}
+
+func (s *mockScalewayServer) handler(w http.ResponseWriter, _ *http.Request) {
+	data := s.responseFunc()
+	w.Write(data)
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway.go b/lib/promscrape/discovery/scaleway/scaleway.go
new file mode 100644
index 0000000..7c0d7eb
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway.go
@@ -0,0 +1,105 @@
+package scaleway
+
+import (
+	"flag"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/proxy"
+)
+
+// SDCheckInterval defines interval for Scaleway targets refresh.
+var SDCheckInterval = flag.Duration("promscrape.scalewaySDCheckInterval", 30*time.Second, "Interval for checking for changes in Scaleway. "+
+	"This works only if scaleway_sd_configs is configured in '-promscrape.config' file. "+
+	"See https://docs.victoriametrics.com/victoriametrics/sd_configs/#scaleway_sd_configs for details")
+
+// SDConfig represents service discovery config for Scaleway Instances.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-instances-list-all-instances
+type SDConfig struct {
+	// Server is an optional Scaleway API server to query. By default, https://api.scaleway.com is used.
+	Server string `yaml:"server,omitempty"`
+
+	// Zone is the Scaleway zone to discover instances from. By default, fr-par-1 is used.
+	Zone string `yaml:"zone,omitempty"`
+
+	// Project is an optional Scaleway project ID to filter discovered instances by.
+	Project string `yaml:"project,omitempty"`
+
+	// Organization is an optional Scaleway organization ID to filter discovered instances by.
+	Organization string `yaml:"organization,omitempty"`
+
+	// Port is the port to scrape metrics from. By default, port 80 is used.
+	Port int `yaml:"port,omitempty"`
+
+	// General HTTP / Auth configs.
+	//
+	// Scaleway's API authenticates requests via a secret key passed in the `X-Auth-Token` header.
+	// It can be supplied via the `headers` option below, e.g. `headers: ["X-Auth-Token: <secret_key>"]`.
+	HTTPClientConfig  promauth.HTTPClientConfig  `yaml:",inline"`
+	ProxyURL          *proxy.URL                 `yaml:"proxy_url,omitempty"`
+	ProxyClientConfig promauth.ProxyClientConfig `yaml:",inline"`
+
+	// refresh_interval is obtained from `-promscrape.scalewaySDCheckInterval` command-line option.
+}
+
+var configMap = discoveryutil.NewConfigMap()
+
+// GetLabels returns Scaleway instance labels according to sdc.
+func (sdc *SDConfig) GetLabels(baseDir string) ([]*promutil.Labels, error) {
+	ac, err := getAPIConfig(sdc, baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot get API config: %w", err)
+	}
+	servers, err := getServers(ac)
+	if err != nil {
+		return nil, err
+	}
+	return getServerLabels(servers, ac.port), nil
+}
+
+// MustStop stops further usage for sdc.
+func (sdc *SDConfig) MustStop() {
+	_ = configMap.Delete(sdc)
+}
+
+// getServerLabels returns labels for Scaleway instances obtained from the given servers.
+func getServerLabels(servers []Server, port int) []*promutil.Labels {
+	ms := make([]*promutil.Labels, 0, len(servers))
+	for _, server := range servers {
+		publicIP := ""
+		if server.PublicIP != nil {
+			publicIP = server.PublicIP.Address
+		}
+		addr := publicIP
+		if addr == "" {
+			addr = server.PrivateIP
+		}
+		if addr == "" {
+			// Skip instances without any usable IP address.
+			continue
+		}
+
+		m := promutil.NewLabels(16)
+		m.Add("__address__", discoveryutil.JoinHostPort(addr, port))
+		m.Add("__meta_scaleway_instance_id", server.ID)
+		m.Add("__meta_scaleway_instance_name", server.Name)
+		m.Add("__meta_scaleway_instance_hostname", server.Hostname)
+		m.Add("__meta_scaleway_instance_type", server.CommercialType)
+		m.Add("__meta_scaleway_instance_status", server.State)
+		m.Add("__meta_scaleway_instance_zone", server.Zone)
+		m.Add("__meta_scaleway_instance_organization_id", server.Organization)
+		m.Add("__meta_scaleway_instance_project_id", server.Project)
+		m.Add("__meta_scaleway_instance_private_ipv4", server.PrivateIP)
+		m.Add("__meta_scaleway_instance_public_ipv4", publicIP)
+		if len(server.Tags) > 0 {
+			m.Add("__meta_scaleway_instance_tags", ","+strings.Join(server.Tags, ",")+",")
+		}
+		ms = append(ms, m)
+	}
+	return ms
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway_test.go b/lib/promscrape/discovery/scaleway/scaleway_test.go
