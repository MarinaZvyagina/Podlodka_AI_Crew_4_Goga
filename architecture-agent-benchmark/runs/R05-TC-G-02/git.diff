@@ -0,0 +1,66 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func TestGetServerLabels(t *testing.T) {
+	privateIP := "10.44.0.1"
+	input := []Server{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "scaleway-sd",
+			Arch:           "x86_64",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Hostname:       "scaleway-sd",
+			Zone:           "fr-par-1",
+			Organization:   "22222222-2222-2222-2222-222222222222",
+			Project:        "22222222-2222-2222-2222-222222222222",
+			Tags:           []string{"web", "production"},
+			PublicIP: &ServerIP{
+				Address: "51.15.0.1",
+			},
+			PrivateIP: &privateIP,
+		},
+		{
+			// non-running instances must be skipped
+			ID:        "22222222-2222-2222-2222-222222222222",
+			Name:      "scaleway-sd-stopped",
+			State:     "stopped",
+			Zone:      "fr-par-1",
+			Tags:      []string{},
+			PrivateIP: &privateIP,
+		},
+		{
+			// instances without any IP address must be skipped
+			ID:    "33333333-3333-3333-3333-333333333333",
+			Name:  "scaleway-sd-no-ip",
+			State: "running",
+			Zone:  "fr-par-1",
+		},
+	}
+
+	expect := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "51.15.0.1:8080",
+			"__meta_scaleway_instance_id":              "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":            "scaleway-sd",
+			"__meta_scaleway_instance_hostname":        "scaleway-sd",
+			"__meta_scaleway_instance_zone":            "fr-par-1",
+			"__meta_scaleway_instance_type":            "DEV1-S",
+			"__meta_scaleway_instance_arch":            "x86_64",
+			"__meta_scaleway_instance_state":           "running",
+			"__meta_scaleway_instance_organization_id": "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_project_id":      "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_public_ipv4":     "51.15.0.1",
+			"__meta_scaleway_instance_private_ipv4":    "10.44.0.1",
+			"__meta_scaleway_instance_tags":            ",web,production,",
+		}),
+	}
+	labels := getServerLabels(input, 8080)
+	discoveryutil.TestEqualLabelss(t, labels, expect)
+}
