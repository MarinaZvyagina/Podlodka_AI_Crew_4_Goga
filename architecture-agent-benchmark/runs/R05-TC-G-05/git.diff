+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func TestAddServerLabels(t *testing.T) {
+	f := func(servers []server, labelssExpected []*promutil.Labels) {
+		t.Helper()
+
+		labelss := addServerLabels(servers, 9100)
+		discoveryutil.TestEqualLabelss(t, labelss, labelssExpected)
+	}
+
+	// full set of fields
+	servers := []server{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "vm-1",
+			Hostname:       "vm-1.local",
+			Arch:           "x86_64",
+			CommercialType: "DEV1-S",
+			BootType:       "local",
+			State:          "running",
+			Zone:           "fr-par-1",
+			Organization:   "22222222-2222-2222-2222-222222222222",
+			Project:        "33333333-3333-3333-3333-333333333333",
+			Tags:           []string{"env=prod", "app=web"},
+			Image: image{
+				ID:   "44444444-4444-4444-4444-444444444444",
+				Name: "Ubuntu 22.04",
+			},
+			PrivateIP: "10.0.0.1",
+			PublicIPs: []publicIP{
+				{Address: "1.2.3.4", Family: "inet"},
+				{Address: "2001:db8::1", Family: "inet6"},
+			},
+			SecurityGroup: securityGroup{
+				ID:   "66666666-6666-6666-6666-666666666666",
+				Name: "default",
+			},
+		},
+	}
+	labelssExpected := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                                  "1.2.3.4:9100",
+			"__meta_scaleway_instance_id":                  "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":                "vm-1",
+			"__meta_scaleway_instance_hostname":            "vm-1.local",
+			"__meta_scaleway_instance_boot_type":           "local",
+			"__meta_scaleway_instance_image_id":            "44444444-4444-4444-4444-444444444444",
+			"__meta_scaleway_instance_image_name":          "Ubuntu 22.04",
+			"__meta_scaleway_instance_organization_id":     "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_project_id":          "33333333-3333-3333-3333-333333333333",
+			"__meta_scaleway_instance_private_ipv4":        "10.0.0.1",
+			"__meta_scaleway_instance_public_ipv4":         "1.2.3.4",
+			"__meta_scaleway_instance_public_ipv6":         "2001:db8::1",
+			"__meta_scaleway_instance_region":              "fr-par",
+			"__meta_scaleway_instance_zone":                "fr-par-1",
+			"__meta_scaleway_instance_security_group_id":   "66666666-6666-6666-6666-666666666666",
+			"__meta_scaleway_instance_security_group_name": "default",
+			"__meta_scaleway_instance_status":              "running",
+			"__meta_scaleway_instance_type":                "DEV1-S",
+			"__meta_scaleway_instance_tags":                ",env=prod,app=web,",
+		}),
+	}
+	f(servers, labelssExpected)
+
+	// instance with only a private IP falls back to it for __address__
+	servers = []server{
+		{
+			ID:             "77777777-7777-7777-7777-777777777777",
+			Name:           "vm-2",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Zone:           "nl-ams-1",
+			PrivateIP:      "10.0.0.2",
+		},
+	}
+	labelssExpected = []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                                  "10.0.0.2:9100",
+			"__meta_scaleway_instance_id":                  "77777777-7777-7777-7777-777777777777",
+			"__meta_scaleway_instance_name":                "vm-2",
+			"__meta_scaleway_instance_hostname":            "",
+			"__meta_scaleway_instance_boot_type":           "",
+			"__meta_scaleway_instance_image_id":            "",
+			"__meta_scaleway_instance_image_name":          "",
+			"__meta_scaleway_instance_organization_id":     "",
+			"__meta_scaleway_instance_project_id":          "",
+			"__meta_scaleway_instance_private_ipv4":        "10.0.0.2",
+			"__meta_scaleway_instance_public_ipv4":         "",
+			"__meta_scaleway_instance_public_ipv6":         "",
+			"__meta_scaleway_instance_region":              "nl-ams",
+			"__meta_scaleway_instance_zone":                "nl-ams-1",
+			"__meta_scaleway_instance_security_group_id":   "",
+			"__meta_scaleway_instance_security_group_name": "",
+			"__meta_scaleway_instance_status":              "running",
+			"__meta_scaleway_instance_type":                "DEV1-S",
+		}),
+	}
+	f(servers, labelssExpected)
+
+	// instance without any IP address is skipped
+	servers = []server{
+		{
+			ID:    "88888888-8888-8888-8888-888888888888",
+			Name:  "vm-3",
+			Zone:  "fr-par-1",
+			State: "stopped",
+		},
+	}
+	f(servers, nil)
+}
