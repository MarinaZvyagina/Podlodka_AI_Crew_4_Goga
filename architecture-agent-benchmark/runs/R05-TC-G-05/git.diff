+)
+
+func TestParseAPIResponse(t *testing.T) {
+	f := func(data string, responseExpected *listServersResponse) {
+		t.Helper()
+
+		response, err := parseAPIResponse([]byte(data))
+		if err != nil {
+			t.Fatalf("unexpected parseAPIResponse() error: %s", err)
+		}
+		if !reflect.DeepEqual(response, responseExpected) {
+			t.Fatalf("unexpected response\ngot\n%v\nwant\n%v", response, responseExpected)
+		}
+	}
+
+	data := `
+{
+  "servers": [
+    {
+      "id": "11111111-1111-1111-1111-111111111111",
+      "name": "vm-1",
+      "hostname": "vm-1",
+      "arch": "x86_64",
+      "commercial_type": "DEV1-S",
+      "boot_type": "local",
+      "state": "running",
+      "zone": "fr-par-1",
+      "organization": "22222222-2222-2222-2222-222222222222",
+      "project": "33333333-3333-3333-3333-333333333333",
+      "tags": ["env=prod", "app=web"],
+      "image": {
+        "id": "44444444-4444-4444-4444-444444444444",
+        "name": "Ubuntu 22.04"
+      },
+      "private_ip": "10.0.0.1",
+      "public_ip": {
+        "id": "55555555-5555-5555-5555-555555555555",
+        "address": "1.2.3.4",
+        "family": "inet"
+      },
+      "public_ips": [
+        {
+          "id": "55555555-5555-5555-5555-555555555555",
+          "address": "1.2.3.4",
+          "family": "inet"
+        }
+      ],
+      "security_group": {
+        "id": "66666666-6666-6666-6666-666666666666",
+        "name": "default"
+      }
+    }
+  ],
+  "total_count": 1
+}`
+
+	responseExpected := &listServersResponse{
+		Servers: []server{
+			{
+				ID:             "11111111-1111-1111-1111-111111111111",
+				Name:           "vm-1",
+				Hostname:       "vm-1",
+				Arch:           "x86_64",
+				CommercialType: "DEV1-S",
+				BootType:       "local",
+				State:          "running",
+				Zone:           "fr-par-1",
+				Organization:   "22222222-2222-2222-2222-222222222222",
+				Project:        "33333333-3333-3333-3333-333333333333",
+				Tags:           []string{"env=prod", "app=web"},
+				Image: image{
+					ID:   "44444444-4444-4444-4444-444444444444",
+					Name: "Ubuntu 22.04",
+				},
+				PrivateIP: "10.0.0.1",
+				PublicIP: &publicIP{
+					ID:      "55555555-5555-5555-5555-555555555555",
+					Address: "1.2.3.4",
+					Family:  "inet",
+				},
+				PublicIPs: []publicIP{
+					{
+						ID:      "55555555-5555-5555-5555-555555555555",
+						Address: "1.2.3.4",
+						Family:  "inet",
+					},
+				},
+				SecurityGroup: securityGroup{
+					ID:   "66666666-6666-6666-6666-666666666666",
+					Name: "default",
+				},
+			},
+		},
+		TotalCount: 1,
+	}
+	f(data, responseExpected)
+}
+
+func TestGetServers(t *testing.T) {
+	f := func(getAPIResponse func(string) ([]byte, error), expectedServerCount int) {
+		t.Helper()
+
+		cfg := &apiConfig{zone: "fr-par-1"}
+
+		resp, err := getServers(cfg, getAPIResponse)
+		if err != nil {
+			t.Fatalf("getServers() error: %s", err)
+		}
+		if len(resp) != expectedServerCount {
+			t.Fatalf("unexpected servers count; got %d; want %d\nservers:\n%v", len(resp), expectedServerCount, resp)
+		}
+	}
+
+	serverJSON := func(id string) string {
+		return fmt.Sprintf(`{
+      "id": %q,
+      "name": "vm",
+      "state": "running",
+      "zone": "fr-par-1",
+      "commercial_type": "DEV1-S",
+      "private_ip": "10.0.0.1"
+    }`, id)
+	}
+
+	getAPIResponse := func(path string) ([]byte, error) {
+		var resp []byte
+		if strings.Contains(path, "page=2") {
+			// second (partial) page finishes pagination
+			resp = []byte(fmt.Sprintf(`{"servers":[%s],"total_count":101}`, serverJSON("2")))
+		} else {
+			// first full page triggers another request
+			servers := make([]string, perPage)
+			for i := range servers {
+				servers[i] = serverJSON(fmt.Sprintf("page1-%d", i))
+			}
+			resp = []byte(fmt.Sprintf(`{"servers":[%s],"total_count":101}`, strings.Join(servers, ",")))
+		}
+		return resp, nil
+	}
+	f(getAPIResponse, perPage+1)
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway.go b/lib/promscrape/discovery/scaleway/scaleway.go
new file mode 100644
index 0000000..f4bdd34
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway.go
@@ -0,0 +1,174 @@
+package scaleway
+
+import (
+	"flag"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/proxy"
+)
+
+// SDCheckInterval defines interval for targets refresh.
+var SDCheckInterval = flag.Duration("promscrape.scalewaySDCheckInterval", 30*time.Second, "Interval for checking for changes in Scaleway Instances API. "+
+	"This works only if scaleway_sd_configs is configured in '-promscrape.config' file. "+
+	"See https://docs.victoriametrics.com/victoriametrics/sd_configs/#scaleway_sd_configs for details")
+
+// SDConfig represents service discovery config for Scaleway Instances.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type SDConfig struct {
+	// Server is an optional Scaleway API server to query.
+	// By default, https://api.scaleway.com is used.
+	Server string `yaml:"server,omitempty"`
+
+	// Zone is the Scaleway zone to discover instances in, e.g. "fr-par-1", "nl-ams-1" or "pl-waw-1".
+	// By default, "fr-par-1" is used.
+	Zone string `yaml:"zone,omitempty"`
+
+	// Project optionally filters discovered instances by the given project id.
+	Project string `yaml:"project_id,omitempty"`
+
+	// Organization optionally filters discovered instances by the given organization id.
+	Organization string `yaml:"organization_id,omitempty"`
+
+	// NameFilter optionally filters discovered instances by name.
+	NameFilter string `yaml:"name_filter,omitempty"`
+
+	// TagsFilter optionally filters discovered instances, which contain all the given tags.
+	TagsFilter []string `yaml:"tags_filter,omitempty"`
+
+	// Port is an optional port to scrape metrics from. By default, port 80 is used.
+	Port int `yaml:"port,omitempty"`
+
+	HTTPClientConfig  promauth.HTTPClientConfig  `yaml:",inline"`
+	ProxyURL          *proxy.URL                 `yaml:"proxy_url,omitempty"`
+	ProxyClientConfig promauth.ProxyClientConfig `yaml:",inline"`
+}
+
+// GetLabels returns Scaleway instance labels according to sdc.
+func (sdc *SDConfig) GetLabels(baseDir string) ([]*promutil.Labels, error) {
+	cfg, err := getAPIConfig(sdc, baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot get API config: %w", err)
+	}
+	servers, err := getServers(cfg, cfg.client.GetAPIResponse)
+	if err != nil {
+		return nil, err
+	}
+	return addServerLabels(servers, cfg.port), nil
+}
+
+// MustStop stops further usage for sdc.
+func (sdc *SDConfig) MustStop() {
+	v := configMap.Delete(sdc)
+	if v != nil {
+		cfg := v.(*apiConfig)
+		cfg.client.Stop()
+	}
+}
+
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type server struct {
+	ID             string        `json:"id"`
+	Name           string        `json:"name"`
+	Hostname       string        `json:"hostname"`
+	Arch           string        `json:"arch"`
+	CommercialType string        `json:"commercial_type"`
+	BootType       string        `json:"boot_type"`
+	State          string        `json:"state"`
+	Zone           string        `json:"zone"`
+	Organization   string        `json:"organization"`
+	Project        string        `json:"project"`
+	Tags           []string      `json:"tags"`
+	Image          image         `json:"image"`
+	PrivateIP      string        `json:"private_ip"`
+	PublicIP       *publicIP     `json:"public_ip"`
+	PublicIPs      []publicIP    `json:"public_ips"`
+	SecurityGroup  securityGroup `json:"security_group"`
+}
+
+type image struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+}
+
+type publicIP struct {
+	ID      string `json:"id"`
+	Address string `json:"address"`
+	// Family is "inet" for IPv4 and "inet6" for IPv6.
+	Family string `json:"family"`
+}
+
+type securityGroup struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+}
+
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type listServersResponse struct {
+	Servers    []server `json:"servers"`
+	TotalCount int      `json:"total_count"`
+}
+
+func (s *server) getPublicIP(family string) string {
+	for _, ip := range s.PublicIPs {
+		if ip.Family == family {
+			return ip.Address
+		}
+	}
+	if family == "inet" && s.PublicIP != nil {
+		return s.PublicIP.Address
+	}
+	return ""
+}
+
+func addServerLabels(servers []server, defaultPort int) []*promutil.Labels {
+	var ms []*promutil.Labels
+	for _, srv := range servers {
+		publicIPv4 := srv.getPublicIP("inet")
+		privateIPv4 := srv.PrivateIP
+
+		addrHost := publicIPv4
+		if addrHost == "" {
+			addrHost = privateIPv4
+		}
+		if addrHost == "" {
+			continue
+		}
+
+		region := srv.Zone
+		if n := strings.LastIndex(region, "-"); n >= 0 {
+			region = region[:n]
+		}
+
+		m := promutil.NewLabels(20)
+		m.Add("__address__", discoveryutil.JoinHostPort(addrHost, defaultPort))
+		m.Add("__meta_scaleway_instance_id", srv.ID)
+		m.Add("__meta_scaleway_instance_name", srv.Name)
+		m.Add("__meta_scaleway_instance_hostname", srv.Hostname)
+		m.Add("__meta_scaleway_instance_boot_type", srv.BootType)
+		m.Add("__meta_scaleway_instance_image_id", srv.Image.ID)
+		m.Add("__meta_scaleway_instance_image_name", srv.Image.Name)
+		m.Add("__meta_scaleway_instance_organization_id", srv.Organization)
+		m.Add("__meta_scaleway_instance_project_id", srv.Project)
+		m.Add("__meta_scaleway_instance_private_ipv4", privateIPv4)
+		m.Add("__meta_scaleway_instance_public_ipv4", publicIPv4)
+		m.Add("__meta_scaleway_instance_public_ipv6", srv.getPublicIP("inet6"))
+		m.Add("__meta_scaleway_instance_region", region)
+		m.Add("__meta_scaleway_instance_zone", srv.Zone)
+		m.Add("__meta_scaleway_instance_security_group_id", srv.SecurityGroup.ID)
+		m.Add("__meta_scaleway_instance_security_group_name", srv.SecurityGroup.Name)
+		m.Add("__meta_scaleway_instance_status", srv.State)
+		m.Add("__meta_scaleway_instance_type", srv.CommercialType)
+		if len(srv.Tags) > 0 {
+			tags := fmt.Sprintf(",%s,", strings.Join(srv.Tags, ","))
+			m.Add("__meta_scaleway_instance_tags", tags)
+		}
+		ms = append(ms, m)
+	}
+	return ms
+}
