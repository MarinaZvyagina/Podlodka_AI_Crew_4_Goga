diff --git a/lib/promscrape/discovery/scaleway/api.go b/lib/promscrape/discovery/scaleway/api.go
new file mode 100644
index 0000000..66e3732
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api.go
@@ -0,0 +1,115 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/url"
+	"strings"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+var configMap = discoveryutil.NewConfigMap()
+
+// defaultZone is used when SDConfig.Zone is unset.
+const defaultZone = "fr-par-1"
+
+// serversPerPage is the maximum number of instances requested per API call.
+const serversPerPage = 100
+
+type apiConfig struct {
+	client    *discoveryutil.Client
+	projectID string
+	zone      string
+	port      int
+}
+
+func newAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	if sdc.ProjectID == "" {
+		return nil, fmt.Errorf("missing `project_id` in `scaleway_sd_config`")
+	}
+	ac, err := sdc.HTTPClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse auth config: %w", err)
+	}
+
+	apiServer := sdc.Server
+	if apiServer == "" {
+		apiServer = "https://api.scaleway.com"
+	}
+	if !strings.Contains(apiServer, "://") {
+		scheme := "http"
+		if sdc.HTTPClientConfig.TLSConfig != nil {
+			scheme = "https"
+		}
+		apiServer = scheme + "://" + apiServer
+	}
+	proxyAC, err := sdc.ProxyClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse proxy auth config: %w", err)
+	}
+	client, err := discoveryutil.NewClient(apiServer, ac, sdc.ProxyURL, proxyAC, &sdc.HTTPClientConfig)
+	if err != nil {
+		return nil, fmt.Errorf("cannot create HTTP client for %q: %w", apiServer, err)
+	}
+	zone := sdc.Zone
+	if zone == "" {
+		zone = defaultZone
+	}
+	cfg := &apiConfig{
+		client:    client,
+		projectID: sdc.ProjectID,
+		zone:      zone,
+		port:      sdc.Port,
+	}
+	if cfg.port == 0 {
+		cfg.port = 80
+	}
+	return cfg, nil
+}
+
+func getAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	v, err := configMap.Get(sdc, func() (any, error) { return newAPIConfig(sdc, baseDir) })
+	if err != nil {
+		return nil, err
+	}
+	return v.(*apiConfig), nil
+}
+
+func instancesAPIPath(zone, projectID string, page int) string {
+	v := url.Values{}
+	v.Set("project", projectID)
+	v.Set("page", fmt.Sprintf("%d", page))
+	v.Set("per_page", fmt.Sprintf("%d", serversPerPage))
+	return fmt.Sprintf("/instance/v1/zones/%s/servers?%s", url.PathEscape(zone), v.Encode())
+}
+
+func getInstances(zone, projectID string, getAPIResponse func(string) ([]byte, error)) ([]instance, error) {
+	var instances []instance
+
+	page := 1
+	for {
+		data, err := getAPIResponse(instancesAPIPath(zone, projectID, page))
+		if err != nil {
+			return nil, fmt.Errorf("cannot fetch data from scaleway instances api: %w", err)
+		}
+		apiResp, err := parseAPIResponse(data)
+		if err != nil {
+			return nil, err
+		}
+		instances = append(instances, apiResp.Servers...)
+		if len(apiResp.Servers) == 0 || len(instances) >= apiResp.TotalCount {
+			break
+		}
+		page++
+	}
+	return instances, nil
+}
+
+func parseAPIResponse(data []byte) (*listServersResponse, error) {
+	var resp listServersResponse
+	if err := json.Unmarshal(data, &resp); err != nil {
+		return nil, fmt.Errorf("failed parse scaleway api response: %q, err: %w", data, err)
+	}
+	return &resp, nil
+}
diff --git a/lib/promscrape/discovery/scaleway/api_test.go b/lib/promscrape/discovery/scaleway/api_test.go
new file mode 100644
index 0000000..0c104eb
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api_test.go
@@ -0,0 +1,109 @@
+package scaleway
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestParseAPIResponse(t *testing.T) {
+	f := func(data string, responseExpected *listServersResponse) {
+		t.Helper()
+
+		response, err := parseAPIResponse([]byte(data))
+		if err != nil {
+			t.Fatalf("unexpected parseAPIResponse() error: %s", err)
+		}
+		if !reflect.DeepEqual(response, responseExpected) {
+			t.Fatalf("unexpected response\ngot\n%v\nwant\n%v", response, responseExpected)
+		}
+	}
+
+	data := `
+{
+  "servers": [
+    {
+      "id": "11111111-1111-1111-1111-111111111111",
+      "name": "example",
+      "hostname": "example",
+      "organization": "org-1",
+      "project": "project-1",
+      "tags": ["tag1", "tag2"],
+      "commercial_type": "DEV1-S",
+      "arch": "x86_64",
+      "state": "running",
+      "zone": "fr-par-1",
+      "private_ip": "10.10.10.10",
+      "public_ip": {
+        "id": "22222222-2222-2222-2222-222222222222",
+        "address": "163.172.0.1"
+      }
+    }
+  ],
+  "total_count": 1
+}`
+
+	privateIP := "10.10.10.10"
+	responseExpected := &listServersResponse{
+		Servers: []instance{
+			{
+				ID:             "11111111-1111-1111-1111-111111111111",
+				Name:           "example",
+				Hostname:       "example",
+				Organization:   "org-1",
+				Project:        "project-1",
+				Tags:           []string{"tag1", "tag2"},
+				CommercialType: "DEV1-S",
+				Arch:           "x86_64",
+				State:          "running",
+				Zone:           "fr-par-1",
+				PrivateIP:      &privateIP,
+				PublicIP: &publicIP{
+					Address: "163.172.0.1",
+				},
+			},
+		},
+		TotalCount: 1,
+	}
+	f(data, responseExpected)
+}
+
+func TestGetInstances(t *testing.T) {
+	f := func(getAPIResponse func(string) ([]byte, error), expectedInstanceCount int) {
+		t.Helper()
+
+		instances, err := getInstances("fr-par-1", "project-1", getAPIResponse)
+		if err != nil {
+			t.Fatalf("getInstances() error: %s", err)
+		}
+		if len(instances) != expectedInstanceCount {
+			t.Fatalf("unexpected instances count; got %d; want %d\ninstances:\n%v", len(instances), expectedInstanceCount, instances)
+		}
+	}
+
+	pageOne := `{
+  "servers": [
+    {"id": "1", "name": "s1", "state": "running", "public_ip": {"address": "1.1.1.1"}},
+    {"id": "2", "name": "s2", "state": "running", "public_ip": {"address": "1.1.1.2"}}
+  ],
+  "total_count": 3
+}`
+	pageTwo := `{
+  "servers": [
+    {"id": "3", "name": "s3", "state": "running", "public_ip": {"address": "1.1.1.3"}}
+  ],
+  "total_count": 3
+}`
+
+	getAPIResponse := func(path string) ([]byte, error) {
+		switch path {
+		case instancesAPIPath("fr-par-1", "project-1", 1):
+			return []byte(pageOne), nil
+		case instancesAPIPath("fr-par-1", "project-1", 2):
+			return []byte(pageTwo), nil
+		default:
+			t.Fatalf("unexpected request path: %s", path)
+			return nil, nil
+		}
+	}
+	f(getAPIResponse, 3)
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway.go b/lib/promscrape/discovery/scaleway/scaleway.go
new file mode 100644
index 0000000..d79983f
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway.go
@@ -0,0 +1,124 @@
+package scaleway
+
+import (
+	"flag"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/proxy"
+)
+
+// SDCheckInterval defines interval for targets refresh.
+var SDCheckInterval = flag.Duration("promscrape.scalewaySDCheckInterval", 30*time.Second, "Interval for checking for changes in Scaleway. "+
+	"This works only if scaleway_sd_configs is configured in '-promscrape.config' file. "+
+	"See https://docs.victoriametrics.com/victoriametrics/sd_configs/#scaleway_sd_configs for details")
+
+// SDConfig represents service discovery config for Scaleway Instances.
+//
+// See https://prometheus.io/docs/prometheus/latest/configuration/configuration/#scaleway_sd_config
+type SDConfig struct {
+	Server            string                     `yaml:"api_url,omitempty"`
+	ProjectID         string                     `yaml:"project_id"`
+	Zone              string                     `yaml:"zone,omitempty"`
+	HTTPClientConfig  promauth.HTTPClientConfig  `yaml:",inline"`
+	ProxyURL          *proxy.URL                 `yaml:"proxy_url,omitempty"`
+	ProxyClientConfig promauth.ProxyClientConfig `yaml:",inline"`
+	Port              int                        `yaml:"port,omitempty"`
+}
+
+// GetLabels returns Scaleway Instance labels according to sdc.
+func (sdc *SDConfig) GetLabels(baseDir string) ([]*promutil.Labels, error) {
+	cfg, err := getAPIConfig(sdc, baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot get API config: %w", err)
+	}
+	instances, err := getInstances(cfg.zone, cfg.projectID, cfg.client.GetAPIResponse)
+	if err != nil {
+		return nil, err
+	}
+	return addInstanceLabels(instances, cfg.port), nil
+}
+
+// https://www.scaleway.com/en/developers/api/instance/#path-instances-list-all-instances
+type instance struct {
+	ID             string    `json:"id"`
+	Name           string    `json:"name"`
+	Hostname       string    `json:"hostname"`
+	Organization   string    `json:"organization"`
+	Project        string    `json:"project"`
+	Tags           []string  `json:"tags"`
+	CommercialType string    `json:"commercial_type"`
+	Arch           string    `json:"arch"`
+	State          string    `json:"state"`
+	Zone           string    `json:"zone"`
+	PrivateIP      *string   `json:"private_ip"`
+	PublicIP       *publicIP `json:"public_ip"`
+}
+
+type publicIP struct {
+	Address string `json:"address"`
+}
+
+// https://www.scaleway.com/en/developers/api/instance/#path-instances-list-all-instances
+type listServersResponse struct {
+	Servers    []instance `json:"servers"`
+	TotalCount int        `json:"total_count"`
+}
+
+func addInstanceLabels(instances []instance, defaultPort int) []*promutil.Labels {
+	var ms []*promutil.Labels
+	for _, inst := range instances {
+		if inst.State != "running" {
+			continue
+		}
+
+		var publicIPv4, privateIPv4 string
+		if inst.PublicIP != nil {
+			publicIPv4 = inst.PublicIP.Address
+		}
+		if inst.PrivateIP != nil {
+			privateIPv4 = *inst.PrivateIP
+		}
+
+		addr := publicIPv4
+		if addr == "" {
+			addr = privateIPv4
+		}
+		if addr == "" {
+			continue
+		}
+
+		m := promutil.NewLabels(16)
+		m.Add("__address__", discoveryutil.JoinHostPort(addr, defaultPort))
+		m.Add("__meta_scaleway_instance_id", inst.ID)
+		m.Add("__meta_scaleway_instance_name", inst.Name)
+		m.Add("__meta_scaleway_instance_hostname", inst.Hostname)
+		m.Add("__meta_scaleway_instance_type", inst.CommercialType)
+		m.Add("__meta_scaleway_instance_architecture", inst.Arch)
+		m.Add("__meta_scaleway_instance_status", inst.State)
+		m.Add("__meta_scaleway_instance_zone", inst.Zone)
+		m.Add("__meta_scaleway_instance_organization_id", inst.Organization)
+		m.Add("__meta_scaleway_instance_project_id", inst.Project)
+		m.Add("__meta_scaleway_instance_public_ipv4", publicIPv4)
+		m.Add("__meta_scaleway_instance_private_ipv4", privateIPv4)
+		if len(inst.Tags) > 0 {
+			tags := fmt.Sprintf(",%s,", strings.Join(inst.Tags, ","))
+			m.Add("__meta_scaleway_instance_tags", tags)
+		}
+		ms = append(ms, m)
+	}
+	return ms
+}
+
+// MustStop stops further usage for sdc.
+func (sdc *SDConfig) MustStop() {
+	v := configMap.Delete(sdc)
+	if v != nil {
+		cfg := v.(*apiConfig)
+		cfg.client.Stop()
+	}
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway_test.go b/lib/promscrape/discovery/scaleway/scaleway_test.go
