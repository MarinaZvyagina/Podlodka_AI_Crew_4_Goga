+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func TestAddInstanceLabels(t *testing.T) {
+	f := func(instances []instance, labelssExpected []*promutil.Labels) {
+		t.Helper()
+
+		labelss := addInstanceLabels(instances, 9100)
+		discoveryutil.TestEqualLabelss(t, labelss, labelssExpected)
+	}
+
+	runningPrivateIP := "10.10.10.10"
+	privateOnlyIP := "10.10.10.20"
+	instances := []instance{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "test-1",
+			Hostname:       "test-1",
+			Organization:   "org-1",
+			Project:        "project-1",
+			Tags:           []string{"foo", "bar"},
+			CommercialType: "DEV1-S",
+			Arch:           "x86_64",
+			State:          "running",
+			Zone:           "fr-par-1",
+			PrivateIP:      &runningPrivateIP,
+			PublicIP: &publicIP{
+				Address: "100.100.100.100",
+			},
+		},
+		{
+			// instances without a public IP must fall back to the private IP
+			ID:             "33333333-3333-3333-3333-333333333333",
+			Name:           "test-3",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Zone:           "fr-par-2",
+			PrivateIP:      &privateOnlyIP,
+		},
+		{
+			// stopped instances must be skipped
+			ID:    "22222222-2222-2222-2222-222222222222",
+			Name:  "test-2",
+			State: "stopped",
+			Zone:  "fr-par-1",
+			PublicIP: &publicIP{
+				Address: "100.100.100.200",
+			},
+		},
+		{
+			// instances without any IP must be skipped
+			ID:    "44444444-4444-4444-4444-444444444444",
+			Name:  "test-4",
+			State: "running",
+			Zone:  "fr-par-1",
+		},
+	}
+	labelssExpected := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "100.100.100.100:9100",
+			"__meta_scaleway_instance_id":              "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":            "test-1",
+			"__meta_scaleway_instance_hostname":        "test-1",
+			"__meta_scaleway_instance_type":            "DEV1-S",
+			"__meta_scaleway_instance_architecture":    "x86_64",
+			"__meta_scaleway_instance_status":          "running",
+			"__meta_scaleway_instance_zone":            "fr-par-1",
+			"__meta_scaleway_instance_organization_id": "org-1",
+			"__meta_scaleway_instance_project_id":      "project-1",
+			"__meta_scaleway_instance_public_ipv4":     "100.100.100.100",
+			"__meta_scaleway_instance_private_ipv4":    "10.10.10.10",
+			"__meta_scaleway_instance_tags":            ",foo,bar,",
+		}),
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "10.10.10.20:9100",
+			"__meta_scaleway_instance_id":              "33333333-3333-3333-3333-333333333333",
+			"__meta_scaleway_instance_name":            "test-3",
+			"__meta_scaleway_instance_hostname":        "",
+			"__meta_scaleway_instance_type":            "DEV1-S",
+			"__meta_scaleway_instance_architecture":    "",
+			"__meta_scaleway_instance_status":          "running",
+			"__meta_scaleway_instance_zone":            "fr-par-2",
+			"__meta_scaleway_instance_organization_id": "",
+			"__meta_scaleway_instance_project_id":      "",
+			"__meta_scaleway_instance_public_ipv4":     "",
+			"__meta_scaleway_instance_private_ipv4":    "10.10.10.20",
+		}),
+	}
+	f(instances, labelssExpected)
+}
