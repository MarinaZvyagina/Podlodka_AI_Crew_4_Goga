+func TestStorage_SeriesLimitExceededMetricNamesTracking(t *testing.T) {
+	defer testRemoveAll(t)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+
+	const (
+		maxHourlySeries = 10
+		metricNames     = 3
+		seriesPerMetric = 20
+	)
+
+	var mrs []MetricRow
+	for nameIdx := range metricNames {
+		metricGroup := fmt.Appendf(nil, "metric_%d", nameIdx)
+		for seriesIdx := range seriesPerMetric {
+			var mn MetricName
+			mn.MetricGroup = metricGroup
+			mn.Tags = []Tag{
+				{Key: []byte("job"), Value: []byte("webservice")},
+				{Key: []byte("instance"), Value: fmt.Appendf(nil, "instance_%d", seriesIdx)},
+			}
+			mrs = append(mrs, MetricRow{
+				MetricNameRaw: mn.marshalRaw(nil),
+				Timestamp:     rng.Int63n(maxTimestamp-minTimestamp) + minTimestamp,
+				Value:         rng.NormFloat64(),
+			})
+		}
+	}
+
+	// Test both "not tracking" (default) and "tracking enabled" modes to
+	// verify that the feature is opt-in and doesn't affect the existing
+	// aggregate drop counter either way.
+	t.Run("TrackingDisabled", func(t *testing.T) {
+		opts := OpenOptions{
+			MaxHourlySeries: maxHourlySeries,
+		}
+		s := MustOpenStorage(filepath.Join(t.Name(), "TrackingDisabled"), opts)
+		defer s.MustClose()
+		s.AddRows(mrs, defaultPrecisionBits)
+		s.DebugFlush()
+
+		var m Metrics
+		s.UpdateMetrics(&m)
+		if m.HourlySeriesLimitRowsDropped == 0 {
+			t.Fatalf("expected some rows to be dropped due to hourly series limit")
+		}
+
+		stats := s.GetSeriesLimitExceededStats(0)
+		if len(stats.Records) != 0 {
+			t.Fatalf("expected no per-metric-name records when tracking is disabled, got %v", stats.Records)
+		}
+	})
+
+	t.Run("TrackingEnabled", func(t *testing.T) {
+		opts := OpenOptions{
+			MaxHourlySeries:                     maxHourlySeries,
+			TrackSeriesLimitExceededMetricNames: true,
+		}
+		s := MustOpenStorage(filepath.Join(t.Name(), "TrackingEnabled"), opts)
+		defer s.MustClose()
+		s.AddRows(mrs, defaultPrecisionBits)
+		s.DebugFlush()
+
+		var m Metrics
+		s.UpdateMetrics(&m)
+		wantDropped := uint64(len(mrs)) - maxHourlySeries
+		if m.HourlySeriesLimitRowsDropped != wantDropped {
+			t.Fatalf("unexpected HourlySeriesLimitRowsDropped: got %d, want %d", m.HourlySeriesLimitRowsDropped, wantDropped)
+		}
+
+		stats := s.GetSeriesLimitExceededStats(10)
+		if len(stats.Records) == 0 {
+			t.Fatalf("expected at least one tracked metric name")
+		}
+		var totalTracked uint64
+		for i, r := range stats.Records {
+			totalTracked += r.DroppedRowsTotal
+			if i > 0 && stats.Records[i-1].DroppedRowsTotal < r.DroppedRowsTotal {
+				t.Fatalf("records aren't sorted in descending order of DroppedRowsTotal: %v", stats.Records)
+			}
+		}
+		if totalTracked != m.HourlySeriesLimitRowsDropped {
+			t.Fatalf("unexpected total tracked dropped rows: got %d, want %d", totalTracked, m.HourlySeriesLimitRowsDropped)
+		}
+
+		// limit must be respected
+		limited := s.GetSeriesLimitExceededStats(1)
+		if len(limited.Records) != 1 {
+			t.Fatalf("unexpected number of records with limit=1: got %d", len(limited.Records))
+		}
+		if limited.Records[0] != stats.Records[0] {
+			t.Fatalf("unexpected top record with limit=1: got %+v, want %+v", limited.Records[0], stats.Records[0])
+		}
+
+		s.ResetSeriesLimitExceededStats()
+		stats = s.GetSeriesLimitExceededStats(0)
+		if len(stats.Records) != 0 {
+			t.Fatalf("expected no records after reset, got %v", stats.Records)
+		}
+
+		var mAfterReset Metrics
+		s.UpdateMetrics(&mAfterReset)
+		if mAfterReset.HourlySeriesLimitRowsDropped != m.HourlySeriesLimitRowsDropped {
+			t.Fatalf("ResetSeriesLimitExceededStats must not affect the aggregate HourlySeriesLimitRowsDropped counter")
+		}
+	})
+}
