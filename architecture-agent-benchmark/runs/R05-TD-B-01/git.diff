diff --git a/lib/storage/droppedseries/tracker.go b/lib/storage/droppedseries/tracker.go
new file mode 100644
index 0000000..eac0957
--- /dev/null
+++ b/lib/storage/droppedseries/tracker.go
@@ -0,0 +1,218 @@
+// Package droppedseries tracks, per metric name, how many samples were
+// dropped because adding a new series for that metric name would have
+// exceeded -storage.maxHourlySeries or -storage.maxDailySeries.
+//
+// This helps to answer support questions like "which metric names are
+// causing us to hit our series-limit settings" without requiring customers
+// to dig through their own instrumentation.
+package droppedseries
+
+import (
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/bytesutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+const (
+	// metricNameBufSize is the size of the batch allocation used for storing
+	// cloned metric names. See cloneMetricNameLocked.
+	metricNameBufSize = 4 * 1024
+
+	// storeOverhead approximates the per-entry memory overhead of the map
+	// entry (map bucket, string header, atomic counter and pointer) on top
+	// of the metric name bytes themselves.
+	storeOverhead = 64
+)
+
+// Tracker tracks, per metric name, the number of samples dropped because
+// adding a new series for that metric name would have exceeded the
+// configured -storage.maxHourlySeries or -storage.maxDailySeries limit.
+//
+// Tracker has a bounded memory footprint controlled by maxSizeBytes: once
+// the tracked metric names occupy maxSizeBytes, drops for metric names,
+// which aren't tracked yet, are silently ignored, while counters for
+// already-tracked metric names keep being updated. This guarantees Tracker
+// cannot grow without bound even when an installation has millions of
+// distinct metric names hitting the limit.
+type Tracker struct {
+	maxSizeBytes uint64
+
+	creationTs       atomic.Uint64
+	currentSizeBytes atomic.Uint64
+
+	// mu protects the fields below.
+	mu sync.RWMutex
+
+	m map[string]*atomic.Uint64
+	// metricNamesBuf holds batch allocations for the metric names used as
+	// keys at m. See cloneMetricNameLocked.
+	metricNamesBuf []byte
+}
+
+// NewTracker creates a Tracker, which tracks at most maxSizeBytes bytes of
+// metric names in memory.
+func NewTracker(maxSizeBytes uint64) *Tracker {
+	t := &Tracker{
+		maxSizeBytes: maxSizeBytes,
+	}
+	t.resetLocked()
+	return t
+}
+
+func (t *Tracker) resetLocked() {
+	t.m = make(map[string]*atomic.Uint64)
+	t.metricNamesBuf = nil
+	t.currentSizeBytes.Store(0)
+	t.creationTs.Store(fasttime.UnixTimestamp())
+}
+
+// IncrementDroppedRows increments the number of dropped rows tracked for
+// the given metricName by 1.
+//
+// It is safe to call IncrementDroppedRows on a nil Tracker - it is a no-op
+// in this case. This allows keeping this tracking disabled with zero
+// overhead by simply keeping the Tracker pointer nil.
+func (t *Tracker) IncrementDroppedRows(metricName []byte) {
+	if t == nil {
+		return
+	}
+	t.mu.RLock()
+	c, ok := t.m[bytesutil.ToUnsafeString(metricName)]
+	t.mu.RUnlock()
+	if ok {
+		c.Add(1)
+		return
+	}
+	if t.currentSizeBytes.Load() > t.maxSizeBytes {
+		// The tracker is full - do not track new metric names in order to
+		// bound memory usage. Note that drops for metric names, which are
+		// already tracked, are still counted above.
+		return
+	}
+
+	t.mu.Lock()
+	// The entry could have been added concurrently while the lock above was released.
+	c, ok = t.m[bytesutil.ToUnsafeString(metricName)]
+	if !ok {
+		name := t.cloneMetricNameLocked(metricName)
+		c = &atomic.Uint64{}
+		t.m[name] = c
+		t.currentSizeBytes.Add(uint64(len(metricName)) + storeOverhead)
+	}
+	t.mu.Unlock()
+
+	c.Add(1)
+}
+
+// cloneMetricNameLocked uses the same idea as strings.Clone, but instead of
+// allocating a []byte per each cloned string, it allocates metricNamesBuf,
+// copies the provided metricName into it and returns a string referencing
+// the copy via a subslice. This reduces the number of allocations and GC
+// pressure. It must be called with t.mu held for writing.
+func (t *Tracker) cloneMetricNameLocked(metricName []byte) string {
+	if len(metricName) > metricNameBufSize {
+		b := make([]byte, len(metricName))
+		copy(b, metricName)
+		return bytesutil.ToUnsafeString(b)
+	}
+	idx := len(t.metricNamesBuf)
+	n := len(metricName) + len(t.metricNamesBuf)
+	if n > cap(t.metricNamesBuf) {
+		t.metricNamesBuf = make([]byte, 0, metricNameBufSize)
+		idx = 0
+	}
+	t.metricNamesBuf = append(t.metricNamesBuf, metricName...)
+	return bytesutil.ToUnsafeString(t.metricNamesBuf[idx:])
+}
+
+// Reset drops all the previously collected stats and restarts the
+// CollectedSinceTimestamp counter.
+//
+// It is safe to call Reset on a nil Tracker - it is a no-op in this case.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.resetLocked()
+	t.mu.Unlock()
+}
+
+// Record is a single per-metric-name stat entry.
+type Record struct {
+	// MetricName is the metric name samples were dropped for.
+	MetricName string
+	// DroppedRowsTotal is the total number of dropped samples recorded for MetricName.
+	DroppedRowsTotal uint64
+}
+
+// StatsResult is the response returned by Tracker.GetTopRecords.
+type StatsResult struct {
+	// CollectedSinceTimestamp is the unix timestamp in seconds since which
+	// the stats have been collected, i.e. the time the Tracker was created
+	// or last reset.
+	CollectedSinceTimestamp uint64
+	// Records contains at most the requested number of records with the
+	// highest DroppedRowsTotal, sorted in descending order of DroppedRowsTotal.
+	Records []Record
+}
+
+// GetTopRecords returns up to limit records with the highest
+// DroppedRowsTotal, sorted in descending order of DroppedRowsTotal. A
+// non-positive limit returns all the tracked records.
+//
+// It returns a zero StatsResult when called on a nil Tracker.
+func (t *Tracker) GetTopRecords(limit int) StatsResult {
+	var result StatsResult
+	if t == nil {
+		return result
+	}
+
+	t.mu.RLock()
+	result.CollectedSinceTimestamp = t.creationTs.Load()
+	records := make([]Record, 0, len(t.m))
+	for name, c := range t.m {
+		records = append(records, Record{
+			MetricName:       name,
+			DroppedRowsTotal: c.Load(),
+		})
+	}
+	t.mu.RUnlock()
+
+	sort.Slice(records, func(i, j int) bool {
+		if records[i].DroppedRowsTotal != records[j].DroppedRowsTotal {
+			return records[i].DroppedRowsTotal > records[j].DroppedRowsTotal
+		}
+		return records[i].MetricName < records[j].MetricName
+	})
+	if limit > 0 && len(records) > limit {
+		records = records[:limit]
+	}
+	result.Records = records
+	return result
+}
+
+// TrackerMetrics holds internal Tracker stats for exposing via storage.Metrics.
+type TrackerMetrics struct {
+	CurrentItemsCount uint64
+	CurrentSizeBytes  uint64
+	MaxSizeBytes      uint64
+}
+
+// UpdateMetrics writes internal metrics to dst.
+//
+// It is safe to call UpdateMetrics on a nil Tracker - dst is left untouched
+// in this case.
+func (t *Tracker) UpdateMetrics(dst *TrackerMetrics) {
+	if t == nil {
+		return
+	}
+	t.mu.RLock()
+	dst.CurrentItemsCount = uint64(len(t.m))
+	t.mu.RUnlock()
+	dst.CurrentSizeBytes = t.currentSizeBytes.Load()
+	dst.MaxSizeBytes = t.maxSizeBytes
+}
diff --git a/lib/storage/droppedseries/tracker_test.go b/lib/storage/droppedseries/tracker_test.go
new file mode 100644
index 0000000..ca102a6
--- /dev/null
+++ b/lib/storage/droppedseries/tracker_test.go
@@ -0,0 +1,159 @@
+package droppedseries
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestTracker_Nil(t *testing.T) {
+	var t2 *Tracker
+
+	// None of these must panic on a nil Tracker.
+	t2.IncrementDroppedRows([]byte("foo"))
+	t2.Reset()
+
+	sr := t2.GetTopRecords(10)
+	if len(sr.Records) != 0 {
+		t.Fatalf("unexpected records for nil Tracker: %v", sr.Records)
+	}
+
+	var tm TrackerMetrics
+	t2.UpdateMetrics(&tm)
+	if tm != (TrackerMetrics{}) {
+		t.Fatalf("unexpected non-zero metrics for nil Tracker: %+v", tm)
+	}
+}
+
+func TestTracker_IncrementAndGetTopRecords(t *testing.T) {
+	tr := NewTracker(1e6)
+
+	tr.IncrementDroppedRows([]byte("foo"))
+	tr.IncrementDroppedRows([]byte("foo"))
+	tr.IncrementDroppedRows([]byte("foo"))
+	tr.IncrementDroppedRows([]byte("bar"))
+	tr.IncrementDroppedRows([]byte("bar"))
+	tr.IncrementDroppedRows([]byte("baz"))
+
+	sr := tr.GetTopRecords(10)
+	want := []Record{
+		{MetricName: "foo", DroppedRowsTotal: 3},
+		{MetricName: "bar", DroppedRowsTotal: 2},
+		{MetricName: "baz", DroppedRowsTotal: 1},
+	}
+	if len(sr.Records) != len(want) {
+		t.Fatalf("unexpected number of records: got %d, want %d; records=%v", len(sr.Records), len(want), sr.Records)
+	}
+	for i, r := range want {
+		if sr.Records[i] != r {
+			t.Fatalf("unexpected record at index %d: got %+v, want %+v", i, sr.Records[i], r)
+		}
+	}
+
+	// Verify the limit is respected.
+	sr = tr.GetTopRecords(2)
+	if len(sr.Records) != 2 {
+		t.Fatalf("unexpected number of records with limit=2: got %d", len(sr.Records))
+	}
+	if sr.Records[0].MetricName != "foo" || sr.Records[1].MetricName != "bar" {
+		t.Fatalf("unexpected top-2 records: %v", sr.Records)
+	}
+
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+	if tm.CurrentItemsCount != 3 {
+		t.Fatalf("unexpected CurrentItemsCount: got %d, want 3", tm.CurrentItemsCount)
+	}
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(1e6)
+	tr.IncrementDroppedRows([]byte("foo"))
+	tr.IncrementDroppedRows([]byte("bar"))
+
+	sr := tr.GetTopRecords(0)
+	if len(sr.Records) != 2 {
+		t.Fatalf("unexpected number of records before reset: %d", len(sr.Records))
+	}
+	firstCollectedSinceTs := sr.CollectedSinceTimestamp
+
+	tr.Reset()
+
+	sr = tr.GetTopRecords(0)
+	if len(sr.Records) != 0 {
+		t.Fatalf("unexpected number of records after reset: %d", len(sr.Records))
+	}
+	if sr.CollectedSinceTimestamp < firstCollectedSinceTs {
+		t.Fatalf("unexpected CollectedSinceTimestamp after reset: got %d, want >= %d", sr.CollectedSinceTimestamp, firstCollectedSinceTs)
+	}
+
+	// Verify that counting resumes properly after reset.
+	tr.IncrementDroppedRows([]byte("foo"))
+	sr = tr.GetTopRecords(0)
+	if len(sr.Records) != 1 || sr.Records[0].DroppedRowsTotal != 1 {
+		t.Fatalf("unexpected records after reset and re-increment: %v", sr.Records)
+	}
+}
+
+func TestTracker_MemoryBoundRespected(t *testing.T) {
+	// Pick a small maxSizeBytes, which is enough for a handful of entries only.
+	const maxSizeBytes = 500
+	tr := NewTracker(maxSizeBytes)
+
+	const numDistinctNames = 10000
+	for i := range numDistinctNames {
+		name := fmt.Sprintf("metric_%d", i)
+		tr.IncrementDroppedRows([]byte(name))
+	}
+
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+	if tm.CurrentSizeBytes > maxSizeBytes+storeOverhead+64 {
+		t.Fatalf("Tracker exceeded its memory bound: currentSizeBytes=%d, maxSizeBytes=%d", tm.CurrentSizeBytes, maxSizeBytes)
+	}
+	if tm.CurrentItemsCount >= numDistinctNames {
+		t.Fatalf("expected the Tracker to stop tracking new metric names once full, but tracked all %d of them", tm.CurrentItemsCount)
+	}
+	if tm.CurrentItemsCount == 0 {
+		t.Fatalf("expected the Tracker to track at least some metric names before becoming full")
+	}
+
+	sr := tr.GetTopRecords(0)
+	if uint64(len(sr.Records)) != tm.CurrentItemsCount {
+		t.Fatalf("unexpected number of records: got %d, want %d", len(sr.Records), tm.CurrentItemsCount)
+	}
+}
+
+func TestTracker_ConcurrentIncrement(t *testing.T) {
+	tr := NewTracker(1e7)
+
+	const goroutines = 10
+	const incrementsPerGoroutine = 1000
+	const numNames = 5
+
+	var wg sync.WaitGroup
+	for range goroutines {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := range incrementsPerGoroutine {
+				name := fmt.Sprintf("metric_%d", i%numNames)
+				tr.IncrementDroppedRows([]byte(name))
+			}
+		}()
+	}
+	wg.Wait()
+
+	sr := tr.GetTopRecords(0)
+	if len(sr.Records) != numNames {
+		t.Fatalf("unexpected number of records: got %d, want %d", len(sr.Records), numNames)
+	}
+	var total uint64
+	for _, r := range sr.Records {
+		total += r.DroppedRowsTotal
+	}
+	want := uint64(goroutines * incrementsPerGoroutine)
+	if total != want {
+		t.Fatalf("unexpected total dropped rows: got %d, want %d", total, want)
+	}
+}
