diff --git a/lib/storage/droppedseries/tracker.go b/lib/storage/droppedseries/tracker.go
new file mode 100644
index 0000000..e552d4b
--- /dev/null
+++ b/lib/storage/droppedseries/tracker.go
@@ -0,0 +1,229 @@
+// Package droppedseries tracks, per metric name, how many samples were
+// dropped because adding the corresponding series would have exceeded the
+// configured -storage.maxHourlySeries or -storage.maxDailySeries limit.
+//
+// This is meant to help answer "which metric names are hitting my series
+// limit" support questions without requiring access to the customer's own
+// instrumentation.
+package droppedseries
+
+import (
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/bytesutil"
+)
+
+const (
+	// nameBufSize is the size of the batch allocation buffer used for cloning tracked metric names.
+	nameBufSize = 16 * 1024
+	// itemBufSize is the size of the batch allocation buffer used for tracked items.
+	itemBufSize = 1024
+	// storeOverhead is an approximate per-entry overhead of the map bucket, the string header and the item pointer.
+	storeOverhead = 24 + 16 + 24
+)
+
+// Tracker keeps track, per metric name, of how many samples were dropped
+// because adding the corresponding series would have exceeded the configured
+// hourly or daily series limit.
+//
+// The memory used by Tracker is bounded by maxSizeBytes passed to NewTracker.
+// Once that bound is reached, counters for already-tracked names keep
+// growing, but samples dropped for previously unseen metric names are no
+// longer recorded until Reset is called.
+//
+// A nil *Tracker is valid, and all of its methods are no-ops. This allows
+// the tracking to be fully disabled with no measurable overhead on the
+// ingestion hot path.
+type Tracker struct {
+	maxSizeBytes uint64
+
+	currentSizeBytes  atomic.Uint64
+	currentItemsCount atomic.Uint64
+
+	// mu protects store, itemBuf and nameBuf below.
+	mu    sync.RWMutex
+	store map[string]*item
+
+	// itemBuf and nameBuf hold batch allocations for items and metric names in store.
+	// This reduces the number of allocations and GC pressure compared to allocating
+	// a new item and copying the name on every newly tracked metric name.
+	itemBuf []item
+	nameBuf []byte
+}
+
+type item struct {
+	hourlyDropped atomic.Uint64
+	dailyDropped  atomic.Uint64
+}
+
+// NewTracker creates a Tracker whose memory usage is bounded by maxSizeBytes.
+func NewTracker(maxSizeBytes uint64) *Tracker {
+	return &Tracker{
+		maxSizeBytes: maxSizeBytes,
+		store:        make(map[string]*item),
+	}
+}
+
+// RegisterHourlyDrop registers a single sample drop for metricName caused by -storage.maxHourlySeries.
+//
+// metricName isn't referenced after this call returns.
+func (t *Tracker) RegisterHourlyDrop(metricName []byte) {
+	if t == nil {
+		return
+	}
+	if it := t.getOrCreate(metricName); it != nil {
+		it.hourlyDropped.Add(1)
+	}
+}
+
+// RegisterDailyDrop registers a single sample drop for metricName caused by -storage.maxDailySeries.
+//
+// metricName isn't referenced after this call returns.
+func (t *Tracker) RegisterDailyDrop(metricName []byte) {
+	if t == nil {
+		return
+	}
+	if it := t.getOrCreate(metricName); it != nil {
+		it.dailyDropped.Add(1)
+	}
+}
+
+func (t *Tracker) getOrCreate(metricName []byte) *item {
+	t.mu.RLock()
+	it := t.store[string(metricName)]
+	t.mu.RUnlock()
+	if it != nil {
+		return it
+	}
+	if t.cacheIsFull() {
+		return nil
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	// The entry could have been created concurrently, or the cache could have become full
+	// while waiting for the lock - re-check both under the write lock.
+	if it := t.store[string(metricName)]; it != nil {
+		return it
+	}
+	if t.cacheIsFull() {
+		return nil
+	}
+	it = t.nextItemLocked()
+	name := t.cloneNameLocked(metricName)
+	t.store[name] = it
+	t.currentSizeBytes.Add(uint64(len(name)) + storeOverhead)
+	t.currentItemsCount.Add(1)
+	return it
+}
+
+func (t *Tracker) cacheIsFull() bool {
+	return t.currentSizeBytes.Load() > t.maxSizeBytes
+}
+
+func (t *Tracker) nextItemLocked() *item {
+	n := len(t.itemBuf) + 1
+	if n > cap(t.itemBuf) {
+		// Allocate a new slice instead of reallocating the existing one -
+		// this saves memory and reduces GC pressure.
+		t.itemBuf = make([]item, 0, itemBufSize)
+		n = 1
+	}
+	t.itemBuf = t.itemBuf[:n]
+	return &t.itemBuf[n-1]
+}
+
+// cloneNameLocked uses the same idea as strings.Clone, but instead of a
+// direct []byte allocation for every cloned name, it batch-allocates nameBuf
+// and returns a subslice of it.
+func (t *Tracker) cloneNameLocked(name []byte) string {
+	if len(name) > nameBufSize {
+		b := make([]byte, len(name))
+		copy(b, name)
+		return bytesutil.ToUnsafeString(b)
+	}
+	idx := len(t.nameBuf)
+	n := len(name) + len(t.nameBuf)
+	if n > cap(t.nameBuf) {
+		t.nameBuf = make([]byte, 0, nameBufSize)
+		idx = 0
+	}
+	t.nameBuf = append(t.nameBuf, name...)
+	return bytesutil.ToUnsafeString(t.nameBuf[idx:])
+}
+
+// Record is a single per-metric-name entry returned by GetTopRecords.
+type Record struct {
+	MetricName    string
+	HourlyDropped uint64
+	DailyDropped  uint64
+}
+
+// TotalDropped returns the total number of samples dropped for r.MetricName.
+func (r Record) TotalDropped() uint64 {
+	return r.HourlyDropped + r.DailyDropped
+}
+
+// GetTopRecords returns up to limit tracked records sorted by descending total dropped-sample count.
+//
+// A non-positive limit returns all tracked records.
+func (t *Tracker) GetTopRecords(limit int) []Record {
+	if t == nil {
+		return nil
+	}
+	t.mu.RLock()
+	records := make([]Record, 0, len(t.store))
+	for name, it := range t.store {
+		records = append(records, Record{
+			MetricName:    name,
+			HourlyDropped: it.hourlyDropped.Load(),
+			DailyDropped:  it.dailyDropped.Load(),
+		})
+	}
+	t.mu.RUnlock()
+
+	sort.Slice(records, func(i, j int) bool {
+		ti, tj := records[i].TotalDropped(), records[j].TotalDropped()
+		if ti == tj {
+			return records[i].MetricName < records[j].MetricName
+		}
+		return ti > tj
+	})
+	if limit > 0 && limit < len(records) {
+		records = records[:limit]
+	}
+	return records
+}
+
+// Reset drops all the tracked data.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.store = make(map[string]*item)
+	t.itemBuf = nil
+	t.nameBuf = nil
+	t.mu.Unlock()
+	t.currentSizeBytes.Store(0)
+	t.currentItemsCount.Store(0)
+}
+
+// TrackerMetrics holds internal metrics of the Tracker to report.
+type TrackerMetrics struct {
+	CurrentSizeBytes  uint64
+	CurrentItemsCount uint64
+	MaxSizeBytes      uint64
+}
+
+// UpdateMetrics writes internal metrics to dst.
+func (t *Tracker) UpdateMetrics(dst *TrackerMetrics) {
+	if t == nil {
+		return
+	}
+	dst.CurrentSizeBytes = t.currentSizeBytes.Load()
+	dst.CurrentItemsCount = t.currentItemsCount.Load()
+	dst.MaxSizeBytes = t.maxSizeBytes
+}
diff --git a/lib/storage/droppedseries/tracker_test.go b/lib/storage/droppedseries/tracker_test.go
new file mode 100644
index 0000000..5a0deba
--- /dev/null
+++ b/lib/storage/droppedseries/tracker_test.go
@@ -0,0 +1,188 @@
+package droppedseries
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestTracker_RegisterDrop_MultipleMetricNames(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	tr.RegisterHourlyDrop([]byte("metric_a"))
+	tr.RegisterHourlyDrop([]byte("metric_a"))
+	tr.RegisterHourlyDrop([]byte("metric_b"))
+	tr.RegisterDailyDrop([]byte("metric_b"))
+	tr.RegisterDailyDrop([]byte("metric_c"))
+
+	records := tr.GetTopRecords(0)
+	got := make(map[string]Record, len(records))
+	for _, r := range records {
+		got[r.MetricName] = r
+	}
+
+	if len(got) != 3 {
+		t.Fatalf("unexpected number of tracked metric names: got %d, want 3; records=%+v", len(got), records)
+	}
+	if r := got["metric_a"]; r.HourlyDropped != 2 || r.DailyDropped != 0 {
+		t.Fatalf("unexpected counts for metric_a: %+v", r)
+	}
+	if r := got["metric_b"]; r.HourlyDropped != 1 || r.DailyDropped != 1 {
+		t.Fatalf("unexpected counts for metric_b: %+v", r)
+	}
+	if r := got["metric_c"]; r.HourlyDropped != 0 || r.DailyDropped != 1 {
+		t.Fatalf("unexpected counts for metric_c: %+v", r)
+	}
+}
+
+func TestTracker_RegisterDrop_Concurrent(t *testing.T) {
+	tr := NewTracker(4 * 1024 * 1024)
+
+	const goroutines = 10
+	const dropsPerName = 50
+	const names = 20
+
+	var wg sync.WaitGroup
+	for g := 0; g < goroutines; g++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < dropsPerName; i++ {
+				for n := 0; n < names; n++ {
+					name := fmt.Sprintf("metric_%d", n)
+					tr.RegisterHourlyDrop([]byte(name))
+				}
+			}
+		}()
+	}
+	wg.Wait()
+
+	records := tr.GetTopRecords(0)
+	if len(records) != names {
+		t.Fatalf("unexpected number of tracked metric names: got %d, want %d", len(records), names)
+	}
+	want := uint64(goroutines * dropsPerName)
+	for _, r := range records {
+		if r.HourlyDropped != want {
+			t.Fatalf("unexpected HourlyDropped for %s: got %d, want %d", r.MetricName, r.HourlyDropped, want)
+		}
+	}
+}
+
+func TestTracker_GetTopRecords(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	counts := map[string]int{
+		"metric_low":    1,
+		"metric_high":   10,
+		"metric_medium": 5,
+	}
+	for name, n := range counts {
+		for i := 0; i < n; i++ {
+			tr.RegisterHourlyDrop([]byte(name))
+		}
+	}
+
+	top := tr.GetTopRecords(2)
+	if len(top) != 2 {
+		t.Fatalf("unexpected number of top records: got %d, want 2", len(top))
+	}
+	if top[0].MetricName != "metric_high" || top[0].TotalDropped() != 10 {
+		t.Fatalf("unexpected top[0]: %+v", top[0])
+	}
+	if top[1].MetricName != "metric_medium" || top[1].TotalDropped() != 5 {
+		t.Fatalf("unexpected top[1]: %+v", top[1])
+	}
+
+	all := tr.GetTopRecords(0)
+	if len(all) != 3 {
+		t.Fatalf("unexpected number of records with limit=0: got %d, want 3", len(all))
+	}
+}
+
+func TestTracker_MemoryBoundIsRespected(t *testing.T) {
+	// Pick a maxSizeBytes that only fits a handful of entries.
+	const maxSizeBytes = 500
+	tr := NewTracker(maxSizeBytes)
+
+	const namesTried = 1000
+	for i := 0; i < namesTried; i++ {
+		name := fmt.Sprintf("metric_%d", i)
+		tr.RegisterHourlyDrop([]byte(name))
+	}
+
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+
+	if tm.CurrentSizeBytes > maxSizeBytes+storeOverhead+32 {
+		t.Fatalf("tracked size exceeds the configured bound: got %d bytes, want <= ~%d bytes", tm.CurrentSizeBytes, maxSizeBytes)
+	}
+	if tm.CurrentItemsCount >= namesTried {
+		t.Fatalf("expected the tracker to stop accepting new names once full, but tracked %d out of %d", tm.CurrentItemsCount, namesTried)
+	}
+	if tm.CurrentItemsCount == 0 {
+		t.Fatalf("expected at least some names to be tracked before the cache became full")
+	}
+
+	records := tr.GetTopRecords(0)
+	if uint64(len(records)) != tm.CurrentItemsCount {
+		t.Fatalf("unexpected number of records: got %d, want %d", len(records), tm.CurrentItemsCount)
+	}
+
+	// Once the cache is full, drops for already-tracked names must keep incrementing,
+	// while newly seen names beyond the bound must be silently dropped without growing memory further.
+	firstName := records[0].MetricName
+	tr.RegisterHourlyDrop([]byte(firstName))
+
+	var tm2 TrackerMetrics
+	tr.UpdateMetrics(&tm2)
+	if tm2.CurrentItemsCount != tm.CurrentItemsCount {
+		t.Fatalf("CurrentItemsCount must not grow once the cache is full: got %d, want %d", tm2.CurrentItemsCount, tm.CurrentItemsCount)
+	}
+
+	updated := tr.GetTopRecords(0)
+	for _, r := range updated {
+		if r.MetricName == firstName {
+			want := records[0].HourlyDropped + 1
+			if r.HourlyDropped != want {
+				t.Fatalf("unexpected HourlyDropped for already-tracked name %s: got %d, want %d", firstName, r.HourlyDropped, want)
+			}
+		}
+	}
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+	tr.RegisterHourlyDrop([]byte("metric_a"))
+	tr.RegisterDailyDrop([]byte("metric_b"))
+
+	tr.Reset()
+
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+	if tm.CurrentItemsCount != 0 || tm.CurrentSizeBytes != 0 {
+		t.Fatalf("unexpected metrics after Reset: %+v", tm)
+	}
+	if records := tr.GetTopRecords(0); len(records) != 0 {
+		t.Fatalf("unexpected records after Reset: %+v", records)
+	}
+}
+
+func TestTracker_NilTrackerIsNoOp(t *testing.T) {
+	var tr *Tracker
+
+	// None of these must panic.
+	tr.RegisterHourlyDrop([]byte("metric_a"))
+	tr.RegisterDailyDrop([]byte("metric_a"))
+	tr.Reset()
+
+	if records := tr.GetTopRecords(10); records != nil {
+		t.Fatalf("unexpected records for nil tracker: %+v", records)
+	}
+
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+	if tm != (TrackerMetrics{}) {
+		t.Fatalf("unexpected metrics for nil tracker: %+v", tm)
+	}
+}
