+func TestStorageDroppedSeriesByNameStats(t *testing.T) {
+	defer testRemoveAll(t)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	const numRows = 1000
+	const maxHourlySeries = 500
+	mrs := testGenerateMetricRows(rng, numRows, minTimestamp, maxTimestamp)
+
+	opts := OpenOptions{
+		MaxHourlySeries:          maxHourlySeries,
+		TrackDroppedSeriesByName: true,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped == 0 {
+		t.Fatalf("expected some rows to be dropped due to the hourly series limit")
+	}
+
+	records := s.GetDroppedSeriesByNameStats(0)
+	if len(records) == 0 {
+		t.Fatalf("expected some per-metric-name drop stats to be recorded")
+	}
+
+	var totalDropped uint64
+	seen := make(map[string]bool)
+	for _, r := range records {
+		if seen[r.MetricName] {
+			t.Fatalf("duplicate metric name in stats: %s", r.MetricName)
+		}
+		seen[r.MetricName] = true
+		if !strings.HasPrefix(r.MetricName, "metric_") {
+			t.Fatalf("unexpected metric name in stats: %s", r.MetricName)
+		}
+		totalDropped += r.HourlyDropped + r.DailyDropped
+	}
+	if totalDropped != m.HourlySeriesLimitRowsDropped {
+		t.Fatalf("unexpected total dropped count in per-name stats: got %d, want %d", totalDropped, m.HourlySeriesLimitRowsDropped)
+	}
+
+	// GetDroppedSeriesByNameStats(limit) must limit the number of returned records.
+	if limited := s.GetDroppedSeriesByNameStats(1); len(limited) != 1 {
+		t.Fatalf("unexpected number of limited records: got %d, want 1", len(limited))
+	}
+
+	s.ResetDroppedSeriesByNameStats()
+	if records := s.GetDroppedSeriesByNameStats(0); len(records) != 0 {
+		t.Fatalf("expected no records after reset, got %d", len(records))
+	}
+}
