+func TestStorageSeriesLimiterDropStats(t *testing.T) {
+	defer testRemoveAll(t)
+
+	// makeRows builds numSeries distinct series (distinguished by the `instance`
+	// tag) sharing the given metric name.
+	makeRows := func(metricName string, numSeries int, tr TimeRange) []MetricRow {
+		var mrs []MetricRow
+		var mn MetricName
+		mn.MetricGroup = []byte(metricName)
+		for i := range numSeries {
+			mn.Tags = []Tag{
+				{[]byte("instance"), fmt.Appendf(nil, "instance_%d", i)},
+			}
+			mr := MetricRow{
+				MetricNameRaw: mn.marshalRaw(nil),
+				Timestamp:     tr.MinTimestamp,
+				Value:         float64(i),
+			}
+			mrs = append(mrs, mr)
+		}
+		return mrs
+	}
+
+	t.Run("TrackingEnabled", func(t *testing.T) {
+		s := MustOpenStorage(t.Name(), OpenOptions{
+			MaxHourlySeries:             1,
+			TrackSeriesLimiterDropStats: true,
+		})
+		defer s.MustClose()
+
+		minTimestamp := time.Now().UnixMilli()
+		tr := TimeRange{MinTimestamp: minTimestamp, MaxTimestamp: minTimestamp + 1000}
+
+		// The very first series admitted by the limiter isn't dropped. All
+		// the subsequent distinct series are dropped, since maxHourlySeries=1.
+		var mrs []MetricRow
+		mrs = append(mrs, makeRows("metric_a", 4, tr)...) // 1 admitted, 3 dropped
+		mrs = append(mrs, makeRows("metric_b", 2, tr)...) // 2 dropped
+		mrs = append(mrs, makeRows("metric_c", 1, tr)...) // 1 dropped
+		s.AddRows(mrs, defaultPrecisionBits)
+		s.DebugFlush()
+
+		var m Metrics
+		s.UpdateMetrics(&m)
+		if got, want := m.HourlySeriesLimitRowsDropped, uint64(6); got != want {
+			t.Fatalf("unexpected HourlySeriesLimitRowsDropped: got %d, want %d", got, want)
+		}
+
+		stats := s.GetSeriesLimiterDropStats(0)
+		if stats.CollectedSinceTs == 0 {
+			t.Fatalf("expected non-zero CollectedSinceTs")
+		}
+		want := map[string]uint64{
+			"metric_a": 3,
+			"metric_b": 2,
+			"metric_c": 1,
+		}
+		if len(stats.Entries) != len(want) {
+			t.Fatalf("unexpected number of entries; got %+v; want %d entries matching %v", stats.Entries, len(want), want)
+		}
+		for _, e := range stats.Entries {
+			if got, want := e.DroppedRowsCount, want[e.MetricName]; got != want {
+				t.Fatalf("unexpected DroppedRowsCount for %q: got %d, want %d", e.MetricName, got, want)
+			}
+		}
+		// Verify entries are sorted by DroppedRowsCount in descending order.
+		for i := 1; i < len(stats.Entries); i++ {
+			if stats.Entries[i-1].DroppedRowsCount < stats.Entries[i].DroppedRowsCount {
+				t.Fatalf("entries aren't sorted in descending order: %+v", stats.Entries)
+			}
+		}
+
+		// Verify topN limiting returns only the biggest offenders.
+		top1 := s.GetSeriesLimiterDropStats(1)
+		if len(top1.Entries) != 1 || top1.Entries[0].MetricName != "metric_a" {
+			t.Fatalf("unexpected top1 result: %+v", top1.Entries)
+		}
+
+		// Verify Reset clears the collected stats.
+		s.ResetSeriesLimiterDropStats()
+		stats = s.GetSeriesLimiterDropStats(0)
+		if len(stats.Entries) != 0 {
+			t.Fatalf("expected no entries after reset; got %+v", stats.Entries)
+		}
+	})
+
+	t.Run("TrackingDisabled", func(t *testing.T) {
+		// TrackSeriesLimiterDropStats isn't set, so it defaults to false: the
+		// feature must not collect any per-metric-name stats even though
+		// samples are still being dropped because of the series limit.
+		s := MustOpenStorage(t.Name(), OpenOptions{
+			MaxHourlySeries: 1,
+		})
+		defer s.MustClose()
+
+		minTimestamp := time.Now().UnixMilli()
+		tr := TimeRange{MinTimestamp: minTimestamp, MaxTimestamp: minTimestamp + 1000}
+		mrs := makeRows("metric_a", 5, tr)
+		s.AddRows(mrs, defaultPrecisionBits)
+		s.DebugFlush()
+
+		var m Metrics
+		s.UpdateMetrics(&m)
+		if m.HourlySeriesLimitRowsDropped == 0 {
+			t.Fatalf("expected some rows to be dropped because of the series limit")
+		}
+
+		stats := s.GetSeriesLimiterDropStats(0)
+		if len(stats.Entries) != 0 {
+			t.Fatalf("expected no tracked entries when tracking is disabled; got %+v", stats.Entries)
+		}
+	})
+}
