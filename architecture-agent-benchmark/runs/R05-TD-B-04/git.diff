diff --git a/lib/storage/seriesdropstats/tracker.go b/lib/storage/seriesdropstats/tracker.go
new file mode 100644
index 0000000..95b5a44
--- /dev/null
+++ b/lib/storage/seriesdropstats/tracker.go
@@ -0,0 +1,204 @@
+// Package seriesdropstats tracks, per metric name, how many samples were
+// dropped because adding the corresponding series would have exceeded the
+// configured -storage.maxHourlySeries or -storage.maxDailySeries limit.
+//
+// The tracker is memory-bounded: once its configured size limit is reached,
+// counters for already-tracked metric names keep being updated, but samples
+// belonging to previously unseen metric names are no longer accounted for.
+// This guarantees the tracker cannot grow without bound even when an
+// installation has millions of distinct offending metric names.
+package seriesdropstats
+
+import (
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/bytesutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+const (
+	// metricNameBufSize is the size of the batch allocation used for cloning
+	// tracked metric names. See cloneMetricNameLocked.
+	metricNameBufSize = 16 * 1024
+
+	// entryOverheadBytes is a rough estimate of the memory overhead of a single
+	// tracked entry: the map bucket itself, the *atomic.Uint64 counter and its
+	// pointed-to value, and the string header referencing the cloned name.
+	entryOverheadBytes = 64
+)
+
+// Tracker tracks per-metric-name counts of samples dropped due to hitting
+// -storage.maxHourlySeries or -storage.maxDailySeries.
+//
+// It is safe to use a Tracker from concurrent goroutines. A nil *Tracker is
+// valid - all of its methods are no-ops in that case, which allows disabling
+// the feature with negligible overhead on the ingestion path.
+type Tracker struct {
+	maxSizeBytes uint64
+
+	creationTs       atomic.Uint64
+	currentSizeBytes atomic.Uint64
+
+	mu sync.RWMutex
+	m  map[string]*atomic.Uint64
+	// metricNamesBuf holds batch allocations for the metric name keys stored in m.
+	metricNamesBuf []byte
+
+	// getCurrentTs is overridden in tests for deterministic timestamps.
+	getCurrentTs func() uint64
+}
+
+// NewTracker creates a Tracker bounded by approximately maxSizeBytes of memory.
+func NewTracker(maxSizeBytes uint64) *Tracker {
+	t := &Tracker{
+		maxSizeBytes: maxSizeBytes,
+		getCurrentTs: fasttime.UnixTimestamp,
+	}
+	t.resetLocked()
+	return t
+}
+
+func (t *Tracker) resetLocked() {
+	t.m = make(map[string]*atomic.Uint64)
+	t.metricNamesBuf = make([]byte, 0, metricNameBufSize)
+	t.currentSizeBytes.Store(0)
+	t.creationTs.Store(t.getCurrentTs())
+}
+
+// IncrementFor increments the drop counter for the given metricName by 1.
+//
+// Once the Tracker's configured memory bound is reached, samples for
+// previously untracked metric names are silently ignored, while counters for
+// already-tracked names keep being incremented.
+func (t *Tracker) IncrementFor(metricName []byte) {
+	if t == nil {
+		return
+	}
+
+	t.mu.RLock()
+	cnt, ok := t.m[bytesutil.ToUnsafeString(metricName)]
+	t.mu.RUnlock()
+	if ok {
+		cnt.Add(1)
+		return
+	}
+
+	if t.currentSizeBytes.Load() >= t.maxSizeBytes {
+		// The tracker is full - do not track new metric names in order
+		// to keep memory usage bounded.
+		return
+	}
+
+	t.mu.Lock()
+	cnt, ok = t.m[bytesutil.ToUnsafeString(metricName)]
+	if !ok {
+		cnt = &atomic.Uint64{}
+		t.m[t.cloneMetricNameLocked(metricName)] = cnt
+		t.currentSizeBytes.Add(uint64(len(metricName)) + entryOverheadBytes)
+	}
+	t.mu.Unlock()
+
+	cnt.Add(1)
+}
+
+// cloneMetricNameLocked clones metricName into a batch-allocated buffer in
+// order to reduce the number of heap allocations and GC pressure. It must be
+// called with t.mu held.
+func (t *Tracker) cloneMetricNameLocked(metricName []byte) string {
+	if len(metricName) > metricNameBufSize {
+		b := make([]byte, len(metricName))
+		copy(b, metricName)
+		return bytesutil.ToUnsafeString(b)
+	}
+	idx := len(t.metricNamesBuf)
+	n := len(metricName) + len(t.metricNamesBuf)
+	if n > cap(t.metricNamesBuf) {
+		t.metricNamesBuf = make([]byte, 0, metricNameBufSize)
+		idx = 0
+	}
+	t.metricNamesBuf = append(t.metricNamesBuf, metricName...)
+	return bytesutil.ToUnsafeString(t.metricNamesBuf[idx:])
+}
+
+// Entry is a single metric name and its associated dropped samples count.
+type Entry struct {
+	MetricName       string
+	DroppedRowsCount uint64
+}
+
+// Stats is the result of Tracker.GetTop.
+type Stats struct {
+	// CollectedSinceTs is the unix timestamp in seconds since which the stats
+	// have been collected, i.e. since the tracker was created or last Reset.
+	CollectedSinceTs uint64
+
+	// Entries contains up to the requested number of top offenders, sorted by
+	// DroppedRowsCount in descending order.
+	Entries []Entry
+}
+
+// GetTop returns a Stats containing up to topN metric names with the highest
+// dropped samples count, sorted in descending order of DroppedRowsCount.
+//
+// If topN <= 0, all tracked entries are returned.
+func (t *Tracker) GetTop(topN int) Stats {
+	if t == nil {
+		return Stats{}
+	}
+
+	t.mu.RLock()
+	entries := make([]Entry, 0, len(t.m))
+	for name, cnt := range t.m {
+		entries = append(entries, Entry{
+			MetricName:       name,
+			DroppedRowsCount: cnt.Load(),
+		})
+	}
+	t.mu.RUnlock()
+
+	sort.Slice(entries, func(i, j int) bool {
+		if entries[i].DroppedRowsCount != entries[j].DroppedRowsCount {
+			return entries[i].DroppedRowsCount > entries[j].DroppedRowsCount
+		}
+		return entries[i].MetricName < entries[j].MetricName
+	})
+	if topN > 0 && len(entries) > topN {
+		entries = entries[:topN]
+	}
+
+	return Stats{
+		CollectedSinceTs: t.creationTs.Load(),
+		Entries:          entries,
+	}
+}
+
+// Reset drops all the collected stats and starts collecting them anew.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.resetLocked()
+	t.mu.Unlock()
+}
+
+// TrackerMetrics holds Tracker metrics to report.
+type TrackerMetrics struct {
+	CurrentItemsCount uint64
+	CurrentSizeBytes  uint64
+	MaxSizeBytes      uint64
+}
+
+// UpdateMetrics writes internal metrics of t to dst.
+func (t *Tracker) UpdateMetrics(dst *TrackerMetrics) {
+	if t == nil {
+		return
+	}
+	t.mu.RLock()
+	dst.CurrentItemsCount += uint64(len(t.m))
+	t.mu.RUnlock()
+	dst.CurrentSizeBytes += t.currentSizeBytes.Load()
+	dst.MaxSizeBytes += t.maxSizeBytes
+}
diff --git a/lib/storage/seriesdropstats/tracker_test.go b/lib/storage/seriesdropstats/tracker_test.go
new file mode 100644
index 0000000..c6215b0
--- /dev/null
+++ b/lib/storage/seriesdropstats/tracker_test.go
@@ -0,0 +1,167 @@
+package seriesdropstats
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestTracker_IncrementAndGetTop(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	counts := map[string]int{
+		"metric_a": 5,
+		"metric_b": 10,
+		"metric_c": 1,
+		"metric_d": 7,
+	}
+	for name, n := range counts {
+		for i := 0; i < n; i++ {
+			tr.IncrementFor([]byte(name))
+		}
+	}
+
+	stats := tr.GetTop(0)
+	if len(stats.Entries) != len(counts) {
+		t.Fatalf("unexpected number of entries; got %d; want %d", len(stats.Entries), len(counts))
+	}
+	for _, e := range stats.Entries {
+		want, ok := counts[e.MetricName]
+		if !ok {
+			t.Fatalf("unexpected metric name in result: %q", e.MetricName)
+		}
+		if uint64(want) != e.DroppedRowsCount {
+			t.Fatalf("unexpected count for %q; got %d; want %d", e.MetricName, e.DroppedRowsCount, want)
+		}
+	}
+
+	// Verify results are sorted in descending order of DroppedRowsCount.
+	for i := 1; i < len(stats.Entries); i++ {
+		if stats.Entries[i-1].DroppedRowsCount < stats.Entries[i].DroppedRowsCount {
+			t.Fatalf("entries aren't sorted in descending order: %+v", stats.Entries)
+		}
+	}
+
+	// Verify topN limiting returns the biggest offenders.
+	top2 := tr.GetTop(2)
+	if len(top2.Entries) != 2 {
+		t.Fatalf("unexpected number of entries for topN=2; got %d", len(top2.Entries))
+	}
+	if top2.Entries[0].MetricName != "metric_b" || top2.Entries[1].MetricName != "metric_d" {
+		t.Fatalf("unexpected top2 entries: %+v", top2.Entries)
+	}
+}
+
+func TestTracker_IncrementForConcurrent(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	const goroutines = 10
+	const incrementsPerName = 100
+	names := []string{"foo", "bar", "baz"}
+
+	var wg sync.WaitGroup
+	for i := 0; i < goroutines; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for _, name := range names {
+				for j := 0; j < incrementsPerName; j++ {
+					tr.IncrementFor([]byte(name))
+				}
+			}
+		}()
+	}
+	wg.Wait()
+
+	stats := tr.GetTop(0)
+	if len(stats.Entries) != len(names) {
+		t.Fatalf("unexpected number of tracked names; got %d; want %d", len(stats.Entries), len(names))
+	}
+	want := uint64(goroutines * incrementsPerName)
+	for _, e := range stats.Entries {
+		if e.DroppedRowsCount != want {
+			t.Fatalf("unexpected count for %q; got %d; want %d", e.MetricName, e.DroppedRowsCount, want)
+		}
+	}
+}
+
+func TestTracker_MemoryBoundIsRespected(t *testing.T) {
+	// Choose a small size bound that fits only a handful of entries.
+	const maxSizeBytes = 300
+	tr := NewTracker(maxSizeBytes)
+
+	// Register a metric name before the bound is reached, and keep it incrementing
+	// afterwards to verify already-tracked names aren't dropped once the tracker is full.
+	tr.IncrementFor([]byte("first_metric"))
+
+	const totalNames = 1000
+	for i := 0; i < totalNames; i++ {
+		tr.IncrementFor([]byte(fmt.Sprintf("some_metric_name_%d", i)))
+	}
+
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+	if tm.CurrentSizeBytes > maxSizeBytes+entryOverheadBytes+64 {
+		// Allow a small slack for the entry that pushed the tracker over the bound
+		// as well as for the length of a single metric name.
+		t.Fatalf("tracker exceeded its memory bound: currentSizeBytes=%d, maxSizeBytes=%d", tm.CurrentSizeBytes, maxSizeBytes)
+	}
+	if tm.CurrentItemsCount == 0 {
+		t.Fatalf("expected at least one entry to be tracked")
+	}
+	if tm.CurrentItemsCount >= totalNames {
+		t.Fatalf("expected the tracker to stop accepting new metric names once full; got %d tracked items out of %d attempted",
+			tm.CurrentItemsCount, totalNames)
+	}
+
+	// The first metric, tracked before the bound was hit, must keep incrementing.
+	for i := 0; i < 5; i++ {
+		tr.IncrementFor([]byte("first_metric"))
+	}
+	stats := tr.GetTop(0)
+	found := false
+	for _, e := range stats.Entries {
+		if e.MetricName == "first_metric" {
+			found = true
+			if e.DroppedRowsCount != 6 {
+				t.Fatalf("unexpected count for first_metric; got %d; want 6", e.DroppedRowsCount)
+			}
+		}
+	}
+	if !found {
+		t.Fatalf("expected first_metric to remain tracked")
+	}
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+	tr.IncrementFor([]byte("metric_a"))
+	tr.IncrementFor([]byte("metric_b"))
+
+	firstTs := tr.GetTop(0).CollectedSinceTs
+
+	tr.Reset()
+
+	stats := tr.GetTop(0)
+	if len(stats.Entries) != 0 {
+		t.Fatalf("expected no entries after reset; got %+v", stats.Entries)
+	}
+	if stats.CollectedSinceTs < firstTs {
+		t.Fatalf("expected CollectedSinceTs to be reset to a value >= previous one")
+	}
+}
+
+func TestTracker_NilIsSafe(t *testing.T) {
+	var tr *Tracker
+	tr.IncrementFor([]byte("foo"))
+	tr.Reset()
+	stats := tr.GetTop(10)
+	if len(stats.Entries) != 0 {
+		t.Fatalf("expected empty stats from nil tracker")
+	}
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+	if tm.CurrentItemsCount != 0 || tm.CurrentSizeBytes != 0 || tm.MaxSizeBytes != 0 {
+		t.Fatalf("expected zero metrics from nil tracker")
+	}
+}
