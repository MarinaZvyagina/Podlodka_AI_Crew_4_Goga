+// getMetricGroupFromRaw extracts metric name (aka MetricGroup) from metricNameRaw
+// encoded with MarshalMetricNameRaw, without unmarshaling the whole label set.
+//
+// The returned slice references src and is valid only as long as src isn't reused.
+func getMetricGroupFromRaw(src []byte) ([]byte, error) {
+	for len(src) > 0 {
+		tail, key, err := unmarshalBytesFast(src)
+		if err != nil {
+			return nil, fmt.Errorf("cannot decode key: %w", err)
+		}
+		src = tail
+
+		tail, value, err := unmarshalBytesFast(src)
+		if err != nil {
+			return nil, fmt.Errorf("cannot decode value: %w", err)
+		}
+		src = tail
+
+		if len(key) == 0 {
+			return value, nil
+		}
+	}
+	return nil, nil
+}
