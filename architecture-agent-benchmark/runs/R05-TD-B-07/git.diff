+// GetSeriesLimitExceededStats returns up to topN metric names with the highest number of
+// samples dropped because of -storage.maxHourlySeries or -storage.maxDailySeries, collected
+// since the last call to ResetSeriesLimitExceededStats (or storage startup). If topN <= 0,
+// all tracked entries are returned.
+func (s *Storage) GetSeriesLimitExceededStats(topN int) SeriesLimitExceededStats {
+	return s.seriesLimitExceededTracker.GetTop(topN)
+}
