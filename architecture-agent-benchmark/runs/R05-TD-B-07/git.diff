+// testGenSeriesLimitExceededRows creates numSeries distinct series - unique per "instance"
+// tag value - which all share the given metric name.
+func testGenSeriesLimitExceededRows(metricName string, numSeries int, tr TimeRange) []MetricRow {
+	var mrs []MetricRow
+	for i := range numSeries {
+		var mn MetricName
+		mn.MetricGroup = []byte(metricName)
+		mn.Tags = []Tag{
+			{[]byte("instance"), fmt.Appendf(nil, "instance_%d", i)},
+		}
+		mrs = append(mrs, MetricRow{
+			MetricNameRaw: mn.marshalRaw(nil),
+			Timestamp:     tr.MinTimestamp,
+			Value:         float64(i),
+		})
+	}
+	return mrs
+}
