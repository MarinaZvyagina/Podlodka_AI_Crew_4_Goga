diff --git a/lib/storage/series_limit_exceeded_tracker.go b/lib/storage/series_limit_exceeded_tracker.go
new file mode 100644
index 0000000..4840c0e
--- /dev/null
+++ b/lib/storage/series_limit_exceeded_tracker.go
@@ -0,0 +1,140 @@
+package storage
+
+import (
+	"sort"
+	"sync"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+// seriesLimitExceededTracker tracks the number of samples dropped per metric name
+// because adding the corresponding series would have exceeded -storage.maxHourlySeries
+// or -storage.maxDailySeries.
+//
+// The number of distinct tracked metric names is bounded by maxNames in order to protect
+// installations with millions of distinct metric names from unbounded memory usage.
+// Once the bound is reached, samples for previously unseen metric names are no longer
+// attributed to a name - they are only counted in untrackedDroppedRows.
+type seriesLimitExceededTracker struct {
+	maxNames int
+
+	mu sync.Mutex
+	m  map[string]uint64
+	// sinceTs is the unix timestamp in seconds of the last Reset call (or creation).
+	sinceTs uint64
+	// untrackedDroppedRows is the number of dropped samples, which couldn't be attributed
+	// to a metric name, because maxNames has been reached and the name was previously unseen.
+	untrackedDroppedRows uint64
+}
+
+// newSeriesLimitExceededTracker returns a tracker, which tracks up to maxNames distinct
+// metric names. maxNames must be greater than 0.
+func newSeriesLimitExceededTracker(maxNames int) *seriesLimitExceededTracker {
+	t := &seriesLimitExceededTracker{
+		maxNames: maxNames,
+	}
+	t.resetLocked()
+	return t
+}
+
+// Add increments the drop counter for the given metric name.
+//
+// It is safe calling Add for a nil tracker - it is a no-op in this case.
+func (t *seriesLimitExceededTracker) Add(metricName []byte) {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if n, ok := t.m[string(metricName)]; ok {
+		t.m[string(metricName)] = n + 1
+		return
+	}
+	if len(t.m) >= t.maxNames {
+		t.untrackedDroppedRows++
+		return
+	}
+	t.m[string(metricName)] = 1
+}
+
+// SeriesLimitExceededStatsEntry is a single entry in SeriesLimitExceededStats.Entries.
+type SeriesLimitExceededStatsEntry struct {
+	// MetricName is the metric name samples were dropped for.
+	MetricName string `json:"metricName"`
+	// DroppedRows is the number of samples dropped for MetricName.
+	DroppedRows uint64 `json:"droppedRows"`
+}
+
+// SeriesLimitExceededStats is the result of seriesLimitExceededTracker.GetTop.
+type SeriesLimitExceededStats struct {
+	// CollectedSinceTs is the unix timestamp in seconds since when the stats have been collected.
+	CollectedSinceTs uint64 `json:"collectedSinceTimestamp"`
+	// MaxMetricNames is the maximum number of distinct metric names, which can be tracked.
+	MaxMetricNames int `json:"maxMetricNames"`
+	// TrackedMetricNames is the number of currently tracked distinct metric names.
+	TrackedMetricNames int `json:"trackedMetricNames"`
+	// UntrackedDroppedRows is the number of dropped samples, which couldn't be attributed to
+	// a metric name, because MaxMetricNames has been reached and the metric name was
+	// previously unseen. When this is greater than 0, Entries may be missing some of the
+	// metric names, which hit the series limit.
+	UntrackedDroppedRows uint64 `json:"untrackedDroppedRows"`
+	// Entries contains up to the requested number of entries with the highest DroppedRows values.
+	Entries []SeriesLimitExceededStatsEntry `json:"entries"`
+}
+
+// GetTop returns up to topN entries with the highest DroppedRows values, sorted in
+// descending order of DroppedRows. If topN <= 0, all the tracked entries are returned.
+//
+// It is safe calling GetTop on a nil tracker - it returns an empty result in this case.
+func (t *seriesLimitExceededTracker) GetTop(topN int) SeriesLimitExceededStats {
+	var result SeriesLimitExceededStats
+	if t == nil {
+		return result
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	result.CollectedSinceTs = t.sinceTs
+	result.MaxMetricNames = t.maxNames
+	result.TrackedMetricNames = len(t.m)
+	result.UntrackedDroppedRows = t.untrackedDroppedRows
+
+	entries := make([]SeriesLimitExceededStatsEntry, 0, len(t.m))
+	for name, n := range t.m {
+		entries = append(entries, SeriesLimitExceededStatsEntry{
+			MetricName:  name,
+			DroppedRows: n,
+		})
+	}
+	sort.Slice(entries, func(i, j int) bool {
+		if entries[i].DroppedRows != entries[j].DroppedRows {
+			return entries[i].DroppedRows > entries[j].DroppedRows
+		}
+		return entries[i].MetricName < entries[j].MetricName
+	})
+	if topN > 0 && topN < len(entries) {
+		entries = entries[:topN]
+	}
+	result.Entries = entries
+	return result
+}
+
+// Reset drops all the collected stats and restarts the collection window.
+//
+// It is safe calling Reset on a nil tracker - it is a no-op in this case.
+func (t *seriesLimitExceededTracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.resetLocked()
+	t.mu.Unlock()
+}
+
+func (t *seriesLimitExceededTracker) resetLocked() {
+	t.m = make(map[string]uint64)
+	t.sinceTs = fasttime.UnixTimestamp()
+	t.untrackedDroppedRows = 0
+}
diff --git a/lib/storage/series_limit_exceeded_tracker_test.go b/lib/storage/series_limit_exceeded_tracker_test.go
new file mode 100644
index 0000000..bce994c
--- /dev/null
+++ b/lib/storage/series_limit_exceeded_tracker_test.go
@@ -0,0 +1,144 @@
+package storage
+
+import (
+	"fmt"
+	"testing"
+)
+
+func TestSeriesLimitExceededTracker_Nil(t *testing.T) {
+	var t1 *seriesLimitExceededTracker
+
+	// None of these must panic when the tracker is nil (tracking disabled).
+	t1.Add([]byte("foo"))
+	t1.Reset()
+
+	got := t1.GetTop(10)
+	if got.TrackedMetricNames != 0 || len(got.Entries) != 0 {
+		t.Fatalf("unexpected non-empty result from nil tracker: %+v", got)
+	}
+}
+
+func TestSeriesLimitExceededTracker_MultipleMetricNames(t *testing.T) {
+	tr := newSeriesLimitExceededTracker(100)
+
+	tr.Add([]byte("metric_a"))
+	tr.Add([]byte("metric_a"))
+	tr.Add([]byte("metric_a"))
+	tr.Add([]byte("metric_b"))
+	tr.Add([]byte("metric_c"))
+	tr.Add([]byte("metric_c"))
+
+	got := tr.GetTop(10)
+	if got.TrackedMetricNames != 3 {
+		t.Fatalf("unexpected TrackedMetricNames: got %d, want 3", got.TrackedMetricNames)
+	}
+	if got.UntrackedDroppedRows != 0 {
+		t.Fatalf("unexpected UntrackedDroppedRows: got %d, want 0", got.UntrackedDroppedRows)
+	}
+
+	want := map[string]uint64{
+		"metric_a": 3,
+		"metric_b": 1,
+		"metric_c": 2,
+	}
+	if len(got.Entries) != len(want) {
+		t.Fatalf("unexpected number of entries: got %d, want %d", len(got.Entries), len(want))
+	}
+	for _, e := range got.Entries {
+		if want[e.MetricName] != e.DroppedRows {
+			t.Fatalf("unexpected DroppedRows for %q: got %d, want %d", e.MetricName, e.DroppedRows, want[e.MetricName])
+		}
+	}
+}
+
+func TestSeriesLimitExceededTracker_GetTopOrderingAndLimit(t *testing.T) {
+	tr := newSeriesLimitExceededTracker(100)
+
+	counts := map[string]int{
+		"metric_a": 7,
+		"metric_b": 3,
+		"metric_c": 5,
+		"metric_d": 5,
+	}
+	for name, n := range counts {
+		for range n {
+			tr.Add([]byte(name))
+		}
+	}
+
+	got := tr.GetTop(2)
+	if len(got.Entries) != 2 {
+		t.Fatalf("unexpected number of entries: got %d, want 2", len(got.Entries))
+	}
+	if got.Entries[0].MetricName != "metric_a" || got.Entries[0].DroppedRows != 7 {
+		t.Fatalf("unexpected top entry: %+v", got.Entries[0])
+	}
+	// metric_c and metric_d are tied at 5 - ties are broken by name ascending.
+	if got.Entries[1].MetricName != "metric_c" || got.Entries[1].DroppedRows != 5 {
+		t.Fatalf("unexpected second entry: %+v", got.Entries[1])
+	}
+
+	// A non-positive topN must return all the entries.
+	all := tr.GetTop(0)
+	if len(all.Entries) != len(counts) {
+		t.Fatalf("unexpected number of entries for topN<=0: got %d, want %d", len(all.Entries), len(counts))
+	}
+}
+
+func TestSeriesLimitExceededTracker_MemoryBoundRespected(t *testing.T) {
+	const maxNames = 3
+	tr := newSeriesLimitExceededTracker(maxNames)
+
+	const totalNames = 50
+	for i := range totalNames {
+		tr.Add(fmt.Appendf(nil, "metric_%d", i))
+	}
+
+	got := tr.GetTop(0)
+	if got.TrackedMetricNames > maxNames {
+		t.Fatalf("tracker exceeded its memory bound: TrackedMetricNames=%d, maxNames=%d", got.TrackedMetricNames, maxNames)
+	}
+	if got.TrackedMetricNames != maxNames {
+		t.Fatalf("unexpected TrackedMetricNames: got %d, want %d", got.TrackedMetricNames, maxNames)
+	}
+	if len(got.Entries) != maxNames {
+		t.Fatalf("unexpected number of entries: got %d, want %d", len(got.Entries), maxNames)
+	}
+	wantUntracked := uint64(totalNames - maxNames)
+	if got.UntrackedDroppedRows != wantUntracked {
+		t.Fatalf("unexpected UntrackedDroppedRows: got %d, want %d", got.UntrackedDroppedRows, wantUntracked)
+	}
+
+	// Hits to an already-tracked name must keep incrementing its counter without
+	// consuming additional capacity or affecting UntrackedDroppedRows.
+	tracked := got.Entries[0].MetricName
+	tr.Add([]byte(tracked))
+	got2 := tr.GetTop(0)
+	if got2.TrackedMetricNames != maxNames {
+		t.Fatalf("unexpected TrackedMetricNames after re-adding a tracked name: got %d, want %d", got2.TrackedMetricNames, maxNames)
+	}
+	if got2.UntrackedDroppedRows != wantUntracked {
+		t.Fatalf("unexpected UntrackedDroppedRows after re-adding a tracked name: got %d, want %d", got2.UntrackedDroppedRows, wantUntracked)
+	}
+}
+
+func TestSeriesLimitExceededTracker_Reset(t *testing.T) {
+	tr := newSeriesLimitExceededTracker(10)
+	tr.Add([]byte("metric_a"))
+	tr.Add([]byte("metric_b"))
+
+	got := tr.GetTop(0)
+	if got.TrackedMetricNames != 2 {
+		t.Fatalf("unexpected TrackedMetricNames before reset: %d", got.TrackedMetricNames)
+	}
+
+	tr.Reset()
+
+	got = tr.GetTop(0)
+	if got.TrackedMetricNames != 0 || len(got.Entries) != 0 {
+		t.Fatalf("unexpected non-empty result after Reset: %+v", got)
+	}
+	if got.CollectedSinceTs == 0 {
+		t.Fatalf("expected CollectedSinceTs to be set after Reset")
+	}
+}
