+func TestStorageSeriesLimitExceededStats(t *testing.T) {
+	defer testRemoveAll(t)
+
+	tr := TimeRange{
+		MinTimestamp: time.Now().UnixMilli(),
+		MaxTimestamp: time.Now().UnixMilli() + 1000,
+	}
+
+	t.Run("MultipleMetricNamesAndTopN", func(t *testing.T) {
+		s := MustOpenStorage(t.Name(), OpenOptions{
+			MaxHourlySeries:                   3,
+			MaxSeriesLimitExceededMetricNames: 10,
+		})
+		defer s.MustClose()
+
+		// Fill the hourly series limit completely with unrelated series, so every series
+		// added below is guaranteed to be dropped and deterministically attributed.
+		s.AddRows(testGenSeriesLimitExceededRows("filler_metric", 3, tr), defaultPrecisionBits)
+		s.DebugFlush()
+
+		mrs := append(testGenSeriesLimitExceededRows("metric_a", 7, tr), testGenSeriesLimitExceededRows("metric_b", 3, tr)...)
+		s.AddRows(mrs, defaultPrecisionBits)
+		s.DebugFlush()
+
+		var m Metrics
+		s.UpdateMetrics(&m)
+		if got, want := m.HourlySeriesLimitRowsDropped, uint64(10); got != want {
+			t.Fatalf("unexpected HourlySeriesLimitRowsDropped: got %d, want %d", got, want)
+		}
+
+		stats := s.GetSeriesLimitExceededStats(10)
+		if stats.TrackedMetricNames != 2 {
+			t.Fatalf("unexpected TrackedMetricNames: got %d, want 2", stats.TrackedMetricNames)
+		}
+		if stats.UntrackedDroppedRows != 0 {
+			t.Fatalf("unexpected UntrackedDroppedRows: got %d, want 0", stats.UntrackedDroppedRows)
+		}
+		if len(stats.Entries) != 2 {
+			t.Fatalf("unexpected number of entries: got %d, want 2", len(stats.Entries))
+		}
+		if stats.Entries[0].MetricName != "metric_a" || stats.Entries[0].DroppedRows != 7 {
+			t.Fatalf("unexpected top entry: %+v", stats.Entries[0])
+		}
+		if stats.Entries[1].MetricName != "metric_b" || stats.Entries[1].DroppedRows != 3 {
+			t.Fatalf("unexpected second entry: %+v", stats.Entries[1])
+		}
+
+		// A topN smaller than the tracked entries count must be respected.
+		top1 := s.GetSeriesLimitExceededStats(1)
+		if len(top1.Entries) != 1 || top1.Entries[0].MetricName != "metric_a" {
+			t.Fatalf("unexpected result for topN=1: %+v", top1)
+		}
+
+		// Reset must clear the collected stats.
+		s.ResetSeriesLimitExceededStats()
+		stats = s.GetSeriesLimitExceededStats(10)
+		if stats.TrackedMetricNames != 0 || len(stats.Entries) != 0 {
+			t.Fatalf("unexpected non-empty stats after reset: %+v", stats)
+		}
+	})
+
+	t.Run("MemoryBoundRespected", func(t *testing.T) {
+		s := MustOpenStorage(t.Name(), OpenOptions{
+			MaxHourlySeries:                   1,
+			MaxSeriesLimitExceededMetricNames: 2,
+		})
+		defer s.MustClose()
+
+		s.AddRows(testGenSeriesLimitExceededRows("filler_metric", 1, tr), defaultPrecisionBits)
+		s.DebugFlush()
+
+		var mrs []MetricRow
+		for i := range 5 {
+			mrs = append(mrs, testGenSeriesLimitExceededRows(fmt.Sprintf("metric_%d", i), 4, tr)...)
+		}
+		s.AddRows(mrs, defaultPrecisionBits)
+		s.DebugFlush()
+
+		stats := s.GetSeriesLimitExceededStats(0)
+		if stats.TrackedMetricNames > 2 {
+			t.Fatalf("tracker exceeded its configured memory bound: TrackedMetricNames=%d", stats.TrackedMetricNames)
+		}
+		if stats.TrackedMetricNames != 2 {
+			t.Fatalf("unexpected TrackedMetricNames: got %d, want 2", stats.TrackedMetricNames)
+		}
+		if stats.UntrackedDroppedRows == 0 {
+			t.Fatalf("expected UntrackedDroppedRows to be greater than 0")
+		}
+
+		var m Metrics
+		s.UpdateMetrics(&m)
+		trackedDropped := uint64(0)
+		for _, e := range stats.Entries {
+			trackedDropped += e.DroppedRows
+		}
+		if trackedDropped+stats.UntrackedDroppedRows != m.HourlySeriesLimitRowsDropped {
+			t.Fatalf("tracked(%d)+untracked(%d) dropped rows do not add up to total dropped(%d)",
+				trackedDropped, stats.UntrackedDroppedRows, m.HourlySeriesLimitRowsDropped)
+		}
+	})
+
+	t.Run("DisabledByDefault", func(t *testing.T) {
+		s := MustOpenStorage(t.Name(), OpenOptions{
+			MaxHourlySeries: 1,
+			// MaxSeriesLimitExceededMetricNames is left at zero - tracking is disabled.
+		})
+		defer s.MustClose()
+
+		s.AddRows(testGenSeriesLimitExceededRows("metric_a", 5, tr), defaultPrecisionBits)
+		s.DebugFlush()
+
+		stats := s.GetSeriesLimitExceededStats(10)
+		if stats.TrackedMetricNames != 0 || len(stats.Entries) != 0 {
+			t.Fatalf("expected no stats to be collected when tracking is disabled, got %+v", stats)
+		}
+	})
+}
