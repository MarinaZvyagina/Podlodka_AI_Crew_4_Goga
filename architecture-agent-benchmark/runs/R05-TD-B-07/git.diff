+// registerSeriesLimitExceeded attributes a dropped sample to the metric name encoded in
+// metricNameRaw for the purposes of -storage.maxHourlySeries / -storage.maxDailySeries
+// observability. It is a cheap no-op when tracking is disabled.
+func (s *Storage) registerSeriesLimitExceeded(metricNameRaw []byte) {
+	if s.seriesLimitExceededTracker == nil {
+		return
+	}
+	metricGroup, err := getMetricGroupFromRaw(metricNameRaw)
+	if err != nil {
+		return
+	}
+	s.seriesLimitExceededTracker.Add(metricGroup)
+}
