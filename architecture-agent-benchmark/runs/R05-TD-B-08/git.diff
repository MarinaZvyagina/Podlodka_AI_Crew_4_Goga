diff --git a/lib/storage/series_limit_exceeded_storage_test.go b/lib/storage/series_limit_exceeded_storage_test.go
new file mode 100644
index 0000000..f975193
--- /dev/null
+++ b/lib/storage/series_limit_exceeded_storage_test.go
@@ -0,0 +1,182 @@
+package storage
+
+import (
+	"fmt"
+	"math/rand"
+	"testing"
+	"time"
+)
+
+// testGenerateMetricRowsForNames generates seriesPerName distinct series (identical
+// metric name, distinct "instance" label) for every name in names.
+func testGenerateMetricRowsForNames(rng *rand.Rand, names []string, seriesPerName int, tr TimeRange) []MetricRow {
+	var mrs []MetricRow
+	var mn MetricName
+	for i := range seriesPerName {
+		for _, name := range names {
+			mn.MetricGroup = []byte(name)
+			mn.Tags = []Tag{
+				{[]byte("instance"), fmt.Appendf(nil, "instance_%d", i)},
+			}
+			metricNameRaw := mn.marshalRaw(nil)
+			timestamp := rng.Int63n(tr.MaxTimestamp-tr.MinTimestamp) + tr.MinTimestamp
+			mrs = append(mrs, MetricRow{
+				MetricNameRaw: metricNameRaw,
+				Timestamp:     timestamp,
+				Value:         rng.NormFloat64() * 1e6,
+			})
+		}
+	}
+	return mrs
+}
+
+func TestStorageSeriesLimitExceededTop(t *testing.T) {
+	defer testRemoveAll(t)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	tr := TimeRange{minTimestamp, maxTimestamp}
+
+	names := []string{"cpu_usage", "mem_usage", "disk_io"}
+	const seriesPerName = 30
+	const maxHourlySeries = 6
+
+	mrs := testGenerateMetricRowsForNames(rng, names, seriesPerName, tr)
+
+	opts := OpenOptions{
+		MaxHourlySeries:                      maxHourlySeries,
+		SeriesLimitExceededTrackerMaxEntries: 100,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped == 0 {
+		t.Fatalf("expected some rows to be dropped due to -storage.maxHourlySeries")
+	}
+
+	top, sinceTs := s.GetHourlySeriesLimitExceededTop(10)
+	if sinceTs == 0 {
+		t.Fatalf("expected a non-zero collection start timestamp")
+	}
+	if len(top) != len(names) {
+		t.Fatalf("unexpected number of tracked metric names: got %d, want %d; top=%v", len(top), len(names), top)
+	}
+
+	var totalDropped uint64
+	seenNames := make(map[string]bool)
+	for _, e := range top {
+		seenNames[e.MetricName] = true
+		if e.DroppedRows == 0 {
+			t.Fatalf("unexpected zero DroppedRows for metric name %q", e.MetricName)
+		}
+		totalDropped += e.DroppedRows
+	}
+	for _, name := range names {
+		if !seenNames[name] {
+			t.Fatalf("expected metric name %q to be present in the top offenders list; got %v", name, top)
+		}
+	}
+	if totalDropped != m.HourlySeriesLimitRowsDropped {
+		t.Fatalf("sum of per-name dropped rows (%d) doesn't match Metrics.HourlySeriesLimitRowsDropped (%d)", totalDropped, m.HourlySeriesLimitRowsDropped)
+	}
+
+	// GetTop must respect topN.
+	topLimited, _ := s.GetHourlySeriesLimitExceededTop(1)
+	if len(topLimited) != 1 {
+		t.Fatalf("unexpected number of entries with topN=1: got %d", len(topLimited))
+	}
+
+	// The daily limit is disabled in this test, so its tracker must be
+	// a no-op returning an empty result.
+	dailyTop, dailySinceTs := s.GetDailySeriesLimitExceededTop(10)
+	if len(dailyTop) != 0 || dailySinceTs != 0 {
+		t.Fatalf("expected empty results for the disabled daily series limit tracker; got top=%v, sinceTs=%d", dailyTop, dailySinceTs)
+	}
+
+	// Verify Reset clears the collected stats.
+	s.ResetSeriesLimitExceededTrackers()
+	topAfterReset, sinceTsAfterReset := s.GetHourlySeriesLimitExceededTop(10)
+	if len(topAfterReset) != 0 {
+		t.Fatalf("expected empty top offenders list after reset; got %v", topAfterReset)
+	}
+	if sinceTsAfterReset < sinceTs {
+		t.Fatalf("expected SinceTimestamp to advance after reset: got %d, want >= %d", sinceTsAfterReset, sinceTs)
+	}
+}
+
+// TestStorageSeriesLimitExceededTop_TrackerDisabled verifies that setting
+// SeriesLimitExceededTrackerMaxEntries to 0 fully disables per-name tracking
+// while the aggregate drop counter keeps working as before.
+func TestStorageSeriesLimitExceededTop_TrackerDisabled(t *testing.T) {
+	defer testRemoveAll(t)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	tr := TimeRange{minTimestamp, maxTimestamp}
+
+	names := []string{"cpu_usage", "mem_usage"}
+	mrs := testGenerateMetricRowsForNames(rng, names, 30, tr)
+
+	opts := OpenOptions{
+		MaxHourlySeries:                      6,
+		SeriesLimitExceededTrackerMaxEntries: 0,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped == 0 {
+		t.Fatalf("expected some rows to be dropped due to -storage.maxHourlySeries")
+	}
+
+	top, sinceTs := s.GetHourlySeriesLimitExceededTop(10)
+	if len(top) != 0 || sinceTs != 0 {
+		t.Fatalf("expected disabled tracker to return empty results; got top=%v, sinceTs=%d", top, sinceTs)
+	}
+}
+
+// TestStorageSeriesLimitExceededTop_MemoryBound verifies that the number of
+// tracked metric names never exceeds SeriesLimitExceededTrackerMaxEntries,
+// even when far more distinct metric names hit the series limit.
+func TestStorageSeriesLimitExceededTop_MemoryBound(t *testing.T) {
+	defer testRemoveAll(t)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	tr := TimeRange{minTimestamp, maxTimestamp}
+
+	const distinctNames = 200
+	const maxTrackedEntries = 5
+	names := make([]string, distinctNames)
+	for i := range names {
+		names[i] = fmt.Sprintf("metric_%d", i)
+	}
+	mrs := testGenerateMetricRowsForNames(rng, names, 5, tr)
+
+	opts := OpenOptions{
+		MaxHourlySeries:                      1,
+		SeriesLimitExceededTrackerMaxEntries: maxTrackedEntries,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	top, _ := s.GetHourlySeriesLimitExceededTop(0)
+	if len(top) > maxTrackedEntries {
+		t.Fatalf("tracker exceeded its configured memory bound: got %d tracked names, want <= %d", len(top), maxTrackedEntries)
+	}
+}
diff --git a/lib/storage/series_limit_exceeded_tracker.go b/lib/storage/series_limit_exceeded_tracker.go
new file mode 100644
index 0000000..6c96b4f
--- /dev/null
+++ b/lib/storage/series_limit_exceeded_tracker.go
@@ -0,0 +1,152 @@
+package storage
+
+import (
+	"sort"
+	"sync"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/bytesutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+// seriesLimitExceededTracker tracks, per metric name, how many samples were
+// dropped because adding a new series for that metric name would have
+// exceeded -storage.maxHourlySeries or -storage.maxDailySeries.
+//
+// The number of distinct metric names tracked is bounded by maxEntries via
+// the Space-Saving algorithm (see Register), so memory usage cannot grow
+// unbounded even if millions of distinct metric names hit the limit.
+//
+// A nil *seriesLimitExceededTracker is valid and turns every method into a
+// no-op, so the feature can be fully disabled with a single nil check on the
+// ingestion hot path.
+type seriesLimitExceededTracker struct {
+	maxEntries int
+
+	mu      sync.Mutex
+	entries map[string]*seriesLimitExceededEntry
+	sinceTs uint64
+}
+
+type seriesLimitExceededEntry struct {
+	name  string
+	count uint64
+}
+
+// newSeriesLimitExceededTracker creates a tracker bounded to maxEntries distinct metric names.
+//
+// It returns nil, which disables the tracker, if maxEntries <= 0.
+func newSeriesLimitExceededTracker(maxEntries int) *seriesLimitExceededTracker {
+	if maxEntries <= 0 {
+		return nil
+	}
+	return &seriesLimitExceededTracker{
+		maxEntries: maxEntries,
+		entries:    make(map[string]*seriesLimitExceededEntry),
+		sinceTs:    fasttime.UnixTimestamp(),
+	}
+}
+
+// Register accounts for a single dropped sample belonging to the given metric name.
+func (t *seriesLimitExceededTracker) Register(metricName []byte) {
+	if t == nil {
+		return
+	}
+
+	key := bytesutil.ToUnsafeString(metricName)
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if e, ok := t.entries[key]; ok {
+		e.count++
+		return
+	}
+	if len(t.entries) < t.maxEntries {
+		name := string(metricName)
+		t.entries[name] = &seriesLimitExceededEntry{name: name, count: 1}
+		return
+	}
+
+	// The tracker is full. Use the Space-Saving algorithm to keep an
+	// approximation of the top offenders without growing memory usage any
+	// further: evict the entry with the smallest count and let the new
+	// entry start from that count, so that recurring offenders can "catch
+	// up" and eventually displace one-off entries.
+	var minKey string
+	var minEntry *seriesLimitExceededEntry
+	for k, e := range t.entries {
+		if minEntry == nil || e.count < minEntry.count {
+			minKey, minEntry = k, e
+		}
+	}
+	delete(t.entries, minKey)
+	name := string(metricName)
+	t.entries[name] = &seriesLimitExceededEntry{name: name, count: minEntry.count + 1}
+}
+
+// SeriesLimitExceededEntry is a single row of the result returned by GetTop.
+type SeriesLimitExceededEntry struct {
+	MetricName  string
+	DroppedRows uint64
+}
+
+// GetTop returns up to topN metric names with the highest drop counts, sorted in descending order of DroppedRows.
+//
+// All the tracked entries are returned if topN <= 0.
+func (t *seriesLimitExceededTracker) GetTop(topN int) []SeriesLimitExceededEntry {
+	if t == nil {
+		return nil
+	}
+
+	t.mu.Lock()
+	result := make([]SeriesLimitExceededEntry, 0, len(t.entries))
+	for _, e := range t.entries {
+		result = append(result, SeriesLimitExceededEntry{
+			MetricName:  e.name,
+			DroppedRows: e.count,
+		})
+	}
+	t.mu.Unlock()
+
+	sort.Slice(result, func(i, j int) bool {
+		if result[i].DroppedRows != result[j].DroppedRows {
+			return result[i].DroppedRows > result[j].DroppedRows
+		}
+		return result[i].MetricName < result[j].MetricName
+	})
+	if topN > 0 && topN < len(result) {
+		result = result[:topN]
+	}
+	return result
+}
+
+// EntriesCount returns the number of distinct metric names currently tracked.
+func (t *seriesLimitExceededTracker) EntriesCount() int {
+	if t == nil {
+		return 0
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return len(t.entries)
+}
+
+// SinceTimestamp returns the unix timestamp of the last Reset call, or of tracker creation if Reset was never called.
+func (t *seriesLimitExceededTracker) SinceTimestamp() uint64 {
+	if t == nil {
+		return 0
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.sinceTs
+}
+
+// Reset clears all the tracked entries and their counts.
+func (t *seriesLimitExceededTracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.entries = make(map[string]*seriesLimitExceededEntry)
+	t.sinceTs = fasttime.UnixTimestamp()
+	t.mu.Unlock()
+}
