+package storage
+
+import (
+	"fmt"
+	"testing"
+)
+
+func TestSeriesLimitExceededTracker_Nil(t *testing.T) {
+	var t0 *seriesLimitExceededTracker
+
+	// All methods on a nil tracker must be safe no-ops.
+	t0.Register([]byte("foo"))
+	if got := t0.GetTop(10); got != nil {
+		t.Fatalf("unexpected non-nil result from GetTop() on a nil tracker: %v", got)
+	}
+	if got := t0.EntriesCount(); got != 0 {
+		t.Fatalf("unexpected EntriesCount() on a nil tracker: got %d, want 0", got)
+	}
+	if got := t0.SinceTimestamp(); got != 0 {
+		t.Fatalf("unexpected SinceTimestamp() on a nil tracker: got %d, want 0", got)
+	}
+	t0.Reset()
+}
+
+func TestSeriesLimitExceededTracker_DisabledWhenMaxEntriesIsZero(t *testing.T) {
+	tr := newSeriesLimitExceededTracker(0)
+	if tr != nil {
+		t.Fatalf("expected newSeriesLimitExceededTracker(0) to return nil, got %v", tr)
+	}
+}
+
+func TestSeriesLimitExceededTracker_RegisterAndGetTop(t *testing.T) {
+	tr := newSeriesLimitExceededTracker(100)
+
+	// metric_0 dropped once, metric_1 dropped twice, metric_2 dropped three times.
+	tr.Register([]byte("metric_0"))
+	tr.Register([]byte("metric_1"))
+	tr.Register([]byte("metric_1"))
+	tr.Register([]byte("metric_2"))
+	tr.Register([]byte("metric_2"))
+	tr.Register([]byte("metric_2"))
+
+	if got, want := tr.EntriesCount(), 3; got != want {
+		t.Fatalf("unexpected EntriesCount(): got %d, want %d", got, want)
+	}
+
+	top := tr.GetTop(10)
+	want := []SeriesLimitExceededEntry{
+		{MetricName: "metric_2", DroppedRows: 3},
+		{MetricName: "metric_1", DroppedRows: 2},
+		{MetricName: "metric_0", DroppedRows: 1},
+	}
+	if len(top) != len(want) {
+		t.Fatalf("unexpected number of entries: got %d, want %d; entries=%v", len(top), len(want), top)
+	}
+	for i, e := range want {
+		if top[i] != e {
+			t.Fatalf("unexpected entry at position %d: got %+v, want %+v", i, top[i], e)
+		}
+	}
+
+	// Limiting topN must return only the highest offenders.
+	top1 := tr.GetTop(1)
+	if len(top1) != 1 || top1[0].MetricName != "metric_2" {
+		t.Fatalf("unexpected GetTop(1) result: %v", top1)
+	}
+}
+
+func TestSeriesLimitExceededTracker_Reset(t *testing.T) {
+	tr := newSeriesLimitExceededTracker(100)
+	tr.Register([]byte("metric_0"))
+	tr.Register([]byte("metric_1"))
+
+	sinceBeforeReset := tr.SinceTimestamp()
+	tr.Reset()
+
+	if got := tr.EntriesCount(); got != 0 {
+		t.Fatalf("unexpected EntriesCount() after Reset(): got %d, want 0", got)
+	}
+	if got := tr.GetTop(10); len(got) != 0 {
+		t.Fatalf("unexpected GetTop() after Reset(): %v", got)
+	}
+	// SinceTimestamp is expected to be a valid unix timestamp; it may be
+	// equal to the pre-reset value if both calls land within the same second.
+	if got := tr.SinceTimestamp(); got < sinceBeforeReset {
+		t.Fatalf("unexpected SinceTimestamp() after Reset(): got %d, want >= %d", got, sinceBeforeReset)
+	}
+}
+
+// TestSeriesLimitExceededTracker_MemoryBound verifies that the tracker never
+// holds more than maxEntries distinct metric names in memory, regardless of
+// how many distinct offending metric names are registered.
+func TestSeriesLimitExceededTracker_MemoryBound(t *testing.T) {
+	const maxEntries = 50
+	tr := newSeriesLimitExceededTracker(maxEntries)
+
+	const distinctNames = 10000
+	for i := range distinctNames {
+		tr.Register([]byte(fmt.Sprintf("metric_%d", i)))
+		if got := tr.EntriesCount(); got > maxEntries {
+			t.Fatalf("tracker grew beyond maxEntries: got %d entries, want <= %d", got, maxEntries)
+		}
+	}
+
+	if got := tr.EntriesCount(); got != maxEntries {
+		t.Fatalf("unexpected final EntriesCount(): got %d, want %d", got, maxEntries)
+	}
+	if got := tr.GetTop(0); len(got) != maxEntries {
+		t.Fatalf("unexpected number of entries returned by GetTop(0): got %d, want %d", len(got), maxEntries)
+	}
+}
+
+// TestSeriesLimitExceededTracker_MemoryBound_SurvivesHeavyHitter verifies
+// that a metric name repeatedly hitting the limit is eventually retained in
+// the bounded tracker even if many one-off offending names are registered
+// after it.
+func TestSeriesLimitExceededTracker_MemoryBound_SurvivesHeavyHitter(t *testing.T) {
+	const maxEntries = 10
+	tr := newSeriesLimitExceededTracker(maxEntries)
+
+	// Register a heavy hitter many times.
+	const heavyHitterDrops = 100000
+	for range heavyHitterDrops {
+		tr.Register([]byte("heavy_hitter"))
+	}
+
+	// Register a lot of one-off distinct names, far exceeding maxEntries.
+	for i := range 100000 {
+		tr.Register([]byte(fmt.Sprintf("one_off_%d", i)))
+	}
+
+	if got := tr.EntriesCount(); got > maxEntries {
+		t.Fatalf("tracker grew beyond maxEntries: got %d entries, want <= %d", got, maxEntries)
+	}
+
+	top := tr.GetTop(1)
+	if len(top) != 1 || top[0].MetricName != "heavy_hitter" {
+		t.Fatalf("expected heavy_hitter to remain the top offender, got %v", top)
+	}
+	if top[0].DroppedRows < heavyHitterDrops {
