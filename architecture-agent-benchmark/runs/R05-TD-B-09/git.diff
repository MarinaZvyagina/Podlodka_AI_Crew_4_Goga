+// testGenerateMetricRowsForName generates count MetricRows, all sharing the
+// given metricName but each belonging to a distinct series (distinct
+// `instance` tag value).
+func testGenerateMetricRowsForName(rng *rand.Rand, count int, metricName string, tr TimeRange) []MetricRow {
+	var mrs []MetricRow
+	var mn MetricName
+	mn.MetricGroup = []byte(metricName)
+	for i := range count {
+		mn.Tags = []Tag{
+			{[]byte("job"), []byte("webservice")},
+			{[]byte("instance"), fmt.Appendf(nil, "instance_%d", i)},
+		}
+		metricNameRaw := mn.marshalRaw(nil)
+		timestamp := rng.Int63n(tr.MaxTimestamp-tr.MinTimestamp) + tr.MinTimestamp
+		value := rng.NormFloat64() * 1e6
+		mrs = append(mrs, MetricRow{
+			MetricNameRaw: metricNameRaw,
+			Timestamp:     timestamp,
+			Value:         value,
+		})
+	}
+	return mrs
+}
+
+func TestStorageDroppedSeriesByNameStats(t *testing.T) {
+	defer testRemoveAll(t)
+
+	t.Run("TracksMultipleNamesAndTopOffenders", func(t *testing.T) {
+		rng := rand.New(rand.NewSource(1))
+		minTimestamp := time.Now().UnixMilli()
+		maxTimestamp := minTimestamp + 1000
+		tr := TimeRange{minTimestamp, maxTimestamp}
+
+		const seriesLimit = 3
+		opts := OpenOptions{
+			MaxHourlySeries:          seriesLimit,
+			TrackDroppedSeriesByName: true,
+		}
+		s := MustOpenStorage(t.Name(), opts)
+		defer s.MustClose()
+
+		// First saturate the hourly series limit with unrelated placeholder
+		// series, so that every series added afterwards is guaranteed to be
+		// rejected. This makes the resulting per-metric-name drop counts
+		// below deterministic instead of depending on which series happen
+		// to win the remaining limiter capacity.
+		placeholderRows := testGenerateMetricRowsForName(rng, seriesLimit, "placeholder", tr)
+		s.AddRows(placeholderRows, defaultPrecisionBits)
+		s.DebugFlush()
+
+		var mPlaceholder Metrics
+		s.UpdateMetrics(&mPlaceholder)
+		if mPlaceholder.HourlySeriesLimitRowsDropped != 0 {
+			t.Fatalf("unexpected drops while saturating the limiter: %d", mPlaceholder.HourlySeriesLimitRowsDropped)
+		}
+
+		// metric_a produces the most distinct series, metric_c the fewest;
+		// since the limiter is already saturated, every one of these rows
+		// is dropped, so the drop counts equal the series counts below and
+		// their relative order is fully deterministic.
+		var mrs []MetricRow
+		mrs = append(mrs, testGenerateMetricRowsForName(rng, 8, "metric_a", tr)...)
+		mrs = append(mrs, testGenerateMetricRowsForName(rng, 5, "metric_b", tr)...)
+		mrs = append(mrs, testGenerateMetricRowsForName(rng, 2, "metric_c", tr)...)
+
+		s.AddRows(mrs, defaultPrecisionBits)
+		s.DebugFlush()
+
+		var m Metrics
+		s.UpdateMetrics(&m)
+		if got, want := m.HourlySeriesLimitRowsDropped, uint64(len(mrs)); got != want {
+			t.Fatalf("unexpected Metrics.HourlySeriesLimitRowsDropped: got %d, want %d", got, want)
+		}
+
+		stats := s.GetDroppedSeriesByNameStats(0)
+		if stats.RecordsCount != 3 {
+			t.Fatalf("unexpected RecordsCount: got %d, want 3", stats.RecordsCount)
+		}
+		if len(stats.Records) != 3 {
+			t.Fatalf("unexpected len(Records): got %d, want 3", len(stats.Records))
+		}
+		wantCounts := map[string]uint64{
+			"metric_a": 8,
+			"metric_b": 5,
+			"metric_c": 2,
+		}
+		wantOrder := []string{"metric_a", "metric_b", "metric_c"}
+		for i, name := range wantOrder {
+			r := stats.Records[i]
+			if r.MetricName != name {
+				t.Fatalf("unexpected order at position %d: got %q, want %q; records=%+v", i, r.MetricName, name, stats.Records)
+			}
+			if r.DroppedRows != wantCounts[name] {
+				t.Fatalf("unexpected DroppedRows for %q: got %d, want %d", name, r.DroppedRows, wantCounts[name])
+			}
+		}
+
+		// Verify that a limit passed to GetDroppedSeriesByNameStats trims
+		// the result while the total record count stays the same.
+		top1 := s.GetDroppedSeriesByNameStats(1)
+		if top1.RecordsCount != 3 {
+			t.Fatalf("unexpected RecordsCount with limit=1: got %d, want 3", top1.RecordsCount)
+		}
+		if len(top1.Records) != 1 || top1.Records[0].MetricName != "metric_a" {
+			t.Fatalf("unexpected top-1 result: %+v", top1.Records)
+		}
+
+		// Verify Reset clears the collected stats.
+		s.ResetDroppedSeriesByNameStats()
+		afterReset := s.GetDroppedSeriesByNameStats(0)
+		if afterReset.RecordsCount != 0 || len(afterReset.Records) != 0 {
+			t.Fatalf("expected empty stats after reset, got %+v", afterReset)
+		}
+	})
+
+	t.Run("DisabledByDefault", func(t *testing.T) {
+		rng := rand.New(rand.NewSource(1))
+		minTimestamp := time.Now().UnixMilli()
+		maxTimestamp := minTimestamp + 1000
+		mrs := testGenerateMetricRowsForName(rng, 10, "metric_a", TimeRange{minTimestamp, maxTimestamp})
+
+		opts := OpenOptions{
+			MaxHourlySeries: 3,
+			// TrackDroppedSeriesByName is intentionally left unset.
+		}
+		s := MustOpenStorage(t.Name(), opts)
+		defer s.MustClose()
+		s.AddRows(mrs, defaultPrecisionBits)
+		s.DebugFlush()
+
+		stats := s.GetDroppedSeriesByNameStats(0)
+		if stats.RecordsCount != 0 || len(stats.Records) != 0 {
+			t.Fatalf("expected no stats to be collected when the tracker is disabled, got %+v", stats)
+		}
+	})
+
+	t.Run("MemoryBoundRespected", func(t *testing.T) {
+		const maxRecords = 5
+		SetDroppedSeriesByNameMaxRecords(maxRecords)
+		defer SetDroppedSeriesByNameMaxRecords(0)
+
+		rng := rand.New(rand.NewSource(1))
+		minTimestamp := time.Now().UnixMilli()
+		maxTimestamp := minTimestamp + 1000
+		tr := TimeRange{minTimestamp, maxTimestamp}
+
+		// Generate drops for far more distinct metric names than maxRecords.
+		const distinctNames = 50
+		var mrs []MetricRow
+		for i := range distinctNames {
+			mrs = append(mrs, testGenerateMetricRowsForName(rng, 2, fmt.Sprintf("metric_%d", i), tr)...)
+		}
+
+		opts := OpenOptions{
+			MaxHourlySeries:          1,
+			TrackDroppedSeriesByName: true,
+		}
+		s := MustOpenStorage(t.Name(), opts)
+		defer s.MustClose()
+		s.AddRows(mrs, defaultPrecisionBits)
+		s.DebugFlush()
+
+		stats := s.GetDroppedSeriesByNameStats(0)
+		if stats.RecordsCount > maxRecords {
+			t.Fatalf("dropped series tracker exceeded its configured memory bound: got %d records, want at most %d", stats.RecordsCount, maxRecords)
+		}
+		if stats.MaxRecords != maxRecords {
+			t.Fatalf("unexpected MaxRecords: got %d, want %d", stats.MaxRecords, maxRecords)
+		}
+	})
+}
