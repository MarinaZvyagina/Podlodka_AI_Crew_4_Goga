index 0000000..6b8e391
--- /dev/null
+++ b/lib/storage/droppedseriesstats/tracker.go
@@ -0,0 +1,163 @@
+// Package droppedseriesstats tracks, per metric name, how many samples were
+// dropped because adding the corresponding series would have exceeded the
+// configured -storage.maxHourlySeries or -storage.maxDailySeries limit.
+//
+// This makes it possible to answer "which metric names are responsible for
+// hitting our series-limit settings" without asking the customer to dig
+// through their own instrumentation.
+package droppedseriesstats
+
+import (
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+// maxTrackedMetricNameLen limits the length of a single metric name stored
+// in the tracker, so a handful of abnormally long metric names cannot blow
+// up its memory usage.
+const maxTrackedMetricNameLen = 256
+
+// DefaultMaxRecords is the default number of distinct metric names the
+// tracker keeps drop counters for. The feature is meant for identifying the
+// worst cardinality-limit offenders, not for exhaustive per-metric
+// accounting, so a relatively small bound is enough while keeping memory
+// usage predictable even when millions of distinct metric names are dropped.
+const DefaultMaxRecords = 1000
+
+// Tracker keeps track of the number of samples dropped per metric name
+// because of the configured series-cardinality limits.
+//
+// Its memory usage is bounded by maxRecords: once the tracker has recorded
+// drops for maxRecords distinct metric names, drops for any additional,
+// not-yet-seen metric names are simply not recorded until the next Reset.
+//
+// All methods are safe to call on a nil *Tracker: they become no-ops
+// (or return zero values), so callers don't need to check whether the
+// feature is enabled.
+type Tracker struct {
+	maxRecords int
+
+	creationTs atomic.Uint64
+
+	mu sync.Mutex
+	m  map[string]*atomic.Uint64
+}
+
+// NewTracker creates a Tracker, which tracks drop counts for at most
+// maxRecords distinct metric names. If maxRecords <= 0, DefaultMaxRecords is
+// used instead.
+func NewTracker(maxRecords int) *Tracker {
+	if maxRecords <= 0 {
+		maxRecords = DefaultMaxRecords
+	}
+	t := &Tracker{
+		maxRecords: maxRecords,
+		m:          make(map[string]*atomic.Uint64),
+	}
+	t.creationTs.Store(fasttime.UnixTimestamp())
+	return t
+}
+
+// IncrementDropCount registers a single dropped sample for the given metric
+// name.
+func (t *Tracker) IncrementDropCount(metricName []byte) {
+	if t == nil {
+		return
+	}
+	if len(metricName) > maxTrackedMetricNameLen {
+		metricName = metricName[:maxTrackedMetricNameLen]
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	// This lookup doesn't allocate, since Go special-cases map[string]X
+	// reads keyed by a []byte-to-string conversion.
+	c, ok := t.m[string(metricName)]
+	if !ok {
+		if len(t.m) >= t.maxRecords {
+			// The tracker is full - do not track drops for new metric
+			// names in order to keep memory usage bounded.
+			return
+		}
+		c = &atomic.Uint64{}
+		t.m[string(metricName)] = c
+	}
+	c.Add(1)
+}
+
+// Entry is a single (metric name, drop count) pair returned by GetTop.
+type Entry struct {
+	MetricName  string
+	DroppedRows uint64
+}
+
+// Stats is the result of a GetTop call.
+type Stats struct {
+	// CollectedSinceTs is the unix timestamp of the last time the tracker
+	// was created or reset.
+	CollectedSinceTs uint64
+
+	// MaxRecords is the maximum number of distinct metric names the tracker
+	// can hold.
+	MaxRecords int
+
+	// RecordsCount is the current number of distinct metric names tracked.
+	// It may be bigger than len(Records) if the requested limit is smaller.
+	RecordsCount int
+
+	// Records contains the requested top entries sorted by DroppedRows in
+	// descending order.
+	Records []Entry
+}
+
+// GetTop returns stats with up to limit entries with the highest
+// DroppedRows count, sorted by DroppedRows in descending order.
+// limit <= 0 means "no limit".
+func (t *Tracker) GetTop(limit int) Stats {
+	if t == nil {
+		return Stats{}
+	}
+
+	t.mu.Lock()
+	entries := make([]Entry, 0, len(t.m))
+	for k, v := range t.m {
+		entries = append(entries, Entry{
+			MetricName:  k,
+			DroppedRows: v.Load(),
+		})
+	}
+	t.mu.Unlock()
+
+	sort.Slice(entries, func(i, j int) bool {
+		if entries[i].DroppedRows != entries[j].DroppedRows {
+			return entries[i].DroppedRows > entries[j].DroppedRows
+		}
+		return entries[i].MetricName < entries[j].MetricName
+	})
+
+	st := Stats{
+		CollectedSinceTs: t.creationTs.Load(),
+		MaxRecords:       t.maxRecords,
+		RecordsCount:     len(entries),
+	}
+	if limit > 0 && len(entries) > limit {
+		entries = entries[:limit]
+	}
+	st.Records = entries
+	return st
+}
+
+// Reset drops all the collected stats and restarts the collection period.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.m = make(map[string]*atomic.Uint64)
+	t.mu.Unlock()
+	t.creationTs.Store(fasttime.UnixTimestamp())
+}
diff --git a/lib/storage/droppedseriesstats/tracker_test.go b/lib/storage/droppedseriesstats/tracker_test.go
new file mode 100644
index 0000000..e25126d
--- /dev/null
+++ b/lib/storage/droppedseriesstats/tracker_test.go
@@ -0,0 +1,146 @@
+package droppedseriesstats
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestTracker_Nil(t *testing.T) {
+	var tr *Tracker
+	// Must not panic.
+	tr.IncrementDropCount([]byte("foo"))
+	tr.Reset()
+	st := tr.GetTop(10)
+	if st.RecordsCount != 0 || len(st.Records) != 0 {
+		t.Fatalf("unexpected non-empty stats from a nil tracker: %+v", st)
+	}
+}
+
+func TestTracker_IncrementAndGetTop(t *testing.T) {
+	tr := NewTracker(100)
+
+	drops := map[string]int{
+		"metric_a": 5,
+		"metric_b": 1,
+		"metric_c": 10,
+	}
+	for name, n := range drops {
+		for i := 0; i < n; i++ {
+			tr.IncrementDropCount([]byte(name))
+		}
+	}
+
+	st := tr.GetTop(10)
+	if st.RecordsCount != 3 {
+		t.Fatalf("unexpected RecordsCount: got %d, want 3", st.RecordsCount)
+	}
+	if len(st.Records) != 3 {
+		t.Fatalf("unexpected len(Records): got %d, want 3", len(st.Records))
+	}
+	wantOrder := []string{"metric_c", "metric_a", "metric_b"}
+	for i, name := range wantOrder {
+		if st.Records[i].MetricName != name {
+			t.Fatalf("unexpected order at position %d: got %q, want %q; records=%+v", i, st.Records[i].MetricName, name, st.Records)
+		}
+		if st.Records[i].DroppedRows != uint64(drops[name]) {
+			t.Fatalf("unexpected DroppedRows for %q: got %d, want %d", name, st.Records[i].DroppedRows, drops[name])
+		}
+	}
+
+	// Limit must trim the result, while RecordsCount still reflects the total.
+	st = tr.GetTop(1)
+	if st.RecordsCount != 3 {
+		t.Fatalf("unexpected RecordsCount with limit=1: got %d, want 3", st.RecordsCount)
+	}
+	if len(st.Records) != 1 || st.Records[0].MetricName != "metric_c" {
+		t.Fatalf("unexpected top-1 result: %+v", st.Records)
+	}
+}
+
+func TestTracker_MaxRecordsBound(t *testing.T) {
+	const maxRecords = 5
+	tr := NewTracker(maxRecords)
+
+	// Feed drops for far more distinct metric names than the tracker can hold.
+	const distinctNames = 1000
+	var wg sync.WaitGroup
+	for i := 0; i < distinctNames; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			tr.IncrementDropCount([]byte(fmt.Sprintf("metric_%d", i)))
+		}(i)
+	}
+	wg.Wait()
+
+	st := tr.GetTop(0)
+	if st.RecordsCount > maxRecords {
+		t.Fatalf("tracker exceeded its memory bound: got %d records, want at most %d", st.RecordsCount, maxRecords)
+	}
+	if st.MaxRecords != maxRecords {
+		t.Fatalf("unexpected MaxRecords: got %d, want %d", st.MaxRecords, maxRecords)
+	}
+
+	// Metric names already tracked before the tracker filled up must keep
+	// being updated even after the bound is reached.
+	for i := 0; i < distinctNames; i++ {
+		tr.IncrementDropCount([]byte(fmt.Sprintf("metric_%d", i)))
+	}
+	st2 := tr.GetTop(0)
+	if st2.RecordsCount != st.RecordsCount {
+		t.Fatalf("tracker grew beyond its bound after it was already full: got %d records, had %d", st2.RecordsCount, st.RecordsCount)
+	}
+	var totalDrops uint64
+	for _, e := range st2.Records {
+		totalDrops += e.DroppedRows
+	}
+	if totalDrops != uint64(2*st.RecordsCount) {
+		t.Fatalf("existing entries weren't incremented past the bound: got total=%d, want %d", totalDrops, 2*st.RecordsCount)
+	}
+
+	// A very long metric name must be truncated instead of growing memory
+	// usage unboundedly.
+	longName := make([]byte, 10*maxTrackedMetricNameLen)
+	for i := range longName {
+		longName[i] = 'x'
+	}
+	tr2 := NewTracker(maxRecords)
+	tr2.IncrementDropCount(longName)
+	st3 := tr2.GetTop(1)
+	if len(st3.Records[0].MetricName) > maxTrackedMetricNameLen {
+		t.Fatalf("metric name wasn't truncated: len=%d", len(st3.Records[0].MetricName))
+	}
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(10)
+	tr.IncrementDropCount([]byte("metric_a"))
+	tr.IncrementDropCount([]byte("metric_b"))
+
+	st := tr.GetTop(0)
+	if st.RecordsCount != 2 {
+		t.Fatalf("unexpected RecordsCount before reset: %d", st.RecordsCount)
+	}
+
+	tr.Reset()
+
+	st = tr.GetTop(0)
+	if st.RecordsCount != 0 || len(st.Records) != 0 {
+		t.Fatalf("unexpected non-empty stats after reset: %+v", st)
+	}
+
+	// Tracking must resume normally after a reset.
+	tr.IncrementDropCount([]byte("metric_c"))
+	st = tr.GetTop(0)
+	if st.RecordsCount != 1 || st.Records[0].MetricName != "metric_c" {
+		t.Fatalf("unexpected stats after tracking resumed post-reset: %+v", st)
+	}
+}
+
+func TestTracker_DefaultMaxRecords(t *testing.T) {
+	tr := NewTracker(0)
+	if tr.maxRecords != DefaultMaxRecords {
+		t.Fatalf("unexpected default maxRecords: got %d, want %d", tr.maxRecords, DefaultMaxRecords)
+	}
+}
