 		logSkippedSeries(metricNameRaw, "-storage.maxDailySeries", sl.MaxItems())
+		s.registerDroppedSeriesByName(metricNameRaw)
 		return false
 	}
 	return true
 }
 
+// registerDroppedSeriesByName accounts a single sample dropped due to
+// hourlySeriesLimiter or dailySeriesLimiter under the metric name it belongs
+// to. It is a no-op when droppedSeriesTracker is disabled.
+func (s *Storage) registerDroppedSeriesByName(metricNameRaw []byte) {
+	if s.droppedSeriesTracker == nil {
+		return
+	}
+	mn := GetMetricName()
+	if err := mn.UnmarshalRaw(metricNameRaw); err == nil {
+		s.droppedSeriesTracker.IncrementDropCount(mn.MetricGroup)
+	}
+	PutMetricName(mn)
+}
+
+// GetDroppedSeriesByNameStats returns stats about samples dropped because
+// adding the corresponding series would have exceeded -storage.maxHourlySeries
+// or -storage.maxDailySeries, grouped by metric name.
+//
+// limit <= 0 means "no limit".
+func (s *Storage) GetDroppedSeriesByNameStats(limit int) droppedseriesstats.Stats {
+	return s.droppedSeriesTracker.GetTop(limit)
+}
+
+// ResetDroppedSeriesByNameStats resets stats collected by
+// GetDroppedSeriesByNameStats.
+func (s *Storage) ResetDroppedSeriesByNameStats() {
+	s.droppedSeriesTracker.Reset()
+}
