@@ -26,6 +26,7 @@ See also [LTS releases](https://docs.victoriametrics.com/victoriametrics/lts-rel
 
 ## tip
 
+* FEATURE: [vmsingle](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/) and `vmstorage` in [VictoriaMetrics cluster](https://docs.victoriametrics.com/victoriametrics/cluster-victoriametrics/): track which metric names are responsible for samples dropped because of `-storage.maxHourlySeries` / `-storage.maxDailySeries`. The top offending metric names are queryable via the new `/internal/series_limit_exceeded_stats` HTTP endpoint, and their counts are also tracked via new `vm_hourly_series_limit_dropped_names_tracked`, `vm_hourly_series_limit_dropped_names_overflow_rows_total`, `vm_daily_series_limit_dropped_names_tracked` and `vm_daily_series_limit_dropped_names_overflow_rows_total` metrics. The number of distinct metric names tracked per limiter is bounded by the new `-storage.maxDroppedSeriesNames` command-line flag (default `1000`) in order to avoid unbounded memory usage; setting it to `0` disables the tracking.
 * FEATURE: [vmagent](https://docs.victoriametrics.com/victoriametrics/vmagent/), [vmsingle](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/), `vmstorage` and `vmselect` in [VictoriaMetrics cluster](https://docs.victoriametrics.com/victoriametrics/cluster-victoriametrics/): expose the `vm_app_prev_shutdown_unclean` gauge. It is set to `1` when the previous process run didn't shut down cleanly. Added the `UncleanShutdown` [alerting rule](https://github.com/VictoriaMetrics/VictoriaMetrics/blob/master/deployment/docker/rules/alerts-health.yml), which fires for 10 minutes after an unclean shutdown is detected. See [#8443](https://github.com/VictoriaMetrics/VictoriaMetrics/issues/8443).
 * FEATURE: [vmui](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/#vmui): show the selected time zone UTC offset next to the date/time controls and allow opening time zone settings from it. See [#11332](https://github.com/VictoriaMetrics/VictoriaMetrics/pull/11332).
 * FEATURE: [vmsingle](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/), [vmagent](https://docs.victoriametrics.com/victoriametrics/vmagent/), [vmalert](https://docs.victoriametrics.com/victoriametrics/vmalert/), and `vmselect` in [VictoriaMetrics cluster](https://docs.victoriametrics.com/victoriametrics/cluster-victoriametrics/): show how the default value is calculated for command-line flags which derive it from the number of available CPU cores. For example, `-maxConcurrentInserts` now prints `(default 16 = 2*cgroup.AvailableCPUs())` in `-help` output instead of `(default 16)`. Updated flags: `-search.maxConcurrentRequests`, `-search.maxWorkersPerQuery`, `-fs.maxConcurrency`, `-remoteWrite.concurrency`, `-remoteWrite.queues`. See [#9680](https://github.com/VictoriaMetrics/VictoriaMetrics/issues/9680). Thanks to @Vandit1604 for contribution.
diff --git a/lib/storage/droppedseries/tracker.go b/lib/storage/droppedseries/tracker.go
new file mode 100644
index 0000000..9c95f60
--- /dev/null
+++ b/lib/storage/droppedseries/tracker.go
@@ -0,0 +1,168 @@
+// Package droppedseries implements a bounded, in-memory tracker for
+// discovering which metric names are responsible for samples dropped
+// because they would have exceeded a configured unique series limit
+// (see -storage.maxHourlySeries and -storage.maxDailySeries).
+package droppedseries
+
+import (
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+// Tracker tracks the number of dropped samples per metric name with bounded memory usage.
+//
+// Once the number of distinct tracked metric names reaches the configured limit,
+// samples for previously unseen metric names are counted in the overflow bucket
+// instead of being tracked individually. This guarantees that Tracker memory usage
+// never grows past maxEntries regardless of how many distinct metric names
+// are actually seen.
+//
+// It is safe to use Tracker from concurrent goroutines. A nil *Tracker is valid
+// and behaves as a no-op, which allows callers to keep the feature disabled with
+// no extra branching.
+type Tracker struct {
+	maxEntries int
+
+	mu      sync.RWMutex
+	entries map[string]*atomic.Uint64
+
+	overflowDroppedRowsCount atomic.Uint64
+	collectedSince           atomic.Uint64
+}
+
+// NewTracker returns a new Tracker, which tracks dropped samples for at most
+// maxEntries distinct metric names.
+func NewTracker(maxEntries int) *Tracker {
+	t := &Tracker{
+		maxEntries: maxEntries,
+		entries:    make(map[string]*atomic.Uint64),
+	}
+	t.collectedSince.Store(fasttime.UnixTimestamp())
+	return t
+}
+
+// Add registers a single dropped sample for the given metricName.
+func (t *Tracker) Add(metricName []byte) {
+	if t == nil {
+		return
+	}
+
+	t.mu.RLock()
+	cnt, ok := t.entries[string(metricName)]
+	t.mu.RUnlock()
+	if ok {
+		cnt.Add(1)
+		return
+	}
+
+	t.mu.Lock()
+	cnt, ok = t.entries[string(metricName)]
+	if !ok {
+		if len(t.entries) >= t.maxEntries {
+			t.mu.Unlock()
+			t.overflowDroppedRowsCount.Add(1)
+			return
+		}
+		cnt = &atomic.Uint64{}
+		t.entries[string(metricName)] = cnt
+	}
+	t.mu.Unlock()
+
+	cnt.Add(1)
+}
+
+// Entry is a single (metric name, dropped samples count) pair.
+type Entry struct {
+	MetricName       string
+	DroppedRowsCount uint64
+}
+
+// Stats holds a snapshot of the tracker state.
+type Stats struct {
+	// CollectedSince is a unix timestamp in seconds since which the entries were collected.
+	CollectedSince uint64
+
+	// MaxEntries is the maximum number of distinct metric names the tracker can hold.
+	MaxEntries int
+
+	// TrackedEntriesCount is the number of distinct metric names currently tracked.
+	TrackedEntriesCount int
+
+	// OverflowDroppedRowsCount is the number of dropped samples for metric names,
+	// which could not be tracked individually because the tracker reached MaxEntries.
+	OverflowDroppedRowsCount uint64
+
+	// TopEntries contains up to the requested number of entries with the highest
+	// DroppedRowsCount, sorted in descending order.
+	TopEntries []Entry
+}
+
+// GetTopEntries returns a Stats snapshot with up to topN entries with the highest
+// dropped sample counts, sorted in descending order of DroppedRowsCount.
+//
+// If topN is negative, all the tracked entries are returned.
+func (t *Tracker) GetTopEntries(topN int) Stats {
+	if t == nil {
+		return Stats{}
+	}
+
+	t.mu.RLock()
+	entries := make([]Entry, 0, len(t.entries))
+	for name, cnt := range t.entries {
+		entries = append(entries, Entry{
+			MetricName:       name,
+			DroppedRowsCount: cnt.Load(),
+		})
+	}
+	t.mu.RUnlock()
+
+	trackedEntriesCount := len(entries)
+
+	sort.Slice(entries, func(i, j int) bool {
+		if entries[i].DroppedRowsCount == entries[j].DroppedRowsCount {
+			return entries[i].MetricName < entries[j].MetricName
+		}
+		return entries[i].DroppedRowsCount > entries[j].DroppedRowsCount
+	})
+	if topN >= 0 && len(entries) > topN {
+		entries = entries[:topN]
+	}
+
+	return Stats{
+		CollectedSince:           t.collectedSince.Load(),
+		MaxEntries:               t.maxEntries,
+		TrackedEntriesCount:      trackedEntriesCount,
+		OverflowDroppedRowsCount: t.overflowDroppedRowsCount.Load(),
+		TopEntries:               entries,
+	}
+}
+
+// Counts returns the current tracked entries count and the overflow dropped
+// samples counter without the overhead of building and sorting a snapshot of
+// all the tracked entries. It is meant to be cheap enough to call periodically,
+// e.g. when exporting metrics.
+func (t *Tracker) Counts() (trackedEntriesCount int, overflowDroppedRowsCount uint64) {
+	if t == nil {
+		return 0, 0
+	}
+	t.mu.RLock()
+	trackedEntriesCount = len(t.entries)
+	t.mu.RUnlock()
+	overflowDroppedRowsCount = t.overflowDroppedRowsCount.Load()
+	return trackedEntriesCount, overflowDroppedRowsCount
+}
+
+// Reset clears all the tracked entries and counters.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.entries = make(map[string]*atomic.Uint64)
+	t.mu.Unlock()
+	t.overflowDroppedRowsCount.Store(0)
+	t.collectedSince.Store(fasttime.UnixTimestamp())
+}
diff --git a/lib/storage/droppedseries/tracker_test.go b/lib/storage/droppedseries/tracker_test.go
new file mode 100644
index 0000000..73a47fb
--- /dev/null
+++ b/lib/storage/droppedseries/tracker_test.go
@@ -0,0 +1,171 @@
+package droppedseries
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestTrackerNil(t *testing.T) {
+	var t0 *Tracker
+	t0.Add([]byte("foo"))
+	if stats := t0.GetTopEntries(10); len(stats.TopEntries) != 0 {
+		t.Fatalf("unexpected entries for nil tracker: %v", stats.TopEntries)
+	}
+	t0.Reset()
+}
+
+func TestTrackerRecordsMultipleMetricNames(t *testing.T) {
+	tr := NewTracker(100)
+
+	tr.Add([]byte("metric_a"))
+	tr.Add([]byte("metric_a"))
+	tr.Add([]byte("metric_a"))
+	tr.Add([]byte("metric_b"))
+	tr.Add([]byte("metric_b"))
+	tr.Add([]byte("metric_c"))
+
+	stats := tr.GetTopEntries(-1)
+	if got, want := stats.TrackedEntriesCount, 3; got != want {
+		t.Fatalf("unexpected TrackedEntriesCount: got %d, want %d", got, want)
+	}
+	counts := make(map[string]uint64)
+	for _, e := range stats.TopEntries {
+		counts[e.MetricName] = e.DroppedRowsCount
+	}
+	wantCounts := map[string]uint64{
+		"metric_a": 3,
+		"metric_b": 2,
+		"metric_c": 1,
+	}
+	for name, want := range wantCounts {
+		if got := counts[name]; got != want {
+			t.Fatalf("unexpected count for %q: got %d, want %d", name, got, want)
+		}
+	}
+}
+
+func TestTrackerGetTopEntriesOrderingAndLimit(t *testing.T) {
+	tr := NewTracker(100)
+
+	// metric_0 gets 0 hits, metric_1 gets 1 hit, ..., metric_9 gets 9 hits.
+	for i := range 10 {
+		name := []byte(fmt.Sprintf("metric_%d", i))
+		for range i {
+			tr.Add(name)
+		}
+	}
+	// metric_0 was never added, so only 9 distinct names should be tracked.
+
+	stats := tr.GetTopEntries(3)
+	if got, want := len(stats.TopEntries), 3; got != want {
+		t.Fatalf("unexpected number of top entries: got %d, want %d", got, want)
+	}
+	wantOrder := []string{"metric_9", "metric_8", "metric_7"}
+	for i, want := range wantOrder {
+		if got := stats.TopEntries[i].MetricName; got != want {
+			t.Fatalf("unexpected entry at position %d: got %q, want %q", i, got, want)
+		}
+	}
+	if got, want := stats.TopEntries[0].DroppedRowsCount, uint64(9); got != want {
+		t.Fatalf("unexpected DroppedRowsCount for top entry: got %d, want %d", got, want)
+	}
+	if got, want := stats.TrackedEntriesCount, 9; got != want {
+		t.Fatalf("unexpected TrackedEntriesCount: got %d, want %d", got, want)
+	}
+}
+
+func TestTrackerMemoryBoundIsRespected(t *testing.T) {
+	const maxEntries = 100
+	tr := NewTracker(maxEntries)
+
+	const numDistinctNames = 1_000_000
+	for i := range numDistinctNames {
+		tr.Add([]byte(fmt.Sprintf("metric_%d", i)))
+	}
+
+	stats := tr.GetTopEntries(-1)
+	if got := stats.TrackedEntriesCount; got > maxEntries {
+		t.Fatalf("tracker exceeded its memory bound: tracked %d entries, want at most %d", got, maxEntries)
+	}
+	if got, want := stats.TrackedEntriesCount, maxEntries; got != want {
+		t.Fatalf("unexpected TrackedEntriesCount: got %d, want %d", got, want)
+	}
+	wantOverflow := uint64(numDistinctNames - maxEntries)
+	if got := stats.OverflowDroppedRowsCount; got != wantOverflow {
+		t.Fatalf("unexpected OverflowDroppedRowsCount: got %d, want %d", got, wantOverflow)
+	}
+}
+
+func TestTrackerMemoryBoundUnderConcurrency(t *testing.T) {
+	const maxEntries = 50
+	tr := NewTracker(maxEntries)
+
+	const numGoroutines = 20
+	const numNamesPerGoroutine = 5000
+
+	var wg sync.WaitGroup
+	for g := range numGoroutines {
+		wg.Add(1)
+		go func(g int) {
+			defer wg.Done()
+			for i := range numNamesPerGoroutine {
+				tr.Add([]byte(fmt.Sprintf("metric_g%d_n%d", g, i)))
+			}
+		}(g)
+	}
+	wg.Wait()
+
+	stats := tr.GetTopEntries(-1)
+	if got := stats.TrackedEntriesCount; got > maxEntries {
+		t.Fatalf("tracker exceeded its memory bound under concurrency: tracked %d entries, want at most %d", got, maxEntries)
+	}
+}
+
+func TestTrackerReset(t *testing.T) {
+	tr := NewTracker(10)
+	tr.Add([]byte("metric_a"))
+	tr.Add([]byte("metric_b"))
+
+	stats := tr.GetTopEntries(-1)
+	if got, want := stats.TrackedEntriesCount, 2; got != want {
+		t.Fatalf("unexpected TrackedEntriesCount before reset: got %d, want %d", got, want)
+	}
+
+	tr.Reset()
+
+	stats = tr.GetTopEntries(-1)
+	if got, want := stats.TrackedEntriesCount, 0; got != want {
+		t.Fatalf("unexpected TrackedEntriesCount after reset: got %d, want %d", got, want)
+	}
+	if got, want := stats.OverflowDroppedRowsCount, uint64(0); got != want {
+		t.Fatalf("unexpected OverflowDroppedRowsCount after reset: got %d, want %d", got, want)
+	}
+}
+
+func TestTrackerOverflowThenRecoversAfterReset(t *testing.T) {
+	tr := NewTracker(2)
+
+	tr.Add([]byte("metric_a"))
+	tr.Add([]byte("metric_b"))
+	// The tracker is now full; metric_c should overflow instead of being tracked.
+	tr.Add([]byte("metric_c"))
+
+	stats := tr.GetTopEntries(-1)
+	if got, want := stats.TrackedEntriesCount, 2; got != want {
+		t.Fatalf("unexpected TrackedEntriesCount: got %d, want %d", got, want)
+	}
+	if got, want := stats.OverflowDroppedRowsCount, uint64(1); got != want {
+		t.Fatalf("unexpected OverflowDroppedRowsCount: got %d, want %d", got, want)
+	}
+
+	tr.Reset()
+	tr.Add([]byte("metric_c"))
+	stats = tr.GetTopEntries(-1)
+	if got, want := stats.TrackedEntriesCount, 1; got != want {
+		t.Fatalf("unexpected TrackedEntriesCount after reset: got %d, want %d", got, want)
+	}
+	if stats.TopEntries[0].MetricName != "metric_c" {
+		t.Fatalf("unexpected tracked metric name after reset: got %q, want %q", stats.TopEntries[0].MetricName, "metric_c")
+	}
+}
