+// seriesLimitExceededStatsHandler returns which metric names were responsible
+// for samples dropped because of -storage.maxHourlySeries / -storage.maxDailySeries.
+func (vms *VMStorage) seriesLimitExceededStatsHandler(w http.ResponseWriter, r *http.Request) {
+	topN := 10
+	if topNStr := r.FormValue("topN"); len(topNStr) > 0 {
+		n, err := strconv.Atoi(topNStr)
+		if err != nil {
+			jsonResponseError(w, fmt.Errorf("cannot parse `topN` arg %q: %w", topNStr, err))
+			return
+		}
+		topN = n
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	resp := seriesLimitExceededStatsResponse{
+		Status: "ok",
+		Hourly: newSeriesLimiterDroppedNamesStats(vms.s.GetHourlySeriesLimitDroppedNamesStats(topN)),
+		Daily:  newSeriesLimiterDroppedNamesStats(vms.s.GetDailySeriesLimitDroppedNamesStats(topN)),
+	}
+	if err := json.NewEncoder(w).Encode(resp); err != nil {
+		logger.Errorf("cannot write series_limit_exceeded_stats response: %s", err)
+	}
+}
+
+type seriesLimitExceededStatsResponse struct {
+	Status string                          `json:"status"`
+	Hourly *seriesLimiterDroppedNamesStats `json:"hourly"`
+	Daily  *seriesLimiterDroppedNamesStats `json:"daily"`
+}
+
+type seriesLimiterDroppedNamesStats struct {
+	CollectedSince           int64                           `json:"collectedSince"`
+	MaxTrackedNames          int                             `json:"maxTrackedNames"`
+	TrackedNamesCount        int                             `json:"trackedNamesCount"`
+	OverflowDroppedRowsCount uint64                          `json:"overflowDroppedRowsCount"`
+	TopNames                 []seriesLimiterDroppedNameEntry `json:"topNames"`
+}
+
+type seriesLimiterDroppedNameEntry struct {
+	MetricName       string `json:"metricName"`
+	DroppedRowsCount uint64 `json:"droppedRowsCount"`
+}
+
+func newSeriesLimiterDroppedNamesStats(stats droppedseries.Stats) *seriesLimiterDroppedNamesStats {
+	topNames := make([]seriesLimiterDroppedNameEntry, len(stats.TopEntries))
+	for i, e := range stats.TopEntries {
+		topNames[i] = seriesLimiterDroppedNameEntry{
+			MetricName:       e.MetricName,
+			DroppedRowsCount: e.DroppedRowsCount,
+		}
+	}
+	return &seriesLimiterDroppedNamesStats{
+		CollectedSince:           int64(stats.CollectedSince),
+		MaxTrackedNames:          stats.MaxEntries,
+		TrackedNamesCount:        stats.TrackedEntriesCount,
+		OverflowDroppedRowsCount: stats.OverflowDroppedRowsCount,
+		TopNames:                 topNames,
+	}
+}
+
