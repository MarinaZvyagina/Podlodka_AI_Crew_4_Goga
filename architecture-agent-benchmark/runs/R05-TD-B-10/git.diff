+func TestStorageSeriesLimitDroppedNamesStats(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const maxHourlySeries = 2
+	const maxDroppedSeriesNames = 100
+
+	s := MustOpenStorage(t.Name(), OpenOptions{
+		MaxHourlySeries:       maxHourlySeries,
+		MaxDroppedSeriesNames: maxDroppedSeriesNames,
+	})
+	defer s.MustClose()
+
+	timestamp := time.Now().UnixMilli()
+
+	// The first maxHourlySeries series (both named "cpu_usage") are accepted.
+	// Every series after that is dropped because of -storage.maxHourlySeries,
+	// and the metric name responsible for the drop is recorded:
+	//   cpu_usage:  3 dropped samples
+	//   mem_usage:  2 dropped samples
+	//   disk_usage: 1 dropped sample
+	var mrs []MetricRow
+	mrs = append(mrs, testGenerateMetricRowForName("cpu_usage", "instance-1", timestamp, 1))
+	mrs = append(mrs, testGenerateMetricRowForName("cpu_usage", "instance-2", timestamp, 1))
+	mrs = append(mrs, testGenerateMetricRowForName("cpu_usage", "instance-3", timestamp, 1))
+	mrs = append(mrs, testGenerateMetricRowForName("cpu_usage", "instance-4", timestamp, 1))
+	mrs = append(mrs, testGenerateMetricRowForName("cpu_usage", "instance-5", timestamp, 1))
+	mrs = append(mrs, testGenerateMetricRowForName("mem_usage", "instance-1", timestamp, 1))
+	mrs = append(mrs, testGenerateMetricRowForName("mem_usage", "instance-2", timestamp, 1))
+	mrs = append(mrs, testGenerateMetricRowForName("disk_usage", "instance-1", timestamp, 1))
+
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if got, want := m.HourlySeriesLimitRowsDropped, uint64(6); got != want {
+		t.Fatalf("unexpected Metrics.HourlySeriesLimitRowsDropped: got %d, want %d", got, want)
+	}
+	if got, want := m.HourlySeriesLimitDroppedNamesTrackedCount, uint64(3); got != want {
+		t.Fatalf("unexpected Metrics.HourlySeriesLimitDroppedNamesTrackedCount: got %d, want %d", got, want)
+	}
+	if got := m.HourlySeriesLimitDroppedNamesOverflowRowsCount; got != 0 {
+		t.Fatalf("unexpected Metrics.HourlySeriesLimitDroppedNamesOverflowRowsCount: got %d, want 0", got)
+	}
+
+	stats := s.GetHourlySeriesLimitDroppedNamesStats(2)
+	if got, want := len(stats.TopEntries), 2; got != want {
+		t.Fatalf("unexpected number of top entries: got %d, want %d", got, want)
+	}
+	if got, want := stats.TopEntries[0].MetricName, "cpu_usage"; got != want {
+		t.Fatalf("unexpected top entry name: got %q, want %q", got, want)
+	}
+	if got, want := stats.TopEntries[0].DroppedRowsCount, uint64(3); got != want {
+		t.Fatalf("unexpected top entry count: got %d, want %d", got, want)
+	}
+	if got, want := stats.TopEntries[1].MetricName, "mem_usage"; got != want {
+		t.Fatalf("unexpected second entry name: got %q, want %q", got, want)
+	}
+	if got, want := stats.TopEntries[1].DroppedRowsCount, uint64(2); got != want {
+		t.Fatalf("unexpected second entry count: got %d, want %d", got, want)
+	}
+
+	// The daily limiter wasn't configured, so its stats must stay empty.
+	dailyStats := s.GetDailySeriesLimitDroppedNamesStats(10)
+	if len(dailyStats.TopEntries) != 0 {
+		t.Fatalf("unexpected non-empty daily dropped names stats: %v", dailyStats.TopEntries)
+	}
+
+	// After a reset, the tracker no longer reports the previously dropped names.
+	s.ResetSeriesLimitDroppedNamesStats()
+	stats = s.GetHourlySeriesLimitDroppedNamesStats(10)
+	if len(stats.TopEntries) != 0 {
+		t.Fatalf("unexpected non-empty dropped names stats after reset: %v", stats.TopEntries)
+	}
+}
