+func TestStorageSeriesLimitDroppedNamesStats_MemoryBound(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const maxHourlySeries = 1
+	const maxDroppedSeriesNames = 10
+
+	s := MustOpenStorage(t.Name(), OpenOptions{
+		MaxHourlySeries:       maxHourlySeries,
+		MaxDroppedSeriesNames: maxDroppedSeriesNames,
+	})
+	defer s.MustClose()
+
+	timestamp := time.Now().UnixMilli()
+
+	const numDistinctNames = 1000
+	var mrs []MetricRow
+	for i := range numDistinctNames {
+		mrs = append(mrs, testGenerateMetricRowForName(fmt.Sprintf("metric_%d", i), "instance-1", timestamp, 1))
+	}
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if got := m.HourlySeriesLimitDroppedNamesTrackedCount; got > maxDroppedSeriesNames {
+		t.Fatalf("dropped names tracker exceeded its memory bound: tracked %d names, want at most %d", got, maxDroppedSeriesNames)
+	}
+	if got, want := m.HourlySeriesLimitDroppedNamesTrackedCount, uint64(maxDroppedSeriesNames); got != want {
+		t.Fatalf("unexpected Metrics.HourlySeriesLimitDroppedNamesTrackedCount: got %d, want %d", got, want)
+	}
+	wantOverflow := uint64(numDistinctNames - maxHourlySeries - maxDroppedSeriesNames)
+	if got := m.HourlySeriesLimitDroppedNamesOverflowRowsCount; got != wantOverflow {
+		t.Fatalf("unexpected Metrics.HourlySeriesLimitDroppedNamesOverflowRowsCount: got %d, want %d", got, wantOverflow)
+	}
+}
