+// testGenerateMetricRowForName generates a single MetricRow with the given
+// metric name and instance tag value.
+func testGenerateMetricRowForName(metricName, instance string, timestamp int64, value float64) MetricRow {
+	var mn MetricName
+	mn.MetricGroup = []byte(metricName)
+	mn.Tags = []Tag{
+		{[]byte("instance"), []byte(instance)},
+	}
+	return MetricRow{
+		MetricNameRaw: mn.marshalRaw(nil),
+		Timestamp:     timestamp,
+		Value:         value,
+	}
+}
