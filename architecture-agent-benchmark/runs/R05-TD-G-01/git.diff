+func TestStorageSeriesLimitExceededStats(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const (
+		maxHourlySeries = 500
+		countA          = 600  // exceeds the hourly budget on its own, so the budget is guaranteed to be exhausted by the time metric_b starts.
+		countB          = 1000 // inserted once the budget is already exhausted; virtually all rows are dropped.
+		countC          = 3000 // inserted once the budget is already exhausted; virtually all rows are dropped.
+	)
+
+	// The hourly limiter is a probabilistic bloom filter (see lib/bloomfilter),
+	// so a tiny fraction of rows that should be dropped may slip through as
+	// false positives. assertApprox tolerates that noise while still catching
+	// real regressions in the per-metric-name accounting.
+	assertApprox := func(t *testing.T, label string, got, want uint64) {
+		t.Helper()
+		minWant := want - want/20 - 5
+		if got > want || got < minWant {
+			t.Fatalf("unexpected %s: got %d, want in range [%d, %d]", label, got, minWant, want)
+		}
+	}
+
+	// genRows returns count rows sharing metricName but with distinct `instance`
+	// label values, so that each row belongs to a distinct series.
+	genRows := func(metricName string, count int, minTimestamp int64) []MetricRow {
+		mrs := make([]MetricRow, count)
+		var mn MetricName
+		mn.MetricGroup = []byte(metricName)
+		for i := range count {
+			mn.Tags = []Tag{
+				{Key: []byte("instance"), Value: fmt.Appendf(nil, "instance_%d", i)},
+			}
+			mrs[i] = MetricRow{
+				MetricNameRaw: mn.marshalRaw(nil),
+				Timestamp:     minTimestamp,
+				Value:         float64(i),
+			}
+		}
+		return mrs
+	}
+
+	minTimestamp := time.Now().UnixMilli()
+
+	var mrs []MetricRow
+	mrs = append(mrs, genRows("metric_a", countA, minTimestamp)...)
+	mrs = append(mrs, genRows("metric_b", countB, minTimestamp)...)
+	mrs = append(mrs, genRows("metric_c", countC, minTimestamp)...)
+
+	t.Run("TrackingEnabled", func(t *testing.T) {
+		opts := OpenOptions{
+			MaxHourlySeries:               maxHourlySeries,
+			TrackSeriesLimitExceededStats: true,
+		}
+		s := MustOpenStorage(t.Name(), opts)
+		defer s.MustClose()
+
+		s.AddRows(mrs, defaultPrecisionBits)
+		s.DebugFlush()
+
+		var m Metrics
+		s.UpdateMetrics(&m)
+		// metric_a also loses some rows to the limiter once its own count exceeds
+		// maxHourlySeries, so the total is at least countB+countC and at most the
+		// full row count.
+		if got := m.HourlySeriesLimitRowsDropped; got < uint64(countB+countC) || got > uint64(countA+countB+countC) {
+			t.Fatalf("unexpected Metrics.HourlySeriesLimitRowsDropped: got %d, want in range [%d, %d]", got, countB+countC, countA+countB+countC)
+		}
+
+		// The tracker isn't bound in this test, so the sum of all the tracked
+		// per-name counts must equal the aggregate dropped-rows counter.
+		allRecords := s.GetHourlySeriesLimitExceededStats(0)
+		var totalFromRecords uint64
+		for _, r := range allRecords {
+			totalFromRecords += r.RowsDropped
+		}
+		if totalFromRecords != m.HourlySeriesLimitRowsDropped {
+			t.Fatalf("sum of per-name dropped rows counts (%d) doesn't match Metrics.HourlySeriesLimitRowsDropped (%d)", totalFromRecords, m.HourlySeriesLimitRowsDropped)
+		}
+
+		// metric_b and metric_c are entirely inserted after the budget is
+		// exhausted, so their drop counts are close to their full row counts and,
+		// being bigger than whatever overflowed from metric_a, they must be the
+		// top two offenders in that order.
+		top2 := s.GetHourlySeriesLimitExceededStats(2)
+		if len(top2) != 2 {
+			t.Fatalf("unexpected number of records returned by GetHourlySeriesLimitExceededStats(2): got %d, want 2 (%v)", len(top2), top2)
+		}
+		if got, want := top2[0].MetricName, "metric_c"; got != want {
+			t.Fatalf("unexpected top offender: got %q, want %q", got, want)
+		}
+		if got, want := top2[1].MetricName, "metric_b"; got != want {
+			t.Fatalf("unexpected second offender: got %q, want %q", got, want)
+		}
+		assertApprox(t, "metric_c RowsDropped", top2[0].RowsDropped, countC)
+		assertApprox(t, "metric_b RowsDropped", top2[1].RowsDropped, countB)
+
+		// topN must limit the result to the single biggest offender.
+		if got := s.GetHourlySeriesLimitExceededStats(1); len(got) != 1 || got[0].MetricName != "metric_c" {
+			t.Fatalf("unexpected GetHourlySeriesLimitExceededStats(1) result: %v", got)
+		}
+
+		// The daily limiter is disabled, so no daily stats should ever be tracked.
+		if got := s.GetDailySeriesLimitExceededStats(0); got != nil {
+			t.Fatalf("unexpected non-nil daily stats when the daily limiter is disabled: %v", got)
+		}
+
+		// ResetSeriesLimitExceededStats must clear the collected stats.
+		s.ResetSeriesLimitExceededStats()
+		if got := s.GetHourlySeriesLimitExceededStats(0); len(got) != 0 {
+			t.Fatalf("unexpected non-empty stats after ResetSeriesLimitExceededStats: %v", got)
+		}
+	})
+
+	t.Run("TrackingDisabled", func(t *testing.T) {
+		opts := OpenOptions{
+			MaxHourlySeries:               maxHourlySeries,
+			TrackSeriesLimitExceededStats: false,
+		}
+		s := MustOpenStorage(t.Name(), opts)
+		defer s.MustClose()
+
+		s.AddRows(mrs, defaultPrecisionBits)
+		s.DebugFlush()
+
+		var m Metrics
+		s.UpdateMetrics(&m)
+		if got := m.HourlySeriesLimitRowsDropped; got < uint64(countB+countC) || got > uint64(countA+countB+countC) {
+			t.Fatalf("unexpected Metrics.HourlySeriesLimitRowsDropped: got %d, want in range [%d, %d]", got, countB+countC, countA+countB+countC)
+		}
+
+		// Rows are still dropped by the limiter as usual, but no per-name stats are collected.
+		if got := s.GetHourlySeriesLimitExceededStats(0); got != nil {
+			t.Fatalf("unexpected non-nil stats when tracking is disabled: %v", got)
+		}
+	})
+}
