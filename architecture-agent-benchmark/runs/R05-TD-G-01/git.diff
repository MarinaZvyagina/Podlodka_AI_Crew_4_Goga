diff --git a/lib/storage/limiter_exceeded_stats.go b/lib/storage/limiter_exceeded_stats.go
new file mode 100644
index 0000000..5af5954
--- /dev/null
+++ b/lib/storage/limiter_exceeded_stats.go
@@ -0,0 +1,172 @@
+package storage
+
+import (
+	"fmt"
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/bytesutil"
+)
+
+// defaultMaxSeriesLimitExceededStatsEntries is the default number of distinct
+// metric names tracked by seriesLimitExceededStats.
+//
+// This bounds the memory usage of the tracker on installations with millions
+// of distinct metric names hitting -storage.maxHourlySeries or -storage.maxDailySeries.
+const defaultMaxSeriesLimitExceededStatsEntries = 1000
+
+// seriesLimitExceededStats tracks, per metric name, the number of samples
+// dropped because adding the corresponding series would have exceeded
+// -storage.maxHourlySeries or -storage.maxDailySeries.
+//
+// The tracker is bounded to maxEntries distinct metric names in order to
+// avoid unbounded memory growth on installations with a big number of
+// distinct metric names hitting the limit. Once the bound is reached,
+// samples for metric names which aren't already tracked are no longer
+// accounted for (the samples themselves are still dropped from the storage
+// as usual - only the per-name accounting is skipped).
+//
+// A nil *seriesLimitExceededStats is valid and behaves as a disabled tracker.
+type seriesLimitExceededStats struct {
+	maxEntries int
+
+	mu sync.Mutex
+	m  map[string]*atomic.Uint64
+}
+
+// newSeriesLimitExceededStats creates a stats tracker bounded to maxEntries
+// distinct metric names. If maxEntries <= 0, defaultMaxSeriesLimitExceededStatsEntries is used.
+func newSeriesLimitExceededStats(maxEntries int) *seriesLimitExceededStats {
+	if maxEntries <= 0 {
+		maxEntries = defaultMaxSeriesLimitExceededStatsEntries
+	}
+	return &seriesLimitExceededStats{
+		maxEntries: maxEntries,
+		m:          make(map[string]*atomic.Uint64),
+	}
+}
+
+// Inc increments the drop counter for the given metric name.
+//
+// It is a no-op if s is nil, i.e. tracking is disabled.
+func (s *seriesLimitExceededStats) Inc(metricName []byte) {
+	if s == nil {
+		return
+	}
+	key := bytesutil.ToUnsafeString(metricName)
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	if n, ok := s.m[key]; ok {
+		n.Add(1)
+		return
+	}
+	if len(s.m) >= s.maxEntries {
+		// The bound on the number of tracked metric names has been reached.
+		// Do not track new metric names in order to avoid unbounded memory growth.
+		return
+	}
+	n := &atomic.Uint64{}
+	n.Store(1)
+	s.m[string(metricName)] = n
+}
+
+// SeriesLimitExceededRecord is a single per-metric-name entry returned by seriesLimitExceededStats.GetTopRecords.
+type SeriesLimitExceededRecord struct {
+	// MetricName is the metric name (the value of the __name__ label).
+	MetricName string
+
+	// RowsDropped is the number of samples dropped for MetricName.
+	RowsDropped uint64
+}
+
+// GetTopRecords returns up to topN SeriesLimitExceededRecord entries sorted by RowsDropped in descending order.
+//
+// It returns nil if s is nil, i.e. tracking is disabled. If topN <= 0, all the tracked records are returned.
+func (s *seriesLimitExceededStats) GetTopRecords(topN int) []SeriesLimitExceededRecord {
+	if s == nil {
+		return nil
+	}
+
+	s.mu.Lock()
+	records := make([]SeriesLimitExceededRecord, 0, len(s.m))
+	for k, v := range s.m {
+		records = append(records, SeriesLimitExceededRecord{
+			MetricName:  k,
+			RowsDropped: v.Load(),
+		})
+	}
+	s.mu.Unlock()
+
+	sort.Slice(records, func(i, j int) bool {
+		if records[i].RowsDropped != records[j].RowsDropped {
+			return records[i].RowsDropped > records[j].RowsDropped
+		}
+		return records[i].MetricName < records[j].MetricName
+	})
+	if topN > 0 && topN < len(records) {
+		records = records[:topN]
+	}
+	return records
+}
+
+// Reset clears all the tracked stats.
+func (s *seriesLimitExceededStats) Reset() {
+	if s == nil {
+		return
+	}
+	s.mu.Lock()
+	s.m = make(map[string]*atomic.Uint64)
+	s.mu.Unlock()
+}
+
+// EntriesCount returns the number of distinct metric names currently tracked.
+func (s *seriesLimitExceededStats) EntriesCount() int {
+	if s == nil {
+		return 0
+	}
+	s.mu.Lock()
+	n := len(s.m)
+	s.mu.Unlock()
+	return n
+}
+
+// MaxEntries returns the configured bound on the number of distinct metric names tracked.
+func (s *seriesLimitExceededStats) MaxEntries() int {
+	if s == nil {
+		return 0
+	}
+	return s.maxEntries
+}
+
+// getMetricGroupFromRaw returns the metric name (the value of the __name__
+// label) from metricNameRaw, which is expected to be encoded via MarshalMetricNameRaw.
+//
+// Unlike MetricName.UnmarshalRaw, this doesn't parse the rest of the tags,
+// since only the metric name is needed here. This matters on the series
+// limiter drop path, which can be hit at a high rate when ingestion churn
+// exceeds -storage.maxHourlySeries / -storage.maxDailySeries.
+//
+// The returned slice references src and is valid only as long as src isn't reused or modified.
+func getMetricGroupFromRaw(src []byte) ([]byte, error) {
+	for len(src) > 0 {
+		tail, key, err := unmarshalBytesFast(src)
+		if err != nil {
+			return nil, fmt.Errorf("cannot decode key: %w", err)
+		}
+		src = tail
+
+		tail, value, err := unmarshalBytesFast(src)
+		if err != nil {
+			return nil, fmt.Errorf("cannot decode value: %w", err)
+		}
+		src = tail
+
+		if len(key) == 0 {
+			return value, nil
+		}
+	}
+	return nil, nil
+}
diff --git a/lib/storage/limiter_exceeded_stats_test.go b/lib/storage/limiter_exceeded_stats_test.go
new file mode 100644
index 0000000..ead11d5
--- /dev/null
+++ b/lib/storage/limiter_exceeded_stats_test.go
@@ -0,0 +1,155 @@
+package storage
+
+import (
+	"fmt"
+	"reflect"
+	"testing"
+)
+
+func TestSeriesLimitExceededStats_Nil(t *testing.T) {
+	var s *seriesLimitExceededStats
+
+	// Must not panic and must behave as a disabled tracker.
+	s.Inc([]byte("foo"))
+	if got := s.GetTopRecords(10); got != nil {
+		t.Fatalf("unexpected non-nil result from nil tracker: %v", got)
+	}
+	if got := s.EntriesCount(); got != 0 {
+		t.Fatalf("unexpected EntriesCount for nil tracker: got %d, want 0", got)
+	}
+	if got := s.MaxEntries(); got != 0 {
+		t.Fatalf("unexpected MaxEntries for nil tracker: got %d, want 0", got)
+	}
+	s.Reset()
+}
+
+func TestSeriesLimitExceededStats_IncAndGetTopRecords(t *testing.T) {
+	s := newSeriesLimitExceededStats(100)
+
+	// Record a different number of drops for several distinct metric names.
+	counts := map[string]int{
+		"metric_a": 5,
+		"metric_b": 1,
+		"metric_c": 10,
+		"metric_d": 3,
+	}
+	for name, n := range counts {
+		for range n {
+			s.Inc([]byte(name))
+		}
+	}
+
+	if got := s.EntriesCount(); got != len(counts) {
+		t.Fatalf("unexpected EntriesCount: got %d, want %d", got, len(counts))
+	}
+
+	// Verify the full ordering: highest drop count first, ties broken by name.
+	got := s.GetTopRecords(0)
+	want := []SeriesLimitExceededRecord{
+		{MetricName: "metric_c", RowsDropped: 10},
+		{MetricName: "metric_a", RowsDropped: 5},
+		{MetricName: "metric_d", RowsDropped: 3},
+		{MetricName: "metric_b", RowsDropped: 1},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("unexpected GetTopRecords(0) result\ngot\n%v\nwant\n%v", got, want)
+	}
+
+	// Verify topN limits the number of returned records to the biggest offenders.
+	top2 := s.GetTopRecords(2)
+	want2 := want[:2]
+	if !reflect.DeepEqual(top2, want2) {
+		t.Fatalf("unexpected GetTopRecords(2) result\ngot\n%v\nwant\n%v", top2, want2)
+	}
+
+	// Verify Reset clears the state.
+	s.Reset()
+	if got := s.EntriesCount(); got != 0 {
+		t.Fatalf("unexpected EntriesCount after Reset: got %d, want 0", got)
+	}
+	if got := s.GetTopRecords(10); len(got) != 0 {
+		t.Fatalf("unexpected GetTopRecords after Reset: %v", got)
+	}
+}
+
+func TestSeriesLimitExceededStats_MaxEntriesRespected(t *testing.T) {
+	const maxEntries = 10
+	s := newSeriesLimitExceededStats(maxEntries)
+
+	// Record drops for far more distinct metric names than the configured bound.
+	for i := range 10 * maxEntries {
+		s.Inc(fmt.Appendf(nil, "metric_%d", i))
+	}
+
+	if got := s.EntriesCount(); got != maxEntries {
+		t.Fatalf("unexpected EntriesCount: got %d, want %d (the tracker must not grow past its bound)", got, maxEntries)
+	}
+	if got := len(s.GetTopRecords(0)); got != maxEntries {
+		t.Fatalf("unexpected number of records returned: got %d, want %d", got, maxEntries)
+	}
+
+	// Already-tracked metric names must keep accumulating even after the bound is reached.
+	records := s.GetTopRecords(0)
+	trackedName := records[0].MetricName
+	prevCount := records[0].RowsDropped
+	s.Inc([]byte(trackedName))
+	records = s.GetTopRecords(0)
+	var newCount uint64
+	for _, r := range records {
+		if r.MetricName == trackedName {
+			newCount = r.RowsDropped
+		}
+	}
+	if newCount != prevCount+1 {
+		t.Fatalf("expected already-tracked metric name to keep accumulating: got %d, want %d", newCount, prevCount+1)
+	}
+	if got := s.EntriesCount(); got != maxEntries {
+		t.Fatalf("unexpected EntriesCount after re-incrementing a tracked entry: got %d, want %d", got, maxEntries)
+	}
+}
+
+func TestSeriesLimitExceededStats_DefaultMaxEntries(t *testing.T) {
+	s := newSeriesLimitExceededStats(0)
+	if got := s.MaxEntries(); got != defaultMaxSeriesLimitExceededStatsEntries {
+		t.Fatalf("unexpected default MaxEntries: got %d, want %d", got, defaultMaxSeriesLimitExceededStatsEntries)
+	}
+
+	s = newSeriesLimitExceededStats(-1)
+	if got := s.MaxEntries(); got != defaultMaxSeriesLimitExceededStatsEntries {
+		t.Fatalf("unexpected default MaxEntries for negative input: got %d, want %d", got, defaultMaxSeriesLimitExceededStatsEntries)
+	}
+}
+
+func TestGetMetricGroupFromRaw(t *testing.T) {
+	f := func(mn *MetricName, resultExpected string) {
+		t.Helper()
+		raw := mn.marshalRaw(nil)
+		mg, err := getMetricGroupFromRaw(raw)
+		if err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if string(mg) != resultExpected {
+			t.Fatalf("unexpected metric group: got %q, want %q", mg, resultExpected)
+		}
+	}
+
+	f(&MetricName{
+		MetricGroup: []byte("foobar"),
+	}, "foobar")
+
+	f(&MetricName{
+		MetricGroup: []byte("foobar"),
+		Tags: []Tag{
+			{[]byte("job"), []byte("webservice")},
+			{[]byte("instance"), []byte("1.2.3.4")},
+		},
+	}, "foobar")
+
+	if _, err := getMetricGroupFromRaw(nil); err != nil {
+		t.Fatalf("unexpected error for empty input: %s", err)
+	}
+
+	if _, err := getMetricGroupFromRaw([]byte("garbage")); err == nil {
+		t.Fatalf("expected error for invalid input")
+	}
+}
