+// TestStorage_SeriesLimitRowsDroppedByName verifies that rows dropped because of
+// -storage.maxHourlySeries are tracked per metric name and can be queried back.
+func TestStorage_SeriesLimitRowsDroppedByName(t *testing.T) {
+	defer testRemoveAll(t)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+
+	const maxHourlySeries = 10
+	opts := OpenOptions{
+		MaxHourlySeries:                   maxHourlySeries,
+		TrackSeriesLimitRowsDroppedByName: true,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	// Fill up the hourly series limit with unique series first, so that every
+	// row inserted afterwards is guaranteed to be rejected.
+	fillerMrs := testGenerateMetricRows(rng, maxHourlySeries, minTimestamp, maxTimestamp)
+	s.AddRows(fillerMrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	// Push rows for a handful of distinct, previously-unseen metric names.
+	// All of them must be rejected because the hourly series limit has already been reached.
+	overflow := []struct {
+		name  string
+		count int
+	}{
+		{"overflow_metric_a", 5},
+		{"overflow_metric_b", 3},
+		{"overflow_metric_c", 1},
+	}
+	var mn MetricName
+	mn.Tags = []Tag{{[]byte("job"), []byte("webservice")}}
+	var mrs []MetricRow
+	for _, o := range overflow {
+		mn.MetricGroup = []byte(o.name)
+		metricNameRaw := mn.marshalRaw(nil)
+		for range o.count {
+			timestamp := rng.Int63n(maxTimestamp-minTimestamp) + minTimestamp
+			mrs = append(mrs, MetricRow{
+				MetricNameRaw: metricNameRaw,
+				Timestamp:     timestamp,
+				Value:         rng.NormFloat64(),
+			})
+		}
+	}
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped != 9 {
+		t.Fatalf("unexpected Metrics.HourlySeriesLimitRowsDropped: got %d, want 9", m.HourlySeriesLimitRowsDropped)
+	}
+
+	sr := s.GetSeriesLimitRowsDroppedByName(0)
+	got := make(map[string]uint64, len(sr.Entries))
+	for _, e := range sr.Entries {
+		got[e.MetricName] = e.DroppedRowsCount
+	}
+	for _, o := range overflow {
+		if want := uint64(o.count); got[o.name] != want {
+			t.Fatalf("unexpected dropped rows count for %q: got %d, want %d", o.name, got[o.name], want)
+		}
+	}
+
+	// The single top offender must be the metric name with the highest drop count.
+	top1 := s.GetSeriesLimitRowsDroppedByName(1)
+	if len(top1.Entries) != 1 || top1.Entries[0].MetricName != "overflow_metric_a" || top1.Entries[0].DroppedRowsCount != 5 {
+		t.Fatalf("unexpected top entry: %+v", top1.Entries)
+	}
+
+	// Reset must clear the collected stats.
+	s.ResetSeriesLimitRowsDroppedByName()
+	if sr := s.GetSeriesLimitRowsDroppedByName(0); len(sr.Entries) != 0 {
+		t.Fatalf("expected no entries right after reset, got %v", sr.Entries)
+	}
+}
