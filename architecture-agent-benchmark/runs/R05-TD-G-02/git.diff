+// GetSeriesLimitRowsDroppedByName returns up to topN metric names with the highest number
+// of rows dropped because of -storage.maxHourlySeries or -storage.maxDailySeries, sorted
+// in descending order by the number of dropped rows.
+//
+// If topN <= 0, all the tracked metric names are returned.
+//
+// It returns an empty result if TrackSeriesLimitRowsDroppedByName wasn't enabled
+// via OpenOptions.
+func (s *Storage) GetSeriesLimitRowsDroppedByName(topN int) droppedseriesstats.StatsResult {
+	return s.seriesLimitRowsDroppedByName.GetTopEntries(topN)
+}
+
+// ResetSeriesLimitRowsDroppedByName resets the stats collected by GetSeriesLimitRowsDroppedByName.
+func (s *Storage) ResetSeriesLimitRowsDroppedByName() {
+	s.seriesLimitRowsDroppedByName.Reset()
+}
