diff --git a/lib/storage/droppedseriesstats/tracker.go b/lib/storage/droppedseriesstats/tracker.go
new file mode 100644
index 0000000..ba254e9
--- /dev/null
+++ b/lib/storage/droppedseriesstats/tracker.go
@@ -0,0 +1,180 @@
+// Package droppedseriesstats tracks, per metric name, how many samples were
+// dropped because adding the corresponding series would have exceeded the
+// configured -storage.maxHourlySeries or -storage.maxDailySeries limit.
+//
+// It exists to help answer support questions like "which metric name(s) are
+// responsible for us hitting our series-limit settings", without requiring
+// access to the customer's own instrumentation.
+package droppedseriesstats
+
+import (
+	"sort"
+	"sync"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/bytesutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+// entryOverhead is a rough estimate of the per-entry memory overhead of
+// Tracker.m, covering the map bucket, the string header for the key
+// and the counter itself.
+const entryOverhead = 64
+
+// Tracker tracks the number of dropped rows per metric name.
+//
+// In order to avoid unbounded memory growth for installations with millions
+// of distinct metric names, Tracker is bounded by maxSizeBytes: once that
+// budget is exhausted, rows dropped for metric names that aren't already
+// tracked stop being recorded until the next Reset.
+//
+// It is safe to call Tracker methods from concurrent goroutines.
+// It is safe to call methods on a nil *Tracker - they are no-ops in this case,
+// so the feature can be disabled with zero overhead by simply not creating a Tracker.
+type Tracker struct {
+	maxSizeBytes uint64
+
+	mu               sync.RWMutex
+	m                map[string]*counter
+	currentSizeBytes uint64
+	collectedSinceTs uint64
+}
+
+type counter struct {
+	n uint64
+}
+
+// NewTracker creates a Tracker, which can track dropped rows for distinct metric
+// names while using no more than maxSizeBytes bytes of memory.
+func NewTracker(maxSizeBytes uint64) *Tracker {
+	t := &Tracker{
+		maxSizeBytes: maxSizeBytes,
+	}
+	t.resetLocked()
+	return t
+}
+
+func (t *Tracker) resetLocked() {
+	t.m = make(map[string]*counter)
+	t.currentSizeBytes = 0
+	t.collectedSinceTs = fasttime.UnixTimestamp()
+}
+
+// IncrementDropped increments the number of dropped rows for the given metricName by 1.
+func (t *Tracker) IncrementDropped(metricName []byte) {
+	if t == nil {
+		return
+	}
+
+	t.mu.RLock()
+	c := t.m[bytesutil.ToUnsafeString(metricName)]
+	t.mu.RUnlock()
+	if c != nil {
+		t.mu.Lock()
+		c.n++
+		t.mu.Unlock()
+		return
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	// Re-check under the write lock, since the entry could have been added
+	// by a concurrent call between the RUnlock above and this Lock.
+	if c := t.m[bytesutil.ToUnsafeString(metricName)]; c != nil {
+		c.n++
+		return
+	}
+
+	entrySizeBytes := uint64(len(metricName)) + entryOverhead
+	if t.currentSizeBytes+entrySizeBytes > t.maxSizeBytes {
+		// The tracker is full - do not track new metric names in order
+		// to avoid unbounded memory growth.
+		return
+	}
+	t.m[string(metricName)] = &counter{n: 1}
+	t.currentSizeBytes += entrySizeBytes
+}
+
+// Entry is a single per-metric-name dropped rows counter.
+type Entry struct {
+	// MetricName is the metric name (aka __name__) the dropped rows belonged to.
+	MetricName string
+
+	// DroppedRowsCount is the number of rows dropped for MetricName.
+	DroppedRowsCount uint64
+}
+
+// StatsResult is the result of a GetTopEntries call.
+type StatsResult struct {
+	// CollectedSinceTs is the unix timestamp in seconds since which the stats were collected,
+	// i.e. the time of Tracker creation or the last Reset call.
+	CollectedSinceTs uint64
+
+	// Entries contains up to the requested number of top offenders, sorted by
+	// DroppedRowsCount in descending order.
+	Entries []Entry
+}
+
+// GetTopEntries returns up to topN Entries with the highest DroppedRowsCount,
+// sorted in descending order by DroppedRowsCount.
+//
+// If topN <= 0, all the tracked entries are returned.
+func (t *Tracker) GetTopEntries(topN int) StatsResult {
+	if t == nil {
+		return StatsResult{}
+	}
+
+	t.mu.RLock()
+	entries := make([]Entry, 0, len(t.m))
+	for name, c := range t.m {
+		entries = append(entries, Entry{
+			MetricName:       name,
+			DroppedRowsCount: c.n,
+		})
+	}
+	collectedSinceTs := t.collectedSinceTs
+	t.mu.RUnlock()
+
+	sort.Slice(entries, func(i, j int) bool {
+		if entries[i].DroppedRowsCount != entries[j].DroppedRowsCount {
+			return entries[i].DroppedRowsCount > entries[j].DroppedRowsCount
+		}
+		return entries[i].MetricName < entries[j].MetricName
+	})
+	if topN > 0 && topN < len(entries) {
+		entries = entries[:topN]
+	}
+	return StatsResult{
+		CollectedSinceTs: collectedSinceTs,
+		Entries:          entries,
+	}
+}
+
+// Reset drops all the collected stats and starts tracking from scratch.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.resetLocked()
+	t.mu.Unlock()
+}
+
+// TrackerMetrics holds internal metrics of Tracker for observability purposes.
+type TrackerMetrics struct {
+	CurrentSizeBytes  uint64
+	CurrentItemsCount uint64
+	MaxSizeBytes      uint64
+}
+
+// UpdateMetrics writes internal metrics of t to dst.
+func (t *Tracker) UpdateMetrics(dst *TrackerMetrics) {
+	if t == nil {
+		return
+	}
+	t.mu.RLock()
+	dst.CurrentSizeBytes = t.currentSizeBytes
+	dst.CurrentItemsCount = uint64(len(t.m))
+	t.mu.RUnlock()
+	dst.MaxSizeBytes = t.maxSizeBytes
+}
diff --git a/lib/storage/droppedseriesstats/tracker_test.go b/lib/storage/droppedseriesstats/tracker_test.go
new file mode 100644
index 0000000..24961ff
--- /dev/null
+++ b/lib/storage/droppedseriesstats/tracker_test.go
@@ -0,0 +1,157 @@
+package droppedseriesstats
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestTracker_Nil(t *testing.T) {
+	var tr *Tracker
+	tr.IncrementDropped([]byte("foo"))
+	tr.Reset()
+	if sr := tr.GetTopEntries(10); len(sr.Entries) != 0 {
+		t.Fatalf("unexpected entries for nil tracker: %v", sr.Entries)
+	}
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+	if tm != (TrackerMetrics{}) {
+		t.Fatalf("unexpected non-zero metrics for nil tracker: %+v", tm)
+	}
+}
+
+func TestTracker_RecordsMultipleMetricNames(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	tr.IncrementDropped([]byte("metric_a"))
+	tr.IncrementDropped([]byte("metric_a"))
+	tr.IncrementDropped([]byte("metric_a"))
+	tr.IncrementDropped([]byte("metric_b"))
+	tr.IncrementDropped([]byte("metric_c"))
+	tr.IncrementDropped([]byte("metric_c"))
+
+	sr := tr.GetTopEntries(0)
+	got := make(map[string]uint64, len(sr.Entries))
+	for _, e := range sr.Entries {
+		got[e.MetricName] = e.DroppedRowsCount
+	}
+	want := map[string]uint64{
+		"metric_a": 3,
+		"metric_b": 1,
+		"metric_c": 2,
+	}
+	if len(got) != len(want) {
+		t.Fatalf("unexpected number of entries; got %v; want %v", got, want)
+	}
+	for name, cnt := range want {
+		if got[name] != cnt {
+			t.Fatalf("unexpected count for %q; got %d; want %d", name, got[name], cnt)
+		}
+	}
+}
+
+func TestTracker_GetTopEntries(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	counts := map[string]int{
+		"metric_a": 5,
+		"metric_b": 10,
+		"metric_c": 1,
+		"metric_d": 7,
+	}
+	for name, cnt := range counts {
+		for i := 0; i < cnt; i++ {
+			tr.IncrementDropped([]byte(name))
+		}
+	}
+
+	sr := tr.GetTopEntries(2)
+	if len(sr.Entries) != 2 {
+		t.Fatalf("unexpected number of top entries: %d", len(sr.Entries))
+	}
+	if sr.Entries[0].MetricName != "metric_b" || sr.Entries[0].DroppedRowsCount != 10 {
+		t.Fatalf("unexpected top entry: %+v", sr.Entries[0])
+	}
+	if sr.Entries[1].MetricName != "metric_d" || sr.Entries[1].DroppedRowsCount != 7 {
+		t.Fatalf("unexpected second entry: %+v", sr.Entries[1])
+	}
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+	tr.IncrementDropped([]byte("metric_a"))
+	tr.IncrementDropped([]byte("metric_b"))
+
+	if sr := tr.GetTopEntries(0); len(sr.Entries) != 2 {
+		t.Fatalf("expected 2 entries before reset, got %d", len(sr.Entries))
+	}
+
+	tr.Reset()
+
+	if sr := tr.GetTopEntries(0); len(sr.Entries) != 0 {
+		t.Fatalf("expected 0 entries after reset, got %d", len(sr.Entries))
+	}
+
+	// tracking still works after reset
+	tr.IncrementDropped([]byte("metric_c"))
+	sr := tr.GetTopEntries(0)
+	if len(sr.Entries) != 1 || sr.Entries[0].MetricName != "metric_c" {
+		t.Fatalf("unexpected entries after reset and re-tracking: %v", sr.Entries)
+	}
+}
+
+func TestTracker_MemoryBoundIsRespected(t *testing.T) {
+	// Each distinct metric name below is ~10 bytes, so with entryOverhead accounted for,
+	// a budget sized for exactly 10 entries should never admit more than 10 distinct names,
+	// no matter how many distinct names are pushed through it.
+	const wantMaxEntries = 10
+	maxSizeBytes := uint64(wantMaxEntries) * (10 + entryOverhead)
+	tr := NewTracker(maxSizeBytes)
+
+	const totalDistinctNames = 100_000
+	for i := 0; i < totalDistinctNames; i++ {
+		name := fmt.Sprintf("metric_%05d", i)
+		tr.IncrementDropped([]byte(name))
+	}
+
+	sr := tr.GetTopEntries(0)
+	if len(sr.Entries) > wantMaxEntries {
+		t.Fatalf("tracker exceeded its memory bound: got %d entries, want at most %d", len(sr.Entries), wantMaxEntries)
+	}
+
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+	if tm.CurrentSizeBytes > maxSizeBytes {
+		t.Fatalf("tracker exceeded its configured maxSizeBytes: got %d; want at most %d", tm.CurrentSizeBytes, maxSizeBytes)
+	}
+	if tm.CurrentItemsCount > wantMaxEntries {
+		t.Fatalf("unexpected CurrentItemsCount: got %d; want at most %d", tm.CurrentItemsCount, wantMaxEntries)
+	}
+}
+
+func TestTracker_ConcurrentAccess(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	const goroutines = 10
+	const incrementsPerGoroutine = 1000
+	var wg sync.WaitGroup
+	for i := 0; i < goroutines; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < incrementsPerGoroutine; j++ {
+				tr.IncrementDropped([]byte("shared_metric"))
+			}
+		}()
+	}
+	wg.Wait()
+
+	sr := tr.GetTopEntries(1)
+	if len(sr.Entries) != 1 {
+		t.Fatalf("unexpected number of entries: %d", len(sr.Entries))
+	}
+	want := uint64(goroutines * incrementsPerGoroutine)
+	if sr.Entries[0].DroppedRowsCount != want {
+		t.Fatalf("unexpected DroppedRowsCount: got %d; want %d", sr.Entries[0].DroppedRowsCount, want)
+	}
+}
