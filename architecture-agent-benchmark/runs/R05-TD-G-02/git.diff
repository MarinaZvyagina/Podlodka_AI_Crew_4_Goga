+// TestStorage_SeriesLimitRowsDroppedByName_Disabled verifies that per-metric-name
+// tracking of dropped rows stays empty - and doesn't error out - when it isn't
+// explicitly enabled via OpenOptions, even though the aggregate counter still works.
+func TestStorage_SeriesLimitRowsDroppedByName_Disabled(t *testing.T) {
+	defer testRemoveAll(t)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+
+	opts := OpenOptions{
+		MaxHourlySeries: 1,
+		// TrackSeriesLimitRowsDroppedByName is intentionally left at its zero value (false).
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	mrs := testGenerateMetricRows(rng, 10, minTimestamp, maxTimestamp)
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped == 0 {
+		t.Fatalf("expected some rows to be dropped because of the hourly series limit")
+	}
+
+	if sr := s.GetSeriesLimitRowsDroppedByName(0); len(sr.Entries) != 0 {
+		t.Fatalf("expected no per-name stats when tracking is disabled, got %v", sr.Entries)
+	}
+}
