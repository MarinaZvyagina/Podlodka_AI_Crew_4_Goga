+// testGenerateMetricRowsChurn generates metric rows for numMetricNames distinct
+// metric names, each with seriesPerName distinct series (achieved by varying an
+// "instance" tag). This is useful for exercising per-metric-name tracking, since
+// testGenerateMetricRows generates a distinct metric name per row.
+func testGenerateMetricRowsChurn(rng *rand.Rand, numMetricNames, seriesPerName int, tr TimeRange) []MetricRow {
+	var mrs []MetricRow
+	var mn MetricName
+	for i := range numMetricNames {
+		mn.MetricGroup = fmt.Appendf(nil, "metric_%d", i)
+		for j := range seriesPerName {
+			mn.Tags = []Tag{
+				{[]byte("job"), []byte("webservice")},
+				{[]byte("instance"), fmt.Appendf(nil, "host_%d", j)},
+			}
+			metricNameRaw := mn.marshalRaw(nil)
+			timestamp := rng.Int63n(tr.MaxTimestamp-tr.MinTimestamp) + tr.MinTimestamp
+			mrs = append(mrs, MetricRow{
+				MetricNameRaw: metricNameRaw,
+				Timestamp:     timestamp,
+				Value:         rng.NormFloat64() * 1e6,
+			})
+		}
+	}
+	return mrs
+}
