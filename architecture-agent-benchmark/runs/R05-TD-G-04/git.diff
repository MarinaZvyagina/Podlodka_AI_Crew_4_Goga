+func TestStorageSeriesLimitExceededMetricNamesTracker_MemoryBound(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const (
+		numMetricNames  = 50
+		maxHourlySeries = 10
+		trackerCapacity = 3
+	)
+
+	rng := rand.New(rand.NewSource(2))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	mrs := testGenerateMetricRowsChurn(rng, numMetricNames, 1, TimeRange{minTimestamp, maxTimestamp})
+
+	opts := OpenOptions{
+		MaxHourlySeries:                     maxHourlySeries,
+		TrackSeriesLimitExceededMetricNames: true,
+		MaxSeriesLimitExceededMetricNames:   trackerCapacity,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped == 0 {
+		t.Fatalf("expected some rows to be dropped because of -storage.maxHourlySeries")
+	}
+	if got := m.HourlySeriesLimitExceededTrackerEntries; got != trackerCapacity {
+		t.Fatalf("unexpected Metrics.HourlySeriesLimitExceededTrackerEntries: got %d, want %d", got, trackerCapacity)
+	}
+
+	top := s.GetHourlySeriesLimitExceededMetricNames(0)
+	if len(top) != trackerCapacity {
+		t.Fatalf("expected the tracker to be bounded to %d entries regardless of %d distinct dropped metric names; got %d entries: %v",
+			trackerCapacity, numMetricNames, len(top), top)
+	}
+}
