@@ -26,6 +26,7 @@ See also [LTS releases](https://docs.victoriametrics.com/victoriametrics/lts-rel
 
 ## tip
 
+* FEATURE: [vmsingle](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/) and `vmstorage` in [VictoriaMetrics cluster](https://docs.victoriametrics.com/victoriametrics/cluster-victoriametrics/): track, per metric name, how many samples were dropped because of `-storage.maxHourlySeries` or `-storage.maxDailySeries`. The top offending metric names can be queried via the new `/internal/series_limit_exceeded` HTTP endpoint (and reset via `/internal/series_limit_exceeded/reset`), making it possible to identify which metrics are responsible for hitting the configured series limits. This tracking can be disabled via `-storage.trackSeriesLimitExceededMetricNames=false`, and the number of tracked metric names per limiter is bounded via `-storage.maxSeriesLimitExceededMetricNames` (default `1000`) to avoid unbounded memory growth.
 * FEATURE: [vmagent](https://docs.victoriametrics.com/victoriametrics/vmagent/), [vmsingle](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/), `vmstorage` and `vmselect` in [VictoriaMetrics cluster](https://docs.victoriametrics.com/victoriametrics/cluster-victoriametrics/): expose the `vm_app_prev_shutdown_unclean` gauge. It is set to `1` when the previous process run didn't shut down cleanly. Added the `UncleanShutdown` [alerting rule](https://github.com/VictoriaMetrics/VictoriaMetrics/blob/master/deployment/docker/rules/alerts-health.yml), which fires for 10 minutes after an unclean shutdown is detected. See [#8443](https://github.com/VictoriaMetrics/VictoriaMetrics/issues/8443).
 * FEATURE: [vmui](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/#vmui): show the selected time zone UTC offset next to the date/time controls and allow opening time zone settings from it. See [#11332](https://github.com/VictoriaMetrics/VictoriaMetrics/pull/11332).
 * FEATURE: [vmsingle](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/), [vmagent](https://docs.victoriametrics.com/victoriametrics/vmagent/), [vmalert](https://docs.victoriametrics.com/victoriametrics/vmalert/), and `vmselect` in [VictoriaMetrics cluster](https://docs.victoriametrics.com/victoriametrics/cluster-victoriametrics/): show how the default value is calculated for command-line flags which derive it from the number of available CPU cores. For example, `-maxConcurrentInserts` now prints `(default 16 = 2*cgroup.AvailableCPUs())` in `-help` output instead of `(default 16)`. Updated flags: `-search.maxConcurrentRequests`, `-search.maxWorkersPerQuery`, `-fs.maxConcurrency`, `-remoteWrite.concurrency`, `-remoteWrite.queues`. See [#9680](https://github.com/VictoriaMetrics/VictoriaMetrics/issues/9680). Thanks to @Vandit1604 for contribution.
diff --git a/lib/storage/series_limit_exceeded_tracker.go b/lib/storage/series_limit_exceeded_tracker.go
new file mode 100644
index 0000000..c850f37
--- /dev/null
+++ b/lib/storage/series_limit_exceeded_tracker.go
@@ -0,0 +1,124 @@
+package storage
+
+import (
+	"sort"
+	"sync"
+)
+
+// defaultMaxSeriesLimitExceededTrackerEntries is the default number of unique
+// metric names tracked by seriesLimitExceededTracker when a positive
+// maxEntries value isn't explicitly configured.
+const defaultMaxSeriesLimitExceededTrackerEntries = 1000
+
+// seriesLimitExceededTracker tracks the number of samples dropped per metric
+// name because adding the corresponding series would have exceeded the
+// configured -storage.maxHourlySeries or -storage.maxDailySeries limit.
+//
+// The number of tracked unique metric names is bounded by maxEntries in order
+// to avoid unbounded memory growth on installations with millions of unique
+// metric names hitting the limit.
+type seriesLimitExceededTracker struct {
+	maxEntries int
+
+	mu      sync.Mutex
+	entries map[string]uint64
+}
+
+// newSeriesLimitExceededTracker creates a tracker bounded to maxEntries
+// unique metric names. If maxEntries is not positive, a sensible default is
+// used instead.
+func newSeriesLimitExceededTracker(maxEntries int) *seriesLimitExceededTracker {
+	if maxEntries <= 0 {
+		maxEntries = defaultMaxSeriesLimitExceededTrackerEntries
+	}
+	return &seriesLimitExceededTracker{
+		maxEntries: maxEntries,
+		entries:    make(map[string]uint64),
+	}
+}
+
+// Increment accounts for a single dropped sample belonging to metricName.
+//
+// Once the tracker reaches its maxEntries capacity, samples for previously
+// unseen metric names are no longer accounted for, while counts for metric
+// names that are already tracked keep growing. This keeps the memory usage
+// bounded regardless of how many distinct metric names hit the limit.
+func (t *seriesLimitExceededTracker) Increment(metricName string) {
+	t.mu.Lock()
+	if _, ok := t.entries[metricName]; ok {
+		t.entries[metricName]++
+	} else if len(t.entries) < t.maxEntries {
+		t.entries[metricName] = 1
+	}
+	t.mu.Unlock()
+}
+
+// MetricNameCount is a single (metric name, dropped samples count) pair.
+type MetricNameCount struct {
+	MetricName string
+	Count      uint64
+}
+
+// GetTopEntries returns up to topN tracked entries sorted by Count in
+// descending order (metric name is used as a tie-breaker). A non-positive
+// topN returns all tracked entries.
+func (t *seriesLimitExceededTracker) GetTopEntries(topN int) []MetricNameCount {
+	t.mu.Lock()
+	result := make([]MetricNameCount, 0, len(t.entries))
+	for name, count := range t.entries {
+		result = append(result, MetricNameCount{MetricName: name, Count: count})
+	}
+	t.mu.Unlock()
+
+	sort.Slice(result, func(i, j int) bool {
+		if result[i].Count != result[j].Count {
+			return result[i].Count > result[j].Count
+		}
+		return result[i].MetricName < result[j].MetricName
+	})
+	if topN > 0 && topN < len(result) {
+		result = result[:topN]
+	}
+	return result
+}
+
+// EntriesCount returns the number of currently tracked unique metric names.
+func (t *seriesLimitExceededTracker) EntriesCount() int {
+	t.mu.Lock()
+	n := len(t.entries)
+	t.mu.Unlock()
+	return n
+}
+
+// Reset drops all the tracked entries.
+func (t *seriesLimitExceededTracker) Reset() {
+	t.mu.Lock()
+	t.entries = make(map[string]uint64)
+	t.mu.Unlock()
+}
+
+// getMetricGroupFromMetricNameRaw extracts only the metric name (the entry
+// with an empty key) from metricNameRaw encoded via MarshalMetricNameRaw,
+// without unmarshaling the remaining tags. This keeps the cost of tracking
+// series-limiter offenders low even when many samples are being dropped.
+func getMetricGroupFromMetricNameRaw(metricNameRaw []byte) string {
+	src := metricNameRaw
+	for len(src) > 0 {
+		tail, key, err := unmarshalBytesFast(src)
+		if err != nil {
+			return "unknown"
+		}
+		src = tail
+
+		tail, value, err := unmarshalBytesFast(src)
+		if err != nil {
+			return "unknown"
+		}
+		src = tail
+
+		if len(key) == 0 {
+			return string(value)
+		}
+	}
+	return "unknown"
+}
diff --git a/lib/storage/series_limit_exceeded_tracker_test.go b/lib/storage/series_limit_exceeded_tracker_test.go
new file mode 100644
index 0000000..51a4add
--- /dev/null
+++ b/lib/storage/series_limit_exceeded_tracker_test.go
@@ -0,0 +1,173 @@
+package storage
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestSeriesLimitExceededTracker_MultipleMetricNames(t *testing.T) {
+	tr := newSeriesLimitExceededTracker(100)
+
+	tr.Increment("foo")
+	tr.Increment("foo")
+	tr.Increment("foo")
+	tr.Increment("bar")
+	tr.Increment("bar")
+	tr.Increment("baz")
+
+	got := tr.GetTopEntries(0)
+	want := []MetricNameCount{
+		{MetricName: "foo", Count: 3},
+		{MetricName: "bar", Count: 2},
+		{MetricName: "baz", Count: 1},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("unexpected number of entries: got %d, want %d; got=%v", len(got), len(want), got)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("unexpected entry at position %d: got %+v, want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestSeriesLimitExceededTracker_GetTopEntriesN(t *testing.T) {
+	tr := newSeriesLimitExceededTracker(100)
+	for i := range 10 {
+		name := fmt.Sprintf("metric_%d", i)
+		for range i + 1 {
+			tr.Increment(name)
+		}
+	}
+
+	top3 := tr.GetTopEntries(3)
+	if len(top3) != 3 {
+		t.Fatalf("unexpected number of entries: got %d, want 3", len(top3))
+	}
+	wantNames := []string{"metric_9", "metric_8", "metric_7"}
+	for i, name := range wantNames {
+		if top3[i].MetricName != name {
+			t.Fatalf("unexpected metric name at position %d: got %q, want %q", i, top3[i].MetricName, name)
+		}
+	}
+
+	all := tr.GetTopEntries(0)
+	if len(all) != 10 {
+		t.Fatalf("unexpected number of entries with topN=0: got %d, want 10", len(all))
+	}
+
+	allExplicit := tr.GetTopEntries(1000)
+	if len(allExplicit) != 10 {
+		t.Fatalf("unexpected number of entries with topN bigger than entries count: got %d, want 10", len(allExplicit))
+	}
+}
+
+func TestSeriesLimitExceededTracker_MemoryBound(t *testing.T) {
+	const maxEntries = 10
+	tr := newSeriesLimitExceededTracker(maxEntries)
+
+	for i := range 1000 {
+		tr.Increment(fmt.Sprintf("metric_%d", i))
+	}
+
+	if got := tr.EntriesCount(); got != maxEntries {
+		t.Fatalf("unexpected number of tracked entries: got %d, want %d", got, maxEntries)
+	}
+	if got := len(tr.GetTopEntries(0)); got != maxEntries {
+		t.Fatalf("unexpected number of entries returned: got %d, want %d", got, maxEntries)
+	}
+
+	// Existing entries must keep being counted accurately even after the
+	// tracker is at capacity, while brand new names beyond the cap are ignored.
+	tr2 := newSeriesLimitExceededTracker(1)
+	tr2.Increment("foo")
+	tr2.Increment("foo")
+	tr2.Increment("bar")
+	tr2.Increment("bar")
+	tr2.Increment("bar")
+
+	got := tr2.GetTopEntries(0)
+	if len(got) != 1 {
+		t.Fatalf("unexpected number of entries: got %d, want 1", len(got))
+	}
+	if got[0].MetricName != "foo" || got[0].Count != 2 {
+		t.Fatalf("unexpected entry: got %+v, want {foo 2}", got[0])
+	}
+}
+
+func TestSeriesLimitExceededTracker_DefaultMaxEntries(t *testing.T) {
+	tr := newSeriesLimitExceededTracker(0)
+	if tr.maxEntries != defaultMaxSeriesLimitExceededTrackerEntries {
+		t.Fatalf("unexpected default maxEntries: got %d, want %d", tr.maxEntries, defaultMaxSeriesLimitExceededTrackerEntries)
+	}
+
+	tr = newSeriesLimitExceededTracker(-5)
+	if tr.maxEntries != defaultMaxSeriesLimitExceededTrackerEntries {
+		t.Fatalf("unexpected default maxEntries for negative input: got %d, want %d", tr.maxEntries, defaultMaxSeriesLimitExceededTrackerEntries)
+	}
+}
+
+func TestSeriesLimitExceededTracker_Reset(t *testing.T) {
+	tr := newSeriesLimitExceededTracker(100)
+	tr.Increment("foo")
+	tr.Increment("bar")
+	if got := tr.EntriesCount(); got != 2 {
+		t.Fatalf("unexpected number of tracked entries before reset: got %d, want 2", got)
+	}
+
+	tr.Reset()
+	if got := tr.EntriesCount(); got != 0 {
+		t.Fatalf("unexpected number of tracked entries after reset: got %d, want 0", got)
+	}
+	if got := tr.GetTopEntries(0); len(got) != 0 {
+		t.Fatalf("unexpected entries after reset: got %v, want empty", got)
+	}
+
+	// The tracker must be usable again after a reset.
+	tr.Increment("foo")
+	if got := tr.EntriesCount(); got != 1 {
+		t.Fatalf("unexpected number of tracked entries after reset+increment: got %d, want 1", got)
+	}
+}
+
+func TestSeriesLimitExceededTracker_Concurrent(t *testing.T) {
+	tr := newSeriesLimitExceededTracker(1000)
+
+	var wg sync.WaitGroup
+	const goroutines = 10
+	const iterations = 100
+	for g := range goroutines {
+		wg.Add(1)
+		go func(g int) {
+			defer wg.Done()
+			for i := range iterations {
+				tr.Increment(fmt.Sprintf("metric_%d", i))
+				_ = tr.GetTopEntries(5)
+			}
+			_ = g
+		}(g)
+	}
+	wg.Wait()
+
+	for _, e := range tr.GetTopEntries(0) {
+		if e.Count != goroutines {
+			t.Fatalf("unexpected count for metric %q: got %d, want %d", e.MetricName, e.Count, goroutines)
+		}
+	}
+}
+
+func TestGetMetricGroupFromMetricNameRaw(t *testing.T) {
+	var mn MetricName
+	mn.MetricGroup = []byte("http_requests_total")
+	mn.Tags = []Tag{
+		{[]byte("job"), []byte("webservice")},
+		{[]byte("instance"), []byte("1.2.3.4")},
+	}
+	metricNameRaw := mn.marshalRaw(nil)
+
+	got := getMetricGroupFromMetricNameRaw(metricNameRaw)
+	if got != "http_requests_total" {
+		t.Fatalf("unexpected metric group: got %q, want %q", got, "http_requests_total")
+	}
+}
