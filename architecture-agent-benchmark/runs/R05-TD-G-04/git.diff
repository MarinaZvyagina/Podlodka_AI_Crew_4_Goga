+func TestStorageSeriesLimitExceededMetricNamesTracking(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const (
+		numMetricNames  = 5
+		seriesPerName   = 50
+		maxHourlySeries = 100
+	)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	mrs := testGenerateMetricRowsChurn(rng, numMetricNames, seriesPerName, TimeRange{minTimestamp, maxTimestamp})
+
+	opts := OpenOptions{
+		MaxHourlySeries:                     maxHourlySeries,
+		TrackSeriesLimitExceededMetricNames: true,
+		MaxSeriesLimitExceededMetricNames:   1000,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped == 0 {
+		t.Fatalf("expected some rows to be dropped because of -storage.maxHourlySeries")
+	}
+
+	top := s.GetHourlySeriesLimitExceededMetricNames(0)
+	if len(top) == 0 {
+		t.Fatalf("expected some tracked offending metric names")
+	}
+	if len(top) < 2 {
+		t.Fatalf("expected drops to be recorded for multiple distinct metric names, got only %d: %v", len(top), top)
+	}
+
+	var totalTracked uint64
+	for _, e := range top {
+		if e.MetricName == "" {
+			t.Fatalf("unexpected empty metric name in tracked entries: %v", top)
+		}
+		totalTracked += e.Count
+	}
+	if totalTracked != m.HourlySeriesLimitRowsDropped {
+		t.Fatalf("tracked drop count mismatch: got %d, want %d (HourlySeriesLimitRowsDropped)", totalTracked, m.HourlySeriesLimitRowsDropped)
+	}
+
+	// Entries must be sorted by Count in descending order.
+	for i := 1; i < len(top); i++ {
+		if top[i-1].Count < top[i].Count {
+			t.Fatalf("entries aren't sorted by Count descending: %v", top)
+		}
+	}
+
+	// The daily tracker must stay disabled since -storage.maxDailySeries isn't configured.
+	if got := s.GetDailySeriesLimitExceededMetricNames(0); got != nil {
+		t.Fatalf("expected nil daily series limit exceeded tracker entries, got %v", got)
+	}
+
+	// Resetting the per-name tracker must not affect the aggregate drop counter.
+	s.ResetHourlySeriesLimitExceededMetricNames()
+	if got := s.GetHourlySeriesLimitExceededMetricNames(0); len(got) != 0 {
+		t.Fatalf("expected no entries right after reset, got %v", got)
+	}
+	var m2 Metrics
+	s.UpdateMetrics(&m2)
+	if m2.HourlySeriesLimitRowsDropped != m.HourlySeriesLimitRowsDropped {
+		t.Fatalf("resetting the per-name tracker must not affect the aggregate counter: got %d, want %d",
+			m2.HourlySeriesLimitRowsDropped, m.HourlySeriesLimitRowsDropped)
+	}
+}
