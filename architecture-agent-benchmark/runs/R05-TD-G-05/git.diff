+// testGenerateMetricRowsForGroup generates seriesCount MetricRow entries
+// belonging to the given metric name (MetricGroup), each with a distinct
+// `id` tag value so that every row represents a distinct time series.
+func testGenerateMetricRowsForGroup(rng *rand.Rand, metricGroup string, seriesCount int, tr TimeRange) []MetricRow {
+	mrs := make([]MetricRow, seriesCount)
+	for i := range seriesCount {
+		var mn MetricName
+		mn.MetricGroup = []byte(metricGroup)
+		mn.Tags = []Tag{
+			{Key: []byte("id"), Value: fmt.Appendf(nil, "%d", i)},
+		}
+		mrs[i] = MetricRow{
+			MetricNameRaw: mn.marshalRaw(nil),
+			Timestamp:     rng.Int63n(tr.MaxTimestamp-tr.MinTimestamp) + tr.MinTimestamp,
+			Value:         rng.NormFloat64() * 1e6,
+		}
+	}
+	return mrs
+}
