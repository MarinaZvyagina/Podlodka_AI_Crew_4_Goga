diff --git a/lib/storage/droppedseriesstats/tracker.go b/lib/storage/droppedseriesstats/tracker.go
new file mode 100644
index 0000000..5326002
--- /dev/null
+++ b/lib/storage/droppedseriesstats/tracker.go
@@ -0,0 +1,244 @@
+// Package droppedseriesstats tracks, per metric name, how many samples have
+// been dropped because adding the corresponding series would have exceeded
+// a configured series cardinality limit (-storage.maxHourlySeries or
+// -storage.maxDailySeries).
+//
+// The main purpose of this tracker is to let support/on-call quickly answer
+// "which metric name(s) are hitting our series-limit settings?" without
+// asking the customer to dig through their own instrumentation.
+package droppedseriesstats
+
+import (
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/bytesutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+// DefaultMaxSizeBytes is used as the Tracker memory budget when the caller
+// doesn't override it with a positive value.
+const DefaultMaxSizeBytes = 16 * 1024 * 1024
+
+// storeOverhead is a rough estimate of the per-entry memory overhead of
+// tracking a single metric name: the map bucket, the string header, the
+// *atomic.Uint64 pointer and the atomic.Uint64 value itself.
+const storeOverhead = 64
+
+// metricNamesBufSize is the size of batch allocations used for cloning
+// tracked metric names, in order to reduce the number of heap allocations
+// and GC pressure when many new metric names are tracked in a short time.
+const metricNamesBufSize = 16 * 1024
+
+// Tracker tracks, per metric name, the number of dropped samples because of
+// a hit series cardinality limit.
+//
+// Tracker is safe to use from concurrent goroutines. Its memory usage is
+// bounded by the maxSizeBytes value it was created with: once that budget is
+// exhausted, samples for metric names that haven't been seen before are
+// still counted towards TotalDroppedRows, but are no longer tracked
+// individually. This guarantees the tracker cannot grow without bound even
+// when it observes millions of distinct metric names.
+//
+// A nil *Tracker is valid and behaves as if tracking is disabled: all of its
+// methods are no-ops / return zero values.
+type Tracker struct {
+	maxSizeBytes uint64
+
+	creationTs       atomic.Uint64
+	currentSizeBytes atomic.Uint64
+	totalDroppedRows atomic.Uint64
+
+	// mu protects store and metricNamesBuf below.
+	mu             sync.RWMutex
+	store          map[string]*atomic.Uint64
+	metricNamesBuf []byte
+
+	getCurrentTs func() uint64
+}
+
+// NewTracker creates a Tracker bounded by maxSizeBytes bytes of memory.
+//
+// If maxSizeBytes <= 0, DefaultMaxSizeBytes is used instead.
+func NewTracker(maxSizeBytes int) *Tracker {
+	n := maxSizeBytes
+	if n <= 0 {
+		n = DefaultMaxSizeBytes
+	}
+	t := &Tracker{
+		maxSizeBytes: uint64(n),
+		getCurrentTs: fasttime.UnixTimestamp,
+	}
+	t.resetLocked()
+	return t
+}
+
+func (t *Tracker) resetLocked() {
+	t.store = make(map[string]*atomic.Uint64)
+	t.metricNamesBuf = t.metricNamesBuf[:0]
+	t.currentSizeBytes.Store(0)
+	t.totalDroppedRows.Store(0)
+	t.creationTs.Store(t.getCurrentTs())
+}
+
+// Reset drops all the collected statistics and starts collecting from
+// scratch.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.resetLocked()
+	t.mu.Unlock()
+}
+
+// IncrementDroppedSeries registers a single dropped sample for the given
+// metricName.
+//
+// It is safe to call this with a nil Tracker - it is a no-op in this case,
+// which allows the caller to keep the feature disabled with negligible
+// overhead.
+func (t *Tracker) IncrementDroppedSeries(metricName []byte) {
+	if t == nil {
+		return
+	}
+	t.totalDroppedRows.Add(1)
+
+	t.mu.RLock()
+	cnt, ok := t.store[bytesutil.ToUnsafeString(metricName)]
+	t.mu.RUnlock()
+	if ok {
+		cnt.Add(1)
+		return
+	}
+
+	if t.currentSizeBytes.Load() >= t.maxSizeBytes {
+		// The tracker is full - do not track new metric names in order to
+		// keep its memory usage bounded. The dropped sample is still
+		// accounted for in TotalDroppedRows above.
+		return
+	}
+
+	t.mu.Lock()
+	cnt, ok = t.store[bytesutil.ToUnsafeString(metricName)]
+	if !ok {
+		cnt = &atomic.Uint64{}
+		t.store[t.cloneMetricNameLocked(metricName)] = cnt
+		t.mu.Unlock()
+		t.currentSizeBytes.Add(uint64(len(metricName)) + storeOverhead)
+		cnt.Add(1)
+		return
+	}
+	t.mu.Unlock()
+	cnt.Add(1)
+}
+
+// cloneMetricNameLocked clones metricName into a batch buffer in order to
+// reduce the number of small heap allocations. It must be called with t.mu
+// held for writing.
+func (t *Tracker) cloneMetricNameLocked(metricName []byte) string {
+	if len(metricName) > metricNamesBufSize {
+		b := make([]byte, len(metricName))
+		copy(b, metricName)
+		return bytesutil.ToUnsafeString(b)
+	}
+	idx := len(t.metricNamesBuf)
+	n := idx + len(metricName)
+	if n > cap(t.metricNamesBuf) {
+		t.metricNamesBuf = make([]byte, 0, metricNamesBufSize)
+		idx = 0
+	}
+	t.metricNamesBuf = append(t.metricNamesBuf, metricName...)
+	return bytesutil.ToUnsafeString(t.metricNamesBuf[idx : idx+len(metricName)])
+}
+
+// Record holds the number of dropped samples for a single metric name.
+type Record struct {
+	MetricName  string
+	DroppedRows uint64
+}
+
+// Stats is a point-in-time snapshot of the statistics collected by Tracker.
+type Stats struct {
+	// CollectedSinceTs is the unix timestamp of when the tracker was created
+	// or last Reset.
+	CollectedSinceTs uint64
+
+	// TotalDroppedRows is the total number of dropped rows observed since
+	// CollectedSinceTs. This includes rows for metric names which could not
+	// be tracked individually because the memory limit was reached.
+	TotalDroppedRows uint64
+
+	// TrackedMetricNames is the number of distinct metric names currently
+	// tracked.
+	TrackedMetricNames uint64
+
+	// MaxSizeBytes is the configured memory limit for the tracker.
+	MaxSizeBytes uint64
+
+	// CurrentSizeBytes is the current memory usage of the tracker.
+	CurrentSizeBytes uint64
+
+	// Records contains the top offending metric names, sorted by
+	// DroppedRows in descending order.
+	Records []Record
+}
+
+// GetTop returns a Stats snapshot with at most limit Records, sorted by
+// DroppedRows in descending order.
+//
+// If limit <= 0, all the tracked metric names are returned.
+func (t *Tracker) GetTop(limit int) Stats {
+	if t == nil {
+		return Stats{}
+	}
+
+	var s Stats
+	s.CollectedSinceTs = t.creationTs.Load()
+	s.TotalDroppedRows = t.totalDroppedRows.Load()
+	s.MaxSizeBytes = t.maxSizeBytes
+	s.CurrentSizeBytes = t.currentSizeBytes.Load()
+
+	t.mu.RLock()
+	s.TrackedMetricNames = uint64(len(t.store))
+	records := make([]Record, 0, len(t.store))
+	for name, cnt := range t.store {
+		records = append(records, Record{
+			MetricName:  name,
+			DroppedRows: cnt.Load(),
+		})
+	}
+	t.mu.RUnlock()
+
+	sort.Slice(records, func(i, j int) bool {
+		if records[i].DroppedRows != records[j].DroppedRows {
+			return records[i].DroppedRows > records[j].DroppedRows
+		}
+		return records[i].MetricName < records[j].MetricName
+	})
+	if limit > 0 && len(records) > limit {
+		records = records[:limit]
+	}
+	s.Records = records
+	return s
+}
+
+// TrackerMetrics holds internal Tracker metrics for observability purposes.
+type TrackerMetrics struct {
+	CurrentSizeBytes uint64
+	MaxSizeBytes     uint64
+	ItemsCount       uint64
+}
+
+// UpdateMetrics writes internal metrics of t to dst.
+func (t *Tracker) UpdateMetrics(dst *TrackerMetrics) {
+	if t == nil {
+		return
+	}
+	dst.CurrentSizeBytes = t.currentSizeBytes.Load()
+	dst.MaxSizeBytes = t.maxSizeBytes
+	t.mu.RLock()
+	dst.ItemsCount = uint64(len(t.store))
+	t.mu.RUnlock()
+}
diff --git a/lib/storage/droppedseriesstats/tracker_test.go b/lib/storage/droppedseriesstats/tracker_test.go
new file mode 100644
index 0000000..f502931
--- /dev/null
+++ b/lib/storage/droppedseriesstats/tracker_test.go
@@ -0,0 +1,181 @@
+package droppedseriesstats
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestTracker_NilIsNoOp(t *testing.T) {
+	var tr *Tracker
+	tr.IncrementDroppedSeries([]byte("foo"))
+	tr.Reset()
+
+	s := tr.GetTop(10)
+	if s.TotalDroppedRows != 0 || len(s.Records) != 0 {
+		t.Fatalf("unexpected non-empty stats from nil tracker: %+v", s)
+	}
+
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+	if tm != (TrackerMetrics{}) {
+		t.Fatalf("unexpected non-empty metrics from nil tracker: %+v", tm)
+	}
+}
+
+func TestTracker_RecordsMultipleMetricNames(t *testing.T) {
+	tr := NewTracker(0)
+
+	tr.IncrementDroppedSeries([]byte("metric_a"))
+	for i := 0; i < 5; i++ {
+		tr.IncrementDroppedSeries([]byte("metric_b"))
+	}
+	for i := 0; i < 3; i++ {
+		tr.IncrementDroppedSeries([]byte("metric_c"))
+	}
+
+	s := tr.GetTop(10)
+	if s.TotalDroppedRows != 9 {
+		t.Fatalf("unexpected TotalDroppedRows: got %d, want 9", s.TotalDroppedRows)
+	}
+	if s.TrackedMetricNames != 3 {
+		t.Fatalf("unexpected TrackedMetricNames: got %d, want 3", s.TrackedMetricNames)
+	}
+	want := []Record{
+		{MetricName: "metric_b", DroppedRows: 5},
+		{MetricName: "metric_c", DroppedRows: 3},
+		{MetricName: "metric_a", DroppedRows: 1},
+	}
+	if len(s.Records) != len(want) {
+		t.Fatalf("unexpected Records length: got %d, want %d; records=%+v", len(s.Records), len(want), s.Records)
+	}
+	for i, r := range s.Records {
+		if r != want[i] {
+			t.Fatalf("unexpected Records[%d]: got %+v, want %+v", i, r, want[i])
+		}
+	}
+}
+
+func TestTracker_GetTopRespectsLimit(t *testing.T) {
+	tr := NewTracker(0)
+	for i := 0; i < 20; i++ {
+		name := fmt.Sprintf("metric_%02d", i)
+		for j := 0; j <= i; j++ {
+			tr.IncrementDroppedSeries([]byte(name))
+		}
+	}
+
+	s := tr.GetTop(3)
+	if len(s.Records) != 3 {
+		t.Fatalf("unexpected number of top records: got %d, want 3", len(s.Records))
+	}
+	// metric_19 has the most drops (20), then metric_18 (19), then metric_17 (18).
+	wantNames := []string{"metric_19", "metric_18", "metric_17"}
+	for i, r := range s.Records {
+		if r.MetricName != wantNames[i] {
+			t.Fatalf("unexpected Records[%d].MetricName: got %q, want %q", i, r.MetricName, wantNames[i])
+		}
+	}
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(0)
+	tr.IncrementDroppedSeries([]byte("metric_a"))
+	tr.IncrementDroppedSeries([]byte("metric_b"))
+
+	firstTs := tr.GetTop(0).CollectedSinceTs
+
+	tr.Reset()
+
+	s := tr.GetTop(10)
+	if s.TotalDroppedRows != 0 {
+		t.Fatalf("unexpected TotalDroppedRows after reset: got %d, want 0", s.TotalDroppedRows)
+	}
+	if len(s.Records) != 0 {
+		t.Fatalf("unexpected Records after reset: got %+v, want empty", s.Records)
+	}
+	if s.CollectedSinceTs < firstTs {
+		t.Fatalf("CollectedSinceTs went backwards after reset: got %d, want >= %d", s.CollectedSinceTs, firstTs)
+	}
+
+	tr.IncrementDroppedSeries([]byte("metric_a"))
+	s = tr.GetTop(10)
+	if s.TotalDroppedRows != 1 {
+		t.Fatalf("unexpected TotalDroppedRows after reset+increment: got %d, want 1", s.TotalDroppedRows)
+	}
+}
+
+func TestTracker_MemoryBoundIsRespected(t *testing.T) {
+	const maxSizeBytes = 4096
+	tr := NewTracker(maxSizeBytes)
+
+	const numMetricNames = 100000
+	for i := 0; i < numMetricNames; i++ {
+		name := fmt.Sprintf("very_long_metric_name_used_to_explode_cardinality_%d", i)
+		tr.IncrementDroppedSeries([]byte(name))
+	}
+
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+
+	// The tracker only checks the size budget before admitting a new entry,
+	// so the very last admitted entry may push currentSizeBytes slightly
+	// past maxSizeBytes. What must never happen is unbounded growth
+	// proportional to numMetricNames.
+	const maxOverflowBytes = 1024
+	if tm.CurrentSizeBytes > maxSizeBytes+maxOverflowBytes {
+		t.Fatalf("tracker exceeded its memory bound: currentSizeBytes=%d, maxSizeBytes=%d", tm.CurrentSizeBytes, maxSizeBytes)
+	}
+	if tm.ItemsCount >= numMetricNames {
+		t.Fatalf("tracker didn't bound the number of tracked metric names: got %d entries out of %d distinct names", tm.ItemsCount, numMetricNames)
+	}
+	if tm.ItemsCount == 0 {
+		t.Fatalf("tracker didn't track any metric name at all")
+	}
+
+	s := tr.GetTop(0)
+	if s.TotalDroppedRows != numMetricNames {
+		t.Fatalf("unexpected TotalDroppedRows: got %d, want %d (all drops must be counted even when not individually tracked)",
+			s.TotalDroppedRows, numMetricNames)
+	}
+	if uint64(len(s.Records)) != tm.ItemsCount {
+		t.Fatalf("unexpected number of Records: got %d, want %d", len(s.Records), tm.ItemsCount)
+	}
+}
+
+func TestTracker_ConcurrentAccess(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	const goroutines = 20
+	const iterations = 500
+	const metricNamesCount = 10
+
+	var wg sync.WaitGroup
+	wg.Add(goroutines)
+	for g := 0; g < goroutines; g++ {
+		go func() {
+			defer wg.Done()
+			for i := 0; i < iterations; i++ {
+				name := fmt.Sprintf("metric_%d", i%metricNamesCount)
+				tr.IncrementDroppedSeries([]byte(name))
+			}
+		}()
+	}
+	wg.Wait()
+
+	s := tr.GetTop(0)
+	wantTotal := uint64(goroutines * iterations)
+	if s.TotalDroppedRows != wantTotal {
+		t.Fatalf("unexpected TotalDroppedRows: got %d, want %d", s.TotalDroppedRows, wantTotal)
+	}
+	if s.TrackedMetricNames != metricNamesCount {
+		t.Fatalf("unexpected TrackedMetricNames: got %d, want %d", s.TrackedMetricNames, metricNamesCount)
+	}
+	var sum uint64
+	for _, r := range s.Records {
+		sum += r.DroppedRows
+	}
+	if sum != wantTotal {
+		t.Fatalf("sum of per-record DroppedRows mismatch: got %d, want %d", sum, wantTotal)
+	}
+}
