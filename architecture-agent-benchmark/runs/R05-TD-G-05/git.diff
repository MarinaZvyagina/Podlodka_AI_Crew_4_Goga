+func TestStorage_SeriesLimiterDropStatsTracksPerMetricName(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const maxHourlySeries = 50
+	opts := OpenOptions{
+		MaxHourlySeries:             maxHourlySeries,
+		TrackSeriesLimiterDropStats: true,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	tr := TimeRange{MinTimestamp: minTimestamp, MaxTimestamp: minTimestamp + 1000}
+
+	// quiet_metric fits comfortably within the limit, so none of its samples
+	// should ever be dropped. It is inserted first so that it gets to claim
+	// its share of the limit budget before noisy_metric exhausts it.
+	var mrs []MetricRow
+	mrs = append(mrs, testGenerateMetricRowsForGroup(rng, "quiet_metric", 5, tr)...)
+	// noisy_metric alone requests far more unique series than the configured
+	// limit allows, so most of its samples must be dropped.
+	mrs = append(mrs, testGenerateMetricRowsForGroup(rng, "noisy_metric", 500, tr)...)
+
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped == 0 {
+		t.Fatalf("expected some rows to be dropped due to -storage.maxHourlySeries")
+	}
+
+	stats := s.GetSeriesLimiterDroppedRowsStats(10)
+	if stats.TotalDroppedRows != m.HourlySeriesLimitRowsDropped {
+		t.Fatalf("unexpected TotalDroppedRows: got %d, want %d", stats.TotalDroppedRows, m.HourlySeriesLimitRowsDropped)
+	}
+	if len(stats.Records) == 0 {
+		t.Fatalf("expected at least one tracked metric name in stats")
+	}
+	if got := stats.Records[0].MetricName; got != "noisy_metric" {
+		t.Fatalf("unexpected top offender: got %q, want %q; records=%+v", got, "noisy_metric", stats.Records)
+	}
+	if stats.Records[0].DroppedRows == 0 {
+		t.Fatalf("expected noisy_metric to have a non-zero drop count")
+	}
+	for _, rec := range stats.Records {
+		if rec.MetricName == "quiet_metric" {
+			t.Fatalf("did not expect quiet_metric to appear in drop stats, since all of its series fit within the limit: %+v", rec)
+		}
+	}
+
+	// querying the top offenders respects the requested limit.
+	limited := s.GetSeriesLimiterDroppedRowsStats(1)
+	if len(limited.Records) != 1 {
+		t.Fatalf("unexpected number of records with topN=1: got %d, want 1", len(limited.Records))
+	}
+	if limited.Records[0] != stats.Records[0] {
+		t.Fatalf("unexpected top-1 record: got %+v, want %+v", limited.Records[0], stats.Records[0])
+	}
+
+	// resetting clears the collected statistics.
+	s.ResetSeriesLimiterDroppedRowsStats()
+	resetStats := s.GetSeriesLimiterDroppedRowsStats(10)
+	if resetStats.TotalDroppedRows != 0 || len(resetStats.Records) != 0 {
+		t.Fatalf("expected empty stats after reset, got %+v", resetStats)
+	}
+}
