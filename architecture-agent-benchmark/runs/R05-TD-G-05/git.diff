+// trackSeriesLimiterDrop registers a single sample dropped because of
+// hourlySeriesLimiter or dailySeriesLimiter against the metric name it
+// belongs to.
+func (s *Storage) trackSeriesLimiterDrop(metricNameRaw []byte) {
+	if s.seriesLimiterDropStats == nil {
+		return
+	}
+	mn := GetMetricName()
+	if err := mn.UnmarshalRaw(metricNameRaw); err == nil {
+		s.seriesLimiterDropStats.IncrementDroppedSeries(mn.MetricGroup)
+	}
+	PutMetricName(mn)
