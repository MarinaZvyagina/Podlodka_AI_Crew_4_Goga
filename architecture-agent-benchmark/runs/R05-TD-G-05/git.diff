+func TestStorage_SeriesLimiterDropStatsDisabledByDefault(t *testing.T) {
+	defer testRemoveAll(t)
+
+	opts := OpenOptions{
+		MaxHourlySeries: 10,
+		// TrackSeriesLimiterDropStats intentionally left false.
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	tr := TimeRange{MinTimestamp: minTimestamp, MaxTimestamp: minTimestamp + 1000}
+	mrs := testGenerateMetricRowsForGroup(rng, "noisy_metric", 100, tr)
+
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped == 0 {
+		t.Fatalf("expected some rows to be dropped due to -storage.maxHourlySeries")
+	}
+
+	// Querying/resetting stats must be safe no-ops when tracking is disabled.
+	stats := s.GetSeriesLimiterDroppedRowsStats(10)
+	if stats.TotalDroppedRows != 0 || len(stats.Records) != 0 {
+		t.Fatalf("expected empty stats when tracking is disabled, got %+v", stats)
+	}
+	s.ResetSeriesLimiterDroppedRowsStats()
+}
