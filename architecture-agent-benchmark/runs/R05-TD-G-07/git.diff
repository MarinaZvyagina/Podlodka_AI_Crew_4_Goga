+func TestVMStorage_SeriesLimitExceededTopMetricNamesHandler(t *testing.T) {
+	defer fs.MustRemoveDir(t.Name())
+
+	s := storage.MustOpenStorage(t.Name(), storage.OpenOptions{
+		MaxHourlySeries:                    5,
+		MaxSeriesLimitExceededTrackedNames: 10,
+	})
+	vms := newVMStorage(s, 2*cgroup.AvailableCPUs(), func(mrs []storage.MetricRow) {})
+	defer vms.Stop()
+
+	var mrs []storage.MetricRow
+	mrs = append(mrs, newTestMetricRows("noisy_metric", 20)...)
+	mrs = append(mrs, newTestMetricRows("quiet_metric", 3)...)
+	s.AddRows(mrs, 64)
+	s.DebugFlush()
+
+	var m storage.Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped == 0 {
+		t.Fatalf("expected some rows to be dropped due to the hourly series limit")
+	}
+
+	resp := doRequest(t, vms, "/internal/series_limit_exceeded/top_metric_names?limit=5")
+	if got, want := resp.Hourly.CollectedSince, uint64(0); got == want {
+		t.Fatalf("unexpected zero collectedSince")
+	}
+	if len(resp.Hourly.TopMetricNames) == 0 {
+		t.Fatalf("expected at least one tracked metric name")
+	}
+	if got, want := resp.Hourly.TopMetricNames[0].MetricName, "noisy_metric"; got != want {
+		t.Fatalf("unexpected top offending metric name: got %q, want %q", got, want)
+	}
+	if len(resp.Daily.TopMetricNames) != 0 {
+		t.Fatalf("unexpected daily records, since -storage.maxDailySeries wasn't configured: %v", resp.Daily.TopMetricNames)
+	}
+
+	// Reset must clear the collected stats.
+	req := httptest.NewRequest(http.MethodGet, "/internal/series_limit_exceeded/reset", nil)
+	w := httptest.NewRecorder()
+	if handled := vms.requestHandler(w, req); !handled {
+		t.Fatalf("expected /internal/series_limit_exceeded/reset to be handled")
+	}
+	if w.Code != http.StatusOK {
+		t.Fatalf("unexpected status code for reset: got %d, want %d", w.Code, http.StatusOK)
+	}
+
+	resp = doRequest(t, vms, "/internal/series_limit_exceeded/top_metric_names?limit=5")
+	if len(resp.Hourly.TopMetricNames) != 0 {
+		t.Fatalf("expected no tracked records after reset, got %v", resp.Hourly.TopMetricNames)
+	}
+}
+
+type seriesLimitExceededTopMetricNamesResponse struct {
+	Hourly seriesLimitExceededPeriodResponse `json:"hourly"`
+	Daily  seriesLimitExceededPeriodResponse `json:"daily"`
+}
+
+type seriesLimitExceededPeriodResponse struct {
+	CollectedSince uint64                      `json:"collectedSince"`
+	TopMetricNames []seriesLimitExceededRecord `json:"topMetricNames"`
+}
+
+type seriesLimitExceededRecord struct {
+	MetricName  string `json:"metricName"`
+	DroppedRows uint64 `json:"droppedRows"`
+}
+
+func doRequest(t *testing.T, vms *VMStorage, path string) seriesLimitExceededTopMetricNamesResponse {
+	t.Helper()
+	req := httptest.NewRequest(http.MethodGet, path, nil)
+	w := httptest.NewRecorder()
+	if handled := vms.requestHandler(w, req); !handled {
+		t.Fatalf("expected %s to be handled", path)
+	}
+	if w.Code != http.StatusOK {
+		t.Fatalf("unexpected status code: got %d, want %d; body: %s", w.Code, http.StatusOK, w.Body.String())
+	}
+	var resp seriesLimitExceededTopMetricNamesResponse
+	if err := json.Unmarshal(w.Body.Bytes(), &resp); err != nil {
+		t.Fatalf("cannot parse response %s: %s", w.Body.String(), err)
+	}
+	return resp
+}
+
+// newTestMetricRows generates count MetricRow entries sharing the given
+// metric name but with distinct label sets, so each row belongs to a
+// distinct series.
+func newTestMetricRows(name string, count int) []storage.MetricRow {
+	var mrs []storage.MetricRow
+	for i := range count {
+		labels := []prompb.Label{
+			{Name: "__name__", Value: name},
+			{Name: "instance", Value: strconv.Itoa(i)},
+		}
+		metricNameRaw := storage.MarshalMetricNameRaw(nil, labels)
+		mrs = append(mrs, storage.MetricRow{
+			MetricNameRaw: metricNameRaw,
+			Timestamp:     time.Now().UnixMilli(),
+			Value:         float64(i),
+		})
+	}
+	return mrs
+}
