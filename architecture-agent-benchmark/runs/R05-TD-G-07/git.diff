+// writeSeriesLimitExceededTopMetricNames writes up to limit top offending
+// metric names for -storage.maxHourlySeries and -storage.maxDailySeries to w
+// in JSON format.
+func writeSeriesLimitExceededTopMetricNames(w io.Writer, s *storage.Storage, limit int) {
+	hourlyRecords, hourlyCollectedSince := s.GetHourlySeriesLimitExceededTopRecords(limit)
+	dailyRecords, dailyCollectedSince := s.GetDailySeriesLimitExceededTopRecords(limit)
+
+	fmt.Fprintf(w, `{"status":"ok",`)
+	fmt.Fprintf(w, `"hourly":{"collectedSince":%d,"topMetricNames":[`, hourlyCollectedSince)
+	writeSeriesLimitExceededRecords(w, hourlyRecords)
+	fmt.Fprintf(w, `]},`)
+	fmt.Fprintf(w, `"daily":{"collectedSince":%d,"topMetricNames":[`, dailyCollectedSince)
+	writeSeriesLimitExceededRecords(w, dailyRecords)
+	fmt.Fprintf(w, `]}}`)
+}
+
+func writeSeriesLimitExceededRecords(w io.Writer, records []storage.SeriesLimitExceededRecord) {
+	for i, r := range records {
+		if i > 0 {
+			fmt.Fprintf(w, `,`)
+		}
+		fmt.Fprintf(w, `{"metricName":%s,"droppedRows":%d}`, stringsutil.JSONString(r.MetricName), r.DroppedRows)
+	}
+}
+
 func jsonResponseError(w http.ResponseWriter, err error) {
 	logger.Errorf("%s", err)
 	w.WriteHeader(http.StatusInternalServerError)
