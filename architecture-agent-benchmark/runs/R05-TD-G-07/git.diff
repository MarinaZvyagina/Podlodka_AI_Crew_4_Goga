 ## tip
 
+* FEATURE: [vmsingle](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/) and `vmstorage` in [VictoriaMetrics cluster](https://docs.victoriametrics.com/victoriametrics/cluster-victoriametrics/): track, per metric name, how many samples were dropped because adding the corresponding series would have exceeded `-storage.maxHourlySeries` or `-storage.maxDailySeries`. The collected stats can be queried at `/internal/series_limit_exceeded/top_metric_names` and reset at `/internal/series_limit_exceeded/reset`. The number of distinct metric names tracked is bounded by the new `-storage.maxSeriesLimitExceededTrackedNames` command-line flag (default `1000`) in order to avoid unbounded memory usage; setting it to `0` disables the tracking with no overhead.
 * FEATURE: [vmagent](https://docs.victoriametrics.com/victoriametrics/vmagent/), [vmsingle](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/), `vmstorage` and `vmselect` in [VictoriaMetrics cluster](https://docs.victoriametrics.com/victoriametrics/cluster-victoriametrics/): expose the `vm_app_prev_shutdown_unclean` gauge. It is set to `1` when the previous process run didn't shut down cleanly. Added the `UncleanShutdown` [alerting rule](https://github.com/VictoriaMetrics/VictoriaMetrics/blob/master/deployment/docker/rules/alerts-health.yml), which fires for 10 minutes after an unclean shutdown is detected. See [#8443](https://github.com/VictoriaMetrics/VictoriaMetrics/issues/8443).
 * FEATURE: [vmui](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/#vmui): show the selected time zone UTC offset next to the date/time controls and allow opening time zone settings from it. See [#11332](https://github.com/VictoriaMetrics/VictoriaMetrics/pull/11332).
 * FEATURE: [vmsingle](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/), [vmagent](https://docs.victoriametrics.com/victoriametrics/vmagent/), [vmalert](https://docs.victoriametrics.com/victoriametrics/vmalert/), and `vmselect` in [VictoriaMetrics cluster](https://docs.victoriametrics.com/victoriametrics/cluster-victoriametrics/): show how the default value is calculated for command-line flags which derive it from the number of available CPU cores. For example, `-maxConcurrentInserts` now prints `(default 16 = 2*cgroup.AvailableCPUs())` in `-help` output instead of `(default 16)`. Updated flags: `-search.maxConcurrentRequests`, `-search.maxWorkersPerQuery`, `-fs.maxConcurrency`, `-remoteWrite.concurrency`, `-remoteWrite.queues`. See [#9680](https://github.com/VictoriaMetrics/VictoriaMetrics/issues/9680). Thanks to @Vandit1604 for contribution.
diff --git a/lib/storage/series_limit_exceeded_stats.go b/lib/storage/series_limit_exceeded_stats.go
new file mode 100644
index 0000000..1bc4fe5
--- /dev/null
+++ b/lib/storage/series_limit_exceeded_stats.go
@@ -0,0 +1,129 @@
+package storage
+
+import (
+	"fmt"
+	"sort"
+	"sync"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+// seriesLimitExceededTracker tracks, per metric name, how many samples were
+// dropped because adding the corresponding series would have exceeded the
+// configured -storage.maxHourlySeries or -storage.maxDailySeries limit.
+//
+// Memory usage is strictly bounded by maxTrackedNames: once that many
+// distinct metric names have been observed, drops for further,
+// not-yet-seen metric names are still accounted for in the storage-wide
+// hourlySeriesLimitRowsDropped / dailySeriesLimitRowsDropped counters, but
+// are no longer tracked individually. This guarantees that installations
+// with millions of distinct metric names cannot make this tracker consume
+// unbounded memory.
+type seriesLimitExceededTracker struct {
+	maxTrackedNames int
+
+	mu             sync.Mutex
+	m              map[string]uint64
+	collectedSince uint64
+}
+
+func newSeriesLimitExceededTracker(maxTrackedNames int) *seriesLimitExceededTracker {
+	return &seriesLimitExceededTracker{
+		maxTrackedNames: maxTrackedNames,
+		m:               make(map[string]uint64),
+		collectedSince:  fasttime.UnixTimestamp(),
+	}
+}
+
+// registerDrop accounts for a single dropped sample belonging to the given
+// metricName.
+func (t *seriesLimitExceededTracker) registerDrop(metricName []byte) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if c, ok := t.m[string(metricName)]; ok {
+		t.m[string(metricName)] = c + 1
+		return
+	}
+	if len(t.m) >= t.maxTrackedNames {
+		// The tracker is at capacity. Do not track drops for previously
+		// unseen metric names in order to keep memory usage bounded.
+		return
+	}
+	t.m[string(metricName)] = 1
+}
+
+// SeriesLimitExceededRecord contains the number of dropped rows for a single
+// metric name.
+type SeriesLimitExceededRecord struct {
+	MetricName  string
+	DroppedRows uint64
+}
+
+// getTop returns up to topN tracked metric names sorted by DroppedRows in
+// descending order, together with the unix timestamp the stats have been
+// collected since.
+func (t *seriesLimitExceededTracker) getTop(topN int) ([]SeriesLimitExceededRecord, uint64) {
+	t.mu.Lock()
+	records := make([]SeriesLimitExceededRecord, 0, len(t.m))
+	for name, count := range t.m {
+		records = append(records, SeriesLimitExceededRecord{
+			MetricName:  name,
+			DroppedRows: count,
+		})
+	}
+	collectedSince := t.collectedSince
+	t.mu.Unlock()
+
+	sort.Slice(records, func(i, j int) bool {
+		if records[i].DroppedRows != records[j].DroppedRows {
+			return records[i].DroppedRows > records[j].DroppedRows
+		}
+		return records[i].MetricName < records[j].MetricName
+	})
+	if topN > 0 && len(records) > topN {
+		records = records[:topN]
+	}
+	return records, collectedSince
+}
+
+// reset clears all the tracked per-metric-name drop counts.
+func (t *seriesLimitExceededTracker) reset() {
+	t.mu.Lock()
+	t.m = make(map[string]uint64)
+	t.collectedSince = fasttime.UnixTimestamp()
+	t.mu.Unlock()
+}
+
+// entriesCount returns the number of distinct metric names currently
+// tracked.
+func (t *seriesLimitExceededTracker) entriesCount() int {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return len(t.m)
+}
+
+// getMetricGroupFromRaw efficiently extracts the metric name (the value of
+// the label with an empty key) from metricNameRaw encoded with
+// MarshalMetricNameRaw, without unmarshaling the rest of the tags.
+func getMetricGroupFromRaw(metricNameRaw []byte) ([]byte, error) {
+	src := metricNameRaw
+	for len(src) > 0 {
+		tail, key, err := unmarshalBytesFast(src)
+		if err != nil {
+			return nil, fmt.Errorf("cannot decode key: %w", err)
+		}
+		src = tail
+
+		tail, value, err := unmarshalBytesFast(src)
+		if err != nil {
+			return nil, fmt.Errorf("cannot decode value: %w", err)
+		}
+		src = tail
+
+		if len(key) == 0 {
+			return value, nil
+		}
+	}
+	return nil, nil
+}
