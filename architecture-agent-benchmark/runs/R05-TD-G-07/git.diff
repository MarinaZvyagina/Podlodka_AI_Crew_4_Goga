+// GetHourlySeriesLimitExceededTopRecords returns up to topN metric names
+// responsible for the highest number of samples dropped due to
+// -storage.maxHourlySeries being reached, sorted by dropped rows in
+// descending order, together with the unix timestamp the stats have been
+// collected since.
+//
+// It returns no records when -storage.maxHourlySeries is disabled or when
+// -storage.maxSeriesLimitExceededTrackedNames is set to 0.
+func (s *Storage) GetHourlySeriesLimitExceededTopRecords(topN int) ([]SeriesLimitExceededRecord, uint64) {
+	if t := s.hourlySeriesLimitExceededTracker; t != nil {
+		return t.getTop(topN)
+	}
+	return nil, 0
+}
+
+// GetDailySeriesLimitExceededTopRecords is the same as
+// GetHourlySeriesLimitExceededTopRecords, but for -storage.maxDailySeries.
+func (s *Storage) GetDailySeriesLimitExceededTopRecords(topN int) ([]SeriesLimitExceededRecord, uint64) {
+	if t := s.dailySeriesLimitExceededTracker; t != nil {
+		return t.getTop(topN)
+	}
+	return nil, 0
+}
