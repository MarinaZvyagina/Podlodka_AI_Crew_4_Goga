@@ -0,0 +1,227 @@
+package storage
+
+import (
+	"fmt"
+	"math/rand"
+	"testing"
+	"time"
+)
+
+func TestSeriesLimitExceededTracker_RegisterDropAndGetTop(t *testing.T) {
+	tr := newSeriesLimitExceededTracker(10)
+
+	tr.registerDrop([]byte("metric_a"))
+	for range 5 {
+		tr.registerDrop([]byte("metric_b"))
+	}
+	for range 3 {
+		tr.registerDrop([]byte("metric_c"))
+	}
+
+	records, collectedSince := tr.getTop(10)
+	if collectedSince == 0 {
+		t.Fatalf("unexpected zero collectedSince")
+	}
+	wantRecords := []SeriesLimitExceededRecord{
+		{MetricName: "metric_b", DroppedRows: 5},
+		{MetricName: "metric_c", DroppedRows: 3},
+		{MetricName: "metric_a", DroppedRows: 1},
+	}
+	if len(records) != len(wantRecords) {
+		t.Fatalf("unexpected records count: got %d, want %d; records=%v", len(records), len(wantRecords), records)
+	}
+	for i, r := range records {
+		if r != wantRecords[i] {
+			t.Fatalf("unexpected record at index %d: got %+v, want %+v", i, r, wantRecords[i])
+		}
+	}
+
+	// Verify topN limiting.
+	top1, _ := tr.getTop(1)
+	if len(top1) != 1 || top1[0].MetricName != "metric_b" {
+		t.Fatalf("unexpected top1 result: %v", top1)
+	}
+
+	// Verify topN<=0 means unlimited.
+	topAll, _ := tr.getTop(0)
+	if len(topAll) != 3 {
+		t.Fatalf("unexpected topAll result: %v", topAll)
+	}
+
+	// Verify reset clears the tracked stats.
+	tr.reset()
+	records, _ = tr.getTop(10)
+	if len(records) != 0 {
+		t.Fatalf("expected no records after reset, got %v", records)
+	}
+	if n := tr.entriesCount(); n != 0 {
+		t.Fatalf("expected zero entries after reset, got %d", n)
+	}
+}
+
+func TestSeriesLimitExceededTracker_MemoryBoundIsRespected(t *testing.T) {
+	const maxTrackedNames = 100
+
+	tr := newSeriesLimitExceededTracker(maxTrackedNames)
+
+	// Simulate drops for far more distinct metric names than maxTrackedNames
+	// allows, as could happen at an installation with millions of distinct
+	// metric names hitting the series limit.
+	const distinctNames = 100_000
+	for i := range distinctNames {
+		tr.registerDrop(fmt.Appendf(nil, "metric_%d", i))
+	}
+
+	if n := tr.entriesCount(); n > maxTrackedNames {
+		t.Fatalf("tracker exceeded its memory bound: got %d tracked names, want at most %d", n, maxTrackedNames)
+	}
+	if n := tr.entriesCount(); n != maxTrackedNames {
+		// The first maxTrackedNames distinct names must have been admitted,
+		// since none of them repeat.
+		t.Fatalf("unexpected tracked names count: got %d, want %d", n, maxTrackedNames)
+	}
+
+	records, _ := tr.getTop(0)
+	if len(records) != maxTrackedNames {
+		t.Fatalf("unexpected records count: got %d, want %d", len(records), maxTrackedNames)
+	}
+
+	// Registering more drops for already-tracked names must still work and
+	// must not grow the tracker beyond its bound.
+	for range 10 {
+		tr.registerDrop([]byte("metric_0"))
+	}
+	if n := tr.entriesCount(); n != maxTrackedNames {
+		t.Fatalf("unexpected tracked names count after repeated drops: got %d, want %d", n, maxTrackedNames)
+	}
+}
+
+func TestGetMetricGroupFromRaw(t *testing.T) {
+	f := func(mn *MetricName, wantMetricGroup string) {
+		t.Helper()
+		metricNameRaw := mn.marshalRaw(nil)
+		metricGroup, err := getMetricGroupFromRaw(metricNameRaw)
+		if err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if string(metricGroup) != wantMetricGroup {
+			t.Fatalf("unexpected metric group: got %q, want %q", metricGroup, wantMetricGroup)
+		}
+	}
+
+	f(&MetricName{
+		MetricGroup: []byte("foo"),
+	}, "foo")
+
+	f(&MetricName{
+		MetricGroup: []byte("bar"),
+		Tags: []Tag{
+			{[]byte("job"), []byte("webservice")},
+			{[]byte("instance"), []byte("1.2.3.4")},
+		},
+	}, "bar")
+}
+
+func TestStorage_SeriesLimitExceededTopMetricNames(t *testing.T) {
+	defer testRemoveAll(t)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	tr := TimeRange{minTimestamp, maxTimestamp}
+
+	// "noisy_metric" contributes far more new series than the hourly limit
+	// allows, while "quiet_metric_a" and "quiet_metric_b" contribute fewer.
+	// Since the limit is shared across all metric names, "noisy_metric"
+	// must end up responsible for the majority of the dropped samples.
+	var mrs []MetricRow
+	mrs = append(mrs, testGenerateMetricRowsForName(rng, 200, "noisy_metric", tr)...)
+	mrs = append(mrs, testGenerateMetricRowsForName(rng, 20, "quiet_metric_a", tr)...)
+	mrs = append(mrs, testGenerateMetricRowsForName(rng, 20, "quiet_metric_b", tr)...)
+
+	t.Run("TrackingEnabled", func(t *testing.T) {
+		opts := OpenOptions{
+			MaxHourlySeries:                    100,
+			MaxSeriesLimitExceededTrackedNames: 10,
+		}
+		s := MustOpenStorage(t.Name(), opts)
+		defer s.MustClose()
+
+		s.AddRows(mrs, defaultPrecisionBits)
+		s.DebugFlush()
+
+		var m Metrics
+		s.UpdateMetrics(&m)
+		if m.HourlySeriesLimitRowsDropped == 0 {
+			t.Fatalf("expected some rows to be dropped due to the hourly series limit")
+		}
+
+		records, collectedSince := s.GetHourlySeriesLimitExceededTopRecords(10)
+		if collectedSince == 0 {
+			t.Fatalf("unexpected zero collectedSince")
+		}
+		if len(records) == 0 {
+			t.Fatalf("expected at least one tracked metric name")
+		}
+		if records[0].MetricName != "noisy_metric" {
+			t.Fatalf("unexpected top offending metric name: got %q, want %q", records[0].MetricName, "noisy_metric")
+		}
+
+		var totalTracked uint64
+		for _, r := range records {
+			totalTracked += r.DroppedRows
+		}
+		if totalTracked != m.HourlySeriesLimitRowsDropped {
+			t.Fatalf("total dropped rows across tracked names (%d) doesn't match total dropped rows (%d)", totalTracked, m.HourlySeriesLimitRowsDropped)
+		}
+
+		// The daily limit wasn't configured, so it must report no records.
+		if dailyRecords, _ := s.GetDailySeriesLimitExceededTopRecords(10); len(dailyRecords) != 0 {
+			t.Fatalf("unexpected daily records: %v", dailyRecords)
+		}
+	})
+
+	t.Run("TrackingDisabled", func(t *testing.T) {
+		opts := OpenOptions{
+			MaxHourlySeries:                    100,
+			MaxSeriesLimitExceededTrackedNames: 0,
+		}
+		s := MustOpenStorage(t.Name(), opts)
+		defer s.MustClose()
+
+		s.AddRows(mrs, defaultPrecisionBits)
+		s.DebugFlush()
+
+		var m Metrics
+		s.UpdateMetrics(&m)
+		if m.HourlySeriesLimitRowsDropped == 0 {
+			t.Fatalf("expected some rows to be dropped due to the hourly series limit")
+		}
+		if records, _ := s.GetHourlySeriesLimitExceededTopRecords(10); len(records) != 0 {
+			t.Fatalf("expected no tracked records when tracking is disabled, got %v", records)
+		}
+	})
+}
+
+// testGenerateMetricRowsForName generates rows count series sharing the same
+// metric name but with distinct label sets.
+func testGenerateMetricRowsForName(rng *rand.Rand, rows int, name string, tr TimeRange) []MetricRow {
+	var mrs []MetricRow
+	var mn MetricName
+	mn.MetricGroup = []byte(name)
+	for i := range rows {
+		mn.Tags = []Tag{
+			{[]byte("instance"), fmt.Appendf(nil, "instance_%d", i)},
+		}
+		metricNameRaw := mn.marshalRaw(nil)
+		timestamp := rng.Int63n(tr.MaxTimestamp-tr.MinTimestamp) + tr.MinTimestamp
+		value := rng.NormFloat64() * 1e6
+
+		mrs = append(mrs, MetricRow{
+			MetricNameRaw: metricNameRaw,
+			Timestamp:     timestamp,
+			Value:         value,
+		})
+	}
+	return mrs
+}
