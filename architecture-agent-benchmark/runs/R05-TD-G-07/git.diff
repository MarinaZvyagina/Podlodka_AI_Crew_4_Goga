+func registerSeriesLimitExceededDrop(t *seriesLimitExceededTracker, metricNameRaw []byte) {
+	if t == nil {
+		return
+	}
+	metricGroup, err := getMetricGroupFromRaw(metricNameRaw)
+	if err != nil || len(metricGroup) == 0 {
+		return
+	}
+	t.registerDrop(metricGroup)
