+// ResetSeriesLimitExceededStats resets the per-metric-name drop stats
+// collected for -storage.maxHourlySeries and -storage.maxDailySeries.
+func (s *Storage) ResetSeriesLimitExceededStats() {
+	if t := s.hourlySeriesLimitExceededTracker; t != nil {
+		t.reset()
+	}
+	if t := s.dailySeriesLimitExceededTracker; t != nil {
