diff --git a/lib/storage/series_limit_exceeded_tracker.go b/lib/storage/series_limit_exceeded_tracker.go
new file mode 100644
index 0000000..888b5a9
--- /dev/null
+++ b/lib/storage/series_limit_exceeded_tracker.go
@@ -0,0 +1,163 @@
+package storage
+
+import (
+	"sort"
+	"sync"
+)
+
+// defaultSeriesLimitExceededTrackerMaxSizeBytes is the default memory limit
+// for seriesLimitExceededTracker. It is intentionally small, since this tracker
+// is expected to hold only a handful of distinct metric names in the common case -
+// the ones responsible for hitting -storage.maxHourlySeries or -storage.maxDailySeries.
+const defaultSeriesLimitExceededTrackerMaxSizeBytes = 1024 * 1024
+
+// seriesLimitExceededEntryOverhead is an approximate per-entry memory overhead
+// on top of the metric name length itself - the map bucket, the string header
+// and the uint64 counter.
+const seriesLimitExceededEntryOverhead = 64
+
+// SeriesLimitExceededEntry is a single row returned by seriesLimitExceededTracker.GetTopEntries.
+type SeriesLimitExceededEntry struct {
+	// MetricName is the metric name (the value of the `__name__` label)
+	// responsible for the dropped samples.
+	MetricName string
+
+	// DroppedRowsCount is the number of samples dropped for MetricName
+	// since the last reset.
+	DroppedRowsCount uint64
+}
+
+// seriesLimitExceededTracker tracks the number of dropped samples per metric name,
+// which occur when adding a new series for that metric name would exceed
+// the configured -storage.maxHourlySeries or -storage.maxDailySeries limit.
+//
+// The tracker is bounded in memory: once maxSizeBytes is reached, samples
+// for previously unseen metric names are no longer tracked, while counters
+// for the already-tracked metric names keep being updated. This guarantees
+// the tracker cannot consume unbounded memory even when the storage sees
+// millions of distinct metric names hitting the limit.
+type seriesLimitExceededTracker struct {
+	maxSizeBytes uint64
+
+	mu               sync.Mutex
+	currentSizeBytes uint64
+	m                map[string]uint64
+}
+
+func newSeriesLimitExceededTracker(maxSizeBytes int) *seriesLimitExceededTracker {
+	if maxSizeBytes <= 0 {
+		maxSizeBytes = defaultSeriesLimitExceededTrackerMaxSizeBytes
+	}
+	return &seriesLimitExceededTracker{
+		maxSizeBytes: uint64(maxSizeBytes),
+		m:            make(map[string]uint64),
+	}
+}
+
+// Add increments the dropped samples counter for the given metricName.
+//
+// It is a no-op if t is nil, so it is safe to call on a tracker
+// obtained from a disabled series limiter.
+func (t *seriesLimitExceededTracker) Add(metricName []byte) {
+	if t == nil || len(metricName) == 0 {
+		return
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	// Do not use bytesutil.ToUnsafeString+string(metricName) combination here:
+	// mixing an unsafe string conversion with a regular one for the same
+	// byte slice within a single function allows the compiler to reuse the
+	// unsafe (zero-copy) conversion for the "safe" one too, so the map would
+	// end up storing a key aliased to metricName's backing array instead of
+	// an independent copy.
+	if _, ok := t.m[string(metricName)]; ok {
+		t.m[string(metricName)]++
+		return
+	}
+
+	entrySizeBytes := uint64(len(metricName)) + seriesLimitExceededEntryOverhead
+	if t.currentSizeBytes+entrySizeBytes > t.maxSizeBytes {
+		// The memory limit has been reached - do not track new metric names anymore.
+		return
+	}
+	t.m[string(metricName)] = 1
+	t.currentSizeBytes += entrySizeBytes
+}
+
+// GetTopEntries returns up to topN entries with the highest DroppedRowsCount,
+// sorted by DroppedRowsCount in descending order.
+func (t *seriesLimitExceededTracker) GetTopEntries(topN int) []SeriesLimitExceededEntry {
+	if t == nil {
+		return nil
+	}
+
+	t.mu.Lock()
+	entries := make([]SeriesLimitExceededEntry, 0, len(t.m))
+	for k, v := range t.m {
+		entries = append(entries, SeriesLimitExceededEntry{
+			MetricName:       k,
+			DroppedRowsCount: v,
+		})
+	}
+	t.mu.Unlock()
+
+	sort.Slice(entries, func(i, j int) bool {
+		if entries[i].DroppedRowsCount != entries[j].DroppedRowsCount {
+			return entries[i].DroppedRowsCount > entries[j].DroppedRowsCount
+		}
+		return entries[i].MetricName < entries[j].MetricName
+	})
+	if topN > 0 && len(entries) > topN {
+		entries = entries[:topN]
+	}
+	return entries
+}
+
+// Reset drops all the tracked state.
+func (t *seriesLimitExceededTracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.m = make(map[string]uint64)
+	t.currentSizeBytes = 0
+	t.mu.Unlock()
+}
+
+// SizeBytes returns the current memory usage of the tracker in bytes.
+func (t *seriesLimitExceededTracker) SizeBytes() uint64 {
+	if t == nil {
+		return 0
+	}
+	t.mu.Lock()
+	n := t.currentSizeBytes
+	t.mu.Unlock()
+	return n
+}
+
+// EntriesCount returns the current number of tracked metric names.
+func (t *seriesLimitExceededTracker) EntriesCount() uint64 {
+	if t == nil {
+		return 0
+	}
+	t.mu.Lock()
+	n := uint64(len(t.m))
+	t.mu.Unlock()
+	return n
+}
+
+// trackDroppedRow records a dropped sample for the metric name encoded in metricNameRaw.
+//
+// It is a no-op if t is nil (i.e. the corresponding series limit is disabled).
+func (t *seriesLimitExceededTracker) trackDroppedRow(metricNameRaw []byte) {
+	if t == nil {
+		return
+	}
+	mn := GetMetricName()
+	if err := mn.UnmarshalRaw(metricNameRaw); err == nil {
+		t.Add(mn.MetricGroup)
+	}
+	PutMetricName(mn)
+}
diff --git a/lib/storage/series_limit_exceeded_tracker_test.go b/lib/storage/series_limit_exceeded_tracker_test.go
new file mode 100644
index 0000000..80cbed0
--- /dev/null
+++ b/lib/storage/series_limit_exceeded_tracker_test.go
@@ -0,0 +1,157 @@
+package storage
+
+import (
+	"fmt"
+	"testing"
+)
+
+func TestSeriesLimitExceededTracker_Nil(t *testing.T) {
+	var t2 *seriesLimitExceededTracker
+	// Must not panic on a nil tracker, since this is the state used
+	// when the corresponding series limit is disabled.
+	t2.Add([]byte("foo"))
+	t2.trackDroppedRow([]byte("foo"))
+	t2.Reset()
+	if n := t2.SizeBytes(); n != 0 {
+		t.Fatalf("unexpected SizeBytes for nil tracker: %d", n)
+	}
+	if n := t2.EntriesCount(); n != 0 {
+		t.Fatalf("unexpected EntriesCount for nil tracker: %d", n)
+	}
+	if entries := t2.GetTopEntries(10); entries != nil {
+		t.Fatalf("unexpected non-nil result from GetTopEntries on nil tracker: %v", entries)
+	}
+}
+
+func TestSeriesLimitExceededTracker_AddAndGetTopEntries(t *testing.T) {
+	tr := newSeriesLimitExceededTracker(0)
+
+	// Record a different number of dropped samples for multiple metric names.
+	for i := 0; i < 5; i++ {
+		tr.Add([]byte("metric_a"))
+	}
+	for i := 0; i < 3; i++ {
+		tr.Add([]byte("metric_b"))
+	}
+	tr.Add([]byte("metric_c"))
+
+	if n := tr.EntriesCount(); n != 3 {
+		t.Fatalf("unexpected EntriesCount: got %d, want 3", n)
+	}
+
+	top := tr.GetTopEntries(2)
+	if len(top) != 2 {
+		t.Fatalf("unexpected number of top entries: got %d, want 2", len(top))
+	}
+	if top[0].MetricName != "metric_a" || top[0].DroppedRowsCount != 5 {
+		t.Fatalf("unexpected top[0]: %+v", top[0])
+	}
+	if top[1].MetricName != "metric_b" || top[1].DroppedRowsCount != 3 {
+		t.Fatalf("unexpected top[1]: %+v", top[1])
+	}
+
+	// A topN <= 0 must return all the tracked entries.
+	all := tr.GetTopEntries(0)
+	if len(all) != 3 {
+		t.Fatalf("unexpected number of entries for topN=0: got %d, want 3", len(all))
+	}
+}
+
+func TestSeriesLimitExceededTracker_Reset(t *testing.T) {
+	tr := newSeriesLimitExceededTracker(0)
+	tr.Add([]byte("metric_a"))
+	tr.Add([]byte("metric_b"))
+	if n := tr.EntriesCount(); n != 2 {
+		t.Fatalf("unexpected EntriesCount before reset: %d", n)
+	}
+
+	tr.Reset()
+
+	if n := tr.EntriesCount(); n != 0 {
+		t.Fatalf("unexpected EntriesCount after reset: %d", n)
+	}
+	if n := tr.SizeBytes(); n != 0 {
+		t.Fatalf("unexpected SizeBytes after reset: %d", n)
+	}
+	if entries := tr.GetTopEntries(10); len(entries) != 0 {
+		t.Fatalf("unexpected entries after reset: %v", entries)
+	}
+}
+
+func TestSeriesLimitExceededTracker_MemoryBoundIsRespected(t *testing.T) {
+	// Use a small size limit, which can fit only a handful of entries.
+	const maxSizeBytes = 1000
+	tr := newSeriesLimitExceededTracker(maxSizeBytes)
+
+	// Simulate a cardinality explosion across a huge number of distinct metric names.
+	// The tracker must never exceed the configured memory limit regardless of
+	// how many distinct names are pushed through it.
+	const distinctMetricNames = 100_000
+	for i := 0; i < distinctMetricNames; i++ {
+		tr.Add([]byte(fmt.Sprintf("metric_%d", i)))
+	}
+
+	if sz := tr.SizeBytes(); sz > maxSizeBytes {
+		t.Fatalf("tracker exceeded its memory bound: got %d bytes, want <= %d bytes", sz, maxSizeBytes)
+	}
+	if n := tr.EntriesCount(); n >= distinctMetricNames {
+		t.Fatalf("tracker unexpectedly tracked all %d distinct metric names; entries=%d", distinctMetricNames, n)
+	}
+
+	// Metric names that have been already accepted before the limit was reached
+	// must keep being updated - the memory bound must not block existing entries.
+	entriesBefore := tr.GetTopEntries(0)
+	if len(entriesBefore) == 0 {
+		t.Fatalf("expected at least one tracked entry before hitting the memory bound")
+	}
+	firstTrackedName := entriesBefore[0].MetricName
+	tr.Add([]byte(firstTrackedName))
+
+	found := false
+	for _, e := range tr.GetTopEntries(0) {
+		if e.MetricName == firstTrackedName {
+			found = true
+			if e.DroppedRowsCount != entriesBefore[0].DroppedRowsCount+1 {
+				t.Fatalf("unexpected DroppedRowsCount for already-tracked entry %q: got %d, want %d",
+					firstTrackedName, e.DroppedRowsCount, entriesBefore[0].DroppedRowsCount+1)
+			}
+		}
+	}
+	if !found {
+		t.Fatalf("expected already-tracked metric name %q to remain in the tracker", firstTrackedName)
+	}
+
+	// The overall memory usage still must not exceed the configured bound
+	// after all these additional updates.
+	if sz := tr.SizeBytes(); sz > maxSizeBytes {
+		t.Fatalf("tracker exceeded its memory bound after additional updates: got %d bytes, want <= %d bytes", sz, maxSizeBytes)
+	}
+}
+
+func TestSeriesLimitExceededTracker_TrackDroppedRow(t *testing.T) {
+	tr := newSeriesLimitExceededTracker(0)
+
+	var mn MetricName
+	mn.MetricGroup = []byte("http_requests_total")
+	mn.Tags = []Tag{
+		{[]byte("job"), []byte("webservice")},
+	}
+	metricNameRaw := mn.marshalRaw(nil)
+
+	tr.trackDroppedRow(metricNameRaw)
+	tr.trackDroppedRow(metricNameRaw)
+
+	top := tr.GetTopEntries(10)
+	if len(top) != 1 {
+		t.Fatalf("unexpected number of entries: got %d, want 1", len(top))
+	}
+	if top[0].MetricName != "http_requests_total" {
+		t.Fatalf("unexpected MetricName: got %q, want %q", top[0].MetricName, "http_requests_total")
+	}
+	if top[0].DroppedRowsCount != 2 {
+		t.Fatalf("unexpected DroppedRowsCount: got %d, want 2", top[0].DroppedRowsCount)
+	}
+
+	// Invalid raw metric name must not panic and must not be tracked.
+	tr.trackDroppedRow([]byte("garbage"))
+}
