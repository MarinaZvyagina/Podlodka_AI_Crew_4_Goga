+// GetHourlySeriesLimitExceededMetricNames returns up to topN metric names with the highest
+// number of samples dropped because of -storage.maxHourlySeries being exceeded since the last reset.
+func (s *Storage) GetHourlySeriesLimitExceededMetricNames(topN int) []SeriesLimitExceededEntry {
+	return s.hourlySeriesLimitExceeded.GetTopEntries(topN)
+}
+
+// GetDailySeriesLimitExceededMetricNames returns up to topN metric names with the highest
+// number of samples dropped because of -storage.maxDailySeries being exceeded since the last reset.
+func (s *Storage) GetDailySeriesLimitExceededMetricNames(topN int) []SeriesLimitExceededEntry {
+	return s.dailySeriesLimitExceeded.GetTopEntries(topN)
+}
+
+// ResetHourlySeriesLimitExceededMetricNames resets the per-metric-name tracker
+// used by GetHourlySeriesLimitExceededMetricNames.
+func (s *Storage) ResetHourlySeriesLimitExceededMetricNames() {
+	s.hourlySeriesLimitExceeded.Reset()
+}
+
+// ResetDailySeriesLimitExceededMetricNames resets the per-metric-name tracker
+// used by GetDailySeriesLimitExceededMetricNames.
+func (s *Storage) ResetDailySeriesLimitExceededMetricNames() {
+	s.dailySeriesLimitExceeded.Reset()
