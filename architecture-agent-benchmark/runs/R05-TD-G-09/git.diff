+// TestStorageSeriesLimitExceededMetricNames verifies that samples dropped because
+// of exceeding -storage.maxHourlySeries are attributed to the correct metric names,
+// and that the per-metric-name breakdown can be queried via
+// GetHourlySeriesLimitExceededMetricNames.
+func TestStorageSeriesLimitExceededMetricNames(t *testing.T) {
+	defer testRemoveAll(t)
+
+	genRows := func(metricGroup string, seriesCount int, timestamp int64) []MetricRow {
+		var mrs []MetricRow
+		var mn MetricName
+		mn.MetricGroup = []byte(metricGroup)
+		for i := 0; i < seriesCount; i++ {
+			mn.Tags = []Tag{
+				{[]byte("instance"), fmt.Appendf(nil, "instance_%d", i)},
+			}
+			mrs = append(mrs, MetricRow{
+				MetricNameRaw: mn.marshalRaw(nil),
+				Timestamp:     timestamp,
+				Value:         float64(i),
+			})
+		}
+		return mrs
+	}
+
+	const maxHourlySeries = 5
+	opts := OpenOptions{
+		MaxHourlySeries: maxHourlySeries,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	timestamp := time.Now().UnixMilli()
+
+	// Fill up the hourly series quota completely with a single metric name,
+	// so that every series registered afterwards is guaranteed to be dropped,
+	// regardless of row processing order.
+	warmupRows := genRows("warmup", maxHourlySeries, timestamp)
+	s.AddRows(warmupRows, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped != 0 {
+		t.Fatalf("unexpected rows dropped while filling up the quota: %d", m.HourlySeriesLimitRowsDropped)
+	}
+
+	// Now register series for two more metric names. Since the quota is
+	// already exhausted, all of these rows must be dropped.
+	const cpuSeriesCount = 7
+	const memSeriesCount = 3
+	var mrs []MetricRow
+	mrs = append(mrs, genRows("cpu_usage", cpuSeriesCount, timestamp)...)
+	mrs = append(mrs, genRows("mem_usage", memSeriesCount, timestamp)...)
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	s.UpdateMetrics(&m)
+	wantDropped := uint64(cpuSeriesCount + memSeriesCount)
+	if m.HourlySeriesLimitRowsDropped != wantDropped {
+		t.Fatalf("unexpected Metrics.HourlySeriesLimitRowsDropped: got %d, want %d", m.HourlySeriesLimitRowsDropped, wantDropped)
+	}
+
+	top := s.GetHourlySeriesLimitExceededMetricNames(10)
+	if len(top) != 2 {
+		t.Fatalf("unexpected number of top offending metric names: got %d, want 2; entries=%+v", len(top), top)
+	}
+	if top[0].MetricName != "cpu_usage" || top[0].DroppedRowsCount != cpuSeriesCount {
+		t.Fatalf("unexpected top[0]: %+v", top[0])
+	}
+	if top[1].MetricName != "mem_usage" || top[1].DroppedRowsCount != memSeriesCount {
+		t.Fatalf("unexpected top[1]: %+v", top[1])
+	}
+
+	// Limiting topN must return only the highest offenders.
+	topOne := s.GetHourlySeriesLimitExceededMetricNames(1)
+	if len(topOne) != 1 || topOne[0].MetricName != "cpu_usage" {
+		t.Fatalf("unexpected result with topN=1: %+v", topOne)
+	}
+
+	// "warmup" never exceeded the limit, so it must not appear in the report.
+	for _, e := range top {
+		if e.MetricName == "warmup" {
+			t.Fatalf("unexpected metric name %q in the series-limit-exceeded report", e.MetricName)
+		}
+	}
+
+	// The daily tracker must stay empty, since -storage.maxDailySeries wasn't configured.
+	if got := s.GetDailySeriesLimitExceededMetricNames(10); len(got) != 0 {
+		t.Fatalf("unexpected non-empty daily series-limit-exceeded report: %+v", got)
+	}
+
+	// Reset must clear the collected state.
+	s.ResetHourlySeriesLimitExceededMetricNames()
+	if got := s.GetHourlySeriesLimitExceededMetricNames(10); len(got) != 0 {
+		t.Fatalf("unexpected non-empty report after reset: %+v", got)
+	}
+}
