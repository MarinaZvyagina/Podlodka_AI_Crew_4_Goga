+func TestUserAddWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// an empty password is rejected unless the account is explicitly no-password
+	ua := &pb.AuthUserAddRequest{Name: "no-pass-not-allowed", HashedPassword: encodePassword(""), Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a passwordless account is unaffected by the empty-password check
+	ua = &pb.AuthUserAddRequest{Name: "no-pass-allowed", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	require.NoErrorf(t, err, "expected no error, got %v", err)
+}
+
