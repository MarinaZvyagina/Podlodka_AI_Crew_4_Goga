+// isEmptyPassword reports whether the given (possibly hashed) password
+// represents a blank password, whether it arrived as a zero-length hash or
+// as a valid hash that verifies against an empty string.
+func isEmptyPassword(password []byte) bool {
+	if len(password) == 0 {
+		return true
+	}
+	return bcrypt.CompareHashAndPassword(password, []byte("")) == nil
+}
