+func TestUserAddWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// a blank password, without explicitly opting into a no-password account, must be rejected
+	ua := &pb.AuthUserAddRequest{Name: "empty-pass-user", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a no-password account is unaffected by the blank-password check
+	ua = &pb.AuthUserAddRequest{Name: "no-pass-user", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestUserChangePasswordToEmpty(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// changing an ordinary user's password to blank must be rejected
+	_, err := as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo"})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a passwordless account may still have its (no-op) password "changed" to blank
+	username := "usernopass"
+	ua := &pb.AuthUserAddRequest{Name: username, Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: username})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
