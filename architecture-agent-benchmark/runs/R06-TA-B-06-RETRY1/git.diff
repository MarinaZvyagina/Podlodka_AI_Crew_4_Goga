+func TestUserAddEmptyPassword(t *testing.T) {
+	integration.BeforeTest(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	authapi := clus.RandClient()
+
+	// a blank password, without explicitly opting into a no-password account, must be rejected
+	_, err := authapi.UserAdd(t.Context(), "foo", "")
+	require.ErrorIsf(t, err, rpctypes.ErrPasswordEmpty, "expected %v, got %v", rpctypes.ErrPasswordEmpty, err)
+
+	// explicitly opting into a no-password account must keep working
+	_, err = authapi.UserAddWithOptions(t.Context(), "nopass", "", &clientv3.UserAddOptions{NoPassword: true})
+	require.NoError(t, err)
+
+	// changing an existing user's password to blank must be rejected
+	_, err = authapi.UserAdd(t.Context(), "bar", "baz")
+	require.NoError(t, err)
+	_, err = authapi.UserChangePassword(t.Context(), "bar", "")
+	require.ErrorIsf(t, err, rpctypes.ErrPasswordEmpty, "expected %v, got %v", rpctypes.ErrPasswordEmpty, err)
+}
