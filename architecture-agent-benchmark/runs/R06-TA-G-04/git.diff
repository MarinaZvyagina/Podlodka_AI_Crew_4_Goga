--- a/server/auth/store_test.go
+++ b/server/auth/store_test.go
@@ -174,6 +174,24 @@ func TestUserAdd(t *testing.T) {
 	require.Truef(t, ok, "user %s should be added but it doesn't exist in rangePermCache", userName)
 }
 
+func TestUserAddWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// adding a user without opting into NoPassword and without a password must fail
+	ua := &pb.AuthUserAddRequest{Name: "no-pass-not-opted-in", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	_, ok := as.rangePermCache["no-pass-not-opted-in"]
+	require.Falsef(t, ok, "user should not have been created")
+
+	// explicitly opting into NoPassword must still work
+	ua = &pb.AuthUserAddRequest{Name: "no-pass-opted-in", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	require.NoError(t, err)
+}
+
 func TestRecover(t *testing.T) {
 	as, tearDown := setupAuthStore(t)
 	defer as.Close()
@@ -309,6 +327,28 @@ func TestUserChangePassword(t *testing.T) {
