+func TestUserChangePasswordToBlank(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// a blank password is rejected for a regular (password-protected) account
+	_, err := as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo"})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a blank password is fine for an account explicitly created as no-password
+	ua := &pb.AuthUserAddRequest{Name: "blank-pw", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	require.NoErrorf(t, err, "expected no error, got %v", err)
+
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "blank-pw"})
+	require.NoErrorf(t, err, "expected no error, got %v", err)
+}
