+// TestV3AuthUserAddEmptyPassword ensures that creating a user with a blank
+// password is rejected unless the account explicitly opts into no-password
+// (passwordless) mode, regardless of which client talks to the raw gRPC
+// AuthServer.
+func TestV3AuthUserAddEmptyPassword(t *testing.T) {
+	integration.BeforeTest(t)
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	api := integration.ToGRPC(clus.Client(0))
+
+	_, err := api.Auth.UserAdd(t.Context(), &pb.AuthUserAddRequest{Name: "blank-password-user", Options: &authpb.UserAddOptions{NoPassword: false}})
+	require.Truef(t, eqErrGRPC(err, rpctypes.ErrGRPCPasswordEmpty), "got %v, expected %v", err, rpctypes.ErrGRPCPasswordEmpty)
+
+	_, err = api.Auth.UserAdd(t.Context(), &pb.AuthUserAddRequest{Name: "passwordless-user", Options: &authpb.UserAddOptions{NoPassword: true}})
+	require.NoError(t, err)
+}
+
+// TestV3AuthUserChangePasswordEmpty ensures that changing an existing user's
+// password to blank is rejected unless the account is passwordless.
+func TestV3AuthUserChangePasswordEmpty(t *testing.T) {
+	integration.BeforeTest(t)
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	api := integration.ToGRPC(clus.Client(0))
+
+	_, err := api.Auth.UserAdd(t.Context(), &pb.AuthUserAddRequest{Name: "regular-user", Password: "123", Options: &authpb.UserAddOptions{NoPassword: false}})
+	require.NoError(t, err)
+	_, err = api.Auth.UserChangePassword(t.Context(), &pb.AuthUserChangePasswordRequest{Name: "regular-user"})
+	require.Truef(t, eqErrGRPC(err, rpctypes.ErrGRPCPasswordEmpty), "got %v, expected %v", err, rpctypes.ErrGRPCPasswordEmpty)
+
+	_, err = api.Auth.UserAdd(t.Context(), &pb.AuthUserAddRequest{Name: "passwordless-user2", Options: &authpb.UserAddOptions{NoPassword: true}})
+	require.NoError(t, err)
+	_, err = api.Auth.UserChangePassword(t.Context(), &pb.AuthUserChangePasswordRequest{Name: "passwordless-user2"})
+	require.NoError(t, err)
+}
