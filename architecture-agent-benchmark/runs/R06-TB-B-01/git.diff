+	tcs := []struct {
+		name   string
+		cfg    LessorConfig
+		expect int
+	}{
+		{"default", LessorConfig{MinLeaseTTL: minLeaseTTL}, DefaultMaxLeaseAttachedItems},
+		{"configured", LessorConfig{MinLeaseTTL: minLeaseTTL, MaxLeaseAttachedItems: 5}, 5},
+	}
+	for _, tc := range tcs {
+		t.Run(tc.name, func(t *testing.T) {
+			lg := zap.NewNop()
+			dir, be := NewTestBackend(t)
+			defer os.RemoveAll(dir)
+			defer be.Close()
+
+			le := newLessor(lg, be, clusterLatest(), tc.cfg)
+			defer le.Stop()
+
+			if got := le.MaxLeaseAttachedItems(); got != tc.expect {
+				t.Errorf("MaxLeaseAttachedItems() = %d, want %d", got, tc.expect)
+			}
+		})
+	}
