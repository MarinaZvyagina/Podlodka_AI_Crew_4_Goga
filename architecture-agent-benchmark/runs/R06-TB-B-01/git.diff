+// pendingLeaseKeys tracks, per lease, the set of keys that a not-yet-applied
+// request has already been validated to newly attach. It is used to
+// correctly enforce the max-keys-per-lease limit across multiple put
+// operations (e.g. inside a single Txn request) that target the same lease,
+// none of which have been applied to the lessor yet.
+type pendingLeaseKeys map[lease.LeaseID]map[string]struct{}
+
+func newPendingLeaseKeys() pendingLeaseKeys {
+	return make(pendingLeaseKeys)
+}
+
+func checkLease(lessor lease.Lessor, pending pendingLeaseKeys, p *pb.PutRequest) error {
 	leaseID := lease.LeaseID(p.Lease)
-	if leaseID != lease.NoLease {
-		if l := lessor.Lookup(leaseID); l == nil {
-			return lease.ErrLeaseNotFound
-		}
+	if leaseID == lease.NoLease {
+		return nil
+	}
+	l := lessor.Lookup(leaseID)
+	if l == nil {
+		return lease.ErrLeaseNotFound
+	}
+
+	item := lease.LeaseItem{Key: string(p.Key)}
+	if l.Contains(item) {
+		return nil
+	}
+	pendingForLease, ok := pending[leaseID]
+	if !ok {
+		pendingForLease = make(map[string]struct{})
+		pending[leaseID] = pendingForLease
+	}
+	if _, ok := pendingForLease[item.Key]; ok {
+		// already accounted for by an earlier put in the same request
+		return nil
+	}
+	if l.ItemsCount()+len(pendingForLease) >= lessor.MaxLeaseAttachedItems() {
+		return lease.ErrTooManyKeys
 	}
+	pendingForLease[item.Key] = struct{}{}
 	return nil
 }
 
