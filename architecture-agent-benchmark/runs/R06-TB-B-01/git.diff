+// TestLeaseItemState ensures Contains and ItemsCount correctly reflect the
+// items attached to a lease.
+func TestLeaseItemState(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL})
+	defer le.Stop()
+
+	l, err := le.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("could not grant lease (%v)", err)
+	}
+
+	item := LeaseItem{Key: "foo"}
+	if l.Contains(item) {
+		t.Fatalf("expected lease to not contain %v before attach", item)
+	}
+	if got := l.ItemsCount(); got != 0 {
+		t.Fatalf("ItemsCount() = %d, want 0", got)
+	}
+
+	if err = le.Attach(l.ID, []LeaseItem{item}); err != nil {
+		t.Fatalf("failed to attach item: %v", err)
+	}
+
+	if !l.Contains(item) {
+		t.Fatalf("expected lease to contain %v after attach", item)
+	}
+	if got := l.ItemsCount(); got != 1 {
+		t.Fatalf("ItemsCount() = %d, want 1", got)
+	}
+}
