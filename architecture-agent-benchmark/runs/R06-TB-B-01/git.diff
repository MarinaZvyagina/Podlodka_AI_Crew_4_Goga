+// limitations under the License.
+
+package txn
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+// setupWithMaxLeaseAttachedItems creates a store backed by a real lessor
+// (rather than lease.FakeLessor) configured with the given max number of
+// keys per lease, and grants a single lease on it.
+func setupWithMaxLeaseAttachedItems(t *testing.T, maxKeys int) (mvcc.KV, lease.Lessor, lease.LeaseID) {
+	t.Helper()
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() {
+		betesting.Close(t, b)
+	})
+
+	lessor := lease.NewLessor(zaptest.NewLogger(t), b, nil, lease.LessorConfig{MaxLeaseAttachedItems: maxKeys})
+	t.Cleanup(lessor.Stop)
+
+	s := mvcc.NewStore(zaptest.NewLogger(t), b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() {
+		s.Close()
+	})
+
+	l, err := lessor.Grant(1, 100)
+	require.NoError(t, err)
+	return s, lessor, l.ID
+}
+
+// rangeKey performs a read-only range over a single key, properly closing
+// the read view so it doesn't leak and block a later backend Close.
+func rangeKey(t *testing.T, ctx context.Context, s mvcc.KV, key []byte) *mvcc.RangeResult {
+	t.Helper()
+	tr := s.Read(mvcc.ConcurrentReadTxMode, traceutil.TODO())
+	defer tr.End()
+	rr, err := tr.Range(ctx, key, nil, mvcc.RangeOptions{})
+	require.NoError(t, err)
+	return rr
+}
+
+func TestPutRejectsWhenLeaseExceedsMaxAttachedItems(t *testing.T) {
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+	s, lessor, leaseID := setupWithMaxLeaseAttachedItems(t, 2)
+
+	_, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("a"), Lease: int64(leaseID)})
+	require.NoError(t, err)
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("b"), Lease: int64(leaseID)})
+	require.NoError(t, err)
+
+	// a third, distinct key would push the lease over its limit.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("c"), Lease: int64(leaseID)})
+	require.ErrorIs(t, err, lease.ErrTooManyKeys)
+
+	// the rejected write must not have been applied.
+	rr := rangeKey(t, ctx, s, []byte("c"))
+	require.Empty(t, rr.KVs, "rejected put must not have written a key")
+	require.Equal(t, 2, lessor.Lookup(leaseID).ItemsCount())
+
+	// re-attaching an already-attached key must still succeed even though the lease is at capacity.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("a"), Value: []byte("updated"), Lease: int64(leaseID)})
+	require.NoError(t, err)
+}
+
+func TestTxnRejectsCumulativeOverflowOfMaxAttachedItems(t *testing.T) {
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+	s, lessor, leaseID := setupWithMaxLeaseAttachedItems(t, 2)
+
+	// pre-attach one key, leaving one slot before the limit is reached.
+	_, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("existing"), Lease: int64(leaseID)})
+	require.NoError(t, err)
+
+	// a Txn that attaches two more distinct keys to the same lease must be rejected in full,
+	// since the second put alone would already push the lease over the limit.
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("k2"), Lease: int64(leaseID)}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("k3"), Lease: int64(leaseID)}}},
+		},
+	}
+	_, _, err = Txn(ctx, lg, txn, false, s, lessor, false)
+	require.ErrorIs(t, err, lease.ErrTooManyKeys)
+
+	// neither key must have been written, and the lease's key count must be unchanged.
+	for _, k := range [][]byte{[]byte("k2"), []byte("k3")} {
+		rr := rangeKey(t, ctx, s, k)
+		require.Emptyf(t, rr.KVs, "rejected txn must not have written key %q", k)
+	}
+	require.Equal(t, 1, lessor.Lookup(leaseID).ItemsCount())
+}
+
+func TestTxnAllowsReattachingSameKeyAtCapacity(t *testing.T) {
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+	s, lessor, leaseID := setupWithMaxLeaseAttachedItems(t, 1)
+
+	_, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("a"), Lease: int64(leaseID)})
+	require.NoError(t, err)
+
+	// re-putting the same, already-attached key twice within one Txn must not be rejected,
+	// even though the lease is already at its configured capacity.
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a"), Value: []byte("v1"), Lease: int64(leaseID)}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a"), Value: []byte("v2"), Lease: int64(leaseID)}}},
+		},
+	}
+	_, _, err = Txn(ctx, lg, txn, false, s, lessor, false)
+	require.NoError(t, err)
+	require.Equal(t, 1, lessor.Lookup(leaseID).ItemsCount())
+}
