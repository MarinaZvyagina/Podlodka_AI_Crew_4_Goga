new file mode 100644
index 000000000..adbe1e681
--- /dev/null
+++ b/server/etcdserver/txn/lease_capacity.go
@@ -0,0 +1,76 @@
+// Copyright 2025 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package txn
+
+import (
+	"go.etcd.io/etcd/server/v3/lease"
+)
+
+// leaseCapacityChecker simulates, without mutating any lessor state, the
+// effect that a sequence of Put operations would have on the number of keys
+// attached to each lease, mirroring the attach/detach behavior of
+// storeTxnWrite.put. It is used to validate every Put in a request (a single
+// Put, or all the Put operations inside a Txn, including nested txns) against
+// the configured max-keys-per-lease limit before any of them are applied, so
+// a request that would exceed the limit for any lease can be rejected as a
+// whole instead of partially applied.
+type leaseCapacityChecker struct {
+	lessor lease.Lessor
+	// delta tracks, per lease, the net simulated change in attached-key
+	// count relative to what is currently persisted in the lessor.
+	delta map[lease.LeaseID]int
+	// keyLease tracks the simulated current lease owner of a key once the
+	// key has been touched by this checker, so later ops touching the same
+	// key in the same batch see the effect of earlier ones.
+	keyLease map[string]lease.LeaseID
+}
+
+func newLeaseCapacityChecker(lessor lease.Lessor) *leaseCapacityChecker {
+	return &leaseCapacityChecker{
+		lessor:   lessor,
+		delta:    make(map[lease.LeaseID]int),
+		keyLease: make(map[string]lease.LeaseID),
+	}
+}
+
+// checkPut simulates attaching key to leaseID, returning lease.ErrTooManyLeaseKeys
+// if doing so would exceed the configured max-keys-per-lease limit for
+// leaseID. Re-attaching a key that is already on leaseID is a no-op and never
+// counts against the limit, matching storeTxnWrite.put's early return when
+// the old and new lease are the same.
+func (c *leaseCapacityChecker) checkPut(key string, leaseID lease.LeaseID) error {
+	oldLease, ok := c.keyLease[key]
+	if !ok {
+		oldLease = c.lessor.GetLease(lease.LeaseItem{Key: key})
+	}
+
+	if oldLease == leaseID {
+		return nil
+	}
+
+	if oldLease != lease.NoLease {
+		c.delta[oldLease]--
+	}
+	if leaseID != lease.NoLease {
+		if l := c.lessor.Lookup(leaseID); l != nil {
+			if l.ItemCount()+c.delta[leaseID]+1 > c.lessor.MaxLeaseKeys() {
+				return lease.ErrTooManyLeaseKeys
+			}
+			c.delta[leaseID]++
+		}
+	}
+	c.keyLease[key] = leaseID
+	return nil
+}
