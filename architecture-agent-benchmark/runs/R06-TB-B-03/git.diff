+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package txn
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/etcdserver/api/membership"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+	"go.etcd.io/etcd/server/v3/storage/schema"
+)
+
+func setupLeaseCapacityTest(t *testing.T, maxLeaseKeys int) (mvcc.KV, lease.Lessor, lease.LeaseID) {
+	t.Helper()
+	lg := zaptest.NewLogger(t)
+	be, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() {
+		betesting.Close(t, be)
+	})
+
+	cluster := membership.NewCluster(lg)
+	cluster.SetBackend(schema.NewMembershipBackend(lg, be))
+
+	lessor := lease.NewLessor(lg, be, cluster, lease.LessorConfig{MaxLeaseKeys: maxLeaseKeys})
+	t.Cleanup(lessor.Stop)
+	kv := mvcc.NewStore(lg, be, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() { require.NoError(t, kv.Close()) })
+
+	l, err := lessor.Grant(1, 100)
+	require.NoError(t, err)
+
+	return kv, lessor, l.ID
+}
+
+func putReq(key string, leaseID lease.LeaseID) *pb.PutRequest {
+	return &pb.PutRequest{Key: []byte(key), Value: []byte("v"), Lease: int64(leaseID)}
+}
+
+// TestPutRejectsKeyOverLeaseCapacity verifies that a Put attaching a new key
+// to a lease that is already at its configured max-keys capacity is rejected
+// with a clear error, while the server and lease remain healthy and usable.
+func TestPutRejectsKeyOverLeaseCapacity(t *testing.T) {
+	kv, lessor, leaseID := setupLeaseCapacityTest(t, 2)
+
+	_, _, err := Put(context.Background(), zaptest.NewLogger(t), lessor, kv, putReq("k1", leaseID))
+	require.NoError(t, err)
+	_, _, err = Put(context.Background(), zaptest.NewLogger(t), lessor, kv, putReq("k2", leaseID))
+	require.NoError(t, err)
+
+	// A third, distinct key should be rejected: the lease is already at capacity.
+	_, _, err = Put(context.Background(), zaptest.NewLogger(t), lessor, kv, putReq("k3", leaseID))
+	require.ErrorIs(t, err, lease.ErrTooManyLeaseKeys)
+
+	l := lessor.Lookup(leaseID)
+	require.Equal(t, 2, l.ItemCount(), "rejected put must not have attached the key")
+
+	// The server must remain healthy: unrelated writes still work.
+	_, _, err = Put(context.Background(), zaptest.NewLogger(t), lessor, kv, putReq("other", lease.NoLease))
+	require.NoError(t, err)
+
+	// Re-attaching a key already on the lease must not be rejected, even at capacity.
+	_, _, err = Put(context.Background(), zaptest.NewLogger(t), lessor, kv, putReq("k1", leaseID))
+	require.NoError(t, err)
+	require.Equal(t, 2, lessor.Lookup(leaseID).ItemCount())
+}
+
+// TestPutUnderLeaseCapacityUnaffected verifies leases under the configured
+// limit behave exactly as before: puts succeed normally.
+func TestPutUnderLeaseCapacityUnaffected(t *testing.T) {
+	kv, lessor, leaseID := setupLeaseCapacityTest(t, 100)
+
+	for i := 0; i < 10; i++ {
+		_, _, err := Put(context.Background(), zaptest.NewLogger(t), lessor, kv, putReq(string(rune('a'+i)), leaseID))
+		require.NoError(t, err)
+	}
+	require.Equal(t, 10, lessor.Lookup(leaseID).ItemCount())
+}
+
+// TestTxnRejectsBatchOverLeaseCapacity verifies that a single Txn whose Put
+// operations would collectively push a lease over its configured key limit is
+// rejected atomically: none of its operations are applied.
+func TestTxnRejectsBatchOverLeaseCapacity(t *testing.T) {
+	kv, lessor, leaseID := setupLeaseCapacityTest(t, 2)
+
+	txnReq := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: putReq("a", leaseID)}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: putReq("b", leaseID)}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: putReq("c", leaseID)}},
+		},
+	}
+
+	_, _, err := Txn(context.Background(), zaptest.NewLogger(t), txnReq, false, kv, lessor, false)
+	require.True(t, errors.Is(err, lease.ErrTooManyLeaseKeys))
+
+	l := lessor.Lookup(leaseID)
+	require.Equal(t, 0, l.ItemCount(), "no operation from the rejected txn should have been applied")
+
+	// Server must remain healthy and process subsequent requests normally.
+	_, _, err = Put(context.Background(), zaptest.NewLogger(t), lessor, kv, putReq("a", leaseID))
+	require.NoError(t, err)
+}
+
+// TestTxnAllowsBatchAtLeaseCapacity verifies that a Txn whose Put operations
+// exactly fill a lease's remaining capacity succeeds.
+func TestTxnAllowsBatchAtLeaseCapacity(t *testing.T) {
+	kv, lessor, leaseID := setupLeaseCapacityTest(t, 2)
+
+	txnReq := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: putReq("a", leaseID)}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: putReq("b", leaseID)}},
+		},
+	}
+
+	_, _, err := Txn(context.Background(), zaptest.NewLogger(t), txnReq, false, kv, lessor, false)
+	require.NoError(t, err)
+	require.Equal(t, 2, lessor.Lookup(leaseID).ItemCount())
+}
