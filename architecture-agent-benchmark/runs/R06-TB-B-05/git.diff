 }
 
-func checkLease(lessor lease.Lessor, p *pb.PutRequest) error {
+// leaseKeyBudget tracks, while validating a single (possibly multi-op)
+// request before any of it is applied, how many new keys have already been
+// tentatively reserved against each lease's key limit. Without it, several
+// puts in the same txn that each attach a new key to the same lease would
+// all see the lease's pre-txn key count and could together push it past the
+// limit undetected. A nil budget disables this cross-op tracking, which is
+// fine for a standalone Put that only ever checks a single key.
+type leaseKeyBudget map[lease.LeaseID]map[string]struct{}
+
+func checkLease(lessor lease.Lessor, p *pb.PutRequest, budget leaseKeyBudget) error {
 	leaseID := lease.LeaseID(p.Lease)
-	if leaseID != lease.NoLease {
-		if l := lessor.Lookup(leaseID); l == nil {
-			return lease.ErrLeaseNotFound
+	if leaseID == lease.NoLease {
+		return nil
+	}
+	l := lessor.Lookup(leaseID)
+	if l == nil {
+		return lease.ErrLeaseNotFound
+	}
+
+	key := string(p.Key)
+	if lessor.GetLease(lease.LeaseItem{Key: key}) == leaseID {
+		// the key is already attached to this lease; re-attaching it never
+		// counts against the per-lease key limit.
+		return nil
+	}
+
+	reserved := budget[leaseID]
+	if _, ok := reserved[key]; ok {
+		// already accounted for earlier in this same request
+		return nil
+	}
+
+	if max := lessor.MaxLeaseKeys(); max > 0 && l.ItemCount()+len(reserved)+1 > max {
+		return lease.ErrTooManyLeaseKeys
+	}
+
+	if budget != nil {
+		if reserved == nil {
+			reserved = make(map[string]struct{})
+			budget[leaseID] = reserved
 		}
+		reserved[key] = struct{}{}
 	}
 	return nil
 }
