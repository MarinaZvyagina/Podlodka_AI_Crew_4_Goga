+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package txn
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+func setupWithMaxLeaseKeys(t *testing.T, maxLeaseKeys int) (mvcc.KV, lease.Lessor, lease.LeaseID) {
+	t.Helper()
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() {
+		betesting.Close(t, b)
+	})
+	lessor := lease.NewLessor(zaptest.NewLogger(t), b, nil, lease.LessorConfig{
+		MinLeaseTTL:  1,
+		MaxLeaseKeys: maxLeaseKeys,
+	})
+	t.Cleanup(lessor.Stop)
+
+	s := mvcc.NewStore(zaptest.NewLogger(t), b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() {
+		s.Close()
+	})
+
+	l, err := lessor.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("failed to grant lease: %v", err)
+	}
+	return s, lessor, l.ID
+}
+
+func mustGet(t *testing.T, kv mvcc.KV, key string) bool {
+	t.Helper()
+	txnRead := kv.Read(mvcc.ConcurrentReadTxMode, traceutil.TODO())
+	defer txnRead.End()
+	rr, err := txnRead.Range(context.Background(), []byte(key), nil, mvcc.RangeOptions{})
+	if err != nil {
+		t.Fatalf("failed to range %q: %v", key, err)
+	}
+	return len(rr.KVs) > 0
+}
+
+func TestPutRejectedWhenLeaseKeyLimitReached(t *testing.T) {
+	kv, lessor, leaseID := setupWithMaxLeaseKeys(t, 2)
+	lg := zaptest.NewLogger(t)
+
+	for _, key := range []string{"a", "b"} {
+		if _, _, err := Put(context.Background(), lg, lessor, kv, &pb.PutRequest{
+			Key: []byte(key), Lease: int64(leaseID),
+		}); err != nil {
+			t.Fatalf("expected put of %q to succeed, got: %v", key, err)
+		}
+	}
+
+	// a brand-new key on an already-full lease must be rejected...
+	_, _, err := Put(context.Background(), lg, lessor, kv, &pb.PutRequest{
+		Key: []byte("c"), Lease: int64(leaseID),
+	})
+	if !errors.Is(err, lease.ErrTooManyLeaseKeys) {
+		t.Fatalf("expected ErrTooManyLeaseKeys, got: %v", err)
+	}
+	// ...and must not have been applied.
+	if mustGet(t, kv, "c") {
+		t.Fatalf("key %q should not exist after a rejected put", "c")
+	}
+
+	// re-attaching (updating) a key already on the full lease must still work.
+	if _, _, err := Put(context.Background(), lg, lessor, kv, &pb.PutRequest{
+		Key: []byte("a"), Value: []byte("updated"), Lease: int64(leaseID),
+	}); err != nil {
+		t.Fatalf("expected re-attaching an existing key to succeed, got: %v", err)
+	}
+
+	// the server keeps serving unrelated requests after the rejection.
+	if _, _, err := Put(context.Background(), lg, lessor, kv, &pb.PutRequest{
+		Key: []byte("unrelated-no-lease"),
+	}); err != nil {
+		t.Fatalf("expected unrelated put without a lease to succeed, got: %v", err)
+	}
+}
+
+func TestTxnRejectedWhenCumulativePutsExceedLeaseKeyLimit(t *testing.T) {
+	kv, lessor, leaseID := setupWithMaxLeaseKeys(t, 2)
+	lg := zaptest.NewLogger(t)
+
+	// one key already attached to the lease, leaving room for exactly one more.
+	if _, _, err := Put(context.Background(), lg, lessor, kv, &pb.PutRequest{
+		Key: []byte("a"), Lease: int64(leaseID),
+	}); err != nil {
+		t.Fatalf("setup put failed: %v", err)
+	}
+
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("b"), Lease: int64(leaseID)}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("c"), Lease: int64(leaseID)}}},
+		},
+	}
+	_, _, err := Txn(context.Background(), lg, txn, false, kv, lessor, false)
+	if !errors.Is(err, lease.ErrTooManyLeaseKeys) {
+		t.Fatalf("expected ErrTooManyLeaseKeys, got: %v", err)
+	}
+	if mustGet(t, kv, "b") || mustGet(t, kv, "c") {
+		t.Fatalf("neither op of the rejected txn should have been applied")
+	}
+
+	// the same txn shape, but attaching only one new key, must succeed.
+	okTxn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a"), Lease: int64(leaseID)}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("b"), Lease: int64(leaseID)}}},
+		},
+	}
+	if _, _, err := Txn(context.Background(), lg, okTxn, false, kv, lessor, false); err != nil {
+		t.Fatalf("expected txn to succeed, got: %v", err)
+	}
+}
