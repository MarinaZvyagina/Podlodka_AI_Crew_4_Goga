-func checkLease(lessor lease.Lessor, p *pb.PutRequest) error {
+// pendingLeaseKeys tracks, per lease, the set of keys that earlier requests
+// within the same not-yet-applied Txn are about to newly attach to that
+// lease. It lets checkLease account for multiple Put operations in a single
+// Txn that all attach new keys to the same lease, none of which have been
+// applied to the lessor yet.
+type pendingLeaseKeys map[lease.LeaseID]map[string]struct{}
+
+// checkLease verifies that the lease referenced by p exists and, if the put
+// would attach a new key to it, that doing so would not push the lease over
+// its configured maximum number of attached keys. pendingLeaseKeys may be nil
+// when checking a single, standalone Put request.
+func checkLease(lessor lease.Lessor, p *pb.PutRequest, pendingLeaseKeys pendingLeaseKeys) error {
 	leaseID := lease.LeaseID(p.Lease)
-	if leaseID != lease.NoLease {
-		if l := lessor.Lookup(leaseID); l == nil {
-			return lease.ErrLeaseNotFound
+	if leaseID == lease.NoLease {
+		return nil
+	}
+	l := lessor.Lookup(leaseID)
+	if l == nil {
+		return lease.ErrLeaseNotFound
+	}
+
+	key := string(p.Key)
+	// Re-attaching a key that is already on this lease never increases the
+	// lease's key count, so it can never violate the limit.
+	if lessor.GetLease(lease.LeaseItem{Key: key}) == leaseID {
+		return nil
+	}
+	pending := pendingLeaseKeys[leaseID]
+	if _, ok := pending[key]; ok {
+		return nil
+	}
+
+	if max := lessor.MaxLeaseKeys(); max > 0 && l.ItemCount()+len(pending)+1 > max {
+		return lease.ErrTooManyKeys
+	}
+
+	if pendingLeaseKeys != nil {
+		if pending == nil {
+			pending = make(map[string]struct{})
+			pendingLeaseKeys[leaseID] = pending
 		}
+		pending[key] = struct{}{}
 	}
 	return nil
 }
