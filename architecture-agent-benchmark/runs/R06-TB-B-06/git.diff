+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package txn
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+// setupWithLeaseLimit returns a real mvcc.KV backed by a real lessor whose
+// maximum number of keys attached to a single lease is capped at maxLeaseKeys.
+func setupWithLeaseLimit(t *testing.T, maxLeaseKeys int) (mvcc.KV, lease.Lessor) {
+	t.Helper()
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	lessor := lease.NewLessor(zaptest.NewLogger(t), b, nil, lease.LessorConfig{MaxLeaseKeys: maxLeaseKeys})
+	s := mvcc.NewStore(zaptest.NewLogger(t), b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() {
+		s.Close()
+		lessor.Stop()
+	})
+	return s, lessor
+}
+
+func putReq(key string, leaseID lease.LeaseID) *pb.PutRequest {
+	return &pb.PutRequest{Key: []byte(key), Value: []byte("v"), Lease: int64(leaseID)}
+}
+
+func TestPutRejectsExceedingLeaseKeyLimit(t *testing.T) {
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+	kv, lessor := setupWithLeaseLimit(t, 2)
+
+	const leaseID = lease.LeaseID(1)
+	_, err := lessor.Grant(leaseID, 100)
+	require.NoError(t, err)
+
+	_, _, err = Put(ctx, lg, lessor, kv, putReq("a", leaseID))
+	require.NoError(t, err)
+	_, _, err = Put(ctx, lg, lessor, kv, putReq("b", leaseID))
+	require.NoError(t, err)
+
+	// A third distinct key would push the lease over its limit of 2.
+	_, _, err = Put(ctx, lg, lessor, kv, putReq("c", leaseID))
+	require.ErrorIs(t, err, lease.ErrTooManyKeys)
+
+	// The rejected write must not have been applied.
+	rr, err := kv.Read(mvcc.ConcurrentReadTxMode, traceutil.TODO()).Range(ctx, []byte("c"), nil, mvcc.RangeOptions{})
+	require.NoError(t, err)
+	require.Empty(t, rr.KVs)
+	require.Equal(t, 2, lessor.Lookup(leaseID).ItemCount())
+
+	// Re-attaching a key already on the lease must still work at the limit.
+	_, _, err = Put(ctx, lg, lessor, kv, putReq("a", leaseID))
+	require.NoError(t, err)
+	require.Equal(t, 2, lessor.Lookup(leaseID).ItemCount())
+
+	// The server must remain healthy: unrelated writes keep working.
+	_, _, err = Put(ctx, lg, lessor, kv, putReq("unrelated", lease.NoLease))
+	require.NoError(t, err)
+}
+
+func TestTxnRejectsExceedingLeaseKeyLimitAtomically(t *testing.T) {
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+	kv, lessor := setupWithLeaseLimit(t, 2)
+
+	const leaseID = lease.LeaseID(1)
+	_, err := lessor.Grant(leaseID, 100)
+	require.NoError(t, err)
+
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: putReq("a", leaseID)}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: putReq("b", leaseID)}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: putReq("c", leaseID)}},
+		},
+	}
+
+	_, _, err = Txn(ctx, lg, txn, false, kv, lessor, false)
+	require.True(t, errors.Is(err, lease.ErrTooManyKeys))
+
+	// None of the txn's puts should have been applied.
+	for _, key := range []string{"a", "b", "c"} {
+		rr, rerr := kv.Read(mvcc.ConcurrentReadTxMode, traceutil.TODO()).Range(ctx, []byte(key), nil, mvcc.RangeOptions{})
+		require.NoError(t, rerr)
+		require.Emptyf(t, rr.KVs, "key %q should not have been written", key)
+	}
+	require.Equal(t, 0, lessor.Lookup(leaseID).ItemCount())
+}
+
+func TestTxnAllowsRepeatedKeyWithinLimit(t *testing.T) {
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+	kv, lessor := setupWithLeaseLimit(t, 1)
+
+	const leaseID = lease.LeaseID(1)
+	_, err := lessor.Grant(leaseID, 100)
+	require.NoError(t, err)
+
+	// Two ops targeting the same brand-new key within the same txn must only
+	// count as a single new key against the limit.
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: putReq("a", leaseID)}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: putReq("a", leaseID)}},
+		},
+	}
+
+	_, _, err = Txn(ctx, lg, txn, false, kv, lessor, false)
+	require.NoError(t, err)
+	require.Equal(t, 1, lessor.Lookup(leaseID).ItemCount())
+}
+
+func TestPutUnderLeaseKeyLimitBehavesAsBefore(t *testing.T) {
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+	kv, lessor := setupWithLeaseLimit(t, 100000)
+
+	const leaseID = lease.LeaseID(1)
+	_, err := lessor.Grant(leaseID, 100)
+	require.NoError(t, err)
+
+	for _, key := range []string{"a", "b", "c"} {
+		_, _, err = Put(ctx, lg, lessor, kv, putReq(key, leaseID))
+		require.NoError(t, err)
+	}
+	require.Equal(t, 3, lessor.Lookup(leaseID).ItemCount())
+}
