+
+func setupWithMaxLeaseKeys(t *testing.T, maxLeaseKeys int) (mvcc.KV, lease.Lessor) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() {
+		betesting.Close(t, b)
+	})
+	lg := zaptest.NewLogger(t)
+	lessor := lease.NewLessor(lg, b, membership.NewCluster(lg), lease.LessorConfig{MaxLeaseKeys: maxLeaseKeys})
+	t.Cleanup(lessor.Stop)
+	s := mvcc.NewStore(lg, b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() {
+		s.Close()
+	})
+	return s, lessor
+}
+
+func TestPutRejectsExceedingMaxLeaseKeys(t *testing.T) {
+	s, lessor := setupWithMaxLeaseKeys(t, 2)
+	ctx := t.Context()
+
+	l, err := lessor.Grant(1, 100)
+	require.NoError(t, err)
+
+	_, _, err = Put(ctx, zaptest.NewLogger(t), lessor, s, &pb.PutRequest{Key: []byte("foo"), Lease: int64(l.ID)})
+	require.NoError(t, err)
+	_, _, err = Put(ctx, zaptest.NewLogger(t), lessor, s, &pb.PutRequest{Key: []byte("bar"), Lease: int64(l.ID)})
+	require.NoError(t, err)
+
+	// A third distinct key would exceed the configured limit.
+	_, _, err = Put(ctx, zaptest.NewLogger(t), lessor, s, &pb.PutRequest{Key: []byte("baz"), Lease: int64(l.ID)})
+	require.ErrorIs(t, err, lease.ErrTooManyKeysForLease)
+
+	// Re-putting an already-attached key must keep working at the limit.
+	_, _, err = Put(ctx, zaptest.NewLogger(t), lessor, s, &pb.PutRequest{Key: []byte("foo"), Lease: int64(l.ID)})
+	require.NoError(t, err)
+
+	require.Equal(t, 2, lessor.Lookup(l.ID).ItemCount())
+}
+
+func TestTxnRejectsExceedingMaxLeaseKeysAcrossOps(t *testing.T) {
+	s, lessor := setupWithMaxLeaseKeys(t, 2)
+	ctx := t.Context()
+
+	l, err := lessor.Grant(1, 100)
+	require.NoError(t, err)
+
+	require.NoError(t, lessor.Attach(l.ID, []lease.LeaseItem{{Key: "foo"}}))
+
+	// A single Txn attaching two distinct new keys to a lease with only one
+	// slot left must be rejected as a whole, not partially applied.
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("bar"), Lease: int64(l.ID)}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("baz"), Lease: int64(l.ID)}}},
+		},
+	}
+	_, _, err = Txn(ctx, zaptest.NewLogger(t), txn, false, s, lessor, false)
+	require.ErrorIs(t, err, lease.ErrTooManyKeysForLease)
+	require.Equal(t, 1, lessor.Lookup(l.ID).ItemCount())
+
+	// A Txn that only grows the lease by one key, plus re-attaches the
+	// existing one, must succeed.
+	txn = &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("foo"), Lease: int64(l.ID)}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("bar"), Lease: int64(l.ID)}}},
+		},
+	}
+	_, _, err = Txn(ctx, zaptest.NewLogger(t), txn, false, s, lessor, false)
+	require.NoError(t, err)
+	require.Equal(t, 2, lessor.Lookup(l.ID).ItemCount())
+}
