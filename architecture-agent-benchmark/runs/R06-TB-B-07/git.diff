+// TestLessorAttachMaxKeys ensures that Attach fails once a lease already
+// holds the configured maximum number of keys, while re-attaching an item
+// already on the lease keeps working.
+func TestLessorAttachMaxKeys(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL, MaxLeaseKeys: 2})
+	defer le.Stop()
+	le.SetRangeDeleter(func() TxnDelete { return newFakeDeleter(be) })
+
+	l, err := le.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("could not grant lease for 100s ttl (%v)", err)
+	}
+
+	if err := le.CheckAttachLimit(l.ID, 2); err != nil {
+		t.Fatalf("unexpected error checking attach limit for a fresh lease: %v", err)
+	}
+	if err := le.Attach(l.ID, []LeaseItem{{Key: "foo"}, {Key: "bar"}}); err != nil {
+		t.Fatalf("failed to attach items to the lease: %v", err)
+	}
+
+	// The lease is now at the configured limit: re-attaching an existing key
+	// must still succeed.
+	if err := le.Attach(l.ID, []LeaseItem{{Key: "foo"}}); err != nil {
+		t.Fatalf("re-attaching an existing key should not fail: %v", err)
+	}
+
+	// A brand new key would push the lease over the limit.
+	if err := le.CheckAttachLimit(l.ID, 1); !errors.Is(err, ErrTooManyKeysForLease) {
+		t.Fatalf("expected ErrTooManyKeysForLease, got %v", err)
+	}
+
+	if err := le.CheckAttachLimit(NoLease+999, 1); !errors.Is(err, ErrLeaseNotFound) {
+		t.Fatalf("expected ErrLeaseNotFound for unknown lease, got %v", err)
+	}
+}
