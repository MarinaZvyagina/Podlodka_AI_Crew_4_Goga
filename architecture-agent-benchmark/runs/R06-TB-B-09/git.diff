diff --git a/server/etcdserver/txn/lease_limit.go b/server/etcdserver/txn/lease_limit.go
new file mode 100644
index 000000000..365b34f27
--- /dev/null
+++ b/server/etcdserver/txn/lease_limit.go
@@ -0,0 +1,72 @@
+// Copyright 2025 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package txn
+
+import "go.etcd.io/etcd/server/v3/lease"
+
+// leaseKeyLimiter enforces the configured maximum number of keys that may be
+// attached to a single lease. It is used while checking a request (Put or
+// Txn) before any mutation is applied, so that a request that would push a
+// lease over the limit is rejected in full instead of being applied
+// partially.
+//
+// A single leaseKeyLimiter is shared across all the operations of one
+// top-level request, so that a Txn attaching several new keys to the same
+// lease is validated against the cumulative effect of all of its puts.
+type leaseKeyLimiter struct {
+	maxKeys int
+	// pending tracks, per lease, the keys that earlier operations in this
+	// same request would newly attach to that lease.
+	pending map[lease.LeaseID]map[string]struct{}
+}
+
+func newLeaseKeyLimiter(maxKeys int) *leaseKeyLimiter {
+	return &leaseKeyLimiter{maxKeys: maxKeys}
+}
+
+// checkAttach reports whether attaching key to leaseID (whose current state
+// is l) is permitted under the configured limit. Re-attaching a key that is
+// already on the lease never counts against the limit.
+func (lk *leaseKeyLimiter) checkAttach(lessor lease.Lessor, leaseID lease.LeaseID, l *lease.Lease, key string) error {
+	if lk == nil || lk.maxKeys <= 0 {
+		return nil
+	}
+
+	if lessor.GetLease(lease.LeaseItem{Key: key}) == leaseID {
+		// key is already attached to this lease; re-attaching it does not
+		// grow the lease's key count.
+		return nil
+	}
+
+	pending := lk.pending[leaseID]
+	if _, ok := pending[key]; ok {
+		// already accounted for by an earlier operation in this request.
+		return nil
+	}
+
+	if l.ItemCount()+len(pending) >= lk.maxKeys {
+		return lease.ErrTooManyKeys
+	}
+
+	if pending == nil {
+		pending = make(map[string]struct{})
+		if lk.pending == nil {
+			lk.pending = make(map[lease.LeaseID]map[string]struct{})
+		}
+		lk.pending[leaseID] = pending
+	}
+	pending[key] = struct{}{}
+	return nil
+}
diff --git a/server/etcdserver/txn/lease_limit_test.go b/server/etcdserver/txn/lease_limit_test.go
new file mode 100644
index 000000000..1fb20ba70
--- /dev/null
+++ b/server/etcdserver/txn/lease_limit_test.go
@@ -0,0 +1,163 @@
+// Copyright 2025 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package txn
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+func setupWithRealLessor(t *testing.T) (mvcc.KV, lease.Lessor) {
+	t.Helper()
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { betesting.Close(t, b) })
+
+	lessor := lease.NewLessor(zaptest.NewLogger(t), b, nil, lease.LessorConfig{MinLeaseTTL: 1})
+	t.Cleanup(lessor.Stop)
+
+	s := mvcc.NewStore(zaptest.NewLogger(t), b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() { s.Close() })
+
+	_, err := lessor.Grant(lease.LeaseID(1), 100)
+	require.NoError(t, err)
+
+	return s, lessor
+}
+
+func assertKeyAbsent(t *testing.T, kv mvcc.KV, key string) {
+	t.Helper()
+	rr, err := kv.Range(context.Background(), []byte(key), nil, mvcc.RangeOptions{})
+	require.NoError(t, err)
+	assert.Empty(t, rr.KVs, "expected key %q to not have been written", key)
+}
+
+func TestPutRejectsKeyOverLeaseLimit(t *testing.T) {
+	kv, lessor := setupWithRealLessor(t)
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+
+	_, _, err := Put(ctx, lg, lessor, kv, &pb.PutRequest{Key: []byte("a"), Lease: 1}, 2)
+	require.NoError(t, err)
+	_, _, err = Put(ctx, lg, lessor, kv, &pb.PutRequest{Key: []byte("b"), Lease: 1}, 2)
+	require.NoError(t, err)
+
+	// lease 1 now has 2 keys attached, at the configured limit of 2.
+	_, _, err = Put(ctx, lg, lessor, kv, &pb.PutRequest{Key: []byte("c"), Lease: 1}, 2)
+	require.ErrorIs(t, err, lease.ErrTooManyKeys)
+
+	// the rejected write must not have been applied.
+	assertKeyAbsent(t, kv, "c")
+	assert.Equal(t, 2, lessor.Lookup(1).ItemCount())
+}
+
+func TestPutReattachDoesNotCountAgainstLimit(t *testing.T) {
+	kv, lessor := setupWithRealLessor(t)
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+
+	_, _, err := Put(ctx, lg, lessor, kv, &pb.PutRequest{Key: []byte("a"), Lease: 1}, 1)
+	require.NoError(t, err)
+
+	// lease is now at its limit of 1 key; re-attaching the same key must
+	// still be permitted since it does not grow the lease.
+	_, _, err = Put(ctx, lg, lessor, kv, &pb.PutRequest{Key: []byte("a"), Lease: 1}, 1)
+	require.NoError(t, err)
+	assert.Equal(t, 1, lessor.Lookup(1).ItemCount())
+
+	// a genuinely new key is still rejected.
+	_, _, err = Put(ctx, lg, lessor, kv, &pb.PutRequest{Key: []byte("b"), Lease: 1}, 1)
+	require.ErrorIs(t, err, lease.ErrTooManyKeys)
+	assertKeyAbsent(t, kv, "b")
+}
+
+func TestPutWithoutLimitConfiguredAlwaysSucceeds(t *testing.T) {
+	kv, lessor := setupWithRealLessor(t)
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+
+	for _, k := range []string{"a", "b", "c", "d"} {
+		_, _, err := Put(ctx, lg, lessor, kv, &pb.PutRequest{Key: []byte(k), Lease: 1}, 0)
+		require.NoError(t, err)
+	}
+	assert.Equal(t, 4, lessor.Lookup(1).ItemCount())
+}
+
+func TestTxnRejectsWhenCumulativeNewKeysExceedLimit(t *testing.T) {
+	kv, lessor := setupWithRealLessor(t)
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a"), Lease: 1}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("b"), Lease: 1}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("c"), Lease: 1}}},
+		},
+	}
+
+	_, _, err := Txn(ctx, lg, txn, false, kv, lessor, false, 2)
+	require.ErrorIs(t, err, lease.ErrTooManyKeys)
+
+	// none of the puts in the rejected txn should have been applied.
+	assertKeyAbsent(t, kv, "a")
+	assertKeyAbsent(t, kv, "b")
+	assertKeyAbsent(t, kv, "c")
+	assert.Equal(t, 0, lessor.Lookup(1).ItemCount())
+}
+
+func TestTxnAtExactLimitSucceeds(t *testing.T) {
+	kv, lessor := setupWithRealLessor(t)
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a"), Lease: 1}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("b"), Lease: 1}}},
+		},
+	}
+
+	_, _, err := Txn(ctx, lg, txn, false, kv, lessor, false, 2)
+	require.NoError(t, err)
+	assert.Equal(t, 2, lessor.Lookup(1).ItemCount())
+}
+
+func TestTxnReattachWithinTxnCountsOnce(t *testing.T) {
+	kv, lessor := setupWithRealLessor(t)
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+
+	// two ops attaching the same new key to the same lease in one txn must
+	// only count as a single new key against the limit.
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a"), Lease: 1}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a"), Lease: 1}}},
+		},
+	}
+
+	_, _, err := Txn(ctx, lg, txn, false, kv, lessor, false, 1)
+	require.NoError(t, err)
+	assert.Equal(t, 1, lessor.Lookup(1).ItemCount())
+}
