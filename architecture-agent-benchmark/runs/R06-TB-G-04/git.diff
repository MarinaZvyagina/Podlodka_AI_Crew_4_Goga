+// TestLessorMaxLeaseAttachedKeys ensures the configured max-attached-keys
+// limit is exposed by the lessor, defaults to unlimited (0) when unset, and
+// that Attach itself (used by recovery) is never capped -- the limit is only
+// enforced by callers (see etcdserver/txn.checkLease) before Attach is
+// called for a new write.
+func TestLessorMaxLeaseAttachedKeys(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL})
+	defer le.Stop()
+	if got := le.MaxLeaseAttachedKeys(); got != 0 {
+		t.Fatalf("MaxLeaseAttachedKeys() with unset config = %d, want 0 (unlimited)", got)
+	}
+
+	dir2, be2 := NewTestBackend(t)
+	defer os.RemoveAll(dir2)
+	defer be2.Close()
+
+	le2 := newLessor(lg, be2, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL, MaxLeaseAttachedKeys: 1})
+	defer le2.Stop()
+	if got := le2.MaxLeaseAttachedKeys(); got != 1 {
+		t.Fatalf("MaxLeaseAttachedKeys() = %d, want 1", got)
+	}
+
+	l, err := le2.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("could not grant lease (%v)", err)
+	}
+	// Attach is used by mvcc recovery, which must always be able to restore
+	// however many keys were persisted, even beyond the configured limit.
+	if err := le2.Attach(l.ID, []LeaseItem{{"foo"}, {"bar"}}); err != nil {
+		t.Fatalf("Attach beyond limit failed: %v", err)
+	}
+	if got := le2.Lookup(l.ID).Len(); got != 2 {
+		t.Fatalf("Len() = %d, want 2", got)
+	}
+}
