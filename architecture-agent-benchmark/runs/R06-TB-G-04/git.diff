+package lease
+
+import "testing"
+
+func TestLeaseLenAndContains(t *testing.T) {
+	l := NewLease(1, 60)
+
+	if got := l.Len(); got != 0 {
+		t.Fatalf("Len() on empty lease = %d, want 0", got)
+	}
+	if l.Contains(LeaseItem{Key: "foo"}) {
+		t.Fatalf("Contains() on empty lease = true, want false")
+	}
+
+	l.SetLeaseItem(LeaseItem{Key: "foo"})
+
+	if got := l.Len(); got != 1 {
+		t.Fatalf("Len() = %d, want 1", got)
+	}
+	if !l.Contains(LeaseItem{Key: "foo"}) {
+		t.Fatalf("Contains(foo) = false, want true")
+	}
+	if l.Contains(LeaseItem{Key: "bar"}) {
+		t.Fatalf("Contains(bar) = true, want false")
+	}
+
+	// re-setting an already attached item must not change the count.
+	l.SetLeaseItem(LeaseItem{Key: "foo"})
+	if got := l.Len(); got != 1 {
+		t.Fatalf("Len() after re-set = %d, want 1", got)
+	}
+}
+
+func TestLeaseLenAndContainsOnZeroValue(t *testing.T) {
+	// Lease objects returned by fake/simple lessors (and by recovery code
+	// before keys are reattached) may have a nil itemSet.
+	l := &Lease{ID: 1}
+
+	if got := l.Len(); got != 0 {
+		t.Fatalf("Len() on zero-value lease = %d, want 0", got)
+	}
+	if l.Contains(LeaseItem{Key: "foo"}) {
+		t.Fatalf("Contains() on zero-value lease = true, want false")
+	}
+}
