+// TestPutMaxLeaseAttachedKeys ensures that a Put which would attach a new
+// key to a lease beyond the configured limit is rejected with a clear
+// error, that re-attaching a key already on the lease is never rejected
+// even when the lease is at (or over) the limit, and that a Txn rejects the
+// whole request without applying any of it when one of its Put ops would
+// exceed the limit.
+func TestPutMaxLeaseAttachedKeys(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() {
+		betesting.Close(t, b)
+	})
+	lg := zaptest.NewLogger(t)
+	cluster := membership.NewCluster(lg)
+	cluster.SetBackend(schema.NewMembershipBackend(lg, b))
+	lessor := lease.NewLessor(lg, b, cluster, lease.LessorConfig{MaxLeaseAttachedKeys: 2})
+	s := mvcc.NewStore(lg, b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() {
+		s.Close()
+	})
+
+	if _, err := lessor.Grant(1, 100); err != nil {
+		t.Fatalf("could not grant lease: %v", err)
+	}
+
+	ctx := t.Context()
+
+	// Attach two distinct new keys: at the limit, must succeed.
+	if _, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k1"), Lease: 1}); err != nil {
+		t.Fatalf("Put(k1) failed: %v", err)
+	}
+	if _, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k2"), Lease: 1}); err != nil {
+		t.Fatalf("Put(k2) failed: %v", err)
+	}
+
+	// A third new key would exceed the limit: must be rejected, cleanly.
+	_, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k3"), Lease: 1})
+	if !strings.Contains(err.Error(), "too many keys attached to lease") {
+		t.Fatalf("Put(k3) error = %v, want too-many-keys error", err)
+	}
+	if got := lessor.Lookup(1).Len(); got != 2 {
+		t.Fatalf("lease key count after rejected put = %d, want 2 (unchanged)", got)
+	}
+
+	// Re-attaching a key already on the lease must not be rejected, even
+	// though the lease is at the limit.
+	if _, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k1"), Value: []byte("v2"), Lease: 1}); err != nil {
+		t.Fatalf("re-Put(k1) failed: %v", err)
+	}
+
+	revBefore := s.Rev()
+
+	// A Txn where one Put would exceed the limit must fail atomically:
+	// none of its ops (including the one for a brand-new key) apply.
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("k4")}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("k3"), Lease: 1}}},
+		},
+	}
+	_, _, err = Txn(ctx, lg, txn, false, s, lessor, false)
+	if !strings.Contains(err.Error(), "too many keys attached to lease") {
+		t.Fatalf("Txn error = %v, want too-many-keys error", err)
+	}
+	if s.Rev() != revBefore {
+		t.Fatalf("revision changed after rejected txn: before=%d after=%d", revBefore, s.Rev())
+	}
+	if got := lessor.Lookup(1).Len(); got != 2 {
+		t.Fatalf("lease key count after rejected txn = %d, want 2 (unchanged)", got)
+	}
+	if l := lessor.GetLease(lease.LeaseItem{Key: "k4"}); l != lease.NoLease {
+		t.Fatalf("k4 should not have been written by the rejected txn, got lease %v", l)
+	}
+}
