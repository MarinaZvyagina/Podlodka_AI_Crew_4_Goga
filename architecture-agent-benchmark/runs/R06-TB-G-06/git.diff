+// fakeCluster is a minimal implementation satisfying the unexported
+// lease.cluster interface, sufficient for lease.NewLessor in tests that
+// don't exercise checkpoint persistence.
+type fakeCluster struct{}
+
+func (fakeCluster) Version() *semver.Version { return nil }
+
+func setupWithRealLessor(t *testing.T, maxLeaseKeys int) (mvcc.KV, lease.Lessor) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() {
+		betesting.Close(t, b)
+	})
+	lessor := lease.NewLessor(zaptest.NewLogger(t), b, fakeCluster{}, lease.LessorConfig{
+		MinLeaseTTL:  1,
+		MaxLeaseKeys: maxLeaseKeys,
+	})
+	t.Cleanup(lessor.Stop)
+	s := mvcc.NewStore(zaptest.NewLogger(t), b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() {
+		s.Close()
+	})
+	return s, lessor
+}
+
+// TestPutLeaseKeyLimit ensures that attaching a new key to a lease that is
+// already at the configured maximum is rejected, while re-attaching a key
+// already on the lease keeps working, and the server stays otherwise usable.
+func TestPutLeaseKeyLimit(t *testing.T) {
+	s, lessor := setupWithRealLessor(t, 2)
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+
+	if _, err := lessor.Grant(1, 100); err != nil {
+		t.Fatalf("failed to grant lease: %v", err)
+	}
+
+	// Fill the lease up to its limit.
+	if _, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k1"), Lease: 1}); err != nil {
+		t.Fatalf("unexpected error attaching first key: %v", err)
+	}
+	if _, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k2"), Lease: 1}); err != nil {
+		t.Fatalf("unexpected error attaching second key: %v", err)
+	}
+
+	// A new key beyond the limit must be rejected.
+	if _, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k3"), Lease: 1}); !errors.Is(err, lease.ErrTooManyKeysForLease) {
+		t.Fatalf("expected ErrTooManyKeysForLease, got %v", err)
+	}
+
+	// Re-attaching (overwriting) an already-attached key must still succeed.
+	if _, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k1"), Value: []byte("v2"), Lease: 1}); err != nil {
+		t.Fatalf("re-attaching an existing key should succeed, got %v", err)
+	}
+
+	// The server must remain healthy: a normal unrelated write still works.
+	if _, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("unrelated")}); err != nil {
+		t.Fatalf("server should remain usable after rejection, got %v", err)
+	}
+}
+
+// TestTxnLeaseKeyLimitAcrossOps ensures that a single Txn request whose
