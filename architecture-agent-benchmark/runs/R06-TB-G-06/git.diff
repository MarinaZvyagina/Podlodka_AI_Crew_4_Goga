+// TestLessorMaxLeaseKeys ensures that CanAttach rejects a new key once a
+// lease has reached the configured maximum number of keys, while
+// re-attaching an already-attached key keeps working.
+func TestLessorMaxLeaseKeys(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL, MaxLeaseKeys: 2})
+	defer le.Stop()
+	le.Promote(0)
+
+	l, err := le.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("could not grant lease (%v)", err)
+	}
+
+	if err = le.Attach(l.ID, []LeaseItem{{Key: "foo"}, {Key: "bar"}}); err != nil {
+		t.Fatalf("failed to attach items within the limit: %v", err)
+	}
+
+	if err = le.CanAttach(l.ID, LeaseItem{Key: "foo"}, 0); err != nil {
+		t.Errorf("re-attaching an existing key should be permitted, got error: %v", err)
+	}
+
+	if err = le.CanAttach(l.ID, LeaseItem{Key: "baz"}, 0); !errors.Is(err, ErrTooManyKeysForLease) {
+		t.Errorf("expected ErrTooManyKeysForLease for a new key beyond the limit, got: %v", err)
+	}
+
+	if err = le.CanAttach(l.ID, LeaseItem{Key: "baz"}, 1); !errors.Is(err, ErrTooManyKeysForLease) {
+		t.Errorf("expected ErrTooManyKeysForLease when pending count already reaches the limit, got: %v", err)
+	}
+
+	if err = le.CanAttach(9999, LeaseItem{Key: "foo"}, 0); !errors.Is(err, ErrLeaseNotFound) {
+		t.Errorf("expected ErrLeaseNotFound for a non-existing lease, got: %v", err)
+	}
+}
