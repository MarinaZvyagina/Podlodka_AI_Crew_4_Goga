+func TestTxnLeaseKeyLimitAcrossOps(t *testing.T) {
+	s, lessor := setupWithRealLessor(t, 2)
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+
+	if _, err := lessor.Grant(1, 100); err != nil {
+		t.Fatalf("failed to grant lease: %v", err)
+	}
+
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a"), Lease: 1}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("b"), Lease: 1}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("c"), Lease: 1}}},
+		},
+	}
+
+	_, _, err := Txn(ctx, lg, txn, false, s, lessor, false)
+	if !errors.Is(err, lease.ErrTooManyKeysForLease) {
+		t.Fatalf("expected ErrTooManyKeysForLease, got %v", err)
+	}
+
+	// None of the keys should have been attached since the whole txn failed.
+	l := lessor.Lookup(1)
+	if got := len(l.Keys()); got != 0 {
+		t.Fatalf("expected no keys attached after rejected txn, got %d", got)
+	}
+}
