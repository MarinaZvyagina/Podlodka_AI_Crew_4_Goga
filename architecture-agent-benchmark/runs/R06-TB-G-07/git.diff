+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/etcdserver/api/membership"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+	"go.etcd.io/etcd/server/v3/storage/schema"
+)
+
+// setupWithRealLessor builds a KV store backed by a real Lessor (rather than
+// lease.FakeLessor), so that lease key-count enforcement can be exercised.
+func setupWithRealLessor(t *testing.T, maxLeaseKeys int) (mvcc.KV, lease.Lessor) {
+	t.Helper()
+	lg := zaptest.NewLogger(t)
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() {
+		betesting.Close(t, b)
+	})
+
+	cluster := membership.NewCluster(lg)
+	cluster.SetBackend(schema.NewMembershipBackend(lg, b))
+
+	lessor := lease.NewLessor(lg, b, cluster, lease.LessorConfig{MaxLeaseKeys: maxLeaseKeys})
+	t.Cleanup(lessor.Stop)
+
+	s := mvcc.NewStore(lg, b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() {
+		s.Close()
+	})
+
+	return s, lessor
+}
+
+// TestCheckPutMaxLeaseKeys verifies that a Put attaching a new key to a
+// lease that is already at its configured key-count limit is rejected,
+// while re-attaching a key already on that lease keeps working.
+func TestCheckPutMaxLeaseKeys(t *testing.T) {
+	s, lessor := setupWithRealLessor(t, 2)
+
+	_, err := lessor.Grant(1, 100)
+	require.NoError(t, err)
+
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k1"), Lease: 1})
+	require.NoError(t, err)
+
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k2"), Lease: 1})
+	require.NoError(t, err)
+
+	// a third distinct key would exceed the configured limit of 2.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k3"), Lease: 1})
+	require.True(t, errors.Is(err, lease.ErrTooManyLeaseKeys), "expected ErrTooManyLeaseKeys, got %v", err)
+
+	// the lease must still have exactly its first two keys attached.
+	l := lessor.Lookup(1)
+	require.Equal(t, 2, l.Len())
+
+	// re-attaching an already-attached key must not be rejected, even
+	// though the lease is at its limit.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k1"), Value: []byte("v2"), Lease: 1})
+	require.NoError(t, err)
+	require.Equal(t, 2, l.Len())
+
+	// the server must remain otherwise healthy: unrelated writes keep working.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("unrelated")})
+	require.NoError(t, err)
+}
+
+// TestCheckPutMaxLeaseKeysWithinTxn verifies that a Txn containing a put
+// which would exceed the lease key limit is rejected in full, without
+// partially applying any of its other operations.
+func TestCheckPutMaxLeaseKeysWithinTxn(t *testing.T) {
+	s, lessor := setupWithRealLessor(t, 1)
+
+	_, err := lessor.Grant(1, 100)
+	require.NoError(t, err)
+
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{
+				Request: &pb.RequestOp_RequestPut{
+					RequestPut: &pb.PutRequest{Key: []byte("ok"), Value: []byte("v")},
+				},
+			},
+			{
+				Request: &pb.RequestOp_RequestPut{
+					RequestPut: &pb.PutRequest{Key: []byte("k1"), Lease: 1},
+				},
+			},
+			{
+				Request: &pb.RequestOp_RequestPut{
+					RequestPut: &pb.PutRequest{Key: []byte("k2"), Lease: 1},
+				},
+			},
+		},
+	}
+
+	_, _, err = Txn(ctx, lg, txn, false, s, lessor, false)
+	require.True(t, errors.Is(err, lease.ErrTooManyLeaseKeys), "expected ErrTooManyLeaseKeys, got %v", err)
+
+	// none of the txn's operations, including the unrelated first put,
+	// should have been applied.
+	rtx := s.Read(mvcc.ConcurrentReadTxMode, traceutil.TODO())
+	rr, err := rtx.Range(ctx, []byte("ok"), nil, mvcc.RangeOptions{})
+	rtx.End()
+	require.NoError(t, err)
+	require.Empty(t, rr.KVs)
+
+	l := lessor.Lookup(1)
+	require.Equal(t, 0, l.Len())
+}
