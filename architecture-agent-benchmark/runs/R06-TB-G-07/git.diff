+// TestLessorMaxLeaseKeys ensures the configured (or default) maximum number
+// of keys per lease is exposed via MaxLeaseKeys, and that Lease.Len reports
+// the number of currently attached keys.
+func TestLessorMaxLeaseKeys(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL})
+	defer le.Stop()
+	if le.MaxLeaseKeys() != DefaultMaxLeaseKeys {
+		t.Fatalf("MaxLeaseKeys() = %d, want default %d", le.MaxLeaseKeys(), DefaultMaxLeaseKeys)
+	}
+
+	dir2, be2 := NewTestBackend(t)
+	defer os.RemoveAll(dir2)
+	defer be2.Close()
+	le2 := newLessor(lg, be2, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL, MaxLeaseKeys: 3})
+	defer le2.Stop()
+	if le2.MaxLeaseKeys() != 3 {
+		t.Fatalf("MaxLeaseKeys() = %d, want 3", le2.MaxLeaseKeys())
+	}
+
+	l, err := le2.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("could not grant lease (%v)", err)
+	}
+	if l.Len() != 0 {
+		t.Fatalf("Len() = %d, want 0 for a freshly granted lease", l.Len())
+	}
+
+	// Attach itself does not enforce the configured limit: it is the
+	// unconditional, low-level mutation used both by client writes (after
+	// the etcdserver txn layer has already validated the limit) and by
+	// backend recovery, which must be able to restore leases that predate
+	// a newly configured (or lowered) limit.
+	items := []LeaseItem{{"a"}, {"b"}, {"c"}, {"d"}}
+	if err := le2.Attach(l.ID, items); err != nil {
+		t.Fatalf("failed to attach items to the lease: %v", err)
+	}
+	if l.Len() != len(items) {
+		t.Fatalf("Len() = %d, want %d", l.Len(), len(items))
+	}
+}
