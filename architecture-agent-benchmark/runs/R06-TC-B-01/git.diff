+package v3rpc
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestAuditKVRequestInfo(t *testing.T) {
+	tests := []struct {
+		name    string
+		req     any
+		wantOp  string
+		wantKey string
+		wantOK  bool
+	}{
+		{
+			name:    "range single key",
+			req:     &pb.RangeRequest{Key: []byte("foo")},
+			wantOp:  "read",
+			wantKey: "foo",
+			wantOK:  true,
+		},
+		{
+			name:    "range with range end",
+			req:     &pb.RangeRequest{Key: []byte("foo"), RangeEnd: []byte("fop")},
+			wantOp:  "read",
+			wantKey: "[foo, fop)",
+			wantOK:  true,
+		},
+		{
+			name:    "put",
+			req:     &pb.PutRequest{Key: []byte("foo"), Value: []byte("bar")},
+			wantOp:  "write",
+			wantKey: "foo",
+			wantOK:  true,
+		},
+		{
+			name:    "delete range",
+			req:     &pb.DeleteRangeRequest{Key: []byte("foo"), RangeEnd: []byte("fop")},
+			wantOp:  "delete",
+			wantKey: "[foo, fop)",
+			wantOK:  true,
+		},
+		{
+			name: "txn",
+			req: &pb.TxnRequest{
+				Compare: []*pb.Compare{{Key: []byte("a")}},
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a")}}},
+				},
+				Failure: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("b"), RangeEnd: []byte("c")}}},
+				},
+			},
+			wantOp:  "transaction",
+			wantKey: "a,[b, c)",
+			wantOK:  true,
+		},
+		{
+			name:   "unaudited request type",
+			req:    &pb.CompactionRequest{Revision: 1},
+			wantOK: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			op, key, ok := auditKVRequestInfo(tt.req)
+			assert.Equal(t, tt.wantOK, ok)
+			if tt.wantOK {
+				assert.Equal(t, tt.wantOp, op)
+				assert.Equal(t, tt.wantKey, key)
+			}
+		})
+	}
+}
+
+func TestFormatTxnKeysDedupesAndRecursesNestedTxn(t *testing.T) {
+	nested := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("nested")}}},
+		},
+	}
+	req := &pb.TxnRequest{
+		Compare: []*pb.Compare{{Key: []byte("dup")}},
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("dup")}}},
+			{Request: &pb.RequestOp_RequestTxn{RequestTxn: nested}},
+		},
+	}
+
+	assert.Equal(t, "dup,nested", formatTxnKeys(req))
+}
