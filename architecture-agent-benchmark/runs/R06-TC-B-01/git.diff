+package v3rpc
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	"go.uber.org/zap"
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/etcdserver"
+)
+
+// auditUnauthenticatedIdentity is recorded as the caller identity when auth is
+// disabled, or when no identity could be resolved for the request.
+const auditUnauthenticatedIdentity = "unauthenticated"
+
+// newAuditUnaryInterceptor returns a gRPC unary interceptor that produces a uniform
+// compliance audit record for every key-value read, write, delete, and transaction
+// request handled by the server: caller identity, operation kind, key or key range,
+// duration, and outcome.
+//
+// Requests are classified generically from their protobuf request type rather than
+// per-handler, so every KV request of these kinds is covered automatically -- no
+// per-request-type instrumentation is required as new request types are added. The
+// interceptor only observes the request/response already produced by the handler;
+// it never alters them or the error returned to the client.
+func newAuditUnaryInterceptor(s *etcdserver.EtcdServer) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		op, key, ok := auditKVRequestInfo(req)
+		if !ok {
+			return handler(ctx, req)
+		}
+
+		start := time.Now()
+		resp, err := handler(ctx, req)
+
+		if lg := s.Logger(); lg != nil {
+			logAuditRecord(lg, s, ctx, op, key, time.Since(start), err)
+		}
+		return resp, err
+	}
+}
+
+func logAuditRecord(lg *zap.Logger, s *etcdserver.EtcdServer, ctx context.Context, op, key string, duration time.Duration, err error) {
+	identity := auditUnauthenticatedIdentity
+	if authInfo, aerr := s.AuthInfoFromCtx(ctx); aerr == nil && authInfo != nil && authInfo.Username != "" {
+		identity = authInfo.Username
+	}
+
+	fields := []zap.Field{
+		zap.String("caller", identity),
+		zap.String("operation", op),
+		zap.String("key", key),
+		zap.Duration("duration", duration),
+		zap.Bool("success", err == nil),
+	}
+	if err != nil {
+		fields = append(fields, zap.Error(err))
+	}
+	lg.Info("kv audit", fields...)
+}
+
+// auditKVRequestInfo classifies a request into an audit operation kind and a
+// description of the key or key range it involves. ok is false for request types
+// outside the compliance audit scope (e.g. Compact, or any non-KV request), which
+// are left to pass through unaudited.
+func auditKVRequestInfo(req any) (op, key string, ok bool) {
+	switch r := req.(type) {
+	case *pb.RangeRequest:
+		return "read", formatKeyRange(r.GetKey(), r.GetRangeEnd()), true
+	case *pb.PutRequest:
+		return "write", formatKeyRange(r.GetKey(), nil), true
+	case *pb.DeleteRangeRequest:
+		return "delete", formatKeyRange(r.GetKey(), r.GetRangeEnd()), true
+	case *pb.TxnRequest:
+		return "transaction", formatTxnKeys(r), true
+	default:
+		return "", "", false
+	}
+}
+
+func formatKeyRange(key, rangeEnd []byte) string {
+	if len(key) == 0 {
+		return ""
+	}
+	if len(rangeEnd) == 0 {
+		return string(key)
+	}
+	return fmt.Sprintf("[%s, %s)", key, rangeEnd)
+}
+
+// formatTxnKeys collects every key or key range referenced anywhere in a
+// transaction request -- its compare guards and both of its branches -- so the
+// audit record reflects everything the transaction could touch, regardless of
+// which branch ends up executing.
+func formatTxnKeys(r *pb.TxnRequest) string {
+	seen := make(map[string]struct{})
+	var keys []string
+	add := func(k string) {
+		if k == "" {
+			return
+		}
+		if _, dup := seen[k]; dup {
+			return
+		}
+		seen[k] = struct{}{}
+		keys = append(keys, k)
+	}
+
+	for _, c := range r.GetCompare() {
+		add(formatKeyRange(c.GetKey(), c.GetRangeEnd()))
+	}
+	addAuditRequestOpKeys(r.GetSuccess(), add)
+	addAuditRequestOpKeys(r.GetFailure(), add)
+
+	return strings.Join(keys, ",")
+}
+
+func addAuditRequestOpKeys(ops []*pb.RequestOp, add func(string)) {
+	for _, op := range ops {
+		switch o := op.GetRequest().(type) {
+		case *pb.RequestOp_RequestRange:
+			add(formatKeyRange(o.RequestRange.GetKey(), o.RequestRange.GetRangeEnd()))
+		case *pb.RequestOp_RequestPut:
+			add(formatKeyRange(o.RequestPut.GetKey(), nil))
+		case *pb.RequestOp_RequestDeleteRange:
+			add(formatKeyRange(o.RequestDeleteRange.GetKey(), o.RequestDeleteRange.GetRangeEnd()))
+		case *pb.RequestOp_RequestTxn:
+			for _, c := range o.RequestTxn.GetCompare() {
+				add(formatKeyRange(c.GetKey(), c.GetRangeEnd()))
+			}
+			addAuditRequestOpKeys(o.RequestTxn.GetSuccess(), add)
+			addAuditRequestOpKeys(o.RequestTxn.GetFailure(), add)
+		}
+	}
+}
