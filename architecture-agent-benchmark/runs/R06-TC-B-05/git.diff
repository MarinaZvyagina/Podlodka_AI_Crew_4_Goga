+package v3rpc
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestAuditOperation(t *testing.T) {
+	tests := []struct {
+		name          string
+		fullMethod    string
+		req           any
+		wantOperation string
+		wantKey       string
+	}{
+		{
+			name:          "range without range_end",
+			fullMethod:    "/etcdserverpb.KV/Range",
+			req:           &pb.RangeRequest{Key: []byte("foo")},
+			wantOperation: "read",
+			wantKey:       "foo",
+		},
+		{
+			name:          "range with range_end",
+			fullMethod:    "/etcdserverpb.KV/Range",
+			req:           &pb.RangeRequest{Key: []byte("foo"), RangeEnd: []byte("fop")},
+			wantOperation: "read",
+			wantKey:       "[foo, fop)",
+		},
+		{
+			name:          "put",
+			fullMethod:    "/etcdserverpb.KV/Put",
+			req:           &pb.PutRequest{Key: []byte("foo"), Value: []byte("bar")},
+			wantOperation: "write",
+			wantKey:       "foo",
+		},
+		{
+			name:          "delete range",
+			fullMethod:    "/etcdserverpb.KV/DeleteRange",
+			req:           &pb.DeleteRangeRequest{Key: []byte("foo"), RangeEnd: []byte("fop")},
+			wantOperation: "delete",
+			wantKey:       "[foo, fop)",
+		},
+		{
+			name:       "txn",
+			fullMethod: "/etcdserverpb.KV/Txn",
+			req: &pb.TxnRequest{
+				Compare: []*pb.Compare{{Key: []byte("foo")}},
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("foo")}}},
+				},
+				Failure: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("bar")}}},
+				},
+			},
+			wantOperation: "transaction",
+			wantKey:       "foo,bar",
+		},
+		{
+			name:          "unknown KV request type still gets an audit entry",
+			fullMethod:    "/etcdserverpb.KV/Compact",
+			req:           &pb.CompactionRequest{Revision: 5},
+			wantOperation: "Compact",
+			wantKey:       "",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			operation, key := auditOperation(tt.fullMethod, tt.req)
+			assert.Equal(t, tt.wantOperation, operation)
+			assert.Equal(t, tt.wantKey, key)
+		})
+	}
+}
+
+func TestCollectTxnKeys(t *testing.T) {
+	nested := &pb.TxnRequest{
+		Compare: []*pb.Compare{{Key: []byte("nested-cmp")}},
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("nested-del")}}},
+		},
+	}
+	txn := &pb.TxnRequest{
+		Compare: []*pb.Compare{{Key: []byte("top-cmp")}},
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestTxn{RequestTxn: nested}},
+		},
+	}
+
+	keys := collectTxnKeys(txn)
+	got := make([]string, 0, len(keys))
+	for _, k := range keys {
+		got = append(got, string(k))
+	}
+	assert.ElementsMatch(t, []string{"top-cmp", "nested-cmp", "nested-del"}, got)
+}
+
+func TestFormatKeys(t *testing.T) {
+	assert.Equal(t, "", formatKeys(nil))
+	assert.Equal(t, "foo", formatKeys([][]byte{[]byte("foo")}))
+	assert.Equal(t, "foo,bar", formatKeys([][]byte{[]byte("foo"), []byte("bar"), []byte("foo")}))
+}
