+package v3rpc
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	"go.uber.org/zap"
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/etcdserver"
+)
+
+// kvServiceMethodPrefix is the gRPC method prefix shared by every request
+// handled by the KV service. Filtering on it (rather than on individual
+// method names) means newly added KV RPCs are audited automatically.
+const kvServiceMethodPrefix = "/etcdserverpb.KV/"
+
+// newAuditUnaryInterceptor returns an interceptor that produces a single
+// audit record for every key-value request handled by the server: who made
+// it, what kind of operation it was, which key or key range it touched, how
+// long it took, and whether it succeeded. Because it hooks into the gRPC
+// interceptor chain rather than individual handlers, coverage is uniform:
+// no KV request type can be missed by forgetting to add logging to it.
+func newAuditUnaryInterceptor(s *etcdserver.EtcdServer) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		if !strings.HasPrefix(info.FullMethod, kvServiceMethodPrefix) {
+			return handler(ctx, req)
+		}
+
+		start := time.Now()
+		resp, err := handler(ctx, req)
+
+		if lg := s.Logger(); lg != nil {
+			logKVAudit(ctx, lg, s, info.FullMethod, req, time.Since(start), err)
+		}
+
+		return resp, err
+	}
+}
+
+func logKVAudit(ctx context.Context, lg *zap.Logger, s *etcdserver.EtcdServer, fullMethod string, req any, duration time.Duration, err error) {
+	operation, key := auditOperation(fullMethod, req)
+
+	fields := []zap.Field{
+		zap.String("caller", auditCaller(ctx, s)),
+		zap.String("operation", operation),
+		zap.String("key", key),
+		zap.Duration("duration", duration),
+		zap.Bool("success", err == nil),
+	}
+	if err != nil {
+		fields = append(fields, zap.Error(err))
+	}
+	lg.Info("kv audit", fields...)
+}
+
+// auditCaller returns the authenticated username for the request, or
+// "unauthenticated" if auth is disabled or no identity is available.
+func auditCaller(ctx context.Context, s *etcdserver.EtcdServer) string {
+	authInfo, err := s.AuthStore().AuthInfoFromCtx(ctx)
+	if err != nil || authInfo == nil || authInfo.Username == "" {
+		return "unauthenticated"
+	}
+	return authInfo.Username
+}
+
+// auditOperation classifies the request and extracts the key or key range
+// it touched. The default case still produces an operation label (derived
+// from the method name) and best-effort key info for any KV request type
+// not explicitly known, so newly added request types are never dropped from
+// the audit trail even before they get dedicated handling here.
+func auditOperation(fullMethod string, req any) (operation, key string) {
+	switch r := req.(type) {
+	case *pb.RangeRequest:
+		return "read", formatKeyRange(r.GetKey(), r.GetRangeEnd())
+	case *pb.PutRequest:
+		return "write", formatKeyRange(r.GetKey(), nil)
+	case *pb.DeleteRangeRequest:
+		return "delete", formatKeyRange(r.GetKey(), r.GetRangeEnd())
+	case *pb.TxnRequest:
+		return "transaction", formatKeys(collectTxnKeys(r))
+	default:
+		return strings.TrimPrefix(fullMethod, kvServiceMethodPrefix), ""
+	}
+}
+
+func formatKeyRange(key, rangeEnd []byte) string {
+	if len(key) == 0 {
+		return ""
+	}
+	if len(rangeEnd) == 0 {
+		return string(key)
+	}
+	return fmt.Sprintf("[%s, %s)", key, rangeEnd)
+}
+
+func formatKeys(keys [][]byte) string {
+	if len(keys) == 0 {
+		return ""
+	}
+	seen := make(map[string]struct{}, len(keys))
+	parts := make([]string, 0, len(keys))
+	for _, k := range keys {
+		s := string(k)
+		if _, ok := seen[s]; ok {
+			continue
+		}
+		seen[s] = struct{}{}
+		parts = append(parts, s)
+	}
+	return strings.Join(parts, ",")
+}
+
+// collectTxnKeys gathers every key touched by a (possibly nested)
+// transaction: the compare guards plus the puts/deletes/sub-transactions in
+// both its success and failure branches.
+func collectTxnKeys(r *pb.TxnRequest) [][]byte {
+	keys := make([][]byte, 0, len(r.GetCompare()))
+	for _, c := range r.GetCompare() {
+		keys = append(keys, c.GetKey())
+	}
+	keys = append(keys, collectRequestOpKeys(r.GetSuccess())...)
+	keys = append(keys, collectRequestOpKeys(r.GetFailure())...)
+	return keys
+}
+
+func collectRequestOpKeys(ops []*pb.RequestOp) [][]byte {
+	var keys [][]byte
+	for _, op := range ops {
+		switch tv := op.GetRequest().(type) {
+		case *pb.RequestOp_RequestRange:
+			keys = append(keys, tv.RequestRange.GetKey())
+		case *pb.RequestOp_RequestPut:
+			keys = append(keys, tv.RequestPut.GetKey())
+		case *pb.RequestOp_RequestDeleteRange:
+			keys = append(keys, tv.RequestDeleteRange.GetKey())
+		case *pb.RequestOp_RequestTxn:
+			keys = append(keys, collectTxnKeys(tv.RequestTxn)...)
+		}
+	}
+	return keys
+}
