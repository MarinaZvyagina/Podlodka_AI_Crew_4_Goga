+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package v3rpc
+
+import (
+	"errors"
+	"testing"
+	"time"
+
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+	"go.uber.org/zap/zaptest/observer"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestAuditKVRequest(t *testing.T) {
+	tests := []struct {
+		name      string
+		req       any
+		wantOp    string
+		wantKeys  []auditKeyRange
+		wantAudit bool
+	}{
+		{
+			name:      "range",
+			req:       &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")},
+			wantOp:    "read",
+			wantKeys:  []auditKeyRange{{key: []byte("a"), rangeEnd: []byte("z")}},
+			wantAudit: true,
+		},
+		{
+			name:      "put",
+			req:       &pb.PutRequest{Key: []byte("a"), Value: []byte("v")},
+			wantOp:    "write",
+			wantKeys:  []auditKeyRange{{key: []byte("a")}},
+			wantAudit: true,
+		},
+		{
+			name:      "delete range",
+			req:       &pb.DeleteRangeRequest{Key: []byte("a"), RangeEnd: []byte("z")},
+			wantOp:    "delete",
+			wantKeys:  []auditKeyRange{{key: []byte("a"), rangeEnd: []byte("z")}},
+			wantAudit: true,
+		},
+		{
+			name: "txn",
+			req: &pb.TxnRequest{
+				Compare: []*pb.Compare{{Key: []byte("c")}},
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("s")}}},
+				},
+				Failure: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("f"), RangeEnd: []byte("fz")}}},
+					{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+						Success: []*pb.RequestOp{
+							{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("nested")}}},
+						},
+					}}},
+				},
+			},
+			wantOp: "transaction",
+			wantKeys: []auditKeyRange{
+				{key: []byte("c")},
+				{key: []byte("s")},
+				{key: []byte("f"), rangeEnd: []byte("fz")},
+				{key: []byte("nested")},
+			},
+			wantAudit: true,
+		},
+		{
+			name:      "unrelated request type is not audited",
+			req:       &pb.StatusRequest{},
+			wantAudit: false,
+		},
+		{
+			name:      "nil request is not audited",
+			req:       nil,
+			wantAudit: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			op, keys, ok := auditKVRequest(tt.req)
+			if ok != tt.wantAudit {
+				t.Fatalf("auditKVRequest() ok = %v, want %v", ok, tt.wantAudit)
+			}
+			if !ok {
+				return
+			}
+			if op != tt.wantOp {
+				t.Errorf("operation = %q, want %q", op, tt.wantOp)
+			}
+			if len(keys) != len(tt.wantKeys) {
+				t.Fatalf("keys = %v, want %v", keys, tt.wantKeys)
+			}
+			for i := range keys {
+				if string(keys[i].key) != string(tt.wantKeys[i].key) || string(keys[i].rangeEnd) != string(tt.wantKeys[i].rangeEnd) {
+					t.Errorf("keys[%d] = %+v, want %+v", i, keys[i], tt.wantKeys[i])
+				}
+			}
+		})
+	}
+}
+
+func TestFormatAuditKeys(t *testing.T) {
+	got := formatAuditKeys([]auditKeyRange{
+		{key: []byte("foo")},
+		{key: []byte("a"), rangeEnd: []byte("z")},
+	})
+	want := []string{"foo", "[a, z)"}
+	if len(got) != len(want) {
+		t.Fatalf("formatAuditKeys() = %v, want %v", got, want)
+	}
+	for i := range got {
+		if got[i] != want[i] {
+			t.Errorf("formatAuditKeys()[%d] = %q, want %q", i, got[i], want[i])
+		}
+	}
+}
+
+func TestLogAuditRecord(t *testing.T) {
+	core, logs := observer.New(zap.DebugLevel)
+	lg := zap.New(core)
+
+	start := time.Now()
+	logAuditRecord(lg, "alice", "write", []auditKeyRange{{key: []byte("foo")}}, start, 5*time.Millisecond, nil)
+	logAuditRecord(lg, "unauthenticated", "delete", []auditKeyRange{{key: []byte("bar")}}, start, time.Millisecond, errors.New("boom"))
+
+	entries := logs.All()
+	if len(entries) != 2 {
+		t.Fatalf("got %d log entries, want 2", len(entries))
+	}
+
+	first := entries[0].ContextMap()
+	if first["identity"] != "alice" || first["operation"] != "write" || first["outcome"] != "success" {
+		t.Errorf("unexpected fields in success record: %+v", first)
+	}
+	if _, ok := first["error"]; ok {
+		t.Errorf("success record should not include an error field: %+v", first)
+	}
+
+	second := entries[1].ContextMap()
+	if second["identity"] != "unauthenticated" || second["operation"] != "delete" || second["outcome"] != "failure" {
+		t.Errorf("unexpected fields in failure record: %+v", second)
+	}
+	if second["error"] != "boom" {
+		t.Errorf("failure record error = %v, want %q", second["error"], "boom")
+	}
+
+	if entries[0].Level != zapcore.InfoLevel {
+		t.Errorf("audit record level = %v, want Info", entries[0].Level)
+	}
+}
