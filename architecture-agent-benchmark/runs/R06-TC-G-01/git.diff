+
+package v3rpc
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+	"go.uber.org/zap/zaptest/observer"
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+)
+
+type fakeIdentityGetter struct {
+	authInfo *auth.AuthInfo
+	err      error
+}
+
+func (f fakeIdentityGetter) AuthInfoFromCtx(context.Context) (*auth.AuthInfo, error) {
+	return f.authInfo, f.err
+}
+
+func newTestAuditInterceptor(ag auditIdentityGetter) (grpc.UnaryServerInterceptor, *observer.ObservedLogs) {
+	core, logs := observer.New(zap.InfoLevel)
+	lg := zap.New(core)
+	return auditUnaryInterceptor(ag, func() *zap.Logger { return lg }), logs
+}
+
+func TestAuditUnaryInterceptorRecordsKVRequests(t *testing.T) {
+	tests := []struct {
+		name          string
+		fullMethod    string
+		req           any
+		handlerErr    error
+		wantOperation string
+		wantSuccess   bool
+		wantKeys      []string
+	}{
+		{
+			name:          "range is a read",
+			fullMethod:    pb.KV_Range_FullMethodName,
+			req:           &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")},
+			wantOperation: auditOperationRead,
+			wantSuccess:   true,
+			wantKeys:      []string{"a..z"},
+		},
+		{
+			name:          "put is a write",
+			fullMethod:    pb.KV_Put_FullMethodName,
+			req:           &pb.PutRequest{Key: []byte("foo")},
+			wantOperation: auditOperationWrite,
+			wantSuccess:   true,
+			wantKeys:      []string{"foo"},
+		},
+		{
+			name:          "delete range is a delete",
+			fullMethod:    pb.KV_DeleteRange_FullMethodName,
+			req:           &pb.DeleteRangeRequest{Key: []byte("a"), RangeEnd: []byte("b")},
+			wantOperation: auditOperationDelete,
+			wantSuccess:   true,
+			wantKeys:      []string{"a..b"},
+		},
+		{
+			name:       "txn is a transaction and gathers nested keys",
+			fullMethod: pb.KV_Txn_FullMethodName,
+			req: &pb.TxnRequest{
+				Compare: []*pb.Compare{{Key: []byte("guard")}},
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("k1")}}},
+				},
+				Failure: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("k2")}}},
+				},
+			},
+			wantOperation: auditOperationTransaction,
+			wantSuccess:   true,
+			wantKeys:      []string{"guard", "k1", "k2"},
+		},
+		{
+			name:          "failed request is still audited",
+			fullMethod:    pb.KV_Put_FullMethodName,
+			req:           &pb.PutRequest{Key: []byte("foo")},
+			handlerErr:    errors.New("boom"),
+			wantOperation: auditOperationWrite,
+			wantSuccess:   false,
+			wantKeys:      []string{"foo"},
+		},
+		{
+			name:          "unlisted KV method is still audited",
+			fullMethod:    kvServiceMethodPrefix + "NewOp",
+			req:           &pb.PutRequest{Key: []byte("foo")},
+			wantOperation: "NewOp",
+			wantSuccess:   true,
+			wantKeys:      []string{"foo"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			interceptor, logs := newTestAuditInterceptor(fakeIdentityGetter{})
+			handler := func(ctx context.Context, req any) (any, error) {
+				return "resp", tt.handlerErr
+			}
+			resp, err := interceptor(context.Background(), tt.req, &grpc.UnaryServerInfo{FullMethod: tt.fullMethod}, handler)
+
+			assert.Equal(t, "resp", resp)
+			assert.Equal(t, tt.handlerErr, err)
+
+			require.Len(t, logs.All(), 1)
+			entry := logs.All()[0].ContextMap()
+			assert.Equal(t, tt.wantOperation, entry["operation"])
+			assert.Equal(t, tt.wantSuccess, entry["success"])
+			assert.Equal(t, auditUnauthenticatedUser, entry["user"])
+			assert.Contains(t, entry, "duration")
+			if tt.wantKeys != nil {
+				assert.ElementsMatch(t, tt.wantKeys, entry["keys"])
+			}
+		})
+	}
+}
+
+func TestAuditUnaryInterceptorSkipsNonKVAndCompact(t *testing.T) {
+	skipMethods := []string{
+		"/etcdserverpb.Lease/LeaseGrant",
+		"/etcdserverpb.Maintenance/Snapshot",
+		pb.KV_Compact_FullMethodName,
+	}
+
+	for _, method := range skipMethods {
+		t.Run(method, func(t *testing.T) {
+			interceptor, logs := newTestAuditInterceptor(fakeIdentityGetter{})
+			handler := func(ctx context.Context, req any) (any, error) { return "resp", nil }
+			_, err := interceptor(context.Background(), &pb.PutRequest{}, &grpc.UnaryServerInfo{FullMethod: method}, handler)
+			require.NoError(t, err)
+			assert.Empty(t, logs.All())
+		})
+	}
+}
+
+func TestAuditCallerIdentity(t *testing.T) {
+	tests := []struct {
+		name string
+		ag   auditIdentityGetter
+		want string
+	}{
+		{"auth disabled", fakeIdentityGetter{authInfo: nil, err: nil}, auditUnauthenticatedUser},
+		{"auth error", fakeIdentityGetter{authInfo: nil, err: errors.New("bad token")}, auditUnauthenticatedUser},
+		{"authenticated user", fakeIdentityGetter{authInfo: &auth.AuthInfo{Username: "alice"}}, "alice"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, auditCallerIdentity(context.Background(), tt.ag))
+		})
+	}
+}
+
+func TestAuditUnaryInterceptorDoesNotLogWithoutLogger(t *testing.T) {
+	interceptor := auditUnaryInterceptor(fakeIdentityGetter{}, func() *zap.Logger { return nil })
+	handler := func(ctx context.Context, req any) (any, error) { return "resp", nil }
+	resp, err := interceptor(context.Background(), &pb.PutRequest{Key: []byte("k")}, &grpc.UnaryServerInfo{FullMethod: pb.KV_Put_FullMethodName}, handler)
+	require.NoError(t, err)
+	assert.Equal(t, "resp", resp)
+}
