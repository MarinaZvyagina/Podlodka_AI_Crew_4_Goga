+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package v3rpc
+
+import (
+	"context"
+	"sort"
+	"strings"
+	"time"
+
+	"go.uber.org/zap"
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+	"go.etcd.io/etcd/server/v3/etcdserver"
+)
+
+const (
+	auditOperationRead        = "read"
+	auditOperationWrite       = "write"
+	auditOperationDelete      = "delete"
+	auditOperationTransaction = "transaction"
+
+	auditUnauthenticatedUser = "unauthenticated"
+
+	kvServiceMethodPrefix = "/etcdserverpb.KV/"
+)
+
+// kvAuditOperations maps the full gRPC method name of a KV service call to
+// the audited operation kind. A KV method that is not listed here (a future
+// addition to the service, for instance) is still audited: kvAuditOperation
+// falls back to deriving the operation name from the method itself, so
+// coverage never depends on updating this table by hand.
+var kvAuditOperations = map[string]string{
+	pb.KV_Range_FullMethodName:       auditOperationRead,
+	pb.KV_Put_FullMethodName:         auditOperationWrite,
+	pb.KV_DeleteRange_FullMethodName: auditOperationDelete,
+	pb.KV_Txn_FullMethodName:         auditOperationTransaction,
+}
+
+// kvAuditOperation reports whether fullMethod is a KV request that should be
+// audited and, if so, which operation kind to record for it. Compact is
+// excluded: it is neither a read, write, delete, nor transaction.
+func kvAuditOperation(fullMethod string) (operation string, audited bool) {
+	if op, ok := kvAuditOperations[fullMethod]; ok {
+		return op, true
+	}
+	if fullMethod == pb.KV_Compact_FullMethodName || !strings.HasPrefix(fullMethod, kvServiceMethodPrefix) {
+		return "", false
+	}
+	return strings.TrimPrefix(fullMethod, kvServiceMethodPrefix), true
+}
+
+// auditIdentityGetter is the subset of etcdserver.EtcdServer the audit
+// interceptor needs to resolve the caller identity for a request.
+type auditIdentityGetter interface {
+	AuthInfoFromCtx(ctx context.Context) (*auth.AuthInfo, error)
+}
+
+// newAuditUnaryInterceptor produces a compliance audit record for every
+// unary KV read, write, delete, and transaction request, regardless of which
+// gRPC handler ultimately serves it: caller identity, operation kind, key or
+// key range, duration, and outcome. It only observes the request and
+// response already produced by the handler chain, so it never changes what
+// is returned to the caller.
+func newAuditUnaryInterceptor(s *etcdserver.EtcdServer) grpc.UnaryServerInterceptor {
+	return auditUnaryInterceptor(s, s.Logger)
+}
+
+func auditUnaryInterceptor(ag auditIdentityGetter, loggerFunc func() *zap.Logger) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		operation, audited := kvAuditOperation(info.FullMethod)
+		if !audited {
+			return handler(ctx, req)
+		}
+
+		start := time.Now()
+		resp, err := handler(ctx, req)
+		duration := time.Since(start)
+
+		if lg := loggerFunc(); lg != nil {
+			logAuditRecord(ctx, lg, ag, operation, req, duration, err)
+		}
+		return resp, err
+	}
+}
+
+func logAuditRecord(ctx context.Context, lg *zap.Logger, ag auditIdentityGetter, operation string, req any, duration time.Duration, err error) {
+	fields := []zap.Field{
+		zap.String("operation", operation),
+		zap.String("user", auditCallerIdentity(ctx, ag)),
+		zap.Duration("duration", duration),
+		zap.Bool("success", err == nil),
+	}
+	if keys := auditKeys(req); len(keys) > 0 {
+		fields = append(fields, zap.Strings("keys", keys))
+	}
+	if err != nil {
+		fields = append(fields, zap.Error(err))
+	}
+	lg.Info("kv audit", fields...)
+}
+
+func auditCallerIdentity(ctx context.Context, ag auditIdentityGetter) string {
+	authInfo, err := ag.AuthInfoFromCtx(ctx)
+	if err != nil || authInfo == nil || authInfo.Username == "" {
+		return auditUnauthenticatedUser
+	}
+	return authInfo.Username
+}
+
+// keyRanger and keyer let auditKeys extract the key(s) touched by any
+// current or future KV request that carries a Key/RangeEnd pair (or just a
+// Key) via the getters protoc already generates for it, instead of matching
+// on concrete request types one by one.
+type keyRanger interface {
+	GetKey() []byte
+	GetRangeEnd() []byte
+}
+
+type keyer interface {
+	GetKey() []byte
+}
+
+func auditKeys(req any) []string {
+	if txnReq, ok := req.(*pb.TxnRequest); ok {
+		return auditTxnKeys(txnReq)
+	}
+	switch r := req.(type) {
+	case keyRanger:
+		return []string{auditKeyRangeString(r.GetKey(), r.GetRangeEnd())}
+	case keyer:
+		return []string{string(r.GetKey())}
+	}
+	return nil
+}
+
+func auditKeyRangeString(key, rangeEnd []byte) string {
+	if len(rangeEnd) == 0 {
+		return string(key)
+	}
+	return string(key) + ".." + string(rangeEnd)
+}
+
+// auditTxnKeys gathers every key referenced anywhere in the transaction
+// request: the compare guards plus both the success and failure branches,
+// recursing into nested transactions. It records the full set the request
+// could touch rather than only the branch that happened to execute.
+func auditTxnKeys(r *pb.TxnRequest) []string {
+	seen := make(map[string]struct{})
+	var keys []string
+	add := func(k string) {
+		if _, ok := seen[k]; !ok {
+			seen[k] = struct{}{}
+			keys = append(keys, k)
+		}
+	}
+
+	for _, c := range r.GetCompare() {
+		add(string(c.GetKey()))
+	}
+
+	var walk func(ops []*pb.RequestOp)
+	walk = func(ops []*pb.RequestOp) {
+		for _, op := range ops {
+			switch v := op.GetRequest().(type) {
+			case *pb.RequestOp_RequestRange:
+				add(auditKeyRangeString(v.RequestRange.GetKey(), v.RequestRange.GetRangeEnd()))
+			case *pb.RequestOp_RequestPut:
+				add(string(v.RequestPut.GetKey()))
+			case *pb.RequestOp_RequestDeleteRange:
+				add(auditKeyRangeString(v.RequestDeleteRange.GetKey(), v.RequestDeleteRange.GetRangeEnd()))
+			case *pb.RequestOp_RequestTxn:
+				walk(v.RequestTxn.GetSuccess())
+				walk(v.RequestTxn.GetFailure())
+			}
+		}
+	}
+	walk(r.GetSuccess())
+	walk(r.GetFailure())
+
+	sort.Strings(keys)
+	return keys
+}
