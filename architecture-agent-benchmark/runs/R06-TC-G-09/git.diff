+package v3rpc
+
+import (
+	"context"
+	"time"
+
+	"go.uber.org/zap"
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/etcdserver"
+)
+
+// newAuditUnaryInterceptor produces a compliance audit trail for every
+// key-value read, write, delete, and transaction request handled by the
+// server. It is a generic wrapper keyed off the request type rather than
+// something each KV RPC handler has to opt into individually, so newly added
+// KV request kinds only need a case added to auditOperationKind to be
+// covered uniformly.
+//
+// It observes the request/response/error that already flow through the
+// interceptor chain and never mutates them, so it cannot change the
+// functional behavior or response content of the wrapped operation.
+func newAuditUnaryInterceptor(s *etcdserver.EtcdServer) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		kind, ok := auditOperationKind(req)
+		if !ok {
+			return handler(ctx, req)
+		}
+
+		start := time.Now()
+		resp, err := handler(ctx, req)
+		duration := time.Since(start)
+
+		if lg := s.Logger(); lg != nil {
+			logAuditRecord(lg, s, ctx, kind, req, resp, duration, err)
+		}
+
+		return resp, err
+	}
+}
+
+// auditOperationKind reports the compliance-facing operation kind for a
+// request, and whether the request is a key-value operation that must be
+// audited at all.
+func auditOperationKind(req any) (string, bool) {
+	switch req.(type) {
+	case *pb.RangeRequest:
+		return "read", true
+	case *pb.PutRequest:
+		return "write", true
+	case *pb.DeleteRangeRequest:
+		return "delete", true
+	case *pb.TxnRequest:
+		return "transaction", true
+	default:
+		return "", false
+	}
+}
+
+func logAuditRecord(lg *zap.Logger, s *etcdserver.EtcdServer, ctx context.Context, kind string, req, resp any, duration time.Duration, err error) {
+	outcome := "success"
+	if err != nil {
+		outcome = "failure"
+	}
+
+	fields := make([]zap.Field, 0, 8)
+	fields = append(fields,
+		zap.String("caller", auditCallerIdentity(s, ctx)),
+		zap.String("operation", kind),
+	)
+	fields = append(fields, auditKeyFields(req, resp)...)
+	fields = append(fields,
+		zap.Duration("duration", duration),
+		zap.String("outcome", outcome),
+	)
+	if err != nil {
+		fields = append(fields, zap.Error(err))
+	}
+
+	lg.Info("kv audit", fields...)
+}
+
+// auditCallerIdentity returns the authenticated username for the request, or
+// "unauthenticated" when auth is disabled or no identity could be
+// established for the request.
+func auditCallerIdentity(s *etcdserver.EtcdServer, ctx context.Context) string {
+	authInfo, err := s.AuthInfoFromCtx(ctx)
+	if err != nil || authInfo == nil || authInfo.Username == "" {
+		return "unauthenticated"
+	}
+	return authInfo.Username
+}
+
+func auditKeyFields(req, resp any) []zap.Field {
+	switch r := req.(type) {
+	case *pb.RangeRequest:
+		return []zap.Field{zap.ByteString("key", r.GetKey()), zap.ByteString("range-end", r.GetRangeEnd())}
+	case *pb.PutRequest:
+		return []zap.Field{zap.ByteString("key", r.GetKey())}
+	case *pb.DeleteRangeRequest:
+		return []zap.Field{zap.ByteString("key", r.GetKey()), zap.ByteString("range-end", r.GetRangeEnd())}
+	case *pb.TxnRequest:
+		txnResp, _ := resp.(*pb.TxnResponse)
+		return []zap.Field{zap.Strings("keys", auditTxnKeys(r, txnResp))}
+	default:
+		return nil
+	}
+}
+
+// auditTxnKeys collects the keys and key ranges a transaction touched: its
+// compares, plus the requests of whichever branch actually executed. If the
+// branch that executed is unknown (e.g. the transaction failed before
+// producing a response), both branches are reported so no touched key is
+// silently dropped from the audit trail.
+func auditTxnKeys(txn *pb.TxnRequest, resp *pb.TxnResponse) []string {
+	var keys []string
+	seen := make(map[string]struct{})
+	add := func(key, rangeEnd []byte) {
+		s := auditKeyRangeString(key, rangeEnd)
+		if _, ok := seen[s]; ok {
+			return
+		}
+		seen[s] = struct{}{}
+		keys = append(keys, s)
+	}
+
+	for _, c := range txn.GetCompare() {
+		add(c.GetKey(), c.GetRangeEnd())
+	}
+
+	switch {
+	case resp == nil:
+		auditCollectRequestOpKeys(txn.GetSuccess(), add)
+		auditCollectRequestOpKeys(txn.GetFailure(), add)
+	case resp.GetSucceeded():
+		auditCollectRequestOpKeys(txn.GetSuccess(), add)
+	default:
+		auditCollectRequestOpKeys(txn.GetFailure(), add)
+	}
+
+	return keys
+}
+
+func auditCollectRequestOpKeys(ops []*pb.RequestOp, add func(key, rangeEnd []byte)) {
+	for _, op := range ops {
+		switch {
+		case op.GetRequestRange() != nil:
+			rr := op.GetRequestRange()
+			add(rr.GetKey(), rr.GetRangeEnd())
+		case op.GetRequestPut() != nil:
+			add(op.GetRequestPut().GetKey(), nil)
+		case op.GetRequestDeleteRange() != nil:
+			dr := op.GetRequestDeleteRange()
+			add(dr.GetKey(), dr.GetRangeEnd())
+		case op.GetRequestTxn() != nil:
+			nested := op.GetRequestTxn()
+			for _, c := range nested.GetCompare() {
+				add(c.GetKey(), c.GetRangeEnd())
+			}
+			auditCollectRequestOpKeys(nested.GetSuccess(), add)
+			auditCollectRequestOpKeys(nested.GetFailure(), add)
+		}
+	}
+}
+
+func auditKeyRangeString(key, rangeEnd []byte) string {
+	if len(rangeEnd) == 0 {
+		return string(key)
+	}
+	return string(key) + ".." + string(rangeEnd)
+}
