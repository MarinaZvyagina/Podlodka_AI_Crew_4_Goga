+
+package v3rpc
+
+import (
+	"reflect"
+	"testing"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestAuditOperationKind(t *testing.T) {
+	tests := []struct {
+		name     string
+		req      any
+		wantKind string
+		wantOK   bool
+	}{
+		{"range", &pb.RangeRequest{}, "read", true},
+		{"put", &pb.PutRequest{}, "write", true},
+		{"delete range", &pb.DeleteRangeRequest{}, "delete", true},
+		{"txn", &pb.TxnRequest{}, "transaction", true},
+		{"unrelated", &pb.LeaseGrantRequest{}, "", false},
+		{"nil", nil, "", false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			kind, ok := auditOperationKind(tt.req)
+			if kind != tt.wantKind || ok != tt.wantOK {
+				t.Errorf("auditOperationKind(%v) = (%q, %v), want (%q, %v)", tt.req, kind, ok, tt.wantKind, tt.wantOK)
+			}
+		})
+	}
+}
+
+func TestAuditKeyFields(t *testing.T) {
+	rangeReq := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}
+	fields := auditKeyFields(rangeReq, &pb.RangeResponse{})
+	if len(fields) != 2 {
+		t.Fatalf("expected 2 fields for range request, got %d", len(fields))
+	}
+
+	putReq := &pb.PutRequest{Key: []byte("foo")}
+	fields = auditKeyFields(putReq, &pb.PutResponse{})
+	if len(fields) != 1 {
+		t.Fatalf("expected 1 field for put request, got %d", len(fields))
+	}
+
+	if fields := auditKeyFields(&pb.LeaseGrantRequest{}, nil); fields != nil {
+		t.Errorf("expected nil fields for a non-KV request, got %v", fields)
+	}
+}
+
+func TestAuditTxnKeys(t *testing.T) {
+	txn := &pb.TxnRequest{
+		Compare: []*pb.Compare{{Key: []byte("cmp")}},
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("succeed-key")}}},
+		},
+		Failure: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("fail-key"), RangeEnd: []byte("fail-end")}}},
+		},
+	}
+
+	t.Run("succeeded branch only", func(t *testing.T) {
+		got := auditTxnKeys(txn, &pb.TxnResponse{Succeeded: true})
+		want := []string{"cmp", "succeed-key"}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("got %v, want %v", got, want)
+		}
+	})
+
+	t.Run("failed branch only", func(t *testing.T) {
+		got := auditTxnKeys(txn, &pb.TxnResponse{Succeeded: false})
+		want := []string{"cmp", "fail-key..fail-end"}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("got %v, want %v", got, want)
+		}
+	})
+
+	t.Run("unknown branch reports both", func(t *testing.T) {
+		got := auditTxnKeys(txn, nil)
+		want := []string{"cmp", "succeed-key", "fail-key..fail-end"}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("got %v, want %v", got, want)
+		}
+	})
+
+	t.Run("nested txn is expanded", func(t *testing.T) {
+		nested := &pb.TxnRequest{
+			Success: []*pb.RequestOp{
+				{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+					Success: []*pb.RequestOp{
+						{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("nested-key")}}},
+					},
+				}}},
+			},
+		}
+		got := auditTxnKeys(nested, &pb.TxnResponse{Succeeded: true})
+		want := []string{"nested-key"}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("got %v, want %v", got, want)
+		}
+	})
+}
+
+func TestAuditKeyRangeString(t *testing.T) {
+	if got := auditKeyRangeString([]byte("foo"), nil); got != "foo" {
+		t.Errorf("got %q, want %q", got, "foo")
+	}
+	if got := auditKeyRangeString([]byte("foo"), []byte("fop")); got != "foo..fop" {
+		t.Errorf("got %q, want %q", got, "foo..fop")
+	}
+}
