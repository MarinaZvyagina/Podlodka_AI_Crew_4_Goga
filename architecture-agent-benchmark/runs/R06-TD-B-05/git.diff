+// TestKVGetRepeatedNotStale exercises the server-side read cache: repeated,
+// identical Get requests for the same key must never observe a value older
+// than what an equivalent uncached read would have returned at the time it
+// was issued, even though the requests are served back-to-back with a write
+// racing in between. This is checked for both linearizable (default) and
+// serializable reads.
+func TestKVGetRepeatedNotStale(t *testing.T) {
+	integration.BeforeTest(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 3})
+	defer clus.Terminate(t)
+
+	kv := clus.RandClient()
+	ctx := t.Context()
+
+	for _, serializable := range []bool{false, true} {
+		var opts []clientv3.OpOption
+		if serializable {
+			opts = append(opts, clientv3.WithSerializable())
+		}
+
+		if _, err := kv.Put(ctx, "k", "v1"); err != nil {
+			t.Fatalf("put v1: %v", err)
+		}
+
+		// Warm up the cache with a burst of identical reads.
+		var last *clientv3.GetResponse
+		for i := 0; i < 5; i++ {
+			resp, err := kv.Get(ctx, "k", opts...)
+			if err != nil {
+				t.Fatalf("get #%d: %v", i, err)
+			}
+			if len(resp.Kvs) != 1 || string(resp.Kvs[0].Value) != "v1" {
+				t.Fatalf("get #%d: expected v1, got %+v", i, resp.Kvs)
+			}
+			last = resp
+		}
+
+		if _, err := kv.Put(ctx, "k", "v2"); err != nil {
+			t.Fatalf("put v2: %v", err)
+		}
+
+		// The very next read, whether or not it would have hit the cache,
+		// must observe v2 -- never the pre-write cached response.
+		resp, err := kv.Get(ctx, "k", opts...)
+		if err != nil {
+			t.Fatalf("get after write: %v", err)
+		}
+		if len(resp.Kvs) != 1 || string(resp.Kvs[0].Value) != "v2" {
+			t.Fatalf("serializable=%v: expected v2 after write, got %+v", serializable, resp.Kvs)
+		}
+		if resp.Header.Revision <= last.Header.Revision {
+			t.Fatalf("serializable=%v: expected revision to advance past %d, got %d", serializable, last.Header.Revision, resp.Header.Revision)
+		}
+	}
+}
