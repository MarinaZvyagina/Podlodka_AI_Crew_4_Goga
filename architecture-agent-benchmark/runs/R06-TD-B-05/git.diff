+package etcdserver
+
+import (
+	"context"
+	"encoding/binary"
+	"strings"
+	"sync"
+
+	"go.uber.org/zap"
+	"k8s.io/utils/lru"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/etcdserver/txn"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+// defaultRangeCacheSize bounds the number of distinct Range requests the
+// read cache remembers at once, so that clients issuing many different
+// queries can't grow it without bound.
+const defaultRangeCacheSize = 2048
+
+// rangeCache memoizes RangeResponses for repeated, identical RangeRequests
+// so that a burst of clients asking for the same key or range doesn't have
+// to redo the underlying mvcc scan for every request.
+//
+// A cached response is only ever handed back if the store's current
+// revision still equals the revision the response was computed at. Since
+// etcd bumps that revision exactly once for every applied Put, DeleteRange,
+// or Txn, this makes cache validity exact rather than time-based: any write
+// anywhere invalidates every previously cached response before the very
+// next request can observe stale data, with no reliance on an expiration
+// timer. It also makes the cache safe for both linearizable requests (the
+// check runs after LinearizableReadNotify has already caught the local
+// store up to the read's start) and serializable ones (the check runs
+// against whatever revision the local store is currently at, exactly what
+// an uncached serializable read would use).
+type rangeCache struct {
+	mu    sync.Mutex
+	cache *lru.Cache
+}
+
+func newRangeCache(size int) *rangeCache {
+	return &rangeCache{cache: lru.New(size)}
+}
+
+// rangeWithCache serves r from the cache when possible, falling back to a
+// normal txn.Range on a miss and, if the result is still current, saving it
+// for next time. A cache miss behaves exactly as an uncached Range always
+// has.
+func (c *rangeCache) rangeWithCache(ctx context.Context, lg *zap.Logger, kv mvcc.KV, r *pb.RangeRequest) (*pb.RangeResponse, error) {
+	if c == nil {
+		resp, _, err := txn.Range(ctx, lg, kv, r, true)
+		return resp, err
+	}
+
+	key, cacheable := rangeCacheKey(r)
+	if cacheable {
+		if resp, ok := c.get(key, kv.Rev()); ok {
+			return resp, nil
+		}
+	}
+
+	resp, _, err := txn.Range(ctx, lg, kv, r, true)
+	if err != nil {
+		return nil, err
+	}
+
+	if cacheable {
+		c.put(key, resp, kv.Rev())
+	}
+	return resp, nil
+}
+
+// get returns a copy of the cached response for key, if one exists and
+// still reflects currentRev.
+func (c *rangeCache) get(key string, currentRev int64) (*pb.RangeResponse, bool) {
+	c.mu.Lock()
+	v, ok := c.cache.Get(key)
+	c.mu.Unlock()
+	if !ok {
+		return nil, false
+	}
+
+	resp := v.(*pb.RangeResponse)
+	if resp.Header.Revision != currentRev {
+		// Something has been written since resp was computed; it may no
+		// longer reflect the current state of the affected range.
+		return nil, false
+	}
+	return cloneRangeResponse(resp), true
+}
+
+// put saves resp under key, unless a write has already landed since resp
+// was computed. Skipping the save in that case only costs a cache miss on
+// the next lookup; saving it anyway would risk hiding an already-visible
+// write behind a cache entry that nothing will ever refresh.
+func (c *rangeCache) put(key string, resp *pb.RangeResponse, currentRev int64) {
+	if resp.Header.Revision != currentRev {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.cache.Add(key, cloneRangeResponse(resp))
+}
+
+// cloneRangeResponse returns a copy of resp that shares the (never mutated
+// after assembly) Kvs slice but has its own Header, so that callers are
+// free to mutate the returned Header (as the gRPC layer does, to stamp
+// cluster/member/raft-term metadata) without corrupting the cache or racing
+// with a concurrent reader of the same cached entry.
+func cloneRangeResponse(resp *pb.RangeResponse) *pb.RangeResponse {
+	return &pb.RangeResponse{
+		Header: &pb.ResponseHeader{Revision: resp.Header.Revision},
+		Kvs:    resp.Kvs,
+		More:   resp.More,
+		Count:  resp.Count,
+	}
+}
+
+// rangeCacheKey returns a lookup key that uniquely identifies every
+// RangeRequest field that affects the response content, and reports
+// whether r is eligible for caching at all.
+//
+// Serializable is deliberately excluded: it only controls how the response
+// is obtained (see rangeCache's doc comment), not its content, so
+// linearizable and serializable requests for the same range can share a
+// cache entry.
+//
+// Pinned-revision reads (Revision != 0) are excluded from caching: their
+// result is immutable until compaction removes that revision, which this
+// cache does not track, so they always go through the normal read path.
+func rangeCacheKey(r *pb.RangeRequest) (string, bool) {
+	if r.Revision != 0 {
+		return "", false
+	}
+
+	var b strings.Builder
+	writeLenPrefixed(&b, r.Key)
+	writeLenPrefixed(&b, r.RangeEnd)
+	writeInt(&b, r.Limit)
+	writeInt(&b, int64(r.SortOrder))
+	writeInt(&b, int64(r.SortTarget))
+	writeInt(&b, r.MinModRevision)
+	writeInt(&b, r.MaxModRevision)
+	writeInt(&b, r.MinCreateRevision)
+	writeInt(&b, r.MaxCreateRevision)
+	writeBool(&b, r.KeysOnly)
+	writeBool(&b, r.CountOnly)
+	return b.String(), true
+}
+
+func writeLenPrefixed(b *strings.Builder, v []byte) {
+	var lenBuf [8]byte
+	binary.BigEndian.PutUint64(lenBuf[:], uint64(len(v)))
+	b.Write(lenBuf[:])
+	b.Write(v)
+}
+
+func writeInt(b *strings.Builder, v int64) {
+	var buf [8]byte
+	binary.BigEndian.PutUint64(buf[:], uint64(v))
+	b.Write(buf[:])
+}
+
+func writeBool(b *strings.Builder, v bool) {
+	if v {
+		b.WriteByte(1)
+	} else {
+		b.WriteByte(0)
+	}
+}
