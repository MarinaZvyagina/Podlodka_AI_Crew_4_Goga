+package etcdserver
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+)
+
+func TestRangeCacheHitAndMiss(t *testing.T) {
+	c := newRangeCache(defaultRangeCacheSize)
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	key, cacheable := rangeCacheKey(req)
+	require.True(t, cacheable)
+
+	// Nothing cached yet.
+	_, ok := c.get(key, 5)
+	assert.False(t, ok)
+
+	resp := &pb.RangeResponse{
+		Header: &pb.ResponseHeader{Revision: 5},
+		Kvs:    []*mvccpb.KeyValue{{Key: []byte("foo"), Value: []byte("bar")}},
+	}
+	c.put(key, resp, 5)
+
+	// Same revision: hit.
+	got, ok := c.get(key, 5)
+	require.True(t, ok)
+	assert.Equal(t, resp.Kvs, got.Kvs)
+	assert.Equal(t, int64(5), got.Header.Revision)
+
+	// A write bumped the revision: must not serve the stale entry.
+	_, ok = c.get(key, 6)
+	assert.False(t, ok)
+}
+
+func TestRangeCachePutSkipsStaleResponse(t *testing.T) {
+	c := newRangeCache(defaultRangeCacheSize)
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	key, _ := rangeCacheKey(req)
+
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}}
+	// A write already landed (currentRev=6) by the time we try to cache a
+	// response computed at revision 5: don't cache it, since nothing would
+	// ever invalidate it again.
+	c.put(key, resp, 6)
+
+	_, ok := c.get(key, 5)
+	assert.False(t, ok)
+	_, ok = c.get(key, 6)
+	assert.False(t, ok)
+}
+
+func TestRangeCacheReturnsIndependentHeader(t *testing.T) {
+	c := newRangeCache(defaultRangeCacheSize)
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	key, _ := rangeCacheKey(req)
+
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}}
+	c.put(key, resp, 5)
+
+	got1, ok := c.get(key, 5)
+	require.True(t, ok)
+	got1.Header.ClusterId = 42
+
+	got2, ok := c.get(key, 5)
+	require.True(t, ok)
+	assert.Equal(t, uint64(0), got2.Header.ClusterId, "mutating one caller's header must not affect another's")
+}
+
+func TestRangeCacheKeyDistinguishesRequestShape(t *testing.T) {
+	base := &pb.RangeRequest{Key: []byte("foo"), RangeEnd: []byte("fop")}
+	variants := []*pb.RangeRequest{
+		{Key: []byte("foo"), RangeEnd: []byte("fop")},
+		{Key: []byte("foo"), RangeEnd: []byte("fop"), Limit: 1},
+		{Key: []byte("foo"), RangeEnd: []byte("fop"), KeysOnly: true},
+		{Key: []byte("foo"), RangeEnd: []byte("fop"), CountOnly: true},
+		{Key: []byte("foo"), RangeEnd: []byte("fop"), SortOrder: pb.RangeRequest_DESCEND},
+		{Key: []byte("foo"), RangeEnd: []byte("fop"), MinModRevision: 3},
+	}
+
+	baseKey, ok := rangeCacheKey(base)
+	require.True(t, ok)
+	seen := map[string]bool{baseKey: true}
+	for _, v := range variants[1:] {
+		k, ok := rangeCacheKey(v)
+		require.True(t, ok)
+		assert.False(t, seen[k], "expected a distinct cache key for %+v", v)
+		seen[k] = true
+	}
+
+	// Serializable must not affect the key: it doesn't change the content.
+	lin := &pb.RangeRequest{Key: []byte("foo"), RangeEnd: []byte("fop"), Serializable: false}
+	ser := &pb.RangeRequest{Key: []byte("foo"), RangeEnd: []byte("fop"), Serializable: true}
+	linKey, _ := rangeCacheKey(lin)
+	serKey, _ := rangeCacheKey(ser)
+	assert.Equal(t, linKey, serKey)
+
+	// Pinned-revision reads are not cacheable.
+	_, ok = rangeCacheKey(&pb.RangeRequest{Key: []byte("foo"), Revision: 7})
+	assert.False(t, ok)
+}
