+package mvcc
+
+import (
+	"context"
+	"sync"
+
+	"google.golang.org/protobuf/proto"
+	"k8s.io/utils/lru"
+
+	"go.etcd.io/etcd/api/v3/mvccpb"
+	"go.etcd.io/etcd/pkg/v3/adt"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/storage/backend"
+)
+
+// DefaultRangeCacheSize is the default number of distinct Range results a
+// CachingKV keeps around.
+const DefaultRangeCacheSize = 2048
+
+// NewCachingKV wraps kv so that Range requests made at the current
+// (unpinned) revision can be served from an in-memory cache instead of
+// re-walking the in-memory index and the backend on every call. Every write
+// invalidates exactly the cached ranges it touches as part of the same
+// transaction that applies it, so a cache hit never returns data older than
+// an equivalent uncached read would have returned at the same point in
+// time - unlike a time-based cache, there is no window in which a
+// concurrent write can go unnoticed.
+//
+// Reads pinned to a historical revision (RangeOptions.Rev > 0) are never
+// cached: they already refer to immutable data, so caching would only need
+// to track compaction separately from the invalidation used for live
+// writes, for no benefit. Reads made through a write transaction (TxnWrite)
+// are never cached either, since those must observe the transaction's own
+// buffered, not-yet-committed changes.
+func NewCachingKV(kv WatchableKV, maxCacheEntries int) WatchableKV {
+	return &cachingKV{
+		WatchableKV: kv,
+		cache:       newRangeCache(maxCacheEntries),
+	}
+}
+
+type cachingKV struct {
+	WatchableKV
+	cache *rangeCache
+}
+
+func (c *cachingKV) Read(mode ReadTxMode, trace *traceutil.Trace) TxnRead {
+	return &cachingTxnRead{TxnRead: c.WatchableKV.Read(mode, trace), cache: c.cache}
+}
+
+func (c *cachingKV) Write(trace *traceutil.Trace) TxnWrite {
+	return &cachingTxnWrite{TxnWrite: c.WatchableKV.Write(trace), cache: c.cache}
+}
+
+func (c *cachingKV) Restore(b backend.Backend) error {
+	err := c.WatchableKV.Restore(b)
+	// A restore (e.g. installing a snapshot) can replace the entire key
+	// space out from under us, so nothing cached beforehand can be trusted
+	// afterwards.
+	c.cache.clear()
+	return err
+}
+
+// cachingTxnRead serves Range calls for the current revision from the
+// shared cache, falling back to (and populating) it on a miss.
+type cachingTxnRead struct {
+	TxnRead
+	cache *rangeCache
+}
+
+func (t *cachingTxnRead) Range(ctx context.Context, key, end []byte, ro RangeOptions) (*RangeResult, error) {
+	if ro.Rev > 0 {
+		return t.TxnRead.Range(ctx, key, end, ro)
+	}
+
+	k := makeRangeCacheKey(key, end, ro)
+	if rr, ok := t.cache.get(k); ok {
+		// The cached KVs are only guaranteed unchanged since they were
+		// cached; the header revision must still reflect the store's
+		// current revision, exactly like an uncached call would report,
+		// even if unrelated keys were written in the meantime.
+		rr.Rev = t.TxnRead.Rev()
+		return rr, nil
+	}
+
+	rr, err := t.TxnRead.Range(ctx, key, end, ro)
+	if err != nil {
+		return rr, err
+	}
+	t.cache.add(k, rr)
+	return rr, nil
+}
+
+// cachingTxnWrite invalidates every cached range touched by the write once
+// it commits, i.e. once the store's current revision has advanced to
+// reflect it.
+type cachingTxnWrite struct {
+	TxnWrite
+	cache *rangeCache
+}
+
+func (t *cachingTxnWrite) End() {
+	t.TxnWrite.End()
+	for _, kv := range t.TxnWrite.Changes() {
+		t.cache.invalidate(kv.Key)
+	}
+}
+
+// rangeCacheKey identifies a cacheable Range call: a lookup at the current
+// revision, distinguished by every option that can change its result.
+type rangeCacheKey struct {
+	key            string
+	end            string
+	endIsNil       bool
+	limit          int64
+	countOnly      bool
+	fastKeysOnly   bool
+	withTotalCount bool
+}
+
+func makeRangeCacheKey(key, end []byte, ro RangeOptions) rangeCacheKey {
+	return rangeCacheKey{
+		key:            string(key),
+		end:            string(end),
+		endIsNil:       end == nil,
+		limit:          ro.Limit,
+		countOnly:      ro.CountOnly,
+		fastKeysOnly:   ro.FastKeysOnly,
+		withTotalCount: ro.WithTotalCount,
+	}
+}
+
+// interval returns the key range this cache entry covers, using the same
+// nil/empty conventions as ReadView.Range: a nil end covers just the single
+// key, an empty (non-nil) end covers everything from key onward.
+func (k rangeCacheKey) interval() adt.Interval {
+	if k.endIsNil {
+		return adt.NewBytesAffinePoint([]byte(k.key))
+	}
+	return adt.NewBytesAffineInterval([]byte(k.key), []byte(k.end))
+}
+
+// rangeCache caches Range results at the current revision and lets a write
+// to a single key evict precisely the cached ranges that cover it.
+type rangeCache struct {
+	mu         sync.Mutex
+	maxEntries int
+	lru        *lru.Cache
+
+	// ranges is a reverse index from a cached key range to the set of
+	// rangeCacheKeys sharing that exact range, so that Invalidate can find
+	// every cached entry covering a single changed key.
+	ranges adt.IntervalTree
+}
+
+func newRangeCache(maxEntries int) *rangeCache {
+	if maxEntries <= 0 {
+		maxEntries = DefaultRangeCacheSize
+	}
+	return &rangeCache{
+		maxEntries: maxEntries,
+		lru:        lru.New(maxEntries),
+		ranges:     adt.NewIntervalTree(),
+	}
+}
+
+func (c *rangeCache) get(k rangeCacheKey) (*RangeResult, bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	v, ok := c.lru.Get(k)
+	if !ok {
+		return nil, false
+	}
+	return cloneRangeResult(v.(*RangeResult)), true
+}
+
+func (c *rangeCache) add(k rangeCacheKey, rr *RangeResult) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.lru.Add(k, cloneRangeResult(rr))
+
+	ivl := k.interval()
+	if iv := c.ranges.Find(ivl); iv != nil {
+		iv.Val.(map[rangeCacheKey]struct{})[k] = struct{}{}
+	} else {
+		c.ranges.Insert(ivl, map[rangeCacheKey]struct{}{k: {}})
+	}
+}
+
+// invalidate evicts every cached range that covers key.
+func (c *rangeCache) invalidate(key []byte) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	ivs := c.ranges.Stab(adt.NewBytesAffinePoint(key))
+	for _, iv := range ivs {
+		for k := range iv.Val.(map[rangeCacheKey]struct{}) {
+			c.lru.Remove(k)
+		}
+	}
+	// Delete after removing all keys, since deleting is destructive to ivs.
+	for _, iv := range ivs {
+		c.ranges.Delete(iv.Ivl)
+	}
+}
+
+func (c *rangeCache) clear() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.lru = lru.New(c.maxEntries)
+	c.ranges = adt.NewIntervalTree()
+}
+
+// cloneRangeResult deep-copies rr so that neither the cache nor whoever
+// receives the clone can observe the other's later mutations - callers such
+// as txn.Range mutate the KeyValues they get back in place (e.g. stripping
+// Value for a keys-only request).
+func cloneRangeResult(rr *RangeResult) *RangeResult {
+	kvs := make([]*mvccpb.KeyValue, len(rr.KVs))
+	for i, kv := range rr.KVs {
+		kvs[i] = proto.Clone(kv).(*mvccpb.KeyValue)
+	}
+	return &RangeResult{KVs: kvs, Rev: rr.Rev, Count: rr.Count}
+}
