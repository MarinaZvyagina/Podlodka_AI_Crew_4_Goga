+
+package mvcc
+
+import (
+	"context"
+	"testing"
+
+	"go.uber.org/zap/zaptest"
+
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+)
+
+// countingKV counts every Range call that actually reaches the wrapped
+// store, i.e. every cache miss when placed under a cachingKV.
+type countingKV struct {
+	WatchableKV
+	rangeCalls int
+}
+
+func (c *countingKV) Read(mode ReadTxMode, trace *traceutil.Trace) TxnRead {
+	return &countingTxnRead{TxnRead: c.WatchableKV.Read(mode, trace), c: c}
+}
+
+type countingTxnRead struct {
+	TxnRead
+	c *countingKV
+}
+
+func (t *countingTxnRead) Range(ctx context.Context, key, end []byte, ro RangeOptions) (*RangeResult, error) {
+	t.c.rangeCalls++
+	return t.TxnRead.Range(ctx, key, end, ro)
+}
+
+func newTestCachingKV(t *testing.T) (kv WatchableKV, counting *countingKV) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { betesting.Close(t, b) })
+	base := New(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{})
+	counting = &countingKV{WatchableKV: base}
+	return NewCachingKV(counting, DefaultRangeCacheSize), counting
+}
+
+func put(t *testing.T, kv WatchableKV, key, value string) int64 {
+	t.Helper()
+	tw := kv.Write(traceutil.TODO())
+	rev := tw.Put([]byte(key), []byte(value), lease.NoLease)
+	tw.End()
+	return rev
+}
+
+func del(t *testing.T, kv WatchableKV, key string) {
+	t.Helper()
+	tw := kv.Write(traceutil.TODO())
+	tw.DeleteRange([]byte(key), nil)
+	tw.End()
+}
+
+func rangeAt(t *testing.T, kv WatchableKV, key, end []byte, ro RangeOptions) *RangeResult {
+	t.Helper()
+	tr := kv.Read(ConcurrentReadTxMode, traceutil.TODO())
+	defer tr.End()
+	rr, err := tr.Range(context.Background(), key, end, ro)
+	if err != nil {
+		t.Fatalf("Range(%q, %q) failed: %v", key, end, err)
+	}
+	return rr
+}
+
+func TestCachingKVServesRepeatedReadFromCache(t *testing.T) {
+	kv, counting := newTestCachingKV(t)
+	put(t, kv, "foo", "bar")
+
+	rr1 := rangeAt(t, kv, []byte("foo"), nil, RangeOptions{})
+	rr2 := rangeAt(t, kv, []byte("foo"), nil, RangeOptions{})
+
+	if counting.rangeCalls != 1 {
+		t.Fatalf("expected the underlying store to be read once, got %d reads", counting.rangeCalls)
+	}
+	if len(rr1.KVs) != 1 || len(rr2.KVs) != 1 || string(rr1.KVs[0].Value) != "bar" || string(rr2.KVs[0].Value) != "bar" {
+		t.Fatalf("unexpected range results: %+v, %+v", rr1, rr2)
+	}
+}
+
+func TestCachingKVInvalidatesOnWriteToCachedKey(t *testing.T) {
+	kv, counting := newTestCachingKV(t)
+	put(t, kv, "foo", "bar")
+	rangeAt(t, kv, []byte("foo"), nil, RangeOptions{})
+	if counting.rangeCalls != 1 {
+		t.Fatalf("expected 1 read after priming cache, got %d", counting.rangeCalls)
+	}
+
+	put(t, kv, "foo", "baz")
+
+	rr := rangeAt(t, kv, []byte("foo"), nil, RangeOptions{})
+	if counting.rangeCalls != 2 {
+		t.Fatalf("expected the write to invalidate the cache entry, forcing a re-read; got %d reads", counting.rangeCalls)
+	}
+	if string(rr.KVs[0].Value) != "baz" {
+		t.Fatalf("expected fresh value %q, got %q", "baz", rr.KVs[0].Value)
+	}
+}
+
+func TestCachingKVInvalidatesOnDeleteOfCachedKey(t *testing.T) {
+	kv, counting := newTestCachingKV(t)
+	put(t, kv, "foo", "bar")
+	rangeAt(t, kv, []byte("foo"), nil, RangeOptions{})
+
+	del(t, kv, "foo")
+
+	rr := rangeAt(t, kv, []byte("foo"), nil, RangeOptions{})
+	if counting.rangeCalls != 2 {
+		t.Fatalf("expected the delete to invalidate the cache entry; got %d reads", counting.rangeCalls)
+	}
+	if len(rr.KVs) != 0 {
+		t.Fatalf("expected key to be gone, got %+v", rr.KVs)
+	}
+}
+
+func TestCachingKVInvalidatesOnWriteWithinCachedRange(t *testing.T) {
+	kv, counting := newTestCachingKV(t)
+	put(t, kv, "a", "1")
+	put(t, kv, "b", "2")
+
+	rangeAt(t, kv, []byte("a"), []byte("z"), RangeOptions{})
+	if counting.rangeCalls != 1 {
+		t.Fatalf("expected 1 read after priming cache, got %d", counting.rangeCalls)
+	}
+
+	// "aa" falls inside the cached range [a, z) even though it was never
+	// individually read before.
+	put(t, kv, "aa", "3")
+
+	rr := rangeAt(t, kv, []byte("a"), []byte("z"), RangeOptions{})
+	if counting.rangeCalls != 2 {
+		t.Fatalf("expected write inside cached range to force a re-read; got %d reads", counting.rangeCalls)
+	}
+	if len(rr.KVs) != 3 {
+		t.Fatalf("expected 3 keys after the write, got %d", len(rr.KVs))
+	}
+}
+
+func TestCachingKVDoesNotInvalidateUnrelatedRange(t *testing.T) {
+	kv, counting := newTestCachingKV(t)
+	put(t, kv, "foo", "bar")
+	put(t, kv, "other", "1")
+
+	rangeAt(t, kv, []byte("foo"), nil, RangeOptions{})
+	if counting.rangeCalls != 1 {
+		t.Fatalf("expected 1 read after priming cache, got %d", counting.rangeCalls)
+	}
+
+	put(t, kv, "other", "2")
+
+	rangeAt(t, kv, []byte("foo"), nil, RangeOptions{})
+	if counting.rangeCalls != 1 {
+		t.Fatalf("write to an unrelated key must not evict an unrelated cached range; got %d reads", counting.rangeCalls)
+	}
+}
+
+func TestCachingKVDoesNotCachePinnedRevisionReads(t *testing.T) {
+	kv, counting := newTestCachingKV(t)
+	rev := put(t, kv, "foo", "bar")
+
+	rangeAt(t, kv, []byte("foo"), nil, RangeOptions{Rev: rev})
+	rangeAt(t, kv, []byte("foo"), nil, RangeOptions{Rev: rev})
+
+	if counting.rangeCalls != 2 {
+		t.Fatalf("pinned-revision reads must always hit the underlying store; got %d reads for 2 requests", counting.rangeCalls)
+	}
+}
+
+func TestCachingKVReportsCurrentRevisionOnCacheHit(t *testing.T) {
+	kv, counting := newTestCachingKV(t)
+	put(t, kv, "foo", "bar")
+
+	rr1 := rangeAt(t, kv, []byte("foo"), nil, RangeOptions{})
+
+	// A write to an unrelated key advances the store's current revision
+	// without touching the cached entry for "foo".
+	rev2 := put(t, kv, "other", "1")
+
+	rr2 := rangeAt(t, kv, []byte("foo"), nil, RangeOptions{})
+	if counting.rangeCalls != 1 {
+		t.Fatalf("expected the second read to be a cache hit; got %d reads", counting.rangeCalls)
+	}
+	if rr2.Rev != rev2 {
+		t.Fatalf("cache hit must report the store's current revision (%d), got %d", rev2, rr2.Rev)
+	}
+	if rr1.Rev == rr2.Rev {
+		t.Fatalf("expected the store revision to have advanced between reads")
+	}
+}
+
+func TestCachingKVGetIsImmuneToCallerMutation(t *testing.T) {
+	kv, _ := newTestCachingKV(t)
+	put(t, kv, "foo", "bar")
+
+	rr1 := rangeAt(t, kv, []byte("foo"), nil, RangeOptions{})
+	// Simulate what txn.asembleRangeResponse does for a KeysOnly request:
+	// mutate the returned KeyValue in place.
+	rr1.KVs[0].Value = nil
+
+	rr2 := rangeAt(t, kv, []byte("foo"), nil, RangeOptions{})
+	if string(rr2.KVs[0].Value) != "bar" {
+		t.Fatalf("mutating one caller's result must not affect the cached copy; got value %q", rr2.KVs[0].Value)
+	}
+}
+
+func TestCachingKVOpenEndedRangeInvalidation(t *testing.T) {
+	kv, counting := newTestCachingKV(t)
+	put(t, kv, "a", "1")
+
+	// end == []byte{} (non-nil, empty) means "from key to the end of the
+	// key space", matching ReadView.Range's documented convention.
+	rangeAt(t, kv, []byte("a"), []byte{}, RangeOptions{})
+	if counting.rangeCalls != 1 {
+		t.Fatalf("expected 1 read after priming cache, got %d", counting.rangeCalls)
+	}
+
+	put(t, kv, "zzz", "2")
+
+	rr := rangeAt(t, kv, []byte("a"), []byte{}, RangeOptions{})
+	if counting.rangeCalls != 2 {
+		t.Fatalf("write past the cached prefix must still invalidate an open-ended range; got %d reads", counting.rangeCalls)
+	}
+	if len(rr.KVs) != 2 {
+		t.Fatalf("expected 2 keys, got %d", len(rr.KVs))
+	}
+}
+
+func TestCachingKVRestoreClearsCache(t *testing.T) {
+	kv, counting := newTestCachingKV(t)
+	put(t, kv, "foo", "bar")
+	rangeAt(t, kv, []byte("foo"), nil, RangeOptions{})
+	if counting.rangeCalls != 1 {
+		t.Fatalf("expected 1 read after priming cache, got %d", counting.rangeCalls)
+	}
+
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { betesting.Close(t, b) })
+	if err := kv.Restore(b); err != nil {
+		t.Fatalf("Restore failed: %v", err)
+	}
+
+	rangeAt(t, kv, []byte("foo"), nil, RangeOptions{})
+	if counting.rangeCalls != 2 {
+		t.Fatalf("Restore must invalidate the whole cache; got %d reads", counting.rangeCalls)
+	}
+}
