+package cache
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestCacheAddThenGet(t *testing.T) {
+	c := NewCache(DefaultMaxEntries)
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}}
+
+	c.Add(req, resp)
+
+	got, err := c.Get(req)
+	require.NoError(t, err)
+	require.Equal(t, resp, got)
+}
+
+func TestCacheInvalidateRemovesOverlappingEntry(t *testing.T) {
+	c := NewCache(DefaultMaxEntries)
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}}
+	c.Add(req, resp)
+
+	c.Invalidate([]byte("foo"), nil, 6)
+
+	_, err := c.Get(req)
+	require.Error(t, err)
+}
+
+func TestCacheInvalidateIgnoresNonOverlappingEntry(t *testing.T) {
+	c := NewCache(DefaultMaxEntries)
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}}
+	c.Add(req, resp)
+
+	c.Invalidate([]byte("bar"), nil, 6)
+
+	got, err := c.Get(req)
+	require.NoError(t, err)
+	require.Equal(t, resp, got)
+}
+
+// TestCacheAddRejectsResponseRacingWithInvalidate reproduces the scenario
+// where a Range that read a pre-write snapshot loses the race against the
+// write that superseded it: the write's Invalidate call runs first (because
+// the write already completed), and only then does the stale Range attempt
+// to Add its outdated response. Since nothing will invalidate this key
+// again, the stale entry would otherwise sit in the cache forever - worse
+// than not caching it at all. Add must recognize the response is already
+// older than a known completed write and refuse to cache it.
+func TestCacheAddRejectsResponseRacingWithInvalidate(t *testing.T) {
+	c := NewCache(DefaultMaxEntries)
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	staleResp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}}
+
+	// The write that raced ahead of the stale read has already completed
+	// and invalidated at revision 6.
+	c.Invalidate([]byte("foo"), nil, 6)
+
+	// The stale read, which observed the store before the write, now tries
+	// to populate the cache with its outdated (revision 5) response.
+	c.Add(req, staleResp)
+
+	_, err := c.Get(req)
+	require.Error(t, err, "a response older than an already-observed write must not be cached")
+}
+
+// TestCacheAddAllowsFreshResponseAfterInvalidate ensures the race guard
+// doesn't over-invalidate: a response that is at least as new as the last
+// observed write must still be cacheable.
+func TestCacheAddAllowsFreshResponseAfterInvalidate(t *testing.T) {
+	c := NewCache(DefaultMaxEntries)
+
+	c.Invalidate([]byte("foo"), nil, 6)
+
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	freshResp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 7}}
+	c.Add(req, freshResp)
+
+	got, err := c.Get(req)
+	require.NoError(t, err)
+	require.Equal(t, freshResp, got)
+}
+
+// TestCacheAddPinnedRevisionIgnoresRaceGuard ensures reads pinned to an
+// explicit historical revision - which are never invalidated by writes -
+// are exempt from the race guard used for live reads.
+func TestCacheAddPinnedRevisionIgnoresRaceGuard(t *testing.T) {
+	c := NewCache(DefaultMaxEntries)
+
+	c.Invalidate([]byte("foo"), nil, 100)
+
+	req := &pb.RangeRequest{Key: []byte("foo"), Revision: 5}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 50}}
+	c.Add(req, resp)
+
+	got, err := c.Get(req)
+	require.NoError(t, err)
+	require.Equal(t, resp, got)
+}
