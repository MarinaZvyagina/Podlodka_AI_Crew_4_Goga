+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+)
+
+// TestWatchableStoreSubscribeChangesFiresBeforeCommit verifies the ordering
+// guarantee that a mvcc.ChangeNotifier subscriber (such as EtcdServer's read
+// cache) relies on for correctness: the callback must run strictly before
+// the triggering write becomes visible to readers, so a subscriber can use
+// it to evict cached data with no window in which a reader could observe
+// both "old cache entry" and "new committed data".
+func TestWatchableStoreSubscribeChangesFiresBeforeCommit(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	s := newWatchableStore(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{})
+	defer cleanup(s, b)
+
+	revBefore := s.Rev()
+
+	var gotEvents []*mvccpb.Event
+	var revDuringCallback int64
+	calls := 0
+	unsub := s.SubscribeChanges(func(evs []*mvccpb.Event) {
+		calls++
+		gotEvents = evs
+		revDuringCallback = s.Rev()
+	})
+	defer unsub()
+
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	require.Equal(t, 1, calls)
+	require.Len(t, gotEvents, 1)
+	assert.Equal(t, mvccpb.PUT, gotEvents[0].Type)
+	assert.Equal(t, []byte("foo"), gotEvents[0].Kv.Key)
+	assert.Equal(t, revBefore, revDuringCallback,
+		"callback must observe the pre-write revision, i.e. run before the write commits")
+	assert.Greater(t, s.Rev(), revDuringCallback,
+		"the write must be committed (and visible) only after the callback returns")
+}
+
+func TestWatchableStoreSubscribeChangesDelete(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	s := newWatchableStore(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{})
+	defer cleanup(s, b)
+
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	var gotEvents []*mvccpb.Event
+	unsub := s.SubscribeChanges(func(evs []*mvccpb.Event) {
+		gotEvents = evs
+	})
+	defer unsub()
+
+	n, _ := s.DeleteRange([]byte("foo"), nil)
+	require.Equal(t, int64(1), n)
+	require.Len(t, gotEvents, 1)
+	assert.Equal(t, mvccpb.DELETE, gotEvents[0].Type)
+	assert.Equal(t, []byte("foo"), gotEvents[0].Kv.Key)
+}
+
+func TestWatchableStoreSubscribeChangesUnsubscribe(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	s := newWatchableStore(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{})
+	defer cleanup(s, b)
+
+	calls := 0
+	unsub := s.SubscribeChanges(func(evs []*mvccpb.Event) { calls++ })
+
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+	assert.Equal(t, 1, calls)
+
+	unsub()
+
+	s.Put([]byte("foo"), []byte("baz"), lease.NoLease)
+	assert.Equal(t, 1, calls, "no more callbacks should fire after unsubscribe")
+}
+
+// TestWatchableStoreSubscribeChangesNoOpWriteNoCallback verifies a write txn
+// that ends up with no changes (e.g. deleting a range with no matching keys)
+// does not spuriously invoke subscribers.
+func TestWatchableStoreSubscribeChangesNoOpWriteNoCallback(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	s := newWatchableStore(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{})
+	defer cleanup(s, b)
+
+	calls := 0
+	unsub := s.SubscribeChanges(func(evs []*mvccpb.Event) { calls++ })
+	defer unsub()
+
+	n, _ := s.DeleteRange([]byte("nonexistent"), nil)
+	require.Equal(t, int64(0), n)
+	assert.Equal(t, 0, calls)
+}
