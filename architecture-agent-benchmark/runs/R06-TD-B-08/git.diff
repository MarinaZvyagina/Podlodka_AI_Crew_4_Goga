+// limitations under the License.
+
+package etcdserver
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+)
+
+func TestRangeCacheHitAfterStore(t *testing.T) {
+	c := newRangeCache()
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	resp := &pb.RangeResponse{
+		Header: &pb.ResponseHeader{Revision: 5},
+		Kvs:    []*mvccpb.KeyValue{{Key: []byte("foo"), Value: []byte("bar")}},
+	}
+
+	_, ok := c.lookup(req)
+	require.False(t, ok, "expect miss before store")
+
+	c.store(req, resp)
+
+	got, ok := c.lookup(req)
+	require.True(t, ok, "expect hit after store")
+	assert.Equal(t, resp.Kvs, got.Kvs)
+	assert.Equal(t, resp.Header.Revision, got.Header.Revision)
+
+	// The returned response must be an independent copy: mutating it must
+	// not corrupt the cached entry or a concurrently-returned copy.
+	got.Header.Revision = 999
+	got2, ok := c.lookup(req)
+	require.True(t, ok)
+	assert.Equal(t, int64(5), got2.Header.Revision)
+}
+
+func TestRangeCacheDistinguishesRequestParameters(t *testing.T) {
+	c := newRangeCache()
+	base := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}
+	c.store(base, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	variants := []*pb.RangeRequest{
+		{Key: []byte("a"), RangeEnd: []byte("z"), Limit: 1},
+		{Key: []byte("a"), RangeEnd: []byte("z"), Revision: 3},
+		{Key: []byte("a"), RangeEnd: []byte("z"), KeysOnly: true},
+		{Key: []byte("a"), RangeEnd: []byte("z"), CountOnly: true},
+		{Key: []byte("a"), RangeEnd: []byte("z"), SortOrder: pb.RangeRequest_DESCEND},
+		{Key: []byte("a"), RangeEnd: []byte("z"), SortTarget: pb.RangeRequest_VALUE},
+		{Key: []byte("a"), RangeEnd: []byte("z"), MinModRevision: 2},
+		{Key: []byte("ab"), RangeEnd: []byte("z")}, // different key, same total bytes as combining a+z differently
+		{Key: []byte("a"), RangeEnd: []byte("zz")},
+	}
+	for i, v := range variants {
+		t.Run(fmt.Sprintf("variant-%d", i), func(t *testing.T) {
+			_, ok := c.lookup(v)
+			assert.False(t, ok, "distinct parameters must not collide with the cached entry")
+		})
+	}
+
+	// Serializable must NOT be part of the key: a cached serializable read
+	// can satisfy a linearizable request for the same parameters and vice
+	// versa, since invalidation upholds linearizable freshness regardless.
+	serializable := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z"), Serializable: true}
+	_, ok := c.lookup(serializable)
+	assert.True(t, ok, "Serializable must not affect the cache key")
+}
+
+func TestRangeCacheInvalidateOnOverlappingWrite(t *testing.T) {
+	c := newRangeCache()
+	req := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}
+	c.store(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	c.invalidate([]*mvccpb.Event{{Kv: &mvccpb.KeyValue{Key: []byte("m")}}})
+
+	_, ok := c.lookup(req)
+	assert.False(t, ok, "a write inside the cached range must invalidate it")
+}
+
+func TestRangeCacheInvalidateIgnoresNonOverlappingWrite(t *testing.T) {
+	c := newRangeCache()
+	req := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("m")}
+	c.store(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	c.invalidate([]*mvccpb.Event{{Kv: &mvccpb.KeyValue{Key: []byte("z")}}})
+
+	_, ok := c.lookup(req)
+	assert.True(t, ok, "a write outside the cached range must not invalidate it")
+}
+
+func TestRangeCacheInvalidateSingleKeyRequest(t *testing.T) {
+	c := newRangeCache()
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	c.store(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	// A write to a different key must not evict a single-key cache entry.
+	c.invalidate([]*mvccpb.Event{{Kv: &mvccpb.KeyValue{Key: []byte("bar")}}})
+	_, ok := c.lookup(req)
+	assert.True(t, ok)
+
+	c.invalidate([]*mvccpb.Event{{Kv: &mvccpb.KeyValue{Key: []byte("foo")}}})
+	_, ok = c.lookup(req)
+	assert.False(t, ok)
+}
+
+func TestRangeCacheInvalidateOpenEndedRequest(t *testing.T) {
+	c := newRangeCache()
+	// RangeEnd of a single 0x00 byte means "key and beyond" (mkGteRange).
+	req := &pb.RangeRequest{Key: []byte("m"), RangeEnd: []byte{0}}
+	c.store(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	c.invalidate([]*mvccpb.Event{{Kv: &mvccpb.KeyValue{Key: []byte("zzz")}}})
+	_, ok := c.lookup(req)
+	assert.False(t, ok, "an open-ended range must be invalidated by any key at or after the start")
+
+	c.store(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+	c.invalidate([]*mvccpb.Event{{Kv: &mvccpb.KeyValue{Key: []byte("a")}}})
+	_, ok = c.lookup(req)
+	assert.True(t, ok, "a key before the start of an open-ended range must not invalidate it")
+}
+
+func TestRangeCachePinnedRevisionNotInvalidatedByWrites(t *testing.T) {
+	c := newRangeCache()
+	req := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z"), Revision: 3}
+	c.store(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 3}})
+
+	c.invalidate([]*mvccpb.Event{{Kv: &mvccpb.KeyValue{Key: []byte("m")}}})
+
+	_, ok := c.lookup(req)
+	assert.True(t, ok, "a historical, pinned-revision read is immutable and must survive writes")
+}
+
+func TestRangeCachePurgeCompacted(t *testing.T) {
+	c := newRangeCache()
+	req := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z"), Revision: 3}
+	c.store(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 3}})
+
+	c.purgeCompacted(2)
+	_, ok := c.lookup(req)
+	assert.True(t, ok, "compaction below the pinned revision must not purge it")
+
+	c.purgeCompacted(3)
+	_, ok = c.lookup(req)
+	assert.False(t, ok, "compaction at or above the pinned revision must purge it")
+}
+
+func TestRangeCacheReset(t *testing.T) {
+	c := newRangeCache()
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	c.store(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	c.reset()
+
+	_, ok := c.lookup(req)
+	assert.False(t, ok)
+}
+
+func TestRangeCacheEvictsLeastRecentlyUsed(t *testing.T) {
+	c := newRangeCache()
+	for i := 0; i < rangeCacheMaxEntries; i++ {
+		req := &pb.RangeRequest{Key: []byte(fmt.Sprintf("key-%d", i))}
+		c.store(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+	}
+
+	// Touch the first entry so it becomes most-recently-used and survives.
+	first := &pb.RangeRequest{Key: []byte("key-0")}
+	_, ok := c.lookup(first)
+	require.True(t, ok)
+
+	// Inserting one more entry should evict the least recently used one,
+	// which is now key-1 (key-0 was just refreshed).
+	overflow := &pb.RangeRequest{Key: []byte("overflow")}
+	c.store(overflow, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	_, ok = c.lookup(first)
+	assert.True(t, ok, "recently used entry must survive eviction")
+
+	evicted := &pb.RangeRequest{Key: []byte("key-1")}
+	_, ok = c.lookup(evicted)
+	assert.False(t, ok, "least recently used entry must be evicted once over capacity")
+}
+
+func TestRangeCacheSkipsOversizedResponse(t *testing.T) {
+	c := newRangeCache()
+	req := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}
+	kvs := make([]*mvccpb.KeyValue, rangeCacheMaxKVs+1)
+	for i := range kvs {
+		kvs[i] = &mvccpb.KeyValue{Key: []byte(fmt.Sprintf("%d", i))}
+	}
+	c.store(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}, Kvs: kvs})
+
+	_, ok := c.lookup(req)
+	assert.False(t, ok, "responses over the size cap must not be cached")
+}
+
+func TestRangeCacheNilReceiverIsSafe(t *testing.T) {
+	var c *rangeCache
+	req := &pb.RangeRequest{Key: []byte("foo")}
+
+	_, ok := c.lookup(req)
+	assert.False(t, ok)
+
+	assert.NotPanics(t, func() {
+		c.store(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+		c.invalidate([]*mvccpb.Event{{Kv: &mvccpb.KeyValue{Key: []byte("foo")}}})
+		c.reset()
+		c.purgeCompacted(1)
+	})
+}
+
+// TestRangeCacheConcurrentAccess exercises lookup/store/invalidate from many
+// goroutines at once, mirroring many replicas reading the same hot keys
+// while writes race in. Run with -race to catch synchronization bugs.
+func TestRangeCacheConcurrentAccess(t *testing.T) {
+	c := newRangeCache()
+	keys := make([][]byte, 8)
+	for i := range keys {
+		keys[i] = []byte(fmt.Sprintf("key-%d", i))
+	}
+
+	const iterations = 2000
+	var wg sync.WaitGroup
+
+	for _, k := range keys {
+		k := k
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			req := &pb.RangeRequest{Key: k}
+			for i := 0; i < iterations; i++ {
+				if _, ok := c.lookup(req); !ok {
+					c.store(req, &pb.RangeResponse{
+						Header: &pb.ResponseHeader{Revision: 1},
+						Kvs:    []*mvccpb.KeyValue{{Key: k, Value: []byte("v")}},
+					})
+				}
+			}
+		}()
+	}
+
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < iterations; i++ {
+			for _, k := range keys {
+				c.invalidate([]*mvccpb.Event{{Kv: &mvccpb.KeyValue{Key: k}}})
+			}
+		}
+	}()
+
+	wg.Wait()
+}
+
+func TestRangeContainsKey(t *testing.T) {
+	cases := []struct {
+		name     string
+		key, end []byte
+		k        []byte
+		want     bool
+	}{
+		{"exact match", []byte("foo"), nil, []byte("foo"), true},
+		{"exact mismatch", []byte("foo"), nil, []byte("bar"), false},
+		{"open ended in range", []byte("m"), []byte{0}, []byte("z"), true},
+		{"open ended before start", []byte("m"), []byte{0}, []byte("a"), false},
+		{"open ended at start", []byte("m"), []byte{0}, []byte("m"), true},
+		{"bounded inside", []byte("a"), []byte("z"), []byte("m"), true},
+		{"bounded at start (inclusive)", []byte("a"), []byte("z"), []byte("a"), true},
+		{"bounded at end (exclusive)", []byte("a"), []byte("z"), []byte("z"), false},
+		{"bounded before start", []byte("a"), []byte("z"), []byte("0"), false},
+		{"bounded after end", []byte("a"), []byte("z"), []byte("zz"), false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.want, rangeContainsKey(tc.key, tc.end, tc.k))
+		})
+	}
+}
