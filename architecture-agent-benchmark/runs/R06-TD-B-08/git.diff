+
+// ChangeNotifier is implemented by KV implementations that can synchronously
+// notify subscribers about committed key changes.
+type ChangeNotifier interface {
+	// SubscribeChanges registers cb to be invoked once per committed write
+	// transaction that changes at least one key, with the events for that
+	// transaction. cb runs synchronously, on the goroutine committing the
+	// write, strictly before the change becomes visible to readers -- so a
+	// subscriber can use it to evict cached reads without any window in
+	// which the cache could still serve stale data for the changed keys.
+	// Because of that, cb must be fast and must not call back into the KV.
+	// The returned function removes the subscription.
+	SubscribeChanges(cb func(evs []*mvccpb.Event)) (unsubscribe func())
+}
