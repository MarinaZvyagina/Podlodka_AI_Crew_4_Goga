+// SubscribeChanges implements ChangeNotifier.
+func (s *watchableStore) SubscribeChanges(cb func(evs []*mvccpb.Event)) func() {
+	s.mu.Lock()
+	id := s.nextChangeSubID
+	s.nextChangeSubID++
+	s.changeSubs[id] = cb
+	s.mu.Unlock()
+
+	return func() {
+		s.mu.Lock()
+		delete(s.changeSubs, id)
+		s.mu.Unlock()
+	}
+}
+
+// notifyChangeSubs synchronously invokes all subscribers registered via
+// SubscribeChanges. Callers must hold s.mu and must call this before the
+// write that produced evs becomes visible to readers.
+func (s *watchableStore) notifyChangeSubs(evs []*mvccpb.Event) {
+	for _, cb := range s.changeSubs {
+		cb(evs)
+	}
+}
