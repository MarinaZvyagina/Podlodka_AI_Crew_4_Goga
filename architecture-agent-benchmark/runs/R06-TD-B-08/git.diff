+
+// TestV3RangeCacheNeverServesStaleData exercises the server-side read cache
+// end-to-end through a real client/server round trip: repeated identical
+// reads must be served correctly, and a write that touches a previously
+// cached range must be visible on the very next read -- for both
+// linearizable (default) and serializable reads -- with no reliance on a
+// cache expiring naturally.
+func TestV3RangeCacheNeverServesStaleData(t *testing.T) {
+	integration.BeforeTest(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	client := clus.RandClient()
+
+	_, err := client.Put(t.Context(), "foo", "v1")
+	require.NoError(t, err)
+
+	// Issue the exact same read repeatedly, priming and re-hitting any cache.
+	for range 3 {
+		resp, err := client.Get(t.Context(), "foo")
+		require.NoError(t, err)
+		require.Len(t, resp.Kvs, 1)
+		require.Equal(t, "v1", string(resp.Kvs[0].Value))
+	}
+	for range 3 {
+		resp, err := client.Get(t.Context(), "foo", clientv3.WithSerializable())
+		require.NoError(t, err)
+		require.Len(t, resp.Kvs, 1)
+		require.Equal(t, "v1", string(resp.Kvs[0].Value))
+	}
+
+	// Overwrite the key. Any cache entry for it must not survive this.
+	_, err = client.Put(t.Context(), "foo", "v2")
+	require.NoError(t, err)
+
+	linResp, err := client.Get(t.Context(), "foo")
+	require.NoError(t, err)
+	require.Len(t, linResp.Kvs, 1)
+	require.Equal(t, "v2", string(linResp.Kvs[0].Value), "linearizable read must observe the write immediately")
+
+	serResp, err := client.Get(t.Context(), "foo", clientv3.WithSerializable())
+	require.NoError(t, err)
+	require.Len(t, serResp.Kvs, 1)
+	require.Equal(t, "v2", string(serResp.Kvs[0].Value), "serializable read must observe the write immediately")
+
+	// Delete the key; a cached "exists" result must not linger.
+	_, err = client.Delete(t.Context(), "foo")
+	require.NoError(t, err)
+
+	delResp, err := client.Get(t.Context(), "foo")
+	require.NoError(t, err)
+	require.Empty(t, delResp.Kvs, "deleted key must not be served from a stale cache entry")
+}
+
+// TestV3RangeCacheInvalidatesOnOverlappingWrite verifies that a ranged read
+// covering several keys is invalidated as soon as any write lands inside
+// that range, even when the write targets a key that wasn't previously in
+// the store (so the earlier cached read couldn't have observed it).
+func TestV3RangeCacheInvalidatesOnOverlappingWrite(t *testing.T) {
+	integration.BeforeTest(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	client := clus.RandClient()
+
+	_, err := client.Put(t.Context(), "range/a", "1")
+	require.NoError(t, err)
+	_, err = client.Put(t.Context(), "range/c", "1")
+	require.NoError(t, err)
+
+	getRange := func() *clientv3.GetResponse {
+		resp, err := client.Get(t.Context(), "range/", clientv3.WithPrefix())
+		require.NoError(t, err)
+		return resp
+	}
+
+	for range 3 {
+		resp := getRange()
+		require.Len(t, resp.Kvs, 2)
+	}
+
+	// Add a new key inside the previously cached prefix range.
+	_, err = client.Put(t.Context(), "range/b", "1")
+	require.NoError(t, err)
+
+	resp := getRange()
+	require.Len(t, resp.Kvs, 3, "a write inside a cached range must be visible on the next read")
+
+	// A write outside the range must not affect the cached/re-cached result.
+	_, err = client.Put(t.Context(), "outside", "1")
+	require.NoError(t, err)
+
+	resp = getRange()
+	require.Len(t, resp.Kvs, 3)
+}
