index 000000000..2b5fd47a9
--- /dev/null
+++ b/server/etcdserver/range_cache.go
@@ -0,0 +1,277 @@
+// Copyright 2025 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package etcdserver
+
+import (
+	"bytes"
+	"container/list"
+	"encoding/binary"
+	"strings"
+	"sync"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+)
+
+const (
+	// rangeCacheMaxEntries bounds the number of distinct Range requests kept
+	// cached at once. Once exceeded, the least recently used entry is
+	// evicted. This keeps the cache useful for its intended purpose --
+	// bursts of identical repeated reads for a small set of keys -- without
+	// letting memory grow unbounded for workloads with high read cardinality.
+	rangeCacheMaxEntries = 4096
+
+	// rangeCacheMaxKVs bounds the size of a single cached response so that
+	// large range scans (unlikely to be repeated verbatim) don't dominate
+	// the cache's memory budget.
+	rangeCacheMaxKVs = 1000
+)
+
+// rangeCacheItem is one cached Range response, along with the request
+// parameters needed to test whether a later write invalidates it.
+type rangeCacheItem struct {
+	cacheKey string
+	key      []byte
+	rangeEnd []byte
+	pinned   bool // true if the request pinned a historical revision; immutable, never invalidated by writes
+	resp     *pb.RangeResponse
+}
+
+// rangeCache caches the results of Range requests keyed by their
+// result-affecting parameters (key, range_end, limit, revision, sort order,
+// key/count-only flags, and revision filters -- see rangeRequestCacheKey).
+//
+// Entries for "live" requests (Revision == 0) are invalidated synchronously
+// by invalidate, which is wired up as a mvcc.ChangeNotifier subscriber: it
+// runs on the same goroutine that commits a write, before that write becomes
+// visible to any reader (see watchable_store_txn.go). That ordering means a
+// cache hit can never return data older than what an equivalent uncached
+// read, issued at the same point in time, would have returned -- there is no
+// window in which a write has committed but the cache hasn't yet been told
+// about it.
+//
+// Entries for requests pinned to a historical revision are immutable (the
+// data at a past revision never changes) and are never evicted by writes.
+type rangeCache struct {
+	mu    sync.Mutex
+	ll    *list.List // front = most recently used
+	items map[string]*list.Element
+}
+
+func newRangeCache() *rangeCache {
+	return &rangeCache{
+		ll:    list.New(),
+		items: make(map[string]*list.Element),
+	}
+}
+
+// lookup returns a private copy of the cached response for r, if present.
+// The caller is free to mutate the returned response (e.g. to refresh its
+// header) without affecting the cache or other concurrent callers.
+func (c *rangeCache) lookup(r *pb.RangeRequest) (*pb.RangeResponse, bool) {
+	if c == nil {
+		return nil, false
+	}
+	key := rangeRequestCacheKey(r)
+
+	c.mu.Lock()
+	el, ok := c.items[key]
+	if !ok {
+		c.mu.Unlock()
+		return nil, false
+	}
+	c.ll.MoveToFront(el)
+	resp := el.Value.(*rangeCacheItem).resp
+	c.mu.Unlock()
+
+	return cloneRangeResponse(resp), true
+}
+
+// store caches resp as the result for r. resp must not be mutated by the
+// caller afterwards; store keeps its own private copy either way.
+func (c *rangeCache) store(r *pb.RangeRequest, resp *pb.RangeResponse) {
+	if c == nil || len(resp.Kvs) > rangeCacheMaxKVs {
+		return
+	}
+
+	item := &rangeCacheItem{
+		cacheKey: rangeRequestCacheKey(r),
+		key:      r.Key,
+		rangeEnd: r.RangeEnd,
+		pinned:   r.Revision != 0,
+		resp:     cloneRangeResponse(resp),
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if el, ok := c.items[item.cacheKey]; ok {
+		el.Value = item
+		c.ll.MoveToFront(el)
+	} else {
+		c.items[item.cacheKey] = c.ll.PushFront(item)
+	}
+
+	for c.ll.Len() > rangeCacheMaxEntries {
+		oldest := c.ll.Back()
+		if oldest == nil {
+			break
+		}
+		c.ll.Remove(oldest)
+		delete(c.items, oldest.Value.(*rangeCacheItem).cacheKey)
+	}
+}
+
+// invalidate evicts every live (non-pinned) cache entry whose watched key
+// range contains any of the changed keys in evs. It is registered as a
+// mvcc.ChangeNotifier subscriber and must be fast, since it runs
+// synchronously on the write-commit path while the store's internal lock is
+// held.
+func (c *rangeCache) invalidate(evs []*mvccpb.Event) {
+	if c == nil || len(evs) == 0 {
+		return
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	for cacheKey, el := range c.items {
+		it := el.Value.(*rangeCacheItem)
+		if it.pinned {
+			continue
+		}
+		for _, ev := range evs {
+			if rangeContainsKey(it.key, it.rangeEnd, ev.Kv.Key) {
+				c.ll.Remove(el)
+				delete(c.items, cacheKey)
+				break
+			}
+		}
+	}
+}
+
+// reset clears the entire cache. Used when the underlying store is replaced
+// wholesale (e.g. restoring from a snapshot), where per-write invalidation
+// events aren't produced.
+func (c *rangeCache) reset() {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.ll.Init()
+	c.items = make(map[string]*list.Element)
+}
+
+// purgeCompacted drops cached entries pinned to a revision that has now been
+// compacted away; a fresh read for them would return ErrCompacted instead of
+// the previously-cached result.
+func (c *rangeCache) purgeCompacted(compactRev int64) {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	for cacheKey, el := range c.items {
+		it := el.Value.(*rangeCacheItem)
+		if it.pinned && it.resp.Header.Revision <= compactRev {
+			c.ll.Remove(el)
+			delete(c.items, cacheKey)
+		}
+	}
+}
+
+// rangeContainsKey reports whether k falls within the [key, rangeEnd) range
+// as encoded on a pb.RangeRequest: rangeEnd == nil means an exact-key match,
+// a single 0x00 byte means "key and beyond", and anything else is a normal
+// half-open interval. This mirrors the semantics used by the read path (see
+// server/etcdserver/txn.mkGteRange).
+func rangeContainsKey(key, rangeEnd, k []byte) bool {
+	if bytes.Compare(k, key) < 0 {
+		return false
+	}
+	switch {
+	case len(rangeEnd) == 0:
+		return bytes.Equal(k, key)
+	case len(rangeEnd) == 1 && rangeEnd[0] == 0:
+		return true
+	default:
+		return bytes.Compare(k, rangeEnd) < 0
+	}
+}
+
+// cloneRangeResponse returns a shallow copy of resp that is safe to mutate
+// independently: it gets its own top-level struct and its own Header, but
+// shares the Kvs slice, whose elements are never mutated once constructed.
+// Built field-by-field (rather than via struct assignment) since pb.RangeResponse
+// embeds protobuf internal state that must not be copied by value.
+func cloneRangeResponse(resp *pb.RangeResponse) *pb.RangeResponse {
+	clone := &pb.RangeResponse{
+		Kvs:   resp.Kvs,
+		More:  resp.More,
+		Count: resp.Count,
+	}
+	if resp.Header != nil {
+		clone.Header = &pb.ResponseHeader{
+			ClusterId: resp.Header.ClusterId,
+			MemberId:  resp.Header.MemberId,
+			Revision:  resp.Header.Revision,
+			RaftTerm:  resp.Header.RaftTerm,
+		}
+	}
+	return clone
+}
+
+// rangeRequestCacheKey builds an unambiguous cache key from the parameters
+// of r that affect its result. Serializable is intentionally excluded: it
+// only affects the staleness guarantee of a live read, not the data
+// returned, and the cache's invalidation scheme (see rangeCache doc comment)
+// upholds the linearizable guarantee for every entry it serves regardless of
+// which consistency mode originally populated it.
+func rangeRequestCacheKey(r *pb.RangeRequest) string {
+	var b strings.Builder
+	var scratch [8]byte
+
+	putUint64 := func(v uint64) {
+		binary.BigEndian.PutUint64(scratch[:], v)
+		b.Write(scratch[:])
+	}
+	putBytes := func(p []byte) {
+		putUint64(uint64(len(p)))
+		b.Write(p)
+	}
+
+	putBytes(r.Key)
+	putBytes(r.RangeEnd)
+	putUint64(uint64(r.Limit))
+	putUint64(uint64(r.Revision))
+	putUint64(uint64(r.MinModRevision))
+	putUint64(uint64(r.MaxModRevision))
+	putUint64(uint64(r.MinCreateRevision))
+	putUint64(uint64(r.MaxCreateRevision))
+	b.WriteByte(byte(r.SortOrder))
+	b.WriteByte(byte(r.SortTarget))
+	var flags byte
+	if r.KeysOnly {
+		flags |= 1
+	}
+	if r.CountOnly {
+		flags |= 2
+	}
+	b.WriteByte(flags)
+
+	return b.String()
+}
