+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package mvcc
+
+import (
+	"context"
+	"sync"
+
+	"go.etcd.io/etcd/api/v3/mvccpb"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/lease"
+	"go.etcd.io/etcd/server/v3/storage/backend"
+)
+
+// DefaultReadCacheSize bounds the number of distinct Range results kept by
+// the cache returned from NewReadCache when no size is given.
+const DefaultReadCacheSize = 10000
+
+// NewReadCache wraps kv with a read-through cache for Range results.
+//
+// Repeated Range requests that use identical parameters (key, range end,
+// limit, pinned revision and the other RangeOptions) are served from the
+// cache instead of walking the in-memory index and the backend again, as
+// long as no write that could affect the result has been applied since it
+// was cached.
+//
+// Every Put, DeleteRange and Txn that goes through the returned KV evicts,
+// as part of committing, every cached "latest data" entry whose key range
+// contains a modified key. That eviction happens while the cache and the
+// underlying store are both exclusively locked together with the commit
+// itself, so no caller can observe a cached value that is older than what
+// an uncached read would have returned at the same point in time, including
+// linearizable reads (which only consult the cache after the server has
+// already waited for the local revision to catch up via ReadIndex).
+//
+// maxEntries bounds the number of distinct Range results retained; if
+// maxEntries <= 0, DefaultReadCacheSize is used.
+func NewReadCache(kv WatchableKV, maxEntries int) WatchableKV {
+	if maxEntries <= 0 {
+		maxEntries = DefaultReadCacheSize
+	}
+	return &cachingKV{
+		WatchableKV: kv,
+		cache:       newRangeCache(maxEntries, kv.Rev()),
+	}
+}
+
+// cachingKV decorates a WatchableKV with a read cache. Methods that aren't
+// overridden below (NewWatchStream, HashStorage, Commit, Close, ...) fall
+// through to the embedded WatchableKV unchanged.
+type cachingKV struct {
+	WatchableKV
+	cache *rangeCache
+}
+
+func (c *cachingKV) Read(mode ReadTxMode, trace *traceutil.Trace) TxnRead {
+	// The cache revision watermark and the underlying store snapshot must be
+	// captured as a single atomic step with respect to concurrent writes:
+	// otherwise a write could commit and invalidate the cache in the gap
+	// between the two reads, leaving this txn with a watermark that is newer
+	// than the data it will actually observe (or vice versa), which would
+	// let a later maybeAdd wrongly believe its stale result is still current.
+	c.cache.mu.RLock()
+	defer c.cache.mu.RUnlock()
+	return &cachingTxnRead{
+		TxnRead:     c.WatchableKV.Read(mode, trace),
+		cache:       c.cache,
+		epochAtOpen: c.cache.currentRev,
+	}
+}
+
+func (c *cachingKV) Write(trace *traceutil.Trace) TxnWrite {
+	return &cachingTxnWrite{TxnWrite: c.WatchableKV.Write(trace), cache: c.cache}
+}
+
+// Range, Rev and FirstRev mirror the KV-level convenience methods that the
+// real store implements by opening a Read() txn (see readView in
+// kv_view.go), so that every entry point goes through the cache.
+func (c *cachingKV) Range(ctx context.Context, key, end []byte, ro RangeOptions) (*RangeResult, error) {
+	tr := c.Read(ConcurrentReadTxMode, traceutil.TODO())
+	defer tr.End()
+	return tr.Range(ctx, key, end, ro)
+}
+
+func (c *cachingKV) Rev() int64 {
+	tr := c.Read(SharedBufReadTxMode, traceutil.TODO())
+	defer tr.End()
+	return tr.Rev()
+}
+
+func (c *cachingKV) FirstRev() int64 {
+	tr := c.Read(SharedBufReadTxMode, traceutil.TODO())
+	defer tr.End()
+	return tr.FirstRev()
+}
+
+// Put and DeleteRange mirror the KV-level convenience methods (writeView in
+// kv_view.go), routed through our Write() so a write can never bypass
+// invalidation.
+func (c *cachingKV) Put(key, value []byte, lease lease.LeaseID) int64 {
+	tw := c.Write(traceutil.TODO())
+	defer tw.End()
+	return tw.Put(key, value, lease)
+}
+
+func (c *cachingKV) DeleteRange(key, end []byte) (n, rev int64) {
+	tw := c.Write(traceutil.TODO())
+	defer tw.End()
+	return tw.DeleteRange(key, end)
+}
+
+func (c *cachingKV) Compact(trace *traceutil.Trace, rev int64) (<-chan struct{}, error) {
+	ch, err := c.WatchableKV.Compact(trace, rev)
+	if err != nil {
+		return ch, err
+	}
+	// Compaction never changes what a "latest" read observes, only how far
+	// back history reaches, so evicting everything is always safe: any
+	// pinned-revision entry that the compaction just compacted past would
+	// otherwise keep returning data that a fresh read would now reject with
+	// ErrCompacted.
+	c.cache.reset(c.WatchableKV.Rev())
+	return ch, nil
+}
+
+func (c *cachingKV) Restore(b backend.Backend) error {
+	err := c.WatchableKV.Restore(b)
+	c.cache.reset(c.WatchableKV.Rev())
+	return err
+}
+
+// cachingTxnRead serves Range from the cache on a hit, and on a miss stores
+// the freshly-read result for next time, but only if no write has committed
+// since this txn's snapshot was opened.
+type cachingTxnRead struct {
+	TxnRead
+	cache       *rangeCache
+	epochAtOpen int64
+}
+
+func (tr *cachingTxnRead) Range(ctx context.Context, key, end []byte, ro RangeOptions) (*RangeResult, error) {
+	ck := newRangeCacheKey(key, end, ro)
+	if rr, ok := tr.cache.get(ck); ok {
+		return rr, nil
+	}
+	rr, err := tr.TxnRead.Range(ctx, key, end, ro)
+	if err != nil {
+		return rr, err
+	}
+	tr.cache.maybeAdd(ck, rr, tr.epochAtOpen)
+	return rr, nil
+}
+
+// cachingTxnWrite evicts affected cache entries as part of committing the
+// underlying write, so the eviction and the commit are never observable
+// apart from one another.
+type cachingTxnWrite struct {
+	TxnWrite
+	cache *rangeCache
+}
+
+func (tw *cachingTxnWrite) End() {
+	beginRev := tw.TxnWrite.Rev()
+	changes := tw.TxnWrite.Changes()
+	tw.cache.mu.Lock()
+	defer tw.cache.mu.Unlock()
+	tw.TxnWrite.End()
+	if len(changes) == 0 {
+		return
+	}
+	tw.cache.invalidateLocked(changes, beginRev+1)
+}
+
+// rangeCacheKey identifies a cacheable Range call. It deliberately excludes
+// request fields (sort order/target, Min/MaxModRevision, Min/MaxCreateRevision)
+// that the etcdserver txn layer applies as a pure, deterministic
+// post-processing step on top of the raw RangeResult: caching before that
+// step is applied both keeps the cache key simple and lets requests that
+// differ only in those fields share a single cached entry.
+type rangeCacheKey struct {
+	key    string
+	hasEnd bool // RangeEnd != nil; mirrors the single-key-vs-range distinction used throughout mvcc.
+	end    string
+	limit  int64
+	rev    int64 // pinned revision requested; 0 means "latest".
+
+	countOnly      bool
+	fastKeysOnly   bool
+	withTotalCount bool
+}
+
+func newRangeCacheKey(key, end []byte, ro RangeOptions) rangeCacheKey {
+	return rangeCacheKey{
+		key:            string(key),
+		hasEnd:         end != nil,
+		end:            string(end),
+		limit:          ro.Limit,
+		rev:            ro.Rev,
+		countOnly:      ro.CountOnly,
+		fastKeysOnly:   ro.FastKeysOnly,
+		withTotalCount: ro.WithTotalCount,
+	}
+}
+
+// contains reports whether the single key k falls inside the key range that
+// ck was computed over, using the same [key, end) / single-key / ">= key"
+// conventions as store.rangeKeys.
+func (ck rangeCacheKey) contains(k []byte) bool {
+	key := []byte(ck.key)
+	if string(k) < string(key) {
+		return false
+	}
+	if !ck.hasEnd {
+		return string(k) == ck.key
+	}
+	if ck.end == "" {
+		return true
+	}
+	return string(k) < ck.end
+}
+
+// rangeCache is a bounded, revision-gated cache of RangeResults.
+//
+// currentRev is a watermark, maintained only by this cache, that tracks how
+// many writes it has observed and invalidated. A Range result may only be
+// inserted if currentRev is unchanged from the moment its snapshot was
+// opened: any difference means a write committed (and evicted whatever
+// overlapping entries existed at that time) while the read was in flight, so
+// the freshly computed result could already be stale and must not be cached
+// as "the latest" answer.
+type rangeCache struct {
+	mu         sync.RWMutex
+	entries    map[rangeCacheKey]*RangeResult
+	maxEntries int
+	currentRev int64
+}
+
+func newRangeCache(maxEntries int, currentRev int64) *rangeCache {
+	return &rangeCache{
+		entries:    make(map[rangeCacheKey]*RangeResult),
+		maxEntries: maxEntries,
+		currentRev: currentRev,
+	}
+}
+
+func (c *rangeCache) get(key rangeCacheKey) (*RangeResult, bool) {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	rr, ok := c.entries[key]
+	if !ok {
+		return nil, false
+	}
+	return cloneRangeResult(rr), true
+}
+
+func (c *rangeCache) maybeAdd(key rangeCacheKey, result *RangeResult, epochAtOpen int64) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.currentRev != epochAtOpen {
+		// A write committed (and ran its invalidation sweep) while this read
+		// was in flight. The result we just computed may already be stale
+		// for the overlapping range, so don't let it re-enter the cache.
+		return
+	}
+	if _, exists := c.entries[key]; !exists && len(c.entries) >= c.maxEntries {
+		// Bounded, cheap eviction: map iteration order is effectively random
+		// in Go, which is sufficient since this only needs to keep memory
+		// bounded, not maximize the hit rate.
+		for k := range c.entries {
+			delete(c.entries, k)
+			break
+		}
+	}
+	c.entries[key] = cloneRangeResult(result)
+}
+
+// invalidateLocked evicts every "latest" (rev == 0) entry whose range
+// contains any of changes' keys, and advances the watermark to newRev.
+// Callers must hold c.mu and must call it only after the write that produced
+// changes has fully committed, so that the watermark bump and the eviction
+// happen atomically with the data actually becoming visible to new readers.
+func (c *rangeCache) invalidateLocked(changes []*mvccpb.KeyValue, newRev int64) {
+	c.currentRev = newRev
+	for ck := range c.entries {
+		if ck.rev != 0 {
+			// Pinned-revision reads are answers about immutable history;
+			// later writes can never change what they must return.
+			continue
+		}
+		for _, kv := range changes {
+			if ck.contains(kv.Key) {
+				delete(c.entries, ck)
+				break
+			}
+		}
+	}
+}
+
+func (c *rangeCache) reset(currentRev int64) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.entries = make(map[rangeCacheKey]*RangeResult)
+	c.currentRev = currentRev
+}
+
+func cloneRangeResult(rr *RangeResult) *RangeResult {
+	if rr == nil {
+		return nil
+	}
+	clone := &RangeResult{Rev: rr.Rev, Count: rr.Count}
+	if rr.KVs != nil {
+		clone.KVs = make([]*mvccpb.KeyValue, len(rr.KVs))
+		for i, kv := range rr.KVs {
+			if kv == nil {
+				continue
+			}
+			// A shallow field-by-field copy is enough: callers (e.g. the
+			// etcdserver txn layer for KeysOnly requests) reassign fields
+			// like Value on the copy they were handed, they never mutate the
+			// byte slices in place. mvccpb.KeyValue embeds a proto
+			// MessageState (which contains a mutex), so it must be rebuilt
+			// field-by-field rather than copied as a whole struct.
+			clone.KVs[i] = &mvccpb.KeyValue{
+				Key:            kv.Key,
+				CreateRevision: kv.CreateRevision,
+				ModRevision:    kv.ModRevision,
+				Version:        kv.Version,
+				Value:          kv.Value,
+				Lease:          kv.Lease,
+			}
+		}
+	}
+	return clone
+}
diff --git a/server/storage/mvcc/read_cache_test.go b/server/storage/mvcc/read_cache_test.go
