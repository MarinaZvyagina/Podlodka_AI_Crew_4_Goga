+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package mvcc
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"go.uber.org/zap/zaptest"
+
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+)
+
+// countingKV wraps a WatchableKV and counts how many times a Range call was
+// actually served by the underlying store, so tests can tell a cache hit
+// (count unchanged) apart from a cache miss (count incremented).
+type countingKV struct {
+	WatchableKV
+	rangeCalls atomic.Int64
+}
+
+func (c *countingKV) Read(mode ReadTxMode, trace *traceutil.Trace) TxnRead {
+	return &countingTxnRead{TxnRead: c.WatchableKV.Read(mode, trace), counter: &c.rangeCalls}
+}
+
+type countingTxnRead struct {
+	TxnRead
+	counter *atomic.Int64
+}
+
+func (tr *countingTxnRead) Range(ctx context.Context, key, end []byte, ro RangeOptions) (*RangeResult, error) {
+	tr.counter.Add(1)
+	return tr.TxnRead.Range(ctx, key, end, ro)
+}
+
+func newTestCachingKV(t *testing.T) (WatchableKV, *countingKV) {
+	t.Helper()
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { b.Close() })
+	s := New(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{})
+	t.Cleanup(func() { s.Close() })
+	counting := &countingKV{WatchableKV: s}
+	return NewReadCache(counting, 0), counting
+}
+
+func mustRange(t *testing.T, kv ReadView, key, end []byte, ro RangeOptions) *RangeResult {
+	t.Helper()
+	rr, err := kv.Range(context.Background(), key, end, ro)
+	if err != nil {
+		t.Fatalf("Range(%q, %q) failed: %v", key, end, err)
+	}
+	return rr
+}
+
+func TestReadCacheServesRepeatedRangeWithoutTouchingStore(t *testing.T) {
+	kv, counting := newTestCachingKV(t)
+	kv.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	first := mustRange(t, kv, []byte("foo"), nil, RangeOptions{})
+	if got := counting.rangeCalls.Load(); got != 1 {
+		t.Fatalf("expected 1 real Range call after first read, got %d", got)
+	}
+	if len(first.KVs) != 1 || string(first.KVs[0].Value) != "bar" {
+		t.Fatalf("unexpected first result: %+v", first)
+	}
+
+	for i := 0; i < 5; i++ {
+		again := mustRange(t, kv, []byte("foo"), nil, RangeOptions{})
+		if got := counting.rangeCalls.Load(); got != 1 {
+			t.Fatalf("repeated identical Range should be served from cache, real Range call count = %d", got)
+		}
+		if len(again.KVs) != 1 || string(again.KVs[0].Value) != "bar" || again.Rev != first.Rev {
+			t.Fatalf("cached result diverged from original: got %+v, want %+v", again, first)
+		}
+	}
+}
+
+func TestReadCacheMissBehavesLikeUncachedRead(t *testing.T) {
+	plainB, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { plainB.Close() })
+	plain := New(zaptest.NewLogger(t), plainB, &lease.FakeLessor{}, StoreConfig{})
+	t.Cleanup(func() { plain.Close() })
+
+	cached, _ := newTestCachingKV(t)
+
+	for _, kv := range []WatchableKV{plain, cached} {
+		kv.Put([]byte("a"), []byte("1"), lease.NoLease)
+		kv.Put([]byte("b"), []byte("2"), lease.NoLease)
+	}
+
+	wantRR, wantErr := plain.Range(context.Background(), []byte("a"), []byte("z"), RangeOptions{})
+	gotRR, gotErr := cached.Range(context.Background(), []byte("a"), []byte("z"), RangeOptions{})
+	if (wantErr == nil) != (gotErr == nil) {
+		t.Fatalf("error mismatch: want %v, got %v", wantErr, gotErr)
+	}
+	if wantRR.Rev != gotRR.Rev || wantRR.Count != gotRR.Count || len(wantRR.KVs) != len(gotRR.KVs) {
+		t.Fatalf("miss result diverged from uncached read: want %+v, got %+v", wantRR, gotRR)
+	}
+	for i := range wantRR.KVs {
+		if string(wantRR.KVs[i].Key) != string(gotRR.KVs[i].Key) || string(wantRR.KVs[i].Value) != string(gotRR.KVs[i].Value) {
+			t.Fatalf("miss KV[%d] diverged: want %+v, got %+v", i, wantRR.KVs[i], gotRR.KVs[i])
+		}
+	}
+
+	// A request shape the cache never saw (future revision) must still error
+	// exactly like the uncached store.
+	_, wantErr = plain.Range(context.Background(), []byte("a"), nil, RangeOptions{Rev: 999})
+	_, gotErr = cached.Range(context.Background(), []byte("a"), nil, RangeOptions{Rev: 999})
+	if wantErr != ErrFutureRev || gotErr != ErrFutureRev {
+		t.Fatalf("expected ErrFutureRev from both, want %v got %v", wantErr, gotErr)
+	}
+}
+
+func TestReadCacheInvalidatesOnOverlappingPut(t *testing.T) {
+	kv, counting := newTestCachingKV(t)
+	kv.Put([]byte("foo"), []byte("v1"), lease.NoLease)
+
+	rr := mustRange(t, kv, []byte("foo"), nil, RangeOptions{})
+	if string(rr.KVs[0].Value) != "v1" {
+		t.Fatalf("want v1, got %q", rr.KVs[0].Value)
+	}
+	if got := counting.rangeCalls.Load(); got != 1 {
+		t.Fatalf("want 1 real Range call, got %d", got)
+	}
+
+	kv.Put([]byte("foo"), []byte("v2"), lease.NoLease)
+
+	// No sleep, no TTL: the very next read must already see v2.
+	rr = mustRange(t, kv, []byte("foo"), nil, RangeOptions{})
+	if string(rr.KVs[0].Value) != "v2" {
+		t.Fatalf("stale read after Put: want v2, got %q", rr.KVs[0].Value)
+	}
+	if got := counting.rangeCalls.Load(); got != 2 {
+		t.Fatalf("expected the write to force a real Range call, count = %d", got)
+	}
+}
+
+func TestReadCacheInvalidatesOnOverlappingDeleteRange(t *testing.T) {
+	kv, counting := newTestCachingKV(t)
+	kv.Put([]byte("key1"), []byte("v1"), lease.NoLease)
+	kv.Put([]byte("key2"), []byte("v2"), lease.NoLease)
+
+	rr := mustRange(t, kv, []byte("key1"), []byte("key3"), RangeOptions{})
+	if len(rr.KVs) != 2 {
+		t.Fatalf("want 2 keys, got %d", len(rr.KVs))
+	}
+	baseline := counting.rangeCalls.Load()
+
+	kv.DeleteRange([]byte("key1"), []byte("key2"))
+
+	rr = mustRange(t, kv, []byte("key1"), []byte("key3"), RangeOptions{})
+	if len(rr.KVs) != 1 || string(rr.KVs[0].Key) != "key2" {
+		t.Fatalf("stale read after DeleteRange: got %+v", rr.KVs)
+	}
+	if got := counting.rangeCalls.Load(); got != baseline+1 {
+		t.Fatalf("expected exactly one additional real Range call, got %d more", got-baseline)
+	}
+}
+
+func TestReadCacheKeepsUnrelatedRangesCached(t *testing.T) {
+	kv, counting := newTestCachingKV(t)
+	kv.Put([]byte("a"), []byte("1"), lease.NoLease)
+	kv.Put([]byte("z"), []byte("1"), lease.NoLease)
+
+	mustRange(t, kv, []byte("a"), nil, RangeOptions{})
+	baseline := counting.rangeCalls.Load()
+
+	// A write to an unrelated key must not evict "a"'s cached entry.
+	kv.Put([]byte("z"), []byte("2"), lease.NoLease)
+
+	mustRange(t, kv, []byte("a"), nil, RangeOptions{})
+	if got := counting.rangeCalls.Load(); got != baseline {
+		t.Fatalf("unrelated write evicted an unrelated cache entry: extra real Range calls = %d", got-baseline)
+	}
+}
+
+func TestReadCachePinnedRevisionSurvivesLaterWrites(t *testing.T) {
+	kv, counting := newTestCachingKV(t)
+	kv.Put([]byte("foo"), []byte("v1"), lease.NoLease)
+	pinnedRev := kv.Rev()
+
+	rr := mustRange(t, kv, []byte("foo"), nil, RangeOptions{Rev: pinnedRev})
+	if string(rr.KVs[0].Value) != "v1" {
+		t.Fatalf("want v1, got %q", rr.KVs[0].Value)
+	}
+	baseline := counting.rangeCalls.Load()
+
+	kv.Put([]byte("foo"), []byte("v2"), lease.NoLease)
+
+	// The pinned-revision read describes immutable history: it must still be
+	// servable from the cache (and still be v1) even though "foo" moved on.
+	rr = mustRange(t, kv, []byte("foo"), nil, RangeOptions{Rev: pinnedRev})
+	if string(rr.KVs[0].Value) != "v1" {
+		t.Fatalf("pinned-revision read changed after a later write: got %q", rr.KVs[0].Value)
+	}
+	if got := counting.rangeCalls.Load(); got != baseline {
+		t.Fatalf("pinned-revision entry was evicted by an unrelated write, extra calls = %d", got-baseline)
+	}
+
+	// "latest" reads, in contrast, must observe v2 immediately.
+	rr = mustRange(t, kv, []byte("foo"), nil, RangeOptions{})
+	if string(rr.KVs[0].Value) != "v2" {
+		t.Fatalf("latest read did not observe the new write: got %q", rr.KVs[0].Value)
+	}
+}
+
+func TestReadCacheCompactionClearsPinnedEntries(t *testing.T) {
+	kv, _ := newTestCachingKV(t)
+	kv.Put([]byte("foo"), []byte("v1"), lease.NoLease)
+	oldRev := kv.Rev()
+	kv.Put([]byte("foo"), []byte("v2"), lease.NoLease)
+	kv.Put([]byte("foo"), []byte("v3"), lease.NoLease)
+
+	mustRange(t, kv, []byte("foo"), nil, RangeOptions{Rev: oldRev})
+
+	ch, err := kv.Compact(traceutil.TODO(), kv.Rev())
+	if err != nil {
+		t.Fatalf("Compact failed: %v", err)
+	}
+	<-ch
+
+	_, err = kv.Range(context.Background(), []byte("foo"), nil, RangeOptions{Rev: oldRev})
+	if err != ErrCompacted {
+		t.Fatalf("want ErrCompacted after compaction past a previously cached revision, got %v", err)
+	}
+}
+
+// TestReadCacheConcurrentReadsNeverObserveStaleData hammers the cache with
+// concurrent repeated reads of a key while another goroutine keeps
+// overwriting it, and checks that no reader ever observes the ModRevision go
+// backwards -- which is exactly the failure mode a racy insert-after-evict
+// would produce.
+func TestReadCacheConcurrentReadsNeverObserveStaleData(t *testing.T) {
+	kv, _ := newTestCachingKV(t)
+	kv.Put([]byte("k"), []byte("0"), lease.NoLease)
+
+	const writers = 4
+	const readers = 8
+	const writesPerWriter = 200
+
+	var writerWG sync.WaitGroup
+	for w := 0; w < writers; w++ {
+		writerWG.Add(1)
+		go func(w int) {
+			defer writerWG.Done()
+			for i := 0; i < writesPerWriter; i++ {
+				kv.Put([]byte("k"), []byte(fmt.Sprintf("w%d-%d", w, i)), lease.NoLease)
+			}
+		}(w)
+	}
+
+	stop := make(chan struct{})
+	errs := make(chan error, readers)
+	var readerWG sync.WaitGroup
+	for r := 0; r < readers; r++ {
+		readerWG.Add(1)
+		go func() {
+			defer readerWG.Done()
+			var lastSeen int64
+			for {
+				select {
+				case <-stop:
+					errs <- nil
+					return
+				default:
+				}
+				rr, err := kv.Range(context.Background(), []byte("k"), nil, RangeOptions{})
+				if err != nil {
+					errs <- err
+					return
+				}
+				if len(rr.KVs) != 1 {
+					errs <- fmt.Errorf("unexpected KV count %d", len(rr.KVs))
+					return
+				}
+				mod := rr.KVs[0].ModRevision
+				if mod < lastSeen {
+					errs <- fmt.Errorf("observed ModRevision go backwards: saw %d after %d", mod, lastSeen)
+					return
+				}
+				lastSeen = mod
+			}
+		}()
+	}
+
+	writerWG.Wait()
+	close(stop)
+	readerWG.Wait()
+	close(errs)
+	for err := range errs {
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+}
