+// TestKVRangeCacheNeverStale repeats the same Get immediately after a Put
+// that changes the value, for both linearizable and serializable reads. A
+// server-side cache for repeated identical reads must never let a client
+// observe a value older than what an uncached read would have returned at
+// the time of the request.
+func TestKVRangeCacheNeverStale(t *testing.T) {
+	integration.BeforeTest(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 3})
+	defer clus.Terminate(t)
+
+	kv := clus.RandClient()
+	ctx := t.Context()
+
+	key := "cache-key"
+	for i, serializable := range []bool{false, true} {
+		val := fmt.Sprintf("v%d", i)
+		opts := []clientv3.OpOption{}
+		if serializable {
+			opts = append(opts, clientv3.WithSerializable())
+		}
+
+		// Warm the cache with the value before this iteration's write.
+		if _, err := kv.Get(ctx, key, opts...); err != nil {
+			t.Fatalf("warm-up get: %v", err)
+		}
+
+		if _, err := kv.Put(ctx, key, val); err != nil {
+			t.Fatalf("put: %v", err)
+		}
+
+		resp, err := kv.Get(ctx, key, opts...)
+		if err != nil {
+			t.Fatalf("get after put: %v", err)
+		}
+		if len(resp.Kvs) != 1 || string(resp.Kvs[0].Value) != val {
+			t.Fatalf("serializable=%v: expected fresh value %q, got %+v", serializable, val, resp.Kvs)
+		}
+	}
+}
