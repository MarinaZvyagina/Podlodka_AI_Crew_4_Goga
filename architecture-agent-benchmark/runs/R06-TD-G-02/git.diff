+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package txn
+
+import (
+	"context"
+	"testing"
+
+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+func newTestStore(t *testing.T) mvcc.KV {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { betesting.Close(t, b) })
+	s := mvcc.NewStore(zaptest.NewLogger(t), b, &lease.FakeLessor{}, mvcc.StoreConfig{})
+	t.Cleanup(func() { s.Close() })
+	return s
+}
+
+func mustRange(t *testing.T, kv mvcc.KV, r *pb.RangeRequest) *pb.RangeResponse {
+	t.Helper()
+	resp, _, err := Range(context.Background(), zaptest.NewLogger(t), kv, r, true)
+	if err != nil {
+		t.Fatalf("Range: %v", err)
+	}
+	return resp
+}
+
+func TestRangeCacheHitAfterMiss(t *testing.T) {
+	kv := newTestStore(t)
+	kv.Put([]byte("a"), []byte("1"), 0)
+
+	req := &pb.RangeRequest{Key: []byte("a")}
+
+	if _, ok := NewRangeCache(DefaultRangeCacheEntries).Get(kv, req); ok {
+		t.Fatalf("expected miss on empty cache")
+	}
+
+	c := NewRangeCache(DefaultRangeCacheEntries)
+	if _, ok := c.Get(kv, req); ok {
+		t.Fatalf("expected miss before Put")
+	}
+
+	resp := mustRange(t, kv, req)
+	c.Put(kv, req, resp)
+
+	cached, ok := c.Get(kv, req)
+	if !ok {
+		t.Fatalf("expected hit after Put")
+	}
+	if len(cached.Kvs) != 1 || string(cached.Kvs[0].Value) != "1" {
+		t.Fatalf("unexpected cached kvs: %+v", cached.Kvs)
+	}
+	if cached.Header.Revision != kv.Rev() {
+		t.Fatalf("expected cache hit to be stamped with the current revision %d, got %d", kv.Rev(), cached.Header.Revision)
+	}
+}
+
+func TestRangeCacheServesCurrentRevisionOnHit(t *testing.T) {
+	kv := newTestStore(t)
+	kv.Put([]byte("a"), []byte("1"), 0)
+
+	req := &pb.RangeRequest{Key: []byte("a")}
+	resp := mustRange(t, kv, req)
+
+	c := NewRangeCache(DefaultRangeCacheEntries)
+	c.Put(kv, req, resp)
+
+	// A write to an unrelated key still advances the global revision that an
+	// uncached Range would report in its header.
+	kv.Put([]byte("z"), []byte("unrelated"), 0)
+
+	cached, ok := c.Get(kv, req)
+	if !ok {
+		t.Fatalf("expected hit for unrelated key range")
+	}
+	if cached.Header.Revision != kv.Rev() {
+		t.Fatalf("cached response revision %d does not match current revision %d", cached.Header.Revision, kv.Rev())
+	}
+}
+
+func TestRangeCacheNeverCachesPinnedRevision(t *testing.T) {
+	kv := newTestStore(t)
+	kv.Put([]byte("a"), []byte("1"), 0)
+
+	req := &pb.RangeRequest{Key: []byte("a"), Revision: kv.Rev()}
+	resp := mustRange(t, kv, req)
+
+	c := NewRangeCache(DefaultRangeCacheEntries)
+	c.Put(kv, req, resp)
+
+	if _, ok := c.Get(kv, req); ok {
+		t.Fatalf("expected pinned-revision requests to never be cached")
+	}
+}
+
+func TestRangeCacheInvalidatesOnOverlappingPut(t *testing.T) {
+	kv := newTestStore(t)
+	kv.Put([]byte("a"), []byte("1"), 0)
+
+	req := &pb.RangeRequest{Key: []byte("a")}
+	c := NewRangeCache(DefaultRangeCacheEntries)
+	c.Put(kv, req, mustRange(t, kv, req))
+
+	if _, ok := c.Get(kv, req); !ok {
+		t.Fatalf("expected hit before invalidation")
+	}
+
+	kv.Put([]byte("a"), []byte("2"), 0)
+	c.Invalidate([]byte("a"), nil)
+
+	if _, ok := c.Get(kv, req); ok {
+		t.Fatalf("expected miss after invalidating an overlapping write")
+	}
+
+	// The subsequent uncached read should see the new value and repopulate
+	// the cache correctly.
+	resp := mustRange(t, kv, req)
+	if string(resp.Kvs[0].Value) != "2" {
+		t.Fatalf("expected updated value, got %q", resp.Kvs[0].Value)
+	}
+	c.Put(kv, req, resp)
+	cached, ok := c.Get(kv, req)
+	if !ok || string(cached.Kvs[0].Value) != "2" {
+		t.Fatalf("expected cache to reflect the new value, got %+v", cached)
+	}
+}
+
+func TestRangeCacheInvalidateDoesNotAffectDisjointRange(t *testing.T) {
+	kv := newTestStore(t)
+	kv.Put([]byte("a"), []byte("1"), 0)
+	kv.Put([]byte("b"), []byte("1"), 0)
+
+	reqA := &pb.RangeRequest{Key: []byte("a")}
+	reqB := &pb.RangeRequest{Key: []byte("b")}
+	c := NewRangeCache(DefaultRangeCacheEntries)
+	c.Put(kv, reqA, mustRange(t, kv, reqA))
+	c.Put(kv, reqB, mustRange(t, kv, reqB))
+
+	kv.Put([]byte("a"), []byte("2"), 0)
+	c.Invalidate([]byte("a"), nil)
+
+	if _, ok := c.Get(kv, reqA); ok {
+		t.Fatalf("expected key a to be invalidated")
+	}
+	if _, ok := c.Get(kv, reqB); !ok {
+		t.Fatalf("expected disjoint key b to remain cached")
+	}
+}
+
+// TestRangeCacheRejectsStaleInsertRacingWithWrite reproduces the race the
+// cache must not fall prey to: a read observes data as of revision X, and
+// before it manages to populate the cache, a concurrent write commits and
+// advances the store past X. If Put blindly cached the response, nothing
+// would ever invalidate it again, and readers would see a value older than
+// an uncached read would return indefinitely.
+func TestRangeCacheRejectsStaleInsertRacingWithWrite(t *testing.T) {
+	kv := newTestStore(t)
+	kv.Put([]byte("a"), []byte("1"), 0)
+
+	req := &pb.RangeRequest{Key: []byte("a")}
+	staleResp := mustRange(t, kv, req)
+
+	// Simulate the write committing (and invalidating, which is a no-op
+	// here since nothing is cached yet) after staleResp was read but before
+	// it's handed to Put.
+	kv.Put([]byte("a"), []byte("2"), 0)
+
+	c := NewRangeCache(DefaultRangeCacheEntries)
+	c.Invalidate([]byte("a"), nil)
+	c.Put(kv, req, staleResp)
+
+	if _, ok := c.Get(kv, req); ok {
+		t.Fatalf("expected stale response to be rejected, not cached")
+	}
+}
+
+func TestRangeCachePurge(t *testing.T) {
+	kv := newTestStore(t)
+	kv.Put([]byte("a"), []byte("1"), 0)
+
+	req := &pb.RangeRequest{Key: []byte("a")}
+	c := NewRangeCache(DefaultRangeCacheEntries)
+	c.Put(kv, req, mustRange(t, kv, req))
+
+	if c.Size() != 1 {
+		t.Fatalf("expected 1 cached entry, got %d", c.Size())
+	}
+	c.Purge()
+	if c.Size() != 0 {
+		t.Fatalf("expected empty cache after Purge, got %d", c.Size())
+	}
+	if _, ok := c.Get(kv, req); ok {
+		t.Fatalf("expected miss after Purge")
+	}
+}
+
+func TestRangeCacheNilIsNoop(t *testing.T) {
+	var c *RangeCache
+	kv := newTestStore(t)
+	req := &pb.RangeRequest{Key: []byte("a")}
+
+	if _, ok := c.Get(kv, req); ok {
+		t.Fatalf("expected nil cache to always miss")
+	}
+	c.Put(kv, req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: kv.Rev()}})
+	c.Invalidate([]byte("a"), nil)
+	c.Purge()
+	if c.Size() != 0 {
+		t.Fatalf("expected nil cache size 0")
+	}
+}
+
+func TestInvalidateForTxn(t *testing.T) {
+	kv := newTestStore(t)
+	kv.Put([]byte("a"), []byte("1"), 0)
+	kv.Put([]byte("nested"), []byte("1"), 0)
+
+	reqA := &pb.RangeRequest{Key: []byte("a")}
+	reqNested := &pb.RangeRequest{Key: []byte("nested")}
+	c := NewRangeCache(DefaultRangeCacheEntries)
+	c.Put(kv, reqA, mustRange(t, kv, reqA))
+	c.Put(kv, reqNested, mustRange(t, kv, reqNested))
+
+	rt := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a"), Value: []byte("2")}}},
+			{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("nested"), Value: []byte("2")}}},
+				},
+			}}},
+		},
+	}
+	resp := &pb.TxnResponse{
+		Succeeded: true,
+		Responses: []*pb.ResponseOp{
+			{Response: &pb.ResponseOp_ResponsePut{ResponsePut: &pb.PutResponse{}}},
+			{Response: &pb.ResponseOp_ResponseTxn{ResponseTxn: &pb.TxnResponse{
+				Succeeded: true,
+				Responses: []*pb.ResponseOp{
+					{Response: &pb.ResponseOp_ResponsePut{ResponsePut: &pb.PutResponse{}}},
+				},
+			}}},
+		},
+	}
+
+	InvalidateForTxn(c, rt, resp)
+
+	if _, ok := c.Get(kv, reqA); ok {
+		t.Fatalf("expected top-level put to invalidate key a")
+	}
+	if _, ok := c.Get(kv, reqNested); ok {
+		t.Fatalf("expected nested put to invalidate key nested")
+	}
+}
