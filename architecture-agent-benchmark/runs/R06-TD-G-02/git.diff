diff --git a/server/etcdserver/txn/range_cache.go b/server/etcdserver/txn/range_cache.go
new file mode 100644
index 0000000..92102e6
--- /dev/null
+++ b/server/etcdserver/txn/range_cache.go
@@ -0,0 +1,231 @@
+// Copyright 2026 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package txn
+
+import (
+	"sync"
+
+	"google.golang.org/protobuf/proto"
+	"k8s.io/utils/lru"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+	"go.etcd.io/etcd/pkg/v3/adt"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+// DefaultRangeCacheEntries bounds the number of distinct Range requests
+// RangeCache remembers a response for.
+const DefaultRangeCacheEntries = 2048
+
+// RangeCache memoizes RangeResponses for repeated Range requests that ask
+// for the current revision (Revision == 0), so that bursts of identical
+// reads (e.g. many replicas polling the same small set of keys) don't each
+// have to redo the underlying index lookup, filtering and sorting.
+//
+// It does not rely on a fixed expiration: entries are dropped synchronously
+// whenever a write touches their key range, and a candidate entry is only
+// ever admitted into the cache after re-confirming, under the same lock used
+// for invalidation, that no write has landed since it was read. That check
+// closes the race where a read started before a concurrent write, but
+// finishes and would populate the cache after that write's invalidation has
+// already run -- without it, such an entry could sit in the cache forever,
+// since nothing would ever invalidate it again.
+type RangeCache struct {
+	mu     sync.Mutex
+	lru    *lru.Cache
+	ranges adt.IntervalTree
+}
+
+// rangeCacheEntry holds the parts of a RangeResponse that depend only on the
+// queried range's own content, not on unrelated writes elsewhere in the
+// keyspace. The header revision is always re-stamped with the store's
+// current revision when an entry is served, matching what an uncached Range
+// call would report.
+type rangeCacheEntry struct {
+	kvs   []*mvccpb.KeyValue
+	count int64
+	more  bool
+}
+
+// NewRangeCache creates a RangeCache that remembers at most maxEntries
+// distinct requests.
+func NewRangeCache(maxEntries int) *RangeCache {
+	return &RangeCache{
+		lru:    lru.New(maxEntries),
+		ranges: adt.NewIntervalTree(),
+	}
+}
+
+// cacheableRange reports whether r's answer can be memoized. Only requests
+// pinned to the current revision have an answer that changes solely in
+// response to writes we can observe and invalidate on.
+func cacheableRange(r *pb.RangeRequest) bool {
+	return r.Revision == 0
+}
+
+// cacheKey normalizes a request into a stable lookup key. Serializable
+// doesn't change what data is returned for a given revision, so linearizable
+// and serializable requests for the same range and options share an entry.
+func cacheKey(r *pb.RangeRequest) string {
+	norm := proto.Clone(r).(*pb.RangeRequest)
+	norm.Serializable = false
+	b, err := proto.Marshal(norm)
+	if err != nil {
+		panic(err)
+	}
+	return string(b)
+}
+
+// Get returns the cached response for r, if any, with its header stamped
+// with kv's current revision -- exactly what an uncached Range call would
+// report even if only unrelated keys have changed since the entry was
+// cached.
+func (c *RangeCache) Get(kv mvcc.KV, r *pb.RangeRequest) (*pb.RangeResponse, bool) {
+	if c == nil || !cacheableRange(r) {
+		return nil, false
+	}
+
+	c.mu.Lock()
+	v, ok := c.lru.Get(cacheKey(r))
+	c.mu.Unlock()
+	if !ok {
+		return nil, false
+	}
+
+	e := v.(*rangeCacheEntry)
+	return &pb.RangeResponse{
+		Header: &pb.ResponseHeader{Revision: kv.Rev()},
+		Kvs:    e.kvs,
+		Count:  e.count,
+		More:   e.more,
+	}, true
+}
+
+// Put caches resp as the answer for r, unless a write has already committed
+// since resp was computed. That freshness check and the insert happen while
+// holding the same lock Invalidate uses, so a write racing with this call
+// can never be missed: either it invalidates this range before the insert
+// (in which case the insert is rejected here) or after (in which case
+// Invalidate will find and remove the entry we're about to add).
+func (c *RangeCache) Put(kv mvcc.KV, r *pb.RangeRequest, resp *pb.RangeResponse) {
+	if c == nil || !cacheableRange(r) {
+		return
+	}
+	key := cacheKey(r)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if kv.Rev() != resp.Header.Revision {
+		// Something committed since resp was read. Caching it now could
+		// hand out a value older than an uncached read would return, with
+		// nothing left to invalidate it later.
+		return
+	}
+
+	c.lru.Add(key, &rangeCacheEntry{kvs: resp.Kvs, count: resp.Count, more: resp.More})
+
+	var ivl adt.Interval
+	if len(r.RangeEnd) != 0 {
+		ivl = adt.NewStringAffineInterval(string(r.Key), string(r.RangeEnd))
+	} else {
+		ivl = adt.NewStringAffinePoint(string(r.Key))
+	}
+	if iv := c.ranges.Find(ivl); iv != nil {
+		iv.Val.(map[string]struct{})[key] = struct{}{}
+	} else {
+		c.ranges.Insert(ivl, map[string]struct{}{key: {}})
+	}
+}
+
+// Invalidate drops every cached response whose requested range intersects
+// [key, end). It must be called synchronously by every successful mutation,
+// after the mutation is durably applied, so that no reader can ever observe
+// a cached response older than what an uncached read would have returned.
+func (c *RangeCache) Invalidate(key, end []byte) {
+	if c == nil {
+		return
+	}
+
+	var ivl adt.Interval
+	if len(end) != 0 {
+		ivl = adt.NewStringAffineInterval(string(key), string(end))
+	} else {
+		ivl = adt.NewStringAffinePoint(string(key))
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	for _, iv := range c.ranges.Stab(ivl) {
+		for k := range iv.Val.(map[string]struct{}) {
+			c.lru.Remove(k)
+		}
+	}
+	// Delete after removing all keys, since Delete mutates ivs in place.
+	c.ranges.Delete(ivl)
+}
+
+// Purge drops every cached entry. It exists for paths that replace the
+// entire keyspace out from under normal write invalidation, such as
+// restoring from a snapshot.
+func (c *RangeCache) Purge() {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.lru.Clear()
+	c.ranges = adt.NewIntervalTree()
+}
+
+// Size returns the number of responses currently cached.
+func (c *RangeCache) Size() int {
+	if c == nil {
+		return 0
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.lru.Len()
+}
+
+// InvalidateForTxn invalidates cache entries for every Put and DeleteRange
+// executed by an already-applied Txn, recursing into nested transactions.
+// rt and resp must be the request and response of that same Txn.
+func InvalidateForTxn(c *RangeCache, rt *pb.TxnRequest, resp *pb.TxnResponse) {
+	if c == nil || rt == nil || resp == nil {
+		return
+	}
+	reqs := rt.Success
+	if !resp.Succeeded {
+		reqs = rt.Failure
+	}
+	for i, req := range reqs {
+		if i >= len(resp.Responses) {
+			return
+		}
+		switch tv := req.Request.(type) {
+		case *pb.RequestOp_RequestPut:
+			c.Invalidate(tv.RequestPut.Key, nil)
+		case *pb.RequestOp_RequestDeleteRange:
+			c.Invalidate(tv.RequestDeleteRange.Key, tv.RequestDeleteRange.RangeEnd)
+		case *pb.RequestOp_RequestTxn:
+			if nested := resp.Responses[i].GetResponseTxn(); nested != nil {
+				InvalidateForTxn(c, tv.RequestTxn, nested)
+			}
+		}
+	}
+}
diff --git a/server/etcdserver/txn/range_cache_test.go b/server/etcdserver/txn/range_cache_test.go
new file mode 100644
index 0000000..a28f3db
--- /dev/null
+++ b/server/etcdserver/txn/range_cache_test.go
@@ -0,0 +1,273 @@
+// Copyright 2026 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
