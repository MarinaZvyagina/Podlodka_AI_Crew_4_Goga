diff --git a/server/etcdserver/v3_range_cache.go b/server/etcdserver/v3_range_cache.go
new file mode 100644
index 000000000..090133f63
--- /dev/null
+++ b/server/etcdserver/v3_range_cache.go
@@ -0,0 +1,213 @@
+// Copyright 2026 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package etcdserver
+
+import (
+	"bytes"
+	"sync"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+)
+
+// rangeCacheMaxEntries bounds the number of distinct Range requests kept in
+// memory. The cache targets a small, hot set of repeatedly-read keys (e.g.
+// many replicas polling the same config keys), so a modest cap is enough to
+// keep memory bounded without meaningfully hurting hit rate.
+const rangeCacheMaxEntries = 4096
+
+// rangeCacheKey identifies a Range request by every parameter that affects
+// its result. Serializable is deliberately excluded: a cached result is
+// equally valid for a serializable or a linearizable request as long as it
+// is still fresh (see rangeReadCache), so sharing entries across both
+// maximizes the cache's usefulness.
+type rangeCacheKey struct {
+	key, rangeEnd                        string
+	revision                             int64
+	limit                                int64
+	sortOrder, sortTarget                int32
+	keysOnly, countOnly                  bool
+	minModRevision, maxModRevision       int64
+	minCreateRevision, maxCreateRevision int64
+}
+
+func newRangeCacheKey(r *pb.RangeRequest) rangeCacheKey {
+	return rangeCacheKey{
+		key:               string(r.Key),
+		rangeEnd:          string(r.RangeEnd),
+		revision:          r.Revision,
+		limit:             r.Limit,
+		sortOrder:         int32(r.SortOrder),
+		sortTarget:        int32(r.SortTarget),
+		keysOnly:          r.KeysOnly,
+		countOnly:         r.CountOnly,
+		minModRevision:    r.MinModRevision,
+		maxModRevision:    r.MaxModRevision,
+		minCreateRevision: r.MinCreateRevision,
+		maxCreateRevision: r.MaxCreateRevision,
+	}
+}
+
+// keyRange mirrors the [key, rangeEnd) semantics used by the mvcc read path
+// (see mvcc.ReadView.Range and txn.mkGteRange), so overlap checks used for
+// invalidation agree with what a request actually reads.
+type keyRange struct {
+	start, end []byte // end == nil means unbounded (rangeEnd was "\x00")
+	single     bool   // true means a single-key get (rangeEnd was empty)
+}
+
+func newKeyRange(key, rangeEnd []byte) keyRange {
+	switch {
+	case len(rangeEnd) == 0:
+		return keyRange{start: key, single: true}
+	case len(rangeEnd) == 1 && rangeEnd[0] == 0:
+		return keyRange{start: key}
+	default:
+		return keyRange{start: key, end: rangeEnd}
+	}
+}
+
+func (r keyRange) overlaps(k []byte) bool {
+	if r.single {
+		return bytes.Equal(k, r.start)
+	}
+	if bytes.Compare(k, r.start) < 0 {
+		return false
+	}
+	return r.end == nil || bytes.Compare(k, r.end) < 0
+}
+
+type rangeCacheEntry struct {
+	resp   *pb.RangeResponse
+	rng    keyRange
+	pinned bool // read at a fixed historical revision: immutable, never invalidated by writes
+}
+
+// rangeReadCache caches Range responses keyed by their request parameters,
+// so repeated identical reads can skip the mvcc read path entirely.
+//
+// Correctness relies on two mechanisms working together:
+//   - onChange is invoked synchronously by the mvcc store for every applied
+//     write, strictly before the new revision becomes visible to readers
+//     (see mvcc.ChangeNotifier). It evicts any cached entry whose range
+//     overlaps a changed key, so a later lookup can never observe a value
+//     older than the write.
+//   - epoch guards the "insert after invalidate" race: a read result is
+//     only cached if no write was applied while that read was in flight
+//     (beginRead/put), so a slow read racing a concurrent write can never
+//     repopulate the cache with data that is already stale.
+type rangeReadCache struct {
+	mu      sync.Mutex
+	epoch   uint64
+	entries map[rangeCacheKey]*rangeCacheEntry
+	fifo    []rangeCacheKey
+	maxSize int
+}
+
+func newRangeReadCache(maxSize int) *rangeReadCache {
+	return &rangeReadCache{
+		entries: make(map[rangeCacheKey]*rangeCacheEntry),
+		maxSize: maxSize,
+	}
+}
+
+// get returns a fresh, independently-mutable response for k, or nil on a
+// cache miss. The header is cloned because callers fill in per-request
+// fields (cluster ID, member ID, raft term) in place; the Kvs payload is
+// shared since it is never mutated once assembled.
+func (c *rangeReadCache) get(k rangeCacheKey) *pb.RangeResponse {
+	c.mu.Lock()
+	e, ok := c.entries[k]
+	c.mu.Unlock()
+	if !ok {
+		return nil
+	}
+	return cloneRangeResponse(e.resp)
+}
+
+// beginRead returns a token that must be passed to put unchanged for the
+// read's result to be cached.
+func (c *rangeReadCache) beginRead() uint64 {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.epoch
+}
+
+// put caches resp for k, unless a write raced with the read identified by
+// token, in which case resp may already be stale and is left uncached.
+func (c *rangeReadCache) put(k rangeCacheKey, r *pb.RangeRequest, token uint64, resp *pb.RangeResponse) {
+	if c.maxSize <= 0 {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.epoch != token {
+		return
+	}
+	if _, exists := c.entries[k]; !exists {
+		if len(c.fifo) >= c.maxSize {
+			delete(c.entries, c.fifo[0])
+			c.fifo = c.fifo[1:]
+		}
+		c.fifo = append(c.fifo, k)
+	}
+	entry := &rangeCacheEntry{resp: cloneRangeResponse(resp), pinned: r.Revision != 0}
+	if !entry.pinned {
+		entry.rng = newKeyRange(r.Key, r.RangeEnd)
+	}
+	c.entries[k] = entry
+}
+
+func (c *rangeReadCache) onChange(changes []*mvccpb.KeyValue) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.epoch++
+	for k, e := range c.entries {
+		if e.pinned {
+			continue
+		}
+		for _, kv := range changes {
+			if e.rng.overlaps(kv.Key) {
+				delete(c.entries, k)
+				break
+			}
+		}
+	}
+}
+
+func (c *rangeReadCache) onReset() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.epoch++
+	c.entries = make(map[rangeCacheKey]*rangeCacheEntry)
+	c.fifo = nil
+}
+
+func cloneRangeResponse(r *pb.RangeResponse) *pb.RangeResponse {
+	clone := &pb.RangeResponse{
+		Kvs:   r.Kvs,
+		More:  r.More,
+		Count: r.Count,
+	}
+	if r.Header != nil {
+		clone.Header = &pb.ResponseHeader{
+			ClusterId: r.Header.ClusterId,
+			MemberId:  r.Header.MemberId,
+			Revision:  r.Header.Revision,
+			RaftTerm:  r.Header.RaftTerm,
+		}
+	}
+	return clone
+}
