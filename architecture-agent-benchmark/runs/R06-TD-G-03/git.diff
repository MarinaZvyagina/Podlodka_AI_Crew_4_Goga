+)
+
+func TestWatchableStoreChangeNotifierOnChange(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	s := New(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{})
+	defer cleanup(s, b)
+
+	cn, ok := s.(ChangeNotifier)
+	if !ok {
+		t.Fatal("watchableStore must implement ChangeNotifier")
+	}
+
+	var got [][]*mvccpb.KeyValue
+	cn.OnChange(func(changes []*mvccpb.KeyValue) {
+		// Copy since the slice/backing KeyValues can be reused by later
+		// writes; assert on values captured at call time.
+		cp := append([]*mvccpb.KeyValue(nil), changes...)
+		got = append(got, cp)
+	})
+
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+	s.DeleteRange([]byte("foo"), nil)
+
+	if len(got) != 2 {
+		t.Fatalf("expected 2 change notifications, got %d", len(got))
+	}
+	if len(got[0]) != 1 || string(got[0][0].Key) != "foo" {
+		t.Fatalf("unexpected first notification: %+v", got[0])
+	}
+	if len(got[1]) != 1 || string(got[1][0].Key) != "foo" {
+		t.Fatalf("unexpected second notification: %+v", got[1])
+	}
+}
+
+func TestWatchableStoreChangeNotifierNoChangeNoCall(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	s := New(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{})
+	defer cleanup(s, b)
+
+	cn := s.(ChangeNotifier)
+	calls := 0
+	cn.OnChange(func(changes []*mvccpb.KeyValue) { calls++ })
+
+	// Deleting a range with no matching keys makes no change.
+	s.DeleteRange([]byte("missing"), nil)
+
+	if calls != 0 {
+		t.Fatalf("expected no notification for a no-op delete, got %d calls", calls)
+	}
+}
+
+func TestWatchableStoreChangeNotifierOnReset(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	s := New(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{})
+	defer cleanup(s, b)
+
+	cn := s.(ChangeNotifier)
+	resets := 0
+	cn.OnReset(func() { resets++ })
+
+	if err := s.Restore(b); err != nil {
+		t.Fatalf("Restore: %v", err)
+	}
+
+	if resets != 1 {
+		t.Fatalf("expected 1 reset notification, got %d", resets)
+	}
+}
