+// TestKVGetCacheFreshness guards against a read cache serving stale data: it
+// repeats the same Get (warming any server-side cache) and then immediately
+// writes a new value, asserting the very next Get -- serializable or
+// linearizable -- observes the write. A cache invalidated only by a fixed
+// expiry timer could still return the pre-write value here.
+//
+// Put and Get are both pinned to the same member. Serializable reads are
+// only guaranteed to be as fresh as a normal (uncached) read on the member
+// that serves them -- a serializable read against a *different*, lagging
+// replica can legitimately observe an older value than a just-completed
+// write regardless of caching, since it never consults raft. Pinning to one
+// member isolates that member's own cache behavior from cross-replica
+// replication lag.
+func TestKVGetCacheFreshness(t *testing.T) {
+	testRunner.BeforeTest(t)
+	for _, tc := range clusterTestCases() {
+		t.Run(tc.name, func(t *testing.T) {
+			for _, serializable := range []bool{false, true} {
+				t.Run(fmt.Sprintf("serializable=%v", serializable), func(t *testing.T) {
+					ctx, cancel := context.WithTimeout(t.Context(), 30*time.Second)
+					defer cancel()
+					clus := testRunner.NewCluster(ctx, t, config.WithClusterConfig(tc.config))
+					defer clus.Close()
+					cc := clus.Members()[0].Client()
+					getOpts := config.GetOptions{Serializable: serializable}
+
+					testutils.ExecuteUntil(ctx, t, func() {
+						key := "foo"
+						for i := range 20 {
+							value := fmt.Sprintf("v%d", i)
+							_, err := cc.Put(ctx, key, value, config.PutOptions{})
+							require.NoError(t, err)
+
+							// Repeat the identical read a few times so a
+							// cache, if present, is warmed with this
+							// value before the next write.
+							for range 3 {
+								resp, err := cc.Get(ctx, key, getOpts)
+								require.NoError(t, err)
+								require.Len(t, resp.Kvs, 1)
+								assert.Equalf(t, value, string(resp.Kvs[0].Value),
+									"stale read after put %d: got %q, want %q", i, resp.Kvs[0].Value, value)
+							}
+						}
+					})
+				})
+			}
+		})
+	}
+}
