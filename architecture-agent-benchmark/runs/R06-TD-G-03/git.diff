+++ b/server/etcdserver/v3_server.go
@@ -146,7 +146,7 @@ func (s *EtcdServer) Range(ctx context.Context, r *pb.RangeRequest) (*pb.RangeRe
 		return s.authStore.IsRangePermitted(ai, r.Key, r.RangeEnd)
 	}
 
-	get := func() { resp, _, err = txn.Range(ctx, s.Logger(), s.KV(), r, true) }
+	get := func() { resp, err = s.cachedRange(ctx, r) }
 	if serr := s.doSerialize(ctx, chk, get); serr != nil {
 		err = serr
 		return nil, err
@@ -154,6 +154,31 @@ func (s *EtcdServer) Range(ctx context.Context, r *pb.RangeRequest) (*pb.RangeRe
 	return resp, err
 }
 
+// cachedRange serves r from the range cache when a fresh cached response is
+// available, and otherwise performs a normal read and populates the cache
+// for next time. See rangeReadCache for the invalidation/freshness
+// guarantees that make this safe for both serializable and linearizable
+// callers.
+func (s *EtcdServer) cachedRange(ctx context.Context, r *pb.RangeRequest) (*pb.RangeResponse, error) {
+	if s.rangeCache == nil {
+		resp, _, err := txn.Range(ctx, s.Logger(), s.KV(), r, true)
+		return resp, err
+	}
+
+	key := newRangeCacheKey(r)
+	if resp := s.rangeCache.get(key); resp != nil {
+		return resp, nil
+	}
+
+	token := s.rangeCache.beginRead()
+	resp, _, err := txn.Range(ctx, s.Logger(), s.KV(), r, true)
+	if err != nil {
+		return nil, err
+	}
+	s.rangeCache.put(key, r, token, resp)
+	return resp, nil
+}
+
