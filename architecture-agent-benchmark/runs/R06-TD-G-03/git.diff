+++ b/server/storage/mvcc/CODEMANIFEST
@@ -93,6 +93,22 @@ Annotations: |
     callback with.
     `cfg`: compaction batch size and pacing.
 
+"ChangeNotifier()":
+  location: watchable_store.go
+  annotations: |
+    Implemented by the same store returned from `New`. Lets an external subscriber (e.g. a
+    read-side cache in an importing cell) observe every applied write synchronously and in
+    commit order, strictly before the new revision becomes visible to readers. Unlike
+    `WatchStream`, delivery here is not buffered/async, so a subscriber can rely on having
+    reacted to a write before any caller can observe its effects.
+  methods:
+    "OnChange(fn func(changes []mvccpb.KeyValue))": |
+      Register `fn` to run for every batch of key changes committed by a write transaction,
+      including lease-expiry driven deletes.
+    "OnReset(fn func())": |
+      Register `fn` to run whenever the store's entire state is replaced wholesale (snapshot
+      restore), since per-write change notifications don't cover that path.
+
 ---
 
 Author: Goga
diff --git a/server/storage/mvcc/watchable_store.go b/server/storage/mvcc/watchable_store.go
index 7d2e5b619..30bd6b640 100644
--- a/server/storage/mvcc/watchable_store.go
+++ b/server/storage/mvcc/watchable_store.go
@@ -71,11 +71,45 @@ type watchableStore struct {
 	// The key of the map is the key that the watcher watches on.
 	synced watcherGroup
 
+	// changeSubs and resetSubs are called synchronously (under mu) from
+	// End and Restore respectively, before the new state becomes visible
+	// to readers. This lets a subscriber (e.g. a read cache) invalidate
+	// itself before any caller can observe the corresponding change, which
+	// plain watch delivery (buffered, asynchronous) cannot guarantee.
+	changeSubs []func(changes []*mvccpb.KeyValue)
+	resetSubs  []func()
+
 	stopc chan struct{}
 	wg    sync.WaitGroup
 }
 
 var _ WatchableKV = (*watchableStore)(nil)
+var _ ChangeNotifier = (*watchableStore)(nil)
+
+// ChangeNotifier lets external subscribers observe every mutation applied to
+// the store synchronously and in commit order, strictly before the new
+// revision becomes visible to readers.
+type ChangeNotifier interface {
+	// OnChange registers fn to be called for every batch of key changes
+	// committed by a write transaction (including lease-expiry driven
+	// deletes), while the store's write lock is still held.
+	OnChange(fn func(changes []*mvccpb.KeyValue))
+	// OnReset registers fn to be called whenever the store's entire state
+	// is replaced wholesale, e.g. after a snapshot restore.
+	OnReset(fn func())
+}
+
+func (s *watchableStore) OnChange(fn func(changes []*mvccpb.KeyValue)) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.changeSubs = append(s.changeSubs, fn)
+}
+
+func (s *watchableStore) OnReset(fn func()) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.resetSubs = append(s.resetSubs, fn)
+}
 
 // cancelFunc updates unsynced and synced maps when running
 // cancel operations.
@@ -217,6 +251,10 @@ func (s *watchableStore) Restore(b backend.Backend) error {
 		s.unsynced.add(wa)
 	}
 	s.synced = newWatcherGroup()
+
+	for _, fn := range s.resetSubs {
+		fn()
+	}
 	return nil
 }
 
