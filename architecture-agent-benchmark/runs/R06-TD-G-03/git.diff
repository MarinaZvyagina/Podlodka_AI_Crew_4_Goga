+// limitations under the License.
+
+package etcdserver
+
+import (
+	"testing"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+)
+
+func TestRangeReadCacheHitAndMiss(t *testing.T) {
+	c := newRangeReadCache(rangeCacheMaxEntries)
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	k := newRangeCacheKey(req)
+
+	if resp := c.get(k); resp != nil {
+		t.Fatalf("expected miss on empty cache, got %+v", resp)
+	}
+
+	token := c.beginRead()
+	want := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}, Kvs: []*mvccpb.KeyValue{{Key: []byte("foo"), Value: []byte("bar")}}}
+	c.put(k, req, token, want)
+
+	got := c.get(k)
+	if got == nil {
+		t.Fatal("expected hit after put")
+	}
+	if got.Header.Revision != 5 || string(got.Kvs[0].Value) != "bar" {
+		t.Fatalf("unexpected cached response: %+v", got)
+	}
+	// The returned header must be an independent copy so callers can safely
+	// mutate it (as the gRPC layer does when filling in cluster metadata).
+	got.Header.Revision = 99
+	if again := c.get(k); again.Header.Revision != 5 {
+		t.Fatalf("mutating a returned response corrupted the cache: %+v", again)
+	}
+}
+
+func TestRangeReadCacheDistinctParamsDontCollide(t *testing.T) {
+	c := newRangeReadCache(rangeCacheMaxEntries)
+	base := &pb.RangeRequest{Key: []byte("foo")}
+	withLimit := &pb.RangeRequest{Key: []byte("foo"), Limit: 1}
+
+	tok := c.beginRead()
+	c.put(newRangeCacheKey(base), base, tok, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	if resp := c.get(newRangeCacheKey(withLimit)); resp != nil {
+		t.Fatalf("expected requests with different params to miss, got %+v", resp)
+	}
+}
+
+func TestRangeReadCacheInvalidatesOnlyOverlappingRange(t *testing.T) {
+	c := newRangeReadCache(rangeCacheMaxEntries)
+
+	fooReq := &pb.RangeRequest{Key: []byte("foo")}
+	barReq := &pb.RangeRequest{Key: []byte("bar")}
+	fooKey, barKey := newRangeCacheKey(fooReq), newRangeCacheKey(barReq)
+
+	tok := c.beginRead()
+	c.put(fooKey, fooReq, tok, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+	tok = c.beginRead()
+	c.put(barKey, barReq, tok, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	// A write to "foo" must evict only the "foo" entry.
+	c.onChange([]*mvccpb.KeyValue{{Key: []byte("foo")}})
+
+	if resp := c.get(fooKey); resp != nil {
+		t.Fatalf("expected foo entry to be invalidated, got %+v", resp)
+	}
+	if resp := c.get(barKey); resp == nil {
+		t.Fatal("expected unrelated bar entry to survive the write to foo")
+	}
+}
+
+func TestRangeReadCacheRangeOverlap(t *testing.T) {
+	c := newRangeReadCache(rangeCacheMaxEntries)
+	req := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}
+	k := newRangeCacheKey(req)
+	tok := c.beginRead()
+	c.put(k, req, tok, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	c.onChange([]*mvccpb.KeyValue{{Key: []byte("m")}})
+
+	if resp := c.get(k); resp != nil {
+		t.Fatal("expected write inside the cached range to invalidate the entry")
+	}
+}
+
+func TestRangeReadCacheOutsideRangeSurvives(t *testing.T) {
+	c := newRangeReadCache(rangeCacheMaxEntries)
+	req := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("m")}
+	k := newRangeCacheKey(req)
+	tok := c.beginRead()
+	c.put(k, req, tok, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	c.onChange([]*mvccpb.KeyValue{{Key: []byte("z")}})
+
+	if resp := c.get(k); resp == nil {
+		t.Fatal("expected write outside the cached range to leave the entry cached")
+	}
+}
+
+func TestRangeReadCacheDoesNotCacheAcrossConcurrentWrite(t *testing.T) {
+	c := newRangeReadCache(rangeCacheMaxEntries)
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	k := newRangeCacheKey(req)
+
+	token := c.beginRead()
+	// A write commits while the read identified by token is still "in
+	// flight" (i.e. before put is called).
+	c.onChange([]*mvccpb.KeyValue{{Key: []byte("unrelated")}})
+
+	c.put(k, req, token, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	if resp := c.get(k); resp != nil {
+		t.Fatal("expected read racing a concurrent write to not populate the cache")
+	}
+}
+
+func TestRangeReadCachePinnedHistoricalReadSurvivesWrites(t *testing.T) {
+	c := newRangeReadCache(rangeCacheMaxEntries)
+	req := &pb.RangeRequest{Key: []byte("foo"), Revision: 3}
+	k := newRangeCacheKey(req)
+	tok := c.beginRead()
+	c.put(k, req, tok, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 3}})
+
+	c.onChange([]*mvccpb.KeyValue{{Key: []byte("foo")}})
+
+	if resp := c.get(k); resp == nil {
+		t.Fatal("expected a pinned historical read to survive a write to the same key")
+	}
+}
+
+func TestRangeReadCacheOnReset(t *testing.T) {
+	c := newRangeReadCache(rangeCacheMaxEntries)
+	req := &pb.RangeRequest{Key: []byte("foo"), Revision: 3}
+	k := newRangeCacheKey(req)
+	tok := c.beginRead()
+	c.put(k, req, tok, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 3}})
+
+	c.onReset()
+
+	if resp := c.get(k); resp != nil {
+		t.Fatal("expected onReset to clear even pinned entries")
+	}
+}
+
+func TestRangeReadCacheEviction(t *testing.T) {
+	c := newRangeReadCache(2)
+	for i := range 3 {
+		req := &pb.RangeRequest{Key: []byte{byte('a' + i)}}
+		tok := c.beginRead()
+		c.put(newRangeCacheKey(req), req, tok, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+	}
+	if len(c.entries) != 2 {
+		t.Fatalf("expected cache to be bounded at 2 entries, got %d", len(c.entries))
+	}
+	// The oldest entry ("a") should have been evicted first.
+	firstReq := &pb.RangeRequest{Key: []byte("a")}
+	if resp := c.get(newRangeCacheKey(firstReq)); resp != nil {
+		t.Fatal("expected the oldest entry to be evicted")
+	}
+}
diff --git a/server/etcdserver/v3_server.go b/server/etcdserver/v3_server.go
