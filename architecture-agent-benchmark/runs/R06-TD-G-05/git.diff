+
+package mvcc
+
+import (
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+
+	"go.etcd.io/etcd/api/v3/mvccpb"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+)
+
+// recordingWriteNotifier is a WriteNotifier that records every call it
+// receives, for use in tests asserting on when and how it is invoked.
+type recordingWriteNotifier struct {
+	mu      sync.Mutex
+	notices [][]*mvccpb.KeyValue
+	resets  int
+}
+
+func (r *recordingWriteNotifier) Notify(changes []*mvccpb.KeyValue) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	cp := make([]*mvccpb.KeyValue, len(changes))
+	copy(cp, changes)
+	r.notices = append(r.notices, cp)
+}
+
+func (r *recordingWriteNotifier) Reset() {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.resets++
+}
+
+func (r *recordingWriteNotifier) keys() [][]byte {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	var out [][]byte
+	for _, changes := range r.notices {
+		for _, kv := range changes {
+			out = append(out, kv.Key)
+		}
+	}
+	return out
+}
+
+func TestWatchableStoreWriteNotifierOnPut(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	wn := &recordingWriteNotifier{}
+	s := New(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{WriteNotifier: wn})
+	defer cleanup(s, b)
+
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	require.Equal(t, [][]byte{[]byte("foo")}, wn.keys())
+}
+
+func TestWatchableStoreWriteNotifierOnDeleteRange(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	wn := &recordingWriteNotifier{}
+	s := New(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{WriteNotifier: wn})
+	defer cleanup(s, b)
+
+	s.Put([]byte("foo1"), []byte("bar"), lease.NoLease)
+	s.Put([]byte("foo2"), []byte("bar"), lease.NoLease)
+	wn.notices = nil // isolate the DeleteRange call below
+
+	s.DeleteRange([]byte("foo1"), []byte("foo3"))
+
+	require.ElementsMatch(t, [][]byte{[]byte("foo1"), []byte("foo2")}, wn.keys())
+}
+
+func TestWatchableStoreWriteNotifierNoOpTxnSkipsNotify(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	wn := &recordingWriteNotifier{}
+	s := New(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{WriteNotifier: wn})
+	defer cleanup(s, b)
+
+	// A DeleteRange over a key that doesn't exist makes no change to the
+	// store, so there is nothing for a cache to invalidate.
+	s.DeleteRange([]byte("missing"), nil)
+
+	require.Empty(t, wn.notices)
+}
+
+func TestWatchableStoreWriteNotifierResetOnRestore(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	wn := &recordingWriteNotifier{}
+	s := New(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{WriteNotifier: wn})
+	defer cleanup(s, b)
+
+	require.NoError(t, s.Restore(b))
+	require.Equal(t, 1, wn.resets)
+}
