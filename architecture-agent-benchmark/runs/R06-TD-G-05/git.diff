@@ -31,6 +31,24 @@ type RangeOptions struct {
 	WithTotalCount bool
 }
 
+// WriteNotifier lets a caller observe writes committed through a KV
+// synchronously, strictly before those writes become visible to any read
+// transaction newly opened against that KV. It exists so that external
+// state derived from reads (such as a read-side response cache) can be kept
+// from ever returning a value older than what a direct read would have
+// returned at the time it was made.
+type WriteNotifier interface {
+	// Notify reports every key/value touched by a just-committed write
+	// transaction. It is called while the KV holds internal locks that
+	// block new read transactions from starting, so implementations must
+	// return promptly and must not call back into the KV.
+	Notify(changes []*mvccpb.KeyValue)
+	// Reset is called whenever the KV's underlying data is replaced
+	// wholesale, such as after a snapshot restore, and must discard any
+	// state derived from writes observed before this call.
+	Reset()
+}
+
 type RangeResult struct {
 	KVs   []*mvccpb.KeyValue
 	Rev   int64
