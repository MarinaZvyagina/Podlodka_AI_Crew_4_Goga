+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package txn
+
+import (
+	"sync"
+
+	"google.golang.org/protobuf/proto"
+	"k8s.io/utils/lru"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+	"go.etcd.io/etcd/pkg/v3/adt"
+)
+
+// defaultRangeCacheEntries bounds how many distinct RangeRequests are cached
+// at once.
+const defaultRangeCacheEntries = 2048
+
+// RangeCache caches RangeResponses for repeated, identical RangeRequests
+// that ask for the current revision (Revision == 0), so that a burst of
+// duplicate reads (e.g. many replicas polling the same small key set at
+// startup) doesn't redo a full read against the store for every request.
+//
+// It implements mvcc.WriteNotifier so it can be wired into a KV's write
+// path and invalidated synchronously, before a write becomes visible to any
+// new read transaction against that KV. That ordering is what guarantees a
+// cache hit is never staler than an uncached read would have been at the
+// time it was served, for both linearizable and serializable reads: a
+// linearizable read only reaches the cache after it has confirmed the local
+// KV already reflects every write it must observe, and a serializable read
+// reaches the cache no earlier than an uncached serializable read would
+// have reached the KV, on the very same node.
+//
+// A pinned historical read (Revision != 0) is never cached: its result
+// never changes for a given revision, other than becoming ErrCompacted
+// after compaction, which this cache does not track separately.
+type RangeCache struct {
+	mu  sync.Mutex
+	lru *lru.Cache
+
+	// ranges reverse-indexes cached entries by the key range they were
+	// requested over, so a write can find and drop every cached response
+	// it may have staled without scanning the whole cache.
+	ranges adt.IntervalTree
+	// keyIvl maps an LRU key back to the interval it is indexed under in
+	// ranges, so it can be removed from there whenever it leaves the LRU,
+	// however that happens (explicit invalidation or capacity eviction).
+	keyIvl map[string]adt.Interval
+}
+
+func NewRangeCache() *RangeCache {
+	c := &RangeCache{
+		ranges: adt.NewIntervalTree(),
+		keyIvl: make(map[string]adt.Interval),
+	}
+	c.lru = lru.NewWithEvictionFunc(defaultRangeCacheEntries, c.onEvicted)
+	return c
+}
+
+// onEvicted removes a key from the reverse index whenever it leaves the
+// LRU. It is invoked synchronously from within c.lru's own Add/Remove,
+// which are only ever called while c.mu is already held, so it must not
+// lock c.mu itself.
+func (c *RangeCache) onEvicted(key lru.Key, _ any) {
+	k := key.(string)
+	ivl, ok := c.keyIvl[k]
+	if !ok {
+		return
+	}
+	delete(c.keyIvl, k)
+	iv := c.ranges.Find(ivl)
+	if iv == nil {
+		return
+	}
+	keys := iv.Val.(map[string]struct{})
+	delete(keys, k)
+	if len(keys) == 0 {
+		c.ranges.Delete(ivl)
+	}
+}
+
+func cacheable(r *pb.RangeRequest) bool {
+	// Only current-revision reads are cached; see the RangeCache doc comment.
+	return r.Revision == 0
+}
+
+func rangeInterval(r *pb.RangeRequest) adt.Interval {
+	if len(r.RangeEnd) != 0 {
+		return adt.NewBytesAffineInterval(r.Key, r.RangeEnd)
+	}
+	return adt.NewBytesAffinePoint(r.Key)
+}
+
+// Get returns a previously cached response for a request with identical
+// parameters to r, if one is cached. The caller receives its own private
+// clone: response handling (e.g. filling in the response header) mutates
+// the returned message in place exactly as it would for an uncached read,
+// without disturbing either the cached entry or any other concurrent
+// caller's copy.
+func (c *RangeCache) Get(r *pb.RangeRequest) (*pb.RangeResponse, bool) {
+	if !cacheable(r) {
+		return nil, false
+	}
+	key, err := proto.Marshal(r)
+	if err != nil {
+		return nil, false
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	v, ok := c.lru.Get(string(key))
+	if !ok {
+		return nil, false
+	}
+	return proto.Clone(v.(*pb.RangeResponse)).(*pb.RangeResponse), true
+}
+
+// Add caches a private clone of resp as the response to a request with r's
+// parameters. Cloning ensures nothing the caller subsequently does to resp
+// (such as filling in the response header) reaches back into the cache.
+func (c *RangeCache) Add(r *pb.RangeRequest, resp *pb.RangeResponse) {
+	if !cacheable(r) {
+		return
+	}
+	key, err := proto.Marshal(r)
+	if err != nil {
+		return
+	}
+	k := string(key)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.lru.Add(k, proto.Clone(resp).(*pb.RangeResponse))
+
+	ivl := rangeInterval(r)
+	c.keyIvl[k] = ivl
+	if iv := c.ranges.Find(ivl); iv != nil {
+		iv.Val.(map[string]struct{})[k] = struct{}{}
+	} else {
+		c.ranges.Insert(ivl, map[string]struct{}{k: {}})
+	}
+}
+
+// Notify implements mvcc.WriteNotifier. It drops every cached response
+// whose requested range overlaps a just-written key, so the next read over
+// that range misses the cache and observes the write.
+func (c *RangeCache) Notify(changes []*mvccpb.KeyValue) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for _, kv := range changes {
+		for _, iv := range c.ranges.Stab(adt.NewBytesAffinePoint(kv.Key)) {
+			for k := range iv.Val.(map[string]struct{}) {
+				c.lru.Remove(k)
+			}
+		}
+	}
+}
+
+// Reset implements mvcc.WriteNotifier. It discards the entire cache; used
+// when the underlying data is replaced wholesale (e.g. snapshot restore).
+func (c *RangeCache) Reset() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.lru = lru.NewWithEvictionFunc(defaultRangeCacheEntries, c.onEvicted)
+	c.ranges = adt.NewIntervalTree()
+	c.keyIvl = make(map[string]adt.Interval)
+}
