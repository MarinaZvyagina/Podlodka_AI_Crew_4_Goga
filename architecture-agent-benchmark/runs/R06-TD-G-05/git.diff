+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package txn
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+)
+
+func TestRangeCacheHitOnIdenticalRequest(t *testing.T) {
+	c := NewRangeCache()
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}, Kvs: []*mvccpb.KeyValue{{Key: []byte("foo"), Value: []byte("bar")}}}
+
+	c.Add(req, resp)
+
+	got, ok := c.Get(&pb.RangeRequest{Key: []byte("foo")})
+	require.True(t, ok)
+	require.Equal(t, resp.Kvs, got.Kvs)
+	require.Equal(t, resp.Header.Revision, got.Header.Revision)
+}
+
+func TestRangeCacheMissOnDifferentOptions(t *testing.T) {
+	c := NewRangeCache()
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}}
+	c.Add(req, resp)
+
+	tcs := []*pb.RangeRequest{
+		{Key: []byte("foo"), Limit: 1},
+		{Key: []byte("foo"), KeysOnly: true},
+		{Key: []byte("foo"), CountOnly: true},
+		{Key: []byte("foo"), Serializable: true},
+		{Key: []byte("foo"), RangeEnd: []byte("fop")},
+	}
+	for _, tc := range tcs {
+		_, ok := c.Get(tc)
+		require.Falsef(t, ok, "expected miss for request %+v", tc)
+	}
+}
+
+func TestRangeCachePinnedRevisionIsNeverCached(t *testing.T) {
+	c := NewRangeCache()
+	req := &pb.RangeRequest{Key: []byte("foo"), Revision: 3}
+	c.Add(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 3}})
+
+	_, ok := c.Get(req)
+	require.False(t, ok, "a pinned-revision request must never be served from the cache")
+}
+
+func TestRangeCacheGetReturnsIndependentClone(t *testing.T) {
+	c := NewRangeCache()
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	c.Add(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}})
+
+	got1, ok := c.Get(req)
+	require.True(t, ok)
+	got1.Header.RaftTerm = 42 // simulate the response-header-filling interceptor mutating in place
+
+	got2, ok := c.Get(req)
+	require.True(t, ok)
+	require.NotSame(t, got1, got2)
+	require.NotSame(t, got1.Header, got2.Header)
+	require.Zero(t, got2.Header.RaftTerm, "mutating one caller's copy must not affect another's")
+}
+
+func TestRangeCacheNotifyInvalidatesOverlappingRange(t *testing.T) {
+	c := NewRangeCache()
+	req := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("m")}
+	c.Add(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}})
+
+	c.Notify([]*mvccpb.KeyValue{{Key: []byte("f")}}) // inside [a, m)
+
+	_, ok := c.Get(req)
+	require.False(t, ok, "a write inside the cached range must invalidate it")
+}
+
+func TestRangeCacheNotifyLeavesDisjointRangeAlone(t *testing.T) {
+	c := NewRangeCache()
+	req := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("m")}
+	c.Add(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}})
+
+	c.Notify([]*mvccpb.KeyValue{{Key: []byte("z")}}) // outside [a, m)
+
+	_, ok := c.Get(req)
+	require.True(t, ok, "a write outside the cached range must not invalidate it")
+}
+
+func TestRangeCacheNotifyOnPointKey(t *testing.T) {
+	c := NewRangeCache()
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	c.Add(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}})
+
+	c.Notify([]*mvccpb.KeyValue{{Key: []byte("bar")}})
+	_, ok := c.Get(req)
+	require.True(t, ok, "a write to an unrelated key must not invalidate a point read")
+
+	c.Notify([]*mvccpb.KeyValue{{Key: []byte("foo")}})
+	_, ok = c.Get(req)
+	require.False(t, ok, "a write to the exact cached key must invalidate it")
+}
+
+func TestRangeCacheReset(t *testing.T) {
+	c := NewRangeCache()
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	c.Add(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}})
+
+	c.Reset()
+
+	_, ok := c.Get(req)
+	require.False(t, ok)
+}
+
+func TestRangeCacheEvictionCleansReverseIndex(t *testing.T) {
+	c := NewRangeCache()
+	// Fill past capacity with distinct single-key ranges so the oldest is
+	// evicted by the LRU itself, not by an explicit write.
+	for i := range defaultRangeCacheEntries + 1 {
+		key := []byte{byte(i / 256), byte(i % 256)}
+		c.Add(&pb.RangeRequest{Key: key}, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+	}
+
+	require.Len(t, c.keyIvl, defaultRangeCacheEntries, "the reverse index must not grow past the LRU's own bound")
+}
