diff --git a/tests/integration/v3_kv_test.go b/tests/integration/v3_kv_test.go
index 7b6b9644e..169cb902b 100644
--- a/tests/integration/v3_kv_test.go
+++ b/tests/integration/v3_kv_test.go
@@ -65,3 +65,55 @@ func TestKVWithEmptyValue(t *testing.T) {
 	require.NoError(t, err)
 	t.Logf("delete keys:%d", respDel.Deleted)
 }
+
+// TestKVRangeCacheReflectsSubsequentWrite guards against a server-side range
+// cache serving a value that is staler than what an uncached read would
+// return: repeating the exact same Get until it would be served from cache
+// must never hide a Put or Delete that happens afterward, for either a
+// linearizable (the default) or a serializable Get.
+func TestKVRangeCacheReflectsSubsequentWrite(t *testing.T) {
+	integration.BeforeTest(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	client := clus.RandClient()
+
+	for _, serializable := range []bool{false, true} {
+		var opts []clientv3.OpOption
+		if serializable {
+			opts = append(opts, clientv3.WithSerializable())
+		}
+
+		_, err := client.Put(t.Context(), "cachekey", "v1")
+		require.NoError(t, err)
+
+		// Repeat the identical read enough times to warm any cache.
+		var lastRev int64
+		for range 5 {
+			resp, err := client.Get(t.Context(), "cachekey", opts...)
+			require.NoError(t, err)
+			require.Len(t, resp.Kvs, 1)
+			require.Equal(t, "v1", string(resp.Kvs[0].Value))
+			require.GreaterOrEqual(t, resp.Header.Revision, lastRev)
+			lastRev = resp.Header.Revision
+		}
+
+		putResp, err := client.Put(t.Context(), "cachekey", "v2")
+		require.NoError(t, err)
+		require.Greater(t, putResp.Header.Revision, lastRev)
+
+		resp, err := client.Get(t.Context(), "cachekey", opts...)
+		require.NoError(t, err)
+		require.Len(t, resp.Kvs, 1)
+		require.Equal(t, "v2", string(resp.Kvs[0].Value), "read after Put must observe the new value, not a cached one")
+		require.GreaterOrEqual(t, resp.Header.Revision, putResp.Header.Revision)
+
+		_, err = client.Delete(t.Context(), "cachekey")
+		require.NoError(t, err)
+
+		resp, err = client.Get(t.Context(), "cachekey", opts...)
+		require.NoError(t, err)
+		require.Empty(t, resp.Kvs, "read after Delete must observe the deletion, not a cached value")
+	}
+}
