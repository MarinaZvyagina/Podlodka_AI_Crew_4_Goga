+// limitations under the License.
+
+package etcdserver
+
+import (
+	"bytes"
+	"sync"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+)
+
+// maxRangeCacheEntries bounds how many distinct range queries are kept
+// cached at once, so a workload that issues many distinct one-off range
+// queries cannot grow the cache without limit. Once the cap is hit, new
+// entries simply aren't cached until room frees up; existing entries keep
+// serving hits.
+const maxRangeCacheEntries = 512
+
+// rangeCacheKey identifies a cacheable Range request: every request field
+// that can change the result set, excluding Revision (only current-revision
+// reads, Revision == 0, are cached; a request pinned to a historical
+// revision bypasses the cache entirely) and Serializable/Linearizable
+// (the caller has already resolved the requested consistency guarantee into
+// "read local state now" by the time the cache is consulted, so a cached
+// entry is equally valid for either).
+type rangeCacheKey struct {
+	key, rangeEnd     string
+	limit             int64
+	sortOrder         pb.RangeRequest_SortOrder
+	sortTarget        pb.RangeRequest_SortTarget
+	keysOnly          bool
+	countOnly         bool
+	minModRevision    int64
+	maxModRevision    int64
+	minCreateRevision int64
+	maxCreateRevision int64
+}
+
+func newRangeCacheKey(r *pb.RangeRequest) rangeCacheKey {
+	return rangeCacheKey{
+		key:               string(r.Key),
+		rangeEnd:          string(r.RangeEnd),
+		limit:             r.Limit,
+		sortOrder:         r.SortOrder,
+		sortTarget:        r.SortTarget,
+		keysOnly:          r.KeysOnly,
+		countOnly:         r.CountOnly,
+		minModRevision:    r.MinModRevision,
+		maxModRevision:    r.MaxModRevision,
+		minCreateRevision: r.MinCreateRevision,
+		maxCreateRevision: r.MaxCreateRevision,
+	}
+}
+
+// rangeCacheEntry is a cached response for the range [key, rangeEnd), kept
+// alongside the store revision it is known to still be accurate for.
+type rangeCacheEntry struct {
+	key, rangeEnd []byte
+
+	rev   int64
+	kvs   []*mvccpb.KeyValue
+	more  bool
+	count int64
+}
+
+// overlaps reports whether a write to k could affect this entry's range, per
+// the same [key, rangeEnd) semantics RangeRequest uses (see mkGteRange):
+// an empty RangeEnd means a single-key request, and a RangeEnd of []byte{0}
+// means "from key to the end of the keyspace".
+func (e *rangeCacheEntry) overlaps(k []byte) bool {
+	if bytes.Compare(k, e.key) < 0 {
+		return false
+	}
+	switch {
+	case len(e.rangeEnd) == 0:
+		return bytes.Equal(k, e.key)
+	case len(e.rangeEnd) == 1 && e.rangeEnd[0] == 0:
+		return true
+	default:
+		return bytes.Compare(k, e.rangeEnd) < 0
+	}
+}
+
+// rangeCache caches RangeResponses for repeated, identical current-revision
+// Range requests. It is kept coherent with writes synchronously: every
+// mutating transaction reports its changed keys and new revision to
+// onCommit before the transaction's mutations become visible to any reader
+// (see cachingTxnWrite.End), so a lookup can never observe an entry that is
+// staler than the data a fresh, uncached read would return at that moment.
+type rangeCache struct {
+	mu      sync.Mutex
+	entries map[rangeCacheKey]*rangeCacheEntry
+}
+
+func newRangeCache() *rangeCache {
+	return &rangeCache{entries: make(map[rangeCacheKey]*rangeCacheEntry)}
+}
+
+// get returns a fresh response built from a cached entry, if one exists for
+// this exact request. The returned response owns its own Header so callers
+// may freely mutate it (e.g. to fill in cluster metadata) without racing
+// with concurrent cache users or with onCommit updating the entry.
+func (c *rangeCache) get(r *pb.RangeRequest) (*pb.RangeResponse, bool) {
+	if r.Revision != 0 {
+		return nil, false
+	}
+	c.mu.Lock()
+	e, ok := c.entries[newRangeCacheKey(r)]
+	if !ok {
+		c.mu.Unlock()
+		return nil, false
+	}
+	resp := &pb.RangeResponse{
+		Header: &pb.ResponseHeader{Revision: e.rev},
+		Kvs:    e.kvs,
+		More:   e.more,
+		Count:  e.count,
+	}
+	c.mu.Unlock()
+	return resp, true
+}
+
+// put caches resp for r, unless r pins a historical revision or the cache is
+// already at capacity.
+func (c *rangeCache) put(r *pb.RangeRequest, resp *pb.RangeResponse) {
+	if r.Revision != 0 {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if len(c.entries) >= maxRangeCacheEntries {
+		return
+	}
+	c.entries[newRangeCacheKey(r)] = &rangeCacheEntry{
+		key:      append([]byte(nil), r.Key...),
+		rangeEnd: append([]byte(nil), r.RangeEnd...),
+		rev:      resp.Header.Revision,
+		kvs:      resp.Kvs,
+		more:     resp.More,
+		count:    resp.Count,
+	}
+}
+
+// onCommit is called synchronously as part of a write transaction's commit,
+// strictly before its mutations become visible to any reader (see
+// cachingTxnWrite.End). Entries whose range contains a changed key are
+// dropped; every surviving entry's tracked revision is advanced to newRev so
+// it keeps accurately reporting the store's current revision even though
+// its data was left untouched by this write.
+func (c *rangeCache) onCommit(newRev int64, changes []*mvccpb.KeyValue) {
+	if len(changes) == 0 {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for k, e := range c.entries {
+		affected := false
+		for _, kv := range changes {
+			if e.overlaps(kv.Key) {
+				affected = true
+				break
+			}
+		}
+		if affected {
+			delete(c.entries, k)
+		} else {
+			e.rev = newRev
+		}
+	}
+}
+
+// reset drops every cached entry. Used when the underlying store is wholly
+// replaced (e.g. restoring from a snapshot), after which no previously
+// cached entry can be assumed accurate.
+func (c *rangeCache) reset() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.entries = make(map[rangeCacheKey]*rangeCacheEntry)
+}
diff --git a/server/etcdserver/range_cache_test.go b/server/etcdserver/range_cache_test.go
new file mode 100644
index 000000000..4dafb1435
--- /dev/null
+++ b/server/etcdserver/range_cache_test.go
@@ -0,0 +1,144 @@
+// Copyright 2025 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
