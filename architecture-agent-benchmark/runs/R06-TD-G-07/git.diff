+package etcdserver
+
+import (
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/storage/backend"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+// cachingKV wraps a WatchableKV so that every write transaction reports its
+// changes to a rangeCache before the transaction commits, keeping the cache
+// used by EtcdServer.Range coherent with the store. All other behavior is
+// delegated unchanged to the wrapped KV.
+type cachingKV struct {
+	mvcc.WatchableKV
+	cache *rangeCache
+}
+
+func newCachingKV(kv mvcc.WatchableKV, cache *rangeCache) mvcc.WatchableKV {
+	return &cachingKV{WatchableKV: kv, cache: cache}
+}
+
+func (c *cachingKV) Write(trace *traceutil.Trace) mvcc.TxnWrite {
+	return &cachingTxnWrite{TxnWrite: c.WatchableKV.Write(trace), cache: c.cache}
+}
+
+// Restore replaces the store wholesale (e.g. installing a snapshot), so no
+// previously cached entry can be assumed to still be accurate.
+func (c *cachingKV) Restore(b backend.Backend) error {
+	c.cache.reset()
+	return c.WatchableKV.Restore(b)
+}
+
+// cachingTxnWrite reports this transaction's changes to a rangeCache before
+// they become visible to any reader, so that no concurrent cache lookup can
+// observe a stale entry once this transaction has committed.
+type cachingTxnWrite struct {
+	mvcc.TxnWrite
+	cache *rangeCache
+}
+
+func (tw *cachingTxnWrite) End() {
+	changes := tw.Changes()
+	if len(changes) != 0 {
+		newRev := tw.TxnWrite.Rev() + 1
+		tw.cache.onCommit(newRev, changes)
+	}
+	tw.TxnWrite.End()
+}
diff --git a/server/etcdserver/range_cache.go b/server/etcdserver/range_cache.go
