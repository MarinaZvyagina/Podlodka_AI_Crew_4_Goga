+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package etcdserver
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+)
+
+func TestRangeCacheHitOnIdenticalRequest(t *testing.T) {
+	c := newRangeCache()
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	resp := &pb.RangeResponse{
+		Header: &pb.ResponseHeader{Revision: 5},
+		Kvs:    []*mvccpb.KeyValue{{Key: []byte("foo"), Value: []byte("bar")}},
+	}
+
+	_, ok := c.get(req)
+	require.False(t, ok, "expected miss before anything is cached")
+
+	c.put(req, resp)
+
+	got, ok := c.get(req)
+	require.True(t, ok, "expected hit for an identical repeated request")
+	assert.Equal(t, resp.Kvs, got.Kvs)
+	assert.Equal(t, int64(5), got.Header.Revision)
+
+	// The response returned by a hit must be a distinct object so that a
+	// caller mutating its Header (as the v3rpc layer does) cannot race with
+	// another concurrent cache user or with onCommit.
+	assert.NotSame(t, resp.Header, got.Header)
+}
+
+func TestRangeCacheMissOnDifferentParams(t *testing.T) {
+	c := newRangeCache()
+	base := &pb.RangeRequest{Key: []byte("foo")}
+	c.put(base, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	variants := []*pb.RangeRequest{
+		{Key: []byte("bar")},
+		{Key: []byte("foo"), RangeEnd: []byte("zzz")},
+		{Key: []byte("foo"), Limit: 10},
+		{Key: []byte("foo"), KeysOnly: true},
+		{Key: []byte("foo"), CountOnly: true},
+		{Key: []byte("foo"), MinModRevision: 3},
+		{Key: []byte("foo"), Revision: 1}, // pinned historical revision: always bypassed
+	}
+	for _, r := range variants {
+		_, ok := c.get(r)
+		assert.False(t, ok, "expected miss for varied request %+v", r)
+	}
+}
+
+func TestRangeCacheBypassesPinnedRevision(t *testing.T) {
+	c := newRangeCache()
+	req := &pb.RangeRequest{Key: []byte("foo"), Revision: 42}
+	c.put(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 42}})
+
+	_, ok := c.get(req)
+	assert.False(t, ok, "requests pinned to a historical revision must never be cached")
+}
+
+func TestRangeCacheInvalidatesOnOverlappingWrite(t *testing.T) {
+	c := newRangeCache()
+	req := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}
+	c.put(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}, Kvs: []*mvccpb.KeyValue{{Key: []byte("m")}}})
+
+	c.onCommit(2, []*mvccpb.KeyValue{{Key: []byte("m")}})
+
+	_, ok := c.get(req)
+	assert.False(t, ok, "a write to a key inside the cached range must invalidate the entry")
+}
+
+func TestRangeCacheSurvivesNonOverlappingWriteAndAdvancesRevision(t *testing.T) {
+	c := newRangeCache()
+	req := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("b")}
+	c.put(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}, Kvs: []*mvccpb.KeyValue{{Key: []byte("a")}}})
+
+	// A write to an unrelated key must not evict the entry, but the store's
+	// revision has still advanced, so the entry must report the new
+	// revision on the next hit -- exactly what an uncached read would
+	// report, since nothing in the cached range changed.
+	c.onCommit(2, []*mvccpb.KeyValue{{Key: []byte("unrelated")}})
+
+	got, ok := c.get(req)
+	require.True(t, ok, "a write outside the cached range must not evict the entry")
+	assert.Equal(t, int64(2), got.Header.Revision)
+}
+
+func TestRangeCacheSingleKeyOverlap(t *testing.T) {
+	e := &rangeCacheEntry{key: []byte("foo")}
+	assert.True(t, e.overlaps([]byte("foo")))
+	assert.False(t, e.overlaps([]byte("foobar")))
+	assert.False(t, e.overlaps([]byte("bar")))
+}
+
+func TestRangeCacheFromKeyOverlap(t *testing.T) {
+	e := &rangeCacheEntry{key: []byte("m"), rangeEnd: []byte{0}}
+	assert.False(t, e.overlaps([]byte("a")))
+	assert.True(t, e.overlaps([]byte("m")))
+	assert.True(t, e.overlaps([]byte("zzzzzz")))
+}
+
+func TestRangeCacheReset(t *testing.T) {
+	c := newRangeCache()
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	c.put(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	c.reset()
+
+	_, ok := c.get(req)
+	assert.False(t, ok, "reset must drop every cached entry")
+}
+
+func TestRangeCacheCapacity(t *testing.T) {
+	c := newRangeCache()
+	for i := range maxRangeCacheEntries {
+		req := &pb.RangeRequest{Key: []byte{byte(i % 256), byte(i / 256)}}
+		c.put(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+	}
+
+	overflow := &pb.RangeRequest{Key: []byte("overflow")}
+	c.put(overflow, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	_, ok := c.get(overflow)
+	assert.False(t, ok, "the cache must not grow past its capacity")
+}
diff --git a/server/etcdserver/server.go b/server/etcdserver/server.go
index ac782a8a4..f5e41f56d 100644
--- a/server/etcdserver/server.go
+++ b/server/etcdserver/server.go
@@ -252,6 +252,7 @@ type EtcdServer struct {
 	applyWait wait.WaitTime
 
 	kv         mvcc.WatchableKV
+	rangeCache *rangeCache
 	lessor     lease.Lessor
 	bemu       sync.RWMutex
 	be         backend.Backend
@@ -367,7 +368,12 @@ func NewServer(cfg config.ServerConfig) (srv *EtcdServer, err error) {
 		CompactionBatchLimit:    cfg.CompactionBatchLimit,
 		CompactionSleepInterval: cfg.CompactionSleepInterval,
 	}
-	srv.kv = mvcc.New(srv.Logger(), srv.be, srv.lessor, mvccStoreConfig)
+	srv.rangeCache = newRangeCache()
+	srv.kv = newCachingKV(mvcc.New(srv.Logger(), srv.be, srv.lessor, mvccStoreConfig), srv.rangeCache)
+	// mvcc.New wires the lessor's deleter to its own, undecorated store;
+	// repoint it at the caching KV so lease-expiry deletes also invalidate
+	// the range cache.
+	srv.lessor.SetRangeDeleter(func() lease.TxnDelete { return srv.kv.Write(traceutil.TODO()) })
 	srv.corruptionChecker = newCorruptionChecker(cfg.Logger, srv, srv.kv.HashStorage())
 
 	srv.authStore = auth.NewAuthStore(srv.Logger(), schema.NewAuthBackend(srv.Logger(), srv.be), tp, int(cfg.BcryptCost))
diff --git a/server/etcdserver/v3_server.go b/server/etcdserver/v3_server.go
