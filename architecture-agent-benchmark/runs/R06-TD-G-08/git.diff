+func TestReadCacheKeysOnlyAndFullReadDoNotShareCorruptedState(t *testing.T) {
+	// Regression test for the pb.RangeRequest-level KeysOnly behavior: two
+	// requests that both end up with FastKeysOnly=false at the mvcc layer
+	// (one because KeysOnly is unset, one because KeysOnly=true but
+	// SortTarget=VALUE forces FastKeysOnly off) must not let one request's
+	// in-place Value-nil'ing corrupt the other's data via a shared cache
+	// entry.
+	kv := newTestReadCacheKV(t)
+	mustPut(t, kv, "foo", "bar")
+
+	ro := RangeOptions{FastKeysOnly: false}
+	rrFull := rangeOnce(t, kv, []byte("foo"), nil, ro)
+	rrFull.KVs[0].Value = nil // mimic pb.RangeRequest{KeysOnly:true,SortTarget:VALUE} post-processing
+
+	rrAgain := rangeOnce(t, kv, []byte("foo"), nil, ro)
+	if len(rrAgain.KVs) != 1 || string(rrAgain.KVs[0].Value) != "bar" {
+		t.Fatalf("cached entry corrupted across callers: %+v", rrAgain)
+	}
+}
