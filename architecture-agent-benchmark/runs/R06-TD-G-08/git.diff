+func TestReadCacheDistinguishesPointFromOpenEndedRange(t *testing.T) {
+	kv := newTestReadCacheKV(t)
+	mustPut(t, kv, "foo", "v1")
+
+	rangeOnce(t, kv, []byte("foo"), nil, RangeOptions{})      // point get
+	rangeOnce(t, kv, []byte("foo"), []byte{}, RangeOptions{}) // ">= foo"
+
+	if got := len(cacheOf(kv).entries); got != 2 {
+		t.Fatalf("expected point-get and open-ended range to be cached separately, got %d entries", got)
+	}
+}
