+func TestReadCacheWiredIntoServerRangePath(t *testing.T) {
+	// Sanity check that the cache key derivation lines up with what
+	// server/etcdserver/txn.Range actually passes through: RangeRequest
+	// fields not carried by RangeOptions (sort target/order, filters) are
+	// applied by the caller on top of the (possibly cached) RangeResult, so
+	// only the RangeOptions-relevant fields should affect cacheability.
+	r := &pb.RangeRequest{Key: []byte("foo"), Limit: 10}
+	ro := RangeOptions{Limit: r.Limit}
+	ck1 := newCacheKey(r.Key, nil, ro)
+	ck2 := newCacheKey([]byte("foo"), nil, RangeOptions{Limit: 10})
+	if ck1 != ck2 {
+		t.Fatalf("expected identical cache keys for identical range options, got %+v vs %+v", ck1, ck2)
+	}
+}
