+package cache
+
+import (
+	"errors"
+	"testing"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestCacheAddGet(t *testing.T) {
+	c := NewCache(DefaultMaxEntries)
+	req := &pb.RangeRequest{Key: []byte("foo"), Serializable: true}
+	resp := &pb.RangeResponse{}
+
+	token := c.StartRead(req)
+	c.Add(token, req, resp)
+
+	got, err := c.Get(req)
+	if err != nil {
+		t.Fatalf("expected cache hit, got error: %v", err)
+	}
+	if got != resp {
+		t.Fatalf("expected cached response to be returned")
+	}
+}
+
+func TestCacheInvalidateEvictsExistingEntry(t *testing.T) {
+	c := NewCache(DefaultMaxEntries)
+	req := &pb.RangeRequest{Key: []byte("foo"), Serializable: true}
+	resp := &pb.RangeResponse{}
+
+	token := c.StartRead(req)
+	c.Add(token, req, resp)
+
+	c.Invalidate([]byte("foo"), nil)
+
+	if _, err := c.Get(req); err == nil {
+		t.Fatalf("expected cache miss after invalidate")
+	}
+}
+
+// TestCacheRaceBetweenReadAndWrite ensures that a write which is invalidated
+// while a read for the same range is still in flight is not silently lost:
+// without tracking in-flight reads, the write's Invalidate call would find
+// nothing to evict (the read hasn't been cached yet) and the read would go
+// on to cache an already-stale response with no future trigger to remove it.
+func TestCacheRaceBetweenReadAndWrite(t *testing.T) {
+	c := NewCache(DefaultMaxEntries)
+	req := &pb.RangeRequest{Key: []byte("foo"), Serializable: true}
+	staleResp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}
+
+	// Simulate a read that started (e.g. fetching from the backend) before
+	// a concurrent write to the same key was applied and invalidated.
+	token := c.StartRead(req)
+
+	// The concurrent write happens and invalidates the range; at this
+	// point nothing is cached yet, so this is a no-op against the lru, but
+	// it must still mark the in-flight read as dirty.
+	c.Invalidate([]byte("foo"), nil)
+
+	// The read completes and tries to cache its now-stale response.
+	c.Add(token, req, staleResp)
+
+	if _, err := c.Get(req); err == nil {
+		t.Fatalf("expected stale response raced by a concurrent write to not be cached")
+	}
+}
+
+func TestCacheAbortReleasesInFlightRead(t *testing.T) {
+	c := NewCache(DefaultMaxEntries)
+	req := &pb.RangeRequest{Key: []byte("foo"), Serializable: true}
+
+	token := c.StartRead(req)
+	c.Abort(token)
+
+	// A later write to the same range should not find any stale
+	// bookkeeping left behind by the aborted read.
+	c.Invalidate([]byte("foo"), nil)
+
+	resp := &pb.RangeResponse{}
+	token2 := c.StartRead(req)
+	c.Add(token2, req, resp)
+
+	got, err := c.Get(req)
+	if err != nil {
+		t.Fatalf("expected cache hit after unrelated aborted read, got error: %v", err)
+	}
+	if got != resp {
+		t.Fatalf("expected cached response to be returned")
+	}
+}
+
+func TestCacheCompactedRevision(t *testing.T) {
+	c := NewCache(DefaultMaxEntries)
+	req := &pb.RangeRequest{Key: []byte("foo"), Revision: 5}
+	resp := &pb.RangeResponse{}
+
+	token := c.StartRead(req)
+	c.Add(token, req, resp)
+
+	c.Compact(10)
+
+	_, err := c.Get(req)
+	if !errors.Is(err, ErrCompacted) {
+		t.Fatalf("expected ErrCompacted, got %v", err)
+	}
+}
