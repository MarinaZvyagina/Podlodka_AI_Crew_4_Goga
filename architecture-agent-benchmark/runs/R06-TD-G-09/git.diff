+// StartRead registers req's key range as in-flight. See the Cache interface for details.
+func (c *cache) StartRead(req *pb.RangeRequest) uint64 {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	// a request pinned to a historical revision is immutable and can never
+	// be invalidated, so it does not need in-flight tracking.
+	if req.Revision != 0 {
+		return 0
+	}
+
+	c.nextToken++
+	token := c.nextToken
+
+	ivl := rangeInterval(req.Key, req.RangeEnd)
+	c.pendingIvl[token] = ivl
+	if iv := c.pendingRanges.Find(ivl); iv == nil {
+		c.pendingRanges.Insert(ivl, map[uint64]struct{}{token: {}})
+	} else {
+		val := iv.Val.(map[uint64]struct{})
+		val[token] = struct{}{}
+		iv.Val = val
+	}
+	return token
+}
