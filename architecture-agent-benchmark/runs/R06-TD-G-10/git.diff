+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package apply
+
+import (
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/etcdserver/txn"
+)
+
+// rangeCacheInvalidatingApplierV3 evicts a shared RangeCache's entries for
+// whatever a write is about to touch, before executing it, so that once the
+// write becomes visible no cached response can still be describing the data
+// it just replaced.
+//
+// This wraps applierV3Backend directly (see newApplierV3) rather than living
+// in the v3rpc gRPC layer, because this Apply path is the one place every
+// member runs for every committed request regardless of which member the
+// client's original request landed on: a Put proposed through member A is
+// applied here on member B too when B replays the raft log, which a decorator
+// sitting only in front of member B's own gRPC KV service would never see.
+type rangeCacheInvalidatingApplierV3 struct {
+	applierV3
+	cache *txn.RangeCache
+}
+
+func newRangeCacheInvalidatingApplierV3(cache *txn.RangeCache, app applierV3) applierV3 {
+	return &rangeCacheInvalidatingApplierV3{app, cache}
+}
+
+func (a *rangeCacheInvalidatingApplierV3) Put(p *pb.PutRequest) (*pb.PutResponse, *traceutil.Trace, error) {
+	a.cache.Invalidate(p.Key, nil)
+	return a.applierV3.Put(p)
+}
+
+func (a *rangeCacheInvalidatingApplierV3) DeleteRange(dr *pb.DeleteRangeRequest) (*pb.DeleteRangeResponse, *traceutil.Trace, error) {
+	a.cache.Invalidate(dr.Key, dr.RangeEnd)
+	return a.applierV3.DeleteRange(dr)
+}
+
+func (a *rangeCacheInvalidatingApplierV3) Txn(rt *pb.TxnRequest, skipRangeExecution bool) (*pb.TxnResponse, *traceutil.Trace, error) {
+	// Which branch runs depends on comparisons evaluated during execution, so
+	// both branches are invalidated unconditionally before execution: whichever
+	// Put/DeleteRange ends up applied can then never be applied without first
+	// clearing whatever cached response it's about to invalidate.
+	invalidateTxnWrites(a.cache, rt.Success)
+	invalidateTxnWrites(a.cache, rt.Failure)
+	return a.applierV3.Txn(rt, skipRangeExecution)
+}
+
+func (a *rangeCacheInvalidatingApplierV3) LeaseRevoke(lc *pb.LeaseRevokeRequest) (*pb.LeaseRevokeResponse, error) {
+	// A revoked lease deletes every key attached to it, a set this layer
+	// doesn't have cheap access to; invalidate broadly rather than asking the
+	// lessor to enumerate them.
+	a.cache.Reset()
+	return a.applierV3.LeaseRevoke(lc)
+}
+
+// invalidateTxnWrites evicts RangeCache entries for every Put/DeleteRange in
+// reqs, recursing into nested Txns.
+func invalidateTxnWrites(cache *txn.RangeCache, reqs []*pb.RequestOp) {
+	for _, req := range reqs {
+		switch tv := req.Request.(type) {
+		case *pb.RequestOp_RequestPut:
+			if tv.RequestPut != nil {
+				cache.Invalidate(tv.RequestPut.Key, nil)
+			}
+		case *pb.RequestOp_RequestDeleteRange:
+			if tv.RequestDeleteRange != nil {
+				cache.Invalidate(tv.RequestDeleteRange.Key, tv.RequestDeleteRange.RangeEnd)
+			}
+		case *pb.RequestOp_RequestTxn:
+			if tv.RequestTxn != nil {
+				invalidateTxnWrites(cache, tv.RequestTxn.Success)
+				invalidateTxnWrites(cache, tv.RequestTxn.Failure)
+			}
+		}
+	}
+}
