+
+// fakeReadView reports a fixed store revision, standing in for the KV store's
+// ReadView when exercising RangeCache in isolation.
+type fakeReadView struct{ rev int64 }
+
+func (f fakeReadView) FirstRev() int64 { return 1 }
+func (f fakeReadView) Rev() int64      { return f.rev }
+func (f fakeReadView) Range(context.Context, []byte, []byte, mvcc.RangeOptions) (*mvcc.RangeResult, error) {
+	panic("not used by RangeCache")
+}
+
+func rangeReq(key, end string) *pb.RangeRequest {
+	r := &pb.RangeRequest{Key: []byte(key)}
+	if end != "" {
+		r.RangeEnd = []byte(end)
+	}
+	return r
+}
+
+func rangeResp(rev int64, keys ...string) *pb.RangeResponse {
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: rev}}
+	for _, k := range keys {
+		resp.Kvs = append(resp.Kvs, &mvccpb.KeyValue{Key: []byte(k)})
+	}
+	return resp
+}
+
+func TestRangeCacheHitAndMiss(t *testing.T) {
+	c := NewRangeCache(16)
+	req := rangeReq("a", "")
+	resp := rangeResp(5, "a")
+
+	if _, ok := c.Get(req); ok {
+		t.Fatalf("expected miss before Put")
+	}
+
+	c.Put(fakeReadView{rev: 5}, req, resp)
+
+	got, ok := c.Get(req)
+	if !ok {
+		t.Fatalf("expected hit after Put")
+	}
+	if got.Header.Revision != 5 || len(got.Kvs) != 1 {
+		t.Fatalf("unexpected cached response: %+v", got)
+	}
+
+	// The returned response must be an independent copy: mutating it (as the
+	// gRPC layer does when it fills in header fields) must not corrupt what's
+	// cached for the next caller.
+	got.Header.Revision = 999
+	got2, ok := c.Get(req)
+	if !ok || got2.Header.Revision != 5 {
+		t.Fatalf("cache entry was mutated through a returned copy: %+v", got2)
+	}
+}
+
+func TestRangeCacheDifferentParamsMiss(t *testing.T) {
+	c := NewRangeCache(16)
+	c.Put(fakeReadView{rev: 5}, rangeReq("a", ""), rangeResp(5, "a"))
+
+	if _, ok := c.Get(rangeReq("b", "")); ok {
+		t.Fatalf("expected miss for a different key")
+	}
+	if _, ok := c.Get(rangeReq("a", "z")); ok {
+		t.Fatalf("expected miss for a different range end")
+	}
+
+	countOnly := rangeReq("a", "")
+	countOnly.CountOnly = true
+	if _, ok := c.Get(countOnly); ok {
+		t.Fatalf("expected miss for different options on the same key")
+	}
+}
+
+func TestRangeCacheSerializableAndLinearizableShareEntry(t *testing.T) {
+	c := NewRangeCache(16)
+	write := rangeReq("a", "")
+	write.Serializable = false
+	c.Put(fakeReadView{rev: 5}, write, rangeResp(5, "a"))
+
+	read := rangeReq("a", "")
+	read.Serializable = true
+	if _, ok := c.Get(read); !ok {
+		t.Fatalf("expected a serializable request to hit an entry cached from a linearizable one")
+	}
+}
+
+func TestRangeCacheSkipsHistoricalRevision(t *testing.T) {
+	c := NewRangeCache(16)
+	req := rangeReq("a", "")
+	req.Revision = 3
+	c.Put(fakeReadView{rev: 5}, req, rangeResp(3, "a"))
+
+	if _, ok := c.Get(req); ok {
+		t.Fatalf("expected a fixed-revision request never to be cached")
+	}
+}
+
+func TestRangeCachePutRejectsRaceWithConcurrentWrite(t *testing.T) {
+	c := NewRangeCache(16)
+	req := rangeReq("a", "")
+	resp := rangeResp(5, "a")
+
+	// The store has already moved past the revision resp was read at: some
+	// other write landed while this response was in flight, so caching it now
+	// would hand out a stale answer with nothing left to evict it.
+	c.Put(fakeReadView{rev: 6}, req, resp)
+
+	if _, ok := c.Get(req); ok {
+		t.Fatalf("expected Put to reject a response that raced with a concurrent write")
+	}
+}
+
+func TestRangeCacheInvalidateEvictsOverlappingEntries(t *testing.T) {
+	c := NewRangeCache(16)
+	single := rangeReq("b", "")
+	rangeQ := rangeReq("a", "c")
+	unrelated := rangeReq("z", "")
+
+	c.Put(fakeReadView{rev: 5}, single, rangeResp(5, "b"))
+	c.Put(fakeReadView{rev: 5}, rangeQ, rangeResp(5, "a", "b"))
+	c.Put(fakeReadView{rev: 5}, unrelated, rangeResp(5, "z"))
+
+	c.Invalidate([]byte("b"), nil)
+
+	if _, ok := c.Get(single); ok {
+		t.Fatalf("expected the single-key entry to be invalidated")
+	}
+	if _, ok := c.Get(rangeQ); ok {
+		t.Fatalf("expected the overlapping range entry to be invalidated")
+	}
+	if _, ok := c.Get(unrelated); !ok {
+		t.Fatalf("expected an unrelated key's entry to survive invalidation")
+	}
+}
+
+func TestRangeCacheReset(t *testing.T) {
+	c := NewRangeCache(16)
+	req := rangeReq("a", "")
+	c.Put(fakeReadView{rev: 5}, req, rangeResp(5, "a"))
+
+	c.Reset()
+
+	if _, ok := c.Get(req); ok {
+		t.Fatalf("expected Reset to evict every entry")
+	}
+
+	// Reset must leave the cache usable afterwards.
+	c.Put(fakeReadView{rev: 5}, req, rangeResp(5, "a"))
+	if _, ok := c.Get(req); !ok {
+		t.Fatalf("expected the cache to accept entries again after Reset")
+	}
+}
+
+func TestRangeCacheNilReceiverIsNoOp(t *testing.T) {
+	var c *RangeCache
+	if _, ok := c.Get(rangeReq("a", "")); ok {
+		t.Fatalf("expected a nil RangeCache to always miss")
+	}
+	c.Put(fakeReadView{rev: 5}, rangeReq("a", ""), rangeResp(5, "a"))
+	c.Invalidate([]byte("a"), nil)
+	c.Reset()
+}
