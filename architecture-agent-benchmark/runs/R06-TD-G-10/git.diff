+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package txn
+
+import (
+	"sync"
+
+	"google.golang.org/protobuf/proto"
+	"k8s.io/utils/lru"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/pkg/v3/adt"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+// DefaultRangeCacheSize bounds how many distinct Range requests a RangeCache
+// remembers at once.
+var DefaultRangeCacheSize = 2048
+
+// RangeCache memoizes RangeResponses for repeated Range requests that ask for
+// the current revision (Revision == 0). Unlike a time-based cache, an entry is
+// evicted the instant a write lands on a key range that could have affected
+// it (see Invalidate/Reset) rather than after some fixed delay, so a cache hit
+// is always exactly as fresh as re-running the read would have been.
+type RangeCache struct {
+	mu         sync.Mutex
+	maxEntries int
+	lru        *lru.Cache
+	// affected indexes cached entries by the key range their request covers,
+	// so a write touching part of that range can find and evict them.
+	affected adt.IntervalTree
+}
+
+// NewRangeCache builds a RangeCache holding at most maxEntries responses.
+func NewRangeCache(maxEntries int) *RangeCache {
+	c := &RangeCache{maxEntries: maxEntries}
+	c.Reset()
+	return c
+}
+
+// Get returns a previously cached response for an equivalent request, if one
+// is still on file.
+func (c *RangeCache) Get(r *pb.RangeRequest) (*pb.RangeResponse, bool) {
+	if c == nil || !cacheableRangeRequest(r) {
+		return nil, false
+	}
+	key := rangeCacheKey(r)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	v, ok := c.lru.Get(key)
+	if !ok {
+		return nil, false
+	}
+	return proto.Clone(v.(*pb.RangeResponse)).(*pb.RangeResponse), true
+}
+
+// Put remembers resp as the answer for future requests equivalent to r. If a
+// write has already landed since resp was read (rv no longer reports the
+// revision resp was read at), Put does nothing: caching resp now would risk
+// handing out a stale answer with no later write left to invalidate it.
+func (c *RangeCache) Put(rv mvcc.ReadView, r *pb.RangeRequest, resp *pb.RangeResponse) {
+	if c == nil || !cacheableRangeRequest(r) || resp == nil || resp.Header == nil {
+		return
+	}
+	key := rangeCacheKey(r)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if rv.Rev() != resp.Header.Revision {
+		return
+	}
+
+	c.lru.Add(key, proto.Clone(resp).(*pb.RangeResponse))
+
+	ivl := rangeInterval(r.Key, r.RangeEnd)
+	if iv := c.affected.Find(ivl); iv != nil {
+		iv.Val.(map[string]struct{})[key] = struct{}{}
+	} else {
+		c.affected.Insert(ivl, map[string]struct{}{key: {}})
+	}
+}
+
+// Invalidate evicts every cached response whose requested range intersects
+// [key, end). Pass a nil end to invalidate a single key.
+func (c *RangeCache) Invalidate(key, end []byte) {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	ivl := rangeInterval(key, end)
+	for _, iv := range c.affected.Stab(ivl) {
+		for k := range iv.Val.(map[string]struct{}) {
+			c.lru.Remove(k)
+		}
+	}
+	// Deletion happens after the lookup above since it mutates the tree
+	// the Stab traversal is walking.
+	c.affected.Delete(ivl)
+}
+
+// Reset evicts every cached response, e.g. because the set of keys a write
+// touched isn't cheaply known (a lease revocation) or the store it mirrors
+// was replaced wholesale (a snapshot restore).
+func (c *RangeCache) Reset() {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.lru = lru.New(c.maxEntries)
+	c.affected = adt.NewIntervalTree()
+}
+
+func cacheableRangeRequest(r *pb.RangeRequest) bool {
+	// A request pinned to a historical revision is immutable, but caching it
+	// is left for another day: it would need its own compaction-aware
+	// invalidation instead of piggy-backing on writes.
+	return r.Revision == 0
+}
+
+// rangeCacheKey normalizes a request so that a serializable and a
+// linearizable request for the same range, with the same options, share a
+// cache entry: by the time the cache is consulted, the linearizable read
+// barrier (if any) has already run, so the two only differ in how they got
+// here, not in what they should return.
+func rangeCacheKey(r *pb.RangeRequest) string {
+	norm := proto.Clone(r).(*pb.RangeRequest)
+	norm.Serializable = true
+	b, err := proto.Marshal(norm)
+	if err != nil {
+		panic(err)
+	}
+	return string(b)
+}
+
+func rangeInterval(key, end []byte) adt.Interval {
+	if len(end) == 0 {
+		return adt.NewBytesAffinePoint(key)
+	}
+	return adt.NewBytesAffineInterval(key, end)
+}
