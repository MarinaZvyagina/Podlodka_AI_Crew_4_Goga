+
+package apply
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+	"golang.org/x/crypto/bcrypt"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+	"go.etcd.io/etcd/server/v3/etcdserver/api/membership"
+	"go.etcd.io/etcd/server/v3/etcdserver/api/v3alarm"
+	"go.etcd.io/etcd/server/v3/etcdserver/cindex"
+	"go.etcd.io/etcd/server/v3/etcdserver/txn"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+	"go.etcd.io/etcd/server/v3/storage/schema"
+)
+
+func uberApplierWithRangeCache(t *testing.T) (UberApplier, *txn.RangeCache, mvcc.WatchableKV) {
+	lg := zaptest.NewLogger(t)
+	be, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() {
+		betesting.Close(t, be)
+	})
+
+	cluster := membership.NewCluster(lg)
+	cluster.SetBackend(schema.NewMembershipBackend(lg, be))
+	cluster.AddMember(&membership.Member{ID: memberID}, true)
+	lessor := lease.NewLessor(lg, be, cluster, lease.LessorConfig{})
+	kv := mvcc.New(lg, be, lessor, mvcc.StoreConfig{})
+	alarmStore, err := v3alarm.NewAlarmStore(lg, schema.NewAlarmBackend(lg, be))
+	require.NoError(t, err)
+
+	tp, err := auth.NewTokenProvider(lg, "simple", dummyIndexWaiter, 300*time.Second)
+	require.NoError(t, err)
+	authStore := auth.NewAuthStore(lg, schema.NewAuthBackend(lg, be), tp, bcrypt.DefaultCost)
+	consistentIndex := cindex.NewConsistentIndex(be)
+	cache := txn.NewRangeCache(16)
+	opts := ApplierOptions{
+		Logger:                       lg,
+		KV:                           kv,
+		AlarmStore:                   alarmStore,
+		AuthStore:                    authStore,
+		Lessor:                       lessor,
+		Cluster:                      cluster,
+		RaftStatus:                   &fakeRaftStatusGetter{},
+		SnapshotServer:               &fakeSnapshotServer{},
+		ConsistentIndex:              consistentIndex,
+		TxnModeWriteWithSharedBuffer: false,
+		Backend:                      be,
+		QuotaBackendBytesCfg:         16 * 1024 * 1024, // 16MB
+		WarningApplyDuration:         time.Hour,
+		RangeCache:                   cache,
+	}
+	return NewUberApplier(opts), cache, kv
+}
+
+func rangeReq(key string) *pb.RangeRequest { return &pb.RangeRequest{Key: []byte(key)} }
+
+func rangeResp(rev int64) *pb.RangeResponse {
+	return &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: rev}}
+}
+
+// TestUberApplier_RangeCache_InvalidatesOnPut verifies that a Put applied
+// through the uber applier evicts any RangeCache entry for the key it wrote,
+// exercising the same decorator chain a raft-committed entry goes through on
+// every member (not just the one a client's write RPC happened to land on).
+func TestUberApplier_RangeCache_InvalidatesOnPut(t *testing.T) {
+	ua, cache, kv := uberApplierWithRangeCache(t)
+
+	req := rangeReq("foo")
+	cache.Put(kv, req, rangeResp(kv.Rev()))
+	_, ok := cache.Get(req)
+	require.True(t, ok, "expected the seeded entry to be cached")
+
+	result := ua.Apply(&InternalRaftRequestWrapper{InternalRaftRequest: &pb.InternalRaftRequest{
+		Put: &pb.PutRequest{Key: []byte("foo"), Value: []byte("bar")},
+	}}, membership.ApplyBoth)
+	require.NoError(t, result.Err)
+
+	_, ok = cache.Get(req)
+	require.False(t, ok, "expected the Put to evict the cached entry for the key it wrote")
+}
+
+// TestUberApplier_RangeCache_InvalidatesOnDeleteRange verifies DeleteRange
+// evicts overlapping RangeCache entries, including ones for a wider range
+// than the deleted keys.
+func TestUberApplier_RangeCache_InvalidatesOnDeleteRange(t *testing.T) {
+	ua, cache, kv := uberApplierWithRangeCache(t)
+
+	wideReq := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}
+	cache.Put(kv, wideReq, rangeResp(kv.Rev()))
+	_, ok := cache.Get(wideReq)
+	require.True(t, ok)
+
+	result := ua.Apply(&InternalRaftRequestWrapper{InternalRaftRequest: &pb.InternalRaftRequest{
+		DeleteRange: &pb.DeleteRangeRequest{Key: []byte("foo")},
+	}}, membership.ApplyBoth)
+	require.NoError(t, result.Err)
+
+	_, ok = cache.Get(wideReq)
+	require.False(t, ok, "expected the DeleteRange to evict the overlapping cached range")
+}
+
+// TestUberApplier_RangeCache_InvalidatesOnTxn verifies a Txn evicts RangeCache
+// entries for keys in whichever branch actually runs.
+func TestUberApplier_RangeCache_InvalidatesOnTxn(t *testing.T) {
+	ua, cache, kv := uberApplierWithRangeCache(t)
+
+	successReq := rangeReq("success-key")
+	failureReq := rangeReq("failure-key")
+	cache.Put(kv, successReq, rangeResp(kv.Rev()))
+	cache.Put(kv, failureReq, rangeResp(kv.Rev()))
+
+	// Compare fails (the key doesn't exist yet), so the Failure branch runs.
+	result := ua.Apply(&InternalRaftRequestWrapper{InternalRaftRequest: &pb.InternalRaftRequest{
+		Txn: &pb.TxnRequest{
+			Compare: []*pb.Compare{{
+				Key:         []byte("missing"),
+				Target:      pb.Compare_VERSION,
+				Result:      pb.Compare_EQUAL,
+				TargetUnion: &pb.Compare_Version{Version: 1},
+			}},
+			Success: []*pb.RequestOp{{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{
+				Key: []byte("success-key"), Value: []byte("v"),
+			}}}},
+			Failure: []*pb.RequestOp{{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{
+				Key: []byte("failure-key"), Value: []byte("v"),
+			}}}},
+		},
+	}}, membership.ApplyBoth)
+	require.NoError(t, result.Err)
+
+	_, ok := cache.Get(failureReq)
+	require.False(t, ok, "expected the taken Failure branch's write to evict its cached entry")
+}
+
+// TestUberApplier_RangeCache_LeaseRevokeClearsCache verifies a lease
+// revocation clears the whole cache, since the keys it deletes aren't known
+// to this layer.
+func TestUberApplier_RangeCache_LeaseRevokeClearsCache(t *testing.T) {
+	ua, cache, kv := uberApplierWithRangeCache(t)
+
+	unrelated := rangeReq("unrelated-key")
+	cache.Put(kv, unrelated, rangeResp(kv.Rev()))
+
+	grantResult := ua.Apply(&InternalRaftRequestWrapper{InternalRaftRequest: &pb.InternalRaftRequest{
+		LeaseGrant: &pb.LeaseGrantRequest{ID: 7, TTL: 100},
+	}}, membership.ApplyBoth)
+	require.NoError(t, grantResult.Err)
+	_, ok := grantResult.Resp.(*pb.LeaseGrantResponse)
+	require.True(t, ok)
+
+	result := ua.Apply(&InternalRaftRequestWrapper{InternalRaftRequest: &pb.InternalRaftRequest{
+		LeaseRevoke: &pb.LeaseRevokeRequest{ID: 7},
+	}}, membership.ApplyBoth)
+	require.NoError(t, result.Err)
+
+	_, ok = cache.Get(unrelated)
+	require.False(t, ok, "expected a lease revocation to clear the whole cache")
+}
