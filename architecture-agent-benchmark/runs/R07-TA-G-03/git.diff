diff --git a/data/src/test/java/mihon/data/extension/repository/ExtensionStoreRepositoryImplTest.kt b/data/src/test/java/mihon/data/extension/repository/ExtensionStoreRepositoryImplTest.kt
new file mode 100644
index 0000000..275a6a6
--- /dev/null
+++ b/data/src/test/java/mihon/data/extension/repository/ExtensionStoreRepositoryImplTest.kt
@@ -0,0 +1,59 @@
+package mihon.data.extension.repository
+
+import io.kotest.matchers.shouldBe
+import io.mockk.coEvery
+import io.mockk.coVerify
+import io.mockk.mockk
+import kotlinx.coroutines.test.runTest
+import mihon.data.extension.service.ExtensionStoreService
+import mihon.domain.extension.model.ExtensionStore
+import mihon.domain.extension.model.InvalidExtensionStoreUrlException
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.params.ParameterizedTest
+import org.junit.jupiter.params.provider.ValueSource
+import tachiyomi.data.Database
+
+class ExtensionStoreRepositoryImplTest {
+
+    private lateinit var service: ExtensionStoreService
+    private lateinit var database: Database
+    private lateinit var repository: ExtensionStoreRepositoryImpl
+
+    @BeforeEach
+    fun beforeEach() {
+        service = mockk()
+        database = mockk(relaxed = true)
+        repository = ExtensionStoreRepositoryImpl(service, database)
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = ["", "not a url", "example.com", "ftp://example.com", "mihon://add-repo"])
+    fun `insert rejects invalid urls without contacting the network`(indexUrl: String) = runTest {
+        val result = repository.insert(indexUrl)
+
+        result.isFailure shouldBe true
+        (result.exceptionOrNull() is InvalidExtensionStoreUrlException) shouldBe true
+        coVerify(exactly = 0) { service.fetch(any()) }
+    }
+
+    @Test
+    fun `insert fetches the store for a valid http url`() = runTest {
+        val indexUrl = "https://example.com/index.min.json"
+        val store = ExtensionStore(
+            indexUrl = indexUrl,
+            name = "Test store",
+            badgeLabel = "Test",
+            signingKey = "key",
+            contact = ExtensionStore.Contact(website = indexUrl, discord = null),
+            isLegacy = false,
+            extensionListUrl = null,
+        )
+        coEvery { service.fetch(indexUrl) } returns Result.success(store)
+
+        val result = repository.insert(indexUrl)
+
+        result.isSuccess shouldBe true
+        coVerify(exactly = 1) { service.fetch(indexUrl) }
+    }
+}
