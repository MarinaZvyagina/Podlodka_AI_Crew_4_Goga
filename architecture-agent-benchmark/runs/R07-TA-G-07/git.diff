+package mihon.domain.extension.interactor
+
+import io.kotest.matchers.shouldBe
+import io.mockk.coEvery
+import io.mockk.coVerify
+import io.mockk.mockk
+import kotlinx.coroutines.test.runTest
+import mihon.domain.extension.repository.ExtensionStoreRepository
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.params.ParameterizedTest
+import org.junit.jupiter.params.provider.ValueSource
+
+class AddExtensionStoreTest {
+
+    private lateinit var repository: ExtensionStoreRepository
+    private lateinit var addExtensionStore: AddExtensionStore
+
+    @BeforeEach
+    fun beforeEach() {
+        repository = mockk()
+        addExtensionStore = AddExtensionStore(repository)
+    }
+
+    @ParameterizedTest
+    @ValueSource(
+        strings = [
+            "",
+            " ",
+            "not a url",
+            "example.com",
+            "ftp://example.com/repo.json",
+            "http://",
+            "https://",
+        ],
+    )
+    fun `Rejects invalid repository urls without hitting the repository`(indexUrl: String) = runTest {
+        val result = addExtensionStore(indexUrl)
+
+        result.isFailure shouldBe true
+        coVerify(exactly = 0) { repository.insert(any()) }
+    }
+
+    @Test
+    fun `Delegates valid http urls to the repository`() = runTest {
+        coEvery { repository.insert("http://example.com/index.min.json") } returns Result.success(Unit)
+
+        val result = addExtensionStore("http://example.com/index.min.json")
+
+        result.isSuccess shouldBe true
+        coVerify(exactly = 1) { repository.insert("http://example.com/index.min.json") }
+    }
+
+    @Test
+    fun `Delegates valid https urls to the repository`() = runTest {
+        coEvery { repository.insert("https://example.com/index.min.json") } returns Result.success(Unit)
+
+        val result = addExtensionStore("https://example.com/index.min.json")
+
+        result.isSuccess shouldBe true
+        coVerify(exactly = 1) { repository.insert("https://example.com/index.min.json") }
+    }
+}
