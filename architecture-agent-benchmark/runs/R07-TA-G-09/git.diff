--- /dev/null
+++ b/domain/src/main/java/mihon/domain/extension/model/ExtensionStoreUrlValidator.kt
@@ -0,0 +1,25 @@
+package mihon.domain.extension.model
+
+import java.net.URI
+import java.net.URISyntaxException
+
+private val ALLOWED_SCHEMES = setOf("http", "https")
+
+/**
+ * Syntactic check for whether [url] could plausibly be an extension store index URL.
+ *
+ * This only verifies the URL is a well-formed http(s) URL with a host; it does not
+ * verify that the URL is reachable or actually points at a valid store index.
+ */
+fun isValidExtensionStoreUrl(url: String): Boolean {
+    val trimmed = url.trim()
+    if (trimmed.isEmpty()) return false
+
+    val uri = try {
+        URI(trimmed)
+    } catch (_: URISyntaxException) {
+        return false
+    }
+
+    return uri.scheme?.lowercase() in ALLOWED_SCHEMES && !uri.host.isNullOrBlank()
+}
diff --git a/domain/src/test/java/mihon/domain/extension/model/ExtensionStoreUrlValidatorTest.kt b/domain/src/test/java/mihon/domain/extension/model/ExtensionStoreUrlValidatorTest.kt
new file mode 100644
index 0000000..1f47de4
--- /dev/null
+++ b/domain/src/test/java/mihon/domain/extension/model/ExtensionStoreUrlValidatorTest.kt
@@ -0,0 +1,41 @@
+package mihon.domain.extension.model
+
+import io.kotest.matchers.shouldBe
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.parallel.Execution
+import org.junit.jupiter.api.parallel.ExecutionMode
+
+@Execution(ExecutionMode.CONCURRENT)
+class ExtensionStoreUrlValidatorTest {
+
+    @Test
+    fun `accepts well-formed http and https URLs`() {
+        isValidExtensionStoreUrl("https://example.com/index.min.json") shouldBe true
+        isValidExtensionStoreUrl("http://example.com/repo.json") shouldBe true
+        isValidExtensionStoreUrl("  https://example.com  ") shouldBe true
+    }
+
+    @Test
+    fun `rejects blank input`() {
+        isValidExtensionStoreUrl("") shouldBe false
+        isValidExtensionStoreUrl("   ") shouldBe false
+    }
+
+    @Test
+    fun `rejects plain text without a scheme`() {
+        isValidExtensionStoreUrl("example.com") shouldBe false
+        isValidExtensionStoreUrl("not a url") shouldBe false
+    }
+
+    @Test
+    fun `rejects non-http schemes`() {
+        isValidExtensionStoreUrl("ftp://example.com/repo.json") shouldBe false
+        isValidExtensionStoreUrl("javascript:alert(1)") shouldBe false
+    }
+
+    @Test
+    fun `rejects malformed URLs`() {
+        isValidExtensionStoreUrl("http://") shouldBe false
+        isValidExtensionStoreUrl("http:///path") shouldBe false
+    }
+}
