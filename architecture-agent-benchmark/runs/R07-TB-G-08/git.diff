+/**
+ * Lets the user pick how long to snooze (hide from the Updates feed) one or more series for.
+ * Downloads and notifications for the series are unaffected; only the Updates feed listing is hidden
+ * until [onSnoozeUntil]'s epoch-millis value is reached.
+ */
+@Composable
+fun SnoozeDialog(
+    onDismissRequest: () -> Unit,
+    onSnoozeUntil: (Long) -> Unit,
+) {
+    val timeZone = remember { TimeZone.currentSystemDefault() }
+    var showDatePicker by rememberSaveable { mutableStateOf(false) }
+
+    if (showDatePicker) {
+        val initialSelectedDateMillis = remember {
+            startOfDayInDays(1, timeZone)
+        }
+        val pickerState = rememberDatePickerState(initialSelectedDateMillis = initialSelectedDateMillis)
+        DatePickerDialog(
+            onDismissRequest = onDismissRequest,
+            dismissButton = {
+                TextButton(onClick = onDismissRequest) {
+                    Text(text = stringResource(MR.strings.action_cancel))
+                }
+            },
+            confirmButton = {
+                TextButton(
+                    onClick = {
+                        pickerState.selectedDateMillis?.let(onSnoozeUntil)
+                        onDismissRequest()
+                    },
+                ) {
+                    Text(text = stringResource(MR.strings.action_ok))
+                }
+            },
+        ) {
+            DatePicker(state = pickerState)
+        }
+        return
+    }
+
+    AlertDialog(
+        onDismissRequest = onDismissRequest,
+        title = { Text(text = stringResource(MR.strings.action_snooze_updates)) },
+        text = {
+            Column {
+                TextButton(
+                    modifier = Modifier.fillMaxWidth(),
+                    onClick = {
+                        onSnoozeUntil(startOfDayInDays(1, timeZone))
+                        onDismissRequest()
+                    },
+                ) {
+                    Text(
+                        text = stringResource(MR.strings.snooze_tomorrow),
+                        modifier = Modifier.fillMaxWidth(),
+                        textAlign = TextAlign.Start,
+                    )
+                }
+                TextButton(
+                    modifier = Modifier.fillMaxWidth(),
+                    onClick = {
+                        onSnoozeUntil(startOfDayInDays(7, timeZone))
+                        onDismissRequest()
+                    },
+                ) {
+                    Text(
+                        text = stringResource(MR.strings.snooze_next_week),
+                        modifier = Modifier.fillMaxWidth(),
+                        textAlign = TextAlign.Start,
+                    )
+                }
+                TextButton(
+                    modifier = Modifier.fillMaxWidth(),
+                    onClick = { showDatePicker = true },
+                ) {
+                    Text(
+                        text = stringResource(MR.strings.snooze_custom_date),
+                        modifier = Modifier.fillMaxWidth(),
+                        textAlign = TextAlign.Start,
+                    )
+                }
+            }
+        },
+        confirmButton = {},
+        dismissButton = {
+            TextButton(onClick = onDismissRequest) {
+                Text(text = stringResource(MR.strings.action_cancel))
+            }
+        },
+    )
+}
+
+private fun startOfDayInDays(days: Int, timeZone: TimeZone): Long {
+    return Clock.System.now()
+        .toLocalDateTime(timeZone).date
+        .plus(days, DateTimeUnit.DAY)
+        .atStartOfDayIn(timeZone)
+        .toEpochMilliseconds()
+}
