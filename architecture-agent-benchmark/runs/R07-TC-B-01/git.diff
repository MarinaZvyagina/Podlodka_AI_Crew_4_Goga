@@ -0,0 +1,86 @@
+package eu.kanade.tachiyomi.data.track.selfhosted
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.selfhosted.dto.SHLibraryEntry
+import eu.kanade.tachiyomi.data.track.selfhosted.dto.SHLoginRequest
+import eu.kanade.tachiyomi.data.track.selfhosted.dto.SHLoginResponse
+import eu.kanade.tachiyomi.data.track.selfhosted.dto.SHProgressUpdate
+import eu.kanade.tachiyomi.data.track.selfhosted.dto.SHSearchResult
+import eu.kanade.tachiyomi.network.DELETE
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import uy.kohesive.injekt.injectLazy
+
+class SelfHostedApi(
+    private val selfHosted: SelfHosted,
+    interceptor: SelfHostedInterceptor,
+    private val client: OkHttpClient,
+) {
+    private val json: Json by injectLazy()
+
+    private val authClient by lazy {
+        client.newBuilder()
+            .addInterceptor(interceptor)
+            .build()
+    }
+
+    private val baseUrl get() = selfHosted.getServerUrl()
+
+    suspend fun login(serverUrl: String, username: String, password: String): SHLoginResponse {
+        val body = json.encodeToString(SHLoginRequest(username, password)).toRequestBody(CONTENT_TYPE)
+        return with(json) {
+            client.newCall(POST(url = "$serverUrl/api/v1/auth/login", body = body))
+                .awaitSuccess()
+                .parseAs<SHLoginResponse>()
+        }
+    }
+
+    suspend fun search(query: String): List<SHLibraryEntry> {
+        val url = "$baseUrl/api/v1/library/search".toHttpUrl().newBuilder()
+            .addQueryParameter("query", query)
+            .build()
+        return with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<SHSearchResult>()
+                .results
+        }
+    }
+
+    suspend fun fetchEntry(remoteId: Long): SHLibraryEntry {
+        return with(json) {
+            authClient.newCall(GET("$baseUrl/api/v1/library/$remoteId"))
+                .awaitSuccess()
+                .parseAs<SHLibraryEntry>()
+        }
+    }
+
+    suspend fun updateProgress(track: Track): SHLibraryEntry {
+        val body = json.encodeToString(
+            SHProgressUpdate(lastChapterRead = track.last_chapter_read, status = track.status),
+        ).toRequestBody(CONTENT_TYPE)
+        return with(json) {
+            authClient.newCall(PUT(url = "$baseUrl/api/v1/library/${track.remote_id}/progress", body = body))
+                .awaitSuccess()
+                .parseAs<SHLibraryEntry>()
+        }
+    }
+
+    suspend fun unlink(remoteId: Long) {
+        authClient.newCall(DELETE(url = "$baseUrl/api/v1/library/$remoteId/track"))
+            .awaitSuccess()
+    }
+
+    companion object {
+        private val CONTENT_TYPE = "application/json".toMediaType()
+    }
+}
