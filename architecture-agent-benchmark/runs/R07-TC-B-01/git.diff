+package eu.kanade.tachiyomi.data.track.selfhosted.dto
+
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class SHLoginRequest(
+    val username: String,
+    val password: String,
+)
+
+@Serializable
+data class SHLoginResponse(
+    val token: String,
+    @SerialName("user_id")
+    val userId: Long,
+    val username: String,
+)
+
+@Serializable
+data class SHLibraryEntry(
+    val id: Long,
+    val title: String,
+    @SerialName("cover_url")
+    val coverUrl: String? = null,
+    @SerialName("total_chapters")
+    val totalChapters: Long = 0,
+    @SerialName("last_chapter_read")
+    val lastChapterRead: Double = 0.0,
+    val status: Long = 0,
+    val url: String? = null,
+)
+
+@Serializable
+data class SHSearchResult(
+    val results: List<SHLibraryEntry> = emptyList(),
+)
+
+@Serializable
+data class SHProgressUpdate(
+    @SerialName("last_chapter_read")
+    val lastChapterRead: Double,
+    val status: Long,
+)
+
+fun SHLibraryEntry.toTrackSearch(trackerId: Long): TrackSearch {
+    return TrackSearch.create(trackerId).apply {
+        remote_id = this@toTrackSearch.id
+        title = this@toTrackSearch.title
+        total_chapters = this@toTrackSearch.totalChapters
+        last_chapter_read = this@toTrackSearch.lastChapterRead
+        status = this@toTrackSearch.status
+        cover_url = this@toTrackSearch.coverUrl ?: ""
+        tracking_url = this@toTrackSearch.url ?: ""
+    }
+}
