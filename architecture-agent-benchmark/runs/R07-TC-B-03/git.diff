@@ -0,0 +1,82 @@
+package eu.kanade.tachiyomi.data.track.librereader
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import okhttp3.Dns
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import uy.kohesive.injekt.injectLazy
+
+class LibreReaderApi(client: OkHttpClient, interceptor: LibreReaderInterceptor) {
+
+    private val json: Json by injectLazy()
+
+    // Self-hosted servers are often reached over a local IP address, which DNS-over-HTTPS breaks.
+    private val plainClient: OkHttpClient = client.newBuilder().dns(Dns.SYSTEM).build()
+
+    private val authClient: OkHttpClient = plainClient.newBuilder()
+        .addInterceptor(interceptor)
+        .build()
+
+    suspend fun login(serverUrl: String, username: String, password: String): String {
+        val body = json.encodeToString(LibreReaderLoginRequestDto(username, password))
+        return with(json) {
+            plainClient.newCall(
+                POST(
+                    url = "$serverUrl/api/v1/auth/login",
+                    body = body.toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<LibreReaderLoginResponseDto>()
+                .token
+        }
+    }
+
+    suspend fun search(serverUrl: String, query: String): List<LibreReaderSeriesDto> {
+        val url = "$serverUrl/api/v1/series".toHttpUrl().newBuilder()
+            .addQueryParameter("search", query)
+            .build()
+        return with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<List<LibreReaderSeriesDto>>()
+        }
+    }
+
+    suspend fun getSeries(seriesUrl: String): LibreReaderSeriesDto {
+        return with(json) {
+            authClient.newCall(GET(seriesUrl))
+                .awaitSuccess()
+                .parseAs<LibreReaderSeriesDto>()
+        }
+    }
+
+    suspend fun updateProgress(track: Track): LibreReaderSeriesDto {
+        val body = json.encodeToString(
+            LibreReaderProgressUpdateDto(
+                lastChapterRead = track.last_chapter_read,
+                completed = track.status == LibreReader.COMPLETED,
+            ),
+        )
+        authClient.newCall(
+            PUT(
+                url = "${track.tracking_url}/progress",
+                body = body.toRequestBody(CONTENT_TYPE),
+            ),
+        )
+            .awaitSuccess()
+        return getSeries(track.tracking_url)
+    }
+
+    companion object {
+        private val CONTENT_TYPE = "application/json".toMediaType()
+    }
+}
