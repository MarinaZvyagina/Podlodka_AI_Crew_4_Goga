@@ -0,0 +1,103 @@
+package eu.kanade.tachiyomi.data.track.librereader
+
+import androidx.annotation.CallSuper
+import dev.icerock.moko.resources.StringResource
+import eu.kanade.tachiyomi.R
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.BaseTracker
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import tachiyomi.i18n.MR
+import tachiyomi.domain.track.model.Track as DomainTrack
+
+/**
+ * Tracker for a self-hosted manga/comic library server. Unlike the enhanced trackers that piggyback
+ * credentials off a paired source extension, this tracker uses a real username/password typed
+ * directly into the app, together with the server's own URL.
+ */
+class LibreReader(id: Long) : BaseTracker(id, "Self-hosted Library") {
+
+    companion object {
+        const val UNREAD = 1L
+        const val READING = 2L
+        const val COMPLETED = 3L
+    }
+
+    private val interceptor by lazy { LibreReaderInterceptor(this) }
+    private val api by lazy { LibreReaderApi(client, interceptor) }
+
+    override fun getLogo(): Int = R.drawable.brand_librereader
+
+    override fun getStatusList(): List<Long> = listOf(UNREAD, READING, COMPLETED)
+
+    override fun getStatus(status: Long): StringResource? = when (status) {
+        UNREAD -> MR.strings.unread
+        READING -> MR.strings.reading
+        COMPLETED -> MR.strings.completed
+        else -> null
+    }
+
+    override fun getReadingStatus(): Long = READING
+
+    override fun getRereadingStatus(): Long = -1
+
+    override fun getCompletionStatus(): Long = COMPLETED
+
+    override fun getScoreList(): List<String> = emptyList()
+
+    override fun displayScore(track: DomainTrack): String = ""
+
+    override suspend fun update(track: Track, didReadChapter: Boolean): Track {
+        if (track.status != COMPLETED && didReadChapter) {
+            track.status = if (track.total_chapters > 0 && track.last_chapter_read.toLong() == track.total_chapters) {
+                COMPLETED
+            } else {
+                READING
+            }
+        }
+        val remote = api.updateProgress(track)
+        track.total_chapters = remote.totalChapters
+        track.last_chapter_read = remote.lastChapterRead
+        return track
+    }
+
+    override suspend fun bind(track: Track, hasReadChapters: Boolean): Track = track
+
+    override suspend fun search(query: String): List<TrackSearch> {
+        val serverUrl = getServerUrl()
+        return api.search(serverUrl, query).map {
+            it.toTrackSearch(id, "$serverUrl/api/v1/series/${it.id}")
+        }
+    }
+
+    override suspend fun refresh(track: Track): Track {
+        val remote = api.getSeries(track.tracking_url)
+        track.total_chapters = remote.totalChapters
+        track.last_chapter_read = remote.lastChapterRead
+        track.status = when {
+            remote.completed -> COMPLETED
+            remote.lastChapterRead > 0 -> READING
+            else -> UNREAD
+        }
+        return track
+    }
+
+    override suspend fun login(username: String, password: String) {
+        val serverUrl = getServerUrl()
+        require(serverUrl.isNotBlank()) { "Server URL is required" }
+        val token = api.login(serverUrl, username, password)
+        interceptor.newAuth(token)
+        saveCredentials(username, token)
+    }
+
+    @CallSuper
+    override fun logout() {
+        super.logout()
+        interceptor.newAuth(null)
+    }
+
+    fun restoreToken(): String? = getPassword().ifBlank { null }
+
+    fun getServerUrl(): String = trackPreferences.trackApiUrl(this).get()
+
+    fun saveServerUrl(url: String) = trackPreferences.trackApiUrl(this).set(url.trimEnd('/'))
+}
