+package eu.kanade.tachiyomi.data.track.librereader
+
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class LibreReaderLoginRequestDto(
+    val username: String,
+    val password: String,
+)
+
+@Serializable
+data class LibreReaderLoginResponseDto(
+    val token: String,
+)
+
+@Serializable
+data class LibreReaderSeriesDto(
+    val id: Long,
+    val title: String,
+    val coverUrl: String? = null,
+    val totalChapters: Long = 0,
+    val lastChapterRead: Double = 0.0,
+    val completed: Boolean = false,
+)
+
+@Serializable
+data class LibreReaderProgressUpdateDto(
+    val lastChapterRead: Double,
+    val completed: Boolean,
+)
+
+fun LibreReaderSeriesDto.toTrackSearch(trackerId: Long, trackingUrl: String): TrackSearch =
+    TrackSearch.create(trackerId).also {
+        it.title = title
+        it.cover_url = coverUrl.orEmpty()
+        it.tracking_url = trackingUrl
+        it.remote_id = id
+        it.total_chapters = totalChapters
+        it.last_chapter_read = lastChapterRead
+        it.status = when {
+            completed -> LibreReader.COMPLETED
+            lastChapterRead > 0 -> LibreReader.READING
+            else -> LibreReader.UNREAD
+        }
+    }
