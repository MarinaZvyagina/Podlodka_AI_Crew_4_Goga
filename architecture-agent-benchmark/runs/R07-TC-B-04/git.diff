@@ -0,0 +1,158 @@
+package eu.kanade.tachiyomi.data.track.librereader
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRLibraryEntry
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRSearchResult
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRSeries
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRUserProfile
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import eu.kanade.tachiyomi.network.DELETE
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.HttpException
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import okhttp3.Credentials
+import okhttp3.Headers.Companion.headersOf
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import tachiyomi.core.common.util.lang.withIOContext
+import uy.kohesive.injekt.injectLazy
+
+class LibreReaderApi(
+    private val tracker: LibreReader,
+    private val plainClient: OkHttpClient,
+    interceptor: LibreReaderInterceptor,
+) {
+
+    private val json: Json by injectLazy()
+
+    private val authClient = plainClient.newBuilder().addInterceptor(interceptor).build()
+
+    private val baseUrl get() = tracker.getApiUrl().trimEnd('/')
+
+    suspend fun login(username: String, password: String): LRUserProfile {
+        return withIOContext {
+            with(json) {
+                plainClient.newCall(
+                    GET(
+                        "$baseUrl/api/account/me",
+                        headers = headersOf("Authorization", Credentials.basic(username, password)),
+                    ),
+                )
+                    .awaitSuccess()
+                    .parseAs<LRUserProfile>()
+            }
+        }
+    }
+
+    suspend fun search(query: String): List<TrackSearch> {
+        return withIOContext {
+            val url = "$baseUrl/api/series/search".toHttpUrl().newBuilder()
+                .addQueryParameter("q", query)
+                .build()
+            with(json) {
+                authClient.newCall(GET(url.toString()))
+                    .awaitSuccess()
+                    .parseAs<LRSearchResult>()
+                    .results
+                    .map { parseSearchItem(it) }
+            }
+        }
+    }
+
+    suspend fun findLibraryEntry(track: Track): Track? {
+        return withIOContext {
+            try {
+                with(json) {
+                    authClient.newCall(GET("$baseUrl/api/library/series/${track.remote_id}"))
+                        .awaitSuccess()
+                        .parseAs<LRLibraryEntry>()
+                        .let { toTrack(it) }
+                }
+            } catch (e: HttpException) {
+                if (e.code == 404) null else throw e
+            }
+        }
+    }
+
+    suspend fun addToLibrary(track: Track): Track {
+        return withIOContext {
+            authClient.newCall(
+                POST(
+                    url = "$baseUrl/api/library/series/${track.remote_id}",
+                    body = toRequestBody(track),
+                ),
+            )
+                .awaitSuccess()
+
+            track
+        }
+    }
+
+    suspend fun updateProgress(track: Track): Track {
+        return withIOContext {
+            authClient.newCall(
+                PUT(
+                    url = "$baseUrl/api/library/series/${track.remote_id}",
+                    body = toRequestBody(track),
+                ),
+            )
+                .awaitSuccess()
+
+            track
+        }
+    }
+
+    suspend fun deleteFromLibrary(remoteId: Long) {
+        withIOContext {
+            authClient.newCall(DELETE("$baseUrl/api/library/series/$remoteId"))
+                .awaitSuccess()
+        }
+    }
+
+    private fun toRequestBody(track: Track) = buildJsonObject {
+        put("status", LibreReader.statusToApi(track.status))
+        put("last_chapter_read", track.last_chapter_read)
+        put("score", track.score)
+        put("start_date", track.started_reading_date)
+        put("finish_date", track.finished_reading_date)
+        put("private", track.private)
+    }
+        .toString()
+        .toRequestBody(APP_JSON)
+
+    private fun parseSearchItem(series: LRSeries): TrackSearch {
+        return TrackSearch.create(tracker.id).apply {
+            remote_id = series.id
+            title = series.title
+            cover_url = series.coverUrl.orEmpty()
+            total_chapters = series.totalChapters
+            tracking_url = "$baseUrl/series/${series.id}"
+        }
+    }
+
+    private fun toTrack(entry: LRLibraryEntry): Track {
+        return Track.create(tracker.id).apply {
+            remote_id = entry.seriesId
+            title = entry.title
+            status = LibreReader.statusFromApi(entry.status)
+            last_chapter_read = entry.lastChapterRead
+            total_chapters = entry.totalChapters
+            score = entry.score
+            started_reading_date = entry.startDate
+            finished_reading_date = entry.finishDate
+            private = entry.private
+        }
+    }
+
+    companion object {
+        private val APP_JSON = "application/json".toMediaType()
+    }
+}
