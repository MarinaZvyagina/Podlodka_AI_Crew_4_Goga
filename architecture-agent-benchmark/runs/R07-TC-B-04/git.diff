+package eu.kanade.tachiyomi.data.track.librereader
+
+import okhttp3.Credentials
+import okhttp3.Interceptor
+import okhttp3.Response
+import java.io.IOException
+
+class LibreReaderInterceptor(private val libreReader: LibreReader) : Interceptor {
+
+    override fun intercept(chain: Interceptor.Chain): Response {
+        val username = libreReader.getUsername()
+        val password = libreReader.getPassword()
+        if (username.isEmpty() || password.isEmpty()) {
+            throw IOException("Not authenticated with LibreReader")
+        }
+
+        val authRequest = chain.request().newBuilder()
+            .header("Authorization", Credentials.basic(username, password))
+            .build()
+
+        return chain.proceed(authRequest)
+    }
+}
