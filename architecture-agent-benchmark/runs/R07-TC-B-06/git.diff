@@ -0,0 +1,108 @@
+package eu.kanade.tachiyomi.data.track.librereader
+
+import eu.kanade.tachiyomi.BuildConfig
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRSeries
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRUser
+import eu.kanade.tachiyomi.data.track.librereader.dto.toApiStatus
+import eu.kanade.tachiyomi.data.track.librereader.dto.toTrackSearch
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import eu.kanade.tachiyomi.network.DELETE
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import okhttp3.Credentials
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import uy.kohesive.injekt.injectLazy
+import tachiyomi.domain.track.model.Track as DomainTrack
+
+class LibreReaderApi(
+    private val trackerId: Long,
+    private val client: OkHttpClient,
+    interceptor: LibreReaderInterceptor,
+    private val serverUrl: () -> String,
+) {
+
+    private val json: Json by injectLazy()
+
+    private val authClient by lazy { client.newBuilder().addInterceptor(interceptor).build() }
+
+    /**
+     * Verifies credentials directly against [serverUrl] using an explicit Basic Auth header,
+     * since the shared [authClient] interceptor reads credentials from preferences that aren't
+     * saved yet at login time.
+     */
+    suspend fun login(serverUrl: String, username: String, password: String): LRUser {
+        return with(json) {
+            client.newCall(
+                Request.Builder()
+                    .url("$serverUrl$USER_ENDPOINT")
+                    .header("Authorization", Credentials.basic(username, password))
+                    .header("User-Agent", "Mihon v${BuildConfig.VERSION_NAME} (${BuildConfig.APPLICATION_ID})")
+                    .get()
+                    .build(),
+            )
+                .awaitSuccess()
+                .parseAs<LRUser>()
+        }
+    }
+
+    suspend fun search(query: String): List<TrackSearch> {
+        val url = "${serverUrl()}$SERIES_ENDPOINT/search".toHttpUrl().newBuilder()
+            .addQueryParameter("q", query)
+            .build()
+        return with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<List<LRSeries>>()
+                .map { it.toTrackSearch(trackerId) }
+        }
+    }
+
+    suspend fun findSeries(track: Track): LRSeries? {
+        return try {
+            with(json) {
+                authClient.newCall(GET("${serverUrl()}$SERIES_ENDPOINT/${track.remote_id}"))
+                    .awaitSuccess()
+                    .parseAs<LRSeries>()
+            }
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    suspend fun updateProgress(track: Track): Track {
+        val body = buildJsonObject {
+            put("status", track.status.toApiStatus())
+            put("last_chapter_read", track.last_chapter_read)
+        }
+        authClient.newCall(
+            PUT(
+                url = "${serverUrl()}$SERIES_ENDPOINT/${track.remote_id}/progress",
+                body = body.toString().toRequestBody(CONTENT_TYPE),
+            ),
+        )
+            .awaitSuccess()
+        return track
+    }
+
+    suspend fun deleteSeries(track: DomainTrack) {
+        authClient.newCall(DELETE(url = "${serverUrl()}$SERIES_ENDPOINT/${track.remoteId}/progress"))
+            .awaitSuccess()
+    }
+
+    companion object {
+        private const val USER_ENDPOINT = "/api/v1/user/me"
+        private const val SERIES_ENDPOINT = "/api/v1/series"
+
+        private val CONTENT_TYPE = "application/json".toMediaType()
+    }
+}
