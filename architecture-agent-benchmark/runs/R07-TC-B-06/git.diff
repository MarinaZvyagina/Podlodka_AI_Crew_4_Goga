+package eu.kanade.tachiyomi.data.track.librereader.dto
+
+import eu.kanade.tachiyomi.data.track.librereader.LibreReader
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class LRUser(
+    val username: String,
+)
+
+@Serializable
+data class LRSeries(
+    val id: Long,
+    val title: String,
+    val totalChapters: Long = 0,
+    val lastChapterRead: Double = 0.0,
+    val status: String? = null,
+)
+
+fun LRSeries.toTrackSearch(trackerId: Long): TrackSearch {
+    val dto = this
+    return TrackSearch.create(trackerId).apply {
+        remote_id = dto.id
+        title = dto.title
+        total_chapters = dto.totalChapters
+        last_chapter_read = dto.lastChapterRead
+        status = dto.status.toTrackerStatus()
+    }
+}
+
+fun String?.toTrackerStatus(): Long = when (this) {
+    "READING" -> LibreReader.READING
+    "COMPLETED" -> LibreReader.COMPLETED
+    else -> LibreReader.UNREAD
+}
+
+fun Long.toApiStatus(): String = when (this) {
+    LibreReader.READING -> "READING"
+    LibreReader.COMPLETED -> "COMPLETED"
+    else -> "UNREAD"
+}
