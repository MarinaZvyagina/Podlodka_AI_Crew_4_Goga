@@ -0,0 +1,88 @@
+package eu.kanade.tachiyomi.data.track.librereader
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRSearchResponse
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRSeries
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRUser
+import eu.kanade.tachiyomi.data.track.librereader.dto.toStatusKey
+import eu.kanade.tachiyomi.network.DELETE
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import okhttp3.Credentials
+import okhttp3.Headers
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import uy.kohesive.injekt.injectLazy
+import tachiyomi.domain.track.model.Track as DomainTrack
+
+class LibreReaderApi(
+    private val libreReader: LibreReader,
+    client: OkHttpClient,
+) {
+    private val json: Json by injectLazy()
+
+    private val authClient by lazy {
+        client.newBuilder()
+            .addInterceptor(LibreReaderInterceptor(libreReader))
+            .build()
+    }
+
+    private val plainClient = client
+
+    private val baseUrl get() = libreReader.apiUrl.removeSuffix("/")
+
+    suspend fun authenticate(username: String, password: String): LRUser {
+        val request = GET(
+            url = "$baseUrl/api/v1/user",
+            headers = Headers.Builder()
+                .add("Authorization", Credentials.basic(username, password))
+                .build(),
+        )
+        return with(json) {
+            plainClient.newCall(request).awaitSuccess().parseAs<LRUser>()
+        }
+    }
+
+    suspend fun search(query: String): List<LRSeries> {
+        val url = "$baseUrl/api/v1/series".toHttpUrl().newBuilder()
+            .addQueryParameter("search", query)
+            .build()
+        return with(json) {
+            authClient.newCall(GET(url)).awaitSuccess().parseAs<LRSearchResponse>().results
+        }
+    }
+
+    suspend fun getSeries(remoteId: Long): LRSeries {
+        return with(json) {
+            authClient.newCall(GET("$baseUrl/api/v1/series/$remoteId")).awaitSuccess().parseAs<LRSeries>()
+        }
+    }
+
+    suspend fun updateProgress(track: Track) {
+        val body = buildJsonObject {
+            put("chapter", track.last_chapter_read)
+            put("status", track.status.toStatusKey())
+        }
+        authClient.newCall(
+            PUT(
+                url = "$baseUrl/api/v1/series/${track.remote_id}/progress",
+                body = body.toString().toRequestBody(CONTENT_TYPE),
+            ),
+        ).awaitSuccess()
+    }
+
+    suspend fun removeFromLibrary(track: DomainTrack) {
+        authClient.newCall(DELETE(url = "$baseUrl/api/v1/series/${track.remoteId}/progress")).awaitSuccess()
+    }
+
+    companion object {
+        private val CONTENT_TYPE = "application/json".toMediaType()
+    }
+}
