+package eu.kanade.tachiyomi.data.track.librereader.dto
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.librereader.LibreReader.Companion.COMPLETED
+import eu.kanade.tachiyomi.data.track.librereader.LibreReader.Companion.READING
+import eu.kanade.tachiyomi.data.track.librereader.LibreReader.Companion.UNREAD
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class LRUser(
+    val username: String,
+)
+
+@Serializable
+data class LRSearchResponse(
+    val results: List<LRSeries> = emptyList(),
+)
+
+@Serializable
+data class LRSeries(
+    val id: Long,
+    val title: String,
+    @SerialName("cover_url")
+    val coverUrl: String? = null,
+    @SerialName("total_chapters")
+    val totalChapters: Long? = null,
+    @SerialName("progress_chapter")
+    val progressChapter: Double? = null,
+    val status: String? = null,
+)
+
+fun LRSeries.toTrackSearch(trackerId: Long): TrackSearch = TrackSearch.create(trackerId).apply {
+    remote_id = this@toTrackSearch.id
+    title = this@toTrackSearch.title
+    total_chapters = this@toTrackSearch.totalChapters ?: 0
+    cover_url = this@toTrackSearch.coverUrl ?: ""
+    summary = ""
+    tracking_url = ""
+    last_chapter_read = this@toTrackSearch.progressChapter ?: 0.0
+    status = this@toTrackSearch.status.toStatusId()
+}
+
+fun LRSeries.copyTo(track: Track): Track = track.apply {
+    remote_id = this@copyTo.id
+    total_chapters = this@copyTo.totalChapters ?: 0
+    last_chapter_read = this@copyTo.progressChapter ?: 0.0
+    status = this@copyTo.status.toStatusId()
+}
+
+fun Long.toStatusKey(): String = when (this) {
+    UNREAD -> "unread"
+    COMPLETED -> "completed"
+    else -> "reading"
+}
+
+private fun String?.toStatusId(): Long = when (this) {
+    "unread" -> UNREAD
+    "completed" -> COMPLETED
+    else -> READING
+}
