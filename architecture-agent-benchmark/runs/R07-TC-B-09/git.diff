@@ -0,0 +1,105 @@
+package eu.kanade.tachiyomi.data.track.selfhosted
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.selfhosted.dto.SHLoginResponse
+import eu.kanade.tachiyomi.data.track.selfhosted.dto.SHProgress
+import eu.kanade.tachiyomi.data.track.selfhosted.dto.SHSeries
+import eu.kanade.tachiyomi.network.DELETE
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import uy.kohesive.injekt.injectLazy
+
+class SelfHostedApi(
+    private val selfHosted: SelfHosted,
+    interceptor: SelfHostedInterceptor,
+    client: OkHttpClient,
+) {
+    private val json: Json by injectLazy()
+
+    private val baseUrl get() = selfHosted.getBaseUrl()
+
+    private val unauthClient by lazy { client }
+
+    private val authClient by lazy {
+        client.newBuilder()
+            .addInterceptor(interceptor)
+            .build()
+    }
+
+    suspend fun login(username: String, password: String): SHLoginResponse {
+        val body = buildJsonObject {
+            put("username", username)
+            put("password", password)
+        }
+        return with(json) {
+            unauthClient.newCall(
+                POST(
+                    url = "$baseUrl/api/auth/login",
+                    body = body.toString().toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<SHLoginResponse>()
+        }
+    }
+
+    suspend fun search(query: String): List<SHSeries> {
+        val url = "$baseUrl/api/series".toHttpUrl().newBuilder()
+            .addQueryParameter("search", query)
+            .build()
+        return with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<List<SHSeries>>()
+        }
+    }
+
+    suspend fun getProgress(remoteId: Long): SHProgress? {
+        return try {
+            with(json) {
+                authClient.newCall(GET("$baseUrl/api/series/$remoteId/progress"))
+                    .awaitSuccess()
+                    .parseAs<SHProgress>()
+            }
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    suspend fun updateProgress(track: Track): SHProgress {
+        val body = buildJsonObject {
+            put("last_chapter_read", track.last_chapter_read)
+            put("total_chapters", track.total_chapters)
+            put("status", track.status)
+        }
+        return with(json) {
+            authClient.newCall(
+                PUT(
+                    url = "$baseUrl/api/series/${track.remote_id}/progress",
+                    body = body.toString().toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<SHProgress>()
+        }
+    }
+
+    suspend fun deleteProgress(remoteId: Long) {
+        authClient.newCall(DELETE(url = "$baseUrl/api/series/$remoteId/progress"))
+            .awaitSuccess()
+    }
+
+    companion object {
+        private val CONTENT_TYPE = "application/json".toMediaType()
+    }
+}
