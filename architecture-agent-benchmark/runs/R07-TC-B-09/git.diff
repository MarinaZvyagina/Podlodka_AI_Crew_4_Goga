+package eu.kanade.tachiyomi.data.track.selfhosted
+
+import dev.icerock.moko.resources.StringResource
+import eu.kanade.tachiyomi.R
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.BaseTracker
+import eu.kanade.tachiyomi.data.track.DeletableTracker
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import eu.kanade.tachiyomi.data.track.selfhosted.dto.toTrackSearch
+import tachiyomi.i18n.MR
+import tachiyomi.domain.track.model.Track as DomainTrack
+
+class SelfHosted(id: Long) : BaseTracker(id, "Self-hosted"), DeletableTracker {
+
+    companion object {
+        const val READING = 1L
+        const val COMPLETED = 2L
+        const val ON_HOLD = 3L
+        const val DROPPED = 4L
+        const val PLAN_TO_READ = 5L
+    }
+
+    private val interceptor by lazy { SelfHostedInterceptor(this) }
+
+    private val api by lazy { SelfHostedApi(this, interceptor, client) }
+
+    fun getBaseUrl(): String = trackPreferences.trackBaseUrl(this).get()
+
+    private fun saveBaseUrl(url: String) = trackPreferences.trackBaseUrl(this).set(url)
+
+    override fun getLogo(): Int = R.drawable.brand_selfhosted
+
+    override fun getStatusList(): List<Long> = listOf(READING, COMPLETED, ON_HOLD, DROPPED, PLAN_TO_READ)
+
+    override fun getStatus(status: Long): StringResource? = when (status) {
+        READING -> MR.strings.reading
+        COMPLETED -> MR.strings.completed
+        ON_HOLD -> MR.strings.on_hold
+        DROPPED -> MR.strings.dropped
+        PLAN_TO_READ -> MR.strings.plan_to_read
+        else -> null
+    }
+
+    override fun getReadingStatus(): Long = READING
+
+    override fun getRereadingStatus(): Long = -1
+
+    override fun getCompletionStatus(): Long = COMPLETED
+
+    override fun getScoreList(): List<String> = emptyList()
+
+    override fun displayScore(track: DomainTrack): String = ""
+
+    override suspend fun update(track: Track, didReadChapter: Boolean): Track {
+        if (track.status != COMPLETED) {
+            if (didReadChapter) {
+                track.status =
+                    if (track.total_chapters > 0 && track.last_chapter_read.toLong() == track.total_chapters) {
+                        COMPLETED
+                    } else {
+                        READING
+                    }
+            }
+        }
+        val progress = api.updateProgress(track)
+        track.total_chapters = progress.totalChapters
+        return track
+    }
+
+    override suspend fun bind(track: Track, hasReadChapters: Boolean): Track {
+        val progress = api.getProgress(track.remote_id)
+        if (progress != null) {
+            track.last_chapter_read = progress.lastChapterRead
+            track.total_chapters = progress.totalChapters
+            track.status = progress.status
+            return track
+        }
+
+        track.status = if (hasReadChapters) READING else PLAN_TO_READ
+        val created = api.updateProgress(track)
+        track.total_chapters = created.totalChapters
+        return track
+    }
+
+    override suspend fun search(query: String): List<TrackSearch> {
+        return api.search(query).map { it.toTrackSearch(id) }
+    }
+
+    override suspend fun refresh(track: Track): Track {
+        val progress = api.getProgress(track.remote_id) ?: return track
+        track.last_chapter_read = progress.lastChapterRead
+        track.total_chapters = progress.totalChapters
+        track.status = progress.status
+        return track
+    }
+
+    override suspend fun delete(track: DomainTrack) {
+        api.deleteProgress(track.remoteId)
+    }
+
+    override suspend fun login(username: String, password: String) {
+        login(getBaseUrl(), username, password)
+    }
+
+    suspend fun login(baseUrl: String, username: String, password: String) {
+        val normalizedUrl = baseUrl.trim().removeSuffix("/")
+        if (normalizedUrl.isEmpty()) {
+            throw IllegalArgumentException("Server URL is required")
+        }
+        saveBaseUrl(normalizedUrl)
+
+        val response = api.login(username, password)
+        interceptor.newAuth(response.token)
+        saveDisplayUsername(response.username?.ifBlank { null } ?: username)
+        saveCredentials(username, response.token)
+    }
+
+    override fun logout() {
+        super.logout()
+        interceptor.newAuth(null)
+    }
+
+    fun restoreToken(): String? = trackPreferences.trackPassword(this).get().ifBlank { null }
+}
