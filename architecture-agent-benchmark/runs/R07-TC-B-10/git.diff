@@ -0,0 +1,94 @@
+package eu.kanade.tachiyomi.data.track.selfhosted
+
+import dev.icerock.moko.resources.StringResource
+import eu.kanade.tachiyomi.R
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.BaseTracker
+import eu.kanade.tachiyomi.data.track.UrlAuthTracker
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import tachiyomi.i18n.MR
+import tachiyomi.domain.track.model.Track as DomainTrack
+
+/**
+ * Tracker for a self-hosted manga/comic library server (e.g. a home media server), authenticated
+ * with a server address plus a username and password. Unlike the enhanced trackers for a specific
+ * paired extension (Komga, Kavita, Suwayomi), entries are searched for and bound manually, the same
+ * way as any other tracking service.
+ */
+class SelfHosted(id: Long) : BaseTracker(id, "Self-hosted"), UrlAuthTracker {
+
+    companion object {
+        const val UNREAD = 1L
+        const val READING = 2L
+        const val COMPLETED = 3L
+    }
+
+    private val interceptor by lazy { SelfHostedInterceptor(this) }
+    private val api by lazy { SelfHostedApi(id, client, interceptor) }
+
+    override fun getLogo(): Int = R.drawable.brand_selfhosted
+
+    override fun getStatusList(): List<Long> = listOf(UNREAD, READING, COMPLETED)
+
+    override fun getStatus(status: Long): StringResource? = when (status) {
+        UNREAD -> MR.strings.unread
+        READING -> MR.strings.reading
+        COMPLETED -> MR.strings.completed
+        else -> null
+    }
+
+    override fun getReadingStatus(): Long = READING
+
+    override fun getRereadingStatus(): Long = -1
+
+    override fun getCompletionStatus(): Long = COMPLETED
+
+    override fun getScoreList(): List<String> = emptyList()
+
+    override fun displayScore(track: DomainTrack): String = ""
+
+    override suspend fun update(track: Track, didReadChapter: Boolean): Track {
+        if (track.status != COMPLETED && didReadChapter) {
+            track.status = if (track.total_chapters > 0 && track.last_chapter_read.toLong() >= track.total_chapters) {
+                COMPLETED
+            } else {
+                READING
+            }
+        }
+        return api.updateProgress(getServerUrl(), track.remote_id, track.last_chapter_read)
+    }
+
+    override suspend fun bind(track: Track, hasReadChapters: Boolean): Track {
+        val remoteTrack = api.getSeries(getServerUrl(), track.remote_id)
+        track.copyPersonalFrom(remoteTrack)
+        track.total_chapters = remoteTrack.total_chapters
+        return track
+    }
+
+    override suspend fun search(query: String): List<TrackSearch> = api.search(getServerUrl(), query)
+
+    override suspend fun refresh(track: Track): Track {
+        val remoteTrack = api.getSeries(getServerUrl(), track.remote_id)
+        track.copyPersonalFrom(remoteTrack)
+        track.total_chapters = remoteTrack.total_chapters
+        return track
+    }
+
+    override suspend fun login(username: String, password: String) {
+        login(getServerUrl(), username, password)
+    }
+
+    override suspend fun login(serverUrl: String, username: String, password: String) {
+        val normalizedUrl = serverUrl.trimEnd('/')
+        val token = api.login(normalizedUrl, username, password)
+        saveServerUrl(normalizedUrl)
+        saveCredentials(username, token)
+        saveDisplayUsername("$username@$normalizedUrl")
+    }
+
+    override fun getServerUrl(): String = trackPreferences.trackServerUrl(this).get()
+
+    override fun saveServerUrl(serverUrl: String) {
+        trackPreferences.trackServerUrl(this).set(serverUrl)
+    }
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/data/track/selfhosted/SelfHostedApi.kt b/app/src/main/java/eu/kanade/tachiyomi/data/track/selfhosted/SelfHostedApi.kt
