+package eu.kanade.tachiyomi.data.track.selfhosted
+
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class SHLoginRequest(
+    val username: String,
+    val password: String,
+)
+
+@Serializable
+data class SHAuthResponseDto(
+    val token: String,
+    val username: String,
+)
+
+@Serializable
+data class SHSeriesDto(
+    val id: Long,
+    val title: String,
+    val coverUrl: String? = null,
+    val chapterCount: Long = 0,
+    val chaptersRead: Double = 0.0,
+)
+
+@Serializable
+data class SHProgressUpdateRequest(
+    val chaptersRead: Double,
+)
