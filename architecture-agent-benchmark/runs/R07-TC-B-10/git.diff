@@ -0,0 +1,21 @@
+package eu.kanade.tachiyomi.data.track.selfhosted
+
+import eu.kanade.tachiyomi.BuildConfig
+import okhttp3.Interceptor
+import okhttp3.Response
+import java.io.IOException
+
+class SelfHostedInterceptor(private val selfHosted: SelfHosted) : Interceptor {
+
+    override fun intercept(chain: Interceptor.Chain): Response {
+        val token = selfHosted.getPassword().ifBlank { null }
+            ?: throw IOException("Not authenticated with self-hosted server")
+
+        val authRequest = chain.request().newBuilder()
+            .addHeader("Authorization", "Bearer $token")
+            .header("User-Agent", "Mihon v${BuildConfig.VERSION_NAME} (${BuildConfig.APPLICATION_ID})")
+            .build()
+
+        return chain.proceed(authRequest)
+    }
+}
