+++ b/app/src/main/java/eu/kanade/tachiyomi/data/track/selfhosted/SelfHostedApi.kt
@@ -0,0 +1,99 @@
+package eu.kanade.tachiyomi.data.track.selfhosted
+
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import tachiyomi.core.common.util.lang.withIOContext
+import uy.kohesive.injekt.injectLazy
+
+class SelfHostedApi(
+    private val trackId: Long,
+    client: OkHttpClient,
+    interceptor: SelfHostedInterceptor,
+) {
+
+    private val json: Json by injectLazy()
+
+    private val unauthClient = client.newBuilder().build()
+    private val authClient = client.newBuilder().addInterceptor(interceptor).build()
+
+    suspend fun login(serverUrl: String, username: String, password: String): String = withIOContext {
+        val body = json.encodeToString(SHLoginRequest.serializer(), SHLoginRequest(username, password))
+        with(json) {
+            unauthClient.newCall(
+                POST(
+                    url = "$serverUrl/api/auth/login",
+                    body = body.toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<SHAuthResponseDto>()
+                .token
+        }
+    }
+
+    suspend fun search(serverUrl: String, query: String): List<TrackSearch> = withIOContext {
+        val url = "$serverUrl/api/series/search".toHttpUrl().newBuilder()
+            .addQueryParameter("query", query)
+            .build()
+        with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<List<SHSeriesDto>>()
+                .map { it.toTrackSearch() }
+        }
+    }
+
+    suspend fun getSeries(serverUrl: String, seriesId: Long): TrackSearch = withIOContext {
+        with(json) {
+            authClient.newCall(GET("$serverUrl/api/series/$seriesId"))
+                .awaitSuccess()
+                .parseAs<SHSeriesDto>()
+                .toTrackSearch()
+        }
+    }
+
+    suspend fun updateProgress(serverUrl: String, seriesId: Long, chaptersRead: Double): TrackSearch = withIOContext {
+        val body = json.encodeToString(
+            SHProgressUpdateRequest.serializer(),
+            SHProgressUpdateRequest(chaptersRead),
+        )
+        with(json) {
+            authClient.newCall(
+                PUT(
+                    url = "$serverUrl/api/series/$seriesId/progress",
+                    body = body.toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<SHSeriesDto>()
+                .toTrackSearch()
+        }
+    }
+
+    private fun SHSeriesDto.toTrackSearch(): TrackSearch = TrackSearch.create(trackId).apply {
+        val dto = this@toTrackSearch
+        remote_id = dto.id
+        title = dto.title
+        cover_url = dto.coverUrl.orEmpty()
+        total_chapters = dto.chapterCount
+        last_chapter_read = dto.chaptersRead
+        status = when {
+            dto.chapterCount > 0 && dto.chaptersRead >= dto.chapterCount -> SelfHosted.COMPLETED
+            dto.chaptersRead > 0 -> SelfHosted.READING
+            else -> SelfHosted.UNREAD
+        }
+    }
+
+    companion object {
+        private val CONTENT_TYPE = "application/json".toMediaType()
+    }
+}
