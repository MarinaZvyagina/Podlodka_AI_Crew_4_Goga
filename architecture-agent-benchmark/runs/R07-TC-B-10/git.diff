+package eu.kanade.tachiyomi.data.track
+
+/**
+ * A tracker whose login additionally requires the address of a self-hosted server instance,
+ * rather than authenticating against a single, fixed service URL.
+ */
+interface UrlAuthTracker {
+
+    fun getServerUrl(): String
+
+    fun saveServerUrl(serverUrl: String)
+
+    suspend fun login(serverUrl: String, username: String, password: String)
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/data/track/selfhosted/SelfHosted.kt b/app/src/main/java/eu/kanade/tachiyomi/data/track/selfhosted/SelfHosted.kt
new file mode 100644
