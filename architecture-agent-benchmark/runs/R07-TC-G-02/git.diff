@@ -0,0 +1,100 @@
+package eu.kanade.tachiyomi.data.track.yomikata
+
+import eu.kanade.tachiyomi.data.track.yomikata.dto.YHLoginResponse
+import eu.kanade.tachiyomi.data.track.yomikata.dto.YHProgressDto
+import eu.kanade.tachiyomi.data.track.yomikata.dto.YHSeriesDto
+import eu.kanade.tachiyomi.network.DELETE
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import uy.kohesive.injekt.injectLazy
+
+class YomikataApi(
+    interceptor: YomikataInterceptor,
+    private val client: OkHttpClient,
+) {
+    private val json: Json by injectLazy()
+
+    private val authClient by lazy {
+        client.newBuilder()
+            .addInterceptor(interceptor)
+            .build()
+    }
+
+    suspend fun authenticate(serverUrl: String, username: String, password: String): YHLoginResponse {
+        val body = buildJsonObject {
+            put("username", username)
+            put("password", password)
+        }
+        return with(json) {
+            client.newCall(
+                PUT(
+                    url = "$serverUrl/api/v1/auth/login",
+                    body = body.toString().toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<YHLoginResponse>()
+        }
+    }
+
+    suspend fun search(serverUrl: String, query: String): List<YHSeriesDto> {
+        val url = "$serverUrl/api/v1/series".toHttpUrl().newBuilder()
+            .addQueryParameter("search", query)
+            .build()
+        return with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<List<YHSeriesDto>>()
+        }
+    }
+
+    suspend fun getSeries(serverUrl: String, seriesId: Long): YHSeriesDto {
+        return with(json) {
+            authClient.newCall(GET("$serverUrl/api/v1/series/$seriesId"))
+                .awaitSuccess()
+                .parseAs<YHSeriesDto>()
+        }
+    }
+
+    suspend fun getProgress(serverUrl: String, seriesId: Long): YHProgressDto {
+        return with(json) {
+            authClient.newCall(GET("$serverUrl/api/v1/series/$seriesId/progress"))
+                .awaitSuccess()
+                .parseAs<YHProgressDto>()
+        }
+    }
+
+    suspend fun updateProgress(serverUrl: String, seriesId: Long, chaptersRead: Double, status: Long) {
+        val body = buildJsonObject {
+            put("chapters_read", chaptersRead)
+            put("status", status)
+        }
+        authClient.newCall(
+            PUT(
+                url = "$serverUrl/api/v1/series/$seriesId/progress",
+                body = body.toString().toRequestBody(CONTENT_TYPE),
+            ),
+        )
+            .awaitSuccess()
+    }
+
+    suspend fun deleteProgress(serverUrl: String, seriesId: Long) {
+        authClient.newCall(
+            DELETE(url = "$serverUrl/api/v1/series/$seriesId/progress"),
+        )
+            .awaitSuccess()
+    }
+
+    companion object {
+        private val CONTENT_TYPE = "application/json".toMediaType()
+    }
+}
