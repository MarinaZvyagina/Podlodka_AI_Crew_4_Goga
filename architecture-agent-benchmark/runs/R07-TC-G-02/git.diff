@@ -0,0 +1,117 @@
+package eu.kanade.tachiyomi.data.track.yomikata
+
+import dev.icerock.moko.resources.StringResource
+import eu.kanade.tachiyomi.R
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.BaseTracker
+import eu.kanade.tachiyomi.data.track.DeletableTracker
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import eu.kanade.tachiyomi.data.track.yomikata.dto.toTrackSearch
+import tachiyomi.i18n.MR
+import tachiyomi.domain.track.model.Track as DomainTrack
+
+/**
+ * Tracker for a self-hosted manga/comic library server (e.g. a home-hosted Komga/Kavita-style
+ * setup) that exposes its own reading-progress API, reached at a user-supplied server URL.
+ */
+class Yomikata(id: Long) : BaseTracker(id, "Yomikata"), DeletableTracker {
+
+    companion object {
+        const val UNREAD = 1L
+        const val READING = 2L
+        const val COMPLETED = 3L
+    }
+
+    private val interceptor by lazy { YomikataInterceptor(this) }
+
+    private val api by lazy { YomikataApi(interceptor, client) }
+
+    private val serverUrl: String
+        get() = trackPreferences.trackServerUrl(this).get()
+
+    override fun getLogo(): Int = R.drawable.brand_yomikata
+
+    override fun getStatusList(): List<Long> = listOf(READING, COMPLETED, UNREAD)
+
+    override fun getStatus(status: Long): StringResource? = when (status) {
+        READING -> MR.strings.reading
+        COMPLETED -> MR.strings.completed
+        UNREAD -> MR.strings.unread
+        else -> null
+    }
+
+    override fun getReadingStatus(): Long = READING
+
+    override fun getRereadingStatus(): Long = -1
+
+    override fun getCompletionStatus(): Long = COMPLETED
+
+    override fun getScoreList(): List<String> = emptyList()
+
+    override fun displayScore(track: DomainTrack): String = ""
+
+    override suspend fun update(track: Track, didReadChapter: Boolean): Track {
+        if (track.status != COMPLETED && didReadChapter) {
+            track.status = READING
+        }
+        if (track.total_chapters != 0L && track.last_chapter_read.toLong() >= track.total_chapters) {
+            track.status = COMPLETED
+        }
+        api.updateProgress(serverUrl, track.remote_id, track.last_chapter_read, track.status)
+        return track
+    }
+
+    override suspend fun delete(track: DomainTrack) {
+        api.deleteProgress(serverUrl, track.remoteId)
+    }
+
+    override suspend fun bind(track: Track, hasReadChapters: Boolean): Track {
+        return try {
+            val progress = api.getProgress(serverUrl, track.remote_id)
+            track.status = progress.status
+            track.last_chapter_read = progress.chaptersRead
+            track
+        } catch (e: Exception) {
+            track.status = if (hasReadChapters) READING else UNREAD
+            api.updateProgress(serverUrl, track.remote_id, track.last_chapter_read, track.status)
+            track
+        }
+    }
+
+    override suspend fun search(query: String): List<TrackSearch> {
+        return api.search(serverUrl, query).map { it.toTrackSearch(id) }
+    }
+
+    override suspend fun refresh(track: Track): Track {
+        val progress = api.getProgress(serverUrl, track.remote_id)
+        track.status = progress.status
+        track.last_chapter_read = progress.chaptersRead
+        track.total_chapters = api.getSeries(serverUrl, track.remote_id).totalChapters
+        return track
+    }
+
+    override suspend fun login(username: String, password: String) {
+        login(trackPreferences.trackServerUrl(this).get(), username, password)
+    }
+
+    suspend fun login(serverUrl: String, username: String, password: String) {
+        val normalizedUrl = normalizeServerUrl(serverUrl)
+        val authenticated = api.authenticate(normalizedUrl, username, password)
+        trackPreferences.trackServerUrl(this).set(normalizedUrl)
+        interceptor.newAuth(authenticated.token)
+        saveDisplayUsername(authenticated.username)
+        saveCredentials(authenticated.userId.toString(), authenticated.token)
+    }
+
+    override fun logout() {
+        super.logout()
+        interceptor.newAuth(null)
+        trackPreferences.trackServerUrl(this).delete()
+    }
+
+    fun restoreSession(): String? {
+        return trackPreferences.trackPassword(this).get().ifBlank { null }
+    }
+
+    private fun normalizeServerUrl(url: String): String = url.trim().removeSuffix("/")
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/data/track/yomikata/YomikataApi.kt b/app/src/main/java/eu/kanade/tachiyomi/data/track/yomikata/YomikataApi.kt
new file mode 100644
