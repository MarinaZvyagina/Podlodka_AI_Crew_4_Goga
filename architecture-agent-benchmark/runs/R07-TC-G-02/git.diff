+package eu.kanade.tachiyomi.data.track.yomikata.dto
+
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class YHSeriesDto(
+    val id: Long,
+    val title: String,
+    val url: String? = null,
+    @SerialName("total_chapters")
+    val totalChapters: Long = 0,
+    @SerialName("thumbnail_url")
+    val thumbnailUrl: String? = null,
+)
+
+fun YHSeriesDto.toTrackSearch(trackerId: Long): TrackSearch {
+    return TrackSearch.create(trackerId).apply {
+        remote_id = this@toTrackSearch.id
+        title = this@toTrackSearch.title
+        total_chapters = this@toTrackSearch.totalChapters
+        cover_url = this@toTrackSearch.thumbnailUrl ?: ""
+        tracking_url = this@toTrackSearch.url ?: ""
+        summary = ""
+        publishing_status = ""
+        publishing_type = ""
+        start_date = ""
+        score = -1.0
+    }
+}
