@@ -0,0 +1,96 @@
+package eu.kanade.tachiyomi.data.track.librereader
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import eu.kanade.tachiyomi.network.DELETE
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import tachiyomi.core.common.util.lang.withIOContext
+import uy.kohesive.injekt.injectLazy
+import tachiyomi.domain.track.model.Track as DomainTrack
+
+class LibreReaderApi(
+    private val trackId: Long,
+    private val client: OkHttpClient,
+    interceptor: LibreReaderInterceptor,
+) {
+
+    private val json: Json by injectLazy()
+
+    private val authClient by lazy { client.newBuilder().addInterceptor(interceptor).build() }
+
+    // Uses the plain client: no token exists yet at login time.
+    suspend fun login(serverUrl: String, username: String, password: String): LRAuthResponse = withIOContext {
+        val body = buildJsonObject {
+            put("username", username)
+            put("password", password)
+        }
+        with(json) {
+            client.newCall(
+                POST(
+                    url = seriesUrl(serverUrl, "/api/auth/login"),
+                    body = body.toString().toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<LRAuthResponse>()
+        }
+    }
+
+    suspend fun search(serverUrl: String, query: String): List<TrackSearch> = withIOContext {
+        val url = "${serverUrl.trimEnd('/')}/api/series".toHttpUrl().newBuilder()
+            .addQueryParameter("search", query)
+            .build()
+        with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<List<LRSeriesDto>>()
+                .map { it.toTrackSearch(trackId, serverUrl) }
+        }
+    }
+
+    suspend fun getTrackSearch(serverUrl: String, remoteId: Long): TrackSearch = withIOContext {
+        with(json) {
+            authClient.newCall(GET(seriesUrl(serverUrl, "/api/series/$remoteId")))
+                .awaitSuccess()
+                .parseAs<LRSeriesDto>()
+                .toTrackSearch(trackId, serverUrl)
+        }
+    }
+
+    suspend fun updateProgress(serverUrl: String, track: Track): Track = withIOContext {
+        val body = buildJsonObject {
+            put("lastChapterRead", track.last_chapter_read)
+            put("status", track.status)
+        }
+        authClient.newCall(
+            PUT(
+                url = seriesUrl(serverUrl, "/api/series/${track.remote_id}/progress"),
+                body = body.toString().toRequestBody(CONTENT_TYPE),
+            ),
+        )
+            .awaitSuccess()
+        track
+    }
+
+    suspend fun deleteProgress(serverUrl: String, track: DomainTrack) = withIOContext {
+        authClient.newCall(DELETE(url = seriesUrl(serverUrl, "/api/series/${track.remoteId}/progress")))
+            .awaitSuccess()
+    }
+
+    private fun seriesUrl(serverUrl: String, path: String) = "${serverUrl.trimEnd('/')}$path"
+
+    companion object {
+        private val CONTENT_TYPE = "application/json".toMediaType()
+    }
+}
