+package eu.kanade.tachiyomi.data.track.librereader
+
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class LRAuthResponse(
+    val token: String,
+    val username: String,
+)
+
+@Serializable
+data class LRReadProgressDto(
+    val lastChapterRead: Double = 0.0,
+    val status: Long = LibreReader.UNREAD,
+)
+
+@Serializable
+data class LRSeriesDto(
+    val id: Long,
+    val title: String,
+    val chapterCount: Long = 0,
+    val readProgress: LRReadProgressDto? = null,
+)
+
+fun LRSeriesDto.toTrackSearch(trackerId: Long, serverUrl: String): TrackSearch {
+    val dto = this
+    return TrackSearch.create(trackerId).also {
+        it.title = dto.title
+        it.remote_id = dto.id
+        it.tracking_url = "${serverUrl.trimEnd('/')}/api/series/${dto.id}"
+        it.total_chapters = dto.chapterCount
+        it.last_chapter_read = dto.readProgress?.lastChapterRead ?: 0.0
+        it.status = dto.readProgress?.status ?: LibreReader.UNREAD
+    }
+}
