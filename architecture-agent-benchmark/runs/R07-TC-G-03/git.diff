@@ -0,0 +1,120 @@
+package eu.kanade.tachiyomi.data.track.librereader
+
+import dev.icerock.moko.resources.StringResource
+import eu.kanade.tachiyomi.R
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.BaseTracker
+import eu.kanade.tachiyomi.data.track.DeletableTracker
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.combine
+import tachiyomi.i18n.MR
+import tachiyomi.domain.track.model.Track as DomainTrack
+
+/**
+ * Tracker for a self-hosted manga/comic library server: unlike the EnhancedTracker
+ * self-hosted trackers (Kavita/Komga/Suwayomi), which borrow credentials from a paired
+ * source extension, this one is logged into directly with a server URL and account
+ * credentials, so it also works for entries that weren't added through such a source.
+ */
+class LibreReader(id: Long) : BaseTracker(id, "LibreReader"), DeletableTracker {
+
+    companion object {
+        const val UNREAD = 1L
+        const val READING = 2L
+        const val COMPLETED = 3L
+    }
+
+    private val interceptor by lazy { LibreReaderInterceptor(this) }
+    private val api by lazy { LibreReaderApi(id, client, interceptor) }
+
+    override fun getLogo(): Int = R.drawable.brand_librereader
+
+    override fun getStatusList(): List<Long> = listOf(UNREAD, READING, COMPLETED)
+
+    override fun getStatus(status: Long): StringResource? = when (status) {
+        UNREAD -> MR.strings.unread
+        READING -> MR.strings.reading
+        COMPLETED -> MR.strings.completed
+        else -> null
+    }
+
+    override fun getReadingStatus(): Long = READING
+
+    override fun getRereadingStatus(): Long = -1
+
+    override fun getCompletionStatus(): Long = COMPLETED
+
+    override fun getScoreList(): List<String> = emptyList()
+
+    override fun displayScore(track: DomainTrack): String = ""
+
+    override val isLoggedIn: Boolean
+        get() = super.isLoggedIn && getServerUrl().isNotEmpty()
+
+    override val isLoggedInFlow: Flow<Boolean> by lazy {
+        combine(super.isLoggedInFlow, trackPreferences.trackApiUrl(this).changes()) { loggedIn, url ->
+            loggedIn && url.isNotEmpty()
+        }
+    }
+
+    override suspend fun update(track: Track, didReadChapter: Boolean): Track {
+        if (track.status != COMPLETED && didReadChapter) {
+            track.status = if (track.total_chapters > 0 && track.last_chapter_read.toLong() == track.total_chapters) {
+                COMPLETED
+            } else {
+                READING
+            }
+        }
+        return api.updateProgress(getServerUrl(), track)
+    }
+
+    override suspend fun bind(track: Track, hasReadChapters: Boolean): Track {
+        return try {
+            val remoteTrack = api.getTrackSearch(getServerUrl(), track.remote_id)
+            track.copyPersonalFrom(remoteTrack, copyRemotePrivate = false)
+            track.total_chapters = remoteTrack.total_chapters
+            track
+        } catch (e: Exception) {
+            track
+        }
+    }
+
+    override suspend fun search(query: String): List<TrackSearch> = api.search(getServerUrl(), query)
+
+    override suspend fun refresh(track: Track): Track {
+        val remoteTrack = api.getTrackSearch(getServerUrl(), track.remote_id)
+        track.copyPersonalFrom(remoteTrack)
+        track.total_chapters = remoteTrack.total_chapters
+        return track
+    }
+
+    override suspend fun login(username: String, password: String) {
+        val serverUrl = getServerUrl()
+        if (serverUrl.isEmpty()) {
+            throw Exception("A server URL is required")
+        }
+        val auth = api.login(serverUrl, username, password)
+        interceptor.newAuth(auth.token)
+        saveDisplayUsername(auth.username)
+        saveCredentials(username, auth.token)
+    }
+
+    override fun logout() {
+        super.logout()
+        interceptor.newAuth(null)
+        trackPreferences.trackApiUrl(this).delete()
+    }
+
+    override suspend fun delete(track: DomainTrack) {
+        api.deleteProgress(getServerUrl(), track)
+    }
+
+    fun getServerUrl(): String = trackPreferences.trackApiUrl(this).get()
+
+    fun saveServerUrl(url: String) {
+        trackPreferences.trackApiUrl(this).set(url.trim().trimEnd('/'))
+    }
+
+    fun restoreToken(): String? = getPassword().ifBlank { null }
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/data/track/librereader/LibreReaderApi.kt b/app/src/main/java/eu/kanade/tachiyomi/data/track/librereader/LibreReaderApi.kt
