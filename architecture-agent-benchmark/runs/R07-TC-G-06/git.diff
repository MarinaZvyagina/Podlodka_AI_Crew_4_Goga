+package eu.kanade.tachiyomi.data.track.librereader.dto
+
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class LRSeries(
+    val id: Long,
+    val title: String,
+    val coverUrl: String = "",
+    val summary: String = "",
+    val totalChapters: Long = 0,
+)
+
+fun LRSeries.toTrackSearch(trackerId: Long, baseUrl: String): TrackSearch = TrackSearch.create(trackerId).apply {
+    remote_id = this@toTrackSearch.id
+    title = this@toTrackSearch.title
+    cover_url = if (coverUrl.isNotEmpty()) "$baseUrl$coverUrl" else ""
+    summary = this@toTrackSearch.summary
+    total_chapters = totalChapters
+    tracking_url = "$baseUrl/series/${this@toTrackSearch.id}"
+}
+
+@Serializable
+data class LRProgress(
+    val chapter: Double = 0.0,
+    val totalChapters: Long = 0,
+    val status: String = "UNREAD",
+)
