diff --git a/data/src/main/java/tachiyomi/data/source/SourceBrowseCache.kt b/data/src/main/java/tachiyomi/data/source/SourceBrowseCache.kt
new file mode 100644
index 0000000..f13e93a
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourceBrowseCache.kt
@@ -0,0 +1,64 @@
+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.FilterList
+import eu.kanade.tachiyomi.source.model.MangasPage
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.time.Duration.Companion.minutes
+
+/**
+ * Caches the [MangasPage] results of browsing a source (popular, latest, or search listings) so
+ * that repeating the same listing shortly after doesn't re-hit the network. Entries expire after
+ * [CACHE_DURATION_MILLIS], and [forceRefresh] lets a caller bypass a listing's cached pages, e.g.
+ * for a user-initiated refresh.
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourceBrowseCache {
+
+    private val cache = ConcurrentHashMap<CacheKey, CacheEntry>()
+
+    suspend fun getOrPut(
+        sourceId: Long,
+        listingKey: String,
+        filters: FilterList,
+        page: Int,
+        forceRefresh: Boolean,
+        fetch: suspend () -> MangasPage,
+    ): MangasPage {
+        val signature = filters.map { it.name to it.state }
+
+        if (forceRefresh) {
+            cache.keys.removeAll {
+                it.sourceId == sourceId && it.listingKey == listingKey && it.filterSignature == signature
+            }
+        } else {
+            val cached = cache[CacheKey(sourceId, listingKey, signature, page)]
+            if (cached != null && System.currentTimeMillis() - cached.timestamp < CACHE_DURATION_MILLIS) {
+                return cached.mangasPage
+            }
+        }
+
+        val mangasPage = fetch()
+        cache[CacheKey(sourceId, listingKey, signature, page)] = CacheEntry(mangasPage, System.currentTimeMillis())
+        return mangasPage
+    }
+
+    private data class CacheKey(
+        val sourceId: Long,
+        val listingKey: String,
+        val filterSignature: List<Pair<String, Any?>>,
+        val page: Int,
+    )
+
+    private data class CacheEntry(
+        val mangasPage: MangasPage,
+        val timestamp: Long,
+    )
+
+    companion object {
+        private val CACHE_DURATION_MILLIS = 5.minutes.inWholeMilliseconds
+    }
+}
