diff --git a/data/src/main/java/tachiyomi/data/source/SourceMangaPageCache.kt b/data/src/main/java/tachiyomi/data/source/SourceMangaPageCache.kt
new file mode 100644
index 0000000..ffc9193
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourceMangaPageCache.kt
@@ -0,0 +1,48 @@
+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.MangasPage
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.time.Duration.Companion.minutes
+
+/**
+ * Short-lived in-memory cache of source listing/search results, keyed by the exact
+ * source + listing + query + filters + page that produced them. Avoids re-hitting the
+ * network when the user repeats the same search shortly after (e.g. navigating back
+ * to browse, or scrolling back up through an already-loaded search).
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourceMangaPageCache {
+
+    private val cache = ConcurrentHashMap<CacheKey, Entry>()
+
+    fun get(key: CacheKey): MangasPage? {
+        val entry = cache[key] ?: return null
+        if (System.currentTimeMillis() > entry.expiresAtMillis) {
+            cache.remove(key)
+            return null
+        }
+        return entry.mangasPage
+    }
+
+    fun put(key: CacheKey, mangasPage: MangasPage) {
+        cache[key] = Entry(mangasPage, System.currentTimeMillis() + CACHE_DURATION.inWholeMilliseconds)
+    }
+
+    data class CacheKey(
+        val sourceId: Long,
+        val listing: String,
+        val query: String,
+        val filterState: List<Pair<String, Any?>>,
+        val page: Int,
+    )
+
+    private data class Entry(val mangasPage: MangasPage, val expiresAtMillis: Long)
+
+    companion object {
+        private val CACHE_DURATION = 5.minutes
+    }
+}
