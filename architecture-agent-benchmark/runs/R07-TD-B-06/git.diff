diff --git a/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt b/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt
new file mode 100644
index 0000000..22c6513
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt
@@ -0,0 +1,39 @@
+package tachiyomi.data.source
+
+import eu.kanade.tachiyomi.source.model.MangasPage
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.time.Clock
+import kotlin.time.Duration.Companion.minutes
+
+/**
+ * In-memory cache of browse-source listing pages (popular/latest/search), so that
+ * repeating the same listing shortly after fetching it (e.g. navigating back to the
+ * browse screen, or re-scrolling through pages) doesn't hit the network again.
+ */
+class SourceListingCache {
+
+    private data class Key(val sourceId: Long, val listingKey: String, val page: Int)
+    private class Entry(val mangasPage: MangasPage, val timestamp: Long)
+
+    private val cache = ConcurrentHashMap<Key, Entry>()
+
+    fun get(sourceId: Long, listingKey: String, page: Int): MangasPage? {
+        val entry = cache[Key(sourceId, listingKey, page)] ?: return null
+        if (Clock.System.now().toEpochMilliseconds() - entry.timestamp > CACHE_TTL_MILLIS) {
+            return null
+        }
+        return entry.mangasPage
+    }
+
+    fun put(sourceId: Long, listingKey: String, page: Int, mangasPage: MangasPage) {
+        cache[Key(sourceId, listingKey, page)] = Entry(mangasPage, Clock.System.now().toEpochMilliseconds())
+    }
+
+    fun invalidate(sourceId: Long, listingKey: String) {
+        cache.keys.removeIf { it.sourceId == sourceId && it.listingKey == listingKey }
+    }
+
+    companion object {
+        private val CACHE_TTL_MILLIS = 5.minutes.inWholeMilliseconds
+    }
+}
