@@ -0,0 +1,98 @@
+package tachiyomi.domain.source.repository
+
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.MangasPage
+import eu.kanade.tachiyomi.source.model.SManga
+import io.kotest.matchers.shouldBe
+import io.kotest.matchers.types.shouldNotBeSameInstanceAs
+import kotlinx.coroutines.test.runTest
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+
+class SourceBrowseCacheTest {
+
+    private lateinit var cache: SourceBrowseCache
+    private var clock = 0L
+
+    @BeforeEach
+    fun beforeEach() {
+        cache = SourceBrowseCache()
+        clock = 0L
+        cache.nowMillis = { clock }
+    }
+
+    private fun page(marker: String) = MangasPage(listOf(SManga.create().apply { url = marker }), false)
+
+    @Test
+    fun `repeated identical request within TTL does not refetch`() = runTest {
+        var fetchCount = 0
+        suspend fun fetch() = page("a").also { fetchCount++ }
+
+        val first = cache.getOrPut(1, "search", "query", emptyList(), page = 1, forceRefresh = false) { fetch() }
+        clock += 1_000
+        val second = cache.getOrPut(1, "search", "query", emptyList(), page = 1, forceRefresh = false) { fetch() }
+
+        fetchCount shouldBe 1
+        second shouldBe first
+    }
+
+    @Test
+    fun `different pages of the same search are cached independently`() = runTest {
+        val fetched = mutableListOf<Int>()
+        suspend fun fetch(p: Int) = page("page$p").also { fetched.add(p) }
+
+        val page1 = cache.getOrPut(1, "search", "query", emptyList(), page = 1, forceRefresh = false) { fetch(1) }
+        val page2 = cache.getOrPut(1, "search", "query", emptyList(), page = 2, forceRefresh = false) { fetch(2) }
+        // Re-requesting page 1 must not return page 2's result, and must not refetch.
+        val page1Again = cache.getOrPut(1, "search", "query", emptyList(), page = 1, forceRefresh = false) { fetch(1) }
+
+        fetched shouldBe listOf(1, 2)
+        page1Again shouldBe page1
+        page1Again shouldNotBeSameInstanceAs page2
+    }
+
+    @Test
+    fun `different query, filters, source or type do not share a cache entry`() = runTest {
+        var fetchCount = 0
+        suspend fun fetch() = page("x").also { fetchCount++ }
+
+        cache.getOrPut(1, "search", "one", emptyList(), page = 1, forceRefresh = false) { fetch() }
+        cache.getOrPut(1, "search", "two", emptyList(), page = 1, forceRefresh = false) { fetch() }
+        cache.getOrPut(2, "search", "one", emptyList(), page = 1, forceRefresh = false) { fetch() }
+        cache.getOrPut(1, "popular", "one", emptyList(), page = 1, forceRefresh = false) { fetch() }
+        val filterA = listOf<Filter<*>>(object : Filter.CheckBox("genre") {})
+        val filterB = listOf<Filter<*>>(object : Filter.CheckBox("genre", state = true) {})
+        cache.getOrPut(1, "search", "one", filterA, page = 1, forceRefresh = false) { fetch() }
+        cache.getOrPut(1, "search", "one", filterB, page = 1, forceRefresh = false) { fetch() }
+
+        fetchCount shouldBe 6
+    }
+
+    @Test
+    fun `entry expires after ttl and is refetched`() = runTest {
+        var fetchCount = 0
+        suspend fun fetch() = page("a").also { fetchCount++ }
+
+        cache.getOrPut(1, "popular", "", emptyList(), page = 1, forceRefresh = false) { fetch() }
+        clock += 5.minutesInMillis() + 1
+        cache.getOrPut(1, "popular", "", emptyList(), page = 1, forceRefresh = false) { fetch() }
+
+        fetchCount shouldBe 2
+    }
+
+    @Test
+    fun `forceRefresh bypasses the cache and overwrites it`() = runTest {
+        var fetchCount = 0
+        suspend fun fetch() = page("fetch$fetchCount").also { fetchCount++ }
+
+        val first = cache.getOrPut(1, "popular", "", emptyList(), page = 1, forceRefresh = false) { fetch() }
+        val forced = cache.getOrPut(1, "popular", "", emptyList(), page = 1, forceRefresh = true) { fetch() }
+        val afterForce = cache.getOrPut(1, "popular", "", emptyList(), page = 1, forceRefresh = false) { fetch() }
+
+        fetchCount shouldBe 2
+        forced shouldNotBeSameInstanceAs first
+        afterForce shouldBe forced
+    }
+
+    private fun Int.minutesInMillis() = this * 60_000L
+}
