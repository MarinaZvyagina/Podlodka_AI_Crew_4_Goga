diff --git a/domain/src/main/java/tachiyomi/domain/source/repository/SourceBrowseCache.kt b/domain/src/main/java/tachiyomi/domain/source/repository/SourceBrowseCache.kt
new file mode 100644
index 0000000..73ed792
--- /dev/null
+++ b/domain/src/main/java/tachiyomi/domain/source/repository/SourceBrowseCache.kt
@@ -0,0 +1,60 @@
+package tachiyomi.domain.source.repository
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.MangasPage
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.time.Clock
+import kotlin.time.Duration.Companion.minutes
+
+/**
+ * Caches paged results of source browsing (popular/latest listings and searches) so that
+ * repeating an identical request shortly after fetches nothing from the network.
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourceBrowseCache {
+
+    // Test seam: overridden in tests to control expiry without real delays.
+    internal var nowMillis: () -> Long = { Clock.System.now().toEpochMilliseconds() }
+
+    private data class Key(
+        val sourceId: Long,
+        val type: String,
+        val query: String,
+        val filters: List<Filter<*>>,
+        val page: Int,
+    )
+
+    private class Entry(val mangasPage: MangasPage, val cachedAt: Long)
+
+    private val entries = ConcurrentHashMap<Key, Entry>()
+
+    suspend fun getOrPut(
+        sourceId: Long,
+        type: String,
+        query: String,
+        filters: List<Filter<*>>,
+        page: Int,
+        forceRefresh: Boolean,
+        fetch: suspend () -> MangasPage,
+    ): MangasPage {
+        val key = Key(sourceId, type, query, filters, page)
+        val now = nowMillis()
+
+        if (!forceRefresh) {
+            entries[key]?.let { cached ->
+                if (now - cached.cachedAt < EXPIRY_MILLIS) return cached.mangasPage
+                entries.remove(key, cached)
+            }
+        }
+
+        return fetch().also { entries[key] = Entry(it, now) }
+    }
+
+    companion object {
+        private val EXPIRY_MILLIS = 5.minutes.inWholeMilliseconds
+    }
+}
