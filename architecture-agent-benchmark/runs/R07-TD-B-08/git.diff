diff --git a/data/src/main/java/tachiyomi/data/source/SourceMangaPageCache.kt b/data/src/main/java/tachiyomi/data/source/SourceMangaPageCache.kt
new file mode 100644
index 0000000..c9291e2
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourceMangaPageCache.kt
@@ -0,0 +1,55 @@
+package tachiyomi.data.source
+
+import android.util.LruCache
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.FilterList
+import eu.kanade.tachiyomi.source.model.MangasPage
+import kotlin.time.Clock
+import kotlin.time.Duration.Companion.minutes
+import kotlin.time.Instant
+
+/**
+ * Short-lived cache of [MangasPage] results keyed by source + listing + filters + page, so that
+ * repeating the same browse/search request shortly after (e.g. navigating back to a screen)
+ * doesn't hit the network again.
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourceMangaPageCache {
+
+    private data class Key(
+        val sourceId: Long,
+        val listing: String,
+        val filtersHash: Int,
+        val page: Int,
+    )
+
+    private data class Entry(val mangasPage: MangasPage, val savedAt: Instant)
+
+    private val cache = LruCache<Key, Entry>(CACHE_SIZE)
+
+    fun get(sourceId: Long, listing: String, filters: FilterList, page: Int): MangasPage? {
+        val key = key(sourceId, listing, filters, page)
+        val entry = cache[key] ?: return null
+        if (Clock.System.now() - entry.savedAt > CACHE_TTL) {
+            cache.remove(key)
+            return null
+        }
+        return entry.mangasPage
+    }
+
+    fun put(sourceId: Long, listing: String, filters: FilterList, page: Int, mangasPage: MangasPage) {
+        cache.put(key(sourceId, listing, filters, page), Entry(mangasPage, Clock.System.now()))
+    }
+
+    private fun key(sourceId: Long, listing: String, filters: FilterList, page: Int): Key {
+        return Key(sourceId, listing, filters.list.hashCode(), page)
+    }
+
+    companion object {
+        private const val CACHE_SIZE = 60
+        private val CACHE_TTL = 5.minutes
+    }
+}
