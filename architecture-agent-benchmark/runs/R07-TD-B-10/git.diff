diff --git a/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt b/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt
new file mode 100644
index 0000000..135db75
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt
@@ -0,0 +1,52 @@
+package tachiyomi.data.source
+
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.MangasPage
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.time.Clock
+import kotlin.time.Duration.Companion.minutes
+
+/**
+ * In-memory cache of source listing pages (popular/latest/search) so that re-entering the
+ * same listing shortly after a previous fetch doesn't hit the network again.
+ */
+object SourceListingCache {
+
+    private val expiryMs = 5.minutes.inWholeMilliseconds
+
+    private val entries = ConcurrentHashMap<Key, Entry>()
+
+    fun get(key: Key): MangasPage? {
+        val entry = entries[key] ?: return null
+        if (Clock.System.now().toEpochMilliseconds() - entry.timestamp > expiryMs) {
+            entries.remove(key)
+            return null
+        }
+        return entry.mangasPage
+    }
+
+    fun put(key: Key, mangasPage: MangasPage) {
+        entries[key] = Entry(mangasPage, Clock.System.now().toEpochMilliseconds())
+    }
+
+    /**
+     * Drops any cached pages for the given listing so the next fetch goes to the network.
+     */
+    fun invalidate(sourceId: Long, type: Type, query: String, filters: List<Filter<*>>) {
+        entries.keys.removeIf {
+            it.sourceId == sourceId && it.type == type && it.query == query && it.filters == filters
+        }
+    }
+
+    data class Key(
+        val sourceId: Long,
+        val type: Type,
+        val query: String,
+        val filters: List<Filter<*>>,
+        val page: Int,
+    )
+
+    enum class Type { Popular, Latest, Search }
+
+    private data class Entry(val mangasPage: MangasPage, val timestamp: Long)
+}
