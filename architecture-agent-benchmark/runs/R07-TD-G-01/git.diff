diff --git a/data/src/test/java/tachiyomi/data/source/SourcePagingCacheTest.kt b/data/src/test/java/tachiyomi/data/source/SourcePagingCacheTest.kt
new file mode 100644
index 0000000..49ebf1a
--- /dev/null
+++ b/data/src/test/java/tachiyomi/data/source/SourcePagingCacheTest.kt
@@ -0,0 +1,158 @@
+package tachiyomi.data.source
+
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.MangasPage
+import eu.kanade.tachiyomi.source.model.SManga
+import io.kotest.matchers.shouldBe
+import io.kotest.matchers.shouldNotBe
+import kotlinx.coroutines.test.runTest
+import org.junit.jupiter.api.Test
+
+class SourcePagingCacheTest {
+
+    private fun mangasPage(name: String) = MangasPage(
+        mangas = listOf(SManga.create().apply { title = name }),
+        hasNextPage = false,
+    )
+
+    private class TestCheckBoxFilter(name: String, state: Boolean = false) : Filter.CheckBox(name, state)
+
+    @Test
+    fun `returns cached result for an identical request`() = runTest {
+        val cache = SourcePagingCache()
+        var fetchCount = 0
+
+        val first = cache.getOrPut(1L, SourcePagingCache.Type.SEARCH, "query", emptyList(), 1, bypassCache = false) {
+            fetchCount++
+            mangasPage("first")
+        }
+        val second = cache.getOrPut(1L, SourcePagingCache.Type.SEARCH, "query", emptyList(), 1, bypassCache = false) {
+            fetchCount++
+            mangasPage("second")
+        }
+
+        fetchCount shouldBe 1
+        second shouldBe first
+    }
+
+    @Test
+    fun `treats structurally equal filters as the same request despite different list instances`() = runTest {
+        val cache = SourcePagingCache()
+        var fetchCount = 0
+        val fetch: suspend () -> MangasPage = {
+            fetchCount++
+            mangasPage("result")
+        }
+
+        cache.getOrPut(
+            1L,
+            SourcePagingCache.Type.SEARCH,
+            "query",
+            listOf(TestCheckBoxFilter("genre", true)),
+            1,
+            false,
+            fetch,
+        )
+        cache.getOrPut(
+            1L,
+            SourcePagingCache.Type.SEARCH,
+            "query",
+            listOf(TestCheckBoxFilter("genre", true)),
+            1,
+            false,
+            fetch,
+        )
+
+        fetchCount shouldBe 1
+    }
+
+    @Test
+    fun `different filters are cached separately`() = runTest {
+        val cache = SourcePagingCache()
+        var fetchCount = 0
+        val fetch: suspend () -> MangasPage = {
+            fetchCount++
+            mangasPage("result")
+        }
+
+        cache.getOrPut(
+            1L,
+            SourcePagingCache.Type.SEARCH,
+            "query",
+            listOf(TestCheckBoxFilter("genre", true)),
+            1,
+            false,
+            fetch,
+        )
+        cache.getOrPut(
+            1L,
+            SourcePagingCache.Type.SEARCH,
+            "query",
+            listOf(TestCheckBoxFilter("genre", false)),
+            1,
+            false,
+            fetch,
+        )
+
+        fetchCount shouldBe 2
+    }
+
+    @Test
+    fun `different pages of the same query are cached independently`() = runTest {
+        val cache = SourcePagingCache()
+
+        val page1 = cache.getOrPut(1L, SourcePagingCache.Type.POPULAR, "", emptyList(), 1, false) {
+            mangasPage("page1")
+        }
+        val page2 = cache.getOrPut(1L, SourcePagingCache.Type.POPULAR, "", emptyList(), 2, false) {
+            mangasPage("page2")
+        }
+        val page1Again = cache.getOrPut(1L, SourcePagingCache.Type.POPULAR, "", emptyList(), 1, false) {
+            mangasPage("should not be called")
+        }
+
+        page1.mangas.first().title shouldBe "page1"
+        page2.mangas.first().title shouldBe "page2"
+        page1Again shouldBe page1
+        page1 shouldNotBe page2
+    }
+
+    @Test
+    fun `bypassCache always refetches and refreshes the cached value`() = runTest {
+        val cache = SourcePagingCache()
+        var fetchCount = 0
+
+        cache.getOrPut(1L, SourcePagingCache.Type.LATEST, "", emptyList(), 1, false) {
+            fetchCount++
+            mangasPage("stale")
+        }
+        val refreshed = cache.getOrPut(1L, SourcePagingCache.Type.LATEST, "", emptyList(), 1, bypassCache = true) {
+            fetchCount++
+            mangasPage("fresh")
+        }
+        val afterRefresh = cache.getOrPut(1L, SourcePagingCache.Type.LATEST, "", emptyList(), 1, bypassCache = false) {
+            fetchCount++
+            mangasPage("should not be called")
+        }
+
+        fetchCount shouldBe 2
+        refreshed.mangas.first().title shouldBe "fresh"
+        afterRefresh shouldBe refreshed
+    }
+
+    @Test
+    fun `different sources and listing types are cached independently`() = runTest {
+        val cache = SourcePagingCache()
+        var fetchCount = 0
+        val fetch: suspend () -> MangasPage = {
+            fetchCount++
+            mangasPage("result")
+        }
+
+        cache.getOrPut(1L, SourcePagingCache.Type.POPULAR, "", emptyList(), 1, false, fetch)
+        cache.getOrPut(2L, SourcePagingCache.Type.POPULAR, "", emptyList(), 1, false, fetch)
+        cache.getOrPut(1L, SourcePagingCache.Type.LATEST, "", emptyList(), 1, false, fetch)
+
+        fetchCount shouldBe 3
+    }
+}
