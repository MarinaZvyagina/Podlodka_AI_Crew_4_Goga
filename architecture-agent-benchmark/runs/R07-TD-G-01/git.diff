--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourcePagingCache.kt
@@ -0,0 +1,76 @@
+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.MangasPage
+import kotlin.time.Duration.Companion.minutes
+
+/**
+ * Short-lived in-memory cache for source browse/search results (popular, latest and search
+ * listings), keyed by source, listing type, query, filters and page. Lets repeating the same
+ * request shortly afterwards (e.g. navigating back to a previous search, or paging through
+ * results) reuse the previous response instead of hitting the network again.
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourcePagingCache {
+
+    enum class Type { POPULAR, LATEST, SEARCH }
+
+    private data class Key(
+        val sourceId: Long,
+        val type: Type,
+        val query: String,
+        val filters: List<Filter<*>>,
+        val page: Int,
+    )
+
+    private class Entry(val mangasPage: MangasPage, val timestamp: Long)
+
+    // Access-ordered so the least-recently-used entry is evicted once the cache grows too large.
+    private val entries = object : LinkedHashMap<Key, Entry>(0, 0.75f, true) {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<Key, Entry>): Boolean {
+            return size > MAX_ENTRIES
+        }
+    }
+
+    /**
+     * Returns the cached result for this request, fetching and caching it via [fetch] on a
+     * cache miss, expiry, or when [bypassCache] is true (e.g. a user-initiated refresh).
+     */
+    suspend fun getOrPut(
+        sourceId: Long,
+        type: Type,
+        query: String,
+        filters: List<Filter<*>>,
+        page: Int,
+        bypassCache: Boolean,
+        fetch: suspend () -> MangasPage,
+    ): MangasPage {
+        val key = Key(sourceId, type, query, filters, page)
+        if (!bypassCache) {
+            get(key)?.let { return it }
+        }
+        val result = fetch()
+        synchronized(entries) { entries[key] = Entry(result, System.currentTimeMillis()) }
+        return result
+    }
+
+    private fun get(key: Key): MangasPage? {
+        synchronized(entries) {
+            val entry = entries[key] ?: return null
+            if (System.currentTimeMillis() - entry.timestamp > CACHE_DURATION.inWholeMilliseconds) {
+                entries.remove(key)
+                return null
+            }
+            return entry.mangasPage
+        }
+    }
+
+    companion object {
+        private const val MAX_ENTRIES = 300
+        private val CACHE_DURATION = 5.minutes
+    }
+}
