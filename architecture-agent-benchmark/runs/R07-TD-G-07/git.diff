diff --git a/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt b/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt
new file mode 100644
index 0000000..0da2c40
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt
@@ -0,0 +1,67 @@
+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.FilterList
+import eu.kanade.tachiyomi.source.model.MangasPage
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.time.Clock
+import kotlin.time.Duration.Companion.minutes
+
+/**
+ * Caches paged listing results (popular/latest/search) per source so that repeating an
+ * identical request shortly after a previous one doesn't hit the network again.
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourceListingCache {
+
+    private data class Key(
+        val sourceId: Long,
+        val query: String,
+        val filters: FilterList,
+        val page: Int,
+    )
+
+    private data class Entry(
+        val mangasPage: MangasPage,
+        val fetchedAt: Long,
+    )
+
+    private val cache = ConcurrentHashMap<Key, Entry>()
+
+    suspend fun getOrPut(
+        sourceId: Long,
+        query: String,
+        filters: FilterList,
+        page: Int,
+        forceRefresh: Boolean,
+        fetch: suspend () -> MangasPage,
+    ): MangasPage {
+        val key = Key(sourceId, query, filters, page)
+
+        if (forceRefresh) {
+            invalidate(sourceId, query, filters)
+        } else {
+            val cached = cache[key]
+            if (cached != null && !isExpired(cached.fetchedAt)) {
+                return cached.mangasPage
+            }
+        }
+
+        return fetch().also { cache[key] = Entry(it, Clock.System.now().toEpochMilliseconds()) }
+    }
+
+    private fun invalidate(sourceId: Long, query: String, filters: FilterList) {
+        cache.keys.removeAll { it.sourceId == sourceId && it.query == query && it.filters == filters }
+    }
+
+    private fun isExpired(fetchedAt: Long): Boolean {
+        return Clock.System.now().toEpochMilliseconds() - fetchedAt > EXPIRY.inWholeMilliseconds
+    }
+
+    companion object {
+        private val EXPIRY = 5.minutes
+    }
+}
