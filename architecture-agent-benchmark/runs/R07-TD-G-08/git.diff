diff --git a/data/src/main/java/tachiyomi/data/source/SourcePagingSourceCache.kt b/data/src/main/java/tachiyomi/data/source/SourcePagingSourceCache.kt
new file mode 100644
index 0000000..f1e9878
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourcePagingSourceCache.kt
@@ -0,0 +1,74 @@
+package tachiyomi.data.source
+
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.FilterList
+import eu.kanade.tachiyomi.source.model.MangasPage
+
+/**
+ * Caches [MangasPage] results per source listing (popular, latest, or a search + filter
+ * combination) so that repeating the same request shortly after returns the previous result
+ * instead of hitting the network again. Lives for the process lifetime, independent of any
+ * particular Pager/PagingSource instance, since those are recreated on every new search or
+ * screen visit.
+ */
+object SourcePagingSourceCache {
+
+    private const val EXPIRY_MILLIS = 5 * 60 * 1000L
+    private const val MAX_ENTRIES = 300
+
+    private data class Key(val sourceId: Long, val listingKey: String, val page: Long)
+
+    private class Entry(val mangasPage: MangasPage, val expiresAt: Long)
+
+    private val entries = object : LinkedHashMap<Key, Entry>(16, 0.75f, true) {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<Key, Entry>): Boolean {
+            return size > MAX_ENTRIES
+        }
+    }
+
+    /**
+     * Returns the cached page for [sourceId]/[listingKey]/[page] if it exists and hasn't
+     * expired, otherwise runs [fetch], caches the result, and returns it.
+     */
+    suspend fun getOrFetch(sourceId: Long, listingKey: String, page: Long, fetch: suspend () -> MangasPage): MangasPage {
+        get(sourceId, listingKey, page)?.let { return it }
+        val result = fetch()
+        put(sourceId, listingKey, page, result)
+        return result
+    }
+
+    /** Discards every cached page for [sourceId], forcing the next requests to hit the network. */
+    @Synchronized
+    fun invalidate(sourceId: Long) {
+        entries.keys.removeAll { it.sourceId == sourceId }
+    }
+
+    @Synchronized
+    private fun get(sourceId: Long, listingKey: String, page: Long): MangasPage? {
+        val key = Key(sourceId, listingKey, page)
+        val entry = entries[key] ?: return null
+        if (System.currentTimeMillis() >= entry.expiresAt) {
+            entries.remove(key)
+            return null
+        }
+        return entry.mangasPage
+    }
+
+    @Synchronized
+    private fun put(sourceId: Long, listingKey: String, page: Long, mangasPage: MangasPage) {
+        entries[Key(sourceId, listingKey, page)] = Entry(mangasPage, System.currentTimeMillis() + EXPIRY_MILLIS)
+    }
+
+    /** Stable key describing a query + filter combination, used to distinguish searches. */
+    fun listingKeyFor(query: String, filters: FilterList): String {
+        return "search|$query|${filters.joinToString("|") { it.stateKey() }}"
+    }
+
+    private fun Filter<*>.stateKey(): String {
+        val stateString = when (val s = state) {
+            is List<*> -> s.joinToString(",") { element -> (element as? Filter<*>)?.stateKey() ?: element.toString() }
+            else -> s.toString()
+        }
+        return "$name:$stateString"
+    }
+}
