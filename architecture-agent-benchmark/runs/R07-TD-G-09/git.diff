+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.MangasPage
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.time.Clock
+import kotlin.time.Duration.Companion.minutes
+import kotlin.time.Instant
+
+/**
+ * In-memory cache of [MangasPage] results keyed by the request that produced them, so that
+ * repeating the same source listing (popular/latest/search) shortly after it was last fetched
+ * doesn't hit the network again. Entries expire after [ENTRY_LIFETIME].
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourcePagingCache {
+
+    // Overridable by tests so expiry can be exercised without real sleeps.
+    internal var now: () -> Instant = { Clock.System.now() }
+
+    private val entries = ConcurrentHashMap<Key, Entry>()
+
+    fun get(sourceId: Long, listing: String, query: String, filters: List<Filter<*>>, page: Int): MangasPage? {
+        val key = Key(sourceId, listing, query, filters, page)
+        val entry = entries[key] ?: return null
+        if (now() >= entry.expiresAt) {
+            entries.remove(key)
+            return null
+        }
+        return entry.mangasPage
+    }
+
+    fun put(
+        sourceId: Long,
+        listing: String,
+        query: String,
+        filters: List<Filter<*>>,
+        page: Int,
+        mangasPage: MangasPage,
+    ) {
+        val key = Key(sourceId, listing, query, filters, page)
+        entries[key] = Entry(mangasPage, now() + ENTRY_LIFETIME)
+    }
+
+    /**
+     * Drops every cached page for the given listing so the next request for it fetches fresh
+     * results, e.g. when the user explicitly asks for a reload.
+     */
+    fun invalidate(sourceId: Long, listing: String, query: String, filters: List<Filter<*>>) {
+        entries.keys.removeAll {
+            it.sourceId == sourceId && it.listing == listing && it.query == query &&
+                it.filters == filters
+        }
+    }
+
+    private data class Key(
+        val sourceId: Long,
+        val listing: String,
+        val query: String,
+        val filters: List<Filter<*>>,
+        val page: Int,
+    )
+
+    private data class Entry(val mangasPage: MangasPage, val expiresAt: Instant)
+
+    companion object {
+        private val ENTRY_LIFETIME = 5.minutes
+    }
+}
