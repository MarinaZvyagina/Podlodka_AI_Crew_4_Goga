diff --git a/data/src/test/java/tachiyomi/data/source/SourcePagingCacheTest.kt b/data/src/test/java/tachiyomi/data/source/SourcePagingCacheTest.kt
new file mode 100644
index 0000000..c76b1fe
--- /dev/null
+++ b/data/src/test/java/tachiyomi/data/source/SourcePagingCacheTest.kt
@@ -0,0 +1,128 @@
+package tachiyomi.data.source
+
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.MangasPage
+import eu.kanade.tachiyomi.source.model.SManga
+import io.kotest.matchers.nulls.beNull
+import io.kotest.matchers.nulls.shouldNotBeNull
+import io.kotest.matchers.should
+import org.junit.jupiter.api.Test
+import kotlin.time.Clock
+import kotlin.time.Duration.Companion.minutes
+
+class SourcePagingCacheTest {
+
+    private val page = MangasPage(mangas = listOf(SManga.create().apply { url = "/manga" }), hasNextPage = true)
+
+    private class TestFilter(state: Boolean) : Filter.CheckBox("genre", state)
+
+    @Test
+    fun `returns a previously cached page for an identical request`() {
+        val cache = SourcePagingCache()
+
+        cache.put(
+            sourceId = 1L,
+            listing = "search",
+            query = "one piece",
+            filters = emptyList(),
+            page = 1,
+            mangasPage = page,
+        )
+
+        cache.get(sourceId = 1L, listing = "search", query = "one piece", filters = emptyList(), page = 1)
+            .shouldNotBeNull()
+    }
+
+    @Test
+    fun `misses when any part of the request differs`() {
+        val cache = SourcePagingCache()
+        cache.put(
+            sourceId = 1L,
+            listing = "search",
+            query = "one piece",
+            filters = emptyList(),
+            page = 1,
+            mangasPage = page,
+        )
+
+        cache.get(sourceId = 2L, listing = "search", query = "one piece", filters = emptyList(), page = 1) should
+            beNull()
+        cache.get(sourceId = 1L, listing = "popular", query = "one piece", filters = emptyList(), page = 1) should
+            beNull()
+        cache.get(sourceId = 1L, listing = "search", query = "naruto", filters = emptyList(), page = 1) should beNull()
+        cache.get(sourceId = 1L, listing = "search", query = "one piece", filters = emptyList(), page = 2) should
+            beNull()
+        cache.get(
+            sourceId = 1L,
+            listing = "search",
+            query = "one piece",
+            filters = listOf(TestFilter(true)),
+            page = 1,
+        ) should
+            beNull()
+    }
+
+    @Test
+    fun `distinguishes requests by filter state`() {
+        val cache = SourcePagingCache()
+        cache.put(
+            sourceId = 1L,
+            listing = "search",
+            query = "",
+            filters = listOf(TestFilter(true)),
+            page = 1,
+            mangasPage = page,
+        )
+
+        cache.get(sourceId = 1L, listing = "search", query = "", filters = listOf(TestFilter(true)), page = 1)
+            .shouldNotBeNull()
+        cache.get(sourceId = 1L, listing = "search", query = "", filters = listOf(TestFilter(false)), page = 1) should
+            beNull()
+    }
+
+    @Test
+    fun `expires entries after their lifetime elapses`() {
+        val cache = SourcePagingCache()
+        val start = Clock.System.now()
+        cache.now = { start }
+
+        cache.put(sourceId = 1L, listing = "popular", query = "", filters = emptyList(), page = 1, mangasPage = page)
+        cache.get(sourceId = 1L, listing = "popular", query = "", filters = emptyList(), page = 1)
+            .shouldNotBeNull()
+
+        cache.now = { start + 5.minutes }
+
+        cache.get(sourceId = 1L, listing = "popular", query = "", filters = emptyList(), page = 1) should beNull()
+    }
+
+    @Test
+    fun `invalidate drops cached pages only for the matching listing`() {
+        val cache = SourcePagingCache()
+        cache.put(
+            sourceId = 1L,
+            listing = "search",
+            query = "one piece",
+            filters = emptyList(),
+            page = 1,
+            mangasPage = page,
+        )
+        cache.put(
+            sourceId = 1L,
+            listing = "search",
+            query = "one piece",
+            filters = emptyList(),
+            page = 2,
+            mangasPage = page,
+        )
+        cache.put(sourceId = 1L, listing = "popular", query = "", filters = emptyList(), page = 1, mangasPage = page)
+
+        cache.invalidate(sourceId = 1L, listing = "search", query = "one piece", filters = emptyList())
+
+        cache.get(sourceId = 1L, listing = "search", query = "one piece", filters = emptyList(), page = 1) should
+            beNull()
+        cache.get(sourceId = 1L, listing = "search", query = "one piece", filters = emptyList(), page = 2) should
+            beNull()
+        cache.get(sourceId = 1L, listing = "popular", query = "", filters = emptyList(), page = 1)
+            .shouldNotBeNull()
+    }
+}
