+  /**
+   * Marks [media] to skip the batch's compression pass and send as-is, or reverts it back to the batch default at
+   * [MediaSendFlowState.sentMediaQuality]. Unlike [setSentMediaQuality], this touches only the one item.
+   *
+   * Cancels any pre-upload already running or finished for [media], so a stale copy compressed under the old setting
+   * is never what gets sent. The item is not re-uploaded immediately: like other edits made here (trim, mute), the
+   * final send re-uploads anything left uncovered, using [MediaSendFlowState.selectedMedia] as it stands at that
+   * point -- which is where this change actually lives, since it is written into the item's own transform properties
+   * and so rides along with the rest of the selection through [SavedStateHandle] persistence.
+   */
+  private fun toggleItemFullQuality(media: Media) {
+    val snapshot = state.value
+    val current = snapshot.selectedMedia.firstOrNull { it.uri == media.uri } ?: return
+    val isFullQuality = current.transformProperties?.shouldSkipTransform() == true
+    val updated = current.copy(
+      transformProperties = (current.transformProperties ?: TransformProperties.empty()).copy(skipTransform = !isFullQuality)
+    )
+
+    updateState {
+      copy(selectedMedia = selectedMedia.map { if (it.uri == updated.uri) updated else it })
+    }
+
+    preUploadController.cancelUpload(updated)
+
+    internalToastEvents.trySend(
+      ToastEvent(
+        icon = if (!isFullQuality) SignalIcons.CheckCircle else SignalIcons.Check,
+        message = ToastMessage.Text(
+          if (!isFullQuality) R.string.MediaSendViewModel__item_set_to_full_quality else R.string.MediaSendViewModel__item_set_to_standard_quality
+        )
+      )
+    )
+  }
+
