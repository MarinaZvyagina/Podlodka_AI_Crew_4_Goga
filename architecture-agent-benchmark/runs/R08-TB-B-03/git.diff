+package org.thoughtcrime.securesms.mediasend;
+
+import android.content.Context;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.WorkerThread;
+
+import org.signal.core.models.media.Media;
+import org.signal.core.models.media.TransformProperties;
+
+import java.util.Optional;
+
+/**
+ * Marks the transformed media to skip the normal compression pass entirely, so it is delivered at its
+ * full/original quality instead of whatever {@link org.signal.mediasend.SentMediaQuality} the rest of the batch is
+ * using. Safe to use in a pipeline with other transforms: composing it after another transform preserves that
+ * transform's work (an edit's rendered pixels, a video's trim) while still skipping the size-driven compression
+ * pass that would otherwise run afterward.
+ */
+public final class FullQualityMediaTransform implements MediaTransform {
+
+  @WorkerThread
+  @Override
+  public @NonNull Media transform(@NonNull Context context, @NonNull Media media) {
+    TransformProperties existing = Optional.ofNullable(media.getTransformProperties()).orElse(TransformProperties.empty());
+
+    return new Media(media.getUri(),
+                     media.getContentType(),
+                     media.getDate(),
+                     media.getWidth(),
+                     media.getHeight(),
+                     media.getSize(),
+                     media.getDuration(),
+                     media.isBorderless(),
+                     media.isVideoGif(),
+                     media.getBucketId(),
+                     media.getCaption(),
+                     existing.withSkipTransform(),
+                     media.getFileName());
+  }
+}
