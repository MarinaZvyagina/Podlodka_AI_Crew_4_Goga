+  /**
+   * Marks (or unmarks) a single [media] item to be sent at its original quality, skipping compression for it alone
+   * regardless of the batch-wide [MediaSendFlowState.sentMediaQuality].
+   *
+   * If the item has already started (or finished) a background pre-upload, that upload is canceled and, once the
+   * change is persisted, restarted so the correct bytes are the ones actually sent. Since the override lives on
+   * [Media.transformProperties] -- which becomes the pre-uploaded attachment row's own `transform_properties` column --
+   * it is read back from the database rather than kept only in memory, so it survives the app being killed mid-send.
+   */
+  fun setItemFullQuality(media: Media, fullQuality: Boolean) {
+    mutateSelection {
+      val snapshot = state.value
+      val existing = snapshot.selectedMedia.firstOrNull { it.uri == media.uri } ?: return@mutateSelection
+      if ((existing.transformProperties?.skipTransform ?: false) == fullQuality) return@mutateSelection
+
+      val updatedTransformProperties = (existing.transformProperties ?: TransformProperties.empty()).copy(skipTransform = fullQuality)
+      val updatedMediaItem = existing.copy(transformProperties = updatedTransformProperties)
+
+      val newSelection = snapshot.selectedMedia.map { if (it.uri == media.uri) updatedMediaItem else it }
+      val newFocus = if (snapshot.focusedMedia?.uri == media.uri) updatedMediaItem else snapshot.focusedMedia
+
+      updateState { copy(selectedMedia = newSelection, focusedMedia = newFocus) }
+
+      // The bytes already pre-uploaded (if any) no longer match: cancel that upload and, if we still pre-upload at
+      // all, restart it with the new transform properties. If pre-upload is off, the send itself will pick this
+      // item's transform properties up fresh, same as any other unedited item.
+      preUploadController.cancelUpload(existing)
+      if (snapshot.isPreUploadEnabled) {
+        preUploadController.startUpload(updatedMediaItem, snapshot.recipientId)
+      }
+
+      itemFullQualityToastEvent(fullQuality, updatedMediaItem)?.let { internalToastEvents.trySend(it) }
+    }
+  }
+
+  /**
+   * Copy confirming a single item was marked (or unmarked) for original quality. Null for anything that is neither a
+   * video nor an image, which there is nothing to say about.
+   */
+  private fun itemFullQualityToastEvent(fullQuality: Boolean, media: Media): ToastEvent? {
+    val message = when {
+      isNonGifVideo(media) -> ToastMessage.Text(
+        if (fullQuality) R.string.MediaReviewFragment__video_set_to_original_quality else R.string.MediaReviewFragment__video_will_be_compressed
+      )
+
+      ContentTypeUtil.isImageType(media.contentType) -> ToastMessage.Text(
+        if (fullQuality) R.string.MediaReviewFragment__photo_set_to_original_quality else R.string.MediaReviewFragment__photo_will_be_compressed
+      )
+
+      else -> {
+        Log.i(TAG, "No quality confirmation for an attachment of type: ${media.contentType}")
+        return null
+      }
+    }
+
+    return ToastEvent(
+      icon = if (fullQuality) SignalIcons.QualityHigh else SignalIcons.QualityHighSlash,
+      message = message
+    )
+  }
+
   //endregion
 
   //region Video Editing
