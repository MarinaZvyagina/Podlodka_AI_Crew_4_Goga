+  /**
+   * Marks the focused item to be sent in full/original quality, overriding [MediaSendFlowState.sentMediaQuality] for
+   * just that one attachment -- the rest of the batch keeps compressing as usual. Toggling this off restores the
+   * batch default for the item.
+   *
+   * The override is applied to the item's [Media.transformProperties] via [TransformProperties.forSkipTransform],
+   * which [org.thoughtcrime.securesms.jobs.AttachmentCompressionJob] already honors ahead of the quality tier, so no
+   * further plumbing is needed once an attachment is built from it.
+   *
+   * A pre-upload for this item may already be running or finished at the batch's default quality, so any existing
+   * pre-upload is canceled and restarted from the original media with the override applied -- mirroring how editing a
+   * video's trim or mute state invalidates its pre-upload. The choice itself lives in [MediaSendFlowState], which is
+   * persisted via [SavedStateHandle], so it is not lost if the app is killed before the user taps send.
+   */
+  private fun toggleFullQuality() {
+    val snapshot = state.value
+    val uri = snapshot.focusedMedia?.uri ?: return
+    val media = snapshot.selectedMedia.firstOrNull { it.uri == uri } ?: return
+    val isNowFullQuality = uri !in snapshot.fullQualityOverrides
+    val updatedMedia = media.copy(transformProperties = if (isNowFullQuality) TransformProperties.forSkipTransform() else null)
+
+    updateState {
+      copy(
+        fullQualityOverrides = if (isNowFullQuality) fullQualityOverrides + uri else fullQualityOverrides - uri,
+        selectedMedia = selectedMedia.map { if (it.uri == uri) updatedMedia else it },
+        focusedMedia = if (focusedMedia?.uri == uri) updatedMedia else focusedMedia
+      )
+    }
+
+    if (snapshot.isPreUploadEnabled) {
+      preUploadController.startUpload(listOf(updatedMedia), snapshot.recipientId)
+    }
+
+    fullQualityToastEvent(isNowFullQuality, media)?.let { internalToastEvents.trySend(it) }
+  }
+
+  /**
+   * Copy confirming [media]'s full-quality override changed, naming whether it is a photo or video. Null for anything
+   * else, which there is nothing type-specific to say about.
+   */
+  private fun fullQualityToastEvent(isNowFullQuality: Boolean, media: Media): ToastEvent? {
+    val message = when {
+      isNonGifVideo(media) -> ToastMessage.Text(
+        if (isNowFullQuality) R.string.MediaSendViewModel__video_will_be_sent_in_full_quality else R.string.MediaSendViewModel__video_will_be_sent_at_default_quality
+      )
+
+      ContentTypeUtil.isImageType(media.contentType) -> ToastMessage.Text(
+        if (isNowFullQuality) R.string.MediaSendViewModel__photo_will_be_sent_in_full_quality else R.string.MediaSendViewModel__photo_will_be_sent_at_default_quality
+      )
+
+      else -> {
+        Log.i(TAG, "No full-quality confirmation for an attachment of type: ${media.contentType}")
+        return null
+      }
+    }
+
+    return ToastEvent(
+      icon = if (isNowFullQuality) SignalIcons.QualityHigh else SignalIcons.QualityHighSlash,
+      message = message
+    )
+  }
+
   //endregion
 
