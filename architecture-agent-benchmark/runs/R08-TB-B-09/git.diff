+  /**
+   * Toggles [TransformProperties.skipTransform] on the focused item only, overriding the batch's compression for just
+   * that one attachment. This is stored directly on the item's own [Media], the same place a caption or file name
+   * lives, so it rides along through [SavedStateHandle] persistence and the send pipeline without any separate
+   * plumbing.
+   *
+   * The item's pre-upload (if any) is canceled so that a send which already started compressing -- or already
+   * finished uploading -- it will redo the work rather than ship the version it already produced. Un-uploaded items
+   * pick up the change the first time they are uploaded, since nothing has run for them yet.
+   */
+  private fun toggleFullQualityOverride() {
+    mutateSelection {
+      val snapshot = state.value
+      val uri = snapshot.focusedMedia?.uri ?: return@mutateSelection
+      val existing = snapshot.selectedMedia.firstOrNull { it.uri == uri } ?: return@mutateSelection
+      val isNowFullQuality = existing.transformProperties?.skipTransform != true
+
+      val updated = existing.copy(
+        transformProperties = (existing.transformProperties ?: TransformProperties.empty()).copy(skipTransform = isNowFullQuality)
+      )
+
+      updateState {
+        copy(
+          selectedMedia = selectedMedia.map { if (it.uri == uri) updated else it },
+          focusedMedia = if (focusedMedia?.uri == uri) updated else focusedMedia
+        )
+      }
+
+      internalToastEvents.trySend(
+        ToastEvent(
+          icon = if (isNowFullQuality) SignalIcons.QualityHigh else SignalIcons.QualityHighSlash,
+          message = ToastMessage.Text(
+            if (isNowFullQuality) R.string.MediaSendViewModel__item_set_to_full_quality else R.string.MediaSendViewModel__item_removed_from_full_quality
+          )
+        )
+      )
+
+      preUploadController.cancelUpload(existing)
+    }
+  }
+
   //endregion
 
