+  /**
+   * Marks (or unmarks) the focused item to be sent in full quality -- no compression pass at all -- overriding the
+   * batch [MediaSendFlowState.sentMediaQuality] just for that one item. The rest of the batch is unaffected.
+   *
+   * The updated [TransformProperties] land on the item's [Media] in [MediaSendFlowState.selectedMedia], which is what
+   * flows into the attachment row (and from there into the persisted compression job) whether or not that item has
+   * already started uploading, so an in-flight pre-upload for it is canceled and restarted with the new choice rather
+   * than left to finish uncompressed-or-not by chance.
+   */
+  private fun toggleFullQuality() {
+    mutateSelection {
+      val snapshot = state.value
+      val uri = snapshot.focusedMedia?.uri ?: return@mutateSelection
+      val media = snapshot.selectedMedia.firstOrNull { it.uri == uri } ?: return@mutateSelection
+
+      val enabling = media.transformProperties?.skipTransform != true
+      val updatedMedia = media.copy(
+        transformProperties = (media.transformProperties ?: TransformProperties.empty()).withSkipTransform(enabling)
+      )
+
+      updateState {
+        copy(
+          selectedMedia = selectedMedia.map { if (it.uri == uri) updatedMedia else it },
+          focusedMedia = if (focusedMedia?.uri == uri) updatedMedia else focusedMedia
+        )
+      }
+
+      if (snapshot.isPreUploadEnabled) {
+        preUploadController.startUpload(listOf(updatedMedia), snapshot.recipientId)
+      }
+
+      if (enabling) {
+        internalToastEvents.trySend(
+          ToastEvent(
+            icon = SignalIcons.QualityHigh,
+            message = ToastMessage.Text(
+              if (isNonGifVideo(media)) R.string.MediaReviewFragment__video_set_to_full_quality else R.string.MediaReviewFragment__photo_set_to_full_quality
+            )
+          )
+        )
+      }
+    }
+  }
+
   /**
    * Updates video trim duration.
    */
