+package org.thoughtcrime.securesms.mediasend;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.WorkerThread;
+
+import android.content.Context;
+
+import org.signal.core.models.media.Media;
+import org.signal.core.models.media.TransformProperties;
+
+/**
+ * Forces {@link TransformProperties#skipTransform} to true on the transformed media. Applied last in a pipeline of
+ * transforms so that a per-item "send in full quality" choice survives other transforms (e.g. an image edit) that
+ * would otherwise replace {@link TransformProperties} with a fresh, unflagged instance.
+ */
+public final class SkipTransformMediaTransform implements MediaTransform {
+
+  @WorkerThread
+  @Override
+  public @NonNull Media transform(@NonNull Context context, @NonNull Media media) {
+    TransformProperties existing = media.getTransformProperties();
+    TransformProperties updated = existing != null ? existing.withSkipTransform(true) : TransformProperties.empty().withSkipTransform(true);
+
+    return new Media(media.getUri(),
+                      media.getContentType(),
+                      media.getDate(),
+                      media.getWidth(),
+                      media.getHeight(),
+                      media.getSize(),
+                      media.getDuration(),
+                      media.isBorderless(),
+                      media.isVideoGif(),
+                      media.getBucketId(),
+                      media.getCaption(),
+                      updated,
+                      media.getFileName());
+  }
+}
