+   * the [SavedStateHandle]-backed state and survives the process dying mid-send exactly as the rest of the selection
+   * does.
+   */
+  private fun toggleFullQualityOverride(media: Media) {
+    mutateSelection {
+      val snapshot = state.value
+      val current = snapshot.selectedMedia.firstOrNull { it.uri == media.uri } ?: return@mutateSelection
+      val wasOverridden = current.isFullQualityOverridden
+
+      val updated = current.copy(
+        transformProperties = if (wasOverridden) null else TransformProperties.forSentMediaQuality(SentMediaQuality.HIGH.code)
