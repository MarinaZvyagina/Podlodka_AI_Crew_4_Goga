+
+      updateState { copy(selectedMedia = selectedMedia.map { if (it.uri == updated.uri) updated else it }) }
+
+      val storySendRequirements = repository.getStorySendRequirements(listOf(updated))
+      startUpload(listOf(updated), storySendRequirements)
+
+      qualityToastEvent(if (wasOverridden) SentMediaQuality.STANDARD else SentMediaQuality.HIGH, listOf(updated))?.let { internalToastEvents.trySend(it) }
