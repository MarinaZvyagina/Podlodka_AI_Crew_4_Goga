+/**
+ * Creates TransformProperties with the compression pass skipped entirely, preserving existing properties. Used to
+ * send a single item at full/original quality, overriding whatever batch-wide quality would otherwise apply to it.
+ */
+fun transformPropertiesForFullQuality(currentProperties: Optional<TransformProperties>): TransformProperties {
+  val existing = currentProperties.orElse(TransformProperties.empty())
+  return existing.copy(skipTransform = true)
+}
