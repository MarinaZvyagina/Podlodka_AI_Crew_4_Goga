+package org.thoughtcrime.securesms.mediasend;
+
+import android.content.Context;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.WorkerThread;
+
+import org.signal.core.models.media.Media;
+import org.signal.core.models.media.TransformProperties;
+
+/**
+ * Marks {@link TransformProperties#skipTransform} on the transformed media, so the attachment is sent as-is instead of
+ * going through the normal compression pass. Safe to use in a pipeline with other transforms.
+ */
+public final class SkipTransformMediaTransform implements MediaTransform {
+
+  @WorkerThread
+  @Override
+  public @NonNull Media transform(@NonNull Context context, @NonNull Media media) {
+    TransformProperties existing = media.getTransformProperties();
+    TransformProperties updated  = (existing != null ? existing : TransformProperties.empty()).withSkipTransform();
+
+    return new Media(media.getUri(),
+                      media.getContentType(),
+                      media.getDate(),
+                      media.getWidth(),
+                      media.getHeight(),
+                      media.getSize(),
+                      media.getDuration(),
+                      media.isBorderless(),
+                      media.isVideoGif(),
+                      media.getBucketId(),
+                      media.getCaption(),
+                      updated,
+                      media.getFileName());
+  }
+}
