+  /**
+   * Like [deleteAbandonedAttachmentFiles], but processes at most [batchSize] on-disk files per call instead of the whole directory, resuming
+   * from [cursor] (the last file path considered by a prior call, sorted lexicographically). This lets a full sweep make forward progress across
+   * many small invocations instead of one long-running pass, so it can be interrupted (e.g. process death) and continued later without starting over.
+   *
+   * @return the cursor to pass into the next call to keep sweeping, or null if every file on disk has now been considered.
+   */
+  fun deleteAbandonedAttachmentFilesBatch(cursor: String?, batchSize: Int): AbandonedFileSweepResult {
+    val allFiles: List<String> = context.getDir(DIRECTORY, Context.MODE_PRIVATE)
+      .listFiles()
+      ?.filter { file: File -> !PartFileProtector.isProtected(file) }
+      ?.map { file: File -> file.absolutePath }
+      ?.sorted()
+      ?: return AbandonedFileSweepResult(deletedCount = 0, nextCursor = null)
+
+    val remaining: List<String> = if (cursor != null) allFiles.filter { it > cursor } else allFiles
+    if (remaining.isEmpty()) {
+      return AbandonedFileSweepResult(deletedCount = 0, nextCursor = null)
+    }
+
+    val batch: List<String> = remaining.take(batchSize)
+
+    val filesInDb: MutableSet<String> = HashSet()
+    readableDatabase.withinTransaction { db ->
+      db.select(DATA_FILE, THUMBNAIL_FILE)
+        .from(TABLE_NAME)
+        .run()
+        .forEach { cursorRow ->
+          cursorRow.requireString(DATA_FILE)?.let { filesInDb += it }
+          cursorRow.requireString(THUMBNAIL_FILE)?.let { filesInDb += it }
+        }
+    }
+    filesInDb += SignalDatabase.stickers.getAllStickerFiles()
+
+    var deletedCount = 0
+    for (filePath in batch) {
+      if (filePath !in filesInDb) {
+        if (File(filePath).delete()) {
+          deletedCount++
+        } else {
+          Log.w(TAG, "[deleteAbandonedAttachmentFilesBatch] Failed to delete attachment file. $filePath")
+        }
+      }
+    }
+
+    val nextCursor: String? = if (batch.size < remaining.size) batch.last() else null
+    return AbandonedFileSweepResult(deletedCount, nextCursor)
+  }
+
+  data class AbandonedFileSweepResult(val deletedCount: Int, val nextCursor: String?)
+
