+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.jobs
+
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+import org.thoughtcrime.securesms.keyvalue.SignalStore
+import kotlin.time.Duration.Companion.days
+
+/**
+ * Periodically sweeps the attachment directory for thumbnail/attachment files that no longer correspond to any attachment in the database (e.g. because
+ * the attachment or its message was deleted) and deletes them.
+ *
+ * A sweep is done in small batches (see [deleteAbandonedAttachmentFilesBatch]) rather than all at once. Each run processes one batch and, if there's more
+ * left to check, enqueues another instance of itself carrying a cursor to resume from. Because that continuation is a normal, durably-persisted job, a
+ * sweep that gets interrupted partway (e.g. the process is killed) picks back up from its last completed batch the next time this job gets a chance to
+ * run, rather than rescanning everything or losing its place entirely.
+ */
+class ThumbnailCleanupJob private constructor(
+  private var cursor: String?,
+  parameters: Parameters
+) : Job(parameters) {
+
+  companion object {
+    private val TAG = Log.tag(ThumbnailCleanupJob::class)
+
+    const val KEY = "ThumbnailCleanupJob"
+
+    private const val QUEUE = "ThumbnailCleanupJob"
+    private const val BATCH_SIZE = 500
+    private val CLEANUP_INTERVAL = 3.days
+
+    /**
+     * Kicks off a routine sweep if enough time has passed since the last one finished. Safe to call as often as needed (e.g. every time the app is
+     * foregrounded) — [Parameters.Builder.setMaxInstancesForQueue] ensures this is a no-op while a sweep (or its resumption) is already pending.
+     */
+    @JvmStatic
+    fun enqueueRoutineCleanupIfNecessary() {
+      val timeSinceLastCleanup = System.currentTimeMillis() - SignalStore.misc.lastThumbnailCleanupTime
+      if (timeSinceLastCleanup < CLEANUP_INTERVAL.inWholeMilliseconds) {
+        Log.d(TAG, "Too soon to sweep again. Last full sweep finished $timeSinceLastCleanup ms ago.")
+        return
+      }
+
+      AppDependencies.jobManager.add(ThumbnailCleanupJob(cursor = null))
+    }
+  }
+
+  private constructor(cursor: String?) : this(
+    cursor = cursor,
+    parameters = Parameters.Builder()
+      .setQueue(QUEUE)
+      .setMaxInstancesForQueue(1)
+      .setMaxAttempts(Parameters.UNLIMITED)
+      .setLifespan(Parameters.IMMORTAL)
+      .setGlobalPriority(Parameters.PRIORITY_LOWER)
+      .addConstraint(NotInCallConstraint.KEY)
+      .addConstraint(BatteryNotLowConstraint.KEY)
+      .build()
+  )
+
+  override fun serialize(): ByteArray? = cursor?.toByteArray()
+
+  override fun getFactoryKey(): String = KEY
+
+  override fun onFailure() = Unit
+
+  override fun run(): Result {
+    val result = SignalDatabase.attachments.deleteAbandonedAttachmentFilesBatch(cursor, BATCH_SIZE)
+    Log.i(TAG, "Deleted ${result.deletedCount} abandoned file(s) this batch.")
+
+    if (result.nextCursor != null) {
+      AppDependencies.jobManager.add(ThumbnailCleanupJob(cursor = result.nextCursor))
+    } else {
+      SignalStore.misc.lastThumbnailCleanupTime = System.currentTimeMillis()
+      Log.i(TAG, "Finished a full sweep.")
+    }
+
+    return Result.success()
+  }
+
+  class Factory : Job.Factory<ThumbnailCleanupJob> {
+    override fun create(parameters: Parameters, serializedData: ByteArray?): ThumbnailCleanupJob {
+      return ThumbnailCleanupJob(serializedData?.decodeToString(), parameters)
+    }
+  }
+}
