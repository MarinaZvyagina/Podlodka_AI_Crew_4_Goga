+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.jobs
+
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+import org.thoughtcrime.securesms.keyvalue.SignalStore
+import kotlin.time.Duration.Companion.days
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * Periodically scans the attachment/thumbnail file store for files that no longer correspond to any attachment, message, or
+ * sticker still in the app, and deletes them.
+ *
+ * This runs forever, in small resumable batches, re-adding itself after each batch. That keeps any single run short (so it
+ * doesn't compete with user-facing work) and means that if the app process dies mid-pass, the next attempt picks up right
+ * after the last successfully-processed file (via [org.thoughtcrime.securesms.keyvalue.MiscellaneousValues.orphanedAttachmentCleanupCursor])
+ * rather than rescanning everything or losing progress permanently.
+ *
+ * Once a full pass finishes, the job goes dormant until [PASS_INTERVAL] has elapsed before starting the next one.
+ */
+class OrphanedThumbnailCleanupJob private constructor(parameters: Parameters) : Job(parameters) {
+
+  companion object {
+    private val TAG = Log.tag(OrphanedThumbnailCleanupJob::class)
+
+    const val KEY = "OrphanedThumbnailCleanupJob"
+
+    /** How many candidate files we consider (and query the database for) in a single run. */
+    private const val BATCH_SIZE = 500
+
+    /** Gap between batches while a pass is actively in progress, so we don't hammer the disk. */
+    private val BATCH_DELAY = 5.seconds.inWholeMilliseconds
+
+    /** How long to wait after finishing a full pass before starting the next one. */
+    private val PASS_INTERVAL = 1.days.inWholeMilliseconds
+
+    @JvmStatic
+    fun enqueueIfNeeded() {
+      AppDependencies.jobManager.add(OrphanedThumbnailCleanupJob(buildParameters()))
+    }
+
+    private fun buildParameters(initialDelay: Long = 0): Parameters {
+      return Parameters.Builder()
+        .setQueue(KEY)
+        .setMaxInstancesForFactory(2)
+        .setMaxAttempts(10)
+        .setLifespan(Parameters.IMMORTAL)
+        .addConstraint(NotInCallConstraint.KEY)
+        .addConstraint(BatteryNotLowConstraint.KEY)
+        .setGlobalPriority(Parameters.PRIORITY_LOWER)
+        .setInitialDelay(initialDelay)
+        .build()
+    }
+  }
+
+  constructor() : this(buildParameters())
+
+  override fun serialize(): ByteArray? = null
+
+  override fun getFactoryKey(): String = KEY
+
+  override fun run(): Result {
+    val now = System.currentTimeMillis()
+    val cursor = SignalStore.misc.orphanedAttachmentCleanupCursor
+
+    if (cursor == null && SignalStore.misc.nextOrphanedAttachmentCleanupTime > now) {
+      reschedule(SignalStore.misc.nextOrphanedAttachmentCleanupTime - now)
+      return Result.success()
+    }
+
+    val result = try {
+      SignalDatabase.attachments.deleteAbandonedAttachmentFilesBatch(afterPath = cursor, batchSize = BATCH_SIZE)
+    } catch (e: Exception) {
+      Log.w(TAG, "Failed to process a batch of orphaned attachment files. Retrying.", e)
+      return Result.retry(defaultBackoff())
+    }
+
+    if (result.deletedCount > 0) {
+      Log.i(TAG, "Deleted ${result.deletedCount} orphaned attachment/thumbnail files.")
+    }
+
+    if (result.finishedPass) {
+      SignalStore.misc.orphanedAttachmentCleanupCursor = null
+      SignalStore.misc.nextOrphanedAttachmentCleanupTime = now + PASS_INTERVAL
+      reschedule(PASS_INTERVAL)
+    } else {
+      SignalStore.misc.orphanedAttachmentCleanupCursor = result.lastProcessedPath
+      reschedule(BATCH_DELAY)
+    }
+
+    return Result.success()
+  }
+
+  override fun onFailure() {
+    Log.w(TAG, "Job failed. Re-enqueuing to continue from the last saved checkpoint.", true)
+    reschedule(BATCH_DELAY)
+  }
+
+  private fun reschedule(delay: Long) {
+    AppDependencies.jobManager.add(OrphanedThumbnailCleanupJob(buildParameters(delay)))
+  }
+
+  class Factory : Job.Factory<OrphanedThumbnailCleanupJob> {
+    override fun create(parameters: Parameters, serializedData: ByteArray?): OrphanedThumbnailCleanupJob {
+      return OrphanedThumbnailCleanupJob(parameters)
+    }
+  }
+}
