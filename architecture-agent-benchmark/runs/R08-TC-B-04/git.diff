+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.migrations
+
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobs.OrphanedThumbnailCleanupJob
+import java.lang.Exception
+
+/**
+ * Kicks off the perpetual [OrphanedThumbnailCleanupJob] chain. The job re-enqueues itself forever after this, so this only
+ * needs to run once per install/upgrade.
+ */
+internal class OrphanedThumbnailCleanupMigrationJob(parameters: Parameters = Parameters.Builder().build()) : MigrationJob(parameters) {
+
+  companion object {
+    val TAG = Log.tag(OrphanedThumbnailCleanupMigrationJob::class)
+    const val KEY = "OrphanedThumbnailCleanupMigrationJob"
+  }
+
+  override fun getFactoryKey(): String = KEY
+
+  override fun isUiBlocking(): Boolean = false
+
+  override fun performMigration() {
+    OrphanedThumbnailCleanupJob.enqueueIfNeeded()
+  }
+
+  override fun shouldRetry(e: Exception): Boolean = false
+
+  class Factory : Job.Factory<OrphanedThumbnailCleanupMigrationJob> {
+    override fun create(parameters: Parameters, serializedData: ByteArray?): OrphanedThumbnailCleanupMigrationJob {
+      return OrphanedThumbnailCleanupMigrationJob(parameters)
+    }
+  }
+}
