+  /**
+   * Incremental, resumable variant of [deleteAbandonedAttachmentFiles] intended for a periodic background cleanup pass over a
+   * potentially very large [DIRECTORY]. Rather than diffing the entire directory against the entire table in one shot, this
+   * processes at most [batchSize] files whose absolute path sorts after [afterPath], deleting the ones with no surviving
+   * attachment/thumbnail/sticker reference.
+   *
+   * Callers are expected to persist [BatchDeleteResult.lastProcessedPath] as the next [afterPath] so that a pass can be resumed
+   * after being interrupted (e.g. process death) instead of restarting from the beginning of the directory.
+   */
+  fun deleteAbandonedAttachmentFilesBatch(afterPath: String?, batchSize: Int): BatchDeleteResult {
+    val diskFiles = context.getDir(DIRECTORY, Context.MODE_PRIVATE).listFiles() ?: return BatchDeleteResult(deletedCount = 0, lastProcessedPath = null, finishedPass = true)
+
+    val candidates: List<File> = diskFiles
+      .filter { file -> !PartFileProtector.isProtected(file) }
+      .filter { file -> afterPath == null || file.absolutePath > afterPath }
+      .sortedBy { file -> file.absolutePath }
+
+    if (candidates.isEmpty()) {
+      return BatchDeleteResult(deletedCount = 0, lastProcessedPath = null, finishedPass = true)
+    }
+
+    val batch = candidates.take(batchSize)
+    val batchPaths = batch.map { it.absolutePath }
+
+    val filesInDb: MutableSet<String> = mutableSetOf()
+    val dataFileQuery = SqlUtil.buildFastCollectionQuery(DATA_FILE, batchPaths)
+    val thumbnailFileQuery = SqlUtil.buildFastCollectionQuery(THUMBNAIL_FILE, batchPaths)
+
+    readableDatabase
+      .select(DATA_FILE, THUMBNAIL_FILE)
+      .from(TABLE_NAME)
+      .where("(${dataFileQuery.where}) OR (${thumbnailFileQuery.where})", dataFileQuery.whereArgs + thumbnailFileQuery.whereArgs)
+      .run()
+      .forEach { cursor ->
+        cursor.requireString(DATA_FILE)?.let { filesInDb += it }
+        cursor.requireString(THUMBNAIL_FILE)?.let { filesInDb += it }
+      }
+
+    filesInDb += SignalDatabase.stickers.getAllStickerFiles()
+
+    var deletedCount = 0
+    for (file in batch) {
+      if (file.absolutePath !in filesInDb) {
+        if (file.delete()) {
+          deletedCount++
+        } else {
+          Log.w(TAG, "[deleteAbandonedAttachmentFilesBatch] Failed to delete attachment file. ${file.absolutePath}")
+        }
+      }
+    }
+
+    return BatchDeleteResult(
+      deletedCount = deletedCount,
+      lastProcessedPath = batch.last().absolutePath,
+      finishedPass = batch.size == candidates.size
+    )
+  }
+
+  /**
+   * @param lastProcessedPath The absolute path of the last file considered in this batch, or null if there was nothing to process.
+   * @param finishedPass True if this batch reached the end of the directory, i.e. there is no more work left in the current pass.
+   */
+  data class BatchDeleteResult(
+    val deletedCount: Int,
+    val lastProcessedPath: String?,
+    val finishedPass: Boolean
+  )
