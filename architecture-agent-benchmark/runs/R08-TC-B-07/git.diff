+
+package org.thoughtcrime.securesms.jobs
+
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.SignalDatabase.Companion.attachments
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+
+/**
+ * Periodically scans attachment storage for thumbnail/preview and data files that no longer belong to any
+ * attachment or message, and deletes them. This is scheduled on a recurring basis by [org.thoughtcrime.securesms.service.OrphanedAttachmentFileCleanupAlarmListener]
+ * so that files orphaned by deletions that don't otherwise trigger cleanup (e.g. an individual message
+ * delete) don't accumulate indefinitely.
+ *
+ * Runs at the lowest priority and only when the device is not on an active call and battery is not
+ * critically low, so it never competes with anything the user is actively doing.
+ *
+ * Work is done in bounded batches: each run deletes at most [BATCH_SIZE] files and, if orphans remain,
+ * re-enqueues itself for another batch. Because already-deleted files simply disappear from future scans,
+ * a run that gets killed partway through (e.g. process death) loses no progress -- the next attempt, whether
+ * a re-enqueued batch or the next scheduled alarm, picks up wherever the previous one left off rather than
+ * rescanning work that's already done or stalling forever.
+ */
+class OrphanedAttachmentFileCleanupJob private constructor(parameters: Parameters) : Job(parameters) {
+
+  companion object {
+    private val TAG = Log.tag(OrphanedAttachmentFileCleanupJob::class)
+    const val KEY = "OrphanedAttachmentFileCleanupJob"
+
+    private const val BATCH_SIZE = 500
+
+    @JvmStatic
+    fun enqueue() {
+      AppDependencies.jobManager.add(OrphanedAttachmentFileCleanupJob())
+    }
+  }
+
+  constructor() : this(
+    parameters = Parameters.Builder()
+      .setQueue(KEY)
+      .setMaxInstancesForFactory(2)
+      .setLifespan(Parameters.IMMORTAL)
+      .setMaxAttempts(10)
+      .setGlobalPriority(Parameters.PRIORITY_LOWER)
+      .addConstraint(BatteryNotLowConstraint.KEY)
+      .addConstraint(NotInCallConstraint.KEY)
+      .build()
+  )
+
+  override fun serialize(): ByteArray? = null
+  override fun getFactoryKey(): String = KEY
+  override fun onFailure() = Unit
+
+  override fun run(): Result {
+    val result = attachments.deleteAbandonedAttachmentFiles(BATCH_SIZE)
+    Log.i(TAG, "Deleted ${result.filesDeleted} orphaned attachment file(s). ${result.remainingOrphans} remaining.")
+
+    // Only chain into another batch if we made forward progress; otherwise a handful of
+    // permanently undeletable files would cause this to spin forever. If anything is left over,
+    // the next scheduled alarm will pick it back up.
+    if (result.filesDeleted > 0 && result.remainingOrphans > 0) {
+      AppDependencies.jobManager.add(OrphanedAttachmentFileCleanupJob())
+    }
+
+    return Result.success()
+  }
+
+  class Factory : Job.Factory<OrphanedAttachmentFileCleanupJob> {
+    override fun create(parameters: Parameters, serializedData: ByteArray?): OrphanedAttachmentFileCleanupJob {
+      return OrphanedAttachmentFileCleanupJob(parameters)
+    }
+  }
+}
