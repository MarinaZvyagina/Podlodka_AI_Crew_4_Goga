+  /**
+   * Checks a single batch (up to [batchSize] files, in a stable sorted order) of the on-disk attachment/thumbnail
+   * cache for files with no matching [DATA_FILE]/[THUMBNAIL_FILE] row, deleting any that are found. Pass the
+   * [AbandonedAttachmentFileBatchResult.nextCursor] from a prior call back in as [afterCursor] to continue where
+   * that call left off, so a sweep of a large parts directory makes steady forward progress across many
+   * invocations instead of needing to scan the entire directory in one go.
+   *
+   * A `null` [AbandonedAttachmentFileBatchResult.nextCursor] means the full directory has now been checked.
+   */
+  fun deleteAbandonedAttachmentFilesBatch(batchSize: Int, afterCursor: String?): AbandonedAttachmentFileBatchResult {
+    val sortedDiskFiles = context.getDir(DIRECTORY, Context.MODE_PRIVATE).listFiles()?.sortedBy { it.name } ?: return AbandonedAttachmentFileBatchResult(deletedCount = 0, nextCursor = null)
+
+    val startIndex = if (afterCursor != null) {
+      sortedDiskFiles.indexOfFirst { it.name > afterCursor }.let { if (it == -1) sortedDiskFiles.size else it }
+    } else {
+      0
+    }
+
+    if (startIndex >= sortedDiskFiles.size) {
+      return AbandonedAttachmentFileBatchResult(deletedCount = 0, nextCursor = null)
+    }
+
+    val batch = sortedDiskFiles.subList(startIndex, minOf(startIndex + batchSize, sortedDiskFiles.size))
+    val filesInDb = getFilesReferencedInDatabase()
+
+    var deleteCount = 0
+    for (file in batch) {
+      if (PartFileProtector.isProtected(file) || file.absolutePath in filesInDb) {
+        continue
+      }
+
+      if (file.delete()) {
+        deleteCount++
+      } else {
+        Log.w(TAG, "[deleteAbandonedAttachmentFilesBatch] Failed to delete attachment file. ${file.absolutePath}")
+      }
+    }
+
+    val reachedEnd = startIndex + batch.size >= sortedDiskFiles.size
+    return AbandonedAttachmentFileBatchResult(
+      deletedCount = deleteCount,
+      nextCursor = if (reachedEnd) null else batch.last().name
+    )
+  }
