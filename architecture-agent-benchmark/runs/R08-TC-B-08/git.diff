+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.jobs
+
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.SignalDatabase.Companion.attachments
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.JsonJobData
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+import org.thoughtcrime.securesms.keyvalue.SignalStore
+import kotlin.time.Duration.Companion.days
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * Periodically sweeps the on-disk attachment/thumbnail cache for files that no longer correspond to any
+ * attachment or message in the database (e.g. because the attachment or the message that referenced it was
+ * deleted) and deletes them.
+ *
+ * The sweep is done in bounded batches: each run checks one batch of files and, if more remain, saves its place
+ * and retries itself. That saved cursor is persisted along with the job, so getting killed mid-sweep (which
+ * happens routinely on Android) just means the next attempt continues from where the last one left off instead
+ * of rescanning the whole directory or never finishing.
+ *
+ * This is lower priority than anything the user is actively doing, so it backs off while a call is connected or
+ * the battery is critically low.
+ */
+class ThumbnailCacheCleanupJob private constructor(
+  parameters: Parameters,
+  private var cursor: String?
+) : Job(parameters) {
+
+  companion object {
+    private val TAG = Log.tag(ThumbnailCacheCleanupJob::class)
+
+    const val KEY = "ThumbnailCacheCleanupJob"
+
+    private const val QUEUE = "ThumbnailCacheCleanupJob"
+    private const val KEY_CURSOR = "cursor"
+    private const val BATCH_SIZE = 200
+    private val SCAN_INTERVAL = 3.days
+    private val RETRY_DELAY = 5.seconds
+
+    /**
+     * Enqueues a sweep if enough time has passed since the last one. Intended to be called on every app start so
+     * the cleanup happens on a recurring cadence without any user action, rather than just once after an update.
+     */
+    @JvmStatic
+    fun scheduleIfNecessary() {
+      val nextScheduledScan = SignalStore.misc.nextThumbnailCacheCleanupTime
+
+      if (nextScheduledScan <= System.currentTimeMillis()) {
+        Log.i(TAG, "Scheduling a thumbnail cache cleanup sweep.")
+        AppDependencies.jobManager.add(ThumbnailCacheCleanupJob())
+        SignalStore.misc.nextThumbnailCacheCleanupTime = System.currentTimeMillis() + SCAN_INTERVAL.inWholeMilliseconds
+      }
+    }
+  }
+
+  constructor() : this(
+    parameters = Parameters.Builder()
+      .setQueue(QUEUE)
+      .setMaxInstancesForFactory(1)
+      .setMaxAttempts(Parameters.UNLIMITED)
+      .setLifespan(SCAN_INTERVAL.inWholeMilliseconds)
+      .addConstraint(NotInCallConstraint.KEY)
+      .addConstraint(BatteryNotLowConstraint.KEY)
+      .build(),
+    cursor = null
+  )
+
+  override fun serialize(): ByteArray? {
+    return JsonJobData.Builder()
+      .putString(KEY_CURSOR, cursor)
+      .build()
+      .serialize()
+  }
+
+  override fun getFactoryKey(): String = KEY
+
+  override fun onFailure() = Unit
+
+  override fun run(): Result {
+    val batchResult = attachments.deleteAbandonedAttachmentFilesBatch(BATCH_SIZE, cursor)
+
+    if (batchResult.deletedCount > 0) {
+      Log.i(TAG, "Deleted ${batchResult.deletedCount} abandoned attachment/thumbnail files.")
+    }
+
+    if (batchResult.nextCursor == null) {
+      Log.i(TAG, "Finished thumbnail cache cleanup sweep.")
+      return Result.success()
+    }
+
+    cursor = batchResult.nextCursor
+    return Result.retry(RETRY_DELAY.inWholeMilliseconds)
+  }
+
+  class Factory : Job.Factory<ThumbnailCacheCleanupJob> {
+    override fun create(parameters: Parameters, serializedData: ByteArray?): ThumbnailCacheCleanupJob {
+      val data = JsonJobData.deserialize(serializedData)
+      return ThumbnailCacheCleanupJob(parameters, data.getStringOrDefault(KEY_CURSOR, null))
+    }
+  }
+}
