+package org.thoughtcrime.securesms.service
+
+import android.content.Context
+import org.thoughtcrime.securesms.jobs.DeleteAbandonedAttachmentsJob
+import org.thoughtcrime.securesms.keyvalue.SignalStore
+import org.thoughtcrime.securesms.util.toMillis
+import java.security.SecureRandom
+import java.time.LocalDateTime
+
+/**
+ * Schedules a sweep for abandoned attachment/thumbnail files to happen once a day, independent of app updates
+ * or of any particular attachment/message being deleted, so a backlog of orphaned files is eventually cleaned
+ * up even on a device that's otherwise idle.
+ */
+class DeleteAbandonedAttachmentsAlarmListener : PersistentAlarmManagerListener() {
+  companion object {
+    @JvmStatic
+    fun schedule(context: Context?) {
+      DeleteAbandonedAttachmentsAlarmListener().onReceive(context, getScheduleIntent())
+    }
+  }
+
+  override fun getNextScheduledExecutionTime(context: Context): Long {
+    var nextTime = SignalStore.misc.nextAbandonedAttachmentSweepTime
+
+    if (nextTime == 0L) {
+      nextTime = getNextTime()
+      SignalStore.misc.nextAbandonedAttachmentSweepTime = nextTime
+    }
+
+    return nextTime
+  }
+
+  override fun onAlarm(context: Context, scheduledTime: Long): Long {
+    DeleteAbandonedAttachmentsJob.enqueue()
+
+    val nextTime = getNextTime()
+    SignalStore.misc.nextAbandonedAttachmentSweepTime = nextTime
+
+    return nextTime
+  }
+
+  private fun getNextTime(): Long {
+    val random = SecureRandom()
+    return LocalDateTime
+      .now()
+      .plusDays(1)
+      .withHour(2 + random.nextInt(3))
+      .withMinute(random.nextInt(60))
+      .withSecond(random.nextInt(60))
+      .toMillis()
+  }
+}
