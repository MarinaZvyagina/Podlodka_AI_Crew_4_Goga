+package org.thoughtcrime.securesms.service
+
+import android.content.Context
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.jobs.DeleteAbandonedAttachmentsJob
+import org.thoughtcrime.securesms.keyvalue.SignalStore
+import java.util.concurrent.TimeUnit
+
+/**
+ * Schedules a sweep for abandoned attachment/thumbnail files to happen roughly once a day, so they get cleaned up
+ * even if none of the app's other opportunistic triggers (e.g. deleting a thread) happen to run.
+ */
+class DeleteAbandonedAttachmentsAlarmListener : PersistentAlarmManagerListener() {
+  companion object {
+    private val INTERVAL = TimeUnit.DAYS.toMillis(1)
+
+    @JvmStatic
+    fun schedule(context: Context?) {
+      DeleteAbandonedAttachmentsAlarmListener().onReceive(context, getScheduleIntent())
+    }
+  }
+
+  override fun getNextScheduledExecutionTime(context: Context): Long {
+    return SignalStore.misc.nextAbandonedAttachmentCleanupTime
+  }
+
+  override fun onAlarm(context: Context, scheduledTime: Long): Long {
+    AppDependencies.jobManager.add(DeleteAbandonedAttachmentsJob())
+
+    val newTime = System.currentTimeMillis() + INTERVAL
+    SignalStore.misc.nextAbandonedAttachmentCleanupTime = newTime
+
+    return newTime
+  }
+}
