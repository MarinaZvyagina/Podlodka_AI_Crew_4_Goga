+  /**
+   * Like [deleteAbandonedAttachmentFiles], but only checks a single batch of on-disk files per call instead of the whole directory.
+   * Callers should keep passing the returned [AbandonedAttachmentFileBatchResult.lastCheckedFileName] back in as [afterFileName] until
+   * [AbandonedAttachmentFileBatchResult.isFinished] comes back true, at which point the whole directory has been checked and a new pass
+   * can start over from the beginning (i.e. `afterFileName = null`).
+   *
+   * This exists so that a caller doing a slow crawl of a potentially huge number of files can be interrupted (e.g. process death) and
+   * resume from where it left off on the next attempt, rather than restarting the whole directory scan or never finishing.
+   */
+  fun deleteAbandonedAttachmentFilesBatch(afterFileName: String?, limit: Int): AbandonedAttachmentFileBatchResult {
+    val diskFiles = context.getDir(DIRECTORY, Context.MODE_PRIVATE).listFiles() ?: return AbandonedAttachmentFileBatchResult(deletedCount = 0, lastCheckedFileName = null, isFinished = true)
+
+    val sortedCandidates: List<String> = diskFiles
+      .filter { file: File -> !PartFileProtector.isProtected(file) }
+      .map { file: File -> file.absolutePath }
+      .sorted()
+
+    val startIndex = if (afterFileName != null) {
+      sortedCandidates.indexOfFirst { it > afterFileName }.let { if (it == -1) sortedCandidates.size else it }
+    } else {
+      0
+    }
+
+    if (startIndex >= sortedCandidates.size) {
+      return AbandonedAttachmentFileBatchResult(deletedCount = 0, lastCheckedFileName = null, isFinished = true)
+    }
+
+    val endIndex = (startIndex + limit).coerceAtMost(sortedCandidates.size)
+    val batch = sortedCandidates.subList(startIndex, endIndex)
+
+    val filesInDb: MutableSet<String> = HashSet(batch.size)
+    readableDatabase.withinTransaction { db ->
+      db.select(DATA_FILE, THUMBNAIL_FILE)
+        .from(TABLE_NAME)
+        .run()
+        .forEach { cursor ->
+          cursor.requireString(DATA_FILE)?.let { filesInDb += it }
+          cursor.requireString(THUMBNAIL_FILE)?.let { filesInDb += it }
+        }
+    }
+
+    filesInDb += SignalDatabase.stickers.getAllStickerFiles()
+
+    var deleteCount = 0
+    for (filePath in batch) {
+      if (filePath !in filesInDb) {
+        if (File(filePath).delete()) {
+          deleteCount++
+        } else {
+          Log.w(TAG, "[deleteAbandonedAttachmentFilesBatch] Failed to delete attachment file. $filePath")
+        }
+      }
+    }
+
+    return AbandonedAttachmentFileBatchResult(
+      deletedCount = deleteCount,
+      lastCheckedFileName = batch.last(),
+      isFinished = endIndex >= sortedCandidates.size
+    )
+  }
