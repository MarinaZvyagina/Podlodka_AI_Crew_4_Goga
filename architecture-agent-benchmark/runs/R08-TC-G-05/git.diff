+  /**
+   * Chunked variant of [deleteAbandonedAttachmentFiles], used when sweeping the full attachment/thumbnail
+   * file store periodically in the background. Only files sorted after [afterFile] are inspected, and at
+   * most [limit] of them are checked, so that a large backlog of files (which can build up on a device used
+   * for a long time) is worked through gradually across multiple invocations rather than in one long pass.
+   *
+   * The caller is expected to persist [AbandonedAttachmentFileSweepResult.lastFileChecked] and pass it back
+   * in as [afterFile] on the next invocation to resume where a prior, possibly-interrupted, pass left off.
+   */
+  fun deleteAbandonedAttachmentFilesChunk(afterFile: String?, limit: Int): AbandonedAttachmentFileSweepResult {
+    val diskFiles = context.getDir(DIRECTORY, Context.MODE_PRIVATE).listFiles() ?: return AbandonedAttachmentFileSweepResult(deletedCount = 0, lastFileChecked = null, finished = true)
+
+    val candidateFiles: List<String> = diskFiles
+      .filter { file: File -> !PartFileProtector.isProtected(file) }
+      .map { file: File -> file.absolutePath }
+      .sorted()
+      .filter { afterFile == null || it > afterFile }
+
+    if (candidateFiles.isEmpty()) {
+      return AbandonedAttachmentFileSweepResult(deletedCount = 0, lastFileChecked = null, finished = true)
+    }
+
+    val batch: List<String> = candidateFiles.take(limit)
+    val filesInDb: Set<String> = getReferencedAttachmentFilePaths()
+
+    var deletedCount = 0
+    for (filePath in batch) {
+      if (filePath !in filesInDb) {
+        if (File(filePath).delete()) {
+          deletedCount++
+        } else {
+          Log.w(TAG, "[deleteAbandonedAttachmentFilesChunk] Failed to delete attachment file. $filePath")
+        }
+      }
+    }
+
+    return AbandonedAttachmentFileSweepResult(
+      deletedCount = deletedCount,
+      lastFileChecked = batch.last(),
+      finished = candidateFiles.size <= limit
+    )
+  }
