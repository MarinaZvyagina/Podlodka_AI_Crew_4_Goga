+
+package org.thoughtcrime.securesms.jobs
+
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.SignalDatabase.Companion.attachments
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.JsonJobData
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.DataRestoreConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+import kotlin.time.Duration.Companion.days
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * Periodically sweeps the attachment parts directory for thumbnail/attachment files that no
+ * longer belong to any attachment (e.g. because the message or attachment they belonged to was
+ * deleted), deleting them to reclaim disk space.
+ *
+ * The sweep is done in bounded batches, persisting a cursor between runs, so that a single run
+ * can't tie up the job queue for an unbounded amount of time and so that a run that gets killed
+ * partway through (which routinely happens on Android) resumes from where it left off on the
+ * next attempt instead of rescanning everything or losing progress.
+ */
+class ThumbnailCleanupJob private constructor(
+  parameters: Parameters,
+  private var afterPath: String?
+) : Job(parameters) {
+
+  companion object {
+    private val TAG = Log.tag(ThumbnailCleanupJob::class)
+
+    const val KEY = "ThumbnailCleanupJob"
+
+    private const val KEY_AFTER_PATH = "after_path"
+    private const val BATCH_SIZE = 500
+
+    @JvmStatic
+    fun enqueue() {
+      AppDependencies.jobManager.add(ThumbnailCleanupJob())
+    }
+  }
+
+  constructor() : this(
+    parameters = Parameters.Builder()
+      .setMaxInstancesForFactory(1)
+      .setLifespan(1.days.inWholeMilliseconds)
+      .setMaxAttempts(Parameters.UNLIMITED)
+      .addConstraint(NotInCallConstraint.KEY)
+      .addConstraint(BatteryNotLowConstraint.KEY)
+      .addConstraint(DataRestoreConstraint.KEY)
+      .build(),
+    null
+  )
+
+  override fun serialize(): ByteArray? {
+    return JsonJobData.Builder()
+      .putString(KEY_AFTER_PATH, afterPath)
+      .build()
+      .serialize()
+  }
+
+  override fun getFactoryKey(): String = KEY
+
+  override fun onFailure() = Unit
+
+  override fun run(): Result {
+    val sweep = attachments.deleteAbandonedAttachmentFileBatch(afterPath, BATCH_SIZE)
+
+    if (sweep.deletedCount > 0) {
+      Log.i(TAG, "Deleted ${sweep.deletedCount} abandoned thumbnail/attachment files.")
+    }
+
+    if (sweep.nextCursor == null) {
+      Log.i(TAG, "Finished sweeping for abandoned thumbnail files.")
+      return Result.success()
+    }
+
+    afterPath = sweep.nextCursor
+    return Result.retry(1.seconds.inWholeMilliseconds)
+  }
+
+  class Factory : Job.Factory<ThumbnailCleanupJob> {
+    override fun create(parameters: Parameters, data: ByteArray?): ThumbnailCleanupJob {
+      val builder = JsonJobData.deserialize(data)
+      return ThumbnailCleanupJob(parameters, builder.getStringOrDefault(KEY_AFTER_PATH, null))
+    }
+  }
+}
