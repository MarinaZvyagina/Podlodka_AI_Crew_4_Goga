+
+package org.thoughtcrime.securesms.search
+
+import android.app.Application
+import assertk.assertThat
+import assertk.assertions.hasSize
+import assertk.assertions.isSameAs
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.thoughtcrime.securesms.database.MessageType
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.database.ThreadTable
+import org.thoughtcrime.securesms.mms.IncomingMessage
+import org.thoughtcrime.securesms.recipients.RecipientId
+import org.thoughtcrime.securesms.testutil.RecipientTestRule
+
+/**
+ * Verifies that [SearchRepository] serves repeated identical searches from cache, that distinct
+ * search terms are cached independently, and that a data change invalidates previously-cached
+ * results rather than leaving them stale.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class SearchRepositoryCacheTest {
+
+  @get:Rule
+  val recipients = RecipientTestRule()
+
+  private val repository by lazy { SearchRepository("Note to Self") }
+
+  @Test
+  fun `repeated identical search is served from cache until data changes`() {
+    val sender = recipients.createRecipient("Alice Example")
+    val threadId = SignalDatabase.threads.getOrCreateThreadIdFor(sender, false, ThreadTable.DistributionTypes.DEFAULT)
+    insertMessage(sender, threadId, "the eagle has landed", time = 1000)
+
+    val first = repository.queryMessagesSync("eagle", SearchFilter.EMPTY)
+    assertThat(first.results).hasSize(1)
+
+    // Bypasses the repository entirely, so a warm cache won't see it.
+    insertMessage(sender, threadId, "eagle scout troop", time = 1001)
+
+    val second = repository.queryMessagesSync("eagle", SearchFilter.EMPTY)
+    assertThat(second).isSameAs(first)
+
+    SearchRepository.bumpCacheGenerationForTesting()
+
+    val third = repository.queryMessagesSync("eagle", SearchFilter.EMPTY)
+    assertThat(third.results).hasSize(2)
+  }
+
+  @Test
+  fun `different search terms are cached independently`() {
+    val sender = recipients.createRecipient("Bob Example")
+    val threadId = SignalDatabase.threads.getOrCreateThreadIdFor(sender, false, ThreadTable.DistributionTypes.DEFAULT)
+    insertMessage(sender, threadId, "red fish blue fish", time = 2000)
+
+    val red = repository.queryMessagesSync("red", SearchFilter.EMPTY)
+    val blue = repository.queryMessagesSync("blue", SearchFilter.EMPTY)
+    assertThat(red.results).hasSize(1)
+    assertThat(blue.results).hasSize(1)
+
+    insertMessage(sender, threadId, "red herring", time = 2001)
+    SearchRepository.bumpCacheGenerationForTesting()
+
+    // Re-querying "blue" reflects the (unchanged) current state independently of "red" changing.
+    val blueAgain = repository.queryMessagesSync("blue", SearchFilter.EMPTY)
+    assertThat(blueAgain.results).hasSize(1)
+
+    val redAgain = repository.queryMessagesSync("red", SearchFilter.EMPTY)
+    assertThat(redAgain.results).hasSize(2)
+  }
+
+  private fun insertMessage(from: RecipientId, threadId: Long, body: String, time: Long) {
+    val message = IncomingMessage(
+      type = MessageType.NORMAL,
+      from = from,
+      sentTimeMillis = time,
+      serverTimeMillis = time,
+      receivedTimeMillis = time,
+      body = body
+    )
+    SignalDatabase.messages.insertMessageInbox(message, threadId)
+  }
+}
