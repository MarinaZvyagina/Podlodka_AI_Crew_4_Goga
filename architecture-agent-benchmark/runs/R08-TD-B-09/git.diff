diff --git a/app/src/main/java/org/thoughtcrime/securesms/search/SearchResultCache.java b/app/src/main/java/org/thoughtcrime/securesms/search/SearchResultCache.java
new file mode 100644
index 0000000..f2eae36
--- /dev/null
+++ b/app/src/main/java/org/thoughtcrime/securesms/search/SearchResultCache.java
@@ -0,0 +1,62 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+package org.thoughtcrime.securesms.search;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import org.signal.core.util.LRUCache;
+
+import java.util.AbstractMap;
+import java.util.Map;
+
+/**
+ * Memoizes {@link SearchRepository} results by (query, filter) so repeating an identical search
+ * is served from memory instead of re-running the underlying database query.
+ * <p>
+ * Callers own invalidation: {@link #clear()} must be invoked whenever data that could affect
+ * search results changes, since this cache has no way to know which cached queries a given
+ * write might affect.
+ */
+public class SearchResultCache {
+
+  private static final int DEFAULT_MAX_ENTRIES = 20;
+
+  private final Object                                                        lock         = new Object();
+  private final LRUCache<Map.Entry<String, SearchFilter>, MessageSearchResult> messageCache = new LRUCache<>(DEFAULT_MAX_ENTRIES);
+  private final LRUCache<Map.Entry<String, Boolean>, ThreadSearchResult>       threadCache  = new LRUCache<>(DEFAULT_MAX_ENTRIES);
+
+  public @Nullable MessageSearchResult getMessages(@NonNull String query, @NonNull SearchFilter filter) {
+    synchronized (lock) {
+      return messageCache.get(new AbstractMap.SimpleImmutableEntry<>(query, filter));
+    }
+  }
+
+  public void putMessages(@NonNull String query, @NonNull SearchFilter filter, @NonNull MessageSearchResult result) {
+    synchronized (lock) {
+      messageCache.put(new AbstractMap.SimpleImmutableEntry<>(query, filter), result);
+    }
+  }
+
+  public @Nullable ThreadSearchResult getThreads(@NonNull String query, boolean unreadOnly) {
+    synchronized (lock) {
+      return threadCache.get(new AbstractMap.SimpleImmutableEntry<>(query, unreadOnly));
+    }
+  }
+
+  public void putThreads(@NonNull String query, boolean unreadOnly, @NonNull ThreadSearchResult result) {
+    synchronized (lock) {
+      threadCache.put(new AbstractMap.SimpleImmutableEntry<>(query, unreadOnly), result);
+    }
+  }
+
+  /** Drops all cached results. Must be called whenever messages/conversations may have changed. */
+  public void clear() {
+    synchronized (lock) {
+      messageCache.clear();
+      threadCache.clear();
+    }
+  }
+}
diff --git a/app/src/test/java/org/thoughtcrime/securesms/search/SearchResultCacheTest.kt b/app/src/test/java/org/thoughtcrime/securesms/search/SearchResultCacheTest.kt
