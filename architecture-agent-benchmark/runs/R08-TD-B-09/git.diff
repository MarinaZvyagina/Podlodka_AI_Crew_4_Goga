--- /dev/null
+++ b/app/src/test/java/org/thoughtcrime/securesms/search/SearchResultCacheTest.kt
@@ -0,0 +1,90 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import assertk.assertThat
+import assertk.assertions.isNotNull
+import assertk.assertions.isNull
+import assertk.assertions.isSameAs
+import org.junit.Test
+
+class SearchResultCacheTest {
+
+  @Test
+  fun getMessagesMissesUntilPut() {
+    val cache = SearchResultCache()
+
+    assertThat(cache.getMessages("hello", SearchFilter.EMPTY)).isNull()
+
+    val result = MessageSearchResult(emptyList(), "hello")
+    cache.putMessages("hello", SearchFilter.EMPTY, result)
+
+    assertThat(cache.getMessages("hello", SearchFilter.EMPTY)).isSameAs(result)
+  }
+
+  @Test
+  fun getMessagesIsIndependentPerQuery() {
+    val cache = SearchResultCache()
+    cache.putMessages("hello", SearchFilter.EMPTY, MessageSearchResult(emptyList(), "hello"))
+
+    assertThat(cache.getMessages("goodbye", SearchFilter.EMPTY)).isNull()
+  }
+
+  @Test
+  fun getMessagesIsIndependentPerFilter() {
+    val cache = SearchResultCache()
+    val filterA = SearchFilter.EMPTY
+    val filterB = SearchFilter(startDate = 1000L)
+
+    cache.putMessages("hello", filterA, MessageSearchResult(emptyList(), "hello"))
+
+    assertThat(cache.getMessages("hello", filterB)).isNull()
+  }
+
+  @Test
+  fun getThreadsMissesUntilPut() {
+    val cache = SearchResultCache()
+
+    assertThat(cache.getThreads("hello", false)).isNull()
+
+    val result = ThreadSearchResult(emptyList(), "hello")
+    cache.putThreads("hello", false, result)
+
+    assertThat(cache.getThreads("hello", false)).isSameAs(result)
+  }
+
+  @Test
+  fun getThreadsIsIndependentPerUnreadFlag() {
+    val cache = SearchResultCache()
+    cache.putThreads("hello", false, ThreadSearchResult(emptyList(), "hello"))
+
+    assertThat(cache.getThreads("hello", true)).isNull()
+  }
+
+  @Test
+  fun clearRemovesAllCachedEntries() {
+    val cache = SearchResultCache()
+    cache.putMessages("hello", SearchFilter.EMPTY, MessageSearchResult(emptyList(), "hello"))
+    cache.putThreads("hello", false, ThreadSearchResult(emptyList(), "hello"))
+
+    cache.clear()
+
+    assertThat(cache.getMessages("hello", SearchFilter.EMPTY)).isNull()
+    assertThat(cache.getThreads("hello", false)).isNull()
+  }
+
+  @Test
+  fun evictsLeastRecentlyUsedEntryPastCapacity() {
+    val cache = SearchResultCache()
+
+    for (i in 0 until 21) {
+      cache.putMessages("query$i", SearchFilter.EMPTY, MessageSearchResult(emptyList(), "query$i"))
+    }
+
+    assertThat(cache.getMessages("query0", SearchFilter.EMPTY)).isNull()
+    assertThat(cache.getMessages("query20", SearchFilter.EMPTY)).isNotNull()
+  }
+}
