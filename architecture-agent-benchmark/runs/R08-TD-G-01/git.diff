+  /**
+   * Installs a single, app-wide {@link DatabaseObserver} hook (once, regardless of how many
+   * {@link SearchRepository} instances are created) that drops the entire search result cache on
+   * any change that could affect search results. We invalidate broadly rather than trying to track
+   * exactly which cached queries a given mutation affects, since a stale search result is worse
+   * than an extra cache miss.
+   */
+  private static void installCacheInvalidationObserver() {
+    if (cacheInvalidationObserverInstalled.compareAndSet(false, true)) {
+      DatabaseObserver databaseObserver = AppDependencies.getDatabaseObserver();
+
+      databaseObserver.registerConversationListObserver(SearchRepository::clearResultCaches);
+      databaseObserver.registerMessageUpdateObserver(messageId -> clearResultCaches());
+    }
+  }
+
+  private static void clearResultCaches() {
+    synchronized (threadResultCache) {
+      threadResultCache.clear();
+    }
+    synchronized (messageResultCache) {
+      messageResultCache.clear();
+    }
+  }
