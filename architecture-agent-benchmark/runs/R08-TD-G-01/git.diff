+  private static final class ThreadQueryKey {
+    private final String  query;
+    private final boolean unreadOnly;
+
+    ThreadQueryKey(@NonNull String query, boolean unreadOnly) {
+      this.query      = query;
+      this.unreadOnly = unreadOnly;
+    }
+
+    @Override
+    public boolean equals(Object o) {
+      if (this == o) return true;
+      if (!(o instanceof ThreadQueryKey)) return false;
+      ThreadQueryKey that = (ThreadQueryKey) o;
+      return unreadOnly == that.unreadOnly && query.equals(that.query);
+    }
+
+    @Override
+    public int hashCode() {
+      return Objects.hash(query, unreadOnly);
+    }
+  }
+
+  private static final class MessageQueryKey {
+    private final String       query;
+    private final SearchFilter filter;
+
+    MessageQueryKey(@NonNull String query, @NonNull SearchFilter filter) {
+      this.query  = query;
+      this.filter = filter;
+    }
+
+    @Override
+    public boolean equals(Object o) {
+      if (this == o) return true;
+      if (!(o instanceof MessageQueryKey)) return false;
+      MessageQueryKey that = (MessageQueryKey) o;
+      return query.equals(that.query) && filter.equals(that.filter);
+    }
+
+    @Override
+    public int hashCode() {
