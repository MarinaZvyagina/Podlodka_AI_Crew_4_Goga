+   * Shared across all {@link SearchRepository} instances since they all read the same tables.
+   * Invalidated wholesale on any conversation-list or message change so a cached term never
+   * serves stale results.
+   */
+  private static final Map<MessageCacheKey, MessageSearchResult> messageResultCache = new ConcurrentHashMap<>();
+  private static final Map<ThreadCacheKey, ThreadSearchResult>   threadResultCache  = new ConcurrentHashMap<>();
+
