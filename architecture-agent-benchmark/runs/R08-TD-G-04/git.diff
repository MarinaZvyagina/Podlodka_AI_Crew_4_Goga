+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import android.app.Application
+import io.mockk.CapturingSlot
+import io.mockk.every
+import io.mockk.just
+import io.mockk.mockk
+import io.mockk.mockkObject
+import io.mockk.runs
+import io.mockk.slot
+import io.mockk.unmockkObject
+import io.mockk.verify
+import org.junit.After
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.thoughtcrime.securesms.database.DatabaseObserver
+import org.thoughtcrime.securesms.database.GroupTable
+import org.thoughtcrime.securesms.database.MentionTable
+import org.thoughtcrime.securesms.database.MessageTable
+import org.thoughtcrime.securesms.database.RecipientTable
+import org.thoughtcrime.securesms.database.SearchTable
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.database.ThreadTable
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.testutil.MockAppDependenciesRule
+
+/**
+ * Verifies the result-caching behavior in [SearchRepository]: repeated identical searches are
+ * served from cache instead of re-querying, different search terms are cached independently, and
+ * a conversation-list change signal invalidates the cache so a later identical search reflects it.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class SearchRepositoryCacheTest {
+
+  @get:Rule
+  val appDependencies = MockAppDependenciesRule()
+
+  private lateinit var threadTable: ThreadTable
+  private lateinit var recipientTable: RecipientTable
+  private lateinit var groupTable: GroupTable
+  private lateinit var searchTable: SearchTable
+  private lateinit var mentionTable: MentionTable
+  private lateinit var repository: SearchRepository
+  private lateinit var conversationListListener: CapturingSlot<DatabaseObserver.Observer>
+
+  @Before
+  fun setUp() {
+    threadTable = mockk(relaxed = true)
+    recipientTable = mockk(relaxed = true)
+    groupTable = mockk(relaxed = true)
+    searchTable = mockk(relaxed = true)
+    mentionTable = mockk(relaxed = true)
+
+    every { recipientTable.queryAllContacts(any(), any()) } returns null
+    every { groupTable.queryGroupsByTitle(any(), any(), any(), any()) } returns GroupTable.Reader(null)
+    every { threadTable.getFilteredConversationList(any(), any()) } returns null
+    every { searchTable.queryMessages(any<String>(), any<SearchFilter>()) } returns null
+    every { recipientTable.queryRecipientsForMentions(any()) } returns emptyList()
+    every { mentionTable.getMentionsContainingRecipients(any(), any<Long>()) } returns emptyMap()
+
+    mockkObject(SignalDatabase)
+    every { SignalDatabase.threads } returns threadTable
+    every { SignalDatabase.recipients } returns recipientTable
+    every { SignalDatabase.groups } returns groupTable
+    every { SignalDatabase.messageSearch } returns searchTable
+    every { SignalDatabase.mentions } returns mentionTable
+    every { SignalDatabase.messages } returns mockk<MessageTable>(relaxed = true)
+
+    conversationListListener = slot()
+    every { AppDependencies.databaseObserver.registerConversationListObserver(capture(conversationListListener)) } just runs
+
+    repository = SearchRepository("Note to Self")
+  }
+
+  @After
+  fun tearDown() {
+    unmockkObject(SignalDatabase)
+  }
+
+  @Test
+  fun `repeated identical thread search is served from cache`() {
+    repository.queryThreadsSync("alice", false)
+    repository.queryThreadsSync("alice", false)
+
+    // Each search issues two lookups (matching contacts, matching groups); a cache hit on the
+    // second call keeps the total at the first call's count instead of doubling it.
+    verify(exactly = 2) { threadTable.getFilteredConversationList(any(), false) }
+  }
+
+  @Test
+  fun `different thread search terms are cached independently`() {
+    repository.queryThreadsSync("alice", false)
+    repository.queryThreadsSync("bob", false)
+
+    verify(exactly = 4) { threadTable.getFilteredConversationList(any(), false) }
+  }
+
+  @Test
+  fun `data change invalidates the thread search cache`() {
+    repository.queryThreadsSync("alice", false)
+
+    conversationListListener.captured.onChanged()
+    repository.queryThreadsSync("alice", false)
+
+    verify(exactly = 4) { threadTable.getFilteredConversationList(any(), false) }
+  }
+
+  @Test
+  fun `repeated identical message search is served from cache`() {
+    repository.queryMessagesSync("alice", SearchFilter.EMPTY)
+    repository.queryMessagesSync("alice", SearchFilter.EMPTY)
+
+    verify(exactly = 1) { searchTable.queryMessages("alice", SearchFilter.EMPTY) }
+  }
+
+  @Test
+  fun `different message search terms are cached independently`() {
+    repository.queryMessagesSync("alice", SearchFilter.EMPTY)
+    repository.queryMessagesSync("bob", SearchFilter.EMPTY)
+
+    verify(exactly = 1) { searchTable.queryMessages("alice", SearchFilter.EMPTY) }
+    verify(exactly = 1) { searchTable.queryMessages("bob", SearchFilter.EMPTY) }
+  }
+
+  @Test
+  fun `data change invalidates the message search cache`() {
+    repository.queryMessagesSync("alice", SearchFilter.EMPTY)
+
+    conversationListListener.captured.onChanged()
+    repository.queryMessagesSync("alice", SearchFilter.EMPTY)
+
+    verify(exactly = 2) { searchTable.queryMessages("alice", SearchFilter.EMPTY) }
+  }
+}
