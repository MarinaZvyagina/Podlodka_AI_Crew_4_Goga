+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import android.app.Application
+import assertk.assertThat
+import assertk.assertions.hasSize
+import assertk.assertions.isNotSameInstanceAs
+import assertk.assertions.isSameInstanceAs
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.thoughtcrime.securesms.testutil.RecipientTestRule
+import kotlin.random.Random
+
+/**
+ * Verifies that [SearchRepository]'s chat-list search caching (a) actually serves a repeated,
+ * unchanged search from cache, and (b) keys different search terms independently. Cache
+ * invalidation on data changes is wired through [org.thoughtcrime.securesms.database.DatabaseObserver],
+ * which [RecipientTestRule] replaces with a relaxed mock, so that behavior isn't exercised here.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class SearchRepositoryCacheTest {
+
+  @get:Rule
+  val recipients = RecipientTestRule()
+
+  private val searchRepository: SearchRepository by lazy { SearchRepository("Note to Self") }
+
+  @Test
+  fun repeatedIdenticalSearch_isServedFromCache() {
+    val recipientId = recipients.createRecipient("Cache Hit Test")
+    val needle = uniqueNeedle()
+    recipients.insertOutgoingMessage(recipientId, body = "the $needle is findable")
+
+    val firstResult  = searchRepository.queryMessagesSync(needle, SearchFilter.EMPTY)
+    val secondResult = searchRepository.queryMessagesSync(needle, SearchFilter.EMPTY)
+
+    assertThat(firstResult.results).hasSize(1)
+    assertThat(secondResult).isSameInstanceAs(firstResult)
+  }
+
+  @Test
+  fun differentSearchTerms_areCachedIndependently() {
+    val recipientId = recipients.createRecipient("Independent Cache Test")
+    val needleOne = uniqueNeedle()
+    val needleTwo = uniqueNeedle()
+    recipients.insertOutgoingMessage(recipientId, body = "message containing $needleOne")
+    recipients.insertOutgoingMessage(recipientId, body = "message containing $needleTwo")
+
+    val resultOne = searchRepository.queryMessagesSync(needleOne, SearchFilter.EMPTY)
+    val resultTwo = searchRepository.queryMessagesSync(needleTwo, SearchFilter.EMPTY)
+
+    assertThat(resultOne).isNotSameInstanceAs(resultTwo)
+    assertThat(resultOne.results).hasSize(1)
+    assertThat(resultTwo.results).hasSize(1)
+  }
+
+  private fun uniqueNeedle(): String = "needle${Random.nextLong().let { if (it < 0) -it else it }}"
+}
