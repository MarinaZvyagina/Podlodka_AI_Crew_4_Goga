+
+package org.thoughtcrime.securesms.search
+
+import android.app.Application
+import assertk.assertThat
+import assertk.assertions.hasSize
+import assertk.assertions.isNotSameAs
+import assertk.assertions.isSameAs
+import io.mockk.Runs
+import io.mockk.every
+import io.mockk.just
+import io.mockk.mockk
+import io.mockk.slot
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.thoughtcrime.securesms.database.DatabaseObserver
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.testutil.RecipientTestRule
+
+/**
+ * Exercises the query-result caching added to [SearchRepository]: an identical repeated search
+ * should skip re-querying the database, and a search term must never return stale results after
+ * a conversation-list-affecting database change.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class SearchRepositoryCacheTest {
+
+  @get:Rule
+  val recipients = RecipientTestRule()
+
+  @Test
+  fun `repeated identical message search returns the cached result`() {
+    val alice = recipients.createRecipient("Alice Android")
+    recipients.insertOutgoingMessage(alice, body = "hello needle world")
+
+    val repository = SearchRepository("Note to Self")
+
+    val first = repository.queryMessagesSync("needle", SearchFilter.EMPTY)
+    assertThat(first.results).hasSize(1)
+
+    val second = repository.queryMessagesSync("needle", SearchFilter.EMPTY)
+    assertThat(second).isSameAs(first)
+
+    repository.close()
+  }
+
+  @Test
+  fun `message search cache is invalidated by a conversation list change`() {
+    val alice = recipients.createRecipient("Alice Android")
+    recipients.insertOutgoingMessage(alice, body = "hello needle world")
+
+    val observerSlot = slot<DatabaseObserver.Observer>()
+    val mockDatabaseObserver = mockk<DatabaseObserver>(relaxed = true)
+    every { AppDependencies.databaseObserver } returns mockDatabaseObserver
+    every { mockDatabaseObserver.registerConversationListObserver(capture(observerSlot)) } just Runs
+
+    val repository = SearchRepository("Note to Self")
+
+    val first = repository.queryMessagesSync("needle", SearchFilter.EMPTY)
+    assertThat(first.results).hasSize(1)
+
+    recipients.insertOutgoingMessage(alice, body = "another needle message")
+    observerSlot.captured.onChanged()
+
+    val second = repository.queryMessagesSync("needle", SearchFilter.EMPTY)
+    assertThat(second).isNotSameAs(first)
+    assertThat(second.results).hasSize(2)
+
+    repository.close()
+  }
+
+  @Test
+  fun `repeated identical thread search returns the cached result, unrelated query is independent`() {
+    val alice = recipients.createRecipient("Alice Android")
+    recipients.insertOutgoingMessage(alice, body = "hi")
+
+    val repository = SearchRepository("Note to Self")
+
+    val first = repository.queryThreadsSync("Alice", false)
+    assertThat(first.results).hasSize(1)
+
+    val second = repository.queryThreadsSync("Alice", false)
+    assertThat(second).isSameAs(first)
+
+    val third = repository.queryThreadsSync("Bob", false)
+    assertThat(third).isNotSameAs(first)
+    assertThat(third.results).hasSize(0)
+
+    repository.close()
+  }
+}
