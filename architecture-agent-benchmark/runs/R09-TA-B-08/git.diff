+    // MARK: - Removing Data
+    @MainActor
+    func testRemoveWindowData_removesPrimaryAndBackupFile() async throws {
+        let subject = createSubject()
+        let uuidToRemove = defaultTestTabWindowUUID
+        let uuidToKeep = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        let primaryDirectory = URL(string: "some/directory1")!
+        let backupDirectory = URL(string: "some/directory2")!
+        mockFileManager.primaryDirectoryURL = primaryDirectory
+        mockFileManager.backupDirectoryURL = backupDirectory
+        let primaryURLToRemove = primaryDirectory.appendingPathComponent("window-\(uuidToRemove.uuidString)")
+        let primaryURLToKeep = primaryDirectory.appendingPathComponent("window-\(uuidToKeep.uuidString)")
+        mockFileManager.pathContents = [primaryURLToRemove, primaryURLToKeep]
+
+        await subject.removeWindowData(forUUIDs: [uuidToRemove])
+
+        let backupURLToRemove = backupDirectory.appendingPathComponent("window-\(uuidToRemove.uuidString)")
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertEqual(mockFileManager.removedFileURLs, [primaryURLToRemove, backupURLToRemove])
+    }
+
+    @MainActor
+    func testRemoveWindowData_withoutBackupFile_doesNotThrow() async throws {
+        let subject = createSubject()
+        let primaryDirectory = URL(string: "some/directory1")!
+        mockFileManager.primaryDirectoryURL = primaryDirectory
+        mockFileManager.backupDirectoryURL = nil
+        let primaryURLToRemove = primaryDirectory.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        mockFileManager.pathContents = [primaryURLToRemove]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 1)
+        XCTAssertEqual(mockFileManager.removedFileURLs, [primaryURLToRemove])
+    }
