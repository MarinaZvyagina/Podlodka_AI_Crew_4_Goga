+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.pathContents = [URL(string: "some/directory1/window-\(uuidToKeep.uuidString)")!]
+
+        await subject.removeWindowData(forUUIDs: [UUID()])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 0)
+    }
+
