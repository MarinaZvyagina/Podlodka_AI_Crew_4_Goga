+    // MARK: - Removing Data
+    @MainActor
+    func testRemoveWindowData_removesPrimaryAndBackupFiles() async throws {
+        let subject = createSubject()
+        let uuidToRemove = defaultTestTabWindowUUID
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.pathContents = [URL(string: "some/directory1/window-\(uuidToRemove.uuidString)")!]
+
+        await subject.removeWindowData(forUUIDs: [uuidToRemove])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains { $0.absoluteString.contains("directory1") })
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains { $0.absoluteString.contains("directory2") })
+    }
+
+    @MainActor
+    func testRemoveWindowData_windowNotInList_isLeftUntouched() async throws {
+        let subject = createSubject()
+        let uuidToKeep = defaultTestTabWindowUUID
