+    @MainActor
+    func testRemoveWindowData_removesMatchingWindowFromPrimaryAndBackup() async throws {
+        let subject = createSubject()
+        let matchingURL = URL(string: "some/directory/window-\(defaultTestTabWindowUUID.uuidString)")!
+        let nonMatchingURL = URL(string: "some/directory/window-ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.pathContents = [matchingURL, nonMatchingURL]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        // Both the primary and backup directories should be checked, and the matching
+        // window's file should be removed from each.
+        XCTAssertEqual(mockFileManager.windowDataDirectoryCalledCount, 2)
+        XCTAssertEqual(mockFileManager.contentsOfDirectoryCalledCount, 2)
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+    }
+
+    @MainActor
+    func testRemoveWindowData_noMatchingUUID_doesNotRemoveAnyFiles() async throws {
+        let subject = createSubject()
+        let nonMatchingURL = URL(string: "some/directory/window-ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.pathContents = [nonMatchingURL]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 0)
+    }
+
+    @MainActor
+    func testRemoveWindowData_missingBackupDirectory_removesFromPrimaryOnlyWithoutError() async throws {
+        let subject = createSubject()
+        let matchingURL = URL(string: "some/directory/window-\(defaultTestTabWindowUUID.uuidString)")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = nil
+        mockFileManager.pathContents = [matchingURL]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.contentsOfDirectoryCalledCount, 1)
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 1)
+    }
+
