+    // MARK: - Removing Window Data
+    @MainActor
+    func testRemoveWindowData_removesMatchingFileFromPrimaryAndBackup() async throws {
+        let subject = createSubject()
+        let uuidToRemove = defaultTestTabWindowUUID
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.primaryPathContents = [URL(string: "some/directory1/window-\(uuidToRemove.uuidString)")!]
+        mockFileManager.backupPathContents = [URL(string: "some/directory2/window-\(uuidToRemove.uuidString)")!]
+
+        await subject.removeWindowData(forUUIDs: [uuidToRemove])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertEqual(Set(mockFileManager.removedFileURLs), Set([
+            URL(string: "some/directory1/window-\(uuidToRemove.uuidString)")!,
+            URL(string: "some/directory2/window-\(uuidToRemove.uuidString)")!
+        ]))
+    }
+
+    @MainActor
+    func testRemoveWindowData_noBackupFile_stillRemovesPrimaryWithoutError() async throws {
+        let subject = createSubject()
+        let uuidToRemove = defaultTestTabWindowUUID
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.primaryPathContents = [URL(string: "some/directory1/window-\(uuidToRemove.uuidString)")!]
+        mockFileManager.backupPathContents = []
+
+        await subject.removeWindowData(forUUIDs: [uuidToRemove])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 1)
+        XCTAssertEqual(mockFileManager.removedFileURLs, [
+            URL(string: "some/directory1/window-\(uuidToRemove.uuidString)")!
+        ])
+    }
+
+    @MainActor
+    func testRemoveWindowData_leavesUnrelatedWindowsUntouchedInPrimaryAndBackup() async throws {
+        let subject = createSubject()
+        let uuidToRemove = defaultTestTabWindowUUID
+        let uuidToKeep = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.primaryPathContents = [
+            URL(string: "some/directory1/window-\(uuidToRemove.uuidString)")!,
+            URL(string: "some/directory1/window-\(uuidToKeep.uuidString)")!
+        ]
+        mockFileManager.backupPathContents = [
+            URL(string: "some/directory2/window-\(uuidToRemove.uuidString)")!,
+            URL(string: "some/directory2/window-\(uuidToKeep.uuidString)")!
+        ]
+
+        await subject.removeWindowData(forUUIDs: [uuidToRemove])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertFalse(mockFileManager.removedFileURLs.contains(
+            URL(string: "some/directory1/window-\(uuidToKeep.uuidString)")!
+        ))
+        XCTAssertFalse(mockFileManager.removedFileURLs.contains(
+            URL(string: "some/directory2/window-\(uuidToKeep.uuidString)")!
+        ))
+    }
+
