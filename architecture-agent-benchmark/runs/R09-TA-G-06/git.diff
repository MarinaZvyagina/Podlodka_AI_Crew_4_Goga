+    // MARK: - Removing Data
+    @MainActor
+    func testRemoveWindowData_removesMatchingPrimaryAndBackupFiles() async throws {
+        let subject = createSubject()
+        let otherUUID = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.pathContents = [
+            windowFileURL(directory: "some/directory1", uuid: defaultTestTabWindowUUID),
+            windowFileURL(directory: "some/directory1", uuid: otherUUID)
+        ]
+        mockFileManager.backupPathContents = [
+            windowFileURL(directory: "some/directory2", uuid: defaultTestTabWindowUUID),
+            windowFileURL(directory: "some/directory2", uuid: otherUUID)
+        ]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+    }
+
+    @MainActor
+    func testRemoveWindowData_noBackupFile_removesPrimaryWithoutError() async throws {
+        let subject = createSubject()
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.pathContents = [windowFileURL(directory: "some/directory1", uuid: defaultTestTabWindowUUID)]
+        mockFileManager.backupPathContents = []
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 1)
+    }
+
+    @MainActor
+    func testRemoveWindowData_leavesUnrelatedWindowsAndBackupsUntouched() async throws {
+        let subject = createSubject()
+        let otherUUID = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.pathContents = [
+            windowFileURL(directory: "some/directory1", uuid: defaultTestTabWindowUUID),
+            windowFileURL(directory: "some/directory1", uuid: otherUUID)
+        ]
+        mockFileManager.backupPathContents = [
+            windowFileURL(directory: "some/directory2", uuid: defaultTestTabWindowUUID),
+            windowFileURL(directory: "some/directory2", uuid: otherUUID)
+        ]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        // Only the 2 files (primary + backup) for defaultTestTabWindowUUID should be removed,
