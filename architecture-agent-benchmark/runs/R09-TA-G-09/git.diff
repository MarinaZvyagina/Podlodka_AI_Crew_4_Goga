+    @MainActor
+    func testRemoveWindowData_removesPrimaryAndBackupFile_forMatchingUUID() async throws {
+        let subject = createSubject()
+        let uuidToRemove = defaultTestTabWindowUUID
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.pathContents = [
+            URL(string: "some/directory1/window-\(uuidToRemove.uuidString)")!
+        ]
+
+        await subject.removeWindowData(forUUIDs: [uuidToRemove])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertTrue(mockFileManager.removedFilePaths.contains(
+            URL(string: "some/directory1/window-\(uuidToRemove.uuidString)")!
+        ))
+        XCTAssertTrue(mockFileManager.removedFilePaths.contains(
+            URL(string: "some/directory2/window-\(uuidToRemove.uuidString)")!
+        ))
+    }
+
+    @MainActor
+    func testRemoveWindowData_leavesOtherWindowsAndTheirBackupsUntouched() async throws {
+        let subject = createSubject()
+        let uuidToRemove = defaultTestTabWindowUUID
+        let uuidToKeep = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.pathContents = [
+            URL(string: "some/directory1/window-\(uuidToRemove.uuidString)")!,
+            URL(string: "some/directory1/window-\(uuidToKeep.uuidString)")!
+        ]
+
+        await subject.removeWindowData(forUUIDs: [uuidToRemove])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertFalse(mockFileManager.removedFilePaths.contains(
+            URL(string: "some/directory1/window-\(uuidToKeep.uuidString)")!
+        ))
+        XCTAssertFalse(mockFileManager.removedFilePaths.contains(
+            URL(string: "some/directory2/window-\(uuidToKeep.uuidString)")!
+        ))
+    }
+
+    @MainActor
