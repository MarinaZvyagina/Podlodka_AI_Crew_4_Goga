+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,73 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import AVFoundation
+
+/// A stand-in `TranscriptionEngine` representing an alternative speech-to-text pipeline.
+///
+/// Mirrors the permission/audio-session/capture flow used by the other engines so behavior
+/// (permission prompts, error surfaces, stop/cancel) is identical from the user's point of view;
+/// only the transcription itself is mocked, streaming a canned phrase word-by-word.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let mockPhrase: [String]
+    private let wordIntervalNanoseconds: UInt64
+
+    private var transcriptionTask: Task<Void, Never>?
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        mockPhrase: [String] = ["this", "is", "the", "alternative", "transcription", "pipeline"],
+        wordIntervalNanoseconds: UInt64 = 200_000_000
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.mockPhrase = mockPhrase
+        self.wordIntervalNanoseconds = wordIntervalNanoseconds
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        guard !mockPhrase.isEmpty else {
+            continuation.yield(.empty())
+            continuation.finish()
+            return
+        }
+
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        transcriptionTask?.cancel()
+        transcriptionTask = Task { [mockPhrase, wordIntervalNanoseconds] in
+            var accumulated: [String] = []
+            for word in mockPhrase {
+                guard !Task.isCancelled else { return }
+                accumulated.append(word)
+
+                let isFinal = word == mockPhrase.last
+                continuation.yield(SpeechResult(text: accumulated.joined(separator: " "), isFinal: isFinal))
+
+                if isFinal {
+                    continuation.finish()
+                    return
+                }
+                try? await Task.sleep(nanoseconds: wordIntervalNanoseconds)
+            }
+        }
+    }
+
+    func stop() throws {
+        transcriptionTask?.cancel()
+        transcriptionTask = nil
+        try audioManager.stopEngine()
+    }
+}
