+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+/// Identifies which speech-to-text pipeline transcribes voice search audio.
+///
+/// Used to A/B test an alternative pipeline against the default one: `standard` picks the
+/// platform-appropriate engine (`SpeechAnalyzerEngine` on iOS 26+, `SFSpeechRecognizerEngine`
+/// otherwise), while `alternative` swaps in a separate pipeline for enrolled users.
+public enum TranscriptionPipeline: String, Sendable {
+    case standard
+    case alternative
+}
