diff --git a/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
new file mode 100644
index 0000000..2e7300a
--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,69 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import AVFoundation
+
+/// A stand-in for an alternative third-party speech-to-text pipeline, used to A/B test
+/// transcription quality and latency against the platform default engines.
+///
+/// Shares the same permission request and audio capture flow as the default engines so
+/// permission errors and microphone behavior are indistinguishable to the user; the
+/// transcription itself is simulated.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let simulatedWords: [String]
+    private let wordIntervalNanoseconds: UInt64
+
+    private var transcriptionTask: Task<Void, Never>?
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        simulatedWords: [String] = ["This", "is", "the", "alternative", "pipeline"],
+        wordIntervalNanoseconds: UInt64 = 300_000_000
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.simulatedWords = simulatedWords
+        self.wordIntervalNanoseconds = wordIntervalNanoseconds
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        let words = simulatedWords
+        let interval = wordIntervalNanoseconds
+        transcriptionTask = Task { [weak self] in
+            var emitted: [String] = []
+            for word in words {
+                guard !Task.isCancelled else { return }
+                try? await Task.sleep(nanoseconds: interval)
+                guard !Task.isCancelled else { return }
+
+                emitted.append(word)
+                let isFinal = emitted.count == words.count
+                continuation.yield(SpeechResult(text: emitted.joined(separator: " "), isFinal: isFinal))
+                if isFinal {
+                    continuation.finish()
+                }
+            }
+            self?.transcriptionTask = nil
+        }
+    }
+
+    func stop() async throws {
+        transcriptionTask?.cancel()
+        transcriptionTask = nil
+        try audioManager.stopEngine()
+    }
+}
