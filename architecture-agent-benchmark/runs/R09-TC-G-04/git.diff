index 0000000..e492948
--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeSpeechRecognizerEngine.swift
@@ -0,0 +1,67 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import AVFoundation
+
+/// A stand-in transcription engine representing an alternative speech-to-text pipeline, used to
+/// A/B test transcription quality and latency against `SFSpeechRecognizerEngine`/`SpeechAnalyzerEngine`.
+///
+/// It shares the same permission and audio session handling as the default engines, so callers see
+/// identical behavior (permission prompts, error surfaces, stop/cancel) regardless of which engine is
+/// active. The transcription itself is simulated rather than backed by a real third-party engine.
+@MainActor
+final class AlternativeSpeechRecognizerEngine: TranscriptionEngine {
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let simulatedWords: [String]
+    private let wordDelayNanoseconds: UInt64
+    private let sleep: @Sendable (UInt64) async throws -> Void
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        simulatedTranscript: String = "This is a simulated transcript from the alternative speech pipeline",
+        wordDelayNanoseconds: UInt64 = 150_000_000,
+        sleep: @escaping @Sendable (UInt64) async throws -> Void = { try await Task.sleep(nanoseconds: $0) }
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.simulatedWords = simulatedTranscript
+            .components(separatedBy: .whitespacesAndNewlines)
+            .filter { !$0.isEmpty }
+        self.wordDelayNanoseconds = wordDelayNanoseconds
+        self.sleep = sleep
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    /// Simulates a streaming transcription by revealing `simulatedWords` one at a time, mirroring the
+    /// partial-then-final result shape the real engines produce.
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        guard !simulatedWords.isEmpty else {
+            continuation.finish()
+            return
+        }
+
+        var transcript = ""
+        for (index, word) in simulatedWords.enumerated() {
+            try Task.checkCancellation()
+            try await sleep(wordDelayNanoseconds)
+            transcript += transcript.isEmpty ? word : " \(word)"
+            continuation.yield(SpeechResult(text: transcript, isFinal: index == simulatedWords.count - 1))
+        }
+        continuation.finish()
+    }
+
+    func stop() throws {
+        try audioManager.stopEngine()
+    }
+}
