diff --git a/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeSpeechRecognizerEngine.swift b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeSpeechRecognizerEngine.swift
