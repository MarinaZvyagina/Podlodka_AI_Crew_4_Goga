diff --git a/SignalServiceKit/Search/ConversationMediaMessageFinder.swift b/SignalServiceKit/Search/ConversationMediaMessageFinder.swift
new file mode 100644
index 0000000..ddfdc0d
--- /dev/null
+++ b/SignalServiceKit/Search/ConversationMediaMessageFinder.swift
@@ -0,0 +1,65 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+import GRDB
+
+/// Looks up which messages in a thread currently have a body attachment
+/// (photo, video, voice message, or file) associated with them.
+///
+/// Backed directly by the `MessageAttachmentReference` table -- the same
+/// table `MediaGalleryAttachmentFinder` queries for the Media tab -- so
+/// results reflect an attachment as soon as it's associated with its owning
+/// message, with no separate index that needs to be kept in sync.
+public enum ConversationMediaMessageFinder {
+    private typealias RecordType = AttachmentReference.MessageAttachmentReferenceRecord
+
+    private static func baseQuery(threadRowId: Int64) -> QueryInterfaceRequest<RecordType> {
+        let threadIdColumn = Column(RecordType.CodingKeys.threadRowId)
+        let ownerTypeColumn = Column(RecordType.CodingKeys.ownerType)
+        let isViewOnceColumn = Column(RecordType.CodingKeys.isViewOnce)
+        let isPastEditRevisionColumn = Column(RecordType.CodingKeys.ownerIsPastEditRevision)
+
+        return RecordType
+            .filter(threadIdColumn == threadRowId)
+            // Only body attachments count as shared media; link previews, stickers,
+            // quoted-reply thumbnails, and contact avatars don't.
+            .filter(ownerTypeColumn == RecordType.OwnerType.bodyAttachment.rawValue)
+            .filter(isViewOnceColumn == false)
+            .filter(isPastEditRevisionColumn == false)
+    }
+
+    /// The row ids (== `TSInteraction.sortId`) of every message in the thread with a
+    /// qualifying attachment, for membership testing against another result set.
+    public static func messageRowIds(threadRowId: Int64, tx: DBReadTransaction) -> Set<Int64> {
+        let ownerRowIdColumn = Column(RecordType.CodingKeys.ownerRowId)
+        do {
+            let rowIds = try baseQuery(threadRowId: threadRowId)
+                .select(ownerRowIdColumn, as: Int64.self)
+                .distinct()
+                .fetchAll(tx.database)
+            return Set(rowIds)
+        } catch {
+            owsFailDebug("Error fetching attachment message row ids: \(error)")
+            return []
+        }
+    }
+
+    /// The row ids of the `limit` most recent messages in the thread with a qualifying
+    /// attachment, most recent first.
+    public static func recentMessageRowIds(threadRowId: Int64, limit: Int, tx: DBReadTransaction) -> [Int64] {
+        let ownerRowIdColumn = Column(RecordType.CodingKeys.ownerRowId)
+        do {
+            return try baseQuery(threadRowId: threadRowId)
+                .select(ownerRowIdColumn, as: Int64.self)
+                .distinct()
+                .order(ownerRowIdColumn.desc)
+                .limit(limit)
+                .fetchAll(tx.database)
+        } catch {
+            owsFailDebug("Error fetching attachment message row ids: \(error)")
+            return []
+        }
+    }
+}
diff --git a/SignalServiceKit/Search/ConversationMediaMessageFinderTest.swift b/SignalServiceKit/Search/ConversationMediaMessageFinderTest.swift
new file mode 100644
index 0000000..16b5491
--- /dev/null
+++ b/SignalServiceKit/Search/ConversationMediaMessageFinderTest.swift
@@ -0,0 +1,128 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+import XCTest
+
+@testable import SignalServiceKit
+
+class ConversationMediaMessageFinderTest: XCTestCase {
+    private let attachmentStore = AttachmentStore()
+    private var db: InMemoryDB!
+
+    override func setUp() async throws {
+        db = InMemoryDB()
+    }
+
+    func testMessageRowIdsReflectsCurrentAttachmentState() throws {
+        let (thread, _) = insertThreadAndInteraction()
+        let threadRowId = thread.sqliteRowId!
+
+        let (_, textOnlyMessageRowId) = insertThreadAndInteraction(thread: thread)
+        let (_, photoMessageRowId) = insertThreadAndInteraction(thread: thread)
+        let (_, viewOnceMessageRowId) = insertThreadAndInteraction(thread: thread)
+        let (_, pastEditRevisionMessageRowId) = insertThreadAndInteraction(thread: thread)
+
+        // A message with no attachment shouldn't show up before or after its sibling
+        // messages get one.
+        XCTAssertFalse(messageRowIds(threadRowId: threadRowId).contains(textOnlyMessageRowId))
+
+        insertAttachment(messageRowId: photoMessageRowId, threadRowId: threadRowId, mimeType: "image/jpeg")
+        insertAttachment(messageRowId: viewOnceMessageRowId, threadRowId: threadRowId, mimeType: "image/jpeg", isViewOnce: true)
+        insertAttachment(messageRowId: pastEditRevisionMessageRowId, threadRowId: threadRowId, mimeType: "image/jpeg", isPastEditRevision: true)
+
+        let rowIds = messageRowIds(threadRowId: threadRowId)
+        XCTAssertTrue(rowIds.contains(photoMessageRowId))
+        XCTAssertFalse(rowIds.contains(textOnlyMessageRowId))
+        XCTAssertFalse(rowIds.contains(viewOnceMessageRowId), "view-once attachments shouldn't count as shared media")
+        XCTAssertFalse(rowIds.contains(pastEditRevisionMessageRowId), "past edit revisions shouldn't count as shared media")
+    }
+
+    func testMessageRowIdsIsScopedToThread() throws {
+        let (threadA, messageRowIdA) = insertThreadAndInteraction()
+        let (threadB, messageRowIdB) = insertThreadAndInteraction()
+
+        insertAttachment(messageRowId: messageRowIdA, threadRowId: threadA.sqliteRowId!, mimeType: "image/jpeg")
+        insertAttachment(messageRowId: messageRowIdB, threadRowId: threadB.sqliteRowId!, mimeType: "image/jpeg")
+
+        XCTAssertEqual(messageRowIds(threadRowId: threadA.sqliteRowId!), [messageRowIdA])
+        XCTAssertEqual(messageRowIds(threadRowId: threadB.sqliteRowId!), [messageRowIdB])
+    }
+
+    func testRecentMessageRowIdsIsMostRecentFirstAndDeduplicated() throws {
+        let (thread, olderMessageRowId) = insertThreadAndInteraction()
+        let (_, newerMessageRowId) = insertThreadAndInteraction(thread: thread)
+        let threadRowId = thread.sqliteRowId!
+
+        // A message with two attachments should only appear once.
+        insertAttachment(messageRowId: olderMessageRowId, threadRowId: threadRowId, mimeType: "image/jpeg", orderInMessage: 0)
+        insertAttachment(messageRowId: newerMessageRowId, threadRowId: threadRowId, mimeType: "audio/mp3", orderInMessage: 0)
+        insertAttachment(messageRowId: newerMessageRowId, threadRowId: threadRowId, mimeType: "audio/mp3", orderInMessage: 1)
+
+        let recent = db.read { tx in
+            ConversationMediaMessageFinder.recentMessageRowIds(threadRowId: threadRowId, limit: 10, tx: tx)
+        }
+        XCTAssertEqual(recent, [newerMessageRowId, olderMessageRowId])
+
+        let limited = db.read { tx in
+            ConversationMediaMessageFinder.recentMessageRowIds(threadRowId: threadRowId, limit: 1, tx: tx)
+        }
+        XCTAssertEqual(limited, [newerMessageRowId])
+    }
+
+    // MARK: - Helpers
+
+    private func messageRowIds(threadRowId: Int64) -> Set<Int64> {
+        db.read { tx in
+            ConversationMediaMessageFinder.messageRowIds(threadRowId: threadRowId, tx: tx)
+        }
+    }
+
+    private func insertThreadAndInteraction(thread existingThread: TSThread? = nil) -> (thread: TSThread, interactionRowId: Int64) {
+        let thread = existingThread ?? TSThread(uniqueId: UUID().uuidString)
+        let interaction = TSInteraction(timestamp: 0, receivedAtTimestamp: 0, thread: thread)
+
+        db.write { tx in
+            if existingThread == nil {
+                try! thread.insert(tx.database)
+            }
+            try! interaction.asRecord().insert(tx.database)
+        }
+
+        return (thread, interaction.sqliteRowId!)
+    }
+
+    @discardableResult
+    private func insertAttachment(
+        messageRowId: Int64,
+        threadRowId: Int64,
+        mimeType: String,
+        orderInMessage: UInt32 = 0,
+        isViewOnce: Bool = false,
+        isPastEditRevision: Bool = false,
+    ) -> Attachment.IDType {
+        db.write { tx in
+            var attachmentRecord = Attachment.Record.mockStream(mimeType: mimeType)
+            try! attachmentRecord.insert(tx.database)
+
+            let referenceParams = AttachmentReference.ConstructionParams.mockMessageBodyAttachmentReference(
+                attachmentRecord: attachmentRecord,
+                messageRowId: messageRowId,
+                threadRowId: threadRowId,
+                receivedAtTimestamp: 0,
+                isViewOnce: isViewOnce,
+                isPastEditRevision: isPastEditRevision,
+                orderInMessage: orderInMessage,
+            )
+
+            attachmentStore.addReference(
+                referenceParams,
+                attachmentRowId: attachmentRecord.sqliteId!,
+                tx: tx,
+            )
+
+            return attachmentRecord.sqliteId!
+        }
+    }
+}
