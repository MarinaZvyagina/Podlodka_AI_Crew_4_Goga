     }
 
+    // MARK: - Media search (conversation search "media" filter)
+
+    func testFetchRecentMessageRowIdsWithBodyAttachments() throws {
+        let (threadId, message1) = insertThreadAndInteraction()
+        let (_, message2) = insertThreadAndInteraction()
+        let (otherThreadId, otherThreadMessage) = insertThreadAndInteraction()
+
+        try db.write { tx in
+            // message1: has a body (media) attachment.
+            var photoAttachment = Attachment.Record.mockPointer()
+            try attachmentStore.insert(
+                &photoAttachment,
+                reference: .mockMessageBodyAttachmentReference(
+                    attachmentRecord: photoAttachment,
+                    messageRowId: message1,
+                    threadRowId: threadId,
+                ),
+                tx: tx,
+            )
+
+            // message2: has only a sticker, which isn't a "photo, video, voice message, or
+            // file" the media filter should surface.
+            try attachmentStore.insert(
+                &photoAttachment,
+                reference: .mockMessageStickerReference(
+                    messageRowId: message2,
+                    threadRowId: threadId,
+                ),
+                tx: tx,
+            )
+
+            // otherThreadMessage: has a body attachment, but in a different thread.
+            var otherThreadAttachment = Attachment.Record.mockPointer()
+            try attachmentStore.insert(
+                &otherThreadAttachment,
+                reference: .mockMessageBodyAttachmentReference(
+                    attachmentRecord: otherThreadAttachment,
+                    messageRowId: otherThreadMessage,
+                    threadRowId: otherThreadId,
+                ),
+                tx: tx,
+            )
+        }
+
+        db.read { tx in
+            let rowIds = attachmentStore.fetchRecentMessageRowIdsWithBodyAttachments(
+                threadRowId: threadId,
+                limit: 10,
+                tx: tx,
+            )
+            XCTAssertEqual(rowIds, [message1])
+
+            XCTAssertEqual(
+                attachmentStore.fetchRecentMessageRowIdsWithBodyAttachments(
+                    threadRowId: otherThreadId,
+                    limit: 10,
+                    tx: tx,
+                ),
+                [otherThreadMessage],
+            )
+        }
+    }
+
+    func testFetchRecentMessageRowIdsWithBodyAttachments_mostRecentFirstAndLimit() throws {
+        let (threadId, message1) = insertThreadAndInteraction()
+        let (_, message2) = insertThreadAndInteraction()
+        let (_, message3) = insertThreadAndInteraction()
+
+        try db.write { tx in
+            for messageId in [message1, message2, message3] {
+                var attachmentParams = Attachment.Record.mockPointer()
+                try attachmentStore.insert(
+                    &attachmentParams,
+                    reference: .mockMessageBodyAttachmentReference(
+                        attachmentRecord: attachmentParams,
+                        messageRowId: messageId,
+                        threadRowId: threadId,
+                    ),
+                    tx: tx,
+                )
+            }
+        }
+
+        db.read { tx in
+            XCTAssertEqual(
+                attachmentStore.fetchRecentMessageRowIdsWithBodyAttachments(threadRowId: threadId, limit: 10, tx: tx),
+                [message3, message2, message1],
+            )
+            XCTAssertEqual(
+                attachmentStore.fetchRecentMessageRowIdsWithBodyAttachments(threadRowId: threadId, limit: 2, tx: tx),
+                [message3, message2],
+            )
+        }
+    }
