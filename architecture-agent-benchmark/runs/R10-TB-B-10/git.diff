+++ b/SignalServiceKit/Messages/Attachments/V2/AttachmentStore/AttachmentStore.swift
@@ -153,6 +153,32 @@ public struct AttachmentStore {
 
     // MARK: -
 
+    /// Fetch the sqlite row ids of messages in the given thread that have a current
+    /// photo, video, voice message, or file attachment (i.e. a body attachment;
+    /// excludes oversize text, link previews, quoted replies, stickers, and contact
+    /// avatars), most recent first.
+    public func fetchRecentMessageRowIdsWithBodyAttachments(
+        threadRowId: Int64,
+        limit: Int,
+        tx: DBReadTransaction,
+    ) -> [Int64] {
+        let threadRowIdColumn = Column(MessageAttachmentReferenceRecord.CodingKeys.threadRowId)
+        let ownerRowIdColumn = MessageAttachmentReferenceRecord.Columns.ownerRowId
+        let query = MessageAttachmentReferenceRecord
+            .filter(threadRowIdColumn == threadRowId)
+            .filter(MessageAttachmentReferenceRecord.Columns.ownerType == MessageAttachmentReferenceRecord.OwnerType.bodyAttachment.rawValue)
+            .distinct()
+            .order(ownerRowIdColumn.desc)
+            .limit(limit)
+            .select(ownerRowIdColumn, as: Int64.self)
+
+        return failIfThrows {
+            try query.fetchAll(tx.database)
+        }
+    }
+
+    // MARK: -
+
     public func fetch(
         id: Attachment.IDType,
         tx: DBReadTransaction,
