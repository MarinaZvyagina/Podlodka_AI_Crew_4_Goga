diff --git a/SignalServiceKit/Search/ConversationMediaFilterFinder.swift b/SignalServiceKit/Search/ConversationMediaFilterFinder.swift
new file mode 100644
index 0000000..616b48f
--- /dev/null
+++ b/SignalServiceKit/Search/ConversationMediaFilterFinder.swift
@@ -0,0 +1,48 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+import GRDB
+
+/// Supports narrowing in-conversation search results down to only messages
+/// that carry a "real" attachment (photo, video, voice message, or file).
+public enum ConversationMediaFilterFinder {
+    /// Given a set of candidate message row ids, returns the subset that own at least one
+    /// qualifying attachment: a body attachment that isn't view-once and isn't attached to a
+    /// past edit revision of the message. This intentionally excludes oversize text, link
+    /// previews, quoted-reply thumbnails, stickers, and contact avatars, none of which read as
+    /// "shared media" to the user.
+    ///
+    /// Reads `MessageAttachmentReference` directly (the same table attachment linking writes to
+    /// as part of the message-insert transaction), so results always reflect the current state
+    /// of attachment linking without requiring any separate index to be kept in sync.
+    public static func messageRowIds(
+        withQualifyingAttachmentsAmong candidateRowIds: Set<Int64>,
+        tx: DBReadTransaction,
+    ) -> Set<Int64> {
+        guard !candidateRowIds.isEmpty else {
+            return []
+        }
+
+        typealias RecordType = AttachmentReference.MessageAttachmentReferenceRecord
+        let ownerRowIdColumn = Column(RecordType.CodingKeys.ownerRowId)
+        let ownerTypeColumn = Column(RecordType.CodingKeys.ownerType)
+        let isViewOnceColumn = Column(RecordType.CodingKeys.isViewOnce)
+        let isPastEditRevisionColumn = Column(RecordType.CodingKeys.ownerIsPastEditRevision)
+
+        do {
+            let matchingRowIds = try RecordType
+                .filter(candidateRowIds.contains(ownerRowIdColumn))
+                .filter(ownerTypeColumn == RecordType.OwnerType.bodyAttachment.rawValue)
+                .filter(isViewOnceColumn == false)
+                .filter(isPastEditRevisionColumn == false)
+                .select(ownerRowIdColumn, as: Int64.self)
+                .fetchAll(tx.database)
+            return Set(matchingRowIds)
+        } catch {
+            owsFailDebug("Error fetching attachment references: \(error)")
+            return []
+        }
+    }
+}
