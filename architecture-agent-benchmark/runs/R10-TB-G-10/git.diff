diff --git a/SignalServiceKit/Messages/Interactions/AttachmentSearchFinder.swift b/SignalServiceKit/Messages/Interactions/AttachmentSearchFinder.swift
new file mode 100644
index 0000000..56c2114
--- /dev/null
+++ b/SignalServiceKit/Messages/Interactions/AttachmentSearchFinder.swift
@@ -0,0 +1,59 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+import Foundation
+import GRDB
+
+// MARK: -
+
+/// Finds messages in a thread that own a "real" attachment: a photo, video,
+/// voice message, or generic file the user shared, as opposed to a link
+/// preview thumbnail, sticker, contact avatar, or quoted-reply attachment.
+///
+/// Backed by `MessageAttachmentReference`, which is written in the same
+/// write transaction as the owning message (see `AttachmentManagerImpl`), so
+/// results always reflect the current state of the world without requiring a
+/// separate reindex step, unlike the full text search index.
+public class AttachmentSearchFinder {
+
+    public class func messagesWithAttachments(
+        inThreadUniqueId threadUniqueId: String,
+        maxResults: Int,
+        tx: DBReadTransaction,
+    ) -> [TSMessage] {
+        typealias RecordType = AttachmentReference.MessageAttachmentReferenceRecord
+
+        let sql = """
+        SELECT DISTINCT interaction.*
+        FROM \(InteractionRecord.databaseTableName) AS interaction
+        INNER JOIN \(RecordType.databaseTableName) AS attachmentRef
+            ON attachmentRef.\(RecordType.CodingKeys.ownerRowId.rawValue) = interaction.\(interactionColumn: .id)
+        WHERE interaction.\(interactionColumn: .threadUniqueId) = ?
+            AND attachmentRef.\(RecordType.CodingKeys.ownerType.rawValue) = ?
+            AND attachmentRef.\(RecordType.CodingKeys.isViewOnce.rawValue) IS 0
+            AND attachmentRef.\(RecordType.CodingKeys.ownerIsPastEditRevision.rawValue) IS 0
+        ORDER BY interaction.\(interactionColumn: .id) DESC
+        LIMIT ?
+        """
+
+        let arguments: StatementArguments = [
+            threadUniqueId,
+            RecordType.OwnerType.bodyAttachment.rawValue,
+            maxResults,
+        ]
+
+        let cursor = TSMessage.grdbFetchCursor(sql: sql, arguments: arguments, transaction: tx)
+
+        var messages = [TSMessage]()
+        do {
+            while let message = try cursor.next() as? TSMessage {
+                messages.append(message)
+            }
+        } catch {
+            owsFailDebug("unexpected error \(error)")
+        }
+        return messages
+    }
+}
diff --git a/SignalServiceKit/tests/Messages/Interactions/AttachmentSearchFinderTest.swift b/SignalServiceKit/tests/Messages/Interactions/AttachmentSearchFinderTest.swift
new file mode 100644
index 0000000..706117b
--- /dev/null
+++ b/SignalServiceKit/tests/Messages/Interactions/AttachmentSearchFinderTest.swift
@@ -0,0 +1,129 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+import GRDB
+import LibSignalClient
+import XCTest
+@testable import SignalServiceKit
+
+import typealias SignalServiceKit.Attachment
+
+class AttachmentSearchFinderTest: SSKBaseTest {
+    private var attachmentStore: AttachmentStore!
+    private var db: InMemoryDB!
+
+    private var thread: TSContactThread!
+    private var otherThread: TSContactThread!
+
+    override func setUp() {
+        super.setUp()
+
+        attachmentStore = AttachmentStore()
+        db = InMemoryDB()
+
+        thread = TSContactThread(contactUUID: Aci.randomForTesting().serviceIdUppercaseString, contactPhoneNumber: nil)
+        otherThread = TSContactThread(contactUUID: Aci.randomForTesting().serviceIdUppercaseString, contactPhoneNumber: nil)
+
+        db.write { tx in
+            try! thread.insert(tx.database)
+            try! otherThread.insert(tx.database)
+        }
+    }
+
+    func testOnlyReturnsMessagesWithAttachmentsInThatThread() {
+        let messageWithAttachment = insertMessage(in: thread)
+        insertAttachment(messageRowId: messageWithAttachment.sqliteRowId!, threadRowId: thread.sqliteRowId!)
+
+        // A text-only message in the same thread shouldn't show up.
+        insertMessage(in: thread)
+
+        // A message with an attachment in a *different* thread shouldn't show up either.
+        let otherThreadMessage = insertMessage(in: otherThread)
+        insertAttachment(messageRowId: otherThreadMessage.sqliteRowId!, threadRowId: otherThread.sqliteRowId!)
+
+        let results = db.read { tx in
+            AttachmentSearchFinder.messagesWithAttachments(
+                inThreadUniqueId: thread.uniqueId,
+                maxResults: 500,
+                tx: tx,
+            )
+        }
+
+        XCTAssertEqual(results.map(\.uniqueId), [messageWithAttachment.uniqueId])
+    }
+
+    func testExcludesViewOnceAndPastEditRevisions() {
+        let viewOnceMessage = insertMessage(in: thread)
+        insertAttachment(messageRowId: viewOnceMessage.sqliteRowId!, threadRowId: thread.sqliteRowId!, isViewOnce: true)
+
+        let editedMessage = insertMessage(in: thread)
+        insertAttachment(messageRowId: editedMessage.sqliteRowId!, threadRowId: thread.sqliteRowId!, isPastEditRevision: true)
+
+        let results = db.read { tx in
+            AttachmentSearchFinder.messagesWithAttachments(
+                inThreadUniqueId: thread.uniqueId,
+                maxResults: 500,
+                tx: tx,
+            )
+        }
+
+        XCTAssertTrue(results.isEmpty)
+    }
+
+    func testReflectsAttachmentAddedAfterMessageInsertion() {
+        let message = insertMessage(in: thread)
+
+        var results = db.read { tx in
+            AttachmentSearchFinder.messagesWithAttachments(inThreadUniqueId: thread.uniqueId, maxResults: 500, tx: tx)
+        }
+        XCTAssertTrue(results.isEmpty)
+
+        insertAttachment(messageRowId: message.sqliteRowId!, threadRowId: thread.sqliteRowId!)
+
+        results = db.read { tx in
+            AttachmentSearchFinder.messagesWithAttachments(inThreadUniqueId: thread.uniqueId, maxResults: 500, tx: tx)
+        }
+        XCTAssertEqual(results.map(\.uniqueId), [message.uniqueId])
+    }
+
+    // MARK: - Helpers
+
+    @discardableResult
+    private func insertMessage(in thread: TSContactThread) -> TSOutgoingMessage {
+        return db.write { tx in
+            let message = TSOutgoingMessage(
+                outgoingMessageWith: .withDefaultValues(thread: thread, messageBody: nil),
+                recipientAddressStates: [:],
+            )
+            try! message.asRecord().insert(tx.database)
+            return message
+        }
+    }
+
+    @discardableResult
+    private func insertAttachment(
+        messageRowId: Int64,
+        threadRowId: Int64,
+        isViewOnce: Bool = false,
+        isPastEditRevision: Bool = false,
+    ) -> Attachment {
+        return db.write { tx in
+            var attachmentRecord = Attachment.Record.mockPointer()
+            let referenceParams = AttachmentReference.ConstructionParams.mockMessageBodyAttachmentReference(
+                attachmentRecord: attachmentRecord,
+                messageRowId: messageRowId,
+                threadRowId: threadRowId,
+                isViewOnce: isViewOnce,
+                isPastEditRevision: isPastEditRevision,
+            )
+
+            return try! attachmentStore.insert(
+                &attachmentRecord,
+                reference: referenceParams,
+                tx: tx,
+            )
+        }
+    }
+}
