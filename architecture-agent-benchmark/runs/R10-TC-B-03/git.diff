@@ -1347,6 +1347,31 @@ public class InteractionFinder: NSObject {
 
         return mostRecentRowId
     }
+
+    /// The SQLite row ID of the most-recently inserted interaction covered by
+    /// this finder whose `receivedAtTimestamp` is strictly before
+    /// `cutoffTimestampMs`, or `nil` if there is no such interaction.
+    ///
+    /// Used to compute a stable anchor for batch-deleting interactions older
+    /// than a given cutoff (e.g., for message retention cleanup).
+    func rowId(olderThan cutoffTimestampMs: UInt64, tx: DBReadTransaction) -> Int64? {
+        let sql = """
+        SELECT \(interactionColumn: .id)
+        FROM \(InteractionRecord.databaseTableName)
+        INDEXED BY index_interactions_on_threadUniqueId_and_id
+        WHERE \(interactionColumn: .threadUniqueId) = ?
+        AND \(interactionColumn: .receivedAtTimestamp) < ?
+        ORDER BY \(interactionColumn: .id) DESC
+        LIMIT 1
+        """
+        return failIfThrows {
+            try Int64.fetchOne(
+                tx.database,
+                sql: sql,
+                arguments: [threadUniqueId, cutoffTimestampMs],
+            )
+        }
+    }
 }
 
