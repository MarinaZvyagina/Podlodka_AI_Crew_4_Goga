diff --git a/Signal/src/ViewControllers/AppSettings/MessageRetentionSettingsViewController.swift b/Signal/src/ViewControllers/AppSettings/MessageRetentionSettingsViewController.swift
new file mode 100644
index 0000000..1c40a44
--- /dev/null
+++ b/Signal/src/ViewControllers/AppSettings/MessageRetentionSettingsViewController.swift
@@ -0,0 +1,139 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+import SignalServiceKit
+import SignalUI
+
+/// Lets the user choose how long to keep message history before it's
+/// automatically deleted, across all of their chats.
+///
+/// Choosing a window (including choosing one for the first time) applies
+/// retroactively: existing history older than the new window is enqueued for
+/// deletion immediately, not just history received going forward. The actual
+/// deletion happens off the main thread in small batches (see
+/// ``MessageRetentionCleanupJobQueue``), so choosing a short window against a
+/// large history won't freeze the UI, and picking up again automatically if
+/// interrupted.
+class MessageRetentionSettingsViewController: OWSTableViewController2 {
+    /// `nil` represents "keep forever" (retention disabled).
+    private static let options: [UInt32?] = [nil, 30, 90, 365]
+
+    private var currentRetentionPeriodDays: UInt32?
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+
+        title = OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_TITLE",
+            comment: "Title for setting that automatically deletes old messages after a chosen amount of time.",
+        )
+
+        currentRetentionPeriodDays = SSKEnvironment.shared.databaseStorageRef.read { tx in
+            SSKEnvironment.shared.messageRetentionManagerRef.retentionPeriodDays(tx: tx)
+        }
+
+        updateTableContents()
+    }
+
+    private func updateTableContents() {
+        let section = OWSTableSection()
+        section.footerTitle = OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_FOOTER",
+            comment: "Footer explaining the automatic message deletion setting.",
+        )
+
+        for option in Self.options {
+            section.add(OWSTableItem(
+                text: Self.label(forRetentionPeriodDays: option),
+                actionBlock: { [weak self] in
+                    self?.didSelect(retentionPeriodDays: option)
+                },
+                accessoryType: option == currentRetentionPeriodDays ? .checkmark : .none,
+            ))
+        }
+
+        let contents = OWSTableContents()
+        contents.add(section)
+        self.contents = contents
+    }
+
+    private func didSelect(retentionPeriodDays: UInt32?) {
+        guard retentionPeriodDays != currentRetentionPeriodDays else { return }
+
+        // Choosing a shorter (or newly-enabled) window is destructive, since it
+        // immediately deletes existing history outside the new window. Confirm
+        // before applying, the same way other destructive chat settings do.
+        guard retentionPeriodDays != nil else {
+            apply(retentionPeriodDays: nil)
+            return
+        }
+
+        OWSActionSheets.showConfirmationAlert(
+            title: OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_CONFIRM_TITLE",
+                comment: "Title of alert before enabling/changing automatic message deletion.",
+            ),
+            message: OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_CONFIRM_MESSAGE",
+                comment: "Message of alert before enabling/changing automatic message deletion, warning that it applies to existing history.",
+            ),
+            proceedTitle: OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_CONFIRM_BUTTON",
+                comment: "Confirmation button for enabling/changing automatic message deletion.",
+            ),
+            proceedStyle: .destructive,
+        ) { [weak self] _ in
+            self?.apply(retentionPeriodDays: retentionPeriodDays)
+        }
+    }
+
+    private func apply(retentionPeriodDays: UInt32?) {
+        SSKEnvironment.shared.databaseStorageRef.write { tx in
+            SSKEnvironment.shared.messageRetentionManagerRef.setRetentionPeriodDays(retentionPeriodDays, tx: tx)
+        }
+        currentRetentionPeriodDays = retentionPeriodDays
+        updateTableContents()
+    }
+
+    private static func label(forRetentionPeriodDays days: UInt32?) -> String {
+        guard let days else {
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_OPTION_FOREVER",
+                comment: "Option to keep message history forever (disables automatic deletion).",
+            )
+        }
+        switch days {
+        case 30:
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_OPTION_30_DAYS",
+                comment: "Option to keep message history for 30 days.",
+            )
+        case 90:
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_OPTION_90_DAYS",
+                comment: "Option to keep message history for 90 days.",
+            )
+        case 365:
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_OPTION_1_YEAR",
+                comment: "Option to keep message history for 1 year.",
+            )
+        default:
+            return String(format: OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_OPTION_N_DAYS_FORMAT",
+                comment: "Option to keep message history for a number of days. Embeds {{ the number of days }}.",
+            ), days)
+        }
+    }
+
+    /// A short label describing the current setting, suitable for use as the
+    /// accessory text on the settings row that pushes this screen.
+    static func currentValueShortLabel() -> String {
+        let retentionPeriodDays = SSKEnvironment.shared.databaseStorageRef.read { tx in
+            SSKEnvironment.shared.messageRetentionManagerRef.retentionPeriodDays(tx: tx)
+        }
+        return label(forRetentionPeriodDays: retentionPeriodDays)
+    }
+}
