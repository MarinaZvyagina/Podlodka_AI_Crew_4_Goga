new file mode 100644
index 0000000..be45941
--- /dev/null
+++ b/SignalServiceKit/Jobs/JobRecords/MessageRetentionCleanupJobRecord.swift
@@ -0,0 +1,52 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+/// Deletes interactions in a single thread that were received before a fixed
+/// cutoff, as part of enforcing a user-configured message retention window.
+///
+/// The cutoff is captured once, when the job is created, so that a job which
+/// is interrupted (app termination, being backgrounded, network loss, etc.)
+/// and resumed later makes forward progress against a stable target rather
+/// than a constantly-moving "now minus retention period" value.
+final class MessageRetentionCleanupJobRecord: JobRecord {
+    override class var jobRecordType: JobRecord.JobRecordType { .messageRetentionCleanupJobRecord }
+
+    /// The unique ID of the thread within which to delete old interactions.
+    let threadUniqueId: String
+    /// Interactions received strictly before this timestamp (milliseconds
+    /// since epoch) should be deleted.
+    let cutoffTimestampMs: UInt64
+
+    init(
+        threadUniqueId: String,
+        cutoffTimestampMs: UInt64,
+        failureCount: UInt = 0,
+        status: Status = .ready,
+    ) {
+        self.threadUniqueId = threadUniqueId
+        self.cutoffTimestampMs = cutoffTimestampMs
+
+        super.init(
+            failureCount: failureCount,
+            status: status,
+        )
+    }
+
+    required init(inheritableDecoder decoder: any Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+
+        threadUniqueId = try container.decode(String.self, forKey: .MRCJR_threadUniqueId)
+        cutoffTimestampMs = try container.decode(UInt64.self, forKey: .MRCJR_cutoffTimestampMs)
+
+        try super.init(inheritableDecoder: decoder)
+    }
+
+    override func encode(to encoder: any Encoder) throws {
+        try super.encode(to: encoder)
+        var container = encoder.container(keyedBy: CodingKeys.self)
+        try container.encode(threadUniqueId, forKey: .MRCJR_threadUniqueId)
+        try container.encode(cutoffTimestampMs, forKey: .MRCJR_cutoffTimestampMs)
+    }
+}
diff --git a/SignalServiceKit/Jobs/MessageRetentionCleanupJobQueue.swift b/SignalServiceKit/Jobs/MessageRetentionCleanupJobQueue.swift
new file mode 100644
index 0000000..1bda3fe
--- /dev/null
+++ b/SignalServiceKit/Jobs/MessageRetentionCleanupJobQueue.swift
@@ -0,0 +1,278 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+import GRDB
+
+/// Enforces a user-configured message retention window by deleting
+/// interactions older than a cutoff, one thread at a time.
+///
+/// Each thread's cleanup is tracked with its own durable ``JobRecord``, so:
+/// - Work is batched (via ``TimeGatedBatch``) and performed off the main
+///   thread, so large histories don't freeze or slow down the UI.
+/// - If the app is terminated, backgrounded, or loses network mid-cleanup,
+///   the persisted job record is picked back up the next time the job queue
+///   starts (see ``start(appContext:)``), and cleanup resumes by re-querying
+///   for interactions still older than the cutoff — no separate progress
+///   cursor is needed, so there's nothing that can be left in an
+///   inconsistent state.
+/// - Each batch deletes and updates the thread's cached "last interaction"
+///   state within a single transaction, so a conversation's preview and
+///   unread count are correct as soon as that transaction commits, without
+///   waiting for the whole job (or an app relaunch).
+public final class MessageRetentionCleanupJobQueue {
+    private let jobRunnerFactory: MessageRetentionCleanupJobRunnerFactory
+    private let jobQueueRunner: JobQueueRunner<
+        JobRecordFinderImpl<MessageRetentionCleanupJobRecord>,
+        MessageRetentionCleanupJobRunnerFactory,
+    >
+    private let db: any DB
+    private var jobSerializer = CompletionSerializer()
+
+    init(
+        db: any DB,
+        interactionDeleteManager: InteractionDeleteManager,
+        threadStore: ThreadStore,
+    ) {
+        self.db = db
+        self.jobRunnerFactory = MessageRetentionCleanupJobRunnerFactory(
+            db: db,
+            interactionDeleteManager: interactionDeleteManager,
+            threadStore: threadStore,
+        )
+        self.jobQueueRunner = JobQueueRunner(
+            canExecuteJobsConcurrently: false,
+            db: db,
+            jobFinder: JobRecordFinderImpl(db: db),
+            jobRunnerFactory: self.jobRunnerFactory,
+        )
+    }
+
+    func start(appContext: AppContext) {
+        jobQueueRunner.start(shouldRestartExistingJobs: appContext.isMainApp)
+    }
+
+    /// Enqueues a cleanup job for the given thread unless one is already
+    /// pending. Safe to call redundantly (e.g., from a periodic sweep) since
+    /// an already-pending job will, once it runs, delete everything older
+    /// than its (earlier, and therefore more conservative) cutoff.
+    func addJob(
+        threadUniqueId: String,
+        cutoffTimestampMs: UInt64,
+        tx: DBWriteTransaction,
+    ) {
+        guard !hasPendingJob(threadUniqueId: threadUniqueId, tx: tx) else {
+            return
+        }
+
+        let jobRecord = MessageRetentionCleanupJobRecord(
+            threadUniqueId: threadUniqueId,
+            cutoffTimestampMs: cutoffTimestampMs,
+        )
+
+        jobRecord.anyInsert(transaction: tx)
+
+        jobSerializer.addOrderedSyncCompletion(tx: tx) {
+            self.jobQueueRunner.addPersistedJob(jobRecord)
+        }
+    }
+
+    private func hasPendingJob(threadUniqueId: String, tx: DBReadTransaction) -> Bool {
+        // Only jobs that are still runnable (i.e., not permanently failed or
+        // obsolete) count as "pending"; a stalled job shouldn't block this
+        // thread from ever being swept again.
+        let sql = """
+        SELECT 1
+        FROM \(MessageRetentionCleanupJobRecord.databaseTableName)
+        WHERE \(MessageRetentionCleanupJobRecord.columnName(.label)) = ?
+        AND \(MessageRetentionCleanupJobRecord.columnName(.MRCJR_threadUniqueId)) = ?
+        AND \(MessageRetentionCleanupJobRecord.columnName(.status)) IN (?, ?)
+        LIMIT 1
+        """
+        return failIfThrows {
+            return try Bool.fetchOne(
+                tx.database,
+                sql: sql,
+                arguments: [
+                    MessageRetentionCleanupJobRecord.jobRecordType.jobRecordLabel,
+                    threadUniqueId,
+                    JobRecord.Status.ready.rawValue,
+                    JobRecord.Status.running.rawValue,
+                ],
+            ) ?? false
+        }
+    }
+}
+
+// MARK: -
+
+private class MessageRetentionCleanupJobRunner: JobRunner {
+    typealias JobRecordType = MessageRetentionCleanupJobRecord
+
+    private enum Constants {
+        static let maxRetries: UInt = 110
+        static let deletionBatchSize: Int = 500
+    }
+
+    private let db: any DB
+    private let interactionDeleteManager: InteractionDeleteManager
+    private let threadStore: ThreadStore
+
+    private let logger = PrefixedLogger(prefix: "[MessageRetention]")
+
+    init(
+        db: any DB,
+        interactionDeleteManager: InteractionDeleteManager,
+        threadStore: ThreadStore,
+    ) {
+        self.db = db
+        self.interactionDeleteManager = interactionDeleteManager
+        self.threadStore = threadStore
+    }
+
+    func runJobAttempt(
+        _ jobRecord: MessageRetentionCleanupJobRecord,
+    ) async -> JobAttemptResult<Void> {
+        return await JobAttemptResult.executeBlockWithDefaultErrorHandler(
+            jobRecord: jobRecord,
+            retryLimit: Constants.maxRetries,
+            db: db,
+            block: {
+                try await _runJobAttempt(jobRecord)
+            },
+        )
+    }
+
+    func didFinishJob(_ jobRecordId: JobRecord.RowId, result: JobResult<Void>) async {
+        switch result.ranSuccessfullyOrError {
+        case .success:
+            break
+        case .failure(let failure):
+            logger.error("Failed to perform message retention cleanup! \(failure)")
+        }
+    }
+
+    private func _runJobAttempt(
+        _ jobRecord: MessageRetentionCleanupJobRecord,
+    ) async throws {
+        let threadUniqueId = jobRecord.threadUniqueId
+        let cutoffTimestampMs = jobRecord.cutoffTimestampMs
+
+        logger.info("Attempting to clean up interactions older than retention cutoff in thread \(threadUniqueId).")
+
+        guard let anchorRowId = db.read(block: { (tx: DBReadTransaction) in
+            InteractionFinder(threadUniqueId: threadUniqueId).rowId(olderThan: cutoffTimestampMs, tx: tx)
+        }) else {
+            // Nothing in this thread is older than the cutoff (anymore).
+            await db.awaitableWrite { tx in jobRecord.anyRemove(transaction: tx) }
+            return
+        }
+
+        var deletedCount = 0
+        await TimeGatedBatch.processAll(db: db) { tx -> TimeGatedBatch.ProcessBatchResult in
+            let batchDeletedCount = self.deleteSomeInteractions(
+                threadUniqueId: threadUniqueId,
+                anchorMessageRowId: anchorRowId,
+                tx: tx,
+            )
+            deletedCount += batchDeletedCount
+            return batchDeletedCount == 0 ? .done(()) : .more
+        }
+
+        logger.info("Deleted \(deletedCount) messages older than retention cutoff in thread \(threadUniqueId).")
+
+        await db.awaitableWrite { tx in
+            jobRecord.anyRemove(transaction: tx)
+        }
+    }
+
+    /// Delete a batch of interactions.
+    /// - Returns
+    /// The number of interactions deleted. A return value of 0 indicates that
+    /// there are no more interactions to delete.
+    private func deleteSomeInteractions(
+        threadUniqueId: String,
+        anchorMessageRowId: Int64,
+        tx: DBWriteTransaction,
+    ) -> Int {
+        let interactionsToDelete: [TSInteraction]
+        do {
+            interactionsToDelete = try InteractionFinder(
+                threadUniqueId: threadUniqueId,
+            ).fetchAllInteractions(
+                rowIdFilter: .atOrBefore(anchorMessageRowId),
+                limit: Constants.deletionBatchSize,
+                tx: tx,
+            )
+        } catch {
+            owsFailDebug("Failed to get interactions to delete!")
+            return 0
+        }
+
+        if interactionsToDelete.isEmpty { return 0 }
+
+        for interaction in interactionsToDelete {
+            interactionDeleteManager.delete(
+                interaction,
+                sideEffects: .custom(
+                    associatedCallDelete: .localDeleteOnly,
+                    updateThreadOnInteractionDelete: .doNotUpdate,
+                ),
+                tx: tx,
+            )
+        }
+
+        /// Above, we're skipping a per-interaction thread update that would
+        /// otherwise set various "last visible" properties on the thread. To
+        /// compensate, we'll do a single thread update at the end of each
+        /// transaction (note that because we're in a `TimeGatedBatch`, we don't
+        /// know how many interactions will be deleted in a single transaction).
+        /// This ensures the conversation's preview and unread count are
+        /// correct as soon as this transaction commits.
+        tx.addFinalizationBlock(key: "MessageRetentionCleanupJobQueue") { tx in
+            if
+                let thread = self.threadStore.fetchThread(
+                    uniqueId: threadUniqueId,
+                    tx: tx,
+                )
+            {
+                thread.updateOnInteractionsRemoved(
+                    needsToUpdateLastInteractionRowId: true,
+                    needsToUpdateLastVisibleSortId: true,
+                    tx: tx,
+                )
+            }
+        }
+
+        return interactionsToDelete.count
+    }
+}
+
+// MARK: -
+
+private class MessageRetentionCleanupJobRunnerFactory: JobRunnerFactory {
+    typealias JobRunnerType = MessageRetentionCleanupJobRunner
+
+    private let db: any DB
+    private let interactionDeleteManager: InteractionDeleteManager
+    private let threadStore: ThreadStore
+
+    init(
+        db: any DB,
+        interactionDeleteManager: InteractionDeleteManager,
+        threadStore: ThreadStore,
+    ) {
+        self.db = db
+        self.interactionDeleteManager = interactionDeleteManager
+        self.threadStore = threadStore
+    }
+
+    func buildRunner() -> MessageRetentionCleanupJobRunner {
+        return MessageRetentionCleanupJobRunner(
+            db: db,
+            interactionDeleteManager: interactionDeleteManager,
+            threadStore: threadStore,
+        )
+    }
+}
diff --git a/SignalServiceKit/Messages/MessageRetentionManager.swift b/SignalServiceKit/Messages/MessageRetentionManager.swift
new file mode 100644
index 0000000..b2ee7f4
--- /dev/null
+++ b/SignalServiceKit/Messages/MessageRetentionManager.swift
@@ -0,0 +1,100 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+/// Manages the user-configurable "keep messages for N days" retention
+/// setting, and enforces it by enqueuing durable, batched cleanup jobs (see
+/// ``MessageRetentionCleanupJobQueue``) rather than deleting anything
+/// directly.
+///
+/// Changing the retention window (including turning it on for the first
+/// time) immediately sweeps *all* existing threads, so the new window is
+/// applied retroactively to existing history rather than only to messages
+/// going forward.
+public protocol MessageRetentionManager {
+    /// The number of days of message history to keep, or `nil` if messages
+    /// are kept indefinitely (the default).
+    func retentionPeriodDays(tx: DBReadTransaction) -> UInt32?
+
+    /// Updates the retention window and immediately enqueues cleanup of
+    /// every thread's history older than the new cutoff. Pass `nil` to keep
+    /// history indefinitely going forward; this does not undelete anything
+    /// that was already removed.
+    func setRetentionPeriodDays(_ retentionPeriodDays: UInt32?, tx: DBWriteTransaction)
+
+    /// Re-enqueues cleanup for every thread using the currently-configured
+    /// retention window. A no-op if no window is configured. Cheap to call
+    /// redundantly: threads with nothing older than the cutoff, or with an
+    /// already-pending cleanup job, are skipped.
+    ///
+    /// Intended to be invoked periodically (e.g., from a daily Cron job) so
+    /// that messages continue to be trimmed as they age, not just at the
+    /// moment the setting is changed.
+    func sweepAllThreads(tx: DBWriteTransaction)
+}
+
+public class MessageRetentionManagerImpl: MessageRetentionManager {
+    private enum Constants {
+        static let retentionPeriodDaysKey = "retentionPeriodDays"
+    }
+
+    private static let keyValueStore = KeyValueStore(collection: "MessageRetentionManager")
+
+    private let dateProvider: DateProvider
+    private let messageRetentionCleanupJobQueue: MessageRetentionCleanupJobQueue
+    private let threadStore: ThreadStore
+
+    init(
+        dateProvider: @escaping DateProvider,
+        messageRetentionCleanupJobQueue: MessageRetentionCleanupJobQueue,
+        threadStore: ThreadStore,
+    ) {
+        self.dateProvider = dateProvider
+        self.messageRetentionCleanupJobQueue = messageRetentionCleanupJobQueue
+        self.threadStore = threadStore
+    }
+
+    public func retentionPeriodDays(tx: DBReadTransaction) -> UInt32? {
+        Self.keyValueStore.getUInt32(Constants.retentionPeriodDaysKey, transaction: tx)
+    }
+
+    public func setRetentionPeriodDays(_ retentionPeriodDays: UInt32?, tx: DBWriteTransaction) {
+        if let retentionPeriodDays {
+            Self.keyValueStore.setUInt32(retentionPeriodDays, key: Constants.retentionPeriodDaysKey, transaction: tx)
+        } else {
+            Self.keyValueStore.removeValue(forKey: Constants.retentionPeriodDaysKey, transaction: tx)
+        }
+
+        sweepAllThreads(tx: tx)
+    }
+
+    public func sweepAllThreads(tx: DBWriteTransaction) {
+        guard let cutoffTimestampMs = self.cutoffTimestampMs(tx: tx) else {
+            return
+        }
+
+        do {
+            try threadStore.enumerateNonStoryThreads(tx: tx) { thread in
+                self.messageRetentionCleanupJobQueue.addJob(
+                    threadUniqueId: thread.uniqueId,
+                    cutoffTimestampMs: cutoffTimestampMs,
+                    tx: tx,
+                )
+                return true
+            }
+        } catch {
+            owsFailDebug("Unexpected error enumerating threads for retention cleanup: \(error)")
+        }
+    }
+
+    private func cutoffTimestampMs(tx: DBReadTransaction) -> UInt64? {
+        guard let retentionPeriodDays = retentionPeriodDays(tx: tx) else {
+            return nil
+        }
+
+        let nowMs = dateProvider().ows_millisecondsSince1970
+        let retentionPeriodMs = UInt64(retentionPeriodDays) * .dayInMs
+        return retentionPeriodMs < nowMs ? nowMs - retentionPeriodMs : 0
+    }
+}
