+
+    // MARK: - Message Retention
+
+    private static var messageRetentionDurationDaysKey: String { "messageRetentionDurationDays" }
+
+    /// The number of days of message history to keep across all
+    /// conversations, or `nil` if retention-based cleanup is turned off and
+    /// history should be kept forever.
+    public static func messageRetentionDurationDays(transaction: DBReadTransaction) -> Int? {
+        let days = store.getInt(messageRetentionDurationDaysKey, defaultValue: 0, transaction: transaction)
+        return days > 0 ? days : nil
+    }
+
+    public static func setMessageRetentionDurationDays(_ newValue: Int?, transaction: DBWriteTransaction) {
+        store.setInt(newValue ?? 0, key: messageRetentionDurationDaysKey, transaction: transaction)
+    }
 }
