@@ -0,0 +1,90 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+import SignalServiceKit
+import SignalUI
+
+final class MessageRetentionSettingsViewController: OWSTableViewController2 {
+    static let presetRetentionDurationsDays: [Int] = [30, 90, 365]
+
+    private var retentionDurationDays: Int?
+    private let updateHandler: (_ retentionDurationDays: Int?) -> Void
+
+    static func loadWithSneakyTransaction(updateHandler: @escaping (_ retentionDurationDays: Int?) -> Void) -> Self {
+        let databaseStorage = SSKEnvironment.shared.databaseStorageRef
+        return Self(
+            retentionDurationDays: databaseStorage.read { SSKPreferences.messageRetentionDurationDays(transaction: $0) },
+            updateHandler: updateHandler,
+        )
+    }
+
+    init(
+        retentionDurationDays: Int?,
+        updateHandler: @escaping (_ retentionDurationDays: Int?) -> Void,
+    ) {
+        self.retentionDurationDays = retentionDurationDays
+        self.updateHandler = updateHandler
+        super.init()
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+
+        title = OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_ITEM_TITLE",
+            comment: "Item title for the message retention setting",
+        )
+
+        updateTableContents()
+    }
+
+    private func updateTableContents() {
+        let contents = OWSTableContents()
+        defer { self.contents = contents }
+
+        let section = OWSTableSection()
+        section.footerTitle = OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_SECTION_FOOTER",
+            comment: "Footer explaining that choosing a duration deletes older messages, in every chat, including messages already received.",
+        )
+
+        section.add(retentionItem(nil))
+        for days in Self.presetRetentionDurationsDays {
+            section.add(retentionItem(days))
+        }
+
+        contents.add(section)
+    }
+
+    private func retentionItem(_ days: Int?) -> OWSTableItem {
+        return OWSTableItem(
+            text: Self.localizedString(forRetentionDurationDays: days),
+            actionBlock: { [weak self] in
+                self?.changeRetentionDuration(days)
+            },
+            accessoryType: self.retentionDurationDays == days ? .checkmark : .none,
+        )
+    }
+
+    private func changeRetentionDuration(_ days: Int?) {
+        retentionDurationDays = days
+        updateHandler(days)
+        navigationController?.popViewController(animated: true)
+    }
+
+    static func localizedString(forRetentionDurationDays days: Int?) -> String {
+        guard let days else {
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_OFF",
+                comment: "Option indicating that messages are kept forever and are not automatically deleted.",
+            )
+        }
+        let format = OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_DAYS_FORMAT",
+            comment: "Option indicating messages older than the given number of days are automatically deleted. Embeds {{ the number of days }}.",
+        )
+        return String(format: format, days)
+    }
+}
