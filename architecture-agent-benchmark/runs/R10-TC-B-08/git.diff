diff --git a/SignalServiceKit/Messages/MessageRetentionExpirationJob.swift b/SignalServiceKit/Messages/MessageRetentionExpirationJob.swift
new file mode 100644
index 0000000..0e0af50
--- /dev/null
+++ b/SignalServiceKit/Messages/MessageRetentionExpirationJob.swift
@@ -0,0 +1,82 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+/// Continuously deletes interactions across every conversation once they're
+/// older than the user's configured message retention window.
+///
+/// This mirrors ``DisappearingMessagesExpirationJob``, but rather than acting
+/// on a per-message expiration timer stored on each row, it derives an
+/// expiration date on the fly from the interaction's `receivedAtTimestamp`
+/// and the globally configured retention duration
+/// (``SSKPreferences/messageRetentionDurationDays(transaction:)``).
+///
+/// Because that expiration date is always re-derived from persisted state
+/// rather than cached, this job is safe to interrupt at any point — app
+/// termination, backgrounding, a dropped network connection, or the user
+/// signing out mid-sweep — and cheap to resume: the next run simply asks
+/// "what's still older than the cutoff?" again rather than replaying any
+/// saved progress. The same property means turning retention on for the
+/// first time immediately reaches back into existing history instead of
+/// only affecting messages received afterward: every interaction, old or
+/// new, is subject to the same cutoff check.
+///
+/// Deletion happens in small time-boxed batches (see `TimeGatedBatch`, used
+/// by the base ``ExpirationJob``), so a large cleanup never holds a single
+/// long-running write transaction or blocks the main thread. Each deleted
+/// interaction is removed via `InteractionDeleteManager`, in the same write
+/// transaction that updates its thread's last-visible-interaction state, so
+/// conversation previews and unread counts are correct as soon as that
+/// transaction commits.
+public final class MessageRetentionExpirationJob: ExpirationJob<TSInteraction> {
+    private let db: any DB
+    private let interactionDeleteManager: InteractionDeleteManager
+
+    init(
+        dateProvider: @escaping DateProvider,
+        db: any DB,
+        interactionDeleteManager: InteractionDeleteManager,
+    ) {
+        self.db = db
+        self.interactionDeleteManager = interactionDeleteManager
+
+        super.init(
+            dateProvider: dateProvider,
+            db: db,
+            logger: PrefixedLogger(prefix: "[MessageRetentionExpJob]"),
+        )
+    }
+
+    // MARK: -
+
+    override public func nextExpiringElement(tx: DBReadTransaction) -> TSInteraction? {
+        guard SSKPreferences.messageRetentionDurationDays(transaction: tx) != nil else {
+            return nil
+        }
+        return InteractionFinder.oldestInteractionByReceivedAtTimestamp(transaction: tx)
+    }
+
+    override public func expirationDate(ofElement interaction: TSInteraction) -> Date {
+        guard let retentionDurationDays = db.read(block: { tx in
+            SSKPreferences.messageRetentionDurationDays(transaction: tx)
+        }) else {
+            // Retention was turned off between finding this element and
+            // computing its expiration date. Treat it as not expiring;
+            // `restart()` will be called if/when retention is re-enabled.
+            return .distantFuture
+        }
+
+        let secondsPerDay: TimeInterval = 24 * 60 * 60
+        let retentionInterval = TimeInterval(retentionDurationDays) * secondsPerDay
+        return Date(millisecondsSince1970: interaction.receivedAtTimestamp).addingTimeInterval(retentionInterval)
+    }
+
+    override public func deleteExpiredElement(_ interaction: TSInteraction, tx: DBWriteTransaction) {
+        interactionDeleteManager.delete(
+            interaction,
+            sideEffects: .custom(associatedCallDelete: .localDeleteOnly),
+            tx: tx,
+        )
+    }
+}
