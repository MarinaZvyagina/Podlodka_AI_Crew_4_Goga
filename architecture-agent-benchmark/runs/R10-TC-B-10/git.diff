+    // MARK: - Message Retention
+
+    private static let messageRetentionPeriodOptions: [UInt32?] = [nil, 30, 90, 365]
+
+    private func formatMessageRetentionPeriod(_ days: UInt32?) -> String {
+        guard let days else {
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_FOREVER",
+                comment: "Label indicating that chat history is kept forever, i.e. message retention is disabled.",
+            )
+        }
+        if days == 365 {
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_1_YEAR",
+                comment: "Label indicating that chat history is kept for 1 year.",
+            )
+        }
+        return String(
+            format: OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_N_DAYS_FORMAT",
+                comment: "Label indicating that chat history is kept for {{number of days}}, e.g. '30 days'.",
+            ),
+            String(days),
+        )
+    }
+
+    private func showMessageRetentionPicker() {
+        let actionSheet = ActionSheetController(title: OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_TITLE",
+            comment: "Title for the setting that lets users automatically delete old messages after a chosen number of days.",
+        ))
+
+        for option in Self.messageRetentionPeriodOptions {
+            actionSheet.addAction(.init(
+                title: formatMessageRetentionPeriod(option),
+                handler: { [weak self] _ in
+                    self?.didSelectMessageRetentionPeriod(option)
+                },
+            ))
+        }
+
+        actionSheet.addAction(OWSActionSheets.cancelAction)
+
+        presentActionSheet(actionSheet)
+    }
+
+    private func didSelectMessageRetentionPeriod(_ days: UInt32?) {
+        Logger.info("selected message retention period: \(String(describing: days))")
+
+        SSKEnvironment.shared.databaseStorageRef.asyncWrite { tx in
+            SSKPreferences.setMessageRetentionPeriodDays(days, transaction: tx)
+
+            if let days {
+                // Apply the new (or changed) window retroactively right away,
+                // rather than waiting for the next throttled sweep.
+                SSKEnvironment.shared.bulkDeleteInteractionJobQueueRef.sweepMessageRetention(
+                    retentionPeriodDays: days,
+                    now: Date(),
+                    threadStore: DependenciesBridge.shared.threadStore,
+                    tx: tx,
+                )
+            }
+        } completion: { [weak self] in
+            self?.updateTableContents()
+        }
+    }
+
