+
+    // MARK: - Message Retention
+
+    private enum MessageRetentionConstants {
+        static let secondsPerDay: TimeInterval = 24 * 60 * 60
+        static let minSweepInterval: TimeInterval = 24 * 60 * 60
+    }
+
+    /// Enqueues a bulk-delete job for every thread with messages older than
+    /// the given retention window, applying the cutoff immediately.
+    public func sweepMessageRetention(
+        retentionPeriodDays: UInt32,
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        let cutoffTimestamp = now
+            .addingTimeInterval(-TimeInterval(retentionPeriodDays) * MessageRetentionConstants.secondsPerDay)
+            .ows_millisecondsSince1970
+
+        threadStore.enumerateNonStoryThreads(tx: tx) { thread -> Bool in
+            let interactionFinder = InteractionFinder(threadUniqueId: thread.uniqueId)
+            let cutoffRowId = interactionFinder.rowIdOfNewestInteraction(
+                receivedAtOrBefore: cutoffTimestamp,
+                tx: tx,
+            )
+
+            if cutoffRowId > 0 {
+                self.addJob(
+                    anchorMessageRowId: cutoffRowId,
+                    isFullThreadDelete: false,
+                    threadUniqueId: thread.uniqueId,
+                    tx: tx,
+                )
+            }
+
+            return true
+        }
+
+        SSKPreferences.setLastMessageRetentionSweepAt(now, transaction: tx)
+    }
+
+    /// Throttled wrapper around `sweepMessageRetention` for routine/automatic
+    /// triggers (e.g. app launch, foregrounding). No-ops if retention is
+    /// disabled or a sweep already ran recently.
+    func sweepMessageRetentionIfNeeded(
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        guard let retentionPeriodDays = SSKPreferences.messageRetentionPeriodDays(transaction: tx) else {
+            return
+        }
+
+        if
+            let lastSweptAt = SSKPreferences.lastMessageRetentionSweepAt(transaction: tx),
+            now.timeIntervalSince(lastSweptAt) < MessageRetentionConstants.minSweepInterval
+        {
+            return
+        }
+
+        sweepMessageRetention(
+            retentionPeriodDays: retentionPeriodDays,
+            now: now,
+            threadStore: threadStore,
+            tx: tx,
+        )
+    }
 }
 
