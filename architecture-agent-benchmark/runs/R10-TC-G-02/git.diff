+    // MARK: - Message Retention
+
+    private static var messageRetentionPeriodDaysKey: String { "messageRetentionPeriodDays" }
+
+    /// The number of days of chat history to keep, or `nil` if messages
+    /// should be kept forever.
+    public static func messageRetentionPeriodDays(transaction: DBReadTransaction) -> UInt32? {
+        return store.getUInt32(messageRetentionPeriodDaysKey, transaction: transaction)
+    }
+
+    public static func setMessageRetentionPeriodDays(_ newValue: UInt32?, transaction: DBWriteTransaction) {
+        guard let newValue else {
+            store.removeValue(forKey: messageRetentionPeriodDaysKey, transaction: transaction)
+            return
+        }
+        store.setUInt32(newValue, key: messageRetentionPeriodDaysKey, transaction: transaction)
+    }
+
+    private static var lastMessageRetentionSweepAtKey: String { "lastMessageRetentionSweepAt" }
+
+    public static func lastMessageRetentionSweepAt(transaction: DBReadTransaction) -> Date? {
+        return store.getDate(lastMessageRetentionSweepAtKey, transaction: transaction)
+    }
+
+    public static func setLastMessageRetentionSweepAt(_ newValue: Date, transaction: DBWriteTransaction) {
+        store.setDate(newValue, key: lastMessageRetentionSweepAtKey, transaction: transaction)
+    }
 }
