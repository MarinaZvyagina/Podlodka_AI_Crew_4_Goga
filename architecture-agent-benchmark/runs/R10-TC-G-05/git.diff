+import Foundation
+
 public final class BulkDeleteInteractionJobQueue {
+    private enum Constants {
+        static let secondsPerDay: TimeInterval = 24 * 60 * 60
+    }
+
     private let jobRunnerFactory: BulkDeleteInteractionJobRunnerFactory
     private let jobQueueRunner: JobQueueRunner<
         JobRecordFinderImpl<BulkDeleteInteractionJobRecord>,
@@ -64,6 +70,64 @@ public final class BulkDeleteInteractionJobQueue {
             self.jobQueueRunner.addPersistedJob(jobRecord)
         }
     }
+
+    /// Enumerates every non-story thread and enqueues a bulk-delete job for
+    /// any thread with messages older than the given retention window.
+    ///
+    /// Call sites that need the window applied immediately and retroactively
+    /// (e.g. the user just changed the retention setting) should call this
+    /// directly, bypassing the throttling in
+    /// ``sweepMessageRetentionIfNeeded(now:threadStore:tx:)``.
+    public func sweepMessageRetention(
+        retentionPeriodDays: UInt32,
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        let cutoffTimestamp = now
+            .addingTimeInterval(-TimeInterval(retentionPeriodDays) * Constants.secondsPerDay)
+            .ows_millisecondsSince1970
+
+        threadStore.enumerateNonStoryThreads(tx: tx) { thread in
+            let anchorMessageRowId = InteractionFinder(threadUniqueId: thread.uniqueId)
+                .rowIdOfNewestInteraction(receivedAtOrBefore: cutoffTimestamp, tx: tx)
+
+            if anchorMessageRowId > 0 {
+                self.addJob(
+                    anchorMessageRowId: anchorMessageRowId,
+                    isFullThreadDelete: false,
+                    threadUniqueId: thread.uniqueId,
+                    tx: tx,
+                )
+            }
+
+            return true
+        }
+    }
+
+    /// Throttled wrapper around
+    /// ``sweepMessageRetention(retentionPeriodDays:now:threadStore:tx:)`` for
+    /// routine/automatic triggers (app launch, foreground), so we don't
+    /// re-scan every thread more than once a day.
+    func sweepMessageRetentionIfNeeded(
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        guard let retentionPeriodDays = SSKPreferences.messageRetentionPeriodDays(transaction: tx) else {
+            return
+        }
+
+        if
+            let lastSweptAt = SSKPreferences.lastMessageRetentionSweepAt(transaction: tx),
+            now.timeIntervalSince(lastSweptAt) < Constants.secondsPerDay
+        {
+            return
+        }
+
+        sweepMessageRetention(retentionPeriodDays: retentionPeriodDays, now: now, threadStore: threadStore, tx: tx)
+        SSKPreferences.setLastMessageRetentionSweepAt(now, transaction: tx)
+    }
 }
 
