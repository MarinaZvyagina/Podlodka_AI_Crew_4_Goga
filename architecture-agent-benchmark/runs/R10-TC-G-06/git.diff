index d7b0be7..f7ae276 100644
--- a/SignalServiceKit/Jobs/BulkDeleteInteractionJobQueue.swift
+++ b/SignalServiceKit/Jobs/BulkDeleteInteractionJobQueue.swift
@@ -64,6 +64,64 @@ public final class BulkDeleteInteractionJobQueue {
             self.jobQueueRunner.addPersistedJob(jobRecord)
         }
     }
+
+    // MARK: - Message Retention
+
+    private enum MessageRetentionConstants {
+        static let secondsPerDay: TimeInterval = 24 * 60 * 60
+        /// Minimum time between automatic (launch/foreground-triggered) sweeps.
+        static let minSweepInterval: TimeInterval = 24 * 60 * 60
+    }
+
+    /// Deletes messages older than the given retention window across all of
+    /// the user's (non-story) threads, by enqueuing the existing bulk-delete
+    /// job per thread. Safe to call unconditionally/repeatedly; threads with
+    /// nothing to delete are skipped.
+    public func sweepMessageRetention(
+        retentionPeriodDays: UInt32,
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        let cutoffInterval = TimeInterval(retentionPeriodDays) * MessageRetentionConstants.secondsPerDay
+        let cutoffTimestamp = UInt64(max(0, now.addingTimeInterval(-cutoffInterval).timeIntervalSince1970 * 1000))
+
+        threadStore.enumerateNonStoryThreads(tx: tx) { thread in
+            let interactionFinder = InteractionFinder(threadUniqueId: thread.uniqueId)
+            if let anchorRowId = interactionFinder.rowIdOfNewestInteraction(receivedAtOrBefore: cutoffTimestamp, tx: tx) {
+                self.addJob(
+                    anchorMessageRowId: anchorRowId,
+                    isFullThreadDelete: false,
+                    threadUniqueId: thread.uniqueId,
+                    tx: tx,
+                )
+            }
+            return true
+        }
+    }
+
+    /// Throttled wrapper around ``sweepMessageRetention(retentionPeriodDays:now:threadStore:tx:)``
+    /// for routine/automatic triggers (app launch, foregrounding). Does
+    /// nothing if retention is disabled or a sweep already ran recently.
+    func sweepMessageRetentionIfNeeded(
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        guard let retentionPeriodDays = SSKPreferences.messageRetentionPeriodDays(transaction: tx) else {
+            return
+        }
+
+        if
+            let lastSweepAt = SSKPreferences.lastMessageRetentionSweepAt(transaction: tx),
+            now.timeIntervalSince(lastSweepAt) < MessageRetentionConstants.minSweepInterval
+        {
+            return
+        }
+
+        sweepMessageRetention(retentionPeriodDays: retentionPeriodDays, now: now, threadStore: threadStore, tx: tx)
+        SSKPreferences.setLastMessageRetentionSweepAt(now, transaction: tx)
+    }
 }
 
