+    // MARK: - Message Retention
+
+    /// `nil` represents "keep messages forever".
+    private static let messageRetentionPeriodDaysOptions: [UInt32?] = [nil, 30, 90, 365]
+
+    private static func formatMessageRetentionPeriodDays(_ days: UInt32?) -> String {
+        switch days {
+        case nil:
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_FOREVER",
+                comment: "Option in the 'keep messages' picker indicating chat history is never automatically deleted.",
+            )
+        case 365:
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_1_YEAR",
+                comment: "Option in the 'keep messages' picker indicating chat history is kept for 1 year.",
+            )
+        case let .some(days):
+            let format = OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_N_DAYS_FORMAT",
+                comment: "Option in the 'keep messages' picker indicating chat history is kept for the given number of days. Embeds {{ the number of days }}.",
+            )
+            return String(format: format, Int(days))
+        }
+    }
+
+    private func showMessageRetentionPeriodPicker() {
+        let actionSheet = ActionSheetController(title: OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_TITLE",
+            comment: "Label for the 'keep messages' retention-window setting in the Chats settings.",
+        ))
+
+        for retentionPeriodDays in Self.messageRetentionPeriodDaysOptions {
+            actionSheet.addAction(.init(
+                title: Self.formatMessageRetentionPeriodDays(retentionPeriodDays),
+                handler: { [weak self] _ in
+                    self?.didSetMessageRetentionPeriodDays(retentionPeriodDays)
+                },
+            ))
+        }
+
+        actionSheet.addAction(OWSActionSheets.cancelAction)
+
+        presentActionSheet(actionSheet)
+    }
+
+    private func didSetMessageRetentionPeriodDays(_ retentionPeriodDays: UInt32?) {
+        Logger.info("Setting message retention period to \(retentionPeriodDays.map(String.init) ?? "forever") days")
+
+        let threadStore = DependenciesBridge.shared.threadStore
+        let bulkDeleteInteractionJobQueue = SSKEnvironment.shared.bulkDeleteInteractionJobQueueRef
+
+        // Write off the main thread: this enumerates every conversation to
+        // decide which need a retention sweep, which we don't want to do
+        // synchronously on the UI thread.
+        SSKEnvironment.shared.databaseStorageRef.asyncWrite(block: { tx in
+            SSKPreferences.setMessageRetentionPeriodDays(retentionPeriodDays, transaction: tx)
+
+            // Apply the new window retroactively (including turning it on for
+            // the first time) rather than only to future messages, by
+            // immediately enqueuing resumable/batched deletion of any
+            // now-out-of-window messages across all conversations. The actual
+            // deletion happens asynchronously, in small batches, via the
+            // persisted job queue.
+            if let retentionPeriodDays {
+                bulkDeleteInteractionJobQueue.sweepMessageRetention(
+                    retentionPeriodDays: retentionPeriodDays,
+                    now: Date(),
+                    threadStore: threadStore,
+                    tx: tx,
+                )
+            }
+        }, completion: { [weak self] in
+            self?.updateTableContents()
+        })
+    }
+
