+    // MARK: - Message retention
+
+    private enum RetentionSweepConstants {
+        /// How often an unforced ``sweepMessageRetentionIfNeeded`` call will
+        /// actually re-scan every thread for out-of-window messages.
+        static let minIntervalBetweenSweeps: TimeInterval = .day
+    }
+
+    /// If the user has configured a message-retention window (see
+    /// ``SSKPreferences/messageRetentionPeriodDays(transaction:)``) and it's
+    /// been a while since the last sweep, looks for threads containing
+    /// messages older than that window and enqueues a resumable bulk-delete
+    /// job (see ``addJob``) for each. Safe and cheap to call frequently (e.g.
+    /// on every app launch/foreground) since it no-ops when disabled or
+    /// recently swept.
+    public func sweepMessageRetentionIfNeeded(
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        guard let retentionPeriodDays = SSKPreferences.messageRetentionPeriodDays(transaction: tx) else {
+            return
+        }
+        if
+            let lastSweptAt = SSKPreferences.lastMessageRetentionSweepAt(transaction: tx),
+            now.timeIntervalSince(lastSweptAt) < RetentionSweepConstants.minIntervalBetweenSweeps
+        {
+            return
+        }
+
+        sweepMessageRetention(retentionPeriodDays: retentionPeriodDays, now: now, threadStore: threadStore, tx: tx)
+    }
+
+    /// Unconditionally looks for threads containing messages older than
+    /// `retentionPeriodDays` and enqueues a resumable bulk-delete job for
+    /// each. Called directly (bypassing the sweep-frequency throttle in
+    /// ``sweepMessageRetentionIfNeeded``) whenever the user changes the
+    /// retention window, so the new window is applied retroactively right
+    /// away rather than only to future messages.
+    public func sweepMessageRetention(
+        retentionPeriodDays: UInt32,
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        SSKPreferences.setLastMessageRetentionSweepAt(now, transaction: tx)
+
+        let cutoffTimestamp = now.addingTimeInterval(-TimeInterval(retentionPeriodDays) * .day).ows_millisecondsSince1970
+
+        var threadUniqueIds = [String]()
+        threadStore.enumerateNonStoryThreads(tx: tx) { thread in
+            threadUniqueIds.append(thread.uniqueId)
+            return true
+        }
+
+        for threadUniqueId in threadUniqueIds {
+            guard let anchorMessageRowId = InteractionFinder(threadUniqueId: threadUniqueId)
+                .rowIdOfNewestInteraction(receivedAtOrBefore: cutoffTimestamp, tx: tx)
+            else {
+                continue
+            }
+
+            addJob(
+                anchorMessageRowId: anchorMessageRowId,
+                isFullThreadDelete: false,
+                threadUniqueId: threadUniqueId,
+                tx: tx,
+            )
+        }
+    }
 }
 
