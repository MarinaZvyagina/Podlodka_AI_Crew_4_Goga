index 10ddd2a..ddad18d 100644
--- a/SignalServiceKit/Storage/Database/Records/InteractionFinder.swift
+++ b/SignalServiceKit/Storage/Database/Records/InteractionFinder.swift
@@ -1347,6 +1347,27 @@ public class InteractionFinder: NSObject {
 
         return mostRecentRowId
     }
+
+    /// The SQLite row ID of the newest interaction covered by this finder that
+    /// was received at or before the given millisecond timestamp, or `nil` if
+    /// there is no such interaction.
+    ///
+    /// Used to translate a retention-policy cutoff date into a row ID anchor
+    /// suitable for ``RowIdFilter/atOrBefore(_:)``.
+    func rowIdOfNewestInteraction(receivedAtOrBefore timestamp: UInt64, tx: DBReadTransaction) -> Int64? {
+        let sql = """
+        SELECT MAX(\(interactionColumn: .id))
+        FROM \(InteractionRecord.databaseTableName)
+        WHERE \(interactionColumn: .threadUniqueId) = ?
+        AND \(interactionColumn: .receivedAtTimestamp) <= ?
+        """
+        do {
+            return try Int64.fetchOne(tx.database, sql: sql, arguments: [threadUniqueId, timestamp])
+        } catch {
+            owsFailDebug("Failed to find newest interaction row ID before cutoff: \(error)")
+            return nil
+        }
+    }
 }
 
