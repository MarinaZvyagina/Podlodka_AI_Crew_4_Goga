+
+    // MARK: - Message Retention
+
+    private enum RetentionConstants {
+        static let secondsPerDay: TimeInterval = 24 * 60 * 60
+        static let minSweepInterval: TimeInterval = 24 * 60 * 60
+    }
+
+    /// Enumerates every non-story thread and enqueues a bulk-delete job for
+    /// any thread that has messages older than the retention window.
+    ///
+    /// - Parameter retentionPeriodDays: how many days of history to keep, or
+    /// `nil` if there's no retention window configured (a no-op).
+    public func sweepMessageRetention(
+        retentionPeriodDays: UInt32?,
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        guard let retentionPeriodDays else { return }
+
+        let cutoffTimestamp = UInt64(
+            now.addingTimeInterval(-TimeInterval(retentionPeriodDays) * RetentionConstants.secondsPerDay).timeIntervalSince1970 * 1000,
+        )
+
+        threadStore.enumerateNonStoryThreads(tx: tx) { thread in
+            let interactionFinder = InteractionFinder(threadUniqueId: thread.uniqueId)
+            let anchorRowId = interactionFinder.rowIdOfNewestInteraction(
+                receivedAtOrBefore: cutoffTimestamp,
+                tx: tx,
+            )
+
+            if anchorRowId > 0 {
+                self.addJob(
+                    anchorMessageRowId: anchorRowId,
+                    isFullThreadDelete: false,
+                    threadUniqueId: thread.uniqueId,
+                    tx: tx,
+                )
+            }
+
+            return true
+        }
+
+        SSKPreferences.setLastMessageRetentionSweepAt(now, transaction: tx)
+    }
+
+    /// Throttled wrapper around `sweepMessageRetention` for routine/automatic
+    /// triggers (e.g. app launch, foregrounding) that shouldn't re-scan every
+    /// thread more than once a day.
+    func sweepMessageRetentionIfNeeded(
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        let retentionPeriodDays = SSKPreferences.messageRetentionPeriodDays(transaction: tx)
+        guard retentionPeriodDays != nil else { return }
+
+        if
+            let lastSweptAt = SSKPreferences.lastMessageRetentionSweepAt(transaction: tx),
+            now.timeIntervalSince(lastSweptAt) < RetentionConstants.minSweepInterval
+        {
+            return
+        }
+
+        sweepMessageRetention(retentionPeriodDays: retentionPeriodDays, now: now, threadStore: threadStore, tx: tx)
+    }
 }
 
