diff --git a/SignalServiceKit/Threads/ThreadDeletionManager.swift b/SignalServiceKit/Threads/ThreadDeletionManager.swift
index 96f477e..41bb0de 100644
--- a/SignalServiceKit/Threads/ThreadDeletionManager.swift
+++ b/SignalServiceKit/Threads/ThreadDeletionManager.swift
@@ -34,6 +34,15 @@ public protocol ThreadDeletionManager {
         tx: DBWriteTransaction,
     )
 
+    /// Removes every interaction in the given thread that was authored (sent)
+    /// by the local user, leaving interactions from other participants
+    /// untouched.
+    func removeAllInteractionsAuthoredByLocalUser(
+        thread: TSThread,
+        sendDeleteForMeSyncMessage: Bool,
+        tx: DBWriteTransaction,
+    )
+
     func removeIntentsForTerminatedGroup(threadUniqueId: String)
 }
 
@@ -155,6 +164,61 @@ final class ThreadDeletionManagerImpl: ThreadDeletionManager {
         }
     }
 
+    func removeAllInteractionsAuthoredByLocalUser(
+        thread: TSThread,
+        sendDeleteForMeSyncMessage: Bool,
+        tx: DBWriteTransaction,
+    ) {
+        let interactionFinder = InteractionFinder(threadUniqueId: thread.uniqueId)
+        var rowIdFilter: InteractionFinder.RowIdFilter = .newest
+
+        do {
+            var moreInteractionsRemaining = true
+            while moreInteractionsRemaining {
+                try autoreleasepool {
+                    let cursor = interactionFinder.buildOutgoingMessagesCursor(rowIdFilter: rowIdFilter, tx: tx)
+
+                    var batch = [TSInteraction]()
+                    while batch.count < Constants.interactionDeletionBatchSize, let interaction = try cursor.next() {
+                        batch.append(interaction)
+                    }
+
+                    guard let oldestRowIdInBatch = batch.last?.sqliteRowId else {
+                        moreInteractionsRemaining = false
+                        return
+                    }
+                    rowIdFilter = .before(oldestRowIdInBatch)
+
+                    interactionDeleteManager.delete(
+                        interactions: batch,
+                        sideEffects: .custom(
+                            associatedCallDelete: .localDeleteOnly,
+                            updateThreadOnInteractionDelete: .doNotUpdate,
+                            deleteForMeSyncMessage: sendDeleteForMeSyncMessage
+                                ? .sendSyncMessage(interactionsThread: thread)
+                                : .doNotSend,
+                        ),
+                        tx: tx,
+                    )
+
+                    moreInteractionsRemaining = batch.count == Constants.interactionDeletionBatchSize
+                }
+            }
+        } catch {
+            owsFailDebug("Failed to delete batch of interactions authored by local user!")
+            return
+        }
+
+        /// Some, none, or all of the thread's "last interaction" properties
+        /// may have referenced an interaction we just deleted; recompute them
+        /// now that we're done deleting in bulk.
+        thread.updateOnInteractionsRemoved(
+            needsToUpdateLastInteractionRowId: true,
+            needsToUpdateLastVisibleSortId: true,
+            tx: tx,
+        )
+    }
+
     func removeIntentsForTerminatedGroup(threadUniqueId: String) {
         intentsManager.deleteAllIntents(withGroupIdentifier: threadUniqueId)
     }
