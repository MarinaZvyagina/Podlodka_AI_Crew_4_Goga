--- a/SignalServiceKit/Storage/Database/Records/InteractionFinder.swift
+++ b/SignalServiceKit/Storage/Database/Records/InteractionFinder.swift
@@ -1179,6 +1179,29 @@ public class InteractionFinder: NSObject {
         )
     }
 
+    /// Fetch up to `limit` ``TSOutgoingMessage``s covered by this finder.
+    func fetchAllOutgoingMessages(
+        rowIdFilter: RowIdFilter,
+        limit: Int,
+        tx: DBReadTransaction,
+    ) throws -> [TSOutgoingMessage] {
+        var messages: [TSOutgoingMessage] = []
+
+        try buildOutgoingMessagesCursor(
+            rowIdFilter: rowIdFilter,
+            tx: tx,
+        ).enumerate { interaction -> Bool in
+            guard let message = interaction as? TSOutgoingMessage else {
+                return true
+            }
+
+            messages.append(message)
+            return messages.count < limit
+        }
+
+        return messages
+    }
+
     /// Returns a cursor over all ``TSOutgoingMessage``s covered by this finder
     /// that returns its next element in O(1) time.
     ///
