+    func removeAllInteractionsAuthoredByLocalUser(
+        thread: TSThread,
+        sendDeleteForMeSyncMessage: Bool,
+        tx: DBWriteTransaction,
+    ) {
+        logger.info("Deleting local user's messages in thread with ID \(thread.logString).")
+
+        do {
+            var moreMessagesRemaining = true
+            while moreMessagesRemaining {
+                try autoreleasepool {
+                    let messageBatch = try InteractionFinder(
+                        threadUniqueId: thread.uniqueId,
+                    ).fetchAllOutgoingMessages(
+                        rowIdFilter: .newest,
+                        limit: Constants.interactionDeletionBatchSize,
+                        tx: tx,
+                    )
+
+                    interactionDeleteManager.delete(
+                        interactions: messageBatch,
+                        sideEffects: .custom(
+                            associatedCallDelete: .localDeleteAndSendCallEventSyncMessage,
+                            updateThreadOnInteractionDelete: .updateOnEachDeletedInteraction,
+                            deleteForMeSyncMessage: sendDeleteForMeSyncMessage
+                                ? .sendSyncMessage(interactionsThread: thread)
+                                : .doNotSend,
+                        ),
+                        tx: tx,
+                    )
+
+                    moreMessagesRemaining = !messageBatch.isEmpty
+                }
+            }
+        } catch {
+            owsFailDebug("Failed to delete batch of local-authored interactions!")
+            return
+        }
+    }
+
     func removeIntentsForTerminatedGroup(threadUniqueId: String) {
         intentsManager.deleteAllIntents(withGroupIdentifier: threadUniqueId)
     }
