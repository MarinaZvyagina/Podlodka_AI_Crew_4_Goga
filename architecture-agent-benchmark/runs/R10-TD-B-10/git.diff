@@ -1162,6 +1162,28 @@ public class InteractionFinder: NSObject {
         return interactions
     }
 
+    /// Fetch a batch of the ``TSOutgoingMessage``s covered by this finder,
+    /// i.e. the messages sent by the local user.
+    func fetchOutgoingMessages(
+        rowIdFilter: RowIdFilter,
+        limit: Int,
+        tx: DBReadTransaction,
+    ) throws -> [TSInteraction] {
+        var interactions: [TSInteraction] = []
+
+        try buildInteractionCursor(
+            rowIdFilter: rowIdFilter,
+            additionalFiltering: .filterForOutgoingMessages,
+            limit: limit,
+            tx: tx,
+        ).enumerate { interaction -> Bool in
+            interactions.append(interaction)
+            return true
+        }
+
+        return interactions
+    }
+
