@@ -155,6 +168,59 @@ final class ThreadDeletionManagerImpl: ThreadDeletionManager {
         }
     }
 
+    func removeAllInteractionsSentByLocalUser(
+        thread: TSThread,
+        localIdentifiers: LocalIdentifiers,
+        tx: DBWriteTransaction,
+    ) {
+        let interactionFinder = InteractionFinder(threadUniqueId: thread.uniqueId)
+
+        var moreInteractionsRemaining = true
+        while moreInteractionsRemaining {
+            do {
+                try autoreleasepool {
+                    let interactionBatch = try interactionFinder.fetchOutgoingMessages(
+                        rowIdFilter: .newest,
+                        limit: Constants.interactionDeletionBatchSize,
+                        tx: tx,
+                    )
+
+                    // Every message here was sent by the local user, so this
+                    // is always addressable via the `DeleteForMe` sync
+                    // protocol; use the default `associatedCallDelete` side
+                    // effect (rather than `.localDeleteOnly`, as other bulk
+                    // deletes in this file use) so that any call history
+                    // entries caught up in this delete stay consistent with
+                    // their backing interaction being removed.
+                    interactionDeleteManager.delete(
+                        interactions: interactionBatch,
+                        sideEffects: .custom(
+                            updateThreadOnInteractionDelete: .doNotUpdate,
+                            deleteForMeSyncMessage: .sendSyncMessage(interactionsThread: thread),
+                        ),
+                        tx: tx,
+                    )
+
+                    moreInteractionsRemaining = !interactionBatch.isEmpty
+                }
+            } catch {
+                owsFailDebug("Failed to delete batch of interactions sent by local user!")
+                return
+            }
+        }
+
+        /// We skipped updating the thread for each deleted interaction above,
+        /// so recompute the thread's "last interaction" properties now that
+        /// we're done. Unlike a full ``removeAllInteractions``, we can't just
+        /// zero these out, since interactions from other participants may
+        /// remain in the thread.
+        thread.updateOnInteractionsRemoved(
+            needsToUpdateLastInteractionRowId: true,
+            needsToUpdateLastVisibleSortId: true,
+            tx: tx,
+        )
+    }
