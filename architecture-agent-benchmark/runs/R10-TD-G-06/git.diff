@@ -1196,6 +1196,31 @@ public class InteractionFinder: NSObject {
         )
     }
 
+    /// Fetch outgoing messages covered by this finder, up to the given limit.
+    func fetchAllOutgoingMessages(
+        rowIdFilter: RowIdFilter,
+        limit: Int,
+        tx: DBReadTransaction,
+    ) throws -> [TSOutgoingMessage] {
+        var messages: [TSOutgoingMessage] = []
+
+        try buildInteractionCursor(
+            rowIdFilter: rowIdFilter,
+            additionalFiltering: .filterForOutgoingMessages,
+            limit: limit,
+            tx: tx,
+        ).enumerate { interaction -> Bool in
+            guard let message = interaction as? TSOutgoingMessage else {
+                owsFailDebug("Unexpected interaction type for outgoing-messages filter!")
+                return true
+            }
+            messages.append(message)
+            return true
+        }
+
+        return messages
+    }
+
