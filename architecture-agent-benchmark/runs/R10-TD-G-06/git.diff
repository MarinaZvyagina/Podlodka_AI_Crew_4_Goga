+    func removeAllInteractionsAuthoredByLocalUser(
+        thread: TSThread,
+        tx: DBWriteTransaction,
+    ) {
+        do {
+            var moreMessagesRemaining = true
+            while moreMessagesRemaining {
+                try autoreleasepool {
+                    let messageBatch = try InteractionFinder(
+                        threadUniqueId: thread.uniqueId,
+                    ).fetchAllOutgoingMessages(
+                        rowIdFilter: .newest,
+                        limit: Constants.interactionDeletionBatchSize,
+                        tx: tx,
+                    )
+
+                    interactionDeleteManager.delete(
+                        interactions: messageBatch,
+                        sideEffects: .custom(
+                            associatedCallDelete: .localDeleteOnly,
+                            updateThreadOnInteractionDelete: .doNotUpdate,
+                            deleteForMeSyncMessage: .sendSyncMessage(interactionsThread: thread),
+                        ),
+                        tx: tx,
+                    )
+
+                    moreMessagesRemaining = !messageBatch.isEmpty
+                }
+            }
+        } catch {
+            owsFailDebug("Failed to delete batch of outgoing messages!")
+            return
+        }
+
+        /// Unlike a full-history clear, other participants' messages remain
+        /// in the thread, so recompute the last-interaction/last-visible
+        /// state from what's left rather than zeroing it.
+        thread.updateOnInteractionsRemoved(
+            needsToUpdateLastInteractionRowId: true,
+            needsToUpdateLastVisibleSortId: true,
+            tx: tx,
+        )
+    }
+
     func removeIntentsForTerminatedGroup(threadUniqueId: String) {
         intentsManager.deleteAllIntents(withGroupIdentifier: threadUniqueId)
     }
