diff --git a/tests/test_configuration.py b/tests/test_configuration.py
index 59516f6..de2b59e 100644
--- a/tests/test_configuration.py
+++ b/tests/test_configuration.py
@@ -1061,6 +1061,25 @@ def test__validate_demo_trading(default_conf_usdt) -> None:
     validate_config_consistency(conf)
 
 
+def test_validate_capital_settings(default_conf):
+    conf = deepcopy(default_conf)
+    conf["available_capital"] = 1000
+    conf["tradable_balance_ratio"] = 0.5
+
+    with pytest.raises(
+        ConfigurationError,
+        match=r"Both `available_capital` and `tradable_balance_ratio` are set.*",
+    ):
+        validate_config_consistency(conf)
+
+    del conf["tradable_balance_ratio"]
+    validate_config_consistency(conf)
+
+    del conf["available_capital"]
+    conf["tradable_balance_ratio"] = 0.5
+    validate_config_consistency(conf)
+
+
