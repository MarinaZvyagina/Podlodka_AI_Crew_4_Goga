+def test_validate_stake_amount_max_currency_exposure(mocker, default_conf):
+    default_conf["max_currency_exposure"] = 0.5
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=1000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+
+    mocker.patch(
+        "freqtrade.persistence.Trade.get_open_trades",
+        return_value=[
+            MagicMock(pair="LTC/BTC", stake_amount=300),
+            MagicMock(pair="XRP/USDT", stake_amount=400),
+        ],
+    )
+
+    # ETH/BTC shares its quote currency (BTC) with the open LTC/BTC trade (300 committed).
+    # Exposure cap is 0.5 * 1000 = 500 -> only 200 is left for this currency group.
+    assert freqtrade.wallets.validate_stake_amount("ETH/BTC", 300, 10, 10000, None) == 200
+
+    # ETH/USDT shares its quote currency (USDT) with XRP/USDT (400 committed) -> 100 left.
+    assert freqtrade.wallets.validate_stake_amount("ETH/USDT", 300, 10, 10000, None) == 100
+
+    # Group already at/above the cap -> the trade is skipped entirely.
+    mocker.patch(
+        "freqtrade.persistence.Trade.get_open_trades",
+        return_value=[MagicMock(pair="LTC/BTC", stake_amount=600)],
+    )
+    assert freqtrade.wallets.validate_stake_amount("ETH/BTC", 300, 10, 10000, None) == 0
+
+    # Position adjustment on the already-open pair: its own stake must not be double-counted,
+    # but is still added back via `trade_amount` before comparing against the cap.
+    assert freqtrade.wallets.validate_stake_amount("LTC/BTC", 50, 10, 10000, 600) == 0
+    assert freqtrade.wallets.validate_stake_amount("LTC/BTC", 50, 10, 10000, 400) == 50
+
+    # Disabled by default - no cap applied regardless of open exposure.
+    default_conf["max_currency_exposure"] = None
+    assert freqtrade.wallets.validate_stake_amount("ETH/BTC", 300, 10, 10000, None) == 300
+
+
