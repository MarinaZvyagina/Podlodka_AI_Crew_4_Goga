     # Configuration for diskusage beacon should be a list of dicts
     if not isinstance(config, list):
         return False, "Configuration for diskusage beacon must be a list."
+
+    valid_keys = {"minimum", "maximum"}
+    for mounts in config:
+        if not isinstance(mounts, dict):
+            return False, "Configuration for diskusage beacon must be a list of dicts."
+        for mount, monitor_usage in mounts.items():
+            if mount.startswith("_") or not isinstance(monitor_usage, dict):
+                continue
+            extra_keys = set(monitor_usage) - valid_keys
+            if extra_keys:
+                return (
+                    False,
+                    f"Invalid keys {sorted(extra_keys)} for mount {mount}, "
+                    f"only {sorted(valid_keys)} are supported.",
+                )
+            if not monitor_usage:
+                return (
+                    False,
+                    f"Mount {mount} must define a minimum and/or a maximum.",
+                )
     return True, "Valid beacon configuration"
 
 
