+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('notifyShutdown', () => {
+    it('should send a shutdown notice to every open client and resolve once flushed', async () => {
+      const openClient = {
+        readyState: 1,
+        send: vi.fn((_data: string, cb: () => void) => cb()),
+      };
+      const connectingClient = { readyState: 0, send: vi.fn() };
+      const fakeServer = {
+        clients: new Set([openClient, connectingClient]),
+      } as any;
+
+      await adapter.notifyShutdown(fakeServer);
+
+      expect(openClient.send).toHaveBeenCalledTimes(1);
+      const payload = JSON.parse(openClient.send.mock.calls[0][0]);
+      expect(payload).toEqual({
+        event: 'shutdown',
+        data: { message: expect.any(String) },
+      });
+      expect(connectingClient.send).not.toHaveBeenCalled();
+    });
+
+    it('should be a no-op when there are no connected clients', async () => {
+      const fakeServer = { clients: new Set() } as any;
+
+      await expect(adapter.notifyShutdown(fakeServer)).resolves.toBeUndefined();
+    });
+
+    it('should be a no-op when the server has no client registry', async () => {
+      const fakeServer = {} as any;
+
+      await expect(adapter.notifyShutdown(fakeServer)).resolves.toBeUndefined();
+    });
+  });
+});
