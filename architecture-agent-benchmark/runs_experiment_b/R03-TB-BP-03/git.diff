@@ -0,0 +1,97 @@
+import { INestApplication } from '@nestjs/common';
+import { WsAdapter } from '@nestjs/platform-ws';
+import { Test } from '@nestjs/testing';
+import { io } from 'socket.io-client';
+import WebSocket from 'ws';
+import { ApplicationGateway } from '../src/app.gateway.js';
+import { ServerGateway } from '../src/server.gateway.js';
+
+describe('WebSocket graceful shutdown notice', () => {
+  let app: INestApplication;
+
+  afterEach(async () => {
+    if (app) {
+      await app.close().catch(() => {});
+    }
+  });
+
+  it('should notify connected socket.io clients before disconnecting them on app.close()', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [ServerGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    await app.listen(3000);
+
+    const client = io('http://localhost:3000');
+    await new Promise<void>(resolve => client.on('connect', resolve));
+
+    const events: string[] = [];
+    const shutdownMessage = new Promise<any>(resolve => {
+      client.on('shutdown', payload => {
+        events.push('shutdown');
+        resolve(payload);
+      });
+    });
+    const disconnected = new Promise<void>(resolve => {
+      client.on('disconnect', () => {
+        events.push('disconnect');
+        resolve();
+      });
+    });
+
+    await app.close();
+
+    const payload = await shutdownMessage;
+    await disconnected;
+
+    expect(payload).toEqual({ message: expect.any(String) });
+    expect(events).toEqual(['shutdown', 'disconnect']);
+  });
+
+  it('should notify connected ws clients before disconnecting them on app.close()', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [ApplicationGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    app.useWebSocketAdapter(new WsAdapter(app) as any);
+    await app.listen(3000);
+
+    const client = new WebSocket('ws://localhost:8080');
+    await new Promise(resolve => client.on('open', resolve));
+
+    const events: string[] = [];
+    const shutdownMessage = new Promise<any>(resolve => {
+      client.on('message', data => {
+        const parsed = JSON.parse(data.toString());
+        if (parsed.event === 'shutdown') {
+          events.push('shutdown');
+          resolve(parsed.data);
+        }
+      });
+    });
+    const closed = new Promise<void>(resolve => {
+      client.on('close', () => {
+        events.push('close');
+        resolve();
+      });
+    });
+
+    await app.close();
+
+    const payload = await shutdownMessage;
+    await closed;
+
+    expect(payload).toEqual({ message: expect.any(String) });
+    expect(events).toEqual(['shutdown', 'close']);
+  });
+
+  it('should not error when closing an app whose gateway has no connected clients', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [ServerGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    await app.listen(3000);
+
+    await expect(app.close()).resolves.toBeUndefined();
+  });
+});
