@@ -0,0 +1,85 @@
+import { ApplicationConfig } from '@nestjs/core/application-config.js';
+import { AbstractWsAdapter } from '../adapters/ws-adapter.js';
+import { SocketModule } from '../socket-module.js';
+import { SocketsContainer } from '../sockets-container.js';
+
+class NoopAdapter extends AbstractWsAdapter {
+  public create(port: number, options?: any) {}
+  public bindMessageHandlers(client: any, handlers: any) {}
+}
+
+class ShutdownAwareAdapter extends NoopAdapter {
+  public notifyShutdown(server: any) {}
+}
+
+describe('SocketModule', () => {
+  let instance: SocketModule;
+
+  beforeEach(() => {
+    instance = new SocketModule();
+  });
+
+  describe('close', () => {
+    it('should be a no-op when no application config has ever been set (no gateways registered)', async () => {
+      await expect(instance.close()).resolves.toBeUndefined();
+    });
+
+    it('should be a no-op when the application config has no io adapter', async () => {
+      (instance as any).applicationConfig = new ApplicationConfig();
+      await expect(instance.close()).resolves.toBeUndefined();
+    });
+
+    it('should be a no-op when no server was ever created (no connected gateways)', async () => {
+      const adapter = new ShutdownAwareAdapter();
+      const notifyShutdownSpy = vi.spyOn(adapter, 'notifyShutdown');
+      const closeSpy = vi.spyOn(adapter, 'close');
+
+      (instance as any).applicationConfig = new ApplicationConfig(adapter);
+
+      await instance.close();
+
+      expect(notifyShutdownSpy).not.toHaveBeenCalled();
+      expect(closeSpy).not.toHaveBeenCalled();
+    });
+
+    it('should notify each server of the impending shutdown before closing it', async () => {
+      const adapter = new ShutdownAwareAdapter();
+      const calls: string[] = [];
+      vi.spyOn(adapter, 'notifyShutdown').mockImplementation(() =>
+        calls.push('notify'),
+      );
+      vi.spyOn(adapter, 'close').mockImplementation(async () => {
+        calls.push('close');
+      });
+      const disposeSpy = vi.spyOn(adapter, 'dispose');
+
+      (instance as any).applicationConfig = new ApplicationConfig(adapter);
+      const socketsContainer: SocketsContainer = (instance as any)
+        .socketsContainer;
+      const server = { id: 'server-1' };
+      socketsContainer.addOne({ path: '/' } as any, { server } as any);
+
+      await instance.close();
+
+      expect(adapter.notifyShutdown).toHaveBeenCalledWith(server);
+      expect(adapter.close).toHaveBeenCalledWith(server);
+      expect(calls).toEqual(['notify', 'close']);
+      expect(disposeSpy).toHaveBeenCalled();
+      expect(socketsContainer.getAll().size).toBe(0);
+    });
+
+    it('should still close servers when the adapter does not implement notifyShutdown', async () => {
+      const adapter = new NoopAdapter();
+      const closeSpy = vi.spyOn(adapter, 'close').mockResolvedValue(undefined);
+
+      (instance as any).applicationConfig = new ApplicationConfig(adapter);
+      const socketsContainer: SocketsContainer = (instance as any)
+        .socketsContainer;
+      const server = { id: 'server-1' };
+      socketsContainer.addOne({ path: '/' } as any, { server } as any);
+
+      await expect(instance.close()).resolves.toBeUndefined();
+      expect(closeSpy).toHaveBeenCalledWith(server);
+    });
+  });
+});
