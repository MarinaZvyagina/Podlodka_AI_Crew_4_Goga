+++ b/packages/websockets/constants.ts
@@ -13,3 +13,17 @@ export const CONNECTION_EVENT = 'connection';
 export const DISCONNECT_EVENT = 'disconnect';
 export const CLOSE_EVENT = 'close';
 export const ERROR_EVENT = 'error';
+
+/**
+ * Event name emitted to connected clients right before the server closes
+ * their connection as part of the application's graceful shutdown sequence.
+ */
+export const SHUTDOWN_EVENT = 'shutdown';
+export const DEFAULT_SHUTDOWN_MESSAGE =
+  'Server is shutting down, please reconnect.';
+/**
+ * Upper bound on how long a single client's shutdown notice is allowed to
+ * take to flush before shutdown proceeds regardless. Keeps a stalled/slow
+ * client from delaying the whole graceful-shutdown sequence.
+ */
+export const SHUTDOWN_NOTICE_FLUSH_TIMEOUT = 250;
