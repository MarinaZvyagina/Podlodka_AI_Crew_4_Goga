@@ -0,0 +1,77 @@
+import { INestApplication } from '@nestjs/common';
+import { WsAdapter } from '@nestjs/platform-ws';
+import { Test } from '@nestjs/testing';
+import { io } from 'socket.io-client';
+import WebSocket from 'ws';
+import { ShutdownGateway } from '../src/shutdown.gateway.js';
+
+describe('WebSocket graceful shutdown notification', () => {
+  let app: INestApplication;
+
+  afterEach(async () => {
+    if (app) {
+      await app.close();
+    }
+  });
+
+  it('notifies socket.io clients before closing their connection', async () => {
+    const moduleRef = await Test.createTestingModule({
+      providers: [ShutdownGateway],
+    }).compile();
+    app = moduleRef.createNestApplication();
+    await app.listen(3010);
+
+    // Force the websocket transport directly: the polling->websocket upgrade
+    // dance is irrelevant to what this test verifies, and leaving it in would
+    // race the shutdown notice against the upgrade handshake.
+    const client = io('http://localhost:3010', {
+      reconnection: false,
+      transports: ['websocket'],
+    });
+    await new Promise<void>((resolve, reject) => {
+      client.on('connect', resolve);
+      client.on('connect_error', reject);
+    });
+
+    const shutdownNotice = new Promise<string>(resolve =>
+      client.once('shutdown', resolve),
+    );
+    const disconnected = new Promise<void>(resolve =>
+      client.once('disconnect', () => resolve()),
+    );
+
+    await app.close();
+
+    expect(typeof (await shutdownNotice)).toBe('string');
+    await disconnected;
+    client.close();
+  });
+
+  it('notifies ws clients before closing their connection', async () => {
+    const moduleRef = await Test.createTestingModule({
+      providers: [ShutdownGateway],
+    }).compile();
+    app = moduleRef.createNestApplication();
+    app.useWebSocketAdapter(new WsAdapter(app));
+    await app.listen(3011);
+
+    const client = new WebSocket('ws://localhost:3011');
+    await new Promise(resolve => client.on('open', resolve));
+
+    const shutdownNotice = new Promise<any>(resolve => {
+      client.once('message', data => {
+        resolve(JSON.parse(data.toString()));
+      });
+    });
+    const closed = new Promise<void>(resolve =>
+      client.once('close', () => resolve()),
+    );
+
+    await app.close();
+
+    const message = await shutdownNotice;
+    expect(message.event).toBe('shutdown');
+    expect(typeof message.data).toBe('string');
+    await closed;
+  });
+});
