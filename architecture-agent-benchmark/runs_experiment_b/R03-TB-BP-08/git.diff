@@ -0,0 +1,34 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('notifyShutdown', () => {
+    it('should send a shutdown message to every open client', async () => {
+      const openClient = { readyState: 1, send: vi.fn() };
+      const closingClient = { readyState: 2, send: vi.fn() };
+      const server = { clients: new Set([openClient, closingClient]) };
+
+      await adapter.notifyShutdown(server as any);
+
+      expect(openClient.send).toHaveBeenCalledTimes(1);
+      const [payload] = openClient.send.mock.calls[0];
+      expect(JSON.parse(payload)).toEqual({
+        event: 'shutdown',
+        data: expect.any(String),
+      });
+      expect(closingClient.send).not.toHaveBeenCalled();
+    });
+
+    it('should do nothing when the server has no tracked clients', async () => {
+      await expect(
+        adapter.notifyShutdown({} as any),
+      ).resolves.toBeUndefined();
+      await expect(adapter.notifyShutdown(undefined as any)).resolves.toBeUndefined();
+    });
+  });
+});
