@@ -0,0 +1,74 @@
+import { SocketModule } from '../socket-module.js';
+import { SocketsContainer } from '../sockets-container.js';
+
+describe('SocketModule', () => {
+  describe('close', () => {
+    const setupModuleWithServer = (adapter: any) => {
+      const socketModule = new SocketModule();
+      const server = {};
+      const socketsContainer = new SocketsContainer();
+      socketsContainer.addOne(
+        { port: 0 },
+        { server } as any,
+      );
+      (socketModule as any).socketsContainer = socketsContainer;
+      (socketModule as any).applicationConfig = {
+        getIoAdapter: () => adapter,
+      };
+      return { socketModule, server };
+    };
+
+    it('should notify a server before closing it', async () => {
+      const callOrder: string[] = [];
+      const adapter = {
+        notifyShutdown: vi.fn(async () => {
+          callOrder.push('notifyShutdown');
+        }),
+        close: vi.fn(async () => {
+          callOrder.push('close');
+        }),
+        dispose: vi.fn(async () => {}),
+      };
+      const { socketModule, server } = setupModuleWithServer(adapter);
+
+      await socketModule.close();
+
+      expect(adapter.notifyShutdown).toHaveBeenCalledWith(server);
+      expect(adapter.close).toHaveBeenCalledWith(server);
+      expect(callOrder).toEqual(['notifyShutdown', 'close']);
+      expect(adapter.dispose).toHaveBeenCalled();
+    });
+
+    it('should still close the server when the adapter does not implement notifyShutdown', async () => {
+      const adapter = {
+        close: vi.fn(async () => {}),
+        dispose: vi.fn(async () => {}),
+      };
+      const { socketModule, server } = setupModuleWithServer(adapter);
+
+      await expect(socketModule.close()).resolves.toBeUndefined();
+
+      expect(adapter.close).toHaveBeenCalledWith(server);
+    });
+
+    it('should still close the server when notifyShutdown rejects', async () => {
+      const adapter = {
+        notifyShutdown: vi.fn(async () => {
+          throw new Error('client misbehaved');
+        }),
+        close: vi.fn(async () => {}),
+        dispose: vi.fn(async () => {}),
+      };
+      const { socketModule, server } = setupModuleWithServer(adapter);
+
+      await expect(socketModule.close()).resolves.toBeUndefined();
+
+      expect(adapter.close).toHaveBeenCalledWith(server);
+    });
+
+    it('should do nothing when the WebSockets module was never registered', async () => {
+      const socketModule = new SocketModule();
+      await expect(socketModule.close()).resolves.toBeUndefined();
+    });
+  });
+});
