+import { SetMetadata } from '@nestjs/common';
+import { AFFECTED_BY_MAINTENANCE_KEY } from './maintenance-mode.constants.js';
+
+/**
+ * Marks an HTTP route handler, an entire controller, a WS message handler,
+ * or an entire gateway as affected by maintenance mode. While maintenance
+ * mode is enabled, calls into anything carrying this decorator are rejected
+ * before their handler body runs; everything else keeps working normally.
+ */
+export const AffectedByMaintenance = () =>
+  SetMetadata(AFFECTED_BY_MAINTENANCE_KEY, true);
