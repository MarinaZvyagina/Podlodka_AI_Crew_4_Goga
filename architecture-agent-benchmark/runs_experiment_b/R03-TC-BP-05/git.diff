+import { Controller, Get, Post } from '@nestjs/common';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Deliberately never carries @AffectedByMaintenance -- it must stay
+ * reachable while maintenance mode is on so it can be switched back off.
+ */
+@Controller('admin/maintenance-mode')
+export class MaintenanceAdminController {
+  constructor(
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  @Get()
+  status() {
+    return { enabled: this.maintenanceModeService.isEnabled() };
+  }
+
+  @Post('enable')
+  enable() {
+    this.maintenanceModeService.enable();
+    return { enabled: true };
+  }
+
+  @Post('disable')
+  disable() {
+    this.maintenanceModeService.disable();
+    return { enabled: false };
+  }
+}
