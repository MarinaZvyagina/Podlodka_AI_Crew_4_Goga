@@ -0,0 +1,23 @@
+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the current maintenance-mode flag in memory so it can be toggled
+ * from inside the running application (e.g. from an admin endpoint) without
+ * a redeploy. A single instance is shared app-wide via DI.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+
+  enable(): void {
+    this.enabled = true;
+  }
+
+  disable(): void {
+    this.enabled = false;
+  }
+}
