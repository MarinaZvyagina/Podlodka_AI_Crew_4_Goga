diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.spec.ts b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.spec.ts
new file mode 100644
index 0000000..c46c085
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.spec.ts
@@ -0,0 +1,110 @@
+import { ExecutionContext, ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { AffectedByMaintenance } from './affected-by-maintenance.decorator.js';
+import { MaintenanceModeGuard } from './maintenance-mode.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+class UnaffectedController {
+  normalHandler() {}
+}
+
+class PartiallyAffectedController {
+  @AffectedByMaintenance()
+  affectedHandler() {}
+
+  normalHandler() {}
+}
+
+@AffectedByMaintenance()
+class FullyAffectedController {
+  everyHandler() {}
+}
+
+// Builds the minimal ExecutionContext-shaped object the guard actually
+// reads (getHandler/getClass/getType) against a real class, so the real
+// Reflector resolves real @SetMetadata output -- no server, no sockets.
+function createContext(
+  target: Function,
+  handlerName: string,
+  type: 'http' | 'ws' = 'http',
+): ExecutionContext {
+  const handler = (target as any).prototype[handlerName];
+  return {
+    getHandler: () => handler,
+    getClass: () => target,
+    getType: () => type,
+  } as unknown as ExecutionContext;
+}
+
+describe('MaintenanceModeGuard', () => {
+  let guard: MaintenanceModeGuard;
+  let maintenanceModeService: MaintenanceModeService;
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(new Reflector(), maintenanceModeService);
+  });
+
+  it('allows a marked handler through while maintenance mode is off', () => {
+    const context = createContext(
+      PartiallyAffectedController,
+      'affectedHandler',
+    );
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks a handler marked with @AffectedByMaintenance once maintenance mode is on', () => {
+    maintenanceModeService.enable();
+    const context = createContext(
+      PartiallyAffectedController,
+      'affectedHandler',
+    );
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('leaves an unmarked handler on the same controller untouched', () => {
+    maintenanceModeService.enable();
+    const context = createContext(
+      PartiallyAffectedController,
+      'normalHandler',
+    );
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks every handler when the whole controller is marked', () => {
+    maintenanceModeService.enable();
+    const context = createContext(FullyAffectedController, 'everyHandler');
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('leaves handlers on an unrelated, unmarked controller untouched', () => {
+    maintenanceModeService.enable();
+    const context = createContext(UnaffectedController, 'normalHandler');
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('works normally again once maintenance mode is switched back off', () => {
+    maintenanceModeService.enable();
+    maintenanceModeService.disable();
+    const context = createContext(
+      PartiallyAffectedController,
+      'affectedHandler',
+    );
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('throws a WsException, not an HTTP exception, for a blocked WS message handler', () => {
+    maintenanceModeService.enable();
+    const context = createContext(
+      PartiallyAffectedController,
+      'affectedHandler',
+      'ws',
+    );
+    expect(() => guard.canActivate(context)).toThrow(WsException);
+  });
+});
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.ts b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.ts
new file mode 100644
index 0000000..eeeee7a
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.ts
@@ -0,0 +1,48 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { AFFECTED_BY_MAINTENANCE_KEY } from './maintenance-mode.constants.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * A single guard protects both HTTP route handlers and WS message handlers,
+ * since Nest runs guards through the same ExecutionContext abstraction for
+ * both transports. Handler-level metadata takes precedence over class-level
+ * metadata, so a whole controller/gateway can be marked at once, or just one
+ * handler on it.
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    if (!this.maintenanceModeService.isEnabled()) {
+      return true;
+    }
+
+    const isAffected = this.reflector.getAllAndOverride<boolean>(
+      AFFECTED_BY_MAINTENANCE_KEY,
+      [context.getHandler(), context.getClass()],
+    );
+    if (!isAffected) {
+      return true;
+    }
+
+    if (context.getType() === 'ws') {
+      throw new WsException(
+        'This action is temporarily unavailable for maintenance',
+      );
+    }
+    throw new ServiceUnavailableException(
+      'This endpoint is temporarily unavailable for maintenance',
+    );
+  }
+}
