+import { SubscribeMessage, WebSocketGateway } from '@nestjs/websockets';
+import { AffectedByMaintenance } from '../maintenance/affected-by-maintenance.decorator.js';
+
+@WebSocketGateway()
+export class EventsGateway {
+  @SubscribeMessage('ping')
+  onPing() {
+    return { event: 'pong', data: true };
+  }
+
+  // Streams live status off the same tables the migration is rewriting.
+  @SubscribeMessage('migration-status')
+  @AffectedByMaintenance()
+  onMigrationStatus() {
+    return { event: 'migration-status', data: 'ok' };
+  }
+}
