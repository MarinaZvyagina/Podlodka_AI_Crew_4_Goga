+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import { WsAdapter } from '@nestjs/platform-ws';
+import request from 'supertest';
+import { AppModule } from '../../src/app.module.js';
+
+describe('E2E Maintenance Mode Sample', () => {
+  let app: INestApplication;
+
+  beforeAll(async () => {
+    const modRef = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = modRef.createNestApplication();
+    app.useWebSocketAdapter(new WsAdapter(app));
+    await app.init();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('serves every route normally while maintenance mode is off', async () => {
+    await request(app.getHttpServer()).get('/cats').expect(200);
+    await request(app.getHttpServer())
+      .get('/cats/migration-report')
+      .expect(200);
+    await request(app.getHttpServer()).get('/legacy-reports').expect(200);
+  });
+
+  it('rejects only the marked routes once maintenance mode is switched on, then recovers once switched off', async () => {
+    await request(app.getHttpServer())
+      .post('/admin/maintenance-mode/enable')
+      .expect(201, { enabled: true });
+
+    // Unmarked route: unaffected.
+    await request(app.getHttpServer()).get('/cats').expect(200);
+
+    // Marked handler and marked controller: rejected before their logic runs.
+    await request(app.getHttpServer())
+      .get('/cats/migration-report')
+      .expect(503);
+    await request(app.getHttpServer()).get('/legacy-reports').expect(503);
+
+    // The toggle itself must stay reachable so it can be switched back off.
+    await request(app.getHttpServer())
+      .post('/admin/maintenance-mode/disable')
+      .expect(201, { enabled: false });
+
+    await request(app.getHttpServer())
+      .get('/cats/migration-report')
+      .expect(200);
+    await request(app.getHttpServer()).get('/legacy-reports').expect(200);
+  });
+});
