@@ -0,0 +1,24 @@
+import { AsyncLocalStorage } from 'async_hooks';
+
+const requestIdStorage = new AsyncLocalStorage<string>();
+
+/**
+ * Binds `requestId` to the async execution context for the duration of
+ * `callback`, so any code that runs as part of it (however deeply nested,
+ * across awaits, callbacks, etc.) can retrieve it via `getRequestId()`
+ * without it being passed down explicitly.
+ */
+export function runWithRequestId<T>(requestId: string, callback: () => T): T {
+  return requestIdStorage.run(requestId, callback);
+}
+
+/**
+ * Returns the request/correlation id bound to the current async execution
+ * context, or `undefined` when called outside of a request handled by the
+ * request id middleware (see `INestApplication#enableRequestId`).
+ *
+ * @publicApi
+ */
+export function getRequestId(): string | undefined {
+  return requestIdStorage.getStore();
+}
