+++ b/packages/core/middleware/request-id/request-id-hook.factory.ts
@@ -0,0 +1,38 @@
+import type { RequestIdOptions } from '@nestjs/common';
+import { randomStringGenerator } from '@nestjs/common/internal';
+import type { AbstractHttpAdapter } from '../../adapters/index.js';
+import { runWithRequestId } from './request-id-context.js';
+import { DEFAULT_REQUEST_ID_HEADER } from './request-id.constants.js';
+
+/**
+ * Builds the adapter-level request hook that implements request id
+ * propagation: reused from the inbound header when the caller already sent
+ * one, otherwise generated. The resolved id is written to the same header
+ * on the response and bound to the async context for the rest of the
+ * request's lifecycle.
+ *
+ * Registered via `httpAdapter.setOnRequestHook`, which both the Express and
+ * the Fastify adapters invoke at the earliest point of their respective
+ * request lifecycles, before any application middleware, guard, or route
+ * handler runs — so the behavior is identical regardless of the underlying
+ * HTTP library.
+ */
+export function createRequestIdHook(
+  httpAdapter: AbstractHttpAdapter,
+  options: RequestIdOptions = {},
+) {
+  const header = (options.header ?? DEFAULT_REQUEST_ID_HEADER).toLowerCase();
+  const generator = options.generator ?? randomStringGenerator;
+
+  return (request: any, response: any, next: (err?: Error) => void) => {
+    const inboundValue = request?.headers?.[header];
+    const inboundId = Array.isArray(inboundValue)
+      ? inboundValue[0]
+      : inboundValue;
+    const requestId = inboundId || generator();
+
+    httpAdapter.setHeader(response, header, requestId);
+
+    runWithRequestId(requestId, () => next());
+  };
+}
