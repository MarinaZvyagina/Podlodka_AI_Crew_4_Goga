@@ -0,0 +1,151 @@
+import {
+  getRequestId,
+  runWithRequestId,
+} from '../../../middleware/request-id/request-id-context.js';
+import { createRequestIdHook } from '../../../middleware/request-id/request-id-hook.factory.js';
+import { NoopHttpAdapter } from '../../utils/noop-adapter.js';
+
+describe('Request id', () => {
+  describe('runWithRequestId / getRequestId', () => {
+    it('should return undefined outside of a bound context', () => {
+      expect(getRequestId()).toBeUndefined();
+    });
+
+    it('should expose the bound id anywhere within the callback, including across async boundaries', async () => {
+      const seenIds: Array<string | undefined> = [];
+
+      await runWithRequestId('abc-123', async () => {
+        seenIds.push(getRequestId());
+        await Promise.resolve();
+        seenIds.push(getRequestId());
+        setImmediate(() => seenIds.push(getRequestId()));
+        await new Promise(resolve => setImmediate(resolve));
+      });
+
+      expect(seenIds).toEqual(['abc-123', 'abc-123', 'abc-123']);
+      expect(getRequestId()).toBeUndefined();
+    });
+
+    it('should isolate concurrent contexts from each other', async () => {
+      const observed: string[] = [];
+      const track = (id: string) =>
+        runWithRequestId(id, async () => {
+          await new Promise(resolve => setImmediate(resolve));
+          observed.push(getRequestId()!);
+        });
+
+      await Promise.all([track('req-1'), track('req-2'), track('req-3')]);
+
+      expect(observed.sort()).toEqual(['req-1', 'req-2', 'req-3']);
+    });
+  });
+
+  describe('createRequestIdHook', () => {
+    it('should generate a new id and set it on the response header when the request has none', () => {
+      const httpAdapter = new NoopHttpAdapter({});
+      const setHeaderSpy = vi
+        .spyOn(httpAdapter, 'setHeader')
+        .mockImplementation(() => undefined);
+
+      const hook = createRequestIdHook(httpAdapter, {
+        generator: () => 'generated-id',
+      });
+
+      const request = { headers: {} };
+      const response = {};
+      const next = vi.fn();
+
+      hook(request, response, next);
+
+      expect(setHeaderSpy).toHaveBeenCalledExactlyOnceWith(
+        response,
+        'x-request-id',
+        'generated-id',
+      );
+      expect(next).toHaveBeenCalledOnce();
+    });
+
+    it('should reuse the id supplied on the inbound request header instead of generating one', () => {
+      const httpAdapter = new NoopHttpAdapter({});
+      const setHeaderSpy = vi
+        .spyOn(httpAdapter, 'setHeader')
+        .mockImplementation(() => undefined);
+      const generator = vi.fn(() => 'should-not-be-used');
+
+      const hook = createRequestIdHook(httpAdapter, { generator });
+
+      const request = { headers: { 'x-request-id': 'incoming-id' } };
+      const response = {};
+      const next = vi.fn();
+
+      hook(request, response, next);
+
+      expect(generator).not.toHaveBeenCalled();
+      expect(setHeaderSpy).toHaveBeenCalledExactlyOnceWith(
+        response,
+        'x-request-id',
+        'incoming-id',
+      );
+    });
+
+    it('should take the first value when the inbound header was sent multiple times', () => {
+      const httpAdapter = new NoopHttpAdapter({});
+      const setHeaderSpy = vi
+        .spyOn(httpAdapter, 'setHeader')
+        .mockImplementation(() => undefined);
+
+      const hook = createRequestIdHook(httpAdapter, {});
+      const request = {
+        headers: { 'x-request-id': ['first-id', 'second-id'] },
+      };
+      const next = vi.fn();
+
+      hook(request, {}, next);
+
+      expect(setHeaderSpy).toHaveBeenCalledExactlyOnceWith(
+        {},
+        'x-request-id',
+        'first-id',
+      );
+    });
+
+    it('should support a custom header name', () => {
+      const httpAdapter = new NoopHttpAdapter({});
+      const setHeaderSpy = vi
+        .spyOn(httpAdapter, 'setHeader')
+        .mockImplementation(() => undefined);
+
+      const hook = createRequestIdHook(httpAdapter, {
+        header: 'X-Correlation-Id',
+      });
+
+      const request = { headers: { 'x-correlation-id': 'correlation-1' } };
+      const next = vi.fn();
+
+      hook(request, {}, next);
+
+      expect(setHeaderSpy).toHaveBeenCalledExactlyOnceWith(
+        {},
+        'x-correlation-id',
+        'correlation-1',
+      );
+    });
+
+    it('should make the resolved id available to code running inside next()', () => {
+      const httpAdapter = new NoopHttpAdapter({});
+      vi.spyOn(httpAdapter, 'setHeader').mockImplementation(() => undefined);
+
+      const hook = createRequestIdHook(httpAdapter, {
+        generator: () => 'bound-id',
+      });
+
+      let idSeenByHandler: string | undefined;
+      hook({ headers: {} }, {}, () => {
+        idSeenByHandler = getRequestId();
+      });
+
+      expect(idSeenByHandler).toBe('bound-id');
+      expect(getRequestId()).toBeUndefined();
+    });
+  });
+});
