+import {
+  FastifyAdapter,
+  NestFastifyApplication,
+} from '@nestjs/platform-fastify';
+import { Test } from '@nestjs/testing';
+import { AppModule } from '../src/app.module.js';
+
+describe('Request id (Fastify)', () => {
+  let app: NestFastifyApplication;
+
+  beforeAll(async () => {
+    const module = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = module.createNestApplication<NestFastifyApplication>(
+      new FastifyAdapter(),
+    );
+    app.enableRequestId();
+
+    await app.init();
+    await app.getHttpAdapter().getInstance().ready();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('should generate a request id and return it on the response header when none was sent', async () => {
+    const response = await app.inject({ method: 'GET', url: '/' });
+
+    expect(response.statusCode).toBe(200);
+    const headerValue = response.headers['x-request-id'];
+    expect(headerValue).toBeTruthy();
+    expect(response.json().requestId).toBe(headerValue);
+  });
+
+  it('should reuse the id sent by the caller instead of generating a new one', async () => {
+    const response = await app.inject({
+      method: 'GET',
+      url: '/',
+      headers: { 'x-request-id': 'caller-supplied-id' },
+    });
+
+    expect(response.statusCode).toBe(200);
+    expect(response.headers['x-request-id']).toBe('caller-supplied-id');
+    expect(response.json().requestId).toBe('caller-supplied-id');
+  });
+
+  it('should generate a different id for each unrelated request', async () => {
+    const first = await app.inject({ method: 'GET', url: '/' });
+    const second = await app.inject({ method: 'GET', url: '/' });
+
+    expect(first.headers['x-request-id']).not.toBe(
+      second.headers['x-request-id'],
+    );
+  });
+});
