+/**
+ * @publicApi
+ */
+export interface RequestIdOptions {
+  /**
+   * Name of the header used to read an inbound request id from, and that
+   * the resolved id is written back to on the outgoing response.
+   * @default 'x-request-id'
+   */
+  header?: string;
+
+  /**
+   * Generates a new request id when the incoming request doesn't carry one
+   * under `header` already.
+   * @default a random string generator
+   */
+  generator?: () => string;
+}
