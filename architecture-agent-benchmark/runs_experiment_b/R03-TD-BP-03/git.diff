+import { NestExpressApplication } from '@nestjs/platform-express';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../src/app.module.js';
+
+describe('Request id (Express)', () => {
+  let app: NestExpressApplication;
+
+  beforeAll(async () => {
+    const module = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = module.createNestApplication<NestExpressApplication>();
+    app.enableRequestId();
+
+    await app.init();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('should generate a request id and return it on the response header when none was sent', async () => {
+    const response = await request(app.getHttpServer()).get('/').expect(200);
+
+    const headerValue = response.headers['x-request-id'];
+    expect(headerValue).toBeTruthy();
+    expect(response.body.requestId).toBe(headerValue);
+  });
+
+  it('should reuse the id sent by the caller instead of generating a new one', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/')
+      .set('x-request-id', 'caller-supplied-id')
+      .expect(200);
+
+    expect(response.headers['x-request-id']).toBe('caller-supplied-id');
+    expect(response.body.requestId).toBe('caller-supplied-id');
+  });
+
+  it('should generate a different id for each unrelated request', async () => {
+    const first = await request(app.getHttpServer()).get('/').expect(200);
+    const second = await request(app.getHttpServer()).get('/').expect(200);
+
+    expect(first.headers['x-request-id']).not.toBe(
+      second.headers['x-request-id'],
+    );
+  });
+});
