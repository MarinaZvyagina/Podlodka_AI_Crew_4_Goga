index 0000000..ea048c4
--- /dev/null
+++ b/packages/common/src/filename.ts
@@ -0,0 +1,19 @@
+// characters reserved/illegal in file names on Windows, plus ASCII control
+// characters (also disallowed on Windows and unsafe to persist elsewhere)
+// eslint-disable-next-line no-control-regex
+const ILLEGAL_FILENAME_CHARS_REGEX = /[<>:"/\\|?*\x00-\x1F]/g;
+
+// Windows silently strips trailing dots/spaces from file names, which can
+// cause the saved file name to differ from what the user typed
+const TRAILING_DOTS_AND_SPACES_REGEX = /[.\s]+$/;
+
+/**
+ * Sanitizes a user-supplied name so it's safe to use as a file name on
+ * Windows, macOS, and Linux. Returns an empty string if nothing usable
+ * remains (e.g. the input was empty or contained only whitespace/dots).
+ */
+export const sanitizeFilename = (name: string): string => {
+  return name
+    .replace(ILLEGAL_FILENAME_CHARS_REGEX, "_")
+    .replace(TRAILING_DOTS_AND_SPACES_REGEX, "");
+};
