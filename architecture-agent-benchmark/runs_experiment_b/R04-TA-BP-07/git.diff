@@ -0,0 +1,41 @@
+import { sanitizeFilename } from "@excalidraw/common";
+
+describe("sanitizeFilename", () => {
+  it("leaves already-safe names untouched", () => {
+    expect(sanitizeFilename("my drawing")).toBe("my drawing");
+  });
+
+  it("replaces characters illegal on common desktop OSes", () => {
+    expect(sanitizeFilename('a/b\\c:d*e?f"g<h>i|j')).toBe(
+      "a_b_c_d_e_f_g_h_i_j",
+    );
+  });
+
+  it("strips a trailing dot", () => {
+    expect(sanitizeFilename("my drawing.")).toBe("my drawing");
+  });
+
+  it("strips trailing spaces", () => {
+    expect(sanitizeFilename("my drawing   ")).toBe("my drawing");
+  });
+
+  it("strips mixed trailing dots and spaces", () => {
+    expect(sanitizeFilename("my drawing . . ")).toBe("my drawing");
+  });
+
+  it("returns an empty string for empty input", () => {
+    expect(sanitizeFilename("")).toBe("");
+  });
+
+  it("returns an empty string for whitespace-only input", () => {
+    expect(sanitizeFilename("   ")).toBe("");
+  });
+
+  it("returns an empty string for dots-only input", () => {
+    expect(sanitizeFilename("...")).toBe("");
+  });
+
+  it("does not touch leading spaces", () => {
+    expect(sanitizeFilename("  my drawing")).toBe("  my drawing");
+  });
+});
