@@ -0,0 +1,104 @@
+import { pointFrom } from "@excalidraw/math";
+
+import { API } from "../../tests/helpers/api";
+
+import { getElementArea } from "./utils";
+
+describe("getElementArea", () => {
+  it("computes the area of a rectangle", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(rectangle)).toBe(5000);
+  });
+
+  it("is unaffected by rotation", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 100,
+      height: 50,
+      angle: 0.7,
+    });
+    expect(getElementArea(rectangle)).toBe(5000);
+  });
+
+  it("computes the area of a diamond as half the bounding box", () => {
+    const diamond = API.createElement({
+      type: "diamond",
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(diamond)).toBe(2500);
+  });
+
+  it("computes the area of an ellipse", () => {
+    const ellipse = API.createElement({
+      type: "ellipse",
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(ellipse)).toBeCloseTo((Math.PI * 100 * 50) / 4, 5);
+  });
+
+  it("computes the area of a closed polygon line", () => {
+    const line = API.createElement({
+      type: "line",
+      width: 100,
+      height: 100,
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+        pointFrom(0, 0),
+      ],
+      polygon: true,
+    });
+    expect(getElementArea(line)).toBe(10000);
+  });
+
+  it("omits the area of an open (non-polygon) line", () => {
+    const line = API.createElement({
+      type: "line",
+      width: 100,
+      height: 100,
+      points: [pointFrom(0, 0), pointFrom(100, 0), pointFrom(100, 100)],
+    });
+    expect(getElementArea(line)).toBeNull();
+  });
+
+  it("computes the area of a closed (looped) freedraw path", () => {
+    const freedraw = API.createElement({
+      type: "freedraw",
+      width: 100,
+      height: 100,
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+        pointFrom(0, 0),
+      ],
+    });
+    expect(getElementArea(freedraw)).toBe(10000);
+  });
+
+  it("omits the area of an open freedraw path", () => {
+    const freedraw = API.createElement({
+      type: "freedraw",
+      width: 100,
+      height: 100,
+      points: [pointFrom(0, 0), pointFrom(100, 0), pointFrom(50, 100)],
+    });
+    expect(getElementArea(freedraw)).toBeNull();
+  });
+
+  it("omits the area of shapes that don't enclose a region", () => {
+    const text = API.createElement({ type: "text", width: 100, height: 20 });
+    const arrow = API.createElement({ type: "arrow", width: 100, height: 0 });
+    expect(getElementArea(text)).toBeNull();
+    expect(getElementArea(arrow)).toBeNull();
+  });
+});
