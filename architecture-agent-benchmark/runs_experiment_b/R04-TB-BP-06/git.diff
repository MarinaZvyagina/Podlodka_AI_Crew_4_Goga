diff --git a/packages/excalidraw/components/Stats/Area.tsx b/packages/excalidraw/components/Stats/Area.tsx
new file mode 100644
index 0000000..c933d30
--- /dev/null
+++ b/packages/excalidraw/components/Stats/Area.tsx
@@ -0,0 +1,49 @@
+import { round, polygonArea } from "@excalidraw/math";
+
+import { isLineElement, isPathALoop } from "@excalidraw/element";
+
+import type { ExcalidrawElement } from "@excalidraw/element/types";
+
+import { t } from "../../i18n";
+
+interface AreaProps {
+  element: ExcalidrawElement;
+}
+
+export const getElementArea = (element: ExcalidrawElement): number | null => {
+  if (isLineElement(element)) {
+    return element.polygon || isPathALoop(element.points)
+      ? polygonArea(element.points)
+      : null;
+  }
+
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    case "freedraw":
+      return isPathALoop(element.points) ? polygonArea(element.points) : null;
+    default:
+      return null;
+  }
+};
+
+const Area = ({ element }: AreaProps) => {
+  const area = getElementArea(element);
+
+  if (area === null) {
+    return null;
+  }
+
+  return (
+    <>
+      <div>{t("stats.area")}</div>
+      <div>{round(area, 2)}</div>
+    </>
+  );
+};
+
+export default Area;
