+import { degreesToRadians, pointFrom } from "@excalidraw/math";
+
+import type { Degrees } from "@excalidraw/math";
+
+import { getElementArea } from "../src/sizeHelpers";
+import {
+  newElement,
+  newFreeDrawElement,
+  newLinearElement,
+  newTextElement,
+} from "../src/newElement";
+
+describe("getElementArea", () => {
+  it("returns width * height for a rectangle", () => {
+    const element = newElement({
+      type: "rectangle",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(element)).toBeCloseTo(5000, 5);
+  });
+
+  it("returns half the bounding box area for a diamond", () => {
+    const element = newElement({
+      type: "diamond",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(element)).toBeCloseTo(2500, 5);
+  });
+
+  it("returns pi * a * b for an ellipse", () => {
+    const element = newElement({
+      type: "ellipse",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(element)).toBeCloseTo(Math.PI * 50 * 25, 5);
+  });
+
+  it("is unaffected by rotation, since width/height are the local bounding box", () => {
+    const upright = newElement({
+      type: "rectangle",
+      x: 0,
+      y: 0,
+      width: 120,
+      height: 40,
+    });
+    const rotated = newElement({
+      type: "rectangle",
+      x: 0,
+      y: 0,
+      width: 120,
+      height: 40,
+      angle: degreesToRadians(37 as Degrees),
+    });
+    expect(getElementArea(rotated)).toBeCloseTo(getElementArea(upright)!, 5);
+  });
+
+  it("returns null for a text element", () => {
+    const element = newTextElement({
+      x: 0,
+      y: 0,
+      text: "hello",
+      fontSize: 20,
+      fontFamily: 1,
+      textAlign: "left",
+      verticalAlign: "top",
+    });
+    expect(getElementArea(element)).toBeNull();
+  });
+
+  it("returns the shoelace area for a closed (polygon) line", () => {
+    // a 10x10 right triangle closed back to its start
+    const element = newLinearElement({
+      type: "line",
+      x: 0,
+      y: 0,
+      points: [
+        pointFrom(0, 0),
+        pointFrom(10, 0),
+        pointFrom(10, 10),
+        pointFrom(0, 0),
+      ],
+      polygon: true,
+    });
+    expect(getElementArea(element)).toBeCloseTo(50, 5);
+  });
+
+  it("returns null for an open line even with many points", () => {
+    const element = newLinearElement({
+      type: "line",
+      x: 0,
+      y: 0,
+      points: [
+        pointFrom(0, 0),
+        pointFrom(10, 0),
+        pointFrom(10, 10),
+        pointFrom(0, 10),
+      ],
+      polygon: false,
+    });
+    expect(getElementArea(element)).toBeNull();
+  });
+
+  it("returns the enclosed area for a closed hand-drawn (freedraw) outline", () => {
+    // a roughly-closed 10x10 square outline
+    const element = newFreeDrawElement({
+      type: "freedraw",
+      x: 0,
+      y: 0,
+      simulatePressure: true,
+      points: [
+        pointFrom(0, 0),
+        pointFrom(10, 0),
+        pointFrom(10, 10),
+        pointFrom(0, 10),
+        pointFrom(0.2, 0.1),
+      ],
+    });
+    expect(getElementArea(element)).not.toBeNull();
+    expect(getElementArea(element)!).toBeGreaterThan(90);
+    expect(getElementArea(element)!).toBeLessThanOrEqual(100);
+  });
+
+  it("returns null for an open hand-drawn (freedraw) stroke", () => {
+    const element = newFreeDrawElement({
+      type: "freedraw",
+      x: 0,
+      y: 0,
+      simulatePressure: true,
+      points: [pointFrom(0, 0), pointFrom(10, 0), pointFrom(10, 10)],
+    });
+    expect(getElementArea(element)).toBeNull();
+  });
+});
diff --git a/packages/excalidraw/components/Stats/Area.tsx b/packages/excalidraw/components/Stats/Area.tsx
new file mode 100644
index 0000000..aa99c9d
--- /dev/null
+++ b/packages/excalidraw/components/Stats/Area.tsx
@@ -0,0 +1,28 @@
+import { round } from "@excalidraw/math";
+
+import { getElementArea } from "@excalidraw/element";
+
+import type { NonDeletedExcalidrawElement } from "@excalidraw/element/types";
+
+import { t } from "../../i18n";
+
+interface AreaProps {
+  element: NonDeletedExcalidrawElement;
+}
+
+const Area = ({ element }: AreaProps) => {
+  const area = getElementArea(element);
+
+  if (area === null) {
+    return null;
+  }
+
+  return (
+    <>
+      <div>{t("stats.area")}</div>
+      <div>{round(area, 2)}</div>
+    </>
+  );
+};
+
+export default Area;
