+// A hand-drawn stroke whose endpoints land farther apart than this fraction
+// of its own path length reads as an open squiggle rather than a closed
+// outline, so its area would be misleading.
+const FREEDRAW_CLOSED_GAP_MAX_RATIO = 0.15;
+
+const isClosedFreeDrawOutline = (points: readonly LocalPoint[]): boolean => {
+  if (points.length < 3) {
+    return false;
+  }
+
+  let pathLength = 0;
+  for (let i = 1; i < points.length; i++) {
+    pathLength += pointDistance(points[i - 1], points[i]);
+  }
+
+  if (pathLength === 0) {
+    return false;
+  }
+
+  const gap = pointDistance(points[0], points[points.length - 1]);
+
+  return gap / pathLength <= FREEDRAW_CLOSED_GAP_MAX_RATIO;
+};
+
+/**
+ * The enclosed area of an element, in the same units as `width`/`height`.
+ * Returns `null` for elements that don't enclose a region (open lines,
+ * arrows, text, images, etc.) where an area figure would be misleading.
+ *
+ * `width`/`height` are always the element's local, unrotated bounding box,
+ * so area derived from them (or from local `points`) is rotation-invariant.
+ */
+export const getElementArea = (element: ExcalidrawElement): number | null => {
+  if (isLineElement(element)) {
+    return element.polygon && element.points.length > 2
+      ? polygonArea(element.points)
+      : null;
+  }
+
+  if (isFreeDrawElement(element)) {
+    return isClosedFreeDrawOutline(element.points)
+      ? polygonArea(element.points)
+      : null;
+  }
+
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      // the diamond is the rhombus whose vertices are the midpoints of the
+      // bounding box edges, i.e. half the bounding box area
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    default:
+      return null;
+  }
+};
