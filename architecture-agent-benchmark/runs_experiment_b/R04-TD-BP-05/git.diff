diff --git a/packages/element/src/snapToGrid.ts b/packages/element/src/snapToGrid.ts
new file mode 100644
index 0000000..840d56b
--- /dev/null
+++ b/packages/element/src/snapToGrid.ts
@@ -0,0 +1,81 @@
+import { updateBoundElements } from "./binding";
+import { rescalePointsInElement } from "./resizeElements";
+import { getBoundTextElement } from "./textElement";
+import {
+  isFreeDrawElement,
+  isLinearElement,
+  isTextElement,
+} from "./typeChecks";
+
+import type { Scene } from "./Scene";
+import type { NonDeletedExcalidrawElement } from "./types";
+
+const snapValueToGrid = (value: number, gridSize: number) =>
+  Math.round(value / gridSize) * gridSize;
+
+/**
+ * Snaps a single element's position (and, unless it's a text element whose
+ * box is derived from its font metrics, its size) to the nearest grid line —
+ * the same result a user would get by nudging the element with grid snap on.
+ */
+const snapElementToGrid = (
+  element: NonDeletedExcalidrawElement,
+  scene: Scene,
+  gridSize: number,
+  allElements: readonly NonDeletedExcalidrawElement[],
+) => {
+  const nextX = snapValueToGrid(element.x, gridSize);
+  const nextY = snapValueToGrid(element.y, gridSize);
+  const dx = nextX - element.x;
+  const dy = nextY - element.y;
+
+  if (isTextElement(element)) {
+    scene.mutateElement(element, { x: nextX, y: nextY });
+  } else {
+    const nextWidth = Math.max(1, snapValueToGrid(element.width, gridSize));
+    const nextHeight = Math.max(1, snapValueToGrid(element.height, gridSize));
+
+    const rescaledPoints =
+      isLinearElement(element) || isFreeDrawElement(element)
+        ? rescalePointsInElement(element, nextWidth, nextHeight, true)
+        : {};
+
+    scene.mutateElement(element, {
+      x: nextX,
+      y: nextY,
+      width: nextWidth,
+      height: nextHeight,
+      ...rescaledPoints,
+    });
+  }
+
+  const boundTextElement = getBoundTextElement(
+    element,
+    scene.getNonDeletedElementsMap(),
+  );
+  if (boundTextElement) {
+    scene.mutateElement(boundTextElement, {
+      x: boundTextElement.x + dx,
+      y: boundTextElement.y + dy,
+    });
+  }
+
+  updateBoundElements(element, scene, {
+    simultaneouslyUpdated: allElements,
+  });
+};
+
+/**
+ * Snaps each of the given elements to the grid independently — each keeps
+ * its own position/size rounded to the nearest grid line rather than being
+ * treated as a single group.
+ */
+export const snapElementsToGrid = (
+  elements: readonly NonDeletedExcalidrawElement[],
+  scene: Scene,
+  gridSize: number,
+) => {
+  elements.forEach((element) =>
+    snapElementToGrid(element, scene, gridSize, elements),
+  );
+};
diff --git a/packages/element/tests/snapToGrid.test.tsx b/packages/element/tests/snapToGrid.test.tsx
