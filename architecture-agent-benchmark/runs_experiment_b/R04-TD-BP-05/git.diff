@@ -0,0 +1,104 @@
+import { actionSnapToGrid } from "@excalidraw/excalidraw/actions";
+import { defaultLang, setLanguage } from "@excalidraw/excalidraw/i18n";
+import { Excalidraw } from "@excalidraw/excalidraw";
+
+import { API } from "@excalidraw/excalidraw/tests/helpers/api";
+import { Keyboard, Pointer, UI } from "@excalidraw/excalidraw/tests/helpers/ui";
+import {
+  act,
+  unmountComponent,
+  render,
+} from "@excalidraw/excalidraw/tests/test-utils";
+
+const mouse = new Pointer("mouse");
+
+describe("snap to grid", () => {
+  beforeEach(async () => {
+    unmountComponent();
+    mouse.reset();
+
+    await act(() => {
+      return setLanguage(defaultLang);
+    });
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+    API.setAppState({ gridSize: 20 });
+  });
+
+  it("snaps only the selected element's position and size to the grid", () => {
+    const selected = UI.createElement("rectangle", {
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 41,
+    });
+    const untouched = UI.createElement("rectangle", {
+      x: 13,
+      y: 13,
+      width: 50,
+      height: 50,
+    });
+    API.setSelectedElements([selected.get()]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(selected.get().x).toBe(20);
+    expect(selected.get().y).toBe(20);
+    expect(selected.get().width).toBe(60);
+    expect(selected.get().height).toBe(40);
+
+    // not selected, so left exactly as-is
+    expect(untouched.get().x).toBe(13);
+    expect(untouched.get().y).toBe(13);
+    expect(untouched.get().width).toBe(50);
+    expect(untouched.get().height).toBe(50);
+  });
+
+  it("snaps every shape independently when nothing is selected", () => {
+    const first = UI.createElement("rectangle", {
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 41,
+    });
+    const second = UI.createElement("rectangle", {
+      x: 33,
+      y: 8,
+      width: 12,
+      height: 96,
+    });
+    API.clearSelection();
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(first.get().x).toBe(20);
+    expect(first.get().y).toBe(20);
+    expect(first.get().width).toBe(60);
+    expect(first.get().height).toBe(40);
+
+    expect(second.get().x).toBe(40);
+    expect(second.get().y).toBe(0);
+    expect(second.get().width).toBe(20);
+    expect(second.get().height).toBe(100);
+  });
+
+  it("undoes the snap in a single step", () => {
+    const rectangle = UI.createElement("rectangle", {
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 41,
+    });
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(rectangle.get().x).toBe(20);
+    expect(rectangle.get().y).toBe(20);
+
+    Keyboard.undo();
+
+    expect(rectangle.get().x).toBe(12);
+    expect(rectangle.get().y).toBe(27);
+    expect(rectangle.get().width).toBe(53);
+    expect(rectangle.get().height).toBe(41);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..8dca13d
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,44 @@
+import {
+  CaptureUpdateAction,
+  getNonDeletedElements,
+  isTextElement,
+  snapElementsToGrid,
+} from "@excalidraw/element";
+
+import { gridIcon } from "../components/icons";
+
+import { register } from "./register";
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  keywords: ["grid", "snap", "align"],
+  trackEvent: { category: "element" },
+  predicate: (elements) => elements.some((element) => !element.isDeleted),
+  perform: (elements, appState, _, app) => {
+    const selectedElements = app.scene.getSelectedElements(appState);
+
+    const candidateElements =
+      selectedElements.length > 0
+        ? selectedElements
+        : getNonDeletedElements(elements);
+
+    const targetElements = candidateElements.filter(
+      (element) =>
+        !element.locked && !(isTextElement(element) && element.containerId),
+    );
+
+    if (targetElements.length === 0) {
+      return false;
+    }
+
+    snapElementsToGrid(targetElements, app.scene, appState.gridSize);
+
+    return {
+      elements,
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
