diff --git a/lib/promscrape/scraper_test.go b/lib/promscrape/scraper_test.go
index 8a03fc4..c8eb19e 100644
--- a/lib/promscrape/scraper_test.go
+++ b/lib/promscrape/scraper_test.go
@@ -3,6 +3,7 @@ package promscrape
 import (
 	"fmt"
 	"math/rand"
+	"strings"
 	"testing"
 
 	"github.com/VictoriaMetrics/VictoriaMetrics/lib/auth"
@@ -79,3 +80,77 @@ scrape_configs:
     - targets:
         - localhost:8429`, true)
 }
+
+// TestScraperGroupMaxScrapeTargets verifies that a job_name's active scrape target count
+// is capped by max_scrape_targets (or -promscrape.maxScrapeTargetsPerJob) regardless of which
+// service discovery mechanism supplied the targets, and that excess targets are reported
+// as dropped targets instead of being scraped.
+func TestScraperGroupMaxScrapeTargets(t *testing.T) {
+	pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+	globalStopChan = make(chan struct{})
+	defer close(globalStopChan)
+
+	newJobConfig := func(jobName string, maxScrapeTargets, targetsCount int) string {
+		var sb strings.Builder
+		fmt.Fprintf(&sb, "scrape_configs:\n- job_name: %s\n", jobName)
+		if maxScrapeTargets > 0 {
+			fmt.Fprintf(&sb, "  max_scrape_targets: %d\n", maxScrapeTargets)
+		}
+		sb.WriteString("  static_configs:\n    - targets:\n")
+		for i := 0; i < targetsCount; i++ {
+			fmt.Fprintf(&sb, "        - 127.0.0.1:%d\n", 10000+i)
+		}
+		return sb.String()
+	}
+
+	activeTargetsCount := func(jobName string) int {
+		tsmGlobal.mu.Lock()
+		defer tsmGlobal.mu.Unlock()
+		return tsmGlobal.upByJob[jobName] + tsmGlobal.downByJob[jobName]
+	}
+
+	droppedTargetsCountForJob := func(jobName string) int {
+		n := 0
+		for _, dt := range droppedTargetsMap.getTargetsList() {
+			if dt.originalLabels.getJob() == jobName && dt.dropReason == targetDropReasonJobTargetLimit {
+				n++
+			}
+		}
+		return n
+	}
+
+	f := func(maxScrapeTargets, targetsCount, wantActive, wantDropped int) {
+		t.Helper()
+
+		jobName := fmt.Sprintf("test-job-%d", rand.Int())
+		var cfg Config
+		if err := cfg.parseData([]byte(newJobConfig(jobName, maxScrapeTargets, targetsCount)), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sws := cfg.getStaticScrapeWork()
+		if len(sws) != targetsCount {
+			t.Fatalf("unexpected number of discovered targets; got %d; want %d", len(sws), targetsCount)
+		}
+
+		sg := newScraperGroup(fmt.Sprintf("static_configs_%d", rand.Int()), pushData, globalStopChan)
+		defer sg.stop()
+		sg.update(sws)
+
+		if got := activeTargetsCount(jobName); got != wantActive {
+			t.Fatalf("unexpected active targets count for job=%s; got %d; want %d", jobName, got, wantActive)
+		}
+		if got := droppedTargetsCountForJob(jobName); got != wantDropped {
+			t.Fatalf("unexpected job-target-limit dropped targets count for job=%s; got %d; want %d", jobName, got, wantDropped)
+		}
+	}
+
+	// A job under its configured limit must be unaffected.
+	f(5, 2, 2, 0)
+
+	// A job over its configured limit must be truncated to the limit,
+	// with the excess targets visible as dropped targets.
+	f(2, 5, 2, 3)
+
+	// The default (unlimited) behavior must keep all the discovered targets.
+	f(0, 5, 5, 0)
+}
