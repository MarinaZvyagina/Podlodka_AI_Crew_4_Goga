+func TestScraperGroupUpdate_MaxScrapeTargets(t *testing.T) {
+	pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+	globalStopChan = make(chan struct{})
+	defer close(globalStopChan)
+
+	randName := rand.Int()
+	sg := newScraperGroup(fmt.Sprintf("static_configs_%d", randName), pushData, globalStopChan)
+	defer sg.stop()
+
+	jobUnder := fmt.Sprintf("under-limit-%d", randName)
+	jobOver := fmt.Sprintf("over-limit-%d", randName)
+	jobUnlimited := fmt.Sprintf("unlimited-%d", randName)
+
+	cfgData := fmt.Sprintf(`
+scrape_configs:
+- job_name: %s
+  max_scrape_targets: 5
+  static_configs:
+    - targets:
+        - localhost:19001
+        - localhost:19002
+        - localhost:19003
+- job_name: %s
+  max_scrape_targets: 2
+  static_configs:
+    - targets:
+        - localhost:19101
+        - localhost:19102
+        - localhost:19103
+        - localhost:19104
+        - localhost:19105
+- job_name: %s
+  static_configs:
+    - targets:
+        - localhost:19201
+        - localhost:19202
+        - localhost:19203
+        - localhost:19204
+        - localhost:19205
+`, jobUnder, jobOver, jobUnlimited)
+
+	var cfg Config
+	if err := cfg.parseData([]byte(cfgData), "test-scrape.yaml"); err != nil {
+		t.Fatalf("cannot parse config: %s", err)
+	}
+	sws := cfg.getStaticScrapeWork()
+	sg.update(sws)
+
+	activeByJob := make(map[string]int)
+	for _, sc := range sg.m {
+		activeByJob[sc.sw.Config.jobNameOriginal]++
+	}
+	if n := activeByJob[jobUnder]; n != 3 {
+		t.Fatalf("unexpected number of active targets for a job under the limit; got %d; want 3", n)
+	}
+	if n := activeByJob[jobOver]; n != 2 {
+		t.Fatalf("unexpected number of active targets for a job over the limit; got %d; want 2", n)
+	}
+	if n := activeByJob[jobUnlimited]; n != 5 {
+		t.Fatalf("unexpected number of active targets for an unlimited job; got %d; want 5", n)
+	}
+
+	droppedByJob := make(map[string]int)
+	for _, dt := range droppedTargetsMap.getTargetsList() {
+		if dt.dropReason != targetDropReasonMaxScrapeTargets {
+			continue
+		}
+		droppedByJob[dt.originalLabels.getJob()]++
+	}
+	if n := droppedByJob[jobUnder]; n != 0 {
+		t.Fatalf("unexpected number of dropped targets for a job under the limit; got %d; want 0", n)
+	}
+	if n := droppedByJob[jobOver]; n != 3 {
+		t.Fatalf("unexpected number of dropped targets for a job over the limit; got %d; want 3", n)
+	}
+	if n := droppedByJob[jobUnlimited]; n != 0 {
+		t.Fatalf("unexpected number of dropped targets for an unlimited job; got %d; want 0", n)
+	}
+}
