+// TestV3PutExceedsLeaseMaxKeys ensures a Put that would attach a new key past
+// a lease's configured maximum key count fails cleanly, that re-attaching a
+// key already on the lease keeps working, and that the server stays healthy
+// and keeps serving unrelated requests afterwards.
+func TestV3PutExceedsLeaseMaxKeys(t *testing.T) {
+	integration.BeforeTest(t)
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1, MaxLeaseKeys: 1})
+	defer clus.Terminate(t)
+
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+
+	kvc := integration.ToGRPC(clus.RandClient()).KV
+	lc := integration.ToGRPC(clus.RandClient()).Lease
+
+	lresp, err := lc.LeaseGrant(ctx, &pb.LeaseGrantRequest{TTL: 100})
+	require.NoError(t, err)
+
+	_, err = kvc.Put(ctx, &pb.PutRequest{Key: []byte("foo"), Value: []byte("bar"), Lease: lresp.ID})
+	require.NoError(t, err)
+
+	// re-attaching the same key to a lease already at capacity must keep working
+	_, err = kvc.Put(ctx, &pb.PutRequest{Key: []byte("foo"), Value: []byte("bar2"), Lease: lresp.ID})
+	require.NoError(t, err)
+
+	// attaching a genuinely new key once the lease is full must fail cleanly
+	_, err = kvc.Put(ctx, &pb.PutRequest{Key: []byte("bar"), Value: []byte("bar"), Lease: lresp.ID})
+	if !eqErrGRPC(err, rpctypes.ErrGRPCTooManyLeaseKeys) {
+		t.Errorf("err = %v, want %v", err, rpctypes.ErrGRPCTooManyLeaseKeys)
+	}
+
+	// the rejected key must not have been partially applied
+	rresp, err := kvc.Range(ctx, &pb.RangeRequest{Key: []byte("bar")})
+	require.NoError(t, err)
+	require.Empty(t, rresp.Kvs)
+
+	// the server must remain healthy and keep serving other requests
+	_, err = kvc.Put(ctx, &pb.PutRequest{Key: []byte("baz"), Value: []byte("qux")})
+	require.NoError(t, err)
+}
