+// TestCheckLeaseMaxKeys ensures checkLease rejects a Put that would attach a
+// new key past a lease's configured key limit, while a Put that re-attaches a
+// key already on the lease is always allowed.
+func TestCheckLeaseMaxKeys(t *testing.T) {
+	lg := zaptest.NewLogger(t)
+	be, _ := betesting.NewDefaultTmpBackend(t)
+	defer betesting.Close(t, be)
+
+	le := lease.NewLessor(lg, be, nil, lease.LessorConfig{MinLeaseTTL: 5, MaxLeaseKeys: 1})
+	defer le.Stop()
+
+	l, err := le.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("failed to grant lease: %v", err)
+	}
+	if err := le.Attach(l.ID, []lease.LeaseItem{{Key: "foo"}}); err != nil {
+		t.Fatalf("failed to attach item to lease: %v", err)
+	}
+
+	if err := checkLease(le, &pb.PutRequest{Key: []byte("foo"), Lease: int64(l.ID)}); err != nil {
+		t.Fatalf("expected re-attach of existing key to succeed, got %v", err)
+	}
+
+	err = checkLease(le, &pb.PutRequest{Key: []byte("bar"), Lease: int64(l.ID)})
+	if !errors.Is(err, lease.ErrTooManyLeaseKeys) {
+		t.Fatalf("expected ErrTooManyLeaseKeys, got %v", err)
+	}
+}
