+// TestLessorMaxLeaseKeys ensures that attaching a key that would push a
+// lease's distinct key count past MaxLeaseKeys is rejected, while re-attaching
+// a key already on the lease is always allowed regardless of the limit.
+func TestLessorMaxLeaseKeys(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL, MaxLeaseKeys: 2})
+	defer le.Stop()
+
+	l, err := le.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("could not grant lease (%v)", err)
+	}
+
+	// filling the lease up to the limit must succeed
+	if err := le.CheckAttachLimit(l.ID, LeaseItem{Key: "foo"}); err != nil {
+		t.Fatalf("expected no error attaching first key, got %v", err)
+	}
+	if err := le.Attach(l.ID, []LeaseItem{{Key: "foo"}}); err != nil {
+		t.Fatalf("failed to attach item to the lease: %v", err)
+	}
+	if err := le.CheckAttachLimit(l.ID, LeaseItem{Key: "bar"}); err != nil {
+		t.Fatalf("expected no error attaching second key, got %v", err)
+	}
+	if err := le.Attach(l.ID, []LeaseItem{{Key: "bar"}}); err != nil {
+		t.Fatalf("failed to attach item to the lease: %v", err)
+	}
+
+	// re-attaching an existing key must never be rejected, even at the limit
+	if err := le.CheckAttachLimit(l.ID, LeaseItem{Key: "foo"}); err != nil {
+		t.Fatalf("expected re-attach of existing key to succeed, got %v", err)
+	}
+
+	// a genuinely new key must be rejected once the lease is at capacity
+	err = le.CheckAttachLimit(l.ID, LeaseItem{Key: "baz"})
+	if !errors.Is(err, ErrTooManyLeaseKeys) {
+		t.Fatalf("expected ErrTooManyLeaseKeys, got %v", err)
+	}
+
+	// a non-existent lease still reports ErrLeaseNotFound
+	err = le.CheckAttachLimit(LeaseID(999), LeaseItem{Key: "foo"})
+	if !errors.Is(err, ErrLeaseNotFound) {
+		t.Fatalf("expected ErrLeaseNotFound, got %v", err)
+	}
+}
