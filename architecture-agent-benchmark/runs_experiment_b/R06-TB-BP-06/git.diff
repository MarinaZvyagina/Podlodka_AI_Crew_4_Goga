+// CheckAttachLimit reports whether attaching item to the lease with the given
+// ID would exceed maxLeaseKeys. It does not mutate any state.
+func (le *lessor) CheckAttachLimit(id LeaseID, item LeaseItem) error {
+	le.mu.RLock()
+	l := le.leaseMap[id]
+	le.mu.RUnlock()
+	if l == nil {
+		return ErrLeaseNotFound
+	}
+
+	l.mu.RLock()
+	defer l.mu.RUnlock()
+	if _, ok := l.itemSet[item]; ok {
+		return nil
+	}
+	if len(l.itemSet) >= le.maxLeaseKeys {
+		return ErrTooManyLeaseKeys
+	}
+	return nil
+}
