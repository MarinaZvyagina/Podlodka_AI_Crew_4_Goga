diff --git a/domain/src/main/java/mihon/domain/extension/model/ExtensionStoreUrlValidator.kt b/domain/src/main/java/mihon/domain/extension/model/ExtensionStoreUrlValidator.kt
new file mode 100644
index 0000000..ae62c79
--- /dev/null
+++ b/domain/src/main/java/mihon/domain/extension/model/ExtensionStoreUrlValidator.kt
@@ -0,0 +1,20 @@
+package mihon.domain.extension.model
+
+import java.net.URI
+import java.net.URISyntaxException
+
+object ExtensionStoreUrlValidator {
+
+    fun isValid(indexUrl: String): Boolean {
+        if (indexUrl.isBlank()) return false
+
+        val uri = try {
+            URI(indexUrl)
+        } catch (e: URISyntaxException) {
+            return false
+        }
+
+        val scheme = uri.scheme?.lowercase()
+        return (scheme == "http" || scheme == "https") && !uri.host.isNullOrBlank()
+    }
+}
