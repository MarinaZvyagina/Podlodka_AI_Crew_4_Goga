diff --git a/data/src/main/java/tachiyomi/data/source/SourceCatalogueCache.kt b/data/src/main/java/tachiyomi/data/source/SourceCatalogueCache.kt
new file mode 100644
index 0000000..6fe2166
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourceCatalogueCache.kt
@@ -0,0 +1,62 @@
+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.FilterList
+import eu.kanade.tachiyomi.source.model.MangasPage
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.time.Clock
+import kotlin.time.Duration.Companion.minutes
+import kotlin.time.Instant
+
+/**
+ * In-memory cache of source catalogue pages (popular/latest/search) keyed by the exact request
+ * that produced them, so re-issuing the same request shortly after returns cached results
+ * instead of hitting the network again. Entries expire after [CACHE_DURATION].
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourceCatalogueCache {
+
+    private val entries = ConcurrentHashMap<Key, Entry>()
+
+    fun get(key: Key): MangasPage? {
+        val entry = entries[key] ?: return null
+        if (Clock.System.now() - entry.timestamp > CACHE_DURATION) {
+            entries.remove(key)
+            return null
+        }
+        return entry.mangasPage
+    }
+
+    fun put(key: Key, mangasPage: MangasPage) {
+        entries[key] = Entry(mangasPage, Clock.System.now())
+    }
+
+    /**
+     * Drops every cached page belonging to the given listing so the next load fetches fresh data.
+     */
+    fun invalidate(sourceId: Long, mode: Mode, query: String, filters: FilterList) {
+        entries.keys.removeAll {
+            it.sourceId == sourceId && it.mode == mode && it.query == query &&
+                it.filters == filters
+        }
+    }
+
+    data class Key(
+        val sourceId: Long,
+        val mode: Mode,
+        val query: String,
+        val filters: FilterList,
+        val page: Int,
+    )
+
+    enum class Mode { POPULAR, LATEST, SEARCH }
+
+    private data class Entry(val mangasPage: MangasPage, val timestamp: Instant)
+
+    companion object {
+        private val CACHE_DURATION = 5.minutes
+    }
+}
