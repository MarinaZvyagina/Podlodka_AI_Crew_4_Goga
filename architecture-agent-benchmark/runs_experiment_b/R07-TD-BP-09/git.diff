diff --git a/data/src/main/java/tachiyomi/data/source/SourceMangaCache.kt b/data/src/main/java/tachiyomi/data/source/SourceMangaCache.kt
new file mode 100644
index 0000000..cf44e2e
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourceMangaCache.kt
@@ -0,0 +1,61 @@
+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.MangasPage
+import kotlin.time.Duration.Companion.minutes
+import kotlin.time.TimeSource
+
+/**
+ * In-memory cache of paginated browse-source results (popular/latest/search), so repeating the
+ * same listing shortly after (e.g. navigating back to it) doesn't re-hit the network. Entries
+ * expire after [ENTRY_LIFETIME] and can be forced stale early via [invalidate].
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourceMangaCache {
+
+    private data class Key(
+        val sourceId: Long,
+        val query: String,
+        val filters: List<Filter<*>>,
+        val page: Int,
+    )
+
+    private data class Entry(val mangasPage: MangasPage, val savedAt: TimeSource.Monotonic.ValueTimeMark)
+
+    private val cache = object : LinkedHashMap<Key, Entry>(16, 0.75f, true) {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<Key, Entry>) = size > MAX_ENTRIES
+    }
+
+    @Synchronized
+    fun get(sourceId: Long, query: String, filters: List<Filter<*>>, page: Int): MangasPage? {
+        val key = Key(sourceId, query, filters, page)
+        val entry = cache[key] ?: return null
+        if (entry.savedAt.elapsedNow() > ENTRY_LIFETIME) {
+            cache.remove(key)
+            return null
+        }
+        return entry.mangasPage
+    }
+
+    @Synchronized
+    fun put(sourceId: Long, query: String, filters: List<Filter<*>>, page: Int, mangasPage: MangasPage) {
+        cache[Key(sourceId, query, filters, page)] = Entry(mangasPage, TimeSource.Monotonic.markNow())
+    }
+
+    /**
+     * Discards every cached page for the given listing so the next load fetches from the network.
+     */
+    @Synchronized
+    fun invalidate(sourceId: Long, query: String, filters: List<Filter<*>>) {
+        cache.keys.removeAll { it.sourceId == sourceId && it.query == query && it.filters == filters }
+    }
+
+    companion object {
+        private const val MAX_ENTRIES = 60
+        private val ENTRY_LIFETIME = 5.minutes
+    }
+}
