+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.jobs
+
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.SignalDatabase.Companion.attachments
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.JsonJobData
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+import kotlin.time.Duration.Companion.days
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * Periodically reconciles on-disk attachment/thumbnail cache files against the database, deleting any that
+ * no longer correspond to an attachment or message still in the app.
+ *
+ * Files are processed in bounded batches, retrying itself and persisting its progress between attempts so
+ * a scan interrupted partway through (e.g. by process death) resumes from where it left off on its next
+ * attempt rather than restarting the whole scan or never finishing.
+ */
+class ThumbnailCacheCleanupJob private constructor(
+  parameters: Parameters,
+  private var lastProcessedFile: String?
+) : Job(parameters) {
+
+  companion object {
+    private val TAG = Log.tag(ThumbnailCacheCleanupJob::class)
+
+    const val KEY = "ThumbnailCacheCleanupJob"
+
+    private const val BATCH_SIZE = 500
+    private const val KEY_LAST_PROCESSED_FILE = "last_processed_file"
+
+    @JvmStatic
+    fun enqueue() {
+      AppDependencies.jobManager.add(ThumbnailCacheCleanupJob())
+    }
+  }
+
+  constructor() : this(
+    parameters = Parameters.Builder()
+      .setQueue(KEY)
+      .setMaxInstancesForFactory(1)
+      .setLifespan(1.days.inWholeMilliseconds)
+      .setMaxAttempts(Parameters.UNLIMITED)
+      .setGlobalPriority(Parameters.PRIORITY_LOWER)
+      .addConstraint(NotInCallConstraint.KEY)
+      .addConstraint(BatteryNotLowConstraint.KEY)
+      .build(),
+    lastProcessedFile = null
+  )
+
+  override fun serialize(): ByteArray? = JsonJobData.Builder()
+    .putString(KEY_LAST_PROCESSED_FILE, lastProcessedFile)
+    .build()
+    .serialize()
+
+  override fun getFactoryKey(): String = KEY
+
+  override fun onFailure() = Unit
+
+  override fun run(): Result {
+    val batchResult = attachments.deleteAbandonedAttachmentFileBatch(afterFile = lastProcessedFile, batchSize = BATCH_SIZE)
+
+    if (batchResult.deletedCount > 0) {
+      Log.i(TAG, "Deleted ${batchResult.deletedCount} orphaned cache files.")
+    }
+
+    if (batchResult.isComplete) {
+      return Result.success()
+    }
+
+    lastProcessedFile = batchResult.nextCursor
+    return Result.retry(1.seconds.inWholeMilliseconds)
+  }
+
+  class Factory : Job.Factory<ThumbnailCacheCleanupJob> {
+    override fun create(parameters: Parameters, serializedData: ByteArray?): ThumbnailCacheCleanupJob {
+      val data = JsonJobData.deserialize(serializedData)
+      return ThumbnailCacheCleanupJob(parameters, data.getStringOrDefault(KEY_LAST_PROCESSED_FILE, null))
+    }
+  }
+}
