+  /**
+   * Deletes up to [batchSize] on-disk attachment/thumbnail cache files that sort after [afterFile] and are
+   * no longer referenced by any attachment or sticker row, so a large directory can be reconciled across
+   * multiple bounded calls instead of one unbounded pass.
+   *
+   * The returned [AbandonedFileBatchResult.nextCursor] should be passed back in as [afterFile] on the next
+   * call to resume where this one left off; [AbandonedFileBatchResult.isComplete] is true once there are no
+   * more files on disk after [afterFile] to consider.
+   */
+  fun deleteAbandonedAttachmentFileBatch(afterFile: String?, batchSize: Int): AbandonedFileBatchResult {
+    val diskFiles = context.getDir(DIRECTORY, Context.MODE_PRIVATE).listFiles() ?: return AbandonedFileBatchResult(nextCursor = null, deletedCount = 0, isComplete = true)
+
+    val candidateFiles: List<String> = diskFiles
+      .asSequence()
+      .filterNot { file: File -> PartFileProtector.isProtected(file) }
+      .map { file: File -> file.absolutePath }
+      .filter { afterFile == null || it > afterFile }
+      .sorted()
+      .take(batchSize)
+      .toList()
+
+    if (candidateFiles.isEmpty()) {
+      return AbandonedFileBatchResult(nextCursor = null, deletedCount = 0, isComplete = true)
+    }
+
+    val referencedFiles: MutableSet<String> = HashSet(candidateFiles.size)
+
+    readableDatabase.withinTransaction { db ->
+      val dataFileQuery = SqlUtil.buildFastCollectionQuery(DATA_FILE, candidateFiles)
+      db.select(DATA_FILE)
+        .from(TABLE_NAME)
+        .where(dataFileQuery.where, dataFileQuery.whereArgs)
+        .run()
+        .forEach { cursor -> cursor.requireString(DATA_FILE)?.let { referencedFiles += it } }
+
+      val thumbnailFileQuery = SqlUtil.buildFastCollectionQuery(THUMBNAIL_FILE, candidateFiles)
+      db.select(THUMBNAIL_FILE)
+        .from(TABLE_NAME)
+        .where(thumbnailFileQuery.where, thumbnailFileQuery.whereArgs)
+        .run()
+        .forEach { cursor -> cursor.requireString(THUMBNAIL_FILE)?.let { referencedFiles += it } }
+    }
+
+    referencedFiles += SignalDatabase.stickers.getAllStickerFiles()
+
+    var deletedCount = 0
+    for (filePath in candidateFiles) {
+      if (filePath !in referencedFiles) {
+        if (File(filePath).delete()) {
+          deletedCount++
+        } else {
+          Log.w(TAG, "[deleteAbandonedAttachmentFileBatch] Failed to delete orphaned file. $filePath")
+        }
+      }
+    }
+
+    return AbandonedFileBatchResult(
+      nextCursor = candidateFiles.last(),
+      deletedCount = deletedCount,
+      isComplete = candidateFiles.size < batchSize
+    )
+  }
+
+  data class AbandonedFileBatchResult(val nextCursor: String?, val deletedCount: Int, val isComplete: Boolean)
+
