+
+package org.thoughtcrime.securesms.jobs
+
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.JsonJobData
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+import kotlin.time.Duration.Companion.milliseconds
+
+/**
+ * Sweeps the attachment "parts" directory for files that no longer correspond to any attachment or sticker
+ * still referenced in the database, and deletes them. This includes cached thumbnails: thumbnails are stored
+ * in the same on-disk directory as full attachment data and are only distinguishable via the attachment row
+ * that references them (as [org.thoughtcrime.securesms.database.AttachmentTable.THUMBNAIL_FILE]), so once
+ * that row (and the message/attachment it belonged to) is gone, an orphaned thumbnail file is indistinguishable
+ * from an orphaned data file -- both just need to be deleted to reclaim the disk space.
+ *
+ * Triggered on a recurring cadence by [org.thoughtcrime.securesms.service.ThumbnailCacheCleanupAlarmListener],
+ * independent of any specific attachment/message deletion event, so orphaned files don't linger indefinitely if
+ * a deletion path fails to trigger cleanup itself.
+ *
+ * A device that's been used for a long time can have a lot of files to check, so this only examines a small
+ * batch per run and retries itself (via [Result.retry]) until the whole directory has been swept. The examined
+ * position is persisted via [serialize], so if the process is killed mid-pass, the next attempt resumes after
+ * the last completed batch instead of rescanning everything from the start or abandoning the pass.
+ */
+class RoutineThumbnailCacheCleanupJob private constructor(
+  parameters: Parameters,
+  private var cursor: String?
+) : Job(parameters) {
+
+  companion object {
+    private val TAG = Log.tag(RoutineThumbnailCacheCleanupJob::class.java)
+
+    const val KEY = "RoutineThumbnailCacheCleanupJob"
+
+    private const val KEY_CURSOR = "cursor"
+    private const val BATCH_SIZE = 500
+    private val BATCH_DELAY = 500.milliseconds
+  }
+
+  constructor() : this(
+    parameters = Parameters.Builder()
+      .setQueue(KEY)
+      .setMaxInstancesForFactory(1)
+      .setLifespan(Parameters.IMMORTAL)
+      .setMaxAttempts(Parameters.UNLIMITED)
+      .setGlobalPriority(Parameters.PRIORITY_LOWER)
+      .addConstraint(NotInCallConstraint.KEY)
+      .addConstraint(BatteryNotLowConstraint.KEY)
+      .build(),
+    cursor = null
+  )
+
+  override fun serialize(): ByteArray? {
+    return JsonJobData.Builder()
+      .putString(KEY_CURSOR, cursor)
+      .serialize()
+  }
+
+  override fun getFactoryKey(): String = KEY
+
+  override fun onFailure() = Unit
+
+  override fun run(): Result {
+    val result = SignalDatabase.attachments.deleteAbandonedAttachmentFiles(afterFileName = cursor, limit = BATCH_SIZE)
+
+    if (result.filesDeleted > 0) {
+      Log.i(TAG, "Deleted ${result.filesDeleted} orphaned attachment/thumbnail file(s).")
+    }
+
+    if (result.lastExaminedFileName == null) {
+      Log.i(TAG, "Finished a full cleanup pass.")
+      return Result.success()
+    }
+
+    cursor = result.lastExaminedFileName
+    return Result.retry(BATCH_DELAY.inWholeMilliseconds)
+  }
+
+  class Factory : Job.Factory<RoutineThumbnailCacheCleanupJob> {
+    override fun create(parameters: Parameters, serializedData: ByteArray?): RoutineThumbnailCacheCleanupJob {
+      val data = JsonJobData.deserialize(serializedData)
+      return RoutineThumbnailCacheCleanupJob(parameters, data.getStringOrDefault(KEY_CURSOR, null))
+    }
+  }
+}
