+  /**
+   * Batched variant of [deleteAbandonedAttachmentFiles] intended for incremental background cleanup passes over
+   * a potentially large backlog. Examines at most [limit] on-disk files, in filename order, picking up after
+   * [afterFileName], and deletes any that are not referenced by an attachment's data file or thumbnail file, or
+   * by a sticker.
+   *
+   * @return the filename of the last file examined, to be passed back in as [afterFileName] on a later call to
+   * resume where this one left off, or null if there were no more files to examine (i.e. the directory has been
+   * fully swept).
+   */
+  fun deleteAbandonedAttachmentFiles(afterFileName: String?, limit: Int): AbandonedAttachmentFileCleanupResult {
+    val diskFiles = context.getDir(DIRECTORY, Context.MODE_PRIVATE).listFiles() ?: return AbandonedAttachmentFileCleanupResult(0, null)
+
+    val batch: List<File> = diskFiles
+      .filter { file: File -> !PartFileProtector.isProtected(file) }
+      .sortedBy { it.name }
+      .filter { afterFileName == null || it.name > afterFileName }
+      .take(limit)
+
+    if (batch.isEmpty()) {
+      return AbandonedAttachmentFileCleanupResult(0, null)
+    }
+
+    val filesInDb: MutableSet<String> = HashSet()
+
+    readableDatabase.withinTransaction { db ->
+      db.select(DATA_FILE, THUMBNAIL_FILE)
+        .from(TABLE_NAME)
+        .run()
+        .forEach { cursor ->
+          cursor.requireString(DATA_FILE)?.let { filesInDb += it }
+          cursor.requireString(THUMBNAIL_FILE)?.let { filesInDb += it }
+        }
+    }
+
+    filesInDb += SignalDatabase.stickers.getAllStickerFiles()
+
+    var filesDeleted = 0
+    for (file in batch) {
+      if (file.absolutePath !in filesInDb) {
+        if (file.delete()) {
+          filesDeleted++
+        } else {
+          Log.w(TAG, "[deleteAbandonedAttachmentFiles] Failed to delete attachment file. ${file.absolutePath}")
+        }
+      }
+    }
+
+    return AbandonedAttachmentFileCleanupResult(filesDeleted, batch.last().name)
+  }
+
+  data class AbandonedAttachmentFileCleanupResult(val filesDeleted: Int, val lastExaminedFileName: String?)
