+package org.thoughtcrime.securesms.service
+
+import android.content.Context
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.jobs.RoutineThumbnailCacheCleanupJob
+import org.thoughtcrime.securesms.keyvalue.SignalStore
+import kotlin.time.Duration.Companion.days
+
+/**
+ * Periodically schedules [RoutineThumbnailCacheCleanupJob] to sweep up orphaned attachment/thumbnail cache
+ * files, independent of app foreground activity or any particular deletion event.
+ */
+class ThumbnailCacheCleanupAlarmListener : PersistentAlarmManagerListener() {
+  companion object {
+    private val CLEANUP_INTERVAL = 3.days
+
+    @JvmStatic
+    fun schedule(context: Context?) {
+      ThumbnailCacheCleanupAlarmListener().onReceive(context, getScheduleIntent())
+    }
+  }
+
+  override fun getNextScheduledExecutionTime(context: Context): Long {
+    var nextTime = SignalStore.misc.nextThumbnailCleanupTime
+
+    if (nextTime == 0L) {
+      nextTime = getNextTime()
+      SignalStore.misc.nextThumbnailCleanupTime = nextTime
+    }
+
+    return nextTime
+  }
+
+  override fun onAlarm(context: Context, scheduledTime: Long): Long {
+    AppDependencies.jobManager.add(RoutineThumbnailCacheCleanupJob())
+
+    val nextTime = getNextTime()
+    SignalStore.misc.nextThumbnailCleanupTime = nextTime
+
+    return nextTime
+  }
+
+  private fun getNextTime(): Long {
+    return System.currentTimeMillis() + CLEANUP_INTERVAL.inWholeMilliseconds
+  }
+}
