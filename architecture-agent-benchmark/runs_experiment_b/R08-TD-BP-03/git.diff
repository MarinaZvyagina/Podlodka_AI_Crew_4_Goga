+
+package org.thoughtcrime.securesms.search
+
+import android.app.Application
+import assertk.assertThat
+import assertk.assertions.hasSize
+import assertk.assertions.isEmpty
+import assertk.assertions.isSameAs
+import io.mockk.every
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.signal.core.models.ServiceId.ACI
+import org.signal.core.models.ServiceId.PNI
+import org.thoughtcrime.securesms.database.MessageTable
+import org.thoughtcrime.securesms.database.MessageType
+import org.thoughtcrime.securesms.database.RecipientTable
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.mms.IncomingMessage
+import org.thoughtcrime.securesms.recipients.RecipientId
+import org.thoughtcrime.securesms.testutil.RecipientTestRule
+import org.whispersystems.signalservice.api.push.ServiceIds
+import java.util.UUID
+
+/**
+ * Verifies that [SearchRepository] caches repeat identical searches and that [SearchRepository.clearCache]
+ * is what forces a subsequent search to see newly-changed data.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class SearchRepositoryTest_caching {
+
+  @get:Rule
+  val recipientRule = RecipientTestRule()
+
+  private lateinit var recipients: RecipientTable
+  private lateinit var messages: MessageTable
+  private lateinit var alice: RecipientId
+  private lateinit var searchRepository: SearchRepository
+
+  @Before
+  fun setUp() {
+    recipients = SignalDatabase.recipients
+    messages = SignalDatabase.messages
+
+    every { recipientRule.signalStore.account.getServiceIds() } returns ServiceIds(ACI.from(UUID.randomUUID()), PNI.from(UUID.randomUUID()))
+
+    alice = recipients.getOrInsertFromServiceId(ACI.from(UUID.randomUUID()))
+    searchRepository = SearchRepository("Note to Self")
+  }
+
+  @Test
+  fun repeatMessageSearchIsCachedUntilInvalidated() {
+    val inserted = messages.insertMessageInbox(incoming(body = "the eagle has landed")).get()
+
+    val first = searchRepository.queryMessagesSync("eagle", SearchFilter.EMPTY)
+    assertThat(first.results).hasSize(1)
+
+    messages.deleteMessage(inserted.messageId)
+
+    // Same query, no clearCache() call yet -- must return the exact cached snapshot rather than re-querying.
+    val second = searchRepository.queryMessagesSync("eagle", SearchFilter.EMPTY)
+    assertThat(second).isSameAs(first)
+
+    // Once invalidated, the same query must reflect that the message was deleted.
+    searchRepository.clearCache()
+    val third = searchRepository.queryMessagesSync("eagle", SearchFilter.EMPTY)
+    assertThat(third.results).isEmpty()
+  }
+
+  @Test
+  fun differentQueriesAreCachedIndependently() {
+    messages.insertMessageInbox(incoming(body = "the eagle has landed", sentTimeMillis = 1000))
+    messages.insertMessageInbox(incoming(body = "hello world", sentTimeMillis = 2000))
+
+    val eagleResult = searchRepository.queryMessagesSync("eagle", SearchFilter.EMPTY)
+    val helloResult = searchRepository.queryMessagesSync("hello", SearchFilter.EMPTY)
+
+    assertThat(eagleResult.results).hasSize(1)
+    assertThat(helloResult.results).hasSize(1)
+    assertThat(searchRepository.queryMessagesSync("eagle", SearchFilter.EMPTY)).isSameAs(eagleResult)
+    assertThat(searchRepository.queryMessagesSync("hello", SearchFilter.EMPTY)).isSameAs(helloResult)
+  }
+
+  private fun incoming(body: String, sentTimeMillis: Long = 1000): IncomingMessage {
+    return IncomingMessage(
+      type = MessageType.NORMAL,
+      from = alice,
+      sentTimeMillis = sentTimeMillis,
+      serverTimeMillis = sentTimeMillis,
+      receivedTimeMillis = sentTimeMillis,
+      body = body,
+      isUnidentified = true
+    )
+  }
+}
