+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import android.app.Application
+import assertk.assertThat
+import assertk.assertions.isNotSameInstanceAs
+import assertk.assertions.isSameInstanceAs
+import io.mockk.Runs
+import io.mockk.every
+import io.mockk.just
+import io.mockk.slot
+import io.mockk.verify
+import org.junit.Before
+import org.junit.BeforeClass
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.DatabaseObserver
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.testutil.MockAppDependenciesRule
+import org.thoughtcrime.securesms.testutil.SignalDatabaseRule
+import org.thoughtcrime.securesms.testutil.SystemOutLogger
+
+/**
+ * Exercises the search result cache in [SearchRepository]: repeated identical searches should hit
+ * the cache, and a conversation list change (message/thread inserted, edited, or deleted anywhere)
+ * should drop it so the next identical search reflects current data.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class SearchRepositoryCacheTest {
+
+  @get:Rule val signalDatabaseRule = SignalDatabaseRule()
+
+  @get:Rule val applicationDependencies = MockAppDependenciesRule()
+
+  private val invalidationListener = slot<DatabaseObserver.Observer>()
+
+  private lateinit var repository: SearchRepository
+
+  companion object {
+    @BeforeClass
+    @JvmStatic
+    fun setUpClass() {
+      Log.initialize(SystemOutLogger())
+    }
+  }
+
+  @Before
+  fun setUp() {
+    every { AppDependencies.databaseObserver.registerConversationListObserver(capture(invalidationListener)) } just Runs
+
+    repository = SearchRepository("Note to Self")
+  }
+
+  @Test
+  fun repeatedIdenticalThreadSearch_returnsCachedResult() {
+    val first = repository.queryThreadsSync("alpha", false)
+    val second = repository.queryThreadsSync("alpha", false)
+
+    assertThat(second).isSameInstanceAs(first)
+  }
+
+  @Test
+  fun repeatedIdenticalMessageSearch_returnsCachedResult() {
+    val first = repository.queryMessagesSync("alpha", SearchFilter.EMPTY)
+    val second = repository.queryMessagesSync("alpha", SearchFilter.EMPTY)
+
+    assertThat(second).isSameInstanceAs(first)
+  }
+
+  @Test
+  fun differentQueries_areCachedIndependently() {
+    val alpha = repository.queryThreadsSync("alpha", false)
+    val beta = repository.queryThreadsSync("beta", false)
+
+    assertThat(beta).isNotSameInstanceAs(alpha)
+    assertThat(repository.queryThreadsSync("alpha", false)).isSameInstanceAs(alpha)
+  }
+
+  @Test
+  fun conversationListChange_invalidatesThreadCache() {
+    val first = repository.queryThreadsSync("alpha", false)
+
+    invalidationListener.captured.onChanged()
+
+    val second = repository.queryThreadsSync("alpha", false)
+
+    assertThat(second).isNotSameInstanceAs(first)
+  }
+
+  @Test
+  fun conversationListChange_invalidatesMessageCache() {
+    val first = repository.queryMessagesSync("alpha", SearchFilter.EMPTY)
+
+    invalidationListener.captured.onChanged()
+
+    val second = repository.queryMessagesSync("alpha", SearchFilter.EMPTY)
+
+    assertThat(second).isNotSameInstanceAs(first)
+  }
+
+  @Test
+  fun close_unregistersInvalidationListener() {
+    repository.queryThreadsSync("alpha", false)
+    repository.close()
+
+    verify { AppDependencies.databaseObserver.unregisterObserver(invalidationListener.captured) }
+  }
+}
