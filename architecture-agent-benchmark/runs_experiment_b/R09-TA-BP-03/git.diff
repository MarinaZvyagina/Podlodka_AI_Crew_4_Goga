+    @MainActor
+    func testRemoveWindowData_removesPrimaryAndBackupFiles() async throws {
+        let subject = createSubject()
+        let removedUUID = defaultTestTabWindowUUID
+        let primaryURL = URL(string: "some/directory1/window-\(removedUUID.uuidString)")!
+        let backupURL = URL(string: "some/directory2/window-\(removedUUID.uuidString)")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.primaryPathContents = [primaryURL]
+        mockFileManager.backupPathContents = [backupURL]
+
+        await subject.removeWindowData(forUUIDs: [removedUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertTrue(mockFileManager.removedPaths.contains(primaryURL))
+        XCTAssertTrue(mockFileManager.removedPaths.contains(backupURL))
+    }
+
