+import Foundation
+
 public final class BulkDeleteInteractionJobQueue {
     private let jobRunnerFactory: BulkDeleteInteractionJobRunnerFactory
     private let jobQueueRunner: JobQueueRunner<
@@ -64,6 +66,72 @@ public final class BulkDeleteInteractionJobQueue {
             self.jobQueueRunner.addPersistedJob(jobRecord)
         }
     }
+
+    // MARK: - Message Retention
+
+    private enum MessageRetentionConstants {
+        static let secondsPerDay: TimeInterval = 24 * 60 * 60
+        /// Minimum time between automatic (launch/foreground-triggered) sweeps.
+        static let minSweepInterval: TimeInterval = 24 * 60 * 60
+    }
+
+    /// Enumerates every non-story thread and enqueues a bulk-delete job for
+    /// any thread with messages older than `retentionPeriodDays`.
+    public func sweepMessageRetention(
+        retentionPeriodDays: UInt32,
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        let cutoffTimestamp = now
+            .addingTimeInterval(-TimeInterval(retentionPeriodDays) * MessageRetentionConstants.secondsPerDay)
+            .ows_millisecondsSince1970
+
+        threadStore.enumerateNonStoryThreads(tx: tx) { thread in
+            guard
+                let anchorMessageRowId = InteractionFinder.rowIdOfNewestInteraction(
+                    threadUniqueId: thread.uniqueId,
+                    receivedAtOrBefore: cutoffTimestamp,
+                    tx: tx,
+                )
+            else {
+                return true
+            }
+
+            self.addJob(
+                anchorMessageRowId: anchorMessageRowId,
+                isFullThreadDelete: false,
+                threadUniqueId: thread.uniqueId,
+                tx: tx,
+            )
+
+            return true
+        }
+    }
+
+    /// Throttled wrapper around `sweepMessageRetention`, intended for
+    /// routine/automatic triggers (app launch, foregrounding). Applying a
+    /// newly-changed retention window immediately should call
+    /// `sweepMessageRetention` directly instead, bypassing the throttle.
+    func sweepMessageRetentionIfNeeded(
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        guard let retentionPeriodDays = SSKPreferences.messageRetentionPeriodDays(transaction: tx) else {
+            return
+        }
+
+        if
+            let lastSweepAt = SSKPreferences.lastMessageRetentionSweepAt(transaction: tx),
+            now.timeIntervalSince(lastSweepAt) < MessageRetentionConstants.minSweepInterval
+        {
+            return
+        }
+
+        sweepMessageRetention(retentionPeriodDays: retentionPeriodDays, now: now, threadStore: threadStore, tx: tx)
+        SSKPreferences.setLastMessageRetentionSweepAt(now, transaction: tx)
+    }
 }
 
