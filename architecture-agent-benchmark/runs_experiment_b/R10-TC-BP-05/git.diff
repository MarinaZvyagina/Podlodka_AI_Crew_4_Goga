+    // MARK: - Message Retention
+
+    private enum RetentionConstants {
+        static let secondsPerDay: TimeInterval = 24 * 60 * 60
+        /// Don't bother re-sweeping more often than this from routine/automatic
+        /// triggers (app launch, foregrounding); the setting's own UI can still
+        /// force an immediate sweep by calling `sweepMessageRetention` directly.
+        static let minSweepInterval: TimeInterval = RetentionConstants.secondsPerDay
+    }
+
+    /// Enumerates every thread and enqueues a bulk-delete job (reusing the
+    /// same machinery as manual "Clear Chat History") for any thread with
+    /// messages older than the given retention window. Safe to call
+    /// unconditionally and repeatedly; threads with nothing to delete are
+    /// skipped.
+    public func sweepMessageRetention(
+        retentionPeriodDays: UInt32,
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        let cutoffDate = now.addingTimeInterval(-TimeInterval(retentionPeriodDays) * RetentionConstants.secondsPerDay)
+        let cutoffTimestamp = cutoffDate.ows_millisecondsSince1970
+
+        threadStore.enumerateNonStoryThreads(tx: tx) { thread in
+            if
+                let anchorMessageRowId = InteractionFinder.rowIdOfNewestInteraction(
+                    threadUniqueId: thread.uniqueId,
+                    receivedAtOrBefore: cutoffTimestamp,
+                    tx: tx,
+                )
+            {
+                self.addJob(
+                    anchorMessageRowId: anchorMessageRowId,
+                    isFullThreadDelete: false,
+                    threadUniqueId: thread.uniqueId,
+                    tx: tx,
+                )
+            }
+
+            return true
+        }
+
+        SSKPreferences.setLastMessageRetentionSweepAt(now, transaction: tx)
+    }
+
+    /// A throttled wrapper around `sweepMessageRetention`, for use at routine
+    /// automatic trigger points (app launch, foregrounding). Does nothing if
+    /// retention is disabled or a sweep already ran recently.
+    func sweepMessageRetentionIfNeeded(
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        guard let retentionPeriodDays = SSKPreferences.messageRetentionPeriodDays(transaction: tx) else {
+            return
+        }
+
+        if
+            let lastSweptAt = SSKPreferences.lastMessageRetentionSweepAt(transaction: tx),
+            now.timeIntervalSince(lastSweptAt) < RetentionConstants.minSweepInterval
+        {
+            return
+        }
+
+        sweepMessageRetention(
+            retentionPeriodDays: retentionPeriodDays,
+            now: now,
+            threadStore: threadStore,
+            tx: tx,
+        )
+    }
 }
 
