diff --git a/freqtrade/configuration/config_validation.py b/freqtrade/configuration/config_validation.py
index 1c22c2b..328abd0 100644
--- a/freqtrade/configuration/config_validation.py
+++ b/freqtrade/configuration/config_validation.py
@@ -93,6 +93,7 @@ def validate_config_consistency(conf: dict[str, Any], *, preliminary: bool = Fal
     validate_migrated_strategy_settings(conf)
     _validate_orderflow(conf)
     _validate_demo_trading(conf)
+    _validate_capital_settings(conf)
 
     # validate configuration before returning
     logger.info("Validating configuration ...")
@@ -419,6 +420,21 @@ def _validate_demo_trading(conf: dict[str, Any]) -> None:
         raise ConfigurationError("Demo trading cannot be used together with dry_run.")
 
 
+def _validate_capital_settings(conf: dict[str, Any]) -> None:
+    """
+    `available_capital` and `tradable_balance_ratio` both control starting capital sizing.
+    Only `available_capital` takes effect when both are present, silently ignoring
+    `tradable_balance_ratio` - which is confusing for users expecting them to combine.
+    """
+    if "available_capital" in conf and "tradable_balance_ratio" in conf:
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in your "
+            "configuration. Only one of these settings takes effect at a time - "
+            "`available_capital` will be used and `tradable_balance_ratio` will be ignored. "
+            "Please remove one of these settings."
+        )
+
+
 def _strategy_settings(conf: dict[str, Any]) -> None:
     process_deprecated_setting(conf, None, "use_sell_signal", None, "use_exit_signal")
     process_deprecated_setting(conf, None, "sell_profit_only", None, "exit_profit_only")
