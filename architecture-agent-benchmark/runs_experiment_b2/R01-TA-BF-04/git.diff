diff --git a/tests/test_configuration.py b/tests/test_configuration.py
index 59516f6..b3417d9 100644
--- a/tests/test_configuration.py
+++ b/tests/test_configuration.py
@@ -1061,6 +1061,23 @@ def test__validate_demo_trading(default_conf_usdt) -> None:
     validate_config_consistency(conf)
 
 
+def test__validate_capital_settings(default_conf_usdt) -> None:
+    conf = deepcopy(default_conf_usdt)
+    # tradable_balance_ratio alone is fine (already present in default_conf_usdt).
+    validate_config_consistency(conf)
+
+    conf["available_capital"] = 1000
+    with pytest.raises(
+        ConfigurationError,
+        match=r"Both `available_capital` and `tradable_balance_ratio` are set.*",
+    ):
+        validate_config_consistency(conf)
+
+    del conf["tradable_balance_ratio"]
+    # Should pass now that only available_capital is set.
+    validate_config_consistency(conf)
+
+
 def test_validate_edge_removal(default_conf):
