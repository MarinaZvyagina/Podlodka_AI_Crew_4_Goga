+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses_global(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 1000,
+            "trade_limit": 3,
+            "stop_duration": 40,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped for .*due to 3 consecutive losses.*"
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2 losses in a row (different pairs) - not enough yet.
+    for pair, min_ago_close in (("XRP/BTC", 50), ("BCH/BTC", 40)):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.STOP_LOSS.value,
+            min_ago_open=min_ago_close + 10,
+            min_ago_close=min_ago_close,
+            profit_rate=0.9,
+        )
+    assert not freqtrade.protections.global_stop()
+
+    # A win breaks the streak.
+    generate_mock_trade(
+        "LTC/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        min_ago_open=40,
+        min_ago_close=30,
+        profit_rate=1.1,
+    )
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+
+    # 2 more losses - streak since the win is only 2, still not enough.
+    for pair, min_ago_close in (("XRP/BTC", 20), ("BCH/BTC", 10)):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.STOP_LOSS.value,
+            min_ago_open=min_ago_close + 10,
+            min_ago_close=min_ago_close,
+            profit_rate=0.9,
+        )
+    assert not freqtrade.protections.global_stop()
+
+    # 3rd consecutive loss since the win - triggers the global lock.
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=12,
+        min_ago_close=2,
+        profit_rate=0.9,
+    )
+
+    assert freqtrade.protections.global_stop()
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_global_lock()
+
+
+@pytest.mark.parametrize("only_per_pair", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses_perpair(mocker, default_conf, fee, caplog, only_per_pair):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 1000,
+            "trade_limit": 2,
+            "stop_duration": 60,
+            "only_per_pair": only_per_pair,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped for .*due to 2 consecutive losses.*"
+    pair = "XRP/BTC"
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # Unrelated pair should not affect XRP/BTC's per-pair streak
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=80,
+        min_ago_close=60,
+        profit_rate=0.9,
+    )
+
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=70,
+        min_ago_close=50,
+        profit_rate=0.9,
+    )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not PairLocks.is_pair_locked(pair)
+
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=40,
+        min_ago_close=20,
+        profit_rate=0.9,
+    )
+
+    assert freqtrade.protections.stop_per_pair(pair)
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_pair_locked(pair)
+    # The bot-wide streak (ETH/BTC loss + 2 XRP/BTC losses) is 3 consecutive losses overall,
+    # so the global lock should also trigger unless disabled via only_per_pair.
+    assert freqtrade.protections.global_stop() != only_per_pair
+    assert PairLocks.is_global_lock() != only_per_pair
+
+
