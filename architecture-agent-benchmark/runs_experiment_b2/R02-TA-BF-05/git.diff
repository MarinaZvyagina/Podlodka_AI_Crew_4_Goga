+def _to_percent(value):
+    """
+    Normalize a threshold value (which may be a percent string like
+    "50%" or a bare number) into a float.
+    """
+    if isinstance(value, str) and "%" in value:
+        value = re.sub("%", "", value)
+    return float(value)
+
