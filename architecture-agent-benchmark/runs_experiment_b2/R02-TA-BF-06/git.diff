diff --git a/changelog/69950.added.md b/changelog/69950.added.md
new file mode 100644
index 0000000..806a5fc
--- /dev/null
+++ b/changelog/69950.added.md
@@ -0,0 +1 @@
+Added a "usage dropped below expected" alert to the `diskusage` beacon, so a mount that suddenly reports unexpectedly low usage (often a sign that a filesystem silently failed to mount) can be alerted on alongside the existing high-usage threshold. Configure it with a `min`/`max` mapping instead of a bare percentage; existing scalar-percentage configuration is unaffected.
diff --git a/salt/beacons/diskusage.py b/salt/beacons/diskusage.py
index da904cf..47a2206 100644
--- a/salt/beacons/diskusage.py
+++ b/salt/beacons/diskusage.py
@@ -43,6 +43,12 @@ def validate(config):
     return True, "Valid beacon configuration"
 
 
+def _to_percent(value):
+    if isinstance(value, str) and "%" in value:
+        value = re.sub("%", "", value)
+    return float(value)
+
+
 def beacon(config):
     r"""
     Monitor the disk usage of the minion
@@ -83,6 +89,28 @@ def beacon(config):
     which means that if a regular expression matches another defined mount point,
     it will override the previously defined threshold.
 
+    .. versionadded:: 3007.0
+
+        A mount point's threshold can also be given as a mapping of ``min`` and/or
+        ``max`` percentages, instead of a bare high-water mark. ``max`` behaves
+        exactly like the plain percentage above: the beacon fires when usage is at
+        or above it. ``min`` fires when usage drops *below* it, which is normally a
+        sign that a filesystem failed to mount and the mount point is just an empty
+        directory on the root filesystem rather than genuine free space. Either key
+        may be used alone, or both together, and each mount point is evaluated
+        independently.
+
+        .. code-block:: yaml
+
+            beacons:
+              diskusage:
+                - /: 63%
+                - /mnt/nfs:
+                    min: 5%
+                    max: 50%
+                - /mnt/backups:
+                    min: 10%
+
     """
     whitelist = []
     config = salt.utils.beacons.remove_hidden_options(config, whitelist)
@@ -118,9 +146,25 @@ def beacon(config):
 
                 current_usage = _current_usage.percent
                 monitor_usage = mounts[mount]
-                if isinstance(monitor_usage, str) and "%" in monitor_usage:
-                    monitor_usage = re.sub("%", "", monitor_usage)
-                monitor_usage = float(monitor_usage)
-                if current_usage >= monitor_usage:
+
+                if isinstance(monitor_usage, dict):
+                    max_usage = monitor_usage.get("max")
+                    min_usage = monitor_usage.get("min")
+                else:
+                    # Existing configuration: a bare percentage is a high-water
+                    # mark, exactly as before.
+                    max_usage = monitor_usage
+                    min_usage = None
+
+                if max_usage is not None and current_usage >= _to_percent(max_usage):
                     ret.append({"diskusage": current_usage, "mount": _mount})
+
+                if min_usage is not None and current_usage < _to_percent(min_usage):
+                    ret.append(
+                        {
+                            "diskusage": current_usage,
+                            "mount": _mount,
+                            "below_threshold": True,
+                        }
+                    )
     return ret
