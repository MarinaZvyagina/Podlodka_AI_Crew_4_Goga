+def _to_percent(value):
+    """
+    Normalize a threshold value (which may be a percent-suffixed string,
+    a plain string, or a number) into a float.
+    """
+    if isinstance(value, str) and "%" in value:
+        value = re.sub("%", "", value)
+    return float(value)
+
