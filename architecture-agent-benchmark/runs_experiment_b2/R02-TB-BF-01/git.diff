+        configured = self._get_beacons(
+            include_pillar=include_pillar, include_opts=include_opts
+        )
+
+        status = {}
+        for name in configured:
+            if name == "enabled":
+                continue
+            entry = self.status.get(name)
+            if entry is None:
+                # This beacon is configured but has not fired even once
+                # since the minion process last (re)loaded its beacons.
+                status[name] = {"last_run": None, "last_error": None}
+            else:
+                status[name] = dict(entry)
+
+        # Fire the complete event back along with the beacon status
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacons": status},
+                tag="/salt/minion/minion_beacons_status_complete",
+            )
+
+        return True
