+def status(include_pillar=True, include_opts=True, return_yaml=True, **kwargs):
+    """
+    Return, for each currently configured beacon, when it last actually
+    fired and whether that firing raised an error. This reflects live
+    beacon activity on the minion: it is updated every time a beacon runs,
+    with no need to wait for a new probe cycle, read log files, or restart
+    the minion. A beacon that is configured but hasn't fired yet is
+    reported with ``last_run`` set to ``None`` rather than a stale or
+    made-up value.
+
+    :param return_yaml:    Whether to return YAML formatted output,
+                           default ``True``
+
+    :param include_pillar: Whether to include beacons that are
+                           configured in pillar, default is ``True``.
+
+    :param include_opts:   Whether to include beacons that are
+                           configured in opts, default is ``True``.
+
+    :return:               Dictionary, keyed by beacon name, of
+                           ``last_run`` (timestamp string, or ``None`` if
+                           the beacon has never fired) and ``last_error``
+                           (the error string from the most recent run, or
+                           ``None`` if it succeeded or hasn't run yet).
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+
+    """
+    beacons_status = None
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {
+                    "func": "status",
+                    "include_pillar": include_pillar,
+                    "include_opts": include_opts,
+                },
+                "manage_beacons",
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacons_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                log.debug("event_ret %s", event_ret)
+                if event_ret and event_ret["complete"]:
+                    beacons_status = event_ret["beacons"]
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+        return ret
+
+    if return_yaml:
+        tmp = {"beacons": beacons_status}
+        return salt.utils.yaml.safe_dump(tmp, default_flow_style=False)
+    else:
+        return beacons_status
+
+
