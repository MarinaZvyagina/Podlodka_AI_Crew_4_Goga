+@pytest.mark.slow_test
+def test_status():
+    """
+    Test getting the last-run status of configured beacons.
+    """
+    event_returns = [
+        {
+            "complete": True,
+            "tag": "/salt/minion/minion_beacons_status_complete",
+            "beacons": {
+                "ps": {"last_run": None, "last_error": None},
+                "inotify": {
+                    "last_run": "2026-09-14T10:15:23.123456",
+                    "last_error": "No such file or directory",
+                },
+            },
+        },
+    ]
+
+    mock = MagicMock(return_value=True)
+    with patch.dict(beacons.__salt__, {"event.fire": mock}):
+        with patch.object(SaltEvent, "get_event", side_effect=event_returns):
+            ret = beacons.status(return_yaml=False)
+
+    assert ret == {
+        "ps": {"last_run": None, "last_error": None},
+        "inotify": {
+            "last_run": "2026-09-14T10:15:23.123456",
+            "last_error": "No such file or directory",
+        },
