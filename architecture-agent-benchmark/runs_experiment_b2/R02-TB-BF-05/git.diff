+    def list_beacons_status(self):
+        """
+        Return, for every currently configured beacon, the last time it
+        actually fired and whether that run raised an error.
+
+        Beacons that are configured but have never fired (for example
+        because they are interval-gated and the interval hasn't elapsed
+        yet) are reported with ``has_run: False`` rather than being
+        omitted or given a made-up timestamp.
+        """
+        beacons = self._get_beacons()
+        status = {}
+        for name in beacons:
+            if name == "enabled":
+                continue
+            last = self.beacon_status.get(name)
+            if last is None:
+                status[name] = {
+                    "has_run": False,
+                    "last_run_time": None,
+                    "last_error": None,
+                }
+            else:
+                status[name] = {
+                    "has_run": True,
+                    "last_run_time": last["last_run_time"],
+                    "last_error": last["last_error"],
+                }
+
+        # Fire the complete event back along with the beacon status
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacon_status": status},
+                tag="/salt/minion/minion_beacons_status_complete",
+            )
+
+        return True
