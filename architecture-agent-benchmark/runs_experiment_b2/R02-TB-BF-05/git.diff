+def list_status(time_fmt="%Y-%m-%dT%H:%M:%S", return_yaml=True, **kwargs):
+    """
+    Show, for each beacon currently configured on the minion, the last time
+    it actually fired and whether that run raised an error.
+
+    This is answered from the running minion's live beacon state, the same
+    state that is updated the instant a beacon fires. It never waits for a
+    new beacon loop, reads log files, or requires restarting the minion.
+    Beacons that have not fired yet are reported with ``has_run: False``
+    instead of a stale or fabricated timestamp.
+
+    :param time_fmt:        The strftime format used to render last_run_time,
+                            defaults to ISO 8601 (``%Y-%m-%dT%H:%M:%S``).
+
+    :param return_yaml:    Whether to return YAML formatted output,
+                           default ``True``
+
+    :return:               Per-beacon status: ``has_run``, ``last_run_time``,
+                           and ``last_error``.
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.list_status
+
+    """
+    beacon_status = None
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"]({"func": "list_status"}, "manage_beacons")
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacons_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                log.debug("event_ret %s", event_ret)
+                if event_ret and event_ret["complete"]:
+                    beacon_status = event_ret["beacon_status"]
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+        return ret
+
+    if beacon_status:
+        for status in beacon_status.values():
+            if status.get("last_run_time") is not None:
+                status["last_run_time"] = datetime.datetime.fromtimestamp(
+                    status["last_run_time"]
+                ).strftime(time_fmt)
+
+    if return_yaml:
+        tmp = {"beacons": beacon_status}
+        return salt.utils.yaml.safe_dump(tmp, default_flow_style=False)
+    else:
+        return beacon_status
+
+
