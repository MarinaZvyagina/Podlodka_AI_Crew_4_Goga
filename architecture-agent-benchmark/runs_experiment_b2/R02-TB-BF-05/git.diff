+@pytest.mark.slow_test
+def test_list_status():
+    """
+    Test listing beacon status returns per-beacon last run time and error,
+    with the never-run beacon called out rather than given a made-up value.
+    """
+    event_returns = [
+        {
+            "complete": True,
+            "tag": "/salt/minion/minion_beacons_status_complete",
+            "beacon_status": {
+                "ps": {
+                    "has_run": True,
+                    "last_run_time": 1577836800.0,
+                    "last_error": None,
+                },
+                "inotify": {
+                    "has_run": True,
+                    "last_run_time": 1577836801.0,
+                    "last_error": "Global Thermonuclear War",
+                },
+                "never_run": {
+                    "has_run": False,
+                    "last_run_time": None,
+                    "last_error": None,
+                },
+            },
+        }
+    ]
+
+    mock = MagicMock(return_value=True)
+    with patch.dict(beacons.__salt__, {"event.fire": mock}):
+        with patch.object(SaltEvent, "get_event", side_effect=event_returns):
+            ret = beacons.list_status(return_yaml=False)
+
+    expected_time = datetime.datetime.fromtimestamp(1577836800.0).strftime(
+        "%Y-%m-%dT%H:%M:%S"
+    )
+    assert ret["ps"]["has_run"] is True
+    assert ret["ps"]["last_error"] is None
+    assert ret["ps"]["last_run_time"] == expected_time
+
+    assert ret["inotify"]["has_run"] is True
+    assert ret["inotify"]["last_error"] == "Global Thermonuclear War"
+
+    assert ret["never_run"] == {
+        "has_run": False,
+        "last_run_time": None,
+        "last_error": None,
+    }
+
+
