+def test_beacon_status_after_successful_run(minion_opts):
+    """
+    Once a beacon has fired successfully, its status should reflect the
+    firing time with no error.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    assert "watch_apache" in beacon.status
+    assert beacon.status["watch_apache"]["last_error"] is None
+    assert isinstance(beacon.status["watch_apache"]["last_fired"], float)
+
