+    def beacon_status(self, name=None):
+        """
+        Return, for one or all currently configured beacons, the time
+        they last actually fired and whether that run raised an error.
+
+        A beacon that is configured but has not fired yet (for example
+        because its interval hasn't elapsed, or it was only just added)
+        is reported with a last-fired time of ``None`` rather than a
+        stale or guessed value.
+        """
+        beacons = self._get_beacons()
+
+        if name is not None and name not in beacons:
+            complete = False
+            comment = f"Beacon {name} is not currently configured."
+            status = {}
+        else:
+            complete = True
+            comment = ""
+            status = {}
+            for bname in beacons:
+                if bname == "enabled":
+                    continue
+                if name is not None and bname != name:
+                    continue
+                entry = self.status.get(bname)
+                if entry is None:
+                    status[bname] = {"last_fired": None, "last_error": None}
+                else:
+                    status[bname] = dict(entry)
+
+        # Fire the complete event back along with the beacon status
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {
+                    "complete": complete,
+                    "comment": comment,
+                    "beacon_status": status,
+                },
+                tag="/salt/minion/minion_beacon_status_complete",
+            )
+
+        return True
+
