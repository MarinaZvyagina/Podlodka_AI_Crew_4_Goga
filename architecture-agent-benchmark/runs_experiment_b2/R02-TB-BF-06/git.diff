+
+            minion.module_refresh()
+            assert hasattr(minion.beacons, "status")
+
+            test_status = {"ps": {"last_fired": 12345.6, "last_error": None}}
+            minion.beacons.status = test_status.copy()
+
+            minion.beacons_refresh()
+
+            assert minion.beacons.status == test_status
+
+        finally:
+            if minion is not None:
+                minion.destroy()
