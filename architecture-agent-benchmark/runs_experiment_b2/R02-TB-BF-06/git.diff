+@pytest.mark.slow_test
+def test_status():
+    """
+    Test getting the last-fired/error status of all configured beacons.
+    """
+    event_returns = [
+        {
+            "complete": True,
+            "tag": "/salt/minion/minion_beacon_status_complete",
+            "beacon_status": {
+                "ps": {"last_fired": 12345.6, "last_error": None},
+                "inotify": {"last_fired": None, "last_error": None},
+            },
+        },
+    ]
+
+    mock = MagicMock(return_value=True)
+    with patch.dict(beacons.__salt__, {"event.fire": mock}):
+        with patch.object(SaltEvent, "get_event", side_effect=event_returns):
+            ret = beacons.status()
+            assert ret["result"] is True
+            assert ret["beacons"] == {
+                "ps": {"last_fired": 12345.6, "last_error": None},
+                "inotify": {"last_fired": None, "last_error": None},
+            }
+
+
+@pytest.mark.slow_test
+def test_status_unknown_beacon():
+    """
+    Test that asking for the status of an unconfigured beacon surfaces
+    the minion's comment rather than fabricating a result.
+    """
+    event_returns = [
+        {
+            "complete": False,
+            "comment": "Beacon bogus is not currently configured.",
+            "tag": "/salt/minion/minion_beacon_status_complete",
+            "beacon_status": {},
+        },
+    ]
+
+    mock = MagicMock(return_value=True)
+    with patch.dict(beacons.__salt__, {"event.fire": mock}):
+        with patch.object(SaltEvent, "get_event", side_effect=event_returns):
+            ret = beacons.status("bogus")
+            assert ret["result"] is False
+            assert ret["comment"] == "Beacon bogus is not currently configured."
+
+
