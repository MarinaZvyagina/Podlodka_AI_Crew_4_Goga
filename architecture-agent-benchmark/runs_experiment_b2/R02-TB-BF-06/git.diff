+def status(name=None, **kwargs):
+    """
+    Return the last-run status of the minion's beacons: when each
+    configured beacon last actually fired, and whether that run raised
+    an error. This reflects live in-memory state from the running
+    minion, so it is current as of the moment it's asked, not a value
+    from the next scheduled beacon loop or from log files.
+
+    A beacon that hasn't fired yet (for example because its interval
+    hasn't elapsed) is reported with ``last_fired`` set to ``None``.
+
+    :param name:    Optional name of a single configured beacon to
+                     check. If not given, status is returned for every
+                     currently configured beacon.
+    :return:         Dict with ``result``, ``comment``, and (on
+                     success) ``beacons``: a mapping of beacon name to
+                     ``{"last_fired": <epoch time or None>, "last_error": <str or None>}``.
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+
+        salt '*' beacons.status ps
+    """
+    ret = {"comment": [], "result": True}
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {"func": "status", "name": name}, "manage_beacons"
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacon_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                if event_ret and event_ret["complete"]:
+                    ret["result"] = True
+                    ret["beacons"] = event_ret["beacon_status"]
+                elif event_ret:
+                    ret["result"] = False
+                    ret["comment"] = event_ret["comment"]
+                else:
+                    ret["result"] = False
+                    ret["comment"] = (
+                        "Did not receive the beacon status complete event before"
+                        " the timeout of {}s".format(
+                            kwargs.get("timeout", default_event_wait)
+                        )
+                    )
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+    return ret
+
+
