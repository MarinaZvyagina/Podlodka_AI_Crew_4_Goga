+def test_beacon_status_never_fired(minion_opts):
+    """
+    A beacon that is configured but hasn't fired yet must be reported
+    with a last_fired of None instead of a stale/made-up value.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "ps": [{"processes": {"apache2": "stopped"}}],
+    }
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+
+    fired = {}
+    fake_evt = MagicMock()
+    fake_evt.fire_event = MagicMock(side_effect=lambda data, tag: fired.update(data))
+    fake_evt.__enter__ = MagicMock(return_value=fake_evt)
+    fake_evt.__exit__ = MagicMock(return_value=False)
+
+    with patch("salt.utils.event.get_event", MagicMock(return_value=fake_evt)):
+        beacon.beacon_status()
+
+    assert fired["complete"] is True
+    assert fired["beacon_status"] == {"ps": {"last_fired": None, "last_error": None}}
+
