@@ -0,0 +1,247 @@
+"""
+Cache data in a local SQLite3 database file.
+
+.. versionadded:: 3009.0
+
+The ``sqlite3`` cache module stores the minion data cache (grains, mine
+data, job returns, etc.) in a single SQLite database file on disk, using
+only the :py:mod:`sqlite3` module from the Python standard library. Unlike
+the ``redis``, ``mysql``, ``etcd``, and ``consul`` cache drivers, there is no
+separate service to install, configure, or operate -- the database is just a
+file under :conf_master:`cachedir`. Unlike ``localfs`` (one file per cache
+entry), all cached data lives in a single file, but it is written and read
+the same way: on the local disk, so data stored before a master restart is
+still there afterwards.
+
+To use it, set the master ``cache`` config value to ``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+The database file is created automatically, the first time it is needed, at
+``<cachedir>/cache.sqlite3``.
+"""
+
+import logging
+import os
+import threading
+
+import salt.payload
+import salt.syspaths
+import salt.utils.path
+from salt.exceptions import SaltCacheError
+
+try:
+    import sqlite3
+
+    HAS_SQLITE3 = True
+except ImportError:
+    HAS_SQLITE3 = False
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+_DB_FILENAME = "cache.sqlite3"
+_BUSY_TIMEOUT_MS = 5000
+
+# (db_path, pid) -> (sqlite3.Connection, threading.Lock)
+#
+# Keyed on pid as well as path so that a forked master worker never reuses a
+# sqlite3.Connection opened by its parent before the fork -- sqlite3
+# connections are not safe to share across processes.
+_connections = {}
+_connections_lock = threading.Lock()
+
+
+def __virtual__():
+    """
+    Confirm that the Python standard library was built with sqlite3 support.
+    """
+    if not HAS_SQLITE3:
+        return (
+            False,
+            "The sqlite3 cache driver requires a Python built with sqlite3 support.",
+        )
+    return __virtualname__
+
+
+def __cachedir(kwargs=None):
+    if kwargs and "cachedir" in kwargs:
+        return kwargs["cachedir"]
+    return __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+
+
+def init_kwargs(kwargs):
+    return {"cachedir": __cachedir(kwargs)}
+
+
+def get_storage_id(kwargs):
+    return ("sqlite3", _db_path(__cachedir(kwargs)))
+
+
+def _db_path(cachedir):
+    return salt.utils.path.join(cachedir, _DB_FILENAME)
+
+
+def _connect(db_path):
+    conn = sqlite3.connect(db_path, check_same_thread=False, isolation_level=None)
+    conn.execute(f"PRAGMA busy_timeout = {_BUSY_TIMEOUT_MS}")
+    # WAL lets one writer and multiple readers -- e.g. several master worker
+    # processes -- use the database file at the same time.
+    conn.execute("PRAGMA journal_mode = WAL")
+    conn.execute("PRAGMA synchronous = NORMAL")
+    conn.execute(
+        """
+        CREATE TABLE IF NOT EXISTS salt_cache (
+            bank TEXT NOT NULL,
+            ckey TEXT NOT NULL,
+            data BLOB,
+            last_update INTEGER NOT NULL,
+            PRIMARY KEY (bank, ckey)
+        )
+        """
+    )
+    return conn
+
+
+def _get_conn(cachedir):
+    """
+    Return the (connection, lock) pair for this process' database file,
+    opening and initializing it on first use.
+    """
+    try:
+        os.makedirs(cachedir, exist_ok=True)
+    except OSError as exc:
+        raise SaltCacheError(
+            f"The cache directory, {cachedir}, could not be created: {exc}"
+        )
+
+    db_path = _db_path(cachedir)
+    cache_key = (db_path, os.getpid())
+    with _connections_lock:
+        entry = _connections.get(cache_key)
+        if entry is None:
+            try:
+                conn = _connect(db_path)
+            except sqlite3.Error as exc:
+                raise SaltCacheError(
+                    f'There was an error opening the sqlite3 cache database "{db_path}": {exc}'
+                )
+            entry = (conn, threading.Lock())
+            _connections[cache_key] = entry
+        return entry
+
+
+def store(bank, key, data, cachedir):
+    """
+    Store a key value.
+    """
+    conn, lock = _get_conn(cachedir)
+    raw = salt.payload.dumps(data)
+    with lock:
+        try:
+            conn.execute(
+                "INSERT OR REPLACE INTO salt_cache"
+                " (bank, ckey, data, last_update)"
+                " VALUES (?, ?, ?, strftime('%s', 'now'))",
+                (bank, key, raw),
+            )
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"There was an error storing {bank}/{key}: {exc}")
+
+
+def fetch(bank, key, cachedir):
+    """
+    Fetch a key value.
+    """
+    conn, lock = _get_conn(cachedir)
+    with lock:
+        try:
+            row = conn.execute(
+                "SELECT data FROM salt_cache WHERE bank = ? AND ckey = ?", (bank, key)
+            ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"There was an error fetching {bank}/{key}: {exc}")
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key, cachedir):
+    """
+    Return the integer Unix epoch of the last write to this key, or None if
+    it does not exist.
+    """
+    conn, lock = _get_conn(cachedir)
+    with lock:
+        try:
+            row = conn.execute(
+                "SELECT last_update FROM salt_cache WHERE bank = ? AND ckey = ?",
+                (bank, key),
+            ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f"There was an error reading the update time for {bank}/{key}: {exc}"
+            )
+    return int(row[0]) if row else None
+
+
+def flush(bank, key=None, cachedir=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key
+    is specified, remove the entire bank.
+    """
+    if cachedir is None:
+        cachedir = __cachedir()
+    conn, lock = _get_conn(cachedir)
+    with lock:
+        try:
+            if key is None:
+                cur = conn.execute("DELETE FROM salt_cache WHERE bank = ?", (bank,))
+            else:
+                cur = conn.execute(
+                    "DELETE FROM salt_cache WHERE bank = ? AND ckey = ?", (bank, key)
+                )
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"There was an error removing {bank}/{key}: {exc}")
+    return cur.rowcount > 0
+
+
+def list_(bank, cachedir):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank.
+    """
+    conn, lock = _get_conn(cachedir)
+    with lock:
+        try:
+            rows = conn.execute(
+                "SELECT ckey FROM salt_cache WHERE bank = ?", (bank,)
+            ).fetchall()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f'There was an error listing bank "{bank}": {exc}')
+    return [row[0] for row in rows]
+
+
+def contains(bank, key, cachedir):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    conn, lock = _get_conn(cachedir)
+    with lock:
+        try:
+            if key is None:
+                row = conn.execute(
+                    "SELECT 1 FROM salt_cache WHERE bank = ? LIMIT 1", (bank,)
+                ).fetchone()
+            else:
+                row = conn.execute(
+                    "SELECT 1 FROM salt_cache WHERE bank = ? AND ckey = ? LIMIT 1",
+                    (bank, key),
+                ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"There was an error checking {bank}/{key}: {exc}")
+    return row is not None
