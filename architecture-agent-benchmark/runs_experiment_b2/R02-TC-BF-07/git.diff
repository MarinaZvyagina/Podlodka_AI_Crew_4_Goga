@@ -0,0 +1,99 @@
+"""
+unit tests for the sqlite3_cache cache
+"""
+
+import os
+
+import pytest
+
+import salt.cache.sqlite3_cache as sqlite3_cache
+from salt.exceptions import SaltCacheError
+from tests.support.mock import patch
+
+
+@pytest.fixture
+def cachedir(tmp_path):
+    return str(tmp_path / "sqlite3-cache")
+
+
+@pytest.fixture
+def configure_loader_modules(cachedir):
+    return {sqlite3_cache: {"__opts__": {"cachedir": cachedir}}}
+
+
+def test_virtual():
+    assert sqlite3_cache.__virtual__() == "sqlite3"
+
+
+def test_init_kwargs_and_storage_id(cachedir):
+    kwargs = sqlite3_cache.init_kwargs({"cachedir": cachedir})
+    assert kwargs == {"cachedir": cachedir}
+    assert sqlite3_cache.get_storage_id(kwargs) == (
+        "sqlite3",
+        os.path.join(cachedir, "cache.sqlite3"),
+    )
+
+
+def test_store_creates_database_file(cachedir):
+    assert not os.path.exists(os.path.join(cachedir, "cache.sqlite3"))
+    sqlite3_cache.store("bank", "key", {"a": 1}, cachedir=cachedir)
+    assert os.path.exists(os.path.join(cachedir, "cache.sqlite3"))
+
+
+def test_data_survives_new_connection(cachedir):
+    """
+    Data written through one connection must be readable through a brand
+    new connection -- the scenario exercised when the master process (and
+    hence the module-level state) restarts.
+    """
+    sqlite3_cache.store("minions/alpha", "data", {"grains": {"os": "Linux"}}, cachedir=cachedir)
+    fetched = sqlite3_cache.fetch("minions/alpha", "data", cachedir=cachedir)
+    assert fetched == {"grains": {"os": "Linux"}}
+
+
+def test_list_returns_keys_and_sub_banks(cachedir):
+    sqlite3_cache.store("minions", "alpha", {"a": 1}, cachedir=cachedir)
+    sqlite3_cache.store("minions/beta", "data", {"b": 2}, cachedir=cachedir)
+    assert set(sqlite3_cache.list_("minions", cachedir=cachedir)) == {"alpha", "beta"}
+
+
+def test_list_all(cachedir):
+    sqlite3_cache.store("bank", "k1", {"v": 1}, cachedir=cachedir)
+    sqlite3_cache.store("bank", "k2", {"v": 2}, cachedir=cachedir)
+    assert sqlite3_cache.list_all("bank", cachedir=cachedir, include_data=True) == {
+        "k1": {"v": 1},
+        "k2": {"v": 2},
+    }
+    assert sqlite3_cache.list_all("bank", cachedir=cachedir, include_data=False) == {
+        "k1": {},
+        "k2": {},
+    }
+
+
+def test_flush_bank_removes_sub_banks(cachedir):
+    sqlite3_cache.store("minions", "alpha", {"a": 1}, cachedir=cachedir)
+    sqlite3_cache.store("minions/beta", "data", {"b": 2}, cachedir=cachedir)
+    assert sqlite3_cache.flush("minions", cachedir=cachedir) is True
+    assert sqlite3_cache.list_("minions", cachedir=cachedir) == []
+    assert sqlite3_cache.fetch("minions/beta", "data", cachedir=cachedir) == {}
+
+
+def test_custom_database_path(tmp_path, cachedir):
+    custom_path = str(tmp_path / "custom" / "salt.db")
+    with patch.dict(sqlite3_cache.__opts__, {"sqlite3.database": custom_path}):
+        sqlite3_cache.store("bank", "key", {"a": 1}, cachedir=cachedir)
+    assert os.path.exists(custom_path)
+    # The default cachedir-relative path must be untouched.
+    assert not os.path.exists(os.path.join(cachedir, "cache.sqlite3"))
+
+
+def test_updated_missing_key_returns_none(cachedir):
+    assert sqlite3_cache.updated("bank", "missing", cachedir=cachedir) is None
+
+
+def test_corrupt_database_raises_saltcacheerror(cachedir):
+    os.makedirs(cachedir)
+    with open(os.path.join(cachedir, "cache.sqlite3"), "w") as fh_:
+        fh_.write("not a sqlite database")
+    with pytest.raises(SaltCacheError):
+        sqlite3_cache.store("bank", "key", {"a": 1}, cachedir=cachedir)
