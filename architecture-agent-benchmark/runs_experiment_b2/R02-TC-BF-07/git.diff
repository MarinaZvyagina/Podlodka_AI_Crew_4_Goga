+"Cache::SQLite3Backend()":
+  location: sqlite3_cache.py
+  annotations: |
+    Opt-in cache backend driver (master config option cache set to sqlite3) storing bank/key
+    entries as rows in one SQLite database file under cachedir, using only the Python standard
+    library's sqlite3 module. Gives single-node masters durable, restart-surviving cache
+    storage — the same guarantee `LocalFSBackend` provides — without requiring a separate
+    database service. Deployments that do not opt in are unaffected; localfs remains the
+    default.
+  methods:
+    "store(bank: str, key: str, data: object, cachedir: str)": |
+      Serialize `data` and upsert the row keyed by (`bank`, `key`) into the on-disk SQLite
+      database (cachedir/cache.sqlite3 by default, overridable via master config), committing
+      immediately so the write survives a master restart.
+    "fetch(bank: str, key: str, cachedir: str) -> data:object": |
+      Read and deserialize the row for `bank`/`key`, or an empty value if it doesn't exist.
+    "flush(bank: str, key: str | None, cachedir: str | None)": |
+      Delete the row for `key` in `bank`, or every row under `bank` (including sub-banks) if
+      `key` is omitted.
+    "list(bank: str, cachedir: str) -> keys:list[str]": |
+      List the keys stored directly in `bank`, plus the names of its immediate sub-banks.
+
 ---
 
