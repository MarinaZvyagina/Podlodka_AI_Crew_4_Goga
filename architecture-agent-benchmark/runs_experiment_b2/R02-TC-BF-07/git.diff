@@ -0,0 +1,328 @@
+"""
+Minion data cache plugin for SQLite3.
+
+.. versionadded:: 3009.0
+
+Unlike the ``mysql``, ``redis``, ``consul`` and ``etcd``/``etcd3`` cache
+plugins, this backend needs nothing beyond a standard Python installation:
+the :mod:`sqlite3 <python:sqlite3>` module is part of the Python standard
+library, and the "server" is a single ordinary file on disk. This makes it a
+good fit for small, single-node masters that want the cached minion data
+(grains, mine data, job returns, and the like) to survive a master restart
+without standing up a separate database service.
+
+To use sqlite3 as the minion data cache backend, set the master ``cache``
+config value to ``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+By default the database file is created at ``<cachedir>/cache.sqlite3``
+(``/var/cache/salt/master/cache.sqlite3`` on most platforms). The location,
+and a couple of other knobs, can be overridden in the master config. These
+are the defaults:
+
+.. code-block:: yaml
+
+    sqlite3.database: <cachedir>/cache.sqlite3
+    sqlite3.table_name: cache
+    sqlite3.timeout: 5.0
+
+.. warning::
+
+    ``sqlite3.table_name`` is interpolated directly into the SQL statements
+    issued by this module. Salt treats it as trusted input, exactly as the
+    ``mysql`` cache plugin does with ``mysql.table_name``.
+
+The database is opened in `WAL <https://sqlite.org/wal.html>`_ mode, which
+lets the several worker processes a Salt master runs concurrently read and
+write the same file safely. Each entry is written with an immediate
+``COMMIT``, so previously cached data is available again after the master
+process (and machine) restarts.
+"""
+
+import logging
+import os
+import time
+
+try:
+    import sqlite3
+
+    HAS_SQLITE3 = True
+except ImportError:
+    HAS_SQLITE3 = False
+
+import salt.payload
+import salt.syspaths
+import salt.utils.path
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+_DEFAULT_TABLE_NAME = "cache"
+_DEFAULT_TIMEOUT = 5.0
+
+
+def __virtual__():
+    """
+    Confirm that the sqlite3 module (part of the Python standard library) is
+    available. Some minimal/embedded Python builds are compiled without it.
+    """
+    if not HAS_SQLITE3:
+        return (False, "The Python sqlite3 module is not available.")
+    return __virtualname__
+
+
+def __cachedir(kwargs=None):
+    if kwargs and "cachedir" in kwargs:
+        return kwargs["cachedir"]
+    return __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+
+
+def init_kwargs(kwargs):
+    """
+    Return the canonical keyword arguments for this cache driver.
+    """
+    return {"cachedir": __cachedir(kwargs)}
+
+
+def get_storage_id(kwargs):
+    """
+    Return a unique identifier for this cache driver instance, used by
+    MemCache to key its in-process storage.
+    """
+    return ("sqlite3", _db_path(__cachedir(kwargs)))
+
+
+def _db_path(cachedir=None):
+    configured = __opts__.get("sqlite3.database")
+    if configured:
+        return configured
+    if cachedir is None:
+        cachedir = __cachedir()
+    return salt.utils.path.join(cachedir, "cache.sqlite3")
+
+
+def _table_name():
+    return __opts__.get("sqlite3.table_name", _DEFAULT_TABLE_NAME)
+
+
+def _connect(cachedir=None):
+    """
+    Open a fresh connection to the cache database, creating the database
+    file, directory and schema on first use.
+    """
+    path = _db_path(cachedir)
+    dirname = os.path.dirname(path)
+    if dirname and not os.path.isdir(dirname):
+        try:
+            os.makedirs(dirname, exist_ok=True)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"The sqlite3 cache directory, {dirname}, could not be created: {exc}"
+            )
+
+    timeout = __opts__.get("sqlite3.timeout", _DEFAULT_TIMEOUT)
+    table = _table_name()
+    try:
+        # isolation_level=None puts the connection in autocommit mode, so
+        # every statement below is durable on disk as soon as it returns.
+        conn = sqlite3.connect(path, timeout=timeout, isolation_level=None)
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute("PRAGMA synchronous=NORMAL")
+        conn.execute(
+            f"CREATE TABLE IF NOT EXISTS {table} ("
+            "bank TEXT NOT NULL, "
+            "cache_key TEXT NOT NULL, "
+            "data BLOB, "
+            "last_update INTEGER NOT NULL, "
+            "PRIMARY KEY (bank, cache_key))"
+        )
+        conn.execute(f"CREATE INDEX IF NOT EXISTS {table}_bank_idx ON {table} (bank)")
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f'There was an error opening the sqlite3 cache database "{path}": {exc}'
+        )
+    return conn
+
+
+def _escape_like(value):
+    """
+    Escape LIKE metacharacters in *value* so it can be safely used with the
+    ``ESCAPE '\\'`` clause.
+    """
+    return value.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+
+
+def store(bank, key, data, cachedir=None):
+    """
+    Store a key value.
+    """
+    table = _table_name()
+    conn = _connect(cachedir)
+    try:
+        conn.execute(
+            f"INSERT INTO {table} (bank, cache_key, data, last_update) "
+            "VALUES (?, ?, ?, ?) "
+            "ON CONFLICT (bank, cache_key) DO UPDATE SET "
+            "data=excluded.data, last_update=excluded.last_update",
+            (bank, key, salt.payload.dumps(data), int(time.time())),
+        )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"There was an error storing the sqlite3 cache entry {bank}/{key}: {exc}"
+        )
+    finally:
+        conn.close()
+
+
+def fetch(bank, key, cachedir=None):
+    """
+    Fetch a key value.
+    """
+    table = _table_name()
+    conn = _connect(cachedir)
+    try:
+        cur = conn.execute(
+            f"SELECT data FROM {table} WHERE bank = ? AND cache_key = ?", (bank, key)
+        )
+        row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"There was an error fetching the sqlite3 cache entry {bank}/{key}: {exc}"
+        )
+    finally:
+        conn.close()
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key, cachedir=None):
+    """
+    Return the Unix Epoch timestamp of when the key was last updated. Return
+    None if the key is not found.
+    """
+    table = _table_name()
+    conn = _connect(cachedir)
+    try:
+        cur = conn.execute(
+            f"SELECT last_update FROM {table} WHERE bank = ? AND cache_key = ?",
+            (bank, key),
+        )
+        row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"There was an error reading the sqlite3 cache entry {bank}/{key}: {exc}"
+        )
+    finally:
+        conn.close()
+    return int(row[0]) if row else None
+
+
+def flush(bank, key=None, cachedir=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key is
+    specified, remove the entire bank with all keys and sub-banks inside.
+    """
+    table = _table_name()
+    conn = _connect(cachedir)
+    try:
+        if key is None:
+            prefix = f"{bank}/" if bank else ""
+            cur = conn.execute(
+                f"DELETE FROM {table} WHERE bank = ? OR bank LIKE ? ESCAPE '\\'",
+                (bank, _escape_like(prefix) + "%"),
+            )
+        else:
+            cur = conn.execute(
+                f"DELETE FROM {table} WHERE bank = ? AND cache_key = ?", (bank, key)
+            )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f'There was an error removing "{bank}/{key}": {exc}')
+    finally:
+        conn.close()
+    return cur.rowcount > 0
+
+
+def list_(bank, cachedir=None):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank: the keys stored directly in it, plus the names of any immediate
+    sub-banks.
+    """
+    table = _table_name()
+    conn = _connect(cachedir)
+    try:
+        cur = conn.execute(f"SELECT cache_key FROM {table} WHERE bank = ?", (bank,))
+        names = {row[0] for row in cur.fetchall()}
+
+        prefix = f"{bank}/" if bank else ""
+        cur = conn.execute(
+            f"SELECT DISTINCT bank FROM {table} WHERE bank LIKE ? ESCAPE '\\' "
+            "AND bank != ?",
+            (_escape_like(prefix) + "%", bank),
+        )
+        for (sub_bank,) in cur.fetchall():
+            names.add(sub_bank[len(prefix) :].split("/", 1)[0])
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f'There was an error listing the bank "{bank}": {exc}')
+    finally:
+        conn.close()
+    return list(names)
+
+
+def list_all(bank, cachedir=None, include_data=False):
+    """
+    Return all entries with their data from the specified bank in a single
+    pass. Returns a dict of ``{key: data}``. If ``include_data`` is False,
+    the value for every key is ``{}``, avoiding the cost of deserialising
+    every row.
+    """
+    table = _table_name()
+    conn = _connect(cachedir)
+    try:
+        if include_data:
+            cur = conn.execute(
+                f"SELECT cache_key, data FROM {table} WHERE bank = ?", (bank,)
+            )
+            return {row[0]: salt.payload.loads(row[1]) for row in cur.fetchall()}
+        cur = conn.execute(f"SELECT cache_key FROM {table} WHERE bank = ?", (bank,))
+        return {row[0]: {} for row in cur.fetchall()}
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f'There was an error listing the bank "{bank}": {exc}')
+    finally:
+        conn.close()
+
+
+def contains(bank, key=None, cachedir=None):
+    """
+    Checks if the specified bank contains the specified key. If key is None,
+    checks for the bank's existence (including as a namespace of sub-banks).
+    """
+    table = _table_name()
+    conn = _connect(cachedir)
+    try:
+        if key is None:
+            prefix = f"{bank}/" if bank else ""
+            cur = conn.execute(
+                f"SELECT 1 FROM {table} WHERE bank = ? OR bank LIKE ? ESCAPE '\\' "
+                "LIMIT 1",
+                (bank, _escape_like(prefix) + "%"),
+            )
+        else:
+            cur = conn.execute(
+                f"SELECT 1 FROM {table} WHERE bank = ? AND cache_key = ? LIMIT 1",
+                (bank, key),
+            )
+        return cur.fetchone() is not None
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f'There was an error checking "{bank}/{key}" for existence: {exc}'
+        )
+    finally:
+        conn.close()
