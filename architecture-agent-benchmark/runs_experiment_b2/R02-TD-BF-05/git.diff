@@ -87,6 +87,12 @@ def usage(args=None):
 
         Default for SunOS changed to 1 kilobyte blocks
 
+    The result of each distinct set of ``args`` is cached in ``__context__``
+    for the duration of the current Salt run, so repeated calls with the
+    same arguments (e.g. checking free space before and after some other
+    action) don't re-invoke ``df`` and re-parse its output. The cache does
+    not persist across separate Salt runs.
+
     CLI Example:
 
     .. code-block:: bash
@@ -113,6 +119,11 @@ def usage(args=None):
         cmd = "df"
     if flags:
         cmd += f" -{flags}"
+
+    cache = __context__.setdefault("disk.usage", {})
+    if cmd in cache:
+        return cache[cmd]
+
     ret = {}
     out = __salt__["cmd.run"](cmd, python_shell=False).splitlines()
     oldline = None
@@ -157,6 +168,7 @@ def usage(args=None):
         except IndexError:
             log.error("Problem parsing disk usage information")
             ret = {}
+    cache[cmd] = ret
     return ret
 
 
diff --git a/tests/pytests/unit/modules/test_disk.py b/tests/pytests/unit/modules/test_disk.py
index 11b2170..eeb82d1 100644
--- a/tests/pytests/unit/modules/test_disk.py
+++ b/tests/pytests/unit/modules/test_disk.py
@@ -162,6 +162,50 @@ def test_usage_none():
             assert "" == disk.usage(args=None)
 
 
+def test_usage_caches_within_context():
+    """
+    disk.usage should only shell out to df once per distinct set of args
+    for the life of the __context__ dict (a single Salt run), and reuse
+    the cached result on subsequent calls.
+    """
+    df_output = (
+        "Filesystem     1024-blocks     Used Available Capacity Mounted on\n"
+        "/dev/sda1          10000     5000      5000      50% /"
+    )
+    mock_cmd = MagicMock(return_value=df_output)
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch.dict(
+        disk.__salt__, {"cmd.run": mock_cmd}
+    ), patch("os.path.isfile", MagicMock(return_value=True)), patch.dict(
+        disk.__context__, {}, clear=True
+    ):
+        first = disk.usage()
+        second = disk.usage()
+
+    assert first == second
+    mock_cmd.assert_called_once()
+
+
+def test_usage_does_not_leak_across_context():
+    """
+    Different __context__ dicts (i.e. separate Salt runs) must not share
+    cached results, and different args must not share a cache entry.
+    """
+    df_output = (
+        "Filesystem     1024-blocks     Used Available Capacity Mounted on\n"
+        "/dev/sda1          10000     5000      5000      50% /"
+    )
+    mock_cmd = MagicMock(return_value=df_output)
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch.dict(
+        disk.__salt__, {"cmd.run": mock_cmd}
+    ), patch("os.path.isfile", MagicMock(return_value=True)):
+        with patch.dict(disk.__context__, {}, clear=True):
+            disk.usage()
+        with patch.dict(disk.__context__, {}, clear=True):
+            disk.usage()
+
+    assert mock_cmd.call_count == 2
+
+
