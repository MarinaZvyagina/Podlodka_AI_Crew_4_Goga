+def test_usage_caches_within_context():
+    """
+    Repeated disk.usage() calls with the same args should only shell out
+    to df once per Salt run (i.e. per __context__ lifetime).
+    """
+    df_output = (
+        "Filesystem     1K-blocks     Used Available Use% Mounted on\n"
+        "/dev/sda1       10000000  5000000   5000000  50% /"
+    )
+    mock_cmd = MagicMock(return_value=df_output)
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch.dict(
+        disk.__salt__, {"cmd.run": mock_cmd}
+    ), patch("os.path.isfile", MagicMock(return_value=True)):
+        first = disk.usage()
+        second = disk.usage()
+        assert first == second
+        mock_cmd.assert_called_once()
+
+
+def test_usage_cache_is_keyed_by_flags():
+    """
+    Different flags must not share a cache entry.
+    """
+    df_output = (
+        "Filesystem     1K-blocks     Used Available Use% Mounted on\n"
+        "/dev/sda1       10000000  5000000   5000000  50% /"
+    )
+    mock_cmd = MagicMock(return_value=df_output)
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch.dict(
+        disk.__salt__, {"cmd.run": mock_cmd}
+    ), patch("os.path.isfile", MagicMock(return_value=True)):
+        disk.usage()
+        disk.usage(args="h")
+        assert mock_cmd.call_count == 2
+
+
+def test_usage_cache_does_not_persist_across_runs():
+    """
+    A fresh __context__ (a new, independent Salt run) must not see
+    another run's cached result.
+    """
+    df_output = (
+        "Filesystem     1K-blocks     Used Available Use% Mounted on\n"
+        "/dev/sda1       10000000  5000000   5000000  50% /"
+    )
+    mock_cmd = MagicMock(return_value=df_output)
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch.dict(
+        disk.__salt__, {"cmd.run": mock_cmd}
+    ), patch("os.path.isfile", MagicMock(return_value=True)):
+        disk.usage()
+        disk.__context__.clear()
+        disk.usage()
+        assert mock_cmd.call_count == 2
+
+
