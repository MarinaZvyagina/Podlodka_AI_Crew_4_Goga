diff --git a/packages/platform-ws/adapters/CODEMANIFEST b/packages/platform-ws/adapters/CODEMANIFEST
new file mode 100644
index 0000000..3aa6b51
--- /dev/null
+++ b/packages/platform-ws/adapters/CODEMANIFEST
@@ -0,0 +1,59 @@
+Imports:
+  - Types:
+      - AbstractWsAdapter
+    From: packages/websockets/adapters
+
+Annotations: |
+  Concrete AbstractWsAdapter implementation over the lighter-weight ws library, used
+  in place of socket.io when a gateway opts into it via useWebSocketAdapter. Does
+  not support namespaces.
+
+---
+
+"AbstractWsAdapter::WsAdapter(appOrHttpServer: any)":
+  location: ws-adapter.ts
+  annotations: |
+    Wraps one or more ws-library WebSocket server instances behind the
+    `AbstractWsAdapter` contract from Imports.
+
+    `appOrHttpServer`: the owning Nest application or a raw HTTP server, forwarded
+    to `AbstractWsAdapter` from Imports
+
+  methods:
+    "create(port: number, options: any) -> server: any": |
+      Create a ws-library server, either standalone on `port`, sharing the
+      adapter's HTTP server (registering an upgrade handler routed by path), or
+      reusing an externally supplied server passed inside `options`. Throws if a
+      namespace is requested inside `options`, since ws has no namespace concept.
+    "bindMessageHandlers(client: any, handlers: Array<any>, transform: any)": |
+      Parse each incoming message on `client` with the configured message parser
+      into an event/data pair, dispatch it to the matching entry in `handlers`, and
+      send the result of `transform`, once resolved, back to `client` as JSON.
+    "close(server: any) -> done: Promise<void>": |
+      Notify every client connected to `server` that it is shutting down, then
+      forcibly disconnect all of them and close `server`.
+
+      Algorithm:
+      1. Start waiting on `server`'s own close callback
+      2. For every client currently connected to `server`, send it the shutdown
+         notice as a JSON message (skipped for a client that is not currently open),
+         then immediately terminate that client's connection — ws has no built-in
+         mechanism to disconnect all clients on server close, so the adapter must do
+         it explicitly
+      3. Await the server close callback from step 1
+      Requirements:
+      - A `server` with no connected clients must close exactly as before this hook
+        existed
+    "dispose() -> done: Promise<void>": |
+      Close every shared HTTP server created for path-based routing and clear the
+      adapter's internal server registries.
+
+---
+
+Author: Goga
+CreatedAt: 16/09/26
+Description: |
+  Documents the ws platform adapter as a concrete mutation of `AbstractWsAdapter`,
+  alongside the socket.io adapter, showing how each platform package satisfies the
+  shared shutdown-notice guarantee using its own library's native mechanism: a raw
+  JSON message sent to each client before it is terminated.
