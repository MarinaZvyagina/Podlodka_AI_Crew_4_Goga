@@ -0,0 +1,66 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('close', () => {
+    function createFakeClient(readyState: number) {
+      return { readyState, send: vi.fn(), terminate: vi.fn() };
+    }
+
+    function createFakeServer(clients: any[]) {
+      return {
+        clients,
+        close: vi.fn((cb: (err?: Error) => void) => cb()),
+      };
+    }
+
+    it('should notify every open client of the shutdown before terminating it', async () => {
+      const openClient = createFakeClient(1 /* OPEN */);
+      const server = createFakeServer([openClient]);
+
+      await adapter.close(server as any);
+
+      expect(openClient.send).toHaveBeenCalledTimes(1);
+      const [payload] = openClient.send.mock.calls[0];
+      expect(JSON.parse(payload)).toEqual({
+        event: 'shutdown',
+        data: 'Server is shutting down',
+      });
+      expect(openClient.terminate).toHaveBeenCalledTimes(1);
+      const sendOrder = openClient.send.mock.invocationCallOrder[0];
+      const terminateOrder = openClient.terminate.mock.invocationCallOrder[0];
+      expect(sendOrder).toBeLessThan(terminateOrder);
+    });
+
+    it('should terminate a non-open client without sending it a message', async () => {
+      const connectingClient = createFakeClient(0 /* CONNECTING */);
+      const server = createFakeServer([connectingClient]);
+
+      await adapter.close(server as any);
+
+      expect(connectingClient.send).not.toHaveBeenCalled();
+      expect(connectingClient.terminate).toHaveBeenCalledTimes(1);
+    });
+
+    it('should close the server without error when there are no connected clients', async () => {
+      const server = createFakeServer([]);
+
+      await expect(adapter.close(server as any)).resolves.toBeUndefined();
+      expect(server.close).toHaveBeenCalledTimes(1);
+    });
+
+    it('should still close the server when it has no clients property', async () => {
+      const server = {
+        close: vi.fn((cb: (err?: Error) => void) => cb()),
+      };
+
+      await expect(adapter.close(server as any)).resolves.toBeUndefined();
+      expect(server.close).toHaveBeenCalledTimes(1);
+    });
+  });
+});
diff --git a/packages/websockets/adapters/CODEMANIFEST b/packages/websockets/adapters/CODEMANIFEST
new file mode 100644
index 0000000..05c011b
--- /dev/null
+++ b/packages/websockets/adapters/CODEMANIFEST
@@ -0,0 +1,76 @@
+Annotations: |
+  Defines Nest's WebSocket-adapter boundary: the abstract surface every WebSocket
+  platform integration (socket.io, ws, and others) must implement so the rest of the
+  framework (SocketModule, WebSocketsController) can create servers, bind
+  connect/disconnect handlers, and tear a server down without knowing which
+  underlying WebSocket library is in use.
+
+---
+
+"AbstractWsAdapter(appOrHttpServer: any)":
+  location: ws-adapter.ts
+  annotations: |
+    Abstract base class for platform WebSocket adapters. Concrete subclasses
+    (socket.io, ws, and others) wrap a specific WebSocket library behind this common
+    surface. Server creation and message-handler binding are left abstract for
+    subclasses to implement against their underlying library; connect/disconnect
+    binding and close/dispose have generic default implementations subclasses may
+    override.
+
+    `appOrHttpServer`: the owning Nest application (its underlying HTTP server is
+    reused for the WebSocket upgrade) or a raw HTTP server instance
+
+    Algorithm:
+    1. If given a Nest application instance, store its underlying native HTTP server;
+       otherwise store the argument as-is (already a raw HTTP server, or undefined)
+  properties:
+    "forceCloseConnections -> boolean": |
+      Whether the close operation should skip closing a server whose connections are
+      already being force-closed via its shared underlying HTTP server, to avoid
+      closing the same connections twice.
+  methods:
+    "create(port: number, options: any) -> server: any": |
+      Abstract. Create (or reuse, for namespaced/shared servers) the concrete
+      WebSocket server instance for the given port/options.
+    "bindClientConnect(server: any, callback: Function)": |
+      Register `callback` to run whenever a new client connects to `server`. Default
+      implementation forwards the library's own connection event.
+    "bindClientDisconnect(client: any, callback: Function)": |
+      Register `callback` to run when `client` disconnects. Default implementation
+      forwards the library's own disconnect event, preferring a one-shot listener
+      when the client supports it.
+    "bindMessageHandlers(client: any, handlers: Array<any>, transform: any)": |
+      Abstract. Wire each of `handlers` to fire when `client` sends a matching
+      message, piping the handler's result through `transform` before responding.
+    "close(server: any) -> done: Promise<void>": |
+      Stop `server` from accepting new connections and disconnect any clients still
+      connected to it.
+
+      Algorithm:
+      1. Notify every client still connected to `server` that the server is going
+         away, immediately before actually closing it, so the disconnect is
+         distinguishable on the client side from a network failure — this must
+         happen automatically for every gateway, with no per-gateway wiring
+      2. Close the underlying server
+      Requirements:
+      - A server with no connected clients, or an app with no WebSocket servers at
+        all, must close exactly as before this hook existed
+      - Notifying a client must not delay the server's own close beyond the brief,
+        bounded amount of time needed for the underlying library to actually flush
+        the notice to the network before the connection is torn down
+    "dispose() -> done: Promise<void>": |
+      Release any adapter-level resources not tied to a single server (e.g. shared
+      HTTP servers created to route multiple WebSocket servers by path). Default
+      implementation is a no-op.
+
+---
+
+Author: Goga
+CreatedAt: 16/09/26
+Description: |
+  Documents the abstract WebSocket-adapter contract that decouples the framework
+  core from any specific WebSocket library, and the shutdown-notice guarantee every
+  concrete adapter's `close` must honor: connected clients are told the server is
+  going away immediately before their connection is closed, as part of the app's
+  existing graceful-shutdown sequence, regardless of which WebSocket library backs
+  the adapter.
