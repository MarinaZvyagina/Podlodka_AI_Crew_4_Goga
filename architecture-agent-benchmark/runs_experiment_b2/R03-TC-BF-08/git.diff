+++ b/packages/core/maintenance/maintenance.decorator.ts
@@ -0,0 +1,19 @@
+import { SetMetadata } from '@nestjs/common';
+import { MAINTENANCE_METADATA } from './maintenance-metadata.constants.js';
+
+/**
+ * Marks a handler method, or every handler in a controller/gateway class, as
+ * affected by maintenance mode.
+ *
+ * When `@Maintenance()` is used at the method level, only that handler is
+ * gated by `MaintenanceModeGuard`. When used at the class level, every
+ * handler in that controller/gateway is gated — the same method/class scoping
+ * convention as `@UseGuards()`.
+ *
+ * @see [Maintenance mode](https://docs.nestjs.com/guards)
+ *
+ * @publicApi
+ */
+export function Maintenance(): MethodDecorator & ClassDecorator {
+  return SetMetadata(MAINTENANCE_METADATA, true);
+}
diff --git a/packages/core/test/maintenance/maintenance-mode.guard.spec.ts b/packages/core/test/maintenance/maintenance-mode.guard.spec.ts
new file mode 100644
index 0000000..c0a5f8f
