+++ b/packages/core/maintenance/maintenance-mode.service.ts
@@ -0,0 +1,36 @@
+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the process-local maintenance-mode flag. Toggling it is an in-process
+ * runtime action (inject this service and call `enable()`/`disable()`), not a
+ * redeploy or config change.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  /**
+   * Turn maintenance mode on. Takes effect immediately for the next call to
+   * any handler marked with `@Maintenance()`.
+   */
+  enable(): void {
+    this.enabled = true;
+  }
+
+  /**
+   * Turn maintenance mode off. Marked handlers resume normal behavior
+   * immediately.
+   */
+  disable(): void {
+    this.enabled = false;
+  }
+
+  /**
+   * Return the current on/off state.
+   */
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+}
