@@ -0,0 +1,90 @@
+import type { ExecutionContext } from '@nestjs/common';
+import { Reflector } from '../../services/reflector.service.js';
+import { Maintenance } from '../../maintenance/maintenance.decorator.js';
+import { MaintenanceModeGuard } from '../../maintenance/maintenance-mode.guard.js';
+import { MaintenanceModeService } from '../../maintenance/maintenance-mode.service.js';
+
+class AffectedController {
+  @Maintenance()
+  affectedHandler() {}
+
+  unaffectedHandler() {}
+}
+
+@Maintenance()
+class FullyAffectedGateway {
+  affectedMessageHandler() {}
+}
+
+function contextFor(
+  instance: object,
+  handler: (...args: unknown[]) => unknown,
+): ExecutionContext {
+  return {
+    getHandler: () => handler,
+    getClass: () => instance.constructor,
+  } as unknown as ExecutionContext;
+}
+
+describe('MaintenanceModeGuard', () => {
+  let maintenanceModeService: MaintenanceModeService;
+  let guard: MaintenanceModeGuard;
+  let controller: AffectedController;
+  let gateway: FullyAffectedGateway;
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(maintenanceModeService, new Reflector());
+    controller = new AffectedController();
+    gateway = new FullyAffectedGateway();
+  });
+
+  describe('when maintenance mode is off', () => {
+    it('should allow a marked handler', () => {
+      const context = contextFor(controller, controller.affectedHandler);
+      expect(guard.canActivate(context)).toBe(true);
+    });
+
+    it('should allow an unmarked handler', () => {
+      const context = contextFor(controller, controller.unaffectedHandler);
+      expect(guard.canActivate(context)).toBe(true);
+    });
+  });
+
+  describe('when maintenance mode is on', () => {
+    beforeEach(() => {
+      maintenanceModeService.enable();
+    });
+
+    it('should reject a method-level marked handler', () => {
+      const context = contextFor(controller, controller.affectedHandler);
+      expect(() => guard.canActivate(context)).toThrow(
+        'Service is currently in maintenance mode',
+      );
+    });
+
+    it('should allow an unmarked handler on an unmarked controller', () => {
+      const context = contextFor(controller, controller.unaffectedHandler);
+      expect(guard.canActivate(context)).toBe(true);
+    });
+
+    it('should reject every handler on a class-level marked gateway', () => {
+      const context = contextFor(gateway, gateway.affectedMessageHandler);
+      expect(() => guard.canActivate(context)).toThrow(
+        'Service is currently in maintenance mode',
+      );
+    });
+  });
+
+  describe('when maintenance mode is switched back off', () => {
+    it('should allow a previously-blocked handler again', () => {
+      const context = contextFor(controller, controller.affectedHandler);
+
+      maintenanceModeService.enable();
+      expect(() => guard.canActivate(context)).toThrow();
+
+      maintenanceModeService.disable();
+      expect(guard.canActivate(context)).toBe(true);
+    });
+  });
+});
