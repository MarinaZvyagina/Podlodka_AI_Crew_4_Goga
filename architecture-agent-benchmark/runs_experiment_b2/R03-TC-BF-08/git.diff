+import { Maintenance } from '../../maintenance/maintenance.decorator.js';
+import { MAINTENANCE_METADATA } from '../../maintenance/maintenance-metadata.constants.js';
+
+describe('@Maintenance', () => {
+  it('should mark a method with maintenance metadata', () => {
+    class TestController {
+      @Maintenance()
+      affectedHandler() {}
+
+      unaffectedHandler() {}
+    }
+
+    const instance = new TestController();
+    expect(
+      Reflect.getMetadata(MAINTENANCE_METADATA, instance.affectedHandler),
+    ).toBe(true);
+    expect(
+      Reflect.getMetadata(MAINTENANCE_METADATA, instance.unaffectedHandler),
+    ).toBeUndefined();
+  });
+
+  it('should mark a class with maintenance metadata', () => {
+    @Maintenance()
+    class TestController {
+      someHandler() {}
