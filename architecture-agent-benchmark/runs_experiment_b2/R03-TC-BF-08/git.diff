--- /dev/null
+++ b/packages/core/maintenance/maintenance-mode.guard.ts
@@ -0,0 +1,45 @@
+import type { CanActivate, ExecutionContext } from '@nestjs/common';
+import { Injectable, ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '../services/reflector.service.js';
+import { MAINTENANCE_METADATA } from './maintenance-metadata.constants.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * `CanActivate` implementation that rejects calls to handlers marked with
+ * `@Maintenance()` while `MaintenanceModeService` reports maintenance mode as
+ * on, before the handler's own logic runs. Unmarked handlers, and marked
+ * handlers while maintenance mode is off, are unaffected.
+ *
+ * Register it as a global guard (e.g. via the `APP_GUARD` provider token, or
+ * `app.useGlobalGuards(...)`) so it gates every request through the same
+ * guard-resolution pipeline the framework already runs for both HTTP routes
+ * and WebSocket `@SubscribeMessage()` handlers.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly maintenanceModeService: MaintenanceModeService,
+    private readonly reflector: Reflector,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    if (!this.maintenanceModeService.isEnabled()) {
+      return true;
+    }
+
+    const isMarked = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_METADATA,
+      [context.getHandler(), context.getClass()],
+    );
+
+    if (isMarked) {
+      throw new ServiceUnavailableException(
+        'Service is currently in maintenance mode',
+      );
+    }
+
+    return true;
+  }
+}
