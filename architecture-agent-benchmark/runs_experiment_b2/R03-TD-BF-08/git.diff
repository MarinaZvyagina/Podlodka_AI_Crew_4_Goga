@@ -0,0 +1,73 @@
+import { REQUEST_ID_HEADER } from '../../request-id/request-id.constants.js';
+import { getRequestId } from '../../request-id/request-id-storage.js';
+import { RequestIdMiddleware } from '../../request-id/request-id.middleware.js';
+
+describe('RequestIdMiddleware', () => {
+  let middleware: RequestIdMiddleware;
+  let res: { setHeader: (name: string, value: string) => void };
+  let setHeaderSpy: ReturnType<typeof vi.fn>;
+
+  beforeEach(() => {
+    middleware = new RequestIdMiddleware();
+    setHeaderSpy = vi.fn();
+    res = { setHeader: setHeaderSpy };
+  });
+
+  it('should generate a request id and set it on the response header when none is supplied', () => {
+    const next = vi.fn();
+    middleware.use({ headers: {} }, res, next);
+
+    expect(setHeaderSpy).toHaveBeenCalledTimes(1);
+    const [headerName, headerValue] = setHeaderSpy.mock.calls[0];
+    expect(headerName).toEqual(REQUEST_ID_HEADER);
+    expect(headerValue).toEqual(expect.any(String));
+    expect(headerValue.length).toBeGreaterThan(0);
+    expect(next).toHaveBeenCalledTimes(1);
+  });
+
+  it('should reuse an incoming request id instead of generating a new one', () => {
+    const next = vi.fn();
+    middleware.use(
+      { headers: { [REQUEST_ID_HEADER]: 'incoming-id' } },
+      res,
+      next,
+    );
+
+    expect(setHeaderSpy).toHaveBeenCalledWith(REQUEST_ID_HEADER, 'incoming-id');
+  });
+
+  it('should generate a new id when the incoming header is an empty string', () => {
+    const next = vi.fn();
+    middleware.use({ headers: { [REQUEST_ID_HEADER]: '' } }, res, next);
+
+    const [, headerValue] = setHeaderSpy.mock.calls[0];
+    expect(headerValue).not.toEqual('');
+  });
+
+  it('should use the first value when the incoming header is repeated', () => {
+    const next = vi.fn();
+    middleware.use(
+      { headers: { [REQUEST_ID_HEADER]: ['first-id', 'second-id'] } },
+      res,
+      next,
+    );
+
+    expect(setHeaderSpy).toHaveBeenCalledWith(REQUEST_ID_HEADER, 'first-id');
+  });
+
+  it('should make the id readable from RequestIdStorage while next() runs', () => {
+    let observed: string | undefined;
+    const next = () => {
+      observed = getRequestId();
+    };
+
+    middleware.use(
+      { headers: { [REQUEST_ID_HEADER]: 'incoming-id' } },
+      res,
+      next,
+    );
+
+    expect(observed).toEqual('incoming-id');
+    expect(getRequestId()).toBeUndefined();
+  });
+});
