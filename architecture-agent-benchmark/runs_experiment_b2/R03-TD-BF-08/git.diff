+/**
+ * Name of the header used to carry the request/correlation id, both when
+ * reading it off an incoming request and when writing it onto the outgoing
+ * response. Lowercase because Node normalizes incoming HTTP header names to
+ * lowercase, and both the Express and Fastify adapters read headers off the
+ * same normalized `req.headers` object.
+ */
+export const REQUEST_ID_HEADER = 'x-request-id';
