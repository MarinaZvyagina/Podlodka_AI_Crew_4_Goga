+import { AsyncLocalStorage } from 'async_hooks';
+
+/**
+ * Holds the current request's id in an `AsyncLocalStorage`, so it can be read
+ * from anywhere in application code handling that request (services, guards,
+ * interceptors, exception filters, log lines) without threading it through
+ * function arguments or re-reading it off a request object.
+ */
+export class RequestIdStorage {
+  private static readonly storage = new AsyncLocalStorage<string>();
+
+  /**
+   * Runs `callback` with `requestId` bound as the current request id for the
+   * remainder of its (a)synchronous execution.
+   */
+  public static run<T>(requestId: string, callback: () => T): T {
+    return this.storage.run(requestId, callback);
+  }
+
+  /**
+   * Returns the current request's id, or `undefined` when called outside of
+   * a `run` scope (e.g. outside of an HTTP request).
+   */
+  public static getId(): string | undefined {
+    return this.storage.getStore();
+  }
+}
+
+/**
+ * Returns the id of the request currently being handled, or `undefined` when
+ * called outside of one. The same value is present on the response's
+ * `x-request-id` header.
+ */
+export function getRequestId(): string | undefined {
+  return RequestIdStorage.getId();
+}
