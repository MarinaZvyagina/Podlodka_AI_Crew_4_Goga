+import {
+  getRequestId,
+  RequestIdStorage,
+} from '../../request-id/request-id-storage.js';
+
+describe('RequestIdStorage', () => {
+  it('should return undefined outside of a run scope', () => {
+    expect(RequestIdStorage.getId()).toBeUndefined();
+    expect(getRequestId()).toBeUndefined();
+  });
+
+  it('should expose the bound id for the duration of the callback', () => {
+    RequestIdStorage.run('req-1', () => {
+      expect(RequestIdStorage.getId()).toEqual('req-1');
+      expect(getRequestId()).toEqual('req-1');
+    });
+  });
+
+  it('should expose the bound id across an awaited async chain', async () => {
+    await RequestIdStorage.run('req-2', async () => {
+      await Promise.resolve();
+      expect(getRequestId()).toEqual('req-2');
+    });
+  });
+
+  it('should isolate concurrent scopes from each other', async () => {
+    const observed: Array<string | undefined> = [];
+
+    await Promise.all([
+      RequestIdStorage.run('req-a', async () => {
+        await new Promise(resolve => setTimeout(resolve, 10));
+        observed.push(getRequestId());
+      }),
+      RequestIdStorage.run('req-b', async () => {
+        observed.push(getRequestId());
+      }),
+    ]);
+
+    expect(observed).toEqual(['req-b', 'req-a']);
+  });
+
+  it('should return the callback result', () => {
+    const result = RequestIdStorage.run('req-3', () => 42);
+    expect(result).toEqual(42);
+  });
+});
diff --git a/packages/core/test/request-id/request-id.middleware.spec.ts b/packages/core/test/request-id/request-id.middleware.spec.ts
