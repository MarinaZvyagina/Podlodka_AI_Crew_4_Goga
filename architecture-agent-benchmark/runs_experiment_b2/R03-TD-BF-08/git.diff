+import { Injectable, type NestMiddleware } from '@nestjs/common';
+import { randomUUID } from 'crypto';
+import { REQUEST_ID_HEADER } from './request-id.constants.js';
+import { RequestIdStorage } from './request-id-storage.js';
+
+/**
+ * Ensures every response carries a request/correlation id on the
+ * `x-request-id` header: reused from the incoming request when the caller
+ * already supplied one (e.g. an upstream internal service forwarding its own
+ * id), otherwise freshly generated.
+ *
+ * Registered as ordinary global `NestMiddleware`, so it runs through
+ * `AbstractHttpAdapter#use` on both the Express and Fastify adapters
+ * identically, ahead of routing, guards, interceptors and the not-found /
+ * exception handlers - the id ends up on every response, not just successful
+ * ones.
+ *
+ * The id is also bound to `RequestIdStorage` for the rest of the request, so
+ * application code can read the exact same value via `getRequestId()`
+ * without parsing it back out of the response.
+ */
+@Injectable()
+export class RequestIdMiddleware implements NestMiddleware {
+  public use(req: any, res: any, next: (error?: any) => void) {
+    const incoming = req.headers?.[REQUEST_ID_HEADER];
+    const forwarded = Array.isArray(incoming) ? incoming[0] : incoming;
+    const requestId = forwarded?.trim() || randomUUID();
+
+    res.setHeader(REQUEST_ID_HEADER, requestId);
+    RequestIdStorage.run(requestId, next);
+  }
+}
