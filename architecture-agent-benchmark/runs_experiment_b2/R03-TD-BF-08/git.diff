+import {
+  Controller,
+  Get,
+  MiddlewareConsumer,
+  Module,
+  NestModule,
+} from '@nestjs/common';
+import {
+  getRequestId,
+  REQUEST_ID_HEADER,
+  RequestIdMiddleware,
+} from '@nestjs/core';
+import {
+  FastifyAdapter,
+  NestFastifyApplication,
+} from '@nestjs/platform-fastify';
+import { Test } from '@nestjs/testing';
+
+@Controller()
+class RequestIdController {
+  @Get('request-id')
+  getId() {
+    return { id: getRequestId() };
+  }
+}
+
+@Module({
+  controllers: [RequestIdController],
+})
+class RequestIdModule implements NestModule {
+  configure(consumer: MiddlewareConsumer) {
+    consumer.apply(RequestIdMiddleware).forRoutes('*');
+  }
+}
+
+describe('RequestId (FastifyAdapter)', () => {
+  let app: NestFastifyApplication;
+
+  beforeEach(async () => {
+    app = (
+      await Test.createTestingModule({
+        imports: [RequestIdModule],
+      }).compile()
+    ).createNestApplication<NestFastifyApplication>(new FastifyAdapter());
+    await app.init();
+    await app.getHttpAdapter().getInstance().ready();
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  it('generates a request id and returns it on the response header', async () => {
+    const response = await app.inject({
+      method: 'GET',
+      url: '/request-id',
+    });
+
+    expect(response.statusCode).toEqual(200);
+    expect(response.headers[REQUEST_ID_HEADER]).toBeDefined();
+  });
+
+  it('makes the same id readable from application code handling the request', async () => {
+    const response = await app.inject({
+      method: 'GET',
+      url: '/request-id',
+    });
+
+    expect(JSON.parse(response.payload).id).toEqual(
+      response.headers[REQUEST_ID_HEADER],
+    );
+  });
+
+  it('reuses an incoming request id instead of generating a new one', async () => {
+    const incomingId = 'incoming-correlation-id';
+    const response = await app.inject({
+      method: 'GET',
+      url: '/request-id',
+      headers: { [REQUEST_ID_HEADER]: incomingId },
+    });
+
+    expect(response.headers[REQUEST_ID_HEADER]).toEqual(incomingId);
+    expect(JSON.parse(response.payload).id).toEqual(incomingId);
+  });
+
+  it('generates a different id per request when none is supplied', async () => {
+    const first = await app.inject({ method: 'GET', url: '/request-id' });
+    const second = await app.inject({ method: 'GET', url: '/request-id' });
+
+    expect(first.headers[REQUEST_ID_HEADER]).not.toEqual(
+      second.headers[REQUEST_ID_HEADER],
+    );
+  });
+
+  it('sets the header even on responses for routes that do not exist', async () => {
+    const response = await app.inject({
+      method: 'GET',
+      url: '/does-not-exist',
+    });
+
+    expect(response.statusCode).toEqual(404);
+    expect(response.headers[REQUEST_ID_HEADER]).toBeDefined();
+  });
+});
