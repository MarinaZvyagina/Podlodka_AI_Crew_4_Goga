+import {
+  FastifyAdapter,
+  NestFastifyApplication,
+} from '@nestjs/platform-fastify';
+import { Test } from '@nestjs/testing';
+import { AppModule } from '../src/app.module.js';
+
+describe('Request ID (fastify adapter)', () => {
+  let app: NestFastifyApplication;
+
+  beforeEach(async () => {
+    const module = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = module.createNestApplication<NestFastifyApplication>(
+      new FastifyAdapter(),
+    );
+    await app.init();
+  });
+
+  it('should generate a request id header and expose it to the handler', async () => {
+    const response = await app.inject({ method: 'GET', url: '/request-id' });
+
+    expect(response.statusCode).toBe(200);
+    const headerValue = response.headers['x-request-id'];
+    expect(headerValue).toBeTruthy();
+    expect(JSON.parse(response.payload)).toEqual({ requestId: headerValue });
+  });
+
+  it('should reuse an inbound request id across the response and the handler', async () => {
+    const response = await app.inject({
+      method: 'GET',
+      url: '/request-id',
+      headers: { 'x-request-id': 'incoming-fastify-id' },
+    });
+
+    expect(response.statusCode).toBe(200);
+    expect(response.headers['x-request-id']).toEqual('incoming-fastify-id');
+    expect(JSON.parse(response.payload)).toEqual({
+      requestId: 'incoming-fastify-id',
+    });
+  });
+
+  it('should assign a different id per request', async () => {
+    const first = await app.inject({ method: 'GET', url: '/request-id' });
+    const second = await app.inject({ method: 'GET', url: '/request-id' });
+
+    expect(first.headers['x-request-id']).not.toEqual(
+      second.headers['x-request-id'],
+    );
+  });
+
+  it('should include the header on every response, including 404s', async () => {
+    const response = await app.inject({
+      method: 'GET',
+      url: '/does-not-exist',
+    });
+
+    expect(response.statusCode).toBe(404);
+    expect(response.headers['x-request-id']).toBeTruthy();
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+});
