@@ -0,0 +1,35 @@
+import {
+  getRequestId,
+  runWithRequestId,
+} from '../../request-id/request-id.storage.js';
+
+describe('request-id.storage', () => {
+  it('should return undefined outside of a request context', () => {
+    expect(getRequestId()).toBeUndefined();
+  });
+
+  it('should expose the id for the duration of the callback', () => {
+    runWithRequestId('req-1', () => {
+      expect(getRequestId()).toEqual('req-1');
+    });
+  });
+
+  it('should expose the id to async work started within the callback', async () => {
+    await runWithRequestId('req-2', async () => {
+      await Promise.resolve();
+      expect(getRequestId()).toEqual('req-2');
+    });
+  });
+
+  it('should isolate concurrent requests from each other', async () => {
+    const readBack = (id: string) =>
+      runWithRequestId(id, async () => {
+        await new Promise(resolve => setTimeout(resolve, 0));
+        return getRequestId();
+      });
+
+    const [a, b] = await Promise.all([readBack('req-a'), readBack('req-b')]);
+    expect(a).toEqual('req-a');
+    expect(b).toEqual('req-b');
+  });
+});
