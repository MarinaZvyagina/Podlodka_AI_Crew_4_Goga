diff --git a/packages/common/request-id/request-id.middleware.ts b/packages/common/request-id/request-id.middleware.ts
new file mode 100644
index 0000000..ebbeb92
--- /dev/null
+++ b/packages/common/request-id/request-id.middleware.ts
@@ -0,0 +1,32 @@
+import type { RequestHandler } from '../interfaces/http/http-server.interface.js';
+import { randomStringGenerator } from '../utils/random-string-generator.util.js';
+import { REQUEST_ID_HEADER } from './request-id.constants.js';
+import { runWithRequestId } from './request-id.storage.js';
+
+const INCOMING_REQUEST_ID_HEADER = REQUEST_ID_HEADER.toLowerCase();
+
+function readIncomingRequestId(req: {
+  headers?: Record<string, string | string[] | undefined>;
+}): string | undefined {
+  const header = req.headers?.[INCOMING_REQUEST_ID_HEADER];
+  const value = Array.isArray(header) ? header[0] : header;
+  return value || undefined;
+}
+
+/**
+ * Builds the middleware Nest registers on every HTTP adapter so that every
+ * response carries an `X-Request-Id` header: the inbound header's value is
+ * reused when the caller already supplied one (so a single ID can be traced
+ * across a chain of internal calls), otherwise a new one is generated. The
+ * resolved ID is stored for the lifetime of the request so application code
+ * can retrieve it via `getRequestId()`.
+ *
+ * @internal
+ */
+export function createRequestIdMiddleware(): RequestHandler {
+  return function requestIdMiddleware(req, res, next) {
+    const requestId = readIncomingRequestId(req) || randomStringGenerator();
+    res.setHeader(REQUEST_ID_HEADER, requestId);
+    runWithRequestId(requestId, () => next?.());
+  };
+}
diff --git a/packages/common/request-id/request-id.storage.ts b/packages/common/request-id/request-id.storage.ts
new file mode 100644
index 0000000..b226029
--- /dev/null
+++ b/packages/common/request-id/request-id.storage.ts
@@ -0,0 +1,19 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+
+const requestIdStore = new AsyncLocalStorage<string>();
+
+/**
+ * Returns the request/correlation ID of the HTTP request currently being
+ * handled, i.e. the same value sent back in the `X-Request-Id` response
+ * header. Returns `undefined` when called outside of an HTTP request
+ * (e.g. during application bootstrap).
+ *
+ * @publicApi
+ */
+export function getRequestId(): string | undefined {
+  return requestIdStore.getStore();
+}
+
+export function runWithRequestId<T>(requestId: string, callback: () => T): T {
+  return requestIdStore.run(requestId, callback);
+}
