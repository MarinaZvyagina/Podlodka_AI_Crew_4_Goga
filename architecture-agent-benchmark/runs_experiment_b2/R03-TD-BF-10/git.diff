+import { INestApplication } from '@nestjs/common';
+import { ExpressAdapter } from '@nestjs/platform-express';
+import { Test } from '@nestjs/testing';
+import express from 'express';
+import request from 'supertest';
+import { App } from 'supertest/types';
+import { AppModule } from '../src/app.module.js';
+
+describe('Request ID (express adapter)', () => {
+  let server: App;
+  let app: INestApplication;
+
+  beforeEach(async () => {
+    const module = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = module.createNestApplication(new ExpressAdapter(express()));
+    server = app.getHttpServer();
+    await app.init();
+  });
+
+  it('should generate a request id header and expose it to the handler', async () => {
+    const response = await request(server).get('/request-id').expect(200);
+
+    const headerValue = response.headers['x-request-id'];
+    expect(headerValue).toBeTruthy();
+    expect(response.body).toEqual({ requestId: headerValue });
+  });
+
+  it('should reuse an inbound request id across the response and the handler', async () => {
+    const response = await request(server)
+      .get('/request-id')
+      .set('X-Request-Id', 'incoming-express-id')
+      .expect(200);
+
+    expect(response.headers['x-request-id']).toEqual('incoming-express-id');
+    expect(response.body).toEqual({ requestId: 'incoming-express-id' });
+  });
+
+  it('should assign a different id per request', async () => {
+    const first = await request(server).get('/request-id').expect(200);
+    const second = await request(server).get('/request-id').expect(200);
+
+    expect(first.headers['x-request-id']).not.toEqual(
+      second.headers['x-request-id'],
+    );
+  });
+
+  it('should include the header on every response, including 404s', async () => {
+    const response = await request(server).get('/does-not-exist').expect(404);
+    expect(response.headers['x-request-id']).toBeTruthy();
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+});
