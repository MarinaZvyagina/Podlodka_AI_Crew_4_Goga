+import { createRequestIdMiddleware } from '../../request-id/request-id.middleware.js';
+import { getRequestId } from '../../request-id/request-id.storage.js';
+
+function createMockResponse() {
+  const headers: Record<string, string> = {};
+  return {
+    setHeader: (name: string, value: string) => {
+      headers[name] = value;
+    },
+    getHeader: (name: string) => headers[name],
+  };
+}
+
+describe('createRequestIdMiddleware', () => {
+  it('should generate a new id and set it on the response when none was sent', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = { headers: {} };
+    const res = createMockResponse();
+    let idSeenByHandler: string | undefined;
+
+    middleware(req, res, () => {
+      idSeenByHandler = getRequestId();
+    });
+
+    expect(res.getHeader('X-Request-Id')).toBeTypeOf('string');
+    expect(res.getHeader('X-Request-Id')).not.toEqual('');
+    expect(idSeenByHandler).toEqual(res.getHeader('X-Request-Id'));
+  });
+
+  it('should reuse an inbound request id instead of generating a new one', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = { headers: { 'x-request-id': 'chain-id-123' } };
+    const res = createMockResponse();
+
+    middleware(req, res, () => undefined);
+
+    expect(res.getHeader('X-Request-Id')).toEqual('chain-id-123');
+  });
+
+  it('should take the first value when the inbound header is duplicated', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = { headers: { 'x-request-id': ['first-id', 'second-id'] } };
+    const res = createMockResponse();
+
+    middleware(req, res, () => undefined);
+
+    expect(res.getHeader('X-Request-Id')).toEqual('first-id');
+  });
+
+  it('should make the id available to code invoked from next()', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = { headers: { 'x-request-id': 'chain-id-456' } };
+    const res = createMockResponse();
+
+    middleware(req, res, () => {
+      expect(getRequestId()).toEqual('chain-id-456');
+    });
+  });
+
+  it('should not leak the id outside of the request it belongs to', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = { headers: { 'x-request-id': 'chain-id-789' } };
+    const res = createMockResponse();
+
+    middleware(req, res, () => undefined);
+
+    expect(getRequestId()).toBeUndefined();
+  });
+});
