--- /dev/null
+++ b/packages/excalidraw/data/filename.ts
@@ -0,0 +1,22 @@
+import { DEFAULT_FILENAME } from "@excalidraw/common";
+
+// characters forbidden in file names on Windows (which is stricter than
+// macOS/Linux, whose only hard requirement is no path separator), plus raw
+// ASCII control characters
+// eslint-disable-next-line no-control-regex
+const UNSAFE_FILENAME_CHARS = /[\x00-\x1f\\/:*?"<>|]/g;
+
+/**
+ * Turns arbitrary user input into a name that's safe to use as a file name
+ * on Windows, macOS, and Linux. Replaces characters those filesystems forbid
+ * and drops trailing dots/spaces, which Windows silently strips on its own
+ * and would otherwise desync the name shown in the editor from the one that
+ * ends up on disk. Falls back to DEFAULT_FILENAME if nothing safe remains.
+ */
+export const sanitizeFilename = (name: string): string => {
+  const sanitized = name
+    .replace(UNSAFE_FILENAME_CHARS, "_")
+    .replace(/[.\s]+$/, "");
+
+  return sanitized || DEFAULT_FILENAME;
+};
