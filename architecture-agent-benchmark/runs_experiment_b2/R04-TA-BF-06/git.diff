index 0000000..feeafe5
--- /dev/null
+++ b/packages/excalidraw/data/filename.test.ts
@@ -0,0 +1,40 @@
+import { sanitizeFilename } from "./filename";
+
+describe("sanitizeFilename", () => {
+  it("leaves an already-safe name untouched", () => {
+    expect(sanitizeFilename("My Drawing 2024")).toBe("My Drawing 2024");
+  });
+
+  it("replaces characters that are illegal on Windows", () => {
+    expect(sanitizeFilename('a/b\\c:d*e?f"g<h>i|j')).toBe(
+      "a_b_c_d_e_f_g_h_i_j",
+    );
+  });
+
+  it("strips trailing dots and spaces", () => {
+    expect(sanitizeFilename("My Drawing.")).toBe("My Drawing");
+    expect(sanitizeFilename("My Drawing   ")).toBe("My Drawing");
+    expect(sanitizeFilename("My Drawing. . ")).toBe("My Drawing");
+  });
+
+  it("falls back to the default name when empty or whitespace-only", () => {
+    expect(sanitizeFilename("")).toBe("Untitled");
+    expect(sanitizeFilename("   ")).toBe("Untitled");
+    expect(sanitizeFilename("...")).toBe("Untitled");
+  });
+
+  it("falls back to the default name for Windows-reserved device names", () => {
+    expect(sanitizeFilename("CON")).toBe("Untitled");
+    expect(sanitizeFilename("con")).toBe("Untitled");
+    expect(sanitizeFilename("COM1")).toBe("Untitled");
+    expect(sanitizeFilename("lpt9")).toBe("Untitled");
+  });
+
+  it("is idempotent", () => {
+    const inputs = ["My/Drawing.", "   ", "CON", "Normal Name"];
+    for (const input of inputs) {
+      const once = sanitizeFilename(input);
+      expect(sanitizeFilename(once)).toBe(once);
+    }
+  });
+});
