+import { DEFAULT_FILENAME } from "@excalidraw/common";
+
+// reserved on Windows, plus ASCII control characters (also invalid on Windows)
+// eslint-disable-next-line no-control-regex
+const INVALID_FILENAME_CHARS = /[\\/:*?"<>|\x00-\x1f]/g;
+
+// Windows reserved device names (case-insensitive, regardless of extension)
+const WINDOWS_RESERVED_NAMES = /^(con|prn|aux|nul|com[0-9]|lpt[0-9])$/i;
+
+/**
+ * Turns arbitrary user input into a name that's safe to use as a file name
+ * (sans extension) on Windows, macOS, and Linux:
+ * - replaces characters that are illegal in Windows file names
+ * - strips trailing dots/spaces, which Windows silently drops
+ * - falls back to DEFAULT_FILENAME if nothing safe is left, or if the
+ *   sanitized name collides with a Windows-reserved device name
+ */
+export const sanitizeFilename = (name: string): string => {
+  const sanitized = name
+    .replace(INVALID_FILENAME_CHARS, "_")
+    .trim()
+    .replace(/[.\s]+$/, "");
+
+  if (!sanitized || WINDOWS_RESERVED_NAMES.test(sanitized)) {
+    return DEFAULT_FILENAME;
+  }
+
+  return sanitized;
+};
