+++ b/packages/element/tests/getElementArea.test.ts
@@ -0,0 +1,277 @@
+import { pointFrom, degreesToRadians } from "@excalidraw/math";
+import { arrayToMap, ROUNDNESS } from "@excalidraw/common";
+
+import type { LocalPoint, Radians, Degrees } from "@excalidraw/math";
+
+import { getElementArea } from "../src/shape";
+
+import type {
+  ExcalidrawElement,
+  ExcalidrawFreeDrawElement,
+  ExcalidrawLinearElement,
+} from "../src/types";
+
+const rectangular = ({
+  type = "rectangle",
+  x = 0,
+  y = 0,
+  w,
+  h,
+  angle = 0,
+}: {
+  type?: "rectangle" | "diamond" | "ellipse";
+  x?: number;
+  y?: number;
+  w: number;
+  h: number;
+  angle?: number;
+}) =>
+  ({
+    id: "el",
+    type,
+    strokeColor: "#000",
+    backgroundColor: "#000",
+    fillStyle: "solid",
+    strokeWidth: 1,
+    roundness: { type: ROUNDNESS.PROPORTIONAL_RADIUS },
+    roughness: 0,
+    opacity: 1,
+    x,
+    y,
+    width: w,
+    height: h,
+    angle: degreesToRadians(angle as Degrees),
+    groupIds: [],
+    boundElements: null,
+    isDeleted: false,
+    frameId: null,
+    index: null,
+    seed: 1,
+    version: 1,
+    versionNonce: 1,
+    updated: 1,
+    link: null,
+    locked: false,
+  } as unknown as ExcalidrawElement);
+
+const linearOrFreedraw = ({
+  type,
+  points,
+  polygon,
+  backgroundColor = "#000",
+}: {
+  type: "line" | "freedraw";
+  points: readonly LocalPoint[];
+  polygon?: boolean;
+  backgroundColor?: string;
+}) =>
+  ({
+    id: "el",
+    type,
+    x: 0,
+    y: 0,
+    width: 100,
+    height: 100,
+    angle: 0 as Radians,
+    strokeColor: "#000",
+    backgroundColor,
+    fillStyle: "solid",
+    strokeWidth: 1,
+    strokeStyle: "solid",
+    roundness: null,
+    roughness: 0,
+    opacity: 1,
+    groupIds: [],
+    boundElements: null,
+    isDeleted: false,
+    frameId: null,
+    index: null,
+    seed: 1,
+    version: 1,
+    versionNonce: 1,
+    updated: 1,
+    link: null,
+    locked: false,
+    points,
+    lastCommittedPoint: null,
+    startBinding: null,
+    endBinding: null,
+    ...(type === "line" ? { polygon: polygon ?? false } : {}),
+  } as unknown as ExcalidrawLinearElement | ExcalidrawFreeDrawElement);
+
+const arrow = () =>
+  ({
+    id: "el",
+    type: "arrow",
+    x: 0,
+    y: 0,
+    width: 100,
+    height: 100,
+    angle: 0 as Radians,
+    strokeColor: "#000",
+    backgroundColor: "#000",
+    fillStyle: "solid",
+    strokeWidth: 1,
+    roughness: 0,
+    opacity: 1,
+    groupIds: [],
+    boundElements: null,
+    isDeleted: false,
+    frameId: null,
+    index: null,
+    seed: 1,
+    version: 1,
+    versionNonce: 1,
+    updated: 1,
+    link: null,
+    locked: false,
+    points: [pointFrom<LocalPoint>(0, 0), pointFrom<LocalPoint>(100, 100)],
+    lastCommittedPoint: null,
+    startBinding: null,
+    endBinding: null,
+    startArrowhead: null,
+    endArrowhead: null,
+    elbowed: false,
+  } as unknown as ExcalidrawElement);
+
+const text = () =>
+  ({
+    id: "el",
+    type: "text",
+    x: 0,
+    y: 0,
+    width: 100,
+    height: 25,
+    angle: 0 as Radians,
+    strokeColor: "#000",
+    backgroundColor: "transparent",
+    fillStyle: "solid",
+    strokeWidth: 1,
+    roughness: 0,
+    opacity: 1,
+    groupIds: [],
+    boundElements: null,
+    isDeleted: false,
+    frameId: null,
+    index: null,
+    seed: 1,
+    version: 1,
+    versionNonce: 1,
+    updated: 1,
+    link: null,
+    locked: false,
+    text: "hi",
+    fontSize: 20,
+    fontFamily: 1,
+    textAlign: "left",
+    verticalAlign: "top",
+    containerId: null,
+    originalText: "hi",
+    lineHeight: 1.25,
+    autoResize: true,
+  } as unknown as ExcalidrawElement);
+
+describe("getElementArea", () => {
+  it("computes area for an axis-aligned rectangle", () => {
+    const element = rectangular({ w: 100, h: 50 });
+    expect(getElementArea(element, arrayToMap([element]))).toBeCloseTo(5000, 5);
+  });
+
+  it("computes the same area for a rotated rectangle", () => {
+    const element = rectangular({ w: 100, h: 50, angle: 37 });
+    expect(getElementArea(element, arrayToMap([element]))).toBeCloseTo(5000, 5);
+  });
+
+  it("computes area for a diamond as half the bounding box", () => {
+    const element = rectangular({ type: "diamond", w: 100, h: 50 });
+    expect(getElementArea(element, arrayToMap([element]))).toBeCloseTo(2500, 5);
+  });
+
+  it("computes the same area for a rotated diamond", () => {
+    const element = rectangular({ type: "diamond", w: 100, h: 50, angle: 52 });
+    expect(getElementArea(element, arrayToMap([element]))).toBeCloseTo(2500, 5);
+  });
+
+  it("computes area for an ellipse", () => {
+    const element = rectangular({ type: "ellipse", w: 100, h: 50 });
+    expect(getElementArea(element, arrayToMap([element]))).toBeCloseTo(
+      Math.PI * 50 * 25,
+      5,
+    );
+  });
+
+  it("computes the same area for a rotated ellipse", () => {
+    const element = rectangular({ type: "ellipse", w: 100, h: 50, angle: 71 });
+    expect(getElementArea(element, arrayToMap([element]))).toBeCloseTo(
+      Math.PI * 50 * 25,
+      5,
+    );
+  });
+
+  it("computes area for a closed, filled line", () => {
+    const points = [
+      pointFrom<LocalPoint>(0, 0),
+      pointFrom<LocalPoint>(100, 0),
+      pointFrom<LocalPoint>(100, 100),
+      pointFrom<LocalPoint>(0, 100),
+      pointFrom<LocalPoint>(0, 0),
+    ];
+    const element = linearOrFreedraw({ type: "line", points, polygon: true });
+    expect(getElementArea(element, arrayToMap([element]))).toBeCloseTo(
+      10000,
+      0,
+    );
+  });
+
+  it("returns undefined for an open line", () => {
+    const points = [
+      pointFrom<LocalPoint>(0, 0),
+      pointFrom<LocalPoint>(100, 0),
+      pointFrom<LocalPoint>(100, 100),
+    ];
+    const element = linearOrFreedraw({ type: "line", points });
+    expect(getElementArea(element, arrayToMap([element]))).toBeUndefined();
+  });
+
+  it("returns undefined for a closed but transparent (unfilled) line", () => {
+    const points = [
+      pointFrom<LocalPoint>(0, 0),
+      pointFrom<LocalPoint>(100, 0),
+      pointFrom<LocalPoint>(100, 100),
+      pointFrom<LocalPoint>(0, 100),
+      pointFrom<LocalPoint>(0, 0),
+    ];
+    const element = linearOrFreedraw({
+      type: "line",
+      points,
+      polygon: true,
+      backgroundColor: "transparent",
+    });
+    expect(getElementArea(element, arrayToMap([element]))).toBeUndefined();
+  });
+
+  it("computes area for a closed, filled freedraw stroke", () => {
+    const points = [
+      pointFrom<LocalPoint>(0, 0),
+      pointFrom<LocalPoint>(100, 0),
+      pointFrom<LocalPoint>(100, 100),
+      pointFrom<LocalPoint>(0, 100),
+      pointFrom<LocalPoint>(0, 0),
+    ];
+    const element = linearOrFreedraw({ type: "freedraw", points });
+    expect(getElementArea(element, arrayToMap([element]))).toBeCloseTo(
+      10000,
+      0,
+    );
+  });
+
+  it("returns undefined for an arrow", () => {
+    const element = arrow();
+    expect(getElementArea(element, arrayToMap([element]))).toBeUndefined();
+  });
+
+  it("returns undefined for a text element", () => {
+    const element = text();
+    expect(getElementArea(element, arrayToMap([element]))).toBeUndefined();
+  });
+});
