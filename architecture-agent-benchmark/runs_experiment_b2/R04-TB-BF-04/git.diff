+/**
+ * get the true enclosed area of an element, accounting for rotation.
+ * returns undefined for element types/states with no meaningful enclosed area
+ * (e.g. arrows, text, images, or open/unfilled lines and freedraw strokes).
+ */
+export const getElementArea = (
+  element: ExcalidrawElement,
+  elementsMap: ElementsMap,
+): number | undefined => {
+  switch (element.type) {
+    case "rectangle":
+    case "diamond":
+    case "ellipse":
+      break;
+    case "line":
+    case "freedraw":
+      if (!shouldTestInside(element)) {
+        return undefined;
+      }
+      break;
+    default:
+      return undefined;
+  }
+
+  const shape = getElementShape(element, elementsMap);
+
+  switch (shape.type) {
+    case "polygon":
+      return polygonArea(shape.data);
+    case "ellipse":
+      return Math.PI * shape.data.halfWidth * shape.data.halfHeight;
+    default:
+      return undefined;
+  }
+};
