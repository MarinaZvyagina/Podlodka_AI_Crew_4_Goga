+/**
+ * area enclosed by an element's own outline, in scene px².
+ *
+ * `null` for element types that don't enclose a meaningful region (text,
+ * images, frames, arrows, open lines/freedraw, ...). Computed from the
+ * element's own local width/height/points rather than its rotated bounding
+ * box, so a rotated shape reports the same area as before rotation.
+ */
+export const getElementArea = (element: ExcalidrawElement): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    case "line":
+    case "freedraw":
+      return isPathALoop(element.points) ? polygonArea(element.points) : null;
+    default:
+      return null;
+  }
+};
