diff --git a/packages/element/tests/area.test.ts b/packages/element/tests/area.test.ts
new file mode 100644
index 0000000..bcf5c4c
--- /dev/null
+++ b/packages/element/tests/area.test.ts
@@ -0,0 +1,149 @@
+import { pointFrom } from "@excalidraw/math";
+import { API } from "@excalidraw/excalidraw/tests/helpers/api";
+
+import type { LocalPoint } from "@excalidraw/math";
+
+import { getElementArea as area } from "../src/shape";
+
+import type { ExcalidrawElement } from "../src/types";
+
+describe("getElementArea", () => {
+  it("returns width * height for a rectangle", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 200,
+      height: 100,
+    });
+    expect(area(rectangle)).toBe(20000);
+  });
+
+  it("returns half of width * height for a diamond", () => {
+    const diamond = API.createElement({
+      type: "diamond",
+      width: 200,
+      height: 100,
+    });
+    expect(area(diamond)).toBe(10000);
+  });
+
+  it("returns pi * (w/2) * (h/2) for an ellipse", () => {
+    const ellipse = API.createElement({
+      type: "ellipse",
+      width: 200,
+      height: 100,
+    });
+    expect(area(ellipse)).toBeCloseTo(Math.PI * 100 * 50, 5);
+  });
+
+  it("is unaffected by rotation", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 200,
+      height: 100,
+    });
+    const rotated = { ...rectangle, angle: Math.PI / 4 } as ExcalidrawElement;
+    expect(area(rotated)).toBe(area(rectangle));
+
+    const diamond = API.createElement({
+      type: "diamond",
+      width: 60,
+      height: 40,
+    });
+    const rotatedDiamond = {
+      ...diamond,
+      angle: 0.73,
+    } as ExcalidrawElement;
+    expect(area(rotatedDiamond)).toBeCloseTo(area(diamond)!, 5);
+
+    const ellipse = API.createElement({
+      type: "ellipse",
+      width: 60,
+      height: 40,
+    });
+    const rotatedEllipse = { ...ellipse, angle: 1.2 } as ExcalidrawElement;
+    expect(area(rotatedEllipse)).toBeCloseTo(area(ellipse)!, 5);
+  });
+
+  it("returns null for elements that don't enclose a region", () => {
+    const text = API.createElement({ type: "text", width: 100, height: 20 });
+    expect(area(text)).toBeNull();
+
+    const image = API.createElement({ type: "image", width: 100, height: 100 });
+    expect(area(image)).toBeNull();
+
+    const arrow = API.createElement({
+      type: "arrow",
+      points: [pointFrom<LocalPoint>(0, 0), pointFrom<LocalPoint>(100, 100)],
+    });
+    expect(area(arrow)).toBeNull();
+  });
+
+  it("returns null for an open (non-looping) line", () => {
+    const openLine = API.createElement({
+      type: "line",
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 100),
+      ],
+    });
+    expect(area(openLine)).toBeNull();
+  });
+
+  it("returns the shoelace area for a closed (looping) line", () => {
+    const closedLine = API.createElement({
+      type: "line",
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 100),
+        pointFrom<LocalPoint>(0, 100),
+        pointFrom<LocalPoint>(0, 0),
+      ],
+    });
+    expect(area(closedLine)).toBeCloseTo(10000, 2);
+  });
+
+  it("returns null for an open (non-looping) freedraw stroke", () => {
+    const openFreedraw = API.createElement({
+      type: "freedraw",
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(50, 50),
+        pointFrom<LocalPoint>(100, 100),
+      ],
+    });
+    expect(area(openFreedraw)).toBeNull();
+  });
+
+  it("returns the shoelace area for a closed (looping) freedraw stroke", () => {
+    const closedFreedraw = API.createElement({
+      type: "freedraw",
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 100),
+        pointFrom<LocalPoint>(0, 100),
+        pointFrom<LocalPoint>(0, 0),
+      ],
+    });
+    expect(area(closedFreedraw)).toBeCloseTo(10000, 2);
+  });
+
+  it("closed line/freedraw area is unaffected by rotation", () => {
+    const closedLine = API.createElement({
+      type: "line",
+      x: 10,
+      y: 10,
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 100),
+        pointFrom<LocalPoint>(0, 100),
+        pointFrom<LocalPoint>(0, 0),
+      ],
+    });
+    const rotated = { ...closedLine, angle: 0.9 } as ExcalidrawElement;
+    expect(area(rotated)).toBeCloseTo(area(closedLine)!, 2);
+  });
+});
