diff --git a/packages/excalidraw/actions/actionToggleCaptions.test.tsx b/packages/excalidraw/actions/actionToggleCaptions.test.tsx
new file mode 100644
index 0000000..2d781e4
--- /dev/null
+++ b/packages/excalidraw/actions/actionToggleCaptions.test.tsx
@@ -0,0 +1,120 @@
+import { CODES } from "@excalidraw/common";
+
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { Keyboard, UI } from "../tests/helpers/ui";
+import { act, render, unmountComponent } from "../tests/test-utils";
+
+import { actionToggleCaptions } from "./actionToggleCaptions";
+
+unmountComponent();
+
+const h = window.h;
+
+const createContainerWithText = () => {
+  const container = API.createElement({
+    type: "rectangle",
+    width: 100,
+  });
+  const text = API.createElement({
+    type: "text",
+    text: "hello",
+    x: container.x + 10,
+    y: container.y + 10,
+    width: 50,
+    height: 20,
+    containerId: container.id,
+  });
+  h.app.scene.mutateElement(container, {
+    boundElements: [{ id: text.id, type: "text" }],
+  });
+  API.setElements([container, text]);
+  return { container, text };
+};
+
+describe("actionToggleCaptions", () => {
+  beforeEach(async () => {
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+    API.setElements([]);
+  });
+
+  it("toggles appState.captionsHiddenEnabled without touching elements", () => {
+    const { container, text } = createContainerWithText();
+
+    expect(h.state.captionsHiddenEnabled).toBe(false);
+
+    act(() => {
+      h.app.actionManager.executeAction(actionToggleCaptions);
+    });
+    expect(h.state.captionsHiddenEnabled).toBe(true);
+
+    act(() => {
+      h.app.actionManager.executeAction(actionToggleCaptions);
+    });
+    expect(h.state.captionsHiddenEnabled).toBe(false);
+
+    expect(h.elements).toEqual([
+      expect.objectContaining({ id: container.id }),
+      expect.objectContaining({ id: text.id, text: "hello" }),
+    ]);
+  });
+
+  it("toggles via the Alt+C keyboard shortcut", () => {
+    createContainerWithText();
+    UI.clickTool("selection");
+
+    expect(h.state.captionsHiddenEnabled).toBe(false);
+
+    act(() => {
+      Keyboard.withModifierKeys({ alt: true }, () => {
+        Keyboard.codePress(CODES.C);
+      });
+    });
+    expect(h.state.captionsHiddenEnabled).toBe(true);
+
+    act(() => {
+      Keyboard.withModifierKeys({ alt: true }, () => {
+        Keyboard.codePress(CODES.C);
+      });
+    });
+    expect(h.state.captionsHiddenEnabled).toBe(false);
+  });
+
+  it("works with no selection and with a selection", () => {
+    const { container } = createContainerWithText();
+
+    act(() => {
+      h.app.actionManager.executeAction(actionToggleCaptions);
+    });
+    expect(h.state.captionsHiddenEnabled).toBe(true);
+    act(() => {
+      h.app.actionManager.executeAction(actionToggleCaptions);
+    });
+    expect(h.state.captionsHiddenEnabled).toBe(false);
+
+    API.setSelectedElements([container]);
+    act(() => {
+      h.app.actionManager.executeAction(actionToggleCaptions);
+    });
+    expect(h.state.captionsHiddenEnabled).toBe(true);
+  });
+
+  it("is independent from other view toggles", () => {
+    createContainerWithText();
+
+    act(() => {
+      h.app.actionManager.executeAction(actionToggleCaptions);
+    });
+    expect(h.state.captionsHiddenEnabled).toBe(true);
+    expect(h.state.zenModeEnabled).toBe(false);
+    expect(h.state.gridModeEnabled).toBe(false);
+
+    act(() => {
+      Keyboard.withModifierKeys({ alt: true }, () => {
+        Keyboard.codePress(CODES.Z);
+      });
+    });
+    expect(h.state.zenModeEnabled).toBe(true);
+    expect(h.state.captionsHiddenEnabled).toBe(true);
+  });
+});
diff --git a/packages/excalidraw/actions/actionToggleCaptions.tsx b/packages/excalidraw/actions/actionToggleCaptions.tsx
new file mode 100644
index 0000000..b0f0b8e
--- /dev/null
+++ b/packages/excalidraw/actions/actionToggleCaptions.tsx
@@ -0,0 +1,30 @@
+import { CODES, KEYS } from "@excalidraw/common";
+
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { eyeClosedIcon } from "../components/icons";
+
+import { register } from "./register";
+
+export const actionToggleCaptions = register({
+  name: "captionsHidden",
+  label: "labels.toggleCaptions",
+  icon: eyeClosedIcon,
+  viewMode: true,
+  trackEvent: {
+    category: "canvas",
+    predicate: (appState) => !appState.captionsHiddenEnabled,
+  },
+  perform(elements, appState) {
+    return {
+      appState: {
+        ...appState,
+        captionsHiddenEnabled: !this.checked!(appState),
+      },
+      captureUpdate: CaptureUpdateAction.EVENTUALLY,
+    };
+  },
+  checked: (appState) => appState.captionsHiddenEnabled,
+  keyTest: (event) =>
+    !event[KEYS.CTRL_OR_CMD] && event.altKey && event.code === CODES.C,
+});
