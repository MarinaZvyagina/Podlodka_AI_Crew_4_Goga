+
+  it("omits bound text from export when captionsHiddenEnabled is set", async () => {
+    const container = API.createElement({
+      type: "rectangle",
+      id: "container-captions",
+      width: 100,
+      height: 100,
+      boundElements: [{ type: "text", id: "label-captions" }],
+    });
+    const label = API.createElement({
+      type: "text",
+      id: "label-captions",
+      text: "caption-text",
+      width: 50,
+      height: 20,
+      containerId: "container-captions",
+    });
+
+    const shown = await exportUtils.exportToSvg(
+      [container, label] as NonDeletedExcalidrawElement[],
+      DEFAULT_OPTIONS,
+      null,
+    );
+    expect(shown.innerHTML).toContain("caption-text");
+
+    const hidden = await exportUtils.exportToSvg(
+      [container, label] as NonDeletedExcalidrawElement[],
+      { ...DEFAULT_OPTIONS, captionsHiddenEnabled: true },
+      null,
+    );
+    expect(hidden.innerHTML).not.toContain("caption-text");
+  });
 });
 
