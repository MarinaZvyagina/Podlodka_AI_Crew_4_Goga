diff --git a/packages/excalidraw/tests/actionToggleCaptions.test.tsx b/packages/excalidraw/tests/actionToggleCaptions.test.tsx
new file mode 100644
index 0000000..3c44a4d
--- /dev/null
+++ b/packages/excalidraw/tests/actionToggleCaptions.test.tsx
@@ -0,0 +1,78 @@
+import { newElementWith } from "@excalidraw/element";
+
+import { actionToggleCaptions } from "../actions/actionToggleCaptions";
+import { Excalidraw } from "../index";
+
+import { API } from "./helpers/api";
+import { render, unmountComponent } from "./test-utils";
+
+unmountComponent();
+
+const { h } = window;
+
+describe("actionToggleCaptions", () => {
+  beforeEach(async () => {
+    localStorage.clear();
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+  });
+
+  it("defaults to captions visible", () => {
+    expect(h.state.captionsHiddenEnabled).toBe(false);
+    expect(actionToggleCaptions.checked!(h.state)).toBe(false);
+  });
+
+  it("toggles captionsHiddenEnabled on and off", () => {
+    API.executeAction(actionToggleCaptions);
+    expect(h.state.captionsHiddenEnabled).toBe(true);
+    expect(actionToggleCaptions.checked!(h.state)).toBe(true);
+
+    API.executeAction(actionToggleCaptions);
+    expect(h.state.captionsHiddenEnabled).toBe(false);
+    expect(actionToggleCaptions.checked!(h.state)).toBe(false);
+  });
+
+  it("is enabled even without a selection", () => {
+    expect(h.state.selectedElementIds).toEqual({});
+    expect(h.app.actionManager.isActionEnabled(actionToggleCaptions)).toBe(
+      true,
+    );
+  });
+
+  it("never mutates the underlying elements or their bound-text relationship", () => {
+    const container = API.createElement({ type: "rectangle" });
+    const text = API.createElement({
+      type: "text",
+      containerId: container.id,
+      text: "hello",
+    });
+
+    API.updateScene({
+      elements: [
+        newElementWith(container, { boundElements: [{ id: text.id, type: "text" }] }),
+        text,
+      ],
+    });
+
+    const beforeContainer = h.elements[0];
+    const beforeText = h.elements[1];
+
+    API.executeAction(actionToggleCaptions);
+    API.executeAction(actionToggleCaptions);
+
+    expect(h.elements[0]).toStrictEqual(beforeContainer);
+    expect(h.elements[1]).toStrictEqual(beforeText);
+    expect((h.elements[1] as any).containerId).toBe(container.id);
+    expect((h.elements[1] as any).text).toBe("hello");
+    expect((h.elements[1] as any).isDeleted).toBe(false);
+  });
+
+  it("is independent from other display toggles", () => {
+    API.setAppState({ gridModeEnabled: true, zenModeEnabled: true });
+
+    API.executeAction(actionToggleCaptions);
+
+    expect(h.state.captionsHiddenEnabled).toBe(true);
+    expect(h.state.gridModeEnabled).toBe(true);
+    expect(h.state.zenModeEnabled).toBe(true);
+  });
+});
