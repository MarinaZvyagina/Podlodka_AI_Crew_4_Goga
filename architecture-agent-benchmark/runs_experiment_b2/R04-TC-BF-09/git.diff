diff --git a/packages/excalidraw/actions/actionToggleBoundTextsHidden.tsx b/packages/excalidraw/actions/actionToggleBoundTextsHidden.tsx
new file mode 100644
index 0000000..8c6da36
--- /dev/null
+++ b/packages/excalidraw/actions/actionToggleBoundTextsHidden.tsx
@@ -0,0 +1,31 @@
+import { CODES, KEYS } from "@excalidraw/common";
+
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { eyeClosedIcon } from "../components/icons";
+
+import { register } from "./register";
+
+export const actionToggleBoundTextsHidden = register({
+  name: "boundTextsHidden",
+  icon: eyeClosedIcon,
+  keywords: ["captions", "labels", "text", "hide"],
+  label: "labels.toggleCaptions",
+  viewMode: true,
+  trackEvent: {
+    category: "canvas",
+    predicate: (appState) => !appState.boundTextsHidden,
+  },
+  perform(elements, appState) {
+    return {
+      appState: {
+        ...appState,
+        boundTextsHidden: !this.checked!(appState),
+      },
+      captureUpdate: CaptureUpdateAction.EVENTUALLY,
+    };
+  },
+  checked: (appState) => appState.boundTextsHidden,
+  keyTest: (event) =>
+    !event[KEYS.CTRL_OR_CMD] && event.altKey && event.code === CODES.C,
+});
