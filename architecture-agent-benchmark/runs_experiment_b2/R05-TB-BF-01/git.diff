+// buildStaticScrapeConfig returns a parsed Config with a single job_name, an optional
+// max_scrape_targets override (pass "" for the global default) and targetCount static targets
+// starting at 127.0.0.1:<portBase>.
+func buildStaticScrapeConfig(t *testing.T, jobName, maxScrapeTargetsYAML string, portBase, targetCount int) *Config {
+	t.Helper()
+	var sb strings.Builder
+	fmt.Fprintf(&sb, "scrape_configs:\n- job_name: %s\n", jobName)
+	sb.WriteString(maxScrapeTargetsYAML)
+	sb.WriteString("  static_configs:\n  - targets:\n")
+	for i := range targetCount {
+		fmt.Fprintf(&sb, "    - 127.0.0.1:%d\n", portBase+i)
+	}
+	var cfg Config
+	if err := cfg.parseData([]byte(sb.String()), "test-scrape.yaml"); err != nil {
+		t.Fatalf("cannot parse config: %s", err)
+	}
+	return &cfg
+}
+
+// activeAndDroppedTargetsForJob returns the number of currently active and
+// currently-dropped (across all reasons) targets known for the given job_name.
+func activeAndDroppedTargetsForJob(jobName string) (active, dropped int) {
+	tsr := tsmGlobal.getTargetsStatusByJob(&requestFilter{})
+	for _, tlj := range tsr.getTargetLabelsByJob() {
+		if tlj.jobName == jobName {
+			return tlj.activeTargets, tlj.droppedTargets
+		}
+	}
+	return 0, 0
+}
+
+func TestScraperGroupMaxScrapeTargetsPerJob(t *testing.T) {
+	pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+	globalStopChan := make(chan struct{})
+	defer close(globalStopChan)
+
+	t.Run("job under the limit is unaffected", func(t *testing.T) {
+		jobName := fmt.Sprintf("under_limit_%d", rand.Int())
+		cfg := buildStaticScrapeConfig(t, jobName, "  max_scrape_targets: 5\n", 20000, 3)
+		sg := newScraperGroup(fmt.Sprintf("sd_%d", rand.Int()), pushData, globalStopChan)
+		defer sg.stop()
+
+		sg.update(cfg.getStaticScrapeWork())
+
+		if n := len(sg.m); n != 3 {
+			t.Fatalf("unexpected number of started scrapers; got %d, want 3", n)
+		}
+		active, dropped := activeAndDroppedTargetsForJob(jobName)
+		if active != 3 || dropped != 0 {
+			t.Fatalf("unexpected active/dropped targets for job %q; got active=%d, dropped=%d; want active=3, dropped=0", jobName, active, dropped)
+		}
+	})
+
+	t.Run("job over the limit is truncated and visible", func(t *testing.T) {
+		jobName := fmt.Sprintf("over_limit_%d", rand.Int())
+		cfg := buildStaticScrapeConfig(t, jobName, "  max_scrape_targets: 2\n", 20100, 5)
+		sg := newScraperGroup(fmt.Sprintf("sd_%d", rand.Int()), pushData, globalStopChan)
+		defer sg.stop()
+
+		sg.update(cfg.getStaticScrapeWork())
+
+		if n := len(sg.m); n != 2 {
+			t.Fatalf("unexpected number of started scrapers; got %d, want 2", n)
+		}
+		active, dropped := activeAndDroppedTargetsForJob(jobName)
+		if active != 2 || dropped != 3 {
+			t.Fatalf("unexpected active/dropped targets for job %q; got active=%d, dropped=%d; want active=2, dropped=3", jobName, active, dropped)
+		}
+	})
+
+	t.Run("default behavior is unlimited", func(t *testing.T) {
+		jobName := fmt.Sprintf("unlimited_%d", rand.Int())
+		cfg := buildStaticScrapeConfig(t, jobName, "", 20200, 20)
+		sg := newScraperGroup(fmt.Sprintf("sd_%d", rand.Int()), pushData, globalStopChan)
+		defer sg.stop()
+
+		sg.update(cfg.getStaticScrapeWork())
+
+		if n := len(sg.m); n != 20 {
+			t.Fatalf("unexpected number of started scrapers; got %d, want 20", n)
+		}
+		active, dropped := activeAndDroppedTargetsForJob(jobName)
+		if active != 20 || dropped != 0 {
+			t.Fatalf("unexpected active/dropped targets for job %q; got active=%d, dropped=%d; want active=20, dropped=0", jobName, active, dropped)
+		}
+	})
+
+	t.Run("limit is enforced across independent discovery mechanisms for the same job", func(t *testing.T) {
+		jobName := fmt.Sprintf("cross_group_%d", rand.Int())
+
+		// Simulate two different service discovery mechanisms contributing targets to the
+		// same job_name, each running its own independent scraperGroup (e.g. static_configs
+		// and kubernetes_sd_configs would each get their own group in production).
+		cfg1 := buildStaticScrapeConfig(t, jobName, "  max_scrape_targets: 3\n", 20300, 2)
+		cfg2 := buildStaticScrapeConfig(t, jobName, "  max_scrape_targets: 3\n", 20400, 2)
+
+		sg1 := newScraperGroup(fmt.Sprintf("sd1_%d", rand.Int()), pushData, globalStopChan)
+		defer sg1.stop()
+		sg2 := newScraperGroup(fmt.Sprintf("sd2_%d", rand.Int()), pushData, globalStopChan)
+		defer sg2.stop()
+
+		sg1.update(cfg1.getStaticScrapeWork())
+		if n := len(sg1.m); n != 2 {
+			t.Fatalf("unexpected number of started scrapers in the first group; got %d, want 2", n)
+		}
+
+		sg2.update(cfg2.getStaticScrapeWork())
+		if n := len(sg2.m); n != 1 {
+			t.Fatalf("unexpected number of started scrapers in the second group; got %d, want 1", n)
+		}
+
+		active, dropped := activeAndDroppedTargetsForJob(jobName)
+		if active != 3 || dropped != 1 {
+			t.Fatalf("unexpected active/dropped targets for job %q; got active=%d, dropped=%d; want active=3, dropped=1", jobName, active, dropped)
+		}
+	})
+}
