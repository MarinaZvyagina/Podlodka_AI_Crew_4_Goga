+// countByJobAndReason returns the number of currently tracked dropped targets for the given jobName and reason.
+func (dt *droppedTargets) countByJobAndReason(jobName string, reason targetDropReason) int {
+	dt.mu.Lock()
+	defer dt.mu.Unlock()
+	n := 0
+	for _, v := range dt.m {
+		if v.dropReason == reason && v.originalLabels.getJob() == jobName {
+			n++
+		}
+	}
+	return n
