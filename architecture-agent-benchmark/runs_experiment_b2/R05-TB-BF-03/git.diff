+// newStaticScrapeConfigData returns scrape config data for jobName with the given number of static targets
+// and an optional max_scrape_targets override (0 means the option is omitted from the config).
+func newStaticScrapeConfigData(jobName string, targetsCount, maxScrapeTargets int) string {
+	targets := make([]string, targetsCount)
+	for i := range targets {
+		targets[i] = fmt.Sprintf("        - 127.0.0.1:%d", 10000+i)
+	}
+	maxScrapeTargetsLine := ""
+	if maxScrapeTargets > 0 {
+		maxScrapeTargetsLine = fmt.Sprintf("  max_scrape_targets: %d\n", maxScrapeTargets)
+	}
+	return fmt.Sprintf(`
+scrape_configs:
+- job_name: %s
+%s  static_configs:
+    - targets:
+%s`, jobName, maxScrapeTargetsLine, strings.Join(targets, "\n"))
+}
+
+// setUpScraperGroupForTargetsLimitTest parses cfgData, computes its static_configs ScrapeWork and feeds it
+// into a freshly created scraperGroup. It returns the running scraperGroup for inspection; the caller
+// must call the returned stop function once done.
+func setUpScraperGroupForTargetsLimitTest(t *testing.T, groupName, cfgData string) (sg *scraperGroup, stop func()) {
+	t.Helper()
+	pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+	stopCh := make(chan struct{})
+
+	var cfg Config
+	if err := cfg.parseData([]byte(cfgData), "test-scrape.yaml"); err != nil {
+		t.Fatalf("cannot parse config: %s", err)
+	}
+	sws := cfg.getStaticScrapeWork()
+
+	sg = newScraperGroup(groupName, pushData, stopCh)
+	sg.update(sws)
+	return sg, func() {
+		sg.stop()
+		close(stopCh)
+	}
+}
+
+func TestScraperGroupUpdateTargetsLimitUnderLimit(t *testing.T) {
+	const jobName = "targets_limit_under_test"
+	randName := rand.Int()
+	cfgData := newStaticScrapeConfigData(jobName, 3, 5)
+	sg, stop := setUpScraperGroupForTargetsLimitTest(t, fmt.Sprintf("static_configs_%d", randName), cfgData)
+	defer stop()
+
+	if len(sg.m) != 3 {
+		t.Fatalf("unexpected number of active scrapers; got %d; want 3", len(sg.m))
+	}
+	if !tsmGlobal.HasCapacity(jobName, 5) {
+		t.Fatalf("expected job %q to still have capacity under the limit", jobName)
+	}
+	if n := droppedTargetsMap.countByJobAndReason(jobName, targetDropReasonTargetsLimit); n != 0 {
+		t.Fatalf("unexpected number of targets dropped because of max_scrape_targets; got %d; want 0", n)
+	}
+}
+
+func TestScraperGroupUpdateTargetsLimitOverLimit(t *testing.T) {
+	const jobName = "targets_limit_over_test"
+	randName := rand.Int()
+	cfgData := newStaticScrapeConfigData(jobName, 5, 2)
+	sg, stop := setUpScraperGroupForTargetsLimitTest(t, fmt.Sprintf("static_configs_%d", randName), cfgData)
+	defer stop()
+
+	if len(sg.m) != 2 {
+		t.Fatalf("unexpected number of active scrapers; got %d; want 2 (truncated by max_scrape_targets)", len(sg.m))
+	}
+	if tsmGlobal.HasCapacity(jobName, 2) {
+		t.Fatalf("expected job %q to have no spare capacity once at the limit", jobName)
+	}
+	// The excess targets must be visible as dropped targets, e.g. at /service-discovery and /api/v1/targets,
+	// so operators can tell that job_name=%s is currently truncated because of the limit.
+	if n := droppedTargetsMap.countByJobAndReason(jobName, targetDropReasonTargetsLimit); n != 3 {
+		t.Fatalf("unexpected number of targets dropped because of max_scrape_targets; got %d; want 3", n)
+	}
+}
