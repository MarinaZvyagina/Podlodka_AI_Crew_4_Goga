+// HasCapacity reports whether jobName can accept one more active target without exceeding maxScrapeTargets.
+//
+// The check is performed against the total number of currently active targets for jobName across every
+// scraperGroup (i.e. regardless of which service discovery mechanism registered them), since a single job
+// can be fed by multiple service discovery mechanisms at once.
+//
+// maxScrapeTargets<=0 means no limit.
+func (tsm *targetStatusMap) HasCapacity(jobName string, maxScrapeTargets int) bool {
+	if maxScrapeTargets <= 0 {
+		return true
 	}
+	tsm.mu.Lock()
+	n := tsm.upByJob[jobName] + tsm.downByJob[jobName]
+	tsm.mu.Unlock()
+	return n < maxScrapeTargets
 }
 
