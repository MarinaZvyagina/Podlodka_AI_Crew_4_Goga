+				"zone": "fr-par-1",
+				"commercial_type": "DEV1-S",
+				"tags": ["mock", "tags"],
+				"public_ip": {"address": "51.15.0.1"},
+				"private_ip": "10.0.0.1"
+			}]
+		}`
+		return []byte(resp)
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		client:    client,
+		zone:      "fr-par-1",
+		secretKey: "fake-secret-key",
+	}
+
+	instances, err := getInstances(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+
+	if gotAuthToken != "fake-secret-key" {
+		t.Fatalf("unexpected X-Auth-Token header; got %q; want %q", gotAuthToken, "fake-secret-key")
+	}
+
+	expectedInstances := []Server{
+		{
+			ID:             "fake-id-07f7-4b68-88ac-fake-id",
+			Name:           "scaleway-sd",
+			Hostname:       "scaleway-sd",
+			Organization:   "fake-organization-id",
+			Project:        "fake-project-id",
+			State:          "running",
+			Zone:           "fr-par-1",
+			CommercialType: "DEV1-S",
+			Tags:           []string{"mock", "tags"},
+			PublicIP:       &ServerIP{Address: "51.15.0.1"},
+			PrivateIP:      "10.0.0.1",
+		},
+	}
+	if !reflect.DeepEqual(instances, expectedInstances) {
+		t.Fatalf("unexpected result\ngot\n%#v\nwant\n%#v", instances, expectedInstances)
+	}
+}
+
+func TestGetInstances_Failure(t *testing.T) {
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		return []byte("some error")
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		client: client,
+	}
+
+	if _, err := getInstances(cfg); err == nil {
+		t.Fatalf("expecting non-nil error from getInstances()")
+	}
+}
+
+func TestGetInstances_Paging(t *testing.T) {
+	requestCount := 0
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		requestCount++
+		if requestCount == 1 {
+			return []byte(mockListServersFullPageResp)
+		}
+		return []byte(mockListServersLastPageResp)
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		client: client,
+	}
+
+	instances, err := getInstances(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+	if len(instances) != perPage+1 {
+		t.Fatalf("unexpected number of instances; got %d; want %d", len(instances), perPage+1)
+	}
+}
+
+// mockListServersFullPageResp contains exactly `perPage` servers, signaling that another page follows.
+var mockListServersFullPageResp = buildServersPageResp(perPage, "page0")
+
+// mockListServersLastPageResp contains fewer than `perPage` servers, signaling the last page.
+var mockListServersLastPageResp = buildServersPageResp(1, "page1")
+
+func buildServersPageResp(count int, idPrefix string) string {
+	resp := `{"servers": [`
+	for i := 0; i < count; i++ {
+		if i > 0 {
+			resp += ","
+		}
+		resp += `{
+			"id": "` + idPrefix + `-server",
+			"name": "scaleway-sd",
+			"hostname": "scaleway-sd",
+			"state": "running",
+			"zone": "fr-par-1",
+			"commercial_type": "DEV1-S",
+			"tags": [],
+			"public_ip": {"address": "51.15.0.1"},
+			"private_ip": "10.0.0.1"
+		}`
+	}
+	resp += `]}`
+	return resp
+}
diff --git a/lib/promscrape/discovery/scaleway/mock_server_test.go b/lib/promscrape/discovery/scaleway/mock_server_test.go
