@@ -0,0 +1,58 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	sdc := &SDConfig{}
+	baseDir := "."
+	_, err := newAPIConfig(sdc, baseDir)
+	if err == nil {
+		t.Fatalf("expecting non-nil error")
+	}
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		SecretKey: &promauth.Secret{
+			S: "foobar",
+		},
+	}
+	baseDir := "."
+	cfg, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	if cfg.zone != "fr-par-1" {
+		t.Fatalf("unexpected default zone; got %q; want %q", cfg.zone, "fr-par-1")
+	}
+	if cfg.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want %d", cfg.port, 80)
+	}
+}
+
+func TestNewAPIConfig_SuccessWithFilters(t *testing.T) {
+	sdc := &SDConfig{
+		SecretKey: &promauth.Secret{
+			S: "foobar",
+		},
+		Zone:         "nl-ams-1",
+		Project:      "project-id",
+		Organization: "org-id",
+	}
+	baseDir := "."
+	cfg, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	if cfg.zone != "nl-ams-1" {
+		t.Fatalf("unexpected zone; got %q; want %q", cfg.zone, "nl-ams-1")
+	}
+	expectedQueryParams := "organization=org-id&project=project-id"
+	if cfg.listQueryParams != expectedQueryParams {
+		t.Fatalf("unexpected listQueryParams; got %q; want %q", cfg.listQueryParams, expectedQueryParams)
+	}
+}
diff --git a/lib/promscrape/discovery/scaleway/instance.go b/lib/promscrape/discovery/scaleway/instance.go
new file mode 100644
index 0000000..4e88b97
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/instance.go
@@ -0,0 +1,78 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+)
+
+// perPage is the maximum number of Instances requested per page.
+//
+// The Scaleway Instance API v1 doesn't return a total count or a "has more" flag for this
+// endpoint, so pagination is driven off whether a full page was returned.
+const perPage = 100
+
+// ListServersResponse is the response structure of the Scaleway list servers API.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type ListServersResponse struct {
+	Servers []Server `json:"servers"`
+}
+
+// Server represents a Scaleway Instance.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type Server struct {
+	ID             string    `json:"id"`
+	Name           string    `json:"name"`
+	Hostname       string    `json:"hostname"`
+	Organization   string    `json:"organization"`
+	Project        string    `json:"project"`
+	State          string    `json:"state"`
+	Zone           string    `json:"zone"`
+	CommercialType string    `json:"commercial_type"`
+	Tags           []string  `json:"tags"`
+	PublicIP       *ServerIP `json:"public_ip"`
+	PrivateIP      string    `json:"private_ip"`
+}
+
+// ServerIP represents a Scaleway Instance's public IP address.
+type ServerIP struct {
+	Address string `json:"address"`
+}
+
+// PublicIPAddress returns the server's public IP address, or an empty string if it has none.
+func (s *Server) PublicIPAddress() string {
+	if s.PublicIP == nil {
+		return ""
+	}
+	return s.PublicIP.Address
+}
+
+// getInstances retrieves the list of Instances from the Scaleway API.
+func getInstances(cfg *apiConfig) ([]Server, error) {
+	var servers []Server
+
+	page := 1
+	for {
+		// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?%s&page=%d&per_page=%d", cfg.zone, cfg.listQueryParams, page, perPage)
+		data, err := cfg.client.GetAPIResponseWithReqParams(path, cfg.setAuthHeader)
+		if err != nil {
+			return nil, fmt.Errorf("cannot get Scaleway response from %q: %w", path, err)
+		}
+
+		var resp ListServersResponse
+		if err := json.Unmarshal(data, &resp); err != nil {
+			return nil, fmt.Errorf("cannot unmarshal ListServersResponse obtained from %q: %w; response=%q", path, err, data)
+		}
+
+		servers = append(servers, resp.Servers...)
+
+		if len(resp.Servers) < perPage {
+			break
+		}
+		page++
+	}
+
+	return servers, nil
+}
