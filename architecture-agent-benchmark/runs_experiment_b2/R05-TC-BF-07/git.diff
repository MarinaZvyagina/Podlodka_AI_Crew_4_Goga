+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"reflect"
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+func TestGetInstances_Success(t *testing.T) {
+	s := newMockScalewayServer(func(_ *http.Request) (int, []byte) {
+		const resp = `{
+			"servers": [{
+				"id": "11111111-1111-1111-1111-111111111111",
+				"name": "scaleway-sd",
+				"organization": "22222222-2222-2222-2222-222222222222",
+				"project": "33333333-3333-3333-3333-333333333333",
+				"tags": ["env:prod", "app:vm"],
+				"commercial_type": "DEV1-S",
+				"state": "running",
+				"arch": "x86_64",
+				"zone": "fr-par-1",
+				"private_ip": "10.0.0.1",
+				"public_ip": {"address": "163.172.1.1"}
+			}]
+		}`
+		return http.StatusOK, []byte(resp)
+	})
+	defer s.Close()
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:         client,
+		secretKey: "fake-secret-key",
+		project:   "33333333-3333-3333-3333-333333333333",
+		zone:      "fr-par-1",
+	}
+
+	instances, err := getInstances(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+
+	expectedInstances := []Instance{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "scaleway-sd",
+			Organization:   "22222222-2222-2222-2222-222222222222",
+			Project:        "33333333-3333-3333-3333-333333333333",
+			Tags:           []string{"env:prod", "app:vm"},
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Arch:           "x86_64",
+			Zone:           "fr-par-1",
+			PrivateIP:      "10.0.0.1",
+			PublicIP:       &PublicIP{Address: "163.172.1.1"},
+		},
+	}
+	if !reflect.DeepEqual(instances, expectedInstances) {
+		t.Fatalf("unexpected result\ngot\n%#v\nwant\n%#v", instances, expectedInstances)
+	}
+}
+
+func TestGetInstances_Failure(t *testing.T) {
+	s := newMockScalewayServer(func(_ *http.Request) (int, []byte) {
+		return http.StatusInternalServerError, []byte("some error")
+	})
+	defer s.Close()
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c: client,
+	}
+
+	if _, err := getInstances(cfg); err == nil {
+		t.Fatalf("expecting non-nil error from getInstances()")
+	}
+}
+
+func TestGetInstances_Paging(t *testing.T) {
+	requestCount := 0
+	s := newMockScalewayServer(func(_ *http.Request) (int, []byte) {
+		requestCount++
+		if requestCount == 1 {
+			// First page is full, so getInstances() must request a second page.
+			return http.StatusOK, mustMarshalServers(instancesPerPage, "page0-")
+		}
+		// Second page is short, so getInstances() must stop after it.
+		return http.StatusOK, mustMarshalServers(1, "page1-")
+	})
+	defer s.Close()
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c: client,
+	}
+
+	instances, err := getInstances(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+	if requestCount != 2 {
+		t.Fatalf("unexpected number of requests; got %d; want 2", requestCount)
+	}
+	if len(instances) != instancesPerPage+1 {
+		t.Fatalf("unexpected number of instances; got %d; want %d", len(instances), instancesPerPage+1)
+	}
+	if instances[0].ID != "page0-0" {
+		t.Fatalf("unexpected id for the first instance; got %q; want %q", instances[0].ID, "page0-0")
+	}
+	if last := instances[len(instances)-1]; last.ID != "page1-0" {
+		t.Fatalf("unexpected id for the last instance; got %q; want %q", last.ID, "page1-0")
+	}
+}
+
+func TestGetInstances_AuthHeader(t *testing.T) {
+	var gotToken string
+	s := newMockScalewayServer(func(r *http.Request) (int, []byte) {
+		gotToken = r.Header.Get("X-Auth-Token")
+		return http.StatusOK, []byte(`{"servers": []}`)
+	})
+	defer s.Close()
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:         client,
+		secretKey: "my-secret-key",
+	}
+
+	if _, err := getInstances(cfg); err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+	if gotToken != "my-secret-key" {
+		t.Fatalf("unexpected X-Auth-Token header; got %q; want %q", gotToken, "my-secret-key")
+	}
+}
+
+func mustMarshalServers(n int, idPrefix string) []byte {
+	servers := make([]Instance, n)
+	for i := 0; i < n; i++ {
+		servers[i] = Instance{
+			ID:    fmt.Sprintf("%s%d", idPrefix, i),
+			Name:  "scaleway-sd",
+			Zone:  "fr-par-1",
+			State: "running",
+		}
+	}
+	data, err := json.Marshal(ListServersResponse{Servers: servers})
+	if err != nil {
+		panic(fmt.Sprintf("BUG: cannot marshal test data: %s", err))
+	}
+	return data
+}
diff --git a/lib/promscrape/discovery/scaleway/mock_server_test.go b/lib/promscrape/discovery/scaleway/mock_server_test.go
new file mode 100644
index 0000000..c10ba1b
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/mock_server_test.go
@@ -0,0 +1,24 @@
+package scaleway
+
+import (
+	"net/http"
+	"net/http/httptest"
+)
+
+type mockScalewayServer struct {
+	*httptest.Server
+	responseFunc func(r *http.Request) (int, []byte)
+}
+
+func newMockScalewayServer(responseFunc func(r *http.Request) (int, []byte)) *mockScalewayServer {
+	var s mockScalewayServer
+	s.responseFunc = responseFunc
+	s.Server = httptest.NewServer(http.HandlerFunc(s.handler))
+	return &s
+}
+
+func (s *mockScalewayServer) handler(w http.ResponseWriter, r *http.Request) {
+	statusCode, data := s.responseFunc(r)
+	w.WriteHeader(statusCode)
+	_, _ = w.Write(data)
+}
