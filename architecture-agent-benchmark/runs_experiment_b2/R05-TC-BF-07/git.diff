+			"__meta_scaleway_instance_state":           "stopped",
+			"__meta_scaleway_instance_arch":            "x86_64",
+			"__meta_scaleway_instance_organization_id": "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_project_id":      "33333333-3333-3333-3333-333333333333",
+			"__meta_scaleway_instance_private_ipv4":    "10.0.0.2",
+		}),
+	}
+
+	labels := getInstanceLabels(input, 8080)
+	discoveryutil.TestEqualLabelss(t, labels, expect)
+}
+
+func TestRegionFromZone(t *testing.T) {
+	f := func(zone, expected string) {
+		t.Helper()
+		if got := regionFromZone(zone); got != expected {
+			t.Fatalf("unexpected region for zone %q; got %q; want %q", zone, got, expected)
+		}
+	}
+	f("fr-par-1", "fr-par")
+	f("nl-ams-2", "nl-ams")
+	f("no-zone-format", "no-zone")
+	f("", "")
+}
