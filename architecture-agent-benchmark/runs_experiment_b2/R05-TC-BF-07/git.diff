+			"__meta_scaleway_instance_organization_id": "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_project_id":      "33333333-3333-3333-3333-333333333333",
+			"__meta_scaleway_instance_private_ipv4":    "10.0.0.1",
