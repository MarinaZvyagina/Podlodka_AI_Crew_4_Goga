+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/url"
+)
+
+// instancesPerPage is the maximum number of Instances requested per API call.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+const instancesPerPage = 100
+
+// ListServersResponse is the response structure of the Scaleway Instance "list servers" API.
+type ListServersResponse struct {
+	Servers []Instance `json:"servers"`
+}
+
+// PublicIP represents a Scaleway Instance public IP address.
+type PublicIP struct {
+	Address string `json:"address"`
+}
+
+// Instance represents a Scaleway Instance.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type Instance struct {
+	ID             string    `json:"id"`
+	Name           string    `json:"name"`
+	Organization   string    `json:"organization"`
+	Project        string    `json:"project"`
+	Tags           []string  `json:"tags"`
+	CommercialType string    `json:"commercial_type"`
+	State          string    `json:"state"`
+	Arch           string    `json:"arch"`
+	Zone           string    `json:"zone"`
+	PrivateIP      string    `json:"private_ip"`
+	PublicIP       *PublicIP `json:"public_ip"`
+}
+
+// getInstances retrieves the list of Instances from the Scaleway Instance API.
+func getInstances(cfg *apiConfig) ([]Instance, error) {
+	setAuthHeader := func(req *http.Request) {
+		// Scaleway API authentication uses a static secret key sent via the X-Auth-Token header.
+		// See https://www.scaleway.com/en/developers/api/#authentication
+		req.Header.Set("X-Auth-Token", cfg.secretKey)
+	}
+
+	var instances []Instance
+
+	// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+	path := fmt.Sprintf("/instance/v1/zones/%s/servers?project=%s&per_page=%d",
+		url.PathEscape(cfg.zone), url.QueryEscape(cfg.project), instancesPerPage)
+
+	for page := 1; ; page++ {
+		pagePath := fmt.Sprintf("%s&page=%d", path, page)
+
+		data, err := cfg.c.GetAPIResponseWithReqParams(pagePath, setAuthHeader)
+		if err != nil {
+			return nil, fmt.Errorf("cannot get Scaleway response from %q: %w", pagePath, err)
+		}
+
+		var resp ListServersResponse
+		if err := json.Unmarshal(data, &resp); err != nil {
+			return nil, fmt.Errorf("cannot unmarshal ListServersResponse obtained from %q: %w; response=%q", pagePath, err, data)
+		}
+
+		instances = append(instances, resp.Servers...)
+
+		if len(resp.Servers) < instancesPerPage {
+			break
+		}
+	}
+
+	return instances, nil
+}
