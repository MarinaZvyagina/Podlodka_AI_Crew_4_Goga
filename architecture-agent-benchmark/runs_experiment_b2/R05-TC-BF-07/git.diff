+			"__address__":                              "10.0.0.2:8080",
+			"__meta_scaleway_instance_id":              "44444444-4444-4444-4444-444444444444",
+			"__meta_scaleway_instance_name":            "scaleway-sd-private",
+			"__meta_scaleway_instance_zone":            "nl-ams-2",
+			"__meta_scaleway_instance_region":          "nl-ams",
