diff --git a/lib/promscrape/discovery/scaleway/api.go b/lib/promscrape/discovery/scaleway/api.go
new file mode 100644
index 0000000..1f0ad33
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api.go
@@ -0,0 +1,179 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/url"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+var configMap = discoveryutil.NewConfigMap()
+
+// defaultZones is the list of Scaleway zones queried when SDConfig.Zones is empty.
+//
+// See https://www.scaleway.com/en/developers/api/#regions-and-zones
+var defaultZones = []string{
+	"fr-par-1", "fr-par-2", "fr-par-3",
+	"nl-ams-1", "nl-ams-2", "nl-ams-3",
+	"pl-waw-1", "pl-waw-2", "pl-waw-3",
+}
+
+// apiConfig contains config for Scaleway API.
+type apiConfig struct {
+	client *discoveryutil.Client
+
+	secretKey    string
+	project      string
+	organization string
+	zones        []string
+	port         int
+}
+
+func getAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	v, err := configMap.Get(sdc, func() (any, error) { return newAPIConfig(sdc, baseDir) })
+	if err != nil {
+		return nil, err
+	}
+	return v.(*apiConfig), nil
+}
+
+func newAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	if sdc.Project == "" && sdc.Organization == "" {
+		return nil, fmt.Errorf("missing `project` or `organization` option")
+	}
+	if sdc.SecretKey == nil {
+		return nil, fmt.Errorf("missing `secret_key` option")
+	}
+
+	apiServer := sdc.APIURL
+	if apiServer == "" {
+		apiServer = "https://api.scaleway.com"
+	}
+
+	zones := sdc.Zones
+	if len(zones) == 0 {
+		zones = defaultZones
+	}
+
+	ac, err := sdc.HTTPClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse auth config: %w", err)
+	}
+	proxyAC, err := sdc.ProxyClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse proxy auth config: %w", err)
+	}
+	client, err := discoveryutil.NewClient(apiServer, ac, sdc.ProxyURL, proxyAC, &sdc.HTTPClientConfig)
+	if err != nil {
+		return nil, fmt.Errorf("cannot create HTTP client for %q: %w", apiServer, err)
+	}
+
+	port := sdc.Port
+	if port == 0 {
+		port = 80
+	}
+
+	cfg := &apiConfig{
+		client: client,
+
+		secretKey:    sdc.SecretKey.String(),
+		project:      sdc.Project,
+		organization: sdc.Organization,
+		zones:        zones,
+		port:         port,
+	}
+	return cfg, nil
+}
+
+// Server represents a Scaleway Instance returned by the List Servers API.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type Server struct {
+	ID             string    `json:"id"`
+	Name           string    `json:"name"`
+	Hostname       string    `json:"hostname"`
+	Organization   string    `json:"organization"`
+	Project        string    `json:"project"`
+	CommercialType string    `json:"commercial_type"`
+	State          string    `json:"state"`
+	Tags           []string  `json:"tags"`
+	PrivateIP      *string   `json:"private_ip"`
+	PublicIP       *PublicIP `json:"public_ip"`
+
+	// Zone isn't always returned by the API for every request path, so it is explicitly
+	// set to the zone used for the request instead of relying on this field.
+	Zone string `json:"zone"`
+}
+
+// PublicIP represents the public IP address attached to a Scaleway Instance.
+type PublicIP struct {
+	ID      string `json:"id"`
+	Address string `json:"address"`
+	Dynamic bool   `json:"dynamic"`
+}
+
+// listServersResponse is the response of the Scaleway List Servers API.
+type listServersResponse struct {
+	Servers []Server `json:"servers"`
+}
+
+const serversPerPage = 100
+
+// getServers returns all the Scaleway instances visible to cfg across all the configured zones.
+func getServers(cfg *apiConfig) ([]Server, error) {
+	var servers []Server
+	for _, zone := range cfg.zones {
+		zoneServers, err := getServersByZone(cfg, zone)
+		if err != nil {
+			return nil, err
+		}
+		servers = append(servers, zoneServers...)
+	}
+	return servers, nil
+}
+
+func getServersByZone(cfg *apiConfig, zone string) ([]Server, error) {
+	var servers []Server
+	for page := 1; ; page++ {
+		qp := url.Values{}
+		qp.Set("page", fmt.Sprintf("%d", page))
+		qp.Set("per_page", fmt.Sprintf("%d", serversPerPage))
+		if cfg.project != "" {
+			qp.Set("project", cfg.project)
+		}
+		if cfg.organization != "" {
+			qp.Set("organization", cfg.organization)
+		}
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?%s", url.PathEscape(zone), qp.Encode())
+
+		data, err := cfg.client.GetAPIResponseWithReqParams(path, func(req *http.Request) {
+			req.Header.Set("X-Auth-Token", cfg.secretKey)
+		})
+		if err != nil {
+			return nil, fmt.Errorf("cannot query Scaleway API for servers in zone %q: %w", zone, err)
+		}
+		resp, err := parseServersResponse(data)
+		if err != nil {
+			return nil, fmt.Errorf("cannot parse Scaleway servers response for zone %q: %w", zone, err)
+		}
+		for i := range resp.Servers {
+			resp.Servers[i].Zone = zone
+		}
+		servers = append(servers, resp.Servers...)
+
+		if len(resp.Servers) < serversPerPage {
+			break
+		}
+	}
+	return servers, nil
+}
+
+func parseServersResponse(data []byte) (*listServersResponse, error) {
+	var resp listServersResponse
+	if err := json.Unmarshal(data, &resp); err != nil {
+		return nil, fmt.Errorf("failed to parse Scaleway servers list response: %q: %w", data, err)
+	}
+	return &resp, nil
+}
