+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func strPtr(s string) *string {
+	return &s
+}
+
+func TestAddServerLabels(t *testing.T) {
+	f := func(servers []Server, port int, labelssExpected []*promutil.Labels) {
+		t.Helper()
+
+		labelss := addServerLabels(servers, port)
+		discoveryutil.TestEqualLabelss(t, labelss, labelssExpected)
+	}
+
+	servers := []Server{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "my-instance",
+			Hostname:       "my-instance",
+			Organization:   "22222222-2222-2222-2222-222222222222",
+			Project:        "33333333-3333-3333-3333-333333333333",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Zone:           "fr-par-1",
+			Tags:           []string{"foo", "bar"},
+			PrivateIP:      strPtr("10.0.0.1"),
+			PublicIP: &PublicIP{
+				ID:      "44444444-4444-4444-4444-444444444444",
+				Address: "163.172.1.2",
+				Dynamic: false,
+			},
+		},
+		{
+			// server without a public IP - private IP must be used for __address__.
+			ID:             "55555555-5555-5555-5555-555555555555",
+			Name:           "private-only",
+			Hostname:       "private-only",
+			Project:        "33333333-3333-3333-3333-333333333333",
+			CommercialType: "DEV1-M",
+			State:          "stopped",
+			Zone:           "nl-ams-1",
+			PrivateIP:      strPtr("10.0.0.2"),
+		},
+		{
+			// server without any IP address must be skipped.
+			ID:    "66666666-6666-6666-6666-666666666666",
+			Name:  "no-ip",
+			Zone:  "fr-par-1",
+			State: "stopped",
+		},
+	}
+
+	labelssExpected := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                           "163.172.1.2:9100",
+			"__meta_scaleway_instance_id":           "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":         "my-instance",
+			"__meta_scaleway_instance_hostname":     "my-instance",
+			"__meta_scaleway_instance_zone":         "fr-par-1",
+			"__meta_scaleway_instance_type":         "DEV1-S",
+			"__meta_scaleway_instance_state":        "running",
+			"__meta_scaleway_instance_project":      "33333333-3333-3333-3333-333333333333",
+			"__meta_scaleway_instance_organization": "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_private_ipv4": "10.0.0.1",
+			"__meta_scaleway_instance_public_ipv4":  "163.172.1.2",
+			"__meta_scaleway_instance_tags":         ",foo,bar,",
+		}),
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                           "10.0.0.2:9100",
+			"__meta_scaleway_instance_id":           "55555555-5555-5555-5555-555555555555",
+			"__meta_scaleway_instance_name":         "private-only",
+			"__meta_scaleway_instance_hostname":     "private-only",
+			"__meta_scaleway_instance_zone":         "nl-ams-1",
+			"__meta_scaleway_instance_type":         "DEV1-M",
+			"__meta_scaleway_instance_state":        "stopped",
+			"__meta_scaleway_instance_project":      "33333333-3333-3333-3333-333333333333",
+			"__meta_scaleway_instance_organization": "",
+			"__meta_scaleway_instance_private_ipv4": "10.0.0.2",
+			"__meta_scaleway_instance_public_ipv4":  "",
+		}),
+	}
+	f(servers, 9100, labelssExpected)
+}
