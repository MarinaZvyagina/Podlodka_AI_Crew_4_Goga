@@ -0,0 +1,115 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	f := func(sdc *SDConfig) {
+		t.Helper()
+
+		_, err := newAPIConfig(sdc, ".")
+		if err == nil {
+			t.Fatalf("expecting non-nil error")
+		}
+	}
+
+	// Missing project and organization.
+	f(&SDConfig{
+		SecretKey: promauth.NewSecret("some-secret"),
+	})
+
+	// Missing secret_key.
+	f(&SDConfig{
+		Project: "some-project",
+	})
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		Project:   "some-project",
+		SecretKey: promauth.NewSecret("some-secret"),
+	}
+	cfg, err := newAPIConfig(sdc, ".")
+	if err != nil {
+		t.Fatalf("newAPIConfig() failed unexpectedly: %s", err)
+	}
+	if cfg.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want 80", cfg.port)
+	}
+	if len(cfg.zones) != len(defaultZones) {
+		t.Fatalf("unexpected default zones count; got %d; want %d", len(cfg.zones), len(defaultZones))
+	}
+}
+
+func TestGetServers(t *testing.T) {
+	// The mock server serves two zones. The first zone returns a full page (serversPerPage
+	// servers) followed by a second, partial page, in order to exercise pagination. The
+	// second zone returns a single, partial page.
+	s := newMockScalewayServer(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("X-Auth-Token") != "some-secret" {
+			http.Error(w, "missing or invalid X-Auth-Token header", http.StatusUnauthorized)
+			return
+		}
+		if r.URL.Query().Get("project") != "some-project" {
+			http.Error(w, "missing project query param", http.StatusBadRequest)
+			return
+		}
+
+		var resp listServersResponse
+		switch {
+		case r.URL.Path == "/instance/v1/zones/fr-par-1/servers" && r.URL.Query().Get("page") == "1":
+			resp.Servers = make([]Server, serversPerPage)
+			for i := range resp.Servers {
+				resp.Servers[i] = Server{ID: fmt.Sprintf("fr-par-1-%d", i)}
+			}
+		case r.URL.Path == "/instance/v1/zones/fr-par-1/servers" && r.URL.Query().Get("page") == "2":
+			resp.Servers = []Server{{ID: "fr-par-1-last"}}
+		case r.URL.Path == "/instance/v1/zones/nl-ams-1/servers" && r.URL.Query().Get("page") == "1":
+			resp.Servers = []Server{{ID: "nl-ams-1-only"}}
+		default:
+			http.Error(w, fmt.Sprintf("unexpected request: %s", r.URL), http.StatusNotFound)
+			return
+		}
+
+		data, err := json.Marshal(resp)
+		if err != nil {
+			t.Fatalf("cannot marshal response: %s", err)
+		}
+		w.Write(data)
+	})
+	defer s.Close()
+
+	sdc := &SDConfig{
+		Project:   "some-project",
+		SecretKey: promauth.NewSecret("some-secret"),
+		APIURL:    s.URL,
+		Zones:     []string{"fr-par-1", "nl-ams-1"},
+	}
+	cfg, err := newAPIConfig(sdc, ".")
+	if err != nil {
+		t.Fatalf("newAPIConfig() failed unexpectedly: %s", err)
+	}
+
+	servers, err := getServers(cfg)
+	if err != nil {
+		t.Fatalf("getServers() failed unexpectedly: %s", err)
+	}
+	if len(servers) != serversPerPage+2 {
+		t.Fatalf("unexpected servers count; got %d; want %d", len(servers), serversPerPage+2)
+	}
+	for _, server := range servers {
+		wantZone := "fr-par-1"
+		if server.ID == "nl-ams-1-only" {
+			wantZone = "nl-ams-1"
+		}
+		if server.Zone != wantZone {
+			t.Fatalf("unexpected zone for server %q; got %q; want %q", server.ID, server.Zone, wantZone)
+		}
+	}
+}
