+// testGenerateMetricRowsForNames generates rowsPerName rows for each metric
+// name in names, each row belonging to a distinct series (unique "instance" tag).
+func testGenerateMetricRowsForNames(rng *rand.Rand, rowsPerName int, names []string, tr TimeRange) []MetricRow {
+	var mrs []MetricRow
+	var mn MetricName
+	for _, name := range names {
+		mn.MetricGroup = []byte(name)
+		for i := range rowsPerName {
+			mn.Tags = []Tag{
+				{[]byte("job"), []byte("webservice")},
+				{[]byte("instance"), fmt.Appendf(nil, "%d", i)},
+			}
+			metricNameRaw := mn.marshalRaw(nil)
+			timestamp := rng.Int63n(tr.MaxTimestamp-tr.MinTimestamp) + tr.MinTimestamp
+			value := rng.NormFloat64() * 1e6
+			mrs = append(mrs, MetricRow{
+				MetricNameRaw: metricNameRaw,
+				Timestamp:     timestamp,
+				Value:         value,
+			})
+		}
+	}
+	return mrs
+}
