+// GetDroppedSeriesNamesStats returns up to topN metric names with the
+// highest number of samples dropped since storage start or the last call to
+// ResetDroppedSeriesNamesStats, because adding the corresponding series
+// would have exceeded -storage.maxHourlySeries or -storage.maxDailySeries.
+//
+// It returns a zero-value Stats when -storage.maxDroppedSeriesNames tracking
+// is disabled.
+func (s *Storage) GetDroppedSeriesNamesStats(topN int) droppedseries.Stats {
+	return s.droppedSeriesTracker.GetTop(topN)
+}
+
+// ResetDroppedSeriesNamesStats resets the stats collected for
+// GetDroppedSeriesNamesStats.
+func (s *Storage) ResetDroppedSeriesNamesStats() {
+	s.droppedSeriesTracker.Reset()
+}
