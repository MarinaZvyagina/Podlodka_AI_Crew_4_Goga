diff --git a/lib/storage/droppedseries/tracker.go b/lib/storage/droppedseries/tracker.go
new file mode 100644
index 0000000..5ace2f2
--- /dev/null
+++ b/lib/storage/droppedseries/tracker.go
@@ -0,0 +1,170 @@
+// Package droppedseries provides a memory-bounded tracker for the metric
+// names responsible for samples dropped by lib/storage because adding the
+// corresponding series would have exceeded -storage.maxHourlySeries or
+// -storage.maxDailySeries.
+package droppedseries
+
+import (
+	"sort"
+	"sync"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+// DefaultMaxTrackedNames is used by NewTracker when maxTrackedNames <= 0.
+const DefaultMaxTrackedNames = 1000
+
+// Tracker tracks, per metric name, how many samples were dropped because
+// adding the corresponding series would have exceeded a configured
+// hourly/daily unique-series limit.
+//
+// Memory usage is bounded by maxTrackedNames: once that many distinct
+// metric names are being tracked, Add for any additional, not-yet-seen
+// metric name is counted towards Overflow instead of growing the tracked
+// set further. This keeps the tracker's memory usage bounded regardless of
+// how many distinct metric names are seen, e.g. during a cardinality
+// explosion involving many unrelated metric names.
+type Tracker struct {
+	maxTrackedNames int
+
+	mu       sync.Mutex
+	counts   map[string]uint64
+	overflow uint64
+	sinceTs  uint64
+}
+
+// NewTracker creates a Tracker, which tracks drop counts for at most
+// maxTrackedNames distinct metric names. If maxTrackedNames <= 0, then
+// DefaultMaxTrackedNames is used.
+func NewTracker(maxTrackedNames int) *Tracker {
+	if maxTrackedNames <= 0 {
+		maxTrackedNames = DefaultMaxTrackedNames
+	}
+	t := &Tracker{
+		maxTrackedNames: maxTrackedNames,
+	}
+	t.resetLocked()
+	return t
+}
+
+// Add records a single dropped sample for the given metricName.
+//
+// It is safe calling Add from concurrent goroutines. Add is a no-op when t
+// is nil, so callers can keep an always-valid *Tracker field that is simply
+// nil when the feature is disabled.
+func (t *Tracker) Add(metricName string) {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if _, ok := t.counts[metricName]; ok {
+		t.counts[metricName]++
+		return
+	}
+	if len(t.counts) >= t.maxTrackedNames {
+		t.overflow++
+		return
+	}
+	t.counts[metricName] = 1
+}
+
+// Entry is a single (metric name, drop count) pair.
+type Entry struct {
+	MetricName string
+	DropCount  uint64
+}
+
+// Stats is the result of GetTop.
+type Stats struct {
+	// SinceTs is the unix timestamp of the Tracker creation or of the last Reset call.
+	SinceTs uint64
+
+	// TrackedNames is the number of distinct metric names currently tracked.
+	TrackedNames int
+
+	// MaxTrackedNames is the maxTrackedNames value passed to NewTracker.
+	MaxTrackedNames int
+
+	// Overflow is the number of dropped samples for metric names, which
+	// could not be tracked individually because the tracker was full.
+	// A non-zero Overflow means the reported Entries may be missing some
+	// offending metric names; consider increasing maxTrackedNames.
+	Overflow uint64
+
+	// Entries holds up to topN tracked metric names sorted by DropCount
+	// in descending order.
+	Entries []Entry
+}
+
+// GetTop returns the Stats for at most topN tracked metric names with the
+// highest drop counts recorded since the tracker was created or last Reset.
+//
+// If topN <= 0, all the tracked entries are returned.
+func (t *Tracker) GetTop(topN int) Stats {
+	if t == nil {
+		return Stats{}
+	}
+	t.mu.Lock()
+	stats := Stats{
+		SinceTs:         t.sinceTs,
+		TrackedNames:    len(t.counts),
+		MaxTrackedNames: t.maxTrackedNames,
+		Overflow:        t.overflow,
+		Entries:         make([]Entry, 0, len(t.counts)),
+	}
+	for name, count := range t.counts {
+		stats.Entries = append(stats.Entries, Entry{
+			MetricName: name,
+			DropCount:  count,
+		})
+	}
+	t.mu.Unlock()
+
+	sort.Slice(stats.Entries, func(i, j int) bool {
+		if stats.Entries[i].DropCount != stats.Entries[j].DropCount {
+			return stats.Entries[i].DropCount > stats.Entries[j].DropCount
+		}
+		return stats.Entries[i].MetricName < stats.Entries[j].MetricName
+	})
+	if topN > 0 && topN < len(stats.Entries) {
+		stats.Entries = stats.Entries[:topN]
+	}
+	return stats
+}
+
+// Reset clears all the tracked counts and sets Stats.SinceTs to the current time.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.resetLocked()
+	t.mu.Unlock()
+}
+
+func (t *Tracker) resetLocked() {
+	t.counts = make(map[string]uint64)
+	t.overflow = 0
+	t.sinceTs = fasttime.UnixTimestamp()
+}
+
+// TrackerMetrics holds internal Tracker metrics for exposing at /metrics.
+type TrackerMetrics struct {
+	TrackedNames    uint64
+	MaxTrackedNames uint64
+	OverflowDrops   uint64
+}
+
+// UpdateMetrics writes internal metrics of t to dst.
+func (t *Tracker) UpdateMetrics(dst *TrackerMetrics) {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	dst.TrackedNames = uint64(len(t.counts))
+	dst.OverflowDrops = t.overflow
+	t.mu.Unlock()
+	dst.MaxTrackedNames = uint64(t.maxTrackedNames)
+}
diff --git a/lib/storage/droppedseries/tracker_test.go b/lib/storage/droppedseries/tracker_test.go
new file mode 100644
index 0000000..0817ef9
--- /dev/null
+++ b/lib/storage/droppedseries/tracker_test.go
@@ -0,0 +1,174 @@
+package droppedseries
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestTracker_MultipleMetricNames(t *testing.T) {
+	tr := NewTracker(100)
+
+	tr.Add("metric_a")
+	tr.Add("metric_a")
+	tr.Add("metric_a")
+	tr.Add("metric_b")
+	tr.Add("metric_b")
+	tr.Add("metric_c")
+
+	stats := tr.GetTop(0)
+	if stats.TrackedNames != 3 {
+		t.Fatalf("unexpected TrackedNames; got %d; want 3", stats.TrackedNames)
+	}
+	if stats.Overflow != 0 {
+		t.Fatalf("unexpected Overflow; got %d; want 0", stats.Overflow)
+	}
+	want := map[string]uint64{
+		"metric_a": 3,
+		"metric_b": 2,
+		"metric_c": 1,
+	}
+	if len(stats.Entries) != len(want) {
+		t.Fatalf("unexpected number of entries; got %d; want %d", len(stats.Entries), len(want))
+	}
+	for _, e := range stats.Entries {
+		if want[e.MetricName] != e.DropCount {
+			t.Fatalf("unexpected DropCount for %q; got %d; want %d", e.MetricName, e.DropCount, want[e.MetricName])
+		}
+	}
+}
+
+func TestTracker_GetTop(t *testing.T) {
+	tr := NewTracker(100)
+
+	tr.Add("least")
+	for i := 0; i < 2; i++ {
+		tr.Add("middle")
+	}
+	for i := 0; i < 5; i++ {
+		tr.Add("most")
+	}
+
+	stats := tr.GetTop(2)
+	if len(stats.Entries) != 2 {
+		t.Fatalf("unexpected number of entries; got %d; want 2", len(stats.Entries))
+	}
+	if stats.Entries[0].MetricName != "most" || stats.Entries[0].DropCount != 5 {
+		t.Fatalf("unexpected top entry: %+v", stats.Entries[0])
+	}
+	if stats.Entries[1].MetricName != "middle" || stats.Entries[1].DropCount != 2 {
+		t.Fatalf("unexpected second entry: %+v", stats.Entries[1])
+	}
+
+	// topN <= 0 must return all the tracked entries.
+	statsAll := tr.GetTop(0)
+	if len(statsAll.Entries) != 3 {
+		t.Fatalf("unexpected number of entries for topN=0; got %d; want 3", len(statsAll.Entries))
+	}
+}
+
+func TestTracker_MemoryBoundRespected(t *testing.T) {
+	const maxNames = 10
+	tr := NewTracker(maxNames)
+
+	for i := 0; i < 1000; i++ {
+		tr.Add(fmt.Sprintf("metric_%d", i))
+	}
+
+	stats := tr.GetTop(0)
+	if stats.TrackedNames != maxNames {
+		t.Fatalf("unexpected TrackedNames; got %d; want %d", stats.TrackedNames, maxNames)
+	}
+	if len(stats.Entries) != maxNames {
+		t.Fatalf("unexpected number of entries; got %d; want %d", len(stats.Entries), maxNames)
+	}
+	wantOverflow := uint64(1000 - maxNames)
+	if stats.Overflow != wantOverflow {
+		t.Fatalf("unexpected Overflow; got %d; want %d", stats.Overflow, wantOverflow)
+	}
+
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+	if tm.TrackedNames != maxNames {
+		t.Fatalf("unexpected TrackerMetrics.TrackedNames; got %d; want %d", tm.TrackedNames, maxNames)
+	}
+	if tm.MaxTrackedNames != maxNames {
+		t.Fatalf("unexpected TrackerMetrics.MaxTrackedNames; got %d; want %d", tm.MaxTrackedNames, maxNames)
+	}
+	if tm.OverflowDrops != wantOverflow {
+		t.Fatalf("unexpected TrackerMetrics.OverflowDrops; got %d; want %d", tm.OverflowDrops, wantOverflow)
+	}
+}
+
+func TestTracker_MemoryBoundRespectedConcurrent(t *testing.T) {
+	const maxNames = 20
+	tr := NewTracker(maxNames)
+
+	var wg sync.WaitGroup
+	for g := 0; g < 10; g++ {
+		wg.Add(1)
+		go func(g int) {
+			defer wg.Done()
+			for i := 0; i < 500; i++ {
+				tr.Add(fmt.Sprintf("g%d_metric_%d", g, i))
+			}
+		}(g)
+	}
+	wg.Wait()
+
+	stats := tr.GetTop(0)
+	if stats.TrackedNames > maxNames {
+		t.Fatalf("TrackedNames exceeded the configured bound; got %d; want <= %d", stats.TrackedNames, maxNames)
+	}
+	if len(stats.Entries) > maxNames {
+		t.Fatalf("Entries exceeded the configured bound; got %d; want <= %d", len(stats.Entries), maxNames)
+	}
+}
+
+func TestTracker_DefaultMaxTrackedNames(t *testing.T) {
+	tr := NewTracker(0)
+	if tr.maxTrackedNames != DefaultMaxTrackedNames {
+		t.Fatalf("unexpected maxTrackedNames; got %d; want %d", tr.maxTrackedNames, DefaultMaxTrackedNames)
+	}
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(10)
+	tr.Add("metric_a")
+	tr.Add("metric_b")
+
+	stats := tr.GetTop(0)
+	if stats.TrackedNames != 2 {
+		t.Fatalf("unexpected TrackedNames before reset; got %d; want 2", stats.TrackedNames)
+	}
+
+	tr.Reset()
+
+	stats = tr.GetTop(0)
+	if stats.TrackedNames != 0 {
+		t.Fatalf("unexpected TrackedNames after reset; got %d; want 0", stats.TrackedNames)
+	}
+	if len(stats.Entries) != 0 {
+		t.Fatalf("unexpected Entries after reset; got %d; want 0", len(stats.Entries))
+	}
+	if stats.Overflow != 0 {
+		t.Fatalf("unexpected Overflow after reset; got %d; want 0", stats.Overflow)
+	}
+}
+
+func TestTracker_NilTrackerIsNoOp(t *testing.T) {
+	var tr *Tracker
+	tr.Add("metric_a")
+	tr.Reset()
+
+	stats := tr.GetTop(10)
+	if stats.TrackedNames != 0 || len(stats.Entries) != 0 {
+		t.Fatalf("unexpected non-empty stats from a nil tracker: %+v", stats)
+	}
+
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+	if tm != (TrackerMetrics{}) {
+		t.Fatalf("unexpected non-empty metrics from a nil tracker: %+v", tm)
+	}
+}
diff --git a/lib/storage/metric_name.go b/lib/storage/metric_name.go
index e4feb6f..63e486d 100644
--- a/lib/storage/metric_name.go
+++ b/lib/storage/metric_name.go
@@ -521,6 +521,32 @@ func (mn *MetricName) UnmarshalRaw(src []byte) error {
 	return nil
 }
 
+// getMetricGroupFromRaw extracts only the metric name (MetricGroup) from src,
+// which must be encoded with MarshalMetricNameRaw.
+//
+// This is a cheaper alternative to MetricName.UnmarshalRaw for the case when
+// only the metric name is needed: it avoids populating the tags slice.
+func getMetricGroupFromRaw(src []byte) (string, error) {
+	for len(src) > 0 {
+		tail, key, err := unmarshalBytesFast(src)
+		if err != nil {
+			return "", fmt.Errorf("cannot decode key: %w", err)
+		}
+		src = tail
+
+		tail, value, err := unmarshalBytesFast(src)
+		if err != nil {
+			return "", fmt.Errorf("cannot decode value: %w", err)
+		}
+		src = tail
+
+		if len(key) == 0 {
+			return string(value), nil
+		}
+	}
+	return "", nil
+}
+
