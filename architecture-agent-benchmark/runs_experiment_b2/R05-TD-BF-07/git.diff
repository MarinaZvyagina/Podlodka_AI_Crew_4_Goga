+func TestStorageRowsNotAdded_DroppedSeriesNamesTracked(t *testing.T) {
+	defer testRemoveAll(t)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	tr := TimeRange{minTimestamp, maxTimestamp}
+
+	t.Run("TopOffendersAcrossMultipleNames", func(t *testing.T) {
+		const (
+			maxHourlySeries = 50
+			rowsPerName     = 100
+		)
+		names := []string{"metric_a", "metric_b", "metric_c"}
+		mrs := testGenerateMetricRowsForNames(rng, rowsPerName, names, tr)
+
+		s := MustOpenStorage(t.Name(), OpenOptions{
+			MaxHourlySeries:       maxHourlySeries,
+			MaxDroppedSeriesNames: 10,
+		})
+		defer s.MustClose()
+
+		s.AddRows(mrs, defaultPrecisionBits)
+		s.DebugFlush()
+
+		var m Metrics
+		s.UpdateMetrics(&m)
+		if m.HourlySeriesLimitRowsDropped == 0 {
+			t.Fatalf("expecting some rows to be dropped due to -storage.maxHourlySeries")
+		}
+
+		stats := s.GetDroppedSeriesNamesStats(0)
+		if stats.Overflow != 0 {
+			t.Fatalf("unexpected Overflow: got %d, want 0", stats.Overflow)
+		}
+
+		var totalTracked uint64
+		for _, e := range stats.Entries {
+			totalTracked += e.DropCount
+		}
+		if totalTracked != m.HourlySeriesLimitRowsDropped {
+			t.Fatalf("sum of tracked drop counts %d does not match HourlySeriesLimitRowsDropped %d", totalTracked, m.HourlySeriesLimitRowsDropped)
+		}
+
+		// Verify entries are sorted by DropCount descending.
+		for i := 1; i < len(stats.Entries); i++ {
+			if stats.Entries[i-1].DropCount < stats.Entries[i].DropCount {
+				t.Fatalf("entries are not sorted by DropCount descending: %+v", stats.Entries)
+			}
+		}
+
+		top := s.GetDroppedSeriesNamesStats(1)
+		if len(top.Entries) != 1 {
+			t.Fatalf("unexpected number of entries for topN=1: got %d, want 1", len(top.Entries))
+		}
+		if top.Entries[0].DropCount != stats.Entries[0].DropCount {
+			t.Fatalf("topN=1 entry mismatch: got %+v, want %+v", top.Entries[0], stats.Entries[0])
+		}
+
+		s.ResetDroppedSeriesNamesStats()
+		afterReset := s.GetDroppedSeriesNamesStats(0)
+		if len(afterReset.Entries) != 0 {
+			t.Fatalf("expecting no entries after ResetDroppedSeriesNamesStats, got %+v", afterReset.Entries)
+		}
+	})
+
+	t.Run("MemoryBoundRespected", func(t *testing.T) {
+		const (
+			maxHourlySeries       = 1
+			maxDroppedSeriesNames = 5
+			distinctNames         = 20
+			rowsPerName           = 2
+		)
+		names := make([]string, distinctNames)
+		for i := range names {
+			names[i] = fmt.Sprintf("bounded_metric_%d", i)
+		}
+		mrs := testGenerateMetricRowsForNames(rng, rowsPerName, names, tr)
+
+		s := MustOpenStorage(t.Name(), OpenOptions{
+			MaxHourlySeries:       maxHourlySeries,
+			MaxDroppedSeriesNames: maxDroppedSeriesNames,
+		})
+		defer s.MustClose()
+
+		s.AddRows(mrs, defaultPrecisionBits)
+		s.DebugFlush()
+
+		stats := s.GetDroppedSeriesNamesStats(0)
+		if stats.TrackedNames > maxDroppedSeriesNames {
+			t.Fatalf("tracked names count %d exceeds the configured bound %d", stats.TrackedNames, maxDroppedSeriesNames)
+		}
+		if len(stats.Entries) > maxDroppedSeriesNames {
+			t.Fatalf("entries count %d exceeds the configured bound %d", len(stats.Entries), maxDroppedSeriesNames)
+		}
+		if stats.Overflow == 0 {
+			t.Fatalf("expecting a non-zero Overflow, since there are more distinct dropped names than the configured bound")
+		}
+	})
+
+	t.Run("DisabledByDefault", func(t *testing.T) {
+		mrs := testGenerateMetricRowsForNames(rng, 10, []string{"metric_x"}, tr)
+
+		s := MustOpenStorage(t.Name(), OpenOptions{
+			MaxHourlySeries: 1,
+			// MaxDroppedSeriesNames is intentionally left at its zero value.
+		})
+		defer s.MustClose()
+
+		s.AddRows(mrs, defaultPrecisionBits)
+		s.DebugFlush()
+
+		var m Metrics
+		s.UpdateMetrics(&m)
+		if m.HourlySeriesLimitRowsDropped == 0 {
+			t.Fatalf("expecting some rows to be dropped due to -storage.maxHourlySeries")
+		}
+
+		stats := s.GetDroppedSeriesNamesStats(0)
+		if len(stats.Entries) != 0 || stats.TrackedNames != 0 {
+			t.Fatalf("expecting no tracked entries when MaxDroppedSeriesNames is disabled, got %+v", stats)
+		}
+	})
+}
