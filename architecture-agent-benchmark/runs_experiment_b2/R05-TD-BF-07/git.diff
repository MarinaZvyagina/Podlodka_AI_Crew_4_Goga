+// registerDroppedSeries logs metricNameRaw as skipped because of flagName
+// and, when droppedSeriesTracker is enabled, records the drop against its
+// metric name for later querying via GetDroppedSeriesNamesStats.
+func (s *Storage) registerDroppedSeries(metricNameRaw []byte, flagName string, flagValue int) {
+	if s.droppedSeriesTracker != nil {
+		if metricGroup, err := getMetricGroupFromRaw(metricNameRaw); err == nil {
+			s.droppedSeriesTracker.Add(metricGroup)
+		}
+	}
+	logSkippedSeries(metricNameRaw, flagName, flagValue)
+}
