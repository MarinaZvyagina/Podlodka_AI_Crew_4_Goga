+func TestStorageDroppedSeriesStats_TracksDroppedSeriesByMetricName(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const (
+		numRows         = 1000
+		maxHourlySeries = 500
+	)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	mrs := testGenerateMetricRows(rng, numRows, minTimestamp, maxTimestamp)
+
+	opts := OpenOptions{
+		MaxHourlySeries:                maxHourlySeries,
+		TrackDroppedSeriesByMetricName: true,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped == 0 {
+		t.Fatalf("expected some rows to be dropped due to the hourly series limit")
+	}
+
+	stats := s.GetDroppedSeriesStats(0)
+	if len(stats.Records) == 0 {
+		t.Fatalf("expected GetDroppedSeriesStats to report at least one dropped metric name")
+	}
+
+	var totalTracked uint64
+	seen := make(map[string]bool)
+	for _, r := range stats.Records {
+		if seen[r.MetricName] {
+			t.Fatalf("metric name %q reported more than once in GetDroppedSeriesStats", r.MetricName)
+		}
+		seen[r.MetricName] = true
+		if r.DroppedRowsCount == 0 {
+			t.Fatalf("unexpected zero DroppedRowsCount for metric name %q", r.MetricName)
+		}
+		totalTracked += r.DroppedRowsCount
+	}
+	if totalTracked != m.HourlySeriesLimitRowsDropped {
+		t.Fatalf("sum of per-metric-name drop counts (%d) doesn't match the aggregate counter (%d)", totalTracked, m.HourlySeriesLimitRowsDropped)
+	}
+
+	// GetDroppedSeriesStats(limit) must cap the number of returned records.
+	top1 := s.GetDroppedSeriesStats(1)
+	if len(top1.Records) != 1 {
+		t.Fatalf("unexpected number of records with limit=1: got %d, want 1", len(top1.Records))
+	}
+	if top1.Records[0].DroppedRowsCount < stats.Records[len(stats.Records)-1].DroppedRowsCount {
+		t.Fatalf("GetDroppedSeriesStats(1) didn't return the top offender")
+	}
+
+	s.ResetDroppedSeriesStats()
+	if got := s.GetDroppedSeriesStats(0); len(got.Records) != 0 {
+		t.Fatalf("expected no records right after ResetDroppedSeriesStats, got %+v", got.Records)
+	}
+}
