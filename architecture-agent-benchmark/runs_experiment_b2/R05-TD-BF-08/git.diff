new file mode 100644
index 0000000..c89d87f
--- /dev/null
+++ b/lib/storage/droppedseries/tracker_test.go
@@ -0,0 +1,153 @@
+package droppedseries
+
+import (
+	"fmt"
+	"testing"
+)
+
+func TestTrackerRegisterAccumulatesPerMetricName(t *testing.T) {
+	tr := NewTracker(1 << 20)
+
+	tr.Register([]byte("metric_a"))
+	tr.Register([]byte("metric_b"))
+	tr.Register([]byte("metric_a"))
+	tr.Register([]byte("metric_a"))
+	tr.Register([]byte("metric_c"))
+	tr.Register([]byte("metric_b"))
+
+	got := map[string]uint64{}
+	for _, r := range tr.GetTop(0).Records {
+		got[r.MetricName] = r.DroppedRowsCount
+	}
+	want := map[string]uint64{
+		"metric_a": 3,
+		"metric_b": 2,
+		"metric_c": 1,
+	}
+	if len(got) != len(want) {
+		t.Fatalf("unexpected number of tracked metric names: got %v, want %v", got, want)
+	}
+	for name, wantCount := range want {
+		if gotCount := got[name]; gotCount != wantCount {
+			t.Fatalf("unexpected drop count for %q: got %d, want %d", name, gotCount, wantCount)
+		}
+	}
+}
+
+func TestTrackerGetTopOrderingAndLimit(t *testing.T) {
+	tr := NewTracker(1 << 20)
+
+	counts := map[string]int{
+		"metric_low":    1,
+		"metric_high":   5,
+		"metric_medium": 3,
+	}
+	for name, n := range counts {
+		for range n {
+			tr.Register([]byte(name))
+		}
+	}
+
+	top2 := tr.GetTop(2).Records
+	if len(top2) != 2 {
+		t.Fatalf("unexpected number of records: got %d, want 2", len(top2))
+	}
+	if top2[0].MetricName != "metric_high" || top2[0].DroppedRowsCount != 5 {
+		t.Fatalf("unexpected top record: %+v", top2[0])
+	}
+	if top2[1].MetricName != "metric_medium" || top2[1].DroppedRowsCount != 3 {
+		t.Fatalf("unexpected second record: %+v", top2[1])
+	}
+
+	all := tr.GetTop(0).Records
+	if len(all) != 3 {
+		t.Fatalf("unexpected number of records with limit=0: got %d, want 3", len(all))
+	}
+}
+
+func TestTrackerMemoryBoundIsRespected(t *testing.T) {
+	// Budget large enough for a handful of entries, far smaller than what
+	// registering thousands of distinct metric names would need unbounded.
+	const maxSizeBytes = 2000
+	tr := NewTracker(maxSizeBytes)
+
+	const distinctNames = 10000
+	for i := range distinctNames {
+		tr.Register(fmt.Appendf(nil, "metric_%d", i))
+	}
+
+	stats := tr.GetTop(0)
+	if stats.CurrentSizeBytes > maxSizeBytes {
+		t.Fatalf("tracker exceeded its memory bound: currentSizeBytes=%d, maxSizeBytes=%d", stats.CurrentSizeBytes, maxSizeBytes)
+	}
+	if uint64(len(stats.Records)) >= distinctNames {
+		t.Fatalf("expected tracker to stop tracking new metric names once full, but tracked %d of %d", len(stats.Records), distinctNames)
+	}
+	if len(stats.Records) == 0 {
+		t.Fatalf("expected at least some metric names to be tracked before the bound was hit")
+	}
+
+	// Already-tracked names must keep accumulating even after the tracker is full.
+	firstName := stats.Records[0].MetricName
+	beforeCount := stats.Records[0].DroppedRowsCount
+	tr.Register([]byte(firstName))
+	after := tr.GetTop(0)
+	var afterCount uint64
+	for _, r := range after.Records {
+		if r.MetricName == firstName {
+			afterCount = r.DroppedRowsCount
+		}
+	}
+	if afterCount != beforeCount+1 {
+		t.Fatalf("expected already-tracked metric name to keep accumulating: before=%d, after=%d", beforeCount, afterCount)
+	}
+	if after.CurrentSizeBytes > maxSizeBytes {
+		t.Fatalf("tracker exceeded its memory bound after re-registering a tracked name: currentSizeBytes=%d, maxSizeBytes=%d", after.CurrentSizeBytes, maxSizeBytes)
+	}
+}
+
+func TestTrackerReset(t *testing.T) {
+	tr := NewTracker(1 << 20)
+	tr.Register([]byte("metric_a"))
+	tr.Register([]byte("metric_b"))
+
+	before := tr.GetTop(0)
+	if len(before.Records) != 2 {
+		t.Fatalf("unexpected records before reset: %+v", before.Records)
+	}
+
+	tr.Reset()
+
+	after := tr.GetTop(0)
+	if len(after.Records) != 0 {
+		t.Fatalf("unexpected records after reset: %+v", after.Records)
+	}
+	if after.CollectedSinceTs < before.CollectedSinceTs {
+		t.Fatalf("expected CollectedSinceTs to not go backwards: before=%d, after=%d", before.CollectedSinceTs, after.CollectedSinceTs)
+	}
+
+	tr.Register([]byte("metric_a"))
+	got := tr.GetTop(0).Records
+	if len(got) != 1 || got[0].DroppedRowsCount != 1 {
+		t.Fatalf("unexpected records after reset+register: %+v", got)
+	}
+}
