diff --git a/lib/storage/droppedseries/tracker.go b/lib/storage/droppedseries/tracker.go
new file mode 100644
index 0000000..372b084
--- /dev/null
+++ b/lib/storage/droppedseries/tracker.go
@@ -0,0 +1,176 @@
+// Package droppedseries tracks, per metric name, how many samples were
+// dropped because adding the corresponding series would have exceeded a
+// configured cardinality limit (-storage.maxHourlySeries / -storage.maxDailySeries).
+//
+// Memory usage is bounded by a configurable byte budget: once the budget is
+// exhausted, samples for previously-unseen metric names stop being tracked,
+// while counters for already-tracked metric names keep growing. This keeps
+// the tracker safe to run even when the number of distinct offending metric
+// names is unbounded.
+package droppedseries
+
+import (
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+// recordOverheadBytes approximates the per-entry memory overhead on top of
+// the metric name bytes themselves: the map bucket, the string header and
+// the *atomic.Uint64 counter it points to.
+const recordOverheadBytes = 64
+
+// Tracker collects the number of samples dropped per metric name, bounded by
+// maxSizeBytes of approximate memory usage.
+//
+// A nil *Tracker is valid: every method becomes a no-op, so the feature can
+// be disabled by simply not constructing a Tracker, with a single nil check
+// on the caller's side.
+type Tracker struct {
+	maxSizeBytes uint64
+
+	creationTs       atomic.Uint64
+	currentSizeBytes atomic.Uint64
+
+	mu    sync.Mutex
+	store map[string]*atomic.Uint64
+
+	getCurrentTs func() uint64
+}
+
+// NewTracker creates a Tracker bounded by maxSizeBytes of approximate memory usage.
+func NewTracker(maxSizeBytes uint64) *Tracker {
+	t := &Tracker{
+		maxSizeBytes: maxSizeBytes,
+		getCurrentTs: fasttime.UnixTimestamp,
+	}
+	t.resetLocked()
+	return t
+}
+
+func (t *Tracker) resetLocked() {
+	t.store = make(map[string]*atomic.Uint64)
+	t.currentSizeBytes.Store(0)
+	t.creationTs.Store(t.getCurrentTs())
+}
+
+// Register records a single dropped sample for the given metricName.
+//
+// If metricName hasn't been seen before and the tracker's memory budget is
+// already exhausted, the sample is accounted for nowhere - it is intentionally
+// dropped from tracking in order to keep memory usage bounded.
+func (t *Tracker) Register(metricName []byte) {
+	if t == nil {
+		return
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	cnt, ok := t.store[string(metricName)]
+	if !ok {
+		entrySize := uint64(len(metricName)) + recordOverheadBytes
+		if t.currentSizeBytes.Load()+entrySize > t.maxSizeBytes {
+			return
+		}
+		cnt = &atomic.Uint64{}
+		t.store[string(metricName)] = cnt
+		t.currentSizeBytes.Add(entrySize)
+	}
+	cnt.Add(1)
+}
+
+// Record is a single metric name and its accumulated dropped samples count.
+type Record struct {
+	MetricName       string
+	DroppedRowsCount uint64
+}
+
+// StatsResult is the response returned by Tracker.GetTop.
+type StatsResult struct {
+	// CollectedSinceTs is the unix timestamp (seconds) since which the
+	// currently reported stats have been accumulated (i.e. the time of
+	// tracker creation or the last Reset call).
+	CollectedSinceTs uint64
+
+	// CurrentItemsCount is the number of distinct metric names currently tracked.
+	CurrentItemsCount uint64
+
+	// CurrentSizeBytes is the approximate current memory usage of the tracker.
+	CurrentSizeBytes uint64
+
+	// MaxSizeBytes is the configured memory budget of the tracker.
+	MaxSizeBytes uint64
+
+	// Records are sorted by DroppedRowsCount in descending order, capped at
+	// the limit requested from GetTop.
+	Records []Record
+}
+
+// GetTop returns up to limit Records with the highest DroppedRowsCount, sorted
+// in descending order (ties broken by metric name). A non-positive limit returns
+// every currently tracked record.
+func (t *Tracker) GetTop(limit int) StatsResult {
+	if t == nil {
+		return StatsResult{}
+	}
+
+	t.mu.Lock()
+	records := make([]Record, 0, len(t.store))
+	for name, cnt := range t.store {
+		records = append(records, Record{
+			MetricName:       name,
+			DroppedRowsCount: cnt.Load(),
+		})
+	}
+	result := StatsResult{
+		CollectedSinceTs:  t.creationTs.Load(),
+		CurrentItemsCount: uint64(len(t.store)),
+		CurrentSizeBytes:  t.currentSizeBytes.Load(),
+		MaxSizeBytes:      t.maxSizeBytes,
+	}
+	t.mu.Unlock()
+
+	sort.Slice(records, func(i, j int) bool {
+		if records[i].DroppedRowsCount == records[j].DroppedRowsCount {
+			return records[i].MetricName < records[j].MetricName
+		}
+		return records[i].DroppedRowsCount > records[j].DroppedRowsCount
+	})
+	if limit > 0 && len(records) > limit {
+		records = records[:limit]
+	}
+	result.Records = records
+	return result
+}
+
+// Reset clears all the collected stats and restarts the CollectedSinceTs window.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.resetLocked()
+	t.mu.Unlock()
+}
+
+// Metrics holds Tracker's internal metrics for reporting.
+type Metrics struct {
+	CurrentSizeBytes  uint64
+	CurrentItemsCount uint64
+	MaxSizeBytes      uint64
+}
+
+// UpdateMetrics writes the tracker's internal metrics to dst.
+func (t *Tracker) UpdateMetrics(dst *Metrics) {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	dst.CurrentItemsCount = uint64(len(t.store))
+	t.mu.Unlock()
+	dst.CurrentSizeBytes = t.currentSizeBytes.Load()
+	dst.MaxSizeBytes = t.maxSizeBytes
+}
