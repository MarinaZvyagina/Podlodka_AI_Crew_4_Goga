+func TestStorageRegisterSeriesCardinality_SeriesLimitExceededStats(t *testing.T) {
+	defer testRemoveAll(t)
+
+	rng := rand.New(rand.NewSource(1))
+	tr := TimeRange{
+		MinTimestamp: time.Now().UnixMilli(),
+		MaxTimestamp: time.Now().UnixMilli() + 1000,
+	}
+
+	const maxHourlySeries = 100
+
+	t.Run("enabled", func(t *testing.T) {
+		opts := OpenOptions{
+			MaxHourlySeries:                     maxHourlySeries,
+			TrackSeriesLimitExceededMetricNames: true,
+		}
+		s := MustOpenStorage(t.Name(), opts)
+		defer s.MustClose()
+
+		// metric_a is inserted first, so up to maxHourlySeries of its series are
+		// accepted before the hourly limit is reached; the rest are rejected.
+		// metric_b and metric_c are inserted after the limit is already reached,
+		// so all of their rows are deterministically rejected.
+		mrsA := testGenerateMetricRowsForGroup(rng, 300, "metric_a", tr)
+		mrsB := testGenerateMetricRowsForGroup(rng, 300, "metric_b", tr)
+		mrsC := testGenerateMetricRowsForGroup(rng, 200, "metric_c", tr)
+
+		s.AddRows(mrsA, defaultPrecisionBits)
+		s.AddRows(mrsB, defaultPrecisionBits)
+		s.AddRows(mrsC, defaultPrecisionBits)
+		s.DebugFlush()
+
+		var m Metrics
+		s.UpdateMetrics(&m)
+		if m.HourlySeriesLimitRowsDropped == 0 {
+			t.Fatalf("expected some rows to be dropped because of the hourly series limit")
+		}
+
+		stats := s.GetSeriesLimitExceededStats(10)
+		if len(stats.Records) != 3 {
+			t.Fatalf("unexpected number of tracked metric names: got %d, want 3; records=%+v", len(stats.Records), stats.Records)
+		}
+
+		counts := make(map[string]uint64, len(stats.Records))
+		var sum uint64
+		for _, r := range stats.Records {
+			counts[r.MetricName] = r.DroppedRowsCount
+			sum += r.DroppedRowsCount
+		}
+		if sum != m.HourlySeriesLimitRowsDropped {
+			t.Fatalf("sum of per-metric-name drop counts (%d) doesn't match the aggregate HourlySeriesLimitRowsDropped (%d)", sum, m.HourlySeriesLimitRowsDropped)
+		}
+
+		// metric_b and metric_c are inserted after the hourly limit is already reached, so
+		// essentially all of their rows are rejected. A handful of rows may still slip through
+		// due to the underlying bloomfilter's inherent false-positive rate, so allow small slack
+		// instead of asserting an exact count.
+		if got, wantMin := counts["metric_b"], uint64(290); got < wantMin || got > 300 {
+			t.Fatalf("unexpected drop count for metric_b: got %d, want in range [%d, 300]", got, wantMin)
+		}
+		if got, wantMin := counts["metric_c"], uint64(190); got < wantMin || got > 200 {
+			t.Fatalf("unexpected drop count for metric_c: got %d, want in range [%d, 200]", got, wantMin)
+		}
+		if got := counts["metric_a"]; got == 0 || got >= 300 {
+			t.Fatalf("unexpected drop count for metric_a: got %d, want in range (0, 300)", got)
+		}
+
+		// metric_b has strictly more drops than any other tracked name, so it must be the top offender.
+		top := s.GetSeriesLimitExceededStats(1)
+		if len(top.Records) != 1 || top.Records[0].MetricName != "metric_b" {
+			t.Fatalf("unexpected top offender: got %+v, want metric_b", top.Records)
+		}
+
+		s.ResetSeriesLimitExceededStats()
+		afterReset := s.GetSeriesLimitExceededStats(10)
+		if len(afterReset.Records) != 0 {
+			t.Fatalf("expected no records after ResetSeriesLimitExceededStats, got %+v", afterReset.Records)
+		}
+	})
+
+	t.Run("disabled", func(t *testing.T) {
+		opts := OpenOptions{
+			MaxHourlySeries: maxHourlySeries,
+			// TrackSeriesLimitExceededMetricNames is intentionally left false.
+		}
+		s := MustOpenStorage(t.Name(), opts)
+		defer s.MustClose()
+
+		mrs := testGenerateMetricRowsForGroup(rng, 300, "metric_a", tr)
+		s.AddRows(mrs, defaultPrecisionBits)
+		s.DebugFlush()
+
+		var m Metrics
+		s.UpdateMetrics(&m)
+		if m.HourlySeriesLimitRowsDropped == 0 {
+			t.Fatalf("expected some rows to be dropped because of the hourly series limit")
+		}
+
+		stats := s.GetSeriesLimitExceededStats(10)
+		if len(stats.Records) != 0 {
+			t.Fatalf("expected no tracked records when TrackSeriesLimitExceededMetricNames is disabled, got %+v", stats.Records)
+		}
+	})
+}
