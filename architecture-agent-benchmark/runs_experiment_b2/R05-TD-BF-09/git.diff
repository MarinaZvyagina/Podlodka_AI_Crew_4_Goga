+func testGenerateMetricRowsForGroup(rng *rand.Rand, rows uint64, metricGroup string, tr TimeRange) []MetricRow {
+	mrs := make([]MetricRow, rows)
+	for i := range mrs {
+		mn := MetricName{
+			MetricGroup: []byte(metricGroup),
+			Tags: []Tag{
+				{
+					Key:   []byte("label"),
+					Value: fmt.Appendf(nil, "%d", i),
+				},
+			},
+		}
+		mrs[i].MetricNameRaw = mn.marshalRaw(nil)
+		mrs[i].Timestamp = tr.MinTimestamp + int64(rng.Intn(int(tr.MaxTimestamp-tr.MinTimestamp+1)))
+		mrs[i].Value = rng.NormFloat64() * 1e6
+	}
+	return mrs
+}
