diff --git a/lib/storage/droppedseriesstats/tracker.go b/lib/storage/droppedseriesstats/tracker.go
new file mode 100644
index 0000000..5b81ed4
--- /dev/null
+++ b/lib/storage/droppedseriesstats/tracker.go
@@ -0,0 +1,180 @@
+package droppedseriesstats
+
+import (
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+// storeOverhead is an approximation of the per-entry in-memory overhead of storing
+// one metric name in Tracker.store: the map bucket entry, the *atomic.Uint64 value
+// allocation and the string header for the key.
+const storeOverhead = 24 + 8 + 16
+
+// Tracker implements an in-memory, bounded tracker of per-metric-name drop counts.
+//
+// It is used for tracking how many samples were dropped for each metric name because
+// adding the corresponding series would have exceeded a configured unique-series limit
+// (see -storage.maxHourlySeries and -storage.maxDailySeries).
+//
+// It is safe to use Tracker from concurrent goroutines. It is safe to call any method
+// on a nil *Tracker - all methods are no-ops in that case, so the tracker can be left
+// nil to disable tracking with no runtime overhead.
+type Tracker struct {
+	maxSizeBytes uint64
+
+	creationTs        atomic.Uint64
+	currentSizeBytes  atomic.Uint64
+	currentItemsCount atomic.Uint64
+
+	mu    sync.RWMutex
+	store map[string]*atomic.Uint64
+
+	// getCurrentTs is overridden in tests.
+	getCurrentTs func() uint64
+}
+
+// NewTracker creates a new Tracker, which can track up to maxSizeBytes worth of
+// distinct metric names before refusing to track any new (previously unseen) name.
+//
+// Metric names already being tracked keep accumulating their drop count even after
+// the limit is reached.
+func NewTracker(maxSizeBytes uint64) *Tracker {
+	t := &Tracker{
+		maxSizeBytes: maxSizeBytes,
+		getCurrentTs: fasttime.UnixTimestamp,
+	}
+	t.store = make(map[string]*atomic.Uint64)
+	t.creationTs.Store(t.getCurrentTs())
+	return t
+}
+
+// IncrementDropCount registers a single dropped sample for the given metricName.
+//
+// It is safe calling IncrementDropCount from concurrent goroutines.
+func (t *Tracker) IncrementDropCount(metricName []byte) {
+	if t == nil {
+		return
+	}
+
+	t.mu.RLock()
+	cnt, ok := t.store[string(metricName)]
+	t.mu.RUnlock()
+	if ok {
+		cnt.Add(1)
+		return
+	}
+
+	newEntrySizeBytes := uint64(len(metricName)) + storeOverhead
+	if t.currentSizeBytes.Load()+newEntrySizeBytes > t.maxSizeBytes {
+		// The tracker is full and metricName isn't tracked yet - drop the event
+		// in order to keep memory usage bounded.
+		return
+	}
+
+	t.mu.Lock()
+	// metricName could have been inserted concurrently since the RLock check above.
+	cnt, ok = t.store[string(metricName)]
+	if ok {
+		t.mu.Unlock()
+		cnt.Add(1)
+		return
+	}
+	if t.currentSizeBytes.Load()+newEntrySizeBytes > t.maxSizeBytes {
+		t.mu.Unlock()
+		return
+	}
+	name := string(append([]byte(nil), metricName...))
+	cnt = &atomic.Uint64{}
+	cnt.Store(1)
+	t.store[name] = cnt
+	t.mu.Unlock()
+
+	t.currentSizeBytes.Add(uint64(len(name)) + storeOverhead)
+	t.currentItemsCount.Add(1)
+}
+
+// Reset clears all the tracked state.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.store = make(map[string]*atomic.Uint64)
+	t.currentSizeBytes.Store(0)
+	t.currentItemsCount.Store(0)
+	t.creationTs.Store(t.getCurrentTs())
+	t.mu.Unlock()
+}
+
+// StatRecord is a single per-metric-name drop-count record.
+type StatRecord struct {
+	// MetricName is the name of the metric for which samples were dropped.
+	MetricName string
+
+	// DroppedRowsCount is the number of samples dropped for MetricName since CollectedSinceTs.
+	DroppedRowsCount uint64
+}
+
+// StatsResult is the result of a GetTopOffenders call.
+type StatsResult struct {
+	// CollectedSinceTs is the unix timestamp in seconds since which the returned stats were collected.
+	CollectedSinceTs uint64
+
+	// TotalTrackedNames is the total number of distinct metric names currently tracked.
+	TotalTrackedNames uint64
+
+	// Records contains the top offending metric names, sorted by DroppedRowsCount in descending order.
+	Records []StatRecord
+}
+
+// GetTopOffenders returns up to limit metric names with the highest drop count,
+// sorted by drop count in descending order.
+func (t *Tracker) GetTopOffenders(limit int) StatsResult {
+	var result StatsResult
+	if t == nil {
+		return result
+	}
+
+	t.mu.RLock()
+	result.CollectedSinceTs = t.creationTs.Load()
+	result.TotalTrackedNames = t.currentItemsCount.Load()
+	result.Records = make([]StatRecord, 0, len(t.store))
+	for name, cnt := range t.store {
+		result.Records = append(result.Records, StatRecord{
+			MetricName:       name,
+			DroppedRowsCount: cnt.Load(),
+		})
+	}
+	t.mu.RUnlock()
+
+	sort.Slice(result.Records, func(i, j int) bool {
+		if result.Records[i].DroppedRowsCount == result.Records[j].DroppedRowsCount {
+			return result.Records[i].MetricName < result.Records[j].MetricName
+		}
+		return result.Records[i].DroppedRowsCount > result.Records[j].DroppedRowsCount
+	})
+	if limit >= 0 && len(result.Records) > limit {
+		result.Records = result.Records[:limit]
+	}
+	return result
+}
+
+// TrackerMetrics holds Tracker metrics to report.
+type TrackerMetrics struct {
+	CurrentSizeBytes  uint64
+	CurrentItemsCount uint64
+	MaxSizeBytes      uint64
+}
+
+// UpdateMetrics writes internal metrics to dst.
+func (t *Tracker) UpdateMetrics(dst *TrackerMetrics) {
+	if t == nil {
+		return
+	}
+	dst.CurrentSizeBytes = t.currentSizeBytes.Load()
+	dst.CurrentItemsCount = t.currentItemsCount.Load()
+	dst.MaxSizeBytes = t.maxSizeBytes
+}
diff --git a/lib/storage/droppedseriesstats/tracker_test.go b/lib/storage/droppedseriesstats/tracker_test.go
new file mode 100644
index 0000000..fcb937f
--- /dev/null
+++ b/lib/storage/droppedseriesstats/tracker_test.go
@@ -0,0 +1,144 @@
+package droppedseriesstats
+
+import (
+	"fmt"
+	"testing"
+)
+
+func TestTracker_IncrementAndGetTopOffenders(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	tr.IncrementDropCount([]byte("metric_a"))
+	tr.IncrementDropCount([]byte("metric_a"))
+	tr.IncrementDropCount([]byte("metric_a"))
+	tr.IncrementDropCount([]byte("metric_b"))
+	tr.IncrementDropCount([]byte("metric_c"))
+	tr.IncrementDropCount([]byte("metric_c"))
+
+	result := tr.GetTopOffenders(10)
+	if result.TotalTrackedNames != 3 {
+		t.Fatalf("unexpected TotalTrackedNames; got %d; want 3", result.TotalTrackedNames)
+	}
+	if len(result.Records) != 3 {
+		t.Fatalf("unexpected number of records; got %d; want 3", len(result.Records))
+	}
+	wantOrder := []struct {
+		name  string
+		count uint64
+	}{
+		{"metric_a", 3},
+		{"metric_c", 2},
+		{"metric_b", 1},
+	}
+	for i, w := range wantOrder {
+		if result.Records[i].MetricName != w.name || result.Records[i].DroppedRowsCount != w.count {
+			t.Fatalf("unexpected record at index %d; got %+v; want {%s %d}", i, result.Records[i], w.name, w.count)
+		}
+	}
+
+	// Verify limit truncation.
+	limited := tr.GetTopOffenders(1)
+	if len(limited.Records) != 1 {
+		t.Fatalf("unexpected number of records with limit=1; got %d", len(limited.Records))
+	}
+	if limited.Records[0].MetricName != "metric_a" {
+		t.Fatalf("unexpected top offender; got %q; want %q", limited.Records[0].MetricName, "metric_a")
+	}
+}
+
+func TestTracker_RepeatedIncrementsAccumulate(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+	const n = 1000
+	for i := 0; i < n; i++ {
+		tr.IncrementDropCount([]byte("some_metric"))
+	}
+	result := tr.GetTopOffenders(10)
+	if len(result.Records) != 1 {
+		t.Fatalf("unexpected number of records; got %d; want 1", len(result.Records))
+	}
+	if result.Records[0].DroppedRowsCount != n {
+		t.Fatalf("unexpected DroppedRowsCount; got %d; want %d", result.Records[0].DroppedRowsCount, n)
+	}
+}
+
+func TestTracker_NilTrackerIsNoOp(t *testing.T) {
+	var tr *Tracker
+
+	// Must not panic.
+	tr.IncrementDropCount([]byte("metric_a"))
+	tr.Reset()
+
+	result := tr.GetTopOffenders(10)
+	if result.TotalTrackedNames != 0 || len(result.Records) != 0 {
+		t.Fatalf("unexpected non-empty result from nil tracker: %+v", result)
+	}
+
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+	if tm != (TrackerMetrics{}) {
+		t.Fatalf("unexpected non-zero metrics from nil tracker: %+v", tm)
+	}
+}
+
+func TestTracker_MemoryBoundRespected(t *testing.T) {
+	// Choose a small cap that can hold only a handful of entries.
+	const maxSizeBytes = 500
+	tr := NewTracker(maxSizeBytes)
+
+	// Track well beyond what could possibly fit in maxSizeBytes.
+	const totalNames = 10000
+	for i := 0; i < totalNames; i++ {
+		tr.IncrementDropCount([]byte(fmt.Sprintf("metric_%d", i)))
+	}
+
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+	if tm.CurrentSizeBytes > maxSizeBytes {
+		t.Fatalf("tracker exceeded its memory bound; currentSizeBytes=%d; maxSizeBytes=%d", tm.CurrentSizeBytes, maxSizeBytes)
+	}
+	if tm.CurrentItemsCount == 0 {
+		t.Fatalf("expected at least one tracked item")
+	}
+	if tm.CurrentItemsCount >= totalNames {
+		t.Fatalf("expected tracker to refuse most of the %d unique names given the small memory bound; tracked %d", totalNames, tm.CurrentItemsCount)
+	}
+
+	// Existing tracked names must keep accumulating even after the bound is reached.
+	result := tr.GetTopOffenders(1)
+	if len(result.Records) == 0 {
+		t.Fatalf("expected at least one record")
+	}
+	trackedName := result.Records[0].MetricName
+	tr.IncrementDropCount([]byte(trackedName))
+	result = tr.GetTopOffenders(int(tm.CurrentItemsCount))
+	found := false
+	for _, r := range result.Records {
+		if r.MetricName == trackedName && r.DroppedRowsCount == 2 {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatalf("expected already-tracked metric name %q to keep accumulating past the memory bound", trackedName)
+	}
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+	tr.IncrementDropCount([]byte("metric_a"))
+	tr.IncrementDropCount([]byte("metric_b"))
+
+	before := tr.GetTopOffenders(10)
+	if len(before.Records) != 2 {
+		t.Fatalf("unexpected number of records before reset; got %d", len(before.Records))
+	}
+
+	tr.Reset()
+
+	after := tr.GetTopOffenders(10)
+	if len(after.Records) != 0 {
+		t.Fatalf("unexpected non-empty records after reset: %+v", after.Records)
+	}
+	if after.TotalTrackedNames != 0 {
+		t.Fatalf("unexpected TotalTrackedNames after reset; got %d", after.TotalTrackedNames)
+	}
+}
