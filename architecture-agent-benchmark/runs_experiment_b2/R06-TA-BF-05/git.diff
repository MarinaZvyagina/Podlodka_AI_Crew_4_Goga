diff --git a/server/auth/store_test.go b/server/auth/store_test.go
index fae37161d..34e1f84b6 100644
--- a/server/auth/store_test.go
+++ b/server/auth/store_test.go
@@ -1140,6 +1140,45 @@ func TestUserNoPasswordAdd(t *testing.T) {
 	require.ErrorIsf(t, err, ErrAuthFailed, "expected %v, got %v", ErrAuthFailed, err)
 }
 
+func TestUserAddWithEmptyPasswordRejected(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	ua := &pb.AuthUserAddRequest{Name: "empty-pwd-user", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	ua = &pb.AuthUserAddRequest{Name: "empty-pwd-user", HashedPassword: "", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err = as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a nil Options is treated the same as {NoPassword: false}
+	ua = &pb.AuthUserAddRequest{Name: "empty-pwd-user"}
+	_, err = as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+}
+
+func TestUserChangePasswordToEmptyRejected(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// "foo" was created by setupAuthStore with a real password and is not passwordless.
+	_, err := as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo"})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a passwordless account must keep working exactly as before.
+	username := "usernopass"
+	ua := &pb.AuthUserAddRequest{Name: username, Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: username})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
