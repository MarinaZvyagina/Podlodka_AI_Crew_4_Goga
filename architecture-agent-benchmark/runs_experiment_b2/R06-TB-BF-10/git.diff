+// limitations under the License.
+
+package txn
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/etcdserver/api/membership"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+// setupWithMaxLeaseKeys returns a real KV store backed by a real Lessor
+// (rather than lease.FakeLessor, which never actually tracks attachments)
+// configured with the given max-keys-per-lease limit, plus the ID of a
+// freshly granted lease to attach keys to.
+func setupWithMaxLeaseKeys(t *testing.T, maxLeaseKeys int) (mvcc.KV, lease.Lessor, lease.LeaseID) {
+	t.Helper()
+	lg := zaptest.NewLogger(t)
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { betesting.Close(t, b) })
+
+	lessor := lease.NewLessor(lg, b, membership.NewCluster(lg), lease.LessorConfig{MaxLeaseKeys: maxLeaseKeys})
+	t.Cleanup(lessor.Stop)
+
+	s := mvcc.NewStore(lg, b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() { s.Close() })
+	lessor.SetRangeDeleter(func() lease.TxnDelete {
+		return s.Write(traceutil.TODO())
+	})
+
+	l, err := lessor.Grant(1, 100)
+	require.NoError(t, err)
+	return s, lessor, l.ID
+}
+
+func TestPutLeaseKeyLimit(t *testing.T) {
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+
+	t.Run("new key under the limit succeeds", func(t *testing.T) {
+		s, lessor, leaseID := setupWithMaxLeaseKeys(t, 2)
+		_, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k1"), Value: []byte("v"), Lease: int64(leaseID)})
+		require.NoError(t, err)
+	})
+
+	t.Run("new key that would exceed the limit is rejected", func(t *testing.T) {
+		s, lessor, leaseID := setupWithMaxLeaseKeys(t, 1)
+		_, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k1"), Value: []byte("v"), Lease: int64(leaseID)})
+		require.NoError(t, err)
+
+		_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k2"), Value: []byte("v"), Lease: int64(leaseID)})
+		require.ErrorIs(t, err, lease.ErrTooManyLeaseKeys)
+
+		// the rejected write must not have been applied.
+		require.Equal(t, lease.NoLease, lessor.GetLease(lease.LeaseItem{Key: "k2"}))
+		require.Equal(t, 1, lessor.Lookup(leaseID).TotalItemCnt())
+	})
+
+	t.Run("re-attaching a key already on the lease at the limit still succeeds", func(t *testing.T) {
+		s, lessor, leaseID := setupWithMaxLeaseKeys(t, 1)
+		_, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k1"), Value: []byte("v"), Lease: int64(leaseID)})
+		require.NoError(t, err)
+
+		_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k1"), Value: []byte("v2"), Lease: int64(leaseID)})
+		require.NoError(t, err)
+	})
+
+	t.Run("server stays healthy and keeps serving unrelated writes after a rejection", func(t *testing.T) {
+		s, lessor, leaseID := setupWithMaxLeaseKeys(t, 1)
+		_, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k1"), Value: []byte("v"), Lease: int64(leaseID)})
+		require.NoError(t, err)
+
+		_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k2"), Value: []byte("v"), Lease: int64(leaseID)})
+		require.ErrorIs(t, err, lease.ErrTooManyLeaseKeys)
+
+		_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("unrelated"), Value: []byte("v")})
+		require.NoError(t, err)
+	})
+
+	t.Run("puts without a lease are never limited", func(t *testing.T) {
+		s, lessor, _ := setupWithMaxLeaseKeys(t, 0)
+		_, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k1"), Value: []byte("v")})
+		require.NoError(t, err)
+	})
+}
+
+func TestTxnLeaseKeyLimit(t *testing.T) {
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+
+	putOp := func(key string, leaseID lease.LeaseID) *pb.RequestOp {
+		return &pb.RequestOp{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{
+			Key: []byte(key), Value: []byte("v"), Lease: int64(leaseID),
+		}}}
+	}
+
+	t.Run("multiple new puts to the same lease within the limit succeed", func(t *testing.T) {
+		s, lessor, leaseID := setupWithMaxLeaseKeys(t, 2)
+		txnReq := &pb.TxnRequest{Success: []*pb.RequestOp{putOp("k1", leaseID), putOp("k2", leaseID)}}
+
+		_, _, err := Txn(ctx, lg, txnReq, false, s, lessor, false)
+		require.NoError(t, err)
+		require.Equal(t, 2, lessor.Lookup(leaseID).TotalItemCnt())
+	})
+
+	t.Run("cumulative new puts exceeding the limit are rejected as a whole, nothing partially applied", func(t *testing.T) {
+		s, lessor, leaseID := setupWithMaxLeaseKeys(t, 1)
+		txnReq := &pb.TxnRequest{Success: []*pb.RequestOp{putOp("k1", leaseID), putOp("k2", leaseID)}}
+
+		_, _, err := Txn(ctx, lg, txnReq, false, s, lessor, false)
+		require.ErrorIs(t, err, lease.ErrTooManyLeaseKeys)
+
+		require.Equal(t, 0, lessor.Lookup(leaseID).TotalItemCnt())
+		require.Equal(t, lease.NoLease, lessor.GetLease(lease.LeaseItem{Key: "k1"}))
+		require.Equal(t, lease.NoLease, lessor.GetLease(lease.LeaseItem{Key: "k2"}))
+
+		rr, err := s.Read(mvcc.ConcurrentReadTxMode, traceutil.TODO()).Range(ctx, []byte("k1"), []byte("k3"), mvcc.RangeOptions{})
+		require.NoError(t, err)
+		require.Empty(t, rr.KVs)
+	})
+
+	t.Run("repeated put of the same new key within one txn only counts once", func(t *testing.T) {
+		s, lessor, leaseID := setupWithMaxLeaseKeys(t, 1)
+		txnReq := &pb.TxnRequest{Success: []*pb.RequestOp{putOp("k1", leaseID), putOp("k1", leaseID)}}
+
+		_, _, err := Txn(ctx, lg, txnReq, false, s, lessor, false)
+		require.NoError(t, err)
+		require.Equal(t, 1, lessor.Lookup(leaseID).TotalItemCnt())
+	})
+}
