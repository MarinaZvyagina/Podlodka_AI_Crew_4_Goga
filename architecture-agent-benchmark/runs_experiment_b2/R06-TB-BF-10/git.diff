 }
 
+// checkLeaseKeyLimit validates that attaching p.Key to p.Lease does not push the
+// lease's distinct key count over the lessor's configured limit. Re-attaching a
+// key already on the lease never counts as growth. `pendingLeaseAttach` tracks
+// keys already provisionally counted as new attachments earlier within the same
+// request (e.g. other Put ops inside the same Txn attaching to the same lease),
+// keyed by lease ID; it is nil when checking a standalone Put.
+func checkLeaseKeyLimit(lessor lease.Lessor, p *pb.PutRequest, pendingLeaseAttach map[lease.LeaseID]map[string]struct{}) error {
+	leaseID := lease.LeaseID(p.Lease)
+	if leaseID == lease.NoLease {
+		return nil
+	}
+	if lessor.GetLease(lease.LeaseItem{Key: string(p.Key)}) == leaseID {
+		// already attached to this lease; re-attaching does not grow it.
+		return nil
+	}
+	key := string(p.Key)
+	pendingForLease := pendingLeaseAttach[leaseID]
+	if _, ok := pendingForLease[key]; ok {
+		// already counted as a new attachment earlier in this same request.
+		return nil
+	}
+	l := lessor.Lookup(leaseID)
+	if l == nil {
+		return lease.ErrLeaseNotFound
+	}
+	if l.TotalItemCnt()+len(pendingForLease) >= lessor.MaxLeaseKeys() {
+		return lease.ErrTooManyLeaseKeys
+	}
+	if pendingLeaseAttach != nil {
+		if pendingForLease == nil {
+			pendingForLease = make(map[string]struct{})
+			pendingLeaseAttach[leaseID] = pendingForLease
+		}
+		pendingForLease[key] = struct{}{}
+	}
+	return nil
+}
