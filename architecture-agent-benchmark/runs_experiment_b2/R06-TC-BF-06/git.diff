+func TestAuditKVServerTxnKeyRangeDedupAndNesting(t *testing.T) {
+	ag := &fakeAuthGetter{authInfo: &auth.AuthInfo{Username: "alice"}}
+	kv := &fakeKVServer{txnResp: &pb.TxnResponse{}}
+	a, logs := newObservedAuditServer(kv, ag)
+
+	r := &pb.TxnRequest{
+		Compare: []*pb.Compare{{Key: []byte("a")}},
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a")}}}, // duplicate of compare key
+			{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("b")}}},
+				},
+			}}},
+		},
+		Failure: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("c"), RangeEnd: []byte("cz")}}},
+		},
+	}
+
+	if _, err := a.Txn(context.Background(), r); err != nil {
+		t.Fatal(err)
+	}
+
+	got := fieldString(t, lastAuditFields(t, logs), "key")
+	want := "a, b, [c, cz)"
+	if got != want {
+		t.Errorf("txn key range = %q, want %q (deduped, nested ops walked)", got, want)
+	}
+}
