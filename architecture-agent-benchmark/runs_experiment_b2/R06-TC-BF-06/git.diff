+func newObservedAuditServer(kv pb.KVServer, ag AuthGetter) (*auditKVServer, *observer.ObservedLogs) {
+	core, logs := observer.New(zapcore.InfoLevel)
+	return &auditKVServer{lg: zap.New(core), ag: ag, kv: kv}, logs
+}
+
+func lastAuditFields(t *testing.T, logs *observer.ObservedLogs) map[string]any {
+	t.Helper()
+	all := logs.All()
+	if len(all) == 0 {
+		t.Fatal("expected at least one audit log entry, got none")
+	}
+	entry := all[len(all)-1]
+	fields := make(map[string]any, len(entry.Context))
+	for _, f := range entry.Context {
+		fields[f.Key] = f
+	}
+	return fields
+}
+
+func fieldString(t *testing.T, fields map[string]any, key string) string {
+	t.Helper()
+	f, ok := fields[key].(zapcore.Field)
+	if !ok {
+		t.Fatalf("field %q not found in audit log entry", key)
+	}
+	return f.String
+}
