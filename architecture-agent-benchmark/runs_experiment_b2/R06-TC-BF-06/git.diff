+func TestAuditKVServerOutcome(t *testing.T) {
+	ag := &fakeAuthGetter{authInfo: &auth.AuthInfo{Username: "alice"}}
+
+	t.Run("success", func(t *testing.T) {
+		kv := &fakeKVServer{putResp: &pb.PutResponse{}}
+		a, logs := newObservedAuditServer(kv, ag)
+
+		if _, err := a.Put(context.Background(), &pb.PutRequest{Key: []byte("a")}); err != nil {
+			t.Fatal(err)
+		}
+		if got := fieldString(t, lastAuditFields(t, logs), "outcome"); got != "success" {
+			t.Errorf("outcome = %q, want %q", got, "success")
+		}
+	})
+
+	t.Run("failure", func(t *testing.T) {
+		wantErr := errors.New("boom")
+		kv := &fakeKVServer{err: wantErr}
+		a, logs := newObservedAuditServer(kv, ag)
+
+		_, err := a.Put(context.Background(), &pb.PutRequest{Key: []byte("a")})
+		if !errors.Is(err, wantErr) {
+			t.Fatalf("expected error to pass through unchanged, got %v", err)
+		}
+		if got := fieldString(t, lastAuditFields(t, logs), "outcome"); got != "failure" {
+			t.Errorf("outcome = %q, want %q", got, "failure")
+		}
+	})
+}
