+func TestAuditKVServerCallerIdentity(t *testing.T) {
+	tests := []struct {
+		name     string
+		authInfo *auth.AuthInfo
+		err      error
+		want     string
+	}{
+		{name: "authenticated", authInfo: &auth.AuthInfo{Username: "alice"}, want: "alice"},
+		{name: "auth disabled or no token", authInfo: nil, err: nil, want: "unauthenticated"},
+		{name: "identity lookup error", authInfo: nil, err: errors.New("invalid auth token"), want: "unauthenticated"},
+		{name: "empty username", authInfo: &auth.AuthInfo{Username: ""}, want: "unauthenticated"},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			kv := &fakeKVServer{putResp: &pb.PutResponse{}}
+			ag := &fakeAuthGetter{authInfo: tc.authInfo, err: tc.err}
+			a, logs := newObservedAuditServer(kv, ag)
+
+			_, err := a.Put(context.Background(), &pb.PutRequest{Key: []byte("k")})
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+
+			fields := lastAuditFields(t, logs)
+			if got := fieldString(t, fields, "caller"); got != tc.want {
+				t.Errorf("caller = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
