+// TestAuditKVServerDoesNotEmbedRealInterface guards the structural coverage
+// guarantee: auditKVServer must implement every pb.KVServer method
+// explicitly rather than embedding pb.KVServer itself, so a method added to
+// pb.KVServer in the future cannot silently bypass the audit trail — it
+// must instead fail to compile until implemented here.
+func TestAuditKVServerDoesNotEmbedRealInterface(t *testing.T) {
+	typ := reflect.TypeOf(auditKVServer{})
+	kvServerType := reflect.TypeOf((*pb.KVServer)(nil)).Elem()
+
+	for i := 0; i < typ.NumField(); i++ {
+		f := typ.Field(i)
+		if f.Anonymous && f.Type.Implements(kvServerType) {
+			t.Fatalf("auditKVServer must not embed a field satisfying pb.KVServer directly (found %s %s); "+
+				"embedding would let future pb.KVServer methods silently skip the audit trail", f.Name, f.Type)
+		}
+	}
+}
