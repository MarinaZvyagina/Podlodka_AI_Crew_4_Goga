+package v3rpc
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	"go.uber.org/zap"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/etcdserver"
+)
+
+// auditKVServer decorates a pb.KVServer with a uniform compliance audit
+// trail: for every call it records the caller identity, operation kind, key
+// or key range, duration, and outcome, then returns the wrapped response and
+// error unchanged. It embeds pb.UnsafeKVServer only (never pb.KVServer), so
+// a future method added to pb.KVServer causes a compile error here instead
+// of silently bypassing the audit trail.
+type auditKVServer struct {
+	lg *zap.Logger
+	ag AuthGetter
+	kv pb.KVServer
+	// we want compile errors if new methods are added
+	pb.UnsafeKVServer
+}
+
+// NewAuditKVServer wraps kv with a decorator that records a compliance
+// audit entry for every request it handles, without altering the request,
+// response, or error produced by kv.
+func NewAuditKVServer(s *etcdserver.EtcdServer, kv pb.KVServer) pb.KVServer {
+	return &auditKVServer{lg: s.Logger(), ag: s, kv: kv}
+}
+
+func (a *auditKVServer) Range(ctx context.Context, r *pb.RangeRequest) (*pb.RangeResponse, error) {
+	start := time.Now()
+	resp, err := a.kv.Range(ctx, r)
+	a.record(ctx, "read", formatKeyRange(r.GetKey(), r.GetRangeEnd()), start, err)
+	return resp, err
+}
+
+func (a *auditKVServer) RangeStream(r *pb.RangeRequest, rs pb.KV_RangeStreamServer) error {
+	start := time.Now()
+	err := a.kv.RangeStream(r, rs)
+	a.record(rs.Context(), "read", formatKeyRange(r.GetKey(), r.GetRangeEnd()), start, err)
+	return err
+}
+
+func (a *auditKVServer) Put(ctx context.Context, r *pb.PutRequest) (*pb.PutResponse, error) {
+	start := time.Now()
+	resp, err := a.kv.Put(ctx, r)
+	a.record(ctx, "write", formatKeyRange(r.GetKey(), nil), start, err)
+	return resp, err
+}
+
+func (a *auditKVServer) DeleteRange(ctx context.Context, r *pb.DeleteRangeRequest) (*pb.DeleteRangeResponse, error) {
+	start := time.Now()
+	resp, err := a.kv.DeleteRange(ctx, r)
+	a.record(ctx, "delete", formatKeyRange(r.GetKey(), r.GetRangeEnd()), start, err)
+	return resp, err
+}
+
+func (a *auditKVServer) Txn(ctx context.Context, r *pb.TxnRequest) (*pb.TxnResponse, error) {
+	start := time.Now()
+	resp, err := a.kv.Txn(ctx, r)
+	a.record(ctx, "transaction", txnKeyRange(r), start, err)
+	return resp, err
+}
+
+func (a *auditKVServer) Compact(ctx context.Context, r *pb.CompactionRequest) (*pb.CompactionResponse, error) {
+	start := time.Now()
+	resp, err := a.kv.Compact(ctx, r)
+	a.record(ctx, "compact", "", start, err)
+	return resp, err
+}
+
+// caller resolves the identity of the request's caller from ctx, returning
+// "unauthenticated" when auth is disabled, no identity is present, or the
+// identity lookup itself fails.
+func (a *auditKVServer) caller(ctx context.Context) string {
+	authInfo, err := a.ag.AuthInfoFromCtx(ctx)
+	if err != nil || authInfo == nil || authInfo.Username == "" {
+		return "unauthenticated"
+	}
+	return authInfo.Username
+}
+
+// record emits one audit log entry for a handled key-value request.
+func (a *auditKVServer) record(ctx context.Context, operation, key string, start time.Time, err error) {
+	if a.lg == nil {
+		return
+	}
+	outcome := "success"
+	fields := []zap.Field{
+		zap.String("caller", a.caller(ctx)),
+		zap.String("operation", operation),
+		zap.String("key", key),
+		zap.Duration("duration", time.Since(start)),
+	}
+	if err != nil {
+		outcome = "failure"
+		fields = append(fields, zap.Error(err))
+	}
+	fields = append(fields, zap.String("outcome", outcome))
+	a.lg.Info("kv audit", fields...)
+}
+
+// formatKeyRange renders a single key, or a [key, rangeEnd) range when
+// rangeEnd is non-empty, as a human-readable string for the audit trail.
+func formatKeyRange(key, rangeEnd []byte) string {
+	if len(rangeEnd) == 0 {
+		return string(key)
+	}
+	return fmt.Sprintf("[%s, %s)", key, rangeEnd)
+}
+
+// txnKeyRange collects every distinct key or key range touched by a Txn
+// request — its compares plus every Put/DeleteRange/Range operation nested
+// in its success and failure branches, recursing into nested Txn ops — and
+// renders them as a single comma-separated audit key field.
+func txnKeyRange(r *pb.TxnRequest) string {
+	seen := make(map[string]struct{})
+	var ranges []string
+	add := func(kr string) {
+		if kr == "" {
+			return
+		}
+		if _, ok := seen[kr]; ok {
+			return
+		}
+		seen[kr] = struct{}{}
+		ranges = append(ranges, kr)
+	}
+
+	for _, c := range r.GetCompare() {
+		add(formatKeyRange(c.GetKey(), nil))
+	}
+
+	var walk func(ops []*pb.RequestOp)
+	walk = func(ops []*pb.RequestOp) {
+		for _, op := range ops {
+			switch v := op.GetRequest().(type) {
+			case *pb.RequestOp_RequestRange:
+				add(formatKeyRange(v.RequestRange.GetKey(), v.RequestRange.GetRangeEnd()))
+			case *pb.RequestOp_RequestPut:
+				add(formatKeyRange(v.RequestPut.GetKey(), nil))
+			case *pb.RequestOp_RequestDeleteRange:
+				add(formatKeyRange(v.RequestDeleteRange.GetKey(), v.RequestDeleteRange.GetRangeEnd()))
+			case *pb.RequestOp_RequestTxn:
+				walk(v.RequestTxn.GetSuccess())
+				walk(v.RequestTxn.GetFailure())
+			}
+		}
+	}
+	walk(r.GetSuccess())
+	walk(r.GetFailure())
+
+	return strings.Join(ranges, ", ")
+}
