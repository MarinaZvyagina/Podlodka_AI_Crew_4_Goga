@@ -1,13 +1,28 @@
 package mihon.domain.extension.interactor
 
 import dev.zacsweers.metro.Inject
+import mihon.domain.extension.model.InvalidExtensionRepoUrlException
 import mihon.domain.extension.repository.ExtensionStoreRepository
+import java.net.URI
+import java.net.URISyntaxException
 
 @Inject
 class AddExtensionStore(
     private val repository: ExtensionStoreRepository,
 ) {
     suspend operator fun invoke(indexUrl: String): Result<Unit> {
+        if (!indexUrl.isValidRepositoryUrl()) {
+            return Result.failure(InvalidExtensionRepoUrlException())
+        }
         return repository.insert(indexUrl)
     }
+
+    private fun String.isValidRepositoryUrl(): Boolean {
+        val uri = try {
+            URI(this)
+        } catch (_: URISyntaxException) {
+            return false
+        }
+        return (uri.scheme == "http" || uri.scheme == "https") && !uri.host.isNullOrEmpty()
+    }
 }
