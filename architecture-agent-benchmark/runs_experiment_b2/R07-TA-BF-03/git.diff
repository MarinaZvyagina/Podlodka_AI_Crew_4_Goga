diff --git a/domain/src/test/java/mihon/domain/extension/interactor/AddExtensionStoreTest.kt b/domain/src/test/java/mihon/domain/extension/interactor/AddExtensionStoreTest.kt
new file mode 100644
index 0000000..0d7ad7e
--- /dev/null
+++ b/domain/src/test/java/mihon/domain/extension/interactor/AddExtensionStoreTest.kt
@@ -0,0 +1,47 @@
+package mihon.domain.extension.interactor
+
+import io.kotest.matchers.shouldBe
+import io.kotest.matchers.types.shouldBeInstanceOf
+import io.mockk.coEvery
+import io.mockk.coVerify
+import io.mockk.mockk
+import kotlinx.coroutines.test.runTest
+import mihon.domain.extension.model.InvalidExtensionRepoUrlException
+import mihon.domain.extension.repository.ExtensionStoreRepository
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.parallel.Execution
+import org.junit.jupiter.api.parallel.ExecutionMode
+
+@Execution(ExecutionMode.CONCURRENT)
+class AddExtensionStoreTest {
+
+    private val repository = mockk<ExtensionStoreRepository>()
+    private val addExtensionStore = AddExtensionStore(repository)
+
+    @Test
+    fun `inserts the store when the index URL is a valid http or https URL`() = runTest {
+        coEvery { repository.insert(any()) } returns Result.success(Unit)
+
+        addExtensionStore("https://example.com/index.min.json") shouldBe Result.success(Unit)
+        coVerify { repository.insert("https://example.com/index.min.json") }
+    }
+
+    @Test
+    fun `rejects an invalid index URL without contacting the repository`() = runTest {
+        val result = addExtensionStore("not a url")
+
+        result.isFailure shouldBe true
+        result.exceptionOrNull().shouldBeInstanceOf<InvalidExtensionRepoUrlException>()
+        coVerify(exactly = 0) { repository.insert(any()) }
+    }
+
+    @Test
+    fun `rejects a blank index URL`() = runTest {
+        addExtensionStore("").isFailure shouldBe true
+    }
+
+    @Test
+    fun `rejects URLs using a non-http scheme`() = runTest {
+        addExtensionStore("ftp://example.com/index.min.json").isFailure shouldBe true
+    }
+}
