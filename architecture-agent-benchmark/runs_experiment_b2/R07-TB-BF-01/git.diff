+package tachiyomi.domain.updates.interactor
+
+import dev.zacsweers.metro.Inject
+import tachiyomi.domain.updates.repository.UpdatesRepository
+import kotlin.time.Instant
+
+@Inject
+class SetMangaUpdateSnooze(
+    private val repository: UpdatesRepository,
+) {
+
+    suspend fun await(mangaId: Long, until: Instant) {
+        repository.snoozeUpdates(mangaId, until.toEpochMilliseconds())
+    }
+
+    suspend fun await(mangaIds: Collection<Long>, until: Instant) {
+        mangaIds.forEach { repository.snoozeUpdates(it, until.toEpochMilliseconds()) }
+    }
+
+    suspend fun clear(mangaId: Long) {
+        repository.clearSnooze(mangaId)
+    }
+
+    suspend fun clear(mangaIds: Collection<Long>) {
+        mangaIds.forEach { repository.clearSnooze(it) }
+    }
+}
