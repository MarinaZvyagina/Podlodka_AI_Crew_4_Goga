+++ b/app/src/main/java/eu/kanade/tachiyomi/data/track/librereader/LibreReaderApi.kt
@@ -0,0 +1,159 @@
+package eu.kanade.tachiyomi.data.track.librereader
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRLibraryEntry
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRSeries
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRUser
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import eu.kanade.tachiyomi.network.DELETE
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import okhttp3.Credentials
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import uy.kohesive.injekt.injectLazy
+import tachiyomi.domain.track.model.Track as DomainTrack
+
+class LibreReaderApi(
+    private val libreReader: LibreReader,
+    interceptor: LibreReaderInterceptor,
+    private val client: OkHttpClient,
+) {
+    private val json: Json by injectLazy()
+
+    private val authClient by lazy {
+        client.newBuilder()
+            .addInterceptor(interceptor)
+            .build()
+    }
+
+    private val baseUrl: String
+        get() = libreReader.getApiUrl()
+
+    suspend fun authenticate(username: String, password: String): LRUser {
+        val request = Request.Builder()
+            .url("$baseUrl/api/auth/whoami")
+            .header("Authorization", Credentials.basic(username, password))
+            .build()
+
+        return with(json) {
+            client.newCall(request)
+                .awaitSuccess()
+                .parseAs<LRUser>()
+        }
+    }
+
+    suspend fun search(query: String): List<TrackSearch> {
+        val url = "$baseUrl/api/series/search".toHttpUrl().newBuilder()
+            .addQueryParameter("query", query)
+            .build()
+
+        return with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<List<LRSeries>>()
+                .map { parseSearchItem(it) }
+        }
+    }
+
+    suspend fun getSeriesDetails(id: Long): TrackSearch {
+        return with(json) {
+            authClient.newCall(GET("$baseUrl/api/series/$id"))
+                .awaitSuccess()
+                .parseAs<LRSeries>()
+                .let { parseSearchItem(it) }
+        }
+    }
+
+    suspend fun findLibraryEntry(track: Track): LRLibraryEntry {
+        val url = "$baseUrl/api/library".toHttpUrl().newBuilder()
+            .addQueryParameter("series_id", track.remote_id.toString())
+            .build()
+
+        return with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<LRLibraryEntry>()
+        }
+    }
+
+    suspend fun addLibraryEntry(track: Track): LRLibraryEntry {
+        val body = buildJsonObject {
+            put("series_id", track.remote_id)
+            put("status", track.status)
+            put("progress", track.last_chapter_read)
+        }
+
+        return with(json) {
+            authClient.newCall(
+                POST(
+                    url = "$baseUrl/api/library",
+                    body = body.toString().toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<LRLibraryEntry>()
+        }
+    }
+
+    suspend fun updateLibraryEntry(track: Track): LRLibraryEntry {
+        val body = buildJsonObject {
+            put("status", track.status)
+            put("progress", track.last_chapter_read)
+            put("score", track.score)
+        }
+
+        return with(json) {
+            authClient.newCall(
+                PUT(
+                    url = "$baseUrl/api/library/${track.library_id}",
+                    body = body.toString().toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<LRLibraryEntry>()
+        }
+    }
+
+    suspend fun deleteLibraryEntry(track: DomainTrack) {
+        authClient.newCall(DELETE(url = "$baseUrl/api/library/${track.libraryId}"))
+            .awaitSuccess()
+    }
+
+    private fun parseSearchItem(series: LRSeries): TrackSearch {
+        return TrackSearch.create(libreReader.id).apply {
+            remote_id = series.id
+            title = series.title
+            cover_url = series.coverUrl ?: ""
+            summary = series.description ?: ""
+            tracking_url = series.url ?: ""
+            total_chapters = series.totalChapters ?: 0
+            publishing_status = ""
+            publishing_type = ""
+            start_date = ""
+        }
+    }
+
+    companion object {
+        private val CONTENT_TYPE = "application/json".toMediaType()
+    }
+}
+
+fun Track.copyFrom(entry: LRLibraryEntry): Track = apply {
+    library_id = entry.id
+    remote_id = entry.seriesId
+    title = entry.title
+    status = entry.status
+    last_chapter_read = entry.progress
+    total_chapters = entry.totalChapters ?: total_chapters
+    score = entry.score ?: 0.0
+}
