diff --git a/data/src/main/java/tachiyomi/data/source/SourceMangaCache.kt b/data/src/main/java/tachiyomi/data/source/SourceMangaCache.kt
new file mode 100644
index 0000000..4746f49
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourceMangaCache.kt
@@ -0,0 +1,62 @@
+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.FilterList
+import eu.kanade.tachiyomi.source.model.MangasPage
+import kotlin.time.Duration.Companion.minutes
+import kotlin.time.TimeMark
+import kotlin.time.TimeSource
+
+/**
+ * Caches [MangasPage] results per source/query/filters/page so that repeating an identical
+ * popular/latest/search listing shortly after doesn't hit the network again.
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourceMangaCache {
+
+    private data class Key(
+        val sourceId: Long,
+        val query: String,
+        val filters: List<Filter<*>>,
+        val page: Int,
+    )
+
+    private class CacheEntry(val mangasPage: MangasPage, val timeMark: TimeMark)
+
+    private val cache = object : LinkedHashMap<Key, CacheEntry>(0, 0.75f, true) {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<Key, CacheEntry>): Boolean {
+            return size > MAX_ENTRIES
+        }
+    }
+
+    @Synchronized
+    fun get(sourceId: Long, query: String, filters: FilterList, page: Int): MangasPage? {
+        val key = Key(sourceId, query, filters.list, page)
+        val entry = cache[key] ?: return null
+        if (entry.timeMark.elapsedNow() > TTL) {
+            cache.remove(key)
+            return null
+        }
+        return entry.mangasPage
+    }
+
+    @Synchronized
+    fun put(sourceId: Long, query: String, filters: FilterList, page: Int, mangasPage: MangasPage) {
+        val key = Key(sourceId, query, filters.list, page)
+        cache[key] = CacheEntry(mangasPage, TimeSource.Monotonic.markNow())
+    }
+
+    @Synchronized
+    fun invalidate(sourceId: Long, query: String, filters: FilterList) {
+        cache.keys.removeAll { it.sourceId == sourceId && it.query == query && it.filters == filters.list }
+    }
+
+    companion object {
+        private const val MAX_ENTRIES = 60
+        private val TTL = 5.minutes
+    }
+}
