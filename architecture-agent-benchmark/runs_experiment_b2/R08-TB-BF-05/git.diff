+package org.thoughtcrime.securesms.mediasend
+
+import android.content.Context
+import androidx.annotation.WorkerThread
+import org.signal.core.models.media.Media
+import org.signal.core.models.media.TransformProperties
+
+/**
+ * Forces [TransformProperties.skipTransform] onto the transformed media, regardless of what an earlier transform in
+ * the pipeline did to its transform properties. An image edit render, for example, rebuilds [Media] from scratch and
+ * drops the original's transform properties entirely, so a per-item "send at full quality" choice has to be
+ * re-applied after any other transform rather than carried through it. Composing this last in a
+ * [CompositeMediaTransform] guarantees the choice survives.
+ */
+class FullQualityOverrideTransform : MediaTransform {
+  @WorkerThread
+  override fun transform(context: Context, media: Media): Media {
+    val existing = media.transformProperties ?: TransformProperties.empty()
+    return media.copy(transformProperties = existing.copy(skipTransform = true))
+  }
+}
