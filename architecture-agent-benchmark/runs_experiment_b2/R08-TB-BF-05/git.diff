+      // A per-item "send at full quality" choice overrides the batch quality above, and has to be composed last so it
+      // is not undone by a transform (an image edit render, in particular) that drops the original's transform
+      // properties.
+      if (it.transformProperties?.skipTransform == true) {
+        val existingTransform: MediaTransform? = modelsToRender[it]
+
+        modelsToRender[it] = if (existingTransform == null) {
+          FullQualityOverrideTransform()
+        } else {
+          CompositeMediaTransform(existingTransform, FullQualityOverrideTransform())
+        }
+      }
     }
 
     return modelsToRender
