+  /**
+   * Toggles whether [media] is sent without the batch's compression pass, overriding [MediaSendFlowState.sentMediaQuality]
+   * for this one item alone. The rest of the selection is unaffected.
+   *
+   * Cancels the item's pre-upload without restarting it — same as any other in-place edit — so the choice takes
+   * effect even if that item had already started uploading: the final send re-attaches it, uncompressed, through the
+   * normal (non-preupload) path, which is where [org.thoughtcrime.securesms.mediasend.v2.MediaSelectionRepository]
+   * honors a per-item full-quality override. Because the flag lives on the `Media` in [MediaSendFlowState.selectedMedia],
+   * which is persisted via [SavedStateHandle], the choice also survives the app being killed before the send completes.
+   */
+  private fun toggleFullQuality(media: Media) {
+    mutateSelection {
+      val snapshot = state.value
+      val current = snapshot.selectedMedia.firstOrNull { it.uri == media.uri } ?: return@mutateSelection
+
+      val isFullQuality = current.transformProperties?.skipTransform != true
+      val updated = current.copy(
+        transformProperties = (current.transformProperties ?: TransformProperties.empty()).copy(skipTransform = isFullQuality)
+      )
+
+      updateState {
+        copy(selectedMedia = selectedMedia.map { if (it.uri == updated.uri) updated else it })
+      }
+
+      preUploadController.cancelUpload(current)
+
+      fullQualityToastEvent(isFullQuality, updated)?.let { internalToastEvents.trySend(it) }
+    }
+  }
+
+  /**
+   * Copy confirming a single item's full-quality toggle. Unlike [qualityToastEvent], turning it back off does not
+   * say which quality the item falls back to — that is whatever [MediaSendFlowState.sentMediaQuality] is at send time.
+   */
+  private fun fullQualityToastEvent(isFullQuality: Boolean, media: Media): ToastEvent? {
+    val message = if (!isFullQuality) {
+      ToastMessage.Text(R.string.MediaSendViewModel__full_quality_removed)
+    } else when {
+      isNonGifVideo(media) -> ToastMessage.Text(R.string.MediaSendViewModel__video_set_to_full_quality)
+      ContentTypeUtil.isImageType(media.contentType) -> ToastMessage.Text(R.string.MediaSendViewModel__photo_set_to_full_quality)
+      else -> return null
+    }
+
+    return ToastEvent(
+      icon = if (isFullQuality) SignalIcons.QualityHigh else SignalIcons.QualityHighSlash,
+      message = message
+    )
+  }
+
   //endregion
 
   //region Video Editing
