index 0000000..b6d0cbc
--- /dev/null
+++ b/app/src/test/java/org/thoughtcrime/securesms/search/SearchRepositoryCacheTest.kt
@@ -0,0 +1,179 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import android.app.Application
+import assertk.assertThat
+import assertk.assertions.isEqualTo
+import assertk.assertions.isFalse
+import assertk.assertions.isTrue
+import io.mockk.Runs
+import io.mockk.every
+import io.mockk.just
+import io.mockk.mockk
+import io.mockk.slot
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.thoughtcrime.securesms.database.DatabaseObserver
+import org.thoughtcrime.securesms.database.MessageTable
+import org.thoughtcrime.securesms.database.MessageType
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.mms.IncomingMessage
+import org.thoughtcrime.securesms.recipients.RecipientId
+import org.thoughtcrime.securesms.testutil.RecipientTestRule
+
+/**
+ * Verifies [SearchRepository]'s result cache: a repeated identical search is served from cache,
+ * data changes stay invisible until the [DatabaseObserver] fires (matching how production code is
+ * only notified after a transaction commits), and distinct queries don't clobber each other's
+ * cache entries.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class SearchRepositoryCacheTest {
+
+  @get:Rule
+  val recipients = RecipientTestRule()
+
+  private val conversationListObserver = slot<DatabaseObserver.Observer>()
+
+  // RecipientTestRule blanket-mocks AppDependencies, leaving unstubbed DatabaseObserver methods
+  // (e.g. notifyRecipientChanged, fired by recipient setup below) with no answer. Stub the property
+  // to return our own relaxed mock so the rest of DatabaseObserver behaves like a no-op, while still
+  // letting us capture the listener registered by SearchRepository's cache invalidation wiring.
+  private val databaseObserver: DatabaseObserver = mockk(relaxed = true)
+
+  private lateinit var senderId: RecipientId
+  private lateinit var repository: SearchRepository
+
+  @Before
+  fun setUp() {
+    every { AppDependencies.databaseObserver } returns databaseObserver
+    every { databaseObserver.registerConversationListObserver(capture(conversationListObserver)) } just Runs
+
+    SearchRepository.resetCacheInvalidationStateForTesting()
+
+    senderId = recipients.createRecipient("Searchable Person")
+    repository = SearchRepository("Note to Self")
+  }
+
+  @Test
+  fun repeatedIdenticalSearchIsServedFromCache() {
+    insertIncomingMessage("hello there")
+
+    val first = repository.queryMessagesSync("hello", SearchFilter.EMPTY)
+    val second = repository.queryMessagesSync("hello", SearchFilter.EMPTY)
+
+    assertThat(first.results).isEqualTo(second.results)
+    assertThat(second === first).isTrue()
+  }
+
+  @Test
+  fun newlyMatchingMessageIsInvisibleUntilObserverFires() {
+    insertIncomingMessage("hello there", time = 1000)
+
+    val first = repository.queryMessagesSync("hello", SearchFilter.EMPTY)
+    assertThat(first.results.size).isEqualTo(1)
+
+    // A second matching message lands, but nothing has told the repository's cache about it yet --
+    // mirrors production, where invalidation only happens once the observer fires.
+    insertIncomingMessage("hello again", time = 1001)
+    val stillCached = repository.queryMessagesSync("hello", SearchFilter.EMPTY)
+    assertThat(stillCached === first).isTrue()
+    assertThat(stillCached.results.size).isEqualTo(1)
+
+    conversationListObserver.captured.onChanged()
+
+    val refreshed = repository.queryMessagesSync("hello", SearchFilter.EMPTY)
+    assertThat(refreshed === first).isFalse()
+    assertThat(refreshed.results.size).isEqualTo(2)
+  }
+
+  @Test
+  fun editedMessageNoLongerMatchesAfterObserverFires() {
+    val messageId = insertIncomingMessage("hello there")
+    assertThat(repository.queryMessagesSync("hello", SearchFilter.EMPTY).results.size).isEqualTo(1)
+
+    updateMessageBody(messageId, "goodbye there")
+    conversationListObserver.captured.onChanged()
+
+    assertThat(repository.queryMessagesSync("hello", SearchFilter.EMPTY).results.size).isEqualTo(0)
+    assertThat(repository.queryMessagesSync("goodbye", SearchFilter.EMPTY).results.size).isEqualTo(1)
+  }
+
+  @Test
+  fun differentQueriesAreCachedIndependently() {
+    insertIncomingMessage("alpha message")
+    insertIncomingMessage("beta message", time = 1001)
+
+    val alpha = repository.queryMessagesSync("alpha", SearchFilter.EMPTY)
+    val beta = repository.queryMessagesSync("beta", SearchFilter.EMPTY)
+
+    assertThat(alpha.results.size).isEqualTo(1)
+    assertThat(beta.results.size).isEqualTo(1)
+    assertThat(alpha.results.first().body.toString()).isEqualTo("alpha message")
+    assertThat(beta.results.first().body.toString()).isEqualTo("beta message")
+
+    // Re-querying "alpha" still hits its own cache entry rather than one clobbered by "beta".
+    assertThat(repository.queryMessagesSync("alpha", SearchFilter.EMPTY) === alpha).isTrue()
+  }
+
+  @Test
+  fun threadSearchIsCachedAndInvalidatedIndependentlyOfMessageSearch() {
+    createFindableThread("Findable Thread")
+
+    val first = repository.queryThreadsSync("Findable", false)
+    val second = repository.queryThreadsSync("Findable", false)
+    assertThat(second === first).isTrue()
+    assertThat(first.results.size).isEqualTo(1)
+
+    createFindableThread("Findable Second Thread")
+    val stillCached = repository.queryThreadsSync("Findable", false)
+    assertThat(stillCached === first).isTrue()
+
+    conversationListObserver.captured.onChanged()
+
+    val refreshed = repository.queryThreadsSync("Findable", false)
+    assertThat(refreshed === first).isFalse()
+    assertThat(refreshed.results.size).isEqualTo(2)
+  }
+
+  /**
+   * A thread with no messages is inactive and invisible to [org.thoughtcrime.securesms.database.ThreadTable.getFilteredConversationList],
+   * so give it one to make it show up in thread search.
+   */
+  private fun createFindableThread(profileName: String) {
+    val id = recipients.createRecipient(profileName)
+    recipients.insertOutgoingMessage(id)
+  }
+
+  private fun insertIncomingMessage(body: String, time: Long = 1000L): Long {
+    val threadId = SignalDatabase.threads.getOrCreateThreadIdFor(senderId, false)
+    val message = IncomingMessage(
+      type = MessageType.NORMAL,
+      from = senderId,
+      groupId = null,
+      body = body,
+      sentTimeMillis = time,
+      receivedTimeMillis = time,
+      serverTimeMillis = time,
+      isUnidentified = true
+    )
+    return SignalDatabase.messages.insertMessageInbox(message, threadId).get().messageId
+  }
+
+  private fun updateMessageBody(messageId: Long, body: String) {
+    SignalDatabase.writableDatabase.execSQL(
+      "UPDATE ${MessageTable.TABLE_NAME} SET ${MessageTable.BODY} = ? WHERE ${MessageTable.ID} = ?",
+      arrayOf(body, messageId)
+    )
+  }
+}
