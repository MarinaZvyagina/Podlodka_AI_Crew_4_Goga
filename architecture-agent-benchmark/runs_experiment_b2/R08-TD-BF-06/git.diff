   public interface ModelBuilder<T> {
     T build(@NonNull Cursor cursor);
   }
+
+  /**
+   * Holds the cross-instance search result cache. Nested so that loading it (and touching
+   * {@link AppDependencies}) is deferred until a query is actually run, rather than happening
+   * whenever the outer {@link SearchRepository} class is loaded (e.g. in unit tests that only
+   * exercise its static helper methods).
+   */
+  private static final class CacheHolder {
+    static final AtomicLong                                       generation   = new AtomicLong(0);
+    static final Map<ThreadCacheKey, CacheEntry<ThreadSearchResult>>   threadCache  = new ConcurrentHashMap<>();
+    static final Map<MessageCacheKey, CacheEntry<MessageSearchResult>> messageCache = new ConcurrentHashMap<>();
+
+    static {
+      DatabaseObserver observer = AppDependencies.getDatabaseObserver();
+      observer.registerConversationListObserver(CacheHolder::invalidate);
+      observer.registerMessageUpdateObserver(messageId -> invalidate());
+    }
+
+    static void invalidate() {
+      generation.incrementAndGet();
+      threadCache.clear();
+      messageCache.clear();
+    }
+  }
+
+  private static final class CacheEntry<T> {
+    final long generation;
+    final T    value;
+
+    CacheEntry(long generation, @NonNull T value) {
+      this.generation = generation;
+      this.value      = value;
+    }
+  }
+
+  private static final class ThreadCacheKey {
+    private final String  query;
+    private final boolean unreadOnly;
+    private final String  noteToSelfTitle;
+
+    ThreadCacheKey(@NonNull String query, boolean unreadOnly, @NonNull String noteToSelfTitle) {
+      this.query           = query;
+      this.unreadOnly      = unreadOnly;
+      this.noteToSelfTitle = noteToSelfTitle;
+    }
+
+    @Override
+    public boolean equals(Object o) {
+      if (this == o) return true;
+      if (!(o instanceof ThreadCacheKey)) return false;
+      ThreadCacheKey that = (ThreadCacheKey) o;
+      return unreadOnly == that.unreadOnly && query.equals(that.query) && noteToSelfTitle.equals(that.noteToSelfTitle);
+    }
+
+    @Override
+    public int hashCode() {
+      return Objects.hash(query, unreadOnly, noteToSelfTitle);
+    }
+  }
+
+  private static final class MessageCacheKey {
+    private final String       query;
+    private final SearchFilter filter;
+
+    MessageCacheKey(@NonNull String query, @NonNull SearchFilter filter) {
+      this.query  = query;
+      this.filter = filter;
+    }
+
+    @Override
+    public boolean equals(Object o) {
+      if (this == o) return true;
+      if (!(o instanceof MessageCacheKey)) return false;
+      MessageCacheKey that = (MessageCacheKey) o;
+      return query.equals(that.query) && filter.equals(that.filter);
+    }
+
+    @Override
+    public int hashCode() {
+      return Objects.hash(query, filter);
+    }
+  }
 }
