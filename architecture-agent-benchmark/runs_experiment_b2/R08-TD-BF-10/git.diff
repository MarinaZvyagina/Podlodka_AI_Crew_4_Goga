+  private static final class SearchCacheEpoch {
+    private static final AtomicLong CURRENT = new AtomicLong(0);
+
+    static {
+      DatabaseObserver observer = AppDependencies.getDatabaseObserver();
+      observer.registerConversationListObserver(CURRENT::incrementAndGet);
+      observer.registerMessageUpdateObserver(messageId -> CURRENT.incrementAndGet());
+    }
+
+    static long get() {
+      return CURRENT.get();
+    }
+  }
