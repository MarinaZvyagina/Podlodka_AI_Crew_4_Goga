+    // MARK: - Removing Data
+    @MainActor
+    func testRemoveWindowData_removesMatchingFileFromPrimaryAndBackup() async throws {
+        let subject = createSubject()
+        let primaryDirectoryURL = URL(string: "some/directory1")!
+        let backupDirectoryURL = URL(string: "some/directory2")!
+        let otherUUID = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        mockFileManager.primaryDirectoryURL = primaryDirectoryURL
+        mockFileManager.backupDirectoryURL = backupDirectoryURL
+        mockFileManager.pathContents = [
+            primaryDirectoryURL.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)"),
+            primaryDirectoryURL.appendingPathComponent("window-\(otherUUID.uuidString)")
+        ]
+        mockFileManager.backupPathContents = [
+            backupDirectoryURL.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)"),
+            backupDirectoryURL.appendingPathComponent("window-\(otherUUID.uuidString)")
+        ]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertTrue(mockFileManager.removedFilePaths.contains(
+            primaryDirectoryURL.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")))
+        XCTAssertTrue(mockFileManager.removedFilePaths.contains(
+            backupDirectoryURL.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")))
+        XCTAssertFalse(mockFileManager.removedFilePaths.contains(
+            primaryDirectoryURL.appendingPathComponent("window-\(otherUUID.uuidString)")))
+        XCTAssertFalse(mockFileManager.removedFilePaths.contains(
+            backupDirectoryURL.appendingPathComponent("window-\(otherUUID.uuidString)")))
+    }
+
+    @MainActor
+    func testRemoveWindowData_noBackupFile_doesNotError() async throws {
+        let subject = createSubject()
+        let primaryDirectoryURL = URL(string: "some/directory1")!
+        let backupDirectoryURL = URL(string: "some/directory2")!
+        mockFileManager.primaryDirectoryURL = primaryDirectoryURL
+        mockFileManager.backupDirectoryURL = backupDirectoryURL
+        mockFileManager.pathContents = [
+            primaryDirectoryURL.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        ]
+        mockFileManager.backupPathContents = []
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 1)
+        XCTAssertTrue(mockFileManager.removedFilePaths.contains(
+            primaryDirectoryURL.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")))
+    }
+
