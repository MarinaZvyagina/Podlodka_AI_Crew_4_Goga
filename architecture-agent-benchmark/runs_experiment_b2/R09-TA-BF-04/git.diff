+    // MARK: - Removing Window Data
+    @MainActor
+    func testRemoveWindowData_removesFromBothPrimaryAndBackupDirectories() async throws {
+        let subject = createSubject()
+        let keepUUID = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.pathContents = [
+            URL(string: "file:///window-\(defaultTestTabWindowUUID.uuidString)")!,
+            URL(string: "file:///window-\(keepUUID.uuidString)")!
+        ]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        // The directory (and its contents) is checked once for the primary location and
+        // once for the backup location, and only the matching UUID's file is removed each time.
+        XCTAssertEqual(mockFileManager.windowDataDirectoryCalledCount, 2)
+        XCTAssertEqual(mockFileManager.contentsOfDirectoryCalledCount, 2)
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+    }
+
+    @MainActor
+    func testRemoveWindowData_noMatchingFile_doesNotRemoveAnything() async throws {
+        let subject = createSubject()
+        let keepUUID = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.pathContents = [URL(string: "file:///window-\(keepUUID.uuidString)")!]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 0)
+    }
+
+    @MainActor
+    func testRemoveWindowData_noBackupDirectory_stillRemovesPrimary() async throws {
+        let subject = createSubject()
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = nil
+        mockFileManager.pathContents = [URL(string: "file:///window-\(defaultTestTabWindowUUID.uuidString)")!]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 1)
+    }
+
