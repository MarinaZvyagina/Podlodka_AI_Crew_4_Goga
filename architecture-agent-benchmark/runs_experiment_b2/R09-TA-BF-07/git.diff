+    // MARK: - Removing Data
+    @MainActor
+    func testRemoveWindowData_removesPrimaryAndBackupFiles() async throws {
+        let subject = createSubject()
+        let primaryURL = URL(string: "some/directory1")!
+        let backupURL = URL(string: "some/directory2")!
+        let primaryFileURL = primaryURL.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        let backupFileURL = backupURL.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        mockFileManager.primaryDirectoryURL = primaryURL
+        mockFileManager.backupDirectoryURL = backupURL
+        mockFileManager.pathContents = [primaryFileURL]
+        mockFileManager.backupPathContents = [backupFileURL]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(primaryFileURL))
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(backupFileURL))
+    }
+
+    @MainActor
+    func testRemoveWindowData_leavesOtherWindowsUntouched() async throws {
+        let subject = createSubject()
+        let otherUUID = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        let primaryURL = URL(string: "some/directory1")!
+        let backupURL = URL(string: "some/directory2")!
+        let targetPrimaryFileURL = primaryURL.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        let otherPrimaryFileURL = primaryURL.appendingPathComponent("window-\(otherUUID.uuidString)")
+        let otherBackupFileURL = backupURL.appendingPathComponent("window-\(otherUUID.uuidString)")
+        mockFileManager.primaryDirectoryURL = primaryURL
+        mockFileManager.backupDirectoryURL = backupURL
+        mockFileManager.pathContents = [targetPrimaryFileURL, otherPrimaryFileURL]
+        mockFileManager.backupPathContents = [otherBackupFileURL]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 1)
+        XCTAssertEqual(mockFileManager.removedFileURLs, [targetPrimaryFileURL])
+    }
+
