+    private static func messageRetentionLabel(forDays days: UInt32?) -> String {
+        switch days {
+        case nil:
+            return OWSLocalizedString("SETTINGS_MESSAGE_RETENTION_FOREVER", comment: "Label for the 'message retention' option that keeps messages forever.")
+        case 365:
+            return OWSLocalizedString("SETTINGS_MESSAGE_RETENTION_1_YEAR", comment: "Label for the 'message retention' option that keeps messages for 1 year.")
+        case .some(let days):
+            let format = OWSLocalizedString("SETTINGS_MESSAGE_RETENTION_N_DAYS_FORMAT", comment: "Label for a 'message retention' option that keeps messages for a given number of days. Embeds {{ the number of days }}.")
+            return String(format: format, String(days))
+        }
+    }
