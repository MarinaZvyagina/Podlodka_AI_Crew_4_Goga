+
+    // MARK: - Message Retention
+
+    private enum RetentionConstants {
+        static let secondsPerDay: TimeInterval = 24 * 60 * 60
+        static let minimumSweepInterval: TimeInterval = 24 * 60 * 60
+    }
+
+    /// Enqueues a bulk-delete job for every thread with messages older than
+    /// the given retention window. Safe to call unconditionally — threads
+    /// with nothing to delete are skipped.
+    public func sweepMessageRetention(
+        retentionPeriodDays: UInt32,
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        let cutoff = now.addingTimeInterval(-TimeInterval(retentionPeriodDays) * RetentionConstants.secondsPerDay)
+
+        threadStore.enumerateNonStoryThreads(tx: tx) { thread in
+            guard let anchorMessageRowId = InteractionFinder(threadUniqueId: thread.uniqueId)
+                .rowIdOfNewestInteraction(receivedAtOrBefore: cutoff, tx: tx)
+            else {
+                return true
+            }
+
+            self.addJob(
+                anchorMessageRowId: anchorMessageRowId,
+                isFullThreadDelete: false,
+                threadUniqueId: thread.uniqueId,
+                tx: tx,
+            )
+
+            return true
+        }
+
+        SSKPreferences.setLastMessageRetentionSweepAt(now, transaction: tx)
+    }
+
+    /// Throttled wrapper around `sweepMessageRetention` for routine/automatic
+    /// triggers (app launch, foreground) — does nothing if retention is
+    /// disabled or a sweep already ran recently.
+    func sweepMessageRetentionIfNeeded(
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        guard let retentionPeriodDays = SSKPreferences.messageRetentionPeriodDays(transaction: tx) else {
+            return
+        }
+
+        if
+            let lastSweptAt = SSKPreferences.lastMessageRetentionSweepAt(transaction: tx),
+            now.timeIntervalSince(lastSweptAt) < RetentionConstants.minimumSweepInterval
+        {
+            return
+        }
+
+        sweepMessageRetention(retentionPeriodDays: retentionPeriodDays, now: now, threadStore: threadStore, tx: tx)
+    }
 }
 
