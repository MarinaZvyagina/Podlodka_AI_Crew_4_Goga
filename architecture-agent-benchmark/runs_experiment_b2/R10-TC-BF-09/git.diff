@@ -1347,6 +1347,27 @@ public class InteractionFinder: NSObject {
 
         return mostRecentRowId
     }
+
+    /// The SQLite row ID of the newest interaction in this thread received
+    /// at or before `receivedAtOrBefore`, or `nil` if there are none.
+    func rowIdOfNewestInteraction(receivedAtOrBefore: Date, tx: DBReadTransaction) -> Int64? {
+        let sql = """
+        SELECT MAX(\(interactionColumn: .id))
+        FROM \(InteractionRecord.databaseTableName)
+        WHERE \(interactionColumn: .threadUniqueId) = ?
+        AND \(interactionColumn: .receivedAtTimestamp) <= ?
+        """
+        do {
+            return try Int64.fetchOne(
+                tx.database,
+                sql: sql,
+                arguments: [threadUniqueId, receivedAtOrBefore.ows_millisecondsSince1970],
+            )
+        } catch {
+            owsFailDebug("Failed to find newest interaction row ID before cutoff: \(error)")
+            return nil
+        }
+    }
 }
 
