+    private func showMessageRetentionPicker() {
+        let actionSheet = ActionSheetController(title: OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_TITLE",
+            comment: "Label for the 'message retention' setting, which lets a user automatically delete old messages after a chosen number of days.",
+        ))
+
+        for days in Self.messageRetentionPickerOptionsDays {
+            actionSheet.addAction(.init(
+                title: Self.messageRetentionPickerOptionTitle(forDays: days),
+                handler: { [weak self] _ in
+                    self?.didPickMessageRetention(days: days)
+                },
+            ))
+        }
+
+        actionSheet.addAction(OWSActionSheets.cancelAction)
+
+        presentActionSheet(actionSheet)
+    }
