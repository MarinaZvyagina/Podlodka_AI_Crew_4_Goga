+def _validate_capital_settings(conf: dict[str, Any]) -> None:
+    """
+    `available_capital` and `tradable_balance_ratio` both control starting capital sizing,
+    but only one of them is ever actually used - `available_capital` takes precedence and
+    `tradable_balance_ratio` is silently ignored when both are set.
+    """
+    if "available_capital" in conf and "tradable_balance_ratio" in conf:
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in the "
+            "configuration. Only one of these settings can be in effect at a time - "
+            "`available_capital` will take precedence and `tradable_balance_ratio` will be "
+            "ignored. Please remove one of these settings."
+        )
+
