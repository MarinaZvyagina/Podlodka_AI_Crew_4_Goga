@@ -110,6 +111,21 @@ def _validate_unlimited_amount(conf: dict[str, Any]) -> None:
         raise ConfigurationError("`max_open_trades` and `stake_amount` cannot both be unlimited.")
 
 
+def _validate_capital_settings(conf: dict[str, Any]) -> None:
+    """
+    `available_capital` and `tradable_balance_ratio` both influence starting capital sizing,
+    but only one of them is ever used - whichever is set takes over silently and the other
+    is ignored. Setting both is almost certainly not what the user intended.
+    """
+    if "available_capital" in conf and "tradable_balance_ratio" in conf:
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in the config. "
+            "Only one of these settings is ever used to size the starting capital - "
+            "`available_capital` takes precedence and `tradable_balance_ratio` will be "
+            "silently ignored. Please remove one of these settings."
+        )
+
+
