+def _validate_capital_settings(conf: dict[str, Any]) -> None:
+    """
+    `available_capital` and `tradable_balance_ratio` both influence how much starting
+    capital is used for trading, but only one of them is ever applied - if
+    `available_capital` is set, `tradable_balance_ratio` is silently ignored.
+    :raise: ConfigurationError if both are set explicitly
+    """
+    if "available_capital" in conf and "tradable_balance_ratio" in conf:
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in the "
+            "configuration, but only one of these settings can be in effect at a time - "
+            "if `available_capital` is set, `tradable_balance_ratio` will be ignored. "
+            "Please remove one of these settings."
+        )
+
