+@pytest.mark.parametrize("use_db", [True, False])
+def test_get_currency_exposure(mocker, default_conf_usdt, fee, use_db):
+    # _get_currency_exposure must return identical results whether trades are stored in the
+    # database (live/dry-run) or kept in-memory as LocalTrade (backtesting).
+    freqtrade = get_patched_freqtradebot(mocker, default_conf_usdt)
+    Trade.use_db = use_db
+    Trade.reset_trades()
+
+    create_mock_trades_usdt(fee, is_short=None, use_db=use_db)
+
+    # Open USDT trades created by create_mock_trades_usdt:
+    # NEO/USDT (20), XRP/USDT (20), LTC/USDT (20), ADA/USDT (20).
+    assert freqtrade.wallets._get_currency_exposure("NEO") == 20
+    assert freqtrade.wallets._get_currency_exposure("XRP") == 20
+    assert freqtrade.wallets._get_currency_exposure("LTC") == 20
+    assert freqtrade.wallets._get_currency_exposure("BTC") == 0
+
+    Trade.use_db = True
+
+
+@pytest.mark.parametrize(
+    "currency_exposure,stake_amount,expected",
+    [
+        # 30% of 1000 total capital = 300 max for the currency.
+        (0, 250, 250),  # No existing exposure, requested stake fits under the cap.
+        (0, 400, 300),  # No existing exposure, requested stake sized down to the cap.
+        (250, 100, 50),  # 250 already committed, remaining 100 sized down to the 50 left.
+        (300, 100, 0),  # Already at the cap, remaining room below min_stake -> skipped.
+    ],
+)
