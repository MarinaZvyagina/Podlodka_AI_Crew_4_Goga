+    mocker.patch("freqtrade.wallets.Wallets._get_currency_exposure", return_value=currency_exposure)
+    mocker.patch(f"{EXMS}.get_pair_base_currency", return_value="BTC")
+
+    res = freqtrade.wallets.validate_stake_amount("BTC/USDT", stake_amount, 11, 10000, None)
