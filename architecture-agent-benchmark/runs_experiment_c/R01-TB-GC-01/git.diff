+    def _get_currency_exposure(self, currency: str) -> float:
+        """
+        Sum of stake_amount currently committed to open trades that share the given
+        underlying (base) currency.
+        """
+        return sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if trade.safe_base_currency == currency
+        )
+
+    def _get_max_currency_exposure_stake(self, pair: str) -> float | None:
+        """
+        :return: Maximum stake amount that may still be allocated to `pair` without pushing
+        the combined exposure to its underlying (base) currency over the configured
+        `max_single_currency_exposure` limit, or None if the limit is not configured.
+        """
+        max_single_currency_exposure = self._config.get("max_single_currency_exposure")
+        if max_single_currency_exposure is None:
+            return None
+
+        currency = self._exchange.get_pair_base_currency(pair)
+        current_exposure = self._get_currency_exposure(currency)
+        exposure_cap = max_single_currency_exposure * self.get_total_stake_amount()
+        return max(exposure_cap - current_exposure, 0)
+
