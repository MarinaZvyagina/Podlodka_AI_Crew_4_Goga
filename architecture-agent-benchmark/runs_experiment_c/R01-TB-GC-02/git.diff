+def test_get_currency_exposure_stake(mocker, default_conf):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    def get_pair_quote_currency(pair):
+        return pair.split("/")[1].split(":")[0]
+
+    mocker.patch.multiple(
+        EXMS, get_pair_quote_currency=MagicMock(side_effect=get_pair_quote_currency)
+    )
+
+    open_trades = [
+        MagicMock(pair="ETH/USDT", stake_amount=100),
+        MagicMock(pair="BTC/USDT", stake_amount=50),
+        MagicMock(pair="ETH/BTC", stake_amount=20),
+    ]
+    mocker.patch("freqtrade.wallets.Trade.get_open_trades", return_value=open_trades)
+
+    assert freqtrade.wallets.get_currency_exposure_stake("XRP/USDT") == 150
+    assert freqtrade.wallets.get_currency_exposure_stake("LTC/BTC") == 20
+    assert freqtrade.wallets.get_currency_exposure_stake("LTC/ETH") == 0
+
+
+@pytest.mark.parametrize(
+    "stake_amount,min_stake,stake_available,max_stake,total_stake,exposure_ratio,"
+    "currency_exposure,expected",
+    [
+        # No limit configured (0/None) -> untouched
+        (100, 11, 500, 10000, 1000, None, 0, 100),
+        # Plenty of headroom left for the currency (50% of 1000 = 500, 0 used) -> untouched
+        (100, 11, 500, 10000, 1000, 0.5, 0, 100),
+        # Only 450 left of a 500 currency-cap (50 already committed) -> untouched
+        (100, 11, 500, 10000, 1000, 0.5, 50, 100),
+        # Cap allows only 30 more (500 - 470) -> stake reduced to 30
+        (100, 11, 500, 10000, 1000, 0.5, 470, 30),
+        # No room left at all -> trade skipped
+        (100, 11, 500, 10000, 1000, 0.5, 500, 0),
+        # Remaining room (5) below min_stake (11) -> trade skipped
+        (100, 11, 500, 10000, 1000, 0.5, 495, 0),
+    ],
+)
+def test_validate_stake_amount_max_currency_exposure(
+    mocker,
+    default_conf,
+    stake_amount,
+    min_stake,
+    stake_available,
+    max_stake,
+    total_stake,
+    exposure_ratio,
+    currency_exposure,
+    expected,
+):
+    if exposure_ratio is not None:
+        default_conf["max_currency_exposure"] = exposure_ratio
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    mocker.patch(
+        "freqtrade.wallets.Wallets.get_available_stake_amount", return_value=stake_available
+    )
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=total_stake)
+    mocker.patch(
+        "freqtrade.wallets.Wallets.get_currency_exposure_stake", return_value=currency_exposure
+    )
+    res = freqtrade.wallets.validate_stake_amount(
+        "XRP/USDT", stake_amount, min_stake, max_stake, None
+    )
+    assert res == expected
+
+
+def test_validate_stake_amount_max_currency_exposure_live_backtest_parity(
+    mocker, default_conf, caplog
+):
+    """
+    The exposure-cap decision must be identical whether Wallets runs live/dry-run
+    or as part of a backtest - only the local logging differs (suppressed in backtest).
+    """
+    default_conf["max_currency_exposure"] = 0.5
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=500)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+    mocker.patch("freqtrade.wallets.Wallets.get_currency_exposure_stake", return_value=470)
+
+    backtest_wallets = Wallets(default_conf, freqtrade.exchange, is_backtest=True)
+
+    caplog.clear()
+    live_result = freqtrade.wallets.validate_stake_amount("XRP/USDT", 100, 11, 10000, None)
+    backtest_result = backtest_wallets.validate_stake_amount("XRP/USDT", 100, 11, 10000, None)
+
+    assert live_result == backtest_result == 30
+    # Live logs the reason, backtest stays silent - as with all other sizing decisions.
+    assert log_has_re(".*limited by max_currency_exposure.*", caplog)
+    caplog.clear()
+    backtest_wallets.validate_stake_amount("XRP/USDT", 100, 11, 10000, None)
+    assert not log_has_re(".*limited by max_currency_exposure.*", caplog)
+
