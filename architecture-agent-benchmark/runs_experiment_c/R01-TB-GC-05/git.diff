+    def _apply_currency_exposure_limit(
+        self, pair: str, max_allowed_stake: float, trade_amount: float | None
+    ) -> float:
+        """
+        Clamp `max_allowed_stake` so that opening or increasing this trade cannot push the
+        combined stake committed to the pair's underlying (quote/settlement) currency - across
+        all simultaneously open trades - above the strategy-configured `max_currency_exposure`
+        share of total tradable capital.
+        :param pair: Pair the trade is for
+        :param max_allowed_stake: Currently allowed max stake, before applying this limit
+        :param trade_amount: Stake already tied up in this same trade, if increasing a
+            position (None for a brand-new trade)
+        :return: max_allowed_stake, further reduced if the currency exposure cap is binding
+        """
+        max_currency_exposure = self._config.get("max_currency_exposure")
+        if not max_currency_exposure:
+            return max_allowed_stake
+
+        quote_currency = self._exchange.get_pair_quote_currency(pair)
+        currency_cap = self.get_total_stake_amount() * max_currency_exposure
+        committed = Trade.total_open_trades_stakes_for_currency(quote_currency)
+        if trade_amount:
+            # trade_amount is this trade's own already-tied-up stake, already included in
+            # `committed` since the trade is currently open - exclude it to avoid double-counting.
+            committed -= trade_amount
+        available_for_currency = max(currency_cap - committed, 0)
+
+        if available_for_currency < max_allowed_stake:
+            self._local_log(
+                f"Stake amount for pair {pair} is capped to {available_for_currency:.8f} "
+                f"{self._config['stake_currency']} to keep combined {quote_currency} exposure "
+                f"within the configured max_currency_exposure ({max_currency_exposure:.2%}).",
+                level="warning",
+            )
+        return min(max_allowed_stake, available_for_currency)
+
     def _local_log(self, msg: str, level: Literal["info", "warning", "debug"] = "info") -> None:
