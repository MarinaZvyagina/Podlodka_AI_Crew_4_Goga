+    def total_open_trades_stakes_for_currency(quote_currency: str) -> float:
+        """
+        Calculates the total invested amount, in stake currency, of open trades whose
+        underlying (quote/settlement) currency is `quote_currency`.
+        Uses `safe_quote_currency` (rather than a DB-side filter on the `stake_currency`
+        column) so that DB-backed and in-memory (backtesting) trades are grouped identically,
+        including for older trades that predate the `stake_currency` column.
+        """
+        return sum(
+            t.stake_amount
+            for t in Trade.get_trades_proxy(is_open=True)
+            if t.safe_quote_currency == quote_currency
+        )
