+def _mock_open_trade(pair, stake_amount):
+    return SimpleNamespace(pair=pair, stake_amount=stake_amount)
+
+
+@pytest.mark.parametrize(
+    "max_exposure,other_trades,trade_amount,total_stake,expected",
+    [
+        # No limit configured -> disabled
+        (None, [], None, 1000, None),
+        # No existing exposure, 30% of 1000 available for a new trade
+        (0.3, [], None, 1000, 300),
+        # 200 USDT already committed to other USDT pairs, 100 USDT room left
+        (0.3, [("ETH/USDT", 200)], None, 1000, 100),
+        # Trades in a different underlying currency (BTC) don't count against USDT exposure
+        (0.3, [("ETH/BTC", 200)], None, 1000, 300),
+        # Position adjustment: the trade's own existing stake reserves room too
+        (0.3, [("ETH/USDT", 100)], 100, 1000, 100),
+        # Exposure already at/above the cap -> no room left
+        (0.3, [("ETH/USDT", 350)], None, 1000, 0),
+    ],
+)
+def test_get_underlying_currency_exposure_limit(
+    mocker, default_conf, max_exposure, other_trades, trade_amount, total_stake, expected
+):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    if max_exposure is not None:
+        freqtrade.config["max_underlying_currency_exposure"] = max_exposure
+
+    quote_currencies = {"XRP/USDT": "USDT", "ETH/USDT": "USDT", "ETH/BTC": "BTC"}
+    mocker.patch(f"{EXMS}.get_pair_quote_currency", side_effect=lambda pair: quote_currencies[pair])
+    mocker.patch(
+        "freqtrade.persistence.models.Trade.get_open_trades",
+        return_value=[_mock_open_trade(pair, amount) for pair, amount in other_trades],
+    )
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=total_stake)
+
+    result = freqtrade.wallets._get_underlying_currency_exposure_limit("XRP/USDT", trade_amount)
+    assert result == expected
+
+
+def test_validate_stake_amount_underlying_currency_exposure(mocker, default_conf):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    freqtrade.config["max_underlying_currency_exposure"] = 0.3
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=1000)
+    mocker.patch(f"{EXMS}.get_pair_quote_currency", return_value="USDT")
+    mocker.patch(
+        "freqtrade.persistence.models.Trade.get_open_trades",
+        return_value=[_mock_open_trade("ETH/USDT", 200)],
+    )
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+
+    # Requested stake (150) exceeds remaining exposure room (100) -> resized down.
+    res = freqtrade.wallets.validate_stake_amount("XRP/USDT", 150, 10, 10000, None)
+    assert res == 100
+
+    # Remaining exposure room is below min-stake -> trade is skipped entirely.
+    res = freqtrade.wallets.validate_stake_amount("XRP/USDT", 150, 150, 10000, None)
+    assert res == 0
+
