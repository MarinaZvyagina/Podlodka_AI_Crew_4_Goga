+    def _get_underlying_currency_exposure_limit(
+        self, pair: str, trade_amount: float | None
+    ) -> float | None:
+        """
+        Compute the maximum additional stake that may be committed to `pair` without the
+        combined stake of all open trades sharing its underlying (quote) currency exceeding
+        `max_underlying_currency_exposure` (a fraction of total tradable capital).
+        Shared by live/dry-run and backtesting, since both query the same open-trades
+        interface and configuration.
+        :param trade_amount: Stake already committed by the trade being resized (None for a
+            brand new trade).
+        :return: None if no exposure limit is configured, otherwise the maximum additional
+            stake (>= 0) that may be committed to `pair`.
+        """
+        max_exposure_ratio = self._config.get("max_underlying_currency_exposure")
+        if not max_exposure_ratio:
+            return None
+
+        currency = self._exchange.get_pair_quote_currency(pair)
+        other_exposure = sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if trade.pair != pair and self._exchange.get_pair_quote_currency(trade.pair) == currency
+        )
+        max_currency_stake = self.get_total_stake_amount() * max_exposure_ratio
+        return max(max_currency_stake - other_exposure - (trade_amount or 0), 0)
+
