+++ b/tests/test_wallets.py
@@ -218,6 +218,62 @@ def test_validate_stake_amount(
     assert res == expected
 
 
+@pytest.mark.parametrize(
+    "max_currency_exposure,other_stake,requested,expected",
+    [
+        # Disabled (default) - no limit applied.
+        (1.0, 300, 400, 400),
+        # 0.5 * 1000 total capital = 500 cap; 300 already committed -> 200 room.
+        (0.5, 300, 400, 200),
+        # Already at (or above) the cap -> no room left.
+        (0.5, 500, 400, 0),
+        # Requested amount already fits under the remaining room.
+        (0.5, 100, 200, 200),
+    ],
+)
+def test_validate_stake_amount_currency_exposure(
+    mocker, default_conf, max_currency_exposure, other_stake, requested, expected
+):
+    conf = deepcopy(default_conf)
+    conf["max_currency_exposure"] = max_currency_exposure
+    freqtrade = get_patched_freqtradebot(mocker, conf)
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=1000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+    mocker.patch(
+        "freqtrade.wallets.Wallets._get_underlying_currency",
+        return_value="USDT",
+    )
+    other_trade = MagicMock(pair="ETH/USDT", stake_amount=other_stake)
+    mocker.patch("freqtrade.persistence.models.Trade.get_open_trades", return_value=[other_trade])
+
+    res = freqtrade.wallets.validate_stake_amount("BTC/USDT", requested, 10, 10000, None)
+    assert res == expected
+
+
+def test_validate_stake_amount_currency_exposure_ignores_other_currencies(mocker, default_conf):
+    conf = deepcopy(default_conf)
+    conf["max_currency_exposure"] = 0.5
+    freqtrade = get_patched_freqtradebot(mocker, conf)
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=1000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+    mocker.patch(
+        "freqtrade.exchange.Exchange.get_pair_settle_currency",
+        return_value="",
+    )
+    mocker.patch(
+        "freqtrade.exchange.Exchange.get_pair_quote_currency",
+        side_effect=lambda pair: pair.split("/")[1],
+    )
+    # BTC-margined trade should not count against a USDT exposure cap.
+    other_trade = MagicMock(pair="ETH/BTC", stake_amount=900)
+    mocker.patch("freqtrade.persistence.models.Trade.get_open_trades", return_value=[other_trade])
+
+    res = freqtrade.wallets.validate_stake_amount("BTC/USDT", 400, 10, 10000, None)
+    assert res == 400
+
