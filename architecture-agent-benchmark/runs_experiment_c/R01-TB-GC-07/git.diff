+    def _get_underlying_currency(self, pair: str) -> str:
+        """
+        The currency that a pair's risk/capital is concentrated in - the settlement
+        (margin) currency for derivatives, falling back to the quote currency for
+        spot pairs (or if settlement currency is unknown).
+        """
+        return self._exchange.get_pair_settle_currency(
+            pair
+        ) or self._exchange.get_pair_quote_currency(pair)
+
+    def _apply_currency_exposure_limit(
+        self, pair: str, max_allowed_stake: float, trade_amount: float | None
+    ) -> float:
+        """
+        Limit the stake amount so that the combined exposure to this pair's underlying
+        currency across all open trades does not exceed `max_currency_exposure` of the
+        total tradable capital.
+        """
+        max_currency_exposure = self._config.get("max_currency_exposure", 1.0)
+        if max_currency_exposure >= 1.0:
+            return max_allowed_stake
+
+        currency = self._get_underlying_currency(pair)
+        committed = sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if self._get_underlying_currency(trade.pair) == currency
+        )
+        already_committed = committed - (trade_amount or 0)
+        exposure_limit = self.get_total_stake_amount() * max_currency_exposure
+        remaining_room = max(exposure_limit - already_committed, 0)
+
+        if remaining_room < max_allowed_stake:
+            self._local_log(
+                f"Stake amount for pair {pair} is limited to {remaining_room:.8f} to keep "
+                f"exposure to underlying currency {currency} under {max_currency_exposure:.2%} "
+                f"of total tradable capital ({already_committed:.8f} already committed)."
+            )
+            return remaining_room
+        return max_allowed_stake
