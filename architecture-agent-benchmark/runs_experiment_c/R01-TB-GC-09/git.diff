+    def _get_underlying_currency_exposure(self, currency: str) -> float:
+        """
+        Sum of stake amounts currently committed to open trades that share the given
+        underlying (quote) currency.
+        """
+        return sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if trade.safe_quote_currency == currency
+        )
+
+    def _limit_stake_for_currency_exposure(
+        self, pair: str, stake_amount: float, min_stake_amount: float | None
+    ) -> float:
+        """
+        Limit stake_amount so the combined stake of all currently open trades sharing the
+        pair's underlying (quote) currency does not exceed the configured
+        `max_underlying_currency_exposure` fraction of total tradable capital.
+        :return: (possibly reduced) stake_amount, or 0 if the currency is already at/over
+                 its exposure limit.
+        """
+        max_exposure_ratio = self._config.get("max_underlying_currency_exposure")
+        if max_exposure_ratio is None or stake_amount <= 0:
+            return stake_amount
+
+        currency = self._exchange.get_pair_quote_currency(pair)
+        max_currency_stake = self.get_total_stake_amount() * max_exposure_ratio
+        current_exposure = self._get_underlying_currency_exposure(currency)
+        available_for_currency = max(max_currency_stake - current_exposure, 0)
+
+        if stake_amount > available_for_currency:
+            if min_stake_amount is not None and available_for_currency < min_stake_amount:
+                self._local_log(
+                    f"Underlying currency exposure limit for {currency} reached "
+                    f"({current_exposure:.8f} already committed, limit is "
+                    f"{max_currency_stake:.8f} = {max_exposure_ratio:.2%} of tradable "
+                    f"capital), ignoring trade for {pair}."
+                )
+                return 0
+            self._local_log(
+                f"Stake amount for pair {pair} would raise {currency} exposure above the "
+                f"configured limit of {max_exposure_ratio:.2%} of tradable capital "
+                f"({current_exposure:.8f} + {stake_amount:.8f} > {max_currency_stake:.8f}), "
+                f"adjusting to {available_for_currency:.8f}."
+            )
+            stake_amount = available_for_currency
+
+        return stake_amount
+
