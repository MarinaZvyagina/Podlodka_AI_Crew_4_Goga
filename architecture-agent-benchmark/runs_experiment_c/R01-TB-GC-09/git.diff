@@ -330,6 +330,43 @@ def test_create_trade(
     assert whitelist == default_conf_usdt["exchange"]["pair_whitelist"]
 
 
+def test_create_trade_underlying_currency_exposure_limit(
+    default_conf_usdt, ticker_usdt, fee, mocker, caplog
+) -> None:
+    patch_RPCManager(mocker)
+    patch_exchange(mocker)
+    mocker.patch.multiple(
+        EXMS,
+        fetch_ticker=ticker_usdt,
+        get_fee=fee,
+        get_min_pair_stake_amount=MagicMock(return_value=1.0),
+        _dry_is_price_crossed=MagicMock(return_value=False),
+    )
+    default_conf_usdt["max_open_trades"] = 3
+    # Total tradable capital is (1000 * 0.99) = 990 -> only 99 (10%) may be committed to USDT.
+    default_conf_usdt["max_underlying_currency_exposure"] = 0.1
+    freqtrade = FreqtradeBot(default_conf_usdt)
+    patch_get_signal(freqtrade)
+
+    assert freqtrade.create_trade("ETH/USDT") is True
+    trade1 = Trade.session.scalars(select(Trade)).first()
+    assert pytest.approx(trade1.stake_amount) == 60.0
+
+    # A 2nd trade would push USDT exposure to 120 - above the 99 limit - so it's resized.
+    caplog.clear()
+    assert freqtrade.create_trade("LTC/USDT") is True
+    trade2 = Trade.session.scalars(select(Trade).order_by(Trade.id.desc())).first()
+    assert trade2.id != trade1.id
+    assert pytest.approx(trade2.stake_amount) == 39.0
+    assert log_has_re(r"Stake amount for pair LTC/USDT would raise USDT exposure.*", caplog)
+
+    # A 3rd trade has no room left at all - it must be rejected outright.
+    caplog.clear()
+    assert freqtrade.create_trade("NEO/USDT") is False
+    assert log_has_re(r"Underlying currency exposure limit for USDT reached.*", caplog)
+    assert Trade.session.scalars(select(Trade)).all() == [trade1, trade2]
+
+
