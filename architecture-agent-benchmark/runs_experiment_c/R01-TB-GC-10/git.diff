@@ -407,6 +407,43 @@ class Wallets:
 
         return self._check_available_stake_amount(stake_amount, available_amount)
 
+    def _get_currency_exposure_stake(self, currency: str) -> float:
+        """
+        Sum of stake_amount currently committed to open trades sharing the given
+        underlying (base) currency.
+        """
+        return sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if trade.safe_base_currency == currency
+        )
+
+    def _apply_currency_exposure_limit(self, pair: str, max_allowed_stake: float) -> float:
+        """
+        Further limit max_allowed_stake so that the combined stake_amount of all
+        open trades sharing the same underlying (base) currency as `pair` does not
+        exceed `max_currency_exposure` (a share of total tradable capital).
+        """
+        max_currency_exposure = self._config.get("max_currency_exposure")
+        if not max_currency_exposure:
+            return max_allowed_stake
+
+        currency = self._exchange.get_pair_base_currency(pair)
+        allowed_currency_stake = self.get_total_stake_amount() * max_currency_exposure
+        current_currency_exposure = self._get_currency_exposure_stake(currency)
+        max_stake_for_currency = max(allowed_currency_stake - current_currency_exposure, 0)
+
+        if max_stake_for_currency < max_allowed_stake:
+            self._local_log(
+                f"Stake amount for pair {pair} is limited by the configured "
+                f"max_currency_exposure ({max_currency_exposure:.2%}) for {currency} "
+                f"(already committed: {current_currency_exposure}, "
+                f"allowed: {allowed_currency_stake}); "
+                f"adjusting max stake to {max_stake_for_currency}."
+            )
+            max_allowed_stake = max_stake_for_currency
+        return max_allowed_stake
+
