+@pytest.mark.parametrize(
+    "max_currency_exposure,other_exposure,total_stake,stake_amount,expected",
+    [
+        # Disabled - stake amount is untouched.
+        (None, 250, 1000, 100, 100),
+        (0, 250, 1000, 100, 100),
+        # 30% of 1000 = 300 allowed, 250 already committed -> only 50 left, resized down.
+        (0.3, 250, 1000, 100, 50),
+        # Bucket already full -> trade skipped entirely.
+        (0.3, 300, 1000, 100, 0),
+        (0.3, 400, 1000, 100, 0),
+        # Plenty of headroom -> stake amount untouched.
+        (0.5, 100, 1000, 300, 300),
+    ],
+)
+def test_validate_stake_amount_currency_exposure(
+    mocker,
+    default_conf,
+    max_currency_exposure,
+    other_exposure,
+    total_stake,
+    stake_amount,
+    expected,
+):
+    if max_currency_exposure is not None:
+        default_conf["max_currency_exposure"] = max_currency_exposure
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    mocker.patch(
+        "freqtrade.wallets.Wallets.get_available_stake_amount", return_value=10000
+    )
+    mocker.patch(
+        "freqtrade.wallets.Wallets.get_total_stake_amount", return_value=total_stake
+    )
+    mocker.patch(
+        "freqtrade.wallets.Wallets._get_currency_exposure_stake", return_value=other_exposure
+    )
+
+    res = freqtrade.wallets.validate_stake_amount("BTC/USDT", stake_amount, None, 10000, None)
+    assert res == expected
+
+
+def test_get_currency_exposure_stake(mocker, default_conf_usdt, fee):
