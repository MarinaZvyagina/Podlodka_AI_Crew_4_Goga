@@ -590,6 +590,50 @@ def test_backtest__enter_trade(default_conf, fee, mocker) -> None:
     assert trade.stake_amount == 300.0
 
 
+def test_backtest__enter_trade_max_currency_exposure(default_conf, fee, mocker) -> None:
+    default_conf["use_exit_signal"] = False
+    mocker.patch(f"{EXMS}.get_fee", fee)
+    mocker.patch(f"{EXMS}.get_min_pair_stake_amount", return_value=10)
+    mocker.patch(f"{EXMS}.get_max_pair_stake_amount", return_value=float("inf"))
+    patch_exchange(mocker)
+    default_conf["stake_amount"] = 200
+    default_conf["max_open_trades"] = 5
+    default_conf["max_currency_exposure"] = 0.3
+    backtesting = Backtesting(default_conf)
+    backtesting._set_strategy(backtesting.strategylist[0])
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+    # ETH/BTC has a known "base" (ETH) in the mocked markets, unlike UNITTEST/BTC.
+    pair = "ETH/BTC"
+    row = [
+        pd.Timestamp(year=2020, month=1, day=1, hour=5, minute=0),
+        1,  # Buy
+        0.001,  # Open
+        0.0011,  # Close
+        0,  # Sell
+        0.00099,  # Low
+        0.0012,  # High
+        "",  # Buy Signal Name
+    ]
+    # 30% of the (mocked) total tradable capital of 1000 = 300 max for "ETH" exposure.
+    # First trade fits fully. _enter_trade adds successful entries to LocalTrade.bt_trades_open
+    # itself, so subsequent calls already see this trade's exposure without any manual bookkeeping.
+    trade = backtesting._enter_trade(pair, row=row, direction="long")
+    assert trade is not None
+    assert trade.stake_amount == 200
+
+    # Second trade would push combined exposure to 400 > 300 - resized down to the 100 left.
+    trade2 = backtesting._enter_trade(pair, row=row, direction="long")
+    assert trade2 is not None
+    assert trade2.stake_amount == 100
+
+    # Exposure bucket is now fully used (300/300) - a third trade must not be opened.
+    trade3 = backtesting._enter_trade(pair, row=row, direction="long")
+    assert trade3 is None
+
+    LocalTrade.bt_trades_open.remove(trade)
+    LocalTrade.bt_trades_open.remove(trade2)
+
+
