+@pytest.mark.parametrize("only_per_pair", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses_perpair(mocker, default_conf, fee, caplog, only_per_pair):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 1000,
+            "stop_duration": 60,
+            "max_consecutive_losses": 3,
+            "only_per_pair": only_per_pair,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped for .*"
+    pair = "XRP/BTC"
+
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # A winning trade, followed by only 2 losses - streak is too short to lock.
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        min_ago_open=500,
+        min_ago_close=400,
+        profit_rate=1.1,
+    )
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=300,
+        min_ago_close=200,
+        profit_rate=0.9,
+    )
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=150,
+        min_ago_close=100,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 3rd consecutive loss for this pair.
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=60,
+        min_ago_close=30,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+
+    assert freqtrade.protections.stop_per_pair(pair)
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_pair_locked(pair)
+    assert freqtrade.protections.global_stop() != only_per_pair
+    assert PairLocks.is_global_lock() != only_per_pair
+
+
+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses_global_multi_pair(mocker, default_conf, fee, caplog):
+    """
+    Losses spread across different pairs should not trigger any per-pair lock
+    individually, but should trigger the bot-wide (global) lock once the
+    bot-wide streak reaches the configured threshold.
+    """
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 1000,
+            "stop_duration": 60,
+            "max_consecutive_losses": 3,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped for .*"
+
+    for i, pair in enumerate(["XRP/BTC", "ETH/BTC", "LTC/BTC"]):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.STOP_LOSS.value,
+            min_ago_open=100 - i * 20,
+            min_ago_close=40 - i * 10,
+            profit_rate=0.9,
+        )
+    Trade.commit()
+
+    # None of the individual pairs has 3 losses of its own.
+    for pair in ["XRP/BTC", "ETH/BTC", "LTC/BTC"]:
+        assert not freqtrade.protections.stop_per_pair(pair)
+        assert not PairLocks.is_pair_locked(pair)
+
+    # But bot-wide, 3 consecutive losses in a row (regardless of pair) lock everything.
+    assert freqtrade.protections.global_stop()
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_global_lock()
+
