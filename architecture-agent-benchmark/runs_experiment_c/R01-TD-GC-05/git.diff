+@pytest.mark.parametrize("exchange_name", EXCHANGES)
+def test_fetch_ticker_cached(default_conf, mocker, exchange_name, time_machine):
+    api_mock = MagicMock()
+    tick1 = {"symbol": "ETH/BTC", "bid": 0.00001098, "ask": 0.00001099, "last": 0.0001}
+    tick2 = {"symbol": "ETH/BTC", "bid": 0.5, "ask": 1, "last": 42}
+    api_mock.fetch_ticker = MagicMock(return_value=tick1)
+    exchange = get_patched_exchange(mocker, default_conf, api_mock, exchange=exchange_name)
+
+    start_dt = datetime(2023, 12, 1, 0, 10, 0, tzinfo=UTC)
+    time_machine.move_to(start_dt, tick=False)
+
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert ticker == tick1
+    assert api_mock.fetch_ticker.call_count == 1
+
+    # A different pair is not affected by the cache
+    exchange.fetch_ticker(pair="LTC/BTC")
+    assert api_mock.fetch_ticker.call_count == 2
+
+    # Repeated request for the same pair a moment later reuses the cached result
+    api_mock.fetch_ticker = MagicMock(return_value=tick2)
+    time_machine.move_to(start_dt + timedelta(seconds=1), tick=False)
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert ticker == tick1
+    assert api_mock.fetch_ticker.call_count == 0
+
+    # Once the short cache TTL has elapsed, the exchange is queried again
+    time_machine.move_to(start_dt + timedelta(seconds=3), tick=False)
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert ticker == tick2
+    assert api_mock.fetch_ticker.call_count == 1
+
+
 @pytest.mark.parametrize("exchange_name", EXCHANGES)
