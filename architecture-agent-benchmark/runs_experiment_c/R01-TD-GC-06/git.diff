+def test_fetch_ticker_short_lived_cache(default_conf, mocker, time_machine):
+    api_mock = MagicMock()
+    tick = {"symbol": "ETH/BTC", "bid": 0.00001098, "ask": 0.00001099, "last": 0.0001}
+    tick2 = {"symbol": "XRP/BTC", "bid": 0.05, "ask": 0.06, "last": 0.055}
+    api_mock.fetch_ticker = MagicMock(return_value=tick)
+    api_mock.markets = {"ETH/BTC": {"active": True}, "XRP/BTC": {"active": True}}
+    exchange = get_patched_exchange(mocker, default_conf, api_mock)
+
+    start_dt = dt_now()
+    time_machine.move_to(start_dt, tick=False)
+
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert ticker == tick
+    assert api_mock.fetch_ticker.call_count == 1
+
+    # A 2nd request for the same pair moments later reuses the cached ticker.
+    api_mock.fetch_ticker.reset_mock()
+    api_mock.fetch_ticker = MagicMock(return_value={"bid": 999, "ask": 999, "last": 999})
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert ticker == tick
+    assert api_mock.fetch_ticker.call_count == 0
+
+    # A different pair is not affected by the ETH/BTC cache entry.
+    api_mock.fetch_ticker = MagicMock(return_value=tick2)
+    ticker = exchange.fetch_ticker(pair="XRP/BTC")
+    assert ticker == tick2
+    assert api_mock.fetch_ticker.call_count == 1
+
+    # Once the short cache window elapses, the exchange is queried again.
+    time_machine.move_to(start_dt + timedelta(seconds=3), tick=False)
+    api_mock.fetch_ticker = MagicMock(return_value={"bid": 999, "ask": 999, "last": 999})
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert ticker["bid"] == 999
+    assert api_mock.fetch_ticker.call_count == 1
+
+
