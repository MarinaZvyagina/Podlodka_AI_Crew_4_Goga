+@pytest.mark.parametrize("exchange_name", EXCHANGES)
+def test_fetch_ticker_caching(default_conf, mocker, exchange_name, time_machine):
+    start = datetime(2023, 12, 1, 0, 10, 0, tzinfo=UTC)
+    time_machine.move_to(start, tick=False)
+
+    api_mock = MagicMock()
+    tick = {
+        "symbol": "ETH/BTC",
+        "bid": 0.00001098,
+        "ask": 0.00001099,
+        "last": 0.0001,
+    }
+    api_mock.fetch_ticker = MagicMock(return_value=tick)
+    api_mock.markets = {"ETH/BTC": {"active": True}}
+    exchange = get_patched_exchange(mocker, default_conf, api_mock, exchange=exchange_name)
+
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert ticker["bid"] == 0.00001098
+    assert api_mock.fetch_ticker.call_count == 1
+
+    # A 2nd call a moment later (e.g. exit-decision and entry-confirmation logic asking
+    # for the current price of the same pair) reuses the cached ticker.
+    time_machine.move_to(start + timedelta(seconds=2), tick=False)
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert ticker["bid"] == 0.00001098
+    assert api_mock.fetch_ticker.call_count == 1
+
+    # Once the cache expires, the price is refreshed from the exchange again.
+    time_machine.move_to(start + timedelta(seconds=10), tick=False)
+    api_mock.fetch_ticker = MagicMock(return_value={**tick, "bid": 0.5, "ask": 1})
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert ticker["bid"] == 0.5
+    assert api_mock.fetch_ticker.call_count == 1
+
+
