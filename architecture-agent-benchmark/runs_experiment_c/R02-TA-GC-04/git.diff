         return False, "Configuration for diskusage beacon must be a list."
+
+    for mounts in config:
+        for mount in mounts:
+            monitor_usage = mounts[mount]
+            if isinstance(monitor_usage, dict):
+                if not set(monitor_usage).intersection({"min", "max"}):
+                    return (
+                        False,
+                        "Configuration for diskusage beacon must specify "
+                        "'min' and/or 'max' when using a dictionary value "
+                        f"for mount {mount}.",
+                    )
+
     return True, "Valid beacon configuration"
 
 
@@ -83,6 +96,32 @@ def beacon(config):
     which means that if a regular expression matches another defined mount point,
     it will override the previously defined threshold.
 
+    To catch a mount that unexpectedly drops in usage (for example, because a
+    filesystem failed to mount and the mount point is actually just an empty
+    directory on the root filesystem), specify a dict with a ``min`` and/or
+    ``max`` value instead of a plain percentage. ``max`` behaves the same as
+    the plain percentage form above: a beacon fires when usage is greater
+    than or equal to it. ``min`` fires a beacon when usage is *below* it.
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /mnt/nfs:
+                min: 5%
+                max: 90%
+
+    ``min`` and ``max`` can each be used on their own, so an "only alert on
+    unexpectedly low usage" mount can be configured without also setting a
+    high-usage threshold.
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /mnt/nfs:
+                min: 5%
+
     """
