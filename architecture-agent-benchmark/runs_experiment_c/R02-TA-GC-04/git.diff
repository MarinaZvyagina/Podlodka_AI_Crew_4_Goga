+def test_min_max_config_missing_keys():
+    config = [{"/": {}}]
+
+    ret = diskusage.validate(config)
+    assert ret == (
+        False,
+        "Configuration for diskusage beacon must specify 'min' and/or 'max' "
+        "when using a dictionary value for mount /.",
+    )
+
+
+def test_diskusage_max_only_dict_match(stub_disk_usage, stub_disk_partition):
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        config = [{"/": {"max": "50%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == [{"diskusage": 50, "mount": "/"}]
+
+
+def test_diskusage_min_triggers_on_unexpectedly_low_usage(
+    stub_disk_usage, stub_disk_partition
+):
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        # stub usage for "/" is 50%; a mount that is expected to be at
+        # least 80% full (e.g. because it normally holds a lot of data)
+        # but suddenly reports 50% should trigger the "min" alert.
+        config = [{"/": {"min": "80%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == [{"diskusage": 50, "mount": "/"}]
+
+
+def test_diskusage_min_nomatch_when_usage_is_expected(
+    stub_disk_usage, stub_disk_partition
+):
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        config = [{"/": {"min": "10%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == []
+
+
+def test_diskusage_min_and_max_together(stub_disk_usage, stub_disk_partition):
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        # min and max both configured for the same mount; only min should
+        # fire since usage (50%) is below min (80%) and below max (90%).
+        config = [{"/": {"min": "80%", "max": "90%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == [{"diskusage": 50, "mount": "/"}]
+
+
