diff --git a/changelog/69890.added.md b/changelog/69890.added.md
new file mode 100644
index 0000000..a2b22dd
--- /dev/null
+++ b/changelog/69890.added.md
@@ -0,0 +1 @@
+Added a low-usage alert to the :mod:`diskusage <salt.beacons.diskusage>` beacon, so a mount can also be watched for usage unexpectedly dropping below a configured threshold (typically a sign the filesystem failed to mount). Configure it with a ``min``/``max`` mapping instead of a bare percentage, e.g. ``/mnt/nfs: {min: 5%, max: 50%}``; existing bare-percentage configuration keeps working unchanged as a high-usage-only alert.
diff --git a/salt/beacons/diskusage.py b/salt/beacons/diskusage.py
index da904cf..f58cd09 100644
--- a/salt/beacons/diskusage.py
+++ b/salt/beacons/diskusage.py
@@ -83,6 +83,30 @@ def beacon(config):
     which means that if a regular expression matches another defined mount point,
     it will override the previously defined threshold.
 
+    In addition to the high-usage threshold above, a low-usage threshold can be
+    configured to catch a mount whose usage unexpectedly drops, which is usually
+    a sign that the filesystem failed to mount and the mount point is really
+    just an empty directory on its parent filesystem. To configure both
+    thresholds for a mount, use a mapping with ``min`` and/or ``max`` keys
+    instead of a bare percentage. Mounts using the older, bare percentage form
+    keep behaving exactly as before, and both forms can be mixed freely.
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /: 63%
+            - /mnt/nfs:
+                min: 5%
+                max: 50%
+            - /mnt/backup:
+                min: 5%
+
+    ``max`` behaves the same as the plain percentage form: a beacon fires when
+    usage is greater than or equal to it. ``min`` fires a beacon when usage
+    drops below it, with ``low_usage: True`` added to the event so reactors can
+    tell the two cases apart.
+
     """
     whitelist = []
     config = salt.utils.beacons.remove_hidden_options(config, whitelist)
@@ -118,9 +142,34 @@ def beacon(config):
 
                 current_usage = _current_usage.percent
                 monitor_usage = mounts[mount]
-                if isinstance(monitor_usage, str) and "%" in monitor_usage:
-                    monitor_usage = re.sub("%", "", monitor_usage)
-                monitor_usage = float(monitor_usage)
-                if current_usage >= monitor_usage:
+
+                if isinstance(monitor_usage, dict):
+                    max_usage = monitor_usage.get("max")
+                    min_usage = monitor_usage.get("min")
+                else:
+                    # Backwards compatible bare percentage: high-usage only.
+                    max_usage = monitor_usage
+                    min_usage = None
+
+                if max_usage is not None and current_usage >= _to_percent(
+                    max_usage
+                ):
                     ret.append({"diskusage": current_usage, "mount": _mount})
+                if min_usage is not None and current_usage < _to_percent(min_usage):
+                    ret.append(
+                        {
+                            "diskusage": current_usage,
+                            "mount": _mount,
+                            "low_usage": True,
+                        }
+                    )
     return ret
+
+
+def _to_percent(value):
+    """
+    Normalize a threshold value (e.g. "50%", 50, 50.0) to a float percentage.
+    """
+    if isinstance(value, str) and "%" in value:
+        value = re.sub("%", "", value)
+    return float(value)
diff --git a/tests/pytests/unit/beacons/test_diskusage.py b/tests/pytests/unit/beacons/test_diskusage.py
