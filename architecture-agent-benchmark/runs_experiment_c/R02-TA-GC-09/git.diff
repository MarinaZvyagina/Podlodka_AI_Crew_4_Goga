--- a/salt/beacons/diskusage.py
+++ b/salt/beacons/diskusage.py
@@ -24,6 +24,15 @@ log = logging.getLogger(__name__)
 __virtualname__ = "diskusage"
 
 
+def _to_percent(value):
+    """
+    Normalize a configured threshold (e.g. ``50``, ``"50%"``) to a float.
+    """
+    if isinstance(value, str) and "%" in value:
+        value = re.sub("%", "", value)
+    return float(value)
+
+
 def __virtual__():
     if HAS_PSUTIL is False:
         err_msg = "psutil library is missing."
@@ -83,6 +92,21 @@ def beacon(config):
     which means that if a regular expression matches another defined mount point,
     it will override the previously defined threshold.
 
+    In addition to a plain high-usage threshold, a mount point can be configured
+    with a ``min`` and/or ``max`` percentage by providing a dict instead of a
+    plain value. ``max`` behaves exactly like the plain threshold above (emit
+    when usage is at or above it), and ``min`` emits when usage drops below it,
+    which is normally a sign that the filesystem failed to mount and what is
+    being measured is actually the underlying root filesystem.
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /mnt/nfs:
+                min: 5%
+                max: 80%
+
     """
     whitelist = []
     config = salt.utils.beacons.remove_hidden_options(config, whitelist)
@@ -118,9 +142,24 @@ def beacon(config):
 
                 current_usage = _current_usage.percent
                 monitor_usage = mounts[mount]
-                if isinstance(monitor_usage, str) and "%" in monitor_usage:
-                    monitor_usage = re.sub("%", "", monitor_usage)
-                monitor_usage = float(monitor_usage)
-                if current_usage >= monitor_usage:
-                    ret.append({"diskusage": current_usage, "mount": _mount})
+
+                if isinstance(monitor_usage, dict):
+                    if "max" in monitor_usage:
+                        max_usage = _to_percent(monitor_usage["max"])
+                        if current_usage >= max_usage:
+                            ret.append({"diskusage": current_usage, "mount": _mount})
+                    if "min" in monitor_usage:
+                        min_usage = _to_percent(monitor_usage["min"])
+                        if current_usage < min_usage:
+                            ret.append(
+                                {
+                                    "diskusage": current_usage,
+                                    "mount": _mount,
+                                    "type": "min",
+                                }
+                            )
+                else:
+                    monitor_usage = _to_percent(monitor_usage)
+                    if current_usage >= monitor_usage:
+                        ret.append({"diskusage": current_usage, "mount": _mount})
     return ret
