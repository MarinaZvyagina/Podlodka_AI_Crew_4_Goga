@@ -40,9 +40,40 @@ def validate(config):
     # Configuration for diskusage beacon should be a list of dicts
     if not isinstance(config, list):
         return False, "Configuration for diskusage beacon must be a list."
+
+    for mounts in config:
+        for mount, threshold in mounts.items():
+            if not isinstance(threshold, dict):
+                continue
+            unknown_keys = set(threshold) - {"min", "max"}
+            if unknown_keys:
+                return (
+                    False,
+                    "Configuration for diskusage beacon mount {} contains"
+                    " unknown option(s): {}".format(
+                        mount, ", ".join(sorted(unknown_keys))
+                    ),
+                )
+            if not {"min", "max"} & set(threshold):
+                return (
+                    False,
+                    "Configuration for diskusage beacon mount {} must define a"
+                    " 'min' and/or a 'max' threshold.".format(mount),
+                )
+
     return True, "Valid beacon configuration"
 
 
+def _to_percent(value):
+    """
+    Normalize a threshold value (a percentage string like "50%" or a
+    number) to a float percentage.
+    """
+    if isinstance(value, str) and "%" in value:
+        value = re.sub("%", "", value)
+    return float(value)
+
+
 def beacon(config):
     r"""
     Monitor the disk usage of the minion
@@ -83,6 +114,27 @@ def beacon(config):
     which means that if a regular expression matches another defined mount point,
     it will override the previously defined threshold.
 
+    A mount can also be given a mapping of ``min`` and/or ``max`` thresholds
+    instead of a single high-usage percentage. ``max`` behaves exactly like the
+    plain percentage shown above (alert when usage is at or above the
+    threshold). ``min`` alerts when usage is at or below the threshold, which
+    is useful for catching a mount that is normally busy but suddenly reports
+    little to no usage, most often because the filesystem failed to mount and
+    what is being measured is really just the empty directory on the root
+    filesystem.
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /: 63%
+            - /mnt/nfs:
+                min: 5%
+                max: 50%
+
+    Both forms can be freely mixed across mounts, and existing plain
+    percentage configuration keeps working unchanged.
+
     """
