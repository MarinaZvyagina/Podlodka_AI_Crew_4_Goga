+    def list_beacon_status(self, include_pillar=True, include_opts=True):
+        """
+        Return, for each currently configured beacon, when it last executed
+        and whether that execution raised an error.
+
+        A beacon that hasn't fired yet (e.g. it was just added, or is
+        interval-gated and hasn't reached its interval) is reported with
+        ``last_run_time`` set to ``None`` rather than a stale or made-up
+        value.
+
+        include_pillar: Whether to include beacons that are
+                        configured in pillar, default is True.
+
+        include_opts:   Whether to include beacons that are
+                        configured in opts, default is True.
+        """
+        beacons = self._get_beacons(
+            include_pillar=include_pillar, include_opts=include_opts
+        )
+
+        status = {}
+        for mod in beacons:
+            if mod == "enabled":
+                continue
+            entry = self.status_map.get(mod)
+            if entry is None:
+                status[mod] = {"last_run_time": None, "last_error": None}
+            else:
+                status[mod] = dict(entry)
+
+        # Fire the complete event back along with the beacon status
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacons": status},
+                tag="/salt/minion/minion_beacon_status_complete",
+            )
+
+        return True
