+def test_beacon_process_tracks_status_on_error(minion_opts):
+    """
+    Test that a failing beacon's last-fired time and error are recorded
+    in beacon_status as soon as process() runs it.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+    beacon_mock = MagicMock(side_effect=Exception("Global Thermonuclear War"))
+    beacon_mock.__globals__ = {}
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.beacons["ps.beacon"] = beacon_mock
+
+    assert beacon.beacon_status == {}
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    assert "watch_apache" in beacon.beacon_status
+    status = beacon.beacon_status["watch_apache"]
+    assert status["last_error"] == "Global Thermonuclear War"
+    assert status["last_fired"] is not None
+
+
+def test_beacon_process_tracks_status_on_success(minion_opts):
+    """
+    Test that a successful beacon run records a last-fired time and a
+    None error in beacon_status.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    assert "watch_apache" in beacon.beacon_status
+    status = beacon.beacon_status["watch_apache"]
+    assert status["last_error"] is None
+    assert status["last_fired"] is not None
+
+
+def test_beacon_process_does_not_track_skipped_beacons(minion_opts):
+    """
+    Test that a beacon skipped because its interval hasn't elapsed is not
+    recorded in beacon_status, so it can be correctly reported as never
+    having fired.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+            {"interval": 100000},
+        ]
+    }
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    assert beacon.beacon_status == {}
+
+
+def test_list_beacons_status(minion_opts):
+    """
+    Test that list_beacons_status reports last_fired/last_error for
+    beacons that have run, and explicit None values for a configured
+    beacon that has never fired.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ],
+        "never_fired": [
+            {"files": {"/etc/fstab": {}}},
+            {"beacon_module": "inotify"},
+        ],
+    }
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    with patch("salt.utils.event.get_event") as get_event_mock:
+        beacon.list_beacons_status()
+
+    evt = get_event_mock.return_value.__enter__.return_value
+    fired = evt.fire_event.call_args[0][0]
+    assert fired["complete"] is True
+    status = fired["beacon_status"]
+
+    assert status["watch_apache"]["last_error"] is None
+    assert status["watch_apache"]["last_fired"] is not None
+
+    assert status["never_fired"] == {"last_fired": None, "last_error": None}
+
