+    def list_beacons_status(self):
+        """
+        Return, for every currently configured beacon, the epoch time it
+        last actually fired and the error (if any) that firing raised.
+
+        Beacons that are configured but have not fired even once (e.g. they
+        were just added, or their interval hasn't elapsed yet) are reported
+        with ``last_fired: None`` rather than a stale or fabricated value.
+        """
+        beacons = self._get_beacons()
+
+        status = {}
+        for name in beacons:
+            if name == "enabled":
+                continue
+            if name in self.beacon_status:
+                status[name] = copy.deepcopy(self.beacon_status[name])
+            else:
+                status[name] = {"last_fired": None, "last_error": None}
+
+        # Fire the complete event back along with the beacon status
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacon_status": status},
+                tag="/salt/minion/minion_beacons_status_complete",
+            )
+
+        return True
