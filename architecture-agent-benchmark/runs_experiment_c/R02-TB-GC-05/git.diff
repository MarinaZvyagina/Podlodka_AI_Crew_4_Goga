+def status(**kwargs):
+    """
+    Show, for each beacon currently configured on the minion, the last time
+    it actually fired and whether that run raised an error.
+
+    This reflects live beacon activity tracked in-process by the minion as
+    beacons run; it does not read log files, wait for a new probe cycle, or
+    require restarting the minion or touching the beacon configuration.
+
+    A beacon that is configured but has not fired yet (for example because
+    its interval hasn't elapsed, or it was just added) is reported with
+    ``last_fired`` set to ``None``.
+
+    :return:    Dictionary keyed by beacon name, each containing:
+
+                 - ``last_fired``: epoch timestamp of the beacon's last
+                   execution, or ``None`` if it has never fired.
+                 - ``last_error``: the error message from that execution,
+                   or ``None`` if it completed without error (or has never
+                   fired).
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+
+    """
+    ret = {}
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"]({"func": "status"}, "manage_beacons")
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacons_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                if event_ret and event_ret["complete"]:
+                    ret = event_ret["beacon_status"]
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+
+    return ret
+
+
