+@pytest.mark.slow_test
+def test_status():
+    """
+    Test that beacons.status returns the last-fired time and error for
+    each beacon, including an explicit "never fired" entry.
+    """
+    event_returns = [
+        {
+            "complete": True,
+            "tag": "/salt/minion/minion_beacons_status_complete",
+            "beacon_status": {
+                "ps": {"last_fired": 1700000000.0, "last_error": None},
+                "failing": {"last_fired": 1700000005.0, "last_error": "boom"},
+                "never_fired": {"last_fired": None, "last_error": None},
+            },
+        }
+    ]
+
+    mock = MagicMock(return_value=True)
+    with patch.dict(beacons.__salt__, {"event.fire": mock}):
+        with patch.object(SaltEvent, "get_event", side_effect=event_returns):
+            ret = beacons.status()
+
+    assert ret["ps"]["last_error"] is None
+    assert ret["ps"]["last_fired"] == 1700000000.0
+    assert ret["failing"]["last_error"] == "boom"
+    assert ret["never_fired"] == {"last_fired": None, "last_error": None}
+
+
