@@ -0,0 +1,116 @@
+"""
+Unit tests for the sqlite3_cache cache
+"""
+
+import pytest
+
+import salt.cache.sqlite3_cache as sqlite3_cache
+from salt.exceptions import SaltCacheError
+from tests.support.mock import patch
+
+
+@pytest.fixture
+def configure_loader_modules(tmp_path):
+    return {sqlite3_cache: {"__opts__": {"cachedir": str(tmp_path)}}}
+
+
+def test_virtual():
+    assert sqlite3_cache.__virtual__() == "sqlite3"
+
+
+def test_database_path_defaults_under_cachedir(tmp_path):
+    assert sqlite3_cache._database_path() == str(tmp_path / "cache.sqlite3")
+
+
+def test_database_path_honors_explicit_option(tmp_path):
+    explicit = str(tmp_path / "somewhere-else.db")
+    with patch.dict(sqlite3_cache.__opts__, {"sqlite3.database": explicit}):
+        assert sqlite3_cache._database_path() == explicit
+
+
+def test_store_and_fetch_round_trip():
+    sqlite3_cache.store("bank", "key", {"hello": "world"})
+    assert sqlite3_cache.fetch("bank", "key") == {"hello": "world"}
+
+
+def test_fetch_missing_key_returns_empty():
+    assert sqlite3_cache.fetch("bank", "missing") == {}
+
+
+def test_store_overwrites_existing_key():
+    sqlite3_cache.store("bank", "key", {"v": 1})
+    sqlite3_cache.store("bank", "key", {"v": 2})
+    assert sqlite3_cache.fetch("bank", "key") == {"v": 2}
+
+
+def test_updated_returns_none_for_missing_key():
+    assert sqlite3_cache.updated("bank", "missing") is None
+
+
+def test_updated_returns_int_after_store():
+    sqlite3_cache.store("bank", "key", "data")
+    assert isinstance(sqlite3_cache.updated("bank", "key"), int)
+
+
+def test_list_returns_keys_in_bank():
+    sqlite3_cache.store("bank", "k1", "a")
+    sqlite3_cache.store("bank", "k2", "b")
+    assert set(sqlite3_cache.list_("bank")) == {"k1", "k2"}
+
+
+def test_list_empty_bank_returns_empty_list():
+    assert sqlite3_cache.list_("ghost") == []
+
+
+def test_contains_key_and_bank():
+    sqlite3_cache.store("bank", "key", "data")
+    assert sqlite3_cache.contains("bank", "key") is True
+    assert sqlite3_cache.contains("bank", None) is True
+    assert sqlite3_cache.contains("bank", "nope") is False
+    assert sqlite3_cache.contains("ghost", None) is False
+
+
+def test_flush_single_key():
+    sqlite3_cache.store("bank", "k1", "a")
+    sqlite3_cache.store("bank", "k2", "b")
+    assert sqlite3_cache.flush("bank", "k1") is True
+    assert sqlite3_cache.fetch("bank", "k1") == {}
+    assert sqlite3_cache.fetch("bank", "k2") == "b"
+
+
+def test_flush_missing_key_returns_false():
+    assert sqlite3_cache.flush("bank", "missing") is False
+
+
+def test_flush_entire_bank():
+    sqlite3_cache.store("bank", "k1", "a")
+    sqlite3_cache.store("bank", "k2", "b")
+    assert sqlite3_cache.flush("bank", key=None) is True
+    assert sqlite3_cache.list_("bank") == []
+
+
+def test_data_persists_across_new_connection(tmp_path):
+    """
+    A restart of the process (a new connection to the same on-disk file)
+    must still see previously stored data -- this is the whole point of
+    the sqlite3 cache backend.
+    """
+    sqlite3_cache.store("bank", "key", {"durable": True})
+
+    # Simulate a process restart: drop the cached connection so the next
+    # operation reopens the database file from scratch.
+    sqlite3_cache.__context__.pop("sqlite3_cache.connections", None)
+
+    assert sqlite3_cache.fetch("bank", "key") == {"durable": True}
+
+
+def test_errors_are_wrapped_in_salt_cache_error(tmp_path):
+    sqlite3_cache.store("bank", "key", "data")
+    conn = sqlite3_cache._get_conn()
+    conn.close()
+    # Force a query against a closed connection to trigger sqlite3.Error.
+    sqlite3_cache.__context__["sqlite3_cache.connections"][
+        sqlite3_cache._database_path()
+    ] = conn
+    with pytest.raises(SaltCacheError):
+        sqlite3_cache.fetch("bank", "key")
