@@ -0,0 +1,81 @@
+import logging
+import shutil
+from pathlib import Path
+
+import pytest
+
+import salt.cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def cache_opts(minion_opts):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    try:
+        yield opts
+    finally:
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
+
+
+@pytest.fixture
+def cache(cache_opts):
+    return salt.cache.factory(cache_opts)
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_data_survives_a_master_restart(cache_opts):
+    """
+    The whole point of the sqlite3 cache backend: data written before a
+    restart of the master process must still be there afterwards. We
+    simulate "the master process restarted" by building a brand new
+    ``Cache`` (and therefore a brand new backend-driver connection) against
+    the same on-disk database file and confirming it can see data written
+    by the previous one.
+    """
+    first = salt.cache.factory(cache_opts)
+    first.store("minions/webserver1", "data", {"os": "Linux"})
+
+    second = salt.cache.factory(cache_opts)
+    assert second.fetch("minions/webserver1", "data") == {"os": "Linux"}
+
+
+def test_clean_expired_does_not_drop_unexpired_entries(cache):
+    bank = "tokens"
+    key_with_envelope = "tok-with-envelope"
+    key_plain = "tok-plain"
+
+    cache.store(bank, key_plain, {"name": "alice"})
+    cache.store(bank, key_with_envelope, {"name": "bob"}, expires=12 * 3600)
+
+    assert cache.contains(bank, key_plain)
+    assert cache.contains(bank, key_with_envelope)
+
+    cache.clean_expired(bank)
+
+    assert cache.contains(bank, key_plain)
+    assert cache.contains(bank, key_with_envelope)
+
+
+def test_default_database_lives_under_cachedir(cache):
+    cache.store("bank", "key", "data")
+    assert (Path(cache.cachedir) / "cache.sqlite3").exists()
+
+
+def test_multiple_master_restarts_preserve_data(cache_opts):
+    """
+    Store, "restart" a few times in a row, and confirm nothing is lost --
+    guards against any lazily-created state (tables, connections) not
+    being recreated correctly on a fresh connection.
+    """
+    for i in range(3):
+        salt.cache.factory(cache_opts).store("bank", f"key{i}", {"n": i})
+
+    last = salt.cache.factory(cache_opts)
+    for i in range(3):
+        assert last.fetch("bank", f"key{i}") == {"n": i}
