@@ -0,0 +1,274 @@
+"""
+Minion data cache plugin for SQLite3.
+
+.. versionadded:: 3008.0
+
+This cache plugin stores all banks/keys in a single ordinary SQLite database
+file on disk. It relies only on the :py:mod:`sqlite3` module from the Python
+standard library, so unlike the ``mysql``, ``redis``, ``consul`` and
+``etcd``/``etcd3`` cache plugins, it does not require any additional service
+or third-party package to be installed. This makes it a good fit for small,
+single-node Salt masters that want the minion data cache (grains, mine data,
+job returns, etc.) to survive a restart of the master without the operator
+having to stand up a separate database service.
+
+To enable this cache plugin, set the master (or minion, salt-ssh, salt-cloud,
+etc.) ``cache`` config value to ``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+The following values may optionally be set in the config to control where
+the database file lives and what its cache table is named. These are the
+defaults:
+
+.. code-block:: yaml
+
+    sqlite3.database: <cachedir>/cache.sqlite3
+    sqlite3.table_name: cache
+    sqlite3.timeout: 5.0
+
+``sqlite3.database``
+    Path to the SQLite database file. Defaults to a file named
+    ``cache.sqlite3`` inside :conf_master:`cachedir`.
+
+``sqlite3.table_name``
+    Name of the table used to hold the cached bank/key data. Defaults to
+    ``cache``.
+
+``sqlite3.timeout``
+    Number of seconds SQLite should wait on a locked database before giving
+    up. Defaults to ``5.0``.
+"""
+
+import logging
+import os
+import threading
+
+import salt.payload
+import salt.syspaths
+import salt.utils.path
+from salt.exceptions import SaltCacheError
+
+try:
+    import sqlite3
+
+    HAS_SQLITE3 = True
+except ImportError:
+    HAS_SQLITE3 = False
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+_DEFAULT_DATABASE_NAME = "cache.sqlite3"
+_DEFAULT_TABLE_NAME = "cache"
+_DEFAULT_TIMEOUT = 5.0
+
+# Guards creation of the per-database locks in _LOCKS below.
+_LOCKS_LOCK = threading.Lock()
+# One lock per database file, used to serialize access to that file's
+# connection from multiple threads within this process. Separate processes
+# opening the same file are arbitrated by SQLite's own file locking.
+_LOCKS = {}
+
+
+def __virtual__():
+    if not HAS_SQLITE3:
+        return False, "No python sqlite3 client installed."
+    return __virtualname__
+
+
+def init_kwargs(kwargs):
+    """
+    Effectively a noop. Return an empty dictionary.
+    """
+    return {}
+
+
+def _database_path():
+    database = __opts__.get("sqlite3.database")
+    if database:
+        return database
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    return salt.utils.path.join(cachedir, _DEFAULT_DATABASE_NAME)
+
+
+def _table_name():
+    return __opts__.get("sqlite3.table_name", _DEFAULT_TABLE_NAME)
+
+
+def _get_lock(database):
+    with _LOCKS_LOCK:
+        lock = _LOCKS.get(database)
+        if lock is None:
+            lock = _LOCKS[database] = threading.Lock()
+        return lock
+
+
+def _get_conn():
+    """
+    Return the (lazily-created, per-process) connection to the configured
+    database, creating the cache table on first use.
+    """
+    database = _database_path()
+    connections = __context__.setdefault("sqlite3_cache.connections", {})
+    conn = connections.get(database)
+    if conn is not None:
+        return conn
+
+    dirname = os.path.dirname(database)
+    if dirname and not os.path.isdir(dirname):
+        try:
+            os.makedirs(dirname)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"Could not create the directory for the sqlite3 cache "
+                f"database {database}: {exc}"
+            )
+
+    try:
+        conn = sqlite3.connect(
+            database,
+            timeout=__opts__.get("sqlite3.timeout", _DEFAULT_TIMEOUT),
+            check_same_thread=False,
+        )
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute(
+            f"CREATE TABLE IF NOT EXISTS {_table_name()} ("
+            "bank TEXT NOT NULL, "
+            "cache_key TEXT NOT NULL, "
+            "data BLOB, "
+            "last_update INTEGER NOT NULL, "
+            "PRIMARY KEY (bank, cache_key))"
+        )
+        conn.commit()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"Could not set up the sqlite3 cache database {database}: {exc}"
+        )
+
+    connections[database] = conn
+    return conn
+
+
+def store(bank, key, data):
+    """
+    Store a key value.
+    """
+    conn = _get_conn()
+    table = _table_name()
+    payload = salt.payload.dumps(data)
+    with _get_lock(_database_path()):
+        try:
+            conn.execute(
+                f"INSERT INTO {table} (bank, cache_key, data, last_update) "
+                "VALUES (?, ?, ?, CAST(strftime('%s','now') AS INTEGER)) "
+                "ON CONFLICT (bank, cache_key) DO UPDATE SET "
+                "data=excluded.data, last_update=excluded.last_update",
+                (bank, key, payload),
+            )
+            conn.commit()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error storing {bank} {key}: {exc}")
+
+
+def fetch(bank, key):
+    """
+    Fetch a key value.
+    """
+    conn = _get_conn()
+    table = _table_name()
+    with _get_lock(_database_path()):
+        try:
+            cur = conn.execute(
+                f"SELECT data FROM {table} WHERE bank=? AND cache_key=?",
+                (bank, key),
+            )
+            row = cur.fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error fetching {bank} {key}: {exc}")
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key):
+    """
+    Return the Unix Epoch timestamp of when the key was last updated, or
+    None if the key does not exist.
+    """
+    conn = _get_conn()
+    table = _table_name()
+    with _get_lock(_database_path()):
+        try:
+            cur = conn.execute(
+                f"SELECT last_update FROM {table} WHERE bank=? AND cache_key=?",
+                (bank, key),
+            )
+            row = cur.fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error reading timestamp for {bank} {key}: {exc}")
+    return None if row is None else int(row[0])
+
+
+def flush(bank, key=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key
+    is specified, remove the entire bank with all keys inside.
+    """
+    conn = _get_conn()
+    table = _table_name()
+    with _get_lock(_database_path()):
+        try:
+            if key is None:
+                cur = conn.execute(f"DELETE FROM {table} WHERE bank=?", (bank,))
+            else:
+                cur = conn.execute(
+                    f"DELETE FROM {table} WHERE bank=? AND cache_key=?", (bank, key)
+                )
+            conn.commit()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error flushing {bank} {key}: {exc}")
+    return cur.rowcount > 0
+
+
+def list_(bank):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank.
+    """
+    conn = _get_conn()
+    table = _table_name()
+    with _get_lock(_database_path()):
+        try:
+            cur = conn.execute(
+                f"SELECT cache_key FROM {table} WHERE bank=?", (bank,)
+            )
+            return [row[0] for row in cur.fetchall()]
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error listing {bank}: {exc}")
+
+
+def contains(bank, key=None):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    conn = _get_conn()
+    table = _table_name()
+    with _get_lock(_database_path()):
+        try:
+            if key is None:
+                cur = conn.execute(
+                    f"SELECT 1 FROM {table} WHERE bank=? LIMIT 1", (bank,)
+                )
+            else:
+                cur = conn.execute(
+                    f"SELECT 1 FROM {table} WHERE bank=? AND cache_key=? LIMIT 1",
+                    (bank, key),
+                )
+            return cur.fetchone() is not None
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error checking contains for {bank} {key}: {exc}")
