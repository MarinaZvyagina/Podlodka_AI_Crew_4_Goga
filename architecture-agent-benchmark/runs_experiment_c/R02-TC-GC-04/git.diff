@@ -0,0 +1,98 @@
+"""
+Validate the functions in the sqlite_cache cache
+"""
+
+import os
+
+import pytest
+
+import salt.cache.sqlite_cache as sqlite_cache
+from salt.exceptions import SaltCacheError
+from tests.support.mock import patch
+
+
+@pytest.fixture
+def configure_loader_modules():
+    return {sqlite_cache: {}}
+
+
+@pytest.fixture
+def opts(tmp_path):
+    return {
+        "cachedir": str(tmp_path),
+        "sqlite_cache.database": str(tmp_path / "cache.sqlite3"),
+    }
+
+
+def test_store_and_fetch(opts):
+    with patch.dict(sqlite_cache.__opts__, opts):
+        sqlite_cache.store(bank="bank", key="key", data={"some": "data"})
+        assert sqlite_cache.fetch(bank="bank", key="key") == {"some": "data"}
+
+
+def test_fetch_missing_key_returns_empty_dict(opts):
+    with patch.dict(sqlite_cache.__opts__, opts):
+        assert sqlite_cache.fetch(bank="bank", key="nope") == {}
+
+
+def test_contains(opts):
+    with patch.dict(sqlite_cache.__opts__, opts):
+        assert sqlite_cache.contains(bank="bank", key="key") is False
+        assert sqlite_cache.contains(bank="bank", key=None) is False
+
+        sqlite_cache.store(bank="bank", key="key", data="value")
+
+        assert sqlite_cache.contains(bank="bank", key="key") is True
+        assert sqlite_cache.contains(bank="bank", key=None) is True
+        assert sqlite_cache.contains(bank="bank", key="other") is False
+
+
+def test_list_and_flush(opts):
+    with patch.dict(sqlite_cache.__opts__, opts):
+        sqlite_cache.store(bank="bank", key="k1", data=1)
+        sqlite_cache.store(bank="bank", key="k2", data=2)
+        assert set(sqlite_cache.ls(bank="bank")) == {"k1", "k2"}
+
+        assert sqlite_cache.flush(bank="bank", key="k1") is True
+        assert set(sqlite_cache.ls(bank="bank")) == {"k2"}
+
+        assert sqlite_cache.flush(bank="bank", key=None) is True
+        assert sqlite_cache.ls(bank="bank") == []
+
+
+def test_flush_nonexistent_key_returns_false(opts):
+    with patch.dict(sqlite_cache.__opts__, opts):
+        assert sqlite_cache.flush(bank="bank", key="nope") is False
+
+
+def test_updated(opts):
+    with patch.dict(sqlite_cache.__opts__, opts):
+        assert sqlite_cache.updated(bank="bank", key="key") is None
+        sqlite_cache.store(bank="bank", key="key", data="value")
+        assert isinstance(sqlite_cache.updated(bank="bank", key="key"), int)
+
+
+def test_database_defaults_under_cachedir(opts, tmp_path):
+    opts_without_database = {"cachedir": opts["cachedir"]}
+    with patch.dict(sqlite_cache.__opts__, opts_without_database):
+        sqlite_cache.store(bank="bank", key="key", data="value")
+        assert (tmp_path / "cache.sqlite3").exists()
+
+
+def test_data_persists_across_reconnects(opts):
+    """
+    Simulate a master restart: dropping the cached connection and
+    reconnecting must still see data written before the "restart".
+    """
+    with patch.dict(sqlite_cache.__opts__, opts):
+        sqlite_cache.store(bank="bank", key="key", data="value")
+        sqlite_cache.force_reconnect()
+        assert sqlite_cache.fetch(bank="bank", key="key") == "value"
+
+
+def test_connect_error_raises_salt_cache_error(opts):
+    with patch.dict(sqlite_cache.__opts__, opts):
+        with patch("os.makedirs", side_effect=OSError("boom")):
+            with patch("os.path.isdir", return_value=False):
+                with pytest.raises(SaltCacheError):
+                    sqlite_cache.store(bank="bank", key="key", data="value")
