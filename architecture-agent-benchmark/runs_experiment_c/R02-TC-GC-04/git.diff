@@ -0,0 +1,290 @@
+"""
+Minion data cache plugin for SQLite.
+
+.. versionadded:: 3008.0
+
+This cache plugin stores banks/keys/data (cached grains, mine data, job
+returns, etc.) in a single ordinary SQLite database file on disk, using only
+the ``sqlite3`` module that ships with a standard Python installation -- no
+external database service and no third-party package need to be installed.
+
+It is intended for small, single-node masters that want the cache to survive
+a restart of the master process without standing up Redis, MySQL, or a
+similar dedicated cache service.
+
+.. warning::
+
+    The sqlite_cache.table_name value is directly added into certain
+    queries. Salt treats this as trusted input.
+
+To use sqlite as the minion data cache backend, set the master ``cache``
+config value to ``sqlite``:
+
+.. code-block:: yaml
+
+    cache: sqlite
+
+The following values can optionally be set in the master config. These are
+the defaults:
+
+.. code-block:: yaml
+
+    sqlite_cache.database: <cachedir>/cache.sqlite3
+    sqlite_cache.table_name: cache
+    sqlite_cache.timeout: 5.0
+
+``sqlite_cache.database`` defaults to a file named ``cache.sqlite3`` inside
+the configured ``cachedir``, so the data is written to, and read back from,
+the same on-disk location across restarts without any additional
+configuration.
+"""
+
+import logging
+import os
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+from salt.exceptions import SaltCacheError
+
+try:
+    import sqlite3
+
+    HAS_SQLITE3 = True
+except ImportError:
+    HAS_SQLITE3 = False
+
+
+_DEFAULT_TABLE_NAME = "cache"
+_DEFAULT_TIMEOUT = 5.0
+
+log = logging.getLogger(__name__)
+
+# A single sqlite3 connection is kept per process (in __context__) and may be
+# used from more than one thread within that process (e.g. the master's
+# request-handling threads); guard it with a lock since a Connection opened
+# with check_same_thread=False does not serialize concurrent statements on
+# its own.
+_LOCK = threading.RLock()
+
+# Module properties
+
+__virtualname__ = "sqlite"
+__func_alias__ = {"ls": "list"}
+
+
+def __virtual__():
+    """
+    Confirm that the sqlite3 module is available. It ships with the Python
+    standard library, so this should always succeed except on Python builds
+    that were compiled without SQLite support.
+    """
+    return bool(HAS_SQLITE3), (
+        "No sqlite3 module available in this Python installation."
+        if not HAS_SQLITE3
+        else ""
+    )
+
+
+def force_reconnect():
+    """
+    Force a reconnection to the sqlite cache database, by removing the
+    client from Salt's __context__.
+    """
+    conn = __context__.pop("sqlite_client", None)
+    if conn is not None:
+        conn.close()
+
+
+def _database_path():
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    return __opts__.get(
+        "sqlite_cache.database", os.path.join(cachedir, "cache.sqlite3")
+    )
+
+
+def _table_name():
+    return __opts__.get("sqlite_cache.table_name", _DEFAULT_TABLE_NAME)
+
+
+def _connect():
+    """
+    Return the cached sqlite3 connection, creating (and initializing) it if
+    this is the first call in this process.
+    """
+    conn = __context__.get("sqlite_client")
+    if conn is not None:
+        return conn
+
+    database = _database_path()
+    directory = os.path.dirname(database)
+    if directory and not os.path.isdir(directory):
+        try:
+            os.makedirs(directory)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"The sqlite cache directory, {directory}, could not be created: {exc}"
+            )
+
+    timeout = __opts__.get("sqlite_cache.timeout", _DEFAULT_TIMEOUT)
+    table_name = _table_name()
+    try:
+        conn = sqlite3.connect(
+            database,
+            timeout=timeout,
+            isolation_level=None,
+            check_same_thread=False,
+        )
+        # WAL mode allows readers and a writer to proceed concurrently, and
+        # busy_timeout makes concurrent writers from other master processes
+        # block-and-retry instead of immediately raising "database is locked".
+        with _LOCK:
+            conn.execute("PRAGMA journal_mode=WAL")
+            conn.execute(f"PRAGMA busy_timeout={int(timeout * 1000)}")
+            conn.execute(
+                "CREATE TABLE IF NOT EXISTS {} ("
+                "bank TEXT NOT NULL, "
+                "cache_key TEXT NOT NULL, "
+                "data BLOB, "
+                "last_update INTEGER NOT NULL, "
+                "PRIMARY KEY (bank, cache_key)"
+                ")".format(table_name)
+            )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"Could not open the sqlite cache database {database}: {exc}"
+        )
+
+    log.info("sqlite_cache: using database %s, table %s", database, table_name)
+    __context__["sqlite_client"] = conn
+    return conn
+
+
+def store(bank, key, data):
+    """
+    Store a key value.
+    """
+    conn = _connect()
+    payload = salt.payload.dumps(data)
+    try:
+        with _LOCK:
+            conn.execute(
+                "INSERT OR REPLACE INTO {} "
+                "(bank, cache_key, data, last_update) VALUES (?, ?, ?, ?)".format(
+                    _table_name()
+                ),
+                (bank, key, payload, int(time.time())),
+            )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"There was an error storing {bank}/{key}: {exc}")
+
+
+def fetch(bank, key):
+    """
+    Fetch a key value.
+    """
+    conn = _connect()
+    try:
+        with _LOCK:
+            cur = conn.execute(
+                "SELECT data FROM {} WHERE bank=? AND cache_key=?".format(
+                    _table_name()
+                ),
+                (bank, key),
+            )
+            row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"There was an error fetching {bank}/{key}: {exc}")
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key):
+    """
+    Return the integer Unix epoch update timestamp of the specified bank and
+    key, or None if the key does not exist.
+    """
+    conn = _connect()
+    try:
+        with _LOCK:
+            cur = conn.execute(
+                "SELECT last_update FROM {} WHERE bank=? AND cache_key=?".format(
+                    _table_name()
+                ),
+                (bank, key),
+            )
+            row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"There was an error reading the update time for {bank}/{key}: {exc}"
+        )
+    return int(row[0]) if row else None
+
+
+def flush(bank, key=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key
+    is specified, remove the entire bank.
+    """
+    conn = _connect()
+    try:
+        with _LOCK:
+            if key is None:
+                cur = conn.execute(
+                    "DELETE FROM {} WHERE bank=?".format(_table_name()), (bank,)
+                )
+            else:
+                cur = conn.execute(
+                    "DELETE FROM {} WHERE bank=? AND cache_key=?".format(
+                        _table_name()
+                    ),
+                    (bank, key),
+                )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"There was an error removing {bank}/{key or ''}: {exc}")
+    return cur.rowcount > 0
+
+
+def ls(bank):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank.
+    """
+    conn = _connect()
+    try:
+        with _LOCK:
+            cur = conn.execute(
+                "SELECT cache_key FROM {} WHERE bank=?".format(_table_name()), (bank,)
+            )
+            return [row[0] for row in cur.fetchall()]
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"There was an error listing {bank}: {exc}")
+
+
+def contains(bank, key=None):
+    """
+    Checks if the specified bank contains the specified key. If key is None,
+    checks whether the bank itself contains any keys.
+    """
+    conn = _connect()
+    try:
+        with _LOCK:
+            if key is None:
+                cur = conn.execute(
+                    "SELECT EXISTS(SELECT 1 FROM {} WHERE bank=?)".format(
+                        _table_name()
+                    ),
+                    (bank,),
+                )
+            else:
+                cur = conn.execute(
+                    "SELECT EXISTS(SELECT 1 FROM {} WHERE bank=? AND cache_key=?)".format(
+                        _table_name()
+                    ),
+                    (bank, key),
+                )
+            return bool(cur.fetchone()[0])
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"There was an error checking {bank}/{key or ''}: {exc}")
