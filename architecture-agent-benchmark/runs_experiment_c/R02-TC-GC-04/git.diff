@@ -0,0 +1,46 @@
+import logging
+
+import pytest
+
+import salt.cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def cache(minion_opts, tmp_path):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite"
+    opts["sqlite_cache.database"] = str(tmp_path / "cache.sqlite3")
+    cache = salt.cache.factory(opts)
+    return cache
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_data_survives_a_new_cache_instance(cache):
+    """
+    Simulate a master restart: a brand new Cache/backend-module instance
+    pointed at the same database file must still see previously stored
+    data.
+    """
+    cache.store("minions/alpha", "data", {"grains": {"os": "Linux"}})
+
+    restarted_cache = salt.cache.factory(cache.opts)
+    assert restarted_cache.fetch("minions/alpha", "data") == {
+        "grains": {"os": "Linux"}
+    }
+
+
+def test_default_database_lives_under_cachedir(minion_opts, tmp_path):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite"
+    opts["cachedir"] = str(tmp_path)
+
+    cache = salt.cache.factory(opts)
+    cache.store("bank", "key", "value")
+
+    assert (tmp_path / "cache.sqlite3").exists()
