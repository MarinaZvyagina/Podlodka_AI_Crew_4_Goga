+"""
+SQLite3
+=======
+
+SQLite3 plugin for the Salt caching subsystem.
+
+.. versionadded:: 3008.0
+
+This driver stores cache entries in a single SQLite database file on disk,
+using only the :py:mod:`sqlite3` module from the Python standard library --
+no separate database service (Redis, MySQL, etc.) needs to be installed or
+run. It is intended for small, single-node masters that still want their
+minion data cache (grains, mine data, job returns, and similar) to survive
+a restart of the master process without the operational overhead of a
+networked cache backend.
+
+To use sqlite3 as the minion data cache backend, set the master ``cache``
+config value to ``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+By default the database file is created as ``cache.sqlite3`` inside the
+configured :conf_master:`cachedir`. This can be overridden:
+
+.. code-block:: yaml
+
+    sqlite3.database: /var/cache/salt/master/cache.sqlite3
+"""
+
+import logging
+import os
+import sqlite3
+import threading
+
+import salt.payload
+import salt.syspaths
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+_TABLE = "cache"
+_BUSY_TIMEOUT_MS = 30 * 1000
+
+# Guards connection setup and every statement executed against it, since a
+# single sqlite3.Connection isn't safe for unsynchronized concurrent use by
+# multiple threads within one master process.
+_lock = threading.Lock()
+
+
+def __virtual__():
+    return __virtualname__
+
+
+def _escape_like(value):
+    return value.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+
+
+def _database_path():
+    configured = __opts__.get("sqlite3.database")
+    if configured:
+        return configured
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    return os.path.join(cachedir, "cache.sqlite3")
+
+
+def _connect():
+    conn = __context__.get("sqlite3_client")
+    if conn is not None:
+        return conn
+    path = _database_path()
+    dirname = os.path.dirname(path)
+    if dirname and not os.path.isdir(dirname):
+        try:
+            os.makedirs(dirname)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"Unable to create the sqlite3 cache directory {dirname}: {exc}"
+            )
+    try:
+        conn = sqlite3.connect(path, timeout=30, check_same_thread=False)
+        conn.execute(f"PRAGMA busy_timeout = {_BUSY_TIMEOUT_MS}")
+        conn.execute("PRAGMA journal_mode = WAL")
+        conn.execute(
+            f"""CREATE TABLE IF NOT EXISTS {_TABLE} (
+                bank TEXT NOT NULL,
+                cache_key TEXT NOT NULL,
+                data BLOB,
+                last_update INTEGER NOT NULL,
+                PRIMARY KEY (bank, cache_key)
+            )"""
+        )
+        conn.execute(f"CREATE INDEX IF NOT EXISTS {_TABLE}_bank ON {_TABLE} (bank)")
+        conn.commit()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Unable to open the sqlite3 cache database {path}: {exc}")
+    __context__["sqlite3_client"] = conn
+    return conn
+
+
+def force_reconnect():
+    """
+    Force a reconnection to the sqlite3 database, by removing the client
+    from Salt's __context__.
+    """
+    conn = __context__.pop("sqlite3_client", None)
+    if conn is not None:
+        conn.close()
+
+
+def store(bank, key, data):
+    """
+    Store a key value.
+    """
+    data = salt.payload.dumps(data)
+    with _lock:
+        conn = _connect()
+        try:
+            conn.execute(
+                f"INSERT OR REPLACE INTO {_TABLE}"
+                " (bank, cache_key, data, last_update)"
+                " VALUES (?, ?, ?, CAST(strftime('%s', 'now') AS INTEGER))",
+                (bank, key, data),
+            )
+            conn.commit()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"There was an error writing the key, {bank}/{key}: {exc}")
+
+
+def fetch(bank, key):
+    """
+    Fetch a key value.
+    """
+    with _lock:
+        conn = _connect()
+        try:
+            row = conn.execute(
+                f"SELECT data FROM {_TABLE} WHERE bank = ? AND cache_key = ?",
+                (bank, key),
+            ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"There was an error reading the key, {bank}/{key}: {exc}")
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key):
+    """
+    Return the Unix Epoch timestamp of when the key was last updated. Return
+    None if key is not found.
+    """
+    with _lock:
+        conn = _connect()
+        try:
+            row = conn.execute(
+                f"SELECT last_update FROM {_TABLE} WHERE bank = ? AND cache_key = ?",
+                (bank, key),
+            ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f"There was an error reading the timestamp for {bank}/{key}: {exc}"
+            )
+    return int(row[0]) if row else None
+
+
+def flush(bank, key=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key
+    is specified, remove the entire bank with all keys and sub-banks
+    inside.
+    """
+    with _lock:
+        conn = _connect()
+        try:
+            if key is None:
+                conn.execute(
+                    f"DELETE FROM {_TABLE} WHERE bank = ? OR bank LIKE ? ESCAPE '\\'",
+                    (bank, _escape_like(bank + "/") + "%"),
+                )
+            else:
+                conn.execute(
+                    f"DELETE FROM {_TABLE} WHERE bank = ? AND cache_key = ?",
+                    (bank, key),
+                )
+            conn.commit()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"There was an error removing {bank}: {exc}")
+
+
+def list_(bank):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank.
+    """
+    with _lock:
+        conn = _connect()
+        try:
+            keys = {
+                row[0]
+                for row in conn.execute(
+                    f"SELECT cache_key FROM {_TABLE} WHERE bank = ?", (bank,)
+                ).fetchall()
+            }
+            prefix = bank + "/"
+            rows = conn.execute(
+                f"SELECT DISTINCT bank FROM {_TABLE} WHERE bank LIKE ? ESCAPE '\\'",
+                (_escape_like(prefix) + "%",),
+            ).fetchall()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"There was an error listing {bank}: {exc}")
+    for (sub_bank,) in rows:
+        keys.add(sub_bank[len(prefix) :].split("/", 1)[0])
+    return sorted(keys)
+
+
+def list_all(bank, include_data=False):
+    """
+    Return ``{key: data}`` for every entry directly stored in ``bank``. When
+    ``include_data`` is False the values are omitted (empty dicts) so
+    callers can enumerate keys without paying the deserialization cost.
+    """
+    with _lock:
+        conn = _connect()
+        try:
+            rows = conn.execute(
+                f"SELECT cache_key, data FROM {_TABLE} WHERE bank = ?", (bank,)
+            ).fetchall()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"There was an error listing {bank}: {exc}")
+    if not include_data:
+        return {row[0]: {} for row in rows}
+    return {row[0]: salt.payload.loads(row[1]) for row in rows}
+
+
+def contains(bank, key=None):
+    """
+    Checks if the specified bank contains the specified key. If key is
+    None, checks whether the bank (including any sub-banks) exists at all.
+    """
+    with _lock:
+        conn = _connect()
+        try:
+            if key is None:
+                row = conn.execute(
+                    f"SELECT 1 FROM {_TABLE} WHERE bank = ? OR bank LIKE ? ESCAPE '\\' LIMIT 1",
+                    (bank, _escape_like(bank + "/") + "%"),
+                ).fetchone()
+            else:
+                row = conn.execute(
+                    f"SELECT 1 FROM {_TABLE} WHERE bank = ? AND cache_key = ?",
+                    (bank, key),
+                ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"There was an error checking {bank}: {exc}")
+    return row is not None
