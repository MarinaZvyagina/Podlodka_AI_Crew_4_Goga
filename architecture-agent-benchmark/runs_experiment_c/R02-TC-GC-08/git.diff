+++ b/salt/cache/sqlite_cache.py
@@ -0,0 +1,264 @@
+"""
+Cache data in a single SQLite database file.
+
+.. versionadded:: 3009.0
+
+The ``sqlite`` cache module gives a persistent, on-disk minion data cache
+without requiring any additional database service (Redis, MySQL, Consul,
+etcd, and similar) to be installed or operated. All data lives in one
+ordinary SQLite database file under :conf_master:`cachedir`, and the
+``sqlite3`` module used to talk to it ships with every standard CPython
+installation, so there is nothing extra to install.
+
+Because the data is stored on disk rather than only in memory, it survives
+a restart of the master process.
+
+To use sqlite as the minion data cache backend, set the master ``cache``
+config value to ``sqlite``:
+
+.. code-block:: yaml
+
+    cache: sqlite
+
+The following values are optional and can be set in the master config.
+These are the defaults:
+
+.. code-block:: yaml
+
+    # Path to the database file. Defaults to a file named cache.sqlite
+    # inside the configured cachedir.
+    sqlite.database: <cachedir>/cache.sqlite
+
+    # Number of seconds to wait for a lock on the database before giving
+    # up, when another process is writing to it at the same time.
+    sqlite.timeout: 5.0
+"""
+
+import errno
+import logging
+import os
+import time
+
+import salt.payload
+import salt.syspaths
+import salt.utils.path
+from salt.exceptions import SaltCacheError
+
+try:
+    import sqlite3
+
+    HAS_SQLITE3 = True
+except ImportError:
+    HAS_SQLITE3 = False
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite"
+__func_alias__ = {"list_": "list"}
+
+_DEFAULT_TIMEOUT = 5.0
+_TABLE = "cache"
+
+
+def __virtual__():
+    """
+    Confirm that the sqlite3 module (part of the Python standard library)
+    is available.
+    """
+    if not HAS_SQLITE3:
+        return False, "No python sqlite3 client installed."
+    return __virtualname__
+
+
+def _database_path():
+    path = __opts__.get("sqlite.database")
+    if path:
+        return path
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    return salt.utils.path.join(cachedir, "cache.sqlite")
+
+
+def _connect():
+    """
+    Open a fresh connection to the cache database, creating the containing
+    directory and the cache table if they don't already exist.
+
+    A new connection is opened for every call rather than reused, so that
+    this driver never has to coordinate a single sqlite3 connection object
+    (which is not safe to share) across the master's worker threads and
+    processes.
+    """
+    path = _database_path()
+    dirname = os.path.dirname(path)
+    if dirname and not os.path.isdir(dirname):
+        try:
+            os.makedirs(dirname)
+        except OSError as exc:
+            if exc.errno != errno.EEXIST:
+                raise SaltCacheError(
+                    f"Could not create the sqlite cache directory {dirname}: {exc}"
+                )
+
+    timeout = __opts__.get("sqlite.timeout", _DEFAULT_TIMEOUT)
+    try:
+        conn = sqlite3.connect(path, timeout=timeout)
+        conn.execute(
+            f"CREATE TABLE IF NOT EXISTS {_TABLE} ("
+            "bank TEXT NOT NULL, "
+            "key TEXT NOT NULL, "
+            "data BLOB, "
+            "last_update REAL NOT NULL, "
+            "PRIMARY KEY (bank, key))"
+        )
+        conn.commit()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Could not open the sqlite cache database {path}: {exc}")
+    return conn
+
+
+def store(bank, key, data):
+    """
+    Store a key value.
+    """
+    conn = _connect()
+    try:
+        payload = salt.payload.dumps(data)
+        conn.execute(
+            f"INSERT OR REPLACE INTO {_TABLE} (bank, key, data, last_update) "
+            "VALUES (?, ?, ?, ?)",
+            (bank, key, payload, time.time()),
+        )
+        conn.commit()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error storing {bank}/{key} in sqlite cache: {exc}")
+    finally:
+        conn.close()
+
+
+def fetch(bank, key):
+    """
+    Fetch a key value.
+    """
+    conn = _connect()
+    try:
+        cur = conn.execute(
+            f"SELECT data FROM {_TABLE} WHERE bank = ? AND key = ?", (bank, key)
+        )
+        row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error fetching {bank}/{key} from sqlite cache: {exc}")
+    finally:
+        conn.close()
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key):
+    """
+    Return the integer Unix epoch update timestamp of the specified bank and
+    key, or None if it doesn't exist.
+    """
+    conn = _connect()
+    try:
+        cur = conn.execute(
+            f"SELECT last_update FROM {_TABLE} WHERE bank = ? AND key = ?",
+            (bank, key),
+        )
+        row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error reading {bank}/{key} from sqlite cache: {exc}")
+    finally:
+        conn.close()
+    if row is None:
+        return None
+    return int(row[0])
+
+
+def flush(bank, key=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key is
+    specified remove the entire bank with all keys and sub-banks inside.
+    """
+    conn = _connect()
+    try:
+        if key is None:
+            cur = conn.execute(f"DELETE FROM {_TABLE} WHERE bank = ?", (bank,))
+        else:
+            cur = conn.execute(
+                f"DELETE FROM {_TABLE} WHERE bank = ? AND key = ?", (bank, key)
+            )
+        conn.commit()
+        removed = cur.rowcount > 0
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error removing {bank}/{key} from sqlite cache: {exc}")
+    finally:
+        conn.close()
+    return removed
+
+
+def list_(bank):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank.
+    """
+    conn = _connect()
+    try:
+        cur = conn.execute(f"SELECT key FROM {_TABLE} WHERE bank = ?", (bank,))
+        rows = cur.fetchall()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error listing bank {bank} in sqlite cache: {exc}")
+    finally:
+        conn.close()
+    return [row[0] for row in rows]
+
+
+def list_all(bank, include_data=False):
+    """
+    Return all entries with their data from the specified bank, avoiding a
+    round trip per key. Returns a dict of ``{key: data}``; when
+    ``include_data`` is False the values are omitted (empty dicts) so callers
+    that only need the key names avoid deserializing every entry.
+    """
+    conn = _connect()
+    try:
+        if include_data:
+            cur = conn.execute(
+                f"SELECT key, data FROM {_TABLE} WHERE bank = ?", (bank,)
+            )
+            rows = cur.fetchall()
+        else:
+            cur = conn.execute(f"SELECT key FROM {_TABLE} WHERE bank = ?", (bank,))
+            rows = [(row[0], None) for row in cur.fetchall()]
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error listing bank {bank} in sqlite cache: {exc}")
+    finally:
+        conn.close()
+
+    if include_data:
+        return {row[0]: salt.payload.loads(row[1]) for row in rows}
+    return {row[0]: {} for row in rows}
+
+
+def contains(bank, key=None):
+    """
+    Checks if the specified bank contains the specified key. If key is None
+    checks for the bank existence instead.
+    """
+    conn = _connect()
+    try:
+        if key is None:
+            cur = conn.execute(
+                f"SELECT 1 FROM {_TABLE} WHERE bank = ? LIMIT 1", (bank,)
+            )
+        else:
+            cur = conn.execute(
+                f"SELECT 1 FROM {_TABLE} WHERE bank = ? AND key = ? LIMIT 1",
+                (bank, key),
+            )
+        row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error checking {bank}/{key} in sqlite cache: {exc}")
+    finally:
+        conn.close()
+    return row is not None
