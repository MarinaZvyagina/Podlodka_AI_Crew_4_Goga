@@ -0,0 +1,70 @@
+"""
+Functional tests for the salt.cache sqlite driver.
+
+These exercise the full salt.cache.Cache() public API backed by the real
+sqlite_cache driver with a real opts dict and a real on-disk database file
+-- the same path production code takes.
+"""
+
+import salt.cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+
+def _opts(minion_opts, tmp_path):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite"
+    opts["sqlite.database"] = str(tmp_path / "cache.sqlite")
+    return opts
+
+
+def test_caching(subtests, minion_opts, tmp_path):
+    cache = salt.cache.factory(_opts(minion_opts, tmp_path))
+    run_common_cache_tests(subtests, cache)
+
+
+def test_data_persists_across_new_cache_instance(minion_opts, tmp_path):
+    opts = _opts(minion_opts, tmp_path)
+
+    c1 = salt.cache.factory(opts)
+    c1.store("persist", "key", {"data": 42})
+
+    # A fresh Cache instance pointed at the same database file stands in for
+    # what happens after a master restart: nothing is shared in memory
+    # between c1 and c2, only the file on disk.
+    c2 = salt.cache.factory(opts)
+    assert c2.fetch("persist", "key") == {"data": 42}
+
+
+def test_list_persists_across_instances(minion_opts, tmp_path):
+    opts = _opts(minion_opts, tmp_path)
+
+    c1 = salt.cache.factory(opts)
+    c1.store("p", "k1", 1)
+    c1.store("p", "k2", 2)
+
+    c2 = salt.cache.factory(opts)
+    assert sorted(c2.list("p")) == ["k1", "k2"]
+
+
+def test_database_defaults_under_cachedir(minion_opts, tmp_path):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite"
+    opts["cachedir"] = str(tmp_path / "cachedir")
+
+    cache = salt.cache.factory(opts)
+    cache.store("bank", "key", "value")
+
+    assert (tmp_path / "cachedir" / "cache.sqlite").exists()
+
+
+def test_list_all_includes_data(minion_opts, tmp_path):
+    opts = _opts(minion_opts, tmp_path)
+    cache = salt.cache.factory(opts)
+
+    cache.store("bank", "k1", {"a": 1})
+    cache.store("bank", "k2", {"b": 2})
+
+    assert cache.list_all("bank", include_data=True) == {
+        "k1": {"a": 1},
+        "k2": {"b": 2},
+    }
