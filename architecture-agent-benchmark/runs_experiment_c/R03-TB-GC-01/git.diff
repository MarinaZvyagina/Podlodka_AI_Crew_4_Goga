@@ -0,0 +1,90 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+const OPEN = 1;
+const CONNECTING = 0;
+
+function createFakeClient(readyState = OPEN) {
+  return {
+    readyState,
+    send: vi.fn((_data: string, cb?: (err?: Error) => void) => cb?.()),
+  };
+}
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('notifyShutdown', () => {
+    it('should send the default shutdown message to every open client', async () => {
+      const client1 = createFakeClient();
+      const client2 = createFakeClient();
+      const server = { clients: new Set([client1, client2]) };
+
+      await adapter.notifyShutdown(server);
+
+      const expectedPayload = JSON.stringify({
+        event: 'shutdown',
+        data: 'Server is shutting down',
+      });
+      expect(client1.send).toHaveBeenCalledWith(
+        expectedPayload,
+        expect.any(Function),
+      );
+      expect(client2.send).toHaveBeenCalledWith(
+        expectedPayload,
+        expect.any(Function),
+      );
+    });
+
+    it('should send a custom shutdown message when configured', async () => {
+      const client = createFakeClient();
+      const server = { clients: new Set([client]) };
+      adapter.setShutdownMessage({ event: 'bye', data: { reason: 'redeploy' } });
+
+      await adapter.notifyShutdown(server);
+
+      expect(client.send).toHaveBeenCalledWith(
+        JSON.stringify({ event: 'bye', data: { reason: 'redeploy' } }),
+        expect.any(Function),
+      );
+    });
+
+    it('should skip clients that are not open', async () => {
+      const connectingClient = createFakeClient(CONNECTING);
+      const server = { clients: new Set([connectingClient]) };
+
+      await adapter.notifyShutdown(server);
+
+      expect(connectingClient.send).not.toHaveBeenCalled();
+    });
+
+    it('should not send anything when the shutdown message is disabled', async () => {
+      const client = createFakeClient();
+      const server = { clients: new Set([client]) };
+      adapter.setShutdownMessage(null);
+
+      await adapter.notifyShutdown(server);
+
+      expect(client.send).not.toHaveBeenCalled();
+    });
+
+    it('should do nothing when the server has no clients registry', async () => {
+      await expect(adapter.notifyShutdown({})).resolves.toBeUndefined();
+    });
+
+    it('should not reject even if a client throws while sending', async () => {
+      const throwingClient = {
+        readyState: OPEN,
+        send: vi.fn(() => {
+          throw new Error('socket already destroyed');
+        }),
+      };
+      const server = { clients: new Set([throwingClient]) };
+
+      await expect(adapter.notifyShutdown(server)).resolves.toBeUndefined();
+    });
+  });
+});
