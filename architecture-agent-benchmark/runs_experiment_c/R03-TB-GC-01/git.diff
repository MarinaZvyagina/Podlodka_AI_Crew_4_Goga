@@ -0,0 +1,44 @@
+import { AbstractWsAdapter } from '../../adapters/ws-adapter.js';
+
+class NoopAdapter extends AbstractWsAdapter {
+  public create(port: number, options?: any) {}
+  public bindMessageHandlers(client: any, handlers) {}
+  public getShutdownMessage() {
+    return this.shutdownMessage;
+  }
+}
+
+describe('AbstractWsAdapter', () => {
+  let adapter: NoopAdapter;
+
+  beforeEach(() => {
+    adapter = new NoopAdapter();
+  });
+
+  describe('notifyShutdown', () => {
+    it('should be a no-op by default (no protocol-specific broadcast implemented)', async () => {
+      const server = { close: vi.fn(), on: vi.fn() };
+      await expect(adapter.notifyShutdown(server)).resolves.toBeUndefined();
+    });
+  });
+
+  describe('setShutdownMessage', () => {
+    it('should default to a non-null shutdown message', () => {
+      expect(adapter.getShutdownMessage()).toEqual({
+        event: 'shutdown',
+        data: 'Server is shutting down',
+      });
+    });
+
+    it('should allow overriding the default shutdown message', () => {
+      const message = { event: 'bye', data: { reason: 'redeploy' } };
+      adapter.setShutdownMessage(message);
+      expect(adapter.getShutdownMessage()).toBe(message);
+    });
+
+    it('should allow disabling the shutdown notice entirely', () => {
+      adapter.setShutdownMessage(null);
+      expect(adapter.getShutdownMessage()).toBeNull();
+    });
+  });
+});
