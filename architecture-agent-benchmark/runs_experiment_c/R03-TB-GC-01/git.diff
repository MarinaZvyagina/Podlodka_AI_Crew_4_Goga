+import { ApplicationConfig } from '@nestjs/core/application-config.js';
+import { SocketModule } from '../socket-module.js';
+import { SocketsContainer } from '../sockets-container.js';
+
+describe('SocketModule', () => {
+  describe('close', () => {
+    it('should do nothing when the module was never registered', async () => {
+      const instance = new SocketModule();
+      await expect(instance.close()).resolves.toBeUndefined();
+    });
+
+    it('should do nothing when no adapter was ever created (no gateways in the app)', async () => {
+      const instance = new SocketModule();
+      (instance as any).applicationConfig = new ApplicationConfig(null);
+      await expect(instance.close()).resolves.toBeUndefined();
+    });
+
+    it('should notify each registered server of shutdown before closing it, then dispose the adapter', async () => {
+      const calls: string[] = [];
+      const adapter = {
+        notifyShutdown: vi.fn(async (_server: any) => {
+          calls.push('notify');
+        }),
+        close: vi.fn(async (_server: any) => {
+          calls.push('close');
+        }),
+        dispose: vi.fn(async () => {
+          calls.push('dispose');
+        }),
+      };
+
+      const instance = new SocketModule();
+      const socketsContainer = new SocketsContainer();
+      const server = { foo: 'bar' };
+      socketsContainer.addOne(
+        { namespace: '/' } as any,
+        { server, init: undefined, connection: undefined, disconnect: undefined } as any,
+      );
+
+      (instance as any).applicationConfig = new ApplicationConfig(
+        adapter as any,
+      );
+      (instance as any).socketsContainer = socketsContainer;
+
+      await instance.close();
+
+      expect(adapter.notifyShutdown).toHaveBeenCalledWith(server);
+      expect(adapter.close).toHaveBeenCalledWith(server);
+      expect(adapter.dispose).toHaveBeenCalled();
+      expect(calls).toEqual(['notify', 'close', 'dispose']);
+      expect(socketsContainer.getAll().size).toBe(0);
+    });
+
+    it('should not throw when the configured adapter has no notifyShutdown method', async () => {
+      const adapter = {
+        close: vi.fn(async () => {}),
+        dispose: vi.fn(async () => {}),
+      };
+
+      const instance = new SocketModule();
+      const socketsContainer = new SocketsContainer();
+      const server = { foo: 'bar' };
+      socketsContainer.addOne(
+        { namespace: '/' } as any,
+        { server, init: undefined, connection: undefined, disconnect: undefined } as any,
+      );
+
+      (instance as any).applicationConfig = new ApplicationConfig(
+        adapter as any,
+      );
+      (instance as any).socketsContainer = socketsContainer;
+
+      await expect(instance.close()).resolves.toBeUndefined();
+      expect(adapter.close).toHaveBeenCalledWith(server);
+    });
+
+    it('should not call notifyShutdown or close when there are no registered servers', async () => {
+      const adapter = {
+        notifyShutdown: vi.fn(async () => {}),
+        close: vi.fn(async () => {}),
+        dispose: vi.fn(async () => {}),
+      };
+
+      const instance = new SocketModule();
+      (instance as any).applicationConfig = new ApplicationConfig(
+        adapter as any,
+      );
+      (instance as any).socketsContainer = new SocketsContainer();
+
+      await instance.close();
+
+      expect(adapter.notifyShutdown).not.toHaveBeenCalled();
+      expect(adapter.close).not.toHaveBeenCalled();
+    });
+  });
+});
