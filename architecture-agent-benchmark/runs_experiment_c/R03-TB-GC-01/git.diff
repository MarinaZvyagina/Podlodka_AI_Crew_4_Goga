+/**
+ * Message broadcast to connected clients right before a WebSocket server
+ * closes their connection as part of the application shutdown sequence.
+ *
+ * @publicApi
+ */
+export interface WsShutdownMessage<T = any> {
+  event: string;
+  data?: T;
+}
