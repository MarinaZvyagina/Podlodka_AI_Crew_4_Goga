diff --git a/packages/platform-socket.io/adapters/io-adapter.ts b/packages/platform-socket.io/adapters/io-adapter.ts
index 90c640c..54b20be 100644
--- a/packages/platform-socket.io/adapters/io-adapter.ts
+++ b/packages/platform-socket.io/adapters/io-adapter.ts
@@ -99,4 +99,16 @@ export class IoAdapter extends AbstractWsAdapter {
 
     return super.close(server);
   }
+
+  public async notifyShutdown(server: Server | Namespace): Promise<void> {
+    if (!this.shutdownMessage) {
+      return;
+    }
+    server.emit(this.shutdownMessage.event, this.shutdownMessage.data);
+    // Engine.IO discards any buffered-but-unflushed packets when the server
+    // forcibly tears down connections on close(), and socket.io doesn't
+    // expose a per-emit flush/ack signal. A brief pause here gives the
+    // transport a chance to actually write the packet out before that happens.
+    await new Promise(resolve => setTimeout(resolve, 100));
+  }
 }
