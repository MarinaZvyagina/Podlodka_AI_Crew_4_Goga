@@ -0,0 +1,87 @@
+import { INestApplication } from '@nestjs/common';
+import { WsAdapter } from '@nestjs/platform-ws';
+import { Test } from '@nestjs/testing';
+import { io } from 'socket.io-client';
+import WebSocket from 'ws';
+import { ApplicationGateway } from '../src/app.gateway.js';
+
+describe('WebSocket graceful shutdown notice', () => {
+  describe('socket.io (IoAdapter)', () => {
+    it('should notify a connected client before the server closes it', async () => {
+      const testingModule = await Test.createTestingModule({
+        providers: [ApplicationGateway],
+      }).compile();
+      const app = testingModule.createNestApplication();
+      await app.listen(3000);
+
+      const ws = io('http://localhost:8080');
+      await new Promise<void>(resolve => ws.on('connect', resolve));
+
+      const shutdownMessage = new Promise<any>(resolve =>
+        ws.once('shutdown', data => resolve(data)),
+      );
+      const disconnected = new Promise<void>(resolve =>
+        ws.once('disconnect', () => resolve()),
+      );
+
+      await app.close();
+
+      const data = await shutdownMessage;
+      expect(data).toEqual('Server is shutting down');
+      await disconnected;
+
+      ws.close();
+    });
+
+    it('should not throw when closing with no connected clients', async () => {
+      const testingModule = await Test.createTestingModule({
+        providers: [ApplicationGateway],
+      }).compile();
+      const app = testingModule.createNestApplication();
+      await app.listen(3000);
+
+      await expect(app.close()).resolves.not.toThrow();
+    });
+  });
+
+  describe('ws (WsAdapter)', () => {
+    it('should notify a connected client before the server closes it', async () => {
+      const testingModule = await Test.createTestingModule({
+        providers: [ApplicationGateway],
+      }).compile();
+      const app = testingModule.createNestApplication();
+      app.useWebSocketAdapter(new WsAdapter(app) as any);
+      await app.listen(3000);
+
+      const client = new WebSocket('ws://localhost:8080');
+      await new Promise(resolve => client.on('open', resolve));
+
+      const shutdownMessage = new Promise<any>(resolve =>
+        client.once('message', data => resolve(JSON.parse(data.toString()))),
+      );
+      const closed = new Promise<void>(resolve =>
+        client.once('close', () => resolve()),
+      );
+
+      await app.close();
+
+      const message = await shutdownMessage;
+      expect(message).toEqual({
+        event: 'shutdown',
+        data: 'Server is shutting down',
+      });
+      await closed;
+    });
+
+    it('should not throw when closing with no connected clients', async () => {
+      const testingModule = await Test.createTestingModule({
+        providers: [ApplicationGateway],
+      }).compile();
+      const app = testingModule.createNestApplication();
+      app.useWebSocketAdapter(new WsAdapter(app) as any);
+      await app.listen(3000);
+
+      await expect(app.close()).resolves.not.toThrow();
+    });
+  });
+});
