   public async close(server: Server): Promise<void> {
+    await this.notifyClientsOfShutdown(server);
+
     if (this.forceCloseConnections && server.httpServer === this.httpServer) {
       return;
     }
 
     return super.close(server);
   }
+
+  /**
+   * Broadcasts a shutdown notice to every client currently connected to
+   * the given server/namespace, giving clients a chance to tell a
+   * deliberate shutdown apart from a dropped connection before they're
+   * disconnected.
+   */
+  private async notifyClientsOfShutdown(
+    server: Server | Namespace,
+  ): Promise<void> {
+    if (!isFunction(server?.emit)) {
+      return;
+    }
+    server.emit(SHUTDOWN_EVENT);
+    // Yield to the event loop so the emitted packets are flushed to the
+    // underlying transports before the connections are torn down.
+    await new Promise(resolve => setImmediate(resolve));
+  }
 }
