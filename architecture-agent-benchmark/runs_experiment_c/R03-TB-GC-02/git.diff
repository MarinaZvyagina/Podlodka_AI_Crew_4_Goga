+/**
+ * Emitted to connected clients right before the gateway's underlying
+ * server is closed as part of the application shutdown sequence, so
+ * clients can distinguish an intentional shutdown from a dropped
+ * connection.
+ */
+export const SHUTDOWN_EVENT = 'shutdown';
