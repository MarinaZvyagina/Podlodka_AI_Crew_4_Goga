new file mode 100644
index 0000000..132e586
--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,76 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+const OPEN_STATE = 1;
+const CLOSING_STATE = 2;
+
+function createFakeClient(readyState = OPEN_STATE) {
+  return {
+    readyState,
+    send: vi.fn((_data: string, cb: Function) => cb()),
+    terminate: vi.fn(),
+  };
+}
+
+function createFakeServer(clients: any[]) {
+  return {
+    clients: new Set(clients),
+    close: vi.fn((cb: Function) => cb()),
+  };
+}
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('close', () => {
+    it('should send a shutdown notice to every open client before terminating it', async () => {
+      const client = createFakeClient();
+      const server = createFakeServer([client]);
+
+      await adapter.close(server as any);
+
+      expect(client.send).toHaveBeenCalledWith(
+        JSON.stringify({ event: 'shutdown' }),
+        expect.any(Function),
+      );
+      expect(client.terminate).toHaveBeenCalled();
+      expect(server.close).toHaveBeenCalled();
+
+      const sendOrder = client.send.mock.invocationCallOrder[0];
+      const terminateOrder = client.terminate.mock.invocationCallOrder[0];
+      expect(sendOrder).toBeLessThan(terminateOrder);
+    });
+
+    it('should skip notifying clients that are not open', async () => {
+      const client = createFakeClient(CLOSING_STATE);
+      const server = createFakeServer([client]);
+
+      await adapter.close(server as any);
+
+      expect(client.send).not.toHaveBeenCalled();
+      expect(client.terminate).toHaveBeenCalled();
+    });
+
+    it('should not throw when the server has no connected clients', async () => {
+      const server = createFakeServer([]);
+
+      await expect(adapter.close(server as any)).resolves.toBeUndefined();
+      expect(server.close).toHaveBeenCalled();
+    });
+
+    it('should not hang shutdown if a client never acknowledges the send', async () => {
+      const client = {
+        readyState: OPEN_STATE,
+        send: vi.fn(),
+        terminate: vi.fn(),
+      };
+      const server = createFakeServer([client]);
+
+      await expect(adapter.close(server as any)).resolves.toBeUndefined();
+      expect(client.terminate).toHaveBeenCalled();
+    }, 2000);
+  });
+});
