@@ -93,10 +97,21 @@ export class IoAdapter extends AbstractWsAdapter {
   }
 
   public async close(server: Server): Promise<void> {
+    await this.notifyClientsOfShutdown(server);
+
     if (this.forceCloseConnections && server.httpServer === this.httpServer) {
       return;
     }
 
     return super.close(server);
   }
+
+  private async notifyClientsOfShutdown(server: Server): Promise<void> {
+    if (!isFunction(server.emit)) {
+      return;
+    }
+    server.emit(SHUTDOWN_EVENT, SHUTDOWN_MESSAGE);
+    // Give the transport a chance to flush the notice before sockets are torn down.
+    await new Promise(resolve => setImmediate(resolve));
+  }
 }
