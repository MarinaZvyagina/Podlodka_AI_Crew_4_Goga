@@ -0,0 +1,72 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('close', () => {
+    function createFakeServer(clients: any[]) {
+      let closeCallback: (err?: Error) => void;
+      return {
+        clients,
+        close: (cb: (err?: Error) => void) => {
+          closeCallback = cb;
+          closeCallback();
+        },
+      };
+    }
+
+    it('should send a shutdown notice to every open client before terminating it', async () => {
+      const openClient = { readyState: 1, send: vi.fn(), terminate: vi.fn() };
+      const server = createFakeServer([openClient]);
+
+      await adapter.close(server as any);
+      // Termination is deferred (setImmediate) so the notice can flush first.
+      await new Promise(resolve => setImmediate(resolve));
+
+      expect(openClient.send).toHaveBeenCalledTimes(1);
+      const [payload] = openClient.send.mock.calls[0];
+      expect(JSON.parse(payload)).toEqual({
+        event: 'shutdown',
+        data: 'Server is shutting down',
+      });
+      expect(openClient.terminate).toHaveBeenCalledTimes(1);
+    });
+
+    it('should not attempt to send to a client that is not open, but should still terminate it', async () => {
+      const closingClient = { readyState: 2, send: vi.fn(), terminate: vi.fn() };
+      const server = createFakeServer([closingClient]);
+
+      await adapter.close(server as any);
+      await new Promise(resolve => setImmediate(resolve));
+
+      expect(closingClient.send).not.toHaveBeenCalled();
+      expect(closingClient.terminate).toHaveBeenCalledTimes(1);
+    });
+
+    it('should not throw and should still close the server when there are no clients', async () => {
+      const server = createFakeServer([]);
+
+      await expect(adapter.close(server as any)).resolves.toBeUndefined();
+    });
+
+    it('should terminate the client even if sending the notice throws', async () => {
+      const brokenClient = {
+        readyState: 1,
+        send: vi.fn(() => {
+          throw new Error('socket already closing');
+        }),
+        terminate: vi.fn(),
+      };
+      const server = createFakeServer([brokenClient]);
+
+      await adapter.close(server as any);
+      await new Promise(resolve => setImmediate(resolve));
+
+      expect(brokenClient.terminate).toHaveBeenCalledTimes(1);
+    });
+  });
+});
diff --git a/packages/websockets/constants.ts b/packages/websockets/constants.ts
index e8b7b8e..a5a53b2 100644
--- a/packages/websockets/constants.ts
+++ b/packages/websockets/constants.ts
@@ -13,3 +13,11 @@ export const CONNECTION_EVENT = 'connection';
 export const DISCONNECT_EVENT = 'disconnect';
 export const CLOSE_EVENT = 'close';
 export const ERROR_EVENT = 'error';
+
+/**
+ * Event name and default payload sent to connected clients right before a
+ * gateway's server is closed (e.g. during application shutdown), so that
+ * front-ends can tell a deliberate shutdown apart from a dropped connection.
+ */
+export const SHUTDOWN_EVENT = 'shutdown';
+export const SHUTDOWN_MESSAGE = 'Server is shutting down';
