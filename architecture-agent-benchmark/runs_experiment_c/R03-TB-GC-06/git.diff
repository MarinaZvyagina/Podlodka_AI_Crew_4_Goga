@@ -0,0 +1,103 @@
+import { INestApplication } from '@nestjs/common';
+import { WsAdapter } from '@nestjs/platform-ws';
+import { Test } from '@nestjs/testing';
+import { io } from 'socket.io-client';
+import WebSocket from 'ws';
+import { ApplicationGateway } from '../src/app.gateway.js';
+
+async function createNestApp(): Promise<INestApplication> {
+  const testingModule = await Test.createTestingModule({
+    providers: [ApplicationGateway],
+  }).compile();
+  return testingModule.createNestApplication();
+}
+
+describe('WebSocket shutdown notice', () => {
+  let app: INestApplication;
+
+  afterEach(async () => {
+    if (app) {
+      await app.close();
+    }
+  });
+
+  it('should notify a connected socket.io client before the app closes it', async () => {
+    app = await createNestApp();
+    await app.listen(3000);
+
+    const client = io('http://localhost:8080');
+    await new Promise<void>(resolve => client.on('connect', resolve));
+
+    const events: string[] = [];
+    let shutdownPayload: any;
+    const disconnected = new Promise<void>(resolve => {
+      client.on('shutdown', payload => {
+        events.push('shutdown');
+        shutdownPayload = payload;
+      });
+      client.on('disconnect', () => {
+        events.push('disconnect');
+        resolve();
+      });
+    });
+
+    const closePromise = app.close();
+    await Promise.all([disconnected, closePromise]);
+
+    expect(shutdownPayload).toEqual(
+      expect.objectContaining({ message: expect.any(String) }),
+    );
+    // the shutdown notice must arrive strictly before the disconnect
+    expect(events).toEqual(['shutdown', 'disconnect']);
+
+    client.close();
+  });
+
+  it('should notify a connected ws client before the app closes it', async () => {
+    app = await createNestApp();
+    app.useWebSocketAdapter(new WsAdapter(app) as any);
+    await app.listen(3000);
+
+    const client = new WebSocket('ws://localhost:8080');
+    await new Promise(resolve => client.on('open', resolve));
+
+    const events: string[] = [];
+    let shutdownPayload: any;
+    const closed = new Promise<void>(resolve => {
+      client.on('message', data => {
+        const message = JSON.parse(data.toString());
+        if (message.event === 'shutdown') {
+          events.push('shutdown');
+          shutdownPayload = message.data;
+        }
+      });
+      client.on('close', () => {
+        events.push('close');
+        resolve();
+      });
+    });
+
+    const closePromise = app.close();
+    await Promise.all([closed, closePromise]);
+
+    expect(shutdownPayload).toEqual(
+      expect.objectContaining({ message: expect.any(String) }),
+    );
+    expect(events).toEqual(['shutdown', 'close']);
+  });
+
+  it('should close cleanly (socket.io) when no clients are connected', async () => {
+    app = await createNestApp();
+    await app.listen(3000);
+
+    await expect(app.close()).resolves.toBeUndefined();
+  });
+
+  it('should close cleanly (ws) when no clients are connected', async () => {
+    app = await createNestApp();
+    app.useWebSocketAdapter(new WsAdapter(app) as any);
+    await app.listen(3000);
+
+    await expect(app.close()).resolves.toBeUndefined();
+  });
+});
