+
+  /**
+   * Broadcasts a shutdown notice to every client still connected to this
+   * server/namespace, giving well-behaved clients a chance to distinguish
+   * a graceful deploy from a dropped connection before it is torn down.
+   */
+  protected async notifyClientsOfShutdown(
+    server: Server | Namespace,
+  ): Promise<void> {
+    const connectedSockets =
+      (server as Namespace).sockets instanceof Map
+        ? (server as Namespace).sockets
+        : (server as Server).sockets?.sockets;
+    if (!connectedSockets?.size) {
+      return;
+    }
+
+    server.emit(SHUTDOWN_EVENT, { message: SHUTDOWN_MESSAGE });
+
+    // Yield to the event loop so the emitted packets can be flushed to the
+    // underlying transports before the server/sockets are closed below.
+    await new Promise<void>(resolve => setImmediate(resolve));
+  }
 }
