diff --git a/packages/platform-ws/test/ws-adapter.spec.ts b/packages/platform-ws/test/ws-adapter.spec.ts
new file mode 100644
index 0000000..f6650e9
--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,86 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+const OPEN_STATE = 1;
+const CLOSED_STATE = 3;
+
+function createFakeClient(readyState: number) {
+  return {
+    readyState,
+    send: vi.fn((_data: string, callback: () => void) => callback()),
+    terminate: vi.fn(),
+  };
+}
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('close', () => {
+    it('should send a shutdown notice to every open client before terminating it', async () => {
+      const clientA = createFakeClient(OPEN_STATE);
+      const clientB = createFakeClient(OPEN_STATE);
+      const server = {
+        clients: new Set([clientA, clientB]),
+        close: vi.fn((callback: (err?: Error) => void) => callback()),
+      };
+
+      await adapter.close(server as any);
+
+      for (const client of [clientA, clientB]) {
+        expect(client.send).toHaveBeenCalledTimes(1);
+        const [payload] = client.send.mock.calls[0];
+        expect(JSON.parse(payload)).toEqual({
+          event: 'shutdown',
+          data: { message: expect.any(String) },
+        });
+        expect(client.terminate).toHaveBeenCalled();
+        // the notice must be flushed (send's callback resolved) before terminate
+        expect(client.send.mock.invocationCallOrder[0]).toBeLessThan(
+          client.terminate.mock.invocationCallOrder[0],
+        );
+      }
+      expect(server.close).toHaveBeenCalled();
+    });
+
+    it('should not attempt to notify clients that are not open', async () => {
+      const client = createFakeClient(CLOSED_STATE);
+      const server = {
+        clients: new Set([client]),
+        close: vi.fn((callback: (err?: Error) => void) => callback()),
+      };
+
+      await adapter.close(server as any);
+
+      expect(client.send).not.toHaveBeenCalled();
+      expect(client.terminate).toHaveBeenCalled();
+    });
+
+    it('should not fail when there are no connected clients', async () => {
+      const server = {
+        clients: new Set(),
+        close: vi.fn((callback: (err?: Error) => void) => callback()),
+      };
+
+      await expect(adapter.close(server as any)).resolves.toBeUndefined();
+      expect(server.close).toHaveBeenCalled();
+    });
+
+    it('should not let a client send() error prevent the server from closing', async () => {
+      const client = createFakeClient(OPEN_STATE);
+      client.send.mockImplementation(() => {
+        throw new Error('socket already closed');
+      });
+      const server = {
+        clients: new Set([client]),
+        close: vi.fn((callback: (err?: Error) => void) => callback()),
+      };
+
+      await expect(adapter.close(server as any)).resolves.toBeUndefined();
+      expect(client.terminate).toHaveBeenCalled();
+      expect(server.close).toHaveBeenCalled();
+    });
+  });
+});
