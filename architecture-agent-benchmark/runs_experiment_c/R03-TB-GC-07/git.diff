@@ -0,0 +1,104 @@
+import { ApplicationConfig } from '@nestjs/core/application-config.js';
+import { AbstractWsAdapter } from '../adapters/ws-adapter.js';
+import { SocketModule } from '../socket-module.js';
+import { SocketsContainer } from '../sockets-container.js';
+
+describe('SocketModule', () => {
+  let socketModule: SocketModule;
+  let socketsContainer: SocketsContainer;
+
+  beforeEach(() => {
+    socketModule = new SocketModule();
+    socketsContainer = new SocketsContainer();
+    (socketModule as any).socketsContainer = socketsContainer;
+  });
+
+  describe('close', () => {
+    it('should do nothing when the module was never registered', async () => {
+      await expect(socketModule.close()).resolves.toBeUndefined();
+    });
+
+    it('should do nothing when no adapter has been configured', async () => {
+      const config = new ApplicationConfig();
+      (socketModule as any).applicationConfig = config;
+
+      await expect(socketModule.close()).resolves.toBeUndefined();
+    });
+
+    it('should notify each connected server before closing it, in order', async () => {
+      const calls: string[] = [];
+      class TestAdapter extends AbstractWsAdapter {
+        public create() {}
+        public bindMessageHandlers() {}
+        public notifyShutdown = vi.fn((server: any) => {
+          calls.push(`notify:${server.id}`);
+        });
+        public close = vi.fn(async (server: any) => {
+          calls.push(`close:${server.id}`);
+        });
+      }
+      const adapter = new TestAdapter();
+      const config = new ApplicationConfig(adapter);
+      (socketModule as any).applicationConfig = config;
+
+      const serverA = { id: 'a' };
+      const serverB = { id: 'b' };
+      socketsContainer.addOne({ port: 1 } as any, {
+        server: serverA,
+      } as any);
+      socketsContainer.addOne({ port: 2 } as any, {
+        server: serverB,
+      } as any);
+
+      await socketModule.close();
+
+      expect(adapter.notifyShutdown).toHaveBeenCalledTimes(2);
+      expect(adapter.close).toHaveBeenCalledTimes(2);
+      expect(calls).toEqual(
+        expect.arrayContaining(['notify:a', 'close:a', 'notify:b', 'close:b']),
+      );
+      // notify must happen before close for the same server
+      expect(calls.indexOf('notify:a')).toBeLessThan(calls.indexOf('close:a'));
+      expect(calls.indexOf('notify:b')).toBeLessThan(calls.indexOf('close:b'));
+    });
+
+    it('should still close servers when the adapter does not implement notifyShutdown', async () => {
+      class LegacyAdapter extends AbstractWsAdapter {
+        public create() {}
+        public bindMessageHandlers() {}
+        public close = vi.fn(async () => {});
+      }
+      const adapter = new LegacyAdapter();
+      const config = new ApplicationConfig(adapter);
+      (socketModule as any).applicationConfig = config;
+
+      socketsContainer.addOne({ port: 1 } as any, {
+        server: { id: 'a' },
+      } as any);
+
+      await expect(socketModule.close()).resolves.toBeUndefined();
+      expect(adapter.close).toHaveBeenCalledTimes(1);
+    });
+
+    it('should skip entries without a server', async () => {
+      class TestAdapter extends AbstractWsAdapter {
+        public create() {}
+        public bindMessageHandlers() {}
+        public notifyShutdown = vi.fn();
+        public close = vi.fn(async () => {});
+      }
+      const adapter = new TestAdapter();
+      const config = new ApplicationConfig(adapter);
+      (socketModule as any).applicationConfig = config;
+
+      socketsContainer.addOne({ port: 1 } as any, {
+        server: undefined,
+      } as any);
+
+      await socketModule.close();
+
+      expect(adapter.notifyShutdown).not.toHaveBeenCalled();
+      expect(adapter.close).not.toHaveBeenCalled();
+    });
+  });
+});
