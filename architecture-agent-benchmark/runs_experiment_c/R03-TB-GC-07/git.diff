index 0000000..259be57
--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,48 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('notifyShutdown', () => {
+    function createClient(readyState: number) {
+      return {
+        readyState,
+        send: vi.fn((_data: string, callback?: (err?: Error) => void) =>
+          callback?.(),
+        ),
+      };
+    }
+
+    it('should send a shutdown notice to every open client', async () => {
+      const openClient = createClient(1 /* OPEN */);
+      const closingClient = createClient(2 /* CLOSING */);
+      const server = { clients: new Set([openClient, closingClient]) } as any;
+
+      await adapter.notifyShutdown(server);
+
+      expect(openClient.send).toHaveBeenCalledTimes(1);
+      expect(closingClient.send).not.toHaveBeenCalled();
+
+      const [payload] = openClient.send.mock.calls[0];
+      const parsed = JSON.parse(payload as string);
+      expect(parsed.event).toEqual('shutdown');
+      expect(parsed.data).toEqual({ message: expect.any(String) });
+    });
+
+    it('should resolve without sending anything when the server has no clients set', async () => {
+      const server = {} as any;
+
+      await expect(adapter.notifyShutdown(server)).resolves.toBeUndefined();
+    });
+
+    it('should resolve without sending anything when there are no open clients', async () => {
+      const server = { clients: new Set() } as any;
+
+      await expect(adapter.notifyShutdown(server)).resolves.toBeUndefined();
+    });
+  });
+});
