+import { INestApplication } from '@nestjs/common';
+import { WsAdapter } from '@nestjs/platform-ws';
+import { Test } from '@nestjs/testing';
+import { io } from 'socket.io-client';
+import WebSocket from 'ws';
+import { ApplicationGateway } from '../src/app.gateway.js';
+import { WsPathGateway } from '../src/ws-path.gateway.js';
+
+describe('Graceful shutdown (WebSockets)', () => {
+  let app: INestApplication;
+
+  afterEach(async () => {
+    if (app) {
+      await app.close();
+    }
+  });
+
+  it('notifies connected socket.io clients before closing them', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [ApplicationGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    await app.listen(3000);
+
+    const client = io('http://localhost:8080');
+    await new Promise<void>(resolve => client.on('connect', resolve));
+
+    const shutdownEvent = new Promise<string>(resolve =>
+      client.on('shutdown', resolve),
+    );
+    const disconnectEvent = new Promise<void>(resolve =>
+      client.on('disconnect', () => resolve()),
+    );
+
+    const closePromise = app.close();
+
+    const message = await shutdownEvent;
+    expect(message).toBeTruthy();
+    await disconnectEvent;
+    await closePromise;
+
+    client.close();
+  });
+
+  it('does not affect shutdown when no socket.io clients are connected', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [ApplicationGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    await app.listen(3000);
+
+    await expect(app.close()).resolves.toBeUndefined();
+  });
+
+  it('notifies connected ws clients before closing them', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [WsPathGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    app.useWebSocketAdapter(new WsAdapter(app) as any);
+    await app.listen(3000);
+
+    const client = new WebSocket('ws://localhost:3000/ws-path');
+    await new Promise((resolve, reject) => {
+      client.on('open', resolve);
+      client.on('error', reject);
+    });
+
+    const shutdownMessage = new Promise<any>(resolve =>
+      client.on('message', data => resolve(JSON.parse(data.toString()))),
+    );
+    const closeEvent = new Promise<void>(resolve =>
+      client.on('close', () => resolve()),
+    );
+
+    const closePromise = app.close();
+
+    const parsed = await shutdownMessage;
+    expect(parsed.event).toEqual('shutdown');
+    expect(parsed.data).toBeTruthy();
+    await closeEvent;
+    await closePromise;
+  });
+
+  it('does not affect shutdown when no ws clients are connected', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [WsPathGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    app.useWebSocketAdapter(new WsAdapter(app) as any);
+    await app.listen(3000);
+
+    await expect(app.close()).resolves.toBeUndefined();
+  });
+});
