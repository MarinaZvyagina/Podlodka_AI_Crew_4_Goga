+  public async notifyShutdown(server: Server | Namespace): Promise<void> {
+    if (!server) {
+      return;
+    }
+    // `Server#close()` discards each client's engine.io transport without
+    // waiting for queued writes to flush, so the event emitted below would
+    // otherwise never reach clients still in the middle of a handshake or
+    // long-poll cycle. Emit per-socket and wait for its write buffer to
+    // drain (mirroring engine.io's own graceful `Socket#close(false)`)
+    // before returning, bounded so a stalled client can't delay shutdown.
+    const namespace: any =
+      (server as any).sockets instanceof Map ? server : (server as any).sockets;
+    const sockets: Map<string, Socket> = namespace?.sockets ?? new Map();
+
+    await Promise.race([
+      Promise.all(
+        Array.from(sockets.values()).map(socket => {
+          socket.emit(SHUTDOWN_EVENT, SHUTDOWN_MESSAGE);
+          const conn: any = (socket as any).conn;
+          if (!conn?.writeBuffer?.length) {
+            return undefined;
+          }
+          return new Promise<void>(resolve => conn.once('drain', resolve));
+        }),
+      ),
+      new Promise<void>(resolve =>
+        setTimeout(resolve, NOTIFY_SHUTDOWN_TIMEOUT_MS),
+      ),
+    ]);
+  }
