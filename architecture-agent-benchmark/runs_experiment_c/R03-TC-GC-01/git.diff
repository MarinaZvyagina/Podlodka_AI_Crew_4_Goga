diff --git a/packages/core/maintenance/maintenance-mode.guard.ts b/packages/core/maintenance/maintenance-mode.guard.ts
new file mode 100644
index 0000000..c1f8531
--- /dev/null
+++ b/packages/core/maintenance/maintenance-mode.guard.ts
@@ -0,0 +1,36 @@
+import type { CanActivate, ExecutionContext } from '@nestjs/common';
+import { Injectable } from '@nestjs/common';
+import { MAINTENANCE_MODE_METADATA } from '@nestjs/common/internal';
+import { Reflector } from '../services/reflector.service.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Denies activation of any handler marked with `@MaintenanceMode()`
+ * (at the controller/gateway level or the individual handler level) while
+ * maintenance mode is switched on. Transport-agnostic: works the same way
+ * for HTTP route handlers and WebSocket message handlers, since both are
+ * dispatched through Nest's guard pipeline.
+ *
+ * Register it globally (e.g. via `APP_GUARD` or `app.useGlobalGuards()`) so
+ * it evaluates every request and message once, application-wide.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  public canActivate(context: ExecutionContext): boolean {
+    const isAffected = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_MODE_METADATA,
+      [context.getHandler(), context.getClass()],
+    );
+    if (!isAffected) {
+      return true;
+    }
+    return !this.maintenanceModeService.isEnabled();
+  }
+}
diff --git a/packages/core/maintenance/maintenance-mode.service.ts b/packages/core/maintenance/maintenance-mode.service.ts
new file mode 100644
index 0000000..242e58e
--- /dev/null
+++ b/packages/core/maintenance/maintenance-mode.service.ts
@@ -0,0 +1,37 @@
+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the application-wide maintenance mode toggle. Switching it on or
+ * off takes effect immediately for every currently running instance, with
+ * no redeploy required.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  /**
+   * Switches maintenance mode on. From this point on, calls to any handler
+   * marked with `@MaintenanceMode()` are rejected until `disable()` is
+   * called.
+   */
+  public enable(): void {
+    this.enabled = true;
+  }
+
+  /**
+   * Switches maintenance mode off. Handlers marked with `@MaintenanceMode()`
+   * resume working normally.
+   */
+  public disable(): void {
+    this.enabled = false;
+  }
+
+  /**
+   * @returns whether maintenance mode is currently switched on.
+   */
+  public isEnabled(): boolean {
+    return this.enabled;
+  }
+}
diff --git a/packages/core/test/maintenance/maintenance-mode.guard.spec.ts b/packages/core/test/maintenance/maintenance-mode.guard.spec.ts
new file mode 100644
index 0000000..a429cde
--- /dev/null
+++ b/packages/core/test/maintenance/maintenance-mode.guard.spec.ts
@@ -0,0 +1,93 @@
+import { MaintenanceMode } from '@nestjs/common';
+import { ExecutionContextHost } from '../../helpers/execution-context-host.js';
+import { MaintenanceModeGuard } from '../../maintenance/maintenance-mode.guard.js';
+import { MaintenanceModeService } from '../../maintenance/maintenance-mode.service.js';
+import { Reflector } from '../../services/reflector.service.js';
+
+describe('MaintenanceModeGuard', () => {
+  class UnmarkedController {
+    public handler() {}
+  }
+
+  class MethodMarkedController {
+    @MaintenanceMode()
+    public affectedHandler() {}
+
+    public unaffectedHandler() {}
+  }
+
+  @MaintenanceMode()
+  class ClassMarkedController {
+    public handler() {}
+  }
+
+  let guard: MaintenanceModeGuard;
+  let maintenanceModeService: MaintenanceModeService;
+
+  const contextFor = (instance: object, handler: Function) =>
+    new ExecutionContextHost([], instance.constructor as any, handler);
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(new Reflector(), maintenanceModeService);
+  });
+
+  describe('when the handler is not marked', () => {
+    it('should allow the call regardless of maintenance mode state', () => {
+      const context = contextFor(
+        new UnmarkedController(),
+        UnmarkedController.prototype.handler,
+      );
+
+      expect(guard.canActivate(context)).toBe(true);
+
+      maintenanceModeService.enable();
+      expect(guard.canActivate(context)).toBe(true);
+    });
+  });
+
+  describe('when a specific handler is marked', () => {
+    it('should block only that handler while maintenance mode is on', () => {
+      const affectedContext = contextFor(
+        new MethodMarkedController(),
+        MethodMarkedController.prototype.affectedHandler,
+      );
+      const unaffectedContext = contextFor(
+        new MethodMarkedController(),
+        MethodMarkedController.prototype.unaffectedHandler,
+      );
+
+      maintenanceModeService.enable();
+
+      expect(guard.canActivate(affectedContext)).toBe(false);
+      expect(guard.canActivate(unaffectedContext)).toBe(true);
+    });
+
+    it('should allow the marked handler again once maintenance mode is off', () => {
+      const affectedContext = contextFor(
+        new MethodMarkedController(),
+        MethodMarkedController.prototype.affectedHandler,
+      );
+
+      maintenanceModeService.enable();
+      expect(guard.canActivate(affectedContext)).toBe(false);
+
+      maintenanceModeService.disable();
+      expect(guard.canActivate(affectedContext)).toBe(true);
+    });
+  });
+
+  describe('when the whole controller is marked', () => {
+    it('should block every handler on it while maintenance mode is on', () => {
+      const context = contextFor(
+        new ClassMarkedController(),
+        ClassMarkedController.prototype.handler,
+      );
+
+      expect(guard.canActivate(context)).toBe(true);
+
+      maintenanceModeService.enable();
+      expect(guard.canActivate(context)).toBe(false);
+    });
+  });
+});
