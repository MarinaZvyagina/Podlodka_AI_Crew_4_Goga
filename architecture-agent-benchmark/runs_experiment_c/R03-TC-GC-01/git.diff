index 0000000..c6e13e2
--- /dev/null
+++ b/packages/common/decorators/core/maintenance-mode.decorator.ts
@@ -0,0 +1,20 @@
+import { MAINTENANCE_MODE_METADATA } from '../../constants.js';
+import { CustomDecorator, SetMetadata } from './set-metadata.decorator.js';
+
+/**
+ * Decorator that marks a controller or an individual handler (HTTP route
+ * handler or WebSocket message handler) as affected by maintenance mode.
+ *
+ * When maintenance mode is switched on (see `MaintenanceModeService`), calls
+ * to a marked handler are rejected before any of its logic runs. Unmarked
+ * handlers keep working normally regardless of maintenance mode state.
+ *
+ * When applied to a controller or gateway class, every handler defined on
+ * it is affected.
+ *
+ * @see [Guards](https://docs.nestjs.com/guards)
+ *
+ * @publicApi
+ */
+export const MaintenanceMode = (): CustomDecorator<string> =>
+  SetMetadata(MAINTENANCE_MODE_METADATA, true);
