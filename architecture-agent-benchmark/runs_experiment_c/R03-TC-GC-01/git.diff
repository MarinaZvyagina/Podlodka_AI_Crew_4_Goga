+import { MAINTENANCE_MODE_METADATA } from '../../constants.js';
+import { MaintenanceMode } from '../../decorators/core/maintenance-mode.decorator.js';
+
+describe('@MaintenanceMode', () => {
+  @MaintenanceMode()
+  class TestController {}
+
+  class TestControllerWithMethod {
+    @MaintenanceMode()
+    public affected() {}
+
+    public unaffected() {}
+  }
+
+  it('should mark the class with maintenance mode metadata', () => {
+    expect(Reflect.getMetadata(MAINTENANCE_MODE_METADATA, TestController)).toBe(
+      true,
+    );
+  });
+
+  it('should mark the decorated method with maintenance mode metadata', () => {
+    expect(
+      Reflect.getMetadata(
+        MAINTENANCE_MODE_METADATA,
+        TestControllerWithMethod.prototype.affected,
+      ),
+    ).toBe(true);
+  });
+
+  it('should leave undecorated methods unaffected', () => {
+    expect(
+      Reflect.getMetadata(
+        MAINTENANCE_MODE_METADATA,
+        TestControllerWithMethod.prototype.unaffected,
+      ),
+    ).toBeUndefined();
+  });
+});
