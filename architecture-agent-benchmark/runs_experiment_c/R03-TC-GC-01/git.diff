diff --git a/packages/core/maintenance/CODEMANIFEST b/packages/core/maintenance/CODEMANIFEST
new file mode 100644
index 0000000..5674474
--- /dev/null
+++ b/packages/core/maintenance/CODEMANIFEST
@@ -0,0 +1,58 @@
+Imports:
+  - Types:
+      - Reflector
+    From: packages/core/services
+
+Annotations: |
+  Implements the maintenance-mode extension point: an application-wide
+  runtime toggle plus a CanActivate guard that denies activation of any
+  handler marked with @MaintenanceMode() while the toggle is on. Reuses
+  Nest's existing guard pipeline, so registering the guard globally covers
+  both HTTP route handlers and WebSocket message handlers with the same
+  mechanism, without core/router or websockets needing any changes.
+
+---
+
+"MaintenanceModeService()":
+  location: maintenance-mode.service.ts
+  annotations: |
+    In-memory, application-wide flag recording whether maintenance mode is
+    currently on. Meant to be toggled at runtime (e.g. from an internal
+    admin action) rather than via redeploy.
+  methods:
+    "enable() -> void": |
+      Switches maintenance mode on. Every subsequently evaluated handler
+      marked with @MaintenanceMode() is rejected until disable() is called.
+    "disable() -> void": |
+      Switches maintenance mode off. Marked handlers resume working
+      normally.
+    "isEnabled() -> enabled: boolean": |
+      Current state of the toggle.
+
+"MaintenanceModeGuard(reflector: Reflector, maintenanceModeService: MaintenanceModeService)":
+  location: maintenance-mode.guard.ts
+  annotations: |
+    CanActivate implementation meant to be registered globally (e.g. via
+    APP_GUARD or app.useGlobalGuards()). `reflector` is used to read the
+    MAINTENANCE_MODE_METADATA flag set by @MaintenanceMode(); `maintenanceModeService`
+    supplies the read from Imports.
+  methods:
+    "canActivate(context: any) -> allowed: boolean": |
+      Reads the maintenance-mode flag from the handler first, falling back
+      to its declaring class/gateway (method-level takes precedence over
+      class-level). Unmarked handlers are always allowed. Marked handlers
+      are allowed exactly when maintenanceModeService.isEnabled() is false.
+      Denial surfaces through the same per-transport exception the guard
+      pipeline already throws on a false result (ForbiddenException for
+      HTTP, WsException for WS).
+
+---
+
+Author: Goga
+CreatedAt: 26/09/17
+Description: |
+  Runtime maintenance-mode toggle (MaintenanceModeService) and guard
+  (MaintenanceModeGuard) that together let @MaintenanceMode()-marked
+  controllers, HTTP handlers, WebSocket gateways, and WebSocket message
+  handlers be turned away immediately while maintenance mode is on, using
+  the same mechanism for both transports.
