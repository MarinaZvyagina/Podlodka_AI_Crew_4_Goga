@@ -0,0 +1,11 @@
+import { SetMetadata } from '@nestjs/common';
+
+export const MAINTENANCE_KEY = 'affectedByMaintenance';
+
+/**
+ * Marks a route handler, a `@SubscribeMessage` handler, or an entire
+ * controller/gateway class as affected by maintenance mode. While
+ * maintenance mode is switched on, calls to marked targets are rejected
+ * by `MaintenanceGuard` before any handler logic runs.
+ */
+export const Maintenance = () => SetMetadata(MAINTENANCE_KEY, true);
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts
new file mode 100644
index 0000000..e46aef1
