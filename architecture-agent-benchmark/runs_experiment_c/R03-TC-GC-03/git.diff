+import { Controller, Get } from '@nestjs/common';
+import { Maintenance } from '../maintenance/maintenance.decorator.js';
+
+// The whole controller depends on the migration, so it's marked at the
+// class level rather than repeating `@Maintenance()` on every handler.
+@Maintenance()
+@Controller('reports')
+export class ReportsController {
+  @Get('monthly')
+  monthly() {
+    return { report: 'monthly-totals' };
+  }
+
+  @Get('annual')
+  annual() {
+    return { report: 'annual-totals' };
+  }
+}
