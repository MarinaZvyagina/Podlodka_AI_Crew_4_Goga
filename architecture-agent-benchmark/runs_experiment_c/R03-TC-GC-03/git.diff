+import { MessageBody, SubscribeMessage, WebSocketGateway } from '@nestjs/websockets';
+import { Maintenance } from '../maintenance/maintenance.decorator.js';
+
+@WebSocketGateway({ cors: { origin: '*' } })
+export class EventsGateway {
+  @SubscribeMessage('ping')
+  ping() {
+    return { event: 'pong', data: {} };
+  }
+
+  // Reads data touched by the migration — blocked during maintenance
+  // mode, same as the HTTP handlers above.
+  @Maintenance()
+  @SubscribeMessage('account-balance')
+  accountBalance(@MessageBody() data: { accountId: number }) {
+    return { event: 'account-balance', data: { accountId: data.accountId, balance: 100 } };
+  }
+}
