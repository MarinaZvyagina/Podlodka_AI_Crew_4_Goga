@@ -0,0 +1,23 @@
+import { Injectable } from '@nestjs/common';
+
+/**
+ * Single source of truth for whether the application is currently in
+ * maintenance mode. Toggled at runtime (e.g. from an admin endpoint) —
+ * no redeploy required.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  enable(): void {
+    this.enabled = true;
+  }
+
+  disable(): void {
+    this.enabled = false;
+  }
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+}
