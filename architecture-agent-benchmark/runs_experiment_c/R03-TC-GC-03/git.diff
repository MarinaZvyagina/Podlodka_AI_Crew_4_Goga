+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts
@@ -0,0 +1,96 @@
+import { ExecutionContext, ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { Maintenance } from './maintenance.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+import { MaintenanceGuard } from './maintenance.guard.js';
+
+class DummyHttpController {
+  normalHandler() {}
+
+  @Maintenance()
+  affectedHandler() {}
+}
+
+@Maintenance()
+class DummyFullyMarkedController {
+  anyHandler() {}
+}
+
+class DummyGateway {
+  @Maintenance()
+  affectedMessageHandler() {}
+}
+
+function createContext(
+  handler: Function,
+  clazz: Function,
+  type: 'http' | 'ws' = 'http',
+): ExecutionContext {
+  return {
+    getHandler: () => handler,
+    getClass: () => clazz,
+    getType: () => type,
+  } as unknown as ExecutionContext;
+}
+
+describe('MaintenanceGuard', () => {
+  let maintenanceModeService: MaintenanceModeService;
+  let guard: MaintenanceGuard;
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceGuard(new Reflector(), maintenanceModeService);
+  });
+
+  it('allows unmarked handlers through, regardless of maintenance mode', () => {
+    maintenanceModeService.enable();
+    const context = createContext(DummyHttpController.prototype.normalHandler, DummyHttpController);
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('allows a marked handler through while maintenance mode is off', () => {
+    const context = createContext(
+      DummyHttpController.prototype.affectedHandler,
+      DummyHttpController,
+    );
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('rejects a method-marked HTTP handler while maintenance mode is on', () => {
+    maintenanceModeService.enable();
+    const context = createContext(
+      DummyHttpController.prototype.affectedHandler,
+      DummyHttpController,
+    );
+    expect(() => guard.canActivate(context)).toThrow(ServiceUnavailableException);
+  });
+
+  it('rejects any handler of a class-marked controller while maintenance mode is on', () => {
+    maintenanceModeService.enable();
+    const context = createContext(
+      DummyFullyMarkedController.prototype.anyHandler,
+      DummyFullyMarkedController,
+    );
+    expect(() => guard.canActivate(context)).toThrow(ServiceUnavailableException);
+  });
+
+  it('rejects a marked WS message handler with a WsException, not an HTTP exception', () => {
+    maintenanceModeService.enable();
+    const context = createContext(DummyGateway.prototype.affectedMessageHandler, DummyGateway, 'ws');
+    expect(() => guard.canActivate(context)).toThrow(WsException);
+  });
+
+  it('leaves unrelated WS handlers unaffected', () => {
+    maintenanceModeService.enable();
+    class OtherGateway {
+      normalMessageHandler() {}
+    }
+    const context = createContext(
+      OtherGateway.prototype.normalMessageHandler,
+      OtherGateway,
+      'ws',
+    );
+    expect(guard.canActivate(context)).toBe(true);
+  });
+});
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
new file mode 100644
index 0000000..b3e861e
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
@@ -0,0 +1,46 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MAINTENANCE_KEY } from './maintenance.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Rejects calls to any handler (HTTP route or WS message handler) marked
+ * with `@Maintenance()` while maintenance mode is on, before the handler
+ * body runs. Unmarked handlers, and marked handlers while maintenance
+ * mode is off, are let through unchanged.
+ *
+ * Register this guard globally (e.g. via `APP_GUARD`) so developers only
+ * need to add `@Maintenance()` where it matters, rather than wiring
+ * `@UseGuards` on every affected handler.
+ */
+@Injectable()
+export class MaintenanceGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isAffected = this.reflector.getAllAndOverride<boolean>(MAINTENANCE_KEY, [
+      context.getHandler(),
+      context.getClass(),
+    ]);
+
+    if (!isAffected || !this.maintenanceModeService.isEnabled()) {
+      return true;
+    }
+
+    if (context.getType() === 'ws') {
+      throw new WsException('This operation is temporarily unavailable for maintenance.');
+    }
+    throw new ServiceUnavailableException(
+      'This endpoint is temporarily unavailable for maintenance.',
+    );
+  }
+}
