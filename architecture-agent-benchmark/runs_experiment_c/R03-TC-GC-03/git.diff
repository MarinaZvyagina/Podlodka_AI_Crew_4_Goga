+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../../src/app/app.module.js';
+
+describe('E2E Maintenance Mode Sample', () => {
+  let app: INestApplication;
+
+  beforeAll(async () => {
+    const modRef = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = modRef.createNestApplication();
+    await app.init();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('lets unmarked and marked endpoints through while maintenance mode is off', async () => {
+    await request(app.getHttpServer()).get('/health').expect(200);
+    await request(app.getHttpServer()).get('/accounts').expect(200);
+    await request(app.getHttpServer()).get('/reports/monthly').expect(200);
+  });
+
+  it('blocks only marked endpoints once maintenance mode is switched on', async () => {
+    await request(app.getHttpServer()).post('/maintenance/enable').expect(201);
+
+    await request(app.getHttpServer()).get('/health').expect(200);
+    await request(app.getHttpServer()).get('/accounts').expect(503);
+    await request(app.getHttpServer()).get('/reports/monthly').expect(503);
+    await request(app.getHttpServer()).get('/reports/annual').expect(503);
+
+    await request(app.getHttpServer()).post('/maintenance/disable').expect(201);
+    await request(app.getHttpServer()).get('/accounts').expect(200);
+  });
+});
