+import { Controller, Get, Post } from '@nestjs/common';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Intentionally NOT decorated with `@Maintenance()` — the toggle itself
+ * must stay reachable while maintenance mode is on, otherwise there
+ * would be no way to switch it back off.
+ */
+@Controller('maintenance')
+export class MaintenanceAdminController {
+  constructor(private readonly maintenanceModeService: MaintenanceModeService) {}
+
+  @Get('status')
+  status() {
+    return { enabled: this.maintenanceModeService.isEnabled() };
+  }
+
+  @Post('enable')
+  enable() {
+    this.maintenanceModeService.enable();
+    return { enabled: true };
+  }
+
+  @Post('disable')
+  disable() {
+    this.maintenanceModeService.disable();
+    return { enabled: false };
+  }
+}
