+import { Module } from '@nestjs/common';
+import { MaintenanceController } from './maintenance.controller.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Exports `MaintenanceModeService` so any feature module can import this one
+ * and apply `MaintenanceModeGuard` locally via `@UseGuards()`. Nest's global
+ * `APP_GUARD` mechanism only reaches HTTP routes here, not WS gateways, so
+ * explicit `@UseGuards()` on both controllers and gateways is what keeps the
+ * enforcement identical across transports.
+ */
+@Module({
+  controllers: [MaintenanceController],
+  providers: [MaintenanceModeService],
+  exports: [MaintenanceModeService],
+})
+export class MaintenanceModule {}
