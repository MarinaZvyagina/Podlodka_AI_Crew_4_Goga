+import { UseGuards } from '@nestjs/common';
+import { SubscribeMessage, WebSocketGateway } from '@nestjs/websockets';
+import { Maintainable } from '../maintenance/maintainable.decorator.js';
+import { MaintenanceModeGuard } from '../maintenance/maintenance-mode.guard.js';
+
+@UseGuards(MaintenanceModeGuard)
+@WebSocketGateway({ cors: { origin: '*' } })
+export class EventsGateway {
+  @SubscribeMessage('ping')
+  onPing() {
+    // Unaffected: keeps responding normally during maintenance.
+    return 'pong';
+  }
+
+  @SubscribeMessage('reindex')
+  @Maintainable()
+  onReindex() {
+    // Touches the same data the migration is rewriting; rejected during
+    // maintenance mode, exactly like the marked HTTP handlers.
+    return 'reindexed';
+  }
+}
