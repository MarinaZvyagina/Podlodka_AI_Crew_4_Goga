+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the application's maintenance mode flag in memory so it can be
+ * flipped by an admin action at runtime, with no redeploy required.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  enable(): void {
+    this.enabled = true;
+  }
+
+  disable(): void {
+    this.enabled = false;
+  }
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+}
