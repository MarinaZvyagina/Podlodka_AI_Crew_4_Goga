+import { Maintainable } from '../maintenance/maintainable.decorator.js';
+import { MaintenanceModeGuard } from '../maintenance/maintenance-mode.guard.js';
+
+/**
+ * The whole reporting subsystem reads from tables the migration rewrites, so
+ * every handler here is rejected while maintenance mode is on.
+ */
+@Maintainable()
+@UseGuards(MaintenanceModeGuard)
+@Controller('reports')
+export class ReportsController {
+  @Get('daily')
+  daily() {
+    return { report: 'daily' };
+  }
+
+  @Get('monthly')
