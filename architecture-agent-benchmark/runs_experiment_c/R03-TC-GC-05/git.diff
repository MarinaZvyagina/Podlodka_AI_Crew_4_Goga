+import { Test } from '@nestjs/testing';
+import { MaintenanceController } from './maintenance.controller.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+describe('MaintenanceController', () => {
+  let controller: MaintenanceController;
+  let service: MaintenanceModeService;
+
+  beforeEach(async () => {
+    const moduleRef = await Test.createTestingModule({
+      controllers: [MaintenanceController],
+      providers: [MaintenanceModeService],
+    }).compile();
+
+    controller = moduleRef.get(MaintenanceController);
+    service = moduleRef.get(MaintenanceModeService);
+  });
+
+  it('reports the current state via status()', () => {
+    expect(controller.status()).toEqual({ enabled: false });
+  });
+
+  it('turns maintenance mode on via enable()', () => {
+    controller.enable();
+    expect(service.isEnabled()).toBe(true);
+  });
+
+  it('turns maintenance mode off via disable()', () => {
+    service.enable();
+    controller.disable();
+    expect(service.isEnabled()).toBe(false);
+  });
+});
