+import { Controller, Get, UseGuards } from '@nestjs/common';
+import { Maintainable } from '../maintenance/maintainable.decorator.js';
+import { MaintenanceModeGuard } from '../maintenance/maintenance-mode.guard.js';
+
+@UseGuards(MaintenanceModeGuard)
+@Controller('cats')
+export class CatsController {
+  @Get()
+  findAll() {
+    // Unaffected: keeps working normally regardless of maintenance mode.
+    return [{ name: 'Pixel' }];
+  }
+
+  @Get('migrate')
+  @Maintainable()
+  migrate() {
+    // Depends on the data migration; rejected while maintenance mode is on.
+    return { migrated: true };
+  }
+}
