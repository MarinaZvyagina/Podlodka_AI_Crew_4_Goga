@@ -0,0 +1,11 @@
+import { Reflector } from '@nestjs/core';
+
+/**
+ * Marks a route handler, a whole controller, a WS message handler, or a whole
+ * gateway as affected by maintenance mode. `MaintenanceModeGuard` checks this
+ * metadata on both the handler and its class (method-level wins), so the same
+ * decorator covers "one endpoint" and "the entire controller/gateway" cases.
+ */
+export const Maintainable = Reflector.createDecorator<void, boolean>({
+  transform: () => true,
+});
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.spec.ts b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.spec.ts
new file mode 100644
index 0000000..9b016fc
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.spec.ts
@@ -0,0 +1,124 @@
+import type { ExecutionContext } from '@nestjs/common';
+import { ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { Maintainable } from './maintainable.decorator.js';
+import { MaintenanceModeGuard } from './maintenance-mode.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+class HttpCatsController {
+  findAll() {}
+
+  @Maintainable()
+  migrate() {}
+}
+
+@Maintainable()
+class HttpReportsController {
+  daily() {}
+}
+
+class WsEventsGateway {
+  onPing() {}
+
+  @Maintainable()
+  onReindex() {}
+}
+
+function fakeContext(
+  handler: (...args: unknown[]) => unknown,
+  klass: Function,
+  type: 'http' | 'ws' = 'http',
+): ExecutionContext {
+  return {
+    getHandler: () => handler,
+    getClass: () => klass,
+    getType: () => type,
+  } as unknown as ExecutionContext;
+}
+
+describe('MaintenanceModeGuard', () => {
+  let guard: MaintenanceModeGuard;
+  let maintenanceMode: MaintenanceModeService;
+
+  beforeEach(() => {
+    maintenanceMode = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(new Reflector(), maintenanceMode);
+  });
+
+  it('allows a marked handler while maintenance mode is off', () => {
+    const context = fakeContext(
+      HttpCatsController.prototype.migrate,
+      HttpCatsController,
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks a marked handler once maintenance mode is switched on', () => {
+    maintenanceMode.enable();
+    const context = fakeContext(
+      HttpCatsController.prototype.migrate,
+      HttpCatsController,
+    );
+
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('leaves an unmarked handler on the same controller unaffected', () => {
+    maintenanceMode.enable();
+    const context = fakeContext(
+      HttpCatsController.prototype.findAll,
+      HttpCatsController,
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('re-allows a marked handler once maintenance mode is switched back off', () => {
+    maintenanceMode.enable();
+    maintenanceMode.disable();
+    const context = fakeContext(
+      HttpCatsController.prototype.migrate,
+      HttpCatsController,
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks every handler on a controller marked at the class level', () => {
+    maintenanceMode.enable();
+    const context = fakeContext(
+      HttpReportsController.prototype.daily,
+      HttpReportsController,
+    );
+
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('blocks a marked WS message handler the same way as an HTTP one', () => {
+    maintenanceMode.enable();
+    const context = fakeContext(
+      WsEventsGateway.prototype.onReindex,
+      WsEventsGateway,
+      'ws',
+    );
+
+    expect(() => guard.canActivate(context)).toThrow(WsException);
+  });
+
+  it('leaves an unmarked WS message handler unaffected', () => {
+    maintenanceMode.enable();
+    const context = fakeContext(
+      WsEventsGateway.prototype.onPing,
+      WsEventsGateway,
+      'ws',
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+});
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.ts b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.ts
new file mode 100644
index 0000000..a9991a2
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.ts
@@ -0,0 +1,45 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { Maintainable } from './maintainable.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+const MAINTENANCE_MESSAGE = 'This endpoint is temporarily unavailable for maintenance.';
+
+/**
+ * Blocks calls to whatever `@Maintainable()` marks, but only while
+ * `MaintenanceModeService` reports maintenance mode as on. Everything
+ * unmarked passes through unchanged, in either state.
+ *
+ * `ExecutionContext` abstracts over transports, so the exact same guard
+ * gates HTTP route handlers and WS message handlers alike; only the shape
+ * of the rejection (HTTP exception vs. WS exception) is transport-specific.
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceMode: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isAffected = this.reflector.getAllAndOverride(Maintainable, [
+      context.getHandler(),
+      context.getClass(),
+    ]);
+
+    if (!isAffected || !this.maintenanceMode.isEnabled()) {
+      return true;
+    }
+
+    if (context.getType() === 'ws') {
+      throw new WsException(MAINTENANCE_MESSAGE);
+    }
+    throw new ServiceUnavailableException(MAINTENANCE_MESSAGE);
+  }
+}
