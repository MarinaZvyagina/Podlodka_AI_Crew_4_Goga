+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the application-wide maintenance mode flag. Toggle it at runtime
+ * (e.g. from an admin endpoint) instead of redeploying with a different
+ * config value.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  enable(): void {
+    this.enabled = true;
+  }
+
+  disable(): void {
+    this.enabled = false;
+  }
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+}
