+import { Controller, Get, UseGuards } from '@nestjs/common';
+import { Maintenance } from '../maintenance/maintenance.decorator.js';
+import { MaintenanceGuard } from '../maintenance/maintenance.guard.js';
+
+@Controller('cats')
+@UseGuards(MaintenanceGuard)
+export class CatsController {
+  // Unaffected: keeps serving normally regardless of maintenance mode.
+  @Get()
+  findAll(): string[] {
+    return ['Tom', 'Garfield', 'Felix'];
+  }
+
+  // Affected: depends on the data migration, so it's rejected while
+  // maintenance mode is on.
+  @Get('reindex')
+  @Maintenance()
+  reindex(): { status: string } {
+    return { status: 'reindex started' };
+  }
+}
