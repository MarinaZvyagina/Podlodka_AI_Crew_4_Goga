+import { Controller, Get, Post } from '@nestjs/common';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Stand-in for whatever internal admin action should flip maintenance mode
+ * on and off (a protected HTTP endpoint here, but it could just as well be a
+ * CLI command or a REPL call against `MaintenanceModeService`).
+ */
+@Controller('maintenance')
+export class MaintenanceController {
+  constructor(
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  @Get()
+  status(): { enabled: boolean } {
+    return { enabled: this.maintenanceModeService.isEnabled() };
+  }
+
+  @Post('enable')
+  enable(): { enabled: boolean } {
+    this.maintenanceModeService.enable();
+    return { enabled: true };
+  }
+
+  @Post('disable')
+  disable(): { enabled: boolean } {
+    this.maintenanceModeService.disable();
+    return { enabled: false };
+  }
+}
