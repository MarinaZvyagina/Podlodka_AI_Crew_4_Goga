+import { UseGuards } from '@nestjs/common';
+import { MessageBody, SubscribeMessage, WebSocketGateway } from '@nestjs/websockets';
+import { Maintenance } from '../maintenance/maintenance.decorator.js';
+import { MaintenanceGuard } from '../maintenance/maintenance.guard.js';
+
+@WebSocketGateway()
+@UseGuards(MaintenanceGuard)
+export class ChatGateway {
+  // Unaffected: keeps responding normally regardless of maintenance mode.
+  @SubscribeMessage('ping')
+  ping(): string {
+    return 'pong';
+  }
+
+  // Affected: depends on the same migration as the HTTP reindex endpoint,
+  // so it's rejected the same way while maintenance mode is on.
+  @SubscribeMessage('migrateData')
+  @Maintenance()
+  migrateData(@MessageBody() data: unknown): { status: string } {
+    return { status: 'migration started' };
+  }
+}
