@@ -0,0 +1,12 @@
+import { SetMetadata } from '@nestjs/common';
+
+export const MAINTENANCE_MODE_KEY = 'affectedByMaintenance';
+
+/**
+ * Marks a handler, or every handler on a controller/gateway, as affected by
+ * maintenance mode. While maintenance mode is enabled, `MaintenanceGuard`
+ * rejects calls to anything carrying this marker before its logic runs.
+ * Works identically on HTTP route handlers and WebSocket `@SubscribeMessage`
+ * handlers, since both go through the same guard pipeline.
+ */
+export const Maintenance = () => SetMetadata(MAINTENANCE_MODE_KEY, true);
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts
new file mode 100644
index 0000000..55c20ed
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts
@@ -0,0 +1,101 @@
+import { ExecutionContext } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { CatsController } from '../cats/cats.controller.js';
+import { ChatGateway } from '../chat/chat.gateway.js';
+import { Maintenance } from './maintenance.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+import { MaintenanceGuard } from './maintenance.guard.js';
+
+/**
+ * A minimal stand-in for a real ExecutionContext: the guard only ever reads
+ * `getHandler()`/`getClass()`/`getType()`, so nothing else needs to be
+ * faked, and no HTTP server or socket connection is involved.
+ */
+function createContext(
+  instance: object,
+  handlerName: string,
+  type: 'http' | 'ws' = 'http',
+): ExecutionContext {
+  return {
+    getHandler: () => (instance as Record<string, any>)[handlerName],
+    getClass: () => instance.constructor,
+    getType: () => type,
+  } as unknown as ExecutionContext;
+}
+
+@Maintenance()
+class MigrationOnlyController {
+  anyHandler() {}
+  otherHandler() {}
+}
+
+describe('MaintenanceGuard', () => {
+  let guard: MaintenanceGuard;
+  let maintenanceModeService: MaintenanceModeService;
+  let cats: CatsController;
+  let chat: ChatGateway;
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceGuard(new Reflector(), maintenanceModeService);
+    cats = new CatsController();
+    chat = new ChatGateway();
+  });
+
+  describe('while maintenance mode is off', () => {
+    it('allows marked and unmarked HTTP handlers alike', () => {
+      expect(guard.canActivate(createContext(cats, 'findAll'))).toBe(true);
+      expect(guard.canActivate(createContext(cats, 'reindex'))).toBe(true);
+    });
+
+    it('allows marked and unmarked WS handlers alike', () => {
+      expect(guard.canActivate(createContext(chat, 'ping', 'ws'))).toBe(true);
+      expect(
+        guard.canActivate(createContext(chat, 'migrateData', 'ws')),
+      ).toBe(true);
+    });
+  });
+
+  describe('while maintenance mode is on', () => {
+    beforeEach(() => maintenanceModeService.enable());
+
+    it('leaves the unmarked HTTP handler unaffected', () => {
+      expect(guard.canActivate(createContext(cats, 'findAll'))).toBe(true);
+    });
+
+    it('rejects the marked HTTP handler before its logic would run', () => {
+      expect(() => guard.canActivate(createContext(cats, 'reindex'))).toThrow(
+        /maintenance/i,
+      );
+    });
+
+    it('leaves the unmarked WS handler unaffected', () => {
+      expect(guard.canActivate(createContext(chat, 'ping', 'ws'))).toBe(true);
+    });
+
+    it('rejects the marked WS handler with a WsException', () => {
+      expect(() =>
+        guard.canActivate(createContext(chat, 'migrateData', 'ws')),
+      ).toThrow(WsException);
+    });
+
+    it('rejects every handler on a class marked with @Maintenance()', () => {
+      const instance = new MigrationOnlyController();
+      expect(() =>
+        guard.canActivate(createContext(instance, 'anyHandler')),
+      ).toThrow(/maintenance/i);
+      expect(() =>
+        guard.canActivate(createContext(instance, 'otherHandler')),
+      ).toThrow(/maintenance/i);
+    });
+  });
+
+  it('stops blocking a handler again once maintenance mode is disabled', () => {
+    maintenanceModeService.enable();
+    expect(() => guard.canActivate(createContext(cats, 'reindex'))).toThrow();
+
+    maintenanceModeService.disable();
+    expect(guard.canActivate(createContext(cats, 'reindex'))).toBe(true);
+  });
+});
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
new file mode 100644
index 0000000..d4dd23f
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
@@ -0,0 +1,45 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MAINTENANCE_MODE_KEY } from './maintenance.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+const MAINTENANCE_MESSAGE =
+  'This operation is temporarily unavailable for maintenance.';
+
+/**
+ * Rejects calls to handlers marked with `@Maintenance()` while maintenance
+ * mode is enabled, and leaves every other handler untouched. The block
+ * decision itself only depends on reflected handler/class metadata, so it
+ * never needs to know whether it's guarding an HTTP route or a WebSocket
+ * message handler; `context.getType()` is only consulted to shape the
+ * rejection as an HTTP response or a WS exception frame.
+ */
+@Injectable()
+export class MaintenanceGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isAffectedByMaintenance = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_MODE_KEY,
+      [context.getHandler(), context.getClass()],
+    );
+
+    if (!isAffectedByMaintenance || !this.maintenanceModeService.isEnabled()) {
+      return true;
+    }
+
+    if (context.getType() === 'ws') {
+      throw new WsException(MAINTENANCE_MESSAGE);
+    }
+    throw new ServiceUnavailableException(MAINTENANCE_MESSAGE);
+  }
+}
