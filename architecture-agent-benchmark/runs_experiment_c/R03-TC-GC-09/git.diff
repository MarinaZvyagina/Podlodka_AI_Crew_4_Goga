+import { Controller, Get, Post } from '@nestjs/common';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Lets an operator flip maintenance mode on/off at runtime. In a real
+ * deployment these endpoints should be restricted to admins/operators
+ * (e.g. an internal-only guard) - deliberately left unmarked with
+ * `@Maintenance()` so the toggle itself never locks you out.
+ */
+@Controller('maintenance-mode')
+export class MaintenanceModeController {
+  constructor(private readonly maintenanceMode: MaintenanceModeService) {}
+
+  @Get()
+  status() {
+    return { enabled: this.maintenanceMode.isEnabled() };
+  }
+
+  @Post('enable')
+  enable() {
+    this.maintenanceMode.enable();
+    return { enabled: true };
+  }
+
+  @Post('disable')
+  disable() {
+    this.maintenanceMode.disable();
+    return { enabled: false };
+  }
+}
