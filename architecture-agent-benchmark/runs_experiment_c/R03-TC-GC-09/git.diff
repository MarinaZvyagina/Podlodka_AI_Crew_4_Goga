+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the current maintenance-mode flag in memory so it can be toggled at
+ * runtime (e.g. from an admin endpoint) without redeploying the application.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  enable(): void {
+    this.enabled = true;
+  }
+
+  disable(): void {
+    this.enabled = false;
+  }
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+}
