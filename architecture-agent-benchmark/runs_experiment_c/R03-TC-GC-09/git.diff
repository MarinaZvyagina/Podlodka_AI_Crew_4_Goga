@@ -0,0 +1,9 @@
+import { Reflector } from '@nestjs/core';
+
+/**
+ * Marks a route handler, a `@SubscribeMessage` handler, or an entire
+ * controller/gateway class as affected by maintenance mode. Works the same
+ * way for HTTP and WebSocket handlers since both are read by the same
+ * `MaintenanceGuard` through Nest's `ExecutionContext`.
+ */
+export const Maintenance = Reflector.createDecorator<true>();
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts
new file mode 100644
index 0000000..cbe25ce
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts
@@ -0,0 +1,123 @@
+import { ExecutionContext } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { Maintenance } from './maintenance.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+import { MaintenanceGuard } from './maintenance.guard.js';
+
+// Plain classes standing in for a controller/gateway - decorated exactly
+// like real handlers, but with no HTTP server or socket involved.
+class HandlerLevelController {
+  @Maintenance()
+  affected() {}
+
+  unaffected() {}
+}
+
+@Maintenance()
+class ClassLevelController {
+  anyMethod() {}
+}
+
+class HandlerLevelGateway {
+  @Maintenance()
+  affected() {}
+
+  unaffected() {}
+}
+
+function createContext(
+  instance: object,
+  methodName: string,
+  type: 'http' | 'ws' = 'http',
+): ExecutionContext {
+  const klass = instance.constructor;
+  const handler = (instance as any)[methodName];
+
+  return {
+    getHandler: () => handler,
+    getClass: () => klass,
+    getType: () => type,
+  } as unknown as ExecutionContext;
+}
+
+describe('MaintenanceGuard', () => {
+  let maintenanceMode: MaintenanceModeService;
+  let guard: MaintenanceGuard;
+
+  beforeEach(() => {
+    maintenanceMode = new MaintenanceModeService();
+    guard = new MaintenanceGuard(new Reflector(), maintenanceMode);
+  });
+
+  describe('when maintenance mode is off', () => {
+    it('allows a handler marked with @Maintenance()', () => {
+      const context = createContext(new HandlerLevelController(), 'affected');
+      expect(guard.canActivate(context)).toBe(true);
+    });
+
+    it('allows an unmarked handler', () => {
+      const context = createContext(
+        new HandlerLevelController(),
+        'unaffected',
+      );
+      expect(guard.canActivate(context)).toBe(true);
+    });
+  });
+
+  describe('when maintenance mode is on', () => {
+    beforeEach(() => {
+      maintenanceMode.enable();
+    });
+
+    it('blocks an HTTP handler marked with @Maintenance()', () => {
+      const context = createContext(new HandlerLevelController(), 'affected');
+      expect(() => guard.canActivate(context)).toThrow(
+        'temporarily unavailable',
+      );
+    });
+
+    it('does not block a sibling handler on the same controller', () => {
+      const context = createContext(
+        new HandlerLevelController(),
+        'unaffected',
+      );
+      expect(guard.canActivate(context)).toBe(true);
+    });
+
+    it('blocks every handler of a class marked with @Maintenance()', () => {
+      const context = createContext(new ClassLevelController(), 'anyMethod');
+      expect(() => guard.canActivate(context)).toThrow(
+        'temporarily unavailable',
+      );
+    });
+
+    it('blocks a WebSocket message handler marked with @Maintenance()', () => {
+      const context = createContext(
+        new HandlerLevelGateway(),
+        'affected',
+        'ws',
+      );
+      expect(() => guard.canActivate(context)).toThrow(WsException);
+    });
+
+    it('does not block an unmarked WebSocket message handler', () => {
+      const context = createContext(
+        new HandlerLevelGateway(),
+        'unaffected',
+        'ws',
+      );
+      expect(guard.canActivate(context)).toBe(true);
+    });
+  });
+
+  it('stops blocking once maintenance mode is switched back off', () => {
+    const context = createContext(new HandlerLevelController(), 'affected');
+
+    maintenanceMode.enable();
+    expect(() => guard.canActivate(context)).toThrow();
+
+    maintenanceMode.disable();
+    expect(guard.canActivate(context)).toBe(true);
+  });
+});
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
new file mode 100644
index 0000000..ff528c1
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
@@ -0,0 +1,47 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { Maintenance } from './maintenance.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+const MAINTENANCE_MESSAGE =
+  'This action is temporarily unavailable for maintenance. Please try again later.';
+
+/**
+ * Rejects calls to any handler (or any handler of a class) decorated with
+ * `@Maintenance()` while maintenance mode is switched on, before the
+ * handler's own logic runs. Unmarked handlers are always let through.
+ *
+ * Because it only inspects metadata on the handler/class and the current
+ * flag on `MaintenanceModeService`, this guard behaves identically for HTTP
+ * routes and WebSocket message handlers - it never touches the underlying
+ * request or socket.
+ */
+@Injectable()
+export class MaintenanceGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceMode: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isUnderMaintenance = this.reflector.getAllAndOverride(Maintenance, [
+      context.getHandler(),
+      context.getClass(),
+    ]);
+
+    if (!isUnderMaintenance || !this.maintenanceMode.isEnabled()) {
+      return true;
+    }
+
+    if (context.getType() === 'ws') {
+      throw new WsException(MAINTENANCE_MESSAGE);
+    }
+    throw new ServiceUnavailableException(MAINTENANCE_MESSAGE);
+  }
+}
