+import { UseGuards } from '@nestjs/common';
+import {
+  MessageBody,
+  SubscribeMessage,
+  WebSocketGateway,
+} from '@nestjs/websockets';
+import { Maintenance } from '../maintenance/maintenance.decorator.js';
+import { MaintenanceGuard } from '../maintenance/maintenance.guard.js';
+
+@UseGuards(MaintenanceGuard)
+@WebSocketGateway()
+export class EventsGateway {
+  // Unaffected: a simple health check, safe to answer during maintenance.
+  @SubscribeMessage('ping')
+  ping() {
+    return { event: 'pong', data: {} };
+  }
+
+  // Depends on the data migration, so it's turned away while maintenance
+  // mode is on - marked with the exact same decorator used on HTTP routes.
+  @SubscribeMessage('reindex')
+  @Maintenance()
+  reindex(@MessageBody() data: unknown) {
+    return { event: 'reindex', data: { started: true, payload: data } };
+  }
+}
