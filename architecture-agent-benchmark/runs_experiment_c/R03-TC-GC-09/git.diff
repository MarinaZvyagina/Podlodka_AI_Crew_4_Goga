+import { Global, Module } from '@nestjs/common';
+import { MaintenanceModeController } from './maintenance-mode.controller.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+import { MaintenanceGuard } from './maintenance.guard.js';
+
+/**
+ * Global so that `MaintenanceModeService` and `MaintenanceGuard` can be
+ * injected from any controller or gateway without re-importing this module
+ * everywhere.
+ */
+@Global()
+@Module({
+  controllers: [MaintenanceModeController],
+  providers: [MaintenanceModeService, MaintenanceGuard],
+  exports: [MaintenanceModeService, MaintenanceGuard],
+})
+export class MaintenanceModule {}
