+import { MaintenanceModeController } from './maintenance-mode.controller.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+describe('MaintenanceModeController', () => {
+  let service: MaintenanceModeService;
+  let controller: MaintenanceModeController;
+
+  beforeEach(() => {
+    service = new MaintenanceModeService();
+    controller = new MaintenanceModeController(service);
+  });
+
+  it('reports current status', () => {
+    expect(controller.status()).toEqual({ enabled: false });
+  });
+
+  it('enables maintenance mode', () => {
+    expect(controller.enable()).toEqual({ enabled: true });
+    expect(service.isEnabled()).toBe(true);
+  });
+
+  it('disables maintenance mode', () => {
+    service.enable();
+    expect(controller.disable()).toEqual({ enabled: false });
+    expect(service.isEnabled()).toBe(false);
+  });
+});
