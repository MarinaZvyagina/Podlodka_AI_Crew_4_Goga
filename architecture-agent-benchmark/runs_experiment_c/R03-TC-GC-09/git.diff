+import { Controller, Get, UseGuards } from '@nestjs/common';
+import { Maintenance } from '../maintenance/maintenance.decorator.js';
+import { MaintenanceGuard } from '../maintenance/maintenance.guard.js';
+
+// The whole controller reads from the table being migrated, so every
+// handler in it is marked at once by decorating the class instead of
+// each method individually.
+@UseGuards(MaintenanceGuard)
+@Maintenance()
+@Controller('legacy-reports')
+export class LegacyReportsController {
+  @Get()
+  findAll() {
+    return [];
+  }
+
+  @Get('summary')
+  summary() {
+    return { total: 0 };
+  }
+}
