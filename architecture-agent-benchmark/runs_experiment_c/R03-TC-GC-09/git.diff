+import { Controller, Get, Post, UseGuards } from '@nestjs/common';
+import { Maintenance } from '../maintenance/maintenance.decorator.js';
+import { MaintenanceGuard } from '../maintenance/maintenance.guard.js';
+
+@UseGuards(MaintenanceGuard)
+@Controller('migrations')
+export class MigrationsController {
+  // Unaffected: keeps working normally regardless of maintenance mode.
+  @Get('status')
+  status() {
+    return { migrating: false };
+  }
+
+  // Depends on the data migration, so it's turned away while maintenance
+  // mode is on.
+  @Post('rebuild-index')
+  @Maintenance()
+  rebuildIndex() {
+    return { started: true };
+  }
+}
