@@ -0,0 +1,24 @@
+import { Global, Module } from '@nestjs/common';
+import { APP_GUARD } from '@nestjs/core';
+import { MaintenanceController } from './maintenance.controller.js';
+import { MaintenanceModeGuard } from './maintenance-mode.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Registers `MaintenanceModeGuard` as a global guard (covers HTTP route
+ * handlers automatically) and also exports the guard itself so WS gateways
+ * can additionally opt in with `@UseGuards(MaintenanceModeGuard)` - both
+ * point at the same singleton instance, so there is a single source of
+ * truth for maintenance-mode state either way.
+ */
+@Global()
+@Module({
+  controllers: [MaintenanceController],
+  providers: [
+    MaintenanceModeService,
+    MaintenanceModeGuard,
+    { provide: APP_GUARD, useExisting: MaintenanceModeGuard },
+  ],
+  exports: [MaintenanceModeService, MaintenanceModeGuard],
+})
+export class MaintenanceModule {}
