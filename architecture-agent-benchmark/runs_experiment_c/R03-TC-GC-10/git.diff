+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the single global maintenance-mode flag in memory. Toggle it from an
+ * internal admin action (see `MaintenanceController`) or from any other place
+ * in the running application - no redeploy needed.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  enable(): void {
+    this.enabled = true;
+  }
+
+  disable(): void {
+    this.enabled = false;
+  }
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+}
