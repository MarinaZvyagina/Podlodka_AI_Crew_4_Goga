+import { Reflector } from '@nestjs/core';
+
+/**
+ * Marks a route handler, an entire `@Controller`, a WS message handler, or an
+ * entire `@WebSocketGateway` as affected by maintenance mode.
+ *
+ * When maintenance mode is enabled (see `MaintenanceModeService`), calls to
+ * anything carrying this decorator are rejected by `MaintenanceModeGuard`
+ * before the handler body runs. Everything without the decorator keeps
+ * working normally, regardless of maintenance mode.
+ */
+export const MaintenanceAffected = Reflector.createDecorator<void>();
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.spec.ts b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.spec.ts
new file mode 100644
