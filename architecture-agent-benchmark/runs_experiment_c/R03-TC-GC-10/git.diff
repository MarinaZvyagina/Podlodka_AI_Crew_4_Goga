--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.spec.ts
@@ -0,0 +1,120 @@
+import { ExecutionContext, ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MaintenanceAffected } from './maintenance-mode.decorator.js';
+import { MaintenanceModeGuard } from './maintenance-mode.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Builds a minimal stand-in for `ExecutionContext`. No HTTP server or socket
+ * is involved: the guard only ever looks at `getHandler()`, `getClass()` and
+ * `getType()`.
+ */
+function createContext(options: {
+  handler?: Function;
+  klass?: Function;
+  type?: 'http' | 'ws';
+}): ExecutionContext {
+  const handler = options.handler ?? function unmarkedHandler() {};
+  const klass = options.klass ?? class UnmarkedController {};
+
+  return {
+    getHandler: () => handler,
+    getClass: () => klass,
+    getType: () => options.type ?? 'http',
+  } as unknown as ExecutionContext;
+}
+
+describe('MaintenanceModeGuard', () => {
+  let reflector: Reflector;
+  let maintenanceMode: MaintenanceModeService;
+  let guard: MaintenanceModeGuard;
+
+  function markedHandler() {}
+  class PlainController {}
+  class MarkedController {}
+
+  beforeEach(() => {
+    reflector = new Reflector();
+    maintenanceMode = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(reflector, maintenanceMode);
+
+    Reflect.defineMetadata(
+      MaintenanceAffected.KEY,
+      {},
+      markedHandler,
+    );
+    Reflect.defineMetadata(MaintenanceAffected.KEY, {}, MarkedController);
+  });
+
+  it('allows an unmarked handler through even while maintenance mode is on', () => {
+    maintenanceMode.enable();
+
+    const context = createContext({
+      handler: function unmarkedHandler() {},
+      klass: PlainController,
+    });
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('allows a marked handler through while maintenance mode is off', () => {
+    maintenanceMode.disable();
+
+    const context = createContext({
+      handler: markedHandler,
+      klass: PlainController,
+    });
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks a marked HTTP handler while maintenance mode is on', () => {
+    maintenanceMode.enable();
+
+    const context = createContext({
+      handler: markedHandler,
+      klass: PlainController,
+      type: 'http',
+    });
+
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('blocks every handler on a marked controller while maintenance mode is on', () => {
+    maintenanceMode.enable();
+
+    const context = createContext({
+      handler: function anyMethod() {},
+      klass: MarkedController,
+      type: 'http',
+    });
+
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('blocks a marked WS message handler while maintenance mode is on', () => {
+    maintenanceMode.enable();
+
+    const context = createContext({
+      handler: markedHandler,
+      klass: PlainController,
+      type: 'ws',
+    });
+
+    expect(() => guard.canActivate(context)).toThrow(WsException);
+  });
+
+  it('turns handling back to normal once maintenance mode is switched off again', () => {
+    maintenanceMode.enable();
+    const context = createContext({ handler: markedHandler, klass: PlainController });
+    expect(() => guard.canActivate(context)).toThrow(ServiceUnavailableException);
+
+    maintenanceMode.disable();
+    expect(guard.canActivate(context)).toBe(true);
+  });
+});
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.ts b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.ts
new file mode 100644
index 0000000..f37dc55
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.ts
@@ -0,0 +1,50 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MaintenanceAffected } from './maintenance-mode.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+const MAINTENANCE_MESSAGE =
+  'This part of the API is temporarily unavailable for maintenance.';
+
+/**
+ * Rejects calls to anything decorated with `@MaintenanceAffected()` while
+ * maintenance mode is on, before the handler body runs. Handlers without the
+ * decorator always pass through unaffected.
+ *
+ * Register globally (e.g. via `APP_GUARD`) so it covers HTTP route handlers
+ * automatically. WS gateways should also add `@UseGuards(MaintenanceModeGuard)`
+ * on the gateway class itself: whether a global guard reaches WS message
+ * handlers depends on the WS adapter/version in use, while a guard declared
+ * directly on the gateway is always honoured. Either way it's the same guard
+ * and the same `@MaintenanceAffected()` marker driving the decision.
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceMode: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isAffected = this.reflector.getAllAndOverride(MaintenanceAffected, [
+      context.getHandler(),
+      context.getClass(),
+    ]);
+
+    if (!isAffected || !this.maintenanceMode.isEnabled()) {
+      return true;
+    }
+
+    if (context.getType() === 'ws') {
+      throw new WsException(MAINTENANCE_MESSAGE);
+    }
+
+    throw new ServiceUnavailableException(MAINTENANCE_MESSAGE);
+  }
+}
