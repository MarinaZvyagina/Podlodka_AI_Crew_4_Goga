@@ -0,0 +1,115 @@
+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import { WsAdapter } from '@nestjs/platform-ws';
+import request from 'supertest';
+import { WebSocket } from 'ws';
+import { AppModule } from '../../src/app.module.js';
+
+function sendAndReceive(ws: WebSocket, message: unknown): Promise<any> {
+  return new Promise((resolve, reject) => {
+    ws.once('message', (raw: Buffer) => resolve(JSON.parse(raw.toString())));
+    ws.once('error', reject);
+    ws.send(JSON.stringify(message));
+  });
+}
+
+// The `ws` transport used by this sample only reports a blocked message
+// handler by *not* replying (the reply is what carries the handler's normal
+// output). This still proves the point: the handler body never ran.
+function expectNoReplyWithin(
+  ws: WebSocket,
+  message: unknown,
+  timeoutMs = 300,
+): Promise<void> {
+  return new Promise((resolve, reject) => {
+    const onMessage = (raw: Buffer) => {
+      clearTimeout(timer);
+      ws.off('message', onMessage);
+      reject(new Error(`Expected no reply, but got: ${raw.toString()}`));
+    };
+    const timer = setTimeout(() => {
+      ws.off('message', onMessage);
+      resolve();
+    }, timeoutMs);
+    ws.on('message', onMessage);
+    ws.send(JSON.stringify(message));
+  });
+}
+
+describe('Maintenance mode (e2e)', () => {
+  let app: INestApplication;
+  let ws: WebSocket;
+
+  beforeAll(async () => {
+    const moduleRef = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = moduleRef.createNestApplication();
+    app.useWebSocketAdapter(new WsAdapter(app));
+    await app.listen(3000);
+
+    ws = new WebSocket('ws://localhost:8080');
+    await new Promise<void>((resolve, reject) => {
+      ws.once('open', () => resolve());
+      ws.once('error', reject);
+    });
+  }, 30000);
+
+  afterAll(async () => {
+    ws.close();
+    await app.close();
+  });
+
+  it('lets unaffected HTTP and WS handlers through while maintenance mode is off', async () => {
+    await request(app.getHttpServer()).get('/cats').expect(200);
+
+    const pong = await sendAndReceive(ws, { event: 'ping', data: {} });
+    expect(pong).toBe('pong');
+  });
+
+  it('serves the affected handlers normally while maintenance mode is off', async () => {
+    await request(app.getHttpServer()).get('/cats/report').expect(200);
+
+    const reply = await sendAndReceive(ws, {
+      event: 'migrationDependentEvent',
+      data: {},
+    });
+    expect(reply).toBe(
+      'handled event that depends on the data being migrated',
+    );
+  });
+
+  it('blocks only the affected handlers once maintenance mode is switched on', async () => {
+    await request(app.getHttpServer())
+      .post('/internal/maintenance/enable')
+      .expect(201, { enabled: true });
+
+    await request(app.getHttpServer()).get('/cats').expect(200);
+    await request(app.getHttpServer()).get('/cats/report').expect(503);
+
+    const pong = await sendAndReceive(ws, { event: 'ping', data: {} });
+    expect(pong).toBe('pong');
+
+    await expectNoReplyWithin(ws, {
+      event: 'migrationDependentEvent',
+      data: {},
+    });
+  });
+
+  it('restores normal behaviour once maintenance mode is switched off', async () => {
+    await request(app.getHttpServer())
+      .post('/internal/maintenance/disable')
+      .expect(201, { enabled: false });
+
+    await request(app.getHttpServer()).get('/cats/report').expect(200);
+
+    const reply = await sendAndReceive(ws, {
+      event: 'migrationDependentEvent',
+      data: {},
+    });
+    expect(reply).toBe(
+      'handled event that depends on the data being migrated',
+    );
+  });
+});
