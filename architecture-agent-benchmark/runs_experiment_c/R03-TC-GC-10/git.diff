+import { Controller, Get } from '@nestjs/common';
+import { MaintenanceAffected } from '../maintenance/maintenance-mode.decorator.js';
+import { CatsService } from './cats.service.js';
+
+@Controller('cats')
+export class CatsController {
+  constructor(private readonly catsService: CatsService) {}
+
+  // Unaffected by maintenance mode: keeps working no matter what.
+  @Get()
+  findAll(): string[] {
+    return this.catsService.findAll();
+  }
+
+  // Depends on data that is being migrated during maintenance windows, so it
+  // gets rejected up front while maintenance mode is on.
+  @MaintenanceAffected()
+  @Get('report')
+  getReport(): string {
+    return this.catsService.runMigrationDependentReport();
+  }
+}
