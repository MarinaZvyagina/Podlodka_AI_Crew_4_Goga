+import { UseGuards } from '@nestjs/common';
+import { SubscribeMessage, WebSocketGateway } from '@nestjs/websockets';
+import { MaintenanceAffected } from '../maintenance/maintenance-mode.decorator.js';
+import { MaintenanceModeGuard } from '../maintenance/maintenance-mode.guard.js';
+
+// Declared explicitly here (in addition to the global registration in
+// MaintenanceModule) so this gateway is guaranteed to enforce maintenance
+// mode regardless of how the active WS adapter wires up global guards.
+@UseGuards(MaintenanceModeGuard)
+@WebSocketGateway(8080)
+export class EventsGateway {
+  // Unaffected by maintenance mode: keeps working no matter what.
+  @SubscribeMessage('ping')
+  onPing(): string {
+    return 'pong';
+  }
+
+  // Depends on data that is being migrated during maintenance windows, so it
+  // gets rejected up front while maintenance mode is on. The same
+  // `@MaintenanceAffected()` decorator used on HTTP handlers works here too -
+  // it can also be applied to the whole `EventsGateway` class if every
+  // message handler in it needs to be turned away at once.
+  @MaintenanceAffected()
+  @SubscribeMessage('migrationDependentEvent')
+  onMigrationDependentEvent(): string {
+    return 'handled event that depends on the data being migrated';
+  }
+}
