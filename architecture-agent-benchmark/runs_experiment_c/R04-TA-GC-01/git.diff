+// chars invalid in file names on Windows/macOS/Linux
+const INVALID_FILENAME_CHARS_REGEX = /[/\\:*?"<>|]/g;
+// Windows silently strips trailing dots/spaces, so drop them ourselves
+// to avoid the on-disk name silently diverging from what's shown
+const TRAILING_DOTS_AND_SPACES_REGEX = /[.\s]+$/;
+
+/**
+ * Turns an arbitrary user-supplied string into a name that's safe to use
+ * as a file name on common desktop operating systems (Windows, macOS, Linux).
+ * Falls back to `DEFAULT_FILENAME` if nothing valid remains.
+ */
+export const sanitizeFilename = (name: string): string => {
+  const sanitized = name
+    .replace(INVALID_FILENAME_CHARS_REGEX, "")
+    .trim()
+    .replace(TRAILING_DOTS_AND_SPACES_REGEX, "");
+
+  return sanitized || DEFAULT_FILENAME;
+};
+
