@@ -0,0 +1,53 @@
+import { getDefaultAppState } from "../appState";
+import { actionChangeProjectName } from "../actions/actionExport";
+
+import type { ActionResult } from "../actions/types";
+import type { AppClassProperties, AppState } from "../types";
+
+// actionChangeProjectName.perform is synchronous; the Action type otherwise
+// allows async performs, so the return type must be narrowed for tests
+const perform = (appState: AppState, value: string): ActionResult =>
+  actionChangeProjectName.perform(
+    [],
+    appState,
+    value,
+    {} as AppClassProperties,
+  ) as ActionResult;
+
+describe("actionChangeProjectName", () => {
+  const appState = getDefaultAppState() as AppState;
+
+  it("keeps an already-safe name unchanged, without a toast", () => {
+    const result = perform(appState, "My drawing");
+
+    expect(result).not.toBe(false);
+    if (result === false) {
+      return;
+    }
+    expect(result.appState?.name).toBe("My drawing");
+    expect(result.appState?.toast).toBeFalsy();
+  });
+
+  it("sanitizes unsafe characters and surfaces a toast", () => {
+    const result = perform(appState, "My/Drawing:*?");
+
+    expect(result).not.toBe(false);
+    if (result === false) {
+      return;
+    }
+    expect(result.appState?.name).toBe("My-Drawing---");
+    expect(result.appState?.toast?.message).toContain("My-Drawing---");
+  });
+
+  it("falls back to an untitled name when input sanitizes to empty, and surfaces a toast", () => {
+    const result = perform(appState, "   ");
+
+    expect(result).not.toBe(false);
+    if (result === false) {
+      return;
+    }
+    expect(result.appState?.name).toBeTruthy();
+    expect(result.appState?.name).not.toBe("   ");
+    expect(result.appState?.toast).toBeTruthy();
+  });
+});
diff --git a/packages/excalidraw/tests/data/filename.test.ts b/packages/excalidraw/tests/data/filename.test.ts
