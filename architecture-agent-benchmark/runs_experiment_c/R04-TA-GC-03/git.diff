index 0000000..32e2a44
--- /dev/null
+++ b/packages/excalidraw/tests/data/filename.test.ts
@@ -0,0 +1,39 @@
+import { getSafeFilename } from "../../data/filename";
+
+describe("getSafeFilename", () => {
+  it("leaves an already-safe name untouched", () => {
+    expect(getSafeFilename("My drawing", "fallback")).toBe("My drawing");
+  });
+
+  it("replaces characters invalid on Windows/macOS/Linux", () => {
+    expect(getSafeFilename('a/b\\c:d*e?f"g<h>i|j', "fallback")).toBe(
+      "a-b-c-d-e-f-g-h-i-j",
+    );
+  });
+
+  it("strips ASCII control characters", () => {
+    expect(getSafeFilename("abc\x0bdef", "fallback")).toBe("abc-def");
+  });
+
+  it("strips trailing dots and spaces (silently stripped by Windows)", () => {
+    expect(getSafeFilename("My drawing. . ", "fallback")).toBe("My drawing");
+    expect(getSafeFilename("My drawing...", "fallback")).toBe("My drawing");
+    expect(getSafeFilename("My drawing   ", "fallback")).toBe("My drawing");
+  });
+
+  it("trims leading/trailing whitespace", () => {
+    expect(getSafeFilename("  My drawing  ", "fallback")).toBe("My drawing");
+  });
+
+  it("falls back when the name is empty", () => {
+    expect(getSafeFilename("", "fallback")).toBe("fallback");
+  });
+
+  it("falls back when the name is only whitespace", () => {
+    expect(getSafeFilename("   ", "fallback")).toBe("fallback");
+  });
+
+  it("falls back when the name is only trailing dots/spaces", () => {
+    expect(getSafeFilename(" . . ", "fallback")).toBe("fallback");
+  });
+});
