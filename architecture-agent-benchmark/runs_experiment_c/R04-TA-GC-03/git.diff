new file mode 100644
index 0000000..c2a75a2
--- /dev/null
+++ b/packages/excalidraw/data/filename.ts
@@ -0,0 +1,23 @@
+// characters forbidden in file names on Windows, plus ASCII control characters,
+// which are also unsafe/invisible on macOS and Linux
+// eslint-disable-next-line no-control-regex
+const INVALID_FILENAME_CHARS_REGEX = /[/\\:*?"<>|\x00-\x1f]/g;
+
+// Windows silently strips trailing dots/spaces from file names, which can
+// leave the name on disk mismatched with what the user typed
+const TRAILING_DOTS_AND_SPACES_REGEX = /[.\s]+$/;
+
+/**
+ * Sanitizes a user-provided drawing name into a name that is safe to use as
+ * a file name on Windows, macOS, and Linux. Falls back to `fallback` if the
+ * sanitized result would be empty (e.g. the input was empty, all whitespace,
+ * or made up entirely of invalid characters).
+ */
+export const getSafeFilename = (name: string, fallback: string): string => {
+  const safeName = name
+    .replace(INVALID_FILENAME_CHARS_REGEX, "-")
+    .trim()
+    .replace(TRAILING_DOTS_AND_SPACES_REGEX, "");
+
+  return safeName || fallback;
+};
