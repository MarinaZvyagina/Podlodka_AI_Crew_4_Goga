+// chars disallowed (or reserved as path separators) in file names on
+// Windows/macOS/Linux, plus ASCII control characters
+// eslint-disable-next-line no-control-regex
+const INVALID_FILENAME_CHARS_REGEX = /[\\/:*?"<>|\x00-\x1f]/g;
+
+/**
+ * Makes a user-supplied name safe to use as a file name on Windows, macOS
+ * and Linux by stripping characters that are disallowed (or reserved as
+ * path separators) on at least one of these platforms, as well as trailing
+ * dots/spaces, which Windows silently strips.
+ */
+export const sanitizeFilename = (name: string) =>
+  name
+    .replace(INVALID_FILENAME_CHARS_REGEX, "_")
+    .replace(/[.\s]+$/, "")
+    .trim();
+
