diff --git a/packages/excalidraw/data/filename.test.ts b/packages/excalidraw/data/filename.test.ts
new file mode 100644
index 0000000..3167f70
--- /dev/null
+++ b/packages/excalidraw/data/filename.test.ts
@@ -0,0 +1,39 @@
+import { getSafeFilename } from "./filename";
+
+describe("getSafeFilename", () => {
+  it("leaves an already-safe name untouched", () => {
+    expect(getSafeFilename("My Drawing")).toBe("My Drawing");
+  });
+
+  it("replaces characters invalid on Windows/macOS/Linux", () => {
+    expect(getSafeFilename('a/b\\c:d*e?f"g<h>i|j')).toBe("a_b_c_d_e_f_g_h_i_j");
+  });
+
+  it("replaces control characters", () => {
+    expect(getSafeFilename(`a${String.fromCharCode(1)}b\tc`)).toBe("a_b_c");
+  });
+
+  it("strips trailing dots and spaces", () => {
+    expect(getSafeFilename("My Drawing.")).toBe("My Drawing");
+    expect(getSafeFilename("My Drawing ")).toBe("My Drawing");
+    expect(getSafeFilename("My Drawing . . ")).toBe("My Drawing");
+  });
+
+  it("trims leading whitespace", () => {
+    expect(getSafeFilename("  My Drawing")).toBe("My Drawing");
+  });
+
+  it("returns an empty string for empty or whitespace-only input", () => {
+    expect(getSafeFilename("")).toBe("");
+    expect(getSafeFilename("   ")).toBe("");
+  });
+
+  it("returns an empty string when the input is only dots", () => {
+    expect(getSafeFilename("...")).toBe("");
+    expect(getSafeFilename(".")).toBe("");
+  });
+
+  it("replaces (rather than drops) an all-invalid-character input", () => {
+    expect(getSafeFilename('/\\:*?"<>|')).toBe("_________");
+  });
+});
diff --git a/packages/excalidraw/data/filename.ts b/packages/excalidraw/data/filename.ts
new file mode 100644
index 0000000..248eb2e
--- /dev/null
+++ b/packages/excalidraw/data/filename.ts
@@ -0,0 +1,19 @@
+// characters reserved/invalid in file names on Windows, plus control characters
+// eslint-disable-next-line no-control-regex
+const INVALID_FILENAME_CHARS = /[\\/:*?"<>|\x00-\x1f]/g;
+
+/**
+ * Turns an arbitrary user-typed string into a name that is safe to use as a
+ * file name on Windows, macOS, and Linux: invalid characters are replaced,
+ * and trailing dots/spaces (which Windows silently strips) are removed.
+ *
+ * Returns an empty string if nothing safe remains (e.g. the input was empty,
+ * whitespace-only, or made up entirely of invalid characters), so callers
+ * can fall back to a default name.
+ */
+export const getSafeFilename = (name: string): string => {
+  return name
+    .replace(INVALID_FILENAME_CHARS, "_")
+    .replace(/[.\s]+$/, "")
+    .trim();
+};
