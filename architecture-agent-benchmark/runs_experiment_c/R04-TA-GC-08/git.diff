+      expect(sanitizeFilename("My Drawing.")).toEqual("My Drawing");
+      expect(sanitizeFilename("My Drawing   ")).toEqual("My Drawing");
+      expect(sanitizeFilename("My Drawing...")).toEqual("My Drawing");
+      expect(sanitizeFilename("My Drawing . . ")).toEqual("My Drawing");
+    });
+
+    it("should trim leading/trailing whitespace", () => {
+      expect(sanitizeFilename("  My Drawing  ")).toEqual("My Drawing");
+    });
+
+    it("should fall back when the name is empty, only whitespace, or only dots", () => {
+      expect(sanitizeFilename("")).toEqual("Untitled");
+      expect(sanitizeFilename("   ")).toEqual("Untitled");
+      expect(sanitizeFilename("...")).toEqual("Untitled");
+    });
+
+    it("should replace (not drop) a name made up only of forbidden characters", () => {
+      expect(sanitizeFilename("///")).toEqual("---");
+    });
+
+    it("should use the supplied fallback instead of the default", () => {
+      expect(sanitizeFilename("", "My Fallback")).toEqual("My Fallback");
