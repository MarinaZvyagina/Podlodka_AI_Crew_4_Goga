+// characters reserved/forbidden on Windows, macOS, and Linux filesystems,
+// plus ASCII control characters
+// eslint-disable-next-line no-control-regex
+const INVALID_FILENAME_CHARS_REGEX = /[/\\:*?"<>|\x00-\x1f]/g;
+// Windows silently strips trailing dots and spaces from filenames, which can
+// cause the saved file to not match what the user typed
+const TRAILING_DOTS_AND_SPACES_REGEX = /[.\s]+$/;
+
+/**
+ * Turns an arbitrary user-supplied string into a name that's safe to use as
+ * a filename on Windows, macOS, and Linux. Falls back to `fallback` if
+ * nothing safe is left after sanitization (e.g. name was empty or made up
+ * entirely of invalid/whitespace characters).
+ */
+export const sanitizeFilename = (
+  name: string,
+  fallback: string = DEFAULT_FILENAME,
+): string => {
+  const sanitized = name
+    .replace(INVALID_FILENAME_CHARS_REGEX, "-")
+    .trim()
+    .replace(TRAILING_DOTS_AND_SPACES_REGEX, "");
+
+  return sanitized || fallback;
+};
