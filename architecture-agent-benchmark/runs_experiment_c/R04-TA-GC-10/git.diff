new file mode 100644
index 0000000..e10c156
--- /dev/null
+++ b/packages/excalidraw/data/filename.ts
@@ -0,0 +1,24 @@
+import { DEFAULT_FILENAME } from "@excalidraw/common";
+
+// characters that are reserved/forbidden in file names on Windows, macOS or
+// Linux, plus ASCII control characters
+// eslint-disable-next-line no-control-regex
+const UNSAFE_FILENAME_CHARS_REGEX = /[\x00-\x1f<>:"/\\|?*]/g;
+
+// Windows silently strips trailing dots/spaces, which can cause the saved
+// file name to no longer match what the user typed
+const TRAILING_DOTS_AND_SPACES_REGEX = /[. ]+$/;
+
+/**
+ * Turns an arbitrary user-supplied drawing name into a name that is safe to
+ * use as a file name on common desktop operating systems (Windows, macOS,
+ * Linux). Falls back to `DEFAULT_FILENAME` if nothing safe remains.
+ */
+export const sanitizeFilename = (name: string): string => {
+  const sanitized = name
+    .trim()
+    .replace(UNSAFE_FILENAME_CHARS_REGEX, "_")
+    .replace(TRAILING_DOTS_AND_SPACES_REGEX, "");
+
+  return sanitized || DEFAULT_FILENAME;
+};
