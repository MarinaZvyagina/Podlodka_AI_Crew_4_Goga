diff --git a/packages/excalidraw/tests/data/filename.test.ts b/packages/excalidraw/tests/data/filename.test.ts
new file mode 100644
index 0000000..5584002
--- /dev/null
+++ b/packages/excalidraw/tests/data/filename.test.ts
@@ -0,0 +1,41 @@
+import { sanitizeFilename } from "../../data/filename";
+
+describe("sanitizeFilename", () => {
+  it("leaves an already-safe name untouched", () => {
+    expect(sanitizeFilename("My Drawing")).toBe("My Drawing");
+  });
+
+  it("replaces characters forbidden on Windows/macOS/Linux", () => {
+    expect(sanitizeFilename('a/b\\c:d*e?f"g<h>i|j')).toBe(
+      "a_b_c_d_e_f_g_h_i_j",
+    );
+  });
+
+  it("strips a trailing dot", () => {
+    expect(sanitizeFilename("My Drawing.")).toBe("My Drawing");
+  });
+
+  it("strips trailing spaces", () => {
+    expect(sanitizeFilename("My Drawing   ")).toBe("My Drawing");
+  });
+
+  it("strips a mix of trailing dots and spaces", () => {
+    expect(sanitizeFilename("My Drawing. . ")).toBe("My Drawing");
+  });
+
+  it("falls back to a default name when empty", () => {
+    expect(sanitizeFilename("")).toBe("Untitled");
+  });
+
+  it("falls back to a default name when only whitespace", () => {
+    expect(sanitizeFilename("   ")).toBe("Untitled");
+  });
+
+  it("falls back to a default name when only dots", () => {
+    expect(sanitizeFilename("...")).toBe("Untitled");
+  });
+
+  it("replaces control characters", () => {
+    expect(sanitizeFilename("My\x00Drawing\x1f")).toBe("My_Drawing_");
+  });
+});
