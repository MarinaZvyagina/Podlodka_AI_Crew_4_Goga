+/**
+ * true enclosed area of an element, independent of its rotation.
+ * returns null for elements that don't enclose a region (e.g. an open line,
+ * an arrow, or a text label)
+ */
+export const getElementArea = (
+  element: ExcalidrawElement,
+  elementsMap: ElementsMap,
+): number | null => {
+  switch (element.type) {
+    case "rectangle":
+    case "diamond": {
+      const shape = getPolygonShape(element);
+      return shape.type === "polygon" ? polygonArea(shape.data) : null;
+    }
+    case "ellipse": {
+      const shape = getEllipseShape(element);
+      return shape.type === "ellipse"
+        ? Math.PI * shape.data.halfWidth * shape.data.halfHeight
+        : null;
+    }
+    case "line":
+    case "freedraw": {
+      if (!shouldTestInside(element)) {
+        return null;
+      }
+      const shape = getElementShape(element, elementsMap);
+      return shape.type === "polygon" ? polygonArea(shape.data) : null;
+    }
+    default:
+      return null;
+  }
+};
