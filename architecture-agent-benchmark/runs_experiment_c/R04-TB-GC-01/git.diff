+import { arrayToMap } from "@excalidraw/common";
+import { pointFrom } from "@excalidraw/math";
+import { API } from "@excalidraw/excalidraw/tests/helpers/api";
+
+import type { LocalPoint } from "@excalidraw/math";
+
+import { getElementArea } from "../src/shape";
+
+describe("getElementArea", () => {
+  it("returns width * height for an axis-aligned rectangle", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 200,
+      height: 100,
+    });
+    expect(getElementArea(rectangle, arrayToMap([rectangle]))).toBeCloseTo(
+      20000,
+      5,
+    );
+  });
+
+  it("is rotation-invariant for a rectangle", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 200,
+      height: 100,
+      angle: Math.PI / 5,
+    });
+    expect(getElementArea(rectangle, arrayToMap([rectangle]))).toBeCloseTo(
+      20000,
+      5,
+    );
+  });
+
+  it("returns (width * height) / 2 for a diamond", () => {
+    const diamond = API.createElement({
+      type: "diamond",
+      width: 200,
+      height: 100,
+    });
+    expect(getElementArea(diamond, arrayToMap([diamond]))).toBeCloseTo(
+      10000,
+      5,
+    );
+  });
+
+  it("returns pi * halfWidth * halfHeight for an ellipse", () => {
+    const ellipse = API.createElement({
+      type: "ellipse",
+      width: 200,
+      height: 100,
+    });
+    expect(getElementArea(ellipse, arrayToMap([ellipse]))).toBeCloseTo(
+      Math.PI * 100 * 50,
+      5,
+    );
+  });
+
+  it("returns the enclosed area for a closed, filled line", () => {
+    const line = API.createElement({
+      type: "line",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 100,
+      backgroundColor: "#fff",
+      roundness: null,
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 100),
+        pointFrom<LocalPoint>(0, 100),
+        pointFrom<LocalPoint>(0, 0),
+      ],
+    });
+    expect(getElementArea(line, arrayToMap([line]))).toBeCloseTo(10000, 1);
+  });
+
+  it("returns null for an open (unclosed) line", () => {
+    const line = API.createElement({
+      type: "line",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 100,
+      backgroundColor: "#fff",
+      roundness: null,
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 100),
+      ],
+    });
+    expect(getElementArea(line, arrayToMap([line]))).toBeNull();
+  });
+
+  it("returns the enclosed area for a closed, filled freedraw outline", () => {
+    const freedraw = API.createElement({
+      type: "freedraw",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 100,
+      backgroundColor: "#fff",
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 100),
+        pointFrom<LocalPoint>(0, 100),
+        pointFrom<LocalPoint>(0, 0),
+      ],
+    });
+    expect(getElementArea(freedraw, arrayToMap([freedraw]))).toBeCloseTo(
+      10000,
+      1,
+    );
+  });
+
+  it("returns null for an open freedraw stroke", () => {
+    const freedraw = API.createElement({
+      type: "freedraw",
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 100,
+      backgroundColor: "#fff",
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 100),
+      ],
+    });
+    expect(getElementArea(freedraw, arrayToMap([freedraw]))).toBeNull();
+  });
+
+  it("returns null for a text element", () => {
+    const text = API.createElement({ type: "text", text: "hi" });
+    expect(getElementArea(text, arrayToMap([text]))).toBeNull();
+  });
+
+  it("returns null for an arrow", () => {
+    const arrow = API.createElement({
+      type: "arrow",
+      backgroundColor: "#fff",
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 100),
+        pointFrom<LocalPoint>(0, 0),
+      ],
+    });
+    expect(getElementArea(arrow, arrayToMap([arrow]))).toBeNull();
+  });
+});
