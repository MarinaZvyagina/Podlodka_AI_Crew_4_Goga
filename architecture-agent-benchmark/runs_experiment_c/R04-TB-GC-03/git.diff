diff --git a/packages/excalidraw/components/Stats/Area.tsx b/packages/excalidraw/components/Stats/Area.tsx
new file mode 100644
index 0000000..f367879
--- /dev/null
+++ b/packages/excalidraw/components/Stats/Area.tsx
@@ -0,0 +1,62 @@
+import { polygonArea, round } from "@excalidraw/math";
+
+import {
+  isFreeDrawElement,
+  isLineElement,
+  isPathALoop,
+} from "@excalidraw/element";
+
+import type { NonDeletedExcalidrawElement } from "@excalidraw/element/types";
+
+import { t } from "../../i18n";
+
+/**
+ * Returns the enclosed area of the element, or `null` if the element
+ * doesn't enclose a region (e.g. an open line, arrow, or text).
+ *
+ * Computed from each shape's own local geometry (never the axis-aligned
+ * bounding box), so the result is unaffected by the element's rotation.
+ */
+export const getElementArea = (
+  element: NonDeletedExcalidrawElement,
+): number | null => {
+  if (isLineElement(element)) {
+    return element.polygon ? polygonArea(element.points) : null;
+  }
+
+  if (isFreeDrawElement(element)) {
+    return isPathALoop(element.points) ? polygonArea(element.points) : null;
+  }
+
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    default:
+      return null;
+  }
+};
+
+interface AreaProps {
+  element: NonDeletedExcalidrawElement;
+}
+
+const Area = ({ element }: AreaProps) => {
+  const area = getElementArea(element);
+
+  if (area === null) {
+    return null;
+  }
+
+  return (
+    <>
+      <div>{t("stats.area")}</div>
+      <div>{round(area, 2)}</div>
+    </>
+  );
+};
+
+export default Area;
