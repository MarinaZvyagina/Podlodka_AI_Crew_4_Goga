+import { polygonArea, round } from "@excalidraw/math";
+
+import { getElementShape } from "@excalidraw/element";
+
+import type {
+  ElementsMap,
+  ExcalidrawElementType,
+  NonDeletedExcalidrawElement,
+} from "@excalidraw/element/types";
+
+import { t } from "../../i18n";
+
+interface AreaProps {
+  element: NonDeletedExcalidrawElement;
+  elementsMap: ElementsMap;
+}
+
+const AREA_ELIGIBLE_TYPES = new Set<ExcalidrawElementType>([
+  "rectangle",
+  "diamond",
+  "ellipse",
+  "line",
+  "freedraw",
+]);
+
+export const getElementArea = (
+  element: NonDeletedExcalidrawElement,
+  elementsMap: ElementsMap,
+): number | null => {
+  if (!AREA_ELIGIBLE_TYPES.has(element.type)) {
+    return null;
+  }
+
+  const shape = getElementShape(element, elementsMap);
+
+  switch (shape.type) {
+    case "polygon":
+      return polygonArea(shape.data);
+    case "ellipse":
+      return Math.PI * shape.data.halfWidth * shape.data.halfHeight;
+    default:
+      return null;
+  }
+};
+
+const Area = ({ element, elementsMap }: AreaProps) => {
+  const area = getElementArea(element, elementsMap);
+
+  if (area === null) {
+    return null;
+  }
+
+  return (
+    <>
+      <div>{t("stats.area")}</div>
+      <div>{round(area, 2)}</div>
+    </>
+  );
+};
+
+export default Area;
