+describe("stats area", () => {
+  beforeEach(async () => {
+    localStorage.clear();
+    renderStaticScene.mockClear();
+    reseed(7);
+    setDateTimeForTests("201933152653");
+
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+
+    API.setElements([]);
+
+    fireEvent.contextMenu(GlobalTestState.interactiveCanvas, {
+      button: 2,
+      clientX: 1,
+      clientY: 1,
+    });
+    const contextMenu = UI.queryContextMenu();
+    fireEvent.click(queryByTestId(contextMenu!, "stats")!);
+    stats = UI.queryStats();
+  });
+
+  beforeAll(() => {
+    mockBoundingClientRect();
+  });
+
+  afterAll(() => {
+    restoreOriginalGetBoundingClientRect();
+  });
+
+  const selectElement = (element: NonDeletedExcalidrawElement) => {
+    API.setElements([element]);
+    API.setSelectedElements([element]);
+    elementStats = stats?.querySelector("#elementStats");
+  };
+
+  const getAreaValue = () => {
+    const rows = elementStats!.querySelectorAll(".exc-stats__row");
+    for (const row of Array.from(rows)) {
+      if (row.firstElementChild?.textContent === t("stats.area")) {
+        return row.lastElementChild?.textContent;
+      }
+    }
+    return undefined;
+  };
+
+  it("shows the area of a rectangle and keeps it correct after rotating", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 200,
+      height: 100,
+    });
+    selectElement(rectangle);
+
+    expect(getAreaValue()).toBe("20000");
+
+    API.updateElement(rectangle, {
+      angle: degreesToRadians(45 as Degrees),
+    });
+
+    expect(getAreaValue()).toBe("20000");
+  });
+
+  it("shows the area of a diamond as half its bounding box", () => {
+    const diamond = API.createElement({
+      type: "diamond",
+      width: 200,
+      height: 100,
+    });
+    selectElement(diamond);
+
+    expect(getAreaValue()).toBe("10000");
+  });
+
+  it("shows the area of an ellipse", () => {
+    const ellipse = API.createElement({
+      type: "ellipse",
+      width: 200,
+      height: 100,
+    });
+    selectElement(ellipse);
+
+    expect(getAreaValue()).toBe(round(Math.PI * 100 * 50, 2).toString());
+  });
+
+  it("omits the area for an open line", () => {
+    const line = API.createElement({
+      type: "line",
+      roundness: null,
+      points: [pointFrom(0, 0), pointFrom(100, 0), pointFrom(100, 100)],
+    });
+    selectElement(line);
+
+    expect(getAreaValue()).toBeUndefined();
+  });
+
+  it("shows the area of a closed, filled line", () => {
+    const line = API.createElement({
+      type: "line",
+      roundness: null,
+      backgroundColor: "#000000",
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+        pointFrom(0, 0),
+      ],
+    });
+    selectElement(line);
+
+    expect(getAreaValue()).toBe("10000");
+  });
+
+  it("omits the area for a text element", () => {
+    const text = API.createElement({ type: "text", text: "hi" });
+    selectElement(text);
+
+    expect(getAreaValue()).toBeUndefined();
+  });
+});
