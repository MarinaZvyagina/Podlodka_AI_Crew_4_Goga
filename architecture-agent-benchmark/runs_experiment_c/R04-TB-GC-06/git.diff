+// Returns the enclosed area of the element, or null if the element (e.g. an
+// arrow, an open line, or an open freedraw stroke) has no meaningful area.
+// Rotation doesn't affect area, so this is computed from local dimensions/
+// points without needing to account for `element.angle`.
+export const getElementArea = (element: ExcalidrawElement): number | null => {
+  if (isLineElement(element)) {
+    return element.polygon && isValidPolygon(element.points)
+      ? polygonArea(element.points)
+      : null;
+  }
+  if (isFreeDrawElement(element)) {
+    return isPathALoop(element.points) ? polygonArea(element.points) : null;
+  }
+  switch (element.type) {
+    case "rectangle":
+      return Math.abs(element.width * element.height);
+    case "diamond":
+      return Math.abs(element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * Math.abs(element.width) * Math.abs(element.height)) / 4;
+    default:
+      return null;
+  }
+};
