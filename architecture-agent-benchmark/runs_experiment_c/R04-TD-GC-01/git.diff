diff --git a/packages/element/src/snapToGrid.ts b/packages/element/src/snapToGrid.ts
new file mode 100644
index 0000000..639a1e0
--- /dev/null
+++ b/packages/element/src/snapToGrid.ts
@@ -0,0 +1,66 @@
+import { getGridPoint } from "@excalidraw/common";
+
+import { resizeSingleElement } from "./resizeElements";
+
+import type { NullableGridSize } from "@excalidraw/excalidraw/types";
+
+import type { Scene } from "./Scene";
+import type { NonDeletedExcalidrawElement } from "./types";
+
+export const snapElementsToGrid = (
+  elements: readonly NonDeletedExcalidrawElement[],
+  scene: Scene,
+  gridSize: number,
+): void => {
+  elements.forEach((element) => snapElementToGrid(element, scene, gridSize));
+};
+
+const snapElementToGrid = (
+  element: NonDeletedExcalidrawElement,
+  scene: Scene,
+  gridSize: number,
+) => {
+  const brandedGridSize = gridSize as NullableGridSize;
+  const [snappedX, snappedY] = getGridPoint(
+    element.x,
+    element.y,
+    brandedGridSize,
+  );
+  const [snappedRight, snappedBottom] = getGridPoint(
+    element.x + element.width,
+    element.y + element.height,
+    brandedGridSize,
+  );
+
+  // floor at one grid cell so a shape smaller than the grid spacing can't
+  // collapse to zero size when both of its edges round to the same line
+  const nextWidth = Math.max(snappedRight - snappedX, gridSize);
+  const nextHeight = Math.max(snappedBottom - snappedY, gridSize);
+
+  if (
+    snappedX === element.x &&
+    snappedY === element.y &&
+    nextWidth === element.width &&
+    nextHeight === element.height
+  ) {
+    return;
+  }
+
+  if (snappedX !== element.x || snappedY !== element.y) {
+    scene.mutateElement(element, { x: snappedX, y: snappedY });
+  }
+
+  // anchors the resize at the (now snapped) top-left corner and snaps the
+  // opposite corner to the grid, matching a manual drag-to-resize with grid
+  // snapping on; this also takes care of bound text/arrows via its own
+  // handleBindTextResize/updateBoundElements calls
+  resizeSingleElement(
+    nextWidth,
+    nextHeight,
+    element,
+    element,
+    scene.getNonDeletedElementsMap(),
+    scene,
+    "se",
+  );
+};
diff --git a/packages/excalidraw/actions/actionSnapToGrid.test.tsx b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
new file mode 100644
index 0000000..03439bd
--- /dev/null
