@@ -0,0 +1,143 @@
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { Keyboard } from "../tests/helpers/ui";
+import { render } from "../tests/test-utils";
+
+import { actionSnapToGrid } from "./actionSnapToGrid";
+
+const { h } = window;
+
+describe("snap to grid", () => {
+  beforeEach(async () => {
+    await render(<Excalidraw />);
+    API.setAppState({ gridSize: 20 });
+  });
+
+  it("snaps the position and size of selected elements independently", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      id: "rect1",
+      x: 101,
+      y: 98,
+      width: 53,
+      height: 47,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      id: "rect2",
+      x: 209,
+      y: 311,
+      width: 34,
+      height: 66,
+    });
+
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([rect1, rect2]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updatedRect1 = API.getElement(rect1);
+    expect(updatedRect1.x).toBe(100);
+    expect(updatedRect1.y).toBe(100);
+    expect(updatedRect1.width).toBe(60);
+    expect(updatedRect1.height).toBe(40);
+
+    const updatedRect2 = API.getElement(rect2);
+    expect(updatedRect2.x).toBe(200);
+    expect(updatedRect2.y).toBe(320);
+    expect(updatedRect2.width).toBe(40);
+    expect(updatedRect2.height).toBe(60);
+  });
+
+  it("leaves unselected elements untouched", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      id: "rect1",
+      x: 101,
+      y: 98,
+      width: 53,
+      height: 47,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      id: "rect2",
+      x: 209,
+      y: 311,
+      width: 34,
+      height: 66,
+    });
+
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([rect1]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect1).x).toBe(100);
+    expect(API.getElement(rect2).x).toBe(209);
+  });
+
+  it("snaps every element when nothing is selected", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      id: "rect1",
+      x: 101,
+      y: 98,
+      width: 53,
+      height: 47,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      id: "rect2",
+      x: 209,
+      y: 311,
+      width: 34,
+      height: 66,
+    });
+
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect1).x).toBe(100);
+    expect(API.getElement(rect2).x).toBe(200);
+  });
+
+  it("reverts in a single undo step", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      id: "rect1",
+      x: 101,
+      y: 98,
+      width: 53,
+      height: 47,
+    });
+
+    API.setElements([rect1]);
+    API.setSelectedElements([rect1]);
+
+    API.executeAction(actionSnapToGrid);
+    expect(API.getElement(rect1).x).toBe(100);
+
+    Keyboard.undo();
+
+    expect(API.getElement(rect1).x).toBe(101);
+    expect(API.getElement(rect1).y).toBe(98);
+    expect(API.getElement(rect1).width).toBe(53);
+    expect(API.getElement(rect1).height).toBe(47);
+  });
+
+  it("is a no-op when the canvas is empty", () => {
+    API.setElements([]);
+    API.setSelectedElements([]);
+
+    const result = actionSnapToGrid.perform(
+      h.elements,
+      h.state,
+      null,
+      h.app,
+    );
+
+    expect(result).toBe(false);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..04342ff
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,47 @@
+import {
+  CaptureUpdateAction,
+  getNonDeletedElements,
+  isBoundToContainer,
+  isFrameLikeElement,
+  snapElementsToGrid,
+} from "@excalidraw/element";
+
+import { getSelectedElements } from "../scene";
+
+import { magnetIcon } from "../components/icons";
+
+import { register } from "./register";
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: magnetIcon,
+  trackEvent: { category: "element" },
+  perform: (elements, appState, _, app) => {
+    const nonDeletedElements = getNonDeletedElements(elements);
+
+    const selectedElements = getSelectedElements(nonDeletedElements, appState, {
+      includeBoundTextElement: false,
+      includeElementsInFrames: false,
+    });
+
+    // no selection -> snap everything on the canvas
+    const targets = (
+      selectedElements.length > 0 ? selectedElements : nonDeletedElements
+    ).filter(
+      (element) => !isBoundToContainer(element) && !isFrameLikeElement(element),
+    );
+
+    if (targets.length === 0) {
+      return false;
+    }
+
+    snapElementsToGrid(targets, app.scene, appState.gridSize);
+
+    return {
+      elements,
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
