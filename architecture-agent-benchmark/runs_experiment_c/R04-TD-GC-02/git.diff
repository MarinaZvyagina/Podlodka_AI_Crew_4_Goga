index 0000000..2f01a66
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
@@ -0,0 +1,144 @@
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { render } from "../tests/test-utils";
+
+import { actionSnapToGrid } from "./actionSnapToGrid";
+import { createUndoAction } from "./actionHistory";
+
+const { h } = window;
+
+describe("actionSnapToGrid", () => {
+  beforeEach(async () => {
+    await render(<Excalidraw />);
+    API.setAppState({ gridModeEnabled: true, gridSize: 20 });
+  });
+
+  it("snaps the position and size of a selected element to the grid", () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 38,
+    });
+    API.setElements([rect]);
+    API.setSelectedElements([rect]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated = API.getElement(rect);
+    expect(updated.x).toBe(20);
+    expect(updated.y).toBe(20);
+    expect(updated.width).toBe(40);
+    expect(updated.height).toBe(40);
+  });
+
+  it("applies to every element on the canvas when nothing is selected", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 38,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 101,
+      y: 8,
+      width: 22,
+      height: 19,
+    });
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated1 = API.getElement(rect1);
+    expect(updated1.x).toBe(20);
+    expect(updated1.y).toBe(20);
+
+    const updated2 = API.getElement(rect2);
+    expect(updated2.x).toBe(100);
+    expect(updated2.y).toBe(0);
+  });
+
+  it("snaps multiple selected elements independently, not as a group", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 12,
+      width: 30,
+      height: 30,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 209,
+      y: 91,
+      width: 30,
+      height: 30,
+    });
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([rect1, rect2]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated1 = API.getElement(rect1);
+    expect(updated1.x).toBe(20);
+    expect(updated1.y).toBe(20);
+
+    const updated2 = API.getElement(rect2);
+    expect(updated2.x).toBe(200);
+    expect(updated2.y).toBe(100);
+  });
+
+  it("reverts the snap in a single undo step", () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 38,
+    });
+    API.updateScene({
+      elements: [rect],
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    });
+    API.setSelectedElements([rect]);
+
+    API.executeAction(actionSnapToGrid);
+    expect(API.getElement(rect).x).toBe(20);
+    expect(API.getUndoStack().length).toBe(2);
+
+    const undoAction = createUndoAction(h.history);
+    API.executeAction(undoAction);
+
+    const reverted = API.getElement(rect);
+    expect(reverted.x).toBe(12);
+    expect(reverted.y).toBe(27);
+    expect(reverted.width).toBe(53);
+    expect(reverted.height).toBe(38);
+    expect(API.getUndoStack().length).toBe(1);
+  });
+
+  it("is a no-op when grid mode is disabled", () => {
+    API.setAppState({ gridModeEnabled: false });
+
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 38,
+    });
+    API.setElements([rect]);
+    API.setSelectedElements([rect]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated = API.getElement(rect);
+    expect(updated.x).toBe(12);
+    expect(updated.y).toBe(27);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..d4ac5c7
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,117 @@
+import {
+  CaptureUpdateAction,
+  getNonDeletedElements,
+  isBoundToContainer,
+  isFrameLikeElement,
+  isTextElement,
+  resizeSingleElement,
+  updateFrameMembershipOfSelectedElements,
+} from "@excalidraw/element";
+
+import { getGridPoint } from "@excalidraw/common";
+
+import type {
+  ExcalidrawElement,
+  NonDeletedExcalidrawElement,
+} from "@excalidraw/element/types";
+
+import { magnetIcon } from "../components/icons";
+
+import { register } from "./register";
+
+import type { AppClassProperties, AppState } from "../types";
+
+// bound text elements move with their container, and frames aren't yet
+// supported by bounding-box-mutating actions (see actionAlign/actionDistribute)
+const getSnapToGridTargets = (
+  elements: readonly ExcalidrawElement[],
+  appState: AppState,
+  app: AppClassProperties,
+): NonDeletedExcalidrawElement[] => {
+  const selectedElements = app.scene.getSelectedElements(appState);
+  const candidates =
+    selectedElements.length > 0
+      ? selectedElements
+      : getNonDeletedElements(elements);
+
+  return candidates.filter(
+    (element) =>
+      !isFrameLikeElement(element) &&
+      !(isTextElement(element) && isBoundToContainer(element)),
+  );
+};
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: magnetIcon,
+  keywords: ["grid", "align", "snap"],
+  trackEvent: { category: "element" },
+  predicate: (elements, appState, _appProps, app) =>
+    app.getEffectiveGridSize() !== null &&
+    getSnapToGridTargets(elements, appState, app).length > 0,
+  perform: (elements, appState, _, app) => {
+    const gridSize = app.getEffectiveGridSize();
+    if (gridSize === null) {
+      return false;
+    }
+
+    const targets = getSnapToGridTargets(elements, appState, app);
+    if (targets.length === 0) {
+      return false;
+    }
+
+    const elementsMap = app.scene.getNonDeletedElementsMap();
+
+    for (const element of targets) {
+      // snap the top-left corner...
+      const [snappedX, snappedY] = getGridPoint(element.x, element.y, gridSize);
+      // ...and independently snap the bottom-right corner, so each element
+      // ends up with its own edges resting on the grid, same as manually
+      // dragging then resizing it with snapping on
+      const [snappedRight, snappedBottom] = getGridPoint(
+        element.x + element.width,
+        element.y + element.height,
+        gridSize,
+      );
+
+      if (element.x !== snappedX || element.y !== snappedY) {
+        app.scene.mutateElement(element, { x: snappedX, y: snappedY });
+      }
+
+      // don't inflate elements that are legitimately 0-wide/tall
+      // (e.g. perfectly horizontal/vertical lines and arrows)
+      let nextWidth = snappedRight - snappedX;
+      if (nextWidth === 0 && element.width !== 0) {
+        nextWidth = gridSize;
+      }
+
+      let nextHeight = snappedBottom - snappedY;
+      if (nextHeight === 0 && element.height !== 0) {
+        nextHeight = gridSize;
+      }
+
+      if (nextWidth !== element.width || nextHeight !== element.height) {
+        resizeSingleElement(
+          nextWidth,
+          nextHeight,
+          element,
+          element,
+          elementsMap,
+          app.scene,
+          "se",
+        );
+      }
+    }
+
+    return {
+      elements: updateFrameMembershipOfSelectedElements(
+        elements,
+        appState,
+        app,
+      ),
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
