+// limitTargetsPerJob drops targets from sws, which would push their job_name over its
+// MaxScrapeTargets limit, and registers them as dropped targets, so operators can spot
+// the affected job(s) at /targets, /service-discovery and /api/v1/targets pages.
+//
+// The limit is enforced against the number of targets currently registered in tsmGlobal
+// for the given job_name, so it applies uniformly no matter which service discovery
+// mechanism(s) produced sws.
+func limitTargetsPerJob(sws []*ScrapeWork, groupName string) []*ScrapeWork {
+	remainingByJob := make(map[string]int)
+	excludedByJob := make(map[string]int)
+	dst := sws[:0]
+	for _, sw := range sws {
+		if sw.MaxScrapeTargets <= 0 {
+			dst = append(dst, sw)
+			continue
+		}
+		jobName := sw.jobNameOriginal
+		remaining, ok := remainingByJob[jobName]
+		if !ok {
+			remaining = sw.MaxScrapeTargets - tsmGlobal.activeTargetsCountByJob(jobName)
+			remainingByJob[jobName] = remaining
+		}
+		if remaining <= 0 {
+			excludedByJob[jobName]++
+			droppedTargetsMap.Register(sw.OriginalLabels, sw.RelabelConfigs, targetDropReasonTargetsLimit, nil)
+			continue
+		}
+		remainingByJob[jobName] = remaining - 1
+		dst = append(dst, sw)
+	}
+	for jobName, n := range excludedByJob {
+		logger.Warnf("%s: excluding %d targets for job_name=%q because they exceed the configured max_scrape_targets limit; "+
+			"see /service-discovery page for the list of excluded targets", groupName, n, jobName)
+	}
+	return dst
+}
+
 type scraper struct {
 	sw scrapeWork
 
diff --git a/lib/promscrape/scraper_test.go b/lib/promscrape/scraper_test.go
index 8a03fc4..e6380f4 100644
--- a/lib/promscrape/scraper_test.go
+++ b/lib/promscrape/scraper_test.go
@@ -3,6 +3,7 @@ package promscrape
 import (
 	"fmt"
 	"math/rand"
+	"strings"
 	"testing"
 
 	"github.com/VictoriaMetrics/VictoriaMetrics/lib/auth"
@@ -79,3 +80,94 @@ scrape_configs:
     - targets:
         - localhost:8429`, true)
 }
+
+// TestScraperGroupMaxScrapeTargets verifies that a per-job max_scrape_targets limit is
+// enforced after all the targets for the job are assembled (here via static_configs, which
+// stands in for any service discovery mechanism, since the enforcement point doesn't care
+// which one produced the targets): a job under the limit is unaffected, a job over the limit
+// is truncated down to the limit with the excluded targets surfacing as dropped targets (the
+// same place operators already check target health at), and the feature is unlimited by default.
+func TestScraperGroupMaxScrapeTargets(t *testing.T) {
+	pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+	globalStopChan = make(chan struct{})
+	defer close(globalStopChan)
+
+	newStaticConfigSws := func(jobName, maxScrapeTargetsLine string, targetsCount int) []*ScrapeWork {
+		var addrs strings.Builder
+		for i := 0; i < targetsCount; i++ {
+			fmt.Fprintf(&addrs, "        - host-%d:8429\n", i)
+		}
+		data := fmt.Sprintf("scrape_configs:\n- job_name: %s\n%s  static_configs:\n    - targets:\n%s", jobName, maxScrapeTargetsLine, addrs.String())
+		var cfg Config
+		if err := cfg.parseData([]byte(data), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		return cfg.getStaticScrapeWork()
+	}
+	countDroppedByLimit := func(jobName string) int {
+		n := 0
+		for _, dt := range droppedTargetsMap.getTargetsList() {
+			if dt.dropReason == targetDropReasonTargetsLimit && dt.originalLabels.getJob() == jobName {
+				n++
+			}
+		}
+		return n
+	}
+
+	t.Run("UnderLimit", func(t *testing.T) {
+		jobName := fmt.Sprintf("under-limit-%d", rand.Int())
+		sg := newScraperGroup(jobName, pushData, globalStopChan)
+		defer sg.stop()
+
+		sws := newStaticConfigSws(jobName, "  max_scrape_targets: 5\n", 3)
+		sg.update(sws)
+
+		if len(sg.m) != 3 {
+			t.Fatalf("unexpected number of started scrapers; got %d; want 3", len(sg.m))
+		}
+		if n := tsmGlobal.activeTargetsCountByJob(jobName); n != 3 {
+			t.Fatalf("unexpected number of active targets; got %d; want 3", n)
+		}
+		if n := countDroppedByLimit(jobName); n != 0 {
+			t.Fatalf("unexpected number of targets dropped because of the limit; got %d; want 0", n)
+		}
+	})
+
+	t.Run("OverLimit", func(t *testing.T) {
+		jobName := fmt.Sprintf("over-limit-%d", rand.Int())
+		sg := newScraperGroup(jobName, pushData, globalStopChan)
+		defer sg.stop()
+
+		sws := newStaticConfigSws(jobName, "  max_scrape_targets: 2\n", 5)
+		sg.update(sws)
+
+		if len(sg.m) != 2 {
+			t.Fatalf("unexpected number of started scrapers; got %d; want 2", len(sg.m))
+		}
+		if n := tsmGlobal.activeTargetsCountByJob(jobName); n != 2 {
+			t.Fatalf("unexpected number of active targets; got %d; want 2", n)
+		}
+		if n := countDroppedByLimit(jobName); n != 3 {
+			t.Fatalf("unexpected number of targets dropped because of the limit; got %d; want 3", n)
+		}
+	})
+
+	t.Run("DefaultUnlimited", func(t *testing.T) {
+		jobName := fmt.Sprintf("unlimited-%d", rand.Int())
+		sg := newScraperGroup(jobName, pushData, globalStopChan)
+		defer sg.stop()
+
+		sws := newStaticConfigSws(jobName, "", 20)
+		sg.update(sws)
+
+		if len(sg.m) != 20 {
+			t.Fatalf("unexpected number of started scrapers; got %d; want 20", len(sg.m))
+		}
+		if n := tsmGlobal.activeTargetsCountByJob(jobName); n != 20 {
+			t.Fatalf("unexpected number of active targets; got %d; want 20", n)
+		}
+		if n := countDroppedByLimit(jobName); n != 0 {
+			t.Fatalf("unexpected number of targets dropped because of the limit; got %d; want 0", n)
+		}
+	})
+}
