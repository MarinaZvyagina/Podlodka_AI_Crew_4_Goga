+// activeTargetsCountByJob returns the number of currently registered (both up and down) targets
+// for the given jobName, across all the scraper groups (i.e. regardless of the service discovery
+// mechanism which produced them).
+func (tsm *targetStatusMap) activeTargetsCountByJob(jobName string) int {
+	tsm.mu.Lock()
+	n := tsm.upByJob[jobName] + tsm.downByJob[jobName]
+	tsm.mu.Unlock()
+	return n
