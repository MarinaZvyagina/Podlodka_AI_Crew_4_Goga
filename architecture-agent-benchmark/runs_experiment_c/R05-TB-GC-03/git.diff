index 4be98a8..c511256 100644
--- a/lib/promscrape/targetstatus_test.go
+++ b/lib/promscrape/targetstatus_test.go
@@ -100,6 +100,71 @@ func TestRegisterDroppedTargets(t *testing.T) {
 
 }
 
+func TestTargetStatusMapRegisterMaxTargetsPerJob(t *testing.T) {
+	newSW := func(jobName string, maxTargetsPerJob int, addr string) *scrapeWork {
+		return &scrapeWork{
+			Config: &ScrapeWork{
+				jobNameOriginal:  jobName,
+				MaxTargetsPerJob: maxTargetsPerJob,
+				OriginalLabels: newCompressedLabels(promutil.NewLabelsFromMap(map[string]string{
+					"__address__": addr,
+					"job":         jobName,
+				})),
+			},
+		}
+	}
+
+	// job under the limit - all targets are registered
+	t.Run("under limit", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		for i, addr := range []string{"host1:80", "host2:80"} {
+			sw := newSW("under-limit", 5, addr)
+			if !tsm.Register(sw) {
+				t.Fatalf("target %d unexpectedly rejected", i)
+			}
+		}
+		if n := tsm.upByJob["under-limit"] + tsm.downByJob["under-limit"]; n != 2 {
+			t.Fatalf("unexpected number of registered targets; got %d; want 2", n)
+		}
+	})
+
+	// job over the limit - only the first maxTargetsPerJob targets are registered
+	t.Run("over limit", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		accepted := 0
+		for _, addr := range []string{"host1:80", "host2:80", "host3:80", "host4:80"} {
+			sw := newSW("over-limit", 2, addr)
+			if !tsm.HasCapacity("over-limit", sw.Config.MaxTargetsPerJob) {
+				continue
+			}
+			if tsm.Register(sw) {
+				accepted++
+			}
+		}
+		if accepted != 2 {
+			t.Fatalf("unexpected number of accepted targets; got %d; want 2", accepted)
+		}
+		if n := tsm.upByJob["over-limit"] + tsm.downByJob["over-limit"]; n != 2 {
+			t.Fatalf("unexpected number of registered targets; got %d; want 2", n)
+		}
+	})
+
+	// default (unlimited) behavior - MaxTargetsPerJob=0 never rejects targets
+	t.Run("unlimited by default", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		accepted := 0
+		for _, addr := range []string{"host1:80", "host2:80", "host3:80"} {
+			sw := newSW("unlimited", 0, addr)
+			if tsm.Register(sw) {
+				accepted++
+			}
+		}
+		if accepted != 3 {
+			t.Fatalf("unexpected number of accepted targets; got %d; want 3", accepted)
+		}
+	})
+}
