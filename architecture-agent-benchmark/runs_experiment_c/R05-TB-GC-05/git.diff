+func TestGetScrapeWorkConfigMaxTargets(t *testing.T) {
+	defaultMaxTargetsPerJob := *maxTargetsPerJob
+	defer func() {
+		*maxTargetsPerJob = defaultMaxTargetsPerJob
+	}()
+
+	parseMaxTargets := func(t *testing.T, data string) int {
+		t.Helper()
+		var cfg Config
+		if err := cfg.parseData([]byte(data), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		if len(cfg.ScrapeConfigs) != 1 {
+			t.Fatalf("unexpected number of scrape configs; got %d; want 1", len(cfg.ScrapeConfigs))
+		}
+		return cfg.ScrapeConfigs[0].swc.maxTargets
+	}
+
+	const cfgData = `
+scrape_configs:
+- job_name: foo
+  static_configs:
+  - targets: ["foo.bar:1234"]
+`
+	// By default (no flag, no per-job override) the limit is disabled.
+	*maxTargetsPerJob = 0
+	if n := parseMaxTargets(t, cfgData); n != 0 {
+		t.Fatalf("unexpected maxTargets for unlimited default; got %d; want 0", n)
+	}
+
+	// -promscrape.maxTargetsPerJob sets the default for jobs without an explicit override.
+	*maxTargetsPerJob = 5
+	if n := parseMaxTargets(t, cfgData); n != 5 {
+		t.Fatalf("unexpected maxTargets from global flag; got %d; want 5", n)
+	}
+
+	// A per-job `max_targets` overrides the global flag.
+	const cfgDataOverride = `
+scrape_configs:
+- job_name: foo
+  max_targets: 3
+  static_configs:
+  - targets: ["foo.bar:1234"]
+`
+	if n := parseMaxTargets(t, cfgDataOverride); n != 3 {
+		t.Fatalf("unexpected maxTargets from per-job override; got %d; want 3", n)
+	}
+}
