@@ -399,6 +399,12 @@ func (sg *scraperGroup) update(sws []*ScrapeWork) {
 		swsToStart = append(swsToStart, sw)
 	}
 
+	// Enforce the per-job max_targets limit uniformly, regardless of which service discovery
+	// mechanism(s) produced the targets. This must run after deduplication above, so that the limit
+	// is applied to genuinely new targets only.
+	swsToStart, truncatedByJob := limitTargetsToStart(swsToStart)
+	updateTruncatedTargetsCounts(sg.name, sws, truncatedByJob)
+
 	// Stop deleted scrapers before starting new scrapers in order to prevent
