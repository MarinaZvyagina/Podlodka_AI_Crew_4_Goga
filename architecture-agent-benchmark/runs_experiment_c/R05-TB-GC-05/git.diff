@@ -445,6 +451,61 @@ func (sg *scraperGroup) update(sws []*ScrapeWork) {
 	}
 }
 
+// maxTargetsMu serializes limitTargetsToStart calls across all scraperGroups (i.e. across all
+// service discovery mechanisms), since a single job's targets may be supplied by more than one
+// of them concurrently. This keeps the enforcement of ScrapeWork.MaxTargets consistent job-wide
+// instead of being scoped to a single scraperGroup.
+var maxTargetsMu sync.Mutex
+
+// limitTargetsToStart drops targets from swsToStart once their job's ScrapeWork.MaxTargets is reached,
+// so that at most MaxTargets targets are active for that job at any given time. Targets belonging to
+// jobs without a configured limit (MaxTargets <= 0) are always kept.
+//
+// It returns the (possibly truncated) list of targets to start, along with the number of targets
+// dropped per job because of the limit.
+func limitTargetsToStart(swsToStart []*ScrapeWork) ([]*ScrapeWork, map[string]int) {
+	if len(swsToStart) == 0 {
+		return swsToStart, nil
+	}
+
+	maxTargetsMu.Lock()
+	defer maxTargetsMu.Unlock()
+
+	acceptedSoFar := make(map[string]int)
+	truncatedByJob := make(map[string]int)
+	result := make([]*ScrapeWork, 0, len(swsToStart))
+	for _, sw := range swsToStart {
+		if sw.MaxTargets <= 0 {
+			result = append(result, sw)
+			continue
+		}
+		jobName := sw.jobNameOriginal
+		active := tsmGlobal.CountByJob(jobName) + acceptedSoFar[jobName]
+		if active >= sw.MaxTargets {
+			droppedTargetsMap.Register(sw.OriginalLabels, sw.RelabelConfigs, targetDropReasonMaxTargets, nil)
+			truncatedByJob[jobName]++
+			continue
+		}
+		acceptedSoFar[jobName]++
+		result = append(result, sw)
+	}
+	return result, truncatedByJob
+}
+
+// updateTruncatedTargetsCounts records, for every job observed in sws by the given scrape group,
+// how many of its targets are currently excluded because of the max_targets limit. Jobs present in sws
+// but missing from truncatedByJob are recorded with a count of zero, clearing any previously reported
+// truncation for them once they are back under the limit.
+func updateTruncatedTargetsCounts(group string, sws []*ScrapeWork, truncatedByJob map[string]int) {
+	jobNames := make(map[string]struct{})
+	for _, sw := range sws {
+		jobNames[sw.jobNameOriginal] = struct{}{}
+	}
+	for jobName := range jobNames {
+		tsmGlobal.SetTruncatedTargetsCount(group, jobName, truncatedByJob[jobName])
+	}
+}
