+
+		if n := tsmGlobal.CountByJob(jobName); n != 4 {
+			t.Fatalf("unexpected active target count; got %d; want 4 (capped by max_targets)", n)
+		}
+		tsr := tsmGlobal.getTargetsStatusByJob(&requestFilter{originalJobName: jobName})
