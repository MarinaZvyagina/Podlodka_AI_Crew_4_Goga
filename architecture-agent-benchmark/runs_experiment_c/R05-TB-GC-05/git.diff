+// mechanism, including static_configs used here), and that the outcome is visible via the same
+// targetStatusMap accounting used by the /targets and /api/v1/targets pages.
+func TestScraperGroupUpdateMaxTargets(t *testing.T) {
+	newStaticConfigData := func(jobName string, numTargets, maxTargets int) string {
+		var sb strings.Builder
+		fmt.Fprintf(&sb, "scrape_configs:\n- job_name: %s\n", jobName)
+		if maxTargets > 0 {
+			fmt.Fprintf(&sb, "  max_targets: %d\n", maxTargets)
+		}
+		sb.WriteString("  static_configs:\n    - targets:\n")
+		for i := 0; i < numTargets; i++ {
+			fmt.Fprintf(&sb, "        - 127.0.0.1:%d\n", 20000+i)
+		}
+		return sb.String()
+	}
+
+	// setupAndUpdate parses cfgData, starts a fresh scraperGroup for it and applies the resulting
+	// ScrapeWork list via update(), returning the scraperGroup for further inspection.
+	// Registered scrapers (and their targetStatusMap bookkeeping) are cleaned up automatically.
+	setupAndUpdate := func(t *testing.T, cfgData string) *scraperGroup {
+		t.Helper()
+		pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+		globalStopChan = make(chan struct{})
+		t.Cleanup(func() { close(globalStopChan) })
+
+		sg := newScraperGroup(fmt.Sprintf("static_configs_%d", rand.Int()), pushData, globalStopChan)
+		t.Cleanup(sg.stop)
+
+		var cfg Config
+		if err := cfg.parseData([]byte(cfgData), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sg.update(cfg.getStaticScrapeWork())
+		return sg
+	}
+
+	t.Run("UnderLimit", func(t *testing.T) {
+		jobName := fmt.Sprintf("under-limit-%d", rand.Int())
+		setupAndUpdate(t, newStaticConfigData(jobName, 3, 10))
+
+		if n := tsmGlobal.CountByJob(jobName); n != 3 {
+			t.Fatalf("unexpected active target count; got %d; want 3", n)
+		}
+		tsr := tsmGlobal.getTargetsStatusByJob(&requestFilter{originalJobName: jobName})
+		if len(tsr.jobTargetsStatuses) != 1 {
+			t.Fatalf("unexpected number of jobTargetsStatuses; got %d; want 1", len(tsr.jobTargetsStatuses))
+		}
+		jts := tsr.jobTargetsStatuses[0]
+		if jts.targetsTotal != 3 {
+			t.Fatalf("unexpected targetsTotal; got %d; want 3", jts.targetsTotal)
+		}
+		if jts.targetsExcluded != 0 {
+			t.Fatalf("unexpected targetsExcluded for a job under its limit; got %d; want 0", jts.targetsExcluded)
+		}
+	})
+
+	t.Run("OverLimit", func(t *testing.T) {
+		jobName := fmt.Sprintf("over-limit-%d", rand.Int())
