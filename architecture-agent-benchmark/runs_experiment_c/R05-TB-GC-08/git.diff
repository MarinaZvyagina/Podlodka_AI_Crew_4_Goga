+// truncatedTargetsMap tracks the number of scrape targets, which were excluded from scraping
+// for the given job_name because of -promscrape.maxScrapeTargetsPerJob (or its per-job
+// max_scrape_targets_per_job override).
+//
+// A single job_name can be fed by multiple service discovery mechanisms at once, so counts
+// are tracked per discoveryType and then summed across all of them when read.
+var truncatedTargetsMap = &truncatedTargetsTracker{
+	m: make(map[string]map[string]int),
+}
+
+type truncatedTargetsTracker struct {
+	mu sync.Mutex
+	// m maps discoveryType -> jobName -> the number of targets excluded because of the limit.
+	m map[string]map[string]int
+}
+
+// updateForDiscoveryType replaces the per-job excluded target counts produced by discoveryType.
+func (ttt *truncatedTargetsTracker) updateForDiscoveryType(discoveryType string, excludedByJob map[string]int) {
+	ttt.mu.Lock()
+	if len(excludedByJob) == 0 {
+		delete(ttt.m, discoveryType)
+	} else {
+		ttt.m[discoveryType] = excludedByJob
+	}
+	ttt.mu.Unlock()
+}
+
+// getByJob returns the total number of excluded targets per job_name, summed across all discovery types.
+func (ttt *truncatedTargetsTracker) getByJob() map[string]int {
+	byJob := make(map[string]int)
+	ttt.mu.Lock()
+	for _, counts := range ttt.m {
+		for jobName, n := range counts {
+			byJob[jobName] += n
+		}
+	}
+	ttt.mu.Unlock()
+	return byJob
+}
