+// limitScrapeWorksPerJob enforces -promscrape.maxScrapeTargetsPerJob (or its per-job
+// max_scrape_targets_per_job override) on sws.
+//
+// The limit is applied uniformly regardless of the service discovery mechanism, which produced sws,
+// since sws may be a mix of targets from any of them.
+//
+// It returns the possibly truncated sws together with the number of excluded targets per job_name.
+func (cfg *Config) limitScrapeWorksPerJob(sws []*ScrapeWork) ([]*ScrapeWork, map[string]int) {
+	limitByJob := make(map[string]int)
+	for _, sc := range cfg.ScrapeConfigs {
+		if n := sc.swc.maxTargetsPerJob; n > 0 {
+			limitByJob[sc.swc.jobName] = n
+		}
+	}
+	if len(limitByJob) == 0 {
+		return sws, nil
+	}
+
+	byJob := make(map[string][]*ScrapeWork)
+	for _, sw := range sws {
+		byJob[sw.jobNameOriginal] = append(byJob[sw.jobNameOriginal], sw)
+	}
+
+	// Determine which targets must be excluded because of the per-job limit.
+	// Targets are sorted by ScrapeURL before truncating, so the set of kept targets
+	// remains stable across config reloads even if the discovery order changes.
+	excluded := make(map[*ScrapeWork]struct{})
+	excludedByJob := make(map[string]int)
+	for jobName, limit := range limitByJob {
+		jobSWs := byJob[jobName]
+		if len(jobSWs) <= limit {
+			continue
+		}
+		sortedSWs := append([]*ScrapeWork{}, jobSWs...)
+		sort.Slice(sortedSWs, func(i, j int) bool { return sortedSWs[i].ScrapeURL < sortedSWs[j].ScrapeURL })
+		for _, sw := range sortedSWs[limit:] {
+			excluded[sw] = struct{}{}
+		}
+		excludedByJob[jobName] = len(jobSWs) - limit
+	}
+	if len(excluded) == 0 {
+		return sws, nil
+	}
+
+	dst := make([]*ScrapeWork, 0, len(sws)-len(excluded))
+	for _, sw := range sws {
+		if _, ok := excluded[sw]; !ok {
+			dst = append(dst, sw)
+		}
+	}
+	return dst, excludedByJob
+}
