+func TestGetTargetsStatusByJobReportsTruncatedTargets(t *testing.T) {
+	tsm := newTargetStatusMap()
+	tsm.registerJobNames([]string{"foo", "bar"})
+	tsm.Register(&scrapeWork{
+		Config: &ScrapeWork{
+			jobNameOriginal: "foo",
+			OriginalLabels: newCompressedLabels(promutil.NewLabelsFromMap(map[string]string{
+				"__address__": "host1:80",
+			})),
+		},
+	})
+	tsm.Register(&scrapeWork{
+		Config: &ScrapeWork{
+			jobNameOriginal: "bar",
+			OriginalLabels: newCompressedLabels(promutil.NewLabelsFromMap(map[string]string{
+				"__address__": "host2:80",
+			})),
+		},
+	})
+
+	// No truncation has happened yet, so no job should report excluded targets.
+	tsr := tsm.getTargetsStatusByJob(&requestFilter{})
+	for _, jts := range tsr.jobTargetsStatuses {
+		if jts.truncatedTargets != 0 {
+			t.Fatalf("unexpected truncatedTargets for job=%s before any truncation; got %d; want 0", jts.jobName, jts.truncatedTargets)
+		}
+	}
+
+	// Simulate max_scrape_targets_per_job excluding 3 targets for job=foo.
+	truncatedTargetsMap.updateForDiscoveryType("static_configs", map[string]int{"foo": 3})
+	defer truncatedTargetsMap.updateForDiscoveryType("static_configs", nil)
+
+	tsr = tsm.getTargetsStatusByJob(&requestFilter{})
+	var gotFoo, gotBar bool
+	for _, jts := range tsr.jobTargetsStatuses {
+		switch jts.jobName {
+		case "foo":
+			gotFoo = true
+			if jts.truncatedTargets != 3 {
+				t.Fatalf("unexpected truncatedTargets for job=foo; got %d; want 3", jts.truncatedTargets)
+			}
+		case "bar":
+			gotBar = true
+			if jts.truncatedTargets != 0 {
+				t.Fatalf("unexpected truncatedTargets for job=bar; got %d; want 0", jts.truncatedTargets)
+			}
+		}
+	}
+	if !gotFoo || !gotBar {
+		t.Fatalf("missing expected jobs in the result; gotFoo=%v, gotBar=%v", gotFoo, gotBar)
+	}
+}
