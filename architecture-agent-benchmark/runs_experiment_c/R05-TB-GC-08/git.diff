+func TestConfigLimitScrapeWorksPerJob(t *testing.T) {
+	parse := func(t *testing.T, data string) (*Config, []*ScrapeWork) {
+		t.Helper()
+		var cfg Config
+		if err := cfg.parseData([]byte(data), "non-existing-file"); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		return &cfg, cfg.getStaticScrapeWork()
+	}
+
+	t.Run("job under the limit is left unaffected", func(t *testing.T) {
+		cfg, sws := parse(t, `
+scrape_configs:
+- job_name: foo
+  max_scrape_targets_per_job: 5
+  static_configs:
+  - targets: ["h1:80", "h2:80", "h3:80"]
+`)
+		if len(sws) != 3 {
+			t.Fatalf("unexpected number of discovered targets; got %d; want 3", len(sws))
+		}
+		gotSws, excludedByJob := cfg.limitScrapeWorksPerJob(sws)
+		if len(gotSws) != 3 {
+			t.Fatalf("unexpected number of targets after limiting; got %d; want 3", len(gotSws))
+		}
+		if len(excludedByJob) != 0 {
+			t.Fatalf("unexpected excluded targets; got %v; want none", excludedByJob)
+		}
+	})
+
+	t.Run("job over the limit is truncated and reported", func(t *testing.T) {
+		cfg, sws := parse(t, `
+scrape_configs:
+- job_name: foo
+  max_scrape_targets_per_job: 2
+  static_configs:
+  - targets: ["h3:80", "h1:80", "h2:80", "h4:80", "h5:80"]
+`)
+		gotSws, excludedByJob := cfg.limitScrapeWorksPerJob(sws)
+		if len(gotSws) != 2 {
+			t.Fatalf("unexpected number of targets after limiting; got %d; want 2", len(gotSws))
+		}
+		if n := excludedByJob["foo"]; n != 3 {
+			t.Fatalf("unexpected number of excluded targets for job=foo; got %d; want 3", n)
+		}
+		// The set of kept targets must be deterministic across runs - the ones with the lowest ScrapeURL are kept.
+		gotURLs := []string{gotSws[0].ScrapeURL, gotSws[1].ScrapeURL}
+		sort.Strings(gotURLs)
+		wantURLs := []string{"http://h1:80/metrics", "http://h2:80/metrics"}
+		if !reflect.DeepEqual(gotURLs, wantURLs) {
+			t.Fatalf("unexpected kept targets; got %v; want %v", gotURLs, wantURLs)
+		}
+	})
+
+	t.Run("default is unlimited", func(t *testing.T) {
+		cfg, sws := parse(t, `
+scrape_configs:
+- job_name: foo
+  static_configs:
+  - targets: ["h1:80", "h2:80", "h3:80"]
+`)
+		gotSws, excludedByJob := cfg.limitScrapeWorksPerJob(sws)
+		if len(gotSws) != len(sws) {
+			t.Fatalf("unexpected number of targets after limiting; got %d; want %d", len(gotSws), len(sws))
+		}
+		if len(excludedByJob) != 0 {
+			t.Fatalf("unexpected excluded targets; got %v; want none", excludedByJob)
+		}
+	})
+
+	t.Run("global flag applies when there is no per-job override", func(t *testing.T) {
+		prev := *maxScrapeTargetsPerJob
+		*maxScrapeTargetsPerJob = 2
+		defer func() { *maxScrapeTargetsPerJob = prev }()
+
+		cfg, sws := parse(t, `
+scrape_configs:
+- job_name: foo
+  static_configs:
+  - targets: ["h1:80", "h2:80", "h3:80"]
+`)
+		gotSws, excludedByJob := cfg.limitScrapeWorksPerJob(sws)
+		if len(gotSws) != 2 {
+			t.Fatalf("unexpected number of targets after limiting; got %d; want 2", len(gotSws))
+		}
+		if n := excludedByJob["foo"]; n != 1 {
+			t.Fatalf("unexpected number of excluded targets for job=foo; got %d; want 1", n)
+		}
+	})
+
+	t.Run("explicit per-job zero disables the global flag for that job", func(t *testing.T) {
+		prev := *maxScrapeTargetsPerJob
+		*maxScrapeTargetsPerJob = 1
+		defer func() { *maxScrapeTargetsPerJob = prev }()
+
+		cfg, sws := parse(t, `
+scrape_configs:
+- job_name: foo
+  max_scrape_targets_per_job: 0
+  static_configs:
+  - targets: ["h1:80", "h2:80", "h3:80"]
+`)
+		gotSws, excludedByJob := cfg.limitScrapeWorksPerJob(sws)
+		if len(gotSws) != 3 {
+			t.Fatalf("unexpected number of targets after limiting; got %d; want 3", len(gotSws))
+		}
+		if len(excludedByJob) != 0 {
+			t.Fatalf("unexpected excluded targets; got %v; want none", excludedByJob)
+		}
+	})
+}
