+func (tsm *targetStatusMap) Register(sw *scrapeWork) bool {
 	jobName := sw.Config.jobNameOriginal
+	targetsLimit := sw.Config.TargetsLimit
 
 	tsm.mu.Lock()
+	if targetsLimit > 0 && tsm.upByJob[jobName]+tsm.downByJob[jobName] >= targetsLimit {
+		tsm.mu.Unlock()
