diff --git a/lib/promscrape/scraper_test.go b/lib/promscrape/scraper_test.go
index 8a03fc4..19cda2d 100644
--- a/lib/promscrape/scraper_test.go
+++ b/lib/promscrape/scraper_test.go
@@ -79,3 +79,80 @@ scrape_configs:
     - targets:
         - localhost:8429`, true)
 }
+
+// TestScraperGroupTargetsLimit verifies that the per-job `target_limit` option caps the number
+// of active scrape targets for a job_name regardless of how many targets were discovered for it,
+// and that excess targets are visible via the dropped-targets registry (used by /service-discovery
+// and /api/v1/targets).
+func TestScraperGroupTargetsLimit(t *testing.T) {
+	pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+	globalStopChan = make(chan struct{})
+	defer close(globalStopChan)
+
+	f := func(targetsCount, targetsLimit, expectedActive int) {
+		t.Helper()
+
+		jobName := fmt.Sprintf("targets_limit_test_%d", rand.Int())
+		sg := newScraperGroup(fmt.Sprintf("static_configs_%d", rand.Int()), pushData, globalStopChan)
+		defer sg.stop()
+
+		var targetsYAML string
+		for i := 0; i < targetsCount; i++ {
+			targetsYAML += fmt.Sprintf("        - 127.0.0.1:%d\n", 12000+i)
+		}
+		var limitLine string
+		if targetsLimit > 0 {
+			limitLine = fmt.Sprintf("  target_limit: %d\n", targetsLimit)
+		}
+		cfgData := fmt.Sprintf(`
+scrape_configs:
+- job_name: %s
+%s  static_configs:
+    - targets:
+%s`, jobName, limitLine, targetsYAML)
+
+		var cfg Config
+		if err := cfg.parseData([]byte(cfgData), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sws := cfg.getStaticScrapeWork()
+		if len(sws) != targetsCount {
+			t.Fatalf("unexpected number of parsed scrape works; got %d; want %d", len(sws), targetsCount)
+		}
+
+		sg.update(sws)
+
+		if len(sg.m) != expectedActive {
+			t.Fatalf("unexpected number of active scrapers; got %d; want %d", len(sg.m), expectedActive)
+		}
+
+		tsmGlobal.mu.Lock()
+		activeForJob := tsmGlobal.upByJob[jobName] + tsmGlobal.downByJob[jobName]
+		tsmGlobal.mu.Unlock()
+		if activeForJob != expectedActive {
+			t.Fatalf("unexpected number of targets registered for job=%s; got %d; want %d", jobName, activeForJob, expectedActive)
+		}
+
+		expectedDropped := targetsCount - expectedActive
+		droppedForJob := 0
+		for _, dt := range droppedTargetsMap.getTargetsList() {
+			if dt.originalLabels.getJob() == jobName && dt.dropReason == targetDropReasonTargetsLimit {
+				droppedForJob++
+			}
+		}
+		if droppedForJob != expectedDropped {
+			t.Fatalf("unexpected number of dropped targets for job=%s; got %d; want %d", jobName, droppedForJob, expectedDropped)
+		}
+	}
+
+	// A job under the limit must be unaffected - all the discovered targets are scraped.
+	f(3, 10, 3)
+
+	// A job over the limit must be truncated down to the limit, with the excess targets
+	// visible in the dropped-targets registry.
+	f(10, 3, 3)
+
+	// The default (target_limit unset) means unlimited - all the discovered targets are scraped
+	// regardless of their count.
+	f(5, 0, 5)
+}
