 	tsm.mu.Unlock()
 }
 
+// tryRegister attempts to register sw as an active target, honoring the per-job
+// MaxScrapeTargets limit, if any.
+//
+// It returns false without registering sw if sw.Config.MaxScrapeTargets is set to a positive value
+// and the number of targets already registered for sw.Config.jobNameOriginal has reached this limit.
+// The check-and-register happens atomically, so this can be safely called concurrently
+// for targets belonging to the same job but discovered by different service discovery mechanisms.
+func (tsm *targetStatusMap) tryRegister(sw *scrapeWork) bool {
+	jobName := sw.Config.jobNameOriginal
+	maxTargets := sw.Config.MaxScrapeTargets
+
+	tsm.mu.Lock()
+	defer tsm.mu.Unlock()
+	if maxTargets > 0 && tsm.upByJob[jobName]+tsm.downByJob[jobName] >= maxTargets {
+		return false
+	}
+	tsm.m[sw] = &targetStatus{
+		sw: sw,
+	}
+	tsm.downByJob[jobName]++
+	return true
+}
+
 func (tsm *targetStatusMap) Unregister(sw *scrapeWork) {
 	jobName := sw.Config.jobNameOriginal
 
