+
+// startScrapersForConfig parses cfgData, starts a scraperGroup with the resulting static scrape targets
+// and returns the group together with a cleanup func which must be called when the test finishes.
+func startScrapersForConfig(t *testing.T, cfgData string) (*scraperGroup, *Config) {
+	t.Helper()
+
+	pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+	globalStopChan = make(chan struct{})
+
+	randName := rand.Int()
+	sg := newScraperGroup(fmt.Sprintf("static_configs_%d", randName), pushData, globalStopChan)
+	t.Cleanup(func() {
+		sg.stop()
+		close(globalStopChan)
+	})
+
+	var cfg Config
+	if err := cfg.parseData([]byte(cfgData), "test-scrape.yaml"); err != nil {
+		t.Fatalf("cannot parse config: %s", err)
+	}
+	sws := cfg.getStaticScrapeWork()
+	sg.update(sws)
+	return sg, &cfg
+}
+
+func countDroppedTargetsForJob(jobName string, reason targetDropReason) int {
+	n := 0
+	for _, dt := range droppedTargetsMap.getTargetsList() {
+		if dt.originalLabels.getJob() == jobName && dt.dropReason == reason {
+			n++
+		}
+	}
+	return n
+}
+
+func TestScraperGroupMaxScrapeTargetsPerJob_UnderLimit(t *testing.T) {
+	jobName := fmt.Sprintf("under-limit-job-%d", rand.Int())
+	cfgData := fmt.Sprintf(`
+scrape_configs:
+- job_name: %s
+  max_scrape_targets_per_job: 5
+  static_configs:
+    - targets:
+        - localhost:8420
+        - localhost:8421
+        - localhost:8422`, jobName)
+	sg, _ := startScrapersForConfig(t, cfgData)
+
+	sg.mLock.Lock()
+	started := len(sg.m)
+	sg.mLock.Unlock()
+	if started != 3 {
+		t.Fatalf("unexpected number of started scrapers; got %d; want 3", started)
+	}
+	if n := countDroppedTargetsForJob(jobName, targetDropReasonMaxTargetsPerJob); n != 0 {
+		t.Fatalf("unexpected number of dropped targets for job under the limit; got %d; want 0", n)
+	}
+}
+
+func TestScraperGroupMaxScrapeTargetsPerJob_OverLimit(t *testing.T) {
+	jobName := fmt.Sprintf("over-limit-job-%d", rand.Int())
+	cfgData := fmt.Sprintf(`
+scrape_configs:
+- job_name: %s
+  max_scrape_targets_per_job: 2
+  static_configs:
+    - targets:
+        - localhost:8420
+        - localhost:8421
+        - localhost:8422
+        - localhost:8423
+        - localhost:8424`, jobName)
+	sg, _ := startScrapersForConfig(t, cfgData)
+
+	sg.mLock.Lock()
+	started := len(sg.m)
+	sg.mLock.Unlock()
+	if started != 2 {
+		t.Fatalf("unexpected number of started scrapers; got %d; want 2 (the configured limit)", started)
+	}
+	if n := countDroppedTargetsForJob(jobName, targetDropReasonMaxTargetsPerJob); n != 3 {
+		t.Fatalf("unexpected number of dropped targets exceeding the limit; got %d; want 3", n)
+	}
+}
+
+func TestScraperGroupMaxScrapeTargetsPerJob_DefaultUnlimited(t *testing.T) {
+	jobName := fmt.Sprintf("unlimited-job-%d", rand.Int())
+	cfgData := fmt.Sprintf(`
+scrape_configs:
+- job_name: %s
+  static_configs:
+    - targets:
+        - localhost:8420
+        - localhost:8421
+        - localhost:8422
+        - localhost:8423
+        - localhost:8424
+        - localhost:8425
+        - localhost:8426
+        - localhost:8427
+        - localhost:8428
+        - localhost:8429`, jobName)
+	sg, _ := startScrapersForConfig(t, cfgData)
+
+	sg.mLock.Lock()
+	started := len(sg.m)
+	sg.mLock.Unlock()
+	if started != 10 {
+		t.Fatalf("unexpected number of started scrapers with no configured limit; got %d; want 10", started)
+	}
+	if n := countDroppedTargetsForJob(jobName, targetDropReasonMaxTargetsPerJob); n != 0 {
+		t.Fatalf("unexpected number of dropped targets for unlimited job; got %d; want 0", n)
+	}
+}
