+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+func TestParseListServersResponse(t *testing.T) {
+	f := func(data string, respExpected *listServersResponse) {
+		t.Helper()
+
+		resp, err := parseListServersResponse([]byte(data))
+		if err != nil {
+			t.Fatalf("unexpected parseListServersResponse() error: %s", err)
+		}
+		if !reflect.DeepEqual(resp, respExpected) {
+			t.Fatalf("unexpected response\ngot\n%v\nwant\n%v", resp, respExpected)
+		}
+	}
+
+	data := `{
+  "servers": [
+    {
+      "id": "11111111-1111-1111-1111-111111111111",
+      "name": "my-instance",
+      "hostname": "my-instance",
+      "state": "running",
+      "commercial_type": "DEV1-S",
+      "arch": "x86_64",
+      "project": "22222222-2222-2222-2222-222222222222",
+      "organization": "33333333-3333-3333-3333-333333333333",
+      "tags": ["env:prod", "app:web"],
+      "private_ip": "10.0.0.1",
+      "public_ip": {
+        "id": "44444444-4444-4444-4444-444444444444",
+        "address": "51.15.0.1",
+        "dynamic": false
+      }
+    }
+  ],
+  "total_count": 1
+}`
+
+	respExpected := &listServersResponse{
+		Servers: []Instance{
+			{
+				ID:             "11111111-1111-1111-1111-111111111111",
+				Name:           "my-instance",
+				Hostname:       "my-instance",
+				State:          "running",
+				CommercialType: "DEV1-S",
+				Arch:           "x86_64",
+				Project:        "22222222-2222-2222-2222-222222222222",
+				Organization:   "33333333-3333-3333-3333-333333333333",
+				Tags:           []string{"env:prod", "app:web"},
+				PrivateIP:      "10.0.0.1",
+				PublicIP: PublicIP{
+					Address: "51.15.0.1",
+				},
+			},
+		},
+		TotalCount: 1,
+	}
+	f(data, respExpected)
+}
+
+func newTestAPIConfig(t *testing.T, apiServer string) *apiConfig {
+	t.Helper()
+
+	client, err := discoveryutil.NewClient(apiServer, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	return &apiConfig{
+		client:    client,
+		zone:      "fr-par-1",
+		secretKey: "secret-token",
+	}
+}
+
+func TestGetInstances_Success(t *testing.T) {
+	var gotAuthToken string
+	s := newMockScalewayServer(func(r *http.Request) []byte {
+		gotAuthToken = r.Header.Get("X-Auth-Token")
+		return []byte(`{
+  "servers": [
+    {
+      "id": "1",
+      "name": "instance-1",
+      "state": "running",
+      "commercial_type": "DEV1-S",
+      "private_ip": "10.0.0.1",
+      "public_ip": {"address": "51.15.0.1"}
+    }
+  ],
+  "total_count": 1
+}`)
+	})
+	defer s.Close()
+
+	cfg := newTestAPIConfig(t, s.URL)
+
+	instances, err := getInstances(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+
+	if gotAuthToken != "secret-token" {
+		t.Fatalf("unexpected X-Auth-Token header; got %q; want %q", gotAuthToken, "secret-token")
+	}
+
+	expectedInstances := []Instance{
+		{
+			ID:             "1",
+			Name:           "instance-1",
+			State:          "running",
+			CommercialType: "DEV1-S",
+			PrivateIP:      "10.0.0.1",
+			PublicIP:       PublicIP{Address: "51.15.0.1"},
+		},
+	}
+	if !reflect.DeepEqual(instances, expectedInstances) {
+		t.Fatalf("unexpected result\ngot\n%#v\nwant\n%#v", instances, expectedInstances)
+	}
+}
+
+func TestGetInstances_Failure(t *testing.T) {
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		return []byte("some error")
+	})
+	defer s.Close()
+
+	cfg := newTestAPIConfig(t, s.URL)
+
+	if _, err := getInstances(cfg); err == nil {
+		t.Fatalf("expecting non-nil error from getInstances()")
+	}
+}
+
+func TestGetInstances_Paging(t *testing.T) {
+	requestCount := 0
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		if requestCount == 0 {
+			requestCount++
+			return []byte(`{
+  "servers": [{"id": "1", "name": "instance-1", "state": "running", "private_ip": "10.0.0.1"}],
+  "total_count": 2
+}`)
+		}
+		return []byte(`{
+  "servers": [{"id": "2", "name": "instance-2", "state": "running", "private_ip": "10.0.0.2"}],
+  "total_count": 2
+}`)
+	})
+	defer s.Close()
+
+	cfg := newTestAPIConfig(t, s.URL)
+
+	instances, err := getInstances(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+
+	expectedInstances := []Instance{
+		{ID: "1", Name: "instance-1", State: "running", PrivateIP: "10.0.0.1"},
+		{ID: "2", Name: "instance-2", State: "running", PrivateIP: "10.0.0.2"},
+	}
+	if !reflect.DeepEqual(instances, expectedInstances) {
+		t.Fatalf("unexpected getInstances() result\ngot\n%#v\nwant\n%#v", instances, expectedInstances)
+	}
+}
diff --git a/lib/promscrape/discovery/scaleway/mock_server_test.go b/lib/promscrape/discovery/scaleway/mock_server_test.go
