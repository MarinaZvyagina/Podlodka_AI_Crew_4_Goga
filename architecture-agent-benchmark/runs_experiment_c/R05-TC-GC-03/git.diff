@@ -0,0 +1,58 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	sdc := &SDConfig{}
+	baseDir := "."
+	if _, err := newAPIConfig(sdc, baseDir); err == nil {
+		t.Fatalf("expecting non-nil error when `secret_key` is missing")
+	}
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		SecretKey: &promauth.Secret{
+			S: "secret-token",
+		},
+	}
+	baseDir := "."
+	cfg, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig() failed with, err: %v", err)
+	}
+	if cfg.zone != "fr-par-1" {
+		t.Fatalf("unexpected default zone; got %q; want %q", cfg.zone, "fr-par-1")
+	}
+	if cfg.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want %d", cfg.port, 80)
+	}
+	if cfg.secretKey != "secret-token" {
+		t.Fatalf("unexpected secretKey; got %q; want %q", cfg.secretKey, "secret-token")
+	}
+}
+
+func TestNewAPIConfig_CustomZoneAndPort(t *testing.T) {
+	sdc := &SDConfig{
+		SecretKey: &promauth.Secret{
+			S: "secret-token",
+		},
+		Zone: "nl-ams-1",
+		Port: 9100,
+	}
+	baseDir := "."
+	cfg, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig() failed with, err: %v", err)
+	}
+	if cfg.zone != "nl-ams-1" {
+		t.Fatalf("unexpected zone; got %q; want %q", cfg.zone, "nl-ams-1")
+	}
+	if cfg.port != 9100 {
+		t.Fatalf("unexpected port; got %d; want %d", cfg.port, 9100)
+	}
+}
diff --git a/lib/promscrape/discovery/scaleway/instance.go b/lib/promscrape/discovery/scaleway/instance.go
new file mode 100644
index 0000000..b4f091b
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/instance.go
@@ -0,0 +1,85 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/url"
+	"strconv"
+)
+
+// instancesPerPage is the maximum page size accepted by the Scaleway Instances API.
+const instancesPerPage = 100
+
+// Instance represents a Scaleway Instance.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-instances-list-all-instances
+type Instance struct {
+	ID             string   `json:"id"`
+	Name           string   `json:"name"`
+	Hostname       string   `json:"hostname"`
+	State          string   `json:"state"`
+	CommercialType string   `json:"commercial_type"`
+	Arch           string   `json:"arch"`
+	Project        string   `json:"project"`
+	Organization   string   `json:"organization"`
+	Tags           []string `json:"tags"`
+	PrivateIP      string   `json:"private_ip"`
+	PublicIP       PublicIP `json:"public_ip"`
+}
+
+// PublicIP represents the public IP address assigned to a Scaleway Instance.
+type PublicIP struct {
+	Address string `json:"address"`
+}
+
+// listServersResponse is the response of the Scaleway `list servers` API.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-instances-list-all-instances
+type listServersResponse struct {
+	Servers    []Instance `json:"servers"`
+	TotalCount int        `json:"total_count"`
+}
+
+// getInstances retrieves all the instances from the Scaleway Instances API for the given cfg.
+func getInstances(cfg *apiConfig) ([]Instance, error) {
+	var instances []Instance
+
+	page := 1
+	for {
+		qp := url.Values{}
+		if cfg.projectID != "" {
+			qp.Set("project", cfg.projectID)
+		}
+		qp.Set("page", strconv.Itoa(page))
+		qp.Set("per_page", strconv.Itoa(instancesPerPage))
+
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?%s", cfg.zone, qp.Encode())
+		data, err := cfg.client.GetAPIResponseWithReqParams(path, func(req *http.Request) {
+			req.Header.Set("X-Auth-Token", cfg.secretKey)
+		})
+		if err != nil {
+			return nil, fmt.Errorf("cannot query scaleway api for instances: %w", err)
+		}
+
+		resp, err := parseListServersResponse(data)
+		if err != nil {
+			return nil, err
+		}
+		instances = append(instances, resp.Servers...)
+
+		if len(resp.Servers) == 0 || len(instances) >= resp.TotalCount {
+			break
+		}
+		page++
+	}
+	return instances, nil
+}
+
+func parseListServersResponse(data []byte) (*listServersResponse, error) {
+	var resp listServersResponse
+	if err := json.Unmarshal(data, &resp); err != nil {
+		return nil, fmt.Errorf("cannot unmarshal listServersResponse from %q: %w", data, err)
+	}
+	return &resp, nil
+}
