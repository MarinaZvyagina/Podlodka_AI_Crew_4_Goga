+)
+
+func TestAddInstanceLabels(t *testing.T) {
+	f := func(instances []Instance, zone string, port int, labelssExpected []*promutil.Labels) {
+		t.Helper()
+
+		labelss := addInstanceLabels(instances, zone, port)
+		discoveryutil.TestEqualLabelss(t, labelss, labelssExpected)
+	}
+
+	instances := []Instance{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "my-instance",
+			Hostname:       "my-instance",
+			State:          "running",
+			CommercialType: "DEV1-S",
+			Arch:           "x86_64",
+			Project:        "22222222-2222-2222-2222-222222222222",
+			Organization:   "33333333-3333-3333-3333-333333333333",
+			Tags:           []string{"env:prod", "app:web"},
+			PrivateIP:      "10.0.0.1",
+			PublicIP: PublicIP{
+				Address: "51.15.0.1",
+			},
+		},
+		{
+			// stopped instance without any IP address must be skipped.
+			ID:    "44444444-4444-4444-4444-444444444444",
+			Name:  "stopped-instance",
+			State: "stopped",
+		},
+	}
+
+	labelssExpected := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "51.15.0.1:9100",
+			"__meta_scaleway_instance_id":              "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":            "my-instance",
+			"__meta_scaleway_instance_hostname":        "my-instance",
+			"__meta_scaleway_instance_state":           "running",
+			"__meta_scaleway_instance_zone":            "fr-par-1",
+			"__meta_scaleway_instance_type":            "DEV1-S",
+			"__meta_scaleway_instance_arch":            "x86_64",
+			"__meta_scaleway_instance_project_id":      "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_organization_id": "33333333-3333-3333-3333-333333333333",
+			"__meta_scaleway_instance_public_ipv4":     "51.15.0.1",
+			"__meta_scaleway_instance_private_ipv4":    "10.0.0.1",
+			"__meta_scaleway_instance_tags":            ",env:prod,app:web,",
+		}),
+	}
+	f(instances, "fr-par-1", 9100, labelssExpected)
+}
+
+func TestAddInstanceLabels_PrivateIPFallback(t *testing.T) {
+	instances := []Instance{
+		{
+			ID:        "1",
+			Name:      "private-only",
+			State:     "running",
+			PrivateIP: "10.0.0.5",
+		},
+	}
+	labelssExpected := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "10.0.0.5:80",
+			"__meta_scaleway_instance_id":              "1",
+			"__meta_scaleway_instance_name":            "private-only",
+			"__meta_scaleway_instance_hostname":        "",
+			"__meta_scaleway_instance_state":           "running",
+			"__meta_scaleway_instance_zone":            "fr-par-1",
+			"__meta_scaleway_instance_type":            "",
+			"__meta_scaleway_instance_arch":            "",
+			"__meta_scaleway_instance_project_id":      "",
+			"__meta_scaleway_instance_organization_id": "",
+			"__meta_scaleway_instance_public_ipv4":     "",
+			"__meta_scaleway_instance_private_ipv4":    "10.0.0.5",
+		}),
+	}
+	labelss := addInstanceLabels(instances, "fr-par-1", 80)
+	discoveryutil.TestEqualLabelss(t, labelss, labelssExpected)
+}
