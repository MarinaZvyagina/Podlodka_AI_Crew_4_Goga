new file mode 100644
index 0000000..9c2d4c4
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway.go
@@ -0,0 +1,102 @@
+package scaleway
+
+import (
+	"flag"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/proxy"
+)
+
+// SDCheckInterval defines interval for Scaleway targets refresh.
+var SDCheckInterval = flag.Duration("promscrape.scalewaySDCheckInterval", 30*time.Second, "Interval for checking for changes in Scaleway. "+
+	"This works only if scaleway_sd_configs is configured in '-promscrape.config' file. "+
+	"See https://docs.victoriametrics.com/victoriametrics/sd_configs/#scaleway_sd_configs for details")
+
+// SDConfig represents service discovery config for Scaleway Instances.
+//
+// See: https://www.scaleway.com/en/developers/api/instance/#path-instances-list-all-instances
+type SDConfig struct {
+	// APIURL is the Scaleway API server to query. Defaults to https://api.scaleway.com.
+	APIURL string `yaml:"api_url,omitempty"`
+
+	// SecretKey is the Scaleway API secret key (mandatory), sent as the `X-Auth-Token` header
+	// on every request. See https://www.scaleway.com/en/docs/identity-and-access-management/iam/how-to/create-api-keys/
+	SecretKey *promauth.Secret `yaml:"secret_key"`
+
+	// ProjectID limits discovery to instances belonging to the given Scaleway project (optional).
+	ProjectID string `yaml:"project_id,omitempty"`
+
+	// Zone is the Scaleway zone to query, e.g. `fr-par-1`. Defaults to `fr-par-1`.
+	Zone string `yaml:"zone,omitempty"`
+
+	// The port to scrape metrics from. Defaults to 80.
+	Port int `yaml:"port,omitempty"`
+
+	// General HTTP / Auth / Proxy configs.
+	HTTPClientConfig  promauth.HTTPClientConfig  `yaml:",inline"`
+	ProxyURL          *proxy.URL                 `yaml:"proxy_url,omitempty"`
+	ProxyClientConfig promauth.ProxyClientConfig `yaml:",inline"`
+
+	// refresh_interval is obtained from `-promscrape.scalewaySDCheckInterval` command-line option.
+}
+
+// GetLabels returns Scaleway instance labels according to sdc.
+func (sdc *SDConfig) GetLabels(baseDir string) ([]*promutil.Labels, error) {
+	cfg, err := getAPIConfig(sdc, baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot get API config: %w", err)
+	}
+	instances, err := getInstances(cfg)
+	if err != nil {
+		return nil, err
+	}
+	return addInstanceLabels(instances, cfg.zone, cfg.port), nil
+}
+
+// MustStop stops further usage for sdc.
+func (sdc *SDConfig) MustStop() {
+	v := configMap.Delete(sdc)
+	if v != nil {
+		cfg := v.(*apiConfig)
+		cfg.client.Stop()
+	}
+}
+
+// addInstanceLabels returns labels for the given Scaleway instances.
+func addInstanceLabels(instances []Instance, zone string, port int) []*promutil.Labels {
+	ms := make([]*promutil.Labels, 0, len(instances))
+	for _, inst := range instances {
+		addr := inst.PublicIP.Address
+		if addr == "" {
+			addr = inst.PrivateIP
+		}
+		if addr == "" {
+			// Skip instances without any usable IP address, e.g. stopped instances.
+			continue
+		}
+
+		m := promutil.NewLabels(16)
+		m.Add("__address__", discoveryutil.JoinHostPort(addr, port))
+		m.Add("__meta_scaleway_instance_id", inst.ID)
+		m.Add("__meta_scaleway_instance_name", inst.Name)
+		m.Add("__meta_scaleway_instance_hostname", inst.Hostname)
+		m.Add("__meta_scaleway_instance_state", inst.State)
+		m.Add("__meta_scaleway_instance_zone", zone)
+		m.Add("__meta_scaleway_instance_type", inst.CommercialType)
+		m.Add("__meta_scaleway_instance_arch", inst.Arch)
+		m.Add("__meta_scaleway_instance_project_id", inst.Project)
+		m.Add("__meta_scaleway_instance_organization_id", inst.Organization)
+		m.Add("__meta_scaleway_instance_public_ipv4", inst.PublicIP.Address)
+		m.Add("__meta_scaleway_instance_private_ipv4", inst.PrivateIP)
+		if len(inst.Tags) > 0 {
+			m.Add("__meta_scaleway_instance_tags", ","+strings.Join(inst.Tags, ",")+",")
+		}
+		ms = append(ms, m)
+	}
+	return ms
+}
