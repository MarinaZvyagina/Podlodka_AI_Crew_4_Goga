index 0000000..53d2965
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api_test.go
@@ -0,0 +1,99 @@
+package scaleway
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestParseAPIResponse(t *testing.T) {
+	f := func(data string, responseExpected *listServersResponse) {
+		t.Helper()
+
+		resp, err := parseAPIResponse([]byte(data))
+		if err != nil {
+			t.Fatalf("unexpected parseAPIResponse() error: %s", err)
+		}
+		if !reflect.DeepEqual(resp, responseExpected) {
+			t.Fatalf("unexpected response\ngot\n%v\nwant\n%v", resp, responseExpected)
+		}
+	}
+
+	data := `
+{
+  "servers": [
+    {
+      "id": "11111111-1111-1111-1111-111111111111",
+      "name": "my-server",
+      "state": "running",
+      "commercial_type": "DEV1-S",
+      "zone": "fr-par-1",
+      "project": "22222222-2222-2222-2222-222222222222",
+      "tags": ["tag1", "tag2"],
+      "public_ip": {
+        "address": "51.15.0.1"
+      },
+      "private_ip": "10.0.0.1"
+    }
+  ],
+  "total_count": 1
+}`
+
+	privateIP := "10.0.0.1"
+	responseExpected := &listServersResponse{
+		Servers: []instance{
+			{
+				ID:             "11111111-1111-1111-1111-111111111111",
+				Name:           "my-server",
+				State:          "running",
+				CommercialType: "DEV1-S",
+				Zone:           "fr-par-1",
+				Project:        "22222222-2222-2222-2222-222222222222",
+				Tags:           []string{"tag1", "tag2"},
+				PublicIP:       &instanceIP{Address: "51.15.0.1"},
+				PrivateIP:      &privateIP,
+			},
+		},
+		TotalCount: 1,
+	}
+	f(data, responseExpected)
+}
+
+func TestGetInstancesPaginated(t *testing.T) {
+	cfg := &apiConfig{
+		zone: "fr-par-1",
+	}
+
+	page1 := `{
+  "servers": [
+    {"id": "1", "name": "srv-1", "state": "running", "public_ip": {"address": "1.1.1.1"}},
+    {"id": "2", "name": "srv-2", "state": "running", "public_ip": {"address": "1.1.1.2"}}
+  ],
+  "total_count": 3
+}`
+	page2 := `{
+  "servers": [
+    {"id": "3", "name": "srv-3", "state": "stopped", "public_ip": {"address": "1.1.1.3"}}
+  ],
+  "total_count": 3
+}`
+
+	calls := 0
+	instances, err := getInstancesWithFetcher(cfg, func(path string) ([]byte, error) {
+		calls++
+		switch calls {
+		case 1:
+			return []byte(page1), nil
+		case 2:
+			return []byte(page2), nil
+		default:
+			t.Fatalf("unexpected extra fetch call for path %q", path)
+			return nil, nil
+		}
+	})
+	if err != nil {
+		t.Fatalf("unexpected getInstances() error: %s", err)
+	}
+	if len(instances) != 3 {
+		t.Fatalf("unexpected instances count; got %d; want 3\ninstances:\n%v", len(instances), instances)
+	}
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway.go b/lib/promscrape/discovery/scaleway/scaleway.go
new file mode 100644
index 0000000..003b971
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway.go
@@ -0,0 +1,137 @@
+package scaleway
+
+import (
+	"flag"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/proxy"
+)
+
+// SDCheckInterval defines interval for targets refresh.
+var SDCheckInterval = flag.Duration("promscrape.scalewaySDCheckInterval", time.Minute, "Interval for checking for changes in Scaleway Instances API. "+
+	"This works only if scaleway_sd_configs is configured in '-promscrape.config' file. "+
+	"See https://docs.victoriametrics.com/victoriametrics/sd_configs/#scaleway_sd_configs for details")
+
+// SDConfig represents service discovery config for Scaleway Instances.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+//
+// Authentication is configured the same way as for other cloud-provider SD configs, e.g. via
+// the `headers` option (`headers: ["X-Auth-Token: <secret_key>"]`), since Scaleway's Instances
+// API authenticates via a plain `X-Auth-Token` header rather than an OAuth2/Bearer scheme.
+type SDConfig struct {
+	// Server is an optional Scaleway API server to query. By default, https://api.scaleway.com is used.
+	Server string `yaml:"server,omitempty"`
+
+	// Zone is the Scaleway zone to discover Instances in, e.g. "fr-par-1". Defaults to "fr-par-1".
+	Zone string `yaml:"zone,omitempty"`
+
+	// Project is an optional Scaleway project ID to filter discovered Instances by.
+	Project string `yaml:"project,omitempty"`
+
+	HTTPClientConfig  promauth.HTTPClientConfig  `yaml:",inline"`
+	ProxyURL          *proxy.URL                 `yaml:"proxy_url,omitempty"`
+	ProxyClientConfig promauth.ProxyClientConfig `yaml:",inline"`
+
+	// Port is the port to scrape metrics from. Default 80.
+	Port int `yaml:"port,omitempty"`
+}
+
+// GetLabels returns Scaleway Instance labels according to sdc.
+func (sdc *SDConfig) GetLabels(baseDir string) ([]*promutil.Labels, error) {
+	cfg, err := getAPIConfig(sdc, baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot get API config: %w", err)
+	}
+	instances, err := getInstances(cfg)
+	if err != nil {
+		return nil, err
+	}
+	return addInstanceLabels(instances, cfg.port), nil
+}
+
+// MustStop stops further usage for sdc.
+func (sdc *SDConfig) MustStop() {
+	v := configMap.Delete(sdc)
+	if v != nil {
+		cfg := v.(*apiConfig)
+		cfg.client.Stop()
+	}
+}
+
+// instance represents a Scaleway Instance server object.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type instance struct {
+	ID             string      `json:"id"`
+	Name           string      `json:"name"`
+	State          string      `json:"state"`
+	CommercialType string      `json:"commercial_type"`
+	Zone           string      `json:"zone"`
+	Project        string      `json:"project"`
+	Tags           []string    `json:"tags"`
+	PublicIP       *instanceIP `json:"public_ip"`
+	PrivateIP      *string     `json:"private_ip"`
+}
+
+type instanceIP struct {
+	Address string `json:"address"`
+}
+
+// listServersResponse is the response of the Scaleway "list servers" API.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type listServersResponse struct {
+	Servers    []instance `json:"servers"`
+	TotalCount int        `json:"total_count"`
+}
+
+const instanceStateRunning = "running"
+
+func addInstanceLabels(instances []instance, defaultPort int) []*promutil.Labels {
+	ms := make([]*promutil.Labels, 0, len(instances))
+	for _, inst := range instances {
+		if inst.State != instanceStateRunning {
+			continue
+		}
+
+		var publicIPv4 string
+		if inst.PublicIP != nil {
+			publicIPv4 = inst.PublicIP.Address
+		}
+		var privateIPv4 string
+		if inst.PrivateIP != nil {
+			privateIPv4 = *inst.PrivateIP
+		}
+
+		addrIP := publicIPv4
+		if addrIP == "" {
+			addrIP = privateIPv4
+		}
+		if addrIP == "" {
+			continue
+		}
+
+		m := promutil.NewLabels(10)
+		m.Add("__address__", discoveryutil.JoinHostPort(addrIP, defaultPort))
+		m.Add("__meta_scaleway_instance_id", inst.ID)
+		m.Add("__meta_scaleway_instance_name", inst.Name)
+		m.Add("__meta_scaleway_instance_status", inst.State)
+		m.Add("__meta_scaleway_instance_type", inst.CommercialType)
+		m.Add("__meta_scaleway_zone", inst.Zone)
+		m.Add("__meta_scaleway_project_id", inst.Project)
+		m.Add("__meta_scaleway_public_ipv4", publicIPv4)
+		m.Add("__meta_scaleway_private_ipv4", privateIPv4)
+		if len(inst.Tags) > 0 {
+			tags := fmt.Sprintf(",%s,", strings.Join(inst.Tags, ","))
+			m.Add("__meta_scaleway_tags", tags)
+		}
+		ms = append(ms, m)
+	}
+	return ms
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway_test.go b/lib/promscrape/discovery/scaleway/scaleway_test.go
new file mode 100644
index 0000000..90d367c
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway_test.go
@@ -0,0 +1,98 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func TestAddInstanceLabels(t *testing.T) {
+	f := func(instances []instance, labelssExpected []*promutil.Labels) {
+		t.Helper()
+
+		labelss := addInstanceLabels(instances, 9100)
+		discoveryutil.TestEqualLabelss(t, labelss, labelssExpected)
+	}
+
+	privateIP := "10.10.10.10"
+
+	// instance with both public and private IPv4, tags present
+	instances := []instance{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "my-server",
+			State:          "running",
+			CommercialType: "DEV1-S",
+			Zone:           "fr-par-1",
+			Project:        "22222222-2222-2222-2222-222222222222",
+			Tags:           []string{"web", "prod"},
+			PublicIP:       &instanceIP{Address: "100.100.100.100"},
+			PrivateIP:      &privateIP,
+		},
+	}
+	labelssExpected := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                     "100.100.100.100:9100",
+			"__meta_scaleway_instance_id":     "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":   "my-server",
+			"__meta_scaleway_instance_status": "running",
+			"__meta_scaleway_instance_type":   "DEV1-S",
+			"__meta_scaleway_zone":            "fr-par-1",
+			"__meta_scaleway_project_id":      "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_public_ipv4":     "100.100.100.100",
+			"__meta_scaleway_private_ipv4":    "10.10.10.10",
+			"__meta_scaleway_tags":            ",web,prod,",
+		}),
+	}
+	f(instances, labelssExpected)
+
+	// instance with only a private IPv4 (no public IP, no tags): __address__ falls back to private IP
+	instances = []instance{
+		{
+			ID:             "33333333-3333-3333-3333-333333333333",
+			Name:           "internal-only",
+			State:          "running",
+			CommercialType: "DEV1-M",
+			Zone:           "nl-ams-1",
+			Project:        "44444444-4444-4444-4444-444444444444",
+			PrivateIP:      &privateIP,
+		},
+	}
+	labelssExpected = []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                     "10.10.10.10:9100",
+			"__meta_scaleway_instance_id":     "33333333-3333-3333-3333-333333333333",
+			"__meta_scaleway_instance_name":   "internal-only",
+			"__meta_scaleway_instance_status": "running",
+			"__meta_scaleway_instance_type":   "DEV1-M",
+			"__meta_scaleway_zone":            "nl-ams-1",
+			"__meta_scaleway_project_id":      "44444444-4444-4444-4444-444444444444",
+			"__meta_scaleway_public_ipv4":     "",
+			"__meta_scaleway_private_ipv4":    "10.10.10.10",
+		}),
+	}
+	f(instances, labelssExpected)
+
+	// stopped instance is skipped entirely
+	instances = []instance{
+		{
+			ID:        "55555555-5555-5555-5555-555555555555",
+			Name:      "stopped-server",
+			State:     "stopped",
+			PublicIP:  &instanceIP{Address: "100.100.100.200"},
+			PrivateIP: &privateIP,
+		},
+	}
+	f(instances, nil)
+
+	// running instance with no IPs at all is skipped (nothing to scrape)
+	instances = []instance{
+		{
+			ID:    "66666666-6666-6666-6666-666666666666",
+			Name:  "no-ip-server",
+			State: "running",
+		},
+	}
+	f(instances, nil)
+}
