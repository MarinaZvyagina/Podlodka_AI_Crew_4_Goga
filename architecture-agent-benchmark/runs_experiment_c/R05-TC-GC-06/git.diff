diff --git a/lib/promscrape/discovery/scaleway/api.go b/lib/promscrape/discovery/scaleway/api.go
new file mode 100644
index 0000000..d0258b9
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api.go
@@ -0,0 +1,130 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/url"
+	"strconv"
+	"strings"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+var configMap = discoveryutil.NewConfigMap()
+
+const defaultZone = "fr-par-1"
+
+// perPage is the maximum page size accepted by the Scaleway Instances API.
+const perPage = 100
+
+type apiConfig struct {
+	client *discoveryutil.Client
+	port   int
+
+	zone    string
+	project string
+}
+
+func newAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	ac, err := sdc.HTTPClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse auth config: %w", err)
+	}
+
+	apiServer := sdc.Server
+	if apiServer == "" {
+		apiServer = "https://api.scaleway.com"
+	}
+	if !strings.Contains(apiServer, "://") {
+		scheme := "http"
+		if sdc.HTTPClientConfig.TLSConfig != nil {
+			scheme = "https"
+		}
+		apiServer = scheme + "://" + apiServer
+	}
+	proxyAC, err := sdc.ProxyClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse proxy auth config: %w", err)
+	}
+	client, err := discoveryutil.NewClient(apiServer, ac, sdc.ProxyURL, proxyAC, &sdc.HTTPClientConfig)
+	if err != nil {
+		return nil, fmt.Errorf("cannot create HTTP client for %q: %w", apiServer, err)
+	}
+
+	zone := sdc.Zone
+	if zone == "" {
+		zone = defaultZone
+	}
+
+	port := sdc.Port
+	if port == 0 {
+		port = 80
+	}
+
+	cfg := &apiConfig{
+		client:  client,
+		port:    port,
+		zone:    zone,
+		project: sdc.Project,
+	}
+	return cfg, nil
+}
+
+func getAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	v, err := configMap.Get(sdc, func() (any, error) { return newAPIConfig(sdc, baseDir) })
+	if err != nil {
+		return nil, err
+	}
+	return v.(*apiConfig), nil
+}
+
+func serversAPIPath(zone string) string {
+	return fmt.Sprintf("/instance/v1/zones/%s/servers", zone)
+}
+
+// getInstances fetches the full, paginated list of Instances for cfg's zone (and project, if set)
+// from the Scaleway Instances API.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+func getInstances(cfg *apiConfig) ([]instance, error) {
+	return getInstancesWithFetcher(cfg, cfg.client.GetAPIResponse)
+}
+
+// getInstancesWithFetcher is getInstances with an injectable getAPIResponse, for testing without a live API.
+func getInstancesWithFetcher(cfg *apiConfig, getAPIResponse func(string) ([]byte, error)) ([]instance, error) {
+	var instances []instance
+
+	page := 1
+	for {
+		qp := url.Values{}
+		qp.Set("page", strconv.Itoa(page))
+		qp.Set("per_page", strconv.Itoa(perPage))
+		if cfg.project != "" {
+			qp.Set("project", cfg.project)
+		}
+		path := serversAPIPath(cfg.zone) + "?" + qp.Encode()
+
+		data, err := getAPIResponse(path)
+		if err != nil {
+			return nil, fmt.Errorf("cannot fetch data from scaleway list servers api: %w", err)
+		}
+		resp, err := parseAPIResponse(data)
+		if err != nil {
+			return nil, err
+		}
+		instances = append(instances, resp.Servers...)
+		if len(instances) >= resp.TotalCount || len(resp.Servers) == 0 {
+			break
+		}
+		page++
+	}
+	return instances, nil
+}
+
+func parseAPIResponse(data []byte) (*listServersResponse, error) {
+	var resp listServersResponse
+	if err := json.Unmarshal(data, &resp); err != nil {
+		return nil, fmt.Errorf("failed to parse scaleway api response: %q, err: %w", data, err)
+	}
+	return &resp, nil
+}
