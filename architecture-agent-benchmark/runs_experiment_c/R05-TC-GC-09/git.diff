diff --git a/lib/promscrape/discovery/scaleway/api.go b/lib/promscrape/discovery/scaleway/api.go
new file mode 100644
index 0000000..0ee7780
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api.go
@@ -0,0 +1,107 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/url"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+var configMap = discoveryutil.NewConfigMap()
+
+const defaultZone = "fr-par-1"
+
+// perPage is the maximum number of servers requested per page.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+const perPage = 100
+
+type apiConfig struct {
+	client  *discoveryutil.Client
+	project string
+	zone    string
+	port    int
+}
+
+func getAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	v, err := configMap.Get(sdc, func() (any, error) { return newAPIConfig(sdc, baseDir) })
+	if err != nil {
+		return nil, err
+	}
+	return v.(*apiConfig), nil
+}
+
+func newAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	if sdc.Project == "" {
+		return nil, fmt.Errorf("missing `project_id` in `scaleway_sd_config`")
+	}
+
+	hcc := sdc.HTTPClientConfig
+	if sdc.SecretKey != nil {
+		hcc.Headers = append(hcc.Headers, "X-Auth-Token: "+sdc.SecretKey.String())
+	}
+	ac, err := hcc.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse auth config: %w", err)
+	}
+
+	apiServer := sdc.APIURL
+	if apiServer == "" {
+		apiServer = "https://api.scaleway.com"
+	}
+	proxyAC, err := sdc.ProxyClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse proxy auth config: %w", err)
+	}
+	client, err := discoveryutil.NewClient(apiServer, ac, sdc.ProxyURL, proxyAC, &hcc)
+	if err != nil {
+		return nil, fmt.Errorf("cannot create HTTP client for %q: %w", apiServer, err)
+	}
+
+	zone := sdc.Zone
+	if zone == "" {
+		zone = defaultZone
+	}
+	port := sdc.Port
+	if port == 0 {
+		port = 80
+	}
+	cfg := &apiConfig{
+		client:  client,
+		project: sdc.Project,
+		zone:    zone,
+		port:    port,
+	}
+	return cfg, nil
+}
+
+func getServers(cfg *apiConfig) ([]server, error) {
+	var servers []server
+	page := 1
+	for {
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?project=%s&page=%d&per_page=%d",
+			url.PathEscape(cfg.zone), url.QueryEscape(cfg.project), page, perPage)
+		data, err := cfg.client.GetAPIResponse(path)
+		if err != nil {
+			return nil, fmt.Errorf("cannot fetch scaleway servers: %w", err)
+		}
+		resp, err := parseAPIResponse(data)
+		if err != nil {
+			return nil, err
+		}
+		servers = append(servers, resp.Servers...)
+		if len(resp.Servers) < perPage {
+			return servers, nil
+		}
+		page++
+	}
+}
+
+func parseAPIResponse(data []byte) (*listServersResponse, error) {
+	var lsr listServersResponse
+	if err := json.Unmarshal(data, &lsr); err != nil {
+		return nil, fmt.Errorf("failed to parse scaleway api response: %q, err: %w", data, err)
+	}
+	return &lsr, nil
+}
diff --git a/lib/promscrape/discovery/scaleway/api_test.go b/lib/promscrape/discovery/scaleway/api_test.go
new file mode 100644
index 0000000..e3f004b
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api_test.go
@@ -0,0 +1,131 @@
+package scaleway
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+)
+
+func TestParseAPIResponse(t *testing.T) {
+	f := func(data string, responseExpected *listServersResponse) {
+		t.Helper()
+
+		response, err := parseAPIResponse([]byte(data))
+		if err != nil {
+			t.Fatalf("unexpected parseAPIResponse() error: %s", err)
+		}
+		if !reflect.DeepEqual(response, responseExpected) {
+			t.Fatalf("unexpected response\ngot\n%+v\nwant\n%+v", response, responseExpected)
+		}
+	}
+
+	data := `
+{
+  "servers": [
+    {
+      "id": "11111111-1111-1111-1111-111111111111",
+      "name": "example",
+      "project": "22222222-2222-2222-2222-222222222222",
+      "commercial_type": "DEV1-S",
+      "state": "running",
+      "zone": "fr-par-1",
+      "tags": ["tag1", "tag2"],
+      "private_ip": "10.10.10.10",
+      "public_ip": {
+        "id": "33333333-3333-3333-3333-333333333333",
+        "address": "100.100.100.100"
+      },
+      "ipv6": {
+        "address": "::1"
+      }
+    }
+  ]
+}`
+
+	responseExpected := &listServersResponse{
+		Servers: []server{
+			{
+				ID:             "11111111-1111-1111-1111-111111111111",
+				Name:           "example",
+				Project:        "22222222-2222-2222-2222-222222222222",
+				CommercialType: "DEV1-S",
+				State:          "running",
+				Zone:           "fr-par-1",
+				Tags:           []string{"tag1", "tag2"},
+				PrivateIP:      "10.10.10.10",
+				PublicIP: &serverPublicIP{
+					Address: "100.100.100.100",
+				},
+				IPv6: &serverIPv6{
+					Address: "::1",
+				},
+			},
+		},
+	}
+	f(data, responseExpected)
+}
+
+func TestGetServersPagination(t *testing.T) {
+	// emulate a Scaleway API server that returns servers paginated across full pages,
+	// stopping once a page comes back with fewer than perPage entries.
+	pageResponse := func(n int) string {
+		var body string
+		for i := 0; i < n; i++ {
+			if i > 0 {
+				body += ","
+			}
+			body += fmt.Sprintf(`{"id":"srv-%d","name":"srv-%d","state":"running","private_ip":"10.0.0.%d"}`, i, i, i+1)
+		}
+		return `{"servers":[` + body + `]}`
+	}
+
+	requestedPages := make(map[string]bool)
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if got := r.Header.Get("X-Auth-Token"); got != "secret-token" {
+			t.Errorf("unexpected X-Auth-Token header; got %q", got)
+		}
+		page := r.URL.Query().Get("page")
+		requestedPages[page] = true
+		w.Header().Set("Content-Type", "application/json")
+		switch page {
+		case "1":
+			_, _ = w.Write([]byte(pageResponse(perPage)))
+		default:
+			_, _ = w.Write([]byte(pageResponse(1)))
+		}
+	}))
+	defer ts.Close()
+
+	sdc := &SDConfig{
+		Project:   "project-1",
+		Zone:      "fr-par-1",
+		APIURL:    ts.URL,
+		SecretKey: promauth.NewSecret("secret-token"),
+	}
+	cfg, err := newAPIConfig(sdc, ".")
+	if err != nil {
+		t.Fatalf("unexpected newAPIConfig() error: %s", err)
+	}
+
+	servers, err := getServers(cfg)
+	if err != nil {
+		t.Fatalf("unexpected getServers() error: %s", err)
+	}
+	if len(servers) != perPage+1 {
+		t.Fatalf("unexpected servers count; got %d; want %d", len(servers), perPage+1)
+	}
+	if !requestedPages["1"] || !requestedPages["2"] {
+		t.Fatalf("expected both page 1 and page 2 to be requested; got %v", requestedPages)
+	}
+}
+
+func TestNewAPIConfigMissingProject(t *testing.T) {
+	sdc := &SDConfig{}
+	if _, err := newAPIConfig(sdc, "."); err == nil {
+		t.Fatalf("expected error for missing project_id, got nil")
+	}
+}
