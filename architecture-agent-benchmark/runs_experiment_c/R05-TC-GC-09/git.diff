@@ -0,0 +1,139 @@
+package scaleway
+
+import (
+	"flag"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/proxy"
+)
+
+// SDCheckInterval defines interval for targets refresh.
+var SDCheckInterval = flag.Duration("promscrape.scalewaySDCheckInterval", 30*time.Second, "Interval for checking for changes in Scaleway API. "+
+	"This works only if scaleway_sd_configs is configured in '-promscrape.config' file. "+
+	"See https://docs.victoriametrics.com/victoriametrics/sd_configs/#scaleway_sd_configs for details")
+
+// SDConfig represents service discovery config for Scaleway Instances.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type SDConfig struct {
+	// Project is the id of the Scaleway project to discover Instances in.
+	Project string `yaml:"project_id"`
+
+	// Zone is the Scaleway zone to query Instances from, e.g. "fr-par-1".
+	// By default, "fr-par-1" is used.
+	Zone string `yaml:"zone,omitempty"`
+
+	// APIURL is an optional Scaleway API server to query.
+	// By default, https://api.scaleway.com is used.
+	APIURL string `yaml:"api_url,omitempty"`
+
+	// SecretKey is the Scaleway API secret key used for authenticating requests
+	// to the Scaleway API via the `X-Auth-Token` request header.
+	SecretKey *promauth.Secret `yaml:"secret_key,omitempty"`
+
+	// Port is an optional port to scrape metrics from. By default, port 80 is used.
+	Port int `yaml:"port,omitempty"`
+
+	HTTPClientConfig  promauth.HTTPClientConfig  `yaml:",inline"`
+	ProxyURL          *proxy.URL                 `yaml:"proxy_url,omitempty"`
+	ProxyClientConfig promauth.ProxyClientConfig `yaml:",inline"`
+
+	// refresh_interval is obtained from `-promscrape.scalewaySDCheckInterval` command-line option.
+}
+
+// GetLabels returns Scaleway Instance labels according to sdc.
+func (sdc *SDConfig) GetLabels(baseDir string) ([]*promutil.Labels, error) {
+	cfg, err := getAPIConfig(sdc, baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot get API config: %w", err)
+	}
+	servers, err := getServers(cfg)
+	if err != nil {
+		return nil, err
+	}
+	return addServerLabels(servers, cfg.project, cfg.port), nil
+}
+
+// MustStop stops further usage for sdc.
+func (sdc *SDConfig) MustStop() {
+	v := configMap.Delete(sdc)
+	if v != nil {
+		cfg := v.(*apiConfig)
+		cfg.client.Stop()
+	}
+}
+
+// https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type listServersResponse struct {
+	Servers []server `json:"servers"`
+}
+
+type server struct {
+	ID             string          `json:"id"`
+	Name           string          `json:"name"`
+	Project        string          `json:"project"`
+	CommercialType string          `json:"commercial_type"`
+	State          string          `json:"state"`
+	Zone           string          `json:"zone"`
+	Tags           []string        `json:"tags"`
+	PrivateIP      string          `json:"private_ip"`
+	PublicIP       *serverPublicIP `json:"public_ip"`
+	IPv6           *serverIPv6     `json:"ipv6"`
+}
+
+type serverPublicIP struct {
+	Address string `json:"address"`
+}
+
+type serverIPv6 struct {
+	Address string `json:"address"`
+}
+
+func addServerLabels(servers []server, defaultProject string, defaultPort int) []*promutil.Labels {
+	ms := make([]*promutil.Labels, 0, len(servers))
+	for _, srv := range servers {
+		// Skip instances, which aren't running - they have no reachable address to scrape.
+		if srv.State != "running" {
+			continue
+		}
+		addr := srv.PrivateIP
+		if addr == "" && srv.PublicIP != nil {
+			addr = srv.PublicIP.Address
+		}
+		if addr == "" {
+			continue
+		}
+
+		project := srv.Project
+		if project == "" {
+			project = defaultProject
+		}
+
+		m := promutil.NewLabels(16)
+		m.Add("__address__", discoveryutil.JoinHostPort(addr, defaultPort))
+		m.Add("__meta_scaleway_instance_id", srv.ID)
+		m.Add("__meta_scaleway_instance_name", srv.Name)
+		m.Add("__meta_scaleway_instance_status", srv.State)
+		m.Add("__meta_scaleway_instance_type", srv.CommercialType)
+		m.Add("__meta_scaleway_instance_zone", srv.Zone)
+		m.Add("__meta_scaleway_project_id", project)
+		m.Add("__meta_scaleway_private_ipv4", srv.PrivateIP)
+		if srv.PublicIP != nil {
+			m.Add("__meta_scaleway_public_ipv4", srv.PublicIP.Address)
+		}
+		if srv.IPv6 != nil {
+			m.Add("__meta_scaleway_public_ipv6", srv.IPv6.Address)
+		}
+		if len(srv.Tags) > 0 {
+			tags := fmt.Sprintf(",%s,", strings.Join(srv.Tags, ","))
+			m.Add("__meta_scaleway_instance_tags", tags)
+		}
+		ms = append(ms, m)
+	}
+	return ms
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway_test.go b/lib/promscrape/discovery/scaleway/scaleway_test.go
new file mode 100644
index 0000000..99add78
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway_test.go
@@ -0,0 +1,100 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func TestAddServerLabels(t *testing.T) {
+	f := func(servers []server, defaultProject string, labelssExpected []*promutil.Labels) {
+		t.Helper()
+
+		labelss := addServerLabels(servers, defaultProject, 9100)
+		discoveryutil.TestEqualLabelss(t, labelss, labelssExpected)
+	}
+
+	// base labels add test
+	servers := []server{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "instance-1",
+			Project:        "22222222-2222-2222-2222-222222222222",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Zone:           "fr-par-1",
+			Tags:           []string{"env-prod", "app-vmagent"},
+			PrivateIP:      "10.10.10.10",
+			PublicIP: &serverPublicIP{
+				Address: "100.100.100.100",
+			},
+			IPv6: &serverIPv6{
+				Address: "::1",
+			},
+		},
+	}
+	labelssExpected := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                     "10.10.10.10:9100",
+			"__meta_scaleway_instance_id":     "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":   "instance-1",
+			"__meta_scaleway_instance_status": "running",
+			"__meta_scaleway_instance_type":   "DEV1-S",
+			"__meta_scaleway_instance_zone":   "fr-par-1",
+			"__meta_scaleway_project_id":      "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_private_ipv4":    "10.10.10.10",
+			"__meta_scaleway_public_ipv4":     "100.100.100.100",
+			"__meta_scaleway_public_ipv6":     "::1",
+			"__meta_scaleway_instance_tags":   ",env-prod,app-vmagent,",
+		}),
+	}
+	f(servers, "default-project", labelssExpected)
+
+	// non-running instances are skipped
+	servers = []server{
+		{
+			ID:    "11111111-1111-1111-1111-111111111111",
+			Name:  "instance-1",
+			State: "stopped",
+			PublicIP: &serverPublicIP{
+				Address: "100.100.100.100",
+			},
+		},
+	}
+	f(servers, "default-project", nil)
+
+	// missing project falls back to defaultProject and no public/private ip are skipped
+	servers = []server{
+		{
+			ID:        "11111111-1111-1111-1111-111111111111",
+			Name:      "instance-1",
+			State:     "running",
+			Zone:      "nl-ams-1",
+			PrivateIP: "10.10.10.20",
+		},
+	}
+	labelssExpected = []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                     "10.10.10.20:9100",
+			"__meta_scaleway_instance_id":     "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":   "instance-1",
+			"__meta_scaleway_instance_status": "running",
+			"__meta_scaleway_instance_type":   "",
+			"__meta_scaleway_instance_zone":   "nl-ams-1",
+			"__meta_scaleway_project_id":      "default-project",
+			"__meta_scaleway_private_ipv4":    "10.10.10.20",
+		}),
+	}
+	f(servers, "default-project", labelssExpected)
+
+	// instance without any reachable address is skipped
+	servers = []server{
+		{
+			ID:    "11111111-1111-1111-1111-111111111111",
+			Name:  "instance-1",
+			State: "running",
+		},
+	}
+	f(servers, "default-project", nil)
+}
