diff --git a/lib/promscrape/discovery/scaleway/api.go b/lib/promscrape/discovery/scaleway/api.go
new file mode 100644
index 0000000..d9a65ad
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api.go
@@ -0,0 +1,91 @@
+package scaleway
+
+import (
+	"fmt"
+	"net/url"
+	"strings"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+// apiConfig contains config for API server.
+type apiConfig struct {
+	c    *discoveryutil.Client
+	port int
+
+	zone      string
+	secretKey string
+
+	listQueryParams string
+}
+
+// getAPIConfig get or create API config from configMap.
+func getAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	v, err := configMap.Get(sdc, func() (any, error) { return newAPIConfig(sdc, baseDir) })
+	if err != nil {
+		return nil, err
+	}
+	return v.(*apiConfig), nil
+}
+
+// newAPIConfig creates API config.
+func newAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	port := sdc.Port
+	if port == 0 {
+		port = 80
+	}
+
+	zone := sdc.Zone
+	if zone == "" {
+		zone = "fr-par-1"
+	}
+
+	// See: https://www.scaleway.com/en/developers/api/instance/
+	apiServer := sdc.APIURL
+	if apiServer == "" {
+		apiServer = "https://api.scaleway.com"
+	}
+
+	if sdc.SecretKey == nil {
+		return nil, fmt.Errorf("missing `secret_key` option")
+	}
+	if sdc.Project == "" {
+		return nil, fmt.Errorf("missing `project_id` option")
+	}
+
+	ac, err := sdc.HTTPClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse auth config: %w", err)
+	}
+	proxyAC, err := sdc.ProxyClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse proxy auth config: %w", err)
+	}
+
+	c, err := discoveryutil.NewClient(apiServer, ac, sdc.ProxyURL, proxyAC, &sdc.HTTPClientConfig)
+	if err != nil {
+		return nil, fmt.Errorf("cannot create client for %q: %w", apiServer, err)
+	}
+
+	// Prepare additional query params for the list servers API.
+	// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+	qp := url.Values{}
+	qp.Set("project", sdc.Project)
+	if sdc.NameFilter != "" {
+		qp.Set("name", sdc.NameFilter)
+	}
+	if len(sdc.TagsFilter) > 0 {
+		qp.Set("tags", strings.Join(sdc.TagsFilter, ","))
+	}
+
+	cfg := &apiConfig{
+		c:    c,
+		port: port,
+
+		zone:      zone,
+		secretKey: sdc.SecretKey.String(),
+
+		listQueryParams: qp.Encode(),
+	}
+	return cfg, nil
+}
diff --git a/lib/promscrape/discovery/scaleway/api_test.go b/lib/promscrape/discovery/scaleway/api_test.go
new file mode 100644
index 0000000..1f21588
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api_test.go
@@ -0,0 +1,50 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	f := func(sdc *SDConfig) {
+		t.Helper()
+		baseDir := "."
+		if _, err := newAPIConfig(sdc, baseDir); err == nil {
+			t.Fatalf("expecting non-nil error")
+		}
+	}
+
+	// missing secret_key and project_id
+	f(&SDConfig{})
+
+	// missing project_id
+	f(&SDConfig{
+		SecretKey: &promauth.Secret{S: "foobar"},
+	})
+
+	// missing secret_key
+	f(&SDConfig{
+		Project: "some-project-id",
+	})
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		Project: "some-project-id",
+		SecretKey: &promauth.Secret{
+			S: "foobar",
+		},
+	}
+	baseDir := "."
+	ac, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	if ac.zone != "fr-par-1" {
+		t.Fatalf("unexpected default zone; got %q; want %q", ac.zone, "fr-par-1")
+	}
+	if ac.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want %d", ac.port, 80)
+	}
+}
diff --git a/lib/promscrape/discovery/scaleway/instance.go b/lib/promscrape/discovery/scaleway/instance.go
new file mode 100644
index 0000000..2ffbf67
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/instance.go
@@ -0,0 +1,89 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+)
+
+// instancesPerPage is the maximum number of instances requested per API call.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+const instancesPerPage = 100
+
+// ListServersResponse is the response structure of the Scaleway ListServers API.
+type ListServersResponse struct {
+	Servers    []Server `json:"servers"`
+	TotalCount int      `json:"total_count"`
+}
+
+// Server represents a Scaleway Instance.
+//
+// See: https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type Server struct {
+	ID             string         `json:"id"`
+	Name           string         `json:"name"`
+	Hostname       string         `json:"hostname"`
+	CommercialType string         `json:"commercial_type"`
+	State          string         `json:"state"`
+	BootType       string         `json:"boot_type"`
+	Zone           string         `json:"zone"`
+	Organization   string         `json:"organization"`
+	Project        string         `json:"project"`
+	Tags           []string       `json:"tags"`
+	PrivateIP      string         `json:"private_ip"`
+	PublicIP       *PublicIP      `json:"public_ip"`
+	Image          *Image         `json:"image"`
+	SecurityGroup  *SecurityGroup `json:"security_group"`
+}
+
+// PublicIP represents a Scaleway Instance public IP address.
+type PublicIP struct {
+	Address string `json:"address"`
+	Dynamic bool   `json:"dynamic"`
+}
+
+// Image represents a Scaleway Instance image.
+type Image struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+	Arch string `json:"arch"`
+}
+
+// SecurityGroup represents a Scaleway Instance security group.
+type SecurityGroup struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+}
+
+// getInstances retrieves instances from the Scaleway HTTP API.
+func getInstances(cfg *apiConfig) ([]Server, error) {
+	var servers []Server
+
+	setAuthHeader := func(req *http.Request) {
+		// See https://www.scaleway.com/en/developers/api/#authentication
+		req.Header.Set("X-Auth-Token", cfg.secretKey)
+	}
+
+	for page := 1; ; page++ {
+		// See: https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?%s&per_page=%d&page=%d", cfg.zone, cfg.listQueryParams, instancesPerPage, page)
+		data, err := cfg.c.GetAPIResponseWithReqParams(path, setAuthHeader)
+		if err != nil {
+			return nil, fmt.Errorf("cannot get Scaleway response from %q: %w", path, err)
+		}
+
+		var resp ListServersResponse
+		if err := json.Unmarshal(data, &resp); err != nil {
+			return nil, fmt.Errorf("cannot unmarshal ListServersResponse obtained from %q: %w; response=%q", path, err, data)
+		}
+
+		servers = append(servers, resp.Servers...)
+
+		if len(resp.Servers) == 0 || len(servers) >= resp.TotalCount {
+			break
+		}
+	}
+
+	return servers, nil
+}
