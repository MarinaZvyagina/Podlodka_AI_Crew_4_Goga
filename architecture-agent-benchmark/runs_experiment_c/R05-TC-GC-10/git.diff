--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/mock_server_test.go
@@ -0,0 +1,23 @@
+package scaleway
+
+import (
+	"net/http"
+	"net/http/httptest"
+)
+
+type mockScalewayServer struct {
+	*httptest.Server
+	responseFunc func(r *http.Request) []byte
+}
+
+func newMockScalewayServer(responseFunc func(r *http.Request) []byte) *mockScalewayServer {
+	var s mockScalewayServer
+	s.responseFunc = responseFunc
+	s.Server = httptest.NewServer(http.HandlerFunc(s.handler))
+	return &s
+}
+
+func (s *mockScalewayServer) handler(w http.ResponseWriter, r *http.Request) {
+	data := s.responseFunc(r)
+	w.Write(data)
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway.go b/lib/promscrape/discovery/scaleway/scaleway.go
new file mode 100644
index 0000000..81c5ef7
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway.go
@@ -0,0 +1,142 @@
+package scaleway
+
+import (
+	"flag"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/proxy"
+)
+
+// SDCheckInterval defines interval for Scaleway targets refresh.
+var SDCheckInterval = flag.Duration("promscrape.scalewaySDCheckInterval", 30*time.Second, "Interval for checking for changes in Scaleway. "+
+	"This works only if scaleway_sd_configs is configured in '-promscrape.config' file. "+
+	"See https://docs.victoriametrics.com/victoriametrics/sd_configs/#scaleway_sd_configs for details")
+
+// SDConfig represents service discovery config for Scaleway Instances.
+//
+// See: https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type SDConfig struct {
+	// Project is the id of the Scaleway project to discover instances for. This is mandatory.
+	Project string `yaml:"project_id"`
+
+	// SecretKey is the Scaleway API secret key used for authenticating API requests. This is mandatory.
+	SecretKey *promauth.Secret `yaml:"secret_key"`
+
+	// Zone is an optional Scaleway zone to discover instances in.
+	// By default, "fr-par-1" is used.
+	//
+	// See https://www.scaleway.com/en/developers/api/#region-and-zones
+	Zone string `yaml:"zone,omitempty"`
+
+	// APIURL is an optional Scaleway API server to query.
+	// By default, https://api.scaleway.com is used.
+	APIURL string `yaml:"api_url,omitempty"`
+
+	// NameFilter optionally filters discovered instances by name.
+	NameFilter string `yaml:"name_filter,omitempty"`
+
+	// TagsFilter optionally filters discovered instances, which contain all the given tags.
+	TagsFilter []string `yaml:"tags_filter,omitempty"`
+
+	// The port to scrape metrics from. Default 80.
+	Port int `yaml:"port"`
+
+	// General HTTP / Auth configs.
+	HTTPClientConfig  promauth.HTTPClientConfig  `yaml:",inline"`
+	ProxyURL          *proxy.URL                 `yaml:"proxy_url,omitempty"`
+	ProxyClientConfig promauth.ProxyClientConfig `yaml:",inline"`
+
+	// refresh_interval is obtained from `-promscrape.scalewaySDCheckInterval` command-line option.
+}
+
+var configMap = discoveryutil.NewConfigMap()
+
+// GetLabels returns Scaleway instances' labels according to sdc.
+func (sdc *SDConfig) GetLabels(baseDir string) ([]*promutil.Labels, error) {
+	ac, err := getAPIConfig(sdc, baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot get API config: %w", err)
+	}
+	instances, err := getInstances(ac)
+	if err != nil {
+		return nil, err
+	}
+	return getInstanceLabels(instances, ac.port), nil
+}
+
+// MustStop stops further usage for sdc.
+func (sdc *SDConfig) MustStop() {
+	_ = configMap.Delete(sdc)
+}
+
+// getInstanceLabels returns labels for Scaleway instances obtained from the given instances.
+func getInstanceLabels(instances []Server, port int) []*promutil.Labels {
+	ms := make([]*promutil.Labels, 0, len(instances))
+
+	for _, instance := range instances {
+		// Prefer the private IP address for scraping, since it is usually reachable from within
+		// the same Scaleway network, and fall back to the public IP address otherwise.
+		addr := instance.PrivateIP
+		if addr == "" && instance.PublicIP != nil {
+			addr = instance.PublicIP.Address
+		}
+		if addr == "" {
+			// Skip instances without a usable IP address.
+			continue
+		}
+
+		m := promutil.NewLabels(16)
+		m.Add("__address__", discoveryutil.JoinHostPort(addr, port))
+		m.Add("__meta_scaleway_instance_boot_type", instance.BootType)
+		m.Add("__meta_scaleway_instance_hostname", instance.Hostname)
+		m.Add("__meta_scaleway_instance_id", instance.ID)
+		m.Add("__meta_scaleway_instance_name", instance.Name)
+		m.Add("__meta_scaleway_instance_organization_id", instance.Organization)
+		m.Add("__meta_scaleway_instance_project_id", instance.Project)
+		m.Add("__meta_scaleway_instance_region", zoneToRegion(instance.Zone))
+		m.Add("__meta_scaleway_instance_status", instance.State)
+		m.Add("__meta_scaleway_instance_type", instance.CommercialType)
+		m.Add("__meta_scaleway_instance_zone", instance.Zone)
+
+		if instance.PrivateIP != "" {
+			m.Add("__meta_scaleway_instance_private_ipv4", instance.PrivateIP)
+		}
+		if instance.PublicIP != nil {
+			m.Add("__meta_scaleway_instance_public_ipv4", instance.PublicIP.Address)
+		}
+		if instance.Image != nil {
+			m.Add("__meta_scaleway_instance_image_arch", instance.Image.Arch)
+			m.Add("__meta_scaleway_instance_image_id", instance.Image.ID)
+			m.Add("__meta_scaleway_instance_image_name", instance.Image.Name)
+		}
+		if instance.SecurityGroup != nil {
+			m.Add("__meta_scaleway_instance_security_group_id", instance.SecurityGroup.ID)
+			m.Add("__meta_scaleway_instance_security_group_name", instance.SecurityGroup.Name)
+		}
+		if len(instance.Tags) > 0 {
+			m.Add("__meta_scaleway_instance_tags", joinTags(instance.Tags))
+		}
+
+		ms = append(ms, m)
+	}
+
+	return ms
+}
+
+// zoneToRegion converts a Scaleway zone such as "fr-par-1" into its region "fr-par".
+func zoneToRegion(zone string) string {
+	idx := strings.LastIndex(zone, "-")
+	if idx < 0 {
+		return zone
+	}
+	return zone[:idx]
+}
+
+func joinTags(a []string) string {
+	return "," + strings.Join(a, ",") + ","
+}
