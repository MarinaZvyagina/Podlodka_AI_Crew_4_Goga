+func TestStorageSeriesLimitExceededStats_DisabledByDefault(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const maxHourlySeries = 10
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	mrs := testGenerateMetricRows(rng, 1000, minTimestamp, maxTimestamp)
+
+	// TrackSeriesLimitExceededNames is intentionally left unset (false).
+	s := MustOpenStorage(t.Name(), OpenOptions{MaxHourlySeries: maxHourlySeries})
+	defer s.MustClose()
+
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped == 0 {
+		t.Fatalf("expected some rows to be dropped because of the series limit")
+	}
+
+	sr := s.GetSeriesLimitExceededStats(0)
+	if len(sr.Records) != 0 {
+		t.Fatalf("expected no tracked records when TrackSeriesLimitExceededNames is disabled, got %d", len(sr.Records))
+	}
+}
