+func TestStorageSeriesLimitExceededStats_MemoryBoundIsRespected(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const (
+		maxHourlySeries = 10
+		maxTrackerItems = 20
+		distinctMetrics = 500
+	)
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	tr := TimeRange{minTimestamp, maxTimestamp}
+
+	// Every one of the distinctMetrics metric names is dropped exactly once,
+	// which vastly exceeds maxTrackerItems.
+	var mrs []MetricRow
+	for i := range distinctMetrics {
+		mrs = append(mrs, testGenerateSeriesForMetricGroup(rng, fmt.Sprintf("metric_%d", i), 1, tr)...)
+	}
+
+	opts := OpenOptions{
+		MaxHourlySeries:                      maxHourlySeries,
+		TrackSeriesLimitExceededNames:        true,
+		MaxSeriesLimitExceededTrackerEntries: maxTrackerItems,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.SeriesLimitExceededTrackerEntries > maxTrackerItems {
+		t.Fatalf("tracker exceeded its configured memory bound: got %d entries, want <= %d", m.SeriesLimitExceededTrackerEntries, maxTrackerItems)
+	}
+
+	sr := s.GetSeriesLimitExceededStats(0)
+	if uint64(len(sr.Records)) > maxTrackerItems {
+		t.Fatalf("GetSeriesLimitExceededStats returned more records than the configured memory bound: got %d, want <= %d", len(sr.Records), maxTrackerItems)
+	}
+}
