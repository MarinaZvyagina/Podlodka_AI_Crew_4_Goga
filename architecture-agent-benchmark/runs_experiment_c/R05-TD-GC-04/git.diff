@@ -26,6 +26,7 @@ See also [LTS releases](https://docs.victoriametrics.com/victoriametrics/lts-rel
 
 ## tip
 
+* FEATURE: [vmsingle](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/) and `vmstorage` in [VictoriaMetrics cluster](https://docs.victoriametrics.com/victoriametrics/cluster-victoriametrics/): track, per metric name, how many samples were dropped because of `-storage.maxHourlySeries` or `-storage.maxDailySeries` being exceeded. The collected stats can be queried at `/internal/series_limit_exceeded` and reset at `/internal/series_limit_exceeded/reset`, so that support can tell which metric name(s) are responsible for hitting a customer's series-limit setting instead of guessing. Tracking is enabled by default and can be disabled via `-storage.trackSeriesLimitExceededMetricNames=false`; its memory usage is bounded by the new `-storage.maxSeriesLimitExceededTrackerEntries` flag.
 * FEATURE: [vmagent](https://docs.victoriametrics.com/victoriametrics/vmagent/), [vmsingle](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/), `vmstorage` and `vmselect` in [VictoriaMetrics cluster](https://docs.victoriametrics.com/victoriametrics/cluster-victoriametrics/): expose the `vm_app_prev_shutdown_unclean` gauge. It is set to `1` when the previous process run didn't shut down cleanly. Added the `UncleanShutdown` [alerting rule](https://github.com/VictoriaMetrics/VictoriaMetrics/blob/master/deployment/docker/rules/alerts-health.yml), which fires for 10 minutes after an unclean shutdown is detected. See [#8443](https://github.com/VictoriaMetrics/VictoriaMetrics/issues/8443).
 * FEATURE: [vmui](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/#vmui): show the selected time zone UTC offset next to the date/time controls and allow opening time zone settings from it. See [#11332](https://github.com/VictoriaMetrics/VictoriaMetrics/pull/11332).
 * FEATURE: [vmsingle](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/), [vmagent](https://docs.victoriametrics.com/victoriametrics/vmagent/), [vmalert](https://docs.victoriametrics.com/victoriametrics/vmalert/), and `vmselect` in [VictoriaMetrics cluster](https://docs.victoriametrics.com/victoriametrics/cluster-victoriametrics/): show how the default value is calculated for command-line flags which derive it from the number of available CPU cores. For example, `-maxConcurrentInserts` now prints `(default 16 = 2*cgroup.AvailableCPUs())` in `-help` output instead of `(default 16)`. Updated flags: `-search.maxConcurrentRequests`, `-search.maxWorkersPerQuery`, `-fs.maxConcurrency`, `-remoteWrite.concurrency`, `-remoteWrite.queues`. See [#9680](https://github.com/VictoriaMetrics/VictoriaMetrics/issues/9680). Thanks to @Vandit1604 for contribution.
diff --git a/lib/storage/droppedseries/tracker.go b/lib/storage/droppedseries/tracker.go
new file mode 100644
index 0000000..e517b19
--- /dev/null
+++ b/lib/storage/droppedseries/tracker.go
@@ -0,0 +1,250 @@
+// Package droppedseries tracks, per metric name, how many samples were
+// dropped because adding a new series for that metric name would have
+// exceeded the configured -storage.maxHourlySeries or -storage.maxDailySeries
+// limit.
+//
+// It exists so operators can answer "which metric name(s) are responsible for
+// hitting my series-limit setting" without having to guess or dig through
+// their own instrumentation.
+package droppedseries
+
+import (
+	"container/heap"
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+	"github.com/cespare/xxhash/v2"
+)
+
+// bucketsCount is the number of independently-locked shards the tracked
+// metric names are split across, in order to reduce lock contention.
+const bucketsCount = 16
+
+// Tracker tracks the number of dropped samples per metric name.
+//
+// The number of distinct metric names Tracker can hold is bounded by the
+// maxItems value passed to NewTracker, so memory usage cannot grow without
+// bound even if millions of distinct metric names hit the series limit.
+// Once a shard is full, the tracked metric name with the smallest dropped
+// count is evicted to make room for a new one, and the new entry inherits
+// the evicted entry's count plus one. This is the well-known Space-Saving
+// algorithm for approximate top-K frequency tracking under a fixed memory
+// budget: it guarantees that a metric name responsible for a lot of drops is
+// never far under-counted, at the cost of occasionally over-counting a
+// low-frequency metric name that took over a busy slot.
+//
+// It is safe to use Tracker from concurrent goroutines. A nil *Tracker is
+// valid and every method is a no-op on it, so callers can keep a Tracker
+// field that is nil when the feature is disabled without extra nil checks
+// on the ingestion hot path.
+type Tracker struct {
+	creationTs atomic.Uint64
+	buckets    [bucketsCount]*bucket
+}
+
+// NewTracker creates a Tracker, which can track up to maxItems distinct
+// metric names across all of its shards.
+func NewTracker(maxItems int) *Tracker {
+	t := &Tracker{}
+	maxBucketItems := maxItems / bucketsCount
+	if maxBucketItems < 1 {
+		maxBucketItems = 1
+	}
+	for i := range t.buckets {
+		t.buckets[i] = newBucket(maxBucketItems)
+	}
+	t.creationTs.Store(fasttime.UnixTimestamp())
+	return t
+}
+
+// IncrementDropped registers a single dropped sample for the given metricName.
+func (t *Tracker) IncrementDropped(metricName []byte) {
+	if t == nil {
+		return
+	}
+	idx := xxhash.Sum64(metricName) % bucketsCount
+	t.buckets[idx].increment(metricName)
+}
+
+// Record is a single metric name and the number of samples dropped for it.
+type Record struct {
+	MetricName   string
+	DroppedCount uint64
+}
+
+// StatsResult is the response for a GetTop call.
+type StatsResult struct {
+	// CollectedSince is the unix timestamp since which the stats have been
+	// collected, i.e. since the Tracker was created or last Reset.
+	CollectedSince uint64
+	Records        []Record
+}
+
+// GetTop returns up to limit metric names with the highest dropped-samples
+// count, sorted in descending order of DroppedCount (ties are broken by
+// metric name for a stable order).
+//
+// A non-positive limit returns all the tracked records.
+func (t *Tracker) GetTop(limit int) StatsResult {
+	if t == nil {
+		return StatsResult{}
+	}
+	var records []Record
+	for _, b := range t.buckets {
+		records = append(records, b.snapshot()...)
+	}
+	sort.Slice(records, func(i, j int) bool {
+		if records[i].DroppedCount != records[j].DroppedCount {
+			return records[i].DroppedCount > records[j].DroppedCount
+		}
+		return records[i].MetricName < records[j].MetricName
+	})
+	if limit > 0 && len(records) > limit {
+		records = records[:limit]
+	}
+	return StatsResult{
+		CollectedSince: t.creationTs.Load(),
+		Records:        records,
+	}
+}
+
+// Reset drops all the tracked counters and restarts the CollectedSince timestamp.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	for _, b := range t.buckets {
+		b.reset()
+	}
+	t.creationTs.Store(fasttime.UnixTimestamp())
+}
+
+// TrackerMetrics holds internal metrics of Tracker for observability.
+type TrackerMetrics struct {
+	CurrentItemsCount uint64
+	MaxItemsCount     uint64
+}
+
+// UpdateMetrics populates dst with the current state of t.
+func (t *Tracker) UpdateMetrics(dst *TrackerMetrics) {
+	if t == nil {
+		return
+	}
+	for _, b := range t.buckets {
+		dst.CurrentItemsCount += uint64(b.itemsCount())
+		dst.MaxItemsCount += uint64(b.maxItems)
+	}
+}
+
+type item struct {
+	metricName   string
+	droppedCount uint64
+	heapIdx      int
+}
+
+type bucket struct {
+	mu       sync.Mutex
+	items    map[string]*item
+	h        countHeap
+	maxItems int
+}
+
+func newBucket(maxItems int) *bucket {
+	return &bucket{
+		items:    make(map[string]*item),
+		maxItems: maxItems,
+	}
+}
+
+func (b *bucket) increment(metricName []byte) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+
+	if it := b.items[string(metricName)]; it != nil {
+		it.droppedCount++
+		heap.Fix(&b.h, it.heapIdx)
+		return
+	}
+
+	startCount := uint64(1)
+	if len(b.items) >= b.maxItems {
+		// Evict the metric name with the smallest dropped count to make room
+		// for the new one. The new entry inherits the evicted entry's count,
+		// so a slot that keeps cycling between distinct metric names never
+		// under-counts below what has already been observed for it.
+		evicted := heap.Pop(&b.h).(*item)
+		delete(b.items, evicted.metricName)
+		startCount = evicted.droppedCount + 1
+	}
+
+	it := &item{
+		metricName:   string(metricName),
+		droppedCount: startCount,
+	}
+	heap.Push(&b.h, it)
+	b.items[it.metricName] = it
+}
+
+func (b *bucket) snapshot() []Record {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+
+	records := make([]Record, 0, len(b.items))
+	for _, it := range b.items {
+		records = append(records, Record{
+			MetricName:   it.metricName,
+			DroppedCount: it.droppedCount,
+		})
+	}
+	return records
+}
+
+func (b *bucket) reset() {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+
+	b.items = make(map[string]*item)
+	b.h = nil
+}
+
+func (b *bucket) itemsCount() int {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return len(b.items)
+}
+
+// countHeap implements heap.Interface as a min-heap ordered by droppedCount.
+type countHeap []*item
+
+func (h *countHeap) Len() int {
+	return len(*h)
+}
+
+func (h *countHeap) Less(i, j int) bool {
+	hh := *h
+	return hh[i].droppedCount < hh[j].droppedCount
+}
+
+func (h *countHeap) Swap(i, j int) {
+	hh := *h
+	hh[i], hh[j] = hh[j], hh[i]
+	hh[i].heapIdx = i
+	hh[j].heapIdx = j
+}
+
+func (h *countHeap) Push(x any) {
+	it := x.(*item)
+	it.heapIdx = len(*h)
+	*h = append(*h, it)
+}
+
+func (h *countHeap) Pop() any {
+	old := *h
+	n := len(old)
+	it := old[n-1]
+	old[n-1] = nil
+	*h = old[:n-1]
+	return it
+}
diff --git a/lib/storage/droppedseries/tracker_test.go b/lib/storage/droppedseries/tracker_test.go
new file mode 100644
index 0000000..ccf7391
--- /dev/null
+++ b/lib/storage/droppedseries/tracker_test.go
@@ -0,0 +1,141 @@
+package droppedseries
+
+import (
+	"fmt"
+	"testing"
+)
+
+func TestTracker_IncrementAndGetTop(t *testing.T) {
+	tr := NewTracker(1000)
+
+	// metric_0 is dropped once, metric_1 twice, ..., metric_9 ten times.
+	for i := range 10 {
+		for range i + 1 {
+			tr.IncrementDropped([]byte(fmt.Sprintf("metric_%d", i)))
+		}
+	}
+
+	sr := tr.GetTop(3)
+	wantNames := []string{"metric_9", "metric_8", "metric_7"}
+	wantCounts := []uint64{10, 9, 8}
+	if len(sr.Records) != len(wantNames) {
+		t.Fatalf("unexpected number of records: got %d, want %d (%v)", len(sr.Records), len(wantNames), sr.Records)
+	}
+	for i, r := range sr.Records {
+		if r.MetricName != wantNames[i] || r.DroppedCount != wantCounts[i] {
+			t.Fatalf("unexpected record at position %d: got %+v, want {%s %d}", i, r, wantNames[i], wantCounts[i])
+		}
+	}
+
+	// A non-positive limit must return every tracked record.
+	sr = tr.GetTop(0)
+	if len(sr.Records) != 10 {
+		t.Fatalf("unexpected number of records for limit=0: got %d, want 10", len(sr.Records))
+	}
+}
+
+func TestTracker_IncrementSameMetricNameIsCumulative(t *testing.T) {
+	tr := NewTracker(1000)
+	for range 5 {
+		tr.IncrementDropped([]byte("foo"))
+	}
+	sr := tr.GetTop(10)
+	if len(sr.Records) != 1 {
+		t.Fatalf("unexpected number of records: got %d, want 1", len(sr.Records))
+	}
+	if sr.Records[0].MetricName != "foo" || sr.Records[0].DroppedCount != 5 {
+		t.Fatalf("unexpected record: got %+v", sr.Records[0])
+	}
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(1000)
+	tr.IncrementDropped([]byte("foo"))
+	tr.IncrementDropped([]byte("bar"))
+
+	sinceBefore := tr.GetTop(10).CollectedSince
+
+	tr.Reset()
+
+	sr := tr.GetTop(10)
+	if len(sr.Records) != 0 {
+		t.Fatalf("expected no records after Reset, got %d", len(sr.Records))
+	}
+	// creationTs is derived from fasttime.UnixTimestamp(), which has a
+	// 1-second resolution, so it may legitimately stay the same across a
+	// fast test run - just verify it never goes backwards.
+	if sr.CollectedSince < sinceBefore {
+		t.Fatalf("CollectedSince must not go backwards after Reset: got %d, want >= %d", sr.CollectedSince, sinceBefore)
+	}
+}
+
+func TestTracker_NilTrackerIsNoOp(t *testing.T) {
+	var tr *Tracker
+
+	// Must not panic.
+	tr.IncrementDropped([]byte("foo"))
+	tr.Reset()
+
+	sr := tr.GetTop(10)
+	if len(sr.Records) != 0 || sr.CollectedSince != 0 {
+		t.Fatalf("unexpected result from nil Tracker: %+v", sr)
+	}
+
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+	if tm != (TrackerMetrics{}) {
+		t.Fatalf("unexpected metrics from nil Tracker: %+v", tm)
+	}
+}
+
+func TestTracker_MemoryBoundIsRespected(t *testing.T) {
+	const maxItems = 100
+	tr := NewTracker(maxItems)
+
+	// Register far more distinct metric names than the configured bound.
+	for i := range 100000 {
+		tr.IncrementDropped([]byte(fmt.Sprintf("metric_%d", i)))
+	}
+
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+	if tm.CurrentItemsCount > maxItems {
+		t.Fatalf("tracker exceeded its configured memory bound: got %d tracked items, want <= %d", tm.CurrentItemsCount, maxItems)
+	}
+
+	sr := tr.GetTop(1000000)
+	if uint64(len(sr.Records)) > maxItems {
+		t.Fatalf("GetTop returned more records than the configured memory bound: got %d, want <= %d", len(sr.Records), maxItems)
+	}
+}
+
+func TestTracker_HighFrequencyMetricSurvivesEviction(t *testing.T) {
+	// A bound with several slots per shard, so a genuinely hot metric name
+	// can be told apart from one-off noise instead of every new key
+	// unconditionally evicting the sole occupant of its shard.
+	const maxItems = 800
+	tr := NewTracker(maxItems)
+
+	// hot_metric is dropped on every iteration, interleaved with a much
+	// larger stream of one-off metric names whose combined cardinality
+	// vastly exceeds maxItems, forcing continuous eviction pressure.
+	const hotDrops = 5000
+	for i := range hotDrops {
+		tr.IncrementDropped([]byte("hot_metric"))
+		for j := range 3 {
+			tr.IncrementDropped([]byte(fmt.Sprintf("noise_%d_%d", i, j)))
+		}
+	}
+
+	sr := tr.GetTop(1)
+	if len(sr.Records) != 1 {
+		t.Fatalf("expected exactly one record, got %d", len(sr.Records))
+	}
+	if sr.Records[0].MetricName != "hot_metric" {
+		t.Fatalf("expected the high-frequency metric name to be the top offender, got %+v", sr.Records[0])
+	}
+	if sr.Records[0].DroppedCount < hotDrops {
+		t.Fatalf("hot_metric dropped count must be at least the number of times it was actually incremented: got %d, want >= %d",
+			sr.Records[0].DroppedCount, hotDrops)
+	}
+}
