+// testGenerateSeriesForMetricGroup generates count distinct series (distinct
+// tag sets) all sharing the same metricGroup name.
+func testGenerateSeriesForMetricGroup(rng *rand.Rand, metricGroup string, count int, tr TimeRange) []MetricRow {
+	var mrs []MetricRow
+	var mn MetricName
+	mn.MetricGroup = []byte(metricGroup)
+	for i := range count {
+		mn.Tags = []Tag{
+			{[]byte("idx"), fmt.Appendf(nil, "%d", i)},
+		}
+		metricNameRaw := mn.marshalRaw(nil)
+		timestamp := rng.Int63n(tr.MaxTimestamp-tr.MinTimestamp) + tr.MinTimestamp
+		value := rng.NormFloat64() * 1e6
+		mrs = append(mrs, MetricRow{
+			MetricNameRaw: metricNameRaw,
+			Timestamp:     timestamp,
+			Value:         value,
+		})
+	}
+	return mrs
+}
