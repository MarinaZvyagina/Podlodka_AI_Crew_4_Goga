+// GetMetricGroupFromMetricNameRaw appends the metric group (metric name) found
+// in src, which must be encoded via MarshalMetricNameRaw, to dst and returns
+// the result.
+//
+// Unlike MetricName.UnmarshalRaw, this doesn't unmarshal the rest of the tags,
+// so it is cheaper to call when only the metric group is needed.
+func GetMetricGroupFromMetricNameRaw(dst, src []byte) ([]byte, error) {
+	for len(src) > 0 {
+		tail, key, err := unmarshalBytesFast(src)
+		if err != nil {
+			return dst, fmt.Errorf("cannot decode key: %w", err)
+		}
+		src = tail
+
+		tail, value, err := unmarshalBytesFast(src)
+		if err != nil {
+			return dst, fmt.Errorf("cannot decode value: %w", err)
+		}
+		src = tail
+
+		if len(key) == 0 {
+			return append(dst, value...), nil
+		}
+	}
+	return dst, nil
+}
+
