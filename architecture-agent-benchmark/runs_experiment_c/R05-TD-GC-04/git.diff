+func TestStorageSeriesLimitExceededStats(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const maxHourlySeries = 50
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	tr := TimeRange{minTimestamp, maxTimestamp}
+
+	// fillerRows are submitted first and exhaust the hourly series limit, so
+	// that every series registered afterwards is guaranteed to be dropped
+	// regardless of bloom-filter internals.
+	fillerRows := testGenerateMetricRowsWithPrefix(rng, maxHourlySeries, "filler", tr)
+
+	// hotMetric has far more distinct series than any other metric name, so
+	// it must end up as the top offender.
+	hotRows := testGenerateSeriesForMetricGroup(rng, "hot_metric", 900, tr)
+
+	const coldMetricsCount = 5
+	const coldSeriesPerMetric = 20
+	var coldRows []MetricRow
+	for i := range coldMetricsCount {
+		coldRows = append(coldRows, testGenerateSeriesForMetricGroup(rng, fmt.Sprintf("cold_metric_%d", i), coldSeriesPerMetric, tr)...)
+	}
+
+	var mrs []MetricRow
+	mrs = append(mrs, fillerRows...)
+	mrs = append(mrs, hotRows...)
+	mrs = append(mrs, coldRows...)
+
+	opts := OpenOptions{
+		MaxHourlySeries:               maxHourlySeries,
+		TrackSeriesLimitExceededNames: true,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	// The bloom filter backing the series limiter has a small, expected
+	// false-positive rate, which can occasionally let a handful of series
+	// through instead of dropping them. Assertions below tolerate that
+	// slack instead of expecting exact counts.
+	const tolerance = 5
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	wantDropped := uint64(len(hotRows) + coldMetricsCount*coldSeriesPerMetric)
+	if m.HourlySeriesLimitRowsDropped > wantDropped || m.HourlySeriesLimitRowsDropped < wantDropped-tolerance {
+		t.Fatalf("unexpected Metrics.HourlySeriesLimitRowsDropped: got %d, want close to %d", m.HourlySeriesLimitRowsDropped, wantDropped)
+	}
+
+	// Recording: every dropped metric name must be present with close to the
+	// expected number of samples dropped for it.
+	sr := s.GetSeriesLimitExceededStats(0)
+	if len(sr.Records) != 1+coldMetricsCount {
+		t.Fatalf("unexpected number of tracked metric names: got %d, want %d (%+v)", len(sr.Records), 1+coldMetricsCount, sr.Records)
+	}
+	got := make(map[string]uint64, len(sr.Records))
+	for _, r := range sr.Records {
+		got[r.MetricName] = r.DroppedCount
+	}
+	if c := got["hot_metric"]; c > uint64(len(hotRows)) || c < uint64(len(hotRows))-tolerance {
+		t.Fatalf("unexpected dropped count for hot_metric: got %d, want close to %d", c, len(hotRows))
+	}
+	for i := range coldMetricsCount {
+		name := fmt.Sprintf("cold_metric_%d", i)
+		if c := got[name]; c > coldSeriesPerMetric || c < coldSeriesPerMetric-tolerance {
+			t.Fatalf("unexpected dropped count for %s: got %d, want close to %d", name, c, coldSeriesPerMetric)
+		}
+	}
+
+	// Querying the top offender must return hot_metric.
+	top := s.GetSeriesLimitExceededStats(1)
+	if len(top.Records) != 1 || top.Records[0].MetricName != "hot_metric" {
+		t.Fatalf("unexpected top offender: got %+v, want hot_metric", top.Records)
+	}
+
+	// Reset must clear all the tracked counters.
+	s.ResetSeriesLimitExceededStats()
+	sr = s.GetSeriesLimitExceededStats(0)
+	if len(sr.Records) != 0 {
+		t.Fatalf("expected no records after ResetSeriesLimitExceededStats, got %d", len(sr.Records))
+	}
+}
