diff --git a/app/vmstorage/main_test.go b/app/vmstorage/main_test.go
new file mode 100644
index 0000000..d4836b2
--- /dev/null
+++ b/app/vmstorage/main_test.go
@@ -0,0 +1,51 @@
+package vmstorage
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/storage/droppedseries"
+)
+
+func TestWriteSeriesLimitExceededStatsResponse(t *testing.T) {
+	stats := &droppedseries.Stats{
+		CollectedSinceTs:        1700000000,
+		TrackedMetricNamesCount: 2,
+		MaxTrackedMetricNames:   1000,
+		Entries: []droppedseries.Entry{
+			{MetricName: "high_cardinality_metric", DroppedRowsCount: 42},
+			{MetricName: `weird"metric`, DroppedRowsCount: 1},
+		},
+	}
+
+	var bb bytes.Buffer
+	writeSeriesLimitExceededStatsResponse(&bb, stats)
+	got := bb.String()
+
+	wantSubstrings := []string{
+		`"status":"ok"`,
+		`"collectedSinceTimestamp":1700000000`,
+		`"trackedMetricNamesCount":2`,
+		`"maxTrackedMetricNames":1000`,
+		`"metricName":"high_cardinality_metric","droppedRowsCount":42`,
+		`"metricName":"weird\"metric","droppedRowsCount":1`,
+	}
+	for _, want := range wantSubstrings {
+		if !strings.Contains(got, want) {
+			t.Fatalf("response %q does not contain expected substring %q", got, want)
+		}
+	}
+}
+
+func TestWriteSeriesLimitExceededStatsResponse_Empty(t *testing.T) {
+	stats := &droppedseries.Stats{}
+
+	var bb bytes.Buffer
+	writeSeriesLimitExceededStatsResponse(&bb, stats)
+	got := bb.String()
+
+	if !strings.Contains(got, `"topEntries":[]`) {
+		t.Fatalf("expected empty topEntries array, got %q", got)
+	}
+}
diff --git a/lib/storage/droppedseries/CODEMANIFEST b/lib/storage/droppedseries/CODEMANIFEST
new file mode 100644
index 0000000..5a7fcc1
--- /dev/null
+++ b/lib/storage/droppedseries/CODEMANIFEST
@@ -0,0 +1,106 @@
+Usages:
+  fill_until_full_no_eviction: |
+    Tracker never evicts individual entries once maxTrackedNames distinct metric names are
+    tracked, the same fill-until-full policy as this cell's sibling metricnamestats (as opposed
+    to metricsmetadata's LWW-heap eviction). IncrementDropCount becomes a silent no-op for any
+    metric name not already tracked once len(m)>=maxTrackedNames — existing entries keep
+    accumulating forever until an explicit Reset clears the whole map. This is a deliberate,
+    not incidental, choice: cardinality-limit rejections are expected to concentrate on a small,
+    stable set of offending metric names (the customer's one or two runaway metrics), so a small
+    fixed bound reached once is expected to already cover the useful signal; growing the bound
+    dynamically or evicting cold entries would add complexity without materially improving the
+    "which metric is responsible" answer this cell exists to give.
+
+    Unlike metricnamestats, this cell keeps no on-disk representation at all: it is rebuilt from
+    zero on every process start, since the underlying question ("what have I dropped since the
+    process/limiter came up") is inherently ongoing operational state, not something a restart
+    should carry forward.
+
+  raw_metric_group_extraction: |
+    Callers are expected to pass the metric name extracted via metricGroupFromRaw
+    (lib/storage/metric_name.go) rather than the fully-unmarshaled MetricName.MetricGroup used
+    elsewhere in lib/storage, because IncrementDropCount is called on the storage.add /
+    storage.RegisterMetricNames per-row rejection path once a row has already failed
+    hourlySeriesLimiter/dailySeriesLimiter — a path that, under a sustained cardinality-limit
+    breach, may execute far more often than successful ingestion. metricGroupFromRaw scans
+    MetricNameRaw for the empty-key (metric group) entry and returns as soon as it is found,
+    skipping the tag-list construction that a full MetricName.UnmarshalRaw would perform, so
+    that enabling this tracker doesn't meaningfully add to the cost of the already-abnormal
+    rejection path.
+
+Annotations: |
+  In-memory-only, per-metric-name counter of samples dropped because adding their series would
+  have exceeded -storage.maxHourlySeries or -storage.maxDailySeries (lib/storage's
+  hourlySeriesLimiter/dailySeriesLimiter), answering "which metric names are actually
+  responsible for hitting my series limit" via GetTopEntries — the question the aggregate
+  HourlySeriesLimitRowsDropped/DailySeriesLimitRowsDropped counters on storage.Metrics cannot
+  answer on their own. All exported Tracker methods tolerate a nil receiver as a no-op, so the
+  owning Storage holds a `*Tracker` field that stays nil when -storage.trackSeriesLimitExceededStats
+  is disabled, keeping the ingestion hot path free of this feature's cost with a single nil
+  check (see `raw_metric_group_extraction` for how the call site itself avoids doing any name
+  extraction work at all when the tracker is nil).
+
+  Use `fill_until_full_no_eviction` before changing IncrementDropCount, Reset, or the
+  maxTrackedNames bound-check — this is the load-bearing memory-safety property of the cell:
+  the tracker's size is bounded independently of how many distinct metric names exist in the
+  database.
+
+  Use `raw_metric_group_extraction` before changing how callers obtain the metricName argument
+  passed into IncrementDropCount.
+
+---
+
+"Tracker(maxTrackedNames: int)":
+  location: tracker.go
+  annotations: |
+    Obtained via the NewTracker factory function; maxTrackedNames<=0 falls back to
+    DefaultMaxTrackedNames. See `fill_until_full_no_eviction` for what happens once the bound
+    is reached and why there is no on-disk persistence.
+  methods:
+    "IncrementDropCount(metricName: []byte)": |
+      Record one dropped sample for metricName, creating a new zero-then-incremented entry if
+      one does not already exist and the tracker is not yet full. See
+      `fill_until_full_no_eviction`. Nil-safe.
+    "GetTopEntries(limit: int) -> stats:Stats": |
+      Snapshot every tracked entry, sort by DroppedRowsCount descending (ties broken by
+      MetricName ascending for deterministic output), and truncate to at most limit entries; a
+      non-positive limit returns every tracked entry. Nil-safe (returns a zero Stats).
+    "Reset()": |
+      Clear every tracked entry and restart Stats.CollectedSinceTs from the current time.
+      Nil-safe.
+    "UpdateMetrics(dst: TrackerMetrics)": |
+      Populate dst with the current tracked-name count and the configured maxTrackedNames
+      bound. Nil-safe.
+
+"Stats(collectedSinceTs: uint64, trackedMetricNamesCount: int, maxTrackedMetricNames: int, entries: []Entry)":
+  location: tracker.go
+  annotations: |
+    Response payload for a GetTopEntries call. TrackedMetricNamesCount==MaxTrackedMetricNames
+    is the caller-visible signal that the tracker is full and some dropped metric names may be
+    missing from Entries — see `fill_until_full_no_eviction`.
+
+"Entry(metricName: string, droppedRowsCount: uint64)":
+  location: tracker.go
+  annotations: |
+    One tracked metric name's accumulated drop count, as surfaced by GetTopEntries.
+
+"TrackerMetrics(trackedMetricNamesCount: int, maxTrackedMetricNames: int)":
+  location: tracker.go
+  annotations: |
+    Plain snapshot struct populated by Tracker's UpdateMetrics method; carries no behavior of
+    its own.
+
+---
+
+Author: Goga
+CreatedAt: 21/09/26
+Description: |
+  New Goga cell added to answer the support-facing question "which metric names are hitting my
+  -storage.maxHourlySeries / -storage.maxDailySeries limit", which the pre-existing aggregate
+  HourlySeriesLimitRowsDropped/DailySeriesLimitRowsDropped counters on storage.Metrics could not
+  answer. Modeled structurally on the sibling metricnamestats cell (same nil-safe-methods
+  convention, same fill-until-full memory-bound philosophy) but deliberately simpler: no tenant
+  awareness (per the feature's single-node/cluster-storage-component-only scope) and no on-disk
+  persistence (see `fill_until_full_no_eviction`). Consumed by lib/storage (Storage.
+  droppedSeriesTracker field, wired from storage.registerSeriesLimitExceededDrop) and exposed
+  externally via the GET /internal/series_limit_exceeded endpoint in app/vmstorage.
diff --git a/lib/storage/droppedseries/tracker.go b/lib/storage/droppedseries/tracker.go
new file mode 100644
index 0000000..8ec480f
--- /dev/null
+++ b/lib/storage/droppedseries/tracker.go
@@ -0,0 +1,176 @@
+// Package droppedseries tracks, per metric name, how many samples were dropped
+// because adding their series would have exceeded a configured unique-series
+// limit (see -storage.maxHourlySeries / -storage.maxDailySeries).
+//
+// The tracker is purely in-memory and bounded by a fixed maximum number of
+// distinct tracked metric names, so it cannot grow without bound regardless
+// of how many distinct metric names exist in the database.
+package droppedseries
+
+import (
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+// DefaultMaxTrackedNames is used when Tracker is constructed with maxTrackedNames<=0.
+const DefaultMaxTrackedNames = 1000
+
+// Tracker accumulates, per metric name, the number of samples dropped since
+// the tracker was created or last Reset.
+//
+// All Tracker methods are safe to call on a nil receiver, in which case they
+// are a no-op. This lets an owning cell hold a *Tracker field that is
+// intentionally left nil when the feature is disabled, without a nil-check
+// at every call site.
+type Tracker struct {
+	maxTrackedNames int
+
+	sinceTs atomic.Uint64
+
+	mu sync.RWMutex
+	m  map[string]*atomic.Uint64
+
+	// getCurrentTs is overridden in tests.
+	getCurrentTs func() uint64
+}
+
+// NewTracker creates a Tracker, which tracks drop counts for at most maxTrackedNames
+// distinct metric names. If maxTrackedNames<=0, DefaultMaxTrackedNames is used instead.
+func NewTracker(maxTrackedNames int) *Tracker {
+	if maxTrackedNames <= 0 {
+		maxTrackedNames = DefaultMaxTrackedNames
+	}
+	t := &Tracker{
+		maxTrackedNames: maxTrackedNames,
+		m:               make(map[string]*atomic.Uint64),
+		getCurrentTs:    fasttime.UnixTimestamp,
+	}
+	t.sinceTs.Store(t.getCurrentTs())
+	return t
+}
+
+// IncrementDropCount records a single dropped sample for the given metricName.
+//
+// Once maxTrackedNames distinct metric names are being tracked, drops for any
+// additional, not-yet-tracked metric name are silently ignored - this is what
+// bounds the tracker's memory usage. Nil-safe.
+func (t *Tracker) IncrementDropCount(metricName []byte) {
+	if t == nil {
+		return
+	}
+
+	t.mu.RLock()
+	cnt, ok := t.m[string(metricName)]
+	t.mu.RUnlock()
+	if ok {
+		cnt.Add(1)
+		return
+	}
+
+	t.mu.Lock()
+	cnt, ok = t.m[string(metricName)]
+	if !ok {
+		if len(t.m) >= t.maxTrackedNames {
+			// The tracker is full - do not track any new metric names
+			// in order to keep memory usage bounded.
+			t.mu.Unlock()
+			return
+		}
+		cnt = &atomic.Uint64{}
+		t.m[string(metricName)] = cnt
+	}
+	t.mu.Unlock()
+
+	cnt.Add(1)
+}
+
+// Entry is a single tracked metric name and the number of samples dropped for it.
+type Entry struct {
+	MetricName       string
+	DroppedRowsCount uint64
+}
+
+// Stats is the result of a Tracker query.
+type Stats struct {
+	// CollectedSinceTs is the unix timestamp in seconds since which the drop
+	// counts were accumulated, i.e. since the tracker was created or last Reset.
+	CollectedSinceTs uint64
+
+	// TrackedMetricNamesCount is the number of distinct metric names currently tracked.
+	TrackedMetricNamesCount int
+
+	// MaxTrackedMetricNames is the configured upper bound on TrackedMetricNamesCount.
+	//
+	// If TrackedMetricNamesCount==MaxTrackedMetricNames, then some dropped metric
+	// names may not be reflected in the result, since the tracker became full.
+	MaxTrackedMetricNames int
+
+	// Entries contains at most the requested limit of tracked metric names,
+	// sorted by DroppedRowsCount in descending order.
+	Entries []Entry
+}
+
+// GetTopEntries returns Stats with at most limit Entries, sorted by DroppedRowsCount
+// in descending order. A non-positive limit returns all tracked entries.
+func (t *Tracker) GetTopEntries(limit int) Stats {
+	var s Stats
+	if t == nil {
+		return s
+	}
+
+	t.mu.RLock()
+	s.CollectedSinceTs = t.sinceTs.Load()
+	s.TrackedMetricNamesCount = len(t.m)
+	s.MaxTrackedMetricNames = t.maxTrackedNames
+	entries := make([]Entry, 0, len(t.m))
+	for name, cnt := range t.m {
+		entries = append(entries, Entry{
+			MetricName:       name,
+			DroppedRowsCount: cnt.Load(),
+		})
+	}
+	t.mu.RUnlock()
+
+	sort.Slice(entries, func(i, j int) bool {
+		if entries[i].DroppedRowsCount == entries[j].DroppedRowsCount {
+			return entries[i].MetricName < entries[j].MetricName
+		}
+		return entries[i].DroppedRowsCount > entries[j].DroppedRowsCount
+	})
+	if limit > 0 && limit < len(entries) {
+		entries = entries[:limit]
+	}
+	s.Entries = entries
+	return s
+}
+
+// Reset clears all the tracked drop counts and restarts CollectedSinceTs. Nil-safe.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.m = make(map[string]*atomic.Uint64)
+	t.sinceTs.Store(t.getCurrentTs())
+	t.mu.Unlock()
+}
+
+// TrackerMetrics holds internal metrics to report.
+type TrackerMetrics struct {
+	TrackedMetricNamesCount int
+	MaxTrackedMetricNames   int
+}
+
+// UpdateMetrics writes internal metrics to the provided dst. Nil-safe.
+func (t *Tracker) UpdateMetrics(dst *TrackerMetrics) {
+	if t == nil {
+		return
+	}
+	t.mu.RLock()
+	dst.TrackedMetricNamesCount = len(t.m)
+	t.mu.RUnlock()
+	dst.MaxTrackedMetricNames = t.maxTrackedNames
+}
