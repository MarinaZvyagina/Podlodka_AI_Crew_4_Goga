+func TestStorageGetSeriesLimitExceededStats(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const maxHourlySeries = 3
+
+	opts := OpenOptions{
+		MaxHourlySeries:               maxHourlySeries,
+		TrackSeriesLimitExceededStats: true,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+
+	// Fill up the hourly series limit with distinct "good" metric names, so that
+	// any further distinct metric name is rejected by the limiter.
+	goodRows := testGenerateMetricRowsWithPrefix(rng, maxHourlySeries, "good_metric", TimeRange{minTimestamp, maxTimestamp})
+	s.AddRows(goodRows, defaultPrecisionBits)
+	s.DebugFlush()
+
+	// Repeatedly ingest samples for two distinct metric names that exceed the limit.
+	// Every one of these rows must be dropped and attributed to its metric name.
+	addRowsForMetric := func(metricName string, count int) {
+		var mn MetricName
+		mn.MetricGroup = []byte(metricName)
+		mn.Tags = []Tag{{[]byte("job"), []byte("webservice")}}
+		for range count {
+			metricNameRaw := mn.marshalRaw(nil)
+			timestamp := rng.Int63n(maxTimestamp-minTimestamp) + minTimestamp
+			mr := MetricRow{
+				MetricNameRaw: metricNameRaw,
+				Timestamp:     timestamp,
+				Value:         rng.NormFloat64(),
+			}
+			s.AddRows([]MetricRow{mr}, defaultPrecisionBits)
+		}
+	}
+
+	addRowsForMetric("bad_metric_a", 5)
+	addRowsForMetric("bad_metric_b", 3)
+	s.DebugFlush()
+
+	var gotMetrics Metrics
+	s.UpdateMetrics(&gotMetrics)
+	if got, want := gotMetrics.HourlySeriesLimitRowsDropped, uint64(8); got != want {
+		t.Fatalf("unexpected Metrics.HourlySeriesLimitRowsDropped: got %d, want %d", got, want)
+	}
+
+	stats := s.GetSeriesLimitExceededStats(10)
+	if len(stats.Entries) != 2 {
+		t.Fatalf("unexpected number of tracked metric names: got %d, want 2; entries=%+v", len(stats.Entries), stats.Entries)
+	}
+	if stats.Entries[0].MetricName != "bad_metric_a" || stats.Entries[0].DroppedRowsCount != 5 {
+		t.Fatalf("unexpected top entry: %+v", stats.Entries[0])
+	}
+	if stats.Entries[1].MetricName != "bad_metric_b" || stats.Entries[1].DroppedRowsCount != 3 {
+		t.Fatalf("unexpected second entry: %+v", stats.Entries[1])
+	}
+
+	// A limit smaller than the number of tracked names must be respected.
+	topOne := s.GetSeriesLimitExceededStats(1)
+	if len(topOne.Entries) != 1 || topOne.Entries[0].MetricName != "bad_metric_a" {
+		t.Fatalf("unexpected top-1 result: %+v", topOne.Entries)
+	}
+
+	s.ResetSeriesLimitExceededStats()
+	afterReset := s.GetSeriesLimitExceededStats(10)
+	if len(afterReset.Entries) != 0 {
+		t.Fatalf("expected no tracked metric names after reset, got %+v", afterReset.Entries)
+	}
+}
