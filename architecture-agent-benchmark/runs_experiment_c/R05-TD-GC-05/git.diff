@@ -0,0 +1,170 @@
+package droppedseries
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestTracker_NilSafe(t *testing.T) {
+	var t0 *Tracker
+	t0.IncrementDropCount([]byte("foo"))
+	t0.Reset()
+	var tm TrackerMetrics
+	t0.UpdateMetrics(&tm)
+	if tm.TrackedMetricNamesCount != 0 || tm.MaxTrackedMetricNames != 0 {
+		t.Fatalf("unexpected non-zero metrics from nil Tracker: %+v", tm)
+	}
+	s := t0.GetTopEntries(10)
+	if len(s.Entries) != 0 {
+		t.Fatalf("unexpected entries from nil Tracker: %+v", s)
+	}
+}
+
+func TestTracker_RecordsMultipleMetricNames(t *testing.T) {
+	tr := NewTracker(100)
+
+	tr.IncrementDropCount([]byte("metric_a"))
+	tr.IncrementDropCount([]byte("metric_a"))
+	tr.IncrementDropCount([]byte("metric_a"))
+	tr.IncrementDropCount([]byte("metric_b"))
+	tr.IncrementDropCount([]byte("metric_c"))
+	tr.IncrementDropCount([]byte("metric_c"))
+
+	s := tr.GetTopEntries(100)
+	if s.TrackedMetricNamesCount != 3 {
+		t.Fatalf("unexpected TrackedMetricNamesCount: got %d, want 3", s.TrackedMetricNamesCount)
+	}
+	counts := make(map[string]uint64, len(s.Entries))
+	for _, e := range s.Entries {
+		counts[e.MetricName] = e.DroppedRowsCount
+	}
+	want := map[string]uint64{
+		"metric_a": 3,
+		"metric_b": 1,
+		"metric_c": 2,
+	}
+	for name, wantCount := range want {
+		if got := counts[name]; got != wantCount {
+			t.Fatalf("unexpected drop count for %q: got %d, want %d", name, got, wantCount)
+		}
+	}
+}
+
+func TestTracker_TopEntriesOrderingAndLimit(t *testing.T) {
+	tr := NewTracker(100)
+
+	names := []string{"low", "mid", "high"}
+	counts := map[string]int{"low": 1, "mid": 5, "high": 10}
+	for _, name := range names {
+		for range counts[name] {
+			tr.IncrementDropCount([]byte(name))
+		}
+	}
+
+	s := tr.GetTopEntries(2)
+	if len(s.Entries) != 2 {
+		t.Fatalf("unexpected number of entries: got %d, want 2", len(s.Entries))
+	}
+	if s.Entries[0].MetricName != "high" || s.Entries[0].DroppedRowsCount != 10 {
+		t.Fatalf("unexpected top entry: %+v", s.Entries[0])
+	}
+	if s.Entries[1].MetricName != "mid" || s.Entries[1].DroppedRowsCount != 5 {
+		t.Fatalf("unexpected second entry: %+v", s.Entries[1])
+	}
+}
+
+func TestTracker_MemoryBoundIsRespected(t *testing.T) {
+	const maxTrackedNames = 10
+	tr := NewTracker(maxTrackedNames)
+
+	// Attempt to track far more distinct metric names than the configured bound.
+	for i := range 10000 {
+		tr.IncrementDropCount(fmt.Appendf(nil, "metric_%d", i))
+	}
+
+	s := tr.GetTopEntries(0)
+	if s.TrackedMetricNamesCount != maxTrackedNames {
+		t.Fatalf("unexpected TrackedMetricNamesCount: got %d, want %d", s.TrackedMetricNamesCount, maxTrackedNames)
+	}
+	if len(s.Entries) != maxTrackedNames {
+		t.Fatalf("unexpected number of entries: got %d, want %d", len(s.Entries), maxTrackedNames)
+	}
+	if s.MaxTrackedMetricNames != maxTrackedNames {
+		t.Fatalf("unexpected MaxTrackedMetricNames: got %d, want %d", s.MaxTrackedMetricNames, maxTrackedNames)
+	}
+
+	// Further increments to already-tracked names must still be counted normally.
+	firstName := s.Entries[0].MetricName
+	tr.IncrementDropCount([]byte(firstName))
+	s2 := tr.GetTopEntries(0)
+	if s2.TrackedMetricNamesCount != maxTrackedNames {
+		t.Fatalf("tracker grew past the configured bound: got %d, want %d", s2.TrackedMetricNamesCount, maxTrackedNames)
+	}
+}
+
+func TestTracker_DefaultMaxTrackedNames(t *testing.T) {
+	tr := NewTracker(0)
+	for i := range DefaultMaxTrackedNames + 100 {
