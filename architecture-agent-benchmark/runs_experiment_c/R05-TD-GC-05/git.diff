+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(100)
+	tr.IncrementDropCount([]byte("metric_a"))
+	tr.IncrementDropCount([]byte("metric_b"))
+
+	s := tr.GetTopEntries(0)
+	if s.TrackedMetricNamesCount != 2 {
+		t.Fatalf("unexpected TrackedMetricNamesCount before reset: got %d, want 2", s.TrackedMetricNamesCount)
+	}
+
+	tr.Reset()
+
+	s = tr.GetTopEntries(0)
+	if s.TrackedMetricNamesCount != 0 || len(s.Entries) != 0 {
+		t.Fatalf("expected empty tracker after Reset, got %+v", s)
+	}
+
+	// Drops recorded after Reset must be tracked again from zero.
+	tr.IncrementDropCount([]byte("metric_a"))
+	s = tr.GetTopEntries(0)
+	if len(s.Entries) != 1 || s.Entries[0].DroppedRowsCount != 1 {
+		t.Fatalf("unexpected state after post-reset increment: %+v", s)
+	}
+}
+
+func TestTracker_ConcurrentAccess(t *testing.T) {
+	tr := NewTracker(50)
+
+	const goroutines = 20
+	const incrementsPerName = 50
+	names := []string{"metric_a", "metric_b", "metric_c"}
+
+	var wg sync.WaitGroup
+	for range goroutines {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for _, name := range names {
+				for range incrementsPerName {
+					tr.IncrementDropCount([]byte(name))
+				}
+			}
+		}()
+	}
+	wg.Wait()
+
+	s := tr.GetTopEntries(0)
+	want := uint64(goroutines * incrementsPerName)
+	for _, e := range s.Entries {
+		if e.DroppedRowsCount != want {
+			t.Fatalf("unexpected drop count for %q: got %d, want %d", e.MetricName, e.DroppedRowsCount, want)
+		}
+	}
+}
