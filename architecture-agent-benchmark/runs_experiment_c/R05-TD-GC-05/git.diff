+func TestStorageGetSeriesLimitExceededStats_MemoryBound(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const (
+		maxHourlySeries = 2
+		maxTrackedNames = 5
+	)
+
+	opts := OpenOptions{
+		MaxHourlySeries:               maxHourlySeries,
+		TrackSeriesLimitExceededStats: true,
+	}
+	SetMaxSeriesLimitExceededTrackedNames(maxTrackedNames)
+	defer SetMaxSeriesLimitExceededTrackedNames(0)
+
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+
+	// Fill up the limiter with "good" series first.
+	goodRows := testGenerateMetricRowsWithPrefix(rng, maxHourlySeries, "good_metric", TimeRange{minTimestamp, maxTimestamp})
+	s.AddRows(goodRows, defaultPrecisionBits)
+	s.DebugFlush()
+
+	// Push many more distinct metric names than maxTrackedNames through the
+	// already-full limiter, so all of them are dropped.
+	const distinctBadNames = 500
+	badRows := testGenerateMetricRowsWithPrefix(rng, distinctBadNames, "bad_metric", TimeRange{minTimestamp, maxTimestamp})
+	s.AddRows(badRows, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var gotMetrics Metrics
+	s.UpdateMetrics(&gotMetrics)
+	if got := gotMetrics.HourlySeriesLimitRowsDropped; got != distinctBadNames {
+		t.Fatalf("unexpected Metrics.HourlySeriesLimitRowsDropped: got %d, want %d", got, distinctBadNames)
+	}
+	if got := gotMetrics.SeriesLimitExceededTrackerSize; got != maxTrackedNames {
+		t.Fatalf("tracker exceeded its configured memory bound: got %d tracked names, want %d", got, maxTrackedNames)
+	}
+
+	stats := s.GetSeriesLimitExceededStats(0)
+	if len(stats.Entries) != maxTrackedNames {
+		t.Fatalf("unexpected number of tracked entries: got %d, want %d", len(stats.Entries), maxTrackedNames)
+	}
+	if stats.MaxTrackedMetricNames != maxTrackedNames {
+		t.Fatalf("unexpected MaxTrackedMetricNames: got %d, want %d", stats.MaxTrackedMetricNames, maxTrackedNames)
+	}
+}
