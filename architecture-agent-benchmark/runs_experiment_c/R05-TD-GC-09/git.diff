@@ -0,0 +1,217 @@
+package droppedseriesnames
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/google/go-cmp/cmp/cmpopts"
+)
+
+var statsResultCmpOpts = cmpopts.IgnoreFields(DroppedSeriesStatsResult{}, "CollectedSinceTs", "MaxSizeBytes", "CurrentSizeBytes")
+
+func TestTrackerNilIsNoop(t *testing.T) {
+	var tr *DroppedSeriesTracker
+
+	tr.IncrementDropCount([]byte("metric_1"))
+	tr.Reset()
+
+	if !tr.IsEmpty() {
+		t.Fatalf("expected nil DroppedSeriesTracker to report IsEmpty")
+	}
+
+	var tm DroppedSeriesTrackerMetrics
+	tr.UpdateMetrics(&tm)
+	if tm != (DroppedSeriesTrackerMetrics{}) {
+		t.Fatalf("expected nil DroppedSeriesTracker to leave DroppedSeriesTrackerMetrics untouched, got %+v", tm)
+	}
+
+	got := tr.TopRecords(10)
+	if len(got.Records) != 0 {
+		t.Fatalf("expected nil DroppedSeriesTracker to return no records, got %+v", got)
+	}
+}
+
+func TestTrackerRecordsMultipleMetricNames(t *testing.T) {
+	tr := NewTracker(0)
+
+	tr.IncrementDropCount([]byte("metric_a"))
+	tr.IncrementDropCount([]byte("metric_b"))
+	tr.IncrementDropCount([]byte("metric_b"))
+	tr.IncrementDropCount([]byte("metric_c"))
+	tr.IncrementDropCount([]byte("metric_c"))
+	tr.IncrementDropCount([]byte("metric_c"))
+
+	if tr.IsEmpty() {
+		t.Fatalf("expected DroppedSeriesTracker to have tracked entries")
+	}
+
+	got := tr.TopRecords(-1)
+	expected := DroppedSeriesStatsResult{
+		TrackedNames: 3,
+		Records: []Record{
+			{MetricName: "metric_c", DroppedRowsCount: 3},
+			{MetricName: "metric_b", DroppedRowsCount: 2},
+			{MetricName: "metric_a", DroppedRowsCount: 1},
+		},
+	}
+	if !cmp.Equal(expected, got, statsResultCmpOpts) {
+		t.Fatalf("unexpected TopRecords result: %s", cmp.Diff(expected, got, statsResultCmpOpts))
+	}
+}
+
+func TestTrackerTopRecordsOrderingAndLimit(t *testing.T) {
+	tr := NewTracker(0)
+
+	counts := map[string]int{
+		"metric_low":    1,
+		"metric_mid":    5,
+		"metric_high":   10,
+		"metric_medium": 3,
+	}
+	for name, n := range counts {
+		for range n {
+			tr.IncrementDropCount([]byte(name))
+		}
+	}
+
+	got := tr.TopRecords(2)
+	expected := DroppedSeriesStatsResult{
+		TrackedNames: 4,
+		Records: []Record{
+			{MetricName: "metric_high", DroppedRowsCount: 10},
+			{MetricName: "metric_mid", DroppedRowsCount: 5},
+		},
+	}
+	if !cmp.Equal(expected, got, statsResultCmpOpts) {
+		t.Fatalf("unexpected top-2 TopRecords result: %s", cmp.Diff(expected, got, statsResultCmpOpts))
+	}
+}
