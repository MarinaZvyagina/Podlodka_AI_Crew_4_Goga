+func TestTrackerDefaultMaxSizeBytes(t *testing.T) {
+	tr := NewTracker(0)
+	if tr.maxSizeBytes != DefaultMaxSizeBytes {
+		t.Fatalf("expected NewTracker(0) to fall back to DefaultMaxSizeBytes=%d, got %d", DefaultMaxSizeBytes, tr.maxSizeBytes)
+	}
+}
+
+func TestTrackerUnboundedGrowthIsCapped(t *testing.T) {
+	// Even with a huge number of distinct metric names, the tracker's tracked
+	// item count must stay bounded by the configured byte budget.
+	const maxSizeBytes = 64 * 1024
+	tr := NewTracker(maxSizeBytes)
+
+	for i := range 1_000_000 {
+		tr.IncrementDropCount([]byte(fmt.Sprintf("metric_%d", i)))
+	}
+
+	got := tr.TopRecords(-1)
+	if got.CurrentSizeBytes > maxSizeBytes*2 {
+		t.Fatalf("tracker memory grew unbounded: CurrentSizeBytes=%d, maxSizeBytes=%d", got.CurrentSizeBytes, maxSizeBytes)
+	}
+	if len(got.Records) >= 1_000_000 {
+		t.Fatalf("expected tracker to cap tracked names well below 1_000_000, got %d", len(got.Records))
+	}
+}
+
+func TestTrackerReset(t *testing.T) {
+	tr := NewTracker(0)
+	tr.IncrementDropCount([]byte("metric_1"))
+	tr.IncrementDropCount([]byte("metric_2"))
+
+	if tr.IsEmpty() {
+		t.Fatalf("expected DroppedSeriesTracker to have tracked entries before Reset")
+	}
+
+	tr.Reset()
+
+	if !tr.IsEmpty() {
+		t.Fatalf("expected DroppedSeriesTracker to be empty after Reset")
+	}
+	got := tr.TopRecords(-1)
+	if len(got.Records) != 0 {
+		t.Fatalf("expected no records after Reset, got %+v", got.Records)
+	}
+}
+
+func TestTrackerConcurrentIncrements(t *testing.T) {
+	tr := NewTracker(0)
+	const concurrency = 8
+	const incrementsPerGoroutine = 200
+
+	var wg sync.WaitGroup
+	for range concurrency {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for range incrementsPerGoroutine {
+				tr.IncrementDropCount([]byte("metric_hot"))
+			}
+		}()
+	}
+	wg.Wait()
+
+	got := tr.TopRecords(-1)
+	expected := DroppedSeriesStatsResult{
+		TrackedNames: 1,
+		Records: []Record{
+			{MetricName: "metric_hot", DroppedRowsCount: concurrency * incrementsPerGoroutine},
+		},
+	}
+	if !cmp.Equal(expected, got, statsResultCmpOpts) {
+		t.Fatalf("unexpected concurrent TopRecords result: %s", cmp.Diff(expected, got, statsResultCmpOpts))
+	}
+}
+
+func TestTrackerUpdateMetrics(t *testing.T) {
+	tr := NewTracker(1000)
+	tr.IncrementDropCount([]byte("metric_1"))
+	tr.IncrementDropCount([]byte("metric_2"))
+
+	var tm DroppedSeriesTrackerMetrics
+	tr.UpdateMetrics(&tm)
+
+	if tm.MaxSizeBytes != 1000 {
+		t.Fatalf("unexpected MaxSizeBytes: got %d, want 1000", tm.MaxSizeBytes)
+	}
+	if tm.CurrentItemsCount != 2 {
+		t.Fatalf("unexpected CurrentItemsCount: got %d, want 2", tm.CurrentItemsCount)
+	}
+	if tm.CurrentSizeBytes == 0 {
+		t.Fatalf("expected non-zero CurrentSizeBytes")
+	}
+}
