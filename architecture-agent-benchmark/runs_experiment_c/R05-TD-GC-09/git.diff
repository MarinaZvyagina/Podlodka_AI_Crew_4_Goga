+func TestStorageDroppedSeriesNamesStats(t *testing.T) {
+	defer testRemoveAll(t)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	tr := TimeRange{minTimestamp, maxTimestamp}
+
+	newRowForName := func(name string) MetricRow {
+		var mn MetricName
+		mn.MetricGroup = []byte(name)
+		return MetricRow{
+			MetricNameRaw: mn.marshalRaw(nil),
+			Timestamp:     rng.Int63n(maxTimestamp-minTimestamp) + minTimestamp,
+			Value:         rng.NormFloat64(),
+		}
+	}
+
+	t.Run("DisabledByDefault", func(t *testing.T) {
+		defer testRemoveAll(t)
+		const maxHourlySeries = 1
+		s := MustOpenStorage(t.Name(), OpenOptions{MaxHourlySeries: maxHourlySeries})
+		defer s.MustClose()
+
+		s.AddRows(testGenerateMetricRowsWithPrefix(rng, 10, "m", tr), defaultPrecisionBits)
+		s.DebugFlush()
+
+		got := s.GetDroppedSeriesNamesStats(-1)
+		if len(got.Records) != 0 {
+			t.Fatalf("expected no dropped series names to be tracked when TrackDroppedSeriesNames is unset, got %+v", got.Records)
+		}
+	})
+
+	t.Run("RecordsMultipleNamesAndTopOffenders", func(t *testing.T) {
+		defer testRemoveAll(t)
+		const maxHourlySeries = 3
+		s := MustOpenStorage(t.Name(), OpenOptions{
+			MaxHourlySeries:         maxHourlySeries,
+			TrackDroppedSeriesNames: true,
+		})
+		defer s.MustClose()
+
+		// Fill up the hourly series limit with distinct series, so that every
+		// subsequently ingested new metric name gets rejected.
+		s.AddRows(testGenerateMetricRowsWithPrefix(rng, maxHourlySeries, "seed", tr), defaultPrecisionBits)
+		s.DebugFlush()
+
+		namesAndCounts := map[string]int{
+			"rejected_a": 5,
+			"rejected_b": 2,
+			"rejected_c": 8,
+		}
+		for name, count := range namesAndCounts {
+			for range count {
+				s.AddRows([]MetricRow{newRowForName(name)}, defaultPrecisionBits)
+			}
+		}
+		s.DebugFlush()
+
+		stats := s.GetDroppedSeriesNamesStats(-1)
+		if stats.TrackedNames != uint64(len(namesAndCounts)) {
+			t.Fatalf("unexpected TrackedNames: got %d, want %d", stats.TrackedNames, len(namesAndCounts))
+		}
+		got := make(map[string]uint64, len(stats.Records))
+		for _, r := range stats.Records {
+			got[r.MetricName] = r.DroppedRowsCount
+		}
+		for name, count := range namesAndCounts {
+			if got[name] != uint64(count) {
+				t.Fatalf("unexpected drop count for %q: got %d, want %d", name, got[name], count)
+			}
+		}
+
+		top1 := s.GetDroppedSeriesNamesStats(1)
+		if len(top1.Records) != 1 || top1.Records[0].MetricName != "rejected_c" {
+			t.Fatalf("unexpected top-1 offender: got %+v, want rejected_c", top1.Records)
+		}
+
+		s.ResetDroppedSeriesNamesStats()
+		afterReset := s.GetDroppedSeriesNamesStats(-1)
+		if len(afterReset.Records) != 0 {
+			t.Fatalf("expected no records after ResetDroppedSeriesNamesStats, got %+v", afterReset.Records)
+		}
+	})
+
+	t.Run("MemoryBoundRespected", func(t *testing.T) {
+		defer testRemoveAll(t)
+		defer SetDroppedSeriesNamesCacheSize(0)
+
+		const maxHourlySeries = 1
+		// Only enough space to track a handful of metric names.
+		SetDroppedSeriesNamesCacheSize(256)
+		s := MustOpenStorage(t.Name(), OpenOptions{
+			MaxHourlySeries:         maxHourlySeries,
+			TrackDroppedSeriesNames: true,
+		})
+		defer s.MustClose()
+
+		s.AddRows(testGenerateMetricRowsWithPrefix(rng, maxHourlySeries, "seed", tr), defaultPrecisionBits)
+		s.DebugFlush()
+
+		const rejectedNamesCount = 1000
+		for i := range rejectedNamesCount {
+			s.AddRows([]MetricRow{newRowForName(fmt.Sprintf("rejected_%d", i))}, defaultPrecisionBits)
+		}
+		s.DebugFlush()
+
+		stats := s.GetDroppedSeriesNamesStats(-1)
+		if len(stats.Records) >= rejectedNamesCount {
+			t.Fatalf("expected tracked names count to be bounded well below %d, got %d", rejectedNamesCount, len(stats.Records))
+		}
+		if stats.CurrentSizeBytes > 2*stats.MaxSizeBytes {
+			t.Fatalf("tracked size %d grew far beyond configured bound %d", stats.CurrentSizeBytes, stats.MaxSizeBytes)
+		}
+	})
+}
