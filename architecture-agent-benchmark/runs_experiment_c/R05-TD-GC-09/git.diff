+func TestTrackerRespectsMaxSizeBytes(t *testing.T) {
+	// Only enough budget for 2 metric names of this size.
+	tr := NewTracker(storeOverhead + 2*10)
+
+	names := []string{"metric_0001", "metric_0002", "metric_0003", "metric_0004", "metric_0005"}
+	for _, name := range names {
+		tr.IncrementDropCount([]byte(name))
+	}
+
+	got := tr.TopRecords(-1)
+	if len(got.Records) >= len(names) {
+		t.Fatalf("expected DroppedSeriesTracker to stop tracking new metric names once maxSizeBytes is exceeded, got %d records", len(got.Records))
+	}
+	if got.CurrentSizeBytes > tr.maxSizeBytes+uint64(len(names[0]))+storeOverhead {
+		t.Fatalf("CurrentSizeBytes %d grew far beyond maxSizeBytes %d", got.CurrentSizeBytes, tr.maxSizeBytes)
+	}
+
+	// Already-tracked names must keep being incremented even once the tracker is full.
+	trackedName := got.Records[0].MetricName
+	before := got.Records[0].DroppedRowsCount
+	tr.IncrementDropCount([]byte(trackedName))
+	got = tr.TopRecords(-1)
+	var after uint64
+	for _, r := range got.Records {
+		if r.MetricName == trackedName {
+			after = r.DroppedRowsCount
+		}
+	}
+	if after != before+1 {
+		t.Fatalf("expected already-tracked metric name to keep being incremented once full: before=%d after=%d", before, after)
+	}
+}
