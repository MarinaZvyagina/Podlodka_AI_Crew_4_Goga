new file mode 100644
index 0000000..b09e85b
--- /dev/null
+++ b/lib/storage/droppedseriesnames/tracker.go
@@ -0,0 +1,241 @@
+// Package droppedseriesnames tracks, per metric name, how many samples were
+// dropped because adding the corresponding series would have exceeded the
+// configured -storage.maxHourlySeries or -storage.maxDailySeries unique-series
+// limit.
+package droppedseriesnames
+
+import (
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/bytesutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+const (
+	// metricNameBufSize defines size of buffer for batched metric name allocations.
+	metricNameBufSize = 16 * 1024
+	// counterBufSize defines size of buffer for batched counter allocations.
+	counterBufSize = 1024
+	// storeOverhead approximates the in-memory overhead of a single tracked
+	// entry: map bucket + counter pointer + string header.
+	storeOverhead = 24 + 8 + 16
+
+	// DefaultMaxSizeBytes is the memory bound applied when a DroppedSeriesTracker is created
+	// without an explicit size override. It is a fixed value independent of
+	// total system memory, so that installations with millions of distinct
+	// metric names cannot make this diagnostic feature consume arbitrary
+	// amounts of memory.
+	DefaultMaxSizeBytes = 8 * 1024 * 1024
+)
+
+// DroppedSeriesTracker is an in-memory, bounded tracker of per-metric-name counts of
+// samples dropped due to series cardinality limits.
+//
+// DroppedSeriesTracker never evicts individual entries once the configured byte budget is
+// reached: IncrementDropCount becomes a no-op for any metric name not already
+// tracked until Reset is called. All exported methods tolerate a nil receiver
+// as a no-op, so an owning cell may hold a `*DroppedSeriesTracker` field that is
+// intentionally left nil (e.g. the feature disabled) without a nil-check at
+// every call site.
+type DroppedSeriesTracker struct {
+	maxSizeBytes uint64
+
+	creationTs        atomic.Uint64
+	currentSizeBytes  atomic.Uint64
+	currentItemsCount atomic.Uint64
+
+	mu sync.RWMutex
+
+	store map[string]*atomic.Uint64
+	// holds batch allocations for counters
+	counterBuf []atomic.Uint64
+	// holds batch allocations for metric names
+	metricNamesBuf []byte
+
+	getCurrentTs func() uint64
+}
+
+// NewTracker creates a DroppedSeriesTracker bounded to maxSizeBytes of total tracked-entry
+// size. If maxSizeBytes is 0, DefaultMaxSizeBytes is used instead.
+func NewTracker(maxSizeBytes uint64) *DroppedSeriesTracker {
+	if maxSizeBytes == 0 {
+		maxSizeBytes = DefaultMaxSizeBytes
+	}
+	t := &DroppedSeriesTracker{
+		maxSizeBytes: maxSizeBytes,
+		getCurrentTs: fasttime.UnixTimestamp,
+	}
+	t.initEmpty()
+	return t
+}
+
+func (t *DroppedSeriesTracker) initEmpty() {
+	t.store = make(map[string]*atomic.Uint64)
+	t.metricNamesBuf = make([]byte, 0, metricNameBufSize)
+	t.counterBuf = nil
+	t.currentSizeBytes.Store(0)
+	t.currentItemsCount.Store(0)
+	t.creationTs.Store(t.getCurrentTs())
+}
+
+func (t *DroppedSeriesTracker) nextCounterLocked() *atomic.Uint64 {
+	n := len(t.counterBuf) + 1
+	if n > cap(t.counterBuf) {
+		// allocate a new slice instead of reallocating the existing one:
+		// it saves memory and reduces GC pressure.
+		t.counterBuf = make([]atomic.Uint64, 0, counterBufSize)
+		n = 1
+	}
+	t.counterBuf = t.counterBuf[:n]
+	return &t.counterBuf[n-1]
+}
+
+// cloneMetricNameLocked uses the same idea as strings.Clone, but instead of a
+// direct []byte allocation for each cloned string, it allocates
+// metricNamesBuf, copies the provided metricName into it, and uses a string
+// reference into that subslice.
+func (t *DroppedSeriesTracker) cloneMetricNameLocked(metricName []byte) string {
+	if len(metricName) > metricNameBufSize {
+		b := make([]byte, len(metricName))
+		copy(b, metricName)
+		return bytesutil.ToUnsafeString(b)
+	}
+	idx := len(t.metricNamesBuf)
+	n := len(metricName) + len(t.metricNamesBuf)
+	if n > cap(t.metricNamesBuf) {
+		t.metricNamesBuf = make([]byte, 0, metricNameBufSize)
+		idx = 0
+	}
+	t.metricNamesBuf = append(t.metricNamesBuf, metricName...)
+	return bytesutil.ToUnsafeString(t.metricNamesBuf[idx:])
+}
+
+func (t *DroppedSeriesTracker) cacheIsFull() bool {
+	return t.currentSizeBytes.Load() > t.maxSizeBytes
+}
+
+// IncrementDropCount records one dropped sample for metricName, creating a new
+// zero-based counter for it if one does not already exist. Once the tracker's
+// byte budget is exhausted, it becomes a no-op for any metric name not already
+// tracked. Nil-safe.
+func (t *DroppedSeriesTracker) IncrementDropCount(metricName []byte) {
+	if t == nil {
+		return
+	}
+	t.mu.RLock()
+	c, ok := t.store[bytesutil.ToUnsafeString(metricName)]
+	t.mu.RUnlock()
+	if ok {
+		c.Add(1)
+		return
+	}
+	if t.cacheIsFull() {
+		return
+	}
+
+	t.mu.Lock()
+	c, ok = t.store[bytesutil.ToUnsafeString(metricName)]
+	if !ok {
+		c = t.nextCounterLocked()
+		key := t.cloneMetricNameLocked(metricName)
+		t.store[key] = c
+	}
+	t.mu.Unlock()
+
+	if !ok {
+		t.currentSizeBytes.Add(uint64(len(metricName)) + storeOverhead)
+		t.currentItemsCount.Add(1)
+	}
+	c.Add(1)
+}
+
+// IsEmpty reports whether any entries are currently tracked. Nil-safe.
+func (t *DroppedSeriesTracker) IsEmpty() bool {
+	if t == nil {
+		return true
+	}
+	return t.currentItemsCount.Load() == 0
+}
+
+// Reset clears all tracked entries and restarts the collection window
+// returned as DroppedSeriesStatsResult.CollectedSinceTs. Nil-safe.
+func (t *DroppedSeriesTracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.initEmpty()
+	t.mu.Unlock()
+}
+
+// DroppedSeriesTrackerMetrics holds DroppedSeriesTracker's internal metrics to report.
+type DroppedSeriesTrackerMetrics struct {
+	CurrentSizeBytes  uint64
+	CurrentItemsCount uint64
+	MaxSizeBytes      uint64
+}
+
+// UpdateMetrics writes internal metrics to dst. Nil-safe.
+func (t *DroppedSeriesTracker) UpdateMetrics(dst *DroppedSeriesTrackerMetrics) {
+	if t == nil {
+		return
+	}
+	dst.CurrentSizeBytes = t.currentSizeBytes.Load()
+	dst.CurrentItemsCount = t.currentItemsCount.Load()
+	dst.MaxSizeBytes = t.maxSizeBytes
+}
+
+// Record is one tracked metric name's dropped-samples count.
+type Record struct {
+	MetricName       string
+	DroppedRowsCount uint64
+}
+
+// DroppedSeriesStatsResult is the response for a TopRecords query.
+type DroppedSeriesStatsResult struct {
+	CollectedSinceTs uint64
+	TrackedNames     uint64
+	MaxSizeBytes     uint64
+	CurrentSizeBytes uint64
+	Records          []Record
+}
+
+// TopRecords returns at most limit tracked metric names with the highest
+// DroppedRowsCount, sorted by DroppedRowsCount in descending order (ties
+// broken by MetricName), together with tracker-wide totals. A negative limit
+// returns all tracked records. Nil-safe.
+func (t *DroppedSeriesTracker) TopRecords(limit int) DroppedSeriesStatsResult {
+	var result DroppedSeriesStatsResult
+	if t == nil {
+		return result
+	}
+
+	t.mu.RLock()
+	defer t.mu.RUnlock()
+
+	result.CollectedSinceTs = t.creationTs.Load()
+	result.TrackedNames = t.currentItemsCount.Load()
+	result.MaxSizeBytes = t.maxSizeBytes
+	result.CurrentSizeBytes = t.currentSizeBytes.Load()
+
+	records := make([]Record, 0, len(t.store))
+	for name, c := range t.store {
+		records = append(records, Record{
+			MetricName:       name,
+			DroppedRowsCount: c.Load(),
+		})
+	}
+	sort.Slice(records, func(i, j int) bool {
+		if records[i].DroppedRowsCount == records[j].DroppedRowsCount {
+			return records[i].MetricName < records[j].MetricName
+		}
+		return records[i].DroppedRowsCount > records[j].DroppedRowsCount
+	})
+	if limit >= 0 && limit < len(records) {
+		records = records[:limit]
+	}
+	result.Records = records
+	return result
+}
