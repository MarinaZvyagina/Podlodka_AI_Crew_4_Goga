+func TestUserChangePasswordToEmpty(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// changing to a blank password must be rejected for a password-protected user
+	_, err := as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo"})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo", HashedPassword: ""})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// the original password must still work
+	ctx := context.WithValue(context.WithValue(t.Context(), AuthenticateParamIndex{}, uint64(1)), AuthenticateParamSimpleTokenPrefix{}, "dummy")
+	_, err = as.Authenticate(ctx, "foo", "bar")
+	require.NoErrorf(t, err, "expected original password to still be valid, got %v", err)
+}
+
+func TestUserChangePasswordToEmptyNoPasswordUser(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	const userName = "usernopass-changepw"
+	_, err := as.UserAdd(&pb.AuthUserAddRequest{Name: userName, Options: &authpb.UserAddOptions{NoPassword: true}})
+	require.NoErrorf(t, err, "expected passwordless user add to succeed, got %v", err)
+
+	// changing the password of a passwordless account to blank must still succeed
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: userName})
+	require.NoErrorf(t, err, "expected password change of no-password user to succeed, got %v", err)
+}
