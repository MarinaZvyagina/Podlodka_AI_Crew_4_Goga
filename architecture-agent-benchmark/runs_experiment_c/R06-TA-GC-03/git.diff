diff --git a/server/auth/store_test.go b/server/auth/store_test.go
index fae37161d..3a4166315 100644
--- a/server/auth/store_test.go
+++ b/server/auth/store_test.go
@@ -174,6 +174,43 @@ func TestUserAdd(t *testing.T) {
 	require.Truef(t, ok, "user %s should be added but it doesn't exist in rangePermCache", userName)
 }
 
+func TestUserAddWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// blank password without opting into NoPassword must be rejected
+	ua := &pb.AuthUserAddRequest{Name: "empty-pwd-user", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// blank password when Options is nil defaults to NoPassword: false, must also be rejected
+	ua = &pb.AuthUserAddRequest{Name: "empty-pwd-user-2"}
+	_, err = as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// an explicitly passwordless account must keep working
+	ua = &pb.AuthUserAddRequest{Name: "no-pwd-user", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	require.NoErrorf(t, err, "expected no error, got %v", err)
+}
+
+func TestUserChangePasswordToEmpty(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// changing an existing user's password to blank must be rejected
+	_, err := as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo"})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a passwordless account must remain unaffected by the check
+	ua := &pb.AuthUserAddRequest{Name: "no-pwd-user", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	require.NoErrorf(t, err, "expected no error, got %v", err)
+
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "no-pwd-user"})
+	require.NoErrorf(t, err, "expected no error, got %v", err)
+}
+
 func TestRecover(t *testing.T) {
 	as, tearDown := setupAuthStore(t)
 	defer as.Close()
