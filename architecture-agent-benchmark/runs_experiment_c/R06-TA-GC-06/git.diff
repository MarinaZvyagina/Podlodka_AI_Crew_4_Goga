+func TestUserAddChangePasswordEmpty(t *testing.T) {
+	integration.BeforeTest(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	authapi := clus.RandClient()
+
+	// creating a password-protected user with a blank password must fail
+	_, err := authapi.UserAdd(t.Context(), "foo", "")
+	require.ErrorIsf(t, err, rpctypes.ErrPasswordEmpty, "expected %v, got %v", rpctypes.ErrPasswordEmpty, err)
+
+	// a no-password account is unaffected by the check
+	_, err = authapi.UserAddWithOptions(t.Context(), "nopass", "", &clientv3.UserAddOptions{NoPassword: true})
+	require.NoError(t, err)
+
+	// once a real user exists, clearing its password out must fail the same way
+	_, err = authapi.UserAdd(t.Context(), "bar", "bar-password")
+	require.NoError(t, err)
+	_, err = authapi.UserChangePassword(t.Context(), "bar", "")
+	require.ErrorIsf(t, err, rpctypes.ErrPasswordEmpty, "expected %v, got %v", rpctypes.ErrPasswordEmpty, err)
+
+	// changing the no-password account's password to blank is still fine
+	_, err = authapi.UserChangePassword(t.Context(), "nopass", "")
+	require.NoError(t, err)
+}
