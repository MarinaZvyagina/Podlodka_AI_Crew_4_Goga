index fae37161d..e5aa235a3 100644
--- a/server/auth/store_test.go
+++ b/server/auth/store_test.go
@@ -174,6 +174,24 @@ func TestUserAdd(t *testing.T) {
 	require.Truef(t, ok, "user %s should be added but it doesn't exist in rangePermCache", userName)
 }
 
+func TestUserAddWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	ua := &pb.AuthUserAddRequest{Name: "no-password-not-opted-in", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	ua = &pb.AuthUserAddRequest{Name: "no-password-not-opted-in", HashedPassword: "", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err = as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a passwordless account must not be affected by the empty-password check
+	ua = &pb.AuthUserAddRequest{Name: "no-password-opted-in", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	require.NoErrorf(t, err, "expected nil, got %v", err)
+}
+
