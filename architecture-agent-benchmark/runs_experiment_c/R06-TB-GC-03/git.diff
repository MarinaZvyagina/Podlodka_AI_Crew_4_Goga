-func checkLease(lessor lease.Lessor, p *pb.PutRequest) error {
+func checkLease(lessor lease.Lessor, p *pb.PutRequest, pending pendingLeaseAttaches) error {
 	leaseID := lease.LeaseID(p.Lease)
-	if leaseID != lease.NoLease {
-		if l := lessor.Lookup(leaseID); l == nil {
-			return lease.ErrLeaseNotFound
+	if leaseID == lease.NoLease {
+		return nil
+	}
+	l := lessor.Lookup(leaseID)
+	if l == nil {
+		return lease.ErrLeaseNotFound
+	}
+
+	key := string(p.Key)
+	if l.Contains(lease.LeaseItem{Key: key}) {
+		// Re-attaching a key already on this lease never grows it.
+		return nil
+	}
+
+	staged := pending[leaseID]
+	if _, ok := staged[key]; ok {
+		// Already counted as a new attachment earlier in this request.
+		return nil
+	}
+
+	if l.Len()+len(staged) >= lessor.MaxLeaseKeys() {
+		return lease.ErrTooManyLeaseKeys
+	}
+
+	if pending != nil {
+		if staged == nil {
+			staged = make(map[string]struct{})
+			pending[leaseID] = staged
 		}
+		staged[key] = struct{}{}
 	}
 	return nil
 }
