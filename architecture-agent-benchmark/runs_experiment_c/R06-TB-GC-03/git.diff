+// pendingLeaseAttaches tracks, per lease, the set of keys that have already
+// been validated as new attachments earlier within the same txn request but
+// have not yet actually been attached (checks run before any op in a txn is
+// executed). It lets checkLease enforce the per-lease key limit correctly
+// across a batch of puts, not just one at a time.
+type pendingLeaseAttaches map[lease.LeaseID]map[string]struct{}
+
+func checkPut(trace *traceutil.Trace, txnWrite mvcc.ReadView, lessor lease.Lessor, p *pb.PutRequest, pending pendingLeaseAttaches) error {
+	err := checkLease(lessor, p, pending)
 	if err != nil {
 		return err
 	}
@@ -77,12 +84,38 @@ func checkPut(trace *traceutil.Trace, txnWrite mvcc.ReadView, lessor lease.Lesso
