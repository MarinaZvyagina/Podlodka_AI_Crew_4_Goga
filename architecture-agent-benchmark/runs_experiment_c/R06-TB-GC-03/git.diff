+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package txn
+
+import (
+	"testing"
+
+	"github.com/Masterminds/semver/v3"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+// fakeCluster satisfies the unexported cluster interface required by
+// lease.NewLessor.
+type fakeCluster struct{}
+
+func (fakeCluster) Version() *semver.Version { return semver.MustParse("3.6.0") }
+
+// setupWithMaxLeaseKeys wires up a real lessor (not lease.FakeLessor, which
+// never enforces the per-lease key limit) backed by an mvcc store, and
+// grants a lease bound by maxLeaseKeys.
+func setupWithMaxLeaseKeys(t *testing.T, maxLeaseKeys int) (mvcc.KV, lease.Lessor, lease.LeaseID) {
+	t.Helper()
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { betesting.Close(t, b) })
+
+	lessor := lease.NewLessor(zaptest.NewLogger(t), b, fakeCluster{}, lease.LessorConfig{
+		MinLeaseTTL:  1,
+		MaxLeaseKeys: maxLeaseKeys,
+	})
+	t.Cleanup(lessor.Stop)
+
+	s := mvcc.NewStore(zaptest.NewLogger(t), b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() { s.Close() })
+
+	l, err := lessor.Grant(1, 100)
+	require.NoError(t, err)
+	return s, lessor, l.ID
+}
+
+func TestPutRejectsWhenLeaseKeyLimitExceeded(t *testing.T) {
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+	s, lessor, leaseID := setupWithMaxLeaseKeys(t, 2)
+
+	_, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("a"), Lease: int64(leaseID)})
+	require.NoError(t, err)
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("b"), Lease: int64(leaseID)})
+	require.NoError(t, err)
+
+	// The lease is now at capacity: attaching a third, distinct key must fail
+	// cleanly rather than applying partially or crashing.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("c"), Lease: int64(leaseID)})
+	require.ErrorIs(t, err, lease.ErrTooManyLeaseKeys)
+
+	// Re-attaching (overwriting) a key already on the lease does not grow it
+	// and must keep working.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("a"), Value: []byte("updated"), Lease: int64(leaseID)})
+	require.NoError(t, err)
+
+	// The server must still be healthy and able to serve unrelated writes.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("unleased")})
+	require.NoError(t, err)
+
+	require.Equal(t, 2, lessor.Lookup(leaseID).Len())
+}
+
+func TestTxnRejectsBatchExceedingLeaseKeyLimit(t *testing.T) {
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+	s, lessor, leaseID := setupWithMaxLeaseKeys(t, 2)
+
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a"), Lease: int64(leaseID)}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("b"), Lease: int64(leaseID)}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("c"), Lease: int64(leaseID)}}},
+		},
+	}
+	_, _, err := Txn(ctx, lg, txn, false, s, lessor, false)
+	require.ErrorIs(t, err, lease.ErrTooManyLeaseKeys)
+
+	// The whole txn must be rejected up front: none of its puts should have
+	// been applied.
+	rr, err := s.Range(ctx, []byte("a"), []byte("d"), mvcc.RangeOptions{})
+	require.NoError(t, err)
+	require.Empty(t, rr.KVs)
+	require.Equal(t, 0, lessor.Lookup(leaseID).Len())
+
+	// The server must remain healthy afterward.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("z"), Lease: int64(leaseID)})
+	require.NoError(t, err)
+}
