+type fakeVersionCluster struct{}
+
+func (fakeVersionCluster) Version() *semver.Version { return nil }
+
+// setupWithLeaseLimit builds a store backed by a real lessor (not
+// lease.FakeLessor), configured with the given max number of keys per lease,
+// so tests can exercise the actual enforcement path.
+func setupWithLeaseLimit(t *testing.T, maxLeaseAttachedKeys int) (mvcc.KV, lease.Lessor) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() {
+		betesting.Close(t, b)
+	})
+	lessor := lease.NewLessor(zaptest.NewLogger(t), b, fakeVersionCluster{}, lease.LessorConfig{
+		MaxLeaseAttachedKeys: maxLeaseAttachedKeys,
+	})
+	t.Cleanup(lessor.Stop)
+	s := mvcc.NewStore(zaptest.NewLogger(t), b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() {
+		s.Close()
+	})
+	return s, lessor
+}
+
+func TestPutRejectsWriteOverLeaseKeyLimit(t *testing.T) {
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	lg := zaptest.NewLogger(t)
+
+	s, lessor := setupWithLeaseLimit(t, 2)
+	_, err := lessor.Grant(lease.LeaseID(1), 100)
+	require.NoError(t, err)
+
+	// Two distinct keys fill up the lease's budget.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k1"), Lease: 1})
+	require.NoError(t, err)
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k2"), Lease: 1})
+	require.NoError(t, err)
+
+	// Re-attaching an already-attached key must keep working.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k1"), Value: []byte("v2"), Lease: 1})
+	require.NoError(t, err)
+
+	// A third, brand new key must be rejected cleanly.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("k3"), Lease: 1})
+	require.ErrorIs(t, err, lease.ErrTooManyKeysForLease)
+
+	// The lease must still only have the two original keys attached.
+	l := lessor.Lookup(lease.LeaseID(1))
+	require.Equal(t, 2, l.Len())
+
+	// The server must remain healthy: unrelated writes keep working.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("unrelated"), Value: []byte("v")})
+	require.NoError(t, err)
+}
+
+func TestTxnRejectsWriteOverLeaseKeyLimit(t *testing.T) {
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	lg := zaptest.NewLogger(t)
+
+	s, lessor := setupWithLeaseLimit(t, 2)
+	_, err := lessor.Grant(lease.LeaseID(1), 100)
+	require.NoError(t, err)
+
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("k1"), Lease: 1}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("k2"), Lease: 1}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("k3"), Lease: 1}}},
+		},
+	}
+	_, _, err = Txn(ctx, lg, txn, false, s, lessor, false)
+	require.ErrorIs(t, err, lease.ErrTooManyKeysForLease)
+
+	// Nothing from the rejected txn should have been applied.
+	l := lessor.Lookup(lease.LeaseID(1))
+	require.Equal(t, 0, l.Len())
+
+	// The server must remain healthy: a valid txn afterwards still succeeds.
+	okTxn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("k1"), Lease: 1}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("k2"), Lease: 1}}},
+		},
+	}
+	_, _, err = Txn(ctx, lg, okTxn, false, s, lessor, false)
+	require.NoError(t, err)
+	require.Equal(t, 2, l.Len())
+}
