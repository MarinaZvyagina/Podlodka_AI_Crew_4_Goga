+import "go.etcd.io/etcd/server/v3/lease"
+
+// leaseAttachBudget tracks, across all the put operations validated together
+// (e.g. the requests within a single Txn), how many distinct new keys are
+// tentatively being attached to each lease. This lets the configured
+// per-lease key limit be enforced up front, before any of the writes are
+// actually applied, so a request either fails cleanly in its entirety or is
+// fully applied.
+type leaseAttachBudget struct {
+	lessor  lease.Lessor
+	maxKeys int
+	// pending counts, per lease, how many keys have been tentatively
+	// reserved so far by this budget but aren't yet reflected in the
+	// lessor's own state. Left nil until the first new attachment, since
+	// most puts (no lease, or a re-attach of an already-attached key)
+	// never need it.
+	pending map[lease.LeaseID]int
+	// keyLease remembers the tentative lease of every key that this
+	// budget has already moved to a new lease, so a key touched more than
+	// once (e.g. by two puts in the same txn) is evaluated against its
+	// most recent tentative lease rather than stale lessor state. Left
+	// nil until first needed, for the same reason as pending.
+	keyLease map[string]lease.LeaseID
+}
+
+func newLeaseAttachBudget(lessor lease.Lessor) *leaseAttachBudget {
+	return &leaseAttachBudget{lessor: lessor, maxKeys: lessor.MaxLeaseAttachedKeys()}
+}
+
+// reserve checks whether attaching key to leaseID is allowed, and if so,
+// tentatively records the attachment so later calls on the same budget see
+// its effect. It returns lease.ErrLeaseNotFound if leaseID no longer exists,
+// or lease.ErrTooManyKeysForLease if the attachment would push leaseID over
+// its configured key limit. A key whose current (or already-reserved) lease
+// is already leaseID is always allowed, since it does not add a new key.
+func (b *leaseAttachBudget) reserve(key string, leaseID lease.LeaseID) error {
+	if leaseID == lease.NoLease {
+		return nil
+	}
+	current, tracked := lease.NoLease, false
+	if b.keyLease != nil {
+		current, tracked = b.keyLease[key]
+	}
+	if !tracked {
+		current = b.lessor.GetLease(lease.LeaseItem{Key: key})
+	}
+	if current == leaseID {
+		return nil
+	}
+	l := b.lessor.Lookup(leaseID)
+	if l == nil {
+		return lease.ErrLeaseNotFound
+	}
+	pending := 0
+	if b.pending != nil {
+		pending = b.pending[leaseID]
+	}
+	if l.Len()+pending >= b.maxKeys {
+		return lease.ErrTooManyKeysForLease
+	}
+	if b.pending == nil {
+		b.pending = make(map[lease.LeaseID]int)
+	}
+	b.pending[leaseID]++
+	if b.keyLease == nil {
+		b.keyLease = make(map[string]lease.LeaseID)
+	}
+	b.keyLease[key] = leaseID
+	return nil
+}
