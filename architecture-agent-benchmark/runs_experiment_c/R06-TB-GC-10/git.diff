+// TestPutLeaseKeyLimit verifies that Put rejects a write that would attach a
+// new key to a lease beyond the lessor's configured maximum, that re-attaching
+// an already-attached key is never rejected, and that the store keeps serving
+// unrelated writes after a rejection.
+func TestPutLeaseKeyLimit(t *testing.T) {
+	lg := zaptest.NewLogger(t)
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() {
+		betesting.Close(t, b)
+	})
+
+	le := lease.NewLessor(lg, b, nil, lease.LessorConfig{MinLeaseTTL: 1, MaxLeaseKeys: 2})
+	t.Cleanup(le.Stop)
+
+	s := mvcc.NewStore(lg, b, le, mvcc.StoreConfig{})
+	t.Cleanup(func() {
+		s.Close()
+	})
+
+	if _, err := le.Grant(lease.LeaseID(1), 100); err != nil {
+		t.Fatalf("failed to grant lease: %v", err)
+	}
+
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+
+	put := func(key string, leaseID int64) error {
+		_, _, err := Put(ctx, lg, le, s, &pb.PutRequest{Key: []byte(key), Value: []byte("v"), Lease: leaseID})
+		return err
+	}
+
+	if err := put("foo", 1); err != nil {
+		t.Fatalf("expected first new key to succeed, got %v", err)
+	}
+	if err := put("bar", 1); err != nil {
+		t.Fatalf("expected second new key to succeed, got %v", err)
+	}
+
+	// lease is now at the configured limit of 2 keys.
+	err := put("baz", 1)
+	if !errors.Is(err, lease.ErrTooManyKeys) {
+		t.Fatalf("expected ErrTooManyKeys, got %v", err)
+	}
+
+	// re-attaching an already-attached key must not be rejected.
+	if err := put("foo", 1); err != nil {
+		t.Fatalf("expected re-attach of existing key to succeed, got %v", err)
+	}
+
+	// the store and lessor must keep working for unrelated writes after the rejection.
+	if err := put("unrelated", 0); err != nil {
+		t.Fatalf("expected unrelated write without a lease to succeed, got %v", err)
+	}
+	if _, err := le.Grant(lease.LeaseID(2), 100); err != nil {
+		t.Fatalf("expected lessor to remain healthy and grant a new lease, got %v", err)
+	}
+	if err := put("other", 2); err != nil {
+		t.Fatalf("expected write under a fresh lease to succeed, got %v", err)
+	}
+}
