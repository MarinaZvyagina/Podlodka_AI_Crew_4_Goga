+func (le *lessor) CheckAttachLimit(id LeaseID, item LeaseItem) error {
+	le.mu.RLock()
+	l := le.leaseMap[id]
+	le.mu.RUnlock()
+	if l == nil {
+		return ErrLeaseNotFound
+	}
+
+	l.mu.RLock()
+	defer l.mu.RUnlock()
+	if _, ok := l.itemSet[item]; ok {
