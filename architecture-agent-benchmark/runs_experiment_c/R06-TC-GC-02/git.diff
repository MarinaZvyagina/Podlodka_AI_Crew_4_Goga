+package v3rpc
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestAuditOperationDetails(t *testing.T) {
+	tests := []struct {
+		name          string
+		fullMethod    string
+		req           any
+		wantOperation string
+		wantKey       string
+		wantRangeEnd  string
+	}{
+		{
+			name:          "range is a read",
+			fullMethod:    "/etcdserverpb.KV/Range",
+			req:           &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")},
+			wantOperation: "read",
+			wantKey:       "a",
+			wantRangeEnd:  "z",
+		},
+		{
+			name:          "put is a write",
+			fullMethod:    "/etcdserverpb.KV/Put",
+			req:           &pb.PutRequest{Key: []byte("foo"), Value: []byte("bar")},
+			wantOperation: "write",
+			wantKey:       "foo",
+		},
+		{
+			name:          "delete range is a delete",
+			fullMethod:    "/etcdserverpb.KV/DeleteRange",
+			req:           &pb.DeleteRangeRequest{Key: []byte("foo"), RangeEnd: []byte("fop")},
+			wantOperation: "delete",
+			wantKey:       "foo",
+			wantRangeEnd:  "fop",
+		},
+		{
+			name:          "compact has no key",
+			fullMethod:    "/etcdserverpb.KV/Compact",
+			req:           &pb.CompactionRequest{Revision: 5},
+			wantOperation: "compact",
+		},
+		{
+			name:       "unmapped future method is still audited",
+			fullMethod: "/etcdserverpb.KV/SomeNewMethod",
+			req:        &pb.PutRequest{Key: []byte("foo")},
+			// falls back to the lowercased method name rather than being dropped
+			wantOperation: "somenewmethod",
+			wantKey:       "foo",
+		},
+		{
+			name:       "txn summarizes keys across success and failure branches",
+			fullMethod: "/etcdserverpb.KV/Txn",
+			req: &pb.TxnRequest{
+				Compare: []*pb.Compare{{Key: []byte("c1")}},
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("s1")}}},
+				},
+				Failure: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("f1"), RangeEnd: []byte("f2")}}},
+				},
+			},
+			wantOperation: "transaction",
+			wantKey:       "c1,s1,f1-f2",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			operation, key, rangeEnd := auditOperationDetails(tt.fullMethod, tt.req)
+			assert.Equal(t, tt.wantOperation, operation)
+			assert.Equal(t, tt.wantKey, string(key))
+			assert.Equal(t, tt.wantRangeEnd, string(rangeEnd))
+		})
+	}
+}
+
+func TestAuditTxnKeySummaryNested(t *testing.T) {
+	nested := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("inner")}}},
+		},
+	}
+	outer := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestTxn{RequestTxn: nested}},
+		},
+	}
+
+	assert.Equal(t, "inner", string(auditTxnKeySummary(outer)))
+}
+
+func TestAuditTxnKeySummaryTruncatesLargeTxns(t *testing.T) {
+	txn := &pb.TxnRequest{}
+	for i := 0; i < maxAuditKeysLogged+10; i++ {
+		txn.Success = append(txn.Success, &pb.RequestOp{
+			Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("k")}},
+		})
+	}
+
+	summary := string(auditTxnKeySummary(txn))
+	assert.Contains(t, summary, "...(truncated)")
+}
+
+func TestNonKVMethodsAreNotAudited(t *testing.T) {
+	operation, key, rangeEnd := auditOperationDetails("/etcdserverpb.Lease/LeaseGrant", &pb.LeaseGrantRequest{})
+	// auditOperationDetails itself has no service-prefix guard (that lives in
+	// the interceptor), but it should still degrade gracefully for methods
+	// with no key-shaped fields instead of panicking.
+	assert.Equal(t, "leasegrant", operation)
+	assert.Empty(t, key)
+	assert.Empty(t, rangeEnd)
+}
