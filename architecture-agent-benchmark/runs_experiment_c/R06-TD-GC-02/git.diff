+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package etcdserver
+
+import (
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/storage/backend"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+// cacheInvalidatingKV wraps a WatchableKV so that every committed write
+// synchronously invalidates any read-cache entries it may affect. Put,
+// DeleteRange and Txn all make their changes through a TxnWrite obtained
+// from Write, so intercepting Write here covers every write path,
+// including lease revocation and internal apply-time deletes. Invalidation
+// happens inside TxnWrite.End(), i.e. before the applying raft entry can be
+// marked applied, so no subsequent read - linearizable or serializable -
+// can observe a cache entry made stale by this write.
+type cacheInvalidatingKV struct {
+	mvcc.WatchableKV
+	cache *rangeCache
+}
+
+func newCacheInvalidatingKV(kv mvcc.WatchableKV, cache *rangeCache) mvcc.WatchableKV {
+	return &cacheInvalidatingKV{WatchableKV: kv, cache: cache}
+}
+
+func (c *cacheInvalidatingKV) Write(trace *traceutil.Trace) mvcc.TxnWrite {
+	return &cacheInvalidatingTxnWrite{TxnWrite: c.WatchableKV.Write(trace), cache: c.cache}
+}
+
+// Restore replaces the entire keyspace (e.g. installing a raft snapshot),
+// so every cached entry must be dropped rather than selectively invalidated.
+func (c *cacheInvalidatingKV) Restore(b backend.Backend) error {
+	err := c.WatchableKV.Restore(b)
+	c.cache.purge()
+	return err
+}
+
+type cacheInvalidatingTxnWrite struct {
+	mvcc.TxnWrite
+	cache *rangeCache
+}
+
+func (t *cacheInvalidatingTxnWrite) End() {
+	changes := t.TxnWrite.Changes()
+	t.TxnWrite.End()
+	if len(changes) == 0 {
+		return
+	}
+	keys := make([][]byte, len(changes))
+	for i, kv := range changes {
+		keys[i] = kv.Key
+	}
+	t.cache.invalidate(keys)
+}
diff --git a/server/etcdserver/read_cache_test.go b/server/etcdserver/read_cache_test.go
