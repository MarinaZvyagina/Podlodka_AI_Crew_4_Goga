+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package etcdserver
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+func newTestEtcdServerForRangeCache(t *testing.T) *EtcdServer {
+	t.Helper()
+	be, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { betesting.Close(t, be) })
+
+	s := &EtcdServer{lgMu: new(sync.RWMutex), lg: zap.NewNop()}
+	s.readCache = newRangeCache()
+	s.kv = newCacheInvalidatingKV(mvcc.New(zap.NewNop(), be, &lease.FakeLessor{}, mvcc.StoreConfig{}), s.readCache)
+	t.Cleanup(func() { require.NoError(t, s.kv.Close()) })
+	return s
+}
+
+func putKV(s *EtcdServer, key, val string) {
+	tw := s.kv.Write(traceutil.TODO())
+	tw.Put([]byte(key), []byte(val), lease.NoLease)
+	tw.End()
+}
+
+func deleteKV(s *EtcdServer, key string) {
+	tw := s.kv.Write(traceutil.TODO())
+	tw.DeleteRange([]byte(key), nil)
+	tw.End()
+}
+
+func TestRangeWithCacheServesRepeatedReadFromCache(t *testing.T) {
+	s := newTestEtcdServerForRangeCache(t)
+	ctx := context.Background()
+	putKV(s, "foo", "bar")
+
+	r := &pb.RangeRequest{Key: []byte("foo")}
+	resp1, err := s.rangeWithCache(ctx, r)
+	require.NoError(t, err)
+	require.Len(t, resp1.Kvs, 1)
+	assert.Equal(t, []byte("bar"), resp1.Kvs[0].Value)
+
+	key, ok := newRangeCacheKey(r)
+	require.True(t, ok)
+	_, hit := s.readCache.get(key)
+	require.True(t, hit, "first Range call must populate the cache")
+
+	resp2, err := s.rangeWithCache(ctx, r)
+	require.NoError(t, err)
+	assert.Equal(t, resp1.Kvs, resp2.Kvs)
+	assert.Equal(t, resp1.Count, resp2.Count)
+}
+
+func TestRangeWithCacheInvalidatesOnOverlappingPut(t *testing.T) {
+	s := newTestEtcdServerForRangeCache(t)
+	ctx := context.Background()
+	putKV(s, "foo", "bar")
+
+	r := &pb.RangeRequest{Key: []byte("foo")}
+	_, err := s.rangeWithCache(ctx, r)
+	require.NoError(t, err)
+
+	putKV(s, "foo", "baz")
+
+	key, _ := newRangeCacheKey(r)
+	_, hit := s.readCache.get(key)
+	assert.False(t, hit, "a write to the cached key must invalidate the entry")
+
+	resp, err := s.rangeWithCache(ctx, r)
+	require.NoError(t, err)
+	require.Len(t, resp.Kvs, 1)
+	assert.Equal(t, []byte("baz"), resp.Kvs[0].Value, "must observe the new value, never the stale cached one")
+}
+
+func TestRangeWithCacheInvalidatesOnOverlappingDelete(t *testing.T) {
+	s := newTestEtcdServerForRangeCache(t)
+	ctx := context.Background()
+	putKV(s, "foo", "bar")
+
+	r := &pb.RangeRequest{Key: []byte("foo")}
+	_, err := s.rangeWithCache(ctx, r)
+	require.NoError(t, err)
+
+	deleteKV(s, "foo")
+
+	resp, err := s.rangeWithCache(ctx, r)
+	require.NoError(t, err)
+	assert.Empty(t, resp.Kvs, "delete of the cached key must be observed, not masked by the cache")
+}
+
+func TestRangeWithCacheKeepsUnrelatedEntry(t *testing.T) {
+	s := newTestEtcdServerForRangeCache(t)
+	ctx := context.Background()
+	putKV(s, "foo", "1")
+	putKV(s, "bar", "1")
+
+	rFoo := &pb.RangeRequest{Key: []byte("foo")}
+	_, err := s.rangeWithCache(ctx, rFoo)
+	require.NoError(t, err)
+
+	putKV(s, "bar", "2") // unrelated key must not disturb foo's cache entry
+
+	key, _ := newRangeCacheKey(rFoo)
+	_, hit := s.readCache.get(key)
+	assert.True(t, hit, "a write to an unrelated key must not invalidate the cache entry")
+}
+
+func TestRangeWithCacheRefreshesHeaderRevisionOnHit(t *testing.T) {
+	s := newTestEtcdServerForRangeCache(t)
+	ctx := context.Background()
+	putKV(s, "foo", "1")
+
+	r := &pb.RangeRequest{Key: []byte("foo")}
+	resp1, err := s.rangeWithCache(ctx, r)
+	require.NoError(t, err)
+
+	putKV(s, "bar", "1") // unrelated write advances the store's overall revision
+
+	resp2, err := s.rangeWithCache(ctx, r)
+	require.NoError(t, err)
+	assert.Equal(t, resp1.Kvs, resp2.Kvs)
+	assert.Greater(t, resp2.Header.Revision, resp1.Header.Revision,
+		"a cache hit must report the live store revision, exactly as an uncached read would")
+}
+
+func TestRangeWithCacheDoesNotCachePinnedRevisionReads(t *testing.T) {
+	s := newTestEtcdServerForRangeCache(t)
+	ctx := context.Background()
+	putKV(s, "foo", "1")
+
+	r := &pb.RangeRequest{Key: []byte("foo"), Revision: 1}
+	_, err := s.rangeWithCache(ctx, r)
+	require.NoError(t, err)
+
+	_, cacheable := newRangeCacheKey(r)
+	assert.False(t, cacheable)
+	assert.Empty(t, s.readCache.entries)
+}
+
+func TestRangeCacheEntryOverlaps(t *testing.T) {
+	singleKey := &rangeCacheEntry{rangeKey: []byte("b")}
+	assert.True(t, singleKey.overlaps([]byte("b")))
+	assert.False(t, singleKey.overlaps([]byte("a")))
+	assert.False(t, singleKey.overlaps([]byte("c")))
+
+	unbounded := &rangeCacheEntry{rangeKey: []byte("b"), rangeEnd: []byte{}}
+	assert.False(t, unbounded.overlaps([]byte("a")))
+	assert.True(t, unbounded.overlaps([]byte("b")))
+	assert.True(t, unbounded.overlaps([]byte("z")))
+
+	bounded := &rangeCacheEntry{rangeKey: []byte("b"), rangeEnd: []byte("d")}
+	assert.False(t, bounded.overlaps([]byte("a")))
+	assert.True(t, bounded.overlaps([]byte("b")))
+	assert.True(t, bounded.overlaps([]byte("c")))
+	assert.False(t, bounded.overlaps([]byte("d")))
+}
+
+func TestRangeCacheEvictsLeastRecentlyUsed(t *testing.T) {
+	c := newRangeCache()
+	for i := 0; i < maxRangeCacheEntries; i++ {
+		k := rangeCacheKey{key: fmt.Sprintf("k%d", i)}
+		c.put(k, &rangeCacheEntry{rangeKey: []byte(k.key)})
+	}
+	require.Len(t, c.entries, maxRangeCacheEntries)
+
+	first := rangeCacheKey{key: "k0"}
+	_, ok := c.get(first) // touch it so it's most-recently-used
+	require.True(t, ok)
+
+	c.put(rangeCacheKey{key: "new"}, &rangeCacheEntry{rangeKey: []byte("new")})
+
+	require.LessOrEqual(t, len(c.entries), maxRangeCacheEntries)
+	_, stillThere := c.get(first)
+	assert.True(t, stillThere, "a recently touched entry must survive eviction")
+}
+
+func TestRangeCachePurge(t *testing.T) {
+	c := newRangeCache()
+	k := rangeCacheKey{key: "foo"}
+	c.put(k, &rangeCacheEntry{rangeKey: []byte("foo")})
+	_, ok := c.get(k)
+	require.True(t, ok)
+
+	c.purge()
+	_, ok = c.get(k)
+	assert.False(t, ok)
+}
