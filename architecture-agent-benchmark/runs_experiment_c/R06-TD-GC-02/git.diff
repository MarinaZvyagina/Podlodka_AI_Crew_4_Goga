+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package etcdserver
+
+import (
+	"bytes"
+	"container/list"
+	"context"
+	"sync"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+	"go.etcd.io/etcd/server/v3/etcdserver/txn"
+)
+
+// maxRangeCacheEntries bounds the memory the read cache can use. Once the
+// limit is reached, the least recently used entry is evicted to make room.
+const maxRangeCacheEntries = 10000
+
+// rangeCacheKey identifies a Range request by every field that affects the
+// data it returns. Serializable is intentionally excluded: it only changes
+// how the answer is obtained (whether a ReadIndex round-trip is required
+// first), never what the answer is, so linearizable and serializable
+// requests for the same range share cache entries.
+type rangeCacheKey struct {
+	key               string
+	rangeEnd          string
+	limit             int64
+	sortOrder         int32
+	sortTarget        int32
+	keysOnly          bool
+	countOnly         bool
+	minModRevision    int64
+	maxModRevision    int64
+	minCreateRevision int64
+	maxCreateRevision int64
+}
+
+// newRangeCacheKey returns the cache key for r and whether r is eligible for
+// caching at all. Requests pinned to a specific historical revision are not
+// cached: they are rare in practice, and correctly aging them out only when
+// a compaction could observe them adds bookkeeping this cache doesn't need.
+func newRangeCacheKey(r *pb.RangeRequest) (rangeCacheKey, bool) {
+	if r.Revision != 0 {
+		return rangeCacheKey{}, false
+	}
+	return rangeCacheKey{
+		key:               string(r.Key),
+		rangeEnd:          string(r.RangeEnd),
+		limit:             r.Limit,
+		sortOrder:         int32(r.SortOrder),
+		sortTarget:        int32(r.SortTarget),
+		keysOnly:          r.KeysOnly,
+		countOnly:         r.CountOnly,
+		minModRevision:    r.MinModRevision,
+		maxModRevision:    r.MaxModRevision,
+		minCreateRevision: r.MinCreateRevision,
+		maxCreateRevision: r.MaxCreateRevision,
+	}, true
+}
+
+// effectiveRangeEnd mirrors the '\0' sentinel handling that the normal read
+// path (txn.Range) applies to RangeEnd, so overlap checks agree with it on
+// what "open-ended range" and "single key" mean.
+func effectiveRangeEnd(rangeEnd []byte) []byte {
+	if len(rangeEnd) == 1 && rangeEnd[0] == 0 {
+		return []byte{}
+	}
+	return rangeEnd
+}
+
+// rangeCacheEntry holds the parts of a RangeResponse that never change once
+// computed, together with the byte range the request covered, so a write
+// can invalidate it by a simple key/range overlap check.
+type rangeCacheEntry struct {
+	rangeKey []byte
+	rangeEnd []byte // nil: single key; empty non-nil: unbounded; else: exclusive end
+	kvs      []*mvccpb.KeyValue
+	count    int64
+	more     bool
+
+	elem *list.Element // this entry's node in rangeCache.lru
+}
+
+func newRangeCacheEntry(r *pb.RangeRequest, resp *pb.RangeResponse) *rangeCacheEntry {
+	return &rangeCacheEntry{
+		rangeKey: r.Key,
+		rangeEnd: effectiveRangeEnd(r.RangeEnd),
+		kvs:      resp.Kvs,
+		count:    resp.Count,
+		more:     resp.More,
+	}
+}
+
+// overlaps reports whether the changed key k falls inside the range this
+// entry was computed over.
+func (e *rangeCacheEntry) overlaps(k []byte) bool {
+	if bytes.Compare(k, e.rangeKey) < 0 {
+		return false
+	}
+	if e.rangeEnd == nil {
+		return bytes.Equal(k, e.rangeKey)
+	}
+	if len(e.rangeEnd) == 0 {
+		return true
+	}
+	return bytes.Compare(k, e.rangeEnd) < 0
+}
+
+// toResponse builds a fresh RangeResponse from the cached data. rev is the
+// current store revision, fetched anew on every call: the KVs in range are
+// guaranteed current (any overlapping write invalidates the entry before it
+// can be observed), but unrelated writes elsewhere keep advancing the
+// store's overall revision, and a client is entitled to see that in the
+// response header exactly as an uncached read would show it. A fresh
+// *pb.RangeResponse/*pb.ResponseHeader pair is allocated on every call so
+// concurrent callers sharing a cache hit never mutate each other's header.
+func (e *rangeCacheEntry) toResponse(rev int64) *pb.RangeResponse {
+	return &pb.RangeResponse{
+		Header: &pb.ResponseHeader{Revision: rev},
+		Kvs:    e.kvs,
+		More:   e.more,
+		Count:  e.count,
+	}
+}
+
+// rangeCache caches Range responses so repeated, identical read requests
+// skip the mvcc read path entirely. Entries are invalidated synchronously
+// by cacheInvalidatingKV as part of the write path itself, before the
+// writing raft entry is marked applied, so a cache hit is always at least
+// as fresh as an uncached read arriving at the same point in the apply
+// order would be. A fixed expiration timer is neither used nor needed.
+type rangeCache struct {
+	mu      sync.Mutex
+	entries map[rangeCacheKey]*rangeCacheEntry
+	lru     *list.List // front = most recently used; elements are rangeCacheKey
+}
+
+func newRangeCache() *rangeCache {
+	return &rangeCache{
+		entries: make(map[rangeCacheKey]*rangeCacheEntry),
+		lru:     list.New(),
+	}
+}
+
+func (c *rangeCache) get(k rangeCacheKey) (*rangeCacheEntry, bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	e, ok := c.entries[k]
+	if !ok {
+		return nil, false
+	}
+	c.lru.MoveToFront(e.elem)
+	return e, true
+}
+
+func (c *rangeCache) put(k rangeCacheKey, e *rangeCacheEntry) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if _, ok := c.entries[k]; ok {
+		// Lost the race with a concurrent populate for the same key;
+		// keep whichever entry is already there.
+		return
+	}
+	e.elem = c.lru.PushFront(k)
+	c.entries[k] = e
+	for len(c.entries) > maxRangeCacheEntries {
+		back := c.lru.Back()
+		if back == nil {
+			break
+		}
+		c.lru.Remove(back)
+		delete(c.entries, back.Value.(rangeCacheKey))
+	}
+}
+
+// invalidate drops every cached entry whose requested range overlaps any of
+// the given keys.
+func (c *rangeCache) invalidate(changedKeys [][]byte) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if len(c.entries) == 0 {
+		return
+	}
+	for k, e := range c.entries {
+		for _, ck := range changedKeys {
+			if e.overlaps(ck) {
+				c.lru.Remove(e.elem)
+				delete(c.entries, k)
+				break
+			}
+		}
+	}
+}
+
+// purge drops every cached entry. Used when the underlying data set is
+// replaced wholesale, e.g. when a snapshot is installed.
+func (c *rangeCache) purge() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.entries = make(map[rangeCacheKey]*rangeCacheEntry)
+	c.lru = list.New()
+}
+
+// rangeWithCache serves r from the read cache when possible, falling back
+// to the normal read path (txn.Range) on a miss and populating the cache
+// with the result. Requests that cannot be cached, or that miss, behave
+// exactly as an uncached Range call always has.
+func (s *EtcdServer) rangeWithCache(ctx context.Context, r *pb.RangeRequest) (*pb.RangeResponse, error) {
+	key, cacheable := newRangeCacheKey(r)
+	if cacheable {
+		if e, ok := s.readCache.get(key); ok {
+			return e.toResponse(s.KV().Rev()), nil
+		}
+	}
+
+	resp, _, err := txn.Range(ctx, s.Logger(), s.KV(), r, true)
+	if err == nil && cacheable {
+		s.readCache.put(key, newRangeCacheEntry(r, resp))
+	}
+	return resp, err
+}
diff --git a/server/etcdserver/read_cache_kv.go b/server/etcdserver/read_cache_kv.go
