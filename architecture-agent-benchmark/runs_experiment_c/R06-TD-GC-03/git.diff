index 000000000..26690e014
--- /dev/null
+++ b/server/etcdserver/v3_server_range_cache_test.go
@@ -0,0 +1,228 @@
+// Copyright 2026 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package etcdserver
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/auth"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+	"go.etcd.io/etcd/server/v3/storage/schema"
+)
+
+// countingKV wraps a real mvcc.WatchableKV and separately counts calls to
+// Rev() (the cheap check cachedRange uses to test cache validity) and
+// Read() (the full read transaction txn.Range opens to actually do the
+// work), so tests can distinguish a cache hit - Rev() only - from a miss -
+// Rev() plus a full Read().
+//
+// Both methods are overridden explicitly (rather than relying on
+// countingKV.WatchableKV's promoted methods) because Go does not virtually
+// dispatch through embedding: the embedded store's own Rev() implementation
+// opens its read transaction against itself, not against this wrapper, so
+// only an explicit override observes that call.
+type countingKV struct {
+	mvcc.WatchableKV
+	reads     atomic.Int64
+	revChecks atomic.Int64
+}
+
+func (c *countingKV) Read(mode mvcc.ReadTxMode, trace *traceutil.Trace) mvcc.TxnRead {
+	c.reads.Add(1)
+	return c.WatchableKV.Read(mode, trace)
+}
+
+func (c *countingKV) Rev() int64 {
+	c.revChecks.Add(1)
+	return c.WatchableKV.Rev()
+}
+
+func newTestRangeServer(t *testing.T) (*EtcdServer, *countingKV) {
+	t.Helper()
+	lg := zaptest.NewLogger(t)
+	be, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { be.Close() })
+
+	kv := &countingKV{WatchableKV: mvcc.New(lg, be, &lease.FakeLessor{}, mvcc.StoreConfig{})}
+	s := &EtcdServer{
+		lgMu:      new(sync.RWMutex),
+		lg:        lg,
+		kv:        kv,
+		authStore: auth.NewAuthStore(lg, schema.NewAuthBackend(lg, be), nil, 0),
+	}
+	return s, kv
+}
+
+func rangeReq(key string) *pb.RangeRequest {
+	return &pb.RangeRequest{Key: []byte(key), Serializable: true}
+}
+
+func TestRangeServesRepeatedReadsFromCache(t *testing.T) {
+	s, kv := newTestRangeServer(t)
+	ctx := context.Background()
+
+	txn := s.KV().Write(traceutil.TODO())
+	txn.Put([]byte("foo"), []byte("bar1"), lease.NoLease)
+	txn.End()
+
+	resp1, err := s.Range(ctx, rangeReq("foo"))
+	if err != nil {
+		t.Fatalf("first Range: %v", err)
+	}
+	if len(resp1.Kvs) != 1 || string(resp1.Kvs[0].Value) != "bar1" {
+		t.Fatalf("first Range = %+v, want value bar1", resp1)
+	}
+	readsAfterFirst := kv.reads.Load()
+	revChecksAfterFirst := kv.revChecks.Load()
+
+	resp2, err := s.Range(ctx, rangeReq("foo"))
+	if err != nil {
+		t.Fatalf("second Range: %v", err)
+	}
+	if string(resp2.Kvs[0].Value) != "bar1" {
+		t.Fatalf("second Range = %+v, want value bar1", resp2)
+	}
+	if resp2.Header.Revision != resp1.Header.Revision {
+		t.Errorf("second Range revision = %d, want %d (unchanged store)", resp2.Header.Revision, resp1.Header.Revision)
+	}
+
+	// A cache hit must still pay for the cheap Rev() check (so it can never
+	// serve a result superseded by a concurrent write), but must skip the
+	// expensive full read (txn.Range's own Read()) entirely.
+	if got := kv.reads.Load() - readsAfterFirst; got != 0 {
+		t.Errorf("cache hit opened %d full read txns, want 0 (expensive re-read was not skipped)", got)
+	}
+	if got := kv.revChecks.Load() - revChecksAfterFirst; got != 1 {
+		t.Errorf("cache hit performed %d Rev() checks, want exactly 1 (cache validity must still be checked)", got)
+	}
+}
+
+func TestRangeReflectsWritesImmediatelyNoStaleness(t *testing.T) {
+	s, _ := newTestRangeServer(t)
+	ctx := context.Background()
+
+	put := func(v string) {
+		txn := s.KV().Write(traceutil.TODO())
+		txn.Put([]byte("foo"), []byte(v), lease.NoLease)
+		txn.End()
+	}
+
+	put("v1")
+	resp1, err := s.Range(ctx, rangeReq("foo"))
+	if err != nil {
+		t.Fatalf("Range after v1: %v", err)
+	}
+	if string(resp1.Kvs[0].Value) != "v1" {
+		t.Fatalf("Range after v1 = %q, want v1", resp1.Kvs[0].Value)
+	}
+
+	// Warm the cache for this exact request shape.
+	if _, err := s.Range(ctx, rangeReq("foo")); err != nil {
+		t.Fatalf("warm Range: %v", err)
+	}
+
+	// A write immediately followed by a read for the same key, with no
+	// sleep/delay: the cache must never hand back the pre-write value.
+	put("v2")
+	resp2, err := s.Range(ctx, rangeReq("foo"))
+	if err != nil {
+		t.Fatalf("Range after v2: %v", err)
+	}
+	if string(resp2.Kvs[0].Value) != "v2" {
+		t.Fatalf("Range after v2 = %q, want v2 (stale cache hit)", resp2.Kvs[0].Value)
+	}
+	if resp2.Header.Revision <= resp1.Header.Revision {
+		t.Errorf("resp2 revision %d did not advance past resp1 revision %d", resp2.Header.Revision, resp1.Header.Revision)
+	}
+
+	// Deletion must be reflected just as promptly.
+	dtxn := s.KV().Write(traceutil.TODO())
+	dtxn.DeleteRange([]byte("foo"), nil)
+	dtxn.End()
+
+	resp3, err := s.Range(ctx, rangeReq("foo"))
+	if err != nil {
+		t.Fatalf("Range after delete: %v", err)
+	}
+	if len(resp3.Kvs) != 0 {
+		t.Errorf("Range after delete = %+v, want no Kvs", resp3.Kvs)
+	}
+}
+
+func TestRangeCacheDoesNotLeakHeaderAcrossCallers(t *testing.T) {
+	s, _ := newTestRangeServer(t)
+	ctx := context.Background()
+
+	txn := s.KV().Write(traceutil.TODO())
+	txn.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+	txn.End()
+
+	resp1, err := s.Range(ctx, rangeReq("foo"))
+	if err != nil {
+		t.Fatalf("first Range: %v", err)
+	}
+	resp2, err := s.Range(ctx, rangeReq("foo"))
+	if err != nil {
+		t.Fatalf("second Range: %v", err)
+	}
+	if resp1.Header == resp2.Header {
+		t.Fatalf("two Range calls returned the same *ResponseHeader instance; concurrent header-filling would race")
+	}
+
+	// Simulate what api/v3rpc's header.fill does after every call.
+	resp1.Header.ClusterId = 42
+	if resp2.Header.ClusterId == 42 {
+		t.Errorf("mutating resp1.Header leaked into resp2.Header")
+	}
+}
