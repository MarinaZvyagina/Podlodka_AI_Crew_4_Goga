+func TestRangeHistoricalRevisionBypassesCache(t *testing.T) {
+	s, kv := newTestRangeServer(t)
+	ctx := context.Background()
+
+	put := func(v string) int64 {
+		txn := s.KV().Write(traceutil.TODO())
+		defer txn.End()
+		return txn.Put([]byte("foo"), []byte(v), lease.NoLease)
+	}
+	rev1 := put("v1")
+	put("v2")
+
+	req := &pb.RangeRequest{Key: []byte("foo"), Serializable: true, Revision: rev1}
+	if _, err := s.Range(ctx, req); err != nil {
+		t.Fatalf("first historical Range: %v", err)
+	}
+	before := kv.reads.Load()
+	resp, err := s.Range(ctx, req)
+	if err != nil {
+		t.Fatalf("second historical Range: %v", err)
+	}
+	if string(resp.Kvs[0].Value) != "v1" {
+		t.Fatalf("historical Range = %q, want v1", resp.Kvs[0].Value)
+	}
+	after := kv.reads.Load()
+	if after == before {
+		t.Errorf("historical-revision Range appears to have been cached; it must always re-read")
+	}
+}
