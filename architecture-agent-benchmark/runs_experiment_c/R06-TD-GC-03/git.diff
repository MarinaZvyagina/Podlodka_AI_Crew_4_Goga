+// limitations under the License.
+
+package etcdserver
+
+import (
+	"sync"
+	"testing"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestRangeCacheZeroValueIsUsable(t *testing.T) {
+	var c rangeCache
+	key := newRangeCacheKey(&pb.RangeRequest{Key: []byte("a")})
+
+	if got := c.get(key, 1); got != nil {
+		t.Fatalf("get on empty cache = %v, want nil", got)
+	}
+
+	c.purge() // must not panic on a never-initialized cache
+
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}
+	c.put(key, 1, resp)
+	if got := c.get(key, 1); got != resp {
+		t.Fatalf("get after put = %v, want %v", got, resp)
+	}
+}
+
+func TestRangeCacheHitRequiresMatchingRevision(t *testing.T) {
+	var c rangeCache
+	key := newRangeCacheKey(&pb.RangeRequest{Key: []byte("a")})
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}}
+	c.put(key, 5, resp)
+
+	if got := c.get(key, 5); got != resp {
+		t.Fatalf("get at matching revision = %v, want %v", got, resp)
+	}
+	if got := c.get(key, 6); got != nil {
+		t.Fatalf("get at newer revision = %v, want nil (miss)", got)
+	}
+	if got := c.get(key, 4); got != nil {
+		t.Fatalf("get at older revision = %v, want nil (miss)", got)
+	}
+}
+
+func TestRangeCacheDistinctKeysDoNotCollide(t *testing.T) {
+	var c rangeCache
+	keyA := newRangeCacheKey(&pb.RangeRequest{Key: []byte("a")})
+	keyB := newRangeCacheKey(&pb.RangeRequest{Key: []byte("b")})
+	keyACountOnly := newRangeCacheKey(&pb.RangeRequest{Key: []byte("a"), CountOnly: true})
+
+	respA := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}, Count: 1}
+	respB := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}, Count: 2}
+	respACountOnly := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}, Count: 3}
+
+	c.put(keyA, 1, respA)
+	c.put(keyB, 1, respB)
+	c.put(keyACountOnly, 1, respACountOnly)
+
+	if got := c.get(keyA, 1); got != respA {
+		t.Fatalf("get(keyA) = %v, want %v", got, respA)
+	}
+	if got := c.get(keyB, 1); got != respB {
+		t.Fatalf("get(keyB) = %v, want %v", got, respB)
+	}
+	if got := c.get(keyACountOnly, 1); got != respACountOnly {
+		t.Fatalf("get(keyACountOnly) = %v, want %v", got, respACountOnly)
+	}
+}
+
+func TestRangeCacheEvictsLeastRecentlyUsed(t *testing.T) {
+	var c rangeCache
+
+	fill := rangeCacheMaxEntries
+	for i := 0; i < fill; i++ {
+		key := newRangeCacheKey(&pb.RangeRequest{Key: []byte{byte(i % 256), byte(i / 256)}})
+		c.put(key, 1, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+	}
+
+	firstKey := newRangeCacheKey(&pb.RangeRequest{Key: []byte{0, 0}})
+	// Touch the first entry so it is no longer the least-recently-used one.
+	if c.get(firstKey, 1) == nil {
+		t.Fatalf("expected entry 0 to still be cached before eviction")
+	}
+
+	overflowKey := newRangeCacheKey(&pb.RangeRequest{Key: []byte("overflow")})
+	c.put(overflowKey, 1, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	if c.get(firstKey, 1) == nil {
+		t.Errorf("recently-touched entry was evicted, want it retained")
+	}
+	if c.get(overflowKey, 1) == nil {
+		t.Errorf("newly inserted entry missing, want it retained")
+	}
+
+	secondKey := newRangeCacheKey(&pb.RangeRequest{Key: []byte{1, 0}})
+	if got := c.get(secondKey, 1); got != nil {
+		t.Errorf("least-recently-used entry was not evicted")
+	}
+}
+
+func TestRangeCachePurgeDropsEverything(t *testing.T) {
+	var c rangeCache
+	key := newRangeCacheKey(&pb.RangeRequest{Key: []byte("a")})
+	c.put(key, 1, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	c.purge()
+
+	if got := c.get(key, 1); got != nil {
+		t.Fatalf("get after purge = %v, want nil", got)
+	}
+}
+
+func TestRangeCacheConcurrentAccess(t *testing.T) {
+	var c rangeCache
+	var wg sync.WaitGroup
+	for i := 0; i < 50; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			key := newRangeCacheKey(&pb.RangeRequest{Key: []byte{byte(i)}})
+			for j := 0; j < 20; j++ {
+				c.put(key, int64(j), &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: int64(j)}})
+				c.get(key, int64(j))
+			}
+		}(i)
+	}
+	wg.Wait()
+}
+
+func TestCloneRangeResponseHasIndependentHeader(t *testing.T) {
+	orig := &pb.RangeResponse{
+		Header: &pb.ResponseHeader{Revision: 7, ClusterId: 1},
+		Kvs:    nil,
+		Count:  3,
+		More:   true,
+	}
+	clone := cloneRangeResponse(orig)
+
+	if clone.Header == orig.Header {
+		t.Fatalf("clone shares the same Header pointer as the original")
+	}
+	if clone.Header.Revision != 7 {
+		t.Errorf("clone.Header.Revision = %d, want 7", clone.Header.Revision)
+	}
+	if clone.Count != 3 || clone.More != true {
+		t.Errorf("clone = %+v, want Count=3 More=true", clone)
+	}
+
+	// Mutating the clone's header (as api/v3rpc's header.fill does) must not
+	// affect the cached original.
+	clone.Header.ClusterId = 99
+	if orig.Header.ClusterId != 1 {
+		t.Errorf("mutating clone.Header leaked into orig.Header: %d", orig.Header.ClusterId)
+	}
+}
