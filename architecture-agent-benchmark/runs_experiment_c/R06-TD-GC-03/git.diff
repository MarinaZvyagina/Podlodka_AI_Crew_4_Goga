+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package etcdserver
+
+import (
+	"container/list"
+	"sync"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+// rangeCacheMaxEntries bounds the memory the read cache can use. It only
+// affects how many distinct (range, options) shapes stay memoized; it is not
+// a correctness knob. Entries beyond this count are evicted least-recently
+// -used first.
+const rangeCacheMaxEntries = 10000
+
+// rangeCacheKey identifies a cacheable Range request: every field of
+// RangeRequest that can change the resulting RangeResponse for a fixed
+// revision. Revision itself is deliberately excluded - it is not part of the
+// key, see rangeCache's doc comment - and Serializable is excluded because it
+// only selects how the revision to read at is established, not what the
+// result looks like once that revision is known.
+type rangeCacheKey struct {
+	key               string
+	rangeEnd          string
+	limit             int64
+	sortOrder         pb.RangeRequest_SortOrder
+	sortTarget        pb.RangeRequest_SortTarget
+	keysOnly          bool
+	countOnly         bool
+	minModRevision    int64
+	maxModRevision    int64
+	minCreateRevision int64
+	maxCreateRevision int64
+}
+
+func newRangeCacheKey(r *pb.RangeRequest) rangeCacheKey {
+	return rangeCacheKey{
+		key:               string(r.Key),
+		rangeEnd:          string(r.RangeEnd),
+		limit:             r.Limit,
+		sortOrder:         r.SortOrder,
+		sortTarget:        r.SortTarget,
+		keysOnly:          r.KeysOnly,
+		countOnly:         r.CountOnly,
+		minModRevision:    r.MinModRevision,
+		maxModRevision:    r.MaxModRevision,
+		minCreateRevision: r.MinCreateRevision,
+		maxCreateRevision: r.MaxCreateRevision,
+	}
+}
+
+type rangeCacheEntry struct {
+	key      rangeCacheKey
+	revision int64
+	resp     *pb.RangeResponse
+}
+
+// rangeCache memoizes Range responses computed at the store's current
+// revision (requests pinned to an explicit historical revision are never
+// entered here, see EtcdServer.cachedRange).
+//
+// Correctness relies on one fact about mvcc.KV: its current revision is
+// bumped exactly once, synchronously, as part of committing any write or
+// delete that changes data (server/storage/mvcc kvstore_txn.go,
+// storeTxnWrite.End), and every read - cached or not - resolves "current
+// revision" by reading that same counter. So a lookup keyed on (request
+// shape, revision-at-lookup-time) can never return a result that is older
+// than what a fresh read would see at that same instant: either the entry's
+// revision still matches the live counter, in which case the cached
+// RangeResult is byte-for-byte what recomputing it would produce (Range is a
+// pure function of (key range, options, revision) for a revision that has
+// not been compacted), or the counter has moved on - because a write
+// committed - and the lookup misses, falling through to a fresh read. There
+// is no time-based expiry standing in for this check, so a concurrent write
+// can never race a cache hit into returning stale data.
+// rangeCache is embedded by value in EtcdServer (not constructed explicitly)
+// so that the zero value - as produced by test code that builds an
+// EtcdServer{} literal directly instead of going through NewServer - is
+// already safe to use: every method below tolerates a nil entries/order pair
+// and lazily initializes them on first use.
+type rangeCache struct {
+	mu      sync.Mutex
+	entries map[rangeCacheKey]*list.Element // -> *rangeCacheEntry
+	order   *list.List                      // most-recently-used at the front
+}
+
+// get returns the cached response for key if one exists and was computed at
+// currentRev, promoting it to most-recently-used. It returns nil on a miss,
+// including a stale hit (an entry computed at an earlier revision).
+func (c *rangeCache) get(key rangeCacheKey, currentRev int64) *pb.RangeResponse {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	el, ok := c.entries[key]
+	if !ok {
+		return nil
+	}
+	entry := el.Value.(*rangeCacheEntry)
+	if entry.revision != currentRev {
+		return nil
+	}
+	c.order.MoveToFront(el)
+	return entry.resp
+}
+
+// put stores resp, computed at revision, under key, evicting the
+// least-recently-used entry if the cache is at capacity. resp must not be
+// mutated by the caller afterwards.
+func (c *rangeCache) put(key rangeCacheKey, revision int64, resp *pb.RangeResponse) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if c.entries == nil {
+		c.entries = make(map[rangeCacheKey]*list.Element)
+		c.order = list.New()
+	}
+
+	if el, ok := c.entries[key]; ok {
+		entry := el.Value.(*rangeCacheEntry)
+		entry.revision = revision
+		entry.resp = resp
+		c.order.MoveToFront(el)
+		return
+	}
+
+	el := c.order.PushFront(&rangeCacheEntry{key: key, revision: revision, resp: resp})
+	c.entries[key] = el
+	if c.order.Len() > rangeCacheMaxEntries {
+		oldest := c.order.Back()
+		c.order.Remove(oldest)
+		delete(c.entries, oldest.Value.(*rangeCacheEntry).key)
+	}
+}
+
+// purge drops every cached entry. Used when the underlying mvcc store is
+// replaced wholesale (e.g. restored from a snapshot) so that a coincidental
+// revision-number collision with the discarded store can never be served.
+func (c *rangeCache) purge() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	c.entries = nil
+	c.order = nil
+}
+
+// cloneRangeResponse returns a shallow copy of resp with its own
+// ResponseHeader. Callers (server/etcdserver/api/v3rpc) fill ClusterId/
+// MemberId/RaftTerm into the header of whatever response they get back; a
+// cache hit must not hand out the same *pb.ResponseHeader to more than one
+// caller; concurrent callers would race writing those fields into it. Kvs is
+// shared as-is: it is never mutated after it is first assembled.
+func cloneRangeResponse(resp *pb.RangeResponse) *pb.RangeResponse {
+	return &pb.RangeResponse{
+		Header: &pb.ResponseHeader{Revision: resp.Header.Revision},
+		Kvs:    resp.Kvs,
+		More:   resp.More,
+		Count:  resp.Count,
+	}
+}
