diff --git a/server/etcdserver/v3_server.go b/server/etcdserver/v3_server.go
index a357705a0..e3494f7f8 100644
--- a/server/etcdserver/v3_server.go
+++ b/server/etcdserver/v3_server.go
@@ -146,7 +146,7 @@ func (s *EtcdServer) Range(ctx context.Context, r *pb.RangeRequest) (*pb.RangeRe
 		return s.authStore.IsRangePermitted(ai, r.Key, r.RangeEnd)
 	}
 
-	get := func() { resp, _, err = txn.Range(ctx, s.Logger(), s.KV(), r, true) }
+	get := func() { resp, err = s.cachedRange(ctx, r) }
 	if serr := s.doSerialize(ctx, chk, get); serr != nil {
 		err = serr
 		return nil, err
@@ -154,6 +154,35 @@ func (s *EtcdServer) Range(ctx context.Context, r *pb.RangeRequest) (*pb.RangeRe
 	return resp, err
 }
 
+// cachedRange serves r out of s.rangeCache when possible, falling back to an
+// uncached txn.Range otherwise. Only requests reading at the current
+// revision (Revision <= 0) are cached: the caller has already resolved
+// linearizability (or opted out of it) by this point, so s.KV().Rev() here
+// is exactly the revision an uncached read would use.
+func (s *EtcdServer) cachedRange(ctx context.Context, r *pb.RangeRequest) (*pb.RangeResponse, error) {
+	if r.Revision > 0 {
+		resp, _, err := txn.Range(ctx, s.Logger(), s.KV(), r, true)
+		return resp, err
+	}
+
+	key := newRangeCacheKey(r)
+	if cached := s.rangeCache.get(key, s.KV().Rev()); cached != nil {
+		return cloneRangeResponse(cached), nil
+	}
+
+	resp, _, err := txn.Range(ctx, s.Logger(), s.KV(), r, true)
+	if err != nil {
+		return nil, err
+	}
+	s.rangeCache.put(key, resp.Header.Revision, &pb.RangeResponse{
+		Header: &pb.ResponseHeader{Revision: resp.Header.Revision},
+		Kvs:    resp.Kvs,
+		More:   resp.More,
+		Count:  resp.Count,
+	})
+	return resp, nil
+}
+
 func (s *EtcdServer) RangeStream(r *pb.RangeRequest, rs pb.KV_RangeStreamServer) error {
