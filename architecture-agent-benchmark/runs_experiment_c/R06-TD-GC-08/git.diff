+package mvcc
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+
+	"go.etcd.io/etcd/api/v3/mvccpb"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+)
+
+func rr(kvs ...*mvccpb.KeyValue) *RangeResult {
+	return &RangeResult{KVs: kvs, Rev: 5, Count: len(kvs)}
+}
+
+func TestRangeCacheGetPutRoundTrip(t *testing.T) {
+	c := newRangeCache()
+	ro := RangeOptions{}
+	want := rr(&mvccpb.KeyValue{Key: []byte("foo"), Value: []byte("bar")})
+
+	_, ok := c.get([]byte("foo"), nil, ro)
+	require.False(t, ok, "expected miss before any put")
+
+	c.put([]byte("foo"), nil, ro, want)
+	got, ok := c.get([]byte("foo"), nil, ro)
+	require.True(t, ok, "expected hit after put")
+	assert.Equal(t, want.Rev, got.Rev)
+	require.Len(t, got.KVs, 1)
+	assert.Equal(t, "bar", string(got.KVs[0].Value))
+}
+
+// TestRangeCacheHitsAreIsolated ensures neither storing nor serving a
+// result shares memory with the caller: the in-process callers that mutate
+// a *RangeResult (e.g. executeRange's KeysOnly stripping and prune/sort
+// in-place edits) must never corrupt the cached copy or a different
+// caller's copy of the same cached entry.
+func TestRangeCacheHitsAreIsolated(t *testing.T) {
+	c := newRangeCache()
+	ro := RangeOptions{}
+	original := rr(&mvccpb.KeyValue{Key: []byte("foo"), Value: []byte("bar")})
+
+	c.put([]byte("foo"), nil, ro, original)
+
+	// mutate the source RangeResult after handing it to put(): the cache
+	// must have taken its own copy.
+	original.KVs[0].Value = []byte("mutated-by-source")
+
+	got1, ok := c.get([]byte("foo"), nil, ro)
+	require.True(t, ok)
+	assert.Equal(t, "bar", string(got1.KVs[0].Value))
+
+	// simulate a caller mutating its own copy the way executeRange does for
+	// KeysOnly requests.
+	got1.KVs[0].Value = nil
+	got1.KVs = got1.KVs[:0]
+
+	got2, ok := c.get([]byte("foo"), nil, ro)
+	require.True(t, ok)
+	require.Len(t, got2.KVs, 1)
+	assert.Equal(t, "bar", string(got2.KVs[0].Value))
+}
+
+func TestRangeCacheKeyCovers(t *testing.T) {
+	tests := []struct {
+		name       string
+		key, end   []byte
+		changedKey []byte
+		want       bool
+	}{
+		{"single key exact match", []byte("foo"), nil, []byte("foo"), true},
+		{"single key no match", []byte("foo"), nil, []byte("foobar"), false},
+		{"bounded range inside", []byte("a"), []byte("c"), []byte("b"), true},
+		{"bounded range at start (inclusive)", []byte("a"), []byte("c"), []byte("a"), true},
+		{"bounded range at end (exclusive)", []byte("a"), []byte("c"), []byte("c"), false},
+		{"bounded range before start", []byte("a"), []byte("c"), []byte("0"), false},
+		{"unbounded range in range", []byte("m"), []byte{}, []byte("zzz"), true},
+		{"unbounded range before start", []byte("m"), []byte{}, []byte("a"), false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			k := newRangeCacheKey(tc.key, tc.end, RangeOptions{})
+			assert.Equal(t, tc.want, k.covers(tc.changedKey))
+		})
+	}
+}
+
+func TestRangeCacheInvalidateOnlyDropsOverlapping(t *testing.T) {
+	c := newRangeCache()
+	ro := RangeOptions{}
+	c.put([]byte("foo"), nil, ro, rr(&mvccpb.KeyValue{Key: []byte("foo"), Value: []byte("1")}))
+	c.put([]byte("a"), []byte("m"), ro, rr(&mvccpb.KeyValue{Key: []byte("bar"), Value: []byte("2")}))
+	c.put([]byte("other"), nil, ro, rr(&mvccpb.KeyValue{Key: []byte("other"), Value: []byte("3")}))
+
+	// a write to "bar" overlaps only the [a, m) range entry.
+	c.invalidate([]*mvccpb.KeyValue{{Key: []byte("bar")}})
+
+	_, ok := c.get([]byte("foo"), nil, ro)
+	assert.True(t, ok, "unrelated single-key entry should survive")
+	_, ok = c.get([]byte("other"), nil, ro)
+	assert.True(t, ok, "unrelated single-key entry should survive")
+	_, ok = c.get([]byte("a"), []byte("m"), ro)
+	assert.False(t, ok, "overlapping range entry must be invalidated")
+}
+
+func TestRangeCacheCapacityEvictsLeastRecentlyUsed(t *testing.T) {
+	old := rangeCacheCapacity
+	rangeCacheCapacity = 2
+	defer func() { rangeCacheCapacity = old }()
+
+	c := newRangeCache()
+	ro := RangeOptions{}
+	c.put([]byte("a"), nil, ro, rr(&mvccpb.KeyValue{Key: []byte("a")}))
+	c.put([]byte("b"), nil, ro, rr(&mvccpb.KeyValue{Key: []byte("b")}))
+
+	// touch "a" so "b" becomes the least recently used entry.
+	_, ok := c.get([]byte("a"), nil, ro)
+	require.True(t, ok)
+
+	c.put([]byte("c"), nil, ro, rr(&mvccpb.KeyValue{Key: []byte("c")}))
+
+	_, ok = c.get([]byte("a"), nil, ro)
+	assert.True(t, ok, "recently used entry should survive eviction")
+	_, ok = c.get([]byte("b"), nil, ro)
+	assert.False(t, ok, "least recently used entry should have been evicted")
+	_, ok = c.get([]byte("c"), nil, ro)
+	assert.True(t, ok, "newly inserted entry should be present")
+}
+
+func newTestWatchableStore(t *testing.T) (WatchableKV, backendCloser) {
+	t.Helper()
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	s := New(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{})
+	return s, backendCloser{s, b}
+}
+
+type backendCloser struct {
+	s KV
+	b interface{ Close() error }
+}
+
+func (c backendCloser) Close() {
+	c.s.Close()
+	c.b.Close()
+}
+
+// TestWatchableStoreReadCacheNoStaleDataAfterWrite is the core correctness
+// requirement: once a write affecting a cached range has committed, the
+// very next read must observe it -- a cache hit is never allowed to be
+// staler than an equivalent uncached read issued at the same time.
+func TestWatchableStoreReadCacheNoStaleDataAfterWrite(t *testing.T) {
+	s, closer := newTestWatchableStore(t)
+	defer closer.Close()
+
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	r1, err := s.Range(t.Context(), []byte("foo"), nil, RangeOptions{})
+	require.NoError(t, err)
+	require.Len(t, r1.KVs, 1)
+	assert.Equal(t, "bar", string(r1.KVs[0].Value))
+
+	// second identical read should hit the cache and still be correct.
+	r2, err := s.Range(t.Context(), []byte("foo"), nil, RangeOptions{})
+	require.NoError(t, err)
+	require.Len(t, r2.KVs, 1)
+	assert.Equal(t, "bar", string(r2.KVs[0].Value))
+
+	s.Put([]byte("foo"), []byte("baz"), lease.NoLease)
+
+	r3, err := s.Range(t.Context(), []byte("foo"), nil, RangeOptions{})
+	require.NoError(t, err)
+	require.Len(t, r3.KVs, 1)
+	assert.Equal(t, "baz", string(r3.KVs[0].Value), "must observe the write that just committed, not a stale cached value")
+}
+
+func TestWatchableStoreReadCacheDeleteInvalidates(t *testing.T) {
+	s, closer := newTestWatchableStore(t)
+	defer closer.Close()
+
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+	r, err := s.Range(t.Context(), []byte("foo"), nil, RangeOptions{})
+	require.NoError(t, err)
+	require.Len(t, r.KVs, 1)
+
+	s.DeleteRange([]byte("foo"), nil)
+
+	r, err = s.Range(t.Context(), []byte("foo"), nil, RangeOptions{})
+	require.NoError(t, err)
+	assert.Empty(t, r.KVs, "deleted key must not be served from a stale cache entry")
+}
+
+// TestWatchableStoreReadCacheUnrelatedWriteKeepsEntry checks invalidation
+// is precise (overlap-based), not "any write anywhere clears everything" --
+// otherwise the cache would provide no benefit on a cluster with any
+// unrelated write traffic, defeating its purpose.
+func TestWatchableStoreReadCacheUnrelatedWriteKeepsEntry(t *testing.T) {
+	s, closer := newTestWatchableStore(t)
+	defer closer.Close()
+
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+	_, err := s.Range(t.Context(), []byte("foo"), nil, RangeOptions{})
+	require.NoError(t, err)
+
+	ws := s.(*watchableStore)
+	_, cached := ws.readCache.get([]byte("foo"), nil, RangeOptions{})
+	require.True(t, cached, "read should have been cached")
+
+	s.Put([]byte("unrelated"), []byte("value"), lease.NoLease)
+
+	_, cached = ws.readCache.get([]byte("foo"), nil, RangeOptions{})
+	assert.True(t, cached, "write to an unrelated key must not invalidate this entry")
+}
+
+func TestWatchableStoreReadCacheHistoricalReadNotCached(t *testing.T) {
+	s, closer := newTestWatchableStore(t)
+	defer closer.Close()
+
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+	rev := s.Put([]byte("foo"), []byte("baz"), lease.NoLease)
+
+	_, err := s.Range(t.Context(), []byte("foo"), nil, RangeOptions{Rev: rev})
+	require.NoError(t, err)
+
+	ws := s.(*watchableStore)
+	ws.readCache.mu.Lock()
+	n := len(ws.readCache.entries)
+	ws.readCache.mu.Unlock()
+	assert.Zero(t, n, "a pinned-revision read must not populate the cache")
+}
+
+func TestWatchableStoreReadCacheClearedOnRestore(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	defer b.Close()
+	s := New(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{})
+	defer s.Close()
+
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+	r, err := s.Range(t.Context(), []byte("foo"), nil, RangeOptions{})
+	require.NoError(t, err)
+	require.Len(t, r.KVs, 1)
+	assert.Equal(t, "bar", string(r.KVs[0].Value))
+
+	// prepare a second backend with different data, standing in for a
+	// leader snapshot installed onto this member.
+	b2, _ := betesting.NewDefaultTmpBackend(t)
+	defer b2.Close()
+	prep := NewStore(zaptest.NewLogger(t), b2, &lease.FakeLessor{}, StoreConfig{})
+	prep.Put([]byte("foo"), []byte("from-snapshot"), lease.NoLease)
+	prep.Close()
+
+	require.NoError(t, s.Restore(b2))
+
+	r, err = s.Range(t.Context(), []byte("foo"), nil, RangeOptions{})
+	require.NoError(t, err)
+	require.Len(t, r.KVs, 1)
+	assert.Equal(t, "from-snapshot", string(r.KVs[0].Value), "must not serve a value cached against the pre-restore backend")
+}
+
+func TestWatchableStoreReadCacheTxnRangeAlsoCached(t *testing.T) {
+	s, closer := newTestWatchableStore(t)
+	defer closer.Close()
+
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	tr := s.Read(ConcurrentReadTxMode, traceutil.TODO())
+	r1, err := tr.Range(t.Context(), []byte("foo"), nil, RangeOptions{})
+	require.NoError(t, err)
+	tr.End()
+
+	ws := s.(*watchableStore)
+	_, cached := ws.readCache.get([]byte("foo"), nil, RangeOptions{})
+	require.True(t, cached)
+	assert.Equal(t, "bar", string(r1.KVs[0].Value))
+}
