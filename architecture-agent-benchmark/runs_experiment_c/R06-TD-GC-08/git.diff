+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package mvcc
+
+import (
+	"bytes"
+	"container/list"
+	"sync"
+
+	"go.etcd.io/etcd/api/v3/mvccpb"
+)
+
+// rangeCacheCapacity bounds the number of distinct range reads kept in the
+// read cache; the least-recently-used entry is evicted once the limit is
+// reached. Non-const so tests can shrink it.
+var rangeCacheCapacity = 4096
+
+// rangeCacheKey identifies a cacheable range read. Only current-revision
+// (RangeOptions.Rev == 0) reads are ever looked up or stored: callers must
+// check ro.Rev themselves, get/put treat every key as if Rev were 0.
+type rangeCacheKey struct {
+	key    string
+	end    string
+	hasEnd bool
+	ro     RangeOptions
+}
+
+func newRangeCacheKey(key, end []byte, ro RangeOptions) rangeCacheKey {
+	ro.Rev = 0
+	k := rangeCacheKey{key: string(key), hasEnd: end != nil, ro: ro}
+	if end != nil {
+		k.end = string(end)
+	}
+	return k
+}
+
+// covers reports whether a write to changedKey could have affected the
+// result of the range read identified by k, following the same [key, end)
+// (or single-key, or unbounded) semantics as ReadView.Range.
+func (k rangeCacheKey) covers(changedKey []byte) bool {
+	if !k.hasEnd {
+		return string(changedKey) == k.key
+	}
+	if bytes.Compare(changedKey, []byte(k.key)) < 0 {
+		return false
+	}
+	if k.end == "" {
+		// empty-but-non-nil end means "no upper bound" (see mkGteRange).
+		return true
+	}
+	return bytes.Compare(changedKey, []byte(k.end)) < 0
+}
+
+type rangeCacheEntry struct {
+	key    rangeCacheKey
+	result *RangeResult
+}
+
+// rangeCache caches the results of current-revision range reads, keyed by
+// their exact key/end/options. It must be invalidated synchronously by the
+// write path, strictly before a committing write's new revision becomes
+// observable to new readers (see watchableStoreTxnWrite.End), so that a
+// cache hit is always at least as fresh as a fresh read would have been at
+// the moment it was served — including for linearizable reads, since by the
+// time a linearizable read is unblocked, every write it must observe has
+// already gone through this same invalidation.
+type rangeCache struct {
+	mu      sync.Mutex
+	entries map[rangeCacheKey]*list.Element
+	order   *list.List // front = most recently used
+}
+
+func newRangeCache() *rangeCache {
+	return &rangeCache{
+		entries: make(map[rangeCacheKey]*list.Element),
+		order:   list.New(),
+	}
+}
+
+func (c *rangeCache) get(key, end []byte, ro RangeOptions) (*RangeResult, bool) {
+	k := newRangeCacheKey(key, end, ro)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	el, ok := c.entries[k]
+	if !ok {
+		return nil, false
+	}
+	c.order.MoveToFront(el)
+	return cloneRangeResult(el.Value.(*rangeCacheEntry).result), true
+}
+
+func (c *rangeCache) put(key, end []byte, ro RangeOptions, result *RangeResult) {
+	if rangeCacheCapacity <= 0 {
+		return
+	}
+	k := newRangeCacheKey(key, end, ro)
+	stored := cloneRangeResult(result)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if el, ok := c.entries[k]; ok {
+		el.Value.(*rangeCacheEntry).result = stored
+		c.order.MoveToFront(el)
+		return
+	}
+	el := c.order.PushFront(&rangeCacheEntry{key: k, result: stored})
+	c.entries[k] = el
+	for len(c.entries) > rangeCacheCapacity {
+		oldest := c.order.Back()
+		c.order.Remove(oldest)
+		delete(c.entries, oldest.Value.(*rangeCacheEntry).key)
+	}
+}
+
+// reset drops every cached entry unconditionally, e.g. because the whole
+// backend was just replaced (snapshot restore) and per-key invalidation no
+// longer applies.
+func (c *rangeCache) reset() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.entries = make(map[rangeCacheKey]*list.Element)
+	c.order = list.New()
+}
+
+// invalidate drops every cached entry whose range could have observed any
+// of changedKeys. It must be called synchronously from the write path
+// before the corresponding revision bump becomes visible to new readers.
+func (c *rangeCache) invalidate(changedKeys []*mvccpb.KeyValue) {
+	if len(changedKeys) == 0 {
+		return
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for el := c.order.Front(); el != nil; {
+		next := el.Next()
+		entry := el.Value.(*rangeCacheEntry)
+		for _, kv := range changedKeys {
+			if entry.key.covers(kv.Key) {
+				c.order.Remove(el)
+				delete(c.entries, entry.key)
+				break
+			}
+		}
+		el = next
+	}
+}
+
+// cloneRangeResult deep-enough-copies rr so that a cached RangeResult and
+// the copies handed out on hits are fully isolated: callers (e.g.
+// executeRange's KeysOnly/prune/sort handling) mutate the KeyValue structs
+// and slice in place, which must never reach the cache's own copy or leak
+// between two callers sharing a cache hit.
+func cloneRangeResult(rr *RangeResult) *RangeResult {
+	kvs := make([]*mvccpb.KeyValue, len(rr.KVs))
+	for i, kv := range rr.KVs {
+		kvs[i] = &mvccpb.KeyValue{
+			Key:            kv.Key,
+			CreateRevision: kv.CreateRevision,
+			ModRevision:    kv.ModRevision,
+			Version:        kv.Version,
+			Value:          kv.Value,
+			Lease:          kv.Lease,
+		}
+	}
+	return &RangeResult{KVs: kvs, Rev: rr.Rev, Count: rr.Count}
+}
