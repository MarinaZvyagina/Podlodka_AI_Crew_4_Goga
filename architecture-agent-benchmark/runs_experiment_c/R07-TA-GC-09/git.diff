--- a/domain/src/main/java/mihon/domain/extension/interactor/AddExtensionStore.kt
+++ b/domain/src/main/java/mihon/domain/extension/interactor/AddExtensionStore.kt
@@ -2,12 +2,31 @@ package mihon.domain.extension.interactor
 
 import dev.zacsweers.metro.Inject
 import mihon.domain.extension.repository.ExtensionStoreRepository
+import java.net.URI
+import java.net.URISyntaxException
 
 @Inject
 class AddExtensionStore(
     private val repository: ExtensionStoreRepository,
 ) {
     suspend operator fun invoke(indexUrl: String): Result<Unit> {
+        if (!isValidRepositoryUrl(indexUrl)) {
+            return Result.failure(InvalidExtensionStoreUrlException())
+        }
         return repository.insert(indexUrl)
     }
+
+    private fun isValidRepositoryUrl(url: String): Boolean {
+        if (url.isBlank()) return false
+        val uri = try {
+            URI(url)
+        } catch (e: URISyntaxException) {
+            return false
+        }
+        val scheme = uri.scheme?.lowercase()
+        return (scheme == "http" || scheme == "https") && !uri.host.isNullOrBlank()
+    }
 }
+
+class InvalidExtensionStoreUrlException :
+    IllegalArgumentException("Enter a valid repository URL starting with http:// or https://")
