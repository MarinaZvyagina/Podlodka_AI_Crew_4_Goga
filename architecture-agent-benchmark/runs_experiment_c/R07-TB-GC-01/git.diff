@@ -0,0 +1,19 @@
+package tachiyomi.domain.manga.interactor
+
+import dev.zacsweers.metro.Inject
+import kotlinx.coroutines.flow.Flow
+import tachiyomi.domain.manga.repository.MangaRepository
+
+@Inject
+class SetMangaUpdatesSnooze(
+    private val mangaRepository: MangaRepository,
+) {
+
+    fun subscribe(mangaId: Long): Flow<Long?> {
+        return mangaRepository.getUpdatesSnoozedUntilAsFlow(mangaId)
+    }
+
+    suspend fun await(mangaId: Long, snoozedUntil: Long?): Boolean {
+        return mangaRepository.setUpdatesSnoozedUntil(mangaId, snoozedUntil)
+    }
+}
