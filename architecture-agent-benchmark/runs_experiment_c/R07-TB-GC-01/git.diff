+package eu.kanade.presentation.manga.components
+
+import androidx.compose.foundation.layout.Column
+import androidx.compose.material3.AlertDialog
+import androidx.compose.material3.SelectableDates
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import eu.kanade.presentation.track.TrackDateSelector
+import tachiyomi.i18n.MR
+import tachiyomi.presentation.core.i18n.stringResource
+import kotlin.time.Clock
+import kotlin.time.Duration.Companion.days
+
+@Composable
+fun SnoozeUpdatesDialog(
+    isCurrentlySnoozed: Boolean,
+    onDismissRequest: () -> Unit,
+    onSnooze: (Long) -> Unit,
+    onClearSnooze: () -> Unit,
+) {
+    var showDatePicker by remember { mutableStateOf(false) }
+    val now = remember { Clock.System.now() }
+
+    if (showDatePicker) {
+        TrackDateSelector(
+            title = stringResource(MR.strings.action_snooze_custom_date),
+            initialSelectedDateMillis = now.toEpochMilliseconds(),
+            selectableDates = object : SelectableDates {
+                override fun isSelectableDate(utcTimeMillis: Long) = utcTimeMillis >= now.toEpochMilliseconds()
+            },
+            onConfirm = onSnooze,
+            onRemove = null,
+            onDismissRequest = onDismissRequest,
+        )
+        return
+    }
+
+    AlertDialog(
+        onDismissRequest = onDismissRequest,
+        title = { Text(text = stringResource(MR.strings.action_snooze_updates)) },
+        text = {
+            Column {
+                TextButton(onClick = { onSnooze((now + 1.days).toEpochMilliseconds()) }) {
+                    Text(text = stringResource(MR.strings.action_snooze_tomorrow))
+                }
+                TextButton(onClick = { onSnooze((now + 7.days).toEpochMilliseconds()) }) {
+                    Text(text = stringResource(MR.strings.action_snooze_next_week))
+                }
+                TextButton(onClick = { showDatePicker = true }) {
+                    Text(text = stringResource(MR.strings.action_snooze_custom_date))
+                }
+                if (isCurrentlySnoozed) {
+                    TextButton(onClick = onClearSnooze) {
+                        Text(text = stringResource(MR.strings.action_clear_snooze))
+                    }
+                }
+            }
+        },
+        confirmButton = {
+            TextButton(onClick = onDismissRequest) {
+                Text(text = stringResource(MR.strings.action_cancel))
+            }
+        },
+    )
+}
