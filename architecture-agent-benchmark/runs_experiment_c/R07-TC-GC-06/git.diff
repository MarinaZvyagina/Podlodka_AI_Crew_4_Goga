+package eu.kanade.tachiyomi.data.track.librereader.dto
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class LRSeries(
+    val id: Long,
+    val title: String,
+    @SerialName("cover_url")
+    val coverUrl: String? = null,
+)
+
+@Serializable
+data class LRLibraryEntry(
+    val id: Long,
+    @SerialName("series_id")
+    val seriesId: Long,
+    val title: String? = null,
+    val status: Long,
+    val progress: Int? = null,
+    @SerialName("total_chapters")
+    val totalChapters: Long? = null,
+)
+
+fun Track.copyFrom(entry: LRLibraryEntry): Track = apply {
+    library_id = entry.id
+    remote_id = entry.seriesId
+    entry.title?.let { title = it }
+    status = entry.status
+    last_chapter_read = entry.progress?.toDouble() ?: 0.0
+    total_chapters = entry.totalChapters ?: total_chapters
+}
