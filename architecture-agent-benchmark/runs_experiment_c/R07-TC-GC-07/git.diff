+package eu.kanade.tachiyomi.data.track.librereader.dto
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class LRSeries(
+    val id: Long,
+    val title: String,
+    val summary: String = "",
+    val coverUrl: String = "",
+    val authors: List<String> = emptyList(),
+    val totalChapters: Long = 0,
+)
+
+@Serializable
+data class LRLibraryEntry(
+    val id: Long,
+    val seriesId: Long,
+    val status: Long,
+    val lastChapterRead: Double,
+    val score: Double = 0.0,
+)
+
+@Serializable
+data class LRWhoAmI(
+    val username: String,
+)
+
+fun parseSearchItem(series: LRSeries, trackerId: Long): TrackSearch = TrackSearch.create(trackerId).apply {
+    remote_id = series.id
+    title = series.title
+    summary = series.summary
+    cover_url = series.coverUrl
+    authors = series.authors
+    total_chapters = series.totalChapters
+    tracking_url = ""
+}
+
+fun Track.copyFrom(entry: LRLibraryEntry): Track = apply {
+    library_id = entry.id
+    remote_id = entry.seriesId
+    status = entry.status
+    last_chapter_read = entry.lastChapterRead
+    score = entry.score
+}
