+@Serializable
+data class LRLibraryEntry(
+    val id: Long,
+    @SerialName("series_id")
+    val seriesId: Long,
+    val status: Long,
+    val progress: Double = 0.0,
+)
+
+@Serializable
+data class LRWhoAmI(
+    val username: String,
+)
