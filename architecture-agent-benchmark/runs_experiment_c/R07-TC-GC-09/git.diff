@@ -0,0 +1,19 @@
+package eu.kanade.tachiyomi.data.track.librereader
+
+import okhttp3.Credentials
+import okhttp3.Interceptor
+import okhttp3.Response
+
+class LibreReaderInterceptor(private val libreReader: LibreReader) : Interceptor {
+
+    override fun intercept(chain: Interceptor.Chain): Response {
+        val authenticatedRequest = chain.request().newBuilder()
+            .addHeader(
+                "Authorization",
+                Credentials.basic(libreReader.getUsername(), libreReader.getPassword()),
+            )
+            .build()
+
+        return chain.proceed(authenticatedRequest)
+    }
+}
