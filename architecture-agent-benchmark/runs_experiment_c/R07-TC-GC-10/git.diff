+package eu.kanade.tachiyomi.data.track.kosho.dto
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.kosho.Kosho
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class KoshoAuthDto(
+    val token: String,
+    val username: String,
+)
+
+@Serializable
+data class KoshoSeriesDto(
+    val id: Long,
+    val title: String,
+    @SerialName("cover_url")
+    val coverUrl: String? = null,
+    @SerialName("total_chapters")
+    val totalChapters: Long = 0,
+    @SerialName("last_chapter_read")
+    val lastChapterRead: Double = 0.0,
+    val status: String = "unread",
+)
+
+fun KoshoSeriesDto.toTrackSearch(trackerId: Long): TrackSearch = TrackSearch.create(trackerId).apply {
+    remote_id = this@toTrackSearch.id
+    title = this@toTrackSearch.title
+    cover_url = coverUrl ?: ""
+    total_chapters = totalChapters
+    tracking_url = ""
+}
+
+fun KoshoSeriesDto.copyTo(track: Track): Track = track.apply {
+    remote_id = this@copyTo.id
+    total_chapters = totalChapters
+    last_chapter_read = lastChapterRead
+    status = when (this@copyTo.status) {
+        "completed" -> Kosho.COMPLETED
+        "reading" -> Kosho.READING
+        else -> Kosho.UNREAD
+    }
+}
