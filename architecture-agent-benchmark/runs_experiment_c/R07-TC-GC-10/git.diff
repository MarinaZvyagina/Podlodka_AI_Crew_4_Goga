@@ -0,0 +1,26 @@
+package eu.kanade.tachiyomi.data.track.kosho
+
+import okhttp3.Interceptor
+import okhttp3.Response
+import java.io.IOException
+
+class KoshoInterceptor(kosho: Kosho) : Interceptor {
+
+    private var auth: Pair<String, String>? = kosho.restoreSession()
+
+    override fun intercept(chain: Interceptor.Chain): Response {
+        val token = auth?.second ?: throw IOException("Not authenticated with Kosho")
+
+        val authRequest = chain.request().newBuilder()
+            .addHeader("Authorization", "Bearer $token")
+            .build()
+
+        return chain.proceed(authRequest)
+    }
+
+    fun serverUrl(): String? = auth?.first
+
+    fun newAuth(serverUrl: String?, token: String?) {
+        auth = if (serverUrl != null && token != null) serverUrl to token else null
+    }
+}
