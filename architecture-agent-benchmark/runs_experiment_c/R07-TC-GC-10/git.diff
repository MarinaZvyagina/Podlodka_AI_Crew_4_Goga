@@ -0,0 +1,95 @@
+package eu.kanade.tachiyomi.data.track.kosho
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.kosho.dto.KoshoAuthDto
+import eu.kanade.tachiyomi.data.track.kosho.dto.KoshoSeriesDto
+import eu.kanade.tachiyomi.data.track.kosho.dto.copyTo
+import eu.kanade.tachiyomi.data.track.kosho.dto.toTrackSearch
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import uy.kohesive.injekt.injectLazy
+import java.io.IOException
+
+class KoshoApi(
+    private val trackerId: Long,
+    private val client: OkHttpClient,
+    private val interceptor: KoshoInterceptor,
+) {
+
+    private val json: Json by injectLazy()
+
+    private val authClient by lazy { client.newBuilder().addInterceptor(interceptor).build() }
+
+    suspend fun login(serverUrl: String, username: String, password: String): KoshoAuthDto {
+        val body = buildJsonObject {
+            put("username", username)
+            put("password", password)
+        }
+        return with(json) {
+            client.newCall(
+                POST(
+                    url = "$serverUrl/api/auth/login",
+                    body = body.toString().toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<KoshoAuthDto>()
+        }
+    }
+
+    suspend fun search(query: String): List<TrackSearch> {
+        val url = "${serverUrlOrThrow()}/api/series".toHttpUrl().newBuilder()
+            .addQueryParameter("query", query)
+            .build()
+        return with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<List<KoshoSeriesDto>>()
+                .map { it.toTrackSearch(trackerId) }
+        }
+    }
+
+    suspend fun getSeries(remoteId: Long): KoshoSeriesDto {
+        return with(json) {
+            authClient.newCall(GET("${serverUrlOrThrow()}/api/series/$remoteId"))
+                .awaitSuccess()
+                .parseAs()
+        }
+    }
+
+    suspend fun updateProgress(track: Track): Track {
+        val body = buildJsonObject {
+            put("lastChapterRead", track.last_chapter_read)
+            put("status", track.status)
+        }
+        val series = with(json) {
+            authClient.newCall(
+                PUT(
+                    url = "${serverUrlOrThrow()}/api/series/${track.remote_id}/progress",
+                    body = body.toString().toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<KoshoSeriesDto>()
+        }
+        return series.copyTo(track)
+    }
+
+    private fun serverUrlOrThrow(): String =
+        interceptor.serverUrl() ?: throw IOException("Not authenticated with Kosho")
+
+    companion object {
+        private val CONTENT_TYPE = "application/json".toMediaType()
+    }
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/data/track/kosho/KoshoInterceptor.kt b/app/src/main/java/eu/kanade/tachiyomi/data/track/kosho/KoshoInterceptor.kt
