@@ -0,0 +1,97 @@
+package eu.kanade.tachiyomi.data.track.kosho
+
+import dev.icerock.moko.resources.StringResource
+import eu.kanade.tachiyomi.R
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.BaseTracker
+import eu.kanade.tachiyomi.data.track.kosho.dto.copyTo
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import tachiyomi.i18n.MR
+import java.io.IOException
+import tachiyomi.domain.track.model.Track as DomainTrack
+
+class Kosho(id: Long) : BaseTracker(id, "Kosho") {
+
+    companion object {
+        const val UNREAD = 1L
+        const val READING = 2L
+        const val COMPLETED = 3L
+    }
+
+    private val interceptor by lazy { KoshoInterceptor(this) }
+    val api by lazy { KoshoApi(id, client, interceptor) }
+
+    override fun getLogo(): Int = R.drawable.brand_kosho
+
+    override fun getStatusList(): List<Long> = listOf(UNREAD, READING, COMPLETED)
+
+    override fun getStatus(status: Long): StringResource? = when (status) {
+        UNREAD -> MR.strings.unread
+        READING -> MR.strings.reading
+        COMPLETED -> MR.strings.completed
+        else -> null
+    }
+
+    override fun getReadingStatus(): Long = READING
+
+    override fun getRereadingStatus(): Long = -1
+
+    override fun getCompletionStatus(): Long = COMPLETED
+
+    override fun getScoreList(): List<String> = emptyList()
+
+    override fun displayScore(track: DomainTrack): String = ""
+
+    override suspend fun update(track: Track, didReadChapter: Boolean): Track {
+        if (track.status != COMPLETED && didReadChapter) {
+            track.status = if (track.total_chapters > 0 && track.last_chapter_read.toLong() >= track.total_chapters) {
+                COMPLETED
+            } else {
+                READING
+            }
+        }
+        return api.updateProgress(track)
+    }
+
+    override suspend fun bind(track: Track, hasReadChapters: Boolean): Track {
+        return try {
+            api.getSeries(track.remote_id).copyTo(track)
+        } catch (e: Exception) {
+            track.status = if (hasReadChapters) READING else UNREAD
+            api.updateProgress(track)
+        }
+    }
+
+    override suspend fun search(query: String): List<TrackSearch> = api.search(query)
+
+    override suspend fun refresh(track: Track): Track = api.getSeries(track.remote_id).copyTo(track)
+
+    override suspend fun login(username: String, password: String) {
+        val serverUrl = getServerUrl()
+        if (serverUrl.isEmpty()) {
+            throw IOException("Server URL is required")
+        }
+        val authenticated = api.login(serverUrl, username, password)
+        interceptor.newAuth(serverUrl, authenticated.token)
+        saveDisplayUsername(authenticated.username)
+        saveCredentials(username, authenticated.token)
+    }
+
+    override fun logout() {
+        super.logout()
+        trackPreferences.trackApiUrl(this).delete()
+        interceptor.newAuth(null, null)
+    }
+
+    fun getServerUrl(): String = trackPreferences.trackApiUrl(this).get()
+
+    fun saveServerUrl(url: String) {
+        trackPreferences.trackApiUrl(this).set(url.trim().trimEnd('/'))
+    }
+
+    fun restoreSession(): Pair<String, String>? {
+        val serverUrl = getServerUrl()
+        val token = getPassword()
+        return if (serverUrl.isNotEmpty() && token.isNotEmpty()) serverUrl to token else null
+    }
+}
