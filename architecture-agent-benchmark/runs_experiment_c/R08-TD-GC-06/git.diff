+
+package org.thoughtcrime.securesms.search
+
+import android.app.Application
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.mockkObject
+import io.mockk.unmockkObject
+import io.mockk.verify
+import org.junit.After
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.thoughtcrime.securesms.database.MentionTable
+import org.thoughtcrime.securesms.database.MessageTable
+import org.thoughtcrime.securesms.database.RecipientTable
+import org.thoughtcrime.securesms.database.SearchTable
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.database.ThreadTable
+import org.thoughtcrime.securesms.testutil.MockAppDependenciesRule
+
+/**
+ * Verifies that [SearchRepository] avoids repeating an identical [SearchRepository.queryMessagesSync]
+ * search against the database, and correctly re-runs it once the cache has been invalidated.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class SearchRepositoryCacheTest {
+
+  @get:Rule
+  val appDependencies = MockAppDependenciesRule()
+
+  private val searchTable = mockk<SearchTable>(relaxed = true)
+
+  private lateinit var repository: SearchRepository
+
+  @Before
+  fun setUp() {
+    mockkObject(SignalDatabase)
+    every { SignalDatabase.messageSearch } returns searchTable
+    every { SignalDatabase.threads } returns mockk<ThreadTable>(relaxed = true)
+    every { SignalDatabase.recipients } returns mockk<RecipientTable>(relaxed = true)
+    every { SignalDatabase.mentions } returns mockk<MentionTable>(relaxed = true)
+    every { SignalDatabase.messages } returns mockk<MessageTable>(relaxed = true)
+
+    every { searchTable.queryMessages(any(), any<SearchFilter>()) } returns null
+
+    repository = SearchRepository("Note to Self")
+
+    // The cache is shared across every SearchRepository instance for the life of the process, so
+    // clear out anything left behind by other tests before each one runs.
+    SearchRepository.invalidateCachesForTesting()
+  }
+
+  @After
+  fun tearDown() {
+    unmockkObject(SignalDatabase)
+  }
+
+  @Test
+  fun repeatedIdenticalSearchReusesCachedResult() {
+    repository.queryMessagesSync("hello", SearchFilter.EMPTY)
+    repository.queryMessagesSync("hello", SearchFilter.EMPTY)
+
+    verify(exactly = 1) { searchTable.queryMessages("hello", SearchFilter.EMPTY) }
+  }
+
+  @Test
+  fun differentQueriesAreCachedIndependently() {
+    repository.queryMessagesSync("hello", SearchFilter.EMPTY)
+    repository.queryMessagesSync("world", SearchFilter.EMPTY)
+
+    verify(exactly = 1) { searchTable.queryMessages("hello", SearchFilter.EMPTY) }
+    verify(exactly = 1) { searchTable.queryMessages("world", SearchFilter.EMPTY) }
+  }
+
+  @Test
+  fun differentFiltersAreCachedIndependently() {
+    val unfiltered = SearchFilter.EMPTY
+    val filtered = SearchFilter(startDate = 1000L)
+
+    repository.queryMessagesSync("hello", unfiltered)
+    repository.queryMessagesSync("hello", filtered)
+
+    verify(exactly = 1) { searchTable.queryMessages("hello", unfiltered) }
+    verify(exactly = 1) { searchTable.queryMessages("hello", filtered) }
+  }
+
+  @Test
+  fun invalidationForcesReQueryOnNextIdenticalSearch() {
+    repository.queryMessagesSync("hello", SearchFilter.EMPTY)
+
+    SearchRepository.invalidateCachesForTesting()
+
+    repository.queryMessagesSync("hello", SearchFilter.EMPTY)
+
+    verify(exactly = 2) { searchTable.queryMessages("hello", SearchFilter.EMPTY) }
+  }
+}
