+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.database
+
+/**
+ * A real, test-owned [DatabaseObserver] that tests outside this package can point
+ * `AppDependencies.databaseObserver` at (via mockk `every`) when they need change notifications to
+ * actually fire, plus a deterministic way to drain its async executor. Lives in this package because
+ * [DatabaseObserver.flush] is package-private.
+ */
+object SharedObserver {
+  val instance = DatabaseObserver()
+
+  fun flush() {
+    instance.flush()
+  }
+}
diff --git a/app/src/test/java/org/thoughtcrime/securesms/search/SearchRepositoryCacheTest.kt b/app/src/test/java/org/thoughtcrime/securesms/search/SearchRepositoryCacheTest.kt
