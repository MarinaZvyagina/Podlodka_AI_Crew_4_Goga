+++ b/app/src/test/java/org/thoughtcrime/securesms/search/SearchRepositoryCacheTest.kt
@@ -0,0 +1,136 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import android.app.Application
+import assertk.assertThat
+import assertk.assertions.hasSize
+import assertk.assertions.isEmpty
+import assertk.assertions.isNotSameInstanceAs
+import assertk.assertions.isSameInstanceAs
+import io.mockk.every
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.thoughtcrime.securesms.database.MessageType
+import org.thoughtcrime.securesms.database.SharedObserver
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.mms.IncomingMessage
+import org.thoughtcrime.securesms.recipients.RecipientId
+import org.thoughtcrime.securesms.testutil.RecipientTestRule
+
+/**
+ * Verifies that [SearchRepository]'s in-memory cache for chat-list search (a) actually gets hit on a
+ * repeated identical query, (b) keeps distinct queries independent, and (c) never serves a cached
+ * result once the underlying data it was computed from has changed.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class SearchRepositoryCacheTest {
+
+  @get:Rule
+  val recipients = RecipientTestRule()
+
+  private val repository by lazy { SearchRepository("Note to Self") }
+
+  @Before
+  fun setUp() {
+    // RecipientTestRule leaves AppDependencies.databaseObserver as an inert auto-mock (nothing in
+    // this suite otherwise depends on it firing). SearchRepository's cache invalidation rides that
+    // signal, so point it at a real DatabaseObserver for these tests.
+    every { AppDependencies.databaseObserver } returns SharedObserver.instance
+  }
+
+  // The cache is process-wide (shared across every SearchRepository instance, see the class doc on
+  // SearchRepository), and Robolectric does not reset static state between @Test methods in this
+  // suite, so each test searches for its own unique term to avoid seeing another test's cache entry.
+
+  @Test
+  fun repeatedIdenticalMessageSearchIsServedFromCache() {
+    val recipientId = recipients.createRecipient("Needle Haystack")
+    insertMessage(recipientId, "alphaneedle in a haystack", sentTimeMillis = 100L)
+
+    val first = repository.queryMessagesSync("alphaneedle", SearchFilter.EMPTY)
+    val second = repository.queryMessagesSync("alphaneedle", SearchFilter.EMPTY)
+
+    assertThat(second).isSameInstanceAs(first)
+  }
+
+  @Test
+  fun repeatedIdenticalThreadSearchIsServedFromCache() {
+    recipients.createRecipient("Betaneedle Haystack")
+
+    val first = repository.queryThreadsSync("betaneedle", false)
+    val second = repository.queryThreadsSync("betaneedle", false)
+
+    assertThat(second).isSameInstanceAs(first)
+  }
+
+  @Test
+  fun differentQueriesAreCachedIndependently() {
+    val recipientId = recipients.createRecipient("Gammaneedle Haystack")
+    insertMessage(recipientId, "gammaneedle in a haystack", sentTimeMillis = 100L)
+    insertMessage(recipientId, "totally deltaneedle content", sentTimeMillis = 101L)
+
+    val needleResult = repository.queryMessagesSync("gammaneedle", SearchFilter.EMPTY)
+    val unrelatedResult = repository.queryMessagesSync("deltaneedle", SearchFilter.EMPTY)
+
+    assertThat(unrelatedResult).isNotSameInstanceAs(needleResult)
+    assertThat(unrelatedResult.results).hasSize(1)
+    assertThat(needleResult.results).hasSize(1)
+  }
+
+  @Test
+  fun deletingAMatchingMessageInvalidatesTheCachedSearch() {
+    val recipientId = recipients.createRecipient("Epsilonneedle Haystack")
+    val messageId = insertMessage(recipientId, "epsilonneedle in a haystack", sentTimeMillis = 100L)
+    insertMessage(recipientId, "an unrelated second message keeping the thread alive", sentTimeMillis = 101L)
+
+    val before = repository.queryMessagesSync("epsilonneedle", SearchFilter.EMPTY)
+    assertThat(before.results).hasSize(1)
+
+    SignalDatabase.messages.deleteMessage(messageId)
+    SharedObserver.flush()
+
+    val after = repository.queryMessagesSync("epsilonneedle", SearchFilter.EMPTY)
+    assertThat(after.results).isEmpty()
+  }
+
+  @Test
+  fun newMessageInvalidatesAPreviouslyCachedSearchForTheSameTerm() {
+    val recipientId = recipients.createRecipient("Zetaneedle Haystack")
+
+    val before = repository.queryMessagesSync("zetaneedle", SearchFilter.EMPTY)
+    assertThat(before.results).isEmpty()
+
+    insertMessage(recipientId, "zetaneedle in a haystack", sentTimeMillis = 100L)
+    SharedObserver.flush()
+
+    val after = repository.queryMessagesSync("zetaneedle", SearchFilter.EMPTY)
+    assertThat(after.results).hasSize(1)
+  }
+
+  private fun insertMessage(from: RecipientId, body: String, sentTimeMillis: Long): Long {
+    val threadId = SignalDatabase.threads.getOrCreateThreadIdFor(from, false)
+    return SignalDatabase.messages.insertMessageInbox(
+      IncomingMessage(
+        type = MessageType.NORMAL,
+        from = from,
+        groupId = null,
+        body = body,
+        sentTimeMillis = sentTimeMillis,
+        receivedTimeMillis = sentTimeMillis,
+        serverTimeMillis = sentTimeMillis,
+        isUnidentified = true
+      ),
+      threadId
+    ).get().messageId
+  }
+}
