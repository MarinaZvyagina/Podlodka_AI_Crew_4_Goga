+    // MARK: - Removing Data
+    @MainActor
+    func testRemoveWindowData_removesPrimaryAndBackupFiles() async throws {
+        let subject = createSubject()
+        let primaryDir = URL(string: "some/directory1")!
+        let backupDir = URL(string: "some/directory2")!
+        mockFileManager.primaryDirectoryURL = primaryDir
+        mockFileManager.backupDirectoryURL = backupDir
+        let fileURL = primaryDir.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        mockFileManager.pathContents = [fileURL]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        let expectedBackupURL = backupDir.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertTrue(mockFileManager.removedPaths.contains(fileURL))
+        XCTAssertTrue(mockFileManager.removedPaths.contains(expectedBackupURL))
+    }
+
+    @MainActor
+    func testRemoveWindowData_leavesWindowsNotInListUntouched() async throws {
+        let subject = createSubject()
+        let uuidToKeep = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        let primaryDir = URL(string: "some/directory1")!
+        let backupDir = URL(string: "some/directory2")!
+        mockFileManager.primaryDirectoryURL = primaryDir
+        mockFileManager.backupDirectoryURL = backupDir
+        let removeFileURL = primaryDir.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        let keepFileURL = primaryDir.appendingPathComponent("window-\(uuidToKeep.uuidString)")
+        mockFileManager.pathContents = [removeFileURL, keepFileURL]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        let keepBackupURL = backupDir.appendingPathComponent("window-\(uuidToKeep.uuidString)")
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertFalse(mockFileManager.removedPaths.contains(keepFileURL))
+        XCTAssertFalse(mockFileManager.removedPaths.contains(keepBackupURL))
+    }
+
+    @MainActor
+    func testRemoveWindowData_noBackupDirectory_doesNotError() async throws {
+        let subject = createSubject()
+        let primaryDir = URL(string: "some/directory1")!
+        mockFileManager.primaryDirectoryURL = primaryDir
+        mockFileManager.backupDirectoryURL = nil
+        let fileURL = primaryDir.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        mockFileManager.pathContents = [fileURL]
