+    @MainActor
+    func testRemoveWindowData_removesPrimaryAndBackupFiles_leavesOtherWindowsUntouched() async throws {
+        let subject = createSubject()
+        let uuidToRemove = defaultTestTabWindowUUID
+        let uuidToKeep = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        let primaryDirectoryURL = URL(string: "some/directory1")!
+        let backupDirectoryURL = URL(string: "some/directory2")!
+        let primaryFileToRemove = primaryDirectoryURL.appendingPathComponent("window-\(uuidToRemove.uuidString)")
+        let primaryFileToKeep = primaryDirectoryURL.appendingPathComponent("window-\(uuidToKeep.uuidString)")
+        let backupFileToRemove = backupDirectoryURL.appendingPathComponent("window-\(uuidToRemove.uuidString)")
+        mockFileManager.primaryDirectoryURL = primaryDirectoryURL
+        mockFileManager.backupDirectoryURL = backupDirectoryURL
+        mockFileManager.pathContents = [primaryFileToRemove, primaryFileToKeep]
+        mockFileManager.backupPathContents = [backupFileToRemove]
+
+        await subject.removeWindowData(forUUIDs: [uuidToRemove])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(primaryFileToRemove))
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(backupFileToRemove))
+        XCTAssertFalse(mockFileManager.removedFileURLs.contains(primaryFileToKeep))
+    }
+
+    @MainActor
