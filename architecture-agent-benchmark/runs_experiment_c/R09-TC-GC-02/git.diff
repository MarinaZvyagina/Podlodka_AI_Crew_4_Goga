index 00000000..63eb396a
--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,70 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+/// A stand-in for an alternative third-party speech transcription pipeline, used to A/B test
+/// transcription quality/latency against the platform default engine.
+///
+/// Shares permission and audio session handling with the other engines so that microphone/speech
+/// authorization and error behavior stay identical regardless of which pipeline is active. The
+/// transcription itself is simulated: it streams a scripted sequence of results with an artificial
+/// delay between each, standing in for a real remote/on-device call.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    static let defaultScript: [SpeechResult] = [
+        SpeechResult(text: "What's", isFinal: false),
+        SpeechResult(text: "What's the weather", isFinal: false),
+        SpeechResult(text: "What's the weather today", isFinal: true)
+    ]
+
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let scriptedResults: [SpeechResult]
+    private let stepDelayNanoseconds: UInt64
+
+    private var streamingTask: Task<Void, Never>?
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        scriptedResults: [SpeechResult] = AlternativeTranscriptionEngine.defaultScript,
+        stepDelayNanoseconds: UInt64 = 400_000_000
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.scriptedResults = scriptedResults
+        self.stepDelayNanoseconds = stepDelayNanoseconds
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        streamingTask?.cancel()
+        streamingTask = Task { [scriptedResults, stepDelayNanoseconds] in
+            for result in scriptedResults {
+                guard !Task.isCancelled else { return }
+                try? await Task.sleep(nanoseconds: stepDelayNanoseconds)
+                guard !Task.isCancelled else { return }
+
+                continuation.yield(result)
+                if result.isFinal {
+                    continuation.finish()
+                    return
+                }
+            }
+        }
+    }
+
+    func stop() async throws {
+        streamingTask?.cancel()
+        streamingTask = nil
+        try audioManager.stopEngine()
+    }
+}
