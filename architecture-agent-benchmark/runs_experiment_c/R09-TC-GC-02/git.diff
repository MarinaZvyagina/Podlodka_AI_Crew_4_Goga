diff --git a/BrowserKit/Tests/QuickAnswersKitTests/SpeechService/AlternativeTranscriptionEngineTests.swift b/BrowserKit/Tests/QuickAnswersKitTests/SpeechService/AlternativeTranscriptionEngineTests.swift
new file mode 100644
index 00000000..d3d872ab
--- /dev/null
+++ b/BrowserKit/Tests/QuickAnswersKitTests/SpeechService/AlternativeTranscriptionEngineTests.swift
@@ -0,0 +1,118 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import Testing
+import TestKit
+
+@testable import QuickAnswersKit
+
+@Suite
+@MainActor
+struct AlternativeTranscriptionEngineTests {
+    let testHelper = SwiftTestingHelper()
+    let audioManager = MockAudioManager()
+
+    @Test
+    func test_prepare_microphoneDenied_throwsMicrophoneError() async {
+        let authorizer = MockAuthorizer(micAuthorized: false, speechAuthorized: false)
+        let subject = createSubject(authorizer: authorizer)
+
+        await #expect(throws: SpeechError.microphonePermissionDenied(isFirstTime: false)) {
+            try await subject.prepare()
+        }
+
+        #expect(audioManager.configureAudioSessionCallCount == 0)
+    }
+
+    @Test
+    func test_prepare_microphoneGranted_speechDenied_throwsSpeechError() async {
+        let authorizer = MockAuthorizer(micAuthorized: true, speechAuthorized: false)
+        let subject = createSubject(authorizer: authorizer)
+
+        await #expect(throws: SpeechError.speechRecognitionPermissionDenied(isFirstTime: false)) {
+            try await subject.prepare()
+        }
+
+        #expect(audioManager.configureAudioSessionCallCount == 0)
+    }
+
+    @Test
+    func test_prepare_withPermissions_callsConfigureAudioSession() async throws {
+        let authorizer = MockAuthorizer(micAuthorized: true, speechAuthorized: true)
+        let subject = createSubject(authorizer: authorizer)
+
+        try await subject.prepare()
+
+        #expect(audioManager.configureAudioSessionCallCount == 1)
+    }
+
+    @Test
+    func test_start_streamsScriptedResultsAndFinishesAfterFinal() async throws {
+        let authorizer = MockAuthorizer(micAuthorized: true, speechAuthorized: true)
+        let scriptedResults = [
+            SpeechResult(text: "Hello", isFinal: false),
+            SpeechResult(text: "Hello world", isFinal: true)
+        ]
+        let subject = createSubject(authorizer: authorizer, scriptedResults: scriptedResults)
+
+        var received: [SpeechResult] = []
+        let stream = AsyncThrowingStream<SpeechResult, any Error> { continuation in
+            Task {
+                try await subject.start(continuation: continuation)
+            }
+        }
+
+        for try await result in stream {
+            received.append(result)
+        }
+
+        #expect(received == scriptedResults)
+        #expect(audioManager.startCaptureSimpleCallCount == 1)
+        #expect(audioManager.prepareAndStartEngineCallCount == 1)
+    }
+
+    @Test
+    func test_start_withNoScriptedResults_finishesWithoutYielding() async throws {
+        let authorizer = MockAuthorizer(micAuthorized: true, speechAuthorized: true)
+        let subject = createSubject(authorizer: authorizer, scriptedResults: [])
+
+        var received: [SpeechResult] = []
+        let stream = AsyncThrowingStream<SpeechResult, any Error> { continuation in
+            Task {
+                try await subject.start(continuation: continuation)
+                continuation.finish()
+            }
+        }
+
+        for try await result in stream {
+            received.append(result)
+        }
+
+        #expect(received.isEmpty)
+    }
+
+    @Test
+    func test_stop_callsStopEngine() async throws {
+        let authorizer = MockAuthorizer(micAuthorized: true, speechAuthorized: true)
+        let subject = createSubject(authorizer: authorizer)
+
+        try await subject.stop()
+
+        #expect(audioManager.stopEngineCallCount == 1)
+    }
+
+    private func createSubject(
+        authorizer: AuthorizeProvider,
+        scriptedResults: [SpeechResult] = AlternativeTranscriptionEngine.defaultScript
+    ) -> AlternativeTranscriptionEngine {
+        let subject = AlternativeTranscriptionEngine(
+            audioManager: audioManager,
+            authorizer: authorizer,
+            scriptedResults: scriptedResults,
+            stepDelayNanoseconds: 0
+        )
+        testHelper.trackForMemoryLeaks(subject)
+        return subject
+    }
+}
