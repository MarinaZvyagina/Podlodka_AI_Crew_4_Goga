diff --git a/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
new file mode 100644
index 0000000..e23d251
--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,73 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+/// A stand-in transcription engine used to A/B test an alternative speech-to-text pipeline against the
+/// platform-provided engines (`SFSpeechRecognizerEngine`/`SpeechAnalyzerEngine`).
+///
+/// It follows the same permission/audio-session lifecycle as the other engines so the rest of the Quick
+/// Answers flow (recording UI, streaming, error handling) behaves identically regardless of which engine
+/// is active. Transcription itself is simulated with canned incremental chunks rather than calling out to
+/// a real third-party service.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    static let defaultSimulatedChunks = ["This", "is", "a", "simulated", "transcription", "result"]
+
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let simulatedChunks: [String]
+    private let chunkDelayNanoseconds: UInt64
+
+    private var transcriptionTask: Task<Void, Never>?
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        simulatedChunks: [String] = AlternativeTranscriptionEngine.defaultSimulatedChunks,
+        chunkDelayNanoseconds: UInt64 = 300_000_000
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.simulatedChunks = simulatedChunks
+        self.chunkDelayNanoseconds = chunkDelayNanoseconds
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        guard !simulatedChunks.isEmpty else {
+            continuation.finish()
+            return
+        }
+
+        transcriptionTask = Task { [simulatedChunks, chunkDelayNanoseconds] in
+            var accumulated = ""
+            for (index, word) in simulatedChunks.enumerated() {
+                guard !Task.isCancelled else { return }
+
+                accumulated += accumulated.isEmpty ? word : " \(word)"
+                let isFinal = index == simulatedChunks.count - 1
+                continuation.yield(SpeechResult(text: accumulated, isFinal: isFinal))
+
+                if isFinal {
+                    continuation.finish()
+                    return
+                }
+                try? await Task.sleep(nanoseconds: chunkDelayNanoseconds)
+            }
+        }
+    }
+
+    func stop() throws {
+        transcriptionTask?.cancel()
+        transcriptionTask = nil
+        try audioManager.stopEngine()
+    }
+}
