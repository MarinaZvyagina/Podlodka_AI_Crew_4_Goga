diff --git a/SignalServiceKit/Storage/MediaGallery/MediaGalleryAttachmentFinder.swift b/SignalServiceKit/Storage/MediaGallery/MediaGalleryAttachmentFinder.swift
index 3bc78c0..5dbddd2 100644
--- a/SignalServiceKit/Storage/MediaGallery/MediaGalleryAttachmentFinder.swift
+++ b/SignalServiceKit/Storage/MediaGallery/MediaGalleryAttachmentFinder.swift
@@ -268,6 +268,44 @@ public struct MediaGalleryAttachmentFinder {
         ).count)
     }
 
+    /// Returns the sqlite row ids of messages in the given thread that have at least one body
+    /// attachment (photo, video, voice message, or file), disregarding attachment category/type.
+    /// Used to power "shared media only" filtering of in-conversation search results.
+    public static func messageRowIdsWithBodyAttachments(
+        inThreadId threadId: Int64,
+        restrictedToMessageRowIds messageRowIds: Set<Int64>? = nil,
+        limit: Int? = nil,
+        tx: DBReadTransaction,
+    ) -> Set<Int64> {
+        let threadIdColumn = Column(RecordType.CodingKeys.threadRowId)
+        let ownerTypeColumn = Column(RecordType.CodingKeys.ownerType)
+        let isViewOnceColumn = Column(RecordType.CodingKeys.isViewOnce)
+        let isPastEditRevisionColumn = Column(RecordType.CodingKeys.ownerIsPastEditRevision)
+        let ownerIdColumn = Column(RecordType.CodingKeys.ownerRowId)
+
+        var query: QueryInterfaceRequest<RecordType> = RecordType
+            .filter(threadIdColumn == threadId)
+            .filter(ownerTypeColumn == RecordType.OwnerType.bodyAttachment.rawValue)
+            .filter(isViewOnceColumn == false)
+            .filter(isPastEditRevisionColumn == false)
+
+        if let messageRowIds {
+            query = query.filter(messageRowIds.contains(ownerIdColumn))
+        }
+
+        var rowIdQuery = query.select(ownerIdColumn, as: Int64.self).distinct()
+        if let limit {
+            rowIdQuery = rowIdQuery.order(ownerIdColumn.desc).limit(limit)
+        }
+
+        do {
+            return Set(try rowIdQuery.fetchAll(tx.database))
+        } catch {
+            owsFailDebug("Error fetching message row ids with body attachments: \(error)")
+            return []
+        }
+    }
+
     // MARK: - Private
 
     typealias RecordType = AttachmentReference.MessageAttachmentReferenceRecord
