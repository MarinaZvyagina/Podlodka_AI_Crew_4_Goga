 public final class BulkDeleteInteractionJobQueue {
     private let jobRunnerFactory: BulkDeleteInteractionJobRunnerFactory
     private let jobQueueRunner: JobQueueRunner<
@@ -64,6 +66,72 @@ public final class BulkDeleteInteractionJobQueue {
             self.jobQueueRunner.addPersistedJob(jobRecord)
         }
     }
+
+    // MARK: - Message Retention
+
+    private enum RetentionConstants {
+        static let secondsPerDay: TimeInterval = 24 * 60 * 60
+        static let minimumSweepInterval: TimeInterval = 24 * 60 * 60
+    }
+
+    /// Enqueues a bulk-delete job for every thread that has messages older
+    /// than the given retention window, unconditionally (ignoring throttling).
+    public func sweepMessageRetention(
+        retentionPeriodDays: UInt32,
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        let cutoffDate = now.addingTimeInterval(-TimeInterval(retentionPeriodDays) * RetentionConstants.secondsPerDay)
+        let cutoffTimestamp = cutoffDate.ows_millisecondsSince1970
+
+        threadStore.enumerateNonStoryThreads(tx: tx) { thread -> Bool in
+            let threadUniqueId = thread.uniqueId
+            guard
+                let anchorRowId = InteractionFinder(threadUniqueId: threadUniqueId)
+                    .rowIdOfNewestInteraction(receivedAtOrBefore: cutoffTimestamp, tx: tx)
+            else {
+                return true
+            }
+
+            self.addJob(
+                anchorMessageRowId: anchorRowId,
+                isFullThreadDelete: false,
+                threadUniqueId: threadUniqueId,
+                tx: tx,
+            )
+
+            return true
+        }
+
+        SSKPreferences.setLastMessageRetentionSweepAt(now, transaction: tx)
+    }
+
+    /// A throttled wrapper around ``sweepMessageRetention(retentionPeriodDays:now:threadStore:tx:)``,
+    /// intended for routine/automatic triggers (e.g. app launch, foregrounding).
+    func sweepMessageRetentionIfNeeded(
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        guard let retentionPeriodDays = SSKPreferences.messageRetentionPeriodDays(transaction: tx) else {
+            return
+        }
+
+        if
+            let lastSweptAt = SSKPreferences.lastMessageRetentionSweepAt(transaction: tx),
+            now.timeIntervalSince(lastSweptAt) < RetentionConstants.minimumSweepInterval
+        {
+            return
+        }
+
+        sweepMessageRetention(
+            retentionPeriodDays: retentionPeriodDays,
+            now: now,
+            threadStore: threadStore,
+            tx: tx,
+        )
+    }
 }
 
