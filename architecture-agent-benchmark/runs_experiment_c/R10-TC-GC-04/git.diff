+    // MARK: - Message Retention
+
+    private static let messageRetentionPeriodDaysOptions: [UInt32?] = [30, 90, 365, nil]
+
+    private static func formatMessageRetentionPeriodDays(_ days: UInt32?) -> String {
+        guard let days else {
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_FOREVER",
+                comment: "Label indicating that messages are kept forever, in the 'message retention' setting picker.",
+            )
+        }
+        switch days {
+        case 365:
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_1_YEAR",
+                comment: "Label indicating that messages are kept for one year, in the 'message retention' setting picker.",
+            )
+        default:
+            return String(
+                format: OWSLocalizedString(
+                    "SETTINGS_MESSAGE_RETENTION_N_DAYS_FORMAT",
+                    comment: "Label indicating that messages are kept for a number of days, in the 'message retention' setting picker. Embeds {{ the number of days }}.",
+                ),
+                String(days),
+            )
+        }
+    }
+
+    private func showMessageRetentionPicker() {
+        let actionSheet = ActionSheetController(title: OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_TITLE",
+            comment: "Title for the 'message retention' setting, which lets the user automatically delete old messages.",
+        ))
+
+        for days in Self.messageRetentionPeriodDaysOptions {
+            actionSheet.addAction(.init(
+                title: Self.formatMessageRetentionPeriodDays(days),
+                handler: { [weak self] _ in
+                    self?.didSelectMessageRetentionPeriodDays(days)
+                },
+            ))
+        }
+
+        actionSheet.addAction(OWSActionSheets.cancelAction)
+        presentActionSheet(actionSheet)
+    }
+
+    private func didSelectMessageRetentionPeriodDays(_ days: UInt32?) {
+        Logger.info("selected message retention period days: \(String(describing: days))")
+
+        SSKEnvironment.shared.databaseStorageRef.asyncWrite { tx in
+            SSKPreferences.setMessageRetentionPeriodDays(days, transaction: tx)
+
+            if let days {
+                SSKEnvironment.shared.bulkDeleteInteractionJobQueueRef.sweepMessageRetention(
+                    retentionPeriodDays: days,
+                    now: Date(),
+                    threadStore: DependenciesBridge.shared.threadStore,
+                    tx: tx,
+                )
+            }
+        } completion: { [weak self] in
+            self?.updateTableContents()
+        }
+    }
 }
