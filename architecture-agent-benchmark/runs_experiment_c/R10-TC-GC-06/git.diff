+
+    // MARK: - Message Retention
+
+    private static let messageRetentionOptionsDays: [UInt32?] = [nil, 30, 90, 365]
+
+    private func messageRetentionCurrentValueLabel() -> String {
+        let retentionPeriodDays = SSKEnvironment.shared.databaseStorageRef.read { tx in
+            SSKPreferences.messageRetentionPeriodDays(transaction: tx)
+        }
+        return Self.messageRetentionLabel(forDays: retentionPeriodDays)
+    }
+
+    private static func messageRetentionLabel(forDays days: UInt32?) -> String {
+        guard let days else {
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_FOREVER",
+                comment: "Label indicating that messages are kept forever, in the 'message retention' setting.",
+            )
+        }
+        if days == 365 {
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_1_YEAR",
+                comment: "Label indicating that messages are kept for 1 year, in the 'message retention' setting.",
+            )
+        }
+        return String(
+            format: OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_N_DAYS_FORMAT",
+                comment: "Label indicating that messages are kept for a number of days, in the 'message retention' setting. Embeds {{ the number of days }}.",
+            ),
+            String(days),
+        )
+    }
+
+    private func showMessageRetentionPicker() {
+        let actionSheet = ActionSheetController(title: OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_TITLE",
+            comment: "Title for the 'message retention' setting in the Chats settings, which lets the user choose how long to keep messages before automatically deleting them.",
+        ))
+
+        for days in Self.messageRetentionOptionsDays {
+            actionSheet.addAction(.init(
+                title: Self.messageRetentionLabel(forDays: days),
+                handler: { [weak self] _ in
+                    self?.didPickMessageRetention(days: days)
+                },
+            ))
+        }
+
+        actionSheet.addAction(OWSActionSheets.cancelAction)
+
+        presentActionSheet(actionSheet)
+    }
+
+    private func didPickMessageRetention(days: UInt32?) {
+        SSKEnvironment.shared.databaseStorageRef.asyncWrite { tx in
+            SSKPreferences.setMessageRetentionPeriodDays(days, transaction: tx)
+
+            guard let days else { return }
+
+            SSKEnvironment.shared.bulkDeleteInteractionJobQueueRef.sweepMessageRetention(
+                retentionPeriodDays: days,
+                now: Date(),
+                threadStore: DependenciesBridge.shared.threadStore,
+                tx: tx,
+            )
+        } completion: { [weak self] in
+            self?.updateTableContents()
+        }
+    }
 }
