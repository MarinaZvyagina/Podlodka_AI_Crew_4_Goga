diff --git a/freqtrade/configuration/config_validation.py b/freqtrade/configuration/config_validation.py
index 1c22c2b..5dd7c5c 100644
--- a/freqtrade/configuration/config_validation.py
+++ b/freqtrade/configuration/config_validation.py
@@ -93,6 +93,7 @@ def validate_config_consistency(conf: dict[str, Any], *, preliminary: bool = Fal
     validate_migrated_strategy_settings(conf)
     _validate_orderflow(conf)
     _validate_demo_trading(conf)
+    _validate_available_capital(conf)
 
     # validate configuration before returning
     logger.info("Validating configuration ...")
@@ -419,6 +420,28 @@ def _validate_demo_trading(conf: dict[str, Any]) -> None:
         raise ConfigurationError("Demo trading cannot be used together with dry_run.")
 
 
+def _validate_available_capital(conf: dict[str, Any]) -> None:
+    """
+    `available_capital` and a non-default `tradable_balance_ratio` cannot be
+    meaningfully combined - only one of the two settings actually takes effect
+    (available_capital wins), and the other is silently ignored.
+    Emits an unmissable warning (rather than a hard failure) so that internal/
+    test code paths that legitimately construct both values (e.g. to exercise
+    Wallets precedence directly) are not broken - the goal is to make sure
+    users seeing this at startup understand what's happening.
+    """
+    if "available_capital" in conf and "tradable_balance_ratio" in conf:
+        # 0.99 is the schema default for tradable_balance_ratio (config_schema.py).
+        # Only warn when the user has explicitly set it to something else -
+        # leaving it at the default is not a conflicting configuration.
+        if conf["tradable_balance_ratio"] != 0.99:
+            logger.warning(
+                "Both `available_capital` and a non-default `tradable_balance_ratio` are set. "
+                "Only `available_capital` will be used to determine your starting balance - "
+                "`tradable_balance_ratio` will be ignored. Please remove one of these settings."
+            )
+
+
 def _strategy_settings(conf: dict[str, Any]) -> None:
     process_deprecated_setting(conf, None, "use_sell_signal", None, "use_exit_signal")
     process_deprecated_setting(conf, None, "sell_profit_only", None, "exit_profit_only")
diff --git a/tests/test_configuration.py b/tests/test_configuration.py
index 59516f6..0eea5ce 100644
--- a/tests/test_configuration.py
+++ b/tests/test_configuration.py
@@ -760,6 +760,42 @@ def test_validate_tsl(default_conf):
         validate_config_consistency(default_conf)
 
 
+def test_validate_available_capital(default_conf, caplog):
+    # Regular case - only available_capital set - must not warn
+    conf = deepcopy(default_conf)
+    conf["available_capital"] = 1000
+    conf.pop("tradable_balance_ratio", None)
+    validate_config_consistency(conf)
+    assert "tradable_balance_ratio" not in caplog.text
+
+    # Regular case - only tradable_balance_ratio set - must not warn
+    caplog.clear()
+    conf = deepcopy(default_conf)
+    conf.pop("available_capital", None)
+    conf["tradable_balance_ratio"] = 0.5
+    validate_config_consistency(conf)
+    assert "tradable_balance_ratio" not in caplog.text
+
+    # available_capital + default tradable_balance_ratio (0.99) - must not warn
+    caplog.clear()
+    conf = deepcopy(default_conf)
+    conf["available_capital"] = 1000
+    conf["tradable_balance_ratio"] = 0.99
+    validate_config_consistency(conf)
+    assert "tradable_balance_ratio" not in caplog.text
+
+    # Conflicting case - both set, tradable_balance_ratio non-default -
+    # must emit an unmissable warning referencing both settings, without
+    # raising (this must not prevent the bot from continuing to start).
+    caplog.clear()
+    conf = deepcopy(default_conf)
+    conf["available_capital"] = 1000
+    conf["tradable_balance_ratio"] = 0.5
+    validate_config_consistency(conf)
+    assert "available_capital" in caplog.text
+    assert "tradable_balance_ratio" in caplog.text
+
+
