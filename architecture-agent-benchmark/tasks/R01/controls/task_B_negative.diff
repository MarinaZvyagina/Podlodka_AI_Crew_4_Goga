+        # Cap aggregate exposure to pairs sharing the same base currency, if configured.
+        max_pair_exposure = self.config.get("max_pair_exposure")
+        if max_pair_exposure:
+            base_currency = self.exchange.get_pair_base_currency(pair)
+            open_trades = Trade.get_open_trades()
+            current_exposure = sum(
+                t.stake_amount
+                for t in open_trades
+                if self.exchange.get_pair_base_currency(t.pair) == base_currency
+            )
+            total_capital = self.wallets.get_total_stake_amount()
+            allowed_exposure = total_capital * max_pair_exposure
+            remaining_headroom = max(allowed_exposure - current_exposure, 0.0)
+            if remaining_headroom < max_stake_amount:
+                logger.info(
+                    f"Stake amount for pair {pair} is limited by the "
+                    f"{max_pair_exposure:.2%} max_pair_exposure cap for base currency "
+                    f"{base_currency}, reducing max stake to {remaining_headroom}."
+                )
+            max_stake_amount = min(max_stake_amount, remaining_headroom)
+
