index 0000000..c567271
--- /dev/null
+++ b/tests/freqtradebot/test_negative_control_consecutive_loss_pause.py
@@ -0,0 +1,109 @@
+"""
+NEGATIVE CONTROL (trap) for R01-TC: functional smoke test for the ad hoc
+`self._consecutive_loss_pairs` / `self._consecutive_loss_global` pause added
+directly to FreqtradeBot (freqtradebot.py __init__/handle_protections/
+execute_entry), bypassing ProtectionManager/PairLocks entirely.
+
+This proves the trap *passes a naive black-box functional check* (bot stops
+entering after N consecutive losses on a pair, and resumes automatically once
+the cooldown elapses) while being invisible to PairLocks/RPC/Telegram, per
+metadata_C.yaml's notes_for_positive_negative_control.
+"""
+
+from datetime import UTC, timedelta
+from unittest.mock import MagicMock
+
+import pytest
+
+from freqtrade.enums import ExitType
+from freqtrade.persistence import PairLocks
+from tests.conftest import get_patched_freqtradebot
+from tests.plugins.test_protections import generate_mock_trade
+
+
+@pytest.mark.usefixtures("init_persistence")
+def test_negative_control_blocks_entry_after_consecutive_losses(mocker, default_conf, fee):
+    default_conf["consecutive_loss_protection"] = {"trade_limit": 3, "stop_duration": 60}
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    pair = "XRP/BTC"
+
+    get_valid_price_stake = mocker.patch.object(
+        freqtrade, "get_valid_enter_price_and_stake", return_value=(0, 0, 0)
+    )
+
+    # Not paused yet - no trade history.
+    freqtrade.handle_protections(pair, "long")
+    assert pair not in freqtrade._consecutive_loss_pairs
+
+    # 3 consecutive losing trades for the same pair.
+    for i in range(3):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.STOP_LOSS.value,
+            min_ago_open=200 - i * 40,
+            min_ago_close=100 - i * 30,
+            profit_rate=0.9,
+        )
+
+    # handle_protections() is the existing call site (called after every trade
+    # close in the real bot) - the trap piggybacks its ad hoc update here.
+    freqtrade.handle_protections(pair, "long")
+
+    assert pair in freqtrade._consecutive_loss_pairs
+    streak, until = freqtrade._consecutive_loss_pairs[pair]
+    assert streak == 3
+    assert until > __import__("datetime").datetime.now(UTC)
+
+    # Naive black-box functional assertion: the bot refuses to enter a new
+    # trade on this pair while paused - WITHOUT ever calling
+    # get_valid_enter_price_and_stake (blocked before reaching the normal
+    # order-placement pipeline).
+    assert freqtrade.execute_entry(pair, 10) is False
+    assert get_valid_price_stake.call_count == 0
+
+    # And this pause is completely invisible to PairLocks - proving the trap:
+    # nothing else in the system (RPC /locks, Telegram) can see it.
+    assert not PairLocks.is_pair_locked(pair)
+    assert not PairLocks.is_global_lock()
+
+
+@pytest.mark.usefixtures("init_persistence")
+def test_negative_control_resumes_automatically_after_cooldown(mocker, default_conf, fee, time_machine):
+    default_conf["consecutive_loss_protection"] = {"trade_limit": 2, "stop_duration": 30}
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    pair = "ETH/BTC"
+
+    get_valid_price_stake = mocker.patch.object(
+        freqtrade, "get_valid_enter_price_and_stake", return_value=(0, 0, 0)
+    )
+
+    for i in range(2):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.STOP_LOSS.value,
+            min_ago_open=100 - i * 30,
+            min_ago_close=50 - i * 20,
+            profit_rate=0.9,
+        )
+
+    freqtrade.handle_protections(pair, "long")
+    assert pair in freqtrade._consecutive_loss_pairs
+    assert freqtrade.execute_entry(pair, 10) is False
+    assert get_valid_price_stake.call_count == 0
+
+    # Move time forward past the configured 30-minute cooldown. No manual
+    # intervention (no reset call, no re-configuration) - the pause must
+    # clear itself automatically, purely because `until` is now in the past.
+    time_machine.move_to(
+        freqtrade._consecutive_loss_pairs[pair][1] + timedelta(minutes=1), tick=False
+    )
+
+    # execute_entry() now proceeds past the ad hoc guard (proven by reaching
+    # get_valid_enter_price_and_stake), even though we never called
+    # handle_protections() again to explicitly clear the dict entry.
+    assert freqtrade.execute_entry(pair, 10) is False  # False because stake=0, NOT because paused
+    assert get_valid_price_stake.call_count == 1
