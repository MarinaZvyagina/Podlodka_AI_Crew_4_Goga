+    def _update_consecutive_loss_pause(self, pair: str) -> None:
+        """
+        Recompute the consecutive-loss streak for `pair` and bot-wide, updating
+        self._consecutive_loss_pairs / self._consecutive_loss_global directly.
+        """
+        now = datetime.now(UTC)
+        limit = self._consecutive_loss_trade_limit
+        stop_minutes = self._consecutive_loss_stop_minutes
+
+        def _streak(trades) -> int:
+            trades_recent_first = sorted(
+                (t for t in trades if t.close_date), key=lambda t: t.close_date, reverse=True
+            )
+            streak = 0
+            for t in trades_recent_first:
+                if (t.close_profit or 0.0) < 0:
+                    streak += 1
+                else:
+                    break
+            return streak
+
+        pair_trades = Trade.get_trades_proxy(pair=pair, is_open=False)
+        pair_streak = _streak(pair_trades)
+        if pair_streak >= limit:
+            self._consecutive_loss_pairs[pair] = (pair_streak, now + timedelta(minutes=stop_minutes))
+        elif pair in self._consecutive_loss_pairs and self._consecutive_loss_pairs[pair][1] <= now:
+            del self._consecutive_loss_pairs[pair]
+
+        all_trades = Trade.get_trades_proxy(is_open=False)
+        global_streak = _streak(all_trades)
+        if global_streak >= limit:
