+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "trade_limit": 3,
+            "stop_duration": 60,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    assert not freqtrade.protections.global_stop()
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+
+    # 1st losing trade - not enough yet
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=200,
+        min_ago_close=100,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert not PairLocks.is_pair_locked("XRP/BTC")
+
+    # 2nd losing trade in a row - still not enough
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=90,
+        min_ago_close=60,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert not PairLocks.is_pair_locked("XRP/BTC")
+
+    # 3rd losing trade in a row - threshold reached, should lock the pair
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=50,
+        min_ago_close=20,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    assert freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert PairLocks.is_pair_locked("XRP/BTC")
+    assert not PairLocks.is_global_lock()
+
+
+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses_streak_broken_by_win(mocker, default_conf, fee, caplog):
+    """
+    Proves this is genuine consecutive-loss STREAK counting, not a
+    cumulative/summed profit check (LowProfitPairs' approach): a winning
+    trade resets the streak even though total historical profit may still be
+    negative.
+    """
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "trade_limit": 2,
+            "stop_duration": 60,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    # Older losing trade
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=300,
+        min_ago_close=200,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    # A winning trade breaks the streak
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        min_ago_open=150,
+        min_ago_close=100,
+        profit_rate=1.15,
+    )
+    Trade.commit()
+    # Only 1 losing trade since the streak-breaking win -- below the
+    # threshold of 2 consecutive losses.
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=50,
+        min_ago_close=20,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+
+    # Despite 2 total losing trades existing in history, only 1 is
+    # contiguous with the most recent close (the win broke the streak), so
+    # this must NOT lock.
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert not PairLocks.is_pair_locked("XRP/BTC")
+
+
