+def test_ticker_lru_cache_serves_stale_price_forever(mocker, default_conf, tickers, time_machine):
+    """
+    NEGATIVE CONTROL / TRAP DEMONSTRATION (probing test -- exposes the danger):
+    functools.lru_cache has no TTL/expiry at all. Unlike a correct short-lived
+    TTL cache, it will keep serving the FIRST-EVER fetched price for a pair
+    forever (until process restart), even long after any reasonable TTL and
+    even after the "market" price has clearly moved. A live-trading bot would
+    make entry/exit decisions on a frozen, arbitrarily stale price.
+    """
+    start_dt = datetime(2026, 1, 1, tzinfo=UTC)
+    time_machine.move_to(start_dt, tick=False)
+
+    api_mock = MagicMock()
+    first_tick = tickers()["ETH/BTC"]
+    api_mock.fetch_ticker = MagicMock(return_value=first_tick)
+    api_mock.markets = {"ETH/BTC": {"active": True}}
+    exchange = get_patched_exchange(mocker, default_conf, api_mock)
+    dp = DataProvider(default_conf, exchange)
+
+    res1 = dp.ticker("ETH/BTC")
+    assert res1["bid"] == first_tick["bid"]
+    assert api_mock.fetch_ticker.call_count == 1
+
+    # The "market" price changes dramatically, and we advance well past any
+    # reasonable short TTL (a few seconds) -- e.g. an hour later.
+    new_tick = {**tickers()["ETH/BTC"], "bid": 999.0, "ask": 1000.0, "last": 999.5}
+    api_mock.fetch_ticker = MagicMock(return_value=new_tick)
+    time_machine.move_to(start_dt + timedelta(hours=1), tick=False)
+
+    res2 = dp.ticker("ETH/BTC")
+
+    # DANGEROUS: with functools.lru_cache (no TTL), the exchange is never called
+    # again for this pair/instance, and the stale first-ever price is returned
+    # forever -- this is the exact bug the task asked us to avoid.
+    assert api_mock.fetch_ticker.call_count == 0, (
+        "Trap confirmed: lru_cache never re-fetches, so the new mock (representing "
+        "the exchange's current price) was never called."
+    )
+    assert res2["bid"] == first_tick["bid"], (
+        "Trap confirmed: dp.ticker() is still returning the ORIGINAL (now stale) "
+        "price an hour later, instead of a fresh one."
+    )
+    assert res2["bid"] != new_tick["bid"]
+
+
