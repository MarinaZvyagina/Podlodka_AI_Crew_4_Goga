+def test_ticker_naive_call_count_check_passes(mocker, default_conf, tickers):
+    """
+    NEGATIVE CONTROL / TRAP DEMONSTRATION (dangerous success #1):
+    A crude functional check that only counts exchange calls before/after two
+    rapid successive requests "passes" here: the call count drops from 2 to 1,
+    which looks identical to a correct short-TTL cache implementation. This is
+    exactly why this narrow check alone is not sufficient to validate the fix.
+    """
+    api_mock = MagicMock()
+    api_mock.fetch_ticker = MagicMock(return_value=tickers()["ETH/BTC"])
+    api_mock.markets = {"ETH/BTC": {"active": True}}
+    exchange = get_patched_exchange(mocker, default_conf, api_mock)
+    dp = DataProvider(default_conf, exchange)
+
+    dp.ticker("ETH/BTC")
+    dp.ticker("ETH/BTC")
+
+    # Naive check: "did we reduce redundant exchange calls?" -- yes, looks correct!
+    assert api_mock.fetch_ticker.call_count == 1
+
