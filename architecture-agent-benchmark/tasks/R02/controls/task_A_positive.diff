diff --git a/tests/pytests/unit/beacons/test_diskusage.py b/tests/pytests/unit/beacons/test_diskusage.py
index 94fff2f..3d885b6 100644
--- a/tests/pytests/unit/beacons/test_diskusage.py
+++ b/tests/pytests/unit/beacons/test_diskusage.py
@@ -210,3 +210,87 @@ def test_diskusage_windows_match_regex(
                 {"diskusage": 50, "mount": "D:\\"},
             ]
             assert ret == _expected
+
+
+def test_diskusage_low_threshold_fires(stub_disk_usage, stub_disk_partition):
+    """
+    A mount configured with a "low" threshold should fire when usage is at
+    or below that threshold.
+    """
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        # config matches only "/", whose (first, and only) disk_usage call
+        # reports 50% per the stub_disk_usage fixture
+        config = [{"/": {"low": "60%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == [{"diskusage": 50, "mount": "/"}]
+
+
+def test_diskusage_low_threshold_nomatch(stub_disk_usage, stub_disk_partition):
+    """
+    A mount configured with a "low" threshold should not fire when usage is
+    above that threshold.
+    """
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        # config matches only "/", which reports 50% usage; 50% is above
+        # the 10% low threshold so no beacon should fire
+        config = [{"/": {"low": "10%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == []
+
+
+def test_diskusage_high_and_low_threshold(stub_disk_usage, stub_disk_partition):
+    """
+    A mount configured with both "high" and "low" thresholds should keep
+    firing on the high threshold exactly like the plain-percent form, and
+    should also fire on the low threshold for a different mount.
+    """
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        # stub_disk_usage reports 50% for /mnt/tmp and 25% for /
+        config = [
+            {"/mnt/tmp": {"high": "40%", "low": "5%"}},
+            {"/": {"high": "90%", "low": "30%"}},
+        ]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == [
+            {"diskusage": 50, "mount": "/mnt/tmp"},
+            {"diskusage": 25, "mount": "/"},
+        ]
+
+
+def test_diskusage_low_threshold_no_percent_sign(stub_disk_usage, stub_disk_partition):
+    """
+    The "low" threshold should also accept a bare number, just like the
+    existing plain-percent config form does.
+    """
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        config = [{"/": {"low": 60}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == [{"diskusage": 50, "mount": "/"}]
