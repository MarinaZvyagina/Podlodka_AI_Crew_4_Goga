+def test_status():
+    """
+    Test that beacons.status returns per-beacon last-fired/error data by
+    calling each configured beacon's beacon() function directly.
+    """
+    with patch.dict(
+        beacons.__opts__,
+        {
+            "beacons": {
+                "ps": [{"processes": {"salt-master": "stopped"}}],
+            },
+        },
+    ):
+        mock_beacon_fun = MagicMock(return_value=[{"salt-master": "Running"}])
+        with patch(
+            "salt.loader.beacons", MagicMock(return_value={"ps.beacon": mock_beacon_fun})
+        ):
+            ret = beacons.status()
+            assert "ps" in ret
+            assert ret["ps"]["error"] is False
+            assert ret["ps"]["last_fired"] is not None
