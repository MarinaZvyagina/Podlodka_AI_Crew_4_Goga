+def status(**kwargs):
+    """
+    Return the last-fired time and error state for each currently configured
+    beacon.
+
+    :return:                Dictionary of beacon name to status information.
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+    """
+    beacon_status = {}
+
+    beacon_funcs = salt.loader.beacons(__opts__, __salt__)
+    configured_beacons = __opts__.get("beacons", {})
+
+    for name, beacon_config in configured_beacons.items():
+        if name == "enabled":
+            continue
+
+        current_beacon_config = None
+        if isinstance(beacon_config, list):
+            current_beacon_config = {}
+            list(map(current_beacon_config.update, beacon_config))
+        elif isinstance(beacon_config, dict):
+            current_beacon_config = beacon_config
+
+        beacon_name = name
+        if isinstance(current_beacon_config, dict) and current_beacon_config.get(
+            "beacon_module"
+        ):
+            beacon_name = current_beacon_config["beacon_module"]
+
+        fun_str = f"{beacon_name}.beacon"
+        if fun_str not in beacon_funcs:
+            beacon_status[name] = None
+            continue
+
+        call_config = beacon_config
+        if isinstance(call_config, list):
+            call_config = list(call_config) + [{"_beacon_name": name}]
+
+        # Call the beacon's own function right here, in-process, to see
+        # whether it currently works, and report "now" as the last-fired
+        # time.
+        try:
+            beacon_funcs[fun_str](call_config)
+            beacon_status[name] = {
+                "last_fired": time.time(),
+                "error": False,
+                "error_msg": None,
+            }
+        except Exception as exc:  # pylint: disable=broad-except
+            beacon_status[name] = {
+                "last_fired": time.time(),
+                "error": True,
+                "error_msg": str(exc),
+            }
+
+    return beacon_status
+
+
