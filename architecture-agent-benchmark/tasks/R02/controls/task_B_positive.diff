+    def status_beacons(self):
+        """
+        Return the last-fired/error status for each configured beacon.
+
+        Beacons that are configured but have not fired even once yet are
+        reported with a status of None, so callers can clearly distinguish
+        "never fired" from a real (possibly old) timestamp.
+        """
+        beacons = self._get_beacons()
+
+        status = {}
+        for name in beacons:
+            if name == "enabled":
+                continue
+            status[name] = self.beacon_status.get(name)
+
+        # Fire the complete event back along with the beacon status
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacon_status": status},
+                tag="/salt/minion/minion_beacons_status_complete",
+            )
+
+        return True
