+def test_beacon_process_records_status(minion_opts):
+    """
+    Test that process() records a last-fired timestamp (and no error) in
+    beacon_status for a beacon that ran successfully, and that a beacon which
+    has never fired has no entry (status_beacons reports it as None).
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+
+    # No beacon has fired yet.
+    assert beacon.beacon_status == {}
+
+    before = time.time()
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+    after = time.time()
+
+    assert "watch_apache" in beacon.beacon_status
+    status = beacon.beacon_status["watch_apache"]
+    assert status["error"] is False
+    assert status["error_msg"] is None
+    assert before <= status["last_fired"] <= after
+
+    # status_beacons should report this beacon's recorded status, and a
+    # never-fired beacon as None.
+    minion_opts["beacons"]["never_fired"] = [{"beacon_module": "ps"}]
+    with patch("salt.utils.event.get_event"):
+        assert beacon.status_beacons() is True
+    assert beacon.beacon_status.get("never_fired") is None
+
+
+def test_beacon_process_records_error_status(minion_opts):
+    """
+    Test that process() records an error status (with the exception message)
+    for a beacon whose beacon() function raises.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+    beacon_mock = MagicMock(side_effect=Exception("Global Thermonuclear War"))
+    beacon_mock.__globals__ = {}
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.beacons["ps.beacon"] = beacon_mock
+
+    before = time.time()
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+    after = time.time()
+
+    assert "watch_apache" in beacon.beacon_status
+    status = beacon.beacon_status["watch_apache"]
+    assert status["error"] is True
+    assert status["error_msg"] == "Global Thermonuclear War"
+    assert before <= status["last_fired"] <= after
