         return beacons
 
 
+def status(**kwargs):
+    """
+    Return the last-fired time and error state for each currently configured
+    beacon, as recorded by the running minion's beacon evaluation loop.
+
+    A beacon that has not fired even once yet is reported with a status of
+    ``None`` rather than a stale or made-up value.
+
+    :return:                Dictionary of beacon name to status information.
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+    """
+    beacon_status = None
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"]({"func": "status"}, "manage_beacons")
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacons_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                log.debug("event_ret %s", event_ret)
+                if event_ret and event_ret["complete"]:
+                    beacon_status = event_ret["beacon_status"]
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+        return ret
+
+    if beacon_status is None:
+        beacon_status = {}
+
+    return beacon_status
+
