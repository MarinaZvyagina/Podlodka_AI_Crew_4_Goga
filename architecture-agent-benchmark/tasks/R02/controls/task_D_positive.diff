diff --git a/salt/modules/disk.py b/salt/modules/disk.py
index f766769..066b9ec 100644
--- a/salt/modules/disk.py
+++ b/salt/modules/disk.py
@@ -94,6 +94,17 @@ def usage(args=None):
         salt '*' disk.usage
     """
     flags = _clean_flags(args, "disk.usage")
+
+    # Repeated calls with the same flags/args within a single Salt run
+    # should not re-shell-out to ``df`` and re-parse its output every time.
+    # __context__ is the documented per-run cache: it is populated fresh
+    # for every independent run/loader instantiation (unlike a plain
+    # module-level global, which would persist -- and go stale -- across
+    # unrelated runs sharing this module object).
+    usage_cache = __context__.setdefault("disk.usage", {})
+    if flags in usage_cache:
+        return usage_cache[flags]
+
     if not os.path.isfile("/etc/mtab") and __grains__["kernel"] == "Linux":
         log.error("df cannot run without /etc/mtab")
         if __grains__.get("virtual_subtype") == "LXC":
@@ -102,7 +113,8 @@ def usage(args=None):
                 "a Docker container, consider linking /proc/mounts to "
                 "/etc/mtab or consider running Docker with -privileged"
             )
-        return {}
+        usage_cache[flags] = {}
+        return usage_cache[flags]
     if __grains__["kernel"] == "Linux":
         cmd = "df -P"
     elif __grains__["kernel"] == "OpenBSD" or __grains__["kernel"] == "AIX":
@@ -157,6 +169,7 @@ def usage(args=None):
         except IndexError:
             log.error("Problem parsing disk usage information")
             ret = {}
+    usage_cache[flags] = ret
     return ret
 
 
diff --git a/tests/pytests/unit/modules/test_disk.py b/tests/pytests/unit/modules/test_disk.py
index 11b2170..536fc5e 100644
--- a/tests/pytests/unit/modules/test_disk.py
+++ b/tests/pytests/unit/modules/test_disk.py
@@ -162,6 +162,53 @@ def test_usage_none():
             assert "" == disk.usage(args=None)
 
 
+def test_usage_cached_within_run():
+    """
+    Repeated calls to disk.usage() with identical args within the same
+    run/context should not re-invoke __salt__['cmd.run'] -- the second
+    call should be served from the per-run __context__ cache.
+    """
+    df_output = (
+        "Filesystem     1K-blocks     Used Available Use% Mounted on\n"
+        "/dev/sda1        1000000   400000    600000  40% /\n"
+    )
+    mock_cmd = MagicMock(return_value=df_output)
+    # Use a kernel other than "Linux" so the /etc/mtab existence check
+    # (irrelevant to what this test is exercising) doesn't short-circuit
+    # usage() depending on whether /etc/mtab happens to exist on the box
+    # running the test suite.
+    with patch.dict(disk.__grains__, {"kernel": "SunOS"}), patch.dict(
+        disk.__salt__, {"cmd.run": mock_cmd}
+    ):
+        first = disk.usage(args=None)
+        second = disk.usage(args=None)
+
+    assert first == second
+    assert first["/"]["available"] == "600000"
+    mock_cmd.assert_called_once()
+
+
+def test_usage_not_stale_across_separate_test_functions():
+    """
+    A separate test function (using a fresh __context__ from the standard
+    per-test loader fixture) must see freshly-mocked df output, not a value
+    left over from test_usage_cached_within_run's mock/cache.
+    """
+    df_output = (
+        "Filesystem     1K-blocks     Used Available Use% Mounted on\n"
+        "/dev/sda1        2000000  1000000   1000000  50% /\n"
+    )
+    mock_cmd = MagicMock(return_value=df_output)
+    with patch.dict(disk.__grains__, {"kernel": "SunOS"}), patch.dict(
+        disk.__salt__, {"cmd.run": mock_cmd}
+    ):
+        result = disk.usage(args=None)
+
+    assert result["/"]["available"] == "1000000"
+    assert result["/"]["available"] != "600000"
+    mock_cmd.assert_called_once()
+
+
 def test_inodeusage(stub_disk_inodeusage):
     with patch.dict(disk.__grains__, {"kernel": "OpenBSD"}), patch(
         "salt.modules.disk.inodeusage", MagicMock(return_value=stub_disk_inodeusage)
