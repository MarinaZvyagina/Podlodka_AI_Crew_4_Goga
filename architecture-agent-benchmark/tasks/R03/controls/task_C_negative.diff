+import { INestApplication } from '@nestjs/common';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Registers a raw Express-style middleware, directly against the underlying
+ * HTTP adapter instance, that rejects requests to a hardcoded list of
+ * "protected" paths while maintenance mode is on.
+ *
+ * NOTE: this runs at the middleware layer, BEFORE NestJS routing/guard
+ * resolution -- it is not built on `CanActivate`/`Reflector`, and it only
+ * ever sees plain HTTP requests, so it has no way to protect a
+ * `@SubscribeMessage` WebSocket gateway handler.
+ */
+export function registerMaintenanceMiddleware(
+  app: INestApplication,
+  maintenanceModeService: MaintenanceModeService,
+): void {
+  app.use((req: any, res: any, next: (...args: unknown[]) => void) => {
+    if (
+      maintenanceModeService.isEnabled() &&
+      maintenanceModeService.protectedPaths.has(req.path)
+    ) {
+      res
+        .status(503)
+        .json({ message: 'Service is currently under maintenance.' });
+      return;
+    }
+    next();
+  });
+}
