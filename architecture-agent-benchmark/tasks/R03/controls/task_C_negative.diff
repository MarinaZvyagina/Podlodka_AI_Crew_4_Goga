+import {
+  MessageBody,
+  SubscribeMessage,
+  WebSocketGateway,
+} from '@nestjs/websockets';
+import { callLog } from './call-log.js';
+
+@WebSocketGateway(8099)
+export class AppGateway {
+  // Intended to be "maintenance protected" too, but the middleware-based
+  // check only runs on the HTTP request pipeline -- it never sees
+  // WebSocket message frames, so this handler keeps executing even while
+  // maintenance mode is on.
+  @SubscribeMessage('protectedMessage')
+  onProtectedMessage(@MessageBody() data: unknown) {
+    callLog.push('onProtectedMessage');
+    return { event: 'protectedReply', data };
+  }
+
+  @SubscribeMessage('unprotectedMessage')
+  onUnprotectedMessage(@MessageBody() data: unknown) {
+    callLog.push('onUnprotectedMessage');
+    return { event: 'unprotectedReply', data };
+  }
+}
