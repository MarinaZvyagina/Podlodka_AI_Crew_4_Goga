+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the current maintenance-mode flag, plus the hardcoded set of HTTP
+ * paths that are affected by maintenance mode.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  /**
+   * Registry of HTTP route paths that are "protected" by maintenance mode.
+   * New protected routes must be added here by hand.
+   */
+  readonly protectedPaths = new Set<string>(['/protected']);
+
+  enable(): void {
+    this.enabled = true;
+  }
+
+  disable(): void {
+    this.enabled = false;
+  }
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+}
