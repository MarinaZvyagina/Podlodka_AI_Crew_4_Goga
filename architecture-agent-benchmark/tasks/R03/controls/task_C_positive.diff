+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the current maintenance-mode flag. In a real application this could
+ * be backed by a feature-flag service, a database row, or an env var that is
+ * refreshed periodically — the guard only depends on `isEnabled()`.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  enable(): void {
+    this.enabled = true;
+  }
+
+  disable(): void {
+    this.enabled = false;
+  }
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+}
