+import { ExecutionContext, ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { MaintenanceModeGuard } from '../src/maintenance-mode.guard.js';
+import { MaintenanceModeService } from '../src/maintenance-mode.service.js';
+import { MaintenanceProtected } from '../src/maintenance-protected.decorator.js';
+
+/**
+ * Pure unit test: the guard is instantiated directly, with no HTTP server
+ * and no socket connection involved. Two mock `ExecutionContext` objects
+ * stand in for a protected and an unprotected handler.
+ */
+class ProtectedHandlerHost {
+  @MaintenanceProtected()
+  protectedHandler() {
+    return 'should-not-run';
+  }
+
+  unprotectedHandler() {
+    return 'should-run';
+  }
+}
+
+function createMockContext(handlerName: keyof ProtectedHandlerHost) {
+  const instance = new ProtectedHandlerHost();
+  return {
+    getHandler: () => instance[handlerName],
+    getClass: () => ProtectedHandlerHost,
+  } as unknown as ExecutionContext;
+}
+
+describe('MaintenanceModeGuard (unit, no server/socket)', () => {
+  let guard: MaintenanceModeGuard;
+  let maintenanceModeService: MaintenanceModeService;
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(new Reflector(), maintenanceModeService);
+  });
+
+  it('allows an unmarked handler regardless of maintenance mode state', () => {
+    const context = createMockContext('unprotectedHandler');
+
+    maintenanceModeService.disable();
+    expect(guard.canActivate(context)).toBe(true);
+
+    maintenanceModeService.enable();
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('allows a marked handler while maintenance mode is off', () => {
+    const context = createMockContext('protectedHandler');
+    maintenanceModeService.disable();
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks a marked handler while maintenance mode is on', () => {
+    const context = createMockContext('protectedHandler');
+    maintenanceModeService.enable();
+
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('restores normal behavior once maintenance mode is toggled off again', () => {
+    const context = createMockContext('protectedHandler');
+
+    maintenanceModeService.enable();
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+
+    maintenanceModeService.disable();
+    expect(guard.canActivate(context)).toBe(true);
+  });
+});
