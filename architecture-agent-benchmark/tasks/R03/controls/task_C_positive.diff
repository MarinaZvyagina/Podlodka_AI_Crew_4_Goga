+import { SetMetadata } from '@nestjs/common';
+
+/**
+ * Metadata key under which the "maintenance protected" flag is stored.
+ * Read back by `MaintenanceModeGuard` via `Reflector`.
+ */
+export const MAINTENANCE_PROTECTED_KEY = 'maintenance_protected';
+
+/**
+ * Marks an individual route handler (HTTP controller method or
+ * `@SubscribeMessage` gateway handler) or an entire controller/gateway
+ * class as affected by maintenance mode.
+ *
+ * When maintenance mode is enabled, calls to marked handlers are rejected
+ * by `MaintenanceModeGuard` before the handler body executes. Unmarked
+ * handlers are unaffected.
+ */
+export const MaintenanceProtected = () =>
+  SetMetadata(MAINTENANCE_PROTECTED_KEY, true);
