+import { Controller, Get } from '@nestjs/common';
+import { callLog } from './call-log.js';
+import { MaintenanceProtected } from './maintenance-protected.decorator.js';
+
+@Controller()
+export class AppController {
+  @Get('protected')
+  @MaintenanceProtected()
+  protectedRoute(): string {
+    callLog.push('protectedRoute');
+    return 'protected-ok';
+  }
+
+  @Get('unprotected')
+  unprotectedRoute(): string {
+    callLog.push('unprotectedRoute');
+    return 'unprotected-ok';
+  }
+}
