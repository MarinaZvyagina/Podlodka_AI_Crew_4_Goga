+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { MAINTENANCE_PROTECTED_KEY } from './maintenance-protected.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Reuses the framework's existing guard mechanism (the same
+ * `GuardsContextCreator`/`GuardsConsumer` pair used by both the HTTP router
+ * and the WebSocket gateway context creator) to reject calls to handlers
+ * marked with `@MaintenanceProtected()` while maintenance mode is on.
+ *
+ * Because it is a plain `CanActivate` registered globally (via `APP_GUARD`),
+ * it is invoked for every HTTP route AND every gateway message handler —
+ * there is nothing HTTP-adapter specific about it.
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isProtected = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_PROTECTED_KEY,
+      [context.getHandler(), context.getClass()],
+    );
+
+    if (!isProtected) {
+      return true;
+    }
+
+    if (this.maintenanceModeService.isEnabled()) {
+      throw new ServiceUnavailableException(
+        'Service is currently under maintenance. Please try again later.',
+      );
+    }
+
+    return true;
+  }
+}
