+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import { io, type Socket } from 'socket.io-client';
+import request from 'supertest';
+import { AppModule } from '../src/app.module.js';
+import { callLog, resetCallLog } from '../src/call-log.js';
+import { MaintenanceModeService } from '../src/maintenance-mode.service.js';
+
+describe('Maintenance mode (e2e, real HTTP server + real WS gateway)', () => {
+  let app: INestApplication;
+  let maintenanceModeService: MaintenanceModeService;
+  let ws: Socket;
+
+  beforeAll(async () => {
+    const moduleRef = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = moduleRef.createNestApplication();
+    await app.listen(3211);
+    maintenanceModeService = app.get(MaintenanceModeService);
+
+    ws = io('http://localhost:8099');
+    await new Promise<void>(resolve => ws.on('connect', resolve));
+  });
+
+  afterAll(async () => {
+    ws.disconnect();
+    await app.close();
+  });
+
+  beforeEach(() => {
+    resetCallLog();
+    maintenanceModeService.disable();
+  });
+
+  describe('HTTP', () => {
+    it('allows the unprotected route while maintenance mode is on', async () => {
+      maintenanceModeService.enable();
+
+      await request(app.getHttpServer())
+        .get('/unprotected')
+        .expect(200)
+        .expect('unprotected-ok');
+
+      expect(callLog).toContain('unprotectedRoute');
+    });
+
+    it('rejects the protected route while maintenance mode is on, before the handler body runs', async () => {
+      maintenanceModeService.enable();
+
+      const res = await request(app.getHttpServer()).get('/protected');
+
+      expect(res.status).toBe(503);
+      expect(callLog).not.toContain('protectedRoute');
+    });
+
+    it('allows the protected route again once maintenance mode is toggled off (no restart)', async () => {
+      maintenanceModeService.enable();
+      await request(app.getHttpServer()).get('/protected').expect(503);
+      expect(callLog).not.toContain('protectedRoute');
+
+      maintenanceModeService.disable();
+      await request(app.getHttpServer())
+        .get('/protected')
+        .expect(200)
+        .expect('protected-ok');
+      expect(callLog).toContain('protectedRoute');
+    });
+  });
+
+  describe('WebSocket gateway', () => {
+    it('blocks a maintenance-protected message handler while an unprotected handler on the same gateway keeps working', async () => {
+      maintenanceModeService.enable();
+
+      const unprotectedReply = new Promise<void>(resolve =>
+        ws.once('unprotectedReply', () => resolve()),
+      );
+
+      ws.emit('protectedMessage', { hello: 'protected' });
+      ws.emit('unprotectedMessage', { hello: 'unprotected' });
+
+      // Proves the socket connection and the unrelated handler both keep
+      // working normally while maintenance mode is on.
+      await unprotectedReply;
+
+      expect(callLog).toContain('onUnprotectedMessage');
+      expect(callLog).not.toContain('onProtectedMessage');
+    });
+
+    it('allows the maintenance-protected message handler again once maintenance mode is toggled off (no restart)', async () => {
+      maintenanceModeService.disable();
+
+      const protectedReply = new Promise<void>(resolve =>
+        ws.once('protectedReply', () => resolve()),
+      );
+      ws.emit('protectedMessage', { hello: 'protected' });
+
+      await protectedReply;
+
+      expect(callLog).toContain('onProtectedMessage');
+    });
+  });
+});
