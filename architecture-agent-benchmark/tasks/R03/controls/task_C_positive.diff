+/**
+ * Test-only call tracker. Handler bodies push their name here so e2e tests
+ * can assert "handler body executed / did not execute" without spying on
+ * the controller/gateway prototype (which would strip the Reflect metadata
+ * that decorators like `@Get`/`@SubscribeMessage`/`@MaintenanceProtected`
+ * attach to the original function object, breaking route/pattern
+ * registration).
+ */
+export const callLog: string[] = [];
+
+export function resetCallLog(): void {
+  callLog.length = 0;
+}
