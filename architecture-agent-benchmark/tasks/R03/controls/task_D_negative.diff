+import { INestApplication } from '@nestjs/common';
+import { randomUUID } from 'node:crypto';
+
+/**
+ * TRAP / NEGATIVE CONTROL: registers a plain Express middleware directly
+ * against the underlying Express instance (obtained via
+ * `app.getHttpAdapter().getInstance()`), and sets the response header by
+ * calling `res.setHeader(...)` on the raw Node/Express response object.
+ *
+ * This "just works" when the app happens to be bootstrapped with the
+ * (default) ExpressAdapter, and a naive functional test that only ever
+ * boots the app that way will go green. It silently does nothing useful
+ * (or throws) when the very same application module is bootstrapped with
+ * FastifyAdapter instead, because:
+ *   - `getInstance()` returns the Fastify instance, not an Express app, so
+ *     `.use((req, res, next) => ...)` registers an Express-style
+ *     3-arg middleware against Fastify's (optional, differently-shaped)
+ *     middleware support -- not equivalent at all.
+ *   - Fastify's `reply` object does not expose `.setHeader` the same way
+ *     Node's `http.ServerResponse`/Express response does.
+ */
+export function setupRequestIdMiddleware(app: INestApplication): void {
+  const expressApp = app.getHttpAdapter().getInstance();
+
+  expressApp.use((req: any, res: any, next: any) => {
+    const incoming = req.headers['x-request-id'];
+    const id = incoming || randomUUID();
+    req.requestId = id;
+    res.setHeader('X-Request-Id', id);
+    next();
+  });
+}
