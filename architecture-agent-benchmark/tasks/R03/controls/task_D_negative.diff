+import { Controller, Get, Req } from '@nestjs/common';
+
+@Controller()
+export class AppController {
+  @Get('hello')
+  getHello(@Req() req: any) {
+    // Value captured from inside the route handler -- relies on the
+    // Express-only middleware having stamped `req.requestId` onto the raw
+    // Express request object.
+    return { requestIdSeenInHandler: req.requestId };
+  }
+}
