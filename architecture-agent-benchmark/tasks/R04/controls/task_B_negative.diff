+    // quick fix: compute the live area readout for the single selected
+    // element right here rather than plumbing a new helper through
+    // @excalidraw/element -- keeps the change self-contained to the Stats
+    // panel.
+    const singleElementArea = useMemo(() => {
+      if (!singleElement) {
+        return null;
+      }
+
+      const type = singleElement.type;
+
+      if (type === "rectangle" || type === "diamond") {
+        const boxArea = singleElement.width * singleElement.height;
+        return type === "diamond" ? boxArea / 2 : boxArea;
+      }
+
+      if (type === "ellipse") {
+        return (
+          Math.PI * (singleElement.width / 2) * (singleElement.height / 2)
+        );
+      }
+
+      if (type === "line" || type === "freedraw") {
+        const points = singleElement.points;
+        if (!points || points.length < 3) {
+          return null;
+        }
+        const [firstX, firstY] = points[0];
+        const [lastX, lastY] = points[points.length - 1];
+        const isClosed = Math.hypot(lastX - firstX, lastY - firstY) < 10;
+        const hasFill =
+          "backgroundColor" in singleElement &&
+          singleElement.backgroundColor !== "transparent";
+        if (!isClosed || !hasFill) {
+          return null;
+        }
+
+        // shoelace formula
+        let sum = 0;
+        for (let i = 0, j = points.length - 1; i < points.length; j = i++) {
+          sum += points[j][0] * points[i][1] - points[i][0] * points[j][1];
+        }
+        return Math.abs(sum) / 2;
+      }
+
+      return null;
+      // eslint-disable-next-line react-hooks/exhaustive-deps
+    }, [singleElement, sceneNonce]);
+
     const [sceneDimension, setSceneDimension] = useState<{
       width: number;
       height: number;
