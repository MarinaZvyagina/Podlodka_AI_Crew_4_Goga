+// trimLabelValues strips leading/trailing whitespace from the values of labels whose names
+// are listed in trimLabels. This runs as a post-processing step after relabel_configs have
+// been applied, so it works regardless of which relabeling rules produced the label value.
+func trimLabelValues(labels []prompb.Label, trimLabels []string) {
+	if len(trimLabels) == 0 {
+		return
+	}
+	for i := range labels {
+		label := &labels[i]
+		for _, name := range trimLabels {
+			if label.Name == name {
+				label.Value = strings.TrimSpace(label.Value)
+				break
+			}
+		}
+	}
+}
