diff --git a/lib/promscrape/discovery/kubernetes/kubernetes.go b/lib/promscrape/discovery/kubernetes/kubernetes.go
index 98b96a1..3cf0dec 100644
--- a/lib/promscrape/discovery/kubernetes/kubernetes.go
+++ b/lib/promscrape/discovery/kubernetes/kubernetes.go
@@ -3,6 +3,7 @@ package kubernetes
 import (
 	"flag"
 	"fmt"
+	"sync"
 	"time"
 
 	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
@@ -15,6 +16,30 @@ var SDCheckInterval = flag.Duration("promscrape.kubernetesSDCheckInterval", 30*t
 	"This works only if kubernetes_sd_configs is configured in '-promscrape.config' file. "+
 	"See https://docs.victoriametrics.com/victoriametrics/sd_configs/#kubernetes_sd_configs for details")
 
+// maxTargetsPerJob caps the number of scrape targets a single kubernetes_sd_configs entry
+// (api_server + role combination) is allowed to return. NOTE: this is a NEGATIVE CONTROL /
+// intentionally-flawed implementation for benchmark purposes: the cap is self-contained inside
+// the kubernetes discovery backend only, and every other *_sd_configs backend remains unbounded.
+var maxTargetsPerJob = flag.Int("promscrape.kubernetesSD.maxTargetsPerJob", 0, "The maximum number of scrape targets a single kubernetes_sd_configs entry is allowed to return. "+
+	"Zero (default) disables the limit. See /api/v1/limited_jobs for the list of kubernetes_sd_configs entries which hit the limit")
+
+var (
+	limitedTargetsMu sync.Mutex
+	limitedTargets   = make(map[string]int)
+)
+
+// LimitedTargetsSnapshot returns a snapshot of api_server+role combinations which hit
+// -promscrape.kubernetesSD.maxTargetsPerJob, together with the number of excluded targets.
+func LimitedTargetsSnapshot() map[string]int {
+	limitedTargetsMu.Lock()
+	defer limitedTargetsMu.Unlock()
+	m := make(map[string]int, len(limitedTargets))
+	for k, v := range limitedTargets {
+		m[k] = v
+	}
+	return m
+}
+
 // SDConfig represents kubernetes-based service discovery config.
 //
 // See https://prometheus.io/docs/prometheus/latest/configuration/configuration/#kubernetes_sd_config
@@ -80,7 +105,21 @@ func (sdc *SDConfig) GetScrapeWorkObjects() ([]any, error) {
 	if sdc.cfg == nil {
 		return nil, sdc.startErr
 	}
-	return sdc.cfg.aw.getScrapeWorkObjects(), nil
+	swos := sdc.cfg.aw.getScrapeWorkObjects()
+	limit := *maxTargetsPerJob
+	key := fmt.Sprintf("%s/%s", sdc.APIServer, sdc.role())
+	if limit > 0 && len(swos) > limit {
+		dropped := len(swos) - limit
+		limitedTargetsMu.Lock()
+		limitedTargets[key] = dropped
+		limitedTargetsMu.Unlock()
+		swos = swos[:limit]
+	} else {
+		limitedTargetsMu.Lock()
+		delete(limitedTargets, key)
+		limitedTargetsMu.Unlock()
+	}
+	return swos, nil
 }
 
