diff --git a/lib/promscrape/discovery/kubernetes/kubernetes_maxtargets_test.go b/lib/promscrape/discovery/kubernetes/kubernetes_maxtargets_test.go
new file mode 100644
index 0000000..2f092e7
--- /dev/null
+++ b/lib/promscrape/discovery/kubernetes/kubernetes_maxtargets_test.go
@@ -0,0 +1,85 @@
+package kubernetes
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/VictoriaMetrics/metrics"
+)
+
+// newSDConfigWithFakeTargets builds an *SDConfig backed by an apiWatcher pre-seeded with n fake
+// ScrapeWork-like objects, bypassing the real Kubernetes API watcher machinery. This is enough to
+// exercise (*SDConfig).GetScrapeWorkObjects() and its -promscrape.kubernetesSD.maxTargetsPerJob
+// truncation without spinning up a fake API server.
+func newSDConfigWithFakeTargets(t *testing.T, apiServer string, n int) *SDConfig {
+	t.Helper()
+	sdc := &SDConfig{
+		APIServer: apiServer,
+		Role:      "pod",
+	}
+	aw := &apiWatcher{
+		role:             sdc.role(),
+		gw:               &groupWatcher{m: make(map[string]*urlWatcher)},
+		swosByURLWatcher: make(map[*urlWatcher]map[string][]any),
+		swosCount:        metrics.GetOrCreateCounter(fmt.Sprintf(`test_kubernetes_swos_count{name=%q}`, t.Name())),
+	}
+	uw := &urlWatcher{}
+	swosByKey := make(map[string][]any, n)
+	for i := 0; i < n; i++ {
+		swosByKey[fmt.Sprintf("key-%d", i)] = []any{fmt.Sprintf("target-%d", i)}
+	}
+	aw.swosByURLWatcher[uw] = swosByKey
+	sdc.cfg = &apiConfig{aw: aw}
+	return sdc
+}
+
+// TestKubernetesSDMaxTargetsPerJob is a Kubernetes-only functional test for the (intentionally
+// backend-local, see negative control notes in metadata_B.yaml) -promscrape.kubernetesSD.maxTargetsPerJob
+// cap: it covers a discovery round under the limit (unaffected), over the limit (truncated, and
+// visible via kubernetes.LimitedTargetsSnapshot), and the default/unlimited behavior.
+func TestKubernetesSDMaxTargetsPerJob(t *testing.T) {
+	defaultLimit := *maxTargetsPerJob
+	defer func() { *maxTargetsPerJob = defaultLimit }()
+
+	t.Run("default is unlimited", func(t *testing.T) {
+		*maxTargetsPerJob = 0
+		sdc := newSDConfigWithFakeTargets(t, "http://fake-api-server-1", 10)
+		swos, err := sdc.GetScrapeWorkObjects()
+		if err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if len(swos) != 10 {
+			t.Fatalf("unexpected number of targets; got %d; want 10", len(swos))
+		}
+	})
+
+	t.Run("under the limit is unaffected", func(t *testing.T) {
+		*maxTargetsPerJob = 10
+		sdc := newSDConfigWithFakeTargets(t, "http://fake-api-server-2", 5)
+		swos, err := sdc.GetScrapeWorkObjects()
+		if err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if len(swos) != 5 {
+			t.Fatalf("unexpected number of targets; got %d; want 5", len(swos))
+		}
+	})
+
+	t.Run("over the limit is truncated and visible via LimitedTargetsSnapshot", func(t *testing.T) {
+		*maxTargetsPerJob = 3
+		apiServer := "http://fake-api-server-3"
+		sdc := newSDConfigWithFakeTargets(t, apiServer, 10)
+		swos, err := sdc.GetScrapeWorkObjects()
+		if err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if len(swos) != 3 {
+			t.Fatalf("unexpected number of targets; got %d; want 3", len(swos))
+		}
+		snapshot := LimitedTargetsSnapshot()
+		key := fmt.Sprintf("%s/%s", apiServer, sdc.role())
+		if dropped, ok := snapshot[key]; !ok || dropped != 7 {
+			t.Fatalf("unexpected LimitedTargetsSnapshot()[%q]; got %d (present=%v); want 7", key, dropped, ok)
+		}
+	})
+}
