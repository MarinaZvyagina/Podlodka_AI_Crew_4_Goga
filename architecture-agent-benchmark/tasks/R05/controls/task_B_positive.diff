+// truncateScrapeWorkForJob truncates dst[startIdx:] down to swc.maxTargetsPerJob entries, if the limit is set
+// (i.e. greater than zero) and exceeded. The truncated targets are registered in droppedTargetsMap, so they
+// remain visible to operators via the existing target-status reporting mechanism (see targetstatus.go), namely
+// at /targets, /service-discovery and /api/v1/targets.
+//
+// This is the single, shared enforcement point for the per-job target cap: it is called for every service
+// discovery mechanism (see getScrapeWorkGeneric above and getStaticScrapeWork below), instead of being
+// duplicated inside each lib/promscrape/discovery/<name> package.
+func truncateScrapeWorkForJob(dst []*ScrapeWork, startIdx int, swc *scrapeWorkConfig) []*ScrapeWork {
+	limit := swc.maxTargetsPerJob
+	if limit <= 0 {
+		// The limit is disabled (default) - do not touch dst.
+		return dst
+	}
+	jobTargets := dst[startIdx:]
+	if len(jobTargets) <= limit {
+		return dst
+	}
+	dropped := jobTargets[limit:]
+	for _, sw := range dropped {
+		droppedTargetsMap.Register(sw.OriginalLabels, swc.relabelConfigs, targetDropReasonPerJobLimit, nil)
+	}
+	logger.Warnf("job_name=%q discovered %d targets, which exceeds -promscrape.maxTargetsPerJob=%d (or its per-job max_targets_per_job override); "+
+		"scraping only the first %d targets, while dropping the remaining %d targets; "+
+		"see the dropped targets with reason \"target limit\" at /targets and /api/v1/targets pages",
+		swc.jobName, len(jobTargets), limit, limit, len(dropped))
+	return dst[:startIdx+limit]
+}
