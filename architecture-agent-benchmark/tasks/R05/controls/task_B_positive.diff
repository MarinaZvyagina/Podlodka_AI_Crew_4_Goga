+// getTargetsCountByJobForReason returns a map from job name to the number of dropped targets
+// registered with the given reason. It is used for surfacing per-job counts (e.g. how many targets
+// were dropped because of -promscrape.maxTargetsPerJob) at /targets and /api/v1/targets.
+func (dt *droppedTargets) getTargetsCountByJobForReason(reason targetDropReason) map[string]int {
+	dt.mu.Lock()
+	defer dt.mu.Unlock()
+	m := make(map[string]int)
+	for _, v := range dt.m {
+		if v.dropReason != reason || v.originalLabels == nil {
+			continue
+		}
+		m[v.originalLabels.getJob()]++
+	}
+	return m
+}
