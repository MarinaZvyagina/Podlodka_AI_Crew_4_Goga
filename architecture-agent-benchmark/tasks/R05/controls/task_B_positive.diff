+// resetDroppedTargetsMap clears the global droppedTargetsMap, so tests relying on its contents
+// do not observe leftovers registered by other tests running earlier in the same process.
+func resetDroppedTargetsMap(t *testing.T) {
+	t.Helper()
+	droppedTargetsMap.mu.Lock()
+	droppedTargetsMap.m = make(map[uint64]droppedTarget)
+	droppedTargetsMap.totalTargets = 0
+	droppedTargetsMap.mu.Unlock()
+}
+
+// TestMaxTargetsPerJob covers the -promscrape.maxTargetsPerJob cap (and its per-job
+// max_targets_per_job override): a job under the limit must be unaffected, a job over the limit
+// must be truncated and the excluded targets must become visible as dropped targets, and the
+// default (zero / unlimited) behavior must not change anything.
+func TestMaxTargetsPerJob(t *testing.T) {
+	genStaticConfigData := func(jobName string, maxTargetsPerJob string, n int) string {
+		var sb strings.Builder
+		fmt.Fprintf(&sb, "scrape_configs:\n- job_name: %s\n", jobName)
+		if maxTargetsPerJob != "" {
+			fmt.Fprintf(&sb, "  max_targets_per_job: %s\n", maxTargetsPerJob)
+		}
+		sb.WriteString("  static_configs:\n  - targets:\n")
+		for i := 0; i < n; i++ {
+			fmt.Fprintf(&sb, "    - target-%d:8080\n", i)
+		}
+		return sb.String()
+	}
+
+	loadAndGetStaticScrapeWork := func(t *testing.T, data string) []*ScrapeWork {
+		t.Helper()
+		var cfg Config
+		if err := cfg.parseData([]byte(data), "test-max-targets-per-job"); err != nil {
+			t.Fatalf("cannot parse data: %s", err)
+		}
+		return cfg.getStaticScrapeWork()
+	}
+
+	t.Run("default is unlimited", func(t *testing.T) {
+		resetDroppedTargetsMap(t)
+		data := genStaticConfigData("job-default", "", 10)
+		sws := loadAndGetStaticScrapeWork(t, data)
+		if len(sws) != 10 {
+			t.Fatalf("unexpected number of scrape works; got %d; want %d", len(sws), 10)
+		}
+		if n := droppedTargetsMap.getTotalTargets(); n != 0 {
+			t.Fatalf("unexpected number of dropped targets; got %d; want 0", n)
+		}
+	})
+
+	t.Run("job under the limit is unaffected", func(t *testing.T) {
+		resetDroppedTargetsMap(t)
+		data := genStaticConfigData("job-under-limit", "10", 5)
+		sws := loadAndGetStaticScrapeWork(t, data)
+		if len(sws) != 5 {
+			t.Fatalf("unexpected number of scrape works; got %d; want %d", len(sws), 5)
+		}
+		if n := droppedTargetsMap.getTotalTargets(); n != 0 {
+			t.Fatalf("unexpected number of dropped targets; got %d; want 0", n)
+		}
+	})
+
+	t.Run("job over the limit is truncated and visible in status", func(t *testing.T) {
+		resetDroppedTargetsMap(t)
+		data := genStaticConfigData("job-over-limit", "3", 10)
+		sws := loadAndGetStaticScrapeWork(t, data)
+		if len(sws) != 3 {
+			t.Fatalf("unexpected number of scrape works; got %d; want %d", len(sws), 3)
+		}
+		if n := droppedTargetsMap.getTotalTargets(); n != 7 {
+			t.Fatalf("unexpected number of dropped targets; got %d; want 7", n)
+		}
+		limitedByJob := droppedTargetsMap.getTargetsCountByJobForReason(targetDropReasonPerJobLimit)
+		if n := limitedByJob["job-over-limit"]; n != 7 {
+			t.Fatalf("unexpected number of targets dropped because of the per-job limit; got %d; want 7", n)
+		}
+		// Verify that the dropped targets are indeed visible via the existing status reporting mechanism.
+		tsr := tsmGlobal.getTargetsStatusByJob(&requestFilter{})
+		if len(tsr.droppedTargets) != 7 {
+			t.Fatalf("unexpected number of droppedTargets in targetsStatusResult; got %d; want 7", len(tsr.droppedTargets))
+		}
+		for _, dt := range tsr.droppedTargets {
+			if dt.dropReason != targetDropReasonPerJobLimit {
+				t.Fatalf("unexpected dropReason; got %q; want %q", dt.dropReason, targetDropReasonPerJobLimit)
+			}
+		}
+	})
+
+	t.Run("global flag applies when no per-job override is set", func(t *testing.T) {
+		resetDroppedTargetsMap(t)
+		defaultMaxTargetsPerJob := *maxTargetsPerJob
+		*maxTargetsPerJob = 2
+		defer func() { *maxTargetsPerJob = defaultMaxTargetsPerJob }()
+
+		data := genStaticConfigData("job-global-limit", "", 5)
+		sws := loadAndGetStaticScrapeWork(t, data)
+		if len(sws) != 2 {
+			t.Fatalf("unexpected number of scrape works; got %d; want %d", len(sws), 2)
+		}
+		if n := droppedTargetsMap.getTotalTargets(); n != 3 {
+			t.Fatalf("unexpected number of dropped targets; got %d; want 3", n)
+		}
+	})
+
+	t.Run("per-job override wins over the global flag", func(t *testing.T) {
+		resetDroppedTargetsMap(t)
+		defaultMaxTargetsPerJob := *maxTargetsPerJob
+		*maxTargetsPerJob = 1
+		defer func() { *maxTargetsPerJob = defaultMaxTargetsPerJob }()
+
+		data := genStaticConfigData("job-override-limit", "4", 5)
+		sws := loadAndGetStaticScrapeWork(t, data)
+		if len(sws) != 4 {
+			t.Fatalf("unexpected number of scrape works; got %d; want %d", len(sws), 4)
+		}
+	})
+}
