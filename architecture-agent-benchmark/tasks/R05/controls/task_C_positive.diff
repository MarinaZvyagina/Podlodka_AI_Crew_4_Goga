@@ -0,0 +1,78 @@
+package scaleway
+
+import (
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+)
+
+// TestSDConfigGetLabels_Success verifies the full SDConfig.GetLabels() flow against a
+// fake HTTP server (never contacts the real Scaleway API), including that the
+// configured bearer token is sent as an Authorization header and that the response
+// is turned into the expected target labels.
+func TestSDConfigGetLabels_Success(t *testing.T) {
+	s := newMockScalewayServer(func(r *http.Request) []byte {
+		if !strings.HasSuffix(r.URL.Path, "/instance/v1/zones/fr-par-1/servers") {
+			t.Fatalf("unexpected request path: %s", r.URL.Path)
+		}
+		return []byte(`{
+  "servers": [
+    {
+      "id": "id-1",
+      "name": "web-1",
+      "commercial_type": "DEV1-S",
+      "state": "running",
+      "zone": "fr-par-1",
+      "tags": ["prod"],
+      "public_ip": {"address": "51.15.0.1"},
+      "private_ip": "10.0.0.1"
+    }
+  ]
+}`)
+	})
+	defer s.Close()
+
+	token := "fake-secret-token"
+	sdc := &SDConfig{
+		Server: s.URL,
+		HTTPClientConfig: promauth.HTTPClientConfig{
+			BearerToken: &promauth.Secret{S: token},
+		},
+	}
+
+	labelss, err := sdc.GetLabels(".")
+	if err != nil {
+		t.Fatalf("unexpected GetLabels() error: %s", err)
+	}
+	defer sdc.MustStop()
+
+	if s.lastAuthToken != "Bearer "+token {
+		t.Fatalf("unexpected Authorization header sent to Scaleway API; got %q", s.lastAuthToken)
+	}
+	if len(labelss) != 1 {
+		t.Fatalf("unexpected number of discovered targets; got %d; want 1", len(labelss))
+	}
+	m := labelss[0]
+	if v := m.Get("__address__"); v != "51.15.0.1:80" {
+		t.Fatalf("unexpected __address__; got %q", v)
+	}
+	if v := m.Get("__meta_scaleway_instance_name"); v != "web-1" {
+		t.Fatalf("unexpected __meta_scaleway_instance_name; got %q", v)
+	}
+	if v := m.Get("__meta_scaleway_instance_zone"); v != "fr-par-1" {
+		t.Fatalf("unexpected __meta_scaleway_instance_zone; got %q", v)
+	}
+}
+
+// TestSDConfigGetLabels_MissingToken verifies that GetLabels() fails fast when no
+// API token is configured, instead of silently making an unauthenticated request.
+func TestSDConfigGetLabels_MissingToken(t *testing.T) {
+	sdc := &SDConfig{
+		Server: "http://127.0.0.1:1",
+	}
+	if _, err := sdc.GetLabels("."); err == nil {
+		t.Fatalf("expected an error when no auth token is configured, got nil")
+	}
+}
