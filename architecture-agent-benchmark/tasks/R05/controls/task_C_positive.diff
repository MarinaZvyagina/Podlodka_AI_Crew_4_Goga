index 0000000..9e8b0b1
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api_test.go
@@ -0,0 +1,99 @@
+package scaleway
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestParseAPIResponse(t *testing.T) {
+	f := func(data string, responseExpected *listServersResponse) {
+		t.Helper()
+
+		resp, err := parseAPIResponse([]byte(data))
+		if err != nil {
+			t.Fatalf("unexpected parseAPIResponse() error: %s", err)
+		}
+		if !reflect.DeepEqual(resp, responseExpected) {
+			t.Fatalf("unexpected response\ngot\n%v\nwant\n%v", resp, responseExpected)
+		}
+	}
+
+	data := `
+{
+  "servers": [
+    {
+      "id": "11111111-1111-1111-1111-111111111111",
+      "name": "web-1",
+      "commercial_type": "DEV1-S",
+      "state": "running",
+      "zone": "fr-par-1",
+      "tags": ["prod", "web"],
+      "public_ip": {"address": "51.15.0.1"},
+      "private_ip": "10.0.0.1"
+    }
+  ]
+}`
+
+	responseExpected := &listServersResponse{
+		Servers: []server{
+			{
+				ID:             "11111111-1111-1111-1111-111111111111",
+				Name:           "web-1",
+				CommercialType: "DEV1-S",
+				State:          "running",
+				Zone:           "fr-par-1",
+				Tags:           []string{"prod", "web"},
+				PublicIP:       &serverIP{Address: "51.15.0.1"},
+				PrivateIP:      strPtr("10.0.0.1"),
+			},
+		},
+	}
+	f(data, responseExpected)
+}
+
+func strPtr(s string) *string {
+	return &s
+}
+
+func TestGetServers(t *testing.T) {
+	f := func(getAPIResponse func(string) ([]byte, error), zone string, expectedCount int) {
+		t.Helper()
+
+		servers, err := getServers(getAPIResponse, zone)
+		if err != nil {
+			t.Fatalf("getServers() error: %s", err)
+		}
+		if len(servers) != expectedCount {
+			t.Fatalf("unexpected servers count; got %d; want %d\nservers:\n%v", len(servers), expectedCount, servers)
+		}
+	}
+
+	getAPIResponse := func(path string) ([]byte, error) {
+		if path != serversAPIPath("fr-par-1") {
+			t.Fatalf("unexpected api path requested: %s", path)
+		}
+		return []byte(`{
+  "servers": [
+    {
+      "id": "id-1",
+      "name": "web-1",
+      "commercial_type": "DEV1-S",
+      "state": "running",
+      "zone": "fr-par-1",
+      "tags": ["prod"],
+      "public_ip": {"address": "51.15.0.1"},
+      "private_ip": "10.0.0.1"
+    },
+    {
+      "id": "id-2",
+      "name": "web-2",
+      "commercial_type": "DEV1-S",
+      "state": "running",
+      "zone": "fr-par-1",
+      "private_ip": "10.0.0.2"
+    }
+  ]
+}`), nil
+	}
+	f(getAPIResponse, "fr-par-1", 2)
+}
diff --git a/lib/promscrape/discovery/scaleway/mock_server_test.go b/lib/promscrape/discovery/scaleway/mock_server_test.go
new file mode 100644
index 0000000..6b47792
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/mock_server_test.go
@@ -0,0 +1,27 @@
+package scaleway
+
+import (
+	"net/http"
+	"net/http/httptest"
+)
+
+// mockScalewayServer is a fake Scaleway Instances API server used by tests so that
+// unit tests never need to hit the real Scaleway API.
+type mockScalewayServer struct {
+	*httptest.Server
+	responseFunc  func(r *http.Request) []byte
+	lastAuthToken string
+}
+
+func newMockScalewayServer(responseFunc func(r *http.Request) []byte) *mockScalewayServer {
+	var s mockScalewayServer
+	s.responseFunc = responseFunc
+	s.Server = httptest.NewServer(http.HandlerFunc(s.handler))
+	return &s
+}
+
+func (s *mockScalewayServer) handler(w http.ResponseWriter, r *http.Request) {
+	s.lastAuthToken = r.Header.Get("Authorization")
+	data := s.responseFunc(r)
+	w.Write(data)
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway.go b/lib/promscrape/discovery/scaleway/scaleway.go
new file mode 100644
index 0000000..2f67d1c
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway.go
@@ -0,0 +1,123 @@
+package scaleway
+
+import (
+	"flag"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/proxy"
+)
+
+// SDCheckInterval defines interval for targets refresh.
+var SDCheckInterval = flag.Duration("promscrape.scalewaySDCheckInterval", time.Minute, "Interval for checking for changes in Scaleway. "+
+	"This works only if scaleway_sd_configs is configured in '-promscrape.config' file. "+
+	"See https://docs.victoriametrics.com/victoriametrics/sd_configs/#scaleway_sd_configs for details")
+
+// SDConfig represents service discovery config for Scaleway Instances.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type SDConfig struct {
+	// Server is an optional Scaleway API server to query.
+	// By default, https://api.scaleway.com is used.
+	Server string `yaml:"server,omitempty"`
+
+	// Zone is the Scaleway availability zone to list instances from, e.g. fr-par-1.
+	// By default, fr-par-1 is used.
+	Zone string `yaml:"zone,omitempty"`
+
+	HTTPClientConfig  promauth.HTTPClientConfig  `yaml:",inline"`
+	ProxyURL          *proxy.URL                 `yaml:"proxy_url,omitempty"`
+	ProxyClientConfig promauth.ProxyClientConfig `yaml:",inline"`
+
+	// Port is an optional port to scrape metrics from. By default, port 80 is used.
+	Port int `yaml:"port,omitempty"`
+}
+
+// GetLabels returns Scaleway instance labels according to sdc.
+func (sdc *SDConfig) GetLabels(baseDir string) ([]*promutil.Labels, error) {
+	cfg, err := getAPIConfig(sdc, baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot get API config: %w", err)
+	}
+	servers, err := getServers(cfg.client.GetAPIResponse, cfg.zone)
+	if err != nil {
+		return nil, err
+	}
+	return addServerLabels(servers, cfg.port), nil
+}
+
+// MustStop stops further usage for sdc.
+func (sdc *SDConfig) MustStop() {
+	v := configMap.Delete(sdc)
+	if v != nil {
+		cfg := v.(*apiConfig)
+		cfg.client.Stop()
+	}
+}
+
+// https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type server struct {
+	ID             string    `json:"id"`
+	Name           string    `json:"name"`
+	CommercialType string    `json:"commercial_type"`
+	State          string    `json:"state"`
+	Zone           string    `json:"zone"`
+	Tags           []string  `json:"tags"`
+	PublicIP       *serverIP `json:"public_ip"`
+	PrivateIP      *string   `json:"private_ip"`
+}
+
+type serverIP struct {
+	Address string `json:"address"`
+}
+
+func (s *server) publicIPv4() string {
+	if s.PublicIP == nil {
+		return ""
+	}
+	return s.PublicIP.Address
+}
+
+func (s *server) privateIPv4() string {
+	if s.PrivateIP == nil {
+		return ""
+	}
+	return *s.PrivateIP
+}
+
+func addServerLabels(servers []server, defaultPort int) []*promutil.Labels {
+	var ms []*promutil.Labels
+	for _, s := range servers {
+		publicIPv4 := s.publicIPv4()
+		privateIPv4 := s.privateIPv4()
+
+		addr := publicIPv4
+		if addr == "" {
+			addr = privateIPv4
+		}
+		if addr == "" {
+			// Skip instances without any usable IP address.
+			continue
+		}
+
+		m := promutil.NewLabels(16)
+		m.Add("__address__", discoveryutil.JoinHostPort(addr, defaultPort))
+		m.Add("__meta_scaleway_instance_id", s.ID)
+		m.Add("__meta_scaleway_instance_name", s.Name)
+		m.Add("__meta_scaleway_instance_type", s.CommercialType)
+		m.Add("__meta_scaleway_instance_state", s.State)
+		m.Add("__meta_scaleway_instance_zone", s.Zone)
+		m.Add("__meta_scaleway_public_ipv4", publicIPv4)
+		m.Add("__meta_scaleway_private_ipv4", privateIPv4)
+		if len(s.Tags) > 0 {
+			tags := fmt.Sprintf(",%s,", strings.Join(s.Tags, ","))
+			m.Add("__meta_scaleway_instance_tags", tags)
+		}
+		ms = append(ms, m)
+	}
+	return ms
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway_e2e_test.go b/lib/promscrape/discovery/scaleway/scaleway_e2e_test.go
