+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func TestAddServerLabels(t *testing.T) {
+	f := func(servers []server, port int, labelssExpected []*promutil.Labels) {
+		t.Helper()
+
+		labelss := addServerLabels(servers, port)
+		discoveryutil.TestEqualLabelss(t, labelss, labelssExpected)
+	}
+
+	// server with public and private IPv4, tags
+	servers := []server{
+		{
+			ID:             "id-1",
+			Name:           "web-1",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Zone:           "fr-par-1",
+			Tags:           []string{"prod", "web"},
+			PublicIP:       &serverIP{Address: "51.15.0.1"},
+			PrivateIP:      strPtr("10.0.0.1"),
+		},
+	}
+	labelssExpected := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                    "51.15.0.1:9100",
+			"__meta_scaleway_instance_id":    "id-1",
+			"__meta_scaleway_instance_name":  "web-1",
+			"__meta_scaleway_instance_type":  "DEV1-S",
+			"__meta_scaleway_instance_state": "running",
+			"__meta_scaleway_instance_zone":  "fr-par-1",
+			"__meta_scaleway_public_ipv4":    "51.15.0.1",
+			"__meta_scaleway_private_ipv4":   "10.0.0.1",
+			"__meta_scaleway_instance_tags":  ",prod,web,",
+		}),
+	}
+	f(servers, 9100, labelssExpected)
+
+	// server with only a private IPv4 and no tags falls back to private IP for __address__
+	servers = []server{
+		{
+			ID:             "id-2",
+			Name:           "internal-1",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Zone:           "fr-par-1",
+			PrivateIP:      strPtr("10.0.0.2"),
+		},
+	}
+	labelssExpected = []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                    "10.0.0.2:80",
+			"__meta_scaleway_instance_id":    "id-2",
+			"__meta_scaleway_instance_name":  "internal-1",
+			"__meta_scaleway_instance_type":  "DEV1-S",
+			"__meta_scaleway_instance_state": "running",
+			"__meta_scaleway_instance_zone":  "fr-par-1",
+			"__meta_scaleway_public_ipv4":    "",
+			"__meta_scaleway_private_ipv4":   "10.0.0.2",
+		}),
+	}
+	f(servers, 80, labelssExpected)
+
+	// server without any IP address is skipped entirely
+	servers = []server{
+		{
+			ID:   "id-3",
+			Name: "no-ip",
+			Zone: "fr-par-1",
+		},
+	}
+	f(servers, 80, nil)
+}
