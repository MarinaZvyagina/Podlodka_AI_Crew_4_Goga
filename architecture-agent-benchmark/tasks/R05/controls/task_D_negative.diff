+// droppedSeriesEntry is a metric name paired with its drop count, used by
+// GetTopDroppedSeriesByName.
+type droppedSeriesEntry struct {
+	MetricName string
+	DropCount  uint64
+}
+
+// GetTopDroppedSeriesByName returns up to limit metric names with the
+// highest counts of samples dropped due to -storage.maxHourlySeries or
+// -storage.maxDailySeries, sorted by drop count descending.
+func (s *Storage) GetTopDroppedSeriesByName(limit int) []droppedSeriesEntry {
+	s.droppedSeriesByNameLock.Lock()
+	entries := make([]droppedSeriesEntry, 0, len(s.droppedSeriesByName))
+	for name, count := range s.droppedSeriesByName {
+		entries = append(entries, droppedSeriesEntry{MetricName: name, DropCount: count})
+	}
+	s.droppedSeriesByNameLock.Unlock()
+
+	sort.Slice(entries, func(i, j int) bool {
+		return entries[i].DropCount > entries[j].DropCount
+	})
+	if limit > 0 && len(entries) > limit {
+		entries = entries[:limit]
+	}
+	return entries
+}
