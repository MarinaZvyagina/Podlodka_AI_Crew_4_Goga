diff --git a/lib/storage/dropstats/tracker.go b/lib/storage/dropstats/tracker.go
new file mode 100644
index 0000000..4ab3484
--- /dev/null
+++ b/lib/storage/dropstats/tracker.go
@@ -0,0 +1,145 @@
+// Package dropstats tracks, per metric name, how many samples have been
+// dropped because ingesting them would have exceeded the configured
+// -storage.maxHourlySeries or -storage.maxDailySeries series-cardinality
+// limits.
+//
+// It follows the same isolation shape as lib/storage/metricnamestats and
+// lib/storage/metricsmetadata: a self-contained type holding its own
+// map+mutex state with a hard bound on the number of distinct metric names
+// it will track, exposing a narrow method-based API to the rest of
+// lib/storage. Storage itself only ever holds a single pointer to a
+// *Tracker; it never touches the map/mutex directly.
+package dropstats
+
+import (
+	"sort"
+	"sync"
+)
+
+// DefaultMaxTrackedNames is the default maximum number of distinct metric
+// names the tracker will hold counters for. Once this limit is reached,
+// samples dropped for metric names that aren't already being tracked are
+// folded into a single synthetic "other" bucket instead of growing the map
+// further, so memory usage stays bounded regardless of how many distinct
+// metric names hit the series limits.
+const DefaultMaxTrackedNames = 1000
+
+// otherMetricName is the bucket used for drops belonging to metric names
+// that arrived after the tracker's bound was already reached.
+const otherMetricName = "{__other_metric_names__}"
+
+// Tracker tracks per-metric-name drop counts with a bounded number of
+// distinct entries.
+//
+// Tracker is safe for concurrent use.
+type Tracker struct {
+	maxTrackedNames int
+
+	mu     sync.Mutex
+	counts map[string]uint64
+}
+
+// NewTracker creates a Tracker that tracks at most maxTrackedNames distinct
+// metric names. If maxTrackedNames <= 0, DefaultMaxTrackedNames is used.
+func NewTracker(maxTrackedNames int) *Tracker {
+	if maxTrackedNames <= 0 {
+		maxTrackedNames = DefaultMaxTrackedNames
+	}
+	return &Tracker{
+		maxTrackedNames: maxTrackedNames,
+		counts:          make(map[string]uint64),
+	}
+}
+
+// Register records a single dropped sample for the given metric name.
+//
+// It is safe to call Register with a nil Tracker (this happens when the
+// feature is disabled) - the call becomes a cheap no-op so there is no
+// measurable overhead on the ingestion hot path when tracking is off.
+func (t *Tracker) Register(metricName string) {
+	if t == nil {
+		return
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if _, ok := t.counts[metricName]; !ok {
+		// Reserve one slot in the bound for the "other" bucket itself, so
+		// that the total number of map entries never exceeds
+		// maxTrackedNames even after overflow starts.
+		effectiveMax := t.maxTrackedNames
+		if _, otherOk := t.counts[otherMetricName]; !otherOk {
+			effectiveMax--
+		}
+		if len(t.counts) >= effectiveMax {
+			// Bound reached: fold this drop into the shared "other" bucket
+			// instead of growing the map with a new entry. This keeps
+			// memory usage bounded to maxTrackedNames entries regardless of
+			// how many distinct metric names are seen.
+			t.counts[otherMetricName]++
+			return
+		}
+	}
+	t.counts[metricName]++
+}
+
+// Entry is a single (metric name, drop count) pair returned by GetTop.
+type Entry struct {
+	MetricName string
+	DropCount  uint64
+}
+
+// GetTop returns up to n metric names with the highest drop counts, sorted
+// by drop count descending (ties broken by metric name ascending for
+// determinism).
+//
+// It is safe to call GetTop with a nil Tracker - it returns nil.
+func (t *Tracker) GetTop(n int) []Entry {
+	if t == nil || n <= 0 {
+		return nil
+	}
+
+	t.mu.Lock()
+	entries := make([]Entry, 0, len(t.counts))
+	for name, count := range t.counts {
+		entries = append(entries, Entry{MetricName: name, DropCount: count})
+	}
+	t.mu.Unlock()
+
+	sort.Slice(entries, func(i, j int) bool {
+		if entries[i].DropCount != entries[j].DropCount {
+			return entries[i].DropCount > entries[j].DropCount
+		}
+		return entries[i].MetricName < entries[j].MetricName
+	})
+	if len(entries) > n {
+		entries = entries[:n]
+	}
+	return entries
+}
+
+// Len returns the current number of distinct metric names being tracked.
+// It is primarily useful for tests verifying the memory bound is respected.
+//
+// It is safe to call Len with a nil Tracker - it returns 0.
+func (t *Tracker) Len() int {
+	if t == nil {
+		return 0
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return len(t.counts)
+}
+
+// Reset clears all tracked drop counts.
+//
+// It is safe to call Reset with a nil Tracker - it is a no-op.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.counts = make(map[string]uint64)
+	t.mu.Unlock()
+}
diff --git a/lib/storage/dropstats/tracker_test.go b/lib/storage/dropstats/tracker_test.go
new file mode 100644
index 0000000..48eb24a
--- /dev/null
+++ b/lib/storage/dropstats/tracker_test.go
@@ -0,0 +1,67 @@
+package dropstats
+
+import (
+	"fmt"
+	"testing"
+)
+
+func TestTracker_RegisterAndGetTop(t *testing.T) {
+	tr := NewTracker(100)
+
+	tr.Register("metric_a")
+	tr.Register("metric_a")
+	tr.Register("metric_a")
+	tr.Register("metric_b")
+	tr.Register("metric_b")
+	tr.Register("metric_c")
+
+	top := tr.GetTop(2)
+	if len(top) != 2 {
+		t.Fatalf("expected 2 entries, got %d: %+v", len(top), top)
+	}
+	if top[0].MetricName != "metric_a" || top[0].DropCount != 3 {
+		t.Fatalf("expected metric_a with count 3 first, got %+v", top[0])
+	}
+	if top[1].MetricName != "metric_b" || top[1].DropCount != 2 {
+		t.Fatalf("expected metric_b with count 2 second, got %+v", top[1])
+	}
+}
+
+func TestTracker_MemoryBoundRespected(t *testing.T) {
+	maxNames := 50
+	tr := NewTracker(maxNames)
+
+	// Flood the tracker with far more distinct metric names than the bound.
+	for i := 0; i < 10000; i++ {
+		tr.Register(fmt.Sprintf("metric_%d", i))
+	}
+
+	if got := tr.Len(); got > maxNames {
+		t.Fatalf("tracker exceeded its memory bound: got %d tracked names, want <= %d", got, maxNames)
+	}
+}
+
+func TestTracker_NilIsSafeNoOp(t *testing.T) {
+	var tr *Tracker
+	tr.Register("whatever") // must not panic
+	if got := tr.GetTop(10); got != nil {
+		t.Fatalf("expected nil result from nil tracker, got %+v", got)
+	}
+	if got := tr.Len(); got != 0 {
+		t.Fatalf("expected 0 from nil tracker Len(), got %d", got)
+	}
+	tr.Reset() // must not panic
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(10)
+	tr.Register("m1")
+	tr.Register("m1")
+	if tr.Len() != 1 {
+		t.Fatalf("expected 1 tracked name before reset, got %d", tr.Len())
+	}
+	tr.Reset()
+	if tr.Len() != 0 {
+		t.Fatalf("expected 0 tracked names after reset, got %d", tr.Len())
+	}
+}
