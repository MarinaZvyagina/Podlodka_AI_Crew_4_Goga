+// TestStorageDropStats_TracksTopOffenders verifies that, when TrackDroppedSeries
+// is enabled, samples dropped due to -storage.maxHourlySeries are recorded per
+// metric name and are queryable via Storage.GetTopDroppedSeries, and that the
+// tracker's memory usage stays bounded even when far more distinct metric
+// names are dropped than the configured bound.
+func TestStorageDropStats_TracksTopOffenders(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const (
+		maxHourlySeries = 10
+		numRows         = 2000
+	)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	// Each row generated here uses a distinct metric name (metric_0..metric_1999),
+	// so with maxHourlySeries=10 the vast majority of these distinct names will
+	// be dropped for exceeding the limit.
+	mrs := testGenerateMetricRows(rng, numRows, minTimestamp, maxTimestamp)
+
+	opts := OpenOptions{
+		MaxHourlySeries:              maxHourlySeries,
+		TrackDroppedSeries:           true,
+		MaxTrackedDroppedSeriesNames: 100,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var gotMetrics Metrics
+	s.UpdateMetrics(&gotMetrics)
+	if gotMetrics.HourlySeriesLimitRowsDropped == 0 {
+		t.Fatalf("expected some rows to be dropped due to maxHourlySeries=%d, got HourlySeriesLimitRowsDropped=0", maxHourlySeries)
+	}
+
+	// Querying the top offenders must report a nonzero drop count for
+	// excluded metric names.
+	top := s.GetTopDroppedSeries(nil, 5)
+	if len(top) == 0 {
+		t.Fatalf("expected GetTopDroppedSeries to report at least one offending metric name, got none")
+	}
+	for _, e := range top {
+		if e.DropCount == 0 {
+			t.Fatalf("expected nonzero DropCount for tracked metric name %q, got 0", e.MetricName)
+		}
+	}
+
+	// The tracker must not grow past its configured bound even though there
+	// were ~1990 distinct dropped metric names, far more than
+	// MaxTrackedDroppedSeriesNames=100.
+	if got := s.dropTracker.Len(); got > opts.MaxTrackedDroppedSeriesNames {
+		t.Fatalf("dropTracker exceeded its configured memory bound: got %d tracked names, want <= %d", got, opts.MaxTrackedDroppedSeriesNames)
+	}
+}
+
+// TestStorageDropStats_DisabledIsNoOp verifies that when TrackDroppedSeries is
+// not enabled, the drop tracker stays nil and GetTopDroppedSeries returns no
+// results, i.e. the feature is fully off with no tracking state allocated.
+func TestStorageDropStats_DisabledIsNoOp(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const (
+		maxHourlySeries = 10
+		numRows         = 200
+	)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	mrs := testGenerateMetricRows(rng, numRows, minTimestamp, maxTimestamp)
+
+	opts := OpenOptions{
+		MaxHourlySeries: maxHourlySeries,
+		// TrackDroppedSeries intentionally left false.
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	if s.dropTracker != nil {
+		t.Fatalf("expected dropTracker to remain nil when TrackDroppedSeries is disabled")
+	}
+	if top := s.GetTopDroppedSeries(nil, 5); len(top) != 0 {
+		t.Fatalf("expected no results from GetTopDroppedSeries when tracking is disabled, got %+v", top)
+	}
+}
