+// TestLessorAttachEnforcesMaxAttachedKeys is a shallow, lease-package-only
+// unit test: it calls Attach() directly and checks that it returns
+// ErrTooManyAttachedKeys once a lease is at the configured MaxAttachedKeys,
+// while still allowing a re-attach of an already-attached key. It passes.
+//
+// NOTE: this test alone does not exercise the real request path (a raft
+// apply calling into storeTxnWrite.put(), which panics on any non-nil,
+// non-ErrLeaseNotFound error from Attach). See
+// tests/integration/v3_lease_attached_keys_limit_test.go for that.
+func TestLessorAttachEnforcesMaxAttachedKeys(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL, MaxAttachedKeys: 2})
+	defer le.Stop()
+	le.SetRangeDeleter(func() TxnDelete { return newFakeDeleter(be) })
+
+	l, err := le.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("could not grant lease (%v)", err)
+	}
+
+	if err := le.Attach(l.ID, []LeaseItem{{Key: "foo"}}); err != nil {
+		t.Fatalf("attach 1/2 should succeed, got %v", err)
+	}
+	if err := le.Attach(l.ID, []LeaseItem{{Key: "bar"}}); err != nil {
+		t.Fatalf("attach 2/2 should succeed, got %v", err)
+	}
+
+	// re-attaching an existing key must still be allowed at the limit.
+	if err := le.Attach(l.ID, []LeaseItem{{Key: "foo"}}); err != nil {
+		t.Fatalf("re-attaching an existing key must not be rejected, got %v", err)
+	}
+
+	// a genuinely new key past the limit must be rejected.
+	if err := le.Attach(l.ID, []LeaseItem{{Key: "baz"}}); !errors.Is(err, ErrTooManyAttachedKeys) {
+		t.Fatalf("expected ErrTooManyAttachedKeys, got %v", err)
+	}
+}
