@@ -0,0 +1,70 @@
+package mihon.domain.extension.interactor
+
+import io.kotest.matchers.shouldBe
+import io.mockk.coEvery
+import io.mockk.coVerify
+import io.mockk.mockk
+import kotlinx.coroutines.test.runTest
+import mihon.domain.extension.repository.ExtensionStoreRepository
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.params.ParameterizedTest
+import org.junit.jupiter.params.provider.ValueSource
+
+/**
+ * NOTE (negative control / architectural trap): in this variant, URL validation was
+ * implemented inside ExtensionStoreRepositoryImpl.insert() (data layer) instead of in
+ * AddExtensionStore (domain layer). AddExtensionStore itself is a bare pass-through, so
+ * this test emulates the expected repository behavior via mocks (as if it were the real
+ * ExtensionStoreRepositoryImpl, which the domain module cannot depend on directly) rather
+ * than asserting that repository.insert() is skipped for invalid input. User-visible
+ * behavior (Result.isFailure for bad URLs) is preserved, but note that repository.insert()
+ * IS invoked even for invalid input here - the interactor no longer short-circuits.
+ */
+class AddExtensionStoreTest {
+
+    private lateinit var repository: ExtensionStoreRepository
+    private lateinit var addExtensionStore: AddExtensionStore
+
+    @BeforeEach
+    fun beforeEach() {
+        repository = mockk()
+        addExtensionStore = AddExtensionStore(repository)
+    }
+
+    @ParameterizedTest
+    @ValueSource(
+        strings = [
+            "",
+            "not a url",
+            "javascript:alert(1)",
+            "ftp://example.com/repo",
+        ],
+    )
+    fun `When indexUrl is invalid expect failure`(indexUrl: String) = runTest {
+        // Emulates ExtensionStoreRepositoryImpl.insert()'s own validation, since that is
+        // where the check now actually lives (data layer, not reachable from domain tests).
+        coEvery { repository.insert(indexUrl) } returns Result.failure(
+            IllegalArgumentException("'$indexUrl' is not a valid repository URL"),
+        )
+
+        val result = addExtensionStore(indexUrl)
+
+        result.isFailure shouldBe true
+
+        coVerify(exactly = 1) { repository.insert(indexUrl) }
+    }
+
+    @Test
+    fun `When indexUrl is a valid http url expect repository insert to be called`() = runTest {
+        val indexUrl = "https://example.com/repo.json"
+
+        coEvery { repository.insert(indexUrl) } returns Result.success(Unit)
+
+        val result = addExtensionStore(indexUrl)
+
+        result.isSuccess shouldBe true
+
+        coVerify(exactly = 1) { repository.insert(indexUrl) }
+    }
+}
