+++ b/app/src/main/java/eu/kanade/tachiyomi/data/updates/UpdatesSnoozePreferences.kt
@@ -0,0 +1,48 @@
+package eu.kanade.tachiyomi.data.updates
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import kotlinx.serialization.decodeFromString
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import tachiyomi.core.common.preference.Preference
+import tachiyomi.core.common.preference.PreferenceStore
+
+/**
+ * "Remind me later": ad hoc, app-module-only storage mapping a manga id to the epoch-millis
+ * timestamp it is snoozed (hidden from the updates feed) until. Backed by [PreferenceStore]
+ * (SharedPreferences), entirely outside the domain/data modules and the updatesView SQL query.
+ */
+@Inject
+@SingleIn(AppScope::class)
+class UpdatesSnoozePreferences(
+    preferenceStore: PreferenceStore,
+) {
+
+    private val snoozedUntilByMangaId: Preference<Map<String, Long>> = preferenceStore.getObjectFromString(
+        key = "pref_updates_snoozed_manga",
+        defaultValue = emptyMap(),
+        serializer = { Json.encodeToString(it) },
+        deserializer = { raw ->
+            runCatching { Json.decodeFromString<Map<String, Long>>(raw) }.getOrDefault(emptyMap())
+        },
+    )
+
+    /** True while [mangaId] should be hidden from the updates feed. */
+    fun isSnoozed(mangaId: Long, now: Long = System.currentTimeMillis()): Boolean {
+        val until = snoozedUntilByMangaId.get()[mangaId.toString()] ?: return false
+        return until > now
+    }
+
+    fun snooze(mangaIds: Collection<Long>, until: Long) {
+        if (mangaIds.isEmpty()) return
+        val updated = snoozedUntilByMangaId.get() + mangaIds.associate { it.toString() to until }
+        snoozedUntilByMangaId.set(updated)
+    }
+
+    /** Clears an active snooze early. */
+    fun clear(mangaId: Long) {
+        snoozedUntilByMangaId.set(snoozedUntilByMangaId.get() - mangaId.toString())
+    }
+}
