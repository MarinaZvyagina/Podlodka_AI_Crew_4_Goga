diff --git a/app/src/test/java/eu/kanade/tachiyomi/data/updates/UpdatesSnoozePreferencesTest.kt b/app/src/test/java/eu/kanade/tachiyomi/data/updates/UpdatesSnoozePreferencesTest.kt
new file mode 100644
index 0000000..8a8fa1e
--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/data/updates/UpdatesSnoozePreferencesTest.kt
@@ -0,0 +1,58 @@
+package eu.kanade.tachiyomi.data.updates
+
+import io.kotest.matchers.shouldBe
+import org.junit.jupiter.api.Test
+import tachiyomi.core.common.preference.InMemoryPreferenceStore
+
+/**
+ * Verifies the "remind me later" snooze predicate used by UpdatesViewModel's client-side
+ * post-filter (`applyFilters` -> `filterFnSnoozed`): a manga snoozed until a future time should
+ * be reported as snoozed (and therefore hidden from the updates feed), while one whose snooze
+ * has passed - or was never set - should not be.
+ */
+class UpdatesSnoozePreferencesTest {
+
+    private val now = 10_000L
+
+    private fun preferences() = UpdatesSnoozePreferences(InMemoryPreferenceStore())
+
+    @Test
+    fun `manga snoozed until a future time is reported as snoozed`() {
+        val prefs = preferences()
+        prefs.snooze(listOf(1L), until = now + 100_000L)
+
+        prefs.isSnoozed(1L, now) shouldBe true
+    }
+
+    @Test
+    fun `manga whose snooze has passed is no longer reported as snoozed`() {
+        val prefs = preferences()
+        prefs.snooze(listOf(2L), until = now - 100_000L)
+
+        prefs.isSnoozed(2L, now) shouldBe false
+    }
+
+    @Test
+    fun `manga that was never snoozed is not reported as snoozed`() {
+        val prefs = preferences()
+
+        prefs.isSnoozed(3L, now) shouldBe false
+    }
+
+    @Test
+    fun `snoozing one manga does not affect another manga`() {
+        val prefs = preferences()
+        prefs.snooze(listOf(4L), until = now + 100_000L)
+
+        prefs.isSnoozed(5L, now) shouldBe false
+    }
+
+    @Test
+    fun `clearing an active snooze makes the manga visible again`() {
+        val prefs = preferences()
+        prefs.snooze(listOf(6L), until = now + 100_000L)
+        prefs.clear(6L)
+
+        prefs.isSnoozed(6L, now) shouldBe false
+    }
+}
