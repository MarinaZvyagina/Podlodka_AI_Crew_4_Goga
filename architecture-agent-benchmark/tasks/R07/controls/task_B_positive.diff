@@ -0,0 +1,38 @@
+package tachiyomi.domain.manga.interactor
+
+import dev.zacsweers.metro.Inject
+import tachiyomi.domain.manga.model.MangaUpdate
+import tachiyomi.domain.manga.repository.MangaRepository
+
+/**
+ * Sets or clears the "remind me later" snooze on a manga, hiding/showing it in the updates feed
+ * without affecting anything else about the manga (library membership, chapters, notifications).
+ */
+@Inject
+class SetMangaSnoozedUntil(
+    private val mangaRepository: MangaRepository,
+) {
+
+    suspend fun await(mangaId: Long, snoozedUntil: Long): Boolean {
+        return mangaRepository.update(
+            MangaUpdate(
+                id = mangaId,
+                snoozedUntil = snoozedUntil,
+            ),
+        )
+    }
+
+    suspend fun awaitAll(mangaIds: Collection<Long>, snoozedUntil: Long): Boolean {
+        return mangaRepository.updateAll(
+            mangaIds.map { mangaId ->
+                MangaUpdate(
+                    id = mangaId,
+                    snoozedUntil = snoozedUntil,
+                )
+            },
+        )
+    }
+
+    /** Clears an active snooze early, immediately making the manga eligible for the updates feed again. */
+    suspend fun clear(mangaId: Long): Boolean = await(mangaId, snoozedUntil = 0L)
+}
