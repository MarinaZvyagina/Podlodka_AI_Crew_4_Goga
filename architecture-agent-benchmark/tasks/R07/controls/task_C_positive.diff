+package eu.kanade.tachiyomi.data.track.komf
+
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class LoginRequestDto(
+    val username: String,
+    val password: String,
+)
+
+@Serializable
+data class LoginResponseDto(
+    val apiKey: String,
+)
+
+@Serializable
+data class SeriesDto(
+    val url: String,
+    val title: String,
+    val summary: String,
+    val totalChapters: Long,
+    val lastChapterRead: Double,
+    val status: Long,
+)
+
+@Serializable
+data class ReadProgressUpdateDto(
+    val lastChapterRead: Double,
+    val status: Long,
+)
