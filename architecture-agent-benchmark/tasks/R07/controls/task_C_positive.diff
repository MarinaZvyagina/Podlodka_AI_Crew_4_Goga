+package eu.kanade.tachiyomi.data.track.komf
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Test
+
+class KomfTest {
+
+    @Test
+    fun `stays completed once completed regardless of further reads`() {
+        assertEquals(
+            Komf.COMPLETED,
+            Komf.resolveStatus(
+                currentStatus = Komf.COMPLETED,
+                didReadChapter = true,
+                lastChapterRead = 3.0,
+                totalChapters = 10,
+            ),
+        )
+    }
+
+    @Test
+    fun `does not change status when no chapter was read`() {
+        assertEquals(
+            Komf.UNREAD,
+            Komf.resolveStatus(
+                currentStatus = Komf.UNREAD,
+                didReadChapter = false,
+                lastChapterRead = 0.0,
+                totalChapters = 10,
+            ),
+        )
+    }
+
+    @Test
+    fun `moves to reading when a chapter is read but series is not finished`() {
+        assertEquals(
+            Komf.READING,
+            Komf.resolveStatus(
+                currentStatus = Komf.UNREAD,
+                didReadChapter = true,
+                lastChapterRead = 3.0,
+                totalChapters = 10,
+            ),
+        )
+    }
+
+    @Test
+    fun `moves to completed when the last chapter read reaches the total chapter count`() {
+        assertEquals(
+            Komf.COMPLETED,
+            Komf.resolveStatus(
+                currentStatus = Komf.READING,
+                didReadChapter = true,
+                lastChapterRead = 10.0,
+                totalChapters = 10,
+            ),
+        )
+    }
+
+    @Test
+    fun `does not complete when total chapters is unknown (zero)`() {
+        assertEquals(
+            Komf.READING,
+            Komf.resolveStatus(
+                currentStatus = Komf.UNREAD,
+                didReadChapter = true,
+                lastChapterRead = 5.0,
+                totalChapters = 0,
+            ),
+        )
+    }
+}
