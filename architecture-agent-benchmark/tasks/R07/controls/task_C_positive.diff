@@ -0,0 +1,105 @@
+package eu.kanade.tachiyomi.data.track.komf
+
+import eu.kanade.tachiyomi.BuildConfig
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import logcat.LogPriority
+import okhttp3.Headers
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import tachiyomi.core.common.util.lang.withIOContext
+import tachiyomi.core.common.util.system.logcat
+import uy.kohesive.injekt.injectLazy
+
+/**
+ * Minimal client for a self-hosted Komf server instance. The endpoints/shapes below describe a
+ * plausible REST surface for such a server (login, series lookup, progress push); they are not
+ * tied to any particular real backend.
+ */
+class KomfApi(
+    private val trackId: Long,
+    private val client: OkHttpClient,
+) {
+
+    private val json: Json by injectLazy()
+
+    private fun headers(apiKey: String? = null): Headers = Headers.Builder()
+        .add("User-Agent", "Mihon v${BuildConfig.VERSION_NAME} (${BuildConfig.APPLICATION_ID})")
+        .apply { apiKey?.let { add("X-Api-Key", it) } }
+        .build()
+
+    suspend fun login(username: String, password: String): String = withIOContext {
+        val payload = json.encodeToString(LoginRequestDto(username, password))
+        val request = POST(
+            "$BASE_URL/api/v1/login",
+            headers = headers(),
+            body = payload.toRequestBody("application/json".toMediaType()),
+        )
+        with(json) {
+            client.newCall(request)
+                .awaitSuccess()
+                .parseAs<LoginResponseDto>()
+                .apiKey
+        }
+    }
+
+    suspend fun search(query: String): List<TrackSearch> = withIOContext {
+        try {
+            with(json) {
+                client.newCall(GET("$BASE_URL/api/v1/series?search=$query", headers()))
+                    .awaitSuccess()
+                    .parseAs<List<SeriesDto>>()
+                    .map { it.toTrack() }
+            }
+        } catch (e: Exception) {
+            logcat(LogPriority.WARN, e) { "Could not search Komf server for query: $query" }
+            emptyList()
+        }
+    }
+
+    suspend fun getTrackSearch(url: String): TrackSearch = withIOContext {
+        try {
+            with(json) {
+                client.newCall(GET(url, headers()))
+                    .awaitSuccess()
+                    .parseAs<SeriesDto>()
+                    .toTrack()
+            }
+        } catch (e: Exception) {
+            logcat(LogPriority.WARN, e) { "Could not get item: $url" }
+            throw e
+        }
+    }
+
+    suspend fun updateProgress(track: Track): Track = withIOContext {
+        val payload = json.encodeToString(ReadProgressUpdateDto(track.last_chapter_read, track.status))
+        client.newCall(
+            POST(
+                "${track.tracking_url}/progress",
+                headers = headers(),
+                body = payload.toRequestBody("application/json".toMediaType()),
+            ),
+        )
+            .awaitSuccess()
+        getTrackSearch(track.tracking_url)
+    }
+
+    private fun SeriesDto.toTrack(): TrackSearch = TrackSearch.create(trackId).also {
+        it.title = title
+        it.summary = summary
+        it.tracking_url = url
+        it.total_chapters = totalChapters
+        it.last_chapter_read = lastChapterRead
+        it.status = status
+    }
+
+    companion object {
+        private const val BASE_URL = "https://example-komf-server.invalid"
+    }
+}
