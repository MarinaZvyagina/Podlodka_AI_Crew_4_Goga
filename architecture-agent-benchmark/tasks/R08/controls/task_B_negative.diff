+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.mediasend.preupload
+
+import android.net.Uri
+import assertk.assertThat
+import assertk.assertions.isFalse
+import assertk.assertions.isTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+
+/**
+ * Negative-control demonstration.
+ *
+ * Shows that the feature-module-local override lets a user mark one item full quality "right now" (in-memory
+ * mechanism works), but the choice lives only in transient in-memory state and therefore does NOT survive process
+ * death — it never reaches the persisted per-attachment data layer. This is the intended architectural defect of
+ * the negative control.
+ */
+@RunWith(RobolectricTestRunner::class)
+class FullQualityCompressionOverrideTest {
+
+  @Test
+  fun givenItemMarkedFullQuality_whenCheckedInSameProcess_thenCompressionIsSkipped() {
+    val uri = Uri.parse("content://media/marked")
+    val sibling = Uri.parse("content://media/sibling")
+
+    FullQualityCompressionOverride.setFullQuality(uri, true)
+
+    // The in-memory mechanism works within the same process: the marked item skips compression, the sibling does not.
+    assertThat(FullQualityCompressionOverride.shouldCompress(uri)).isFalse()
+    assertThat(FullQualityCompressionOverride.shouldCompress(sibling)).isTrue()
+
+    // cleanup
+    FullQualityCompressionOverride.setFullQuality(uri, false)
+  }
+
+  @Test
+  fun givenItemMarkedFullQuality_whenProcessRecreated_thenChoiceIsLost() {
+    val uri = Uri.parse("content://media/marked")
+
+    FullQualityCompressionOverride.setFullQuality(uri, true)
+    assertThat(FullQualityCompressionOverride.isFullQuality(uri)).isTrue()
+
+    // Simulate process death: the choice lives only in transient in-memory state, so a fresh process starts with
+    // an empty set and the full-quality choice is silently reverted to the compressed default.
+    simulateProcessDeath()
+
+    assertThat(FullQualityCompressionOverride.isFullQuality(uri)).isFalse()
+    assertThat(FullQualityCompressionOverride.shouldCompress(uri)).isTrue()
+  }
+
+  /**
+   * Resets the singleton's in-memory state to model what a real relaunch would produce: nothing persisted.
+   */
+  private fun simulateProcessDeath() {
+    listOf(
+      Uri.parse("content://media/marked"),
+      Uri.parse("content://media/sibling")
+    ).forEach { FullQualityCompressionOverride.setFullQuality(it, false) }
+  }
+}
