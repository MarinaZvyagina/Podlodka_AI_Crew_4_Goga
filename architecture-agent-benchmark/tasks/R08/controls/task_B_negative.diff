+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.mediasend.preupload
+
+import android.net.Uri
+import java.io.File
+import java.io.FileInputStream
+import java.io.FileOutputStream
+
+/**
+ * Feature-module-local mechanism for the per-item "send at full quality" override.
+ *
+ * Tracks which items the user marked as full quality purely in memory, and re-implements the
+ * "skip compression" behavior directly inside the feature module by copying the original file bytes
+ * over the compressed output instead of routing the choice through the app's attachment/pre-upload
+ * layer.
+ */
+object FullQualityCompressionOverride {
+
+  private val fullQualityUris: MutableSet<Uri> = mutableSetOf()
+
+  fun setFullQuality(uri: Uri, fullQuality: Boolean) {
+    if (fullQuality) {
+      fullQualityUris.add(uri)
+    } else {
+      fullQualityUris.remove(uri)
+    }
+  }
+
+  fun isFullQuality(uri: Uri): Boolean {
+    return uri in fullQualityUris
+  }
+
+  /**
+   * Local re-implementation of the compression decision for this item.
+   */
+  fun shouldCompress(uri: Uri): Boolean {
+    return uri !in fullQualityUris
+  }
+
+  /**
+   * If the item was marked full quality, overwrite the compressed output with the original file bytes so the
+   * uncompressed version is what gets sent.
+   */
+  fun applyFullQuality(uri: Uri, originalFile: File, compressedOutput: File) {
+    if (shouldCompress(uri)) {
+      return
+    }
+
+    FileInputStream(originalFile).use { input ->
+      FileOutputStream(compressedOutput).use { output ->
+        input.copyTo(output)
+      }
+    }
+  }
+}
