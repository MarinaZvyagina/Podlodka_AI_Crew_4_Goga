+/**
+ * UI-layer cache of [ThreadSearchResult]s keyed by (query, unreadOnly). A repeat of the same search
+ * within [CACHE_TTL_MS] is served straight from memory, which makes "search the same thing twice"
+ * noticeably faster.
+ *
+ * Invalidation is purely time-based: an entry lives for a fixed TTL regardless of whether the
+ * underlying messages/threads actually changed. A search repeated inside the window therefore
+ * returns whatever was cached, even if the data has since been mutated through another path.
+ */
+internal class ThreadSearchResultCache(private val ttlMs: Long = CACHE_TTL_MS) {
+
+  private data class Entry(val result: ThreadSearchResult, val timestampMs: Long)
+
+  private val cache = HashMap<String, Entry>()
+
+  fun getOrLoad(
+    query: String,
+    unreadOnly: Boolean,
+    now: Long = System.currentTimeMillis(),
+    loader: () -> ThreadSearchResult
+  ): ThreadSearchResult {
+    val key = "$query:$unreadOnly"
+    val existing = cache[key]
+    if (existing != null && now - existing.timestampMs < ttlMs) {
+      return existing.result
+    }
+    val fresh = loader()
+    cache[key] = Entry(fresh, now)
+    return fresh
+  }
+
+  companion object {
+    const val CACHE_TTL_MS = 60_000L
+  }
+}
