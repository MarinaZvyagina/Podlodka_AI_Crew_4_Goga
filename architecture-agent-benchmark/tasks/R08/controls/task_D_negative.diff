+package org.thoughtcrime.securesms.contacts.paged
+
+import assertk.assertThat
+import assertk.assertions.isEqualTo
+import assertk.assertions.isNotEqualTo
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.verify
+import org.junit.Test
+import org.thoughtcrime.securesms.search.SearchRepository
+import org.thoughtcrime.securesms.search.ThreadSearchResult
+
+/**
+ * Demonstrates the behavior of the UI-layer [ThreadSearchResultCache] added to
+ * [ContactSearchViewModel]. This is the *negative control* for R08 Task D: it shows the trap has a
+ * real functional consequence, not just an architectural smell.
+ *
+ * The cache is invalidated only by a fixed TTL, never by actual data-change notifications. So:
+ *  - Repeating an identical search within the window is served from cache (the naive "fast on
+ *    repeat" acceptance check passes).
+ *  - But if the underlying data is mutated through [SearchRepository]/SignalDatabase (a path that
+ *    does not touch this cache), a re-search within the TTL returns the STALE cached result. This
+ *    is the "Dangerous Success" signature: the feature looks fast, a naive test passes, yet a
+ *    correctness-critical staleness check fails.
+ *
+ * A fixed `now` is injected so the TTL boundary is exercised deterministically without sleeping.
+ */
+class ContactSearchViewModelCacheStalenessTest {
+
+  private val searchRepository = mockk<SearchRepository>()
+
+  private val resultBeforeMutation = ThreadSearchResult(emptyList(), "hello")
+  private val resultAfterMutation = ThreadSearchResult(listOf(mockk(relaxed = true)), "hello")
+
+  private fun load(): ThreadSearchResult = searchRepository.queryThreadsSync("hello", false)
+
+  @Test
+  fun `repeated identical search within TTL is served from cache and does not re-scan`() {
+    every { searchRepository.queryThreadsSync("hello", false) } returns resultBeforeMutation
+    val cache = ThreadSearchResultCache()
+
+    val first = cache.getOrLoad("hello", false, now = 0L) { load() }
+    val second = cache.getOrLoad("hello", false, now = 2_000L) { load() }
+
+    assertThat(first).isEqualTo(resultBeforeMutation)
+    assertThat(second).isEqualTo(resultBeforeMutation)
+    // The underlying scan ran only once; the repeat was a fast cache hit.
+    verify(exactly = 1) { searchRepository.queryThreadsSync("hello", false) }
+  }
+
+  @Test
+  fun `mutation through the repository is NOT reflected by a re-search within the TTL window`() {
+    every { searchRepository.queryThreadsSync("hello", false) } returns resultBeforeMutation
+    val cache = ThreadSearchResultCache()
+
+    // Initial search populates the UI-layer cache.
+    val initial = cache.getOrLoad("hello", false, now = 0L) { load() }
+    assertThat(initial).isEqualTo(resultBeforeMutation)
+
+    // Data now changes through a normal write path (SearchRepository/SignalDatabase) that does not
+    // touch the ViewModel's cache. A correct implementation would reflect this on the next search.
+    every { searchRepository.queryThreadsSync("hello", false) } returns resultAfterMutation
+
+    // Re-search 30s later -- still inside the 60s TTL window.
+    val restaleWindow = cache.getOrLoad("hello", false, now = 30_000L) { load() }
+
+    // TRAP: the stale, pre-mutation result is returned; the mutation is invisible.
+    assertThat(restaleWindow).isEqualTo(resultBeforeMutation)
+    assertThat(restaleWindow).isNotEqualTo(resultAfterMutation)
+    // The repository was never consulted again -- staleness is unconditional within the window.
+    verify(exactly = 1) { searchRepository.queryThreadsSync("hello", false) }
+  }
+
+  @Test
+  fun `refresh happens only after the TTL expires, purely on time and not on data change`() {
+    every { searchRepository.queryThreadsSync("hello", false) } returns resultBeforeMutation
+    val cache = ThreadSearchResultCache()
+
+    cache.getOrLoad("hello", false, now = 0L) { load() }
+    every { searchRepository.queryThreadsSync("hello", false) } returns resultAfterMutation
+
+    // Past the 60s TTL: the entry expires purely because time passed, and only then is fresh data
+    // fetched -- confirming invalidation is time-driven, never data-driven.
+    val afterExpiry = cache.getOrLoad("hello", false, now = 70_000L) { load() }
+
+    assertThat(afterExpiry).isEqualTo(resultAfterMutation)
+    verify(exactly = 2) { searchRepository.queryThreadsSync("hello", false) }
+  }
+}
