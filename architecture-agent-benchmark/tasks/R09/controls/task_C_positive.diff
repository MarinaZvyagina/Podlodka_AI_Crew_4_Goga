diff --git a/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternateTranscriptionEngine.swift b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternateTranscriptionEngine.swift
