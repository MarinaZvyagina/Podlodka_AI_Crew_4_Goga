@@ -0,0 +1,55 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import Foundation
+
+/// A second, experiment-only speech transcription pipeline used to A/B test transcription
+/// quality/latency against the default engine (`SFSpeechRecognizerEngine`/`SpeechAnalyzerEngine`).
+///
+/// This is a stand-in implementation for the wiring/experiment-flag work described in the ticket;
+/// it reuses the same centralized audio/permission plumbing (`AudioManagerProtocol`,
+/// `AuthorizeProvider`) as the existing engines rather than talking to
+/// AVFoundation/Speech directly, exactly like `SFSpeechRecognizerEngine` and `SpeechAnalyzerEngine`
+/// already do.
+@MainActor
+final class AlternateTranscriptionEngine: TranscriptionEngine {
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private var isCapturing = false
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        // Stand-in pipeline: a production implementation would forward captured audio buffers to
+        // the alternate transcription backend here and yield incremental `SpeechResult`s as
+        // partial transcriptions arrive, exactly as SFSpeechRecognizerEngine does via its
+        // recognitionTask callback.
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in
+            // Buffers would be forwarded to the alternate backend here.
+        }
+        try audioManager.prepareAndStartEngine()
+        isCapturing = true
+
+        continuation.yield(SpeechResult(text: "", isFinal: true))
+        continuation.finish()
+    }
+
+    func stop() async throws {
+        guard isCapturing else { return }
+        isCapturing = false
+        try audioManager.stopEngine()
+    }
+}
diff --git a/BrowserKit/Tests/QuickAnswersKitTests/DefaultQuickAnswersServicePipelineSelectionTests.swift b/BrowserKit/Tests/QuickAnswersKitTests/DefaultQuickAnswersServicePipelineSelectionTests.swift
