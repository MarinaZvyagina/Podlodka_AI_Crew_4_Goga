@@ -0,0 +1,94 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import Shared
+import Testing
+import TestKit
+
+@testable import QuickAnswersKit
+
+/// Covers the "alternative speech-to-text pipeline" A/B experiment: (a) selecting each pipeline
+/// yields the expected concrete engine, and (b) record()/stopRecording() behave identically (the
+/// same call sequence into whichever engine is active) regardless of which pipeline is selected.
+@MainActor
+class DefaultQuickAnswersServicePipelineSelectionTests {
+    let testHelper = SwiftTestingHelper()
+    let resultsServiceFactory: MockResultsServiceFactory
+
+    init() {
+        resultsServiceFactory = MockResultsServiceFactory()
+    }
+
+    // MARK: - Selection is centralized and flag-driven
+
+    @Test
+    func test_init_defaultFlag_doesNotSelectAlternateEngine() throws {
+        let subject = try createSubject(useAlternateTranscriptionPipeline: false)
+
+        #expect(!(subject.engine is AlternateTranscriptionEngine))
+    }
+
+    @Test
+    func test_init_alternatePipelineFlagEnabled_selectsAlternateEngine() throws {
+        let subject = try createSubject(useAlternateTranscriptionPipeline: true)
+
+        #expect(subject.engine is AlternateTranscriptionEngine)
+    }
+
+    // MARK: - Both pipelines behave identically through the public entry points
+
+    @Test
+    func test_record_and_stopRecording_behaveIdentically_defaultEngineInjected() async throws {
+        let engine = MockTranscriptionEngine()
+        engine.resultsToYield = [SpeechResult(text: "hello", isFinal: true)]
+        let subject = try createSubject(engine: engine)
+
+        let stream = try await subject.record()
+        var received: [SpeechResult] = []
+        for try await value in stream { received.append(value) }
+        try await subject.stopRecording()
+
+        #expect(engine.prepareCallCount == 1)
+        #expect(engine.startCallCount == 1)
+        #expect(engine.stopCallCount == 1)
+        #expect(received.count == 1)
+    }
+
+    @Test
+    func test_record_and_stopRecording_behaveIdentically_alternateEngineInjectedDirectly() async throws {
+        let audioManager = MockAudioManager()
+        let authorizer = MockAuthorizer(micAuthorized: true, speechAuthorized: true)
+        let engine = AlternateTranscriptionEngine(audioManager: audioManager, authorizer: authorizer)
+        let subject = try createSubject(engine: engine)
+
+        let stream = try await subject.record()
+        var received: [SpeechResult] = []
+        for try await value in stream { received.append(value) }
+        try await subject.stopRecording()
+
+        // Same public-entry-point contract as the default engine: record() prepares + starts,
+        // stopRecording() stops, both routed through DefaultQuickAnswersService's engine property
+        // without any call-site branching.
+        #expect(audioManager.configureAudioSessionCallCount == 1)
+        #expect(audioManager.prepareAndStartEngineCallCount == 1)
+        #expect(audioManager.stopEngineCallCount == 1)
+        #expect(!received.isEmpty)
+    }
+
+    // MARK: - Helper
+    private func createSubject(
+        engine: TranscriptionEngine? = nil,
+        useAlternateTranscriptionPipeline: Bool = false
+    ) throws -> DefaultQuickAnswersService {
+        let subject = try DefaultQuickAnswersService(
+            engine: engine,
+            useAlternateTranscriptionPipeline: useAlternateTranscriptionPipeline,
+            configFetcher: MockQuickAnswersConfigFetcher(),
+            resultsServiceFactory: resultsServiceFactory,
+            prefs: MockProfilePrefs()
+        )
+        testHelper.trackForMemoryLeaks(subject)
+        return subject
+    }
+}
