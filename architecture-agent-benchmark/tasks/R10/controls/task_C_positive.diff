diff --git a/SignalServiceKit/Jobs/JobRecords/MessageRetentionCleanupJobRecord.swift b/SignalServiceKit/Jobs/JobRecords/MessageRetentionCleanupJobRecord.swift
new file mode 100644
index 0000000..12450cd
--- /dev/null
+++ b/SignalServiceKit/Jobs/JobRecords/MessageRetentionCleanupJobRecord.swift
@@ -0,0 +1,48 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+/// Persisted record backing a resumable, interruption-safe sweep that deletes interactions older than a
+/// user-configured retention window, across every conversation.
+///
+/// Modeled directly on ``BulkDeleteInteractionJobRecord``: rather than a per-thread anchor row ID, this job
+/// persists the `receivedAtTimestamp` cutoff ("delete everything strictly older than this") that was computed
+/// once when the job was created. Because the cutoff is a fixed, persisted value (not recomputed from "now" on
+/// every retry), the job is naturally idempotent and resumable: if interrupted, the still-present JobRecord row
+/// causes `JobQueueRunner.start(shouldRestartExistingJobs:)` to pick the same job back up on next launch, and
+/// re-querying "interactions older than cutoffReceivedAtTimestamp" simply finds fewer (or zero) rows the further
+/// along the sweep has already progressed.
+final class MessageRetentionCleanupJobRecord: JobRecord {
+    override class var jobRecordType: JobRecord.JobRecordType { .messageRetentionCleanup }
+
+    /// Interactions with `receivedAtTimestamp` strictly before this value should be deleted, across all threads.
+    let cutoffReceivedAtTimestamp: UInt64
+
+    init(
+        cutoffReceivedAtTimestamp: UInt64,
+        failureCount: UInt = 0,
+        status: Status = .ready,
+    ) {
+        self.cutoffReceivedAtTimestamp = cutoffReceivedAtTimestamp
+
+        super.init(
+            failureCount: failureCount,
+            status: status,
+        )
+    }
+
+    required init(inheritableDecoder decoder: any Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+
+        cutoffReceivedAtTimestamp = try container.decode(UInt64.self, forKey: .MRCJR_cutoffReceivedAtTimestamp)
+
+        try super.init(inheritableDecoder: decoder)
+    }
+
+    override func encode(to encoder: any Encoder) throws {
+        try super.encode(to: encoder)
+        var container = encoder.container(keyedBy: CodingKeys.self)
+        try container.encode(cutoffReceivedAtTimestamp, forKey: .MRCJR_cutoffReceivedAtTimestamp)
+    }
+}
diff --git a/SignalServiceKit/Jobs/MessageRetentionCleanupJobQueue.swift b/SignalServiceKit/Jobs/MessageRetentionCleanupJobQueue.swift
new file mode 100644
index 0000000..16507e3
--- /dev/null
+++ b/SignalServiceKit/Jobs/MessageRetentionCleanupJobQueue.swift
@@ -0,0 +1,219 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+/// Drives the resumable, interruption-safe deletion of interactions older than the user's configured message
+/// retention window, across every conversation.
+///
+/// Modeled directly on ``BulkDeleteInteractionJobQueue``: a single persisted ``MessageRetentionCleanupJobRecord``
+/// (rather than an ad hoc `Timer`/`Task` loop driven by app-lifecycle notifications) is the source of truth for
+/// "is there a retention sweep in progress and where does it need to keep going." Because the JobRecord row
+/// itself is what survives an app kill/background/network loss, `JobQueueRunner.start(shouldRestartExistingJobs:)`
+/// picking it back up at next launch is what gives us resumability "for free," the same way it does for every
+/// other job in this framework.
+public final class MessageRetentionCleanupJobQueue {
+    private let jobRunnerFactory: MessageRetentionCleanupJobRunnerFactory
+    private let jobQueueRunner: JobQueueRunner<
+        JobRecordFinderImpl<MessageRetentionCleanupJobRecord>,
+        MessageRetentionCleanupJobRunnerFactory,
+    >
+    private let preferenceStore: MessageRetentionPreferenceStore
+    private var jobSerializer = CompletionSerializer()
+
+    init(
+        db: any DB,
+        interactionDeleteManager: InteractionDeleteManager,
+        preferenceStore: MessageRetentionPreferenceStore = MessageRetentionPreferenceStore(),
+    ) {
+        self.preferenceStore = preferenceStore
+        self.jobRunnerFactory = MessageRetentionCleanupJobRunnerFactory(
+            db: db,
+            interactionDeleteManager: interactionDeleteManager,
+        )
+        self.jobQueueRunner = JobQueueRunner(
+            canExecuteJobsConcurrently: false,
+            db: db,
+            jobFinder: JobRecordFinderImpl(db: db),
+            jobRunnerFactory: self.jobRunnerFactory,
+        )
+    }
+
+    /// Should be called analogously to every other job queue's `start`, from app-launch bootstrap — not from a
+    /// view controller action or an `applicationDidBecomeActive`-style lifecycle hook.
+    func start(appContext: AppContext) {
+        jobQueueRunner.start(shouldRestartExistingJobs: appContext.isMainApp)
+    }
+
+    /// Updates the user's retention window preference. When a window is set (either for the first time, or
+    /// changed to a shorter window), enqueues a new cleanup job so the change applies retroactively to existing
+    /// history, not just new messages going forward.
+    public func setRetentionWindowDays(_ days: Int?, tx: DBWriteTransaction) {
+        preferenceStore.setRetentionWindowDays(days, tx: tx)
+
+        guard let days, days > 0 else {
+            return
+        }
+
+        let cutoffReceivedAtTimestamp = Date.ows_millisecondTimestamp() - (UInt64(days) * UInt64.dayInMs)
+        addJob(cutoffReceivedAtTimestamp: cutoffReceivedAtTimestamp, tx: tx)
+    }
+
+    private func addJob(cutoffReceivedAtTimestamp: UInt64, tx: DBWriteTransaction) {
+        let jobRecord = MessageRetentionCleanupJobRecord(cutoffReceivedAtTimestamp: cutoffReceivedAtTimestamp)
+        jobRecord.anyInsert(transaction: tx)
+
+        jobSerializer.addOrderedSyncCompletion(tx: tx) {
+            self.jobQueueRunner.addPersistedJob(jobRecord)
+        }
+    }
+}
+
+// MARK: -
+
+private class MessageRetentionCleanupJobRunner: JobRunner {
+    typealias JobRecordType = MessageRetentionCleanupJobRecord
+
+    private enum Constants {
+        static let maxRetries: UInt = 110
+        static let deletionBatchSize: Int = 500
+    }
+
+    private let db: any DB
+    private let interactionDeleteManager: InteractionDeleteManager
+
+    private let logger = PrefixedLogger(prefix: "[MessageRetention]")
+
+    init(db: any DB, interactionDeleteManager: InteractionDeleteManager) {
+        self.db = db
+        self.interactionDeleteManager = interactionDeleteManager
+    }
+
+    func runJobAttempt(
+        _ jobRecord: MessageRetentionCleanupJobRecord,
+    ) async -> JobAttemptResult<Void> {
+        return await JobAttemptResult.executeBlockWithDefaultErrorHandler(
+            jobRecord: jobRecord,
+            retryLimit: Constants.maxRetries,
+            db: db,
+            block: {
+                try await _runJobAttempt(jobRecord)
+            },
+        )
+    }
+
+    func didFinishJob(_ jobRecordId: JobRecord.RowId, result: JobResult<Void>) async {
+        switch result.ranSuccessfullyOrError {
+        case .success:
+            break
+        case .failure(let failure):
+            logger.error("Failed to perform message-retention cleanup! \(failure)")
+        }
+    }
+
+    private func _runJobAttempt(
+        _ jobRecord: MessageRetentionCleanupJobRecord,
+    ) async throws {
+        let cutoffReceivedAtTimestamp = jobRecord.cutoffReceivedAtTimestamp
+
+        logger.info("Attempting message-retention cleanup for interactions older than \(cutoffReceivedAtTimestamp).")
+
+        var deletedCount = 0
+        await TimeGatedBatch.processAll(db: db) { tx -> TimeGatedBatch.ProcessBatchResult in
+            let batchDeletedCount = self.deleteSomeOldInteractions(
+                cutoffReceivedAtTimestamp: cutoffReceivedAtTimestamp,
+                tx: tx,
+            )
+            deletedCount += batchDeletedCount
+            return batchDeletedCount == 0 ? .done(()) : .more
+        }
+
+        logger.info("Deleted \(deletedCount) messages older than \(cutoffReceivedAtTimestamp) across all threads.")
+
+        await db.awaitableWrite { tx in
+            // If the user signed out mid-sweep, we simply stop here: the still-partially-applied deletes we've
+            // already committed are each individually consistent (every batch went through
+            // InteractionDeleteManager, which keeps thread/call-record/cache state coherent as it goes), so
+            // there's no "half-deleted or corrupted-looking" intermediate state to clean up — unlike a bespoke
+            // in-place mutation approach, there's nothing further to roll back or reconcile.
+            jobRecord.anyRemove(transaction: tx)
+        }
+    }
+
+    /// Delete a batch of interactions older than `cutoffReceivedAtTimestamp`, across every thread.
+    /// - Returns: The number of interactions deleted. A return value of 0 indicates there's nothing left to
+    /// delete for this cutoff.
+    private func deleteSomeOldInteractions(
+        cutoffReceivedAtTimestamp: UInt64,
+        tx: DBWriteTransaction,
+    ) -> Int {
+        let interactionsToDelete: [TSInteraction]
+        do {
+            interactionsToDelete = try Self.fetchInteractions(
+                olderThanReceivedAtTimestamp: cutoffReceivedAtTimestamp,
+                limit: Constants.deletionBatchSize,
+                tx: tx,
+            )
+        } catch {
+            owsFailDebug("Failed to get interactions to delete for message retention!")
+            return 0
+        }
+
+        if interactionsToDelete.isEmpty { return 0 }
+
+        // Deleting through InteractionDeleteManager (rather than a raw anyRemove loop) is what makes each
+        // conversation's preview text, unread count, and message list correct immediately after this batch
+        // commits, and what keeps any associated CallRecord rows consistent — all "for free," the same way
+        // BulkDeleteInteractionJobRunner gets it for free for its own bulk-delete feature.
+        interactionDeleteManager.delete(
+            interactions: interactionsToDelete,
+            sideEffects: .custom(
+                associatedCallDelete: .localDeleteOnly,
+                updateThreadOnInteractionDelete: .updateOnEachDeletedInteraction,
+            ),
+            tx: tx,
+        )
+
+        return interactionsToDelete.count
+    }
+
+    private static func fetchInteractions(
+        olderThanReceivedAtTimestamp cutoffReceivedAtTimestamp: UInt64,
+        limit: Int,
+        tx: DBReadTransaction,
+    ) throws -> [TSInteraction] {
+        let sql = """
+            SELECT *
+            FROM \(InteractionRecord.databaseTableName)
+            WHERE \(interactionColumn: .receivedAtTimestamp) < ?
+            ORDER BY \(interactionColumn: .id) ASC
+            LIMIT ?
+        """
+        return try TSInteraction.grdbFetchCursor(
+            sql: sql,
+            arguments: [cutoffReceivedAtTimestamp, limit],
+            transaction: tx,
+        ).all()
+    }
+}
+
+// MARK: -
+
+private class MessageRetentionCleanupJobRunnerFactory: JobRunnerFactory {
+    typealias JobRunnerType = MessageRetentionCleanupJobRunner
+
+    private let db: any DB
+    private let interactionDeleteManager: InteractionDeleteManager
+
+    init(db: any DB, interactionDeleteManager: InteractionDeleteManager) {
+        self.db = db
+        self.interactionDeleteManager = interactionDeleteManager
+    }
+
+    func buildRunner() -> MessageRetentionCleanupJobRunner {
+        return MessageRetentionCleanupJobRunner(
+            db: db,
+            interactionDeleteManager: interactionDeleteManager,
+        )
+    }
+}
diff --git a/SignalServiceKit/Jobs/MessageRetentionPreferenceStore.swift b/SignalServiceKit/Jobs/MessageRetentionPreferenceStore.swift
new file mode 100644
index 0000000..9f460c2
--- /dev/null
+++ b/SignalServiceKit/Jobs/MessageRetentionPreferenceStore.swift
@@ -0,0 +1,30 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+import Foundation
+
+/// Persists the user's message-retention window preference (on/off + number of days). This is a simple,
+/// standalone preference — unlike the actual deletion work, which must go through the job-execution framework
+/// (see ``MessageRetentionCleanupJobQueue``), merely remembering "what window did the user pick" doesn't need
+/// resumability/retry semantics, so a small `NewKeyValueStore`-backed struct (matching the existing pattern used
+/// by ``MediaBandwidthPreferenceStore``) is sufficient here.
+public struct MessageRetentionPreferenceStore {
+    private static let retentionWindowDaysKey = "retentionWindowDays"
+
+    private let kvStore: NewKeyValueStore
+
+    public init() {
+        self.kvStore = NewKeyValueStore(collection: "MessageRetentionPreferences")
+    }
+
+    /// The current retention window in days, or `nil` if retention cleanup is disabled.
+    public func retentionWindowDays(tx: DBReadTransaction) -> Int? {
+        kvStore.fetchValue(Int.self, forKey: Self.retentionWindowDaysKey, tx: tx)
+    }
+
+    public func setRetentionWindowDays(_ days: Int?, tx: DBWriteTransaction) {
+        kvStore.writeValue(days, forKey: Self.retentionWindowDaysKey, tx: tx)
+    }
+}
