+
+/// Lightweight helper that deletes every message the local user personally sent within a single thread, leaving
+/// the other participant(s)' messages untouched. Queries interactions directly and removes them in a single
+/// write transaction — this is a narrowly-scoped, self-contained feature, so it doesn't need the full
+/// `InteractionDeleteManager` machinery (which is oriented around more general-purpose deletion flows like
+/// message-detail "delete" and bulk thread cleanup).
+public struct DeleteAllMessagesSentByLocalUserManager {
+    public init() {}
+
+    /// Deletes every interaction in `thread` that was authored by the local user (i.e., every
+    /// ``TSOutgoingMessage``).
+    public func deleteAllMessagesSentByLocalUser(
+        in thread: TSThread,
+        tx: DBWriteTransaction,
+    ) {
+        var interactionsAuthoredByLocalUser: [TSInteraction] = []
+        try? InteractionFinder(threadUniqueId: thread.uniqueId).enumerateInteractionsForConversationView(
+            rowIdFilter: .newest,
+            tx: tx,
+        ) { interaction in
+            if interaction is TSOutgoingMessage {
+                interactionsAuthoredByLocalUser.append(interaction)
+            }
+            return true
+        }
+
+        for interaction in interactionsAuthoredByLocalUser {
+            interaction.anyRemove(transaction: tx)
+        }
+    }
+}
