+
+/// Thin coordinator, built on top of ``InteractionDeleteManager``, that lets a caller delete every message the
+/// local user personally sent within a single thread — while leaving messages from the other participant(s)
+/// untouched — without needing to duplicate any of the cross-cutting concerns (call-record cleanup, read-cache
+/// invalidation, delete-for-me sync messaging) that `InteractionDeleteManager` already owns.
+public struct DeleteAllMessagesSentByLocalUserManager {
+    private let interactionDeleteManager: InteractionDeleteManager
+
+    public init(interactionDeleteManager: InteractionDeleteManager) {
+        self.interactionDeleteManager = interactionDeleteManager
+    }
+
+    /// Deletes every interaction in `thread` that was authored by the local user (i.e., every
+    /// ``TSOutgoingMessage``). Requests a delete-for-me sync message so the deletion propagates to the user's
+    /// other linked devices, and routes through `InteractionDeleteManager` so associated call records and
+    /// cached thread/preview state stay correct immediately, with no relaunch required.
+    public func deleteAllMessagesSentByLocalUser(
+        in thread: TSThread,
+        tx: DBWriteTransaction,
+    ) {
+        var interactionsAuthoredByLocalUser: [TSInteraction] = []
+        try? InteractionFinder(threadUniqueId: thread.uniqueId).enumerateInteractionsForConversationView(
+            rowIdFilter: .newest,
+            tx: tx,
+        ) { interaction in
+            if interaction is TSOutgoingMessage {
+                interactionsAuthoredByLocalUser.append(interaction)
+            }
+            return true
+        }
+
+        guard !interactionsAuthoredByLocalUser.isEmpty else {
+            return
+        }
+
+        interactionDeleteManager.delete(
+            interactions: interactionsAuthoredByLocalUser,
+            sideEffects: .custom(
+                deleteForMeSyncMessage: .sendSyncMessage(interactionsThread: thread),
+            ),
+            tx: tx,
+        )
+    }
+}
