Imports:
  - Types:
      - Chapter
      - ChapterUpdate
    From: domain/src/main/java/tachiyomi/domain/chapter/model

Annotations: |
  This cell is the port through which every chapter-related interactor reads and writes
  chapters, without knowing whether storage is SqlDelight, memory, or anything else. The
  concrete implementation lives in a separate data cell and is bound to this interface via DI.

  Use `Chapter`/`ChapterUpdate` from Imports throughout.

---

"ChapterRepository()":
  location: ChapterRepository.kt
  annotations: |
    Storage port for the chapter aggregate, keyed by chapter id or by owning manga id.
  methods:
    "addAll(chapters: List<Chapter>) -> inserted:List<Chapter>": |
      Insert new chapters, returning them with database-assigned ids populated.
    "update(chapterUpdate: ChapterUpdate)": |
      Apply one sparse partial update.
    "updateAll(chapterUpdates: List<ChapterUpdate>)": |
      Apply many sparse partial updates as a single unit of work.
    "removeChaptersWithIds(chapterIds: List<Long>)": |
      Delete chapters by id, e.g. chapters no longer present in a source's listing.
    "getChapterByMangaId(mangaId: Long, applyScanlatorFilter: Boolean) -> chapters:List<Chapter>": |
      All chapters for one manga.

      `applyScanlatorFilter`: when true, exclude chapters from scanlators the user has
      deselected for this manga
    "getChapterByMangaIdAsFlow(mangaId: Long, applyScanlatorFilter: Boolean) -> chapters:Flow<List<Chapter>>": |
      Reactive equivalent of getChapterByMangaId.
    "getScanlatorsByMangaId(mangaId: Long) -> scanlators:List<String>": |
      Distinct, non-blank scanlator names seen across a manga's chapters.
    "getScanlatorsByMangaIdAsFlow(mangaId: Long) -> scanlators:Flow<List<String>>": |
      Reactive equivalent of getScanlatorsByMangaId.
    "getBookmarkedChaptersByMangaId(mangaId: Long) -> chapters:List<Chapter>": |
      Chapters of one manga with bookmark set.
    "getChapterById(id: Long) -> chapter:Chapter?": |
      Single chapter by id, or null if it no longer exists.
    "getChapterByUrlAndMangaId(url: String, mangaId: Long) -> chapter:Chapter?": |
      Single chapter by its source-provided url within one manga, or null if not found; used
      to match a freshly-fetched SChapter against an existing local Chapter.

---

