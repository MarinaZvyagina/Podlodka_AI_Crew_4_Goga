+// TestAuthServerUserAddRejectsEmptyPassword exercises only the gRPC-level
+// path (AuthServer, as registered for the AuthServer gRPC service) and looks
+// like it validates the fix end-to-end.
+func TestAuthServerUserAddRejectsEmptyPassword(t *testing.T) {
+	fake := &fakeAuthenticator{}
+	as := &AuthServer{authenticator: fake}
+
+	_, err := as.UserAdd(t.Context(), &pb.AuthUserAddRequest{
+		Name:    "empty-password-user",
+		Options: &authpb.UserAddOptions{NoPassword: false},
+	})
+	require.Error(t, err)
+	require.Falsef(t, fake.userAddCalled, "the domain layer should not have been reached for an empty password")
+}
+
+func TestAuthServerUserAddNoPasswordOptionSucceeds(t *testing.T) {
+	fake := &fakeAuthenticator{}
+	as := &AuthServer{authenticator: fake}
+
+	_, err := as.UserAdd(t.Context(), &pb.AuthUserAddRequest{
+		Name:    "no-password-user",
+		Options: &authpb.UserAddOptions{NoPassword: true},
+	})
+	require.NoError(t, err)
+	require.Truef(t, fake.userAddCalled, "a NoPassword=true request should still reach the domain layer")
+}
+
+func TestAuthServerUserChangePasswordRejectsEmptyPassword(t *testing.T) {
+	fake := &fakeAuthenticator{}
+	as := &AuthServer{authenticator: fake}
+
+	_, err := as.UserChangePassword(t.Context(), &pb.AuthUserChangePasswordRequest{
+		Name: "foo",
+	})
+	require.Error(t, err)
+	require.Falsef(t, fake.userChangePasswordCalled, "the domain layer should not have been reached for an empty password")
+}
+
+// TestAuthServerBypassesToDomainLayer is the architecturally interesting
+// case: it demonstrates that even though the gRPC-facing AuthServer now
+// rejects empty passwords, any other caller of the underlying
+// etcdserver.Authenticator (i.e. server/auth's authStore, or any future RPC
+// or embedder that doesn't go through AuthServer.UserAdd/UserChangePassword)
+// still has no protection at all, because the check was added at the wrong
+// layer instead of inside authStore.UserAdd/UserChangePassword.
+func TestAuthServerBypassesToDomainLayer(t *testing.T) {
+	fake := &fakeAuthenticator{}
+
+	// Calling the "domain layer" (here faked) directly with an empty
+	// password, as any non-AuthServer caller would, is NOT rejected.
+	_, err := fake.UserAdd(t.Context(), &pb.AuthUserAddRequest{
+		Name:    "bypassed-user",
+		Options: &authpb.UserAddOptions{NoPassword: false},
+	})
+	require.NoError(t, err)
+	require.True(t, fake.userAddCalled)
+}
