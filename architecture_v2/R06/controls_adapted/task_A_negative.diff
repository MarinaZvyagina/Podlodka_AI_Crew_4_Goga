diff --git a/server/etcdserver/api/v3rpc/auth.go b/server/etcdserver/api/v3rpc/auth.go
index 15b0bdd..d573af3 100644
--- a/server/etcdserver/api/v3rpc/auth.go
+++ b/server/etcdserver/api/v3rpc/auth.go
@@ -16,12 +16,18 @@ package v3rpc
 
 import (
 	"context"
+	"errors"
 
 	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
 	"go.etcd.io/etcd/server/v3/auth"
 	"go.etcd.io/etcd/server/v3/etcdserver"
 )
 
+// errPasswordEmpty is returned when a user-add or password-change request
+// carries a blank password for an account that is not explicitly opted into
+// no-password (passwordless) mode.
+var errPasswordEmpty = errors.New("etcdserver: password is empty")
+
 type AuthServer struct {
 	authenticator etcdserver.Authenticator
 	// we want compile errors if new methods are added
@@ -113,6 +119,9 @@ func (as *AuthServer) RoleGrantPermission(ctx context.Context, r *pb.AuthRoleGra
 }
 
 func (as *AuthServer) UserAdd(ctx context.Context, r *pb.AuthUserAddRequest) (*pb.AuthUserAddResponse, error) {
+	if r.Password == "" && r.HashedPassword == "" && (r.Options == nil || !r.Options.NoPassword) {
+		return nil, togRPCError(errPasswordEmpty)
+	}
 	resp, err := as.authenticator.UserAdd(ctx, r)
 	if err != nil {
 		return nil, togRPCError(err)
@@ -161,6 +170,12 @@ func (as *AuthServer) UserRevokeRole(ctx context.Context, r *pb.AuthUserRevokeRo
 }
 
 func (as *AuthServer) UserChangePassword(ctx context.Context, r *pb.AuthUserChangePasswordRequest) (*pb.AuthUserChangePasswordResponse, error) {
+	// Note: AuthUserChangePasswordRequest has no Options field, so we cannot
+	// tell here whether the target account is passwordless; reject any blank
+	// password unconditionally.
+	if r.Password == "" && r.HashedPassword == "" {
+		return nil, togRPCError(errPasswordEmpty)
+	}
 	resp, err := as.authenticator.UserChangePassword(ctx, r)
 	if err != nil {
 		return nil, togRPCError(err)
