+// fakeAuthenticator is a minimal stand-in for etcdserver.Authenticator. It
+// never itself validates passwords: UserAdd/UserChangePassword always
+// "succeed" and record whether they were called, so tests can tell whether a
+// request reached the domain layer at all.
+type fakeAuthenticator struct {
+	userAddCalled            bool
+	userChangePasswordCalled bool
+}
+
+func (f *fakeAuthenticator) AuthEnable(context.Context, *pb.AuthEnableRequest) (*pb.AuthEnableResponse, error) {
+	return &pb.AuthEnableResponse{}, nil
+}
+
+func (f *fakeAuthenticator) AuthDisable(context.Context, *pb.AuthDisableRequest) (*pb.AuthDisableResponse, error) {
+	return &pb.AuthDisableResponse{}, nil
+}
+
+func (f *fakeAuthenticator) AuthStatus(context.Context, *pb.AuthStatusRequest) (*pb.AuthStatusResponse, error) {
+	return &pb.AuthStatusResponse{}, nil
+}
+
+func (f *fakeAuthenticator) Authenticate(context.Context, *pb.AuthenticateRequest) (*pb.AuthenticateResponse, error) {
+	return &pb.AuthenticateResponse{}, nil
+}
+
+func (f *fakeAuthenticator) UserAdd(context.Context, *pb.AuthUserAddRequest) (*pb.AuthUserAddResponse, error) {
+	f.userAddCalled = true
+	return &pb.AuthUserAddResponse{}, nil
+}
+
+func (f *fakeAuthenticator) UserDelete(context.Context, *pb.AuthUserDeleteRequest) (*pb.AuthUserDeleteResponse, error) {
+	return &pb.AuthUserDeleteResponse{}, nil
+}
+
+func (f *fakeAuthenticator) UserChangePassword(context.Context, *pb.AuthUserChangePasswordRequest) (*pb.AuthUserChangePasswordResponse, error) {
+	f.userChangePasswordCalled = true
+	return &pb.AuthUserChangePasswordResponse{}, nil
+}
+
+func (f *fakeAuthenticator) UserGrantRole(context.Context, *pb.AuthUserGrantRoleRequest) (*pb.AuthUserGrantRoleResponse, error) {
+	return &pb.AuthUserGrantRoleResponse{}, nil
+}
+
+func (f *fakeAuthenticator) UserGet(context.Context, *pb.AuthUserGetRequest) (*pb.AuthUserGetResponse, error) {
+	return &pb.AuthUserGetResponse{}, nil
+}
+
+func (f *fakeAuthenticator) UserRevokeRole(context.Context, *pb.AuthUserRevokeRoleRequest) (*pb.AuthUserRevokeRoleResponse, error) {
+	return &pb.AuthUserRevokeRoleResponse{}, nil
+}
+
+func (f *fakeAuthenticator) RoleAdd(context.Context, *pb.AuthRoleAddRequest) (*pb.AuthRoleAddResponse, error) {
+	return &pb.AuthRoleAddResponse{}, nil
+}
+
+func (f *fakeAuthenticator) RoleGrantPermission(context.Context, *pb.AuthRoleGrantPermissionRequest) (*pb.AuthRoleGrantPermissionResponse, error) {
+	return &pb.AuthRoleGrantPermissionResponse{}, nil
+}
+
+func (f *fakeAuthenticator) RoleGet(context.Context, *pb.AuthRoleGetRequest) (*pb.AuthRoleGetResponse, error) {
+	return &pb.AuthRoleGetResponse{}, nil
+}
+
+func (f *fakeAuthenticator) RoleRevokePermission(context.Context, *pb.AuthRoleRevokePermissionRequest) (*pb.AuthRoleRevokePermissionResponse, error) {
+	return &pb.AuthRoleRevokePermissionResponse{}, nil
+}
+
+func (f *fakeAuthenticator) RoleDelete(context.Context, *pb.AuthRoleDeleteRequest) (*pb.AuthRoleDeleteResponse, error) {
+	return &pb.AuthRoleDeleteResponse{}, nil
+}
+
+func (f *fakeAuthenticator) UserList(context.Context, *pb.AuthUserListRequest) (*pb.AuthUserListResponse, error) {
+	return &pb.AuthUserListResponse{}, nil
+}
+
+func (f *fakeAuthenticator) RoleList(context.Context, *pb.AuthRoleListRequest) (*pb.AuthRoleListResponse, error) {
+	return &pb.AuthRoleListResponse{}, nil
