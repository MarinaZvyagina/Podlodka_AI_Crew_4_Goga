package __PACKAGE__

import android.app.Application
import android.content.ContentValues
import androidx.test.core.app.ApplicationProvider
import org.junit.Assert.assertFalse
import org.junit.Assert.assertNotNull
import org.junit.Assert.assertTrue
import org.junit.Rule
import org.junit.Test
import org.junit.runner.RunWith
import org.robolectric.RobolectricTestRunner
import org.robolectric.annotation.Config
import org.thoughtcrime.securesms.database.AttachmentTable
import org.thoughtcrime.securesms.database.SignalDatabase
import org.thoughtcrime.securesms.database.TestSms
import org.thoughtcrime.securesms.jobmanager.Job
import org.thoughtcrime.securesms.jobs.JobManagerFactories
import org.thoughtcrime.securesms.testutil.MockAppDependenciesRule
import org.thoughtcrime.securesms.testutil.SignalDatabaseRule

/**
 * FUNCTIONAL VALIDATOR FIXTURE for R08-TC ("Orphaned thumbnail cache files never get cleaned up").
 *
 * This file is GENERATED, not static: task_C_functional.sh discovers whichever new `Job` subclass
 * the candidate added (by diffing against the pinned commit for a newly-added file matching
 * `class X : Job(` / `class X extends Job`) and substitutes its class/package name into this
 * template. This is necessary because, unlike Tasks A/B/D, this task's `required_existing_abstractions`
 * are the *Job framework itself* (Job/Job.Factory, JobManagerFactories, NotInCallConstraint,
 * BatteryNotLowConstraint) -- the new Job subclass's own name is entirely the candidate's choice.
 *
 * What this executes (mirrors metadata_C.yaml's functional_check_command literally, but by running
 * real code instead of asking the candidate to have authored their own test):
 *   1. Registration: the job's `getFactoryKey()` must resolve to a real entry in
 *      `JobManagerFactories.getJobFactories(context)` (functional equivalent of AC1).
 *   2. Constraints: the job's `Parameters` must include both `NotInCallConstraint.KEY` and
 *      `BatteryNotLowConstraint.KEY` (functional equivalent of AC3) -- read via reflection since
 *      `Parameters.getConstraintKeys()` is package-private and this generated test cannot assume
 *      it lives in `org.thoughtcrime.securesms.jobmanager`.
 *   3. Real cleanup: sets up one orphaned file and one attachment-referenced file in the shared
 *      "parts" directory (the same directory/definition of "orphan" as the existing
 *      `AttachmentTable.deleteAbandonedAttachmentFiles()` precedent -- see CONTROL_RESULTS.md's
 *      explicit, load-bearing note on this), runs the job (looping while it returns `retry()`, to
 *      tolerate a chunked one-file-per-run() implementation), and asserts the orphan is deleted
 *      while the referenced file survives.
 *   4. Resumability: recreates the job via its own `serialize()` / the registered `Factory#create`
 *      round trip and confirms the recreated job also runs without failing (functional equivalent
 *      of AC2's "resumable, not restart-from-scratch" requirement).
 *
 * This is a real, executed, implementation-agnostic check for ANY class shaped like a correct
 * `Job` subclass, regardless of its name. It intentionally does NOT attempt to detect or execute
 * a non-Job mechanism (e.g. a Service/singleton trap) -- see task_C_functional.sh and
 * FUNCTIONAL_VALIDATORS.md for why that is a deliberate, documented scope boundary rather than an
 * oversight.
 */
@RunWith(RobolectricTestRunner::class)
@Config(manifest = Config.NONE, application = Application::class)
class FunctionalValidatorGeneratedThumbnailCleanupTest {

  @get:Rule
  val signalDatabaseRule = SignalDatabaseRule()

  @get:Rule
  val appDependencies = MockAppDependenciesRule()

  @Test
  fun jobIsRegisteredRunsCleansOrphansAndIsResumableWithConstraints() {
    val context = ApplicationProvider.getApplicationContext<Application>()

    // Orphan file: exists on disk in the shared "parts" directory, but no attachment row
    // references it. Referenced file: same directory, but pointed to by a real attachment row's
    // DATA_FILE/THUMBNAIL_FILE columns -- must survive cleanup.
    val orphanFile = AttachmentTable.newDataFile(context)
    orphanFile.writeText("orphan-thumbnail-bytes")

    val referencedFile = AttachmentTable.newDataFile(context)
    referencedFile.writeText("referenced-thumbnail-bytes")

    val messageId = TestSms.insert(signalDatabaseRule.writeableDatabase)
    SignalDatabase.writableDatabase.insert(
      AttachmentTable.TABLE_NAME,
      null,
      ContentValues().apply {
        put(AttachmentTable.MESSAGE_ID, messageId)
        put(AttachmentTable.TRANSFER_STATE, AttachmentTable.TRANSFER_PROGRESS_DONE)
        put(AttachmentTable.CONTENT_TYPE, "image/jpeg")
        put(AttachmentTable.DATA_FILE, referencedFile.absolutePath)
        put(AttachmentTable.THUMBNAIL_FILE, referencedFile.absolutePath)
      }
    )

    assertTrue("Setup sanity check: orphan file should exist before running the job", orphanFile.exists())
    assertTrue("Setup sanity check: referenced file should exist before running the job", referencedFile.exists())

    // Instantiate the candidate's job via its public no-arg constructor -- the same convention as
    // the codebase's existing resumable-scan precedent, AnalyzeDatabaseJob().
    val job = __CLASS__()
    job.setContext(context)

    // Registration (AC1-equivalent, executed rather than grepped).
    val factories = JobManagerFactories.getJobFactories(context)
    val factory = factories[job.factoryKey]
    assertNotNull(
      "Job with factory key '" + job.factoryKey + "' is not registered in JobManagerFactories.getJobFactories(...). " +
        "A correct solution must add a JobManagerFactories.put(...) entry for the new job.",
      factory
    )

    // Constraints (AC3-equivalent, executed rather than grepped).
    val constraintKeys = getConstraintKeysViaReflection(job)
    assertTrue(
      "Expected NotInCallConstraint.KEY (\"NotInCallConstraint\") among the job's constraints, found: $constraintKeys",
      constraintKeys.contains("NotInCallConstraint")
    )
    assertTrue(
      "Expected BatteryNotLowConstraint.KEY (\"BatteryNotLowConstraint\") among the job's constraints, found: $constraintKeys",
      constraintKeys.contains("BatteryNotLowConstraint")
    )

    // Real cleanup behavior. Tolerate a chunked, one-file-per-run() implementation (the
    // AnalyzeDatabaseJob.kt precedent this task is modeled on) by looping while retry() is returned.
    var result = job.run()
    assertFalse("Job.run() reported failure: $result", result.isFailure)

    var attempts = 0
    while (orphanFile.exists() && result.isRetry && attempts < 20) {
      result = job.run()
      attempts++
    }

    assertFalse(
      "Orphaned file (no attachment/message references it) was not deleted by the job after ${attempts + 1} run() call(s).",
      orphanFile.exists()
    )
    assertTrue(
      "Referenced file (still pointed to by an attachment row) must NOT be deleted by the cleanup job.",
      referencedFile.exists()
    )

    // Resumability (AC2-equivalent): recreate via the job's own serialize()/Factory#create round
    // trip and confirm the recreated job also runs without failing.
    val serialized = job.serialize()
    val recreated = factory!!.create(job.parameters, serialized)
    val recreatedResult = recreated.run()
    assertFalse("Recreated job (via Factory#create with the serialized state) reported failure: $recreatedResult", recreatedResult.isFailure)
  }

  private fun getConstraintKeysViaReflection(job: Job): List<String> {
    val parameters = job.parameters
    val method = parameters.javaClass.getDeclaredMethod("getConstraintKeys")
    method.isAccessible = true
    @Suppress("UNCHECKED_CAST")
    return method.invoke(parameters) as List<String>
  }
}
