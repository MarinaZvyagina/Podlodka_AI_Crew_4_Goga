diff --git a/tests/test_configuration.py b/tests/test_configuration.py
index 59516f6..853ef35 100644
--- a/tests/test_configuration.py
+++ b/tests/test_configuration.py
@@ -1061,6 +1061,24 @@ def test__validate_demo_trading(default_conf_usdt) -> None:
     validate_config_consistency(conf)
 
 
+def test__validate_available_capital(default_conf_usdt) -> None:
+    conf = deepcopy(default_conf_usdt)
+    validate_config_consistency(conf)
+
+    conf["available_capital"] = 100
+    conf["tradable_balance_ratio"] = 0.5
+
+    with pytest.raises(
+        ConfigurationError,
+        match=r"Both `available_capital` and `tradable_balance_ratio` are set.*",
+    ):
+        validate_config_consistency(conf)
+
+    # Only available_capital set - should pass.
+    del conf["tradable_balance_ratio"]
+    validate_config_consistency(conf)
+
+
