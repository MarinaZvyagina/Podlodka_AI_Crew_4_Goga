--- a/server/auth/store_test.go
+++ b/server/auth/store_test.go
@@ -174,6 +174,22 @@ func TestUserAdd(t *testing.T) {
 	require.Truef(t, ok, "user %s should be added but it doesn't exist in rangePermCache", userName)
 }
 
+func TestUserAddWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	ua := &pb.AuthUserAddRequest{Name: "empty-pass", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a passwordless (no-password) account must still be creatable with an empty password
+	ua = &pb.AuthUserAddRequest{Name: "empty-pass-nopassword", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
 func TestRecover(t *testing.T) {
 	as, tearDown := setupAuthStore(t)
 	defer as.Close()
@@ -1177,3 +1193,23 @@ func TestUserChangePasswordWithOldLog(t *testing.T) {
 	require.Errorf(t, err, "expected %v, got %v", ErrUserNotFound, err)
 	require.ErrorIsf(t, err, ErrUserNotFound, "expected %v, got %v", ErrUserNotFound, err)
 }
+
+func TestUserChangePasswordWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	_, err := as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo"})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// changing the password of a passwordless (no-password) account to empty must still work
+	username := "nopass-changepw"
+	ua := &pb.AuthUserAddRequest{Name: username, Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: username})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
