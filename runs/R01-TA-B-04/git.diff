     _validate_price_config(conf)
+    _validate_capital_config(conf)
     _validate_edge(conf)
     _validate_whitelist(conf)
     _validate_unlimited_amount(conf)
@@ -125,6 +126,21 @@ def _validate_price_config(conf: dict[str, Any]) -> None:
         raise ConfigurationError('Market exit orders require exit_pricing.price_side = "other".')
 
 
+def _validate_capital_config(conf: dict[str, Any]) -> None:
+    """
+    `available_capital` and `tradable_balance_ratio` are mutually exclusive - only one of
+    them is ever used to size the starting balance. Having both set leads users to believe
+    they combine, when in fact one of them is silently ignored.
+    """
+    if "available_capital" in conf and "tradable_balance_ratio" in conf:
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in the config. "
+            "Only one of these settings can be in effect at a time - "
+            "`available_capital` takes precedence and `tradable_balance_ratio` will be "
+            "ignored. Please remove one of these settings from your configuration."
+        )
+
+
