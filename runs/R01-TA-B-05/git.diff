+def _validate_capital_settings(conf: dict[str, Any]) -> None:
+    """
+    `available_capital` takes precedence over `tradable_balance_ratio` - having both set is
+    likely a mistake, since one of them will be silently ignored.
+    :raise: ConfigurationError if config validation failed
+    """
+    if "available_capital" in conf and "tradable_balance_ratio" in conf:
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in the config, "
+            "which is not allowed. `available_capital` takes precedence and "
+            "`tradable_balance_ratio` will be ignored. Please remove one of them."
+        )
+
