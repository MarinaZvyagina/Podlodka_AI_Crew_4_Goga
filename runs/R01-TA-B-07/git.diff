@@ -110,6 +111,24 @@ def _validate_unlimited_amount(conf: dict[str, Any]) -> None:
         raise ConfigurationError("`max_open_trades` and `stake_amount` cannot both be unlimited.")
 
 
+def _validate_capital_settings(conf: dict[str, Any]) -> None:
+    """
+    available_capital and tradable_balance_ratio both influence the starting capital used for
+    trading, but only one of them is ever applied - available_capital takes precedence and
+    tradable_balance_ratio is silently ignored when both are set.
+    """
+    tradable_balance_ratio_default = CONF_SCHEMA["properties"]["tradable_balance_ratio"]["default"]
+    if "available_capital" in conf and conf.get(
+        "tradable_balance_ratio", tradable_balance_ratio_default
+    ) != tradable_balance_ratio_default:
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in your "
+            "configuration. Only `available_capital` will be used to determine your starting "
+            "capital - `tradable_balance_ratio` will be ignored. Please remove one of these "
+            "settings."
+        )
+
