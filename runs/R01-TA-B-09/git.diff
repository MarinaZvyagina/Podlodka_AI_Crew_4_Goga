+def _validate_capital_settings(conf: dict[str, Any]) -> None:
+    """
+    Only one of `available_capital` and `tradable_balance_ratio` is ever used to size the
+    starting capital - the other is silently ignored. Setting both is almost always a
+    misconfiguration, so fail fast instead of letting the bot silently pick one.
+    """
+    tradable_balance_ratio_default = CONF_SCHEMA["properties"]["tradable_balance_ratio"][
+        "default"
+    ]
+    if "available_capital" in conf and conf.get(
+        "tradable_balance_ratio", tradable_balance_ratio_default
+    ) != tradable_balance_ratio_default:
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in the configuration. "
+            "Only one of these settings is used to determine your starting capital - the other "
+            "will be silently ignored. Please remove one of these settings."
+        )
+
