+def _validate_capital_settings(conf: dict[str, Any]) -> None:
+    """
+    available_capital and tradable_balance_ratio both influence how much starting
+    capital is used for trading, but only one of them is ever actually applied
+    (available_capital takes precedence, tradable_balance_ratio is then ignored).
+    Setting both is almost always a misconfiguration, so fail fast instead of
+    silently ignoring one of them.
+    """
+    if "available_capital" not in conf:
+        return
+
+    tradable_balance_ratio_default = CONF_SCHEMA["properties"]["tradable_balance_ratio"][
+        "default"
+    ]
+    if conf.get("tradable_balance_ratio", tradable_balance_ratio_default) != (
+        tradable_balance_ratio_default
+    ):
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in your "
+            "configuration. Only one of these settings is ever used to determine your "
+            "starting trading capital - `available_capital` takes precedence and "
+            "`tradable_balance_ratio` will be ignored. Please remove one of these settings."
+        )
+
