+def test_validate_capital_config(default_conf):
+    conf = deepcopy(default_conf)
+    conf["available_capital"] = 1000
+    conf["tradable_balance_ratio"] = 0.5
+    with pytest.raises(
+        OperationalException,
+        match=r"Both `available_capital` and `tradable_balance_ratio` are set.*",
+    ):
+        validate_config_consistency(conf)
+
+    # Only available_capital set - should pass.
+    conf = deepcopy(default_conf)
+    conf["available_capital"] = 1000
+    conf.pop("tradable_balance_ratio", None)
+    validate_config_consistency(conf)
+
+    # Only tradable_balance_ratio set - should pass.
+    conf = deepcopy(default_conf)
+    conf.pop("available_capital", None)
+    conf["tradable_balance_ratio"] = 0.5
+    validate_config_consistency(conf)
+
+    # Re-validating an already-validated config (tradable_balance_ratio now defaulted onto
+    # the dict) with only available_capital set must not raise a false positive.
+    conf = deepcopy(default_conf)
+    conf["available_capital"] = 1000
+    conf.pop("tradable_balance_ratio", None)
+    validate_config_consistency(conf)
+    assert "tradable_balance_ratio" in conf
+    validate_config_consistency(conf)
+
