+def _validate_capital_config(conf: dict[str, Any]) -> None:
+    """
+    `available_capital` and `tradable_balance_ratio` both influence the starting capital used
+    for trading, but only one of them is ever actually applied - if `available_capital` is set,
+    `tradable_balance_ratio` is ignored entirely. Warn upfront if both appear to be configured,
+    since only one setting takes effect and the other is silently ignored.
+    Note: `tradable_balance_ratio` defaults to a non-zero value, and this default gets written
+    back into the config during schema validation - so a value matching the schema default is
+    not treated as "explicitly set" here, to avoid false positives on configs that only set
+    `available_capital` and never touched `tradable_balance_ratio`.
+    :raise: ConfigurationError if config validation failed
+    """
+    tbr_default = CONF_SCHEMA["properties"]["tradable_balance_ratio"]["default"]
+    if (
+        "available_capital" in conf
+        and conf.get("tradable_balance_ratio", tbr_default) != tbr_default
+    ):
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in the "
+            "configuration, but only one of them is ever used - `available_capital`, if set, "
+            "takes precedence and `tradable_balance_ratio` is silently ignored. "
+            "Please remove one of these settings."
+        )
+
