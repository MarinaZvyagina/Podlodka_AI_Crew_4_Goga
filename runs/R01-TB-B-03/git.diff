+            strategy=backtesting.strategy.get_strategy_name(),
+            timeframe=5,
+        )
+        LocalTrade.bt_trades_open.append(t)
+        backtesting.wallets.update()
+
+    with FtNoDBContext():
+        total_stake = backtesting.wallets.get_total_stake_amount()
+        cap = total_stake * 0.3
+
+        # No open trades yet - the requested stake fits comfortably under the cap.
+        trade = backtesting._enter_trade(pair, row=row, direction="long")
+        assert trade is not None
+        assert trade.stake_amount == 100
+        LocalTrade.bt_trades_open.clear()
+
+        # Existing exposure to the same underlying currency leaves only part of the
+        # requested stake available - the new trade is sized down to fit.
+        add_existing_trade(cap - 40)
+        print("DEBUG open trades:", list(Trade.get_open_trades()))
