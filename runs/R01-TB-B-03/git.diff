+    def get_currency_exposure_headroom(self, pair: str) -> float | None:
+        """
+        Remaining stake amount that can be committed to `pair` without breaching the
+        configured `max_currency_exposure` limit for its underlying currency.
+        :return: None if no limit is configured, otherwise the remaining headroom
+        (may be zero or negative if the limit is already reached/exceeded).
+        """
+        max_currency_exposure = self._config.get("max_currency_exposure")
+        if max_currency_exposure is None:
+            return None
+        currency = self._exchange.get_pair_base_currency(pair)
+        max_currency_stake = self.get_total_stake_amount() * max_currency_exposure
+        return max_currency_stake - self._get_currency_exposure(currency)
