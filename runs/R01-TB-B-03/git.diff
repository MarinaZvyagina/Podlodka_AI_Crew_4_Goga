+        """
+        Sum of stake amounts currently committed to open trades whose pair shares the
+        given underlying (base) currency.
+        """
+        return sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if trade.safe_base_currency == currency
