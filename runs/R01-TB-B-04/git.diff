@@ -407,6 +407,43 @@ class Wallets:
 
         return self._check_available_stake_amount(stake_amount, available_amount)
 
+    def _get_underlying_currency_exposure(self, currency: str) -> float:
+        """
+        Sum of stake_amount currently committed to open trades sharing the given
+        underlying (quote/settlement) currency.
+        """
+        return sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if trade.safe_quote_currency == currency
+        )
+
+    def _apply_max_underlying_exposure(self, pair: str, max_allowed_stake: float) -> float:
+        """
+        Limit max_allowed_stake so that combined exposure to the pair's underlying
+        (quote/settlement) currency across all open trades stays within the
+        configured `max_underlying_exposure` share of tradable capital.
+        """
+        max_exposure_ratio = self._config.get("max_underlying_exposure")
+        if not max_exposure_ratio:
+            return max_allowed_stake
+
+        currency = self._exchange.get_pair_quote_currency(pair)
+        max_currency_stake = self.get_total_stake_amount() * max_exposure_ratio
+        committed = self._get_underlying_currency_exposure(currency)
+        remaining_for_currency = max(max_currency_stake - committed, 0)
+
+        if remaining_for_currency < max_allowed_stake:
+            self._local_log(
+                f"Cannot commit more than {max_exposure_ratio:.2%} of tradable capital to "
+                f"trades underlying {currency} ({committed:.8f} already committed of "
+                f"{max_currency_stake:.8f} {currency} allowed). Limiting stake amount for "
+                f"{pair} to {remaining_for_currency:.8f}.",
+                level="warning" if remaining_for_currency <= 0 else "info",
+            )
+            return remaining_for_currency
+        return max_allowed_stake
+
