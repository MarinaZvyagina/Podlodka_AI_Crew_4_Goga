+def test_execute_entry_max_underlying_exposure_live_parity(
+    default_conf, ticker, limit_buy_order_open, fee, mocker
+) -> None:
+    """
+    The max_underlying_exposure cap must produce identical sizing whether trades are
+    opened through the live/dry-run path (execute_entry) or the backtesting path
+    (see test_backtest__enter_trade_max_underlying_exposure) for the same config.
+    """
+    mocker.patch.multiple(
+        EXMS,
+        fetch_ticker=ticker,
+        create_order=MagicMock(return_value=limit_buy_order_open),
+        get_fee=fee,
+    )
+    default_conf["stake_amount"] = UNLIMITED_STAKE_AMOUNT
+    default_conf["dry_run_wallet"] = 1000
+    default_conf["max_open_trades"] = 2
+    default_conf["max_underlying_exposure"] = 0.3
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    result = freqtrade.wallets.get_trade_stake_amount("ETH/BTC", 2)
+    assert freqtrade.execute_entry("ETH/BTC", result)
+    trade = Trade.get_open_trades()[0]
+    assert trade.stake_amount == 297
+
+    result = freqtrade.wallets.get_trade_stake_amount("LTC/BTC", 2)
+    assert not freqtrade.execute_entry("LTC/BTC", result)
+
+
+def test_validate_stake_amount_max_underlying_exposure(mocker, default_conf, caplog):
+    default_conf["max_underlying_exposure"] = 0.5
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=1000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+    usdt_trade = MagicMock(stake_amount=400, safe_quote_currency="USDT")
+    mocker.patch("freqtrade.wallets.Trade.get_open_trades", return_value=[usdt_trade])
+
+    # max_currency_stake = 1000 * 0.5 = 500; already committed to USDT = 400
+    # -> only 100 left for another USDT-underlying trade
+    res = freqtrade.wallets.validate_stake_amount("XRP/USDT", 300, 11, 10000, None)
+    assert res == 100
+    assert log_has_re(r"Cannot commit more than 50.00% of tradable capital.*USDT.*", caplog)
+
+    # A pair whose underlying currency differs is unaffected by USDT exposure.
+    res = freqtrade.wallets.validate_stake_amount("ETH/BTC", 300, 11, 10000, None)
+    assert res == 300
+
+    # Already at (or over) the cap -> trade fully skipped.
+    usdt_trade.stake_amount = 500
+    res = freqtrade.wallets.validate_stake_amount("XRP/USDT", 300, 11, 10000, None)
+    assert res == 0
+
+
+def test_validate_stake_amount_max_underlying_exposure_disabled(mocker, default_conf):
+    # Feature is opt-in - default config must not change existing sizing behavior.
+    assert "max_underlying_exposure" not in default_conf
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=1000)
+    usdt_trade = MagicMock(stake_amount=100000, safe_quote_currency="USDT")
+    mocker.patch("freqtrade.wallets.Trade.get_open_trades", return_value=[usdt_trade])
+
+    res = freqtrade.wallets.validate_stake_amount("XRP/USDT", 300, 11, 10000, None)
+    assert res == 300
+
