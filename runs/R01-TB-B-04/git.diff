+def test_backtest__enter_trade_max_underlying_exposure(default_conf, fee, mocker) -> None:
+    default_conf["use_exit_signal"] = False
+    mocker.patch(f"{EXMS}.get_fee", fee)
+    mocker.patch(f"{EXMS}.get_min_pair_stake_amount", return_value=0.00001)
+    mocker.patch(f"{EXMS}.get_max_pair_stake_amount", return_value=float("inf"))
+    patch_exchange(mocker)
+    default_conf["stake_amount"] = "unlimited"
+    default_conf["max_open_trades"] = 2
+    default_conf["max_underlying_exposure"] = 0.3
+    backtesting = Backtesting(default_conf)
+    backtesting._set_strategy(backtesting.strategylist[0])
+    row = [
+        pd.Timestamp(year=2020, month=1, day=1, hour=5, minute=0),
+        1,  # Buy
+        0.001,  # Open
+        0.0011,  # Close
+        0,  # Sell
+        0.00099,  # Low
+        0.0012,  # High
+        "",  # Buy Signal Name
+    ]
+    # Without the cap, unlimited stake-amount sizing would use 495 (half of the tradable pool).
+    # max_underlying_exposure=0.3 caps combined BTC exposure to 0.3 * 990 = 297.
+    trade = backtesting._enter_trade("UNITTEST/BTC", row=row, direction="long")
+    assert isinstance(trade, LocalTrade)
+    assert trade.stake_amount == 297
+
+    # A second BTC-underlying pair has no room left under the cap.
+    LocalTrade.bt_trades_open.append(trade)
+    backtesting.wallets.update()
+    trade2 = backtesting._enter_trade("ETH/BTC", row=row, direction="long")
+    assert trade2 is None
+
+
