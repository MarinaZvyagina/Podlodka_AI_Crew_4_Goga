+@pytest.mark.parametrize(
+    "pair,max_allowed_stake,expected",
+    [
+        # cap = 1000 * 0.3 = 300; ETH already has 250 committed -> 50 left.
+        ("ETH/USDT", 1000, 50),
+        # NEO has no open exposure -> capped at 300, but not raised above max_allowed_stake.
+        ("NEO/USDT", 1000, 300),
+        # max_allowed_stake already below the cap - must not be increased.
+        ("NEO/USDT", 100, 100),
+        # LTC is already at (250 >) the 300 cap via other currencies is irrelevant - only own
+        # currency's exposure (50) matters, leaving 250 of room.
+        ("LTC/USDT", 1000, 250),
+    ],
+)
+def test_apply_currency_exposure_cap(mocker, default_conf, pair, max_allowed_stake, expected):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    freqtrade.config["max_single_currency_exposure"] = 0.3
+
+    open_trades = [
+        MagicMock(pair="ETH/USDT", stake_amount=150, safe_base_currency="ETH"),
+        MagicMock(pair="ETH/USDT", stake_amount=100, safe_base_currency="ETH"),
+        MagicMock(pair="LTC/USDT", stake_amount=50, safe_base_currency="LTC"),
+    ]
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+    mocker.patch("freqtrade.persistence.Trade.get_open_trades", return_value=open_trades)
+
+    assert freqtrade.wallets._apply_currency_exposure_cap(pair, max_allowed_stake) == expected
+
+
