     assert trade.stake_amount == 300.0
 
 
+def test_backtest__enter_trade_currency_exposure_cap(default_conf, fee, mocker) -> None:
+    default_conf["use_exit_signal"] = False
+    mocker.patch(f"{EXMS}.get_fee", fee)
+    mocker.patch(f"{EXMS}.get_min_pair_stake_amount", return_value=0.00001)
+    mocker.patch(f"{EXMS}.get_max_pair_stake_amount", return_value=float("inf"))
+    patch_exchange(mocker)
+    default_conf["stake_amount"] = 500
+    default_conf["max_open_trades"] = 5
+    default_conf["max_single_currency_exposure"] = 0.3
+    backtesting = Backtesting(default_conf)
+    backtesting._set_strategy(backtesting.strategylist[0])
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+    pair = "UNITTEST/BTC"
+    row = [
+        pd.Timestamp(year=2020, month=1, day=1, hour=5, minute=0),
+        1,  # Buy
+        0.001,  # Open
+        0.0011,  # Close
+        0,  # Sell
+        0.00099,  # Low
+        0.0012,  # High
+        "",  # Buy Signal Name
+    ]
+    # cap = 1000 * 0.3 = 300 - stake is reduced below the requested 500.
+    # (_enter_trade registers the created trade into LocalTrade.bt_trades_open itself.)
+    trade = backtesting._enter_trade(pair, row=row, direction="long")
+    assert trade is not None
+    assert trade.stake_amount == 300
+    backtesting.wallets.update()
+
+    # UNITTEST exposure is already at the cap - a second trade must be rejected.
+    trade2 = backtesting._enter_trade(pair, row=row, direction="long")
+    assert trade2 is None
+
+    # A different underlying currency is unaffected by UNITTEST's exposure.
+    trade3 = backtesting._enter_trade("NEO/BTC", row=row, direction="long")
+    assert trade3 is not None
+    assert trade3.stake_amount == 300
+
+    LocalTrade.bt_trades_open.remove(trade)
+    LocalTrade.bt_trades_open.remove(trade3)
+
+
