@@ -407,6 +407,44 @@ class Wallets:
 
         return self._check_available_stake_amount(stake_amount, available_amount)
 
+    def _get_currency_exposure(self, currency: str) -> float:
+        """
+        Sum the stake amount currently committed to open trades sharing the given
+        underlying (base) currency.
+        """
+        return sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if trade.safe_base_currency == currency
+        )
+
+    def _apply_currency_exposure_cap(self, pair: str, max_allowed_stake: float) -> float:
+        """
+        Reduce max_allowed_stake so that combined open exposure to the pair's underlying
+        (base) currency does not exceed `max_single_currency_exposure` of tradable capital.
+        Pairs are grouped by base currency (e.g. BTC for both BTC/USDT and BTC/USDT:USDT).
+        """
+        exposure_limit = self._config.get("max_single_currency_exposure")
+        if exposure_limit is None:
+            return max_allowed_stake
+
+        # Mirrors LocalTrade.safe_base_currency, so pairs missing from exchange markets
+        # (e.g. not-yet-opened pairs) still group consistently with existing open trades.
+        currency = self._exchange.get_pair_base_currency(pair) or pair.split("/")[0]
+        exposure_cap = self.get_total_stake_amount() * exposure_limit
+        current_exposure = self._get_currency_exposure(currency)
+        max_exposure_stake = max(exposure_cap - current_exposure, 0)
+
+        if max_exposure_stake < max_allowed_stake:
+            self._local_log(
+                f"Stake amount for pair {pair} is limited by the "
+                f"max_single_currency_exposure cap for {currency} "
+                f"({current_exposure:.8f} already committed of {exposure_cap:.8f} allowed), "
+                f"adjusting to {max_exposure_stake:.8f}."
+            )
+            max_allowed_stake = max_exposure_stake
+        return max_allowed_stake
+
