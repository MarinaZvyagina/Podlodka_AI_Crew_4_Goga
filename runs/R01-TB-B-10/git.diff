+    def _get_max_stake_for_currency_exposure(self, pair: str) -> float:
+        """
+        Return the remaining stake amount that can still be committed to trades sharing
+        `pair`'s underlying currency without pushing the combined exposure of all
+        currently open trades in that currency over the configured
+        `max_single_currency_exposure` share of total tradable capital.
+        :return: float('inf') if the limit is not configured.
+        """
+        exposure_limit = self._config.get("max_single_currency_exposure")
+        if exposure_limit is None:
+            return float("inf")
+
+        currency = self.get_pair_underlying_currency(pair)
+        current_exposure = sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if self.get_pair_underlying_currency(trade.pair) == currency
+        )
+        max_exposure = self.get_total_stake_amount() * exposure_limit
+        return max(max_exposure - current_exposure, 0)
