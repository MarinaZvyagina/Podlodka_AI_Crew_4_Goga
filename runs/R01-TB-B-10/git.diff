+    [
+        (None, 1000, 500, 400, 400),  # disabled -> unaffected
+        (0.5, 1000, 200, 400, 300),  # capped: cap=500, remaining=300
+        (0.5, 1000, 500, 100, 0),  # already at cap -> blocked entirely
+        (0.9, 1000, 100, 400, 400),  # within cap -> unaffected
+    ],
+)
+def test_validate_stake_amount_max_currency_exposure(
+    mocker,
+    default_conf,
+    exposure_limit,
+    total_stake,
+    current_exposure,
+    proposed_stake,
+    expected,
+):
+    if exposure_limit is not None:
+        default_conf["max_single_currency_exposure"] = exposure_limit
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=10000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=total_stake)
+    existing_trade = MagicMock(pair="ETH/USDT", stake_amount=current_exposure)
+    mocker.patch(
+        "freqtrade.persistence.models.Trade.get_open_trades", return_value=[existing_trade]
+    )
+    mocker.patch(f"{EXMS}.get_pair_quote_currency", return_value="USDT")
+
+    res = freqtrade.wallets.validate_stake_amount("XRP/USDT", proposed_stake, 10, 10000, None)
+    assert res == expected
+
+
+def test_validate_stake_amount_max_currency_exposure_groups_by_currency(mocker, default_conf):
