+    def _get_underlying_currency(self, pair: str) -> str:
+        """
+        Currency a pair's positions are effectively settled/collateralized in.
+        Falls back to the pair's quote currency for markets without a distinct
+        settlement currency (spot, or linear futures settled in the quote currency) -
+        this is what groups e.g. several stablecoin-quoted spot pairs together.
+        """
+        return self._exchange.get_pair_settle_currency(
+            pair
+        ) or self._exchange.get_pair_quote_currency(pair)
+
+    def get_underlying_exposure(self, underlying: str) -> float:
+        """
+        Sum of stake_amount currently committed to all open trades sharing the given
+        underlying currency.
+        """
+        return sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if self._get_underlying_currency(trade.pair) == underlying
+        )
+
+    def _apply_underlying_exposure_limit(self, pair: str, max_allowed_stake: float) -> float:
+        """
+        Cap max_allowed_stake so opening/increasing a position in `pair` cannot push the
+        combined stake committed to its underlying currency above the strategy-configured
+        `max_underlying_exposure` share of total tradable capital.
+        """
+        exposure_ratio = self._config.get("max_underlying_exposure")
+        if not exposure_ratio:
+            return max_allowed_stake
+
+        underlying = self._get_underlying_currency(pair)
+        if not underlying:
+            return max_allowed_stake
+
+        current_exposure = self.get_underlying_exposure(underlying)
+        max_underlying_stake = self.get_total_stake_amount() * exposure_ratio
+        available_for_underlying = max(max_underlying_stake - current_exposure, 0)
+
+        if available_for_underlying < max_allowed_stake:
+            self._local_log(
+                f"Underlying exposure limit for {underlying} restricts stake for {pair} to "
+                f"{available_for_underlying:.8f} {self._stake_currency} (already committed "
+                f"{current_exposure:.8f}, limit {max_underlying_stake:.8f} = "
+                f"{exposure_ratio:.2%} of total capital)."
+            )
+        return min(max_allowed_stake, available_for_underlying)
+
