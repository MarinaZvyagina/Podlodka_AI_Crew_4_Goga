+def test_get_underlying_exposure(mocker, default_conf, fee):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    # BTC-quoted spot pairs share "BTC" as underlying currency (settle falls back to quote).
+    _open_trade("ETH/BTC", 10.0, fee)
+    _open_trade("LTC/BTC", 5.0, fee)
+    _open_trade("ETH/USDT", 7.0, fee)
+    Trade.commit()
+
+    assert freqtrade.wallets.get_underlying_exposure("BTC") == 15.0
+    assert freqtrade.wallets.get_underlying_exposure("USDT") == 7.0
+    assert freqtrade.wallets.get_underlying_exposure("ETH") == 0.0
+
+
+def test_validate_stake_amount_underlying_exposure(mocker, default_conf, fee, caplog):
+    # default_conf's stake_currency is BTC - ETH/BTC and XRP/BTC/LTC/BTC share "BTC" exposure.
+    default_conf["max_underlying_exposure"] = 0.5
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=1000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+
+    # No open trades yet - up to 50% of 1000 (=500) may be committed to BTC-underlying trades.
+    res = freqtrade.wallets.validate_stake_amount("ETH/BTC", 400, None, 10000, None)
+    assert res == 400
+
+    # Open a BTC-quoted trade tying up 450 of the 500 allowed for the "BTC" underlying.
+    _open_trade("LTC/BTC", 450, fee)
+    Trade.commit()
+
+    # Only 50 remain for BTC exposure - stake is sized down to fit under the cap.
+    res = freqtrade.wallets.validate_stake_amount("ETH/BTC", 400, None, 10000, None)
+    assert res == 50
+    assert log_has_re(r"Underlying exposure limit for BTC restricts stake for ETH/BTC.*", caplog)
+
+    # A pair with a different underlying currency is unaffected.
+    res = freqtrade.wallets.validate_stake_amount("ETH/USDT", 400, None, 10000, None)
+    assert res == 400
+
+    # Exhaust the BTC exposure limit entirely - new BTC-underlying trades are rejected.
+    _open_trade("ETH/BTC", 50, fee)
+    Trade.commit()
+
+    res = freqtrade.wallets.validate_stake_amount("XRP/BTC", 10, None, 10000, None)
+    assert res == 0
+
+
