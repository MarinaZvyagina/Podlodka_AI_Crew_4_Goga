+@pytest.mark.parametrize("only_per_pair", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses_perpair(mocker, default_conf, fee, caplog, only_per_pair):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 400,
+            "stop_duration": 60,
+            "trade_limit": 3,
+            "only_per_pair": only_per_pair,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped for .* due to .* consecutive losses\."
+    pair = "XRP/BTC"
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2 losing trades in a row - not enough yet.
+    for min_ago in (250, 150):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.STOP_LOSS.value,
+            min_ago_open=min_ago + 20,
+            min_ago_close=min_ago,
+            profit_rate=0.9,
+        )
+    Trade.commit()
+
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not PairLocks.is_pair_locked(pair)
+    assert not PairLocks.is_global_lock()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 3rd loss in a row triggers the streak protection.
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=70,
+        min_ago_close=50,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+
+    assert freqtrade.protections.stop_per_pair(pair)
+    assert PairLocks.is_pair_locked(pair)
+    assert log_has_re(message, caplog)
+    assert freqtrade.protections.global_stop() != only_per_pair
+    assert PairLocks.is_global_lock() != only_per_pair
+
+
+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses_streak_reset_by_win(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 400,
+            "stop_duration": 60,
+            "trade_limit": 2,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    pair = "XRP/BTC"
+
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=220,
+        min_ago_close=200,
+        profit_rate=0.9,
+    )
+    # A winning trade breaks the losing streak.
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        min_ago_open=150,
+        min_ago_close=130,
+        profit_rate=1.15,
+    )
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=70,
+        min_ago_close=50,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+
+    # Only 1 loss since the last win - streak of 2 not reached.
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not PairLocks.is_pair_locked(pair)
+
