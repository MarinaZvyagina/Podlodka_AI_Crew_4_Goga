+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 600,
+            "stop_duration": 60,
+            "trade_limit": 3,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*consecutive losses.*"
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 1st loss
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=200,
+        min_ago_close=90,
+        profit_rate=0.9,
+    )
+    assert not freqtrade.protections.global_stop()
+    caplog.clear()
+
+    # Winning trade - breaks any streak so far.
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        min_ago_open=150,
+        min_ago_close=60,
+        profit_rate=1.15,
+    )
+    assert not freqtrade.protections.global_stop()
+    caplog.clear()
+
+    # 2 losses in a row (streak restarts after the win above)
+    generate_mock_trade(
+        "LTC/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=100,
+        min_ago_close=45,
+        profit_rate=0.9,
+    )
+    generate_mock_trade(
+        "BCH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=80,
+        min_ago_close=30,
+        profit_rate=0.9,
+    )
+    # Only 2 consecutive losses so far - not locked yet.
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 3rd consecutive loss - now locks bot-wide.
+    generate_mock_trade(
+        "NEO/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=60,
+        min_ago_close=15,
+        profit_rate=0.9,
+    )
+    assert freqtrade.protections.global_stop()
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_global_lock()
+
+
+@pytest.mark.parametrize("only_per_pair", [False, True])
+@pytest.mark.parametrize("only_per_side", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses_perpair(
+    mocker, default_conf, fee, caplog, only_per_pair, only_per_side
+):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 600,
+            "trade_limit": 2,
+            "stop_duration": 60,
+            "only_per_pair": only_per_pair,
+            "only_per_side": only_per_side,
+        }
+    ]
+    check_side = "long" if only_per_side else "*"
+    is_short = False
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*consecutive losses.*"
+    pair = "XRP/BTC"
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 1st loss for the pair.
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=200,
+        min_ago_close=90,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # Unrelated pair losing does not affect this pair's streak.
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=180,
+        min_ago_close=80,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    caplog.clear()
+
+    # 2nd loss for the pair, but on the opposite side.
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=150,
+        min_ago_close=70,
+        profit_rate=0.9,
+        is_short=not is_short,
+    )
+    # Locked only if we consider both sides together.
+    assert freqtrade.protections.stop_per_pair(pair) != only_per_side
+    assert freqtrade.protections.global_stop() != only_per_pair
+    caplog.clear()
+
+    # 2nd loss for the pair, on the original side.
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=100,
+        min_ago_close=50,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    assert freqtrade.protections.stop_per_pair(pair)
+    assert freqtrade.protections.global_stop() != only_per_pair
+    assert PairLocks.is_pair_locked(pair, side=check_side)
+    assert PairLocks.is_global_lock(side=check_side) != only_per_pair
+
