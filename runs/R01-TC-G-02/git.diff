+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 1000,
+            "stop_duration": 40,
+            "trade_limit": 3,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*"
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    for pair, min_ago_close in (("XRP/BTC", 60), ("BCH/BTC", 50)):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.EXIT_SIGNAL.value,
+            profit_rate=0.9,
+            min_ago_open=200,
+            min_ago_close=min_ago_close,
+        )
+    # Only 2 losses in a row so far - below the configured trade_limit of 3
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # A winning trade breaks the losing streak
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        profit_rate=1.1,
+        min_ago_open=45,
+        min_ago_close=40,
+    )
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    for pair, min_ago_close in (("LTC/BTC", 30), ("ADA/BTC", 25)):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.EXIT_SIGNAL.value,
+            profit_rate=0.9,
+            min_ago_open=35,
+            min_ago_close=min_ago_close,
+        )
+    # Streak was reset by the win above - only 2 consecutive losses again
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 3rd consecutive loss in a row (spanning multiple pairs) triggers the bot-wide lock
+    generate_mock_trade(
+        "DOT/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        profit_rate=0.9,
+        min_ago_open=15,
+        min_ago_close=5,
+    )
+    assert freqtrade.protections.global_stop()
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_global_lock()
+
+
+@pytest.mark.parametrize("only_per_pair", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses_perpair(mocker, default_conf, fee, caplog, only_per_pair):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 1000,
+            "trade_limit": 2,
+            "stop_duration": 60,
+            "only_per_pair": only_per_pair,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*"
+    pair = "XRP/BTC"
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        profit_rate=0.9,
+        min_ago_open=200,
+        min_ago_close=60,
+    )
+    # A loss on a different pair doesn't extend this pair's own streak
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        profit_rate=0.9,
+        min_ago_open=190,
+        min_ago_close=50,
+    )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2nd consecutive loss for this pair completes the pair-level streak
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        profit_rate=0.9,
+        min_ago_open=45,
+        min_ago_close=30,
+    )
+
+    assert freqtrade.protections.stop_per_pair(pair)
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_pair_locked(pair)
+    caplog.clear()
+
+    # Globally, the 2 most recent trades overall are also both losses
+    assert freqtrade.protections.global_stop() != only_per_pair
+    assert PairLocks.is_global_lock() != only_per_pair
+
