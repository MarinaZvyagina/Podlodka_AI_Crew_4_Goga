+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 1000,
+            "stop_duration": 60,
+            "trade_limit": 3,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .* consecutive losses.*"
+    pair = "XRP/BTC"
+    assert not freqtrade.protections.global_stop()
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2 losses in a row - not enough to lock yet
+    for i in range(2):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.STOP_LOSS.value,
+            min_ago_open=300 - i * 10,
+            min_ago_close=200 - i * 10,
+            profit_rate=0.9,
+        )
+    Trade.commit()
+    assert not freqtrade.protections.global_stop()
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # A winning trade breaks the streak
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        min_ago_open=150,
+        min_ago_close=140,
+        profit_rate=1.1,
+    )
+    Trade.commit()
+
+    # 2 more losses - still short of the 3-in-a-row limit because of the winner above
+    for i in range(2):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.STOP_LOSS.value,
+            min_ago_open=100 - i * 10,
+            min_ago_close=90 - i * 10,
+            profit_rate=0.9,
+        )
+    Trade.commit()
+    assert not freqtrade.protections.global_stop()
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # Third consecutive loss - now the streak triggers a lock
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=30,
+        min_ago_close=20,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+
+    assert freqtrade.protections.stop_per_pair(pair)
+    assert PairLocks.is_pair_locked(pair)
+    assert log_has_re(message, caplog)
+    caplog.clear()
+
+    assert freqtrade.protections.global_stop()
+    assert PairLocks.is_global_lock()
+    assert log_has_re(message, caplog)
+
+
+@pytest.mark.parametrize("only_per_pair", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses_only_per_pair(mocker, default_conf, fee, caplog, only_per_pair):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 1000,
+            "stop_duration": 60,
+            "trade_limit": 2,
+            "only_per_pair": only_per_pair,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    pair = "XRP/BTC"
+
+    for i in range(2):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.STOP_LOSS.value,
+            min_ago_open=40 - i * 10,
+            min_ago_close=30 - i * 10,
+            profit_rate=0.9,
+        )
+    Trade.commit()
+
+    assert freqtrade.protections.stop_per_pair(pair)
+    assert PairLocks.is_pair_locked(pair)
+    assert freqtrade.protections.global_stop() != only_per_pair
+    assert PairLocks.is_global_lock() != only_per_pair
+
