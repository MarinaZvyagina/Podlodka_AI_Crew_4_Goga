+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 60,
+            "trade_limit": 3,
+            "stop_duration": 40,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*"
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 1st loss (bot-wide, spread across pairs)
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=200,
+        min_ago_close=50,
+        profit_rate=0.9,
+    )
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2nd consecutive loss
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=190,
+        min_ago_close=40,
+        profit_rate=0.9,
+    )
+    assert not freqtrade.protections.global_stop()
+    caplog.clear()
+
+    # A winning trade breaks the streak - even though 2 losses happened before it.
+    generate_mock_trade(
+        "LTC/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=180,
+        min_ago_close=35,
+        profit_rate=1.1,
+    )
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # Streak has to build up again from here.
+    generate_mock_trade(
+        "BCH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=170,
+        min_ago_close=30,
+        profit_rate=0.9,
+    )
+    generate_mock_trade(
+        "ADA/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=160,
+        min_ago_close=25,
+        profit_rate=0.9,
+    )
+    assert not freqtrade.protections.global_stop()
+    caplog.clear()
+
+    generate_mock_trade(
+        "DOT/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=150,
+        min_ago_close=20,
+        profit_rate=0.9,
+    )
+    assert freqtrade.protections.global_stop()
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_global_lock()
+
+    # After the lock expires, new entries are allowed again automatically.
+    end_time = PairLocks.get_pair_longest_lock("*").lock_end_time + timedelta(minutes=5)
+    freqtrade.protections.global_stop(end_time)
+    assert not PairLocks.is_global_lock(end_time)
+
+
+@pytest.mark.parametrize("only_per_pair", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses_perpair(mocker, default_conf, fee, caplog, only_per_pair):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 60,
+            "trade_limit": 2,
+            "stop_duration": 60,
+            "only_per_pair": only_per_pair,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*"
+    pair = "XRP/BTC"
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 1st loss for pair
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=200,
+        min_ago_close=50,
+        profit_rate=0.9,
+    )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    caplog.clear()
+
+    # A winning trade for the pair breaks its streak.
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=190,
+        min_ago_close=40,
+        profit_rate=1.1,
+    )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    caplog.clear()
+
+    # 2 fresh consecutive losses for the pair
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=180,
+        min_ago_close=30,
+        profit_rate=0.9,
+    )
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=170,
+        min_ago_close=20,
+        profit_rate=0.9,
+    )
+
+    assert freqtrade.protections.stop_per_pair(pair)
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_pair_locked(pair)
+    # A pair-only guard must not lock the bot globally.
+    assert freqtrade.protections.global_stop() != only_per_pair
+    assert PairLocks.is_global_lock() != only_per_pair
+
+
+@pytest.mark.parametrize("only_per_side", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses_only_per_side(mocker, default_conf, fee, caplog, only_per_side):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 60,
+            "trade_limit": 2,
+            "stop_duration": 60,
+            "only_per_side": only_per_side,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    pair = "XRP/BTC"
+
+    # loss (long), loss (short), loss (long) - 3 consecutive losses overall,
+    # but only 2 consecutive "long" losses interleaved with 1 "short" loss.
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=200,
+        min_ago_close=50,
+        profit_rate=0.9,
+        is_short=False,
+    )
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=190,
+        min_ago_close=40,
+        profit_rate=0.9,
+        is_short=True,
+    )
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=180,
+        min_ago_close=30,
+        profit_rate=0.9,
+        is_short=False,
+    )
+    result = freqtrade.protections.stop_per_pair(pair)
+    assert result
+    if only_per_side:
+        # The short loss is filtered out entirely - it neither counts nor breaks the streak
+        # of the 2 "long" losses.
+        assert PairLocks.is_pair_locked(pair, side="long")
+        assert not PairLocks.is_pair_locked(pair, side="short")
+    else:
+        assert PairLocks.is_pair_locked(pair, side="*")
+
+
