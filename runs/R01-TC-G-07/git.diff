+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses_perpair(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 1000,
+            "trade_limit": 3,
+            "stop_duration": 60,
+            "only_per_pair": True,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .* consecutive losses.*"
+    pair = "XRP/BTC"
+
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2 losses in a row - not enough yet to trigger the streak
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        profit_rate=0.9,
+        min_ago_open=130,
+        min_ago_close=120,
+    )
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        profit_rate=0.9,
+        min_ago_open=110,
+        min_ago_close=100,
+    )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not log_has_re(message, caplog)
+
+    # A winning trade breaks the streak - total profit is irrelevant, only the streak matters
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        profit_rate=1.1,
+        min_ago_open=90,
+        min_ago_close=80,
+    )
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        profit_rate=0.9,
+        min_ago_open=70,
+        min_ago_close=60,
+    )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not log_has_re(message, caplog)
+
+    # 2 more consecutive losses complete a fresh streak of 3
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        profit_rate=0.9,
+        min_ago_open=50,
+        min_ago_close=40,
+    )
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        profit_rate=0.9,
+        min_ago_open=30,
+        min_ago_close=20,
+    )
+
+    assert freqtrade.protections.stop_per_pair(pair)
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_pair_locked(pair)
+    # only_per_pair disables the bot-wide lock
+    assert not freqtrade.protections.global_stop()
+    assert not PairLocks.is_global_lock()
+
+
+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses_global(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 1000,
+            "trade_limit": 3,
+            "stop_duration": 40,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .* consecutive losses.*"
+
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # Losses across different pairs, then a winning trade resets the bot-wide streak
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        profit_rate=0.9,
+        min_ago_open=130,
+        min_ago_close=120,
+    )
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        profit_rate=0.9,
+        min_ago_open=110,
+        min_ago_close=100,
+    )
+    generate_mock_trade(
+        "LTC/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        profit_rate=1.1,
+        min_ago_open=90,
+        min_ago_close=80,
+    )
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 3 consecutive losses across pairs (regardless of pair) after the winning trade
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        profit_rate=0.9,
+        min_ago_open=70,
+        min_ago_close=60,
+    )
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        profit_rate=0.9,
+        min_ago_open=50,
+        min_ago_close=40,
+    )
+    generate_mock_trade(
+        "BCH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        profit_rate=0.9,
+        min_ago_open=30,
+        min_ago_close=20,
+    )
+
+    # BCH/BTC only has a single loss on its own - no per-pair lock for it
+    assert not freqtrade.protections.stop_per_pair("BCH/BTC")
+
+    assert freqtrade.protections.global_stop()
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_global_lock()
+
+    # After the lock elapses, re-checking shouldn't extend the existing lock
+    end_time = PairLocks.get_pair_longest_lock("*").lock_end_time + timedelta(minutes=5)
+    freqtrade.protections.global_stop(end_time)
+    assert not PairLocks.is_global_lock(end_time)
+
