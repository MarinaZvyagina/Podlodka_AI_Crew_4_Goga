+@pytest.mark.parametrize("is_short", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses(mocker, default_conf, fee, caplog, is_short):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 60,
+            "stop_duration": 40,
+            "trade_limit": 3,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading.*stopped due to .*consecutive losses"
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 1st loss - not enough yet
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=200,
+        min_ago_close=50,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    assert not freqtrade.protections.global_stop()
+    caplog.clear()
+
+    # A win breaks the streak, it must not count towards the loss streak
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=190,
+        min_ago_close=40,
+        profit_rate=1.1,
+        is_short=is_short,
+    )
+    assert not freqtrade.protections.global_stop()
+    caplog.clear()
+
+    # 1st loss after the win
+    generate_mock_trade(
+        "LTC/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=180,
+        min_ago_close=30,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2nd consecutive loss - still not enough
+    generate_mock_trade(
+        "BCH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=170,
+        min_ago_close=20,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    assert not freqtrade.protections.global_stop()
+    caplog.clear()
+
+    # 3rd consecutive loss (LTC, BCH, DOT) - triggers the lock
+    generate_mock_trade(
+        "DOT/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=160,
+        min_ago_close=10,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    assert freqtrade.protections.global_stop()
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_global_lock()
+
+
+@pytest.mark.parametrize("only_per_pair", [False, True])
+@pytest.mark.parametrize("only_per_side", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses_perpair(
+    mocker, default_conf, fee, caplog, only_per_pair, only_per_side
+):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 60,
+            "trade_limit": 2,
+            "stop_duration": 60,
+            "only_per_pair": only_per_pair,
+            "only_per_side": only_per_side,
+        }
+    ]
+    check_side = "long" if only_per_side else "*"
+    is_short = False
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading.*stopped due to .*consecutive losses"
+    pair = "XRP/BTC"
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    caplog.clear()
+
+    # 1st loss for our pair
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=200,
+        min_ago_close=40,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    caplog.clear()
+
+    # Loss on a different pair - counts towards the global streak, not this pair's streak
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=190,
+        min_ago_close=30,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert freqtrade.protections.global_stop() != only_per_pair
+    if not only_per_pair:
+        assert log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2nd loss for our pair, but on the wrong side - should not count when only_per_side is set
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=150,
+        min_ago_close=20,
+        profit_rate=0.9,
+        is_short=not is_short,
+    )
+    freqtrade.protections.stop_per_pair(pair)
+    assert PairLocks.is_pair_locked(pair, side=check_side) != (only_per_side and only_per_pair)
+    if only_per_side:
+        assert not PairLocks.is_pair_locked(pair, side="*")
+    caplog.clear()
+
+    # 2nd consecutive loss for our pair on the correct side
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=180,
+        min_ago_close=10,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    freqtrade.protections.stop_per_pair(pair)
+    assert PairLocks.is_pair_locked(pair, side=check_side)
+    if only_per_side:
+        assert not PairLocks.is_pair_locked(pair, side="*")
+
