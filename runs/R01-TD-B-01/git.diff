+def test_ticker_caches_short_lived(mocker, default_conf, tickers):
+    eth_ticker = tickers()["ETH/BTC"]
+    ltc_ticker = tickers()["LTC/BTC"]
+    ticker_mock = MagicMock(side_effect=[eth_ticker, ltc_ticker])
+    mocker.patch(f"{EXMS}.fetch_ticker", ticker_mock)
+    exchange = get_patched_exchange(mocker, default_conf)
+    dp = DataProvider(default_conf, exchange)
+
+    # Repeated calls for the same pair within the cache window reuse the result.
+    res1 = dp.ticker("ETH/BTC")
+    res2 = dp.ticker("ETH/BTC")
+    assert res1 == res2 == eth_ticker
+    assert ticker_mock.call_count == 1
+
+    # A different pair is not affected by the cache and still hits the exchange.
+    res3 = dp.ticker("LTC/BTC")
+    assert res3 == ltc_ticker
+    assert ticker_mock.call_count == 2
+
+    # Once the cache entry expires, the exchange is queried again.
+    dp._DataProvider__ticker_cache.clear()
+    ticker_mock.side_effect = [eth_ticker]
+    res4 = dp.ticker("ETH/BTC")
+    assert res4 == eth_ticker
+    assert ticker_mock.call_count == 3
+
+
