+def test_ticker_uses_short_lived_cache(mocker, default_conf, tickers):
+    api_mock = MagicMock()
+    api_mock.fetch_ticker = MagicMock(return_value=tickers()["ETH/BTC"])
+    api_mock.markets = {"ETH/BTC": {"active": True}}
+    exchange = get_patched_exchange(mocker, default_conf, api_mock)
+    dp = DataProvider(default_conf, exchange)
+
+    # Repeated calls moments apart (e.g. exit-decision and entry-confirmation
+    # logic asking for the same pair's price) should not hit the exchange again.
+    dp.ticker("ETH/BTC")
+    dp.ticker("ETH/BTC")
+    dp.ticker("ETH/BTC")
+    assert api_mock.fetch_ticker.call_count == 1
+
