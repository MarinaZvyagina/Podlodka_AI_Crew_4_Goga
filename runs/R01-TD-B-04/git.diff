+        # Short-lived cache for current-price ticker lookups, to avoid hitting the exchange
+        # again when the same pair's current price is requested multiple times in quick
+        # succession (e.g. by different strategy callbacks).
+        self.__ticker_cache: FtTTLCache = FtTTLCache(maxsize=1000, ttl=2)
 
         self.producers = self._config.get("external_message_consumer", {}).get("producers", [])
         self.external_data_enabled = len(self.producers) > 0
@@ -566,13 +570,20 @@ class DataProvider:
         """
         Return last ticker data from exchange
         Warning: Performs a network request - so use with common sense.
+        Repeated calls for the same pair within a few seconds reuse the last result
+        instead of requesting the price from the exchange again.
         :param pair: Pair to get the data for
         :return: Ticker dict from exchange or empty dict if ticker is not available for the pair
         """
         if self._exchange is None:
             raise OperationalException(NO_EXCHANGE_EXCEPTION)
+        cached = self.__ticker_cache.get(pair)
+        if cached:
+            return cached
         try:
-            return self._exchange.fetch_ticker(pair)
+            ticker = self._exchange.fetch_ticker(pair)
+            self.__ticker_cache[pair] = ticker
+            return ticker
         except ExchangeError:
             return {}
 
