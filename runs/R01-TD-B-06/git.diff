+@pytest.mark.parametrize("exchange_name", EXCHANGES)
+def test_fetch_ticker_cached(default_conf, mocker, exchange_name, time_machine):
+    api_mock = MagicMock()
+    tick1 = {"symbol": "ETH/BTC", "bid": 0.00001098, "ask": 0.00001099, "last": 0.0001}
+    tick2 = {"symbol": "ETH/BTC", "bid": 0.5, "ask": 1, "last": 42}
+    api_mock.fetch_ticker = MagicMock(side_effect=[tick1, tick2, tick2])
+    api_mock.markets = {"ETH/BTC": {"active": True}}
+    exchange = get_patched_exchange(mocker, default_conf, api_mock, exchange=exchange_name)
+    time_machine.move_to("2023-01-01 00:00:00 +00:00")
+
+    # default (uncached) behavior is unchanged - always hits the exchange
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert ticker == tick1
+    assert api_mock.fetch_ticker.call_count == 1
+
+    # A cached=True request shortly after reuses the last fetched value,
+    # without hitting the exchange again.
+    ticker = exchange.fetch_ticker(pair="ETH/BTC", cached=True)
+    assert ticker == tick1
+    assert api_mock.fetch_ticker.call_count == 1
+
+    # ... but an uncached request still always goes to the exchange,
+    # regardless of how recently a price was fetched.
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert ticker == tick2
+    assert api_mock.fetch_ticker.call_count == 2
+
+    # Once the short cache window has elapsed, a cached request refreshes again.
+    time_machine.shift(3)
+    ticker = exchange.fetch_ticker(pair="ETH/BTC", cached=True)
+    assert ticker == tick2
+    assert api_mock.fetch_ticker.call_count == 3
+
+
