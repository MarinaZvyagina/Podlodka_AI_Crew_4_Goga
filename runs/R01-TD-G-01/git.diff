+def test_fetch_ticker_cache(default_conf, mocker, time_machine):
+    api_mock = MagicMock()
+    api_mock.markets = {"ETH/BTC": {"active": True}, "LTC/BTC": {"active": True}}
+    api_mock.fetch_ticker = MagicMock(
+        side_effect=lambda pair: {"symbol": pair, "bid": 1, "ask": 2, "last": 3}
+    )
+    exchange = get_patched_exchange(mocker, default_conf, api_mock)
+    start_dt = datetime(2023, 12, 1, 0, 10, 0, tzinfo=UTC)
+    time_machine.move_to(start_dt, tick=False)
+
+    exchange.fetch_ticker(pair="ETH/BTC")
+    assert api_mock.fetch_ticker.call_count == 1
+
+    # Repeated request for the same pair moments later is served from cache.
+    exchange.fetch_ticker(pair="ETH/BTC")
+    assert api_mock.fetch_ticker.call_count == 1
+
+    # A different pair is not affected by the other pair's cache entry.
+    exchange.fetch_ticker(pair="LTC/BTC")
+    assert api_mock.fetch_ticker.call_count == 2
+
+    # Once the cache entry's TTL has elapsed, the ticker is fetched again.
+    time_machine.move_to(start_dt + timedelta(seconds=5), tick=False)
+    exchange.fetch_ticker(pair="ETH/BTC")
+    assert api_mock.fetch_ticker.call_count == 3
+
+
