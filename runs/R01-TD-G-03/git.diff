diff --git a/freqtrade/data/dataprovider.py b/freqtrade/data/dataprovider.py
index ed396ba..908dbbc 100644
--- a/freqtrade/data/dataprovider.py
+++ b/freqtrade/data/dataprovider.py
@@ -566,13 +566,15 @@ class DataProvider:
         """
         Return last ticker data from exchange
         Warning: Performs a network request - so use with common sense.
+        Repeated calls for the same pair within a couple of seconds may reuse a
+        recently fetched result instead of hitting the exchange again.
         :param pair: Pair to get the data for
         :return: Ticker dict from exchange or empty dict if ticker is not available for the pair
         """
         if self._exchange is None:
             raise OperationalException(NO_EXCHANGE_EXCEPTION)
         try:
-            return self._exchange.fetch_ticker(pair)
+            return self._exchange.fetch_ticker(pair, cached=True)
         except ExchangeError:
             return {}
 
diff --git a/freqtrade/exchange/exchange.py b/freqtrade/exchange/exchange.py
index 69c9993..adea11e 100644
--- a/freqtrade/exchange/exchange.py
+++ b/freqtrade/exchange/exchange.py
@@ -235,6 +235,10 @@ class Exchange:
         self._cache_lock = Lock()
         # Cache for 10 minutes ...
         self._fetch_tickers_cache: FtTTLCache = FtTTLCache(maxsize=4, ttl=60 * 10)
+        # Very short-lived cache to deduplicate repeated single-pair ticker requests
+        # (e.g. entry-confirmation and exit-decision logic both asking for the current
+        # price of the same pair moments apart) without noticeably staling live prices.
+        self._fetch_ticker_cache: FtTTLCache = FtTTLCache(maxsize=1000, ttl=2)
         # Cache values for 300 to avoid frequent polling of the exchange for prices
         # Caching only applies to RPC methods, so prices for open trades are still
         # refreshed once every iteration.
@@ -2162,11 +2166,25 @@ class Exchange:
         return None
 
     @retrier
-    def fetch_ticker(self, pair: str) -> Ticker:
+    def fetch_ticker(self, pair: str, *, cached: bool = False) -> Ticker:
+        """
+        :param pair: Pair to get the ticker for
+        :param cached: Allow cached result. Result is cached for a couple of seconds, to
+        avoid repeated round-trips to the exchange when the current price for the same pair
+        is requested multiple times in short succession (e.g. by different parts of the
+        strategy). Should not be used where a guaranteed up-to-the-moment price is required.
+        """
+        if cached:
+            with self._cache_lock:
+                ticker = self._fetch_ticker_cache.get(pair)
+            if ticker:
+                return ticker
         try:
             if pair not in self.markets or self.markets[pair].get("active", False) is False:
                 raise ExchangeError(f"Pair {pair} not available")
             data: Ticker = self._api.fetch_ticker(pair)
+            with self._cache_lock:
+                self._fetch_ticker_cache[pair] = data
             return data
         except ccxt.DDoSProtection as e:
             raise DDosProtection(e) from e
