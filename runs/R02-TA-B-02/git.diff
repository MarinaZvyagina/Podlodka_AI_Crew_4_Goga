diff --git a/salt/beacons/diskusage.py b/salt/beacons/diskusage.py
index da904cf..7e6691c 100644
--- a/salt/beacons/diskusage.py
+++ b/salt/beacons/diskusage.py
@@ -83,6 +83,25 @@ def beacon(config):
     which means that if a regular expression matches another defined mount point,
     it will override the previously defined threshold.
 
+    Instead of a plain percentage, a mapping of ``maximum`` and/or ``minimum``
+    thresholds can be given for a mount. ``maximum`` behaves exactly like the
+    plain percentage form above: the beacon fires when usage rises to or above
+    it. ``minimum`` is the opposite: the beacon fires when usage drops to or
+    below it. This is useful for catching a mount that is normally busy but
+    suddenly reports little to no usage, which typically means the filesystem
+    silently failed to mount and what is being measured is really just the
+    empty directory underneath it.
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /mnt/nfs:
+                minimum: 5%
+            - /mnt/other:
+                maximum: 90%
+                minimum: 5%
+
     """
     whitelist = []
     config = salt.utils.beacons.remove_hidden_options(config, whitelist)
@@ -118,9 +137,43 @@ def beacon(config):
 
                 current_usage = _current_usage.percent
                 monitor_usage = mounts[mount]
-                if isinstance(monitor_usage, str) and "%" in monitor_usage:
-                    monitor_usage = re.sub("%", "", monitor_usage)
-                monitor_usage = float(monitor_usage)
-                if current_usage >= monitor_usage:
-                    ret.append({"diskusage": current_usage, "mount": _mount})
+
+                if isinstance(monitor_usage, dict):
+                    maximum_usage = monitor_usage.get("maximum")
+                    minimum_usage = monitor_usage.get("minimum")
+
+                    if maximum_usage is not None and current_usage >= _to_percent(
+                        maximum_usage
+                    ):
+                        ret.append(
+                            {
+                                "diskusage": current_usage,
+                                "mount": _mount,
+                                "match": "maximum",
+                            }
+                        )
+
+                    if minimum_usage is not None and current_usage <= _to_percent(
+                        minimum_usage
+                    ):
+                        ret.append(
+                            {
+                                "diskusage": current_usage,
+                                "mount": _mount,
+                                "match": "minimum",
+                            }
+                        )
+                else:
+                    monitor_usage = _to_percent(monitor_usage)
+                    if current_usage >= monitor_usage:
+                        ret.append({"diskusage": current_usage, "mount": _mount})
     return ret
+
+
+def _to_percent(value):
+    """
+    Normalize a threshold value (e.g. "50%" or 50) into a float
+    """
+    if isinstance(value, str) and "%" in value:
+        value = re.sub("%", "", value)
+    return float(value)
diff --git a/tests/pytests/unit/beacons/test_diskusage.py b/tests/pytests/unit/beacons/test_diskusage.py
