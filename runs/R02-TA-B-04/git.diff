@@ -40,9 +40,30 @@ def validate(config):
     # Configuration for diskusage beacon should be a list of dicts
     if not isinstance(config, list):
         return False, "Configuration for diskusage beacon must be a list."
+
+    for mounts in config:
+        for mount, value in mounts.items():
+            if isinstance(value, dict):
+                if "minimum" not in value and "maximum" not in value:
+                    return False, (
+                        "Configuration for diskusage beacon: mount {} must "
+                        "define at least one of 'minimum' or 'maximum'.".format(
+                            mount
+                        )
+                    )
+
     return True, "Valid beacon configuration"
 
 
+def _to_percent(value):
+    """
+    Normalize a threshold value (e.g. ``50``, ``"50%"``) to a float
+    """
+    if isinstance(value, str) and "%" in value:
+        value = re.sub("%", "", value)
+    return float(value)
+
+
