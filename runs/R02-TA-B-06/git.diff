 def beacon(config):
     r"""
     Monitor the disk usage of the minion
@@ -57,6 +66,28 @@ def beacon(config):
             - /: 63%
             - /mnt/nfs: 50%
 
+    A mount can also be configured to alert when its usage drops below an
+    expected value, which usually indicates that the filesystem failed to
+    mount and an empty directory on the root filesystem is being monitored
+    instead. To do this, pass a dict with ``low`` and/or ``high`` keys
+    instead of a bare percentage. Both a low and a high alert can be
+    configured for the same mount, or either one on its own.
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /: 63%
+            - /mnt/nfs:
+                low: 5%
+                high: 50%
+            - /mnt/backups:
+                low: 5%
+
+    A beacon fired because usage dropped below the configured ``low``
+    threshold includes ``low: True`` in its event data, so it can be told
+    apart from the existing high-usage beacons.
+
     Windows drives must be quoted to avoid yaml syntax errors
 
     .. code-block:: yaml
@@ -118,9 +149,25 @@ def beacon(config):
 
                 current_usage = _current_usage.percent
                 monitor_usage = mounts[mount]
-                if isinstance(monitor_usage, str) and "%" in monitor_usage:
-                    monitor_usage = re.sub("%", "", monitor_usage)
-                monitor_usage = float(monitor_usage)
-                if current_usage >= monitor_usage:
+
+                if isinstance(monitor_usage, dict):
+                    high_usage = monitor_usage.get("high")
+                    low_usage = monitor_usage.get("low")
+                else:
+                    # Backwards compatible behavior: a bare value is a
+                    # high-usage threshold.
+                    high_usage = monitor_usage
+                    low_usage = None
+
+                if high_usage is not None and current_usage >= _to_percent(
+                    high_usage
+                ):
                     ret.append({"diskusage": current_usage, "mount": _mount})
+
+                if low_usage is not None and current_usage <= _to_percent(
+                    low_usage
+                ):
+                    ret.append(
+                        {"diskusage": current_usage, "mount": _mount, "low": True}
+                    )
     return ret
