diff --git a/changelog/65001.added.md b/changelog/65001.added.md
new file mode 100644
index 0000000..306f679
--- /dev/null
+++ b/changelog/65001.added.md
@@ -0,0 +1,4 @@
+Added support for ``min_percent`` / ``max_percent`` alerting in the ``diskusage``
+beacon, so a mount can also alert when its usage unexpectedly drops (e.g. an
+NFS mount that silently failed to mount). Existing scalar threshold
+configuration continues to work unchanged.
diff --git a/salt/beacons/diskusage.py b/salt/beacons/diskusage.py
