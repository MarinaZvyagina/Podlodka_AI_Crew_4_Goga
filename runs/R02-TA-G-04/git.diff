@@ -83,6 +89,24 @@ def beacon(config):
     which means that if a regular expression matches another defined mount point,
     it will override the previously defined threshold.
 
+    A mount can also be given a mapping of ``minimum`` and/or ``maximum``
+    thresholds instead of a single value. ``maximum`` behaves exactly like the
+    single-value form above. ``minimum`` emits a beacon when usage drops to or
+    below the given threshold, which is useful for catching a mount that is
+    normally busy but has unexpectedly little usage - in practice this is
+    almost always a filesystem that silently failed to mount, leaving what
+    looks like the mount point as an empty directory on the root filesystem.
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /mnt/nfs:
+                minimum: 5%
+                maximum: 90%
+            - /mnt/backups:
+                minimum: 2%
+
     """
     whitelist = []
     config = salt.utils.beacons.remove_hidden_options(config, whitelist)
