             assert ret == [{"diskusage": 50, "mount": "C:\\"}]
 
 
+def test_min_max_config_missing_keys():
+    config = [{"/": {}}]
+
+    ret = diskusage.validate(config)
+    assert ret == (
+        False,
+        "Configuration for diskusage beacon mount / must include min and/or max.",
+    )
+
+
+def test_min_max_config_unknown_keys():
+    config = [{"/": {"min": "1%", "bar": "2%"}}]
+
+    ret = diskusage.validate(config)
+    assert ret == (
+        False,
+        "Configuration for diskusage beacon mount / contains unknown option(s): bar",
+    )
+
+
+def test_diskusage_min_match(stub_disk_usage, stub_disk_partition):
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        config = [{"/": {"min": "60%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == [{"diskusage": 50, "mount": "/", "match": "min"}]
+
+
+def test_diskusage_min_nomatch(stub_disk_usage, stub_disk_partition):
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        config = [{"/": {"min": "10%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == []
+
+
+def test_diskusage_min_and_max(stub_disk_usage, stub_disk_partition):
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        config = [{"/": {"min": "10%", "max": "50%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == [{"diskusage": 50, "mount": "/", "match": "max"}]
+
