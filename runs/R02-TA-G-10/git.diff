 def beacon(config):
     r"""
     Monitor the disk usage of the minion
@@ -83,6 +109,24 @@ def beacon(config):
     which means that if a regular expression matches another defined mount point,
     it will override the previously defined threshold.
 
+    A mount can also be configured with a ``min`` and/or ``max`` threshold, which
+    allows emitting a beacon when usage rises above ``max`` percent, drops to or
+    below ``min`` percent, or both. This is useful for catching a mount whose
+    filesystem silently failed to mount, which usually shows up as unexpectedly
+    low usage on what should be a busy mount.
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /: 63%
+            - /mnt/nfs:
+                min: 1%
+                max: 90%
+
+    The plain percentage form (``/: 63%``) is unchanged and only alerts when
+    usage rises to or above the threshold, exactly as before.
+
     """
     whitelist = []
     config = salt.utils.beacons.remove_hidden_options(config, whitelist)
