+    def status_beacons(self, name=None, include_pillar=True, include_opts=True):
+        """
+        Return the last execution status of the configured beacons
+
+        This reflects live beacon activity tracked as beacons actually
+        fire; it does not read log files, wait for a new probe cycle, or
+        require the minion to be restarted.
+
+        name:           Only return the status of this beacon. If not
+                        provided, status for all configured beacons is
