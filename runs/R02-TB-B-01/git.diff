+def status(name=None, include_pillar=True, include_opts=True, **kwargs):
+    """
+    Return the last execution status of the minion's configured beacons
+
+    This is answered live from the beacon loop itself, so it reflects
+    real activity as it happens: it does not wait for a new probe cycle,
+    read log files, or require the minion to be restarted.
+
+    :param name:            Only return the status of this beacon. If not
+                            provided, status for all configured beacons is
+                            returned.
+
+    :param include_pillar:  Whether to include beacons that are
+                            configured in pillar, default is ``True``.
+
+    :param include_opts:    Whether to include beacons that are
+                            configured in opts, default is ``True``.
+
+    :return:                Dictionary keyed by beacon name. Each value has
+                            ``last_run`` (the epoch time the beacon last
+                            fired, or ``None`` if it has never fired) and
+                            ``last_error`` (the error raised by that last
+                            run, or ``None`` if it succeeded or never ran).
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+
+        salt '*' beacons.status ps
+
+    """
+    beacons_status = None
+    comment = None
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {
+                    "func": "status",
+                    "name": name,
+                    "include_pillar": include_pillar,
+                    "include_opts": include_opts,
+                },
+                "manage_beacons",
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacons_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                if event_ret:
+                    if event_ret["complete"]:
+                        beacons_status = event_ret["beacons_status"]
+                    else:
+                        comment = event_ret.get("comment")
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+        return ret
+
+    if comment:
+        return {"result": False, "comment": comment}
+
+    return beacons_status
+
+
