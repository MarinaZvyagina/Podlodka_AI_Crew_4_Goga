+def status(name=None, time_fmt="%Y-%m-%dT%H:%M:%S", **kwargs):
+    """
+    Show when each of the minion's configured beacons last actually fired,
+    and whether that run raised an error. This reflects live beacon
+    activity, not log data, and updates in real time as beacons run.
+
+    :param name:        Optional name of a single beacon to check. If not
+                         provided, status is returned for every currently
+                         configured beacon.
+    :param time_fmt:    Format string used to render the last run time,
+                         default ``%Y-%m-%dT%H:%M:%S``.
+    :return:            Dictionary keyed by beacon name. Each value has
+                         ``last_run`` (the formatted time the beacon last
+                         fired, or ``None`` if it has never fired) and
+                         ``last_error`` (the error from that run, or
+                         ``None`` if it completed without error).
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+
+        salt '*' beacons.status ps
+    """
+    status = {}
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {"func": "status", "name": name}, "manage_beacons"
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacon_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                if event_ret and event_ret["complete"]:
+                    status = event_ret["beacons"]
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+        return ret
+
+    for info in status.values():
+        if isinstance(info.get("last_run"), datetime):
+            info["last_run"] = info["last_run"].strftime(time_fmt)
+
+    return status
+
+
