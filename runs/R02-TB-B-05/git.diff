             ret["result"] = False
             ret["comment"] = "Event module not available. Beacon reset job failed."
     return ret
+
+
+def status(name=None, **kwargs):
+    """
+    Show, for each currently configured beacon, the timestamp of the last
+    time it actually fired and whether that run raised an error. A beacon
+    that has never fired reports ``last_run: None`` rather than a stale or
+    made-up value.
+
+    This is answered from live state tracked by the running minion process
+    as beacons execute, so it reflects real activity immediately -- it does
+    not require waiting for another beacon loop, reading minion logs, or
+    restarting the minion.
+
+    name: Only return the status of this single beacon rather than all
+          configured beacons.
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+        salt '*' beacons.status name=mywatcher
+    """
+    ret = {"result": True, "beacons": {}}
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {"func": "status", "name": name}, "manage_beacons"
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacon_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                if event_ret is None:
+                    ret["result"] = False
+                    ret["comment"] = (
+                        "Did not receive the beacon status event before the"
+                        " timeout of {}s".format(
+                            kwargs.get("timeout", default_event_wait)
+                        )
+                    )
+                elif event_ret["complete"]:
+                    ret["beacons"] = event_ret["beacons"]
+                else:
+                    ret["result"] = False
+                    ret["comment"] = event_ret["comment"]
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+
+    return ret
