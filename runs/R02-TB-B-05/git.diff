+def test_beacon_process_records_status_on_success(minion_opts):
+    """
+    Test that process() records a last_run timestamp and no error
+    for a beacon that fires successfully.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    assert "watch_apache" not in beacon.status_map
+
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    assert "watch_apache" in beacon.status_map
+    assert beacon.status_map["watch_apache"]["last_run"] is not None
+    assert beacon.status_map["watch_apache"]["last_error"] is None
+
+
