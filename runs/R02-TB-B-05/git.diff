+    def beacon_status(self, name=None):
+        """
+        Return the timestamp of the last time each beacon actually fired,
+        and whether that run raised an error.
+
+        This reflects live state tracked on this running Beacon instance
+        as beacons fire, so it is accurate immediately and does not
+        require waiting for another probe cycle or reading log files.
+
+        name: Return the status of a single beacon rather than all
+              currently configured beacons.
+        """
+        configured = self._get_beacons()
+        configured.pop("enabled", None)
+
+        if name is not None and name not in configured:
+            with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+                evt.fire_event(
+                    {
+                        "complete": False,
+                        "comment": f"Beacon {name} is not configured.",
+                    },
+                    tag="/salt/minion/minion_beacon_status_complete",
+                )
+            return True
+
+        names = [name] if name is not None else list(configured)
+
+        status = {}
+        for beacon_name in names:
+            entry = self.status_map.get(beacon_name)
+            if entry is None:
+                # Configured but never fired: say so explicitly rather
+                # than fabricating or reusing a stale timestamp.
+                status[beacon_name] = {"last_run": None, "last_error": None}
+            else:
+                status[beacon_name] = dict(entry)
+
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacons": status},
+                tag="/salt/minion/minion_beacon_status_complete",
+            )
+
+        return True
