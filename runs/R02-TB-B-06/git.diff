+def status(name=None, **kwargs):
+    """
+    Return the last time each configured beacon actually executed and
+    whether that run raised an error.
+
+    This reflects the live, in-memory state of the running minion's beacon
+    loop, so it is always current as of the last time the beacon fired -
+    it does not wait for a new probe cycle and does not require reading
+    log files or restarting the minion.
+
+    :param name:            Optionally restrict the status to a single
+                             beacon.
+    :return:                Dictionary keyed by beacon name, each value a
+                             dictionary with ``last_run`` (epoch timestamp
+                             of the beacon's last execution, or ``None`` if
+                             it has not fired yet) and ``last_error`` (the
+                             error raised by that run, or ``None`` if it
+                             succeeded or hasn't run).
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+        salt '*' beacons.status ps
+    """
+    ret = {}
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {"name": name, "func": "status"}, "manage_beacons"
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacon_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                if event_ret and event_ret["complete"]:
+                    ret = event_ret["beacons"]
+                elif event_ret:
+                    ret["result"] = False
+                    ret["comment"] = event_ret["comment"]
+                else:
+                    ret["result"] = False
+                    ret["comment"] = (
+                        "Did not receive the beacon status complete event before"
+                        " the timeout of {}s".format(
+                            kwargs.get("timeout", default_event_wait)
+                        )
+                    )
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+
+    return ret
+
+
