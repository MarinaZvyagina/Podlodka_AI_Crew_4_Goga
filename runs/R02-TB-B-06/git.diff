+    def get_beacon_status(self, name=None):
+        """
+        Return the last actual run time and error status for one or all
+        currently configured beacons.
+
+        A beacon that has never fired is reported with ``last_run`` set to
+        ``None`` rather than being omitted or given a fabricated value.
+        """
+        beacons = self._get_beacons()
+
+        if name is not None and name not in beacons:
+            with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+                evt.fire_event(
+                    {
+                        "complete": False,
+                        "comment": f"Beacon {name} is not currently configured.",
+                    },
+                    tag="/salt/minion/minion_beacon_status_complete",
+                )
+            return True
+
+        mods = [name] if name else [mod for mod in beacons if mod != "enabled"]
+
+        status = {}
+        for mod in mods:
+            entry = self.status_map.get(mod)
+            if entry is None:
+                status[mod] = {"last_run": None, "last_error": None}
+            else:
+                status[mod] = dict(entry)
+
+        # Fire the complete event back along with the status of the beacons
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacons": status},
+                tag="/salt/minion/minion_beacon_status_complete",
+            )
+
+        return True
