         return {"beacons": {}}
 
 
+def status(name=None, **kwargs):
+    """
+    Return the last time each configured beacon actually fired and whether
+    that run produced an error.
+
+    This is populated as beacons run on the live minion process, so it
+    reflects real activity without waiting for a new beacon loop, reading
+    log files, or restarting the minion. A beacon that has not fired yet
+    reports ``last_run: None`` rather than a stale or made up value.
+
+    :param name:    Restrict the status to a single beacon. If not
+                    provided, status is returned for every configured
+                    beacon.
+    :return:        Dictionary keyed by beacon name, each containing
+                    ``last_run`` (epoch timestamp of the beacon's last
+                    execution, or ``None`` if it has not fired yet) and
+                    ``error`` (the error raised by the last execution, or
+                    ``None`` if it succeeded or has not run yet).
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+        salt '*' beacons.status ps
+
+    """
+    ret = {}
+
+    if name:
+        _beacons = list_(return_yaml=False, **kwargs)
+        if name not in _beacons:
+            ret["result"] = False
+            ret["comment"] = f"Beacon {name} is not currently configured."
+            return ret
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {"func": "status", "name": name}, "manage_beacons"
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacon_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                if event_ret and event_ret["complete"]:
+                    ret = event_ret["beacons"]
+                else:
+                    ret["result"] = False
+                    ret["comment"] = (
+                        "Did not receive the beacon status complete event before"
+                        " the timeout of {}s".format(
+                            kwargs.get("timeout", default_event_wait)
+                        )
+                    )
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+
+    return ret
+
+
