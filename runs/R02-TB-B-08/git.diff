+@pytest.mark.slow_test
+def test_status():
+    """
+    Test getting beacon status for all configured beacons.
+    """
+    event_returns = [
+        {
+            "complete": True,
+            "tag": "/salt/minion/minion_beacons_status_complete",
+            "beacons": {
+                "ps": {"fired": True, "last_fired": 123456.0, "last_error": None},
+                "inotify": {"fired": False, "last_fired": None, "last_error": None},
+            },
+        },
+    ]
+
+    with patch.dict(
+        beacons.__opts__,
+        {
+            "beacons": {
+                "ps": [{"processes": {"salt-master": "stopped"}}],
+                "inotify": [{"files": {"/etc/fstab": {}}}],
+            },
+        },
+    ):
+        mock = MagicMock(return_value=True)
+        with patch.dict(beacons.__salt__, {"event.fire": mock}):
+            with patch.object(SaltEvent, "get_event", side_effect=event_returns):
+                ret = beacons.status(return_yaml=False)
+
+    assert ret == {
+        "ps": {"fired": True, "last_fired": 123456.0, "last_error": None},
+        "inotify": {"fired": False, "last_fired": None, "last_error": None},
+    }
+
+
+@pytest.mark.slow_test
+def test_status_single_beacon():
+    """
+    Test getting beacon status for a single configured beacon.
+    """
+    event_returns = [
+        {
+            "complete": True,
+            "tag": "/salt/minion/minion_beacons_status_complete",
+            "beacons": {
+                "ps": {"fired": False, "last_fired": None, "last_error": None},
+            },
+        },
+    ]
+
+    with patch.dict(
+        beacons.__opts__,
+        {
+            "beacons": {
+                "ps": [{"processes": {"salt-master": "stopped"}}],
+            },
+        },
+    ):
+        mock = MagicMock(return_value=True)
+        with patch.dict(beacons.__salt__, {"event.fire": mock}):
+            with patch.object(SaltEvent, "get_event", side_effect=event_returns):
+                ret = beacons.status(name="ps", return_yaml=False)
+
+    assert ret == {"ps": {"fired": False, "last_fired": None, "last_error": None}}
+
+
+@pytest.mark.slow_test
+def test_status_not_configured():
+    """
+    Test that requesting status for a beacon that isn't configured fails
+    without contacting the minion.
+    """
+    with patch.dict(beacons.__opts__, {"beacons": {}}):
+        mock = MagicMock(return_value=True)
+        with patch.dict(beacons.__salt__, {"event.fire": mock}):
