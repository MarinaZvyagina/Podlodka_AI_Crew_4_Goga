+    def status_beacons(self, name=None):
+        """
+        Return when each configured beacon last actually fired and whether
+        that run produced an error.
+
+        name: Return the status for a single beacon instead of all of them.
+        """
+        configured = self._get_beacons()
+
+        if name is not None:
+            bnames = [name] if name in configured else []
+        else:
+            bnames = [bname for bname in configured if bname != "enabled"]
+
+        status = {}
+        for bname in bnames:
+            info = self.beacon_status.get(bname)
+            status[bname] = {
+                "fired": info is not None,
+                "last_fired": info["last_fired"] if info else None,
+                "last_error": info["last_error"] if info else None,
+            }
+
+        # Fire the complete event back along with the beacon status
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacons": status},
+                tag="/salt/minion/minion_beacons_status_complete",
+            )
+
+        return True
