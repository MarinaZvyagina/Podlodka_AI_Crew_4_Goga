+def status(name=None, return_yaml=True, **kwargs):
+    """
+    Return when each configured beacon last actually fired and whether that
+    run raised an error. This reflects live beacon activity on the minion
+    (tracked in memory as beacons run) rather than log files, so it does not
+    require waiting for a new probe cycle or restarting the minion.
+
+    :param name:            Only return the status of this beacon, default
+                           is to return the status of all configured
+                           beacons.
+
+    :param return_yaml:    Whether to return YAML formatted output,
+                           default ``True``
+
+    :return:               Dictionary keyed by beacon name. Each entry has
+                           ``fired`` (``False`` if the beacon has never
+                           fired), ``last_fired`` (epoch time of the last
+                           run, or ``None`` if it has never fired), and
+                           ``last_error`` (the error from the last run, or
+                           ``None`` if it succeeded or has never run).
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+
+        salt '*' beacons.status ps
+
+    """
+    if name and name not in list_(return_yaml=False, **kwargs):
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = f"Beacon {name} is not currently configured."
+        return ret
+
+    beacon_status = None
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {"func": "status", "name": name}, "manage_beacons"
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacons_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                if event_ret and event_ret["complete"]:
+                    beacon_status = event_ret["beacons"]
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+        return ret
+
+    if return_yaml:
+        tmp = {"beacons": beacon_status}
+        return salt.utils.yaml.safe_dump(tmp, default_flow_style=False)
+    else:
+        return beacon_status
+
+
