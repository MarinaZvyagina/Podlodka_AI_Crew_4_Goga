+    def list_beacons_status(self, include_pillar=True, include_opts=True):
+        """
+        Report the last-run status of each currently configured beacon:
+        when it last actually fired, and whether that run raised an error.
+
+        This is populated live as beacons run in this minion process, so it
+        reflects real activity without waiting on a new probe cycle, reading
+        log files, or restarting the minion. Beacons that have not fired
+        even once are reported as such, rather than a stale or made up
+        value.
+
+        include_pillar: Whether to include beacons that are
+                        configured in pillar, default is True.
+
+        include_opts:   Whether to include beacons that are
+                        configured in opts, default is True.
+        """
+        beacons = self._get_beacons(
+            include_pillar=include_pillar, include_opts=include_opts
+        )
+
+        status = {}
+        for name in beacons:
+            if name == "enabled":
+                continue
+            entry = self.status_map.get(name)
+            if entry is None:
+                status[name] = {
+                    "has_run": False,
+                    "last_run": None,
+                    "last_error": None,
+                }
+            else:
+                status[name] = {
+                    "has_run": True,
+                    "last_run": entry["last_run"],
+                    "last_error": entry["last_error"],
+                }
+
+        # Fire the complete event back along with the beacon status
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacons": status},
+                tag="/salt/minion/minion_beacons_status_complete",
+            )
+
+        return True
+
