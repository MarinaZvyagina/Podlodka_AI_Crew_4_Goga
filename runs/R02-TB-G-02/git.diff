+@pytest.mark.slow_test
+def test_list_status():
+    """
+    Test getting the last-run status of configured beacons: one that has
+    already fired successfully, one that last errored, and one that
+    hasn't run yet.
+    """
+    last_run = datetime.datetime(2026, 9, 9, 12, 0, 0)
+    event_returns = [
+        {
+            "complete": True,
+            "tag": "/salt/minion/minion_beacons_status_complete",
+            "beacons": {
+                "ps": {
+                    "has_run": True,
+                    "last_run": last_run,
+                    "last_error": None,
+                },
+                "watch_log": {
+                    "has_run": True,
+                    "last_run": last_run,
+                    "last_error": "file not found",
+                },
+                "never_run": {
+                    "has_run": False,
+                    "last_run": None,
+                    "last_error": None,
+                },
+            },
+        },
+    ]
+
+    mock = MagicMock(return_value=True)
+    with patch.dict(beacons.__salt__, {"event.fire": mock}):
+        with patch.object(SaltEvent, "get_event", side_effect=event_returns):
+            ret = beacons.list_status(return_yaml=False)
+
+    assert ret["ps"]["has_run"] is True
+    assert ret["ps"]["last_error"] is None
+    assert ret["ps"]["last_run"] == last_run.strftime("%Y-%m-%dT%H:%M:%S.%f")
+
+    assert ret["watch_log"]["has_run"] is True
+    assert ret["watch_log"]["last_error"] == "file not found"
+
+    assert ret["never_run"] == {
+        "has_run": False,
+        "last_run": None,
+        "last_error": None,
+    }
+
+
