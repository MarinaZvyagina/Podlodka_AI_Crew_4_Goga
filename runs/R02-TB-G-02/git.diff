+def list_status(return_yaml=True, include_pillar=True, include_opts=True, **kwargs):
+    """
+    Report when each of the minion's currently configured beacons last
+    actually executed, and whether that run raised an error.
+
+    This is served from live state tracked by the running minion process
+    as beacons fire, so it does not require waiting for a new beacon
+    cycle, reading log files, or restarting the minion. A beacon that has
+    not fired even once yet is reported with ``has_run: False`` rather
+    than a stale or made up timestamp.
+
+    :param return_yaml:    Whether to return YAML formatted output,
+                           default ``True``
+
+    :param include_pillar: Whether to include beacons that are
+                           configured in pillar, default is ``True``.
+
+    :param include_opts:   Whether to include beacons that are
+                           configured in opts, default is ``True``.
+
+    :return:               Dictionary keyed by beacon name. Each value has
+                            ``has_run`` (bool), ``last_run`` (timestamp
+                            string of the last execution, or ``None`` if
+                            it has never run), and ``last_error`` (the
+                            error raised during the last run, or ``None``
+                            if the last run succeeded or it has never
+                            run).
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.list_status
+
+    """
+    beacons = None
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {
+                    "func": "list_status",
+                    "include_pillar": include_pillar,
+                    "include_opts": include_opts,
+                },
+                "manage_beacons",
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacons_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                log.debug("event_ret %s", event_ret)
+                if event_ret and event_ret["complete"]:
+                    beacons = event_ret["beacons"]
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+        return ret
+
+    if beacons:
+        for info in beacons.values():
+            if info.get("last_run") is not None:
+                info["last_run"] = info["last_run"].strftime("%Y-%m-%dT%H:%M:%S.%f")
+
+    if return_yaml:
+        tmp = {"beacons": beacons}
+        return salt.utils.yaml.safe_dump(tmp, default_flow_style=False)
+    else:
+        return beacons
+
+
