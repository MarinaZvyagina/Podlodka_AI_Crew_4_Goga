+def test_delete_beacon_clears_status(minion_opts):
+    """
+    Test that deleting a beacon also clears its tracked run status, so a
+    later re-add doesn't report a stale run.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+    assert "watch_apache" in beacon.status_map
+
+    with patch("salt.utils.event.get_event"):
+        beacon.delete_beacon("watch_apache")
+
+    assert "watch_apache" not in beacon.status_map
+
