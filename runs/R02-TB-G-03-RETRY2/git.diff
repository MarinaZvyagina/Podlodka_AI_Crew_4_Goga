+def status(name=None, **kwargs):
+    """
+    Return the last time each currently configured beacon actually fired,
+    and whether that run raised an error.
+
+    This reflects live beacon activity: it does not wait for a new probe
+    cycle, does not require reading log files, and does not require
+    restarting the minion or touching beacon configuration. If a beacon
+    hasn't fired even once yet, its ``last_run`` is reported as ``None``
+    rather than a stale or made up value.
+
+    :param name:    Only return status for the named beacon. If omitted,
+                    status for every currently configured beacon is
+                    returned.
+
+    :return:        Dictionary keyed by beacon name. Each value has
+                    ``last_run`` (epoch time of the beacon's last
+                    execution, or ``None`` if it has never fired) and
+                    ``last_error`` (the error raised by the last run, or
+                    ``None`` if that run succeeded or the beacon has
+                    never fired).
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+
+        salt '*' beacons.status ps
+
+    """
+    beacon_status = None
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {"func": "status", "name": name}, "manage_beacons"
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacon_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                if event_ret and event_ret["complete"]:
+                    beacon_status = event_ret["beacon_status"]
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+        return ret
+
+    return beacon_status
+
+
