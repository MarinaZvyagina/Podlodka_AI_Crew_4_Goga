+def test_beacon_status_records_error(minion_opts):
+    """
+    Test that process() records a last_run timestamp and the error message
+    when a beacon run raises.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+    beacon_mock = MagicMock(side_effect=Exception("Global Thermonuclear War"))
+    beacon_mock.__globals__ = {}
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.beacons["ps.beacon"] = beacon_mock
+
+    before = time.time()
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+    after = time.time()
+
+    status = beacon.beacon_status_map.get("watch_apache")
+    assert status is not None
+    assert status["last_error"] == "Global Thermonuclear War"
+    assert before <= status["last_run"] <= after
+
