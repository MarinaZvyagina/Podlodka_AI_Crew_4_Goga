+def test_beacon_process_records_status(minion_opts):
+    """
+    Test that process() records last_fired and last_error (None on
+    success) for a beacon that ran.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    assert beacon.status_data == {}
+
+    with patch("time.time", MagicMock(return_value=1000.0)):
+        beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    assert beacon.status_data == {
+        "watch_apache": {"last_fired": 1000.0, "last_error": None}
+    }
+
+
