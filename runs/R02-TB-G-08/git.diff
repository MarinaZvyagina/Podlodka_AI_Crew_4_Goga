+@pytest.mark.slow_test
+def test_status():
+    """
+    Test retrieving the last run time and error status of configured beacons.
+    """
+    event_returns = [
+        {
+            "complete": True,
+            "tag": "/salt/minion/minion_beacons_status_complete",
+            "beacons": {
+                "ps": {"last_run": 1699999999.0, "last_error": None, "has_run": True},
+                "inotify": {"last_run": None, "last_error": None, "has_run": False},
+            },
+        },
+    ]
+
+    mock = MagicMock(return_value=True)
+    with patch.dict(beacons.__salt__, {"event.fire": mock}):
+        with patch.object(SaltEvent, "get_event", side_effect=event_returns):
+            assert beacons.status() == {
+                "ps": {"last_run": 1699999999.0, "last_error": None, "has_run": True},
+                "inotify": {"last_run": None, "last_error": None, "has_run": False},
+            }
+
+
