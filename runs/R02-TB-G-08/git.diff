+def test_beacon_status_not_run(minion_opts):
+    """
+    A beacon that is configured but has never fired should be reported
+    as such, rather than with a stale or made-up last run time.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "inotify": [
+            {"files": {"/etc/fstab": {}}},
+        ],
+    }
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+
+    with patch("salt.utils.event.get_event") as get_event_mock:
+        beacon.list_beacons_status()
+
+    fire_event = get_event_mock.return_value.__enter__.return_value.fire_event
+    event_data = fire_event.call_args[0][0]
+    assert event_data["beacons"]["inotify"] == {
+        "last_run": None,
+        "last_error": None,
+        "has_run": False,
+    }
+
+
+def test_beacon_status_after_success(minion_opts):
+    """
+    Test that a successful beacon run is recorded with a last run
+    timestamp and no error.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    assert "watch_apache" in beacon.beacon_status
+    status = beacon.beacon_status["watch_apache"]
+    assert status["last_error"] is None
+    assert isinstance(status["last_run"], float)
+
+    with patch("salt.utils.event.get_event") as get_event_mock:
+        beacon.list_beacons_status()
+
+    fire_event = get_event_mock.return_value.__enter__.return_value.fire_event
+    event_data = fire_event.call_args[0][0]
+    assert event_data["beacons"]["watch_apache"] == {
+        "last_run": status["last_run"],
+        "last_error": None,
+        "has_run": True,
+    }
+
+
+def test_beacon_status_after_error(minion_opts):
+    """
+    Test that a beacon run which raises an exception is recorded with
+    the resulting error message.
