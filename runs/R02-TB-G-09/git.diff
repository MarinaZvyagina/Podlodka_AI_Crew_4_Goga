+def test_beacon_status_records_last_fired_on_success(minion_opts):
+    """
+    Test that process() records a last_fired timestamp and no error
+    for a beacon that fires successfully.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    assert "watch_apache" in beacon.status_map
+    status = beacon.status_map["watch_apache"]
+    assert status["last_error"] is None
+    assert isinstance(status["last_fired"], float)
+
+
