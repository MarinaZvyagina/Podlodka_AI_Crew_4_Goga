+    def beacon_status(self, name=None):
+        """
+        Return when each configured beacon last actually fired and whether
+        that firing raised an error. This is read directly from the live,
+        in-memory record kept by process() above, so it reflects real
+        activity as it happens and never requires a new probe cycle, reading
+        logs, or restarting the minion.
+
+        name: Return the status of a single beacon, default is to return
+              the status of all currently configured beacons.
+        """
+        beacons = self._get_beacons()
+
+        if name is not None:
+            if name not in beacons:
+                comment = f"Beacon item {name} is not configured."
+                with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+                    evt.fire_event(
+                        {"complete": False, "comment": comment, "beacons": {}},
+                        tag="/salt/minion/minion_beacon_status_complete",
+                    )
+                return True
+            beacons = {name: beacons[name]}
+
+        statuses = {}
+        for mod in beacons:
+            if mod == "enabled":
+                continue
+            status = self.status_map.get(mod)
+            if status is None:
+                statuses[mod] = {
+                    "last_fired": None,
+                    "last_error": None,
+                    "comment": f"Beacon {mod} has not fired yet.",
+                }
+            else:
+                statuses[mod] = status
+
+        # Fire the complete event back along with the status of the beacons
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacons": statuses},
+                tag="/salt/minion/minion_beacon_status_complete",
+            )
+
+        return True
+
