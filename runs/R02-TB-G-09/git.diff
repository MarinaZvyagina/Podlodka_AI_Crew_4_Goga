+def status(name=None, **kwargs):
+    """
+    Show when each configured beacon last actually fired and whether that
+    firing raised an error. This is read live from the minion's own beacon
+    process, so it reflects real activity as it happens: it does not wait
+    for a new probe cycle, does not read log files, and does not require
+    restarting the minion or changing the beacon configuration.
+
+    If a beacon has not fired even once yet, its status clearly says so
+    instead of a stale or made up value.
+
+    :param name:    Show the status of a single beacon, default is to show
+                     the status of all currently configured beacons.
+
+    :return:        Dictionary of beacon statuses.
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+        salt '*' beacons.status ps
+
+    """
+    beacons = None
+    comment = None
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {"func": "status", "name": name}, "manage_beacons"
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacon_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                log.debug("event_ret %s", event_ret)
+                if event_ret:
+                    beacons = event_ret["beacons"]
+                    if not event_ret["complete"]:
+                        comment = event_ret.get("comment")
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+        return ret
+
+    if comment:
+        return {"result": False, "comment": comment}
+    return {"beacons": beacons if beacons is not None else {}}
+
+
