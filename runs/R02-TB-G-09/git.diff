+@pytest.mark.slow_test
+def test_status():
+    """
+    Test getting the status of all configured beacons.
+    """
+    event_returns = [
+        {
+            "complete": True,
+            "tag": "/salt/minion/minion_beacon_status_complete",
+            "beacons": {
+                "ps": {"last_fired": 1234.5, "last_error": None},
+                "inotify": {
+                    "last_fired": None,
+                    "last_error": None,
+                    "comment": "Beacon inotify has not fired yet.",
+                },
+            },
+        },
+    ]
+
+    mock = MagicMock(return_value=True)
+    with patch.dict(beacons.__salt__, {"event.fire": mock}):
+        with patch.object(SaltEvent, "get_event", side_effect=event_returns):
+            ret = beacons.status()
+            assert ret["beacons"]["ps"]["last_error"] is None
+            assert ret["beacons"]["inotify"]["last_fired"] is None
+
+
