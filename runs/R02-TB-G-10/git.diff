+@pytest.mark.slow_test
+def test_status():
+    """
+    Test querying beacon status returns the last run time and error
+    state for a beacon that has fired. Formatting of the timestamp
+    happens minion-side before the event is fired, so the beacons dict
+    received here already has a string last_run.
+    """
+    event_returns = [
+        {
+            "complete": True,
+            "tag": "/salt/minion/minion_beacons_status_complete",
+            "comment": "",
+            "beacons": {
+                "ps": {"last_run": "2026-08-27T10:15:00", "last_error": None},
+            },
+        },
+    ]
+
+    mock = MagicMock(return_value=True)
+    with patch.dict(beacons.__salt__, {"event.fire": mock}):
+        with patch.object(SaltEvent, "get_event", side_effect=event_returns):
+            assert beacons.status("ps") == {
+                "ps": {"last_run": "2026-08-27T10:15:00", "last_error": None},
+            }
+
+
