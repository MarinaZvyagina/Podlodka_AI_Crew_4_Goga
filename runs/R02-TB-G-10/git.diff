+    def _format_beacon_status(self, entry, time_fmt):
+        """
+        Render a single status_map entry for transport over the event bus,
+        formatting the last_run timestamp to a string so raw datetime
+        objects never have to cross the event bus.
+        """
+        last_run = entry.get("last_run")
+        if isinstance(last_run, datetime.datetime):
+            last_run = last_run.strftime(time_fmt)
+        return {"last_run": last_run, "last_error": entry.get("last_error")}
+
+    def status_beacons(self, name=None, time_fmt="%Y-%m-%dT%H:%M:%S"):
+        """
+        Return the last time each configured beacon actually fired and
+        whether that firing raised an error.
+
+        name:     Only return the status for this beacon.
+        time_fmt: strftime format used to render the last_run timestamp.
+
+        A beacon that is configured but has not fired yet (since the
+        minion started or since beacons were last refreshed) is reported
+        with ``last_run`` set to ``None``, rather than a stale or guessed
+        value.
+        """
+        configured = self._get_beacons()
+        comment = ""
+        empty_entry = {"last_run": None, "last_error": None}
+
+        if name:
+            if name == "enabled" or name not in configured:
+                status = {}
+                comment = f"Beacon {name} is not currently configured."
+            else:
+                status = {
+                    name: self._format_beacon_status(
+                        self.status_map.get(name, empty_entry), time_fmt
+                    )
+                }
+        else:
+            status = {
+                mod: self._format_beacon_status(
+                    self.status_map.get(mod, empty_entry), time_fmt
+                )
+                for mod in configured
+                if mod != "enabled"
+            }
+
+        # Fire the complete event back along with the beacon status
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacons": status, "comment": comment},
+                tag="/salt/minion/minion_beacons_status_complete",
+            )
+
+        return True
+
