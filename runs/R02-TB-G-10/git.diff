+def status(name=None, time_fmt="%Y-%m-%dT%H:%M:%S", **kwargs):
+    """
+    Return the last time each of the minion's configured beacons actually
+    fired, and whether that run raised an error.
+
+    This is tracked live in the running minion process as beacons fire, so
+    it reflects real activity immediately: it does not require waiting for
+    another beacon loop, reading log files, or restarting the minion or
+    touching the beacon configuration.
+
+    :param name:      Only return the status for this beacon.
+    :param time_fmt:  ``strftime`` format used for the ``last_run``
+                       timestamp, default ``"%Y-%m-%dT%H:%M:%S"``.
+    :return:           Dictionary keyed by beacon name. Each value has
+                        ``last_run`` (``None`` if the beacon has not fired
+                        yet) and ``last_error`` (``None`` if the last run
+                        did not raise an error, otherwise the error
+                        message).
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+        salt '*' beacons.status ps
+
+    """
+    ret = {}
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {"func": "status", "name": name, "time_fmt": time_fmt},
+                "manage_beacons",
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacons_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                if event_ret and event_ret["complete"]:
+                    if event_ret.get("comment"):
+                        return {"result": False, "comment": event_ret["comment"]}
+                    ret = event_ret["beacons"]
+                elif event_ret:
+                    ret = {"result": False, "comment": event_ret["comment"]}
+                else:
+                    ret = {
+                        "result": False,
+                        "comment": (
+                            "Did not receive the beacon status complete event"
+                            " before the timeout of {}s".format(
+                                kwargs.get("timeout", default_event_wait)
+                            )
+                        ),
+                    }
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {
+            "result": False,
+            "comment": "Event module not available. Beacon status failed.",
+        }
+    return ret
+
+
