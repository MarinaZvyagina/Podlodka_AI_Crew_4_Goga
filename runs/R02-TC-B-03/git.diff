@@ -0,0 +1,234 @@
+"""
+Minion data cache plugin backed by a local SQLite3 database file.
+
+.. versionadded:: 3009.0
+
+This cache driver stores cached minion data (grains, mine data, job
+returns, etc.) in a single SQLite database file on disk. It relies
+only on the ``sqlite3`` module that ships with a standard Python
+install -- no extra services or third-party packages are required --
+which makes it a good fit for small, single-node masters that want
+the cache to survive a restart without standing up Redis, MySQL, or
+another external store.
+
+.. warning::
+
+    The ``sqlite3.table_name`` value will be directly interpolated into
+    queries. Salt treats this as trusted input coming from the master
+    configuration, not from any external or minion-supplied data.
+
+To use this cache driver, set the master ``cache`` config value to
+``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+The following values may be set in the master config. These are the
+defaults:
+
+.. code-block:: yaml
+
+    sqlite3.database: <cachedir>/cache.sqlite3
+    sqlite3.table_name: cache
+    sqlite3.timeout: 30
+"""
+
+import logging
+import os
+import threading
+
+try:
+    import sqlite3
+
+    HAS_SQLITE3 = True
+except ImportError:
+    HAS_SQLITE3 = False
+
+import salt.payload
+import salt.syspaths
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+_DEFAULT_TABLE_NAME = "cache"
+_DEFAULT_TIMEOUT = 30
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"ls": "list"}
+
+# A single sqlite3.Connection must not be driven by more than one thread at
+# a time, so every query made from this process is serialized through one
+# lock rather than trying to hand out per-thread connections.
+_lock = threading.Lock()
+
+
+def __virtual__():
+    """
+    Confirm that the sqlite3 module is available.
+    """
+    if not HAS_SQLITE3:
+        return False, "No python sqlite3 library installed."
+    return __virtualname__
+
+
+def _database_path():
+    return __opts__.get(
+        "sqlite3.database",
+        os.path.join(
+            __opts__.get("cachedir", salt.syspaths.CACHE_DIR), "cache.sqlite3"
+        ),
+    )
+
+
+def _table_name():
+    return __opts__.get("sqlite3.table_name", _DEFAULT_TABLE_NAME)
+
+
+def _init_client():
+    """
+    Open the database connection and create the cache table if needed.
+
+    A fresh connection is opened for each process that touches the cache:
+    sqlite3 connections cannot be safely shared across a fork, which is
+    how the master hands work off to its worker processes.
+    """
+    pid = os.getpid()
+    client = __context__.get("sqlite3_client")
+    if client is not None:
+        if __context__.get("sqlite3_client_pid") == pid:
+            return client
+        # A forked child inherited this connection object from its parent
+        # process; sqlite3 connections must not be shared across processes,
+        # so drop it and open a fresh one scoped to this pid.
+        try:
+            client.close()
+        except sqlite3.Error:
+            pass
+
+    database = _database_path()
+    table_name = _table_name()
+    timeout = __opts__.get("sqlite3.timeout", _DEFAULT_TIMEOUT)
+
+    base = os.path.dirname(database)
+    if base:
+        try:
+            os.makedirs(base, exist_ok=True)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"The cache directory, {base}, could not be created: {exc}"
+            )
+
+    log.info("sqlite3_cache: opening database %s", database)
+    try:
+        conn = sqlite3.connect(database, timeout=timeout, check_same_thread=False)
+        conn.execute(f"PRAGMA busy_timeout = {int(timeout * 1000)}")
+        conn.execute("PRAGMA journal_mode = WAL")
+        conn.execute("PRAGMA synchronous = NORMAL")
+        conn.execute(
+            f"""CREATE TABLE IF NOT EXISTS {table_name} (
+                bank TEXT NOT NULL,
+                ckey TEXT NOT NULL,
+                data BLOB,
+                last_update REAL NOT NULL,
+                PRIMARY KEY (bank, ckey)
+            )"""
+        )
+        conn.commit()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Unable to open cache database {database}: {exc}")
+
+    __context__["sqlite3_client"] = conn
+    __context__["sqlite3_client_pid"] = pid
+    return conn
+
+
+def _execute(query, args=(), commit=False):
+    with _lock:
+        conn = _init_client()
+        try:
+            cur = conn.execute(query, args)
+            if commit:
+                conn.commit()
+            return cur
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error running {query}: {exc}")
+
+
+def store(bank, key, data):
+    """
+    Store a key value.
+    """
+    value = salt.payload.dumps(data)
+    _execute(
+        f"INSERT OR REPLACE INTO {_table_name()} "
+        "(bank, ckey, data, last_update) VALUES (?, ?, ?, strftime('%s', 'now'))",
+        (bank, key, value),
+        commit=True,
+    )
+
+
+def fetch(bank, key):
+    """
+    Fetch a key value.
+    """
+    cur = _execute(
+        f"SELECT data FROM {_table_name()} WHERE bank=? AND ckey=?", (bank, key)
+    )
+    row = cur.fetchone()
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def flush(bank, key=None):
+    """
+    Remove the key from the cache bank with all the key content. If no
+    key is given, remove the entire bank.
+    """
+    if key is None:
+        cur = _execute(
+            f"DELETE FROM {_table_name()} WHERE bank=?", (bank,), commit=True
+        )
+    else:
+        cur = _execute(
+            f"DELETE FROM {_table_name()} WHERE bank=? AND ckey=?",
+            (bank, key),
+            commit=True,
+        )
+    return cur.rowcount > 0
+
+
+def ls(bank):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank.
+    """
+    cur = _execute(f"SELECT ckey FROM {_table_name()} WHERE bank=?", (bank,))
+    return [row[0] for row in cur.fetchall()]
+
+
+def contains(bank, key):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    if key is None:
+        cur = _execute(f"SELECT 1 FROM {_table_name()} WHERE bank=? LIMIT 1", (bank,))
+    else:
+        cur = _execute(
+            f"SELECT 1 FROM {_table_name()} WHERE bank=? AND ckey=?", (bank, key)
+        )
+    return cur.fetchone() is not None
+
+
+def updated(bank, key):
+    """
+    Return the integer Unix epoch update timestamp of the specified bank and
+    key.
+    """
+    cur = _execute(
+        f"SELECT last_update FROM {_table_name()} WHERE bank=? AND ckey=?",
+        (bank, key),
+    )
+    row = cur.fetchone()
+    return int(row[0]) if row else None
