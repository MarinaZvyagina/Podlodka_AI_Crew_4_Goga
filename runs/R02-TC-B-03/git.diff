@@ -0,0 +1,64 @@
+import logging
+
+import pytest
+
+import salt.cache
+import salt.cache.sqlite3_cache
+import salt.loader
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+pytestmark = [
+    pytest.mark.skipif(
+        not salt.cache.sqlite3_cache.HAS_SQLITE3,
+        reason="No python sqlite3 library installed.",
+    )
+]
+
+
+@pytest.fixture
+def cache(minion_opts, tmp_path):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    opts["sqlite3.database"] = str(tmp_path / "cache.sqlite3")
+    return salt.cache.factory(opts)
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_data_survives_master_restart(minion_opts, tmp_path):
+    """
+    The whole point of this backend is that cached data is still there
+    after the master process (and therefore the in-memory cache object)
+    goes away and comes back.
+    """
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    opts["sqlite3.database"] = str(tmp_path / "cache.sqlite3")
+
+    cache = salt.cache.factory(opts)
+    cache.store("minions/web1", "data", {"grains": {"os": "Linux"}})
+    cache.store("minions/web1", "mine", {"network.interfaces": {}})
+
+    # Simulate the master process restarting: a brand new Cache object,
+    # with its own fresh module loader, pointed at the same database file.
+    restarted_cache = salt.cache.factory(opts)
+    assert restarted_cache.fetch("minions/web1", "data") == {"grains": {"os": "Linux"}}
+    assert restarted_cache.fetch("minions/web1", "mine") == {
+        "network.interfaces": {}
+    }
+    assert restarted_cache.list("minions/web1") == cache.list("minions/web1")
+
+
+def test_opting_out_keeps_default_localfs_behavior(minion_opts):
+    """
+    Deployments that don't set ``cache: sqlite3`` must keep using localfs,
+    unaffected by this backend existing.
+    """
+    opts = minion_opts.copy()
+    opts.pop("cache", None)
+    cache = salt.cache.factory(opts)
+    assert cache.driver == "localfs"
