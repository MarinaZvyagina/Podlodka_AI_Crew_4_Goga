+"""
+Unit tests for the sqlite3_cache cache module
+"""
+
+import os
+
+import pytest
+
+import salt.cache.sqlite3_cache as sqlite3_cache
+from salt.exceptions import SaltCacheError
+from tests.support.mock import MagicMock, patch
+
+pytestmark = [
+    pytest.mark.skipif(
+        not sqlite3_cache.HAS_SQLITE3, reason="No python sqlite3 library installed."
+    )
+]
+
+
+@pytest.fixture
+def configure_loader_modules(tmp_path):
+    return {sqlite3_cache: {"__opts__": {"cachedir": str(tmp_path)}}}
+
+
+def test_virtual():
+    assert sqlite3_cache.__virtual__() == "sqlite3"
+
+
+def test_store_and_fetch():
+    sqlite3_cache.store(bank="minions/alpha", key="grains", data={"os": "Linux"})
+    assert sqlite3_cache.fetch(bank="minions/alpha", key="grains") == {"os": "Linux"}
+
+
+def test_fetch_missing_key_returns_empty_dict():
+    assert sqlite3_cache.fetch(bank="bank", key="nope") == {}
+
+
+def test_store_overwrites_existing_key():
+    sqlite3_cache.store(bank="bank", key="key", data={"v": 1})
+    sqlite3_cache.store(bank="bank", key="key", data={"v": 2})
+    assert sqlite3_cache.fetch(bank="bank", key="key") == {"v": 2}
+
+
+def test_list_returns_keys_in_bank():
+    sqlite3_cache.store(bank="bank", key="k1", data="a")
+    sqlite3_cache.store(bank="bank", key="k2", data="b")
+    assert set(sqlite3_cache.ls(bank="bank")) == {"k1", "k2"}
+
+
+def test_list_empty_bank():
+    assert sqlite3_cache.ls(bank="ghost") == []
+
+
+def test_contains_key_and_bank():
+    sqlite3_cache.store(bank="bank", key="key", data="x")
+    assert sqlite3_cache.contains(bank="bank", key="key") is True
+    assert sqlite3_cache.contains(bank="bank", key=None) is True
+    assert sqlite3_cache.contains(bank="bank", key="missing") is False
+    assert sqlite3_cache.contains(bank="ghost", key=None) is False
+
+
+def test_updated_returns_int_and_none():
+    assert sqlite3_cache.updated(bank="bank", key="key") is None
+    sqlite3_cache.store(bank="bank", key="key", data="x")
+    assert isinstance(sqlite3_cache.updated(bank="bank", key="key"), int)
+
+
+def test_flush_key_and_missing_key():
+    sqlite3_cache.store(bank="bank", key="key", data="x")
+    assert sqlite3_cache.flush(bank="bank", key="key") is True
+    assert sqlite3_cache.fetch(bank="bank", key="key") == {}
+    assert sqlite3_cache.flush(bank="bank", key="key") is False
+
+
+def test_flush_entire_bank():
+    sqlite3_cache.store(bank="bank", key="k1", data="a")
+    sqlite3_cache.store(bank="bank", key="k2", data="b")
+    assert sqlite3_cache.flush(bank="bank", key=None) is True
+    assert sqlite3_cache.ls(bank="bank") == []
+
+
+def test_database_path_defaults_under_cachedir(tmp_path):
+    assert sqlite3_cache._database_path() == os.path.join(
+        str(tmp_path), "cache.sqlite3"
+    )
+
+
+def test_database_path_honors_explicit_config(tmp_path):
+    custom = str(tmp_path / "custom.sqlite3")
+    with patch.dict(sqlite3_cache.__opts__, {"sqlite3.database": custom}):
+        assert sqlite3_cache._database_path() == custom
+
+
+def test_data_persists_across_reconnect():
+    """
+    Simulate a master restart: drop the in-memory connection object (as
+    happens when the process exits) and confirm the same database file
+    still has the previously stored data once reopened.
+    """
+    sqlite3_cache.store(bank="minions/alpha", key="grains", data={"os": "Linux"})
+    sqlite3_cache.__context__.pop("sqlite3_client", None)
+    sqlite3_cache.__context__.pop("sqlite3_client_pid", None)
+    assert sqlite3_cache.fetch(bank="minions/alpha", key="grains") == {"os": "Linux"}
+
+
+def test_forked_child_does_not_reuse_parents_connection():
+    """
+    A connection created in a parent process must not be reused after a
+    fork; sqlite3 connections are not fork-safe.
+    """
+    sqlite3_cache.store(bank="bank", key="key", data="parent")
+    parent_conn = sqlite3_cache.__context__["sqlite3_client"]
+
+    with patch("os.getpid", MagicMock(return_value=os.getpid() + 1)):
+        sqlite3_cache.store(bank="bank", key="key", data="child")
+        assert sqlite3_cache.__context__["sqlite3_client"] is not parent_conn
+
+
+def test_cache_dir_creation_failure_raises_saltcacheerror(tmp_path):
+    with patch.dict(
+        sqlite3_cache.__opts__,
+        {"sqlite3.database": str(tmp_path / "sub" / "cache.sqlite3")},
+    ):
+        with patch("os.makedirs", MagicMock(side_effect=OSError("boom"))):
+            sqlite3_cache.__context__.pop("sqlite3_client", None)
+            with pytest.raises(SaltCacheError):
+                sqlite3_cache.store(bank="bank", key="key", data="x")
