@@ -0,0 +1,135 @@
+"""
+Functional tests for the salt.cache sqlite3_cache driver.
+
+These exercise the full salt.cache.Cache() public API backed by the real
+sqlite3_cache driver with a real opts dict and real filesystem I/O — the
+same path production code takes.
+"""
+
+import os
+import time
+
+import pytest
+
+import salt.cache
+import salt.cache.sqlite3_cache as sqlite3_cache
+import salt.config
+
+
+@pytest.fixture
+def opts(tmp_path):
+    o = salt.config.DEFAULT_MASTER_OPTS.copy()
+    o["cachedir"] = str(tmp_path / "cache")
+    o["cache"] = "sqlite3"
+    return o
+
+
+@pytest.fixture
+def cache(opts):
+    sqlite3_cache._connections.clear()
+    yield salt.cache.Cache(opts, driver="sqlite3")
+    sqlite3_cache._connections.clear()
+
+
+class TestCacheDriverCRUD:
+    def test_store_and_fetch(self, cache):
+        cache.store("mybank", "mykey", {"hello": "world"})
+        assert cache.fetch("mybank", "mykey") == {"hello": "world"}
+
+    def test_fetch_missing_key_returns_empty(self, cache):
+        assert cache.fetch("nobank", "nokey") == {}
+
+    def test_store_overwrite(self, cache):
+        cache.store("bank", "key", "first")
+        cache.store("bank", "key", "second")
+        assert cache.fetch("bank", "key") == "second"
+
+    def test_flush_key(self, cache):
+        cache.store("bank", "key", "value")
+        assert cache.flush("bank", "key") is True
+        assert cache.fetch("bank", "key") == {}
+
+    def test_flush_bank(self, cache):
+        cache.store("bank", "k1", "v1")
+        cache.store("bank", "k2", "v2")
+        cache.flush("bank")
+        assert cache.list("bank") == []
+
+    def test_list_and_contains(self, cache):
+        cache.store("bank", "k1", "v1")
+        cache.store("bank", "k2", "v2")
+        assert set(cache.list("bank")) == {"k1", "k2"}
+        assert cache.contains("bank", "k1") is True
+        assert cache.contains("bank", "no_such") is False
+
+    def test_updated_is_recent(self, cache):
+        before = int(time.time()) - 2
+        cache.store("bank", "key", "value")
+        after = int(time.time()) + 2
+        ts = cache.updated("bank", "key")
+        assert before <= ts <= after
+
+
+class TestExpiry:
+    def test_store_with_expires_becomes_unavailable(self, cache):
+        cache.store("bank", "key", "value", expires=1)
+        assert cache.fetch("bank", "key") == "value"
+        time.sleep(1.2)
+        assert cache.fetch("bank", "key") == {}
+        assert cache.contains("bank", "key") is False
+        assert "key" not in cache.list("bank")
+
+    def test_store_without_expires_never_expires(self, cache):
+        cache.store("bank", "key", "value")
+        time.sleep(1.2)
+        assert cache.fetch("bank", "key") == "value"
+
+
+class TestDurability:
+    """
+    The whole point of the sqlite3 backend: data survives a master restart.
+    """
+
+    def test_data_survives_simulated_restart(self, opts):
+        sqlite3_cache._connections.clear()
+        first = salt.cache.Cache(opts, driver="sqlite3")
+        first.store("minions/alpha", "grains", {"os": "Linux"})
+        first.destroy()
+
+        # Simulate a fresh master process: drop every open connection and
+        # re-instantiate the cache from the same opts/cachedir.
+        sqlite3_cache._connections.clear()
+        second = salt.cache.Cache(opts, driver="sqlite3")
+        assert second.fetch("minions/alpha", "grains") == {"os": "Linux"}
+        sqlite3_cache._connections.clear()
+
+    def test_database_is_a_single_file(self, opts):
+        sqlite3_cache._connections.clear()
+        cache = salt.cache.Cache(opts, driver="sqlite3")
+        cache.store("bank", "key", "value")
+        dbpath = os.path.join(opts["cachedir"], "salt_cache.sqlite3")
+        assert os.path.isfile(dbpath)
+        sqlite3_cache._connections.clear()
+
+
+class TestConfig:
+    def test_custom_database_path(self, opts, tmp_path):
+        custom_path = str(tmp_path / "custom" / "cache.db")
+        opts["sqlite3.database"] = custom_path
+        sqlite3_cache._connections.clear()
+        cache = salt.cache.Cache(opts, driver="sqlite3")
+        cache.store("bank", "key", "value")
+        assert os.path.isfile(custom_path)
+        assert cache.fetch("bank", "key") == "value"
+        sqlite3_cache._connections.clear()
+
+    def test_default_cache_driver_is_unaffected(self, tmp_path):
+        opts = salt.config.DEFAULT_MASTER_OPTS.copy()
+        opts["cachedir"] = str(tmp_path / "cache")
+        assert opts["cache"] == "localfs"
+        cache = salt.cache.Cache(opts)
+        cache.store("bank", "key", "value")
+        assert cache.fetch("bank", "key") == "value"
+        assert not os.path.exists(
+            os.path.join(opts["cachedir"], "salt_cache.sqlite3")
+        )
