+++ b/salt/cache/sqlite3_cache.py
@@ -0,0 +1,371 @@
+"""
+Cache data in a single SQLite database file on disk.
+
+.. versionadded:: 3009.0
+
+``sqlite3`` is a drop-in, durable replacement for the default ``localfs``
+cache backend, aimed at single-node masters that want their minion data
+cache (grains, mine data, job returns, etc.) to survive a master restart
+without standing up a separate database service such as Redis or MySQL.
+All of the storage lives in one ordinary file on disk, and the driver only
+uses the :mod:`sqlite3 <python:sqlite3>` module from the Python standard
+library, so there is nothing extra to install.
+
+To use it, set the master ``cache`` config value to ``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+Optionally, the database file location and table name can be overridden.
+These are the defaults:
+
+.. code-block:: yaml
+
+    sqlite3.database: <cachedir>/salt_cache.sqlite3
+    sqlite3.table_name: cache
+    sqlite3.timeout: 30
+
+Deployments that do not set ``cache: sqlite3`` are unaffected; ``localfs``
+remains the default cache driver.
+
+.. note::
+
+    ``sqlite3.table_name`` is interpolated directly into the SQL statements
+    issued by this driver (SQLite does not support parameterized table
+    names). Salt treats this configuration value as trusted input, the same
+    way the ``mysql`` cache driver treats ``mysql.table_name``.
+
+Entries stored with an ``expires`` value (for example auth tokens) are
+tracked natively and are treated as absent once they expire, without
+needing the generic fallback wrapper used by drivers that lack expiry
+support.
+"""
+
+import logging
+import os
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+import salt.utils.path
+from salt.exceptions import SaltCacheError
+
+try:
+    import sqlite3
+
+    HAS_SQLITE3 = True
+except ImportError:
+    HAS_SQLITE3 = False
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+_DEFAULT_DB_FILENAME = "salt_cache.sqlite3"
+_DEFAULT_TABLE_NAME = "cache"
+_DEFAULT_TIMEOUT = 30
+
+# Module-level registry of open connections, keyed by the resolved database
+# file path. One connection is kept alive per process for the lifetime of
+# that process, mirroring the ``mmap_cache`` registry pattern.
+_connections = {}
+
+
+def __virtual__():
+    """
+    Confirm that the sqlite3 module (stdlib) is available.
+    """
+    if not HAS_SQLITE3:
+        return (
+            False,
+            "Could not import sqlite3, python sqlite3 library is missing.",
+        )
+    return __virtualname__
+
+
+def __cachedir(kwargs=None):
+    if kwargs and kwargs.get("cachedir"):
+        return kwargs["cachedir"]
+    return __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+
+
+def _dbpath(kwargs=None):
+    configured = __opts__.get("sqlite3.database")
+    if configured:
+        return configured
+    return salt.utils.path.join(__cachedir(kwargs), _DEFAULT_DB_FILENAME)
+
+
+def _table_name():
+    return __opts__.get("sqlite3.table_name", _DEFAULT_TABLE_NAME)
+
+
+def init_kwargs(kwargs):
+    """
+    Return the canonical keyword arguments for this cache driver.
+    """
+    return {"cachedir": __cachedir(kwargs)}
+
+
+def get_storage_id(kwargs):
+    """
+    Return a unique identifier for this cache driver instance.
+    """
+    return ("sqlite3", _dbpath(kwargs))
+
+
+def _connect(dbpath):
+    """
+    Return (or lazily create) the connection/lock pair for *dbpath*, with
+    the cache table already present.
+    """
+    entry = _connections.get(dbpath)
+    if entry is not None:
+        return entry
+
+    db_dir = os.path.dirname(dbpath)
+    if db_dir:
+        try:
+            os.makedirs(db_dir, exist_ok=True)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"The sqlite3 cache directory, {db_dir}, could not be created: {exc}"
+            )
+
+    timeout = __opts__.get("sqlite3.timeout", _DEFAULT_TIMEOUT)
+    try:
+        conn = sqlite3.connect(
+            dbpath,
+            timeout=timeout,
+            isolation_level=None,
+            check_same_thread=False,
+        )
+        # WAL keeps concurrent master worker processes from blocking each
+        # other on every read, and busy_timeout makes writers retry instead
+        # of immediately raising "database is locked".
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute("PRAGMA synchronous=NORMAL")
+        conn.execute(f"PRAGMA busy_timeout={int(timeout * 1000)}")
+        conn.execute(
+            f"CREATE TABLE IF NOT EXISTS {_table_name()} ("
+            "bank TEXT NOT NULL, "
+            "key TEXT NOT NULL, "
+            "data BLOB, "
+            "updated INTEGER NOT NULL, "
+            "expires INTEGER, "
+            "PRIMARY KEY (bank, key))"
+        )
+        conn.execute(
+            f"CREATE INDEX IF NOT EXISTS idx_{_table_name()}_bank "
+            f"ON {_table_name()} (bank)"
+        )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f'There was an error opening the cache file "{dbpath}": {exc}'
+        )
+
+    entry = (conn, threading.Lock())
+    _connections[dbpath] = entry
+    return entry
+
+
+def _execute(dbpath, query, args=()):
+    conn, lock = _connect(dbpath)
+    with lock:
+        try:
+            return conn.execute(query, args)
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f"There was an error accessing the sqlite3 cache: {exc}"
+            )
+
+
+def store(bank, key, data, cachedir=None, expires=None, **kwargs):
+    """
+    Store information in the cache database.
+
+    :param expires:
+        Optional number of seconds from now after which the entry should be
+        considered expired. Expired entries are treated as absent by
+        ``fetch``, ``contains``, ``list`` and ``list_all``, and are
+        physically removed by ``clean_expired``.
+    """
+    dbpath = _dbpath({"cachedir": cachedir} if cachedir else None)
+    try:
+        raw = salt.payload.dumps(data)
+    except Exception as exc:  # pylint: disable=broad-except
+        raise SaltCacheError(f"Failed to serialize cache data for {bank}/{key}: {exc}")
+
+    now = int(time.time())
+    expires_at = now + int(expires) if expires else None
+    _execute(
+        dbpath,
+        f"INSERT OR REPLACE INTO {_table_name()} (bank, key, data, updated, expires) "
+        "VALUES (?, ?, ?, ?, ?)",
+        (bank, key, raw, now, expires_at),
+    )
+
+
+def fetch(bank, key, cachedir=None, **kwargs):
+    """
+    Fetch information from the cache database.
+    """
+    dbpath = _dbpath({"cachedir": cachedir} if cachedir else None)
+    cur = _execute(
+        dbpath,
+        f"SELECT data, expires FROM {_table_name()} WHERE bank=? AND key=?",
+        (bank, key),
+    )
+    row = cur.fetchone()
+    if row is None:
+        return {}
+    data, expires_at = row
+    if expires_at is not None and expires_at <= int(time.time()):
+        _execute(
+            dbpath,
+            f"DELETE FROM {_table_name()} WHERE bank=? AND key=?",
+            (bank, key),
+        )
+        return {}
+    try:
+        return salt.payload.loads(data)
+    except Exception as exc:  # pylint: disable=broad-except
+        raise SaltCacheError(
+            f"There was an error reading the cache entry {bank}/{key}: {exc}"
+        )
+
+
+def updated(bank, key, cachedir=None, **kwargs):
+    """
+    Return the epoch of the last update for this cache entry.
+    """
+    dbpath = _dbpath({"cachedir": cachedir} if cachedir else None)
+    cur = _execute(
+        dbpath,
+        f"SELECT updated FROM {_table_name()} WHERE bank=? AND key=?",
+        (bank, key),
+    )
+    row = cur.fetchone()
+    if row is None:
+        return None
+    return int(row[0])
+
+
+def flush(bank, key=None, cachedir=None, **kwargs):
+    """
+    Remove the key from the cache bank with all the key content. If key is
+    None, remove the entire bank (including any nested sub-banks).
+    """
+    dbpath = _dbpath({"cachedir": cachedir} if cachedir else None)
+    if key is None:
+        cur = _execute(
+            dbpath,
+            f"SELECT 1 FROM {_table_name()} WHERE bank=? OR bank LIKE ? LIMIT 1",
+            (bank, bank + "/%"),
+        )
+        if cur.fetchone() is None:
+            return False
+        _execute(
+            dbpath,
+            f"DELETE FROM {_table_name()} WHERE bank=? OR bank LIKE ?",
+            (bank, bank + "/%"),
+        )
+        return True
+
+    cur = _execute(
+        dbpath,
+        f"DELETE FROM {_table_name()} WHERE bank=? AND key=?",
+        (bank, key),
+    )
+    return cur.rowcount > 0
+
+
+def list_(bank, cachedir=None, **kwargs):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank.
+    """
+    dbpath = _dbpath({"cachedir": cachedir} if cachedir else None)
+    cur = _execute(
+        dbpath,
+        f"SELECT key FROM {_table_name()} WHERE bank=? "
+        "AND (expires IS NULL OR expires > ?)",
+        (bank, int(time.time())),
+    )
+    return [row[0] for row in cur.fetchall()]
+
+
+def list_all(bank, cachedir=None, include_data=False, **kwargs):
+    """
+    Return all entries with their data from the specified bank in a single
+    pass. If include_data is False, only keys are returned (data is {}).
+    """
+    dbpath = _dbpath({"cachedir": cachedir} if cachedir else None)
+    now = int(time.time())
+    if not include_data:
+        cur = _execute(
+            dbpath,
+            f"SELECT key FROM {_table_name()} WHERE bank=? "
+            "AND (expires IS NULL OR expires > ?)",
+            (bank, now),
+        )
+        return {row[0]: {} for row in cur.fetchall()}
+
+    cur = _execute(
+        dbpath,
+        f"SELECT key, data FROM {_table_name()} WHERE bank=? "
+        "AND (expires IS NULL OR expires > ?)",
+        (bank, now),
+    )
+    ret = {}
+    for key, raw in cur.fetchall():
+        try:
+            ret[key] = salt.payload.loads(raw)
+        except Exception as exc:  # pylint: disable=broad-except
+            log.warning(
+                "sqlite3 list_all: skipping undeserialisable entry bank=%r key=%r: %s",
+                bank,
+                key,
+                exc,
+            )
+    return ret
+
+
+def contains(bank, key, cachedir=None, **kwargs):
+    """
+    Checks if the specified bank contains the specified key. If key is None,
+    checks for the existence of the bank itself (including sub-banks).
+    """
+    dbpath = _dbpath({"cachedir": cachedir} if cachedir else None)
+    now = int(time.time())
+    if key is None:
+        cur = _execute(
+            dbpath,
+            f"SELECT 1 FROM {_table_name()} WHERE (bank=? OR bank LIKE ?) "
+            "AND (expires IS NULL OR expires > ?) LIMIT 1",
+            (bank, bank + "/%", now),
+        )
+    else:
+        cur = _execute(
+            dbpath,
+            f"SELECT 1 FROM {_table_name()} WHERE bank=? AND key=? "
+            "AND (expires IS NULL OR expires > ?) LIMIT 1",
+            (bank, key, now),
+        )
+    return cur.fetchone() is not None
+
+
+def clean_expired(bank, cachedir=None, **kwargs):
+    """
+    Physically remove expired entries from the specified bank.
+    """
+    dbpath = _dbpath({"cachedir": cachedir} if cachedir else None)
+    _execute(
+        dbpath,
+        f"DELETE FROM {_table_name()} WHERE bank=? "
+        "AND expires IS NOT NULL AND expires <= ?",
+        (bank, int(time.time())),
+    )
