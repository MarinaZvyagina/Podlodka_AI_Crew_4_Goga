+"""
+Minion data cache plugin for SQLite3.
+
+.. versionadded:: 3008.0
+
+This cache plugin stores the Salt Master's cached minion data (grains, mine
+data, job returns, etc.) in a single ordinary SQLite database file on disk.
+
+Unlike the ``mysql``, ``redis``, ``etcd`` and ``consul`` cache plugins, this
+backend needs nothing beyond what already ships with a standard Python
+installation -- the :py:mod:`sqlite3` module is part of the Python standard
+library, so no additional service or third-party package needs to be
+installed or operated. This makes it a good fit for small, single-node
+setups that still want the cache to survive a restart of the master
+process, without the operational overhead of running a separate database
+service.
+
+To use sqlite3 as the minion data cache backend, set the master ``cache``
+config value to ``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+The following values may optionally be set in the master config. These are
+the defaults:
+
+.. code-block:: yaml
+
+    sqlite3.database: <cachedir>/cache.sqlite3
+    sqlite3.table_name: cache
+    sqlite3.timeout: 5.0
+
+``sqlite3.database`` defaults to a file named ``cache.sqlite3`` inside the
+master's ``cachedir`` (usually ``/var/cache/salt/master``), so in most cases
+no additional configuration is required at all.
+"""
+
+import errno
+import logging
+import os
+import sqlite3
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"ls": "list"}
+
+_DEFAULT_TABLE_NAME = "cache"
+_DEFAULT_TIMEOUT = 5.0
+
+# sqlite3 connections may only be used safely from multiple threads when
+# statements are serialized. Each master process gets its own module
+# instance (and therefore its own lock), so this only needs to guard
+# against concurrent threads within a single process; concurrent access
+# from other processes is handled by SQLite itself via WAL mode and
+# busy_timeout.
+_LOCK = threading.Lock()
+
+
+def __virtual__():
+    """
+    The sqlite3 module is part of the Python standard library, so this
+    cache plugin is always available.
+    """
+    return __virtualname__
+
+
+def _get_db_path():
+    db_path = __opts__.get("sqlite3.database")
+    if db_path:
+        return db_path
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    return os.path.join(cachedir, "cache.sqlite3")
+
+
+def _create_table(conn, table_name):
+    with _LOCK:
+        conn.execute(
+            f"""
+            CREATE TABLE IF NOT EXISTS {table_name} (
+                bank TEXT NOT NULL,
+                cache_key TEXT NOT NULL,
+                data BLOB,
+                last_update REAL NOT NULL,
+                PRIMARY KEY (bank, cache_key)
+            )
+            """
+        )
+        conn.commit()
+
+
+def _connect():
+    """
+    Return the sqlite3 connection for this process, creating it (and the
+    backing table) if it doesn't exist yet.
+    """
+    if __context__.get("sqlite3_client") is not None:
+        return __context__["sqlite3_client"]
+
+    db_path = _get_db_path()
+    if db_path != ":memory:":
+        db_dir = os.path.dirname(db_path)
+        if db_dir and not os.path.isdir(db_dir):
+            try:
+                os.makedirs(db_dir)
+            except OSError as exc:
+                if exc.errno != errno.EEXIST:
+                    raise SaltCacheError(
+                        f"The cache directory, {db_dir}, could not be created: {exc}"
+                    )
+
+    timeout = __opts__.get("sqlite3.timeout", _DEFAULT_TIMEOUT)
+    table_name = __opts__.get("sqlite3.table_name", _DEFAULT_TABLE_NAME)
+    try:
+        conn = sqlite3.connect(db_path, timeout=timeout, check_same_thread=False)
+        # WAL mode allows concurrent readers (and one writer) across the
+        # several worker processes a Salt master typically runs, instead of
+        # locking the whole database file for every write.
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute("PRAGMA synchronous=NORMAL")
+        conn.execute(f"PRAGMA busy_timeout={int(timeout * 1000)}")
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"Could not open the sqlite3 cache database {db_path}: {exc}"
+        )
+
+    __context__["sqlite3_client"] = conn
+    __context__["sqlite3_table_name"] = table_name
+    _create_table(conn, table_name)
+    return conn
+
+
+def _table():
+    return __context__["sqlite3_table_name"]
+
+
+def store(bank, key, data):
+    """
+    Store a key value.
+    """
+    conn = _connect()
+    payload = salt.payload.dumps(data)
+    query = (
+        f"INSERT INTO {_table()} (bank, cache_key, data, last_update) "
+        "VALUES (?, ?, ?, ?) ON CONFLICT(bank, cache_key) "
+        "DO UPDATE SET data=excluded.data, last_update=excluded.last_update"
+    )
+    try:
+        with _LOCK:
+            conn.execute(query, (bank, key, payload, time.time()))
+            conn.commit()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error storing {bank} {key}: {exc}")
+
+
+def fetch(bank, key):
+    """
+    Fetch a key value.
+    """
+    conn = _connect()
+    try:
+        with _LOCK:
+            cur = conn.execute(
+                f"SELECT data FROM {_table()} WHERE bank=? AND cache_key=?",
+                (bank, key),
+            )
+            row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error fetching {bank} {key}: {exc}")
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def flush(bank, key=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key
+    is specified, remove the entire bank with all keys inside.
+    """
+    conn = _connect()
+    try:
+        with _LOCK:
+            if key is None:
+                cur = conn.execute(f"DELETE FROM {_table()} WHERE bank=?", (bank,))
+            else:
+                cur = conn.execute(
+                    f"DELETE FROM {_table()} WHERE bank=? AND cache_key=?",
+                    (bank, key),
+                )
+            conn.commit()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error flushing {bank} {key}: {exc}")
+    return cur.rowcount > 0
+
+
+def ls(bank):
+    """
+    Return an iterable object containing all entries stored in the
+    specified bank.
+    """
+    conn = _connect()
+    try:
+        with _LOCK:
+            cur = conn.execute(
+                f"SELECT cache_key FROM {_table()} WHERE bank=?", (bank,)
+            )
+            return [row[0] for row in cur.fetchall()]
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error listing {bank}: {exc}")
+
+
+def contains(bank, key=None):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    conn = _connect()
+    try:
+        with _LOCK:
+            if key is None:
+                cur = conn.execute(
+                    f"SELECT 1 FROM {_table()} WHERE bank=? LIMIT 1", (bank,)
+                )
+            else:
+                cur = conn.execute(
+                    f"SELECT 1 FROM {_table()} WHERE bank=? AND cache_key=? LIMIT 1",
+                    (bank, key),
+                )
+            return cur.fetchone() is not None
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error checking contains for {bank} {key}: {exc}")
+
+
+def updated(bank, key):
+    """
+    Return the integer Unix epoch update timestamp of the specified bank
+    and key.
+    """
+    conn = _connect()
+    try:
+        with _LOCK:
+            cur = conn.execute(
+                f"SELECT last_update FROM {_table()} WHERE bank=? AND cache_key=?",
+                (bank, key),
+            )
+            row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error fetching updated for {bank} {key}: {exc}")
+    if row is None:
+        return None
+    return int(row[0])
