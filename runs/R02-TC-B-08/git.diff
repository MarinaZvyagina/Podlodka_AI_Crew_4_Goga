@@ -0,0 +1,48 @@
+import logging
+import shutil
+
+import pytest
+
+import salt.cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def cache(minion_opts):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    cache = salt.cache.factory(opts)
+    try:
+        yield cache
+    finally:
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_data_survives_a_new_connection(minion_opts):
+    """
+    Regression check for the whole point of this backend: data stored
+    through one connection/process must still be there when a fresh
+    connection is opened against the same database file, simulating a
+    master restart.
+    """
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    try:
+        first = salt.cache.factory(opts)
+        first.store("bank", "key", {"still": "here"})
+
+        # Drop any in-process connection/context so the next factory call
+        # has to open the sqlite3 file fresh, the way a restarted master
+        # process would.
+        first.destroy()
+
+        second = salt.cache.factory(opts)
+        assert second.fetch("bank", "key") == {"still": "here"}
+    finally:
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
