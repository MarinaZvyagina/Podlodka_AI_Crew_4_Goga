@@ -0,0 +1,107 @@
+"""
+unit tests for the sqlite3_cache cache
+"""
+
+import sqlite3
+
+import pytest
+
+import salt.cache.sqlite3_cache as sqlite3_cache
+from salt.exceptions import SaltCacheError
+from tests.support.mock import MagicMock, patch
+
+
+@pytest.fixture
+def configure_loader_modules(tmp_path):
+    return {
+        sqlite3_cache: {
+            "__opts__": {"cachedir": str(tmp_path)},
+            "__context__": {},
+        }
+    }
+
+
+def test_store_and_fetch():
+    sqlite3_cache.store(bank="minions/minion", key="key1", data={"foo": "bar"})
+    assert sqlite3_cache.fetch(bank="minions/minion", key="key1") == {"foo": "bar"}
+
+
+def test_fetch_missing_key_returns_empty_dict():
+    assert sqlite3_cache.fetch(bank="minions/minion", key="nope") == {}
+
+
+def test_store_overwrites_existing_key():
+    sqlite3_cache.store(bank="bank", key="key", data="one")
+    sqlite3_cache.store(bank="bank", key="key", data="two")
+    assert sqlite3_cache.fetch(bank="bank", key="key") == "two"
+
+
+def test_list():
+    sqlite3_cache.store(bank="bank", key="k1", data="a")
+    sqlite3_cache.store(bank="bank", key="k2", data="b")
+    assert sorted(sqlite3_cache.ls(bank="bank")) == ["k1", "k2"]
+    assert sqlite3_cache.ls(bank="empty") == []
+
+
+def test_contains():
+    sqlite3_cache.store(bank="bank", key="key", data="v")
+    assert sqlite3_cache.contains(bank="bank", key="key") is True
+    assert sqlite3_cache.contains(bank="bank", key="nope") is False
+    assert sqlite3_cache.contains(bank="bank", key=None) is True
+    assert sqlite3_cache.contains(bank="nonexistent", key=None) is False
+
+
+def test_flush_removes_single_key():
+    sqlite3_cache.store(bank="bank", key="k1", data="a")
+    sqlite3_cache.store(bank="bank", key="k2", data="b")
+    assert sqlite3_cache.flush(bank="bank", key="k1") is True
+    assert sqlite3_cache.fetch(bank="bank", key="k1") == {}
+    assert sqlite3_cache.fetch(bank="bank", key="k2") == "b"
+
+
+def test_flush_missing_key_returns_false():
+    assert sqlite3_cache.flush(bank="bank", key="nope") is False
+
+
+def test_flush_entire_bank():
+    sqlite3_cache.store(bank="bank", key="k1", data="a")
+    sqlite3_cache.store(bank="bank", key="k2", data="b")
+    assert sqlite3_cache.flush(bank="bank") is True
+    assert sqlite3_cache.ls(bank="bank") == []
+
+
+def test_updated_returns_none_for_missing_key():
+    assert sqlite3_cache.updated(bank="bank", key="nope") is None
+
+
+def test_updated_returns_int_timestamp():
+    sqlite3_cache.store(bank="bank", key="key", data="v")
+    timestamp = sqlite3_cache.updated(bank="bank", key="key")
+    assert isinstance(timestamp, int)
+
+
+def test_data_persists_across_new_connections(tmp_path):
+    """
+    The whole point of this backend is that data survives a restart of
+    the process holding the connection, since it's an ordinary file on
+    disk rather than an in-memory or ephemeral store.
+    """
+    sqlite3_cache.store(bank="bank", key="key", data={"persisted": True})
+
+    # Simulate a fresh master process: drop the cached connection so the
+    # next call has to open the database file from scratch.
+    sqlite3_cache.__context__.pop("sqlite3_client", None)
+
+    assert sqlite3_cache.fetch(bank="bank", key="key") == {"persisted": True}
+
+
+def test_store_raises_saltcacheerror_on_db_error():
+    with patch.object(sqlite3_cache, "_connect", MagicMock()) as mock_connect:
+        mock_connect.return_value.execute.side_effect = sqlite3.Error("boom")
+        with patch.object(sqlite3_cache, "_table", MagicMock(return_value="cache")):
+            with pytest.raises(SaltCacheError):
+                sqlite3_cache.store(bank="bank", key="key", data="v")
+
+
+def test_virtual():
+    assert sqlite3_cache.__virtual__() == "sqlite3"
