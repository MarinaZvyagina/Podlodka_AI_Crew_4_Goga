+"""
+SQLite3
+=======
+
+SQLite3 plugin for the Salt caching subsystem.
+
+.. versionadded:: 3009.0
+
+This driver stores the cache in a single file using the ``sqlite3`` module
+from the Python standard library, so it requires no extra service or
+third-party package to be installed. It is intended for small, single-node
+deployments that want their minion data cache (grains, mine data, job
+returns, etc.) to survive a restart of the master without having to stand
+up Redis, MySQL, or another external database.
+
+To enable this cache plugin, set the master ``cache`` config value to
+``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+By default the database file is created inside the master's ``cachedir`` as
+``cache.sqlite3``. This, and the number of seconds to wait on a locked
+database before giving up, can be overridden in the master config:
+
+.. code-block:: yaml
+
+    sqlite3.database: /var/cache/salt/master/cache.sqlite3
+    sqlite3.timeout: 5
+"""
+
+import logging
+import os
+import sqlite3
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+import salt.utils.path
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+_TABLE_NAME = "cache"
+_DEFAULT_DATABASE_FILE = "cache.sqlite3"
+_DEFAULT_TIMEOUT = 5
+
+# Guards access to the connection stored in __context__. sqlite3 connections
+# created with check_same_thread=False may be handed to more than one
+# thread within the same process (e.g. master worker threads sharing a
+# loader context), and concurrent statements on one connection would
+# otherwise race.
+_LOCK = threading.Lock()
+
+
+def __virtual__():
+    return __virtualname__
+
+
+def _database_path():
+    database = __opts__.get("sqlite3.database")
+    if database:
+        return database
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    return salt.utils.path.join(cachedir, _DEFAULT_DATABASE_FILE)
+
+
+def _connect():
+    database = _database_path()
+    database_dir = os.path.dirname(database)
+    if database_dir and not os.path.isdir(database_dir):
+        try:
+            os.makedirs(database_dir)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"Unable to create the cache directory {database_dir}: {exc}"
+            )
+    timeout = __opts__.get("sqlite3.timeout", _DEFAULT_TIMEOUT)
+    try:
+        conn = sqlite3.connect(
+            database,
+            timeout=timeout,
+            isolation_level=None,
+            check_same_thread=False,
+        )
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute("PRAGMA synchronous=NORMAL")
+        conn.execute(
+            f"""CREATE TABLE IF NOT EXISTS {_TABLE_NAME} (
+                bank TEXT NOT NULL,
+                cache_key TEXT NOT NULL,
+                data BLOB,
+                last_update REAL NOT NULL,
+                PRIMARY KEY (bank, cache_key)
+            )"""
+        )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Unable to open cache database {database}: {exc}")
+    return conn
+
+
+def _get_conn():
+    if __context__.get("sqlite3_client") is None:
+        __context__["sqlite3_client"] = _connect()
+    return __context__["sqlite3_client"]
+
+
+def store(bank, key, data):
+    """
+    Store a key value.
+    """
+    data = salt.payload.dumps(data)
+    with _LOCK:
+        conn = _get_conn()
+        try:
+            conn.execute(
+                f"INSERT OR REPLACE INTO {_TABLE_NAME} "
+                "(bank, cache_key, data, last_update) VALUES (?, ?, ?, ?)",
+                (bank, key, data, time.time()),
+            )
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error storing {bank}/{key}: {exc}")
+
+
+def fetch(bank, key):
+    """
+    Fetch a key value.
+    """
+    with _LOCK:
+        conn = _get_conn()
+        try:
+            row = conn.execute(
+                f"SELECT data FROM {_TABLE_NAME} WHERE bank=? AND cache_key=?",
+                (bank, key),
+            ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error fetching {bank}/{key}: {exc}")
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key):
+    """
+    Return the integer Unix epoch update timestamp of the specified bank and
+    key. Return None if the key was not found.
+    """
+    with _LOCK:
+        conn = _get_conn()
+        try:
+            row = conn.execute(
+                f"SELECT last_update FROM {_TABLE_NAME} WHERE bank=? AND cache_key=?",
+                (bank, key),
+            ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error fetching update time for {bank}/{key}: {exc}")
+    return None if row is None else int(row[0])
+
+
+def flush(bank, key=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key is
+    specified, remove the entire bank.
+    """
+    with _LOCK:
+        conn = _get_conn()
+        try:
+            if key is None:
+                cur = conn.execute(f"DELETE FROM {_TABLE_NAME} WHERE bank=?", (bank,))
+            else:
+                cur = conn.execute(
+                    f"DELETE FROM {_TABLE_NAME} WHERE bank=? AND cache_key=?",
+                    (bank, key),
+                )
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error flushing {bank}: {exc}")
+    return cur.rowcount > 0
+
+
+def list_(bank):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank.
+    """
+    with _LOCK:
+        conn = _get_conn()
+        try:
+            rows = conn.execute(
+                f"SELECT cache_key FROM {_TABLE_NAME} WHERE bank=?", (bank,)
+            ).fetchall()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error listing {bank}: {exc}")
+    return [row[0] for row in rows]
+
+
+def contains(bank, key):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    with _LOCK:
+        conn = _get_conn()
+        try:
+            if key is None:
+                query = f"SELECT 1 FROM {_TABLE_NAME} WHERE bank=? LIMIT 1"
+                args = (bank,)
+            else:
+                query = (
+                    f"SELECT 1 FROM {_TABLE_NAME} WHERE bank=? AND cache_key=? LIMIT 1"
+                )
+                args = (bank, key)
+            row = conn.execute(query, args).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error checking {bank}/{key}: {exc}")
+    return row is not None
