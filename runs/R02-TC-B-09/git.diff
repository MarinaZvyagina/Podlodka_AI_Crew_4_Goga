@@ -0,0 +1,126 @@
+"""
+unit tests for the sqlite3_cache cache
+"""
+
+import errno
+import logging
+
+import pytest
+
+import salt.cache.sqlite3_cache as sqlite3_cache
+from salt.exceptions import SaltCacheError
+from tests.support.mock import MagicMock, patch
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def configure_loader_modules(tmp_path):
+    return {sqlite3_cache: {"__opts__": {"cachedir": str(tmp_path)}}}
+
+
+def test_store_fetch_roundtrip():
+    """
+    Data written with store() can be read back with fetch().
+    """
+    sqlite3_cache.store("bank", "key", {"foo": "bar"})
+    assert sqlite3_cache.fetch("bank", "key") == {"foo": "bar"}
+
+
+def test_fetch_missing_key_returns_empty_dict():
+    assert sqlite3_cache.fetch("bank", "no_such_key") == {}
+
+
+def test_store_overwrite():
+    sqlite3_cache.store("bank", "key", {"v": 1})
+    sqlite3_cache.store("bank", "key", {"v": 2})
+    assert sqlite3_cache.fetch("bank", "key") == {"v": 2}
+
+
+def test_updated_is_none_for_missing_key():
+    assert sqlite3_cache.updated("bank", "missing") is None
+
+
+def test_updated_returns_int_after_store():
+    sqlite3_cache.store("bank", "key", {"x": 1})
+    assert isinstance(sqlite3_cache.updated("bank", "key"), int)
+
+
+def test_flush_existing_key_returns_true():
+    sqlite3_cache.store("bank", "key", {"d": 1})
+    assert sqlite3_cache.flush("bank", "key") is True
+    assert sqlite3_cache.fetch("bank", "key") == {}
+
+
+def test_flush_missing_key_returns_false():
+    assert sqlite3_cache.flush("bank", "no_such") is False
+
+
+def test_flush_entire_bank():
+    for k in ("k1", "k2", "k3"):
+        sqlite3_cache.store("bank", k, {"v": k})
+    sqlite3_cache.flush("bank")
+    assert sqlite3_cache.list_("bank") == []
+
+
+def test_list_returns_stored_keys():
+    for k in ("a", "b", "c"):
+        sqlite3_cache.store("bank", k, {"v": k})
+    assert set(sqlite3_cache.list_("bank")) == {"a", "b", "c"}
+
+
+def test_list_empty_bank_returns_empty_list():
+    assert sqlite3_cache.list_("ghost_bank") == []
+
+
+def test_contains_key():
+    sqlite3_cache.store("bank", "key", {"v": 1})
+    assert sqlite3_cache.contains("bank", "key") is True
+    assert sqlite3_cache.contains("bank", "no_such") is False
+
+
+def test_contains_bank():
+    assert sqlite3_cache.contains("ghost", None) is False
+    sqlite3_cache.store("real", "k", {})
+    assert sqlite3_cache.contains("real", None) is True
+
+
+def test_keys_in_different_banks_are_independent():
+    sqlite3_cache.store("bank_a", "key", {"from": "a"})
+    sqlite3_cache.store("bank_b", "key", {"from": "b"})
+    assert sqlite3_cache.fetch("bank_a", "key") == {"from": "a"}
+    assert sqlite3_cache.fetch("bank_b", "key") == {"from": "b"}
+
+
+def test_data_survives_master_restart():
+    """
+    Simulate a master restart: drop the cached connection held in
+    __context__ (as would happen when the master process exits) and confirm
+    a fresh connection to the same database file still has the data.
+    """
+    sqlite3_cache.store("minions/host1", "grains", {"os": "Linux"})
+
+    # Simulate process exit: close and forget the connection.
+    conn = sqlite3_cache.__context__.pop("sqlite3_client")
+    conn.close()
+
+    assert sqlite3_cache.fetch("minions/host1", "grains") == {"os": "Linux"}
+
+
+def test_custom_database_path(tmp_path):
+    custom_db = str(tmp_path / "nested" / "custom.sqlite3")
+    with patch.dict(sqlite3_cache.__opts__, {"sqlite3.database": custom_db}):
+        sqlite3_cache.store("bank", "key", {"v": 1})
+    import os
+
+    assert os.path.isfile(custom_db)
+
+
+def test_cache_dir_creation_failure_raises_saltcacheerror(tmp_path):
+    bad_dir = str(tmp_path / "does" / "not" / "exist" / "cache.sqlite3")
+    with patch.dict(sqlite3_cache.__opts__, {"sqlite3.database": bad_dir}):
+        with patch(
+            "os.makedirs", MagicMock(side_effect=OSError(errno.EACCES, "denied"))
+        ):
+            with pytest.raises(SaltCacheError):
+                sqlite3_cache.store("bank", "key", "data")
