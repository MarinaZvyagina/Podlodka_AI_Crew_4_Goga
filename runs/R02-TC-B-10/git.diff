@@ -0,0 +1,272 @@
+"""
+Cache data in a single SQLite3 database file.
+
+.. versionadded:: 3009.0
+
+The ``sqlite3`` cache module stores the master's minion data cache (cached
+grains, mine data, job returns, and similar) in one ordinary file on disk,
+using a single table in a SQLite database. Unlike the ``consul``,
+``redis``, ``etcd``, and ``mysql`` cache modules, it needs no separate
+database service to install or operate: ``sqlite3`` ships with the Python
+standard library, so this backend works out of the box wherever Salt itself
+runs.
+
+This makes it a good fit for small, single-master deployments that want
+their cache to survive a master restart, without taking on the operational
+overhead of running a dedicated database service.
+
+To enable this cache backend, set the master ``cache`` config value to
+``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+The following options may be set in the master config to control where and
+how the database is created. These are the defaults:
+
+.. code-block:: yaml
+
+    sqlite3.database: <cachedir>/cache.db
+    sqlite3.table_name: cache
+    sqlite3.timeout: 5.0
+
+``sqlite3.database`` defaults to a file named ``cache.db`` inside the
+master's :conf_master:`cachedir`, so in the common case no configuration is
+needed beyond setting ``cache: sqlite3``.
+
+.. warning::
+
+    ``sqlite3.table_name`` is interpolated directly into SQL statements.
+    Salt treats this value as trusted input coming from the master
+    configuration, not from any untrusted source.
+"""
+
+import logging
+import os
+import sqlite3
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+_DEFAULT_TABLE_NAME = "cache"
+_DEFAULT_TIMEOUT = 5.0
+
+
+def __virtual__():
+    """
+    ``sqlite3`` is part of the Python standard library, so this module is
+    always usable.
+    """
+    return __virtualname__
+
+
+def _cachedir(kwargs=None):
+    if kwargs and kwargs.get("cachedir"):
+        return kwargs["cachedir"]
+    return __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+
+
+def _database_path(kwargs=None):
+    configured = __opts__.get("sqlite3.database")
+    if configured:
+        return configured
+    return os.path.join(_cachedir(kwargs), "cache.db")
+
+
+def _table_name():
+    return __opts__.get("sqlite3.table_name", _DEFAULT_TABLE_NAME)
+
+
+def init_kwargs(kwargs):
+    """
+    Effectively a noop. Return an empty dictionary, as this driver keeps
+    all of its configuration in ``__opts__``.
+    """
+    return {}
+
+
+def get_storage_id(kwargs):
+    """
+    Return a unique identifier for this cache driver instance.
+    """
+    return ("sqlite3", _database_path())
+
+
+def _connect():
+    database = _database_path()
+    directory = os.path.dirname(database)
+    if directory and not os.path.isdir(directory):
+        try:
+            os.makedirs(directory)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"The sqlite3 cache directory, {directory}, could not be created: {exc}"
+            )
+
+    timeout = __opts__.get("sqlite3.timeout", _DEFAULT_TIMEOUT)
+    try:
+        conn = sqlite3.connect(
+            database,
+            timeout=timeout,
+            check_same_thread=False,
+            isolation_level=None,
+        )
+        # WAL mode keeps a single writer from blocking concurrent readers,
+        # which matters here since multiple master worker processes each
+        # open their own connection to the same on-disk file.
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute(f"PRAGMA busy_timeout={int(timeout * 1000)}")
+        conn.execute(
+            f"""CREATE TABLE IF NOT EXISTS {_table_name()} (
+                bank TEXT NOT NULL,
+                cache_key TEXT NOT NULL,
+                data BLOB,
+                last_update REAL NOT NULL,
+                PRIMARY KEY (bank, cache_key)
+            )"""
+        )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error opening sqlite3 cache database {database}: {exc}")
+    return conn
+
+
+def _client():
+    """
+    Return the ``(connection, lock)`` pair for this process, lazily opening
+    the database the first time it is needed. A connection created before a
+    ``fork()`` is not safe to keep using afterwards, so a fresh connection is
+    opened whenever the caller's pid changes.
+    """
+    pid = os.getpid()
+    if (
+        __context__.get("sqlite3_client") is None
+        or __context__.get("sqlite3_pid") != pid
+    ):
+        __context__["sqlite3_client"] = _connect()
+        __context__["sqlite3_pid"] = pid
+        __context__["sqlite3_lock"] = threading.Lock()
+    return __context__["sqlite3_client"], __context__["sqlite3_lock"]
+
+
+def store(bank, key, data, **kwargs):
+    """
+    Store a key value.
+    """
+    conn, lock = _client()
+    payload = salt.payload.dumps(data)
+    table = _table_name()
+    with lock:
+        try:
+            conn.execute(
+                f"INSERT INTO {table} (bank, cache_key, data, last_update) "
+                "VALUES (?, ?, ?, ?) "
+                "ON CONFLICT (bank, cache_key) DO UPDATE SET "
+                "data=excluded.data, last_update=excluded.last_update",
+                (bank, key, payload, time.time()),
+            )
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error storing {bank} {key}: {exc}")
+
+
+def fetch(bank, key, **kwargs):
+    """
+    Fetch a key value.
+    """
+    conn, lock = _client()
+    table = _table_name()
+    with lock:
+        try:
+            row = conn.execute(
+                f"SELECT data FROM {table} WHERE bank=? AND cache_key=?", (bank, key)
+            ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error fetching {bank} {key}: {exc}")
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key, **kwargs):
+    """
+    Return the integer Unix epoch update timestamp of the specified bank and
+    key, or ``None`` if the key does not exist.
+    """
+    conn, lock = _client()
+    table = _table_name()
+    with lock:
+        try:
+            row = conn.execute(
+                f"SELECT last_update FROM {table} WHERE bank=? AND cache_key=?",
+                (bank, key),
+            ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error reading update time for {bank} {key}: {exc}")
+    return None if row is None else int(row[0])
+
+
+def flush(bank, key=None, **kwargs):
+    """
+    Remove the key from the cache bank with all the key content. If no key
+    is specified, remove the entire bank.
+    """
+    conn, lock = _client()
+    table = _table_name()
+    with lock:
+        try:
+            if key is None:
+                cur = conn.execute(f"DELETE FROM {table} WHERE bank=?", (bank,))
+            else:
+                cur = conn.execute(
+                    f"DELETE FROM {table} WHERE bank=? AND cache_key=?", (bank, key)
+                )
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error flushing {bank} {key}: {exc}")
+    return cur.rowcount > 0
+
+
+def list_(bank, **kwargs):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank.
+    """
+    conn, lock = _client()
+    table = _table_name()
+    with lock:
+        try:
+            rows = conn.execute(
+                f"SELECT cache_key FROM {table} WHERE bank=?", (bank,)
+            ).fetchall()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error listing {bank}: {exc}")
+    return [row[0] for row in rows]
+
+
+def contains(bank, key=None, **kwargs):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    conn, lock = _client()
+    table = _table_name()
+    with lock:
+        try:
+            if key is None:
+                row = conn.execute(
+                    f"SELECT 1 FROM {table} WHERE bank=? LIMIT 1", (bank,)
+                ).fetchone()
+            else:
+                row = conn.execute(
+                    f"SELECT 1 FROM {table} WHERE bank=? AND cache_key=? LIMIT 1",
+                    (bank, key),
+                ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error checking {bank} {key}: {exc}")
+    return row is not None
