+"""
+Unit tests for the sqlite3 cache driver.
+"""
+
+import os
+import time
+
+import pytest
+
+import salt.cache.sqlite3_cache as sqlite3_cache
+
+
+@pytest.fixture
+def configure_loader_modules(tmp_path):
+    return {sqlite3_cache: {"__opts__": {"cachedir": str(tmp_path)}}}
+
+
+def test_store_and_fetch():
+    sqlite3_cache.store(bank="minions/alpha", key="data", data={"os": "linux"})
+    assert sqlite3_cache.fetch(bank="minions/alpha", key="data") == {"os": "linux"}
+
+
+def test_fetch_missing_key_returns_empty_dict():
+    assert sqlite3_cache.fetch(bank="nope", key="nope") == {}
+
+
+def test_store_overwrites_existing_key():
+    sqlite3_cache.store(bank="bank", key="key", data="first")
+    sqlite3_cache.store(bank="bank", key="key", data="second")
+    assert sqlite3_cache.fetch(bank="bank", key="key") == "second"
+
+
+def test_list_returns_keys_in_bank():
+    sqlite3_cache.store(bank="bank", key="one", data=1)
+    sqlite3_cache.store(bank="bank", key="two", data=2)
+    sqlite3_cache.store(bank="other", key="three", data=3)
+    assert sorted(sqlite3_cache.list_(bank="bank")) == ["one", "two"]
+
+
+def test_list_empty_bank_returns_empty_list():
+    assert sqlite3_cache.list_(bank="empty") == []
+
+
+def test_contains_with_key():
+    sqlite3_cache.store(bank="bank", key="key", data="value")
+    assert sqlite3_cache.contains(bank="bank", key="key")
+    assert not sqlite3_cache.contains(bank="bank", key="other")
+
+
+def test_contains_bank_only():
+    sqlite3_cache.store(bank="bank", key="key", data="value")
+    assert sqlite3_cache.contains(bank="bank", key=None)
+    assert not sqlite3_cache.contains(bank="empty", key=None)
+
+
+def test_flush_single_key_leaves_others():
+    sqlite3_cache.store(bank="bank", key="keep", data="keep")
+    sqlite3_cache.store(bank="bank", key="drop", data="drop")
+    assert sqlite3_cache.flush(bank="bank", key="drop") is True
+    assert sqlite3_cache.contains(bank="bank", key="keep")
+    assert not sqlite3_cache.contains(bank="bank", key="drop")
+
+
+def test_flush_missing_key_returns_false():
+    assert sqlite3_cache.flush(bank="bank", key="missing") is False
+
+
+def test_flush_entire_bank():
+    sqlite3_cache.store(bank="bank", key="one", data=1)
+    sqlite3_cache.store(bank="bank", key="two", data=2)
+    assert sqlite3_cache.flush(bank="bank", key=None) is True
+    assert sqlite3_cache.list_(bank="bank") == []
+
+
+def test_updated_returns_none_for_missing_key():
+    assert sqlite3_cache.updated(bank="bank", key="missing") is None
+
+
+def test_updated_returns_timestamp_after_store():
+    before = int(time.time())
+    sqlite3_cache.store(bank="bank", key="key", data="value")
+    after = int(time.time())
+    timestamp = sqlite3_cache.updated(bank="bank", key="key")
+    assert before <= timestamp <= after
+
+
+def test_database_created_under_cachedir(tmp_path):
+    sqlite3_cache.store(bank="bank", key="key", data="value")
+    assert os.path.isfile(os.path.join(str(tmp_path), "cache.db"))
+
+
+def test_database_path_is_configurable(tmp_path):
+    custom_db = str(tmp_path / "custom" / "salt.db")
+    sqlite3_cache.__opts__["sqlite3.database"] = custom_db
+    try:
+        sqlite3_cache.__context__.pop("sqlite3_client", None)
+        sqlite3_cache.store(bank="bank", key="key", data="value")
+        assert os.path.isfile(custom_db)
+    finally:
+        del sqlite3_cache.__opts__["sqlite3.database"]
+
+
+def test_new_connection_sees_previously_stored_data():
+    """
+    Data written by one connection must be visible after the module's
+    cached connection is torn down and re-opened, simulating a master
+    process restart against the same on-disk database file.
+    """
+    sqlite3_cache.store(bank="bank", key="key", data={"still": "here"})
+    sqlite3_cache.__context__.pop("sqlite3_client", None)
+    sqlite3_cache.__context__.pop("sqlite3_pid", None)
+    assert sqlite3_cache.fetch(bank="bank", key="key") == {"still": "here"}
