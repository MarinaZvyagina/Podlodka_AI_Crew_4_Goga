@@ -0,0 +1,57 @@
+import logging
+import os
+import shutil
+
+import pytest
+
+import salt.cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def cache(minion_opts):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    cache = salt.cache.factory(opts)
+    try:
+        yield cache
+    finally:
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_data_survives_new_cache_instance(minion_opts):
+    """
+    The whole point of this backend is that cached data outlives the
+    process that wrote it (e.g. a master restart). Simulate that by
+    dropping the ``Cache`` object -- and its loader/connection -- and
+    creating a brand new one pointed at the same cachedir.
+    """
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    try:
+        first = salt.cache.factory(opts)
+        first.store("minions/alpha", "data", {"os": "linux"})
+        first.destroy()
+        del first
+
+        second = salt.cache.factory(opts)
+        assert second.fetch("minions/alpha", "data") == {"os": "linux"}
+    finally:
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
+
+
+def test_default_database_path_is_under_cachedir(minion_opts):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    try:
+        cache = salt.cache.factory(opts)
+        cache.store("bank", "key", "value")
+        assert os.path.isfile(os.path.join(opts["cachedir"], "cache.db"))
+    finally:
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
