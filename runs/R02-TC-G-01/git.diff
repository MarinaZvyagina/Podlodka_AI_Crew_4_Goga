@@ -0,0 +1,229 @@
+"""
+Minion data cache plugin for SQLite3.
+
+.. versionadded:: 3009.0
+
+This cache driver stores all cached data (minion grains, mine data, job
+returns, etc.) in a single SQLite database file on disk. It is intended for
+small, single-node Salt masters that want their minion data cache to survive
+a master restart without having to stand up a separate database service such
+as Redis or MySQL.
+
+Because ``sqlite3`` ships as part of the Python standard library, this
+backend requires no additional services or third-party packages to be
+installed.
+
+To use the ``sqlite3`` cache, set the master ``cache`` config value to
+``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+By default the database file is created as ``cache.sqlite3`` inside the
+configured :conf_master:`cachedir`. Both the database path and the timeout
+(in seconds) used while waiting for the database file to become available
+when it is locked by another process can be overridden:
+
+.. code-block:: yaml
+
+    cache.sqlite3.database: /var/cache/salt/master/cache.sqlite3
+    cache.sqlite3.timeout: 5
+"""
+
+import logging
+import os
+import sqlite3
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+import salt.utils.path
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+_TABLE_NAME = "cache"
+
+
+def __virtual__():
+    return __virtualname__
+
+
+def init_kwargs(kwargs):
+    """
+    No per-call state is needed; connection details all come from ``__opts__``.
+    """
+    return {}
+
+
+def _database_path():
+    configured = __opts__.get("cache.sqlite3.database")
+    if configured:
+        return configured
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    return salt.utils.path.join(cachedir, "cache.sqlite3")
+
+
+def _connect():
+    database = _database_path()
+    directory = os.path.dirname(database)
+    if directory and not os.path.isdir(directory):
+        try:
+            os.makedirs(directory)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"The cache directory, {directory}, could not be created: {exc}"
+            )
+
+    timeout = __opts__.get("cache.sqlite3.timeout", 5)
+    try:
+        conn = sqlite3.connect(
+            database,
+            timeout=timeout,
+            check_same_thread=False,
+            isolation_level=None,
+        )
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute("PRAGMA synchronous=NORMAL")
+        conn.execute(
+            f"CREATE TABLE IF NOT EXISTS {_TABLE_NAME} ("
+            "bank TEXT NOT NULL, "
+            "key TEXT NOT NULL, "
+            "data BLOB NOT NULL, "
+            "last_update REAL NOT NULL, "
+            "PRIMARY KEY (bank, key))"
+        )
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"Could not open the SQLite cache database {database}: {exc}"
+        )
+    return conn
+
+
+def _get_conn():
+    """
+    Return the per-process SQLite connection, opening (and creating the
+    table in) the database file the first time it is needed.
+    """
+    ctx = __context__.setdefault("sqlite3_cache", {})
+    if ctx.get("conn") is None:
+        ctx["conn"] = _connect()
+        ctx["lock"] = threading.Lock()
+    return ctx["conn"]
+
+
+def _get_lock():
+    _get_conn()
+    return __context__["sqlite3_cache"]["lock"]
+
+
+def store(bank, key, data):
+    """
+    Store a key value.
+    """
+    conn = _get_conn()
+    payload = salt.payload.dumps(data)
+    with _get_lock():
+        try:
+            conn.execute(
+                f"INSERT INTO {_TABLE_NAME} (bank, key, data, last_update) "
+                "VALUES (?, ?, ?, ?) "
+                "ON CONFLICT (bank, key) DO UPDATE SET "
+                "data=excluded.data, last_update=excluded.last_update",
+                (bank, key, payload, time.time()),
+            )
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error storing {bank}/{key}: {exc}")
+
+
+def fetch(bank, key):
+    """
+    Fetch a key value.
+    """
+    conn = _get_conn()
+    try:
+        cur = conn.execute(
+            f"SELECT data FROM {_TABLE_NAME} WHERE bank=? AND key=?", (bank, key)
+        )
+        row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error fetching {bank}/{key}: {exc}")
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key):
+    """
+    Return the Unix epoch of when the specified bank and key were last
+    updated, or ``None`` if the key does not exist.
+    """
+    conn = _get_conn()
+    try:
+        cur = conn.execute(
+            f"SELECT last_update FROM {_TABLE_NAME} WHERE bank=? AND key=?",
+            (bank, key),
+        )
+        row = cur.fetchone()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error reading update time for {bank}/{key}: {exc}")
+    if row is None:
+        return None
+    return int(row[0])
+
+
+def flush(bank, key=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key
+    is specified, remove the entire bank.
+    """
+    conn = _get_conn()
+    with _get_lock():
+        try:
+            if key is None:
+                cur = conn.execute(f"DELETE FROM {_TABLE_NAME} WHERE bank=?", (bank,))
+            else:
+                cur = conn.execute(
+                    f"DELETE FROM {_TABLE_NAME} WHERE bank=? AND key=?", (bank, key)
+                )
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error flushing {bank}: {exc}")
+    return cur.rowcount > 0
+
+
+def list_(bank):
+    """
+    Return an iterable object containing all entries stored in the specified
+    bank.
+    """
+    conn = _get_conn()
+    try:
+        cur = conn.execute(f"SELECT key FROM {_TABLE_NAME} WHERE bank=?", (bank,))
+        return [row[0] for row in cur.fetchall()]
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error listing {bank}: {exc}")
+
+
+def contains(bank, key=None):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    conn = _get_conn()
+    try:
+        if key is None:
+            cur = conn.execute(
+                f"SELECT 1 FROM {_TABLE_NAME} WHERE bank=? LIMIT 1", (bank,)
+            )
+        else:
+            cur = conn.execute(
+                f"SELECT 1 FROM {_TABLE_NAME} WHERE bank=? AND key=? LIMIT 1",
+                (bank, key),
+            )
+        return cur.fetchone() is not None
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f"Error checking {bank}: {exc}")
