+import logging
+import shutil
+
+import pytest
+
+import salt.cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def cache(minion_opts):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    cache = salt.cache.factory(opts)
+    try:
+        yield cache
+    finally:
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_data_survives_a_new_cache_instance(cache):
+    """
+    Regression check for the primary use case of this backend: data must
+    still be readable from a brand new ``Cache`` object (standing in for a
+    restarted master process) pointed at the same cachedir/database file.
+    """
+    bank = "minions/alpha"
+    key = "data"
+    data = {"grains": {"os": "Linux"}, "mine": {"foo": "bar"}}
+
+    cache.store(bank, key, data)
+
+    opts = cache.opts.copy()
+    opts["cache"] = "sqlite3"
+    opts["cachedir"] = cache.cachedir
+    restarted_cache = salt.cache.factory(opts)
+
+    assert restarted_cache.contains(bank, key)
+    assert restarted_cache.fetch(bank, key) == data
