+"""
+Unit tests for the sqlite3 cache driver
+"""
+
+import logging
+
+import pytest
+
+import salt.cache.sqlite3_cache as sqlite3_cache
+from salt.exceptions import SaltCacheError
+from tests.support.mock import MagicMock, patch
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def configure_loader_modules(tmp_path):
+    return {sqlite3_cache: {"__opts__": {"cachedir": str(tmp_path)}}}
+
+
+def test_store_and_fetch():
+    sqlite3_cache.store("bank", "key", {"foo": "bar"})
+    assert sqlite3_cache.fetch("bank", "key") == {"foo": "bar"}
+
+
+def test_fetch_missing_key_returns_empty_dict():
+    assert sqlite3_cache.fetch("bank", "nope") == {}
+
+
+def test_store_overwrites_existing_key():
+    sqlite3_cache.store("bank", "key", "one")
+    sqlite3_cache.store("bank", "key", "two")
+    assert sqlite3_cache.fetch("bank", "key") == "two"
+
+
+def test_updated_returns_none_for_missing_key():
+    assert sqlite3_cache.updated("bank", "nope") is None
+
+
+def test_updated_returns_int_epoch():
+    sqlite3_cache.store("bank", "key", "data")
+    assert isinstance(sqlite3_cache.updated("bank", "key"), int)
+
+
+def test_list_and_contains():
+    sqlite3_cache.store("bank", "key1", "one")
+    sqlite3_cache.store("bank", "key2", "two")
+    assert sorted(sqlite3_cache.list_("bank")) == ["key1", "key2"]
+    assert sqlite3_cache.contains("bank", "key1") is True
+    assert sqlite3_cache.contains("bank", None) is True
+    assert sqlite3_cache.contains("bank", "missing") is False
+    assert sqlite3_cache.contains("missing-bank", None) is False
+
+
+def test_flush_single_key():
+    sqlite3_cache.store("bank", "key1", "one")
+    sqlite3_cache.store("bank", "key2", "two")
+    assert sqlite3_cache.flush("bank", "key1") is True
+    assert sqlite3_cache.contains("bank", "key1") is False
+    assert sqlite3_cache.contains("bank", "key2") is True
+
+
+def test_flush_entire_bank():
+    sqlite3_cache.store("bank", "key1", "one")
+    sqlite3_cache.store("bank", "key2", "two")
+    assert sqlite3_cache.flush("bank", None) is True
+    assert sqlite3_cache.list_("bank") == []
+
+
+def test_flush_nonexistent_returns_false():
+    assert sqlite3_cache.flush("bank", "nope") is False
+
+
+def test_data_persists_in_configured_database_file(tmp_path):
+    database = tmp_path / "custom" / "cache.sqlite3"
+    with patch.dict(
+        sqlite3_cache.__opts__, {"cache.sqlite3.database": str(database)}
+    ):
+        sqlite3_cache.store("bank", "key", "persisted")
+
+    assert database.exists()
+
+    # A brand new module-level context (as happens on a fresh master
+    # process) must be able to read back the same data from the file.
+    with patch.dict(sqlite3_cache.__context__, {}, clear=True):
+        with patch.dict(
+            sqlite3_cache.__opts__, {"cache.sqlite3.database": str(database)}
+        ):
+            assert sqlite3_cache.fetch("bank", "key") == "persisted"
+
+
+def test_connect_raises_saltcacheerror_when_cachedir_cannot_be_created():
+    with patch.object(
+        sqlite3_cache.os, "makedirs", MagicMock(side_effect=OSError("nope"))
+    ), patch.object(sqlite3_cache.os.path, "isdir", MagicMock(return_value=False)):
+        with pytest.raises(SaltCacheError):
+            sqlite3_cache.store("bank", "key", "data")
