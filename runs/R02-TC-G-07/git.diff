@@ -0,0 +1,56 @@
+import logging
+
+import pytest
+
+import salt.cache
+import salt.cache.sqlite3_cache
+from tests.pytests.functional.cache.helpers import run_common_cache_tests
+
+log = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def cache(minion_opts, tmp_path):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    opts["cachedir"] = str(tmp_path)
+    cache = salt.cache.factory(opts)
+    try:
+        yield cache
+    finally:
+        salt.cache.sqlite3_cache.force_reconnect()
+
+
+def test_caching(subtests, cache):
+    run_common_cache_tests(subtests, cache)
+
+
+def test_data_survives_reconnect(cache, tmp_path):
+    """
+    Regression check for the durability guarantee this backend exists for:
+    data written before a simulated master restart (a fresh connection to
+    the same database file) must still be readable afterwards.
+    """
+    cache.store("grains", "minion1", {"os": "Debian"})
+    salt.cache.sqlite3_cache.force_reconnect()
+    assert cache.fetch("grains", "minion1") == {"os": "Debian"}
+
+
+def test_default_database_lives_in_cachedir(cache, tmp_path):
+    cache.store("bank", "key", "value")
+    assert (tmp_path / "cache.sqlite3").exists()
+
+
+def test_custom_database_path(minion_opts, tmp_path):
+    dbfile = tmp_path / "nested" / "custom.sqlite3"
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite3"
+    opts["cachedir"] = str(tmp_path)
+    opts["sqlite3.database"] = str(dbfile)
+    cache = salt.cache.factory(opts)
+    try:
+        cache.store("bank", "key", "value")
+        assert dbfile.exists()
+        assert cache.fetch("bank", "key") == "value"
+    finally:
+        salt.cache.sqlite3_cache.force_reconnect()
