@@ -0,0 +1,261 @@
+"""
+Minion data cache plugin for SQLite3.
+
+.. versionadded:: 3009.0
+
+Stores cache data -- cached grains, mine data, job returns, and other
+minion data the master keeps in its cache -- in a single ordinary SQLite
+database file on disk. This driver only uses the :mod:`sqlite3` module
+from the Python standard library, so no additional service or
+third-party package needs to be installed. It is intended for small,
+single-node deployments that want the cache to survive a restart of the
+master process without standing up a separate database service such as
+Redis or MySQL.
+
+To use the sqlite3 backend as the master's minion data cache, set the
+``cache`` config value to ``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+Optional configuration (defaults shown):
+
+.. code-block:: yaml
+
+    sqlite3.database: <cachedir>/cache.sqlite3
+    sqlite3.timeout: 5.0
+
+``sqlite3.database``
+    Path to the database file. Leave unset to use the default location
+    inside the master's :conf_master:`cachedir`.
+
+``sqlite3.timeout``
+    Number of seconds to wait for a write lock held by another process or
+    thread before giving up. Multiple master worker processes share the
+    same database file, so a short wait-and-retry window avoids spurious
+    "database is locked" errors under concurrent writes.
+
+The database is opened in ``WAL`` (write-ahead log) journal mode with
+``synchronous=NORMAL``. This keeps the cache durable across a master
+restart while still allowing multiple worker processes to read and write
+the file concurrently.
+"""
+
+import errno
+import logging
+import os
+import sqlite3
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+_DEFAULT_TIMEOUT = 5.0
+_DEFAULT_DBFILE = "cache.sqlite3"
+
+# Connections are opened lazily and kept for the life of the process,
+# keyed by resolved database path so that a process which (re)configures
+# sqlite3.database still gets a connection to the right file. A single
+# global lock serializes all access: it guards the connection cache dict
+# below *and* every query, so two threads in the same process can never
+# interleave calls against the same sqlite3.Connection. Concurrency across
+# processes (multiple master workers sharing the same database file) is
+# handled by sqlite3 itself via WAL mode and the busy-wait timeout below.
+_connections = {}
+_lock = threading.Lock()
+
+
+def __virtual__():
+    return __virtualname__
+
+
+def init_kwargs(kwargs):
+    """
+    Effectively a noop. Return an empty dictionary.
+    """
+    return {}
+
+
+def force_reconnect():
+    """
+    Close and drop all cached sqlite3 connections, forcing them to be
+    reopened (and re-resolved against current opts) on next use.
+    """
+    with _lock:
+        for conn in _connections.values():
+            try:
+                conn.close()
+            except sqlite3.Error:
+                pass
+        _connections.clear()
+
+
+def _dbfile():
+    dbfile = __opts__.get("sqlite3.database")
+    if dbfile:
+        return dbfile
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    return os.path.join(cachedir, _DEFAULT_DBFILE)
+
+
+def _connect():
+    """
+    Return the cached sqlite3 connection for the configured database,
+    opening it (and creating the schema, if needed) the first time it's
+    used. Callers must hold ``_lock``.
+    """
+    dbfile = _dbfile()
+    conn = _connections.get(dbfile)
+    if conn is not None:
+        return conn
+
+    dirname = os.path.dirname(dbfile)
+    if dirname and not os.path.isdir(dirname):
+        try:
+            os.makedirs(dirname)
+        except OSError as exc:
+            if exc.errno != errno.EEXIST:
+                raise SaltCacheError(
+                    f"The cache directory, {dirname}, could not be created: {exc}"
+                )
+
+    timeout = float(__opts__.get("sqlite3.timeout", _DEFAULT_TIMEOUT))
+    try:
+        conn = sqlite3.connect(dbfile, timeout=timeout, check_same_thread=False)
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute("PRAGMA synchronous=NORMAL")
+        conn.execute(
+            "CREATE TABLE IF NOT EXISTS cache ("
+            "bank TEXT NOT NULL, "
+            "key TEXT NOT NULL, "
+            "data BLOB NOT NULL, "
+            "updated INTEGER NOT NULL, "
+            "PRIMARY KEY (bank, key))"
+        )
+        conn.commit()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f"Could not open the sqlite3 cache database {dbfile}: {exc}"
+        )
+
+    _connections[dbfile] = conn
+    return conn
+
+
+def store(bank, key, data, **kwargs):
+    """
+    Store a key value.
+    """
+    payload = salt.payload.dumps(data)
+    now = int(time.time())
+    with _lock:
+        conn = _connect()
+        try:
+            conn.execute(
+                "INSERT OR REPLACE INTO cache (bank, key, data, updated) "
+                "VALUES (?, ?, ?, ?)",
+                (bank, key, payload, now),
+            )
+            conn.commit()
+        except sqlite3.Error as exc:
+            conn.rollback()
+            raise SaltCacheError(f"Error storing {bank}/{key}: {exc}")
+
+
+def fetch(bank, key, **kwargs):
+    """
+    Fetch a key value.
+    """
+    with _lock:
+        conn = _connect()
+        try:
+            row = conn.execute(
+                "SELECT data FROM cache WHERE bank = ? AND key = ?", (bank, key)
+            ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error fetching {bank}/{key}: {exc}")
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key, **kwargs):
+    """
+    Return the Unix Epoch based timestamp of when the key was last
+    updated, or None if the key doesn't exist.
+    """
+    with _lock:
+        conn = _connect()
+        try:
+            row = conn.execute(
+                "SELECT updated FROM cache WHERE bank = ? AND key = ?", (bank, key)
+            ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error reading timestamp for {bank}/{key}: {exc}")
+    return None if row is None else int(row[0])
+
+
+def flush(bank, key=None, **kwargs):
+    """
+    Remove the key from the cache bank with all the key content. If no
+    key is specified, remove the entire bank.
+    """
+    with _lock:
+        conn = _connect()
+        try:
+            if key is None:
+                cur = conn.execute("DELETE FROM cache WHERE bank = ?", (bank,))
+            else:
+                cur = conn.execute(
+                    "DELETE FROM cache WHERE bank = ? AND key = ?", (bank, key)
+                )
+            conn.commit()
+        except sqlite3.Error as exc:
+            conn.rollback()
+            raise SaltCacheError(f"Error flushing {bank}/{key}: {exc}")
+        return cur.rowcount > 0
+
+
+def list_(bank, **kwargs):
+    """
+    Return an iterable object containing all entries stored in the
+    specified bank.
+    """
+    with _lock:
+        conn = _connect()
+        try:
+            rows = conn.execute(
+                "SELECT key FROM cache WHERE bank = ?", (bank,)
+            ).fetchall()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error listing bank {bank}: {exc}")
+    return [row[0] for row in rows]
+
+
+def contains(bank, key=None, **kwargs):
+    """
+    Checks if the specified bank contains the specified key.
+    """
+    with _lock:
+        conn = _connect()
+        try:
+            if key is None:
+                row = conn.execute(
+                    "SELECT 1 FROM cache WHERE bank = ? LIMIT 1", (bank,)
+                ).fetchone()
+            else:
+                row = conn.execute(
+                    "SELECT 1 FROM cache WHERE bank = ? AND key = ? LIMIT 1",
+                    (bank, key),
+                ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"Error checking {bank}/{key}: {exc}")
+    return row is not None
