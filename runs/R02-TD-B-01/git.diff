+def test_usage_caches_within_context():
+    """
+    disk.usage should only shell out to df once per set of arguments
+    for the lifetime of a single __context__ (i.e. a single Salt run).
+    """
+    df_output = "Filesystem     1024-blocks     Used Available Capacity Mounted on\n/dev/sda1         10000     5000      5000      50% /"
+    mock_cmd = MagicMock(return_value=df_output)
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch.dict(
+        disk.__salt__, {"cmd.run": mock_cmd}
+    ), patch("os.path.isfile", MagicMock(return_value=True)):
+        first = disk.usage()
+        second = disk.usage()
+        assert first == second
+        mock_cmd.assert_called_once()
+
+        # Different arguments are cached independently and still hit df.
+        disk.usage(args="k")
+        assert mock_cmd.call_count == 2
+
+
+def test_usage_does_not_leak_across_context():
+    """
+    A fresh __context__ (representing a new, independent Salt run) must
+    not reuse a previous run's cached disk usage results.
+    """
+    df_output = "Filesystem     1024-blocks     Used Available Capacity Mounted on\n/dev/sda1         10000     5000      5000      50% /"
+    mock_cmd = MagicMock(return_value=df_output)
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch.dict(
+        disk.__salt__, {"cmd.run": mock_cmd}
+    ), patch("os.path.isfile", MagicMock(return_value=True)):
+        disk.usage()
+        assert mock_cmd.call_count == 1
+
+    with patch.dict(disk.__context__, {}, clear=True), patch.dict(
+        disk.__grains__, {"kernel": "Linux"}
+    ), patch.dict(disk.__salt__, {"cmd.run": mock_cmd}), patch(
+        "os.path.isfile", MagicMock(return_value=True)
+    ):
+        disk.usage()
+        assert mock_cmd.call_count == 2
+
+
