diff --git a/salt/modules/disk.py b/salt/modules/disk.py
index f766769..8ddf4be 100644
--- a/salt/modules/disk.py
+++ b/salt/modules/disk.py
@@ -87,6 +87,13 @@ def usage(args=None):
 
         Default for SunOS changed to 1 kilobyte blocks
 
+    .. versionchanged:: 3008.0
+
+        The result is now cached in ``__context__`` for the duration of the
+        current Salt run, so calling this function again with the same
+        ``args`` will not re-run ``df``. The cache does not persist between
+        separate Salt runs.
+
     CLI Example:
 
     .. code-block:: bash
@@ -94,6 +101,9 @@ def usage(args=None):
         salt '*' disk.usage
     """
     flags = _clean_flags(args, "disk.usage")
+    contextkey = f"disk.usage_{flags}"
+    if contextkey in __context__:
+        return __context__[contextkey]
     if not os.path.isfile("/etc/mtab") and __grains__["kernel"] == "Linux":
         log.error("df cannot run without /etc/mtab")
         if __grains__.get("virtual_subtype") == "LXC":
@@ -157,6 +167,7 @@ def usage(args=None):
         except IndexError:
             log.error("Problem parsing disk usage information")
             ret = {}
+    __context__[contextkey] = ret
     return ret
 
 
diff --git a/tests/pytests/unit/modules/test_disk.py b/tests/pytests/unit/modules/test_disk.py
index 11b2170..55a213c 100644
--- a/tests/pytests/unit/modules/test_disk.py
+++ b/tests/pytests/unit/modules/test_disk.py
@@ -162,6 +162,32 @@ def test_usage_none():
             assert "" == disk.usage(args=None)
 
 
+def test_usage_caches_result_in_context():
+    """
+    disk.usage should only shell out to df once per set of arguments within
+    a run, caching the parsed result in __context__.
+    """
+    df_output = "Filesystem 1K-blocks Used Available Capacity Mounted-on\n/dev/sda1 10000 5000 5000 50% /\n"
+    mock_cmd = MagicMock(return_value=df_output)
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch.dict(
+        disk.__salt__, {"cmd.run": mock_cmd}
+    ), patch("os.path.isfile", MagicMock(return_value=True)):
+        first = disk.usage()
+        second = disk.usage()
+        assert first == second
+        mock_cmd.assert_called_once()
+
+        # Different arguments are cached separately and still shell out.
+        disk.usage(args="h")
+        assert mock_cmd.call_count == 2
+
+        # Clearing __context__, as happens between separate Salt runs,
+        # forces df to be re-run.
+        disk.__context__.clear()
+        disk.usage()
+        assert mock_cmd.call_count == 3
+
+
 def test_inodeusage(stub_disk_inodeusage):
     with patch.dict(disk.__grains__, {"kernel": "OpenBSD"}), patch(
