diff --git a/salt/modules/disk.py b/salt/modules/disk.py
index f766769..148841b 100644
--- a/salt/modules/disk.py
+++ b/salt/modules/disk.py
@@ -87,6 +87,12 @@ def usage(args=None):
 
         Default for SunOS changed to 1 kilobyte blocks
 
+    .. versionchanged:: 3009.0
+
+        The result is now cached in ``__context__`` for the remainder of the
+        current Salt run, so repeated calls with the same ``args`` no longer
+        re-run ``df``. The cache does not persist between separate Salt runs.
+
     CLI Example:
 
     .. code-block:: bash
@@ -94,6 +100,9 @@ def usage(args=None):
         salt '*' disk.usage
     """
     flags = _clean_flags(args, "disk.usage")
+    cache_key = f"disk.usage.{flags}"
+    if cache_key in __context__:
+        return __context__[cache_key]
     if not os.path.isfile("/etc/mtab") and __grains__["kernel"] == "Linux":
         log.error("df cannot run without /etc/mtab")
         if __grains__.get("virtual_subtype") == "LXC":
@@ -157,6 +166,7 @@ def usage(args=None):
         except IndexError:
             log.error("Problem parsing disk usage information")
             ret = {}
+    __context__[cache_key] = ret
     return ret
 
 
diff --git a/tests/pytests/unit/modules/test_disk.py b/tests/pytests/unit/modules/test_disk.py
index 11b2170..807cfa2 100644
--- a/tests/pytests/unit/modules/test_disk.py
+++ b/tests/pytests/unit/modules/test_disk.py
@@ -162,6 +162,35 @@ def test_usage_none():
             assert "" == disk.usage(args=None)
 
 
+def test_usage_is_cached_within_a_run():
+    df_output = [
+        "Filesystem     1024-blocks     Used Available Capacity Mounted on",
+        "/dev/sda1         10000000  5000000   5000000      50% /",
+    ]
+    mock_cmd = MagicMock(return_value="\n".join(df_output))
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch.dict(
+        disk.__salt__, {"cmd.run": mock_cmd}
+    ), patch("os.path.isfile", MagicMock(return_value=True)):
+        first = disk.usage()
+        second = disk.usage()
+        assert first == second
+        mock_cmd.assert_called_once()
+
+
+def test_usage_cache_is_keyed_by_args():
+    df_output = [
+        "Filesystem     1024-blocks     Used Available Capacity Mounted on",
+        "/dev/sda1         10000000  5000000   5000000      50% /",
+    ]
+    mock_cmd = MagicMock(return_value="\n".join(df_output))
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch.dict(
+        disk.__salt__, {"cmd.run": mock_cmd}
+    ), patch("os.path.isfile", MagicMock(return_value=True)):
+        disk.usage()
+        disk.usage(args="h")
+        assert mock_cmd.call_count == 2
+
+
 def test_inodeusage(stub_disk_inodeusage):
     with patch.dict(disk.__grains__, {"kernel": "OpenBSD"}), patch(
         "salt.modules.disk.inodeusage", MagicMock(return_value=stub_disk_inodeusage)
