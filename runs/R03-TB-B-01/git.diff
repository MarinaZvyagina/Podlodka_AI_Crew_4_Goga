@@ -0,0 +1,68 @@
+import { SocketModule } from '../socket-module.js';
+
+describe('SocketModule', () => {
+  describe('close', () => {
+    const setupSocketModule = (adapter: any, servers: any[]) => {
+      const socketModule = new SocketModule();
+      (socketModule as any).applicationConfig = {
+        getIoAdapter: () => adapter,
+      };
+      servers.forEach((server, index) => {
+        (socketModule as any).socketsContainer.addOne(
+          { key: index },
+          { server, init: null, connection: null, disconnect: null },
+        );
+      });
+      return socketModule;
+    };
+
+    it('should notify each server before closing it', async () => {
+      const calls: string[] = [];
+      const adapter = {
+        notifyShutdown: vi.fn(async (server: any) =>
+          calls.push(`notify:${server.id}`),
+        ),
+        close: vi.fn(async (server: any) => calls.push(`close:${server.id}`)),
+        dispose: vi.fn(async () => {}),
+      };
+      const socketModule = setupSocketModule(adapter, [
+        { id: 'a' },
+        { id: 'b' },
+      ]);
+
+      await socketModule.close();
+
+      expect(adapter.notifyShutdown).toHaveBeenCalledTimes(2);
+      expect(adapter.close).toHaveBeenCalledTimes(2);
+      expect(adapter.dispose).toHaveBeenCalledTimes(1);
+      // notify must happen strictly before close, per server
+      expect(calls.indexOf('notify:a')).toBeLessThan(calls.indexOf('close:a'));
+      expect(calls.indexOf('notify:b')).toBeLessThan(calls.indexOf('close:b'));
+    });
+
+    it('should not fail when the adapter does not implement notifyShutdown', async () => {
+      const closeSpy = vi.fn(async () => {});
+      const adapter = {
+        close: closeSpy,
+        dispose: vi.fn(async () => {}),
+      };
+      const socketModule = setupSocketModule(adapter, [{ id: 'a' }]);
+
+      await expect(socketModule.close()).resolves.toBeUndefined();
+      expect(closeSpy).toHaveBeenCalledTimes(1);
+    });
+
+    it('should be a no-op when there is no application config', async () => {
+      const socketModule = new SocketModule();
+      await expect(socketModule.close()).resolves.toBeUndefined();
+    });
+
+    it('should be a no-op when there is no registered adapter', async () => {
+      const socketModule = new SocketModule();
+      (socketModule as any).applicationConfig = {
+        getIoAdapter: () => undefined,
+      };
+      await expect(socketModule.close()).resolves.toBeUndefined();
+    });
+  });
+});
