+      Array.from(sockets.values()).map(socket =>
+        this.emitAndWaitForFlush(
+          socket,
+          this.shutdownEvent,
+          this.shutdownMessage,
+        ),
+      ),
+    );
+  }
+
+  /**
+   * `Server#close()` tears down every socket's transport right away, without
+   * waiting for packets that are still in flight, so a plain `emit()` can be
+   * silently dropped. This flushes the notice through the engine.io
+   * transport before resolving, falling back to a short timeout so a stalled
+   * client can never block shutdown.
+   */
+  private emitAndWaitForFlush(
+    socket: Socket,
+    event: string,
+    data: unknown,
+  ): Promise<void> {
+    return new Promise<void>(resolve => {
+      const conn = (socket as any).conn;
+      socket.emit(event, data);
+
+      if (!conn || conn.transport?.writable !== false) {
+        resolve();
+        return;
+      }
+      const timer = setTimeout(resolve, 1000);
+      conn.once('drain', () => {
+        clearTimeout(timer);
+        resolve();
+      });
+    });
+  }
 }
