+  /**
+   * Customizes the event name and payload sent to currently connected
+   * clients right before the server closes their connection as part of a
+   * graceful shutdown. Pass `null` as the message to disable the notice.
+   */
+  public setShutdownMessage(data: unknown, event = 'shutdown') {
+    this.shutdownEvent = event;
+    this.shutdownMessage = data;
+  }
+
+  public async notifyShutdown(server: Server | Namespace): Promise<void> {
+    if (this.shutdownMessage === null || this.shutdownMessage === undefined) {
+      return;
+    }
+    // On a top-level `Server`, `.sockets` is the default `Namespace` (not a
+    // `Map`) -- the actual map of connected sockets lives one level deeper.
+    // On a `Namespace`, `.sockets` is already that `Map`.
+    const nestedSockets = (server as any).sockets?.sockets;
+    const sockets: Map<string, Socket> | undefined =
+      nestedSockets instanceof Map ? nestedSockets : (server as any).sockets;
+    if (!sockets?.size) {
+      return;
+    }
