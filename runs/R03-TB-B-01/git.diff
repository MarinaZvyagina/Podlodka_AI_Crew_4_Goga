@@ -0,0 +1,83 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('notifyShutdown', () => {
+    const createClient = (readyState = 1) => ({
+      readyState,
+      send: vi.fn((_payload: string, cb: Function) => cb()),
+    });
+
+    it('should send the default shutdown notice to every open client', async () => {
+      const clientA = createClient();
+      const clientB = createClient();
+      const server = { clients: new Set([clientA, clientB]) };
+
+      await adapter.notifyShutdown(server);
+
+      const expectedPayload = JSON.stringify({
+        event: 'shutdown',
+        data: 'Server is shutting down',
+      });
+      expect(clientA.send).toHaveBeenCalledWith(
+        expectedPayload,
+        expect.any(Function),
+      );
+      expect(clientB.send).toHaveBeenCalledWith(
+        expectedPayload,
+        expect.any(Function),
+      );
+    });
+
+    it('should skip clients that are not in the OPEN state', async () => {
+      const openClient = createClient(1);
+      const closingClient = createClient(2);
+      const server = { clients: new Set([openClient, closingClient]) };
+
+      await adapter.notifyShutdown(server);
+
+      expect(openClient.send).toHaveBeenCalledTimes(1);
+      expect(closingClient.send).not.toHaveBeenCalled();
+    });
+
+    it('should be a no-op when the server has no connected clients', async () => {
+      const server = { clients: new Set() };
+      await expect(adapter.notifyShutdown(server)).resolves.toBeUndefined();
+    });
+
+    it('should be a no-op when the server exposes no clients collection at all', async () => {
+      await expect(adapter.notifyShutdown({})).resolves.toBeUndefined();
+    });
+
+    it('should respect a custom message and event name', async () => {
+      adapter.setShutdownMessage({ reason: 'deploy' }, 'server:shutdown');
+      const client = createClient();
+      const server = { clients: new Set([client]) };
+
+      await adapter.notifyShutdown(server);
+
+      expect(client.send).toHaveBeenCalledWith(
+        JSON.stringify({
+          event: 'server:shutdown',
+          data: { reason: 'deploy' },
+        }),
+        expect.any(Function),
+      );
+    });
+
+    it('should allow disabling the notice entirely', async () => {
+      adapter.setShutdownMessage(null);
+      const client = createClient();
+      const server = { clients: new Set([client]) };
+
+      await adapter.notifyShutdown(server);
+
+      expect(client.send).not.toHaveBeenCalled();
+    });
+  });
+});
