diff --git a/packages/platform-ws/test/ws-adapter.spec.ts b/packages/platform-ws/test/ws-adapter.spec.ts
new file mode 100644
index 0000000..4fbdbfe
--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,73 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('close', () => {
+    function createClient(readyState = 1) {
+      return {
+        readyState,
+        send: vi.fn((_data: string, cb?: Function) => cb?.()),
+        terminate: vi.fn(),
+      };
+    }
+
+    function createServer(clients: any[]) {
+      return {
+        clients: new Set(clients),
+        close: vi.fn((cb: Function) => cb()),
+      };
+    }
+
+    it('should send a shutdown notice to every open client before terminating it', async () => {
+      const client1 = createClient();
+      const client2 = createClient();
+      const server = createServer([client1, client2]);
+
+      await adapter.close(server as any);
+
+      for (const client of [client1, client2]) {
+        expect(client.send).toHaveBeenCalledTimes(1);
+        const [payload] = client.send.mock.calls[0];
+        expect(JSON.parse(payload)).toEqual({
+          event: 'shutdown',
+          data: { message: 'Server is shutting down' },
+        });
+        expect(client.terminate).toHaveBeenCalledTimes(1);
+      }
+      expect(client1.send.mock.invocationCallOrder[0]).toBeLessThan(
+        client1.terminate.mock.invocationCallOrder[0],
+      );
+    });
+
+    it('should skip notifying clients that are not open, but still terminate them', async () => {
+      const closingClient = createClient(2 /* CLOSING */);
+      const server = createServer([closingClient]);
+
+      await adapter.close(server as any);
+
+      expect(closingClient.send).not.toHaveBeenCalled();
+      expect(closingClient.terminate).toHaveBeenCalledTimes(1);
+    });
+
+    it('should close the server normally when there are no connected clients', async () => {
+      const server = createServer([]);
+
+      await adapter.close(server as any);
+
+      expect(server.close).toHaveBeenCalledTimes(1);
+    });
+
+    it('should not throw when the server has no clients property', async () => {
+      const server = {
+        close: vi.fn((cb: Function) => cb()),
+      };
+
+      await expect(adapter.close(server as any)).resolves.toBeUndefined();
+    });
+  });
+});
