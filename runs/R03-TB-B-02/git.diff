@@ -0,0 +1,90 @@
+import { INestApplication } from '@nestjs/common';
+import { WsAdapter } from '@nestjs/platform-ws';
+import { Test } from '@nestjs/testing';
+import { io, Socket } from 'socket.io-client';
+import WebSocket from 'ws';
+import { ApplicationGateway } from '../src/app.gateway.js';
+import { ServerGateway } from '../src/server.gateway.js';
+
+describe('Graceful WebSocket shutdown', () => {
+  let app: INestApplication;
+
+  afterEach(async () => {
+    if (app) {
+      await app.close();
+    }
+  });
+
+  it('should notify connected socket.io clients before disconnecting them on app.close()', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [ApplicationGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    await app.listen(3000);
+
+    const client: Socket = io('http://localhost:8080');
+    await new Promise<void>(resolve => client.on('connect', resolve));
+
+    const shutdownNotice = new Promise<any>(resolve =>
+      client.on('shutdown', resolve),
+    );
+    const disconnected = new Promise<void>(resolve =>
+      client.on('disconnect', () => resolve()),
+    );
+
+    let noticeReceivedBeforeDisconnect = false;
+    shutdownNotice.then(() => {
+      noticeReceivedBeforeDisconnect = true;
+    });
+
+    await app.close();
+    app = undefined as any;
+
+    const data = await shutdownNotice;
+    expect(data).toEqual({ message: 'Server is shutting down' });
+
+    await disconnected;
+    expect(noticeReceivedBeforeDisconnect).toBe(true);
+
+    client.close();
+  });
+
+  it('should notify connected ws clients before disconnecting them on app.close()', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [ServerGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    app.useWebSocketAdapter(new WsAdapter(app) as any);
+    await app.listen(3000);
+
+    const client = new WebSocket('ws://localhost:3000');
+    await new Promise(resolve => client.on('open', resolve));
+
+    const closed = new Promise<void>(resolve => client.on('close', resolve));
+    const message = new Promise<any>(resolve =>
+      client.on('message', data => resolve(JSON.parse(data.toString()))),
+    );
+
+    await app.close();
+    app = undefined as any;
+
+    const payload = await message;
+    expect(payload).toEqual({
+      event: 'shutdown',
+      data: { message: 'Server is shutting down' },
+    });
+
+    await closed;
+  });
+
+  it('should not error when a gateway has no connected clients at shutdown time', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [ApplicationGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    await app.listen(3000);
+
+    await expect(app.close()).resolves.toBeUndefined();
+    app = undefined as any;
+  });
+});
