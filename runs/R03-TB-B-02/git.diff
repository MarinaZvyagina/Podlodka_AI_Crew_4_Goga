diff --git a/packages/platform-socket.io/adapters/io-adapter.ts b/packages/platform-socket.io/adapters/io-adapter.ts
index 90c640c..f0b53c5 100644
--- a/packages/platform-socket.io/adapters/io-adapter.ts
+++ b/packages/platform-socket.io/adapters/io-adapter.ts
@@ -93,10 +93,44 @@ export class IoAdapter extends AbstractWsAdapter {
   }
 
   public async close(server: Server): Promise<void> {
+    await this.notifyClientsOfShutdown(server);
+
     if (this.forceCloseConnections && server.httpServer === this.httpServer) {
       return;
     }
 
     return super.close(server);
   }
+
+  /**
+   * Broadcasts a shutdown notice to every socket still connected to this
+   * server/namespace, then gracefully disconnects each one (draining its
+   * write buffer first) so the notice isn't discarded by the forced,
+   * discard-on-close teardown that follows once every socket has been
+   * accounted for.
+   */
+  protected async notifyClientsOfShutdown(
+    server: Server | Namespace,
+  ): Promise<void> {
+    const nsp: Namespace =
+      (server as Namespace).sockets instanceof Map
+        ? (server as Namespace)
+        : (server as Server).sockets;
+    const sockets = Array.from(nsp.sockets.values());
+    if (!sockets.length) {
+      return;
+    }
+
+    const { event, data } = this.getShutdownMessage();
+    await Promise.all(
+      sockets.map(
+        socket =>
+          new Promise<void>(resolve => {
+            socket.conn.once('close', () => resolve());
+            socket.emit(event, data);
+            socket.disconnect(true);
+          }),
+      ),
+    );
+  }
 }
