+   * (up to a short bound) for each send to reach the socket, so the message
+   * isn't lost to the immediately following forceful `terminate()` call.
+   */
+  private notifyClientsOfShutdown(server: any): Promise<void> {
+    const clients: Set<any> | undefined = server?.clients;
+    if (!clients || clients.size === 0) {
+      return Promise.resolve();
+    }
+    const payload = JSON.stringify(this.getShutdownMessage());
+    const notifications = Array.from(clients)
+      .filter(client => client.readyState === READY_STATE.OPEN_STATE)
+      .map(
+        client =>
+          new Promise<void>(resolve => {
+            const settle = () => resolve();
+            const timer = setTimeout(settle, SHUTDOWN_NOTIFY_TIMEOUT_MS);
+            try {
+              client.send(payload, () => {
+                clearTimeout(timer);
+                settle();
+              });
+            } catch {
+              clearTimeout(timer);
+              settle();
+            }
+          }),
+      );
+    return Promise.all(notifications).then(() => undefined);
+  }
