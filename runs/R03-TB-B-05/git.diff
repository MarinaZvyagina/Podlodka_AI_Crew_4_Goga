+import { INestApplication } from '@nestjs/common';
+import { WsAdapter } from '@nestjs/platform-ws';
+import { Test } from '@nestjs/testing';
+import { io } from 'socket.io-client';
+import WebSocket from 'ws';
+import { ApplicationGateway } from '../src/app.gateway.js';
+
+describe('WebSocket graceful shutdown notification', () => {
+  let app: INestApplication;
+
+  afterEach(async () => {
+    if (app) {
+      await app.close();
+    }
+  });
+
+  describe('IoAdapter (socket.io, default)', () => {
+    it('notifies a connected client before disconnecting it on app.close()', async () => {
+      const testingModule = await Test.createTestingModule({
+        providers: [ApplicationGateway],
+      }).compile();
+      app = testingModule.createNestApplication();
+      await app.listen(3000);
+
+      const client = io('http://localhost:8080');
+      await new Promise<void>((resolve, reject) => {
+        client.on('connect', resolve);
+        client.on('error', reject);
+      });
+
+      const shutdownMessage = new Promise<any>(resolve =>
+        client.once('shutdown', resolve),
+      );
+      const disconnected = new Promise<void>(resolve =>
+        client.once('disconnect', () => resolve()),
+      );
+
+      await app.close();
+      app = undefined as any;
+
+      const message = await shutdownMessage;
+      expect(typeof message?.message).toEqual('string');
+      await disconnected;
+
+      client.close();
+    });
+
+    it('does not hang or throw when closing a gateway with no connected clients', async () => {
+      const testingModule = await Test.createTestingModule({
+        providers: [ApplicationGateway],
+      }).compile();
+      app = testingModule.createNestApplication();
+      await app.listen(3000);
+
+      await expect(app.close()).resolves.toBeUndefined();
+      app = undefined as any;
+    });
+  });
+
+  describe('WsAdapter (ws)', () => {
+    async function createWsApp(): Promise<INestApplication> {
+      const testingModule = await Test.createTestingModule({
+        providers: [ApplicationGateway],
+      }).compile();
+      const application = testingModule.createNestApplication();
+      application.useWebSocketAdapter(new WsAdapter(application) as any);
+      await application.listen(3000);
+      return application;
+    }
+
+    it('notifies a connected client before terminating it on app.close()', async () => {
+      app = await createWsApp();
+
+      const client = new WebSocket('ws://localhost:8080');
+      await new Promise(resolve => client.on('open', resolve));
+
+      const shutdownMessage = new Promise<any>(resolve => {
+        client.once('message', data => resolve(JSON.parse(data.toString())));
+      });
+      const closed = new Promise<void>(resolve =>
+        client.once('close', () => resolve()),
+      );
+
+      const [, message] = await Promise.all([app.close(), shutdownMessage]);
+      app = undefined as any;
+
+      expect(message).toEqual({
+        event: 'shutdown',
+        data: { message: expect.any(String) },
+      });
+      await closed;
+    });
+
+    it('does not hang or throw when closing a gateway with no connected clients', async () => {
+      app = await createWsApp();
+
+      await expect(app.close()).resolves.toBeUndefined();
+      app = undefined as any;
+    });
+  });
+});
