@@ -93,10 +93,34 @@ export class IoAdapter extends AbstractWsAdapter {
   }
 
   public async close(server: Server): Promise<void> {
+    await this.notifyClientsOfShutdown(server);
+
     if (this.forceCloseConnections && server.httpServer === this.httpServer) {
       return;
     }
 
     return super.close(server);
   }
+
+  /**
+   * Broadcasts the shutdown notice to every socket still connected to this
+   * server/namespace before its connections are closed. `Server#close()`
+   * tears down each socket's server-side state synchronously, so a tick is
+   * given here for the emitted packet to actually reach the transport first
+   * (otherwise it can be discarded before it's ever written to the wire). A
+   * no-op (no packets sent, no delay) when nobody is connected.
+   */
+  private async notifyClientsOfShutdown(
+    server: Server | Namespace,
+  ): Promise<void> {
+    // `Server#sockets` is the default ("/") `Namespace`, not a socket map,
+    // so resolve to a `Namespace` either way before reading its size.
+    const namespace = server instanceof Namespace ? server : server.sockets;
+    if (namespace.sockets.size === 0) {
+      return;
+    }
+    const { event, data } = this.getShutdownMessage();
+    server.emit(event, data);
+    await new Promise<void>(resolve => setImmediate(resolve));
+  }
 }
