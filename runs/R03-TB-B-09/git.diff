+
+  /**
+   * Notifies every client currently connected to this server/namespace that
+   * the server is shutting down, right before their connection is closed.
+   * Override to customize the event name or payload.
+   */
+  protected async notifyClientsOfShutdown(
+    server: Server | Namespace,
+  ): Promise<void> {
+    server.emit(SHUTDOWN_EVENT);
