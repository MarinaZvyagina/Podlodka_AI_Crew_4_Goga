diff --git a/packages/platform-ws/test/ws-adapter.spec.ts b/packages/platform-ws/test/ws-adapter.spec.ts
new file mode 100644
index 0000000..1e6827e
--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,47 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('close', () => {
+    function createClient(readyState: number) {
+      return { readyState, send: vi.fn(), terminate: vi.fn() };
+    }
+
+    it('should send a shutdown message to every open client before terminating them', async () => {
+      const openClient = createClient(1 /* OPEN */);
+      const connectingClient = createClient(0 /* CONNECTING */);
+      const calls: string[] = [];
+      const fakeServer = {
+        clients: new Set([openClient, connectingClient]),
+        close: vi.fn((cb: Function) => {
+          calls.push('close');
+          cb();
+        }),
+      } as any;
+
+      openClient.send.mockImplementation(() => calls.push('send'));
+
+      await adapter.close(fakeServer);
+
+      expect(openClient.send).toHaveBeenCalledWith(
+        JSON.stringify({ event: 'shutdown' }),
+      );
+      expect(connectingClient.send).not.toHaveBeenCalled();
+      // the notification must be flushed before the server (and its clients) are closed
+      expect(calls).toEqual(['send', 'close']);
+    });
+
+    it('should not throw when the server has no clients', async () => {
+      const fakeServer = {
+        close: vi.fn((cb: Function) => cb()),
+      } as any;
+
+      await expect(adapter.close(fakeServer)).resolves.toBeUndefined();
+    });
+  });
+});
