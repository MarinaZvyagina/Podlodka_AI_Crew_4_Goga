index 0000000..cbb6305
--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,102 @@
+import { SHUTDOWN_EVENT, SHUTDOWN_MESSAGE } from '@nestjs/websockets/internal';
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+enum READY_STATE {
+  CONNECTING_STATE = 0,
+  OPEN_STATE = 1,
+  CLOSING_STATE = 2,
+  CLOSED_STATE = 3,
+}
+
+function createFakeClient(readyState = READY_STATE.OPEN_STATE) {
+  return {
+    readyState,
+    send: vi.fn((_data: string, cb: Function) => cb()),
+    terminate: vi.fn(),
+  };
+}
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('close', () => {
+    it('should send a shutdown notification to every open client before terminating it', async () => {
+      const client = createFakeClient();
+      const fakeServer = {
+        clients: new Set([client]),
+        close: vi.fn((cb: Function) => cb()),
+      } as any;
+
+      await adapter.close(fakeServer);
+
+      expect(client.send).toHaveBeenCalledWith(
+        JSON.stringify({ event: SHUTDOWN_EVENT, data: SHUTDOWN_MESSAGE }),
+        expect.any(Function),
+      );
+      expect(client.terminate).toHaveBeenCalledTimes(1);
+      // terminate should only run after the notification has been handed off
+      const sendOrder = client.send.mock.invocationCallOrder[0];
+      const terminateOrder = client.terminate.mock.invocationCallOrder[0];
+      expect(sendOrder).toBeLessThan(terminateOrder);
+    });
+
+    it('should skip the notification and just terminate clients that are not open', async () => {
+      const client = createFakeClient(READY_STATE.CLOSING_STATE);
+      const fakeServer = {
+        clients: new Set([client]),
+        close: vi.fn((cb: Function) => cb()),
+      } as any;
+
+      await adapter.close(fakeServer);
+
+      expect(client.send).not.toHaveBeenCalled();
+      expect(client.terminate).toHaveBeenCalledTimes(1);
+    });
+
+    it('should terminate the client even if sending the notification throws', async () => {
+      const client = {
+        readyState: READY_STATE.OPEN_STATE,
+        send: vi.fn(() => {
+          throw new Error('socket hang up');
+        }),
+        terminate: vi.fn(),
+      };
+      const fakeServer = {
+        clients: new Set([client]),
+        close: vi.fn((cb: Function) => cb()),
+      } as any;
+
+      await expect(adapter.close(fakeServer)).resolves.toBeUndefined();
+      expect(client.terminate).toHaveBeenCalledTimes(1);
+    });
+
+    it('should not throw when there are no connected clients', async () => {
+      const fakeServer = {
+        clients: new Set(),
+        close: vi.fn((cb: Function) => cb()),
+      } as any;
+
+      await expect(adapter.close(fakeServer)).resolves.toBeUndefined();
+    });
+
+    it('should notify multiple clients independently', async () => {
+      const clientA = createFakeClient();
+      const clientB = createFakeClient();
+      const fakeServer = {
+        clients: new Set([clientA, clientB]),
+        close: vi.fn((cb: Function) => cb()),
+      } as any;
+
+      await adapter.close(fakeServer);
+
+      expect(clientA.send).toHaveBeenCalledTimes(1);
+      expect(clientB.send).toHaveBeenCalledTimes(1);
+      expect(clientA.terminate).toHaveBeenCalledTimes(1);
+      expect(clientB.terminate).toHaveBeenCalledTimes(1);
+    });
+  });
+});
