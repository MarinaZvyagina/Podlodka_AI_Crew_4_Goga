   public async close(server: Server): Promise<void> {
+    this.notifyShutdown(server);
+    // The broadcasted packet is handed off to the underlying transport
+    // asynchronously (e.g. the `ws` library uncorks its write on the next
+    // tick). Yield once so it is actually flushed before the transport gets
+    // torn down below - otherwise the notification races the disconnect.
+    await new Promise<void>(resolve => setImmediate(resolve));
+
     if (this.forceCloseConnections && server.httpServer === this.httpServer) {
       return;
     }
 
     return super.close(server);
   }
+
+  /**
+   * Gives already-connected clients a heads-up that the server is about to
+   * close their connection, before the actual disconnect happens below.
+   *
+   * `Server#emit` is a plain `EventEmitter#emit` (used for events such as
+   * "connection") and does not reach clients — broadcasting has to go
+   * through the default namespace ("/") instead, which is what `Server`
+   * itself delegates to internally (see `Server#send`/`Server#write`). A
+   * `Namespace` returned by `.of(...)` broadcasts directly via `emit`.
+   */
+  protected notifyShutdown(server: Server): void {
+    const broadcaster: { emit: Function } =
+      typeof (server as any).sockets?.emit === 'function'
+        ? (server as any).sockets
+        : server;
+    broadcaster.emit(SHUTDOWN_EVENT, SHUTDOWN_MESSAGE);
+  }
 }
