@@ -0,0 +1,116 @@
+import { INestApplication } from '@nestjs/common';
+import { NestFactory } from '@nestjs/core';
+import { ExpressAdapter } from '@nestjs/platform-express';
+import { WsAdapter } from '@nestjs/platform-ws';
+import { io, Socket as IoSocket } from 'socket.io-client';
+import WebSocket from 'ws';
+import { AppModule } from '../src/app.module.js';
+import { WebSocketsAppModule } from '../src/websockets.module.js';
+
+describe('Graceful Shutdown (WebSockets)', () => {
+  let app: INestApplication;
+
+  afterEach(async () => {
+    if (app) {
+      await app.close();
+    }
+  });
+
+  it('should notify connected socket.io clients before disconnecting them on shutdown', async () => {
+    app = await NestFactory.create(
+      WebSocketsAppModule,
+      new ExpressAdapter() as any,
+      { logger: false },
+    );
+    await app.listen(0);
+    const port = (app.getHttpServer().address() as any).port;
+
+    const client: IoSocket = io(`http://localhost:${port}`);
+    await new Promise<void>(resolve => client.on('connect', () => resolve()));
+
+    const events: string[] = [];
+    const shutdownMessage = new Promise<any>(resolve => {
+      client.on('shutdown', data => {
+        events.push('shutdown');
+        resolve(data);
+      });
+    });
+    const disconnected = new Promise<void>(resolve => {
+      client.on('disconnect', () => {
+        events.push('disconnect');
+        resolve();
+      });
+    });
+
+    await app.close();
+    app = undefined as any;
+
+    const message = await shutdownMessage;
+    await disconnected;
+
+    expect(message).toBe('Server is shutting down');
+    expect(events).toEqual(['shutdown', 'disconnect']);
+  });
+
+  it('should notify connected ws clients before terminating them on shutdown', async () => {
+    app = await NestFactory.create(
+      WebSocketsAppModule,
+      new ExpressAdapter() as any,
+      { logger: false },
+    );
+    app.useWebSocketAdapter(new WsAdapter(app));
+    await app.listen(0);
+    const port = (app.getHttpServer().address() as any).port;
+
+    const client = new WebSocket(`ws://localhost:${port}`);
+    await new Promise<void>(resolve => client.on('open', () => resolve()));
+
+    const events: string[] = [];
+    const shutdownMessage = new Promise<any>(resolve => {
+      client.on('message', data => {
+        events.push('message');
+        resolve(JSON.parse(data.toString()));
+      });
+    });
+    const closed = new Promise<void>(resolve => {
+      client.on('close', () => {
+        events.push('close');
+        resolve();
+      });
+    });
+
+    await app.close();
+    app = undefined as any;
+
+    const message = await shutdownMessage;
+    await closed;
+
+    expect(message).toEqual({
+      event: 'shutdown',
+      data: 'Server is shutting down',
+    });
+    expect(events).toEqual(['message', 'close']);
+  });
+
+  it('should close cleanly when a gateway has no connected clients', async () => {
+    app = await NestFactory.create(
+      WebSocketsAppModule,
+      new ExpressAdapter() as any,
+      { logger: false },
+    );
+    await app.listen(0);
+
+    await expect(app.close()).resolves.toBeUndefined();
+    app = undefined as any;
+  });
+
+  it('should close cleanly for apps that do not use WebSockets at all', async () => {
+    app = await NestFactory.create(AppModule, new ExpressAdapter() as any, {
+      logger: false,
+    });
+    await app.listen(0);
+
+    await expect(app.close()).resolves.toBeUndefined();
+    app = undefined as any;
+  });
+});
