diff --git a/packages/platform-ws/test/ws-adapter.spec.ts b/packages/platform-ws/test/ws-adapter.spec.ts
new file mode 100644
index 0000000..dfc634a
--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,103 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+enum READY_STATE {
+  CONNECTING_STATE = 0,
+  OPEN_STATE = 1,
+  CLOSING_STATE = 2,
+  CLOSED_STATE = 3,
+}
+
+function createFakeClient(readyState = READY_STATE.OPEN_STATE) {
+  const calls: string[] = [];
+  return {
+    readyState,
+    send: vi.fn((_data: string, callback: () => void) => {
+      calls.push('send');
+      callback();
+    }),
+    terminate: vi.fn(() => {
+      calls.push('terminate');
+    }),
+    calls,
+  };
+}
+
+function createFakeServer(clients: any[]) {
+  return {
+    clients,
+    close: vi.fn((callback: (err?: Error) => void) => callback()),
+  };
+}
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('close', () => {
+    it('should send a shutdown message to every open client before terminating it', async () => {
+      const client = createFakeClient();
+      const server = createFakeServer([client]);
+
+      await adapter.close(server as any);
+
+      expect(client.send).toHaveBeenCalledTimes(1);
+      expect(JSON.parse(client.send.mock.calls[0][0])).toEqual({
+        event: 'shutdown',
+        data: 'Server is shutting down',
+      });
+      expect(client.terminate).toHaveBeenCalledTimes(1);
+      expect(client.calls).toEqual(['send', 'terminate']);
+    });
+
+    it('should not send a message to clients that are not open, but should still terminate them', async () => {
+      const client = createFakeClient(READY_STATE.CLOSING_STATE);
+      const server = createFakeServer([client]);
+
+      await adapter.close(server as any);
+
+      expect(client.send).not.toHaveBeenCalled();
+      expect(client.terminate).toHaveBeenCalledTimes(1);
+    });
+
+    it('should notify multiple connected clients', async () => {
+      const clients = [createFakeClient(), createFakeClient()];
+      const server = createFakeServer(clients);
+
+      await adapter.close(server as any);
+
+      clients.forEach(client => {
+        expect(client.send).toHaveBeenCalledTimes(1);
+        expect(client.terminate).toHaveBeenCalledTimes(1);
+      });
+    });
+
+    it('should still close the server when there are no connected clients', async () => {
+      const server = createFakeServer([]);
+
+      await adapter.close(server as any);
+
+      expect(server.close).toHaveBeenCalledTimes(1);
+    });
+
+    it('should close the server even when it has no clients property', async () => {
+      const server = { close: vi.fn((callback: () => void) => callback()) };
+
+      await expect(adapter.close(server as any)).resolves.toBeUndefined();
+      expect(server.close).toHaveBeenCalledTimes(1);
+    });
+
+    it('should not throw if sending the shutdown message fails', async () => {
+      const client = createFakeClient();
+      client.send = vi.fn(() => {
+        throw new Error('not open on this socket');
+      });
+      const server = createFakeServer([client]);
+
+      await expect(adapter.close(server as any)).resolves.toBeUndefined();
+      expect(client.terminate).toHaveBeenCalledTimes(1);
+    });
+  });
+});
diff --git a/packages/websockets/constants.ts b/packages/websockets/constants.ts
index e8b7b8e..0062ea5 100644
--- a/packages/websockets/constants.ts
+++ b/packages/websockets/constants.ts
@@ -13,3 +13,18 @@ export const CONNECTION_EVENT = 'connection';
 export const DISCONNECT_EVENT = 'disconnect';
 export const CLOSE_EVENT = 'close';
 export const ERROR_EVENT = 'error';
+
+/**
+ * Event name/message broadcast to every connected client immediately
+ * before an adapter closes its server as part of application shutdown.
+ */
+export const SHUTDOWN_EVENT = 'shutdown';
+export const SHUTDOWN_MESSAGE = 'Server is shutting down';
+
+/**
+ * Upper bound (in ms) an adapter will wait for connected clients to
+ * disconnect on their own after being notified of a shutdown, before
+ * forcibly closing any that remain.
+ */
+export const SHUTDOWN_DISCONNECT_TIMEOUT = 1000;
+export const SHUTDOWN_DISCONNECT_POLL_INTERVAL = 20;
