@@ -93,10 +99,44 @@ export class IoAdapter extends AbstractWsAdapter {
   }
 
   public async close(server: Server): Promise<void> {
+    await this.notifyAndWaitForClients(server);
+
     if (this.forceCloseConnections && server.httpServer === this.httpServer) {
       return;
     }
 
     return super.close(server);
   }
+
+  /**
+   * Broadcasts a shutdown notice to every client connected to `server` and
+   * gives them a bounded window to disconnect on their own before the
+   * caller forcibly tears down the underlying transport. `server.close()`
+   * (invoked by the engine.io layer right after this resolves) discards any
+   * connections still open at that point, so without this wait the shutdown
+   * packet can be dropped mid-flight.
+   */
+  private async notifyAndWaitForClients(
+    server: Server | Namespace,
+  ): Promise<void> {
+    const isServer = isFunction((server as Server).of);
+    const engine = isServer ? (server as Server).engine : undefined;
+    if (engine && engine.clientsCount === 0) {
+      return;
+    }
+
+    server.emit(SHUTDOWN_EVENT, SHUTDOWN_MESSAGE);
+    server.disconnectSockets(false);
+
+    if (!engine) {
+      return;
+    }
+
+    const deadline = Date.now() + SHUTDOWN_DISCONNECT_TIMEOUT;
+    while (engine.clientsCount > 0 && Date.now() < deadline) {
+      await new Promise(resolve =>
+        setTimeout(resolve, SHUTDOWN_DISCONNECT_POLL_INTERVAL),
+      );
+    }
+  }
 }
