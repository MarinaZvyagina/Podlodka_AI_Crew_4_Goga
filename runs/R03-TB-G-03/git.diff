@@ -0,0 +1,63 @@
+import { SocketModule } from '../socket-module.js';
+
+describe('SocketModule', () => {
+  describe('close', () => {
+    const setup = (adapter: any, servers: Array<{ server: any }>) => {
+      const socketModule = new SocketModule();
+      (socketModule as any).applicationConfig = {
+        getIoAdapter: () => adapter,
+      };
+      (socketModule as any).socketsContainer = {
+        getAll: () => new Map(servers.map((entry, i) => [i, entry])),
+        clear: vi.fn(),
+      };
+      return socketModule;
+    };
+
+    it('should notify a server of shutdown before closing it', async () => {
+      const callOrder: string[] = [];
+      const server = {};
+      const adapter = {
+        notifyShutdown: vi.fn(async () => {
+          callOrder.push('notifyShutdown');
+        }),
+        close: vi.fn(async () => {
+          callOrder.push('close');
+        }),
+        dispose: vi.fn(),
+      };
+
+      await setup(adapter, [{ server }]).close();
+
+      expect(adapter.notifyShutdown).toHaveBeenCalledWith(server);
+      expect(adapter.close).toHaveBeenCalledWith(server);
+      expect(callOrder).toEqual(['notifyShutdown', 'close']);
+    });
+
+    it('should still close servers when the adapter does not implement notifyShutdown', async () => {
+      const server = {};
+      const adapter = {
+        close: vi.fn(async () => undefined),
+        dispose: vi.fn(),
+      };
+
+      await expect(
+        setup(adapter, [{ server }]).close(),
+      ).resolves.not.toThrow();
+      expect(adapter.close).toHaveBeenCalledWith(server);
+    });
+
+    it('should not notify or close anything when there are no registered servers', async () => {
+      const adapter = {
+        notifyShutdown: vi.fn(),
+        close: vi.fn(),
+        dispose: vi.fn(),
+      };
+
+      await setup(adapter, []).close();
+
+      expect(adapter.notifyShutdown).not.toHaveBeenCalled();
+      expect(adapter.close).not.toHaveBeenCalled();
+    });
+  });
+});
