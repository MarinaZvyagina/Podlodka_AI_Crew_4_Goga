diff --git a/packages/platform-ws/test/ws-adapter.spec.ts b/packages/platform-ws/test/ws-adapter.spec.ts
new file mode 100644
index 0000000..a5c0e1f
--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,55 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('notifyShutdown', () => {
+    const createClient = (readyState: number) => ({
+      readyState,
+      send: vi.fn((_data: string, cb: () => void) => cb()),
+    });
+
+    it('should send a shutdown message to every open client', async () => {
+      const openClient = createClient(1 /* OPEN */);
+      const server = { clients: new Set([openClient]) } as any;
+
+      await adapter.notifyShutdown(server);
+
+      expect(openClient.send).toHaveBeenCalledTimes(1);
+      const [payload] = openClient.send.mock.calls[0];
+      expect(JSON.parse(payload)).toEqual({
+        event: 'shutdown',
+        data: { message: expect.any(String) },
+      });
+    });
+
+    it('should skip clients that are not currently open', async () => {
+      const connectingClient = createClient(0 /* CONNECTING */);
+      const closingClient = createClient(2 /* CLOSING */);
+      const server = {
+        clients: new Set([connectingClient, closingClient]),
+      } as any;
+
+      await adapter.notifyShutdown(server);
+
+      expect(connectingClient.send).not.toHaveBeenCalled();
+      expect(closingClient.send).not.toHaveBeenCalled();
+    });
+
+    it('should not throw when the server has no clients registry', async () => {
+      const server = {} as any;
+
+      await expect(adapter.notifyShutdown(server)).resolves.not.toThrow();
+    });
+
+    it('should not throw when there are no connected clients', async () => {
+      const server = { clients: new Set() } as any;
+
+      await expect(adapter.notifyShutdown(server)).resolves.not.toThrow();
+    });
+  });
+});
