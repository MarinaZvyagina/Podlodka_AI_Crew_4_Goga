diff --git a/packages/platform-ws/test/ws-adapter.spec.ts b/packages/platform-ws/test/ws-adapter.spec.ts
new file mode 100644
index 0000000..862d2d6
--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,66 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('close', () => {
+    const createClient = (readyState = 1) => ({
+      readyState,
+      send: vi.fn((_message: string, callback: Function) => callback()),
+      terminate: vi.fn(),
+    });
+
+    it('should send a shutdown notice to every open client before terminating it', async () => {
+      const clientA = createClient();
+      const clientB = createClient();
+      const closeSpy = vi.fn((cb: Function) => cb());
+      const fakeServer = {
+        clients: new Set([clientA, clientB]),
+        close: closeSpy,
+      } as any;
+
+      await adapter.close(fakeServer);
+
+      const expectedMessage = JSON.stringify({
+        event: 'shutdown',
+        data: undefined,
+      });
+      for (const client of [clientA, clientB]) {
+        expect(client.send).toHaveBeenCalledWith(
+          expectedMessage,
+          expect.any(Function),
+        );
+        // the shutdown notice must be flushed before the connection is terminated
+        expect(client.send.mock.invocationCallOrder[0]).toBeLessThan(
+          client.terminate.mock.invocationCallOrder[0],
+        );
+      }
+    });
+
+    it('should not send a shutdown notice to clients that are not open', async () => {
+      const connectingClient = createClient(0 /* CONNECTING */);
+      const closeSpy = vi.fn((cb: Function) => cb());
+      const fakeServer = {
+        clients: new Set([connectingClient]),
+        close: closeSpy,
+      } as any;
+
+      await adapter.close(fakeServer);
+
+      expect(connectingClient.send).not.toHaveBeenCalled();
+      expect(connectingClient.terminate).toHaveBeenCalled();
+    });
+
+    it('should resolve without throwing when there are no connected clients', async () => {
+      const closeSpy = vi.fn((cb: Function) => cb());
+      const fakeServer = { clients: new Set(), close: closeSpy } as any;
+
+      await expect(adapter.close(fakeServer)).resolves.toBeUndefined();
+      expect(closeSpy).toHaveBeenCalled();
+    });
+  });
+});
