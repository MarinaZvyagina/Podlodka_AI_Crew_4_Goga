+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+const OPEN_STATE = 1;
+const CLOSED_STATE = 3;
+
+function createFakeClient(readyState = OPEN_STATE) {
+  return {
+    readyState,
+    send: vi.fn((_data: string, cb?: Function) => cb?.()),
+    terminate: vi.fn(),
+  };
+}
+
+function createFakeServer(clients: any[]) {
+  return {
+    clients: new Set(clients),
+    close: vi.fn((cb?: Function) => cb?.()),
+  };
+}
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('notifyClientsOfShutdown', () => {
+    it('should notify every open client of the shutdown', async () => {
+      const clientA = createFakeClient();
+      const clientB = createFakeClient();
+      const server = createFakeServer([clientA, clientB]);
+
+      await adapter.notifyClientsOfShutdown(server as any);
+
+      const expectedPayload = JSON.stringify({
+        event: 'shutdown',
+        data: 'Server is shutting down',
+      });
+      for (const client of [clientA, clientB]) {
+        expect(client.send).toHaveBeenCalledWith(
+          expectedPayload,
+          expect.any(Function),
+        );
+      }
+    });
+
+    it('should not attempt to notify clients that are not open', async () => {
+      const closedClient = createFakeClient(CLOSED_STATE);
+      const server = createFakeServer([closedClient]);
+
+      await adapter.notifyClientsOfShutdown(server as any);
+
+      expect(closedClient.send).not.toHaveBeenCalled();
+    });
+
+    it('should be a no-op when there are no connected clients', async () => {
+      const server = createFakeServer([]);
+
+      await expect(
+        adapter.notifyClientsOfShutdown(server as any),
+      ).resolves.toBeUndefined();
+    });
+  });
+
+  describe('close', () => {
+    it('should terminate every connected client', async () => {
+      const clientA = createFakeClient();
+      const clientB = createFakeClient();
+      const server = createFakeServer([clientA, clientB]);
+
+      await adapter.close(server as any);
+
+      expect(clientA.terminate).toHaveBeenCalled();
+      expect(clientB.terminate).toHaveBeenCalled();
+      expect(server.close).toHaveBeenCalled();
+    });
+
+    it('should close cleanly when there are no connected clients', async () => {
+      const server = createFakeServer([]);
+
+      await expect(adapter.close(server as any)).resolves.toBeUndefined();
+      expect(server.close).toHaveBeenCalled();
+    });
+  });
+
+  it('should notify clients before terminating them when orchestrated in sequence', async () => {
+    const client = createFakeClient();
+    const server = createFakeServer([client]);
+
+    await adapter.notifyClientsOfShutdown(server as any);
+    await adapter.close(server as any);
+
+    expect(client.send.mock.invocationCallOrder[0]).toBeLessThan(
+      client.terminate.mock.invocationCallOrder[0],
+    );
+  });
+});
