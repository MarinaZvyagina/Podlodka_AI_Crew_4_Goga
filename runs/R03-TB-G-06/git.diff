+import { ServerAndEventStreamsFactory } from '../factories/server-and-event-streams-factory.js';
+import { SocketModule } from '../socket-module.js';
+
+describe('SocketModule', () => {
+  describe('close', () => {
+    function setup(servers: any[], adapter: any) {
+      const socketModule = new SocketModule();
+      (socketModule as any).applicationConfig = {
+        getIoAdapter: () => adapter,
+      };
+      const socketsContainer = (socketModule as any).socketsContainer;
+      servers.forEach((server, i) =>
+        socketsContainer.addOne(
+          { port: i },
+          ServerAndEventStreamsFactory.create(server),
+        ),
+      );
+      return socketModule;
+    }
+
+    it('should notify every registered server before closing any of them', async () => {
+      const calls: string[] = [];
+      const serverA = { id: 'A' };
+      const serverB = { id: 'B' };
+      const adapter = {
+        notifyClientsOfShutdown: vi.fn(async (server: any) => {
+          calls.push(`notify:${server.id}`);
+        }),
+        close: vi.fn(async (server: any) => {
+          calls.push(`close:${server.id}`);
+        }),
+        dispose: vi.fn(),
+      };
+      const socketModule = setup([serverA, serverB], adapter);
+
+      await socketModule.close();
+
+      expect(calls.indexOf('notify:A')).toBeLessThan(calls.indexOf('close:A'));
+      expect(calls.indexOf('notify:B')).toBeLessThan(calls.indexOf('close:B'));
+      // Both servers must be notified before either one is closed.
+      expect(calls.indexOf('notify:A')).toBeLessThan(calls.indexOf('close:B'));
+      expect(calls.indexOf('notify:B')).toBeLessThan(calls.indexOf('close:A'));
+      expect(adapter.dispose).toHaveBeenCalled();
+    });
+
+    it('should not throw when the adapter does not implement notifyClientsOfShutdown', async () => {
+      const adapter = {
+        close: vi.fn(),
+        dispose: vi.fn(),
+      };
+      const socketModule = setup([{ id: 'A' }], adapter);
+
+      await expect(socketModule.close()).resolves.toBeUndefined();
+      expect(adapter.close).toHaveBeenCalled();
+    });
+
+    it('should be a no-op when there is no registered adapter', async () => {
+      const socketModule = new SocketModule();
+      (socketModule as any).applicationConfig = {
+        getIoAdapter: () => undefined,
+      };
+
+      await expect(socketModule.close()).resolves.toBeUndefined();
+    });
+  });
+});
