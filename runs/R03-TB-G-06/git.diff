+import { INestApplication } from '@nestjs/common';
+import { WsAdapter } from '@nestjs/platform-ws';
+import { Test } from '@nestjs/testing';
+import { io, Socket } from 'socket.io-client';
+import WebSocket from 'ws';
+import { ApplicationGateway } from '../src/app.gateway.js';
+import { NamespaceGateway } from '../src/namespace.gateway.js';
+
+async function createNestApp(...gateways: any[]): Promise<INestApplication> {
+  const testingModule = await Test.createTestingModule({
+    providers: gateways,
+  }).compile();
+  return testingModule.createNestApplication();
+}
+
+describe('Graceful shutdown for WebSocket gateways', () => {
+  let app: INestApplication;
+
+  describe('socket.io', () => {
+    let client: Socket;
+
+    afterEach(() => {
+      client?.close();
+    });
+
+    it('should notify connected clients before disconnecting them on shutdown', async () => {
+      app = await createNestApp(ApplicationGateway);
+      await app.listen(3000);
+
+      client = io('http://localhost:8080');
+      await new Promise<void>(resolve => client.on('connect', resolve));
+
+      const shutdownNotice = new Promise<string>(resolve =>
+        client.on('shutdown', resolve),
+      );
+      const disconnected = new Promise<void>(resolve =>
+        client.on('disconnect', () => resolve()),
+      );
+
+      await app.close();
+
+      const message = await shutdownNotice;
+      expect(message).toEqual('Server is shutting down');
+      await disconnected;
+    });
+
+    it('should close without error when no clients are connected', async () => {
+      app = await createNestApp(ApplicationGateway);
+      await app.listen(3000);
+
+      await expect(app.close()).resolves.toBeUndefined();
+    });
+
+    it('should notify clients connected to a namespaced gateway', async () => {
+      app = await createNestApp(NamespaceGateway);
+      await app.listen(3000);
+
+      client = io('http://localhost:8080/test');
+      await new Promise<void>(resolve => client.on('connect', resolve));
+
+      const shutdownNotice = new Promise<string>(resolve =>
+        client.on('shutdown', resolve),
+      );
+
+      await app.close();
+
+      expect(await shutdownNotice).toEqual('Server is shutting down');
+    });
+  });
+
+  describe('ws', () => {
+    let client: WebSocket;
+
+    afterEach(() => {
+      client?.close();
+    });
+
+    it('should notify connected clients before disconnecting them on shutdown', async () => {
+      const testingModule = await Test.createTestingModule({
+        providers: [ApplicationGateway],
+      }).compile();
+      app = testingModule.createNestApplication();
+      app.useWebSocketAdapter(new WsAdapter(app) as any);
+      await app.listen(3000);
+
+      client = new WebSocket('ws://localhost:8080');
+      await new Promise(resolve => client.on('open', resolve));
+
+      const shutdownNotice = new Promise<any>(resolve =>
+        client.on('message', data => resolve(JSON.parse(data.toString()))),
+      );
+      const closed = new Promise<void>(resolve =>
+        client.on('close', () => resolve()),
+      );
+
+      await app.close();
+
+      const message = await shutdownNotice;
+      expect(message).toEqual({
+        event: 'shutdown',
+        data: 'Server is shutting down',
+      });
+      await closed;
+    });
+
+    it('should close without error when no clients are connected', async () => {
+      const testingModule = await Test.createTestingModule({
+        providers: [ApplicationGateway],
+      }).compile();
+      app = testingModule.createNestApplication();
+      app.useWebSocketAdapter(new WsAdapter(app) as any);
+      await app.listen(3000);
+
+      await expect(app.close()).resolves.toBeUndefined();
+    });
+  });
+});
