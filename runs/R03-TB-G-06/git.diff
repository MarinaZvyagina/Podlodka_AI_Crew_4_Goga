+
+  /**
+   * Sends a heads-up message to every currently connected client, giving
+   * them a chance to distinguish a graceful shutdown from a dropped
+   * connection. Called by `SocketModule` for every registered server (and
+   * namespace) *before* any of them are closed.
+   *
+   * A single `Server#close()` tears down every namespace's underlying
+   * transport at once, with `discard: true` (see engine.io's
+   * `Server#close`), which skips its normal "wait for the write buffer to
+   * drain" behaviour. Since `close()` is called separately per namespace,
+   * all notices must be sent - and given a moment to reach the wire - up
+   * front, before any of those `close()` calls can tear down a shared
+   * transport out from under a sibling namespace.
+   */
+  public async notifyClientsOfShutdown(
+    server: Server | Namespace,
+  ): Promise<void> {
+    // `Server#sockets` is the default `Namespace`, whereas `Namespace#sockets`
+    // is the `Map` of connected sockets directly. Normalize both shapes.
+    const rawSockets = (server as any).sockets;
+    const sockets: Map<string, Socket> | undefined =
+      rawSockets instanceof Map ? rawSockets : rawSockets?.sockets;
+    if (!sockets?.size) {
+      return;
+    }
+    server.emit(SHUTDOWN_EVENT, SHUTDOWN_MESSAGE);
+    await new Promise<void>(resolve => setImmediate(resolve));
+  }
 }
