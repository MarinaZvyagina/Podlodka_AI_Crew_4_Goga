new file mode 100644
index 0000000..a029366
--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,30 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('notifyShutdown', () => {
+    it('should send a "shutdown" message to every open client', async () => {
+      const openClient = { readyState: 1, send: vi.fn() };
+      const connectingClient = { readyState: 0, send: vi.fn() };
+      const fakeServer = { clients: [openClient, connectingClient] } as any;
+
+      await adapter.notifyShutdown(fakeServer);
+
+      expect(openClient.send).toHaveBeenCalledWith(
+        JSON.stringify({ event: 'shutdown' }),
+      );
+      expect(connectingClient.send).not.toHaveBeenCalled();
+    });
+
+    it('should do nothing when the server tracks no clients', async () => {
+      const fakeServer = {} as any;
+
+      await expect(adapter.notifyShutdown(fakeServer)).resolves.not.toThrow();
+    });
+  });
+});
