new file mode 100644
index 0000000..e41288c
--- /dev/null
+++ b/packages/websockets/test/socket-module.spec.ts
@@ -0,0 +1,51 @@
+import { ApplicationConfig } from '@nestjs/core/application-config.js';
+import { AbstractWsAdapter } from '../adapters/ws-adapter.js';
+import { ServerAndEventStreamsFactory } from '../factories/server-and-event-streams-factory.js';
+import { SocketModule } from '../socket-module.js';
+import { SocketsContainer } from '../sockets-container.js';
+
+class NoopAdapter extends AbstractWsAdapter {
+  public create(port: number, options?: any) {}
+  public bindMessageHandlers(client: any, handlers) {}
+}
+
+describe('SocketModule', () => {
+  describe('close', () => {
+    it('should notify each registered server of the shutdown before closing it', async () => {
+      const adapter = new NoopAdapter();
+      const notifyShutdownSpy = vi.spyOn(adapter, 'notifyShutdown');
+      const closeSpy = vi.spyOn(adapter, 'close').mockResolvedValue(undefined);
+
+      const applicationConfig = new ApplicationConfig(adapter);
+      const socketModule = new SocketModule();
+      (socketModule as any).applicationConfig = applicationConfig;
+
+      const socketsContainer: SocketsContainer = (socketModule as any)
+        .socketsContainer;
+      const fakeServer = { test: 'server' };
+      socketsContainer.addOne(
+        { namespace: 'test' } as any,
+        ServerAndEventStreamsFactory.create(fakeServer),
+      );
+
+      const callOrder: string[] = [];
+      notifyShutdownSpy.mockImplementation(async () => {
+        callOrder.push('notifyShutdown');
+      });
+      closeSpy.mockImplementation(async () => {
+        callOrder.push('close');
+      });
+
+      await socketModule.close();
+
+      expect(notifyShutdownSpy).toHaveBeenCalledWith(fakeServer);
+      expect(closeSpy).toHaveBeenCalledWith(fakeServer);
+      expect(callOrder).toEqual(['notifyShutdown', 'close']);
+    });
+
+    it('should do nothing when no adapter/application config is registered', async () => {
+      const socketModule = new SocketModule();
+      await expect(socketModule.close()).resolves.not.toThrow();
+    });
+  });
+});
