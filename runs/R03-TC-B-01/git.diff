+import { SetMetadata } from '@nestjs/common';
+import { AFFECTED_BY_MAINTENANCE_KEY } from './maintenance.constants.js';
+
+/**
+ * Marks a handler (HTTP route or WebSocket message handler) or an entire
+ * controller/gateway as affected by maintenance mode. Requires
+ * `MaintenanceModeGuard` to be applied for the marking to take effect.
+ */
+export const AffectedByMaintenance = () =>
+  SetMetadata(AFFECTED_BY_MAINTENANCE_KEY, true);
