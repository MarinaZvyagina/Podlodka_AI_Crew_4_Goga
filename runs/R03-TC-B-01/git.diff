@@ -0,0 +1,91 @@
+import type { ExecutionContext } from '@nestjs/common';
+import { ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { AFFECTED_BY_MAINTENANCE_KEY } from './maintenance.constants.js';
+import { MaintenanceModeGuard } from './maintenance-mode.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+// Builds a bare ExecutionContext-like object so the guard can be exercised
+// without booting a Nest application, HTTP server, or WebSocket connection.
+const createContext = (
+  contextType: 'http' | 'ws',
+  handlerMetadata?: boolean,
+  classMetadata?: boolean,
+): ExecutionContext => {
+  const handler = function handler() {};
+  const clazz = class TestTarget {};
+
+  if (handlerMetadata !== undefined) {
+    Reflect.defineMetadata(AFFECTED_BY_MAINTENANCE_KEY, handlerMetadata, handler);
+  }
+  if (classMetadata !== undefined) {
+    Reflect.defineMetadata(AFFECTED_BY_MAINTENANCE_KEY, classMetadata, clazz);
+  }
+
+  return {
+    getHandler: () => handler,
+    getClass: () => clazz,
+    getType: () => contextType,
+  } as unknown as ExecutionContext;
+};
+
+describe('MaintenanceModeGuard', () => {
+  let maintenanceMode: MaintenanceModeService;
+  let guard: MaintenanceModeGuard;
+
+  beforeEach(() => {
+    maintenanceMode = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(new Reflector(), maintenanceMode);
+  });
+
+  it('allows unmarked handlers regardless of maintenance mode', () => {
+    maintenanceMode.enable();
+    const context = createContext('http');
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('allows marked handlers while maintenance mode is off', () => {
+    const context = createContext('http', true);
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks a marked HTTP handler while maintenance mode is on', () => {
+    maintenanceMode.enable();
+    const context = createContext('http', true);
+
+    expect(() => guard.canActivate(context)).toThrow(ServiceUnavailableException);
+  });
+
+  it('blocks a marked WebSocket message handler while maintenance mode is on', () => {
+    maintenanceMode.enable();
+    const context = createContext('ws', true);
+
+    expect(() => guard.canActivate(context)).toThrow(ServiceUnavailableException);
+  });
+
+  it('blocks every handler of a controller marked at the class level', () => {
+    maintenanceMode.enable();
+    const context = createContext('http', undefined, true);
+
+    expect(() => guard.canActivate(context)).toThrow(ServiceUnavailableException);
+  });
+
+  it('allows a handler-level override to opt out of a class-level mark', () => {
+    maintenanceMode.enable();
+    const context = createContext('http', false, true);
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('re-allows a previously blocked handler once maintenance mode is switched off', () => {
+    maintenanceMode.enable();
+    const context = createContext('http', true);
+    expect(() => guard.canActivate(context)).toThrow(ServiceUnavailableException);
+
+    maintenanceMode.disable();
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+});
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.ts b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.ts
