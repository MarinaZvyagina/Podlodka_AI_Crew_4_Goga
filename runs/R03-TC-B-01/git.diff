+import { Controller, Get, UseGuards } from '@nestjs/common';
+import { AffectedByMaintenance } from './maintenance/affected-by-maintenance.decorator.js';
+import { MaintenanceModeGuard } from './maintenance/maintenance-mode.guard.js';
+
+/**
+ * The whole controller reads from the table being migrated, so every
+ * handler is marked at once instead of annotating each one individually.
+ */
+@Controller('legacy-reports')
+@UseGuards(MaintenanceModeGuard)
+@AffectedByMaintenance()
+export class LegacyReportsController {
+  @Get()
+  findAll(): string[] {
+    return ['report-1', 'report-2'];
+  }
+
+  @Get('summary')
+  summary(): string {
+    return 'summary';
+  }
+}
