+import { MAINTENANCE_KEY, Maintenance } from './maintenance.decorator.js';
+
+describe('@Maintenance', () => {
+  it('marks a method', () => {
+    class Test {
+      @Maintenance()
+      handler() {}
+    }
+    expect(Reflect.getMetadata(MAINTENANCE_KEY, Test.prototype.handler)).toBe(
+      true,
+    );
+  });
+
+  it('marks a class', () => {
+    @Maintenance()
+    class Test {}
+    expect(Reflect.getMetadata(MAINTENANCE_KEY, Test)).toBe(true);
+  });
+
+  it('supports opting a method out with @Maintenance(false)', () => {
+    class Test {
+      @Maintenance(false)
+      handler() {}
+    }
+    expect(Reflect.getMetadata(MAINTENANCE_KEY, Test.prototype.handler)).toBe(
+      false,
+    );
+  });
+
+  it('leaves unmarked methods without metadata', () => {
+    class Test {
+      handler() {}
+    }
+    expect(
+      Reflect.getMetadata(MAINTENANCE_KEY, Test.prototype.handler),
+    ).toBeUndefined();
+  });
+});
