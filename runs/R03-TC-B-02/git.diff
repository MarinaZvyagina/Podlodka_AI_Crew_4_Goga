diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts
new file mode 100644
index 0000000..2db0dd8
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts
@@ -0,0 +1,143 @@
+import { ExecutionContext, ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { Maintenance } from './decorators/maintenance.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+import { MaintenanceGuard } from './maintenance.guard.js';
+
+class UsersController {
+  findAll() {}
+
+  @Maintenance()
+  legacyReport() {}
+}
+
+@Maintenance()
+class BillingController {
+  invoices() {}
+
+  @Maintenance(false)
+  health() {}
+}
+
+class MigrationGateway {
+  onPing() {}
+
+  @Maintenance()
+  onMigrateRecord() {}
+}
+
+const buildContext = (
+  handler: (...args: any[]) => unknown,
+  klass: new (...args: any[]) => unknown,
+  type: 'http' | 'ws',
+): ExecutionContext =>
+  ({
+    getHandler: () => handler,
+    getClass: () => klass,
+    getType: () => type,
+  }) as unknown as ExecutionContext;
+
+describe('MaintenanceGuard', () => {
+  let guard: MaintenanceGuard;
+  let maintenanceMode: MaintenanceModeService;
+
+  beforeEach(() => {
+    maintenanceMode = new MaintenanceModeService();
+    guard = new MaintenanceGuard(new Reflector(), maintenanceMode);
+  });
+
+  describe('when maintenance mode is off', () => {
+    it('allows both marked and unmarked handlers through', () => {
+      const marked = buildContext(
+        UsersController.prototype.legacyReport,
+        UsersController,
+        'http',
+      );
+      const unmarked = buildContext(
+        UsersController.prototype.findAll,
+        UsersController,
+        'http',
+      );
+
+      expect(guard.canActivate(marked)).toBe(true);
+      expect(guard.canActivate(unmarked)).toBe(true);
+    });
+  });
+
+  describe('when maintenance mode is on', () => {
+    beforeEach(() => maintenanceMode.enable());
+
+    it('blocks a handler marked directly, leaves its sibling untouched', () => {
+      const marked = buildContext(
+        UsersController.prototype.legacyReport,
+        UsersController,
+        'http',
+      );
+      const unmarked = buildContext(
+        UsersController.prototype.findAll,
+        UsersController,
+        'http',
+      );
+
+      expect(() => guard.canActivate(marked)).toThrow(
+        ServiceUnavailableException,
+      );
+      expect(guard.canActivate(unmarked)).toBe(true);
+    });
+
+    it('blocks every handler of a controller marked at the class level', () => {
+      const invoices = buildContext(
+        BillingController.prototype.invoices,
+        BillingController,
+        'http',
+      );
+
+      expect(() => guard.canActivate(invoices)).toThrow(
+        ServiceUnavailableException,
+      );
+    });
+
+    it('lets a method opt out of a class-level mark with @Maintenance(false)', () => {
+      const health = buildContext(
+        BillingController.prototype.health,
+        BillingController,
+        'http',
+      );
+
+      expect(guard.canActivate(health)).toBe(true);
+    });
+
+    it('blocks a marked WebSocket message handler with a WsException', () => {
+      const migrateRecord = buildContext(
+        MigrationGateway.prototype.onMigrateRecord,
+        MigrationGateway,
+        'ws',
+      );
+      const ping = buildContext(
+        MigrationGateway.prototype.onPing,
+        MigrationGateway,
+        'ws',
+      );
+
+      expect(() => guard.canActivate(migrateRecord)).toThrow(WsException);
+      expect(guard.canActivate(ping)).toBe(true);
+    });
+
+    it('unblocks a handler again once maintenance mode is switched off', () => {
+      const marked = buildContext(
+        UsersController.prototype.legacyReport,
+        UsersController,
+        'http',
+      );
+
+      expect(() => guard.canActivate(marked)).toThrow(
+        ServiceUnavailableException,
+      );
+
+      maintenanceMode.disable();
+
+      expect(guard.canActivate(marked)).toBe(true);
+    });
+  });
+});
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
new file mode 100644
index 0000000..e81df63
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
@@ -0,0 +1,35 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MAINTENANCE_KEY } from './maintenance.constants.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+@Injectable()
+export class MaintenanceGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceMode: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isUnderMaintenance = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_KEY,
+      [context.getHandler(), context.getClass()],
+    );
+
+    if (!isUnderMaintenance || !this.maintenanceMode.isEnabled()) {
+      return true;
+    }
+
+    const message = 'Service temporarily unavailable for maintenance';
+    if (context.getType() === 'ws') {
+      throw new WsException(message);
+    }
+    throw new ServiceUnavailableException(message);
+  }
+}
