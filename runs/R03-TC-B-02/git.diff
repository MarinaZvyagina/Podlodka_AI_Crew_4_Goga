@@ -0,0 +1,19 @@
+import { applyDecorators, SetMetadata, UseGuards } from '@nestjs/common';
+import { MAINTENANCE_KEY } from '../maintenance.constants.js';
+import { MaintenanceGuard } from '../maintenance.guard.js';
+
+export { MAINTENANCE_KEY };
+
+/**
+ * Marking a class marks every handler in it; `@Maintenance(false)` on a
+ * specific method opts that one handler back out of a class-level mark.
+ *
+ * Binds MaintenanceGuard directly (rather than relying on a global
+ * APP_GUARD) so the exact same mechanism works for both HTTP routes and
+ * @SubscribeMessage WebSocket handlers.
+ */
+export const Maintenance = (underMaintenance = true) =>
+  applyDecorators(
+    SetMetadata(MAINTENANCE_KEY, underMaintenance),
+    UseGuards(MaintenanceGuard),
+  );
