+import { SubscribeMessage, WebSocketGateway } from '@nestjs/websockets';
+import { Maintenance } from '../maintenance/decorators/maintenance.decorator.js';
+
+@WebSocketGateway()
+export class MigrationGateway {
+  @SubscribeMessage('ping')
+  onPing() {
+    return { event: 'pong', data: {} };
+  }
+
+  @SubscribeMessage('migrate-record')
+  @Maintenance()
+  onMigrateRecord() {
+    return { event: 'migrate-record', data: { accepted: true } };
+  }
+}
