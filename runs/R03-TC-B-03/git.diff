+import { Controller, Get } from '@nestjs/common';
+import { AffectedByMaintenance } from '../maintenance/affected-by-maintenance.decorator.js';
+
+@Controller('reports')
+export class ReportsController {
+  // Reads from a table that a data migration rewrites - must be turned away
+  // while that migration is running.
+  @Get('heavy')
+  @AffectedByMaintenance()
+  heavy() {
+    return { report: 'heavy report data' };
+  }
+
+  // Doesn't touch the data under migration, so it keeps working no matter
+  // what maintenance mode is set to.
+  @Get('status')
+  status() {
+    return { status: 'ok' };
+  }
+}
