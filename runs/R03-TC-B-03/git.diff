+import { Controller, Get, Post } from '@nestjs/common';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Internal admin endpoints used to flip maintenance mode on/off at runtime.
+ * Deliberately not marked with `@AffectedByMaintenance()` - you always need
+ * to be able to turn maintenance mode back off.
+ */
+@Controller('maintenance')
+export class MaintenanceModeController {
+  constructor(private readonly maintenanceMode: MaintenanceModeService) {}
+
+  @Get()
+  status() {
+    return { enabled: this.maintenanceMode.isEnabled() };
+  }
+
+  @Post('enable')
+  enable() {
+    this.maintenanceMode.enable();
+    return { enabled: true };
+  }
+
+  @Post('disable')
+  disable() {
+    this.maintenanceMode.disable();
+    return { enabled: false };
+  }
+}
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.spec.ts b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.spec.ts
new file mode 100644
index 0000000..d7d92b1
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.spec.ts
@@ -0,0 +1,124 @@
+import { ExecutionContext, ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { AffectedByMaintenance } from './affected-by-maintenance.decorator.js';
+import { MaintenanceModeGuard } from './maintenance-mode.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+class UnmarkedController {
+  handler() {}
+}
+
+class MarkedHandlerController {
+  @AffectedByMaintenance()
+  handler() {}
+
+  other() {}
+}
+
+@AffectedByMaintenance()
+class MarkedControllerController {
+  handler() {}
+}
+
+function createContext(
+  handler: Function,
+  klass: Function,
+  type: 'http' | 'ws' = 'http',
+): ExecutionContext {
+  return {
+    getHandler: () => handler,
+    getClass: () => klass,
+    getType: () => type,
+    switchToHttp: () => ({}) as any,
+    switchToWs: () => ({}) as any,
+    switchToRpc: () => ({}) as any,
+    getArgs: () => [],
+    getArgByIndex: () => undefined,
+  } as unknown as ExecutionContext;
+}
+
+describe('MaintenanceModeGuard', () => {
+  let guard: MaintenanceModeGuard;
+  let maintenanceMode: MaintenanceModeService;
+
+  beforeEach(() => {
+    maintenanceMode = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(new Reflector(), maintenanceMode);
+  });
+
+  it('allows an unmarked handler through even while maintenance mode is on', () => {
+    maintenanceMode.enable();
+    const context = createContext(
+      UnmarkedController.prototype.handler,
+      UnmarkedController,
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('allows a marked handler through while maintenance mode is off', () => {
+    const context = createContext(
+      MarkedHandlerController.prototype.handler,
+      MarkedHandlerController,
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks a marked handler while maintenance mode is on', () => {
+    maintenanceMode.enable();
+    const context = createContext(
+      MarkedHandlerController.prototype.handler,
+      MarkedHandlerController,
+    );
+
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('leaves an unmarked handler on the same controller unaffected', () => {
+    maintenanceMode.enable();
+    const context = createContext(
+      MarkedHandlerController.prototype.other,
+      MarkedHandlerController,
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks every handler when the whole controller is marked', () => {
+    maintenanceMode.enable();
+    const context = createContext(
+      MarkedControllerController.prototype.handler,
+      MarkedControllerController,
+    );
+
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('throws a WsException instead of an HTTP exception for a WS context', () => {
+    maintenanceMode.enable();
+    const context = createContext(
+      MarkedHandlerController.prototype.handler,
+      MarkedHandlerController,
+      'ws',
+    );
+
+    expect(() => guard.canActivate(context)).toThrow(WsException);
+  });
+
+  it('unblocks a marked handler again once maintenance mode is turned off', () => {
+    maintenanceMode.enable();
+    maintenanceMode.disable();
+    const context = createContext(
+      MarkedHandlerController.prototype.handler,
+      MarkedHandlerController,
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+});
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.ts b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.ts
new file mode 100644
index 0000000..59328c6
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance-mode.guard.ts
@@ -0,0 +1,48 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MAINTENANCE_MODE_KEY } from './maintenance-mode.constants.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Rejects calls to any handler (or any handler of a controller/gateway)
+ * decorated with `@AffectedByMaintenance()` while maintenance mode is on.
+ * Everything without that decorator passes straight through, regardless of
+ * maintenance mode.
+ *
+ * Bind this once as a global guard (e.g. via `APP_GUARD`) and it covers both
+ * HTTP routes and WebSocket message handlers, since both go through the same
+ * `CanActivate` contract - only the shape of the thrown error differs.
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceMode: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isAffected = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_MODE_KEY,
+      [context.getHandler(), context.getClass()],
+    );
+
+    if (!isAffected || !this.maintenanceMode.isEnabled()) {
+      return true;
+    }
+
+    if (context.getType() === 'ws') {
+      throw new WsException(
+        'This service is temporarily unavailable for maintenance.',
+      );
+    }
+    throw new ServiceUnavailableException(
+      'This endpoint is temporarily unavailable for maintenance.',
+    );
+  }
+}
