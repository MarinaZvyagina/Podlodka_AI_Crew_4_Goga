+import { Global, Module } from '@nestjs/common';
+import { APP_GUARD } from '@nestjs/core';
+import { MaintenanceModeController } from './maintenance-mode.controller.js';
+import { MaintenanceModeGuard } from './maintenance-mode.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Registers `MaintenanceModeGuard` as a global guard, so it runs for every
+ * HTTP route and every WebSocket message handler in the app. The guard is a
+ * no-op unless the target was marked with `@AffectedByMaintenance()`.
+ */
+@Global()
+@Module({
+  controllers: [MaintenanceModeController],
+  providers: [
+    MaintenanceModeService,
+    {
+      provide: APP_GUARD,
+      useClass: MaintenanceModeGuard,
+    },
+  ],
+  exports: [MaintenanceModeService],
+})
+export class MaintenanceModeModule {}
