@@ -0,0 +1,19 @@
+import { SubscribeMessage, WebSocketGateway } from '@nestjs/websockets';
+import { AffectedByMaintenance } from '../maintenance/affected-by-maintenance.decorator.js';
+
+@WebSocketGateway()
+export class EventsGateway {
+  // Streams live rows from the table under migration - blocked during
+  // maintenance mode, using the exact same decorator as an HTTP handler.
+  @SubscribeMessage('migrate-data')
+  @AffectedByMaintenance()
+  onMigrateData(client: any, data: any) {
+    return { event: 'migrate-data', data: 'migrated data' };
+  }
+
+  // Unrelated to the migration, so it's left unmarked and keeps responding.
+  @SubscribeMessage('ping')
+  onPing(client: any, data: any) {
+    return { event: 'pong', data };
+  }
+}
