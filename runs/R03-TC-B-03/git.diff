+import { SetMetadata } from '@nestjs/common';
+import { MAINTENANCE_MODE_KEY } from './maintenance-mode.constants.js';
+
+/**
+ * Marks a route handler, an entire controller, a WebSocket message handler,
+ * or an entire gateway as affected by maintenance mode.
+ *
+ * While maintenance mode is switched on, calls to anything carrying this
+ * decorator are rejected by `MaintenanceModeGuard` before their handler runs.
+ * Everything else keeps working normally.
+ */
+export const AffectedByMaintenance = () =>
+  SetMetadata(MAINTENANCE_MODE_KEY, true);
