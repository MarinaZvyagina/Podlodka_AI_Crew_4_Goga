+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../../src/app.module.js';
+
+describe('E2E Maintenance Mode Sample', () => {
+  let app: INestApplication;
+
+  beforeAll(async () => {
+    const modRef = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = modRef.createNestApplication();
+    await app.init();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('serves the marked endpoint normally while maintenance mode is off', () => {
+    return request(app.getHttpServer()).get('/reports/heavy').expect(200);
+  });
+
+  it('rejects the marked endpoint once maintenance mode is switched on, while leaving other endpoints alone', async () => {
+    await request(app.getHttpServer())
+      .post('/maintenance/enable')
+      .expect(201);
+
+    await request(app.getHttpServer()).get('/reports/heavy').expect(503);
+    await request(app.getHttpServer()).get('/reports/status').expect(200);
+
+    await request(app.getHttpServer())
+      .post('/maintenance/disable')
+      .expect(201);
+
+    await request(app.getHttpServer()).get('/reports/heavy').expect(200);
+  });
+});
