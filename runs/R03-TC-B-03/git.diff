+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the single in-memory maintenance-mode flag for the running process.
+ * Toggle it from an admin endpoint (see `MaintenanceModeController`) or from
+ * any other internal trigger - no redeploy required.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  enable(): void {
+    this.enabled = true;
+  }
+
+  disable(): void {
+    this.enabled = false;
+  }
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+}
