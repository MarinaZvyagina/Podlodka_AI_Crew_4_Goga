@@ -0,0 +1,38 @@
+import { MAINTENANCE_MODE_METADATA } from '../../constants.js';
+import { MaintenanceMode } from '../../decorators/core/maintenance-mode.decorator.js';
+
+describe('@MaintenanceMode', () => {
+  @MaintenanceMode()
+  class TestController {}
+
+  class TestControllerWithMethod {
+    @MaintenanceMode()
+    public static affected() {}
+
+    public static unaffected() {}
+  }
+
+  it('should mark the class with maintenance mode metadata', () => {
+    const metadata = Reflect.getMetadata(
+      MAINTENANCE_MODE_METADATA,
+      TestController,
+    );
+    expect(metadata).toBe(true);
+  });
+
+  it('should mark the decorated method with maintenance mode metadata', () => {
+    const metadata = Reflect.getMetadata(
+      MAINTENANCE_MODE_METADATA,
+      TestControllerWithMethod.affected,
+    );
+    expect(metadata).toBe(true);
+  });
+
+  it('should leave an undecorated method without metadata', () => {
+    const metadata = Reflect.getMetadata(
+      MAINTENANCE_MODE_METADATA,
+      TestControllerWithMethod.unaffected,
+    );
+    expect(metadata).toBeUndefined();
+  });
+});
diff --git a/packages/common/test/guards/maintenance-mode.guard.spec.ts b/packages/common/test/guards/maintenance-mode.guard.spec.ts
new file mode 100644
index 0000000..8777cee
--- /dev/null
+++ b/packages/common/test/guards/maintenance-mode.guard.spec.ts
@@ -0,0 +1,95 @@
+import { MaintenanceMode } from '../../decorators/core/maintenance-mode.decorator.js';
+import { ServiceUnavailableException } from '../../exceptions/service-unavailable.exception.js';
+import { MaintenanceModeGuard } from '../../guards/maintenance-mode.guard.js';
+import { ExecutionContext } from '../../interfaces/features/execution-context.interface.js';
+import { MaintenanceModeService } from '../../services/maintenance-mode.service.js';
+
+class AffectedController {
+  @MaintenanceMode()
+  static affectedHandler() {}
+
+  static unaffectedHandler() {}
+}
+
+@MaintenanceMode()
+class FullyAffectedController {
+  static handler() {}
+}
+
+const createContext = (handler: Function, clazz: Function): ExecutionContext =>
+  ({
+    getHandler: () => handler,
+    getClass: () => clazz,
+  }) as ExecutionContext;
+
+describe('MaintenanceModeGuard', () => {
+  let maintenanceModeService: MaintenanceModeService;
+  let guard: MaintenanceModeGuard;
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(maintenanceModeService);
+  });
+
+  describe('when the handler is not marked with @MaintenanceMode', () => {
+    it('should allow the call through regardless of maintenance mode state', () => {
+      const context = createContext(
+        AffectedController.unaffectedHandler,
+        AffectedController,
+      );
+      maintenanceModeService.enable();
+
+      expect(guard.canActivate(context)).toBe(true);
+    });
+  });
+
+  describe('when the handler is marked with @MaintenanceMode', () => {
+    it('should allow the call through while maintenance mode is off', () => {
+      const context = createContext(
+        AffectedController.affectedHandler,
+        AffectedController,
+      );
+
+      expect(guard.canActivate(context)).toBe(true);
+    });
+
+    it('should reject the call while maintenance mode is on', () => {
+      const context = createContext(
+        AffectedController.affectedHandler,
+        AffectedController,
+      );
+      maintenanceModeService.enable();
+
+      expect(() => guard.canActivate(context)).toThrow(
+        ServiceUnavailableException,
+      );
+    });
+
+    it('should allow the call through again after maintenance mode is switched back off', () => {
+      const context = createContext(
+        AffectedController.affectedHandler,
+        AffectedController,
+      );
+      maintenanceModeService.enable();
+      expect(() => guard.canActivate(context)).toThrow();
+
+      maintenanceModeService.disable();
+
+      expect(guard.canActivate(context)).toBe(true);
+    });
+  });
+
+  describe('when the whole controller/gateway class is marked with @MaintenanceMode', () => {
+    it('should reject calls to its handlers while maintenance mode is on', () => {
+      const context = createContext(
+        FullyAffectedController.handler,
+        FullyAffectedController,
+      );
+      maintenanceModeService.enable();
+
+      expect(() => guard.canActivate(context)).toThrow(
+        ServiceUnavailableException,
+      );
+    });
+  });
+});
