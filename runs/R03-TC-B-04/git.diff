index 0000000..7988795
--- /dev/null
+++ b/packages/common/decorators/core/maintenance-mode.decorator.ts
@@ -0,0 +1,34 @@
+import { MAINTENANCE_MODE_METADATA } from '../../constants.js';
+
+/**
+ * Decorator that marks a controller or an individual handler (HTTP route
+ * handler or WebSocket message handler) as affected by maintenance mode.
+ *
+ * When `@MaintenanceMode()` is used at the controller/gateway level, every
+ * handler declared on that class is affected.
+ *
+ * When it's used on an individual method, only that handler is affected.
+ *
+ * Marking a handler does not, by itself, reject any calls. It only flags the
+ * handler so that `MaintenanceModeGuard` can reject calls to it while
+ * maintenance mode is toggled on (via `MaintenanceModeService`); handlers
+ * that aren't marked are always let through.
+ *
+ * @see [Guards](https://docs.nestjs.com/guards)
+ *
+ * @publicApi
+ */
+export function MaintenanceMode(): MethodDecorator & ClassDecorator {
+  return (
+    target: any,
+    key?: string | symbol,
+    descriptor?: TypedPropertyDescriptor<any>,
+  ) => {
+    if (descriptor) {
+      Reflect.defineMetadata(MAINTENANCE_MODE_METADATA, true, descriptor.value);
+      return descriptor;
+    }
+    Reflect.defineMetadata(MAINTENANCE_MODE_METADATA, true, target);
+    return target;
+  };
+}
