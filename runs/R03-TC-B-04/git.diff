diff --git a/packages/common/services/maintenance-mode.service.ts b/packages/common/services/maintenance-mode.service.ts
new file mode 100644
index 0000000..76a7347
--- /dev/null
+++ b/packages/common/services/maintenance-mode.service.ts
@@ -0,0 +1,39 @@
+import { Injectable } from '../decorators/core/index.js';
+
+/**
+ * Holds the runtime on/off state of maintenance mode.
+ *
+ * Injecting this service (it's a singleton by default) and calling
+ * `enable()`/`disable()` — for example from an admin endpoint — toggles
+ * maintenance mode for the whole running application, without a redeploy.
+ *
+ * `MaintenanceModeGuard` reads `isEnabled()` to decide whether to reject
+ * calls to handlers marked with `@MaintenanceMode()`.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private isMaintenanceModeEnabled = false;
+
+  /**
+   * Turns maintenance mode on. Marked handlers start rejecting calls.
+   */
+  enable(): void {
+    this.isMaintenanceModeEnabled = true;
+  }
+
+  /**
+   * Turns maintenance mode off. Marked handlers resume working normally.
+   */
+  disable(): void {
+    this.isMaintenanceModeEnabled = false;
+  }
+
+  /**
+   * Returns whether maintenance mode is currently on.
+   */
+  isEnabled(): boolean {
+    return this.isMaintenanceModeEnabled;
+  }
+}
