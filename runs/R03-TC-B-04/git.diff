@@ -0,0 +1,40 @@
+import { MAINTENANCE_MODE_METADATA } from '../constants.js';
+import { Injectable } from '../decorators/core/injectable.decorator.js';
+import { ServiceUnavailableException } from '../exceptions/service-unavailable.exception.js';
+import { CanActivate } from '../interfaces/features/can-activate.interface.js';
+import { ExecutionContext } from '../interfaces/features/execution-context.interface.js';
+import { MaintenanceModeService } from '../services/maintenance-mode.service.js';
+
+/**
+ * Rejects calls to handlers marked with `@MaintenanceMode()` while
+ * `MaintenanceModeService` reports maintenance mode as enabled; every other
+ * handler is let through untouched.
+ *
+ * Works identically for HTTP route handlers and WebSocket message handlers —
+ * bind it wherever `@UseGuards` is accepted (a controller, a gateway, an
+ * individual handler, or globally via `APP_GUARD`).
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isHandlerAffected =
+      Reflect.getMetadata(MAINTENANCE_MODE_METADATA, context.getHandler()) ??
+      Reflect.getMetadata(MAINTENANCE_MODE_METADATA, context.getClass());
+
+    if (!isHandlerAffected) {
+      return true;
+    }
+    if (this.maintenanceModeService.isEnabled()) {
+      throw new ServiceUnavailableException(
+        'This endpoint is temporarily unavailable due to maintenance.',
+      );
+    }
+    return true;
+  }
+}
