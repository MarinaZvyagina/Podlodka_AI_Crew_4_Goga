@@ -0,0 +1,9 @@
+import { SetMetadata } from '@nestjs/common';
+
+export const MAINTENANCE_AFFECTED = 'maintenance:affected';
+
+/**
+ * Marks a handler, or every handler on a controller/gateway, as one that
+ * must be rejected while maintenance mode is active. See MaintenanceGuard.
+ */
+export const MaintenanceAffected = () => SetMetadata(MAINTENANCE_AFFECTED, true);
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts
new file mode 100644
index 0000000..e8323f9
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts
@@ -0,0 +1,80 @@
+import { ExecutionContext, ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { Test, TestingModule } from '@nestjs/testing';
+import { WsException } from '@nestjs/websockets';
+import { MaintenanceAffected } from './maintenance.decorator.js';
+import { MaintenanceGuard } from './maintenance.guard.js';
+import { MaintenanceService } from './maintenance.service.js';
+
+class DemoHandlers {
+  @MaintenanceAffected()
+  affectedHandler() {}
+
+  unaffectedHandler() {}
+}
+
+describe('MaintenanceGuard', () => {
+  let guard: MaintenanceGuard;
+  let maintenanceService: MaintenanceService;
+
+  const createContext = (
+    handler: (...args: unknown[]) => unknown,
+    type: 'http' | 'ws' = 'http',
+  ): ExecutionContext =>
+    ({
+      getHandler: () => handler,
+      getClass: () => DemoHandlers,
+      getType: () => type,
+    }) as unknown as ExecutionContext;
+
+  beforeEach(async () => {
+    const module: TestingModule = await Test.createTestingModule({
+      providers: [
+        MaintenanceGuard,
+        MaintenanceService,
+        {
+          provide: Reflector,
+          useValue: new Reflector(),
+        },
+      ],
+    }).compile();
+
+    guard = module.get(MaintenanceGuard);
+    maintenanceService = module.get(MaintenanceService);
+  });
+
+  it('lets an affected handler through while maintenance mode is off', () => {
+    const context = createContext(DemoHandlers.prototype.affectedHandler);
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('lets an unaffected handler through while maintenance mode is on', () => {
+    maintenanceService.enable();
+    const context = createContext(DemoHandlers.prototype.unaffectedHandler);
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('rejects an affected HTTP handler while maintenance mode is on', () => {
+    maintenanceService.enable();
+    const context = createContext(DemoHandlers.prototype.affectedHandler);
+
+    expect(() => guard.canActivate(context)).toThrow(ServiceUnavailableException);
+  });
+
+  it('rejects an affected WS handler while maintenance mode is on', () => {
+    maintenanceService.enable();
+    const context = createContext(DemoHandlers.prototype.affectedHandler, 'ws');
+
+    expect(() => guard.canActivate(context)).toThrow(WsException);
+  });
+
+  it('lets the affected handler through again once maintenance mode is disabled', () => {
+    maintenanceService.enable();
+    maintenanceService.disable();
+    const context = createContext(DemoHandlers.prototype.affectedHandler);
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+});
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
new file mode 100644
index 0000000..68fcd06
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
@@ -0,0 +1,43 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MAINTENANCE_AFFECTED } from './maintenance.decorator.js';
+import { MaintenanceService } from './maintenance.service.js';
+
+const MAINTENANCE_MESSAGE =
+  'This operation is temporarily unavailable for scheduled maintenance.';
+
+/**
+ * Applies uniformly to HTTP routes and WS message handlers: both go through
+ * the same guard, keyed off the same handler/class metadata. Global
+ * registration (APP_GUARD) only reaches HTTP routes, so gateways must also
+ * add `@UseGuards(MaintenanceGuard)` themselves — see events.gateway.ts.
+ */
+@Injectable()
+export class MaintenanceGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceService: MaintenanceService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isAffected = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_AFFECTED,
+      [context.getHandler(), context.getClass()],
+    );
+
+    if (!isAffected || !this.maintenanceService.isActive()) {
+      return true;
+    }
+
+    if (context.getType() === 'ws') {
+      throw new WsException(MAINTENANCE_MESSAGE);
+    }
+    throw new ServiceUnavailableException(MAINTENANCE_MESSAGE);
+  }
+}
