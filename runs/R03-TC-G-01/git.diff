+import { Module } from '@nestjs/common';
+import { APP_GUARD } from '@nestjs/core';
+import { MaintenanceAdminController } from './maintenance-admin.controller.js';
+import { MaintenanceGuard } from './maintenance.guard.js';
+import { MaintenanceService } from './maintenance.service.js';
+
+@Module({
+  controllers: [MaintenanceAdminController],
+  providers: [
+    MaintenanceService,
+    MaintenanceGuard,
+    {
+      provide: APP_GUARD,
+      useExisting: MaintenanceGuard,
+    },
+  ],
+  exports: [MaintenanceService, MaintenanceGuard],
+})
+export class MaintenanceModule {}
