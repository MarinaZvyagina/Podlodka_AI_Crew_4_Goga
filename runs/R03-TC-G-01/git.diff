@@ -0,0 +1,18 @@
+import { Injectable } from '@nestjs/common';
+
+@Injectable()
+export class MaintenanceService {
+  private active = false;
+
+  enable(): void {
+    this.active = true;
+  }
+
+  disable(): void {
+    this.active = false;
+  }
+
+  isActive(): boolean {
+    return this.active;
+  }
+}
