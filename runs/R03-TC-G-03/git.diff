+import { Controller, Get } from '@nestjs/common';
+import { MaintenanceAffected } from '../maintenance/maintenance-affected.decorator.js';
+
+@Controller('status')
+export class StatusController {
+  @Get('health')
+  health() {
+    return { status: 'ok' };
+  }
+
+  @Get('reports')
+  @MaintenanceAffected()
+  reports() {
+    return { status: 'ok' };
+  }
+}
