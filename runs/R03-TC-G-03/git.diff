index 0000000..d18385b
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts
@@ -0,0 +1,92 @@
+import type { ExecutionContext } from '@nestjs/common';
+import { ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { beforeEach, describe, expect, it } from 'vitest';
+import { MAINTENANCE_AFFECTED_KEY } from './maintenance-affected.decorator.js';
+import { MaintenanceGuard } from './maintenance.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * A minimal stand-in for `ExecutionContext` so the guard can be exercised
+ * without booting an HTTP server or opening a socket connection.
+ */
+function createContext(options: {
+  type?: 'http' | 'ws';
+  handlerAffected?: boolean;
+  classAffected?: boolean;
+}): ExecutionContext {
+  const handler = function demoHandler() {};
+  class DemoController {}
+
+  if (options.handlerAffected) {
+    Reflect.defineMetadata(MAINTENANCE_AFFECTED_KEY, true, handler);
+  }
+  if (options.classAffected) {
+    Reflect.defineMetadata(MAINTENANCE_AFFECTED_KEY, true, DemoController);
+  }
+
+  return {
+    getHandler: () => handler,
+    getClass: () => DemoController,
+    getType: () => options.type ?? 'http',
+  } as unknown as ExecutionContext;
+}
+
+describe('MaintenanceGuard', () => {
+  let maintenanceMode: MaintenanceModeService;
+  let guard: MaintenanceGuard;
+
+  beforeEach(() => {
+    maintenanceMode = new MaintenanceModeService();
+    guard = new MaintenanceGuard(new Reflector(), maintenanceMode);
+  });
+
+  it('lets unmarked handlers through while maintenance mode is enabled', () => {
+    maintenanceMode.enable();
+    const context = createContext({});
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('lets marked handlers through while maintenance mode is disabled', () => {
+    const context = createContext({ handlerAffected: true });
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks a marked HTTP handler with a 503 while maintenance mode is enabled', () => {
+    maintenanceMode.enable();
+    const context = createContext({ handlerAffected: true, type: 'http' });
+
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('blocks a marked WS handler with a WsException while maintenance mode is enabled', () => {
+    maintenanceMode.enable();
+    const context = createContext({ handlerAffected: true, type: 'ws' });
+
+    expect(() => guard.canActivate(context)).toThrow(WsException);
+  });
+
+  it('blocks every handler on a controller marked at the class level', () => {
+    maintenanceMode.enable();
+    const context = createContext({ classAffected: true });
+
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('re-allows a marked handler once maintenance mode is disabled again', () => {
+    maintenanceMode.enable();
+    const context = createContext({ handlerAffected: true });
+    expect(() => guard.canActivate(context)).toThrow();
+
+    maintenanceMode.disable();
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+});
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
new file mode 100644
index 0000000..3355b25
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
@@ -0,0 +1,44 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MAINTENANCE_AFFECTED_KEY } from './maintenance-affected.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Rejects calls to handlers marked with `@MaintenanceAffected()` while
+ * maintenance mode is enabled. Works for both HTTP routes and WS message
+ * handlers since both go through `ExecutionContext`; unmarked handlers are
+ * always let through regardless of the flag.
+ */
+@Injectable()
+export class MaintenanceGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceMode: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isAffected = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_AFFECTED_KEY,
+      [context.getHandler(), context.getClass()],
+    );
+
+    if (!isAffected || !this.maintenanceMode.isEnabled()) {
+      return true;
+    }
+
+    if (context.getType() === 'ws') {
+      throw new WsException(
+        'Service temporarily unavailable for maintenance',
+      );
+    }
+    throw new ServiceUnavailableException(
+      'Service temporarily unavailable for maintenance',
+    );
+  }
+}
