+import { Injectable, Logger } from '@nestjs/common';
+
+/**
+ * Holds the current maintenance-mode flag in memory so it can be toggled
+ * at runtime (e.g. from an admin endpoint) without redeploying.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private readonly logger = new Logger(MaintenanceModeService.name);
+  private enabled = false;
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+
+  enable(): void {
+    this.enabled = true;
+    this.logger.warn('Maintenance mode enabled');
+  }
+
+  disable(): void {
+    this.enabled = false;
+    this.logger.log('Maintenance mode disabled');
+  }
+}
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts
