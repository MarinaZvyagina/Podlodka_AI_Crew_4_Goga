+import { SetMetadata } from '@nestjs/common';
+
+export const MAINTENANCE_AFFECTED_KEY = 'maintenance:affected';
+
+/**
+ * Marks a controller, an individual HTTP route handler, or a
+ * `@SubscribeMessage()` WS handler as affected by maintenance mode.
+ * `MaintenanceGuard` rejects calls to marked targets while maintenance
+ * mode is enabled and leaves everything else untouched.
+ */
+export const MaintenanceAffected = () =>
+  SetMetadata(MAINTENANCE_AFFECTED_KEY, true);
