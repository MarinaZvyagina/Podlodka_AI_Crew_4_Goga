@@ -0,0 +1,22 @@
+import { UseGuards } from '@nestjs/common';
+import { SubscribeMessage, WebSocketGateway } from '@nestjs/websockets';
+import { MaintenanceAffected } from '../maintenance/maintenance-affected.decorator.js';
+import { MaintenanceGuard } from '../maintenance/maintenance.guard.js';
+
+// Some WS adapters don't run app-wide guards for message handlers, so
+// gateways bind `MaintenanceGuard` directly rather than relying on the
+// global registration that covers HTTP controllers.
+@UseGuards(MaintenanceGuard)
+@WebSocketGateway(8080)
+export class StatusGateway {
+  @SubscribeMessage('ping')
+  onPing() {
+    return { event: 'pong', data: {} };
+  }
+
+  @SubscribeMessage('reports')
+  @MaintenanceAffected()
+  onReports() {
+    return { event: 'reports', data: { status: 'ok' } };
+  }
+}
