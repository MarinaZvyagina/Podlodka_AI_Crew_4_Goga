@@ -0,0 +1,25 @@
+import { MAINTENANCE_MODE_METADATA } from '../../constants.js';
+import { CustomDecorator, SetMetadata } from './set-metadata.decorator.js';
+
+/**
+ * Marks a controller, a WebSocket gateway, or an individual route/message
+ * handler as affected by maintenance mode. While maintenance mode is
+ * enabled (see `MaintenanceModeService`), `MaintenanceModeGuard` rejects
+ * calls to a marked target before any of its own logic runs. Unmarked
+ * targets are unaffected. When applied to a class, every handler in it is
+ * marked.
+ *
+ * Applies identically to HTTP route handlers and WebSocket message
+ * handlers, since both are gated through the same `CanActivate` mechanism.
+ *
+ * @see [Guards](https://docs.nestjs.com/guards)
+ *
+ * @usageNotes
+ * `MaintenanceModeGuard` must be bound globally (e.g. via `APP_GUARD`) for
+ * this decorator to have any effect, since it needs to observe every call
+ * in order to let unmarked ones through.
+ *
+ * @publicApi
+ */
+export const MaintenanceMode = (): CustomDecorator<string> =>
+  SetMetadata(MAINTENANCE_MODE_METADATA, true);
