index 0000000..9d796e9
--- /dev/null
+++ b/packages/common/guards/maintenance-mode.guard.ts
@@ -0,0 +1,43 @@
+import { MAINTENANCE_MODE_METADATA } from '../constants.js';
+import { Injectable } from '../decorators/core/injectable.decorator.js';
+import { CanActivate } from '../interfaces/features/can-activate.interface.js';
+import { ExecutionContext } from '../interfaces/features/execution-context.interface.js';
+import { MaintenanceModeService } from '../services/maintenance-mode.service.js';
+
+/**
+ * Rejects calls to any handler, controller, or gateway marked with
+ * `@MaintenanceMode()` while `MaintenanceModeService` reports maintenance
+ * mode as enabled. Targets that aren't marked are always allowed through.
+ *
+ * Relies only on `ExecutionContext#getHandler()`/`getClass()`, so it applies
+ * unchanged to both HTTP route handlers and WebSocket message handlers.
+ *
+ * @usageNotes
+ * Bind this guard globally so it observes every call, then mark individual
+ * handlers (or an entire controller/gateway) with `@MaintenanceMode()`:
+ * ```ts
+ * providers: [
+ *   MaintenanceModeService,
+ *   { provide: APP_GUARD, useClass: MaintenanceModeGuard },
+ * ]
+ * ```
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    if (!this.maintenanceModeService.isEnabled()) {
+      return true;
+    }
+    const isAffected =
+      Reflect.getMetadata(MAINTENANCE_MODE_METADATA, context.getHandler()) ??
+      Reflect.getMetadata(MAINTENANCE_MODE_METADATA, context.getClass());
+
+    return !isAffected;
+  }
+}
