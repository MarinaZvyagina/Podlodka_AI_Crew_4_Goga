--- /dev/null
+++ b/packages/common/services/maintenance-mode.service.ts
@@ -0,0 +1,27 @@
+import { Injectable } from '../decorators/core/injectable.decorator.js';
+
+/**
+ * Tracks whether the application is currently in maintenance mode.
+ *
+ * Toggling this at runtime (e.g. from an internal admin action) immediately
+ * affects every handler marked with `@MaintenanceMode()`, via
+ * `MaintenanceModeGuard`, with no redeploy required.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  public enable(): void {
+    this.enabled = true;
+  }
+
+  public disable(): void {
+    this.enabled = false;
+  }
+
+  public isEnabled(): boolean {
+    return this.enabled;
+  }
+}
