@@ -0,0 +1,36 @@
+import { MAINTENANCE_MODE_METADATA } from '../../constants.js';
+import { MaintenanceMode } from '../../decorators/core/maintenance-mode.decorator.js';
+
+describe('@MaintenanceMode', () => {
+  @MaintenanceMode()
+  class TestGateway {
+    @MaintenanceMode()
+    public affected() {}
+
+    public unaffected() {}
+  }
+
+  it('should mark the class with maintenance mode metadata', () => {
+    expect(Reflect.getMetadata(MAINTENANCE_MODE_METADATA, TestGateway)).toBe(
+      true,
+    );
+  });
+
+  it('should mark a decorated method with maintenance mode metadata', () => {
+    expect(
+      Reflect.getMetadata(
+        MAINTENANCE_MODE_METADATA,
+        TestGateway.prototype.affected,
+      ),
+    ).toBe(true);
+  });
+
+  it('should leave an undecorated method unmarked', () => {
+    expect(
+      Reflect.getMetadata(
+        MAINTENANCE_MODE_METADATA,
+        TestGateway.prototype.unaffected,
+      ),
+    ).toBeUndefined();
+  });
+});
diff --git a/packages/common/test/guards/maintenance-mode.guard.spec.ts b/packages/common/test/guards/maintenance-mode.guard.spec.ts
new file mode 100644
index 0000000..67f44ec
--- /dev/null
+++ b/packages/common/test/guards/maintenance-mode.guard.spec.ts
@@ -0,0 +1,85 @@
+import { MaintenanceMode } from '../../decorators/core/maintenance-mode.decorator.js';
+import { MaintenanceModeGuard } from '../../guards/maintenance-mode.guard.js';
+import { ExecutionContext } from '../../interfaces/features/execution-context.interface.js';
+import { MaintenanceModeService } from '../../services/maintenance-mode.service.js';
+
+class UnaffectedController {
+  public healthy() {}
+}
+
+class AffectedController {
+  @MaintenanceMode()
+  public underMigration() {}
+
+  public untouched() {}
+}
+
+@MaintenanceMode()
+class AffectedGateway {
+  public onMessage() {}
+}
+
+const createContext = (
+  instance: object,
+  handler: (...args: unknown[]) => unknown,
+): ExecutionContext =>
+  ({
+    getHandler: () => handler,
+    getClass: () => instance.constructor,
+  }) as ExecutionContext;
+
+describe('MaintenanceModeGuard', () => {
+  let maintenanceModeService: MaintenanceModeService;
+  let guard: MaintenanceModeGuard;
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(maintenanceModeService);
+  });
+
+  describe('when maintenance mode is disabled', () => {
+    it('should allow a marked handler through', () => {
+      const context = createContext(
+        new AffectedController(),
+        AffectedController.prototype.underMigration,
+      );
+      expect(guard.canActivate(context)).toBe(true);
+    });
+  });
+
+  describe('when maintenance mode is enabled', () => {
+    beforeEach(() => maintenanceModeService.enable());
+
+    it('should reject a handler marked with @MaintenanceMode()', () => {
+      const context = createContext(
+        new AffectedController(),
+        AffectedController.prototype.underMigration,
+      );
+      expect(guard.canActivate(context)).toBe(false);
+    });
+
+    it('should reject every handler on a marked class', () => {
+      const context = createContext(
+        new AffectedGateway(),
+        AffectedGateway.prototype.onMessage,
+      );
+      expect(guard.canActivate(context)).toBe(false);
+    });
+
+    it('should allow an unmarked handler on the same controller as a marked one through', () => {
+      const context = createContext(
+        new AffectedController(),
+        AffectedController.prototype.untouched,
+      );
+      expect(guard.canActivate(context)).toBe(true);
+    });
+
+    it('should allow a handler on an unmarked controller through', () => {
+      const context = createContext(
+        new UnaffectedController(),
+        UnaffectedController.prototype.healthy,
+      );
+      expect(guard.canActivate(context)).toBe(true);
+    });
+  });
+});
