+import { Controller, Get, Post } from '@nestjs/common';
+import { AffectedByMaintenance } from '../maintenance/affected-by-maintenance.decorator.js';
+
+@Controller('migrations')
+export class MigrationsController {
+  @Get('status')
+  status() {
+    return { running: false };
+  }
+
+  // Depends on the table being migrated - rejected while maintenance mode is on.
+  @Post('run')
+  @AffectedByMaintenance()
+  run() {
+    return { started: true };
+  }
+}
