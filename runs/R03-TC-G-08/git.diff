+import { Reflector } from '@nestjs/core';
+
+/**
+ * Marks a handler (HTTP route or WebSocket `@SubscribeMessage`) - or an
+ * entire controller/gateway - as affected by maintenance mode. `MaintenanceGuard`
+ * looks this metadata up via `Reflector` and rejects the call while maintenance
+ * mode is enabled, regardless of whether the underlying transport is HTTP or WS.
+ */
+export const AffectedByMaintenance = Reflector.createDecorator<void>();
