+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts
@@ -0,0 +1,100 @@
+import { ExecutionContext, ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { AffectedByMaintenance } from './affected-by-maintenance.decorator.js';
+import { MaintenanceGuard } from './maintenance.guard.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+class UnmarkedController {
+  untouched() {}
+}
+
+class MarkedHandlerController {
+  @AffectedByMaintenance()
+  migrate() {}
+
+  untouched() {}
+}
+
+@AffectedByMaintenance()
+class MarkedControllerController {
+  anyRoute() {}
+}
+
+function createContext(
+  instance: object,
+  handlerName: string,
+  type: 'http' | 'ws' = 'http',
+): ExecutionContext {
+  const klass = instance.constructor;
+  const handler = (instance as any)[handlerName];
+  return {
+    getHandler: () => handler,
+    getClass: () => klass,
+    getType: () => type,
+    getArgs: () => [],
+    getArgByIndex: () => undefined,
+    switchToHttp: () => ({}) as any,
+    switchToWs: () => ({}) as any,
+    switchToRpc: () => ({}) as any,
+  } as ExecutionContext;
+}
+
+describe('MaintenanceGuard', () => {
+  let guard: MaintenanceGuard;
+  let maintenanceMode: MaintenanceModeService;
+
+  beforeEach(() => {
+    maintenanceMode = new MaintenanceModeService();
+    guard = new MaintenanceGuard(new Reflector(), maintenanceMode);
+  });
+
+  it('allows unmarked handlers regardless of maintenance mode', () => {
+    const context = createContext(new UnmarkedController(), 'untouched');
+
+    expect(guard.canActivate(context)).toBe(true);
+    maintenanceMode.enable();
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('allows a marked handler while maintenance mode is off', () => {
+    const context = createContext(new MarkedHandlerController(), 'migrate');
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks a marked handler while maintenance mode is on, leaving siblings unaffected', () => {
+    const instance = new MarkedHandlerController();
+    maintenanceMode.enable();
+
+    expect(() => guard.canActivate(createContext(instance, 'migrate'))).toThrow(
+      ServiceUnavailableException,
+    );
+    expect(guard.canActivate(createContext(instance, 'untouched'))).toBe(true);
+  });
+
+  it('re-allows the handler once maintenance mode is switched back off', () => {
+    const context = createContext(new MarkedHandlerController(), 'migrate');
+
+    maintenanceMode.enable();
+    expect(() => guard.canActivate(context)).toThrow(ServiceUnavailableException);
+
+    maintenanceMode.disable();
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks every handler of a controller marked at the class level', () => {
+    const instance = new MarkedControllerController();
+    maintenanceMode.enable();
+
+    expect(() => guard.canActivate(createContext(instance, 'anyRoute'))).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('throws a WsException instead of an HttpException for WS handlers', () => {
+    const context = createContext(new MarkedHandlerController(), 'migrate', 'ws');
+    maintenanceMode.enable();
+
+    expect(() => guard.canActivate(context)).toThrow(WsException);
+  });
+});
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
new file mode 100644
index 0000000..ad121b1
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
@@ -0,0 +1,48 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { AffectedByMaintenance } from './affected-by-maintenance.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+export const MAINTENANCE_MODE_MESSAGE =
+  'This endpoint is temporarily unavailable due to scheduled maintenance.';
+
+/**
+ * Rejects calls to any handler marked with `@AffectedByMaintenance()` while
+ * maintenance mode is on, before its logic runs. Unmarked handlers are never
+ * touched. Works for both HTTP routes and WebSocket `@SubscribeMessage`
+ * handlers, since `ExecutionContext` is transport-agnostic - only the
+ * exception thrown differs, so each transport's own exception filter can
+ * turn it into the right wire format.
+ *
+ * Register this guard globally (e.g. via `APP_GUARD`) so developers only
+ * need to add the decorator, not wire the guard up per-controller/gateway.
+ */
+@Injectable()
+export class MaintenanceGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceMode: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isAffected = this.reflector.getAllAndOverride(AffectedByMaintenance, [
+      context.getHandler(),
+      context.getClass(),
+    ]);
+
+    if (!isAffected || !this.maintenanceMode.isEnabled()) {
+      return true;
+    }
+
+    if (context.getType() === 'ws') {
+      throw new WsException(MAINTENANCE_MODE_MESSAGE);
+    }
+    throw new ServiceUnavailableException(MAINTENANCE_MODE_MESSAGE);
+  }
+}
