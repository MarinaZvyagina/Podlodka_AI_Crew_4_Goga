@@ -0,0 +1,95 @@
+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import { WsAdapter } from '@nestjs/platform-ws';
+import request from 'supertest';
+import { WebSocket } from 'ws';
+import { AppModule } from '../src/app.module.js';
+
+describe('Maintenance mode (e2e)', () => {
+  let app: INestApplication;
+  let httpServer: any;
+  let ws: WebSocket;
+
+  beforeAll(async () => {
+    const moduleRef = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = moduleRef.createNestApplication();
+    app.useWebSocketAdapter(new WsAdapter(app));
+    await app.listen(3000);
+    httpServer = app.getHttpServer();
+  }, 30000);
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  beforeEach(async () => {
+    ws = new WebSocket('ws://localhost:8080');
+    await new Promise((resolve, reject) => {
+      ws.on('open', resolve);
+      ws.on('error', reject);
+    });
+  });
+
+  afterEach(async () => {
+    ws.close();
+    await request(httpServer).post('/admin/maintenance-mode/disable');
+  });
+
+  // Sends one message over the shared connection and resolves with the next
+  // reply, or `null` if nothing arrives within the window (used to prove a
+  // blocked call never produces its normal echo).
+  function roundTrip(event: string, data: unknown, timeoutMs = 1000): Promise<any> {
+    return new Promise(resolve => {
+      const timer = setTimeout(() => {
+        ws.off('message', onMessage);
+        resolve(null);
+      }, timeoutMs);
+      const onMessage = (raw: Buffer) => {
+        clearTimeout(timer);
+        resolve(JSON.parse(raw.toString()));
+      };
+      ws.on('message', onMessage);
+      ws.send(JSON.stringify({ event, data }));
+    });
+  }
+
+  it('leaves unmarked HTTP routes working while maintenance mode is on', async () => {
+    await request(httpServer).post('/admin/maintenance-mode/enable').expect(201);
+
+    await request(httpServer).get('/migrations/status').expect(200, { running: false });
+  });
+
+  it('rejects a marked HTTP route only while maintenance mode is on', async () => {
+    await request(httpServer).post('/migrations/run').expect(201);
+
+    await request(httpServer).post('/admin/maintenance-mode/enable').expect(201);
+    await request(httpServer).post('/migrations/run').expect(503);
+
+    await request(httpServer).post('/admin/maintenance-mode/disable').expect(201);
+    await request(httpServer).post('/migrations/run').expect(201);
+  });
+
+  it('leaves an unmarked WS message handler working while maintenance mode is on', async () => {
+    await request(httpServer).post('/admin/maintenance-mode/enable').expect(201);
+
+    const reply = await roundTrip('ping', {});
+    expect(reply?.event).toBe('pong');
+  });
+
+  it('rejects a marked WS message handler only while maintenance mode is on', async () => {
+    const okReply = await roundTrip('sync-data', { row: 1 });
+    expect(okReply?.event).toBe('sync-data');
+
+    await request(httpServer).post('/admin/maintenance-mode/enable').expect(201);
+    // The handler's own reply must never arrive while maintenance mode is on.
+    const blockedReply = await roundTrip('sync-data', { row: 1 });
+    expect(blockedReply).toBeNull();
+
+    await request(httpServer).post('/admin/maintenance-mode/disable').expect(201);
+    const restoredReply = await roundTrip('sync-data', { row: 1 });
+    expect(restoredReply?.event).toBe('sync-data');
+  });
+});
