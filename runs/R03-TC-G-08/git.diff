+import { MessageBody, SubscribeMessage, WebSocketGateway } from '@nestjs/websockets';
+import { AffectedByMaintenance } from '../maintenance/affected-by-maintenance.decorator.js';
+
+@WebSocketGateway(8080)
+export class EventsGateway {
+  @SubscribeMessage('ping')
+  ping() {
+    return { event: 'pong', data: {} };
+  }
+
+  // Reads/writes the row range currently being migrated.
+  @SubscribeMessage('sync-data')
+  @AffectedByMaintenance()
+  syncData(@MessageBody() data: any) {
+    return { event: 'sync-data', data };
+  }
+}
