+import { Injectable } from '@nestjs/common';
+
+/**
+ * Single source of truth for whether maintenance mode is currently active.
+ * Toggled at runtime (e.g. from an admin endpoint) - no redeploy required.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  enable(): void {
+    this.enabled = true;
+  }
+
+  disable(): void {
+    this.enabled = false;
+  }
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+}
