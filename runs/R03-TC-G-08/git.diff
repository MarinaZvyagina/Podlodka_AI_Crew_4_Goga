+import { Controller, Get, Post } from '@nestjs/common';
+import { MaintenanceModeService } from '../maintenance/maintenance-mode.service.js';
+
+/**
+ * Deliberately NOT decorated with `@AffectedByMaintenance()`: an operator
+ * must always be able to reach these endpoints, including while maintenance
+ * mode is already on, in order to switch it back off again.
+ */
+@Controller('admin/maintenance-mode')
+export class AdminController {
+  constructor(private readonly maintenanceMode: MaintenanceModeService) {}
+
+  @Get()
+  status() {
+    return { enabled: this.maintenanceMode.isEnabled() };
+  }
+
+  @Post('enable')
+  enable() {
+    this.maintenanceMode.enable();
+    return { enabled: true };
+  }
+
+  @Post('disable')
+  disable() {
+    this.maintenanceMode.disable();
+    return { enabled: false };
+  }
+}
