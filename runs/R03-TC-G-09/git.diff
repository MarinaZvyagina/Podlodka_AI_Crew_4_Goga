index 0000000..fc10aa0
--- /dev/null
+++ b/packages/common/decorators/core/maintenance.decorator.ts
@@ -0,0 +1,19 @@
+import { MAINTENANCE_METADATA } from '../../constants.js';
+import { SetMetadata } from './set-metadata.decorator.js';
+
+/**
+ * Marks a controller, a route handler, or a WebSocket message handler as
+ * affected by maintenance mode. When maintenance mode is switched on, calls
+ * to a marked handler are rejected before its logic runs; unmarked handlers
+ * are unaffected.
+ *
+ * Applying `@Maintenance()` to a controller (or gateway) class marks every
+ * handler within it; applying it to an individual method marks only that
+ * handler.
+ *
+ * @see [Guards](https://docs.nestjs.com/guards)
+ *
+ * @publicApi
+ */
+export const Maintenance = (): MethodDecorator & ClassDecorator =>
+  SetMetadata(MAINTENANCE_METADATA, true);
