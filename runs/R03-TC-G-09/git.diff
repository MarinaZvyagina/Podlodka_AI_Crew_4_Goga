+import { MAINTENANCE_METADATA } from '../../constants.js';
+import { Maintenance } from '../../decorators/core/maintenance.decorator.js';
+
+describe('@Maintenance', () => {
+  class Test {
+    @Maintenance()
+    static affectedHandler() {}
+
+    static unaffectedHandler() {}
+  }
+
+  @Maintenance()
+  class AffectedController {}
+
+  it('marks a decorated method with the maintenance metadata', () => {
+    expect(Reflect.getMetadata(MAINTENANCE_METADATA, Test.affectedHandler)).toBe(
+      true,
+    );
+  });
+
+  it('leaves an undecorated method untouched', () => {
+    expect(
+      Reflect.getMetadata(MAINTENANCE_METADATA, Test.unaffectedHandler),
+    ).toBeUndefined();
+  });
+
+  it('marks a decorated class with the maintenance metadata', () => {
+    expect(
+      Reflect.getMetadata(MAINTENANCE_METADATA, AffectedController),
+    ).toBe(true);
+  });
+});
