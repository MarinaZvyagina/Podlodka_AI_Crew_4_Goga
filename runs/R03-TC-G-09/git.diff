@@ -0,0 +1,38 @@
+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the application's maintenance mode flag. Injecting this service
+ * (it is a singleton by default) lets any part of the running application —
+ * an admin endpoint, a CLI command, a scheduled job — flip maintenance mode
+ * on or off without a redeploy. `MaintenanceGuard` reads this flag to decide
+ * whether a handler marked with `@Maintenance()` may run.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  /**
+   * Switches maintenance mode on. From this point, calls to handlers marked
+   * with `@Maintenance()` are rejected until `disable()` is called.
+   */
+  public enable(): void {
+    this.enabled = true;
+  }
+
+  /**
+   * Switches maintenance mode off, restoring normal behavior for handlers
+   * marked with `@Maintenance()`.
+   */
+  public disable(): void {
+    this.enabled = false;
+  }
+
+  /**
+   * @returns whether maintenance mode is currently switched on.
+   */
+  public isEnabled(): boolean {
+    return this.enabled;
+  }
+}
diff --git a/packages/core/maintenance/maintenance.guard.ts b/packages/core/maintenance/maintenance.guard.ts
new file mode 100644
index 0000000..cc465d6
--- /dev/null
+++ b/packages/core/maintenance/maintenance.guard.ts
@@ -0,0 +1,47 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { MAINTENANCE_METADATA } from '@nestjs/common/internal';
+import { Reflector } from '../services/reflector.service.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Rejects calls to handlers marked with `@Maintenance()` while maintenance
+ * mode is switched on, before any of their logic runs. Unmarked handlers are
+ * always let through, and marked handlers behave normally whenever
+ * maintenance mode is off.
+ *
+ * `@Maintenance()` may be applied to a controller/gateway class, an HTTP
+ * route handler, or a WebSocket `@SubscribeMessage()` handler — this guard
+ * enforces it identically in every case, since it relies only on the
+ * `CanActivate` contract shared by both transports.
+ *
+ * @usageNotes
+ * Bind it wherever handlers may carry `@Maintenance()`, e.g. globally via
+ * `APP_GUARD`, or locally with `@UseGuards(MaintenanceGuard)`.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  public canActivate(context: ExecutionContext): boolean {
+    const isAffectedByMaintenance = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_METADATA,
+      [context.getHandler(), context.getClass()],
+    );
+    if (!isAffectedByMaintenance || !this.maintenanceModeService.isEnabled()) {
+      return true;
+    }
+    throw new ServiceUnavailableException(
+      'This endpoint is temporarily unavailable due to maintenance',
+    );
+  }
+}
diff --git a/packages/core/test/maintenance/maintenance-mode.service.spec.ts b/packages/core/test/maintenance/maintenance-mode.service.spec.ts
