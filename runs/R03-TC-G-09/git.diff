@@ -0,0 +1,34 @@
+import { MaintenanceModeService } from '../../maintenance/maintenance-mode.service.js';
+
+describe('MaintenanceModeService', () => {
+  let service: MaintenanceModeService;
+
+  beforeEach(() => {
+    service = new MaintenanceModeService();
+  });
+
+  it('starts disabled', () => {
+    expect(service.isEnabled()).toBe(false);
+  });
+
+  it('reports enabled after enable() is called', () => {
+    service.enable();
+    expect(service.isEnabled()).toBe(true);
+  });
+
+  it('reports disabled again after disable() is called', () => {
+    service.enable();
+    service.disable();
+    expect(service.isEnabled()).toBe(false);
+  });
+
+  it('is idempotent when toggled to the same state twice', () => {
+    service.enable();
+    service.enable();
+    expect(service.isEnabled()).toBe(true);
+
+    service.disable();
+    service.disable();
+    expect(service.isEnabled()).toBe(false);
+  });
+});
diff --git a/packages/core/test/maintenance/maintenance.guard.spec.ts b/packages/core/test/maintenance/maintenance.guard.spec.ts
new file mode 100644
index 0000000..e274448
--- /dev/null
+++ b/packages/core/test/maintenance/maintenance.guard.spec.ts
@@ -0,0 +1,122 @@
+import {
+  ExecutionContext,
+  Maintenance,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '../../services/reflector.service.js';
+import { MaintenanceModeService } from '../../maintenance/maintenance-mode.service.js';
+import { MaintenanceGuard } from '../../maintenance/maintenance.guard.js';
+
+describe('MaintenanceGuard', () => {
+  class TestController {
+    @Maintenance()
+    affectedHandler() {}
+
+    unaffectedHandler() {}
+  }
+
+  @Maintenance()
+  class FullyAffectedController {
+    handler() {}
+  }
+
+  class GatewayLike {
+    @Maintenance()
+    onMigrationSensitiveMessage() {}
+
+    onOrdinaryMessage() {}
+  }
+
+  const createContext = (
+    handler: Function,
+    clazz: Function,
+  ): ExecutionContext =>
+    ({
+      getHandler: () => handler,
+      getClass: () => clazz,
+    }) as ExecutionContext;
+
+  let guard: MaintenanceGuard;
+  let maintenanceModeService: MaintenanceModeService;
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceGuard(new Reflector(), maintenanceModeService);
+  });
+
+  describe('when maintenance mode is off', () => {
+    it('allows a handler marked with @Maintenance()', () => {
+      const context = createContext(
+        TestController.prototype.affectedHandler,
+        TestController,
+      );
+      expect(guard.canActivate(context)).toBe(true);
+    });
+
+    it('allows an unmarked handler', () => {
+      const context = createContext(
+        TestController.prototype.unaffectedHandler,
+        TestController,
+      );
+      expect(guard.canActivate(context)).toBe(true);
+    });
+  });
+
+  describe('when maintenance mode is on', () => {
+    beforeEach(() => maintenanceModeService.enable());
+
+    it('blocks a handler marked with @Maintenance() before it would run', () => {
+      const context = createContext(
+        TestController.prototype.affectedHandler,
+        TestController,
+      );
+      expect(() => guard.canActivate(context)).toThrow(
+        ServiceUnavailableException,
+      );
+    });
+
+    it('leaves an unmarked handler on the same controller unaffected', () => {
+      const context = createContext(
+        TestController.prototype.unaffectedHandler,
+        TestController,
+      );
+      expect(guard.canActivate(context)).toBe(true);
+    });
+
+    it('blocks every handler on a controller marked with @Maintenance()', () => {
+      const context = createContext(
+        FullyAffectedController.prototype.handler,
+        FullyAffectedController,
+      );
+      expect(() => guard.canActivate(context)).toThrow(
+        ServiceUnavailableException,
+      );
+    });
+
+    it('applies identically to a WebSocket message handler carrying the same decorator', () => {
+      const blocked = createContext(
+        GatewayLike.prototype.onMigrationSensitiveMessage,
+        GatewayLike,
+      );
+      const allowed = createContext(
+        GatewayLike.prototype.onOrdinaryMessage,
+        GatewayLike,
+      );
+
+      expect(() => guard.canActivate(blocked)).toThrow(
+        ServiceUnavailableException,
+      );
+      expect(guard.canActivate(allowed)).toBe(true);
+    });
+
+    it('stops blocking once maintenance mode is switched off again', () => {
+      maintenanceModeService.disable();
+
+      const context = createContext(
+        TestController.prototype.affectedHandler,
+        TestController,
+      );
+      expect(guard.canActivate(context)).toBe(true);
+    });
+  });
+});
