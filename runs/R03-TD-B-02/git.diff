index 0000000..33f2496
--- /dev/null
+++ b/packages/core/middleware/request-id/request-id.middleware.ts
@@ -0,0 +1,68 @@
+import { randomStringGenerator } from '@nestjs/common/internal';
+import { RequestIdStorage } from './request-id-storage.js';
+
+/**
+ * Default name of the header used to read/propagate the correlation ID.
+ */
+export const DEFAULT_REQUEST_ID_HEADER = 'X-Request-Id';
+
+/**
+ * A caller-supplied ID is only trusted (echoed back and reused) if it matches
+ * this shape, so that untrusted input can't be used to smuggle control
+ * characters or oversized values into logs and downstream headers.
+ */
+const VALID_REQUEST_ID = /^[a-zA-Z0-9_-]{1,128}$/;
+
+export interface RequestIdMiddlewareOptions {
+  /**
+   * Name of the request/response header carrying the correlation ID.
+   * @default 'X-Request-Id'
+   */
+  header?: string;
+  /**
+   * Used to generate a new ID when the incoming request doesn't already
+   * carry a valid one.
+   * @default randomStringGenerator (from `@nestjs/common`)
+   */
+  generator?: () => string;
+}
+
+function getIncomingHeaderValue(req: any, header: string): string | undefined {
+  const value = req.headers?.[header];
+  return Array.isArray(value) ? value[0] : value;
+}
+
+/**
+ * Creates HTTP-adapter-agnostic middleware that ensures every response
+ * carries a correlation/request ID header: the incoming header value is
+ * reused when present and well-formed, otherwise a new ID is generated. The
+ * ID is also bound to {@link RequestIdStorage} for the duration of the
+ * request so application code can retrieve it (e.g. for logging) without
+ * reading it back off the response.
+ *
+ * Register it via `app.use(createRequestIdMiddleware())` as early as
+ * possible (before other middleware/handlers) so it applies uniformly
+ * regardless of the underlying HTTP adapter (Express, Fastify, ...).
+ *
+ * @publicApi
+ */
+export function createRequestIdMiddleware(
+  options: RequestIdMiddlewareOptions = {},
+) {
+  const header = options.header ?? DEFAULT_REQUEST_ID_HEADER;
+  const lookupHeader = header.toLowerCase();
+  const generator = options.generator ?? randomStringGenerator;
+
+  return function requestIdMiddleware(
+    req: any,
+    res: any,
+    next: (err?: any) => void,
+  ) {
+    const incoming = getIncomingHeaderValue(req, lookupHeader);
+    const id =
+      incoming && VALID_REQUEST_ID.test(incoming) ? incoming : generator();
+
+    res.setHeader(header, id);
+    RequestIdStorage.run(id, next);
+  };
+}
diff --git a/packages/core/test/middleware/request-id/request-id-storage.spec.ts b/packages/core/test/middleware/request-id/request-id-storage.spec.ts
new file mode 100644
