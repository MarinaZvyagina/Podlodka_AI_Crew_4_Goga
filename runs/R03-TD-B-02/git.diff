@@ -0,0 +1,32 @@
+import { AsyncLocalStorage } from 'async_hooks';
+
+/**
+ * Holds the correlation/request ID for the lifetime of a single HTTP request,
+ * independently of which underlying HTTP adapter (Express, Fastify, ...)
+ * handled it. Populated by the request ID middleware and read by application
+ * code via {@link RequestIdStorage.get}.
+ *
+ * @publicApi
+ */
+export class RequestIdStorage {
+  private static readonly storage = new AsyncLocalStorage<string>();
+
+  /**
+   * Runs `callback` with `id` bound as the current request ID. Any code
+   * executed synchronously or asynchronously from within `callback`
+   * (including across `await`/Promise boundaries) can retrieve it via
+   * {@link RequestIdStorage.get}.
+   */
+  public static run<T>(id: string, callback: () => T): T {
+    return this.storage.run(id, callback);
+  }
+
+  /**
+   * Returns the request ID bound by the innermost {@link RequestIdStorage.run}
+   * call in the current async execution context, or `undefined` if called
+   * outside of a request (or before the request ID middleware has run).
+   */
+  public static get(): string | undefined {
+    return this.storage.getStore();
+  }
+}
diff --git a/packages/core/middleware/request-id/request-id.middleware.ts b/packages/core/middleware/request-id/request-id.middleware.ts
