+++ b/packages/core/test/middleware/request-id/request-id-storage.spec.ts
@@ -0,0 +1,54 @@
+import { RequestIdStorage } from '../../../middleware/request-id/request-id-storage.js';
+
+describe('RequestIdStorage', () => {
+  it('should return undefined when called outside of a run() context', () => {
+    expect(RequestIdStorage.get()).toBeUndefined();
+  });
+
+  it('should return the bound id from within the run() callback', () => {
+    RequestIdStorage.run('req-1', () => {
+      expect(RequestIdStorage.get()).toEqual('req-1');
+    });
+  });
+
+  it('should propagate the bound id across async/await boundaries', async () => {
+    await RequestIdStorage.run('req-2', async () => {
+      await Promise.resolve();
+      expect(RequestIdStorage.get()).toEqual('req-2');
+      await new Promise(resolve => setTimeout(resolve, 0));
+      expect(RequestIdStorage.get()).toEqual('req-2');
+    });
+  });
+
+  it('should return the value produced by the callback', () => {
+    const result = RequestIdStorage.run('req-3', () => 42);
+    expect(result).toEqual(42);
+  });
+
+  it('should isolate concurrent, interleaved run() contexts', async () => {
+    const observed: Array<[string, string | undefined]> = [];
+
+    const runA = RequestIdStorage.run('req-a', async () => {
+      await new Promise(resolve => setTimeout(resolve, 10));
+      observed.push(['a', RequestIdStorage.get()]);
+    });
+    const runB = RequestIdStorage.run('req-b', async () => {
+      await new Promise(resolve => setTimeout(resolve, 0));
+      observed.push(['b', RequestIdStorage.get()]);
+    });
+
+    await Promise.all([runA, runB]);
+
+    expect(observed).toContainEqual(['a', 'req-a']);
+    expect(observed).toContainEqual(['b', 'req-b']);
+  });
+
+  it('should restore the outer context after a nested run() returns', () => {
+    RequestIdStorage.run('outer', () => {
+      RequestIdStorage.run('inner', () => {
+        expect(RequestIdStorage.get()).toEqual('inner');
+      });
+      expect(RequestIdStorage.get()).toEqual('outer');
+    });
+  });
+});
diff --git a/packages/core/test/middleware/request-id/request-id.middleware.spec.ts b/packages/core/test/middleware/request-id/request-id.middleware.spec.ts
new file mode 100644
index 0000000..fe1a439
--- /dev/null
+++ b/packages/core/test/middleware/request-id/request-id.middleware.spec.ts
@@ -0,0 +1,119 @@
+import {
+  DEFAULT_REQUEST_ID_HEADER,
+  createRequestIdMiddleware,
+} from '../../../middleware/request-id/request-id.middleware.js';
+import { RequestIdStorage } from '../../../middleware/request-id/request-id-storage.js';
+
+describe('createRequestIdMiddleware', () => {
+  const createReq = (headers: Record<string, any> = {}) => ({ headers });
+  const createRes = () => ({ setHeader: vi.fn() });
+
+  it('should generate a new id when no incoming header is present', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = createReq();
+    const res = createRes();
+    const next = vi.fn();
+
+    middleware(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledTimes(1);
+    const [headerName, id] = res.setHeader.mock.calls[0];
+    expect(headerName).toEqual(DEFAULT_REQUEST_ID_HEADER);
+    expect(typeof id).toEqual('string');
+    expect(id.length).toBeGreaterThan(0);
+    expect(next).toHaveBeenCalledTimes(1);
+  });
+
+  it('should reuse a well-formed incoming header value instead of generating one', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = createReq({ 'x-request-id': 'caller-supplied-id-123' });
+    const res = createRes();
+
+    middleware(req, res, vi.fn());
+
+    expect(res.setHeader).toHaveBeenCalledWith(
+      DEFAULT_REQUEST_ID_HEADER,
+      'caller-supplied-id-123',
+    );
+  });
+
+  it('should fall back to a generated id when the incoming header is malformed', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = createReq({ 'x-request-id': 'not valid\r\nheader value' });
+    const res = createRes();
+
+    middleware(req, res, vi.fn());
+
+    const [, id] = res.setHeader.mock.calls[0];
+    expect(id).not.toEqual('not valid\r\nheader value');
+  });
+
+  it('should fall back to a generated id when the incoming header is empty', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = createReq({ 'x-request-id': '' });
+    const res = createRes();
+
+    middleware(req, res, vi.fn());
+
+    const [, id] = res.setHeader.mock.calls[0];
+    expect(id.length).toBeGreaterThan(0);
+  });
+
+  it('should use the first value when the incoming header was duplicated', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = createReq({ 'x-request-id': ['first-id', 'second-id'] });
+    const res = createRes();
+
+    middleware(req, res, vi.fn());
+
+    expect(res.setHeader).toHaveBeenCalledWith(
+      DEFAULT_REQUEST_ID_HEADER,
+      'first-id',
+    );
+  });
+
+  it('should support a custom header name (matched case-insensitively on the way in)', () => {
+    const middleware = createRequestIdMiddleware({ header: 'X-Trace-Id' });
+    const req = createReq({ 'x-trace-id': 'trace-42' });
+    const res = createRes();
+
+    middleware(req, res, vi.fn());
+
+    expect(res.setHeader).toHaveBeenCalledWith('X-Trace-Id', 'trace-42');
+  });
+
+  it('should support a custom id generator', () => {
+    const middleware = createRequestIdMiddleware({
+      generator: () => 'fixed-id',
+    });
+    const req = createReq();
+    const res = createRes();
+
+    middleware(req, res, vi.fn());
+
+    expect(res.setHeader).toHaveBeenCalledWith(
+      DEFAULT_REQUEST_ID_HEADER,
+      'fixed-id',
+    );
+  });
+
+  it('should make the id available via RequestIdStorage while next() runs', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = createReq({ 'x-request-id': 'req-in-storage' });
+    const res = createRes();
+    let observed: string | undefined;
+
+    middleware(req, res, () => {
+      observed = RequestIdStorage.get();
+    });
+
+    expect(observed).toEqual('req-in-storage');
+  });
+
+  it('should not leak the id into RequestIdStorage outside of the request', () => {
+    const middleware = createRequestIdMiddleware();
+    middleware(createReq(), createRes(), vi.fn());
+
+    expect(RequestIdStorage.get()).toBeUndefined();
+  });
+});
