+import { RequestIdStorage } from '../../utils/request-id-storage.util.js';
+import { createParamDecorator } from './create-route-param-metadata.decorator.js';
+
+/**
+ * Route handler parameter decorator that injects the id of the request
+ * currently being handled.
+ *
+ * The same value is used both for the `X-Request-Id` response header
+ * (see `app.enableRequestId()`) and here, so a log line written from inside
+ * a route handler - or any other application code invoked while the request
+ * is being handled - can be correlated with the response without reading
+ * the id back out of the outgoing response.
+ *
+ * @example
+ * ```typescript
+ * @Get()
+ * findAll(@RequestId() requestId: string) {
+ *   this.logger.log('handling request', { requestId });
+ * }
+ * ```
+ *
+ * @publicApi
+ */
+export const RequestId: () => ParameterDecorator = createParamDecorator(
+  (): string | undefined => RequestIdStorage.get(),
+);
