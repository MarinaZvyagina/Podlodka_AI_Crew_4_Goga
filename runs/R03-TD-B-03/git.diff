+import { AsyncLocalStorage } from 'async_hooks';
+
+/**
+ * Default name of the HTTP header used to carry the request/correlation id,
+ * both when reading it off an inbound request and when writing it onto the
+ * outbound response.
+ *
+ * @publicApi
+ */
+export const X_REQUEST_ID_HEADER = 'x-request-id';
+
+/**
+ * Options accepted by `app.enableRequestId()`.
+ *
+ * @publicApi
+ */
+export interface RequestIdOptions {
+  /**
+   * Name of the HTTP header carrying the request id, read from the inbound
+   * request and written onto the outbound response.
+   *
+   * Defaults to `x-request-id`.
+   */
+  header?: string;
+  /**
+   * Factory used to generate a new request id when the inbound request does
+   * not already carry one (for example, when it isn't itself a downstream
+   * call from another one of our own services).
+   *
+   * Defaults to `crypto.randomUUID()`.
+   */
+  generator?: () => string;
+}
+
+/**
+ * Holds the id of the request currently being handled, so that it can be
+ * read from anywhere in application code (services, guards, interceptors,
+ * loggers, ...) without threading the request object through every call,
+ * and identically regardless of which underlying HTTP adapter (Express or
+ * Fastify) the application uses.
+ *
+ * Populated by the framework for the lifetime of a request once
+ * `app.enableRequestId()` has been called; read it with
+ * `RequestIdStorage.get()`, or inject it into a route handler argument with
+ * the `@RequestId()` decorator.
+ *
+ * @publicApi
+ */
+export class RequestIdStorage {
+  private static readonly storage = new AsyncLocalStorage<string>();
+
+  /**
+   * Runs `callback` with `requestId` bound to the current asynchronous
+   * execution context, so that any code invoked - synchronously or
+   * asynchronously - from within `callback` can read it back via `get()`.
+   */
+  public static run<T>(requestId: string, callback: () => T): T {
+    return this.storage.run(requestId, callback);
+  }
+
+  /**
+   * Returns the id of the request currently being handled, or `undefined`
+   * when called outside of a request handled by an application that has
+   * `enableRequestId()` enabled.
+   */
+  public static get(): string | undefined {
+    return this.storage.getStore();
+  }
+}
