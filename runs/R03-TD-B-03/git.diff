+import {
+  Controller,
+  Get,
+  INestApplication,
+  RequestId,
+  RequestIdStorage,
+  X_REQUEST_ID_HEADER,
+} from '@nestjs/common';
+import {
+  FastifyAdapter,
+  NestFastifyApplication,
+} from '@nestjs/platform-fastify';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+
+@Controller()
+class RequestIdController {
+  @Get('id')
+  getId(@RequestId() requestId: string) {
+    return {
+      fromDecorator: requestId,
+      fromStorage: RequestIdStorage.get(),
+    };
+  }
+}
+
+function declareRequestIdSuite(
+  name: string,
+  createApp: () => Promise<INestApplication>,
+  afterInit: (app: INestApplication) => Promise<void> = async () => {},
+) {
+  describe(name, () => {
+    let app: INestApplication;
+
+    afterEach(async () => {
+      await app.close();
+    });
+
+    describe('default options', () => {
+      beforeEach(async () => {
+        app = await createApp();
+        app.enableRequestId();
+        await app.init();
+        await afterInit(app);
+      });
+
+      it('generates an id and returns it on the response header when the caller sends none', async () => {
+        const response = await request(app.getHttpServer())
+          .get('/id')
+          .expect(200);
+
+        const headerValue = response.headers[X_REQUEST_ID_HEADER];
+        expect(headerValue).toBeDefined();
+        expect(response.body.fromDecorator).toBe(headerValue);
+        expect(response.body.fromStorage).toBe(headerValue);
+      });
+
+      it('reuses the inbound request id instead of generating a new one', async () => {
+        const inboundId = 'caller-supplied-id-123';
+
+        const response = await request(app.getHttpServer())
+          .get('/id')
+          .set(X_REQUEST_ID_HEADER, inboundId)
+          .expect(200);
+
+        expect(response.headers[X_REQUEST_ID_HEADER]).toBe(inboundId);
+        expect(response.body.fromDecorator).toBe(inboundId);
+        expect(response.body.fromStorage).toBe(inboundId);
+      });
+
+      it('generates a different id per request when none is supplied', async () => {
+        const first = await request(app.getHttpServer()).get('/id').expect(200);
+        const second = await request(app.getHttpServer())
+          .get('/id')
+          .expect(200);
+
+        expect(first.headers[X_REQUEST_ID_HEADER]).not.toBe(
+          second.headers[X_REQUEST_ID_HEADER],
+        );
+      });
+
+      it('is not visible outside of a request', () => {
+        expect(RequestIdStorage.get()).toBeUndefined();
+      });
+    });
+
+    describe('custom options', () => {
+      const CUSTOM_HEADER = 'x-correlation-id';
+
+      beforeEach(async () => {
+        app = await createApp();
+        app.enableRequestId({
+          header: CUSTOM_HEADER,
+          generator: () => 'generated-id',
+        });
+        await app.init();
+        await afterInit(app);
+      });
+
+      it('uses the configured header name and generator', async () => {
+        const response = await request(app.getHttpServer())
+          .get('/id')
+          .expect(200);
+
+        expect(response.headers[CUSTOM_HEADER]).toBe('generated-id');
+        expect(response.headers[X_REQUEST_ID_HEADER]).toBeUndefined();
+        expect(response.body.fromDecorator).toBe('generated-id');
+      });
+
+      it('still reuses an inbound id sent on the configured header', async () => {
+        const response = await request(app.getHttpServer())
+          .get('/id')
+          .set(CUSTOM_HEADER, 'inbound-correlation-id')
+          .expect(200);
+
+        expect(response.headers[CUSTOM_HEADER]).toBe('inbound-correlation-id');
+        expect(response.body.fromDecorator).toBe('inbound-correlation-id');
+      });
+    });
+  });
+}
+
+declareRequestIdSuite('RequestId (ExpressAdapter)', async () => {
+  const moduleRef = await Test.createTestingModule({
+    controllers: [RequestIdController],
+  }).compile();
+
+  return moduleRef.createNestApplication();
+});
+
+declareRequestIdSuite(
+  'RequestId (FastifyAdapter)',
+  async () => {
+    const moduleRef = await Test.createTestingModule({
+      controllers: [RequestIdController],
+    }).compile();
+
+    return moduleRef.createNestApplication<NestFastifyApplication>(
+      new FastifyAdapter(),
+    );
+  },
+  async app => {
+    await (app as NestFastifyApplication)
+      .getHttpAdapter()
+      .getInstance()
+      .ready();
+  },
+);
