+  public enableRequestId(options: RequestIdOptions = {}): this {
+    const headerName = options.header ?? X_REQUEST_ID_HEADER;
+    const lowerCasedHeaderName = headerName.toLowerCase();
+    const generateId = options.generator ?? (() => randomUUID());
+
+    this.getHttpAdapter().setOnRequestHook(
+      (req: any, res: any, done: (err?: Error) => void) => {
+        const inboundHeader = req.headers?.[lowerCasedHeaderName];
+        const requestId =
+          (Array.isArray(inboundHeader) ? inboundHeader[0] : inboundHeader) ||
+          generateId();
+
+        this.getHttpAdapter().setHeader(res, headerName, requestId);
+        RequestIdStorage.run(requestId, () => done());
+      },
+    );
+
+    return this;
+  }
