@@ -0,0 +1,40 @@
+import { RequestIdStorage } from '../../middleware/request-id.storage.js';
+
+describe('RequestIdStorage', () => {
+  it('should return undefined outside of a run() context', () => {
+    expect(RequestIdStorage.id).toBeUndefined();
+  });
+
+  it('should expose the id while inside a run() context', () => {
+    RequestIdStorage.run('req-1', () => {
+      expect(RequestIdStorage.id).toEqual('req-1');
+    });
+  });
+
+  it('should propagate the id across async boundaries within run()', async () => {
+    await RequestIdStorage.run('req-2', async () => {
+      await new Promise(resolve => setTimeout(resolve, 0));
+      expect(RequestIdStorage.id).toEqual('req-2');
+    });
+  });
+
+  it('should isolate concurrent run() contexts from each other', async () => {
+    const observed: string[] = [];
+    await Promise.all([
+      RequestIdStorage.run('req-a', async () => {
+        await new Promise(resolve => setTimeout(resolve, 10));
+        observed.push(RequestIdStorage.id!);
+      }),
+      RequestIdStorage.run('req-b', async () => {
+        await new Promise(resolve => setTimeout(resolve, 0));
+        observed.push(RequestIdStorage.id!);
+      }),
+    ]);
+    expect(observed.sort()).toEqual(['req-a', 'req-b']);
+  });
+
+  it('should return the callback result', () => {
+    const result = RequestIdStorage.run('req-3', () => 42);
+    expect(result).toEqual(42);
+  });
+});
