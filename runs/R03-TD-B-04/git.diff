+import { createRequestIdMiddleware } from '@nestjs/core';
+import { NestExpressApplication } from '@nestjs/platform-express';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../src/app.module.js';
+
+describe('Express RequestId', () => {
+  let app: NestExpressApplication;
+
+  beforeEach(async () => {
+    const module = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = module.createNestApplication<NestExpressApplication>();
+    app.use(createRequestIdMiddleware());
+    await app.init();
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  it('should generate an id and expose it via the response header and to application code', async () => {
+    const response = await request(app.getHttpServer()).get('/').expect(200);
+
+    const headerId = response.headers['x-request-id'];
+    expect(typeof headerId).toEqual('string');
+    expect(headerId.length).toBeGreaterThan(0);
+    expect(response.body.id).toEqual(headerId);
+  });
+
+  it('should reuse the id supplied by the caller', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/')
+      .set('x-request-id', 'caller-supplied-id')
+      .expect(200);
+
+    expect(response.headers['x-request-id']).toEqual('caller-supplied-id');
+    expect(response.body.id).toEqual('caller-supplied-id');
+  });
+
+  it('should generate a different id for every request without one', async () => {
+    const first = await request(app.getHttpServer()).get('/').expect(200);
+    const second = await request(app.getHttpServer()).get('/').expect(200);
+
+    expect(first.headers['x-request-id']).not.toEqual(
+      second.headers['x-request-id'],
+    );
+  });
+});
