+import { createRequestIdMiddleware } from '@nestjs/core';
+import {
+  FastifyAdapter,
+  NestFastifyApplication,
+} from '@nestjs/platform-fastify';
+import { Test } from '@nestjs/testing';
+import { AppModule } from '../src/app.module.js';
+
+describe('Fastify RequestId', () => {
+  let app: NestFastifyApplication;
+
+  beforeEach(async () => {
+    const module = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = module.createNestApplication<NestFastifyApplication>(
+      new FastifyAdapter(),
+    );
+    app.use(createRequestIdMiddleware());
+    await app.init();
+    await app.getHttpAdapter().getInstance().ready();
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  it('should generate an id and expose it via the response header and to application code', async () => {
+    const { statusCode, headers, payload } = await app.inject({
+      method: 'GET',
+      url: '/',
+    });
+
+    expect(statusCode).toBe(200);
+    const headerId = headers['x-request-id'];
+    expect(typeof headerId).toEqual('string');
+    expect((headerId as string).length).toBeGreaterThan(0);
+    expect(JSON.parse(payload).id).toEqual(headerId);
+  });
+
+  it('should reuse the id supplied by the caller', async () => {
+    const { statusCode, headers, payload } = await app.inject({
+      method: 'GET',
+      url: '/',
+      headers: { 'x-request-id': 'caller-supplied-id' },
+    });
+
+    expect(statusCode).toBe(200);
+    expect(headers['x-request-id']).toEqual('caller-supplied-id');
+    expect(JSON.parse(payload).id).toEqual('caller-supplied-id');
+  });
+
+  it('should generate a different id for every request without one', async () => {
+    const first = await app.inject({ method: 'GET', url: '/' });
+    const second = await app.inject({ method: 'GET', url: '/' });
+
+    expect(first.headers['x-request-id']).not.toEqual(
+      second.headers['x-request-id'],
+    );
+  });
+});
