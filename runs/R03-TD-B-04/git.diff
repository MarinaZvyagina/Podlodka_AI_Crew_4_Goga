@@ -0,0 +1,105 @@
+import { createRequestIdMiddleware } from '../../middleware/request-id.middleware.js';
+import { RequestIdStorage } from '../../middleware/request-id.storage.js';
+
+describe('createRequestIdMiddleware', () => {
+  const createReqRes = (headers: Record<string, unknown> = {}) => {
+    const req = { headers };
+    const res = { setHeader: vi.fn() };
+    const next = vi.fn();
+    return { req, res, next };
+  };
+
+  it('should generate an id and set it as a response header when none was provided', () => {
+    const middleware = createRequestIdMiddleware();
+    const { req, res, next } = createReqRes();
+
+    middleware(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledOnce();
+    const [header, id] = res.setHeader.mock.calls[0];
+    expect(header).toEqual('x-request-id');
+    expect(typeof id).toEqual('string');
+    expect(id.length).toBeGreaterThan(0);
+    expect(next).toHaveBeenCalledOnce();
+  });
+
+  it('should reuse the id supplied by the caller in the request header', () => {
+    const middleware = createRequestIdMiddleware();
+    const { req, res, next } = createReqRes({
+      'x-request-id': 'caller-supplied-id',
+    });
+
+    middleware(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledWith(
+      'x-request-id',
+      'caller-supplied-id',
+    );
+    expect(next).toHaveBeenCalledOnce();
+  });
+
+  it('should ignore an unsafe incoming id and generate a new one instead', () => {
+    const middleware = createRequestIdMiddleware();
+    const { req, res, next } = createReqRes({
+      'x-request-id': 'has\r\nheader-injection',
+    });
+
+    middleware(req, res, next);
+
+    const [, id] = res.setHeader.mock.calls[0];
+    expect(id).not.toEqual('has\r\nheader-injection');
+  });
+
+  it('should use the first value when the header was sent multiple times', () => {
+    const middleware = createRequestIdMiddleware();
+    const { req, res, next } = createReqRes({
+      'x-request-id': ['first-id', 'second-id'],
+    });
+
+    middleware(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledWith('x-request-id', 'first-id');
+  });
+
+  it('should respect a custom header name', () => {
+    const middleware = createRequestIdMiddleware({
+      header: 'X-Correlation-Id',
+    });
+    const { req, res, next } = createReqRes({
+      'x-correlation-id': 'correlation-1',
+    });
+
+    middleware(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledWith(
+      'x-correlation-id',
+      'correlation-1',
+    );
+  });
+
+  it('should respect a custom id generator', () => {
+    const middleware = createRequestIdMiddleware({
+      generateId: () => 'fixed-id',
+    });
+    const { req, res, next } = createReqRes();
+
+    middleware(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledWith('x-request-id', 'fixed-id');
+  });
+
+  it('should make the id available via RequestIdStorage while next() runs', () => {
+    const middleware = createRequestIdMiddleware({
+      generateId: () => 'stored-id',
+    });
+    const { req, res } = createReqRes();
+    let observed: string | undefined;
+
+    middleware(req, res, () => {
+      observed = RequestIdStorage.id;
+    });
+
+    expect(observed).toEqual('stored-id');
+    expect(RequestIdStorage.id).toBeUndefined();
+  });
+});
diff --git a/packages/core/test/middleware/request-id.storage.spec.ts b/packages/core/test/middleware/request-id.storage.spec.ts
