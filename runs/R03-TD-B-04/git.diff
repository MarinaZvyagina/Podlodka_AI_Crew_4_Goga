@@ -0,0 +1,56 @@
+import { randomUUID } from 'crypto';
+import { RequestIdStorage } from './request-id.storage.js';
+
+export interface RequestIdMiddlewareOptions {
+  /**
+   * Name of the request/response header used to carry the ID.
+   * @default 'x-request-id'
+   */
+  header?: string;
+  /**
+   * Used to generate a new ID when the caller did not supply one.
+   * @default randomUUID
+   */
+  generateId?: () => string;
+}
+
+// Only reuse an incoming ID if it looks safe to echo back verbatim in a
+// response header (bounded length, no header-injection-capable characters).
+const SAFE_ID_PATTERN = /^[\w.-]{1,200}$/;
+
+function extractIncomingId(value: unknown): string | undefined {
+  const raw = Array.isArray(value) ? value[0] : value;
+  return typeof raw === 'string' && SAFE_ID_PATTERN.test(raw)
+    ? raw
+    : undefined;
+}
+
+/**
+ * Connect-style middleware that assigns a correlation/request ID to every
+ * incoming request: the ID supplied by the caller in the request header is
+ * reused when present and valid, otherwise a new one is generated. The ID is
+ * written back on the response header and made available to application
+ * code for the lifetime of the request via {@link RequestIdStorage}.
+ *
+ * Register it with `app.use(createRequestIdMiddleware())` — this works
+ * identically on the Express and Fastify HTTP adapters, since `app.use()`
+ * exposes plain Node request/response objects to global middleware on both.
+ *
+ * @publicApi
+ */
+export function createRequestIdMiddleware(
+  options: RequestIdMiddlewareOptions = {},
+) {
+  const header = (options.header ?? 'x-request-id').toLowerCase();
+  const generateId = options.generateId ?? randomUUID;
+
+  return function requestIdMiddleware(
+    req: { headers: Record<string, unknown> },
+    res: { setHeader: (name: string, value: string) => void },
+    next: (error?: any) => void,
+  ) {
+    const id = extractIncomingId(req.headers[header]) ?? generateId();
+    res.setHeader(header, id);
+    RequestIdStorage.run(id, next);
+  };
+}
diff --git a/packages/core/middleware/request-id.storage.ts b/packages/core/middleware/request-id.storage.ts
new file mode 100644
index 0000000..d8996f9
--- /dev/null
+++ b/packages/core/middleware/request-id.storage.ts
@@ -0,0 +1,21 @@
+import { AsyncLocalStorage } from 'async_hooks';
+
+/**
+ * Propagates the current request's correlation/request ID through the
+ * async call chain (middleware, guards, interceptors, route handlers), so
+ * that application code can read it without access to the request or
+ * response object.
+ *
+ * @publicApi
+ */
+export class RequestIdStorage {
+  private static readonly storage = new AsyncLocalStorage<string>();
+
+  static run<T>(id: string, callback: () => T): T {
+    return this.storage.run(id, callback);
+  }
+
+  static get id(): string | undefined {
+    return this.storage.getStore();
+  }
+}
