+import { NestExpressApplication } from '@nestjs/platform-express';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../src/app.module.js';
+import { REQUEST_ID_HEADER } from '../src/request-id.middleware.js';
+
+const UUID_PATTERN =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+describe('Express Request ID', () => {
+  let app: NestExpressApplication;
+
+  beforeAll(async () => {
+    const module = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = module.createNestApplication<NestExpressApplication>();
+    await app.init();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('generates a request ID and returns it on the response header when the caller sends none', async () => {
+    const response = await request(app.getHttpServer()).get('/').expect(200);
+
+    const headerId = response.headers[REQUEST_ID_HEADER];
+    expect(headerId).toMatch(UUID_PATTERN);
+    expect(response.body.id).toBe(headerId);
+  });
+
+  it('reuses the caller-provided request ID instead of generating a new one', async () => {
+    const incomingId = 'caller-supplied-id-123';
+
+    const response = await request(app.getHttpServer())
+      .get('/')
+      .set(REQUEST_ID_HEADER, incomingId)
+      .expect(200);
+
+    expect(response.headers[REQUEST_ID_HEADER]).toBe(incomingId);
+    expect(response.body.id).toBe(incomingId);
+  });
+
+  it('keeps the request ID available to application code across async work', async () => {
+    const incomingId = 'caller-supplied-async-id';
+
+    const response = await request(app.getHttpServer())
+      .get('/async')
+      .set(REQUEST_ID_HEADER, incomingId)
+      .expect(200);
+
+    expect(response.headers[REQUEST_ID_HEADER]).toBe(incomingId);
+    expect(response.body.id).toBe(incomingId);
+  });
+
+  it('assigns a different generated ID per request', async () => {
+    const [first, second] = await Promise.all([
+      request(app.getHttpServer()).get('/'),
+      request(app.getHttpServer()).get('/'),
+    ]);
+
+    expect(first.headers[REQUEST_ID_HEADER]).not.toBe(
+      second.headers[REQUEST_ID_HEADER],
+    );
+  });
+});
