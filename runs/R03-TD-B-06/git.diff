+++ b/integration/request-id/src/request-id.middleware.ts
@@ -0,0 +1,28 @@
+import { Injectable, NestMiddleware } from '@nestjs/common';
+import { randomUUID } from 'node:crypto';
+import { requestIdStore } from './request-id.store.js';
+
+export const REQUEST_ID_HEADER = 'x-request-id';
+
+/**
+ * Reuses the caller's correlation ID (if one was forwarded on the incoming
+ * request) or generates a new one, echoes it back on the response, and
+ * makes it available to the rest of the request's handling via
+ * `requestIdStore`.
+ *
+ * Node normalizes incoming header names to lower-case and gives Express and
+ * Fastify's middleware layer the same raw `http.IncomingMessage` /
+ * `http.ServerResponse` objects, so this class needs no adapter-specific
+ * branching to behave identically on both.
+ */
+@Injectable()
+export class RequestIdMiddleware implements NestMiddleware {
+  use(req: any, res: any, next: (error?: any) => void) {
+    const incoming = req.headers[REQUEST_ID_HEADER];
+    const id =
+      (Array.isArray(incoming) ? incoming[0] : incoming) || randomUUID();
+
+    res.setHeader(REQUEST_ID_HEADER, id);
+    requestIdStore.run(id, () => next());
+  }
+}
diff --git a/integration/request-id/src/request-id.store.ts b/integration/request-id/src/request-id.store.ts
new file mode 100644
index 0000000..7b763bf
--- /dev/null
+++ b/integration/request-id/src/request-id.store.ts
@@ -0,0 +1,21 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+
+/**
+ * Propagates the current request's correlation ID through async context so
+ * that application code (controllers, services, interceptors, ...) can read
+ * the exact same ID that was written to the response header — regardless of
+ * which HTTP adapter (Express or Fastify) is handling the request.
+ */
+class RequestIdStore {
+  private readonly storage = new AsyncLocalStorage<string>();
+
+  run<T>(id: string, callback: () => T): T {
+    return this.storage.run(id, callback);
+  }
+
+  getId(): string | undefined {
+    return this.storage.getStore();
+  }
+}
+
+export const requestIdStore = new RequestIdStore();
