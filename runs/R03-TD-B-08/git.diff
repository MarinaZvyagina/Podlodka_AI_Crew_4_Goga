+import {
+  getRequestId,
+  RequestIdStorage,
+} from '../../request-id/request-id-storage.js';
+
+describe('RequestIdStorage', () => {
+  it('should return undefined outside of a run() context', () => {
+    expect(RequestIdStorage.getStore()).toBeUndefined();
+    expect(RequestIdStorage.getRequestId()).toBeUndefined();
+    expect(getRequestId()).toBeUndefined();
+  });
+
+  it('should expose the store for the duration of the callback', () => {
+    RequestIdStorage.run({ requestId: 'abc-123' }, () => {
+      expect(RequestIdStorage.getStore()).toEqual({ requestId: 'abc-123' });
+      expect(RequestIdStorage.getRequestId()).toBe('abc-123');
+      expect(getRequestId()).toBe('abc-123');
+    });
+
+    expect(RequestIdStorage.getRequestId()).toBeUndefined();
+  });
+
+  it('should keep the store available across async boundaries within run()', async () => {
+    await RequestIdStorage.run({ requestId: 'async-id' }, async () => {
+      await Promise.resolve();
+      await new Promise(resolve => setTimeout(resolve, 0));
+      expect(getRequestId()).toBe('async-id');
+    });
+
+    expect(getRequestId()).toBeUndefined();
+  });
+
+  it('should isolate concurrent, nested request contexts from one another', async () => {
+    const observedInner: Array<string | undefined> = [];
+
+    await Promise.all([
+      RequestIdStorage.run({ requestId: 'req-1' }, async () => {
+        await new Promise(resolve => setTimeout(resolve, 10));
+        observedInner.push(getRequestId());
+      }),
+      RequestIdStorage.run({ requestId: 'req-2' }, async () => {
+        await new Promise(resolve => setTimeout(resolve, 1));
+        observedInner.push(getRequestId());
+      }),
+    ]);
+
+    expect(observedInner.sort()).toEqual(['req-1', 'req-2']);
+  });
+
+  it('should return the value produced by the callback', () => {
+    const result = RequestIdStorage.run({ requestId: 'x' }, () => 42);
+    expect(result).toBe(42);
+  });
+});
diff --git a/packages/core/test/request-id/request-id.middleware.spec.ts b/packages/core/test/request-id/request-id.middleware.spec.ts
