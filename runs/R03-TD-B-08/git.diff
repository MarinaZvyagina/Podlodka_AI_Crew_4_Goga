+import { AsyncLocalStorage } from 'node:async_hooks';
+
+/**
+ * @publicApi
+ */
+export interface RequestIdStore {
+  requestId: string;
+}
+
+/**
+ * Propagates the correlation id of the request currently being handled to
+ * application code, via `AsyncLocalStorage` rather than the request object.
+ *
+ * Express and Fastify expose different request objects to route handlers
+ * than the one middleware runs against (on Fastify, middleware only ever
+ * sees the raw Node request, while `@Req()` resolves to the wrapped
+ * `FastifyRequest`), so a value stashed on the request by middleware isn't
+ * reachable the same way on both platforms. `AsyncLocalStorage` context
+ * propagates through the rest of the request lifecycle regardless of which
+ * request object a given adapter happens to hand to application code.
+ *
+ * @see [RequestIdMiddleware]
+ * @publicApi
+ */
+export class RequestIdStorage {
+  private static readonly storage = new AsyncLocalStorage<RequestIdStore>();
+
+  public static run<T>(store: RequestIdStore, callback: () => T): T {
+    return this.storage.run(store, callback);
+  }
+
+  public static getStore(): RequestIdStore | undefined {
+    return this.storage.getStore();
+  }
+
+  public static getRequestId(): string | undefined {
+    return this.storage.getStore()?.requestId;
+  }
+}
+
+/**
+ * Returns the correlation id of the request currently being handled.
+ *
+ * Returns `undefined` when called outside of a request handled by
+ * `RequestIdMiddleware` (e.g. the middleware wasn't applied to this route,
+ * or the call happens outside of the request lifecycle).
+ *
+ * @publicApi
+ */
+export function getRequestId(): string | undefined {
+  return RequestIdStorage.getRequestId();
+}
