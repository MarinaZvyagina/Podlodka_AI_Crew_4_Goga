+import { Controller, Get, Module } from '@nestjs/common';
+import { createRequestIdMiddleware, getRequestId } from '@nestjs/core';
+import {
+  FastifyAdapter,
+  NestFastifyApplication,
+} from '@nestjs/platform-fastify';
+import { Test } from '@nestjs/testing';
+
+@Controller()
+class RequestIdController {
+  @Get('request-id')
+  getId() {
+    return { requestId: getRequestId() };
+  }
+}
+
+@Module({
+  controllers: [RequestIdController],
+})
+class RequestIdModule {}
+
+describe('Request id (Fastify adapter)', () => {
+  let app: NestFastifyApplication;
+
+  beforeEach(async () => {
+    app = (
+      await Test.createTestingModule({
+        imports: [RequestIdModule],
+      }).compile()
+    ).createNestApplication<NestFastifyApplication>(new FastifyAdapter());
+
+    app.use(createRequestIdMiddleware());
+    await app.init();
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  it('generates and returns an id when the caller sends none', async () => {
+    const response = await app.inject({
+      method: 'GET',
+      url: '/request-id',
+    });
+
+    expect(response.statusCode).toBe(200);
+    const headerValue = response.headers['x-request-id'];
+    expect(headerValue).toBeTruthy();
+    expect(JSON.parse(response.payload).requestId).toBe(headerValue);
+  });
+
+  it('reuses the id sent by the caller instead of generating a new one', async () => {
+    const response = await app.inject({
+      method: 'GET',
+      url: '/request-id',
+      headers: { 'x-request-id': 'caller-supplied-id' },
+    });
+
+    expect(response.statusCode).toBe(200);
+    expect(response.headers['x-request-id']).toBe('caller-supplied-id');
+    expect(JSON.parse(response.payload).requestId).toBe('caller-supplied-id');
+  });
+
+  it('assigns a distinct id to each request', async () => {
+    const [first, second] = await Promise.all([
+      app.inject({ method: 'GET', url: '/request-id' }),
+      app.inject({ method: 'GET', url: '/request-id' }),
+    ]);
+
+    expect(first.headers['x-request-id']).not.toBe(
+      second.headers['x-request-id'],
+    );
+  });
+});
