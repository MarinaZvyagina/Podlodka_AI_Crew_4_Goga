+import type { IncomingMessage, ServerResponse } from 'node:http';
+import { randomUUID } from 'node:crypto';
+import { Injectable } from '@nestjs/common';
+import type { NestMiddleware } from '@nestjs/common';
+import { X_REQUEST_ID_HEADER } from './request-id.constants.js';
+import { RequestIdStorage } from './request-id-storage.js';
+
+/**
+ * @publicApi
+ */
+export interface RequestIdMiddlewareOptions {
+  /**
+   * Name of the header to read an inbound request id from, and to write
+   * the resolved request id to on the response. Matched case-insensitively,
+   * as HTTP headers are.
+   *
+   * @default 'x-request-id'
+   */
+  header?: string;
+
+  /**
+   * Invoked to generate a request id when the inbound request didn't carry
+   * one (or carried a blank value).
+   *
+   * @default randomUUID
+   */
+  generateId?: () => string;
+}
+
+function readInboundId(
+  req: IncomingMessage,
+  header: string,
+): string | undefined {
+  const value = req.headers[header];
+  const raw = Array.isArray(value) ? value[0] : value;
+  const trimmed = raw?.trim();
+  return trimmed || undefined;
+}
+
+/**
+ * Builds a connect-style `(req, res, next)` middleware function that
+ * resolves a correlation id for the current request - reusing the inbound
+ * request id header when the caller already sent one, generating a new one
+ * otherwise - writes it to the response header, and exposes it to the rest
+ * of the request via `getRequestId()`.
+ *
+ * The returned function has the plain middleware signature that both
+ * `@nestjs/platform-express` and `@nestjs/platform-fastify` accept via
+ * `app.use(...)` or `MiddlewareConsumer#apply(...)`, so the same middleware
+ * instance produces identical behavior - and application code reading the
+ * id back via `getRequestId()` needs no adapter-specific handling - on
+ * either platform.
+ *
+ * @publicApi
+ */
+export function createRequestIdMiddleware(
+  options: RequestIdMiddlewareOptions = {},
+) {
+  const header = (options.header ?? X_REQUEST_ID_HEADER).toLowerCase();
+  const generateId = options.generateId ?? randomUUID;
+
+  return function requestIdMiddleware(
+    req: IncomingMessage,
+    res: ServerResponse,
+    next: (err?: unknown) => void,
+  ) {
+    const requestId = readInboundId(req, header) ?? generateId();
+
+    res.setHeader(header, requestId);
+
+    RequestIdStorage.run({ requestId }, next);
+  };
+}
+
+/**
+ * `NestMiddleware` wrapper around `createRequestIdMiddleware()`, for
+ * applications that wire middleware up through
+ * `MiddlewareConsumer#apply(RequestIdMiddleware).forRoutes(...)` rather
+ * than a plain `app.use(...)` call. Behaves identically to
+ * `createRequestIdMiddleware()` with default options on both the Express
+ * and Fastify adapters.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class RequestIdMiddleware implements NestMiddleware {
+  private readonly handler = createRequestIdMiddleware();
+
+  use(
+    req: IncomingMessage,
+    res: ServerResponse,
+    next: (err?: unknown) => void,
+  ) {
+    this.handler(req, res, next);
+  }
+}
