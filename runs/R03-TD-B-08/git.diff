@@ -0,0 +1,139 @@
+import {
+  createRequestIdMiddleware,
+  RequestIdMiddleware,
+} from '../../request-id/request-id.middleware.js';
+import { getRequestId } from '../../request-id/request-id-storage.js';
+
+function createReq(headers: Record<string, string | string[]> = {}) {
+  return { headers } as any;
+}
+
+function createRes() {
+  const headers: Record<string, string> = {};
+  return {
+    headers,
+    setHeader(name: string, value: string) {
+      headers[name.toLowerCase()] = value;
+    },
+    getHeader(name: string) {
+      return headers[name.toLowerCase()];
+    },
+  } as any;
+}
+
+describe('createRequestIdMiddleware', () => {
+  it('should generate a request id when none was sent by the caller', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = createReq();
+    const res = createRes();
+    const next = vi.fn();
+
+    middleware(req, res, next);
+
+    expect(next).toHaveBeenCalledTimes(1);
+    expect(res.getHeader('x-request-id')).toEqual(expect.any(String));
+    expect(res.getHeader('x-request-id')).not.toBe('');
+  });
+
+  it('should reuse the inbound x-request-id header instead of generating a new one', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = createReq({ 'x-request-id': 'caller-supplied-id' });
+    const res = createRes();
+
+    middleware(req, res, () => {});
+
+    expect(res.getHeader('x-request-id')).toBe('caller-supplied-id');
+  });
+
+  it('should take the first value when the inbound header is duplicated', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = createReq({ 'x-request-id': ['first-id', 'second-id'] });
+    const res = createRes();
+
+    middleware(req, res, () => {});
+
+    expect(res.getHeader('x-request-id')).toBe('first-id');
+  });
+
+  it('should generate a new id when the inbound header is blank', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = createReq({ 'x-request-id': '   ' });
+    const res = createRes();
+
+    middleware(req, res, () => {});
+
+    expect(res.getHeader('x-request-id')).not.toBe('   ');
+    expect(res.getHeader('x-request-id')).toBeTruthy();
+  });
+
+  it('should support a custom header name', () => {
+    const middleware = createRequestIdMiddleware({
+      header: 'X-Correlation-Id',
+    });
+    const req = createReq({ 'x-correlation-id': 'incoming-id' });
+    const res = createRes();
+
+    middleware(req, res, () => {});
+
+    expect(res.getHeader('x-correlation-id')).toBe('incoming-id');
+    expect(res.getHeader('x-request-id')).toBeUndefined();
+  });
+
+  it('should support a custom id generator', () => {
+    const middleware = createRequestIdMiddleware({
+      generateId: () => 'static-generated-id',
+    });
+    const req = createReq();
+    const res = createRes();
+
+    middleware(req, res, () => {});
+
+    expect(res.getHeader('x-request-id')).toBe('static-generated-id');
+  });
+
+  it('should make the resolved id available via getRequestId() while next() runs', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = createReq({ 'x-request-id': 'traced-id' });
+    const res = createRes();
+    let observed: string | undefined;
+
+    middleware(req, res, () => {
+      observed = getRequestId();
+    });
+
+    expect(observed).toBe('traced-id');
+    expect(getRequestId()).toBeUndefined();
+  });
+
+  it('should keep the id available across an asynchronous next()', async () => {
+    const middleware = createRequestIdMiddleware();
+    const req = createReq({ 'x-request-id': 'async-traced-id' });
+    const res = createRes();
+    let observed: string | undefined;
+
+    await new Promise<void>(resolve => {
+      middleware(req, res, () => {
+        setTimeout(() => {
+          observed = getRequestId();
+          resolve();
+        }, 0);
+      });
+    });
+
+    expect(observed).toBe('async-traced-id');
+  });
+});
+
+describe('RequestIdMiddleware', () => {
+  it('should behave like createRequestIdMiddleware() with default options', () => {
+    const middleware = new RequestIdMiddleware();
+    const req = createReq({ 'x-request-id': 'from-class' });
+    const res = createRes();
+    const next = vi.fn();
+
+    middleware.use(req, res, next);
+
+    expect(next).toHaveBeenCalledTimes(1);
+    expect(res.getHeader('x-request-id')).toBe('from-class');
+  });
+});
