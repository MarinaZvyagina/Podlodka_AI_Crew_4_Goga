diff --git a/packages/core/test/middleware/request-id.spec.ts b/packages/core/test/middleware/request-id.spec.ts
new file mode 100644
index 0000000..53eb4df
--- /dev/null
+++ b/packages/core/test/middleware/request-id.spec.ts
@@ -0,0 +1,96 @@
+import { getRequestId } from '../../middleware/request-id/get-request-id.js';
+import { createRequestIdMiddleware } from '../../middleware/request-id/request-id.middleware.js';
+
+describe('Request id middleware', () => {
+  const runMiddleware = (
+    middleware: (req: any, res: any, next: () => void) => void,
+    req: any,
+  ) => {
+    const res = { setHeader: vi.fn() };
+    let capturedId: string | undefined;
+    middleware(req, res, () => {
+      capturedId = getRequestId();
+    });
+    return { res, capturedId };
+  };
+
+  it('should generate a new id and expose it on the response header when none is provided', () => {
+    const middleware = createRequestIdMiddleware();
+    const { res, capturedId } = runMiddleware(middleware, { headers: {} });
+
+    expect(res.setHeader).toHaveBeenCalledExactlyOnceWith(
+      'x-request-id',
+      expect.any(String),
+    );
+    const [, generatedId] = res.setHeader.mock.calls[0];
+    expect(capturedId).toBe(generatedId);
+  });
+
+  it('should reuse the incoming request id instead of generating a new one', () => {
+    const middleware = createRequestIdMiddleware();
+    const { res, capturedId } = runMiddleware(middleware, {
+      headers: { 'x-request-id': 'incoming-id' },
+    });
+
+    expect(res.setHeader).toHaveBeenCalledExactlyOnceWith(
+      'x-request-id',
+      'incoming-id',
+    );
+    expect(capturedId).toBe('incoming-id');
+  });
+
+  it('should use the first value when the incoming header is duplicated', () => {
+    const middleware = createRequestIdMiddleware();
+    const { res } = runMiddleware(middleware, {
+      headers: { 'x-request-id': ['first-id', 'second-id'] },
+    });
+
+    expect(res.setHeader).toHaveBeenCalledExactlyOnceWith(
+      'x-request-id',
+      'first-id',
+    );
+  });
+
+  it('should support a custom header name and generator', () => {
+    const middleware = createRequestIdMiddleware({
+      header: 'X-Trace-Id',
+      generator: () => 'custom-id',
+    });
+    const { res, capturedId } = runMiddleware(middleware, { headers: {} });
+
+    expect(res.setHeader).toHaveBeenCalledExactlyOnceWith(
+      'x-trace-id',
+      'custom-id',
+    );
+    expect(capturedId).toBe('custom-id');
+  });
+
+  it('should not leak the request id outside of the middleware execution context', () => {
+    const middleware = createRequestIdMiddleware();
+    runMiddleware(middleware, { headers: { 'x-request-id': 'leak-check' } });
+
+    expect(getRequestId()).toBeUndefined();
+  });
+
+  it('should isolate concurrent requests from one another', async () => {
+    const middleware = createRequestIdMiddleware();
+    const observe = (id: string) =>
+      new Promise<string | undefined>(resolve => {
+        middleware(
+          { headers: { 'x-request-id': id } },
+          { setHeader: vi.fn() },
+          () => {
+            setImmediate(() => resolve(getRequestId()));
+          },
+        );
+      });
+
+    const [first, second] = await Promise.all([
+      observe('request-a'),
+      observe('request-b'),
+    ]);
+
+    expect(first).toBe('request-a');
+    expect(second).toBe('request-b');
+  });
+});
