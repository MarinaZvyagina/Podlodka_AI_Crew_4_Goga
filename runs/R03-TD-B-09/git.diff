+import {
+  FastifyAdapter,
+  NestFastifyApplication,
+} from '@nestjs/platform-fastify';
+import { Test } from '@nestjs/testing';
+import { AppModule } from '../src/app.module.js';
+
+describe('Fastify Request Id', () => {
+  let app: NestFastifyApplication;
+
+  describe('enableRequestId', () => {
+    beforeAll(async () => {
+      const module = await Test.createTestingModule({
+        imports: [AppModule],
+      }).compile();
+
+      app = module.createNestApplication<NestFastifyApplication>(
+        new FastifyAdapter(),
+      );
+      app.enableRequestId();
+
+      await app.init();
+      await app.getHttpAdapter().getInstance().ready();
+    });
+
+    afterAll(async () => {
+      await app.close();
+    });
+
+    it('should generate a request id and return it in the response header', async () => {
+      const response = await app.inject({ method: 'GET', url: '/' });
+
+      expect(response.statusCode).toBe(200);
+      const headerId = response.headers['x-request-id'] as string;
+      expect(headerId).toEqual(expect.any(String));
+      expect(headerId.length).toBeGreaterThan(0);
+      expect(JSON.parse(response.payload).requestId).toBe(headerId);
+    });
+
+    it('should reuse an incoming request id instead of generating a new one', async () => {
+      const response = await app.inject({
+        method: 'GET',
+        url: '/',
+        headers: { 'x-request-id': 'incoming-request-id' },
+      });
+
+      expect(response.headers['x-request-id']).toBe('incoming-request-id');
+      expect(JSON.parse(response.payload).requestId).toBe(
+        'incoming-request-id',
+      );
+    });
+
+    it('should generate a distinct id per request', async () => {
+      const first = await app.inject({ method: 'GET', url: '/' });
+      const second = await app.inject({ method: 'GET', url: '/' });
+
+      expect(first.headers['x-request-id']).not.toBe(
+        second.headers['x-request-id'],
+      );
+    });
+
+    it('should include the header even on a 404 response', async () => {
+      const response = await app.inject({
+        method: 'GET',
+        url: '/does-not-exist',
+      });
+
+      expect(response.statusCode).toBe(404);
+      expect(response.headers['x-request-id']).toEqual(expect.any(String));
+    });
+  });
+
+  describe('Application Options', () => {
+    beforeAll(async () => {
+      const module = await Test.createTestingModule({
+        imports: [AppModule],
+      }).compile();
+
+      app = module.createNestApplication<NestFastifyApplication>(
+        new FastifyAdapter(),
+        { requestId: { header: 'x-correlation-id' } },
+      );
+
+      await app.init();
+      await app.getHttpAdapter().getInstance().ready();
+    });
+
+    afterAll(async () => {
+      await app.close();
+    });
+
+    it('should honor a custom header name', async () => {
+      const response = await app.inject({
+        method: 'GET',
+        url: '/',
+        headers: { 'x-correlation-id': 'from-caller' },
+      });
+
+      expect(response.headers['x-correlation-id']).toBe('from-caller');
+      expect(JSON.parse(response.payload).requestId).toBe('from-caller');
+    });
+  });
+});
