@@ -0,0 +1,22 @@
+import { AsyncLocalStorage } from 'async_hooks';
+
+export interface RequestIdStore {
+  requestId: string;
+}
+
+const storage = new AsyncLocalStorage<RequestIdStore>();
+
+/**
+ * Holds the request id of the HTTP request currently being handled so that
+ * it can be retrieved from anywhere in the call stack via `getRequestId()`,
+ * without threading it through function parameters or relying on
+ * request-scoped providers.
+ */
+export const RequestIdStorage = {
+  run<T>(store: RequestIdStore, callback: () => T): T {
+    return storage.run(store, callback);
+  },
+  getStore(): RequestIdStore | undefined {
+    return storage.getStore();
+  },
+};
