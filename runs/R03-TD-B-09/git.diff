+import { NestExpressApplication } from '@nestjs/platform-express';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../src/app.module.js';
+
+describe('Express Request Id', () => {
+  let app: NestExpressApplication;
+
+  describe('enableRequestId', () => {
+    beforeAll(async () => {
+      const module = await Test.createTestingModule({
+        imports: [AppModule],
+      }).compile();
+
+      app = module.createNestApplication<NestExpressApplication>();
+      app.enableRequestId();
+
+      await app.init();
+    });
+
+    afterAll(async () => {
+      await app.close();
+    });
+
+    it('should generate a request id and return it in the response header', async () => {
+      const response = await request(app.getHttpServer()).get('/').expect(200);
+
+      const headerId = response.headers['x-request-id'];
+      expect(headerId).toEqual(expect.any(String));
+      expect(headerId.length).toBeGreaterThan(0);
+      expect(response.body.requestId).toBe(headerId);
+    });
+
+    it('should reuse an incoming request id instead of generating a new one', async () => {
+      const response = await request(app.getHttpServer())
+        .get('/')
+        .set('x-request-id', 'incoming-request-id')
+        .expect(200)
+        .expect('x-request-id', 'incoming-request-id');
+
+      expect(response.body.requestId).toBe('incoming-request-id');
+    });
+
+    it('should generate a distinct id per request', async () => {
+      const first = await request(app.getHttpServer()).get('/').expect(200);
+      const second = await request(app.getHttpServer()).get('/').expect(200);
+
+      expect(first.headers['x-request-id']).not.toBe(
+        second.headers['x-request-id'],
+      );
+    });
+
+    it('should include the header even on a 404 response', async () => {
+      const response = await request(app.getHttpServer())
+        .get('/does-not-exist')
+        .expect(404);
+
+      expect(response.headers['x-request-id']).toEqual(expect.any(String));
+    });
+  });
+
+  describe('Application Options', () => {
+    beforeAll(async () => {
+      const module = await Test.createTestingModule({
+        imports: [AppModule],
+      }).compile();
+
+      app = module.createNestApplication<NestExpressApplication>({
+        requestId: { header: 'x-correlation-id' },
+      });
+
+      await app.init();
+    });
+
+    afterAll(async () => {
+      await app.close();
+    });
+
+    it('should honor a custom header name', async () => {
+      const response = await request(app.getHttpServer())
+        .get('/')
+        .set('x-correlation-id', 'from-caller')
+        .expect(200)
+        .expect('x-correlation-id', 'from-caller');
+
+      expect(response.body.requestId).toBe('from-caller');
+    });
+  });
+});
