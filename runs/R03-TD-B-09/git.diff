@@ -0,0 +1,16 @@
+import { RequestIdStorage } from './request-id-storage.js';
+
+/**
+ * Returns the request id of the HTTP request currently being handled — the
+ * same value returned on the response header once `enableRequestId()` (or
+ * the `requestId` application option) is turned on. Works identically
+ * regardless of the underlying HTTP adapter (Express or Fastify).
+ *
+ * Returns `undefined` when called outside of a request's execution context,
+ * or when request id propagation has not been enabled.
+ *
+ * @publicApi
+ */
+export function getRequestId(): string | undefined {
+  return RequestIdStorage.getStore()?.requestId;
+}
