+import type { RequestIdOptions } from '@nestjs/common';
+import { randomUUID } from 'crypto';
+import { RequestIdStorage } from './request-id-storage.js';
+
+const DEFAULT_REQUEST_ID_HEADER = 'x-request-id';
+
+interface RawIncomingMessage {
+  headers?: Record<string, string | string[] | undefined>;
+}
+
+interface RawServerResponse {
+  setHeader(name: string, value: string): unknown;
+}
+
+/**
+ * Builds a connect-style `(req, res, next)` middleware that reuses (or
+ * generates) a request id, exposes it on the response header, and makes it
+ * available for the remainder of the request via `getRequestId()`.
+ *
+ * Operates on the raw Node request/response objects only (plain `headers`
+ * lookup, native `setHeader`), which both the Express and the Fastify
+ * (via `@fastify/middie`) adapters hand to middleware registered through
+ * `app.use()` — so the exact same function works, unmodified, on either.
+ */
+export function createRequestIdMiddleware(options: RequestIdOptions = {}) {
+  const header = (options.header ?? DEFAULT_REQUEST_ID_HEADER).toLowerCase();
+  const generator = options.generator ?? randomUUID;
+
+  return function requestIdMiddleware(
+    req: RawIncomingMessage,
+    res: RawServerResponse,
+    next: () => void,
+  ): void {
+    const incoming = req.headers?.[header];
+    const incomingValue = Array.isArray(incoming) ? incoming[0] : incoming;
+    const requestId = incomingValue || generator();
+
+    res.setHeader(header, requestId);
+
+    RequestIdStorage.run({ requestId }, next);
+  };
+}
