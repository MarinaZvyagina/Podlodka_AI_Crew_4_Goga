+export const DEFAULT_REQUEST_ID_HEADER = 'x-request-id';
+
+/**
+ * Incoming header values are only trusted (and echoed back) when they match
+ * this shape; anything else is treated as absent and a fresh id is
+ * generated instead, e.g. to avoid propagating empty or malformed values.
+ */
+export const REQUEST_ID_PATTERN = /^[\w-]{1,200}$/;
