+import { createRequestIdHook } from '../../request-id/request-id-hook.js';
+import { getRequestId } from '../../request-id/request-id-storage.js';
+
+describe('createRequestIdHook', () => {
+  const createHttpAdapter = () => ({
+    setHeader: vi.fn(),
+  });
+
+  it('should generate an id when the request has none, and set it on the response header', () => {
+    const httpAdapter = createHttpAdapter();
+    const hook = createRequestIdHook(httpAdapter as any, {
+      generateId: () => 'generated-id',
+    });
+    const next = vi.fn();
+
+    hook({ headers: {} }, {}, next);
+
+    expect(httpAdapter.setHeader).toHaveBeenCalledWith(
+      {},
+      'x-request-id',
+      'generated-id',
+    );
+    expect(next).toHaveBeenCalledTimes(1);
+  });
+
+  it('should reuse a valid id already present on the request header', () => {
+    const httpAdapter = createHttpAdapter();
+    const generateId = vi.fn(() => 'should-not-be-used');
+    const hook = createRequestIdHook(httpAdapter as any, { generateId });
+    const response = {};
+
+    hook({ headers: { 'x-request-id': 'caller-id' } }, response, vi.fn());
+
+    expect(httpAdapter.setHeader).toHaveBeenCalledWith(
+      response,
+      'x-request-id',
+      'caller-id',
+    );
+    expect(generateId).not.toHaveBeenCalled();
+  });
+
+  it('should read the incoming header case-insensitively via the lower-cased key', () => {
+    const httpAdapter = createHttpAdapter();
+    const hook = createRequestIdHook(httpAdapter as any, {
+      header: 'X-Correlation-Id',
+    });
+
+    hook({ headers: { 'x-correlation-id': 'caller-id' } }, {}, vi.fn());
+
+    expect(httpAdapter.setHeader).toHaveBeenCalledWith(
+      {},
+      'x-correlation-id',
+      'caller-id',
+    );
+  });
+
+  it('should ignore a malformed incoming value and generate a fresh id instead', () => {
+    const httpAdapter = createHttpAdapter();
+    const hook = createRequestIdHook(httpAdapter as any, {
+      generateId: () => 'generated-id',
+    });
+
+    hook(
+      { headers: { 'x-request-id': 'not valid\r\ninjected' } },
+      {},
+      vi.fn(),
+    );
+
+    expect(httpAdapter.setHeader).toHaveBeenCalledWith(
+      {},
+      'x-request-id',
+      'generated-id',
+    );
+  });
+
+  it('should use the first value when the incoming header was sent multiple times', () => {
+    const httpAdapter = createHttpAdapter();
+    const hook = createRequestIdHook(httpAdapter as any);
+
+    hook(
+      { headers: { 'x-request-id': ['first-id', 'second-id'] } },
+      {},
+      vi.fn(),
+    );
+
+    expect(httpAdapter.setHeader).toHaveBeenCalledWith(
+      {},
+      'x-request-id',
+      'first-id',
+    );
+  });
+
+  it('should use crypto.randomUUID by default when no generator is supplied', () => {
+    const httpAdapter = createHttpAdapter();
+    const hook = createRequestIdHook(httpAdapter as any);
+
+    hook({ headers: {} }, {}, vi.fn());
+
+    const [, , value] = httpAdapter.setHeader.mock.calls[0];
+    expect(value).toMatch(
+      /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/,
+    );
+  });
+
+  it('should bind the resolved id to the async context before invoking next()', () => {
+    const httpAdapter = createHttpAdapter();
+    const hook = createRequestIdHook(httpAdapter as any, {
+      generateId: () => 'generated-id',
+    });
+
+    let observed: string | undefined;
+    hook({ headers: {} }, {}, () => {
+      observed = getRequestId();
+    });
+
+    expect(observed).toEqual('generated-id');
+    expect(getRequestId()).toBeUndefined();
+  });
+});
