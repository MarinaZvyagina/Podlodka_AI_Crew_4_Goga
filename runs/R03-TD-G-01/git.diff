@@ -0,0 +1,43 @@
+import type { RequestIdOptions } from '@nestjs/common/internal';
+import { randomUUID } from 'crypto';
+import type { AbstractHttpAdapter } from '../adapters/index.js';
+import {
+  DEFAULT_REQUEST_ID_HEADER,
+  REQUEST_ID_PATTERN,
+} from './request-id.constants.js';
+import { RequestIdStorage } from './request-id-storage.js';
+
+function isValidRequestId(value: unknown): value is string {
+  return typeof value === 'string' && REQUEST_ID_PATTERN.test(value);
+}
+
+/**
+ * Builds an `onRequest` hook (see `AbstractHttpAdapter#setOnRequestHook`)
+ * that resolves the id for the incoming request, echoes it back on the
+ * response header, and binds it to the request's async context so
+ * `getRequestId()` resolves to the same value anywhere the request is
+ * handled. The hook is written purely against the platform-agnostic
+ * `httpAdapter` surface, so it behaves identically on every HTTP adapter.
+ */
+export function createRequestIdHook(
+  httpAdapter: AbstractHttpAdapter,
+  options: RequestIdOptions = {},
+) {
+  const header = (options.header ?? DEFAULT_REQUEST_ID_HEADER).toLowerCase();
+  const generateId = options.generateId ?? randomUUID;
+
+  return function requestIdHook(
+    request: any,
+    response: any,
+    next: (err?: Error) => void,
+  ) {
+    const incomingValue = request?.headers?.[header];
+    const candidate = Array.isArray(incomingValue)
+      ? incomingValue[0]
+      : incomingValue;
+    const requestId = isValidRequestId(candidate) ? candidate : generateId();
+
+    httpAdapter.setHeader(response, header, requestId);
+    RequestIdStorage.run(requestId, () => next());
+  };
+}
diff --git a/packages/core/request-id/request-id-storage.ts b/packages/core/request-id/request-id-storage.ts
new file mode 100644
index 0000000..31a171b
--- /dev/null
+++ b/packages/core/request-id/request-id-storage.ts
@@ -0,0 +1,31 @@
+import { AsyncLocalStorage } from 'async_hooks';
+
+/**
+ * Propagates the id of the request currently being handled to any code
+ * running within that request's async context, regardless of which HTTP
+ * adapter (Express, Fastify, ...) received it.
+ *
+ * @publicApi
+ */
+export class RequestIdStorage {
+  private static readonly storage = new AsyncLocalStorage<string>();
+
+  public static run<T>(requestId: string, callback: () => T): T {
+    return this.storage.run(requestId, callback);
+  }
+
+  public static get(): string | undefined {
+    return this.storage.getStore();
+  }
+}
+
+/**
+ * Returns the id of the request currently being handled, or `undefined`
+ * when called outside of a request initiated after `enableRequestId()` was
+ * set up, or before the id has been assigned.
+ *
+ * @publicApi
+ */
+export function getRequestId(): string | undefined {
+  return RequestIdStorage.get();
+}
