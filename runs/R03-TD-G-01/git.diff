+/**
+ * Interface describing options that can be passed to `enableRequestId()`.
+ *
+ * @publicApi
+ */
+export interface RequestIdOptions {
+  /**
+   * Name of the HTTP header used to read an already-assigned request id from
+   * an incoming request, and to write the resolved id on the outgoing
+   * response. Matched case-insensitively.
+   * @default 'x-request-id'
+   */
+  header?: string;
+  /**
+   * Factory invoked to generate a new request id whenever the incoming
+   * request does not already carry one on the configured header.
+   * @default crypto.randomUUID
+   */
+  generateId?: () => string;
+}
