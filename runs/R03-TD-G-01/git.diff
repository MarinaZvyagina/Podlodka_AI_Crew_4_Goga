+import { getRequestId, RequestIdStorage } from '../../request-id/index.js';
+
+describe('RequestIdStorage', () => {
+  it('should return undefined outside of a run() context', () => {
+    expect(RequestIdStorage.get()).toBeUndefined();
+    expect(getRequestId()).toBeUndefined();
+  });
+
+  it('should expose the id bound by run() for the duration of the callback', () => {
+    const result = RequestIdStorage.run('req-1', () => {
+      expect(RequestIdStorage.get()).toEqual('req-1');
+      expect(getRequestId()).toEqual('req-1');
+      return 'callback-result';
+    });
+
+    expect(result).toEqual('callback-result');
+    expect(RequestIdStorage.get()).toBeUndefined();
+  });
+
+  it('should propagate the id across an async continuation started inside run()', async () => {
+    const observed: Array<string | undefined> = [];
+
+    await RequestIdStorage.run('req-async', async () => {
+      await Promise.resolve();
+      observed.push(getRequestId());
+      await new Promise(resolve => setTimeout(resolve, 0));
+      observed.push(getRequestId());
+    });
+
+    expect(observed).toEqual(['req-async', 'req-async']);
+  });
+
+  it('should isolate concurrent run() contexts from each other', async () => {
+    const results = await Promise.all([
+      RequestIdStorage.run('req-a', async () => {
+        await new Promise(resolve => setTimeout(resolve, 5));
+        return getRequestId();
+      }),
+      RequestIdStorage.run('req-b', async () => {
+        return getRequestId();
+      }),
+    ]);
+
+    expect(results).toEqual(['req-a', 'req-b']);
+  });
+});
