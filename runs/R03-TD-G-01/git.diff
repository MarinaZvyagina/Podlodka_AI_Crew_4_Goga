@@ -0,0 +1,85 @@
+import { NestExpressApplication } from '@nestjs/platform-express';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../src/app.module.js';
+
+describe('Express Request Id', () => {
+  let app: NestExpressApplication;
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  describe('enableRequestId (default header)', () => {
+    beforeEach(async () => {
+      const module = await Test.createTestingModule({
+        imports: [AppModule],
+      }).compile();
+
+      app = module.createNestApplication<NestExpressApplication>();
+      app.enableRequestId();
+      await app.init();
+    });
+
+    it('generates an id and returns it on the "x-request-id" response header', async () => {
+      const response = await request(app.getHttpServer())
+        .get('/')
+        .expect(200);
+
+      const header = response.headers['x-request-id'];
+      expect(header).toBeDefined();
+      expect(header).toEqual(expect.any(String));
+      expect(header.length).toBeGreaterThan(0);
+    });
+
+    it('exposes the same id to application code that ends up on the response header', async () => {
+      const response = await request(app.getHttpServer())
+        .get('/')
+        .expect(200);
+
+      expect(response.body.requestId).toEqual(response.headers['x-request-id']);
+    });
+
+    it('reuses an incoming request id instead of generating a new one', async () => {
+      const response = await request(app.getHttpServer())
+        .get('/')
+        .set('x-request-id', 'caller-supplied-id')
+        .expect(200);
+
+      expect(response.headers['x-request-id']).toEqual('caller-supplied-id');
+      expect(response.body.requestId).toEqual('caller-supplied-id');
+    });
+
+    it('generates a different id for each request without an incoming id', async () => {
+      const first = await request(app.getHttpServer()).get('/').expect(200);
+      const second = await request(app.getHttpServer()).get('/').expect(200);
+
+      expect(first.headers['x-request-id']).not.toEqual(
+        second.headers['x-request-id'],
+      );
+    });
+  });
+
+  describe('enableRequestId (custom header)', () => {
+    beforeEach(async () => {
+      const module = await Test.createTestingModule({
+        imports: [AppModule],
+      }).compile();
+
+      app = module.createNestApplication<NestExpressApplication>();
+      app.enableRequestId({ header: 'x-correlation-id' });
+      await app.init();
+    });
+
+    it('reads and writes the configured header instead of the default one', async () => {
+      const response = await request(app.getHttpServer())
+        .get('/')
+        .set('x-correlation-id', 'from-caller')
+        .expect(200);
+
+      expect(response.headers['x-correlation-id']).toEqual('from-caller');
+      expect(response.headers['x-request-id']).toBeUndefined();
+      expect(response.body.requestId).toEqual('from-caller');
+    });
+  });
+});
