+import {
+  Controller,
+  Get,
+  MiddlewareConsumer,
+  Module,
+  NestModule,
+  RequestIdMiddleware,
+  RequestIdService,
+} from '@nestjs/common';
+import {
+  FastifyAdapter,
+  NestFastifyApplication,
+} from '@nestjs/platform-fastify';
+import { Test } from '@nestjs/testing';
+
+@Controller()
+class RequestIdTestController {
+  @Get('request-id')
+  get() {
+    return { requestId: RequestIdService.getId() };
+  }
+}
+
+@Module({
+  controllers: [RequestIdTestController],
+})
+class RequestIdTestModule implements NestModule {
+  configure(consumer: MiddlewareConsumer) {
+    consumer.apply(RequestIdMiddleware).forRoutes('*');
+  }
+}
+
+describe('Request id (FastifyAdapter)', () => {
+  let app: NestFastifyApplication;
+
+  beforeEach(async () => {
+    app = (
+      await Test.createTestingModule({
+        imports: [RequestIdTestModule],
+      }).compile()
+    ).createNestApplication<NestFastifyApplication>(new FastifyAdapter());
+
+    await app.init();
+    await app.getHttpAdapter().getInstance().ready();
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  it('should generate and return a request id header when none was sent', async () => {
+    const response = await app.inject({
+      method: 'GET',
+      url: '/request-id',
+    });
+
+    expect(response.statusCode).toEqual(200);
+    const headerValue = response.headers['x-request-id'];
+    expect(headerValue).toBeTruthy();
+    expect(JSON.parse(response.payload).requestId).toEqual(headerValue);
+  });
+
+  it('should reuse an incoming request id instead of generating a new one', async () => {
+    const response = await app.inject({
+      method: 'GET',
+      url: '/request-id',
+      headers: { 'x-request-id': 'upstream-service-id' },
+    });
+
+    expect(response.statusCode).toEqual(200);
+    expect(response.headers['x-request-id']).toEqual('upstream-service-id');
+    expect(JSON.parse(response.payload).requestId).toEqual(
+      'upstream-service-id',
+    );
+  });
+
+  it('should generate a distinct id per request', async () => {
+    const [first, second] = await Promise.all([
+      app.inject({ method: 'GET', url: '/request-id' }),
+      app.inject({ method: 'GET', url: '/request-id' }),
+    ]);
+
+    expect(first.headers['x-request-id']).not.toEqual(
+      second.headers['x-request-id'],
+    );
+  });
+});
