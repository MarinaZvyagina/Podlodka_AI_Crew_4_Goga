@@ -0,0 +1,66 @@
+import { RequestIdService } from '../../services/request-id.service.js';
+
+describe('RequestIdService', () => {
+  describe('when called outside of a request', () => {
+    it('should return undefined', () => {
+      expect(RequestIdService.getId()).toBeUndefined();
+      expect(new RequestIdService().getId()).toBeUndefined();
+    });
+  });
+
+  describe('when called from within a run()', () => {
+    it('should return the bound request id via the static API', () => {
+      RequestIdService.run('abc-123', () => {
+        expect(RequestIdService.getId()).toEqual('abc-123');
+      });
+    });
+
+    it('should return the bound request id via an instance', () => {
+      const service = new RequestIdService();
+      service.run('abc-123', () => {
+        expect(service.getId()).toEqual('abc-123');
+      });
+    });
+
+    it('should share state across independently constructed instances', () => {
+      const producer = new RequestIdService();
+      const consumer = new RequestIdService();
+
+      producer.run('shared-id', () => {
+        expect(consumer.getId()).toEqual('shared-id');
+        expect(RequestIdService.getId()).toEqual('shared-id');
+      });
+    });
+
+    it('should remain available across async continuations started within run()', async () => {
+      await RequestIdService.run('async-id', async () => {
+        await new Promise(resolve => setTimeout(resolve, 0));
+        expect(RequestIdService.getId()).toEqual('async-id');
+      });
+    });
+
+    it('should not leak the request id once run() has returned', () => {
+      RequestIdService.run('temporary-id', () => undefined);
+      expect(RequestIdService.getId()).toBeUndefined();
+    });
+
+    it('should isolate concurrent request ids from one another', async () => {
+      const observedInA: (string | undefined)[] = [];
+      const observedInB: (string | undefined)[] = [];
+
+      const runA = RequestIdService.run('id-a', async () => {
+        await new Promise(resolve => setTimeout(resolve, 10));
+        observedInA.push(RequestIdService.getId());
+      });
+      const runB = RequestIdService.run('id-b', async () => {
+        await new Promise(resolve => setTimeout(resolve, 0));
+        observedInB.push(RequestIdService.getId());
+      });
+
+      await Promise.all([runA, runB]);
+
+      expect(observedInA).toEqual(['id-a']);
+      expect(observedInB).toEqual(['id-b']);
+    });
+  });
+});
