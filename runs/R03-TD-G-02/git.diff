+import type { IncomingMessage, ServerResponse } from 'node:http';
+import { randomUUID } from 'node:crypto';
+import { Injectable } from '../decorators/core/injectable.decorator.js';
+import { NestMiddleware } from '../interfaces/middleware/nest-middleware.interface.js';
+import { RequestIdService } from '../services/request-id.service.js';
+
+/**
+ * Ensures every response carries a request/correlation id header, so that a
+ * single incoming request can be traced across logs - including across a
+ * chain of internal service calls that forward the same id.
+ *
+ * - If the incoming request already carries the header (e.g. it was
+ *   forwarded by an upstream internal service), that value is reused as-is.
+ * - Otherwise, a new id is generated.
+ *
+ * The resolved id is both set on the response header and made available to
+ * the rest of the request's lifecycle via `RequestIdService`, so application
+ * code can read it (for example, to include it in a log line) without
+ * parsing it back out of the response.
+ *
+ * Works identically regardless of which HTTP platform the application uses,
+ * since it only relies on the underlying request/response objects that both
+ * platforms expose to global middleware.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class RequestIdMiddleware implements NestMiddleware {
+  /**
+   * Name of the header read from the incoming request and written to the
+   * response. Override in a subclass to use a different header name.
+   */
+  protected readonly headerName: string = 'X-Request-Id';
+
+  /**
+   * Generates a new id when the incoming request doesn't already carry one.
+   * Override in a subclass to use a different id format.
+   */
+  protected generateId(): string {
+    return randomUUID();
+  }
+
+  use(
+    req: IncomingMessage,
+    res: ServerResponse,
+    next: (error?: any) => void,
+  ): void {
+    const incomingValue = req.headers[this.headerName.toLowerCase()];
+    const incomingId = Array.isArray(incomingValue)
+      ? incomingValue[0]
+      : incomingValue;
+    const requestId = incomingId || this.generateId();
+
+    res.setHeader(this.headerName, requestId);
+
+    RequestIdService.run(requestId, next);
+  }
+}
