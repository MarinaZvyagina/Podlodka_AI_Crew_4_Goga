@@ -0,0 +1,55 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+import { Injectable } from '../decorators/core/injectable.decorator.js';
+
+export interface RequestIdStore {
+  requestId: string;
+}
+
+/**
+ * Backing storage for the current request's id.
+ *
+ * Declared at module scope (rather than as an instance field) so that every
+ * `RequestIdService` instance - however it was constructed - reads and writes
+ * the same context, regardless of how many times the class is instantiated
+ * across an application or its dependency injection graph.
+ */
+const requestIdStorage = new AsyncLocalStorage<RequestIdStore>();
+
+/**
+ * Gives application code access to the id of the request currently being
+ * handled, without threading it through every function call or parsing it
+ * back out of the response.
+ *
+ * The value is populated by `RequestIdMiddleware` and is available for the
+ * full lifetime of the request (guards, interceptors, pipes, controllers,
+ * exception filters), on every HTTP platform Nest supports.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class RequestIdService {
+  /**
+   * Runs `callback` with `requestId` bound to the current async execution
+   * context, so that any code invoked from within it (synchronously or
+   * later, via promises/timers/etc.) can retrieve it with `getId`.
+   */
+  static run<T>(requestId: string, callback: () => T): T {
+    return requestIdStorage.run({ requestId }, callback);
+  }
+
+  /**
+   * Returns the id of the request currently being handled, or `undefined`
+   * when called outside of a request (e.g. during application bootstrap).
+   */
+  static getId(): string | undefined {
+    return requestIdStorage.getStore()?.requestId;
+  }
+
+  run<T>(requestId: string, callback: () => T): T {
+    return RequestIdService.run(requestId, callback);
+  }
+
+  getId(): string | undefined {
+    return RequestIdService.getId();
+  }
+}
diff --git a/packages/common/test/middleware/request-id.middleware.spec.ts b/packages/common/test/middleware/request-id.middleware.spec.ts
new file mode 100644
index 0000000..96f2f81
--- /dev/null
+++ b/packages/common/test/middleware/request-id.middleware.spec.ts
@@ -0,0 +1,112 @@
+import { RequestIdMiddleware } from '../../middleware/request-id.middleware.js';
+import { RequestIdService } from '../../services/request-id.service.js';
+
+function createMockReq(headers: Record<string, string | string[]> = {}) {
+  return { headers } as any;
+}
+
+function createMockRes() {
+  const headers: Record<string, string> = {};
+  return {
+    headers,
+    setHeader: vi.fn((name: string, value: string) => {
+      headers[name] = value;
+    }),
+    getHeader: (name: string) => headers[name],
+  } as any;
+}
+
+describe('RequestIdMiddleware', () => {
+  let middleware: RequestIdMiddleware;
+
+  beforeEach(() => {
+    middleware = new RequestIdMiddleware();
+  });
+
+  it('should generate a new id when the request has none, and set it on the response', () => {
+    const req = createMockReq();
+    const res = createMockRes();
+    const next = vi.fn();
+
+    middleware.use(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledOnce();
+    const [headerName, requestId] = res.setHeader.mock.calls[0];
+    expect(headerName).toEqual('X-Request-Id');
+    expect(requestId).toBeTypeOf('string');
+    expect(requestId.length).toBeGreaterThan(0);
+    expect(next).toHaveBeenCalledOnce();
+  });
+
+  it('should reuse an incoming request id instead of generating a new one', () => {
+    const req = createMockReq({ 'x-request-id': 'incoming-id' });
+    const res = createMockRes();
+    const next = vi.fn();
+
+    middleware.use(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledWith('X-Request-Id', 'incoming-id');
+  });
+
+  it('should use the first value when the incoming header is repeated', () => {
+    const req = createMockReq({ 'x-request-id': ['first-id', 'second-id'] });
+    const res = createMockRes();
+    const next = vi.fn();
+
+    middleware.use(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledWith('X-Request-Id', 'first-id');
+  });
+
+  it('should generate a different id for each request without an incoming one', () => {
+    const res1 = createMockRes();
+    const res2 = createMockRes();
+
+    middleware.use(createMockReq(), res1, vi.fn());
+    middleware.use(createMockReq(), res2, vi.fn());
+
+    expect(res1.setHeader.mock.calls[0][1]).not.toEqual(
+      res2.setHeader.mock.calls[0][1],
+    );
+  });
+
+  it('should make the resolved id available to application code via RequestIdService while next() runs', () => {
+    const req = createMockReq({ 'x-request-id': 'traced-id' });
+    const res = createMockRes();
+    let observedId: string | undefined;
+
+    middleware.use(req, res, () => {
+      observedId = RequestIdService.getId();
+    });
+
+    expect(observedId).toEqual('traced-id');
+  });
+
+  it('should not leak the request id outside of the middleware-wrapped call', () => {
+    const req = createMockReq({ 'x-request-id': 'scoped-id' });
+    const res = createMockRes();
+
+    middleware.use(req, res, vi.fn());
+
+    expect(RequestIdService.getId()).toBeUndefined();
+  });
+
+  describe('when subclassed with a custom header name', () => {
+    class CorrelationIdMiddleware extends RequestIdMiddleware {
+      protected override readonly headerName = 'X-Correlation-Id';
+    }
+
+    it('should read from and write to the overridden header', () => {
+      const custom = new CorrelationIdMiddleware();
+      const req = createMockReq({ 'x-correlation-id': 'custom-incoming' });
+      const res = createMockRes();
+
+      custom.use(req, res, vi.fn());
+
+      expect(res.setHeader).toHaveBeenCalledWith(
+        'X-Correlation-Id',
+        'custom-incoming',
+      );
+    });
+  });
+});
diff --git a/packages/common/test/services/request-id.service.spec.ts b/packages/common/test/services/request-id.service.spec.ts
