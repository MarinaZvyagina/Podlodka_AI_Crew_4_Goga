+import { randomUUID } from 'node:crypto';
+import { runWithRequestId } from './request-id-context.js';
+import { X_REQUEST_ID_HEADER } from './request-id.constants.js';
+
+/**
+ * @publicApi
+ */
+export interface RequestIdMiddlewareOptions {
+  /**
+   * Header used to read an inbound request ID from, and to reflect it back on
+   * the response. Defaults to `x-request-id`.
+   */
+  header?: string;
+  /**
+   * Generates a request ID when the inbound request doesn't carry one.
+   * Defaults to `randomUUID`.
+   */
+  generateId?: () => string;
+}
+
+export interface IncomingRequestLike {
+  headers: Record<string, string | string[] | undefined>;
+}
+
+export interface OutgoingResponseLike {
+  setHeader(name: string, value: string): unknown;
+}
+
+/**
+ * @publicApi
+ * Creates Connect-style middleware that gives every request a correlation ID:
+ * reused from the configured inbound header when the caller already sent one,
+ * generated otherwise. The ID is reflected back on the response header and made
+ * available to application code for the lifetime of the request via
+ * `getRequestId()`, without needing to parse it back out of the response.
+ *
+ * Register it with `app.use(...)` as the very first middleware so the header
+ * ends up on every response, including ones produced by later middleware,
+ * guards, or exception filters. Behaves identically on the Express and Fastify
+ * HTTP adapters.
+ */
+export function createRequestIdMiddleware(
+  options: RequestIdMiddlewareOptions = {},
+) {
+  const header = (options.header ?? X_REQUEST_ID_HEADER).toLowerCase();
+  const generateId = options.generateId ?? randomUUID;
+
+  return function requestIdMiddleware(
+    req: IncomingRequestLike,
+    res: OutgoingResponseLike,
+    next: (err?: any) => void,
+  ): void {
+    const inbound = req.headers[header];
+    const requestId =
+      (Array.isArray(inbound) ? inbound[0] : inbound) || generateId();
+
+    res.setHeader(header, requestId);
+    runWithRequestId(requestId, next);
+  };
+}
