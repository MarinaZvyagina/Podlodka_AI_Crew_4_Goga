+import { createRequestIdMiddleware } from '@nestjs/core';
+import { NestExpressApplication } from '@nestjs/platform-express';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../src/app.module.js';
+
+describe('Request ID (Express)', () => {
+  let app: NestExpressApplication;
+
+  beforeAll(async () => {
+    const module = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = module.createNestApplication<NestExpressApplication>();
+    app.use(createRequestIdMiddleware());
+    await app.init();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('should generate a request id and expose it to application code', async () => {
+    const response = await request(app.getHttpServer()).get('/').expect(200);
+
+    const headerId = response.headers['x-request-id'];
+    expect(headerId).toEqual(expect.any(String));
+    expect(headerId.length).toBeGreaterThan(0);
+    expect(response.body.requestId).toBe(headerId);
+  });
+
+  it('should reuse an inbound request id instead of generating a new one', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/')
+      .set('x-request-id', 'client-supplied-id')
+      .expect(200);
+
+    expect(response.headers['x-request-id']).toBe('client-supplied-id');
+    expect(response.body.requestId).toBe('client-supplied-id');
+  });
+
+  it('should set the header on error responses', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/boom')
+      .set('x-request-id', 'error-path-id')
+      .expect(500);
+
+    expect(response.headers['x-request-id']).toBe('error-path-id');
+  });
+
+  it('should set the header on 404 responses for unmatched routes', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/does-not-exist')
+      .set('x-request-id', 'not-found-id')
+      .expect(404);
+
+    expect(response.headers['x-request-id']).toBe('not-found-id');
+  });
+});
