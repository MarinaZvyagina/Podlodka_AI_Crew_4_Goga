@@ -0,0 +1,48 @@
+import {
+  getRequestId,
+  runWithRequestId,
+} from '../../../middleware/request-id/request-id-context.js';
+
+describe('request-id-context', () => {
+  it('should return undefined outside of a run() call', () => {
+    expect(getRequestId()).toBeUndefined();
+  });
+
+  it('should expose the id for the duration of the synchronous callback', () => {
+    let observedId: string | undefined;
+
+    runWithRequestId('abc-123', () => {
+      observedId = getRequestId();
+    });
+
+    expect(observedId).toBe('abc-123');
+    expect(getRequestId()).toBeUndefined();
+  });
+
+  it('should propagate the id across async continuations started inside run()', async () => {
+    const observedIds: Array<string | undefined> = [];
+
+    await runWithRequestId('async-id', async () => {
+      observedIds.push(getRequestId());
+      await Promise.resolve();
+      observedIds.push(getRequestId());
+      await new Promise(resolve => setTimeout(resolve, 0));
+      observedIds.push(getRequestId());
+    });
+
+    expect(observedIds).toEqual(['async-id', 'async-id', 'async-id']);
+  });
+
+  it('should keep concurrent request contexts isolated from each other', async () => {
+    const results = await Promise.all(
+      ['first', 'second', 'third'].map(id =>
+        runWithRequestId(id, async () => {
+          await new Promise(resolve => setTimeout(resolve, Math.random() * 5));
+          return getRequestId();
+        }),
+      ),
+    );
+
+    expect(results).toEqual(['first', 'second', 'third']);
+  });
+});
