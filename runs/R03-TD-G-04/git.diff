@@ -0,0 +1,19 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+
+const requestIdStorage = new AsyncLocalStorage<string>();
+
+export function runWithRequestId<T>(requestId: string, callback: () => T): T {
+  return requestIdStorage.run(requestId, callback);
+}
+
+/**
+ * @publicApi
+ * Returns the request/correlation ID of the request currently being handled, or
+ * `undefined` when called outside of a request handled by the request ID
+ * middleware (see `createRequestIdMiddleware`). Backed by `AsyncLocalStorage`, so
+ * it resolves the same way regardless of which HTTP adapter (Express or Fastify)
+ * is in use, without needing to parse the ID back out of the response.
+ */
+export function getRequestId(): string | undefined {
+  return requestIdStorage.getStore();
+}
