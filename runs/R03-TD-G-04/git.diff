+import { getRequestId } from '../../../middleware/request-id/request-id-context.js';
+import { createRequestIdMiddleware } from '../../../middleware/request-id/request-id.middleware.js';
+
+describe('createRequestIdMiddleware', () => {
+  function createMockRes() {
+    return { setHeader: vi.fn() };
+  }
+
+  it('should generate a request id when the inbound request has none', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = { headers: {} };
+    const res = createMockRes();
+    const next = vi.fn();
+
+    middleware(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledTimes(1);
+    const [header, id] = res.setHeader.mock.calls[0];
+    expect(header).toBe('x-request-id');
+    expect(id).toEqual(expect.any(String));
+    expect(id.length).toBeGreaterThan(0);
+    expect(next).toHaveBeenCalledTimes(1);
+  });
+
+  it('should reuse an inbound request id instead of generating a new one', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = { headers: { 'x-request-id': 'incoming-id' } };
+    const res = createMockRes();
+    const next = vi.fn();
+
+    middleware(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledWith('x-request-id', 'incoming-id');
+  });
+
+  it('should use the first value when the inbound header is repeated', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = { headers: { 'x-request-id': ['first-id', 'second-id'] } };
+    const res = createMockRes();
+    const next = vi.fn();
+
+    middleware(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledWith('x-request-id', 'first-id');
+  });
+
+  it('should support a custom header name', () => {
+    const middleware = createRequestIdMiddleware({
+      header: 'X-Correlation-Id',
+    });
+    const req = { headers: { 'x-correlation-id': 'incoming-id' } };
+    const res = createMockRes();
+    const next = vi.fn();
+
+    middleware(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledWith(
+      'x-correlation-id',
+      'incoming-id',
+    );
+  });
+
+  it('should support a custom id generator', () => {
+    const middleware = createRequestIdMiddleware({
+      generateId: () => 'generated-id',
+    });
+    const req = { headers: {} };
+    const res = createMockRes();
+    const next = vi.fn();
+
+    middleware(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledWith('x-request-id', 'generated-id');
+  });
+
+  it('should make the request id available to code running inside next()', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = { headers: { 'x-request-id': 'incoming-id' } };
+    const res = createMockRes();
+
+    let observedId: string | undefined;
+    middleware(req, res, () => {
+      observedId = getRequestId();
+    });
+
+    expect(observedId).toBe('incoming-id');
+  });
+
+  it('should not leak the request id outside of the middleware call', () => {
+    const middleware = createRequestIdMiddleware();
+    const req = { headers: { 'x-request-id': 'incoming-id' } };
+    const res = createMockRes();
+
+    middleware(req, res, () => {});
+
+    expect(getRequestId()).toBeUndefined();
+  });
+});
