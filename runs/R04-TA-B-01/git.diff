diff --git a/packages/excalidraw/data/filename.test.ts b/packages/excalidraw/data/filename.test.ts
new file mode 100644
index 0000000..b0f7520
--- /dev/null
+++ b/packages/excalidraw/data/filename.test.ts
@@ -0,0 +1,26 @@
+import { sanitizeFilename } from "./filename";
+
+describe("sanitizeFilename", () => {
+  it("leaves already-valid names untouched", () => {
+    expect(sanitizeFilename("my drawing")).toBe("my drawing");
+    expect(sanitizeFilename("my-drawing_2024")).toBe("my-drawing_2024");
+  });
+
+  it("replaces characters forbidden on common filesystems", () => {
+    expect(sanitizeFilename('a/b\\c:d*e?f"g<h>i|j')).toBe(
+      "a_b_c_d_e_f_g_h_i_j",
+    );
+  });
+
+  it("strips trailing dots and spaces", () => {
+    expect(sanitizeFilename("my drawing.")).toBe("my drawing");
+    expect(sanitizeFilename("my drawing   ")).toBe("my drawing");
+    expect(sanitizeFilename("my drawing. . .")).toBe("my drawing");
+  });
+
+  it("falls back to a default name when nothing valid remains", () => {
+    expect(sanitizeFilename("")).toBe("Untitled");
+    expect(sanitizeFilename("   ")).toBe("Untitled");
+    expect(sanitizeFilename("...")).toBe("Untitled");
+  });
+});
diff --git a/packages/excalidraw/data/filename.ts b/packages/excalidraw/data/filename.ts
new file mode 100644
index 0000000..bedb4f8
--- /dev/null
+++ b/packages/excalidraw/data/filename.ts
@@ -0,0 +1,23 @@
+import { DEFAULT_FILENAME } from "@excalidraw/common";
+
+// characters reserved/forbidden in filenames on Windows, plus ASCII control
+// characters, which are invalid on Windows and cause issues elsewhere
+// eslint-disable-next-line no-control-regex
+const INVALID_FILENAME_CHARS = /[<>:"/\\|?*\x00-\x1f]/g;
+
+/**
+ * Turns an arbitrary user-supplied string into a filename that is valid and
+ * safe to save on Windows, macOS, and Linux:
+ * - replaces characters forbidden on common filesystems
+ * - strips trailing dots/spaces (Windows silently strips these, which can
+ *   desync the name the user sees from the name actually saved to disk)
+ * - falls back to a default name if nothing valid remains
+ */
+export const sanitizeFilename = (name: string): string => {
+  const sanitized = name
+    .replace(INVALID_FILENAME_CHARS, "_")
+    .replace(/[.\s]+$/, "")
+    .trim();
+
+  return sanitized || DEFAULT_FILENAME;
+};
