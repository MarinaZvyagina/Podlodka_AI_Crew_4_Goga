+import { DEFAULT_FILENAME } from "./constants";
+
+// characters forbidden in file names on Windows, macOS or Linux
+// eslint-disable-next-line no-control-regex
+const INVALID_FILENAME_CHARS = /[/\\:*?"<>|\x00-\x1f]/g;
+
+/**
+ * Sanitizes a user-supplied name so it is safe to use as a file name on
+ * common desktop operating systems (Windows, macOS, Linux): strips
+ * characters that are illegal or reserved on any of them, and trims
+ * trailing dots/spaces which Windows silently drops. Falls back to
+ * `DEFAULT_FILENAME` if nothing usable remains.
+ */
+export const sanitizeFilename = (name: string) => {
+  const sanitized = name
+    .replace(INVALID_FILENAME_CHARS, "_")
+    .trim()
+    .replace(/[\s.]+$/, "");
+
+  return sanitized || DEFAULT_FILENAME;
+};
