@@ -0,0 +1,35 @@
+import { sanitizeFilename } from "@excalidraw/common";
+
+describe("@excalidraw/common/filename", () => {
+  describe("sanitizeFilename()", () => {
+    it("should leave a normal name untouched", () => {
+      expect(sanitizeFilename("my drawing")).toEqual("my drawing");
+    });
+
+    it("should replace characters forbidden on Windows/macOS/Linux", () => {
+      expect(sanitizeFilename('a/b\\c:d*e?f"g<h>i|j')).toEqual(
+        "a_b_c_d_e_f_g_h_i_j",
+      );
+    });
+
+    it("should strip trailing dots and spaces", () => {
+      expect(sanitizeFilename("my drawing.")).toEqual("my drawing");
+      expect(sanitizeFilename("my drawing   ")).toEqual("my drawing");
+      expect(sanitizeFilename("my drawing. . .")).toEqual("my drawing");
+    });
+
+    it("should trim leading/trailing whitespace", () => {
+      expect(sanitizeFilename("  my drawing  ")).toEqual("my drawing");
+    });
+
+    it("should fall back to the default name when empty or blank", () => {
+      expect(sanitizeFilename("")).toEqual("Untitled");
+      expect(sanitizeFilename("   ")).toEqual("Untitled");
+      expect(sanitizeFilename("...")).toEqual("Untitled");
+    });
+
+    it("should replace forbidden characters even if that's all the name contains", () => {
+      expect(sanitizeFilename("///")).toEqual("___");
+    });
+  });
+});
