diff --git a/packages/excalidraw/tests/data/filename.test.ts b/packages/excalidraw/tests/data/filename.test.ts
new file mode 100644
index 0000000..16517ac
--- /dev/null
+++ b/packages/excalidraw/tests/data/filename.test.ts
@@ -0,0 +1,41 @@
+import { getSanitizedFilename } from "../../data/filename";
+
+describe("getSanitizedFilename", () => {
+  it("leaves an already-valid name untouched", () => {
+    expect(getSanitizedFilename("my drawing", "fallback")).toBe("my drawing");
+  });
+
+  it("replaces characters that are illegal on Windows/macOS/Linux", () => {
+    expect(getSanitizedFilename('a/b\\c:d*e?f"g<h>i|j', "fallback")).toBe(
+      "a_b_c_d_e_f_g_h_i_j",
+    );
+  });
+
+  it("strips a trailing dot", () => {
+    expect(getSanitizedFilename("my drawing.", "fallback")).toBe("my drawing");
+  });
+
+  it("strips trailing spaces", () => {
+    expect(getSanitizedFilename("my drawing   ", "fallback")).toBe(
+      "my drawing",
+    );
+  });
+
+  it("strips a mix of trailing dots and spaces", () => {
+    expect(getSanitizedFilename("my drawing . . ", "fallback")).toBe(
+      "my drawing",
+    );
+  });
+
+  it("falls back when the name is empty", () => {
+    expect(getSanitizedFilename("", "fallback")).toBe("fallback");
+  });
+
+  it("falls back when the name is only whitespace", () => {
+    expect(getSanitizedFilename("   ", "fallback")).toBe("fallback");
+  });
+
+  it("falls back when the name is only dots", () => {
+    expect(getSanitizedFilename("...", "fallback")).toBe("fallback");
+  });
+});
