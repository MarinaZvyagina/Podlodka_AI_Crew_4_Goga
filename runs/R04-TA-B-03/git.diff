diff --git a/packages/excalidraw/data/filename.ts b/packages/excalidraw/data/filename.ts
new file mode 100644
index 0000000..f430434
--- /dev/null
+++ b/packages/excalidraw/data/filename.ts
@@ -0,0 +1,20 @@
+// characters that are illegal in file names on Windows, macOS and/or Linux
+const INVALID_FILENAME_CHARS_REGEX = /[/\\:*?"<>|]/g;
+// Windows silently strips trailing dots/spaces, which would otherwise cause
+// the saved file name to differ from what the user typed
+const TRAILING_DOTS_OR_SPACES_REGEX = /[.\s]+$/;
+
+/**
+ * Sanitizes a user-supplied name so it's safe to use as a file name across
+ * Windows, macOS and Linux. Returns `fallback` if nothing valid remains.
+ */
+export const getSanitizedFilename = (
+  name: string,
+  fallback: string,
+): string => {
+  const sanitized = name
+    .replace(INVALID_FILENAME_CHARS_REGEX, "_")
+    .replace(TRAILING_DOTS_OR_SPACES_REGEX, "");
+
+  return sanitized || fallback;
+};
