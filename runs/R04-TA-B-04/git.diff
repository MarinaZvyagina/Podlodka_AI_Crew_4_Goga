+// characters reserved/illegal in file names on Windows, macOS and/or Linux
+const ILLEGAL_FILENAME_CHARACTERS = /[/\\:*?"<>|]/g;
+// Windows silently strips trailing dots/spaces from file names, which can
+// otherwise cause the saved file name to mismatch what the user typed
+const TRAILING_DOTS_OR_SPACES = /[.\s]+$/;
+
+/** sanitizes a user-supplied drawing name into a name that's safe to use
+ * as a file name across Windows, macOS and Linux */
+export const sanitizeFilename = (name: string | null | undefined): string => {
+  const sanitized = (name ?? "")
+    .trim()
+    .replace(ILLEGAL_FILENAME_CHARACTERS, "_")
+    .replace(TRAILING_DOTS_OR_SPACES, "");
+
+  return sanitized || DEFAULT_FILENAME;
+};
