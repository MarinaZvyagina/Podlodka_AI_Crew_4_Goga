+/**
+ * Turns an arbitrary user-entered string into a filename that's safe to
+ * save/export on Windows, macOS, and Linux: strips characters reserved by
+ * common filesystems, and trailing dots/spaces (which Windows silently
+ * strips, causing the saved filename to mismatch what the user typed).
+ * Falls back to DEFAULT_FILENAME if nothing safe remains.
+ */
+export const getSafeFilename = (name: string): string => {
+  const sanitized = name
+    .replace(/[<>:"/\\|?*]/g, "-")
+    .replace(/[.\s]+$/, "")
+    .trim();
+
+  return sanitized || DEFAULT_FILENAME;
+};
