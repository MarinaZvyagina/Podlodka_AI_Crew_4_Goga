+  describe("getSafeFilename()", () => {
+    it("should leave already-safe names untouched", () => {
+      expect(getSafeFilename("My Drawing")).toEqual("My Drawing");
+    });
+
+    it("should replace characters that are invalid on Windows/macOS/Linux", () => {
+      expect(getSafeFilename('a/b\\c:d*e?f"g<h>i|j')).toEqual(
+        "a-b-c-d-e-f-g-h-i-j",
+      );
+    });
+
+    it("should strip trailing dots and spaces", () => {
+      expect(getSafeFilename("My Drawing.")).toEqual("My Drawing");
+      expect(getSafeFilename("My Drawing   ")).toEqual("My Drawing");
+      expect(getSafeFilename("My Drawing. . ")).toEqual("My Drawing");
+    });
+
+    it("should fall back to the default name when nothing safe is left", () => {
+      expect(getSafeFilename("")).toEqual("Untitled");
+      expect(getSafeFilename("   ")).toEqual("Untitled");
+      expect(getSafeFilename("...")).toEqual("Untitled");
+    });
+  });
 });
