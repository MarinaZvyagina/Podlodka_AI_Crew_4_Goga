+// characters that are invalid in file names on Windows, macOS and Linux
+const UNSAFE_FILENAME_CHARS_REGEX = /[/\\:*?"<>|]/g;
+// Windows silently strips trailing dots and spaces from file names
+const TRAILING_DOTS_AND_SPACES_REGEX = /[.\s]+$/;
+
+/** Turns arbitrary user input into a name that is safe to use as a file
+ * name on Windows, macOS and Linux. Falls back to `DEFAULT_FILENAME` if
+ * nothing safe is left after sanitization. */
+export const getSafeFilename = (name: string): string => {
+  const safeName = name
+    .replace(UNSAFE_FILENAME_CHARS_REGEX, "-")
+    .trim()
+    .replace(TRAILING_DOTS_AND_SPACES_REGEX, "");
+
+  return safeName || DEFAULT_FILENAME;
+};
