+// characters reserved on Windows, macOS or Linux file systems
+const RE_INVALID_FILENAME_CHARS = /[/\\:*?"<>|]/g;
+// Windows silently strips trailing dots/spaces from file names, which can
+// cause the saved file name to mismatch what the user typed
+const RE_TRAILING_DOTS_OR_SPACES = /[. ]+$/;
+
+/**
+ * Sanitizes a user-supplied name so it's safe to use as a file name when
+ * saving/exporting to disk on Windows, macOS and Linux. Falls back to
+ * `fallback` if nothing usable remains (e.g. name was empty or blank).
+ */
+export const getSanitizedFilename = (
+  name: string,
+  fallback: string = DEFAULT_FILENAME,
+): string => {
+  const sanitized = name
+    .replace(RE_INVALID_FILENAME_CHARS, "")
+    .trim()
+    .replace(RE_TRAILING_DOTS_OR_SPACES, "");
+
+  return sanitized || fallback;
+};
