@@ -0,0 +1,46 @@
+import { describe, expect, it } from "vitest";
+
+import { DEFAULT_FILENAME, sanitizeFilename } from "@excalidraw/common";
+
+describe("sanitizeFilename", () => {
+  it("leaves a normal name untouched", () => {
+    expect(sanitizeFilename("My Drawing")).toBe("My Drawing");
+  });
+
+  it("replaces characters invalid on Windows/macOS/Linux", () => {
+    expect(sanitizeFilename('a/b\\c:d*e?f"g<h>i|j')).toBe(
+      "a_b_c_d_e_f_g_h_i_j",
+    );
+  });
+
+  it("strips control characters", () => {
+    const withControlChars = `a${String.fromCharCode(1)}b${String.fromCharCode(
+      31,
+    )}c`;
+    expect(sanitizeFilename(withControlChars)).toBe("a_b_c");
+  });
+
+  it("strips a trailing dot", () => {
+    expect(sanitizeFilename("My Drawing.")).toBe("My Drawing");
+  });
+
+  it("strips trailing spaces", () => {
+    expect(sanitizeFilename("My Drawing   ")).toBe("My Drawing");
+  });
+
+  it("strips a mix of trailing dots and spaces", () => {
+    expect(sanitizeFilename("My Drawing . . ")).toBe("My Drawing");
+  });
+
+  it("falls back to the default filename when empty", () => {
+    expect(sanitizeFilename("")).toBe(DEFAULT_FILENAME);
+  });
+
+  it("falls back to the default filename when made up only of spaces", () => {
+    expect(sanitizeFilename("   ")).toBe(DEFAULT_FILENAME);
+  });
+
+  it("falls back to the default filename when nothing safe remains", () => {
+    expect(sanitizeFilename("...")).toBe(DEFAULT_FILENAME);
+  });
+});
