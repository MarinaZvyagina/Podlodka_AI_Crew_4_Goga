@@ -0,0 +1,25 @@
+import { DEFAULT_FILENAME } from "./constants";
+
+// characters invalid in file names on Windows (the most restrictive of the
+// common desktop OSes), plus ASCII control characters
+// eslint-disable-next-line no-control-regex
+const INVALID_FILENAME_CHARS_REGEX = /[/\\:*?"<>|\x00-\x1f]/g;
+
+// Windows silently strips trailing dots and spaces from file names, which
+// can otherwise cause the saved file name to silently differ from what the
+// user typed
+const TRAILING_DOTS_AND_SPACES_REGEX = /[.\s]+$/;
+
+/**
+ * Turns an arbitrary user-supplied string into a name that is safe to use
+ * as a file name on common desktop operating systems (Windows, macOS,
+ * Linux). Falls back to `DEFAULT_FILENAME` if nothing safe remains.
+ */
+export const sanitizeFilename = (name: string): string => {
+  const sanitized = name
+    .replace(INVALID_FILENAME_CHARS_REGEX, "_")
+    .replace(TRAILING_DOTS_AND_SPACES_REGEX, "")
+    .trim();
+
+  return sanitized || DEFAULT_FILENAME;
+};
