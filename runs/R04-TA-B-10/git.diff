@@ -1200,3 +1200,54 @@ export const oneOf = <N extends string | number | symbol | null, H extends N>(
 ): needle is H => {
   return haystack.includes(needle as any);
 };
+
+// characters forbidden in file names on Windows, plus ASCII control characters
+// eslint-disable-next-line no-control-regex
+const ILLEGAL_FILENAME_CHARACTERS = /[<>:"/\\|?*\x00-\x1F]/g;
+// Windows silently strips trailing dots/spaces, which would otherwise cause
+// the saved file name to mismatch what the user typed
+const TRAILING_DOTS_AND_SPACES = /[.\s]+$/;
+// reserved device names on Windows, regardless of extension
+const WINDOWS_RESERVED_FILENAMES = new Set([
+  "CON",
+  "PRN",
+  "AUX",
+  "NUL",
+  "COM1",
+  "COM2",
+  "COM3",
+  "COM4",
+  "COM5",
+  "COM6",
+  "COM7",
+  "COM8",
+  "COM9",
+  "LPT1",
+  "LPT2",
+  "LPT3",
+  "LPT4",
+  "LPT5",
+  "LPT6",
+  "LPT7",
+  "LPT8",
+  "LPT9",
+]);
+
+/**
+ * Turns an arbitrary user-supplied string into a name that's safe to use as
+ * a file name on Windows, macOS, and Linux. Returns an empty string if
+ * nothing safe remains (e.g. the input was empty, all whitespace/dots, or a
+ * Windows-reserved device name), leaving the choice of fallback to the caller.
+ */
+export const sanitizeFilename = (name: string): string => {
+  const sanitized = name
+    .replace(ILLEGAL_FILENAME_CHARACTERS, "-")
+    .replace(TRAILING_DOTS_AND_SPACES, "")
+    .trim();
+
+  if (!sanitized || WINDOWS_RESERVED_FILENAMES.has(sanitized.toUpperCase())) {
+    return "";
+  }
+
+  return sanitized;
+};
diff --git a/packages/excalidraw/actions/actionExport.test.tsx b/packages/excalidraw/actions/actionExport.test.tsx
new file mode 100644
index 0000000..b0fe401
--- /dev/null
+++ b/packages/excalidraw/actions/actionExport.test.tsx
@@ -0,0 +1,79 @@
+import React from "react";
+
+import { Excalidraw } from "../index";
+import { act, render } from "../tests/test-utils";
+
+import { actionChangeProjectName } from "./actionExport";
+
+const { h } = window;
+
+describe("actionChangeProjectName", () => {
+  it("should keep a name that is already a safe file name as-is", async () => {
+    await render(<Excalidraw />);
+
+    act(() => {
+      h.app.actionManager.executeAction(
+        actionChangeProjectName,
+        "ui",
+        "My Drawing",
+      );
+    });
+
+    expect(h.state.name).toBe("My Drawing");
+    expect(h.state.toast).toBe(null);
+  });
+
+  it("should sanitize characters that are illegal in file names and surface a toast", async () => {
+    await render(<Excalidraw />);
+
+    act(() => {
+      h.app.actionManager.executeAction(
+        actionChangeProjectName,
+        "ui",
+        'notes: "q1/q2" plan?',
+      );
+    });
+
+    expect(h.state.name).toBe("notes- -q1-q2- plan-");
+    expect(h.state.toast).not.toBe(null);
+  });
+
+  it("should strip trailing dots and spaces", async () => {
+    await render(<Excalidraw />);
+
+    act(() => {
+      h.app.actionManager.executeAction(
+        actionChangeProjectName,
+        "ui",
+        "My Drawing. ",
+      );
+    });
+
+    expect(h.state.name).toBe("My Drawing");
+    expect(h.state.toast).not.toBe(null);
+  });
+
+  it("should fall back to an automatic name when the input is only whitespace", async () => {
+    await render(<Excalidraw />);
+
+    act(() => {
+      h.app.actionManager.executeAction(actionChangeProjectName, "ui", "   ");
+    });
+
+    expect(h.state.name).toBe("");
+    expect(h.state.toast).not.toBe(null);
+    expect(h.app.getName()).not.toBe("");
+  });
+
+  it("should not surface a toast when clearing the name entirely", async () => {
+    await render(<Excalidraw />);
+
+    act(() => {
+      h.app.actionManager.executeAction(actionChangeProjectName, "ui", "");
+    });
+
+    expect(h.state.name).toBe("");
+    expect(h.state.toast).toBe(null);
+    expect(h.app.getName()).not.toBe("");
+  });
+});
