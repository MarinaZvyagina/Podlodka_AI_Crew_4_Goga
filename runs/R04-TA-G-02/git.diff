diff --git a/packages/excalidraw/data/filename.ts b/packages/excalidraw/data/filename.ts
new file mode 100644
index 0000000..fb1e123
--- /dev/null
+++ b/packages/excalidraw/data/filename.ts
@@ -0,0 +1,28 @@
+// Characters disallowed in file names on Windows; also safest to avoid on
+// macOS/Linux since some of them are shell/path metacharacters there too.
+const INVALID_FILENAME_CHARS_REGEX = /[<>:"/\\|?*]/g;
+
+// Reserved device names on Windows (case-insensitive). Checked against the
+// name *before* the extension is appended, since that's how Windows applies
+// the restriction (e.g. "con.excalidraw" is invalid too).
+const WINDOWS_RESERVED_NAME_REGEX = /^(con|prn|aux|nul|com[0-9]|lpt[0-9])$/i;
+
+/**
+ * Sanitizes a user-supplied drawing name so it's safe to use as a file name
+ * when saving/exporting to disk on Windows, macOS, and Linux. Returns an
+ * empty string if nothing safe is left, so callers can fall back to a
+ * default name.
+ */
+export const getSanitizedFilename = (name: string): string => {
+  let sanitized = name.replace(INVALID_FILENAME_CHARS_REGEX, "-");
+
+  // Windows silently strips trailing dots/spaces when saving a file, which
+  // would otherwise desync the displayed name from what lands on disk.
+  sanitized = sanitized.trim().replace(/[.\s]+$/, "");
+
+  if (WINDOWS_RESERVED_NAME_REGEX.test(sanitized)) {
+    sanitized = `-${sanitized}`;
+  }
+
+  return sanitized;
+};
