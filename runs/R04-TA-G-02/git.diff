diff --git a/packages/excalidraw/tests/data/filename.test.ts b/packages/excalidraw/tests/data/filename.test.ts
new file mode 100644
index 0000000..372eaf2
--- /dev/null
+++ b/packages/excalidraw/tests/data/filename.test.ts
@@ -0,0 +1,32 @@
+import { getSanitizedFilename } from "../../data/filename";
+
+describe("getSanitizedFilename", () => {
+  it("leaves an already-safe name untouched", () => {
+    expect(getSanitizedFilename("My Drawing")).toBe("My Drawing");
+  });
+
+  it("replaces characters invalid on Windows/macOS/Linux", () => {
+    expect(getSanitizedFilename('a/b\\c:d*e?f"g<h>i|j')).toBe(
+      "a-b-c-d-e-f-g-h-i-j",
+    );
+  });
+
+  it("strips trailing dots and spaces", () => {
+    expect(getSanitizedFilename("My Drawing...")).toBe("My Drawing");
+    expect(getSanitizedFilename("My Drawing   ")).toBe("My Drawing");
+    expect(getSanitizedFilename("My Drawing . . ")).toBe("My Drawing");
+  });
+
+  it("returns an empty string for names made up only of spaces", () => {
+    expect(getSanitizedFilename("   ")).toBe("");
+    expect(getSanitizedFilename("")).toBe("");
+  });
+
+  it("prefixes Windows-reserved device names", () => {
+    expect(getSanitizedFilename("CON")).toBe("-CON");
+    expect(getSanitizedFilename("com1")).toBe("-com1");
+    expect(getSanitizedFilename("Nul")).toBe("-Nul");
+    // not reserved names, should be left alone
+    expect(getSanitizedFilename("Console")).toBe("Console");
+  });
+});
