+// characters reserved/forbidden in file names on Windows, macOS, or Linux,
+// plus ASCII control characters
+// eslint-disable-next-line no-control-regex
+const RESERVED_FILENAME_CHARS_REGEX = /[<>:"/\\|?*\x00-\x1F]/g;
+// Windows silently strips trailing dots/spaces when saving, which can leave
+// the file on disk named differently than what was typed
+const TRAILING_DOTS_OR_SPACES_REGEX = /[.\s]+$/;
+
+/**
+ * Turns an arbitrary user-supplied string into a name that's safe to use
+ * as a file name on common desktop operating systems (Windows, macOS, Linux).
+ */
+export const sanitizeFilename = (name: string) => {
+  const sanitized = name
+    .replace(RESERVED_FILENAME_CHARS_REGEX, "")
+    .trim()
+    .replace(TRAILING_DOTS_OR_SPACES_REGEX, "")
+    .trim();
+
+  return sanitized || DEFAULT_FILENAME;
+};
