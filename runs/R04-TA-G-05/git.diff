@@ -0,0 +1,52 @@
+import { DEFAULT_FILENAME, sanitizeFilename } from "@excalidraw/common";
+
+describe("sanitizeFilename", () => {
+  it("leaves an already-valid name untouched", () => {
+    expect(sanitizeFilename("My Drawing")).toBe("My Drawing");
+  });
+
+  it("replaces characters forbidden on Windows/macOS/Linux", () => {
+    expect(sanitizeFilename('a/b\\c:d*e?f"g<h>i|j')).toBe(
+      "a-b-c-d-e-f-g-h-i-j",
+    );
+  });
+
+  it("strips ASCII control characters", () => {
+    const withControlChar = `My${String.fromCharCode(1)}Drawing`;
+    expect(sanitizeFilename(withControlChar)).toBe("My-Drawing");
+  });
+
+  it("falls back to the default name when empty", () => {
+    expect(sanitizeFilename("")).toBe(DEFAULT_FILENAME);
+  });
+
+  it("falls back to the default name when made up only of spaces", () => {
+    expect(sanitizeFilename("   ")).toBe(DEFAULT_FILENAME);
+  });
+
+  it("strips a trailing dot, which Windows silently drops", () => {
+    expect(sanitizeFilename("My Drawing.")).toBe("My Drawing");
+  });
+
+  it("strips trailing spaces, which Windows silently drops", () => {
+    expect(sanitizeFilename("My Drawing   ")).toBe("My Drawing");
+  });
+
+  it("strips interleaved trailing dots and spaces", () => {
+    expect(sanitizeFilename("My Drawing . . ")).toBe("My Drawing");
+  });
+
+  it("falls back to the default name when only dots", () => {
+    expect(sanitizeFilename("....")).toBe(DEFAULT_FILENAME);
+  });
+
+  it("disambiguates Windows-reserved device names", () => {
+    expect(sanitizeFilename("CON")).toBe("CON-");
+    expect(sanitizeFilename("con")).toBe("con-");
+    expect(sanitizeFilename("LPT1")).toBe("LPT1-");
+  });
+
+  it("does not touch names that merely contain a reserved word", () => {
+    expect(sanitizeFilename("CONtract")).toBe("CONtract");
+  });
+});
