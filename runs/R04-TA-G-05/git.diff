@@ -0,0 +1,32 @@
+import { DEFAULT_FILENAME } from "./constants";
+
+// characters forbidden in file names on Windows, plus path separators unsafe
+// on macOS/Linux, plus ASCII control characters
+// eslint-disable-next-line no-control-regex
+const FORBIDDEN_FILENAME_CHARS_REGEX = /[/\\:*?"<>|\x00-\x1f]/g;
+
+// Windows reserves these device names (case-insensitive) as file names
+const WINDOWS_RESERVED_NAME_REGEX = /^(?:CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])$/i;
+
+/**
+ * Turns an arbitrary user-provided string into a name that's safe to use
+ * as a file name on Windows, macOS and Linux.
+ */
+export const sanitizeFilename = (name: string): string => {
+  const sanitized = name
+    .replace(FORBIDDEN_FILENAME_CHARS_REGEX, "-")
+    .trim()
+    // Windows silently strips trailing dots/spaces, which would otherwise
+    // make the saved file name not match what the user sees
+    .replace(/[\s.]+$/, "");
+
+  if (!sanitized) {
+    return DEFAULT_FILENAME;
+  }
+
+  if (WINDOWS_RESERVED_NAME_REGEX.test(sanitized)) {
+    return `${sanitized}-`;
+  }
+
+  return sanitized;
+};
