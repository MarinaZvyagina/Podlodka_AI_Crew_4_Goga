--- /dev/null
+++ b/packages/common/src/filename.ts
@@ -0,0 +1,23 @@
+import { DEFAULT_FILENAME } from "./constants";
+
+// Characters reserved/disallowed in file names on Windows, plus ASCII
+// control characters, which are unsafe across Windows, macOS, and Linux.
+// eslint-disable-next-line no-control-regex
+const UNSAFE_FILENAME_CHARS_REGEX = /[\x00-\x1f<>:"/\\|?*]/g;
+
+// Windows silently strips trailing dots/spaces, which can cause the file
+// name actually saved to disk to differ from what the user typed.
+const TRAILING_DOTS_OR_SPACES_REGEX = /[. ]+$/;
+
+/**
+ * Sanitizes a user-supplied drawing name into a name that's safe to save as
+ * a file name (without the extension) on Windows, macOS, and Linux.
+ */
+export const getSanitizedFilename = (name: string): string => {
+  const sanitized = name
+    .replace(UNSAFE_FILENAME_CHARS_REGEX, "_")
+    .replace(TRAILING_DOTS_OR_SPACES_REGEX, "")
+    .trim();
+
+  return sanitized || DEFAULT_FILENAME;
+};
