+// eslint-disable-next-line no-control-regex
+const RESERVED_FILENAME_CHARS_REGEX = /[<>:"/\\|?*\x00-\x1F]/g;
+
+/**
+ * Sanitizes a user-supplied name into a name that's safe to use as a file
+ * name when saving/exporting on Windows, macOS, and Linux: strips
+ * characters reserved by those filesystems, and strips trailing dots/spaces
+ * (which Windows silently drops, causing the saved file name to no longer
+ * match what was typed). Falls back to `fallback` if nothing safe remains.
+ */
+export const getSafeFilename = (name: string, fallback: string): string => {
+  const safeName = name
+    .replace(RESERVED_FILENAME_CHARS_REGEX, "_")
+    .trim()
+    .replace(/[.\s]+$/, "");
+
+  return safeName || fallback;
+};
