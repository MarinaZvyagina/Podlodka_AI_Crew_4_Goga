@@ -0,0 +1,29 @@
+import { sanitizeFilename } from "@excalidraw/common";
+
+describe("sanitizeFilename", () => {
+  it("leaves a normal name untouched", () => {
+    expect(sanitizeFilename("my drawing")).toBe("my drawing");
+  });
+
+  it("replaces characters forbidden on Windows/macOS/Linux", () => {
+    expect(sanitizeFilename('a/b\\c:d*e?f"g<h>i|j')).toBe(
+      "a_b_c_d_e_f_g_h_i_j",
+    );
+  });
+
+  it("strips ASCII control characters", () => {
+    expect(sanitizeFilename("foo\x00bar\x1f")).toBe("foo_bar_");
+  });
+
+  it("strips trailing dots and spaces (silently stripped by Windows)", () => {
+    expect(sanitizeFilename("my drawing...")).toBe("my drawing");
+    expect(sanitizeFilename("my drawing   ")).toBe("my drawing");
+    expect(sanitizeFilename("my drawing. . ")).toBe("my drawing");
+  });
+
+  it("falls back to a default name when input is empty or blank", () => {
+    expect(sanitizeFilename("")).toBe("Untitled");
+    expect(sanitizeFilename("   ")).toBe("Untitled");
+    expect(sanitizeFilename("...")).toBe("Untitled");
+  });
+});
diff --git a/packages/common/src/filename.ts b/packages/common/src/filename.ts
new file mode 100644
index 0000000..47640a7
--- /dev/null
+++ b/packages/common/src/filename.ts
@@ -0,0 +1,25 @@
+import { DEFAULT_FILENAME } from "./constants";
+
+// characters reserved/forbidden in file names on Windows, plus ASCII control
+// characters, which are forbidden or cause issues on Windows/macOS/Linux
+// eslint-disable-next-line no-control-regex
+const INVALID_FILENAME_CHARS_REGEX = /[\\/:*?"<>|\x00-\x1f]/g;
+
+/**
+ * Sanitizes a user-supplied string so it's safe to use as a file name on
+ * Windows, macOS, and Linux: strips/replaces characters that are illegal or
+ * reserved on any of these platforms, and trims trailing dots/spaces, which
+ * Windows silently drops (and which would otherwise cause the saved file
+ * name to mismatch what the user typed).
+ *
+ * Falls back to a generic name if the sanitized result is empty (e.g. the
+ * input was empty or contained only whitespace).
+ */
+export const sanitizeFilename = (name: string) => {
+  const sanitized = name
+    .replace(INVALID_FILENAME_CHARS_REGEX, "_")
+    .replace(/[. ]+$/, "")
+    .trim();
+
+  return sanitized || DEFAULT_FILENAME;
+};
