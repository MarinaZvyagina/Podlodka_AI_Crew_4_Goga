+import { polygonArea, round } from "@excalidraw/math";
+
+import { isPathALoop } from "@excalidraw/element";
+
+import type { NonDeletedExcalidrawElement } from "@excalidraw/element/types";
+
+import { t } from "../../i18n";
+
+interface AreaProps {
+  element: NonDeletedExcalidrawElement;
+}
+
+/** Returns the enclosed area of the element, or `null` if the element
+ * doesn't enclose a region (e.g. an open line/arrow, or a text label). */
+export const getElementArea = (
+  element: NonDeletedExcalidrawElement,
+): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      // a diamond is a quadrilateral through the midpoints of its
+      // bounding box's sides, i.e. half the bounding box's area
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return Math.PI * (element.width / 2) * (element.height / 2);
+    case "line":
+    case "freedraw":
+      // only a closed outline encloses a region; matches the same
+      // loop-closure rule the renderer uses to decide whether to fill it
+      return isPathALoop(element.points) ? polygonArea(element.points) : null;
+    default:
+      return null;
+  }
+};
+
+const Area = ({ element }: AreaProps) => {
+  const area = getElementArea(element);
+
+  if (area === null) {
+    return null;
+  }
+
+  return (
+    <>
+      <div>{t("stats.area")}</div>
+      <div>{round(area, 2)}</div>
+    </>
+  );
+};
+
+export default Area;
