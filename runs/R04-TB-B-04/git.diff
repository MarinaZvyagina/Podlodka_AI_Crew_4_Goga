+/** enclosed area of the element, or `null` if the element doesn't enclose a
+ * meaningful region (e.g. an open line/arrow or a text label) */
+export const getElementArea = (
+  element: NonDeletedExcalidrawElement,
+): number | null => {
+  switch (element.type) {
+    case "rectangle":
+    case "image":
+    case "iframe":
+    case "embeddable":
+    case "frame":
+    case "magicframe":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return Math.PI * (element.width / 2) * (element.height / 2);
+    case "line":
+    case "freedraw":
+      // local points are unaffected by the element's position/rotation, so
+      // the shoelace area computed from them is already the final area
+      return isPathALoop(element.points) ? polygonArea(element.points) : null;
+    default:
+      return null;
+  }
+};
