+/**
+ * get the area enclosed by an excalidraw element, or `null` if the element
+ * doesn't enclose a region (e.g. an open line/freedraw path, an arrow, or
+ * a text element).
+ *
+ * area is invariant to rotation, so `element.angle` doesn't need to be
+ * taken into account.
+ */
+export const getElementArea = (element: ExcalidrawElement): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    case "line":
+      return isLineElement(element) &&
+        element.polygon &&
+        isPathALoop(element.points)
+        ? polygonArea(element.points)
+        : null;
+    case "freedraw":
+      return isPathALoop(element.points) ? polygonArea(element.points) : null;
+    default:
+      return null;
+  }
+};
