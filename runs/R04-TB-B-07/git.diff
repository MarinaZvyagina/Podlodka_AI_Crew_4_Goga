+describe("shape area stats", () => {
+  beforeEach(async () => {
+    localStorage.clear();
+    renderStaticScene.mockClear();
+    reseed(7);
+    setDateTimeForTests("201933152653");
+
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+
+    API.setElements([]);
+
+    fireEvent.contextMenu(GlobalTestState.interactiveCanvas, {
+      button: 2,
+      clientX: 1,
+      clientY: 1,
+    });
+    const contextMenu = UI.queryContextMenu();
+    fireEvent.click(queryByTestId(contextMenu!, "stats")!);
+    stats = UI.queryStats();
+  });
+
+  beforeAll(() => {
+    mockBoundingClientRect();
+  });
+
+  afterAll(() => {
+    restoreOriginalGetBoundingClientRect();
+  });
+
+  const queryAreaValue = () => {
+    const rows = stats
+      ?.querySelector("#elementStats")
+      ?.querySelectorAll(".exc-stats__row");
+    const row = rows
+      ? Array.from(rows).find(
+          (row) => row.firstElementChild?.textContent === t("stats.area"),
+        )
+      : undefined;
+    return row?.lastElementChild?.textContent;
+  };
+
+  it("should show the area of a rectangle and update it as it's resized", () => {
+    UI.clickTool("rectangle");
+    mouse.down();
+    mouse.up(200, 100);
+
+    expect(queryAreaValue()).toBe("20000");
+
+    const widthInput = UI.queryStatsProperty("W")?.querySelector(
+      ".drag-input",
+    ) as HTMLInputElement;
+    UI.updateInput(widthInput, "100");
+
+    expect(queryAreaValue()).toBe("10000");
+  });
+
+  it("should report the same area for a rectangle regardless of rotation", () => {
+    UI.clickTool("rectangle");
+    mouse.down();
+    mouse.up(200, 100);
+
+    expect(queryAreaValue()).toBe("20000");
+
+    const angleInput = UI.queryStatsProperty("A")?.querySelector(
+      ".drag-input",
+    ) as HTMLInputElement;
+    UI.updateInput(angleInput, "45");
+
+    expect(queryAreaValue()).toBe("20000");
+  });
+
+  it("should show the correct area for a diamond and an ellipse", () => {
+    UI.clickTool("diamond");
+    mouse.down();
+    mouse.up(200, 100);
+
+    expect(queryAreaValue()).toBe("10000");
+
+    UI.clickTool("ellipse");
+    mouse.down();
+    mouse.up(200, 100);
+
+    expect(queryAreaValue()).toBe(
+      round((Math.PI * 200 * 100) / 4, 2).toString(),
+    );
+  });
+
+  it("should show the area of a closed line but not an open one", () => {
+    const openLine = API.createElement({
+      type: "line",
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 100),
+      ],
+    });
+    API.setElements([openLine]);
+    API.setSelectedElements([openLine]);
+
+    expect(queryAreaValue()).toBeUndefined();
+
+    const closedLine = API.createElement({
+      type: "line",
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 100),
+        pointFrom<LocalPoint>(0, 0),
+      ],
+    });
+    API.setElements([closedLine]);
+    API.setSelectedElements([closedLine]);
+
+    expect(queryAreaValue()).toBe("5000");
+  });
+
+  it("should not show the area for an arrow or a text element", () => {
+    UI.clickTool("arrow");
+    mouse.down();
+    mouse.up(200, 100);
+
+    expect(queryAreaValue()).toBeUndefined();
+
+    const text = API.createElement({ type: "text", text: "hello" });
+    API.setElements([text]);
+    API.setSelectedElements([text]);
+
+    expect(queryAreaValue()).toBeUndefined();
+  });
