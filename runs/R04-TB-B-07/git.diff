+/**
+ * The area enclosed by an element, in the element's local (unrotated)
+ * coordinate space. Rotation is a rigid transform and doesn't change area,
+ * so `element.angle` doesn't need to be factored in.
+ *
+ * Returns `null` for elements that don't enclose a region (e.g. arrows,
+ * text, or open lines/freedraw paths).
+ */
+export const getElementArea = (element: ExcalidrawElement): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    case "line":
+    case "freedraw":
+      return isPathALoop(element.points) ? polygonArea(element.points) : null;
+    default:
+      return null;
+  }
+};
