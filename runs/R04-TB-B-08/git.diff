+describe("stats area readout", () => {
+  beforeEach(async () => {
+    localStorage.clear();
+    renderStaticScene.mockClear();
+    reseed(7);
+    setDateTimeForTests("201933152653");
+
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+
+    API.setElements([]);
+
+    fireEvent.contextMenu(GlobalTestState.interactiveCanvas, {
+      button: 2,
+      clientX: 1,
+      clientY: 1,
+    });
+    const contextMenu = UI.queryContextMenu();
+    fireEvent.click(queryByTestId(contextMenu!, "stats")!);
+    stats = UI.queryStats();
+  });
+
+  beforeAll(() => {
+    mockBoundingClientRect();
+  });
+
+  afterAll(() => {
+    restoreOriginalGetBoundingClientRect();
+  });
+
+  const getAreaValue = () => {
+    const row = stats?.querySelector('[data-testid="stats-area"]');
+    return row?.lastElementChild?.textContent;
+  };
+
+  it("shows the area for a rectangle, matching width * height", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 200,
+      height: 100,
+    });
+    API.setElements([rectangle]);
+    API.setSelectedElements([rectangle]);
+
+    expect(getAreaValue()).toBe("20000");
+  });
+
+  it("reports the same area for a rectangle regardless of rotation", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 200,
+      height: 100,
+      angle: degreesToRadians(37 as Degrees),
+    });
+    API.setElements([rectangle]);
+    API.setSelectedElements([rectangle]);
+
+    expect(getAreaValue()).toBe("20000");
+  });
+
+  it("shows the area for an ellipse, matching pi * rx * ry", () => {
+    const ellipse = API.createElement({
+      type: "ellipse",
+      width: 100,
+      height: 50,
+    });
+    API.setElements([ellipse]);
+    API.setSelectedElements([ellipse]);
+
+    const expectedArea = Math.PI * 50 * 25;
+    expect(Number(getAreaValue())).toBeCloseTo(expectedArea, 1);
+  });
+
+  it("shows the area for a diamond, matching half of width * height", () => {
+    const diamond = API.createElement({
+      type: "diamond",
+      width: 100,
+      height: 50,
+    });
+    API.setElements([diamond]);
+    API.setSelectedElements([diamond]);
+
+    expect(Number(getAreaValue())).toBeCloseTo(2500, 1);
+  });
+
