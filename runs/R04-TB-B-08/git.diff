+/** element types for which an enclosed area can ever be meaningful */
+const AREA_ELEMENT_TYPES = new Set<ExcalidrawElement["type"]>([
+  "rectangle",
+  "diamond",
+  "ellipse",
+  "line",
+  "freedraw",
+]);
+
+/**
+ * The area enclosed by an element's outline, in scene units squared,
+ * rotation-invariant (rotating a shape doesn't change how much area it
+ * covers). Returns `null` for elements that don't enclose a region (e.g.
+ * an open line/arrow, or a freedraw stroke that isn't a closed loop),
+ * since reporting an area for those would be misleading.
+ */
+export const getElementArea = (
+  element: ExcalidrawElement,
+  elementsMap: ElementsMap,
+): number | null => {
+  if (!AREA_ELEMENT_TYPES.has(element.type)) {
+    return null;
+  }
+
+  const shape = getElementShape<GlobalPoint>(element, elementsMap);
+
+  switch (shape.type) {
+    case "polygon":
+      return polygonArea(shape.data);
+    case "ellipse":
+      return Math.PI * shape.data.halfWidth * shape.data.halfHeight;
+    default:
+      return null;
+  }
+};
