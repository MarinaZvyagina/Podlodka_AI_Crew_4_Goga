+import { polygonArea, round } from "@excalidraw/math";
+
+import { isPathALoop } from "@excalidraw/element";
+
+import type { NonDeletedExcalidrawElement } from "@excalidraw/element/types";
+
+import { t } from "../../i18n";
+
+// Area is only meaningful for shapes that enclose a region. Rotation doesn't
+// change it, so we can work entirely in each element's local (unrotated)
+// space: width/height for the bounding-box-based shapes, and the raw points
+// (shoelace formula) for line/freedraw, which are rotation-invariant too.
+export const getElementArea = (
+  element: NonDeletedExcalidrawElement,
+): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    case "line":
+    case "freedraw":
+      return isPathALoop(element.points) ? polygonArea(element.points) : null;
+    default:
+      return null;
+  }
+};
+
+interface AreaProps {
+  element: NonDeletedExcalidrawElement;
+}
+
+const Area = ({ element }: AreaProps) => {
+  const area = getElementArea(element);
+
+  if (area === null) {
+    return null;
+  }
+
+  return (
+    <div className="drag-input-container" data-testid="Ar">
+      <div className="drag-input-label" title={t("stats.area")}>
+        Ar
+      </div>
+      <div className="drag-input" aria-label={t("stats.area")}>
+        {round(area, 2)}
+      </div>
+    </div>
+  );
+};
+
+export default Area;
