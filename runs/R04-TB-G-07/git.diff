+describe("stats: area", () => {
+  beforeEach(async () => {
+    localStorage.clear();
+    renderStaticScene.mockClear();
+    reseed(7);
+    setDateTimeForTests("201933152653");
+
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+
+    API.setElements([]);
+
+    fireEvent.contextMenu(GlobalTestState.interactiveCanvas, {
+      button: 2,
+      clientX: 1,
+      clientY: 1,
+    });
+    const contextMenu = UI.queryContextMenu();
+    fireEvent.click(queryByTestId(contextMenu!, "stats")!);
+    stats = UI.queryStats();
+  });
+
+  beforeAll(() => {
+    mockBoundingClientRect();
+  });
+
+  afterAll(() => {
+    restoreOriginalGetBoundingClientRect();
+  });
+
+  const selectElement = (element: NonDeletedExcalidrawElement) => {
+    API.setElements([element]);
+    API.setSelectedElements([element]);
+    elementStats = stats?.querySelector("#elementStats");
+  };
+
+  const getAreaRowValue = () => {
+    const rows = elementStats?.querySelectorAll(".exc-stats__row") ?? [];
+    for (const row of Array.from(rows)) {
+      const [label, value] = row.querySelectorAll(":scope > div");
+      if (label?.textContent === t("stats.area")) {
+        return value?.textContent;
+      }
+    }
+    return undefined;
+  };
+
+  it("shows width * height for a rectangle", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 200,
+      height: 100,
+    });
+    selectElement(rectangle);
+    expect(getAreaRowValue()).toBe("20000");
+  });
+
+  it("is unaffected by rotation", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 200,
+      height: 100,
+      angle: degreesToRadians(37 as Degrees),
+    });
+    selectElement(rectangle);
+    expect(getAreaRowValue()).toBe("20000");
+  });
+
+  it("shows (width * height) / 2 for a diamond", () => {
+    const diamond = API.createElement({
+      type: "diamond",
+      width: 200,
+      height: 100,
+    });
+    selectElement(diamond);
+    expect(getAreaRowValue()).toBe("10000");
+  });
+
+  it("shows pi * (width / 2) * (height / 2) for an ellipse", () => {
+    const ellipse = API.createElement({
+      type: "ellipse",
+      width: 200,
+      height: 100,
+    });
+    selectElement(ellipse);
+    expect(getAreaRowValue()).toBe(round(Math.PI * 100 * 50, 2).toString());
+  });
+
+  it("omits the area readout for a text element", () => {
+    const text = API.createElement({
+      type: "text",
+      text: "hello",
+      width: 100,
+      height: 25,
+    });
+    selectElement(text);
+    expect(getAreaRowValue()).toBeUndefined();
+  });
+
+  it("omits the area readout for an open line", () => {
+    const line = API.createElement({
+      type: "line",
+      points: [pointFrom(0, 0), pointFrom(100, 0), pointFrom(50, 80)],
+    });
+    selectElement(line);
+    expect(getAreaRowValue()).toBeUndefined();
+  });
+
+  it("shows the polygon area for a closed, filled line", () => {
+    const line = API.createElement({
+      type: "line",
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(50, 80),
+        pointFrom(0, 0),
+      ],
+      backgroundColor: "#ffc9c9",
+    });
+    selectElement(line);
+    expect(getAreaRowValue()).toBe("4000");
+  });
+
+  it("omits the area readout for an arrow even when closed and filled", () => {
+    const arrow = API.createElement({
+      type: "arrow",
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(50, 80),
+        pointFrom(0, 0),
+      ],
+      backgroundColor: "#ffc9c9",
+    });
+    selectElement(arrow);
+    expect(getAreaRowValue()).toBeUndefined();
+  });
+});
