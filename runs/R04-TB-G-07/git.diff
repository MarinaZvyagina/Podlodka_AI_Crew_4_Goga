+import { polygonArea } from "@excalidraw/math";
+
+import { shouldTestInside } from "./collision";
+
+import type { ExcalidrawElement } from "./types";
+
+/**
+ * Returns the area enclosed by an element, or `null` if the element has no
+ * well-defined enclosed region (e.g. an open line/arrow, a freedraw stroke
+ * that isn't a closed+filled loop, or text).
+ *
+ * Area is computed from the element's own (unrotated) local geometry, which
+ * is correct since rotating or translating a shape never changes its area.
+ */
+export const getElementArea = (element: ExcalidrawElement): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      // a diamond inscribed in a `width` x `height` box is a rhombus with
+      // diagonals `width` and `height`
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    case "line":
+    case "freedraw":
+      // matches the same "closed + filled" definition used for hit-testing
+      // and fill rendering elsewhere in the app
+      return shouldTestInside(element) ? polygonArea(element.points) : null;
+    default:
+      return null;
+  }
+};
