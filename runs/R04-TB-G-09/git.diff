+/**
+ * Returns the area enclosed by the element, or `null` if the element
+ * doesn't enclose a well-defined region (e.g. an open line, an arrow,
+ * or a text label). Rotation-invariant since it's derived from the
+ * element's local (unrotated) geometry.
+ */
+export const getElementArea = (
+  element: NonDeletedExcalidrawElement,
+): number | null => {
+  if (isFreeDrawElement(element)) {
+    return isPathALoop(element.points) ? polygonArea(element.points) : null;
+  }
+
+  if (isLineElement(element)) {
+    return element.polygon ? polygonArea(element.points) : null;
+  }
+
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    default:
+      return null;
+  }
+};
