diff --git a/packages/excalidraw/actions/actionToggleCaptions.tsx b/packages/excalidraw/actions/actionToggleCaptions.tsx
new file mode 100644
index 0000000..e777fe8
--- /dev/null
+++ b/packages/excalidraw/actions/actionToggleCaptions.tsx
@@ -0,0 +1,27 @@
+import { CODES, KEYS } from "@excalidraw/common";
+
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { TextIcon } from "../components/icons";
+
+import { register } from "./register";
+
+export const actionToggleCaptions = register({
+  name: "captions",
+  label: "labels.toggleCaptions",
+  icon: TextIcon,
+  viewMode: true,
+  trackEvent: { category: "canvas" },
+  perform(elements, appState) {
+    return {
+      appState: {
+        ...appState,
+        showCaptions: !this.checked!(appState),
+      },
+      captureUpdate: CaptureUpdateAction.EVENTUALLY,
+    };
+  },
+  checked: (appState) => appState.showCaptions,
+  keyTest: (event) =>
+    !event[KEYS.CTRL_OR_CMD] && event.altKey && event.code === CODES.C,
+});
