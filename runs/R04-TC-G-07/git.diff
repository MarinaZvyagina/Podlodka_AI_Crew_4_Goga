diff --git a/packages/excalidraw/CHANGELOG.md b/packages/excalidraw/CHANGELOG.md
index 705bec3..e08b585 100644
--- a/packages/excalidraw/CHANGELOG.md
+++ b/packages/excalidraw/CHANGELOG.md
@@ -208,6 +208,10 @@ The toolbar UI was rewritten from hidden radio/checkbox inputs to real `<button>
 
 ## Excalidraw Library
 
+### Features
+
+- Added a "Toggle captions" preference (menu item + `Alt+C` shortcut) to instantly hide/show all shape-bound text labels on the canvas. Purely a display toggle — it never touches the underlying text or container elements — and is excluded from exported images, mirroring how grid mode is excluded.
+
 ### Breaking changes
 
 - `updateActiveTool` (from `@excalidraw/common`): the `lastActiveToolBeforeEraser` property of the `data` parameter was renamed to `lastActiveTool` (it was already stored under that name on `appState.activeTool`, and is no longer eraser-specific).
diff --git a/packages/excalidraw/actions/actionToggleHideBoundTexts.tsx b/packages/excalidraw/actions/actionToggleHideBoundTexts.tsx
new file mode 100644
index 0000000..26484a3
--- /dev/null
+++ b/packages/excalidraw/actions/actionToggleHideBoundTexts.tsx
@@ -0,0 +1,31 @@
+import { CODES, KEYS } from "@excalidraw/common";
+
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { TextIcon } from "../components/icons";
+
+import { register } from "./register";
+
+export const actionToggleHideBoundTexts = register({
+  name: "hideBoundTexts",
+  icon: TextIcon,
+  keywords: ["caption", "label", "text"],
+  label: "labels.toggleBoundTexts",
+  viewMode: true,
+  trackEvent: {
+    category: "canvas",
+    predicate: (appState) => appState.hideBoundTextsEnabled,
+  },
+  perform(elements, appState) {
+    return {
+      appState: {
+        ...appState,
+        hideBoundTextsEnabled: !this.checked!(appState),
+      },
+      captureUpdate: CaptureUpdateAction.EVENTUALLY,
+    };
+  },
+  checked: (appState) => appState.hideBoundTextsEnabled,
+  keyTest: (event) =>
+    !event[KEYS.CTRL_OR_CMD] && event.altKey && event.code === CODES.C,
+});
