diff --git a/packages/element/src/snapToGrid.ts b/packages/element/src/snapToGrid.ts
new file mode 100644
index 0000000..f073ce2
--- /dev/null
+++ b/packages/element/src/snapToGrid.ts
@@ -0,0 +1,75 @@
+import { MIN_WIDTH_OR_HEIGHT } from "@excalidraw/common";
+
+import { updateBoundElements } from "./binding";
+import { computeBoundTextPosition, getBoundTextElement } from "./textElement";
+import {
+  isBoundToContainer,
+  isFreeDrawElement,
+  isLinearElement,
+  isTextElement,
+} from "./typeChecks";
+
+import type { Scene } from "./Scene";
+import type { NonDeletedExcalidrawElement } from "./types";
+
+const snapValueToGrid = (value: number, gridSize: number) =>
+  Math.round(value / gridSize) * gridSize;
+
+// these element types derive their visual shape from `points` or from font
+// metrics rather than directly from width/height, so resizing them here
+// would desync their declared bounding box from what's actually rendered —
+// only their position gets snapped.
+const canSnapSize = (element: NonDeletedExcalidrawElement) =>
+  !isLinearElement(element) &&
+  !isFreeDrawElement(element) &&
+  !isTextElement(element);
+
+export const snapElementsToGrid = (
+  targetElements: readonly NonDeletedExcalidrawElement[],
+  gridSize: number,
+  scene: Scene,
+): NonDeletedExcalidrawElement[] => {
+  // bound text snaps along with its container via updateBoundElements below,
+  // so snapping it independently here would fight that and detach it
+  const elementsToSnap = targetElements.filter(
+    (element) => !isBoundToContainer(element),
+  );
+
+  return elementsToSnap.map((element) => {
+    const updates = {
+      x: snapValueToGrid(element.x, gridSize),
+      y: snapValueToGrid(element.y, gridSize),
+      ...(canSnapSize(element)
+        ? {
+            width: Math.max(
+              MIN_WIDTH_OR_HEIGHT,
+              snapValueToGrid(element.width, gridSize),
+            ),
+            height: Math.max(
+              MIN_WIDTH_OR_HEIGHT,
+              snapValueToGrid(element.height, gridSize),
+            ),
+          }
+        : {}),
+    };
+
+    const updatedElement = scene.mutateElement(element, updates);
+
+    // container moved/resized independently of its label — recenter the
+    // label instead of leaving it at its pre-snap offset
+    const elementsMap = scene.getNonDeletedElementsMap();
+    const boundTextElement = getBoundTextElement(updatedElement, elementsMap);
+    if (boundTextElement) {
+      scene.mutateElement(
+        boundTextElement,
+        computeBoundTextPosition(updatedElement, boundTextElement, elementsMap),
+      );
+    }
+
+    updateBoundElements(updatedElement, scene, {
+      simultaneouslyUpdated: elementsToSnap,
+    });
+
+    return updatedElement;
+  });
+};
diff --git a/packages/element/tests/snapToGrid.test.tsx b/packages/element/tests/snapToGrid.test.tsx
new file mode 100644
index 0000000..8ae2cc2
--- /dev/null
+++ b/packages/element/tests/snapToGrid.test.tsx
@@ -0,0 +1,149 @@
+import { actionSnapToGrid } from "@excalidraw/excalidraw/actions";
+import { Excalidraw } from "@excalidraw/excalidraw";
+
+import { API } from "@excalidraw/excalidraw/tests/helpers/api";
+import { Keyboard, Pointer, UI } from "@excalidraw/excalidraw/tests/helpers/ui";
+import { unmountComponent, render } from "@excalidraw/excalidraw/tests/test-utils";
+
+import type { NonDeletedExcalidrawElement } from "@excalidraw/element/types";
+
+const mouse = new Pointer("mouse");
+const { h } = window;
+
+describe("snapping elements to grid", () => {
+  beforeEach(async () => {
+    unmountComponent();
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+    API.setAppState({ gridSize: 20 });
+  });
+
+  it("snaps position and size of a selected element to the nearest grid line", () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 8,
+      width: 47,
+      height: 33,
+    });
+    API.setElements([rect]);
+    API.setSelectedElements([rect]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated = API.getElement(rect);
+    expect(updated.x).toEqual(20);
+    expect(updated.y).toEqual(0);
+    expect(updated.width).toEqual(40);
+    expect(updated.height).toEqual(40);
+  });
+
+  it("snaps every element independently, not as a single group", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 9,
+      y: 9,
+      width: 100,
+      height: 100,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 31,
+      y: 31,
+      width: 100,
+      height: 100,
+    });
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([rect1, rect2]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect1).x).toEqual(0);
+    expect(API.getElement(rect1).y).toEqual(0);
+    expect(API.getElement(rect2).x).toEqual(40);
+    expect(API.getElement(rect2).y).toEqual(40);
+  });
+
+  it("applies to every element on the canvas when nothing is selected", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 9,
+      y: 9,
+      width: 100,
+      height: 100,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 31,
+      y: 31,
+      width: 100,
+      height: 100,
+    });
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect1).x).toEqual(0);
+    expect(API.getElement(rect1).y).toEqual(0);
+    expect(API.getElement(rect2).x).toEqual(40);
+    expect(API.getElement(rect2).y).toEqual(40);
+  });
+
+  it("moves a bound text along with its snapped container", () => {
+    const container = API.createElement({
+      type: "rectangle",
+      id: "container",
+      x: 11,
+      y: 11,
+      width: 100,
+      height: 100,
+      boundElements: [{ type: "text", id: "bound-text" }],
+    });
+    const boundText = API.createElement({
+      type: "text",
+      id: "bound-text",
+      x: 31,
+      y: 51,
+      width: 60,
+      height: 20,
+      containerId: container.id,
+    });
+    API.setElements([container, boundText]);
+    API.setSelectedElements([container]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(container).x).toEqual(20);
+    expect(API.getElement(container).y).toEqual(20);
+    // bound text re-centers relative to its container rather than snapping
+    // on its own (which would detach it from the container)
+    expect(API.getElement(boundText).x).toEqual(
+      API.getElement(container).x + 5,
+    );
+  });
+
+  it("reverts the snap in a single undo step", () => {
+    mouse.reset();
+    UI.clickTool("rectangle");
+    mouse.down(9, 9);
+    mouse.up(100, 100);
+
+    mouse.reset();
+    UI.clickTool("rectangle");
+    mouse.down(31, 31);
+    mouse.up(100, 100);
+
+    const [rect1, rect2] = h.elements as NonDeletedExcalidrawElement[];
+
+    API.setSelectedElements([rect1, rect2]);
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect1).x).toEqual(0);
+    expect(API.getElement(rect2).x).toEqual(40);
+
+    Keyboard.undo();
+
+    expect(API.getElement(rect1).x).toEqual(9);
+    expect(API.getElement(rect2).x).toEqual(31);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..ccb84df
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,44 @@
+import { arrayToMap } from "@excalidraw/common";
+
+import {
+  CaptureUpdateAction,
+  snapElementsToGrid,
+  updateFrameMembershipOfSelectedElements,
+} from "@excalidraw/element";
+
+import { gridIcon } from "../components/icons";
+
+import { register } from "./register";
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  keywords: ["grid", "align"],
+  trackEvent: { category: "element" },
+  predicate: (elements, appState, appProps, app) =>
+    app.scene.getNonDeletedElements().length > 0,
+  perform: (elements, appState, _, app) => {
+    const selectedElements = app.scene.getSelectedElements(appState);
+    const targetElements =
+      selectedElements.length > 0
+        ? selectedElements
+        : app.scene.getNonDeletedElements();
+
+    const updatedElementsMap = arrayToMap(
+      snapElementsToGrid(targetElements, appState.gridSize, app.scene),
+    );
+
+    return {
+      appState,
+      elements: updateFrameMembershipOfSelectedElements(
+        elements.map(
+          (element) => updatedElementsMap.get(element.id) || element,
+        ),
+        appState,
+        app,
+      ),
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
