@@ -0,0 +1,62 @@
+import { updateBoundElements } from "./binding";
+import { resizeSingleElement } from "./resizeElements";
+import { isBoundToContainer } from "./typeChecks";
+
+import type { Scene } from "./Scene";
+import type { NonDeletedExcalidrawElement } from "./types";
+
+const snapValueToGrid = (value: number, gridSize: number) =>
+  Math.round(value / gridSize) * gridSize;
+
+/**
+ * Snaps the position and size of each of the given elements to the grid
+ * independently, as if each element had been nudged into place by hand with
+ * grid snapping enabled. Bound text elements are skipped since they're
+ * repositioned together with their container.
+ */
+export const snapElementsToGrid = (
+  targetElements: readonly NonDeletedExcalidrawElement[],
+  scene: Scene,
+  gridSize: number,
+): NonDeletedExcalidrawElement[] => {
+  const elementsToSnap = targetElements.filter(
+    (element) => !isBoundToContainer(element),
+  );
+
+  return elementsToSnap.map((element) => {
+    const snapped = scene.mutateElement(element, {
+      x: snapValueToGrid(element.x, gridSize),
+      y: snapValueToGrid(element.y, gridSize),
+    });
+
+    const nextWidth = Math.max(
+      gridSize,
+      snapValueToGrid(snapped.width, gridSize),
+    );
+    const nextHeight = Math.max(
+      gridSize,
+      snapValueToGrid(snapped.height, gridSize),
+    );
+
+    if (nextWidth !== snapped.width || nextHeight !== snapped.height) {
+      // keeps the just-snapped top-left corner fixed and only adjusts
+      // width/height, which also takes care of bound text and linear
+      // element points, and re-routes bound arrows
+      resizeSingleElement(
+        nextWidth,
+        nextHeight,
+        snapped,
+        snapped,
+        scene.getNonDeletedElementsMap(),
+        scene,
+        "se",
+      );
+    } else {
+      updateBoundElements(snapped, scene, {
+        simultaneouslyUpdated: elementsToSnap,
+      });
+    }
+
+    return snapped;
+  });
+};
diff --git a/packages/excalidraw/actions/actionSnapToGrid.tsx b/packages/excalidraw/actions/actionSnapToGrid.tsx
