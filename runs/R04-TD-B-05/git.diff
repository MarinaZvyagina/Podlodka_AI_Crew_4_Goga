@@ -0,0 +1,47 @@
+import { arrayToMap } from "@excalidraw/common";
+
+import { CaptureUpdateAction, snapElementsToGrid } from "@excalidraw/element";
+
+import type { ExcalidrawElement } from "@excalidraw/element/types";
+
+import { magnetIcon } from "../components/icons";
+
+import { register } from "./register";
+
+import type { AppClassProperties, AppState } from "../types";
+
+const snapSelectionToGrid = (
+  elements: readonly ExcalidrawElement[],
+  appState: Readonly<AppState>,
+  app: AppClassProperties,
+) => {
+  const selectedElements = app.scene.getSelectedElements(appState);
+  const targetElements =
+    selectedElements.length > 0
+      ? selectedElements
+      : app.scene.getNonDeletedElements();
+
+  const snappedElementsMap = arrayToMap(
+    snapElementsToGrid(targetElements, app.scene, appState.gridSize),
+  );
+
+  return elements.map(
+    (element) => snappedElementsMap.get(element.id) || element,
+  );
+};
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: magnetIcon,
+  trackEvent: { category: "element" },
+  predicate: (elements, appState, appProps, app) =>
+    app.scene.getNonDeletedElements().length > 0,
+  perform: (elements, appState, _, app) => {
+    return {
+      appState,
+      elements: snapSelectionToGrid(elements, appState, app),
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
