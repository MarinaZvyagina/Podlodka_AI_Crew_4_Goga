diff --git a/packages/excalidraw/tests/snapToGrid.test.tsx b/packages/excalidraw/tests/snapToGrid.test.tsx
new file mode 100644
index 0000000..aeeb095
--- /dev/null
+++ b/packages/excalidraw/tests/snapToGrid.test.tsx
@@ -0,0 +1,103 @@
+import { KEYS } from "@excalidraw/common";
+
+import type { NonDeletedExcalidrawElement } from "@excalidraw/element/types";
+
+import { actionSnapToGrid } from "../actions";
+import { Excalidraw } from "../index";
+
+import { API } from "./helpers/api";
+import { Keyboard, UI } from "./helpers/ui";
+import { GlobalTestState, render, unmountComponent } from "./test-utils";
+
+import type { NormalizedZoomValue } from "../types";
+
+const { h } = window;
+
+beforeEach(async () => {
+  unmountComponent();
+
+  localStorage.clear();
+  sessionStorage.clear();
+
+  Object.assign(document, {
+    elementFromPoint: () => GlobalTestState.canvas,
+  });
+  await render(<Excalidraw handleKeyboardGlobally={true} />);
+  API.setAppState({ zoom: { value: 1 as NormalizedZoomValue }, gridSize: 20 });
+});
+
+describe("snap to grid action", () => {
+  it("snaps position and size of selected elements to the nearest grid line", () => {
+    const rectangle = UI.createElement("rectangle", {
+      x: 11,
+      y: 24,
+      width: 47,
+      height: 33,
+    });
+    const untouched = UI.createElement("rectangle", {
+      x: 200,
+      y: 200,
+      width: 30,
+      height: 30,
+    });
+    API.setSelectedElements([rectangle.get()] as NonDeletedExcalidrawElement[]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(rectangle.x).toBe(20);
+    expect(rectangle.y).toBe(20);
+    expect(rectangle.width).toBe(40);
+    expect(rectangle.height).toBe(40);
+
+    // unselected elements are left untouched
+    expect(untouched.x).toBe(200);
+    expect(untouched.y).toBe(200);
+    expect(untouched.width).toBe(30);
+    expect(untouched.height).toBe(30);
+  });
+
+  it("snaps every element independently when nothing is selected", () => {
+    const a = UI.createElement("rectangle", {
+      x: 11,
+      y: 11,
+      width: 11,
+      height: 11,
+    });
+    const b = UI.createElement("ellipse", {
+      x: 54,
+      y: 6,
+      width: 23,
+      height: 23,
+    });
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect([a.x, a.y, a.width, a.height]).toEqual([20, 20, 20, 20]);
+    expect([b.x, b.y, b.width, b.height]).toEqual([60, 0, 20, 20]);
+  });
+
+  it("is undoable in a single step", () => {
+    const rectangle = UI.createElement("rectangle", {
+      x: 11,
+      y: 24,
+      width: 47,
+      height: 33,
+    });
+    API.setSelectedElements([rectangle.get()] as NonDeletedExcalidrawElement[]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(h.elements[0].x).toBe(20);
+    expect(h.elements[0].y).toBe(20);
+
+    Keyboard.withModifierKeys({ ctrl: true }, () => {
+      Keyboard.keyPress(KEYS.Z);
+    });
+
+    expect(h.elements[0].x).toBe(11);
+    expect(h.elements[0].y).toBe(24);
+    expect(h.elements[0].width).toBe(47);
+    expect(h.elements[0].height).toBe(33);
+  });
+});
