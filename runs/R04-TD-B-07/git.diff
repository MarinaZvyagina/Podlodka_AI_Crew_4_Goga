index 0000000..50de2bd
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
@@ -0,0 +1,143 @@
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { render } from "../tests/test-utils";
+
+import { createUndoAction } from "./actionHistory";
+import { actionSnapToGrid } from "./actionSnapToGrid";
+
+const { h } = window;
+
+describe("snap to grid action", () => {
+  beforeEach(async () => {
+    await render(<Excalidraw initialData={{ appState: { gridSize: 20 } }} />);
+  });
+
+  it("snaps position and size of each selected element independently, not as a group", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      id: "rect1",
+      x: 11,
+      y: 9,
+      width: 47,
+      height: 53,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      id: "rect2",
+      x: 108,
+      y: 4,
+      width: 23,
+      height: 12,
+    });
+
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([rect1, rect2]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updatedRect1 = API.getElement(rect1);
+    expect(updatedRect1.x).toBe(20);
+    expect(updatedRect1.y).toBe(0);
+    expect(updatedRect1.width).toBe(40);
+    expect(updatedRect1.height).toBe(60);
+
+    const updatedRect2 = API.getElement(rect2);
+    expect(updatedRect2.x).toBe(100);
+    expect(updatedRect2.y).toBe(0);
+    expect(updatedRect2.width).toBe(20);
+    expect(updatedRect2.height).toBe(20);
+  });
+
+  it("applies to every element on the canvas when nothing is selected", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      id: "rect1",
+      x: 11,
+      y: 9,
+      width: 47,
+      height: 53,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      id: "rect2",
+      x: 108,
+      y: 4,
+      width: 23,
+      height: 12,
+    });
+
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect1).x).toBe(20);
+    expect(API.getElement(rect2).x).toBe(100);
+  });
+
+  it("does not move locked elements", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      id: "rect1",
+      x: 11,
+      y: 9,
+      width: 47,
+      height: 53,
+      locked: true,
+    });
+
+    API.setElements([rect1]);
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updatedRect1 = API.getElement(rect1);
+    expect(updatedRect1.x).toBe(11);
+    expect(updatedRect1.y).toBe(9);
+  });
+
+  it("undoes the snap in a single step", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      id: "rect1",
+      x: 11,
+      y: 9,
+      width: 47,
+      height: 53,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      id: "rect2",
+      x: 108,
+      y: 4,
+      width: 23,
+      height: 12,
+    });
+
+    API.updateScene({
+      elements: [rect1, rect2],
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    });
+    API.setSelectedElements([rect1, rect2]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect1).x).toBe(20);
+    expect(API.getElement(rect2).x).toBe(100);
+
+    const undoAction = createUndoAction(h.history);
+    API.executeAction(undoAction);
+
+    expect(API.getElement(rect1).x).toBe(11);
+    expect(API.getElement(rect1).y).toBe(9);
+    expect(API.getElement(rect1).width).toBe(47);
+    expect(API.getElement(rect1).height).toBe(53);
+
+    expect(API.getElement(rect2).x).toBe(108);
+    expect(API.getElement(rect2).y).toBe(4);
+    expect(API.getElement(rect2).width).toBe(23);
+    expect(API.getElement(rect2).height).toBe(12);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.tsx b/packages/excalidraw/actions/actionSnapToGrid.tsx
new file mode 100644
index 0000000..ab68b42
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.tsx
@@ -0,0 +1,113 @@
+import {
+  CaptureUpdateAction,
+  getBoundTextElement,
+  getNonDeletedElements,
+  handleBindTextResize,
+  isFreeDrawElement,
+  isLinearElement,
+  isTextElement,
+  rescalePointsInElement,
+  updateBoundElements,
+} from "@excalidraw/element";
+
+import { getGridPoint } from "@excalidraw/common";
+
+import type { Scene } from "@excalidraw/element";
+import type {
+  ExcalidrawElement,
+  NonDeletedExcalidrawElement,
+} from "@excalidraw/element/types";
+
+import { getSelectedElements } from "../scene";
+
+import { register } from "./register";
+
+import type { AppState, NullableGridSize } from "../types";
+
+// avoid collapsing an element's width/height to nothing when rounding down
+const MIN_SNAPPED_DIMENSION = 1;
+
+const getSnapToGridTargets = (
+  elements: readonly ExcalidrawElement[],
+  appState: Readonly<AppState>,
+) => {
+  const selectedElements = getSelectedElements(elements, appState);
+  const candidates =
+    selectedElements.length > 0
+      ? selectedElements
+      : getNonDeletedElements(elements);
+
+  return candidates.filter(
+    (element) =>
+      // locked elements are protected from edits, including this one
+      !element.locked &&
+      // bound labels snap along with their container, not independently
+      !(isTextElement(element) && element.containerId),
+  );
+};
+
+const getSnappedDimension = (value: number, gridSize: number) => {
+  if (value === 0) {
+    // preserve intentionally zero-width/height elements, e.g. straight
+    // vertical/horizontal lines and arrows
+    return 0;
+  }
+  return Math.max(
+    MIN_SNAPPED_DIMENSION,
+    Math.round(value / gridSize) * gridSize,
+  );
+};
+
+const snapElementToGrid = (
+  element: NonDeletedExcalidrawElement,
+  gridSize: number,
+  scene: Scene,
+) => {
+  const [nextX, nextY] = getGridPoint(
+    element.x,
+    element.y,
+    gridSize as NullableGridSize,
+  );
+
+  if (isTextElement(element)) {
+    // text dimensions are derived from font metrics, not free-form geometry
+    scene.mutateElement(element, { x: nextX, y: nextY });
+  } else {
+    const nextWidth = getSnappedDimension(element.width, gridSize);
+    const nextHeight = getSnappedDimension(element.height, gridSize);
+
+    const sizeUpdate =
+      isLinearElement(element) || isFreeDrawElement(element)
+        ? rescalePointsInElement(element, nextWidth, nextHeight, true)
+        : { width: nextWidth, height: nextHeight };
+
+    scene.mutateElement(element, { x: nextX, y: nextY, ...sizeUpdate });
+  }
+
+  if (getBoundTextElement(element, scene.getNonDeletedElementsMap())) {
+    handleBindTextResize(element, scene, "nw");
+  }
+
+  updateBoundElements(element, scene);
+};
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  keywords: ["snap", "grid", "align to grid"],
+  trackEvent: { category: "element" },
+  predicate: (elements) => getNonDeletedElements(elements).length > 0,
+  perform: (elements, appState, _, app) => {
+    const targets = getSnapToGridTargets(elements, appState);
+
+    targets.forEach((element) => {
+      snapElementToGrid(element, appState.gridSize, app.scene);
+    });
+
+    return {
+      elements,
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
