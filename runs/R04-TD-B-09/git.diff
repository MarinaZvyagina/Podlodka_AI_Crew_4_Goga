diff --git a/packages/element/src/snapToGrid.ts b/packages/element/src/snapToGrid.ts
new file mode 100644
index 0000000..b9754f5
--- /dev/null
+++ b/packages/element/src/snapToGrid.ts
@@ -0,0 +1,71 @@
+import { getGridPoint, MIN_WIDTH_OR_HEIGHT } from "@excalidraw/common";
+
+import type { NullableGridSize } from "@excalidraw/excalidraw/types";
+
+import { updateBoundElements } from "./binding";
+import { getElementBounds } from "./bounds";
+import { resizeSingleElement } from "./resizeElements";
+import { isElbowArrow } from "./typeChecks";
+
+import type { Scene } from "./Scene";
+import type { NonDeletedExcalidrawElement } from "./types";
+
+/**
+ * Snaps each element's position and size to the nearest grid line
+ * independently, as if it had been nudged into place by hand with grid
+ * snapping enabled. Elements are processed one at a time rather than as a
+ * single group, so unrelated shapes don't shift relative to one another.
+ */
+export const snapElementsToGrid = (
+  selectedElements: readonly NonDeletedExcalidrawElement[],
+  scene: Scene,
+  gridSize: NullableGridSize,
+): NonDeletedExcalidrawElement[] => {
+  if (!gridSize) {
+    return selectedElements as NonDeletedExcalidrawElement[];
+  }
+
+  const elementsMap = scene.getNonDeletedElementsMap();
+
+  return selectedElements.map((element) => {
+    // an elbow arrow bound on either end has its points fully derived from
+    // the elements it connects to, so there's nothing of its own to snap
+    if (isElbowArrow(element) && (element.startBinding || element.endBinding)) {
+      return element;
+    }
+
+    // bounds in the element's own (unrotated) coordinate space, so rotation
+    // doesn't distort the snapped position/size
+    const [x1, y1, x2, y2] = getElementBounds(element, elementsMap, true);
+    const [snappedX1, snappedY1] = getGridPoint(x1, y1, gridSize);
+    const [snappedX2, snappedY2] = getGridPoint(x2, y2, gridSize);
+
+    const movedElement = scene.mutateElement(element, {
+      x: element.x + (snappedX1 - x1),
+      y: element.y + (snappedY1 - y1),
+    });
+
+    updateBoundElements(movedElement, scene, {
+      simultaneouslyUpdated: selectedElements,
+    });
+
+    const nextWidth = Math.max(MIN_WIDTH_OR_HEIGHT, snappedX2 - snappedX1);
+    const nextHeight = Math.max(MIN_WIDTH_OR_HEIGHT, snappedY2 - snappedY1);
+
+    if (nextWidth === x2 - x1 && nextHeight === y2 - y1) {
+      return movedElement;
+    }
+
+    resizeSingleElement(
+      nextWidth,
+      nextHeight,
+      movedElement,
+      movedElement,
+      elementsMap,
+      scene,
+      "se",
+    );
+
+    return movedElement;
+  });
+};
diff --git a/packages/excalidraw/actions/actionSnapToGrid.test.tsx b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
new file mode 100644
index 0000000..27b3d8f
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
@@ -0,0 +1,106 @@
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { Keyboard } from "../tests/helpers/ui";
+import { render } from "../tests/test-utils";
+
+import { actionSnapToGrid } from "./actionSnapToGrid";
+
+const { h } = window;
+
+describe("snap to grid", () => {
+  it("snaps the position and size of selected elements independently to the nearest grid line", async () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      id: "rect1",
+      x: 13,
+      y: 13,
+      width: 27,
+      height: 27,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      id: "rect2",
+      x: 205,
+      y: 305,
+      width: 90,
+      height: 90,
+    });
+
+    await render(<Excalidraw initialData={{ elements: [rect1, rect2] }} />);
+
+    API.setSelectedElements([rect1, rect2]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const snappedRect1 = h.elements.find((el) => el.id === "rect1")!;
+    const snappedRect2 = h.elements.find((el) => el.id === "rect2")!;
+
+    // rounded to the nearest grid line (default grid size is 20), not moved
+    // uniformly as a group
+    expect(snappedRect1.x).toBe(20);
+    expect(snappedRect1.y).toBe(20);
+    expect(snappedRect1.width).toBe(20);
+    expect(snappedRect1.height).toBe(20);
+
+    expect(snappedRect2.x).toBe(200);
+    expect(snappedRect2.y).toBe(300);
+    expect(snappedRect2.width).toBe(100);
+    expect(snappedRect2.height).toBe(100);
+  });
+
+  it("applies to every element on the canvas when nothing is selected", async () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      id: "rect1",
+      x: 13,
+      y: 13,
+      width: 27,
+      height: 27,
+    });
+
+    await render(<Excalidraw initialData={{ elements: [rect1] }} />);
+
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const snappedRect1 = h.elements.find((el) => el.id === "rect1")!;
+
+    expect(snappedRect1.x).toBe(20);
+    expect(snappedRect1.y).toBe(20);
+    expect(snappedRect1.width).toBe(20);
+    expect(snappedRect1.height).toBe(20);
+  });
+
+  it("reverts the snap in a single undo step", async () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      id: "rect1",
+      x: 13,
+      y: 13,
+      width: 27,
+      height: 27,
+    });
+
+    await render(
+      <Excalidraw
+        handleKeyboardGlobally={true}
+        initialData={{ elements: [rect1] }}
+      />,
+    );
+
+    API.setSelectedElements([rect1]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(h.elements.find((el) => el.id === "rect1")!.x).toBe(20);
+
+    Keyboard.undo();
+
+    const revertedRect1 = h.elements.find((el) => el.id === "rect1")!;
+    expect(revertedRect1.x).toBe(13);
+    expect(revertedRect1.y).toBe(13);
+    expect(revertedRect1.width).toBe(27);
+    expect(revertedRect1.height).toBe(27);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.tsx b/packages/excalidraw/actions/actionSnapToGrid.tsx
new file mode 100644
index 0000000..e1f0b79
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.tsx
@@ -0,0 +1,62 @@
+import { arrayToMap } from "@excalidraw/common";
+
+import {
+  CaptureUpdateAction,
+  getNonDeletedElements,
+  isBoundToContainer,
+  snapElementsToGrid,
+  updateFrameMembershipOfSelectedElements,
+} from "@excalidraw/element";
+
+import type { ExcalidrawElement } from "@excalidraw/element/types";
+
+import { gridIcon } from "../components/icons";
+
+import { register } from "./register";
+
+import type { AppClassProperties, AppState, NullableGridSize } from "../types";
+
+const snapSelectedOrAllElementsToGrid = (
+  elements: readonly ExcalidrawElement[],
+  appState: Readonly<AppState>,
+  app: AppClassProperties,
+) => {
+  const selectedElements = app.scene.getSelectedElements(appState);
+
+  const targetElements =
+    selectedElements.length > 0
+      ? selectedElements
+      : getNonDeletedElements(elements).filter(
+          (element) => !element.locked && !isBoundToContainer(element),
+        );
+
+  const updatedElements = snapElementsToGrid(
+    targetElements,
+    app.scene,
+    appState.gridSize as NullableGridSize,
+  );
+
+  const updatedElementsMap = arrayToMap(updatedElements);
+
+  return updateFrameMembershipOfSelectedElements(
+    elements.map((element) => updatedElementsMap.get(element.id) || element),
+    appState,
+    app,
+  );
+};
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  keywords: ["snap", "grid", "align"],
+  trackEvent: { category: "element" },
+  predicate: (elements) => getNonDeletedElements(elements).length > 0,
+  perform: (elements, appState, _, app) => {
+    return {
+      appState,
+      elements: snapSelectedOrAllElementsToGrid(elements, appState, app),
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
