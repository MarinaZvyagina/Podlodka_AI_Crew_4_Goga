diff --git a/packages/element/src/snapToGrid.ts b/packages/element/src/snapToGrid.ts
new file mode 100644
index 0000000..9bfe062
--- /dev/null
+++ b/packages/element/src/snapToGrid.ts
@@ -0,0 +1,93 @@
+import { getFontString, getGridPoint } from "@excalidraw/common";
+
+import type { NullableGridSize } from "@excalidraw/excalidraw/types";
+
+import { updateBoundElements } from "./binding";
+import { getBoundTextElement, handleBindTextResize } from "./textElement";
+import {
+  getApproxMinLineHeight,
+  getApproxMinLineWidth,
+} from "./textMeasurements";
+import { isBindableElement, isTextElement } from "./typeChecks";
+
+import type { Scene } from "./Scene";
+import type { NonDeletedExcalidrawElement } from "./types";
+
+// Text sizes itself from its content, and linear/freedraw elements encode
+// their shape in `points`, so snapping their width/height like a plain
+// rectangle would distort them. Only rectanguloid/ellipse-like containers
+// get their size snapped; every element still gets its position snapped.
+const isSizeSnappable = (element: NonDeletedExcalidrawElement) =>
+  isBindableElement(element) && !isTextElement(element);
+
+export const snapElementsToGrid = (
+  targetElements: readonly NonDeletedExcalidrawElement[],
+  gridSize: NullableGridSize,
+  scene: Scene,
+): NonDeletedExcalidrawElement[] => {
+  if (!gridSize) {
+    return [];
+  }
+
+  return targetElements.map((element) => {
+    const [nextX, nextY] = getGridPoint(element.x, element.y, gridSize);
+
+    if (!isSizeSnappable(element)) {
+      const updated = scene.mutateElement(element, { x: nextX, y: nextY });
+      updateBoundElements(updated, scene, {
+        simultaneouslyUpdated: targetElements,
+      });
+      return updated;
+    }
+
+    const [right, bottom] = getGridPoint(
+      nextX + element.width,
+      nextY + element.height,
+      gridSize,
+    );
+
+    let nextWidth = right - nextX;
+    let nextHeight = bottom - nextY;
+    if (nextWidth <= 0) {
+      nextWidth = element.width;
+    }
+    if (nextHeight <= 0) {
+      nextHeight = element.height;
+    }
+
+    const boundTextElement = getBoundTextElement(
+      element,
+      scene.getNonDeletedElementsMap(),
+    );
+    if (boundTextElement) {
+      nextWidth = Math.max(
+        nextWidth,
+        getApproxMinLineWidth(
+          getFontString(boundTextElement),
+          boundTextElement.lineHeight,
+        ),
+      );
+      nextHeight = Math.max(
+        nextHeight,
+        getApproxMinLineHeight(
+          boundTextElement.fontSize,
+          boundTextElement.lineHeight,
+        ),
+      );
+    }
+
+    const updated = scene.mutateElement(element, {
+      x: nextX,
+      y: nextY,
+      width: nextWidth,
+      height: nextHeight,
+    });
+
+    handleBindTextResize(updated, scene, "se");
+    updateBoundElements(updated, scene, {
+      simultaneouslyUpdated: targetElements,
+    });
+
+    return updated;
+  });
+};
diff --git a/packages/element/tests/snapToGrid.test.tsx b/packages/element/tests/snapToGrid.test.tsx
new file mode 100644
index 0000000..f983cb1
