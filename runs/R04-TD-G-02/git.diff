+++ b/packages/element/tests/snapToGrid.test.tsx
@@ -0,0 +1,151 @@
+import { actionSnapToGrid } from "@excalidraw/excalidraw/actions";
+import { defaultLang, setLanguage } from "@excalidraw/excalidraw/i18n";
+import { Excalidraw } from "@excalidraw/excalidraw";
+
+import { API } from "@excalidraw/excalidraw/tests/helpers/api";
+import { Keyboard, UI } from "@excalidraw/excalidraw/tests/helpers/ui";
+import {
+  act,
+  unmountComponent,
+  render,
+} from "@excalidraw/excalidraw/tests/test-utils";
+
+describe("snapping existing shapes to grid", () => {
+  beforeEach(async () => {
+    unmountComponent();
+
+    await act(() => {
+      return setLanguage(defaultLang);
+    });
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+  });
+
+  it("snaps the position and size of a selected rectangle to the nearest grid lines", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 8,
+      width: 47,
+      height: 53,
+    });
+
+    API.setElements([rectangle]);
+    API.setSelectedElements([rectangle]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated = API.getElement(rectangle);
+    expect(updated.x).toEqual(20);
+    expect(updated.y).toEqual(0);
+    expect(updated.width).toEqual(40);
+    expect(updated.height).toEqual(60);
+  });
+
+  it("snaps multiple selected shapes independently rather than as a group", () => {
+    const rectangleA = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 8,
+      width: 47,
+      height: 53,
+    });
+    const rectangleB = API.createElement({
+      type: "rectangle",
+      x: 111,
+      y: 6,
+      width: 20,
+      height: 20,
+    });
+
+    API.setElements([rectangleA, rectangleB]);
+    API.setSelectedElements([rectangleA, rectangleB]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rectangleA).x).toEqual(20);
+    expect(API.getElement(rectangleA).y).toEqual(0);
+    expect(API.getElement(rectangleB).x).toEqual(120);
+    expect(API.getElement(rectangleB).y).toEqual(0);
+  });
+
+  it("applies to every shape on the canvas when nothing is selected", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 8,
+      width: 47,
+      height: 53,
+    });
+
+    API.setElements([rectangle]);
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated = API.getElement(rectangle);
+    expect(updated.x).toEqual(20);
+    expect(updated.y).toEqual(0);
+  });
+
+  it("keeps a bound text following its container after snapping", () => {
+    const container = API.createElement({
+      type: "rectangle",
+      id: "container",
+      x: 12,
+      y: 8,
+      width: 47,
+      height: 53,
+      boundElements: [{ type: "text", id: "bound-text" }],
+    });
+    const boundText = API.createElement({
+      type: "text",
+      id: "bound-text",
+      x: 20,
+      y: 25,
+      width: 30,
+      height: 20,
+      containerId: container.id,
+    });
+
+    API.setElements([container, boundText]);
+    API.setSelectedElements([container]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updatedContainer = API.getElement(container);
+    const updatedText = API.getElement(boundText);
+    expect(updatedContainer.x).toEqual(20);
+    expect(updatedContainer.y).toEqual(0);
+    // bound text remains horizontally centered within the resized container
+    expect(updatedText.x).toBeGreaterThanOrEqual(updatedContainer.x);
+    expect(updatedText.x + updatedText.width).toBeLessThanOrEqual(
+      updatedContainer.x + updatedContainer.width,
+    );
+  });
+
+  it("undoes the snap in a single step", () => {
+    // drawn via the UI (rather than API.setElements) so the creation itself
+    // is a real history entry to undo back to
+    const rectangle = UI.createElement("rectangle", {
+      x: 12,
+      y: 8,
+      width: 47,
+      height: 53,
+    });
+
+    const undoStackSizeBeforeSnap = API.getUndoStack().length;
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rectangle).x).toEqual(20);
+    expect(API.getUndoStack().length).toEqual(undoStackSizeBeforeSnap + 1);
+
+    Keyboard.undo();
+
+    const reverted = API.getElement(rectangle);
+    expect(reverted.x).toEqual(12);
+    expect(reverted.y).toEqual(8);
+    expect(reverted.width).toEqual(47);
+    expect(reverted.height).toEqual(53);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..def2ae4
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,66 @@
+import {
+  getNonDeletedElements,
+  isTextElement,
+  snapElementsToGrid,
+  updateFrameMembershipOfSelectedElements,
+} from "@excalidraw/element";
+
+import { arrayToMap } from "@excalidraw/common";
+
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { magnetIcon } from "../components/icons";
+
+import { register } from "./register";
+
+import type { NullableGridSize } from "../types";
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: magnetIcon,
+  keywords: ["grid", "align", "align to grid"],
+  trackEvent: { category: "element" },
+  predicate: (elements) =>
+    getNonDeletedElements(elements).some(
+      (element) => !(isTextElement(element) && element.containerId),
+    ),
+  perform: (elements, appState, _, app) => {
+    if (!appState.gridSize) {
+      return false;
+    }
+
+    const nonDeletedElements = getNonDeletedElements(elements);
+    const selectedElements = app.scene.getSelectedElements(appState);
+    const targetElements = selectedElements.length
+      ? selectedElements
+      : nonDeletedElements.filter(
+          (element) =>
+            !element.locked && !(isTextElement(element) && element.containerId),
+        );
+
+    if (!targetElements.length) {
+      return false;
+    }
+
+    const updatedElements = snapElementsToGrid(
+      targetElements,
+      appState.gridSize as NullableGridSize,
+      app.scene,
+    );
+
+    const updatedElementsMap = arrayToMap(updatedElements);
+
+    return {
+      elements: updateFrameMembershipOfSelectedElements(
+        elements.map(
+          (element) => updatedElementsMap.get(element.id) || element,
+        ),
+        appState,
+        app,
+      ),
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
