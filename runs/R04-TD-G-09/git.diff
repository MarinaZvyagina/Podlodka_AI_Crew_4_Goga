diff --git a/packages/element/src/snapToGrid.ts b/packages/element/src/snapToGrid.ts
new file mode 100644
index 0000000..72a0ed9
--- /dev/null
+++ b/packages/element/src/snapToGrid.ts
@@ -0,0 +1,54 @@
+import { getGridPoint } from "@excalidraw/common";
+
+import type { NullableGridSize } from "@excalidraw/excalidraw/types";
+
+import { updateBoundElements } from "./binding";
+import { resizeSingleElement } from "./resizeElements";
+
+import type { Scene } from "./Scene";
+import type { NonDeletedExcalidrawElement } from "./types";
+
+/**
+ * Snaps each element's position and size independently to the nearest grid
+ * line, matching the result of manually nudging/resizing the element with
+ * grid snapping enabled.
+ */
+export const snapElementsToGrid = (
+  targetElements: readonly NonDeletedExcalidrawElement[],
+  gridSize: number,
+  scene: Scene,
+): NonDeletedExcalidrawElement[] => {
+  const elementsMap = scene.getNonDeletedElementsMap();
+  const nullableGridSize = gridSize as NullableGridSize;
+
+  return targetElements.map((element) => {
+    const [nextX, nextY] = getGridPoint(element.x, element.y, nullableGridSize);
+
+    scene.mutateElement(element, { x: nextX, y: nextY });
+    updateBoundElements(element, scene, {
+      simultaneouslyUpdated: targetElements,
+    });
+
+    // clamp to at least one grid cell so elements can't collapse to 0 size
+    const nextWidth = Math.max(
+      gridSize,
+      Math.round(element.width / gridSize) * gridSize,
+    );
+    const nextHeight = Math.max(
+      gridSize,
+      Math.round(element.height / gridSize) * gridSize,
+    );
+
+    resizeSingleElement(
+      nextWidth,
+      nextHeight,
+      element,
+      element,
+      elementsMap,
+      scene,
+      "se",
+    );
+
+    return element;
+  });
+};
diff --git a/packages/element/tests/snapToGrid.test.tsx b/packages/element/tests/snapToGrid.test.tsx
new file mode 100644
index 0000000..5c129ad
--- /dev/null
+++ b/packages/element/tests/snapToGrid.test.tsx
@@ -0,0 +1,122 @@
+import { actionSnapToGrid } from "@excalidraw/excalidraw/actions";
+import { Excalidraw } from "@excalidraw/excalidraw";
+
+import { API } from "@excalidraw/excalidraw/tests/helpers/api";
+import { Keyboard, Pointer, UI } from "@excalidraw/excalidraw/tests/helpers/ui";
+import {
+  render,
+  unmountComponent,
+} from "@excalidraw/excalidraw/tests/test-utils";
+
+const mouse = new Pointer("mouse");
+
+describe("snap to grid", () => {
+  beforeEach(async () => {
+    unmountComponent();
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+    API.setAppState({ gridSize: 20 });
+  });
+
+  it("snaps the position and size of the selected elements independently", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 3,
+      y: 8,
+      width: 47,
+      height: 53,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 101,
+      y: 12,
+      width: 22,
+      height: 9,
+    });
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([rect1, rect2]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const [updated1, updated2] = API.getSelectedElements();
+
+    expect(updated1.x).toBe(0);
+    expect(updated1.y).toBe(0);
+    expect(updated1.width).toBe(40);
+    expect(updated1.height).toBe(60);
+
+    expect(updated2.x).toBe(100);
+    expect(updated2.y).toBe(20);
+    expect(updated2.width).toBe(20);
+    expect(updated2.height).toBe(20);
+  });
+
+  it("only snaps the selected elements, leaving others untouched", () => {
+    const selected = API.createElement({
+      type: "rectangle",
+      x: 3,
+      y: 8,
+      width: 47,
+      height: 53,
+    });
+    const untouched = API.createElement({
+      type: "rectangle",
+      x: 5,
+      y: 5,
+      width: 33,
+      height: 33,
+    });
+    API.setElements([selected, untouched]);
+    API.setSelectedElements([selected]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getSelectedElements()[0].x).toBe(0);
+    expect(window.h.elements[1].x).toBe(5);
+    expect(window.h.elements[1].width).toBe(33);
+  });
+
+  it("snaps every element when nothing is selected", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 3,
+      y: 8,
+      width: 47,
+      height: 53,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 101,
+      y: 12,
+      width: 22,
+      height: 9,
+    });
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(window.h.elements[0].x).toBe(0);
+    expect(window.h.elements[0].y).toBe(0);
+    expect(window.h.elements[1].x).toBe(100);
+    expect(window.h.elements[1].y).toBe(20);
+  });
+
+  it("undoes the snap in a single step", () => {
+    mouse.reset();
+    UI.clickTool("rectangle");
+    mouse.down(3, 8);
+    mouse.up(47, 53);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(window.h.elements[0].x).toBe(0);
+    expect(window.h.elements[0].width).toBe(40);
+
+    Keyboard.undo();
+
+    expect(window.h.elements[0].x).toBe(3);
+    expect(window.h.elements[0].y).toBe(8);
+    expect(window.h.elements[0].width).toBe(47);
+    expect(window.h.elements[0].height).toBe(53);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.tsx b/packages/excalidraw/actions/actionSnapToGrid.tsx
new file mode 100644
index 0000000..aa5f713
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.tsx
@@ -0,0 +1,76 @@
+import { getNonDeletedElements } from "@excalidraw/element";
+import { isFrameLikeElement, isTextElement } from "@excalidraw/element";
+import { updateFrameMembershipOfSelectedElements } from "@excalidraw/element";
+import { snapElementsToGrid } from "@excalidraw/element";
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { arrayToMap } from "@excalidraw/common";
+
+import type {
+  ExcalidrawElement,
+  NonDeletedExcalidrawElement,
+} from "@excalidraw/element/types";
+
+import { gridIcon } from "../components/icons";
+
+import { register } from "./register";
+
+import type { AppClassProperties, AppState } from "../types";
+
+const getSnapToGridTargetElements = (
+  elements: readonly ExcalidrawElement[],
+  appState: AppState,
+  app: AppClassProperties,
+): NonDeletedExcalidrawElement[] => {
+  const selectedElements = app.scene.getSelectedElements(appState);
+
+  if (selectedElements.length > 0) {
+    return selectedElements.filter((element) => !isFrameLikeElement(element));
+  }
+
+  // nothing selected → snap every shape on the canvas
+  return getNonDeletedElements(elements).filter(
+    (element) =>
+      !element.locked &&
+      !isFrameLikeElement(element) &&
+      !(isTextElement(element) && element.containerId),
+  );
+};
+
+export const snapToGridPredicate = (
+  elements: readonly ExcalidrawElement[],
+  appState: AppState,
+  app: AppClassProperties,
+) => getSnapToGridTargetElements(elements, appState, app).length > 0;
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  trackEvent: { category: "element" },
+  predicate: (elements, appState, appProps, app) =>
+    snapToGridPredicate(elements, appState, app),
+  perform: (elements, appState, _, app) => {
+    const targetElements = getSnapToGridTargetElements(elements, appState, app);
+
+    const updatedElements = snapElementsToGrid(
+      targetElements,
+      appState.gridSize,
+      app.scene,
+    );
+
+    const updatedElementsMap = arrayToMap(updatedElements);
+
+    return {
+      appState,
+      elements: updateFrameMembershipOfSelectedElements(
+        elements.map(
+          (element) => updatedElementsMap.get(element.id) || element,
+        ),
+        appState,
+        app,
+      ),
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
