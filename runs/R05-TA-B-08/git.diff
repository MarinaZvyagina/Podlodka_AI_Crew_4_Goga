diff --git a/lib/promrelabel/relabel.go b/lib/promrelabel/relabel.go
index 95a4031..d200b17 100644
--- a/lib/promrelabel/relabel.go
+++ b/lib/promrelabel/relabel.go
@@ -424,6 +424,15 @@ func (prc *parsedRelabelConfig) apply(labels []prompb.Label, labelsOffset int) [
 		valueStr = strings.ToLower(valueStr)
 		labels = setLabelValue(labels, labelsOffset, prc.TargetLabel, valueStr)
 		return labels
+	case "trim":
+		// Store the whitespace-trimmed value of `source_labels` joined with `separator` at `target_label`
+		bb := relabelBufPool.Get()
+		bb.B = concatLabelValues(bb.B[:0], src, prc.SourceLabels, prc.Separator)
+		valueStr := bytesutil.InternBytes(bb.B)
+		relabelBufPool.Put(bb)
+		valueStr = strings.TrimSpace(valueStr)
+		labels = setLabelValue(labels, labelsOffset, prc.TargetLabel, valueStr)
+		return labels
 	default:
 		logger.Panicf("BUG: unknown `action`: %q", prc.Action)
 		return labels
