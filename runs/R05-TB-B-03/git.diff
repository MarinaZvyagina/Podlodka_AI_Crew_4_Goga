diff --git a/lib/promscrape/scraper_test.go b/lib/promscrape/scraper_test.go
index 8a03fc4..53ce40a 100644
--- a/lib/promscrape/scraper_test.go
+++ b/lib/promscrape/scraper_test.go
@@ -3,6 +3,7 @@ package promscrape
 import (
 	"fmt"
 	"math/rand"
+	"strings"
 	"testing"
 
 	"github.com/VictoriaMetrics/VictoriaMetrics/lib/auth"
@@ -79,3 +80,64 @@ scrape_configs:
     - targets:
         - localhost:8429`, true)
 }
+
+// TestScraperGroupUpdateMaxScrapeTargetsPerJob verifies that scraperGroup.update()
+// enforces the configured max_scrape_targets_per_job limit uniformly regardless of
+// which service discovery mechanism produced the targets (static_configs is used
+// here for simplicity, but the enforcement point - scraperGroup.update - is shared
+// by all discovery mechanisms).
+func TestScraperGroupUpdateMaxScrapeTargetsPerJob(t *testing.T) {
+	f := func(jobName string, targetsCount, maxTargets, wantActive int) {
+		t.Helper()
+
+		pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+		globalStopChan = make(chan struct{})
+		defer close(globalStopChan)
+
+		sg := newScraperGroup(fmt.Sprintf("static_configs_%s", jobName), pushData, globalStopChan)
+		defer sg.stop()
+
+		var sb strings.Builder
+		fmt.Fprintf(&sb, "scrape_configs:\n- job_name: %s\n", jobName)
+		if maxTargets > 0 {
+			fmt.Fprintf(&sb, "  max_scrape_targets_per_job: %d\n", maxTargets)
+		}
+		sb.WriteString("  static_configs:\n  - targets:\n")
+		for i := 0; i < targetsCount; i++ {
+			fmt.Fprintf(&sb, "    - host-%s-%d:8429\n", jobName, i)
+		}
+
+		var cfg Config
+		if err := cfg.parseData([]byte(sb.String()), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sws := cfg.getStaticScrapeWork()
+		sg.update(sws)
+
+		if len(sg.m) != wantActive {
+			t.Fatalf("job=%s: unexpected number of active scrapers; got %d; want %d", jobName, len(sg.m), wantActive)
+		}
+
+		var droppedForJob int
+		for _, dt := range droppedTargetsMap.getTargetsList() {
+			if dt.originalLabels.getJob() == jobName && dt.dropReason == targetDropReasonMaxScrapeTargetsPerJob {
+				droppedForJob++
+			}
+		}
+		wantDropped := targetsCount - wantActive
+		if droppedForJob != wantDropped {
+			t.Fatalf("job=%s: unexpected number of dropped targets with reason=%q; got %d; want %d",
+				jobName, targetDropReasonMaxScrapeTargetsPerJob, droppedForJob, wantDropped)
+		}
+	}
+
+	// A job under the configured limit must be unaffected: all the targets are scraped and none are dropped.
+	f("under-limit", 3, 10, 3)
+
+	// A job over the configured limit must be truncated to the limit, with the excess
+	// reported as dropped targets with the max_scrape_targets_per_job reason.
+	f("over-limit", 10, 3, 3)
+
+	// The default behavior (max_scrape_targets_per_job unset) must be unlimited.
+	f("unlimited", 20, 0, 20)
+}
