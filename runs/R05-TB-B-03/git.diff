diff --git a/lib/promscrape/jobtargetslimiter.go b/lib/promscrape/jobtargetslimiter.go
new file mode 100644
index 0000000..67471a9
--- /dev/null
+++ b/lib/promscrape/jobtargetslimiter.go
@@ -0,0 +1,56 @@
+package promscrape
+
+import "sync"
+
+// jobTargetsLimiter tracks the number of currently active (started) scrape targets
+// per job_name and enforces the configured max_scrape_targets_per_job limit.
+//
+// All the service discovery mechanisms (kubernetes_sd_configs, consul_sd_configs,
+// static_configs, etc.) for a given job_name eventually start their scrapers via
+// scraperGroup.update(), so gating target starts there enforces the limit uniformly
+// regardless of which discovery mechanism produced the targets.
+type jobTargetsLimiter struct {
+	mu sync.Mutex
+	m  map[string]int
+}
+
+var jtLimiter = &jobTargetsLimiter{
+	m: make(map[string]int),
+}
+
+// tryAcquire reserves an active target slot for jobName if the current number
+// of active targets for jobName is below maxTargets.
+//
+// maxTargets <= 0 means the limit is disabled, so the slot is always granted
+// and the internal counter isn't touched.
+//
+// On success (true), the caller must eventually call release(jobName, maxTargets)
+// with the same maxTargets value exactly once, when the corresponding scraper stops.
+func (jtl *jobTargetsLimiter) tryAcquire(jobName string, maxTargets int) bool {
+	if maxTargets <= 0 {
+		return true
+	}
+	jtl.mu.Lock()
+	defer jtl.mu.Unlock()
+	if jtl.m[jobName] >= maxTargets {
+		return false
+	}
+	jtl.m[jobName]++
+	return true
+}
+
+// release frees a previously acquired active target slot for jobName.
+//
+// maxTargets must be the same value passed to the corresponding tryAcquire() call.
+func (jtl *jobTargetsLimiter) release(jobName string, maxTargets int) {
+	if maxTargets <= 0 {
+		return
+	}
+	jtl.mu.Lock()
+	defer jtl.mu.Unlock()
+	if n := jtl.m[jobName]; n > 1 {
+		jtl.m[jobName] = n - 1
+	} else {
+		delete(jtl.m, jobName)
+	}
+}
