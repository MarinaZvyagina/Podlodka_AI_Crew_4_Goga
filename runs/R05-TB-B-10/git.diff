+// TestScraperGroupUpdateMaxScrapeTargets verifies that scraperGroup.update() admits at most
+// max_scrape_targets targets for a given job_name, regardless of the number of discovered targets,
+// and that targets dropped because of the limit are visible via droppedTargetsMap (the same
+// mechanism used for /targets and /service-discovery pages).
+func TestScraperGroupUpdateMaxScrapeTargets(t *testing.T) {
+	f := func(jobName string, maxScrapeTargets, targetsCount, wantAdmitted, wantDropped int) {
+		t.Helper()
+		pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+		globalStopChan = make(chan struct{})
+		defer close(globalStopChan)
+
+		randName := rand.Int()
+		sg := newScraperGroup(fmt.Sprintf("max_scrape_targets_%d", randName), pushData, globalStopChan)
+		defer sg.stop()
+
+		var sb strings.Builder
+		fmt.Fprintf(&sb, "scrape_configs:\n- job_name: %s\n", jobName)
+		if maxScrapeTargets > 0 {
+			fmt.Fprintf(&sb, "  max_scrape_targets: %d\n", maxScrapeTargets)
+		}
+		sb.WriteString("  static_configs:\n    - targets:\n")
+		for i := 0; i < targetsCount; i++ {
+			fmt.Fprintf(&sb, "        - %s-host-%d:8429\n", jobName, i)
+		}
+
+		var cfg Config
+		if err := cfg.parseData([]byte(sb.String()), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sws := cfg.getStaticScrapeWork()
+		if len(sws) != targetsCount {
+			t.Fatalf("unexpected number of parsed targets; got %d; want %d", len(sws), targetsCount)
+		}
+
+		sg.update(sws)
+
+		if len(sg.m) != wantAdmitted {
+			t.Fatalf("unexpected number of admitted targets for job %q; got %d; want %d", jobName, len(sg.m), wantAdmitted)
+		}
+
+		gotDropped := 0
+		for _, dt := range droppedTargetsMap.getTargetsList() {
+			if dt.originalLabels.getJob() == jobName && dt.dropReason == targetDropReasonMaxScrapeTargets {
+				gotDropped++
+			}
+		}
+		if gotDropped != wantDropped {
+			t.Fatalf("unexpected number of targets dropped because of max_scrape_targets for job %q; got %d; want %d", jobName, gotDropped, wantDropped)
+		}
+	}
+	// A job under its max_scrape_targets limit must keep all of its discovered targets.
+	f("under-limit", 10, 5, 5, 0)
+	// A job over its max_scrape_targets limit must be truncated to the limit,
+	// and the excluded targets must show up as dropped targets for that job.
+	f("over-limit", 3, 10, 3, 7)
+	// A job without max_scrape_targets (and no -promscrape.maxScrapeTargetsPerJob flag set)
+	// must remain unlimited by default.
+	f("unlimited", 0, 20, 20, 0)
+}
