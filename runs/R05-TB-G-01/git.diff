diff --git a/lib/promscrape/scraper_test.go b/lib/promscrape/scraper_test.go
index 8a03fc4..6645f66 100644
--- a/lib/promscrape/scraper_test.go
+++ b/lib/promscrape/scraper_test.go
@@ -79,3 +79,64 @@ scrape_configs:
     - targets:
         - localhost:8429`, true)
 }
+
+// TestScraperGroupUpdateMaxScrapeTargets verifies that scraperGroup.update() enforces the
+// per-job max_scrape_targets cap uniformly, regardless of which discovery mechanism (static_configs
+// here) provided the targets, and that excluded targets become visible via droppedTargetsMap.
+func TestScraperGroupUpdateMaxScrapeTargets(t *testing.T) {
+	f := func(maxScrapeTargets, targetsCount, wantActive, wantDropped int) {
+		t.Helper()
+		pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+		globalStopChan = make(chan struct{})
+		defer close(globalStopChan)
+
+		randName := rand.Int()
+		sg := newScraperGroup(fmt.Sprintf("static_configs_%d", randName), pushData, globalStopChan)
+		defer sg.stop()
+
+		jobName := fmt.Sprintf("max-targets-job-%d", randName)
+		var targetsYAML string
+		for i := 0; i < targetsCount; i++ {
+			targetsYAML += fmt.Sprintf("        - 127.0.0.1:%d\n", 20000+i)
+		}
+		cfgData := fmt.Sprintf(`
+scrape_configs:
+- job_name: %s
+  max_scrape_targets: %d
+  static_configs:
+    - targets:
+%s`, jobName, maxScrapeTargets, targetsYAML)
+
+		var cfg Config
+		if err := cfg.parseData([]byte(cfgData), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sws := cfg.getStaticScrapeWork()
+		sg.update(sws)
+
+		if got := len(sg.m); got != wantActive {
+			t.Fatalf("unexpected number of active scrapers; got %d; want %d", got, wantActive)
+		}
+
+		var dropped int
+		for _, dt := range droppedTargetsMap.getTargetsList() {
+			if dt.originalLabels.getJob() != jobName {
+				continue
+			}
+			dropped++
+			if dt.dropReason != targetDropReasonTargetsLimitExceeded {
+				t.Fatalf("unexpected drop reason for excluded target: %q", dt.dropReason)
+			}
+		}
+		if dropped != wantDropped {
+			t.Fatalf("unexpected number of dropped targets; got %d; want %d", dropped, wantDropped)
+		}
+	}
+
+	// default (unlimited) behavior: max_scrape_targets=0 means nothing is dropped.
+	f(0, 5, 5, 0)
+	// a job under the limit must be unaffected.
+	f(10, 5, 5, 0)
+	// a job over the limit must be truncated, with the excluded targets visible as dropped.
+	f(3, 5, 3, 2)
+}
