+func TestConfigGetMaxTargetsByJob(t *testing.T) {
+	f := func(data string, maxTargetsPerJobFlag int, expected map[string]int) {
+		t.Helper()
+		prevFlagValue := *maxTargetsPerJob
+		*maxTargetsPerJob = maxTargetsPerJobFlag
+		defer func() { *maxTargetsPerJob = prevFlagValue }()
+
+		var cfg Config
+		if err := cfg.parseData([]byte(data), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		got := cfg.getMaxTargetsByJob()
+		if !reflect.DeepEqual(got, expected) {
+			t.Fatalf("unexpected result;\ngot\n%v\nwant\n%v", got, expected)
+		}
+	}
+
+	// no limit set anywhere - the job must be absent from the result (unlimited).
+	f(`
+scrape_configs:
+- job_name: foo
+  static_configs:
+  - targets: ["foo.bar:1234"]
+`, 0, map[string]int{})
+
+	// no per-job override - falls back to the global -promscrape.maxTargetsPerJob flag.
+	f(`
+scrape_configs:
+- job_name: foo
+  static_configs:
+  - targets: ["foo.bar:1234"]
+`, 42, map[string]int{"foo": 42})
+
+	// per-job override takes precedence over the global flag.
+	f(`
+scrape_configs:
+- job_name: foo
+  max_targets_per_job: 5
+  static_configs:
+  - targets: ["foo.bar:1234"]
+- job_name: bar
+  static_configs:
+  - targets: ["foo.bar:1234"]
+`, 42, map[string]int{"foo": 5, "bar": 42})
 }
 
