+func TestScraperGroupUpdateWithMaxTargetsLimit(t *testing.T) {
+	pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+	globalStopChan = make(chan struct{})
+	defer close(globalStopChan)
+
+	randName := rand.Int()
+	jobName1 := fmt.Sprintf("job-limit-test-a-%d", randName)
+	jobName2 := fmt.Sprintf("job-limit-test-b-%d", randName)
+
+	setLimit := func(jobName string, n int) {
+		tsmGlobal.mu.Lock()
+		if n > 0 {
+			tsmGlobal.maxTargetsByJob[jobName] = n
+		} else {
+			delete(tsmGlobal.maxTargetsByJob, jobName)
+		}
+		tsmGlobal.mu.Unlock()
+	}
+	excludedCount := func(jobName string) int {
+		tsmGlobal.mu.Lock()
+		defer tsmGlobal.mu.Unlock()
+		return tsmGlobal.excludedByJob[jobName]
+	}
+	defer setLimit(jobName1, 0)
+	defer setLimit(jobName2, 0)
+
+	parseTargets := func(jobName string, targets ...string) []*ScrapeWork {
+		cfgData := fmt.Sprintf("scrape_configs:\n- job_name: %s\n  static_configs:\n  - targets: %s\n",
+			jobName, "[\""+strings.Join(targets, "\", \"")+"\"]")
+		var cfg Config
+		if err := cfg.parseData([]byte(cfgData), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		return cfg.getStaticScrapeWork()
+	}
+
+	// Default (unlimited) behavior: no limit is configured for the job, so all targets are scraped.
+	sg1 := newScraperGroup(fmt.Sprintf("static_configs_unlimited_%d", randName), pushData, globalStopChan)
+	defer sg1.stop()
+	sws := parseTargets(jobName1, "localhost:19001", "localhost:19002", "localhost:19003")
+	sg1.update(sws)
+	if n := len(sg1.m); n != 3 {
+		t.Fatalf("unlimited: unexpected number of started scrapers; got %d, want 3", n)
+	}
+	if n := excludedCount(jobName1); n != 0 {
+		t.Fatalf("unlimited: unexpected number of excluded targets; got %d, want 0", n)
+	}
+
+	// Job under the limit: unaffected, all targets are scraped.
+	setLimit(jobName1, 5)
+	sg1.update(sws)
+	if n := len(sg1.m); n != 3 {
+		t.Fatalf("under limit: unexpected number of started scrapers; got %d, want 3", n)
+	}
+	if n := excludedCount(jobName1); n != 0 {
+		t.Fatalf("under limit: unexpected number of excluded targets; got %d, want 0", n)
+	}
+
+	// Job over the limit: truncated to the limit, the excess is dropped and visible in status.
+	// Use a fresh scraperGroup and a distinct job_name, so the first update() already observes
+	// all 5 targets at once, simulating a discovery source suddenly returning a runaway number
+	// of targets for a job that had no previously-registered targets.
+	setLimit(jobName2, 2)
+	sg2 := newScraperGroup(fmt.Sprintf("static_configs_overlimit_%d", randName), pushData, globalStopChan)
+	defer sg2.stop()
+	sws2 := parseTargets(jobName2, "localhost:19004", "localhost:19005", "localhost:19006", "localhost:19007", "localhost:19008")
+	sg2.update(sws2)
+	if n := len(sg2.m); n != 2 {
+		t.Fatalf("over limit: unexpected number of started scrapers; got %d, want 2", n)
+	}
+	if n := excludedCount(jobName2); n != 3 {
+		t.Fatalf("over limit: unexpected number of excluded targets; got %d, want 3", n)
+	}
+	var droppedForJob int
+	for _, dt := range droppedTargetsMap.getTargetsList() {
+		if dt.originalLabels.getJob() == jobName2 && dt.dropReason == targetDropReasonJobTargetsLimit {
+			droppedForJob++
+		}
+	}
+	if droppedForJob != 3 {
+		t.Fatalf("over limit: unexpected number of targets visible as dropped because of the limit; got %d, want 3", droppedForJob)
+	}
+
+	// Raising the limit again must un-exclude the previously dropped targets.
+	setLimit(jobName2, 5)
+	sg2.update(sws2)
+	if n := len(sg2.m); n != 5 {
+		t.Fatalf("limit raised: unexpected number of started scrapers; got %d, want 5", n)
+	}
+	if n := excludedCount(jobName2); n != 0 {
+		t.Fatalf("limit raised: unexpected number of excluded targets; got %d, want 0", n)
+	}
+}
