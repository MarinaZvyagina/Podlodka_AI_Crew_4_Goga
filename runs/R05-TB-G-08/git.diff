+func TestTargetStatusMapRegister_MaxScrapeTargets(t *testing.T) {
+	newSW := func(jobName string, maxScrapeTargets int) *scrapeWork {
+		return &scrapeWork{
+			Config: &ScrapeWork{
+				jobNameOriginal:  jobName,
+				MaxScrapeTargets: maxScrapeTargets,
+			},
+		}
+	}
+
+	// unlimited (default) - all the targets must be registered
+	t.Run("unlimited", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		for i := 0; i < 10; i++ {
+			if ok := tsm.Register(newSW("unlimited-job", 0)); !ok {
+				t.Fatalf("unexpected registration failure for target %d", i)
+			}
+		}
+		if n := tsm.upByJob["unlimited-job"] + tsm.downByJob["unlimited-job"]; n != 10 {
+			t.Fatalf("unexpected number of registered targets; got %d; want 10", n)
+		}
+	})
+
+	// under the limit - all the targets must be registered
+	t.Run("under limit", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		for i := 0; i < 3; i++ {
+			if ok := tsm.Register(newSW("under-limit-job", 5)); !ok {
+				t.Fatalf("unexpected registration failure for target %d", i)
+			}
+		}
+		if n := tsm.upByJob["under-limit-job"] + tsm.downByJob["under-limit-job"]; n != 3 {
+			t.Fatalf("unexpected number of registered targets; got %d; want 3", n)
+		}
+	})
+
+	// over the limit - only the first maxScrapeTargets registrations must succeed
+	t.Run("over limit", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		const maxScrapeTargets = 3
+		var registered, rejected int
+		for i := 0; i < 10; i++ {
+			if tsm.Register(newSW("over-limit-job", maxScrapeTargets)) {
+				registered++
+			} else {
+				rejected++
+			}
+		}
+		if registered != maxScrapeTargets {
+			t.Fatalf("unexpected number of registered targets; got %d; want %d", registered, maxScrapeTargets)
+		}
+		if rejected != 10-maxScrapeTargets {
+			t.Fatalf("unexpected number of rejected targets; got %d; want %d", rejected, 10-maxScrapeTargets)
+		}
+		if n := tsm.upByJob["over-limit-job"] + tsm.downByJob["over-limit-job"]; n != maxScrapeTargets {
+			t.Fatalf("unexpected number of registered targets in tsm; got %d; want %d", n, maxScrapeTargets)
+		}
+
+		// unregistering a target must free up a slot for a new registration
+		var freed *scrapeWork
+		for sw := range tsm.m {
+			freed = sw
+			break
+		}
+		tsm.Unregister(freed)
+		if !tsm.Register(newSW("over-limit-job", maxScrapeTargets)) {
+			t.Fatalf("expected registration to succeed after freeing up a slot")
+		}
+	})
+
+	// the limit must be independent per job
+	t.Run("independent per job", func(t *testing.T) {
+		tsm := newTargetStatusMap()
+		if !tsm.Register(newSW("job-a", 1)) {
+			t.Fatalf("unexpected registration failure for job-a")
+		}
+		if tsm.Register(newSW("job-a", 1)) {
+			t.Fatalf("expected registration failure for the second target of job-a")
+		}
+		if !tsm.Register(newSW("job-b", 1)) {
+			t.Fatalf("unexpected registration failure for job-b")
+		}
+	})
+}
+
+func TestRegisterDroppedTargets_JobTargetsLimit(t *testing.T) {
+	dtm := &droppedTargets{
+		m: make(map[uint64]droppedTarget),
+	}
+	labels := promutil.MustNewLabelsFromString(`{__address__="host1:80",job="my-job"}`)
+	dtm.Register(newCompressedLabels(labels), nil, targetDropReasonJobTargetsLimit, nil)
+
+	dts := dtm.getTargetsList()
+	if len(dts) != 1 {
+		t.Fatalf("unexpected number of dropped targets; got %d; want 1", len(dts))
+	}
+	if dts[0].dropReason != targetDropReasonJobTargetsLimit {
+		t.Fatalf("unexpected drop reason; got %q; want %q", dts[0].dropReason, targetDropReasonJobTargetsLimit)
+	}
+}
