 	targetDropReasonSharding         = targetDropReason("sharding")           // target is dropped because of sharding https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-big-number-of-targets
+	targetDropReasonJobTargetsLimit  = targetDropReason("job targets limit")  // target is dropped because the job's active targets count reached -promscrape.maxScrapeTargetsPerJob (or max_scrape_targets_per_job)
 )
 
