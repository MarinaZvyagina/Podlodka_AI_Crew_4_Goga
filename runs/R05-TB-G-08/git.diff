+
+func TestScraperGroupUpdate_MaxScrapeTargetsPerJob(t *testing.T) {
+	f := func(scrapeConfigYAML string, targetsCount, wantActive, wantDropped int) {
+		t.Helper()
+
+		var sb strings.Builder
+		fmt.Fprint(&sb, scrapeConfigYAML)
+		fmt.Fprint(&sb, "\n  static_configs:\n    - targets:\n")
+		for i := 0; i < targetsCount; i++ {
+			fmt.Fprintf(&sb, "        - host%d:80\n", i)
+		}
+
+		var cfg Config
+		if err := cfg.parseData([]byte(fmt.Sprintf("scrape_configs:\n%s", sb.String())), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sws := cfg.getStaticScrapeWork()
+		if len(sws) != targetsCount {
+			t.Fatalf("unexpected number of discovered targets; got %d; want %d", len(sws), targetsCount)
+		}
+
+		pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+		globalStopChan = make(chan struct{})
+		defer close(globalStopChan)
+
+		sg := newScraperGroup(fmt.Sprintf("static_configs_%d", rand.Int()), pushData, globalStopChan)
+		defer sg.stop()
+
+		droppedBefore := droppedTargetsMap.getTotalTargets()
+
+		sg.update(sws)
+
+		if len(sg.m) != wantActive {
+			t.Fatalf("unexpected number of active scrapers; got %d; want %d", len(sg.m), wantActive)
+		}
+
+		droppedAfter := droppedTargetsMap.getTotalTargets()
+		if gotDropped := droppedAfter - droppedBefore; gotDropped != wantDropped {
+			t.Fatalf("unexpected number of newly dropped targets; got %d; want %d", gotDropped, wantDropped)
+		}
+	}
+
+	// job under the limit - all the targets must be scraped, nothing dropped
+	f(`
+- job_name: under-limit
+  max_scrape_targets_per_job: 10`, 3, 3, 0)
+
+	// job over the limit - only max_scrape_targets_per_job targets must be scraped,
+	// the rest must be dropped and visible via the dropped targets tracking
+	f(`
+- job_name: over-limit
+  max_scrape_targets_per_job: 3`, 10, 3, 7)
+
+	// default (unlimited) behavior - no max_scrape_targets_per_job set, all targets scraped
+	f(`
+- job_name: unlimited`, 10, 10, 0)
+}
