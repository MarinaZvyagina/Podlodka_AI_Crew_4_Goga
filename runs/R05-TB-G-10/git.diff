+// limitScrapeWorkForJob truncates dst[dstLen:] (the targets discovered for a single job_name
+// during the current service discovery round) down to maxScrapeTargets entries.
+//
+// This provides a safety net against a misbehaving service discovery mechanism (of any kind -
+// Kubernetes, cloud API, file, etc.) suddenly returning an excessive number of targets for a job.
+// The truncated targets are registered as dropped, so operators can notice them
+// at /targets, /api/v1/targets and /service-discovery pages.
+func limitScrapeWorkForJob(dst []*ScrapeWork, dstLen, maxScrapeTargets int) []*ScrapeWork {
+	if maxScrapeTargets <= 0 || len(dst)-dstLen <= maxScrapeTargets {
+		return dst
+	}
+	for _, sw := range dst[dstLen+maxScrapeTargets:] {
+		droppedTargetsMap.Register(sw.OriginalLabels, sw.RelabelConfigs, targetDropReasonTargetsLimit, nil)
+	}
+	return dst[:dstLen+maxScrapeTargets]
+}
