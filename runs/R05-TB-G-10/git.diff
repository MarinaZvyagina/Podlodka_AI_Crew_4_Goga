+// TestMaxScrapeTargetsPerJob verifies the per-job_name safety net on the number of active scrape
+// targets. The limit must be applied identically regardless of which service discovery mechanism
+// produced the targets (static_configs is used here purely because it's the simplest to construct
+// in a unit test).
+func TestMaxScrapeTargetsPerJob(t *testing.T) {
+	buildConfig := func(jobName string, maxScrapeTargets, targetsCount int) string {
+		var sb strings.Builder
+		fmt.Fprintf(&sb, "scrape_configs:\n- job_name: %s\n", jobName)
+		if maxScrapeTargets > 0 {
+			fmt.Fprintf(&sb, "  max_scrape_targets: %d\n", maxScrapeTargets)
+		}
+		sb.WriteString("  static_configs:\n  - targets: [")
+		for i := 0; i < targetsCount; i++ {
+			if i > 0 {
+				sb.WriteString(", ")
+			}
+			fmt.Fprintf(&sb, "%q", fmt.Sprintf("host-%d:80", i))
+		}
+		sb.WriteString("]\n")
+		return sb.String()
+	}
+	resetDroppedTargets := func() {
+		droppedTargetsMap.mu.Lock()
+		droppedTargetsMap.m = make(map[uint64]droppedTarget)
+		droppedTargetsMap.totalTargets = 0
+		droppedTargetsMap.mu.Unlock()
+	}
+	droppedForJob := func(jobName string) int {
+		n := 0
+		for _, dt := range droppedTargetsMap.getTargetsList() {
+			if dt.dropReason == targetDropReasonTargetsLimit && dt.originalLabels.getJob() == jobName {
+				n++
+			}
+		}
+		return n
+	}
+
+	f := func(jobName string, maxScrapeTargets, targetsCount, expectedSWs, expectedDropped int) {
+		t.Helper()
+		resetDroppedTargets()
+		sws, err := getStaticScrapeWork([]byte(buildConfig(jobName, maxScrapeTargets, targetsCount)), "non-existing-file")
+		if err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if len(sws) != expectedSWs {
+			t.Fatalf("unexpected number of scrape works; got %d; want %d", len(sws), expectedSWs)
+		}
+		if n := droppedForJob(jobName); n != expectedDropped {
+			t.Fatalf("unexpected number of targets dropped because of the limit; got %d; want %d", n, expectedDropped)
+		}
+	}
+
+	// A job under the limit must be unaffected.
+	f("under-limit", 10, 3, 3, 0)
+
+	// A job over the limit must be truncated down to the limit, with the excess
+	// visible as dropped targets (surfaced at /targets, /api/v1/targets, /service-discovery).
+	f("over-limit", 3, 7, 3, 4)
 
+	// The default (max_scrape_targets unset) behavior must remain unlimited.
+	f("unlimited", 0, 20, 20, 0)
 }
