diff --git a/lib/promscrape/discovery/scaleway/api.go b/lib/promscrape/discovery/scaleway/api.go
new file mode 100644
index 0000000..577799f
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api.go
@@ -0,0 +1,117 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/url"
+	"strings"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+var configMap = discoveryutil.NewConfigMap()
+
+// apiConfig contains config for API server.
+type apiConfig struct {
+	client *discoveryutil.Client
+	port   int
+
+	zone            string
+	listQueryParams string
+}
+
+func getAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	v, err := configMap.Get(sdc, func() (any, error) { return newAPIConfig(sdc, baseDir) })
+	if err != nil {
+		return nil, err
+	}
+	return v.(*apiConfig), nil
+}
+
+func newAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	if sdc.Zone == "" {
+		return nil, fmt.Errorf("missing `zone` option")
+	}
+
+	ac, err := sdc.HTTPClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse auth config: %w", err)
+	}
+
+	apiServer := sdc.Server
+	if apiServer == "" {
+		apiServer = "https://api.scaleway.com"
+	}
+	if !strings.Contains(apiServer, "://") {
+		scheme := "http"
+		if sdc.HTTPClientConfig.TLSConfig != nil {
+			scheme = "https"
+		}
+		apiServer = scheme + "://" + apiServer
+	}
+
+	proxyAC, err := sdc.ProxyClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse proxy auth config: %w", err)
+	}
+	client, err := discoveryutil.NewClient(apiServer, ac, sdc.ProxyURL, proxyAC, &sdc.HTTPClientConfig)
+	if err != nil {
+		return nil, fmt.Errorf("cannot create HTTP client for %q: %w", apiServer, err)
+	}
+
+	qp := url.Values{}
+	if sdc.Project != "" {
+		qp.Set("project", sdc.Project)
+	}
+
+	port := sdc.Port
+	if port == 0 {
+		port = 80
+	}
+
+	return &apiConfig{
+		client: client,
+		port:   port,
+
+		zone:            sdc.Zone,
+		listQueryParams: qp.Encode(),
+	}, nil
+}
+
+// serversPerPage is the maximum number of servers requested per page from the Scaleway API.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+const serversPerPage = 100
+
+func getServers(cfg *apiConfig) ([]server, error) {
+	var servers []server
+	page := 1
+	for {
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?per_page=%d&page=%d", cfg.zone, serversPerPage, page)
+		if cfg.listQueryParams != "" {
+			path += "&" + cfg.listQueryParams
+		}
+		data, err := cfg.client.GetAPIResponse(path)
+		if err != nil {
+			return nil, fmt.Errorf("cannot query scaleway api for servers: %w", err)
+		}
+		resp, err := parseAPIResponse(data)
+		if err != nil {
+			return nil, err
+		}
+		servers = append(servers, resp.Servers...)
+		if len(resp.Servers) < serversPerPage {
+			break
+		}
+		page++
+	}
+	return servers, nil
+}
+
+func parseAPIResponse(data []byte) (*listServersResponse, error) {
+	var resp listServersResponse
+	if err := json.Unmarshal(data, &resp); err != nil {
+		return nil, fmt.Errorf("cannot parse scaleway api response: %q: %w", data, err)
+	}
+	return &resp, nil
+}
diff --git a/lib/promscrape/discovery/scaleway/api_test.go b/lib/promscrape/discovery/scaleway/api_test.go
new file mode 100644
index 0000000..6997281
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api_test.go
@@ -0,0 +1,177 @@
+package scaleway
+
+import (
+	"fmt"
+	"net/http"
+	"reflect"
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+func TestParseAPIResponse(t *testing.T) {
+	f := func(data string, responseExpected *listServersResponse) {
+		t.Helper()
+
+		resp, err := parseAPIResponse([]byte(data))
+		if err != nil {
+			t.Fatalf("unexpected parseAPIResponse() error: %s", err)
+		}
+		if !reflect.DeepEqual(resp, responseExpected) {
+			t.Fatalf("unexpected response\ngot\n%v\nwant\n%v", resp, responseExpected)
+		}
+	}
+
+	data := `{
+	  "servers": [
+	    {
+	      "id": "11111111-1111-1111-1111-111111111111",
+	      "name": "scaleway-sd",
+	      "hostname": "scaleway-sd",
+	      "arch": "x86_64",
+	      "boot_type": "local",
+	      "commercial_type": "DEV1-S",
+	      "state": "running",
+	      "zone": "fr-par-1",
+	      "project": "project-1",
+	      "organization": "org-1",
+	      "tags": ["foo", "bar"],
+	      "private_ip": "10.10.10.10",
+	      "public_ips": [
+	        {"address": "1.2.3.4", "family": "inet"},
+	        {"address": "2001:db8::1", "family": "inet6"}
+	      ]
+	    }
+	  ]
+	}`
+
+	responseExpected := &listServersResponse{
+		Servers: []server{
+			{
+				ID:             "11111111-1111-1111-1111-111111111111",
+				Name:           "scaleway-sd",
+				Hostname:       "scaleway-sd",
+				Arch:           "x86_64",
+				BootType:       "local",
+				CommercialType: "DEV1-S",
+				State:          "running",
+				Zone:           "fr-par-1",
+				Project:        "project-1",
+				Organization:   "org-1",
+				Tags:           []string{"foo", "bar"},
+				PrivateIP:      "10.10.10.10",
+				PublicIPs: []publicIP{
+					{Address: "1.2.3.4", Family: "inet"},
+					{Address: "2001:db8::1", Family: "inet6"},
+				},
+			},
+		},
+	}
+	f(data, responseExpected)
+}
+
+func serverJSON(id string) string {
+	return fmt.Sprintf(`{
+	  "id": %q,
+	  "name": "scaleway-sd",
+	  "commercial_type": "DEV1-S",
+	  "state": "running",
+	  "zone": "fr-par-1",
+	  "private_ip": "10.10.10.10",
+	  "public_ips": [{"address": "1.2.3.4", "family": "inet"}]
+	}`, id)
+}
+
+func TestGetServers_Success(t *testing.T) {
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		return []byte(fmt.Sprintf(`{"servers": [%s]}`, serverJSON("11111111-1111-1111-1111-111111111111")))
+	})
+	defer s.Close()
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		client: client,
+		zone:   "fr-par-1",
+	}
+
+	servers, err := getServers(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getServers(): %s", err)
+	}
+	if len(servers) != 1 {
+		t.Fatalf("unexpected servers count; got %d; want 1", len(servers))
+	}
+	if servers[0].ID != "11111111-1111-1111-1111-111111111111" {
+		t.Fatalf("unexpected server id: %q", servers[0].ID)
+	}
+}
+
+func TestGetServers_Failure(t *testing.T) {
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		return []byte("some error")
+	})
+	defer s.Close()
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		client: client,
+		zone:   "fr-par-1",
+	}
+
+	if _, err := getServers(cfg); err == nil {
+		t.Fatalf("expecting non-nil error from getServers()")
+	}
+}
+
+func TestGetServers_Paging(t *testing.T) {
+	requestCount := 0
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		requestCount++
+		if requestCount == 1 {
+			// first page is full - triggers a request for the next page.
+			ids := make([]string, serversPerPage)
+			for i := range ids {
+				ids[i] = serverJSON(fmt.Sprintf("page1-%d", i))
+			}
+			resp := `{"servers": [`
+			for i, s := range ids {
+				if i > 0 {
+					resp += ","
+				}
+				resp += s
+			}
+			resp += `]}`
+			return []byte(resp)
+		}
+		// second page is partial - no more pages after this one.
+		return []byte(fmt.Sprintf(`{"servers": [%s]}`, serverJSON("page2-0")))
+	})
+	defer s.Close()
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		client: client,
+		zone:   "fr-par-1",
+	}
+
+	servers, err := getServers(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getServers(): %s", err)
+	}
+	if requestCount != 2 {
+		t.Fatalf("unexpected number of requests; got %d; want 2", requestCount)
+	}
+	if len(servers) != serversPerPage+1 {
+		t.Fatalf("unexpected servers count; got %d; want %d", len(servers), serversPerPage+1)
+	}
+}
diff --git a/lib/promscrape/discovery/scaleway/mock_server_test.go b/lib/promscrape/discovery/scaleway/mock_server_test.go
