+
+func TestZoneToRegion(t *testing.T) {
+	f := func(zone, regionExpected string) {
+		t.Helper()
+
+		region := zoneToRegion(zone)
+		if region != regionExpected {
+			t.Fatalf("unexpected region for zone=%q; got %q; want %q", zone, region, regionExpected)
+		}
+	}
+
+	f("fr-par-1", "fr-par")
+	f("nl-ams-2", "nl-ams")
+	f("pl-waw-3", "pl-waw")
+	f("unknown", "unknown")
+	f("", "")
+}
