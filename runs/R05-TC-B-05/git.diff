@@ -0,0 +1,73 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func TestGetServerLabels(t *testing.T) {
+	privateIP := "10.14.0.5"
+	input := []Server{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "my-server",
+			Hostname:       "my-server",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Arch:           "x86_64",
+			Tags:           []string{"web", "prod"},
+			PrivateIP:      &privateIP,
+			PublicIP: &ServerIP{
+				Address: "51.15.0.1",
+			},
+		},
+		{
+			// instance without a public IP; __address__ must fall back to the private IP.
+			ID:             "22222222-2222-2222-2222-222222222222",
+			Name:           "internal-server",
+			Hostname:       "internal-server",
+			CommercialType: "DEV1-M",
+			State:          "stopped",
+			Arch:           "x86_64",
+			PrivateIP:      &privateIP,
+		},
+		{
+			// instance without any IP address must be skipped.
+			ID:   "33333333-3333-3333-3333-333333333333",
+			Name: "no-ip-server",
+		},
+	}
+
+	expect := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                           "51.15.0.1:80",
+			"__meta_scaleway_instance_id":           "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":         "my-server",
+			"__meta_scaleway_instance_hostname":     "my-server",
+			"__meta_scaleway_instance_zone":         "fr-par-1",
+			"__meta_scaleway_instance_state":        "running",
+			"__meta_scaleway_instance_type":         "DEV1-S",
+			"__meta_scaleway_instance_arch":         "x86_64",
+			"__meta_scaleway_instance_public_ipv4":  "51.15.0.1",
+			"__meta_scaleway_instance_private_ipv4": "10.14.0.5",
+			"__meta_scaleway_instance_tags":         ",web,prod,",
+		}),
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                           "10.14.0.5:80",
+			"__meta_scaleway_instance_id":           "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_name":         "internal-server",
+			"__meta_scaleway_instance_hostname":     "internal-server",
+			"__meta_scaleway_instance_zone":         "fr-par-1",
+			"__meta_scaleway_instance_state":        "stopped",
+			"__meta_scaleway_instance_type":         "DEV1-M",
+			"__meta_scaleway_instance_arch":         "x86_64",
+			"__meta_scaleway_instance_public_ipv4":  "",
+			"__meta_scaleway_instance_private_ipv4": "10.14.0.5",
+		}),
+	}
+
+	labels := getServerLabels(input, "fr-par-1", 80)
+	discoveryutil.TestEqualLabelss(t, labels, expect)
+}
