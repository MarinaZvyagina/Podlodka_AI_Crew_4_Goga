+		"servers": [{
+			"id": "1-11111111-1111-1111-1111-111111111111",
+			"name": "server-1",
+			"hostname": "server-1",
+			"commercial_type": "DEV1-S",
+			"state": "running",
+			"arch": "x86_64",
+			"tags": [],
+			"private_ip": null,
