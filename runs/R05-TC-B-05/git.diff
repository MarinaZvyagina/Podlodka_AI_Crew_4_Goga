+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	f := func(sdc *SDConfig) {
+		t.Helper()
+		if _, err := newAPIConfig(sdc, "."); err == nil {
+			t.Fatalf("expecting non-nil error")
+		}
+	}
+
+	// Missing project_id and secret_key
+	f(&SDConfig{})
+
+	// Missing secret_key
+	f(&SDConfig{
+		ProjectID: "project-id",
+	})
+
+	// Missing project_id
+	f(&SDConfig{
+		SecretKey: &promauth.Secret{S: "secret-key"},
+	})
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		ProjectID: "project-id",
+		SecretKey: &promauth.Secret{S: "secret-key"},
+	}
+	cfg, err := newAPIConfig(sdc, ".")
+	if err != nil {
+		t.Fatalf("newAPIConfig() failed unexpectedly: %s", err)
+	}
+	if cfg.projectID != "project-id" {
+		t.Fatalf("unexpected projectID; got %q; want %q", cfg.projectID, "project-id")
+	}
+	if cfg.zone != "fr-par-1" {
+		t.Fatalf("unexpected default zone; got %q; want %q", cfg.zone, "fr-par-1")
+	}
+	if cfg.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want %d", cfg.port, 80)
+	}
+}
+
+func TestNewAPIConfig_CustomZoneAndPort(t *testing.T) {
+	sdc := &SDConfig{
+		ProjectID: "project-id",
+		SecretKey: &promauth.Secret{S: "secret-key"},
+		Zone:      "nl-ams-1",
+		Port:      9100,
+	}
+	cfg, err := newAPIConfig(sdc, ".")
+	if err != nil {
+		t.Fatalf("newAPIConfig() failed unexpectedly: %s", err)
+	}
+	if cfg.zone != "nl-ams-1" {
+		t.Fatalf("unexpected zone; got %q; want %q", cfg.zone, "nl-ams-1")
+	}
+	if cfg.port != 9100 {
+		t.Fatalf("unexpected port; got %d; want %d", cfg.port, 9100)
+	}
+}
diff --git a/lib/promscrape/discovery/scaleway/instance.go b/lib/promscrape/discovery/scaleway/instance.go
new file mode 100644
index 0000000..cfe5e13
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/instance.go
@@ -0,0 +1,65 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/url"
+)
+
+// listServersResponse is the response structure of the Scaleway "list servers" API.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type listServersResponse struct {
+	Servers    []Server `json:"servers"`
+	TotalCount int      `json:"total_count"`
+}
+
+// Server represents a Scaleway Instance.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type Server struct {
+	ID             string    `json:"id"`
+	Name           string    `json:"name"`
+	Hostname       string    `json:"hostname"`
+	CommercialType string    `json:"commercial_type"`
+	State          string    `json:"state"`
+	Arch           string    `json:"arch"`
+	Tags           []string  `json:"tags"`
+	PrivateIP      *string   `json:"private_ip"`
+	PublicIP       *ServerIP `json:"public_ip"`
+}
+
+// ServerIP represents a public IP address attached to a Scaleway Instance.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type ServerIP struct {
+	Address string `json:"address"`
+}
+
+// getServers retrieves the list of instances from the Scaleway Instances API.
+func getServers(cfg *apiConfig) ([]Server, error) {
+	var servers []Server
+
+	page := 1
+	for {
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?project=%s&per_page=100&page=%d", url.QueryEscape(cfg.zone), url.QueryEscape(cfg.projectID), page)
+		data, err := cfg.client.GetAPIResponse(path)
+		if err != nil {
+			return nil, fmt.Errorf("cannot get Scaleway response from %q: %w", path, err)
+		}
+
+		var resp listServersResponse
+		if err := json.Unmarshal(data, &resp); err != nil {
+			return nil, fmt.Errorf("cannot unmarshal listServersResponse obtained from %q: %w; response=%q", path, err, data)
+		}
+
+		servers = append(servers, resp.Servers...)
+
+		if len(resp.Servers) == 0 || len(servers) >= resp.TotalCount {
+			break
+		}
+		page++
+	}
+
+	return servers, nil
+}
