+	mockListServersPage1Resp = `{
+		"servers": [{
+			"id": "2-11111111-1111-1111-1111-111111111111",
+			"name": "server-2",
+			"hostname": "server-2",
+			"commercial_type": "DEV1-S",
+			"state": "stopped",
