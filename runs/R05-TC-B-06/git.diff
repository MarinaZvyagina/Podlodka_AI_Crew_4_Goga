+	var gotToken string
+	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotToken = r.Header.Get("X-Auth-Token")
+		w.Write([]byte(`{"servers": [], "total_count": 0}`))
