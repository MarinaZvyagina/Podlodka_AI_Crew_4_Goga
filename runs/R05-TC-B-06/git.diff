+++ b/lib/promscrape/discovery/scaleway/scaleway_test.go
@@ -0,0 +1,65 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func TestGetInstanceLabels(t *testing.T) {
+	input := []Server{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "scaleway-sd",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Zone:           "fr-par-1",
+			Tags:           []string{"foo", "bar"},
+			PublicIP:       &PublicIP{Address: "51.15.0.1"},
+			PrivateIP:      "10.10.0.1",
+		},
+		{
+			// stopped instance without a public IP address
+			ID:             "22222222-2222-2222-2222-222222222222",
+			Name:           "scaleway-sd-private",
+			CommercialType: "DEV1-M",
+			State:          "stopped",
+			Zone:           "fr-par-2",
+			PrivateIP:      "10.10.0.2",
+		},
+		{
+			// instance without any usable IP address must be skipped
+			ID:    "33333333-3333-3333-3333-333333333333",
+			Name:  "scaleway-sd-no-ip",
+			State: "stopped",
+			Zone:  "fr-par-1",
+		},
+	}
+
+	expect := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "51.15.0.1:80",
+			"__meta_scaleway_instance_id":              "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":            "scaleway-sd",
+			"__meta_scaleway_instance_commercial_type": "DEV1-S",
+			"__meta_scaleway_instance_state":           "running",
+			"__meta_scaleway_instance_zone":            "fr-par-1",
+			"__meta_scaleway_instance_public_ip":       "51.15.0.1",
+			"__meta_scaleway_instance_private_ip":      "10.10.0.1",
+			"__meta_scaleway_instance_tags":            ",foo,bar,",
+		}),
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "10.10.0.2:80",
+			"__meta_scaleway_instance_id":              "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_name":            "scaleway-sd-private",
+			"__meta_scaleway_instance_commercial_type": "DEV1-M",
+			"__meta_scaleway_instance_state":           "stopped",
+			"__meta_scaleway_instance_zone":            "fr-par-2",
+			"__meta_scaleway_instance_public_ip":       "",
+			"__meta_scaleway_instance_private_ip":      "10.10.0.2",
+		}),
+	}
+	labels := getInstanceLabels(input, 80)
+	discoveryutil.TestEqualLabelss(t, labels, expect)
+}
