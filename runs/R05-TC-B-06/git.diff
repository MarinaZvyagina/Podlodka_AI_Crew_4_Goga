@@ -0,0 +1,64 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	f := func(sdc *SDConfig) {
+		t.Helper()
+		baseDir := "."
+		if _, err := newAPIConfig(sdc, baseDir); err == nil {
+			t.Fatalf("expecting non-nil error")
+		}
+	}
+
+	// missing secret_key
+	f(&SDConfig{
+		Zone: "fr-par-1",
+	})
+
+	// missing zone
+	f(&SDConfig{
+		SecretKey: &promauth.Secret{S: "foobar"},
+	})
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		SecretKey: &promauth.Secret{S: "foobar"},
+		Zone:      "fr-par-1",
+	}
+	baseDir := "."
+	ac, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig() failed with, err: %v", err)
+	}
+	if ac.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want 80", ac.port)
+	}
+	if ac.zone != "fr-par-1" {
+		t.Fatalf("unexpected zone; got %q; want %q", ac.zone, "fr-par-1")
+	}
+	if ac.secretKey != "foobar" {
+		t.Fatalf("unexpected secretKey; got %q; want %q", ac.secretKey, "foobar")
+	}
+}
+
+func TestNewAPIConfig_ProjectIDFilter(t *testing.T) {
+	sdc := &SDConfig{
+		SecretKey: &promauth.Secret{S: "foobar"},
+		Zone:      "fr-par-1",
+		ProjectID: "my-project-id",
+	}
+	baseDir := "."
+	ac, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig() failed with, err: %v", err)
+	}
+	if ac.listQueryParams != "project=my-project-id" {
+		t.Fatalf("unexpected listQueryParams; got %q; want %q", ac.listQueryParams, "project=my-project-id")
+	}
+}
diff --git a/lib/promscrape/discovery/scaleway/instance.go b/lib/promscrape/discovery/scaleway/instance.go
new file mode 100644
index 0000000..3012052
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/instance.go
@@ -0,0 +1,63 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+)
+
+const perPage = 100
+
+// ListServersResponse is the response of the Scaleway ListServers API.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type ListServersResponse struct {
+	Servers    []Server `json:"servers"`
+	TotalCount int      `json:"total_count"`
+}
+
+// Server represents a Scaleway Instance.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type Server struct {
+	ID             string    `json:"id"`
+	Name           string    `json:"name"`
+	CommercialType string    `json:"commercial_type"`
+	State          string    `json:"state"`
+	Zone           string    `json:"zone"`
+	Tags           []string  `json:"tags"`
+	PublicIP       *PublicIP `json:"public_ip"`
+	PrivateIP      string    `json:"private_ip"`
+}
+
+// PublicIP represents the public IP address attached to a Scaleway Instance.
+type PublicIP struct {
+	Address string `json:"address"`
+}
+
+// getInstances retrieves the list of Instances from the Scaleway API for the configured zone.
+func getInstances(cfg *apiConfig) ([]Server, error) {
+	var servers []Server
+
+	page := 1
+	for {
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?%s&page=%d&per_page=%d", cfg.zone, cfg.listQueryParams, page, perPage)
+		data, err := cfg.c.GetAPIResponseWithReqParams(path, cfg.authHeader)
+		if err != nil {
+			return nil, fmt.Errorf("cannot get Scaleway response from %q: %w", path, err)
+		}
+
+		var resp ListServersResponse
+		if err := json.Unmarshal(data, &resp); err != nil {
+			return nil, fmt.Errorf("cannot unmarshal ListServersResponse obtained from %q: %w; response=%q", path, err, data)
+		}
+
+		servers = append(servers, resp.Servers...)
+
+		if len(resp.Servers) == 0 || len(servers) >= resp.TotalCount {
+			break
+		}
+		page++
+	}
+
+	return servers, nil
+}
