+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func TestGetInstanceLabels(t *testing.T) {
+	input := []Instance{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "scaleway-sd",
+			Project:        "22222222-2222-2222-2222-222222222222",
+			Zone:           "fr-par-1",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Tags:           []string{"mock-tag"},
+			PrivateIP:      "10.0.0.1",
+			PublicIP:       &PublicIP{Address: "51.15.0.1"},
+			IPv6:           &IPv6{Address: "2001:bc8:1234::1"},
+		},
+		{
+			// Instance without a public IP address; must fall back to the private IP for __address__.
+			ID:             "33333333-3333-3333-3333-333333333333",
+			Name:           "scaleway-sd-private-only",
+			Project:        "22222222-2222-2222-2222-222222222222",
+			Zone:           "fr-par-2",
+			CommercialType: "DEV1-M",
+			State:          "stopped",
+			PrivateIP:      "10.0.0.2",
+		},
+		{
+			// Instance without any IP address must be skipped entirely.
+			ID:      "44444444-4444-4444-4444-444444444444",
+			Name:    "scaleway-sd-no-ip",
+			Project: "22222222-2222-2222-2222-222222222222",
+			Zone:    "fr-par-1",
+			State:   "stopped",
+		},
+	}
+
+	expect := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                          "51.15.0.1:8080",
+			"__meta_scaleway_instance_id":          "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":        "scaleway-sd",
+			"__meta_scaleway_instance_project_id":  "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_zone":        "fr-par-1",
+			"__meta_scaleway_instance_type":        "DEV1-S",
+			"__meta_scaleway_instance_state":       "running",
+			"__meta_scaleway_instance_public_ipv4": "51.15.0.1",
+			"__meta_scaleway_instance_public_ipv6": "2001:bc8:1234::1",
+			"__meta_scaleway_instance_private_ip":  "10.0.0.1",
+			"__meta_scaleway_instance_tags":        ",mock-tag,",
+		}),
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                          "10.0.0.2:8080",
+			"__meta_scaleway_instance_id":          "33333333-3333-3333-3333-333333333333",
+			"__meta_scaleway_instance_name":        "scaleway-sd-private-only",
+			"__meta_scaleway_instance_project_id":  "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_zone":        "fr-par-2",
+			"__meta_scaleway_instance_type":        "DEV1-M",
+			"__meta_scaleway_instance_state":       "stopped",
+			"__meta_scaleway_instance_public_ipv4": "",
+			"__meta_scaleway_instance_public_ipv6": "",
+			"__meta_scaleway_instance_private_ip":  "10.0.0.2",
+		}),
+	}
+
+	labels := getInstanceLabels(input, 8080)
+	discoveryutil.TestEqualLabelss(t, labels, expect)
+}
