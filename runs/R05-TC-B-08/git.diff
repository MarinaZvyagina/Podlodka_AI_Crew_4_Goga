@@ -0,0 +1,23 @@
+package scaleway
+
+import (
+	"net/http"
+	"net/http/httptest"
+)
+
+type mockScalewayServer struct {
+	*httptest.Server
+	responseFunc func() []byte
+}
+
+func newMockScalewayServer(responseFunc func() []byte) *mockScalewayServer {
+	var s mockScalewayServer
+	s.responseFunc = responseFunc
+	s.Server = httptest.NewServer(http.HandlerFunc(s.handler))
+	return &s
+}
+
+func (s *mockScalewayServer) handler(w http.ResponseWriter, _ *http.Request) {
+	data := s.responseFunc()
+	w.Write(data)
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway.go b/lib/promscrape/discovery/scaleway/scaleway.go
new file mode 100644
index 0000000..bd3551e
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway.go
@@ -0,0 +1,121 @@
+package scaleway
+
+import (
+	"flag"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/proxy"
+)
+
+// SDCheckInterval defines interval for Scaleway targets refresh.
+var SDCheckInterval = flag.Duration("promscrape.scalewaySDCheckInterval", 30*time.Second, "Interval for checking for changes in Scaleway. "+
+	"This works only if scaleway_sd_configs is configured in '-promscrape.config' file. "+
+	"See https://docs.victoriametrics.com/victoriametrics/sd_configs/#scaleway_sd_configs for details")
+
+// SDConfig represents service discovery config for Scaleway Instances.
+//
+// See: https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type SDConfig struct {
+	// SecretKey is the Scaleway API secret key, which is sent as `X-Auth-Token` in every discovery API request (mandatory).
+	// See https://www.scaleway.com/en/docs/console/account/how-to/generate-api-key/
+	SecretKey *promauth.Secret `yaml:"secret_key"`
+
+	// Project is the id of the Scaleway project to discover Instances in (mandatory).
+	Project string `yaml:"project"`
+
+	// Zone is the Scaleway zone to query for Instances.
+	// See https://www.scaleway.com/en/docs/console/account/reference-content/products-availability/
+	//
+	// Default: fr-par-1
+	Zone string `yaml:"zone,omitempty"`
+
+	// APIURL is the Scaleway API server to query.
+	//
+	// Default: https://api.scaleway.com
+	APIURL string `yaml:"api_url,omitempty"`
+
+	// NameFilter is an optional filter for returning only Instances whose name contains the given string.
+	NameFilter string `yaml:"name_filter,omitempty"`
+
+	// TagsFilter is an optional filter for returning only Instances, which contain all the given tags.
+	TagsFilter []string `yaml:"tags_filter,omitempty"`
+
+	// The port to scrape metrics from. Default 80.
+	Port int `yaml:"port,omitempty"`
+
+	// General HTTP / Auth configs.
+	HTTPClientConfig  promauth.HTTPClientConfig  `yaml:",inline"`
+	ProxyURL          *proxy.URL                 `yaml:"proxy_url,omitempty"`
+	ProxyClientConfig promauth.ProxyClientConfig `yaml:",inline"`
+
+	// refresh_interval is obtained from `-promscrape.scalewaySDCheckInterval` command-line option.
+}
+
+var configMap = discoveryutil.NewConfigMap()
+
+// GetLabels returns Scaleway Instances' labels according to sdc.
+func (sdc *SDConfig) GetLabels(baseDir string) ([]*promutil.Labels, error) {
+	ac, err := getAPIConfig(sdc, baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot get API config: %w", err)
+	}
+	instances, err := getInstances(ac)
+	if err != nil {
+		return nil, err
+	}
+	return getInstanceLabels(instances, ac.port), nil
+}
+
+// MustStop stops further usage for sdc.
+func (sdc *SDConfig) MustStop() {
+	v := configMap.Delete(sdc)
+	if v != nil {
+		cfg := v.(*apiConfig)
+		cfg.c.Stop()
+	}
+}
+
+// getInstanceLabels returns labels for Scaleway Instances obtained from the given cfg
+func getInstanceLabels(instances []Instance, port int) []*promutil.Labels {
+	ms := make([]*promutil.Labels, 0, len(instances))
+
+	for _, instance := range instances {
+		addr := instance.PublicIPv4()
+		if addr == "" {
+			addr = instance.PrivateIP
+		}
+		if addr == "" {
+			// Skip instances without any IP address to scrape.
+			continue
+		}
+
+		m := promutil.NewLabels(12)
+		m.Add("__address__", discoveryutil.JoinHostPort(addr, port))
+		m.Add("__meta_scaleway_instance_id", instance.ID)
+		m.Add("__meta_scaleway_instance_name", instance.Name)
+		m.Add("__meta_scaleway_instance_zone", instance.Zone)
+		m.Add("__meta_scaleway_instance_project_id", instance.Project)
+		m.Add("__meta_scaleway_instance_type", instance.CommercialType)
+		m.Add("__meta_scaleway_instance_state", instance.State)
+		m.Add("__meta_scaleway_instance_public_ipv4", instance.PublicIPv4())
+		m.Add("__meta_scaleway_instance_public_ipv6", instance.PublicIPv6())
+		m.Add("__meta_scaleway_instance_private_ip", instance.PrivateIP)
+
+		if len(instance.Tags) > 0 {
+			m.Add("__meta_scaleway_instance_tags", joinStrings(instance.Tags))
+		}
+
+		ms = append(ms, m)
+	}
+
+	return ms
+}
+
+func joinStrings(a []string) string {
+	return "," + strings.Join(a, ",") + ","
+}
