+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func TestGetServerLabels(t *testing.T) {
+	f := func(servers []Server, port int, labelssExpected []*promutil.Labels) {
+		t.Helper()
+
+		labelss := getServerLabels(servers, port)
+		discoveryutil.TestEqualLabelss(t, labelss, labelssExpected)
+	}
+
+	// server with public and private IP, tags
+	servers := []Server{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "my-server",
+			Hostname:       "my-server",
+			Zone:           "fr-par-1",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Tags:           []string{"web", "prod"},
+			PrivateIP:      "10.10.10.1",
+			PublicIP: &PublicIP{
+				Address: "51.15.0.1",
+			},
+			Project:      "project-id",
+			Organization: "org-id",
+		},
+	}
+	labelssExpected := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "51.15.0.1:9100",
+			"__meta_scaleway_instance_id":              "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":            "my-server",
+			"__meta_scaleway_instance_hostname":        "my-server",
+			"__meta_scaleway_instance_zone":            "fr-par-1",
+			"__meta_scaleway_instance_type":            "DEV1-S",
+			"__meta_scaleway_instance_state":           "running",
+			"__meta_scaleway_instance_public_ipv4":     "51.15.0.1",
+			"__meta_scaleway_instance_private_ipv4":    "10.10.10.1",
+			"__meta_scaleway_instance_project_id":      "project-id",
+			"__meta_scaleway_instance_organization_id": "org-id",
+			"__meta_scaleway_instance_tags":            ",web,prod,",
+		}),
+	}
+	f(servers, 9100, labelssExpected)
+
+	// server without a public IP falls back to the private IP for __address__
+	servers = []Server{
+		{
+			ID:             "22222222-2222-2222-2222-222222222222",
+			Name:           "private-only",
+			Zone:           "nl-ams-1",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			PrivateIP:      "10.10.10.2",
+		},
+	}
+	labelssExpected = []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "10.10.10.2:80",
+			"__meta_scaleway_instance_id":              "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_name":            "private-only",
+			"__meta_scaleway_instance_hostname":        "",
+			"__meta_scaleway_instance_zone":            "nl-ams-1",
+			"__meta_scaleway_instance_type":            "DEV1-S",
+			"__meta_scaleway_instance_state":           "running",
+			"__meta_scaleway_instance_public_ipv4":     "",
+			"__meta_scaleway_instance_private_ipv4":    "10.10.10.2",
+			"__meta_scaleway_instance_project_id":      "",
+			"__meta_scaleway_instance_organization_id": "",
+		}),
+	}
+	f(servers, 80, labelssExpected)
+
+	// server without any IP address is skipped
+	servers = []Server{
+		{
+			ID:   "33333333-3333-3333-3333-333333333333",
+			Zone: "fr-par-1",
+		},
+	}
+	f(servers, 80, nil)
+}
diff --git a/lib/promscrape/discovery/scaleway/server.go b/lib/promscrape/discovery/scaleway/server.go
new file mode 100644
index 0000000..f613b15
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/server.go
@@ -0,0 +1,76 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/url"
+)
+
+// serversPerPage is the maximum number of servers requested per API call.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+const serversPerPage = 100
+
+// listServersResponse is the response structure of the Scaleway list servers API.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type listServersResponse struct {
+	Servers []Server `json:"servers"`
+}
+
+// Server represents a Scaleway Instance.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type Server struct {
+	ID             string    `json:"id"`
+	Name           string    `json:"name"`
+	Hostname       string    `json:"hostname"`
+	Zone           string    `json:"zone"`
+	CommercialType string    `json:"commercial_type"`
+	State          string    `json:"state"`
+	Tags           []string  `json:"tags"`
+	PrivateIP      string    `json:"private_ip"`
+	PublicIP       *PublicIP `json:"public_ip"`
+	Project        string    `json:"project"`
+	Organization   string    `json:"organization"`
+}
+
+// PublicIP represents a Scaleway Instance public IP address.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type PublicIP struct {
+	Address string `json:"address"`
+}
+
+// getServers retrieves the list of Instances from the Scaleway Instance API.
+func getServers(cfg *apiConfig) ([]Server, error) {
+	var servers []Server
+
+	qp := url.Values{}
+	if cfg.project != "" {
+		qp.Set("project", cfg.project)
+	}
+	qp.Set("per_page", fmt.Sprintf("%d", serversPerPage))
+
+	for page := 1; ; page++ {
+		qp.Set("page", fmt.Sprintf("%d", page))
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?%s", cfg.zone, qp.Encode())
+
+		data, err := cfg.c.GetAPIResponse(path)
+		if err != nil {
+			return nil, fmt.Errorf("cannot get Scaleway response from %q: %w", path, err)
+		}
+
+		var resp listServersResponse
+		if err := json.Unmarshal(data, &resp); err != nil {
+			return nil, fmt.Errorf("cannot unmarshal listServersResponse obtained from %q: %w; response=%q", path, err, data)
+		}
+
+		servers = append(servers, resp.Servers...)
+		if len(resp.Servers) < serversPerPage {
+			break
+		}
+	}
+
+	return servers, nil
+}
diff --git a/lib/promscrape/discovery/scaleway/server_test.go b/lib/promscrape/discovery/scaleway/server_test.go
new file mode 100644
index 0000000..409520e
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/server_test.go
@@ -0,0 +1,134 @@
+package scaleway
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+func TestGetServers_Success(t *testing.T) {
+	s := newMockScalewayServer(func() []byte {
+		const resp = `{
+			"servers": [{
+				"id": "11111111-1111-1111-1111-111111111111",
+				"name": "my-server",
+				"hostname": "my-server",
+				"zone": "fr-par-1",
+				"commercial_type": "DEV1-S",
+				"state": "running",
+				"tags": ["web", "prod"],
+				"private_ip": "10.10.10.1",
+				"public_ip": {
+					"id": "22222222-2222-2222-2222-222222222222",
+					"address": "51.15.0.1"
+				},
+				"project": "33333333-3333-3333-3333-333333333333",
+				"organization": "44444444-4444-4444-4444-444444444444"
+			}]
+		}`
+		return []byte(resp)
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:    client,
+		zone: "fr-par-1",
+	}
+
+	servers, err := getServers(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getServers(): %s", err)
+	}
+
+	expectedServers := []Server{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "my-server",
+			Hostname:       "my-server",
+			Zone:           "fr-par-1",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Tags:           []string{"web", "prod"},
+			PrivateIP:      "10.10.10.1",
+			PublicIP: &PublicIP{
+				Address: "51.15.0.1",
+			},
+			Project:      "33333333-3333-3333-3333-333333333333",
+			Organization: "44444444-4444-4444-4444-444444444444",
+		},
+	}
+	if !reflect.DeepEqual(servers, expectedServers) {
+		t.Fatalf("unexpected result\ngot\n%#v\nwant\n%#v", servers, expectedServers)
+	}
+}
+
+func TestGetServers_Failure(t *testing.T) {
+	s := newMockScalewayServer(func() []byte {
+		return []byte("some error")
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:    client,
+		zone: "fr-par-1",
+	}
+
+	if _, err := getServers(cfg); err == nil {
+		t.Fatalf("expecting non-nil error from getServers()")
+	}
+}
+
+func TestGetServers_Paging(t *testing.T) {
+	requestCount := 0
+	s := newMockScalewayServer(func() []byte {
+		requestCount++
+		if requestCount == 1 {
+			return []byte(mockFullPageResp())
+		}
+		return []byte(mockPartialPageResp())
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:    client,
+		zone: "fr-par-1",
+	}
+
+	servers, err := getServers(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getServers(): %s", err)
+	}
+	if len(servers) != serversPerPage+1 {
+		t.Fatalf("unexpected number of servers; got %d; want %d", len(servers), serversPerPage+1)
+	}
+	if requestCount != 2 {
+		t.Fatalf("unexpected number of requests; got %d; want 2", requestCount)
+	}
+}
+
+func mockFullPageResp() string {
+	resp := `{"servers": [`
+	for i := 0; i < serversPerPage; i++ {
+		if i > 0 {
+			resp += ","
+		}
+		resp += `{"id": "server", "zone": "fr-par-1"}`
+	}
+	resp += `]}`
+	return resp
+}
+
+func mockPartialPageResp() string {
+	return `{"servers": [{"id": "last-server", "zone": "fr-par-1"}]}`
+}
