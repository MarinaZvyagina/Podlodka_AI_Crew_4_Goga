@@ -0,0 +1,43 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	f := func(sdc *SDConfig) {
+		t.Helper()
+		if _, err := newAPIConfig(sdc, "."); err == nil {
+			t.Fatalf("expecting non-nil error")
+		}
+	}
+
+	// missing zone
+	f(&SDConfig{
+		SecretKey: promauth.NewSecret("foobar"),
+	})
+
+	// missing secret_key
+	f(&SDConfig{
+		Zone: "fr-par-1",
+	})
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		Zone:      "fr-par-1",
+		SecretKey: promauth.NewSecret("foobar"),
+	}
+	cfg, err := newAPIConfig(sdc, ".")
+	if err != nil {
+		t.Fatalf("newAPIConfig() failed with, err: %v", err)
+	}
+	if cfg.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want 80", cfg.port)
+	}
+	if cfg.zone != "fr-par-1" {
+		t.Fatalf("unexpected zone; got %q; want %q", cfg.zone, "fr-par-1")
+	}
+}
