index 0000000..bec5b18
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api_test.go
@@ -0,0 +1,106 @@
+package scaleway
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestParseAPIResponse(t *testing.T) {
+	f := func(data string, responseExpected *listServersResponse) {
+		t.Helper()
+
+		response, err := parseAPIResponse([]byte(data))
+		if err != nil {
+			t.Fatalf("unexpected parseAPIResponse() error: %s", err)
+		}
+		if !reflect.DeepEqual(response, responseExpected) {
+			t.Fatalf("unexpected response\ngot\n%v\nwant\n%v", response, responseExpected)
+		}
+	}
+
+	data := `
+{
+  "servers": [
+    {
+      "id": "11111111-1111-1111-1111-111111111111",
+      "name": "web-1",
+      "hostname": "web-1",
+      "organization": "org-1",
+      "project": "proj-1",
+      "commercial_type": "DEV1-S",
+      "state": "running",
+      "arch": "x86_64",
+      "boot_type": "local",
+      "zone": "fr-par-1",
+      "tags": ["prod", "web"],
+      "private_ip": "10.10.10.10",
+      "public_ip": {
+        "id": "22222222-2222-2222-2222-222222222222",
+        "address": "163.172.1.1",
+        "dynamic": false
+      }
+    }
+  ],
+  "total_count": 1
+}`
+
+	privateIP := "10.10.10.10"
+	responseExpected := &listServersResponse{
+		Servers: []server{
+			{
+				ID:             "11111111-1111-1111-1111-111111111111",
+				Name:           "web-1",
+				Hostname:       "web-1",
+				Organization:   "org-1",
+				Project:        "proj-1",
+				CommercialType: "DEV1-S",
+				State:          "running",
+				Arch:           "x86_64",
+				BootType:       "local",
+				Zone:           "fr-par-1",
+				Tags:           []string{"prod", "web"},
+				PrivateIP:      &privateIP,
+				PublicIP:       &serverPublicIP{Address: "163.172.1.1"},
+			},
+		},
+		TotalCount: 1,
+	}
+	f(data, responseExpected)
+}
+
+func TestGetServers(t *testing.T) {
+	f := func(getAPIResponse func(string) ([]byte, error), expectedServerCount int) {
+		t.Helper()
+
+		servers, err := getServers("fr-par-1", "project=proj-1", getAPIResponse)
+		if err != nil {
+			t.Fatalf("getServers() error: %s", err)
+		}
+		if len(servers) != expectedServerCount {
+			t.Fatalf("unexpected servers count; got %d; want %d\nservers:\n%v", len(servers), expectedServerCount, servers)
+		}
+	}
+
+	fullPage := func() string {
+		s := `{"servers":[`
+		for i := 0; i < serversPerPage; i++ {
+			if i > 0 {
+				s += ","
+			}
+			s += `{"id":"srv","name":"srv","state":"running"}`
+		}
+		s += `],"total_count":250}`
+		return s
+	}()
+
+	callCount := 0
+	getAPIResponse := func(_ string) ([]byte, error) {
+		callCount++
+		if callCount <= 2 {
+			return []byte(fullPage), nil
+		}
+		return []byte(`{"servers":[{"id":"last","name":"last","state":"running"}],"total_count":250}`), nil
+	}
+
+	f(getAPIResponse, serversPerPage*2+1)
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway.go b/lib/promscrape/discovery/scaleway/scaleway.go
new file mode 100644
index 0000000..8b232a0
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway.go
@@ -0,0 +1,147 @@
+package scaleway
+
+import (
+	"flag"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/proxy"
+)
+
+// SDCheckInterval defines interval for targets refresh.
+var SDCheckInterval = flag.Duration("promscrape.scalewaySDCheckInterval", time.Minute, "Interval for checking for changes in Scaleway Instances. "+
+	"This works only if scaleway_sd_configs is configured in '-promscrape.config' file. "+
+	"See https://docs.victoriametrics.com/victoriametrics/sd_configs/#scaleway_sd_configs for details")
+
+// SDConfig represents service discovery config for Scaleway Instances.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type SDConfig struct {
+	// APIServer is an optional Scaleway API server to query.
+	// By default, https://api.scaleway.com is used.
+	APIServer string `yaml:"api_server,omitempty"`
+
+	// Zone is the Scaleway zone to discover instances in, e.g. `fr-par-1`, `nl-ams-1`, `pl-waw-1`, etc.
+	// By default, `fr-par-1` is used.
+	Zone string `yaml:"zone,omitempty"`
+
+	// ProjectID optionally filters the discovered instances by the given Scaleway project id.
+	ProjectID string `yaml:"project_id,omitempty"`
+
+	// OrganizationID optionally filters the discovered instances by the given Scaleway organization id.
+	OrganizationID string `yaml:"organization_id,omitempty"`
+
+	HTTPClientConfig  promauth.HTTPClientConfig  `yaml:",inline"`
+	ProxyURL          *proxy.URL                 `yaml:"proxy_url,omitempty"`
+	ProxyClientConfig promauth.ProxyClientConfig `yaml:",inline"`
+	Port              int                        `yaml:"port,omitempty"`
+}
+
+// GetLabels returns Scaleway instance labels according to sdc.
+func (sdc *SDConfig) GetLabels(baseDir string) ([]*promutil.Labels, error) {
+	cfg, err := getAPIConfig(sdc, baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot get API config: %w", err)
+	}
+	servers, err := getServers(cfg.zone, cfg.listQueryParams, cfg.client.GetAPIResponse)
+	if err != nil {
+		return nil, err
+	}
+	return addServerLabels(servers, cfg.zone, cfg.port), nil
+}
+
+// MustStop stops further usage for sdc.
+func (sdc *SDConfig) MustStop() {
+	v := configMap.Delete(sdc)
+	if v != nil {
+		cfg := v.(*apiConfig)
+		cfg.client.Stop()
+	}
+}
+
+// server represents a subset of the Scaleway Instance API server object.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type server struct {
+	ID             string          `json:"id"`
+	Name           string          `json:"name"`
+	Hostname       string          `json:"hostname"`
+	Organization   string          `json:"organization"`
+	Project        string          `json:"project"`
+	CommercialType string          `json:"commercial_type"`
+	State          string          `json:"state"`
+	Arch           string          `json:"arch"`
+	BootType       string          `json:"boot_type"`
+	Zone           string          `json:"zone"`
+	Tags           []string        `json:"tags"`
+	PrivateIP      *string         `json:"private_ip"`
+	PublicIP       *serverPublicIP `json:"public_ip"`
+}
+
+type serverPublicIP struct {
+	Address string `json:"address"`
+}
+
+// listServersResponse is the response structure of the Scaleway Instance list servers API.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type listServersResponse struct {
+	Servers    []server `json:"servers"`
+	TotalCount int      `json:"total_count"`
+}
+
+func addServerLabels(servers []server, zone string, defaultPort int) []*promutil.Labels {
+	var ms []*promutil.Labels
+	for _, srv := range servers {
+		if srv.State != "running" {
+			continue
+		}
+
+		var publicIP, privateIP string
+		if srv.PublicIP != nil {
+			publicIP = srv.PublicIP.Address
+		}
+		if srv.PrivateIP != nil {
+			privateIP = *srv.PrivateIP
+		}
+
+		addr := publicIP
+		if addr == "" {
+			addr = privateIP
+		}
+		if addr == "" {
+			// The instance has no usable IP address to scrape.
+			continue
+		}
+
+		instanceZone := srv.Zone
+		if instanceZone == "" {
+			instanceZone = zone
+		}
+
+		m := promutil.NewLabels(16)
+		m.Add("__address__", discoveryutil.JoinHostPort(addr, defaultPort))
+		m.Add("__meta_scaleway_instance_id", srv.ID)
+		m.Add("__meta_scaleway_instance_name", srv.Name)
+		m.Add("__meta_scaleway_instance_hostname", srv.Hostname)
+		m.Add("__meta_scaleway_instance_zone", instanceZone)
+		m.Add("__meta_scaleway_instance_type", srv.CommercialType)
+		m.Add("__meta_scaleway_instance_state", srv.State)
+		m.Add("__meta_scaleway_instance_arch", srv.Arch)
+		m.Add("__meta_scaleway_instance_boot_type", srv.BootType)
+		m.Add("__meta_scaleway_instance_project_id", srv.Project)
+		m.Add("__meta_scaleway_instance_organization_id", srv.Organization)
+		m.Add("__meta_scaleway_instance_public_ipv4", publicIP)
+		m.Add("__meta_scaleway_instance_private_ipv4", privateIP)
+		if len(srv.Tags) > 0 {
+			tags := fmt.Sprintf(",%s,", strings.Join(srv.Tags, ","))
+			m.Add("__meta_scaleway_instance_tags", tags)
+		}
+		ms = append(ms, m)
+	}
+	return ms
+}
