index 0000000..28e76fe
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api_test.go
@@ -0,0 +1,227 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	f := func(sdc *SDConfig) {
+		t.Helper()
+		if _, err := newAPIConfig(sdc, "."); err == nil {
+			t.Fatalf("expecting non-nil error")
+		}
+	}
+
+	// missing project_id
+	f(&SDConfig{
+		SecretKey: &promauth.Secret{S: "foobar"},
+	})
+
+	// missing secret_key
+	f(&SDConfig{
+		Project: "my-project",
+	})
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		Project:   "my-project",
+		SecretKey: &promauth.Secret{S: "foobar"},
+	}
+	cfg, err := newAPIConfig(sdc, ".")
+	if err != nil {
+		t.Fatalf("newAPIConfig() failed unexpectedly: %s", err)
+	}
+	if cfg.zone != defaultZone {
+		t.Fatalf("unexpected default zone; got %q; want %q", cfg.zone, defaultZone)
+	}
+	if cfg.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want 80", cfg.port)
+	}
+}
+
+// mockScalewayServer is a fake Scaleway API server used in tests.
+type mockScalewayServer struct {
+	*httptest.Server
+
+	// lastAuthToken contains the X-Auth-Token header value received by the last request.
+	lastAuthToken string
+
+	responseFunc func(r *http.Request) []byte
+}
+
+func newMockScalewayServer(responseFunc func(r *http.Request) []byte) *mockScalewayServer {
+	var s mockScalewayServer
+	s.responseFunc = responseFunc
+	s.Server = httptest.NewServer(http.HandlerFunc(s.handler))
+	return &s
+}
+
+func (s *mockScalewayServer) handler(w http.ResponseWriter, r *http.Request) {
+	s.lastAuthToken = r.Header.Get("X-Auth-Token")
+	w.Write(s.responseFunc(r))
+}
+
+func TestGetServers_Success(t *testing.T) {
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		return []byte(`{
+			"servers": [{
+				"id": "11111111-1111-1111-1111-111111111111",
+				"name": "prod-web-1",
+				"hostname": "prod-web-1",
+				"organization": "22222222-2222-2222-2222-222222222222",
+				"project": "33333333-3333-3333-3333-333333333333",
+				"commercial_type": "DEV1-S",
+				"state": "running",
+				"zone": "fr-par-1",
+				"arch": "x86_64",
+				"boot_type": "local",
+				"private_ip": "10.10.10.10",
+				"public_ip": {
+					"id": "66666666-6666-6666-6666-666666666666",
+					"address": "51.15.10.10"
+				},
+				"tags": ["prod", "web"]
+			}]
+		}`)
+	})
+	defer s.Close()
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		client:    client,
+		project:   "33333333-3333-3333-3333-333333333333",
+		zone:      "fr-par-1",
+		secretKey: "my-secret-key",
+	}
+
+	servers, err := getServers(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getServers(): %s", err)
+	}
+
+	expectedServers := []server{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "prod-web-1",
+			Hostname:       "prod-web-1",
+			Organization:   "22222222-2222-2222-2222-222222222222",
+			Project:        "33333333-3333-3333-3333-333333333333",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Zone:           "fr-par-1",
+			Arch:           "x86_64",
+			BootType:       "local",
+			PrivateIP:      "10.10.10.10",
+			PublicIP: &serverIP{
+				Address: "51.15.10.10",
+			},
+			Tags: []string{"prod", "web"},
+		},
+	}
+	if !reflect.DeepEqual(servers, expectedServers) {
+		t.Fatalf("unexpected result\ngot\n%#v\nwant\n%#v", servers, expectedServers)
+	}
+	if s.lastAuthToken != "my-secret-key" {
+		t.Fatalf("unexpected X-Auth-Token header sent; got %q; want %q", s.lastAuthToken, "my-secret-key")
+	}
+}
+
+func TestGetServers_Failure(t *testing.T) {
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		return []byte("some error")
+	})
+	defer s.Close()
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		client:    client,
+		project:   "my-project",
+		zone:      "fr-par-1",
+		secretKey: "my-secret-key",
+	}
+
+	if _, err := getServers(cfg); err == nil {
+		t.Fatalf("expecting non-nil error from getServers()")
+	}
+}
+
+func TestGetServers_Paging(t *testing.T) {
+	requestCount := 0
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		requestCount++
+		if requestCount == 1 {
+			// a full page of serversPerPage servers - the caller must request the next page.
+			return mockFullPageResponse()
+		}
+		// second, non-full page - the caller must stop after this page.
+		return []byte(`{
+			"servers": [{
+				"id": "last-server",
+				"name": "last-server",
+				"zone": "fr-par-1",
+				"private_ip": "10.10.10.99"
+			}]
+		}`)
+	})
+	defer s.Close()
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		client:    client,
+		project:   "my-project",
+		zone:      "fr-par-1",
+		secretKey: "my-secret-key",
+	}
+
+	servers, err := getServers(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getServers(): %s", err)
+	}
+	if requestCount != 2 {
+		t.Fatalf("unexpected number of requests sent; got %d; want 2", requestCount)
+	}
+	if len(servers) != serversPerPage+1 {
+		t.Fatalf("unexpected number of servers returned; got %d; want %d", len(servers), serversPerPage+1)
+	}
+	if servers[len(servers)-1].ID != "last-server" {
+		t.Fatalf("unexpected last server id; got %q; want %q", servers[len(servers)-1].ID, "last-server")
+	}
+}
+
+// mockFullPageResponse returns a listServersResponse JSON payload containing exactly serversPerPage servers.
+func mockFullPageResponse() []byte {
+	resp := listServersResponse{
+		Servers: make([]server, serversPerPage),
+	}
+	for i := range resp.Servers {
+		resp.Servers[i] = server{
+			ID:        fmt.Sprintf("server-%d", i),
+			Name:      fmt.Sprintf("server-%d", i),
+			Zone:      "fr-par-1",
+			PrivateIP: "10.10.10.10",
+		}
+	}
+	data, err := json.Marshal(resp)
+	if err != nil {
+		panic(fmt.Sprintf("BUG: cannot marshal mock response: %s", err))
+	}
+	return data
+}
