+
+func TestAddServerLabels(t *testing.T) {
+	servers := []server{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "prod-web-1",
+			Hostname:       "prod-web-1",
+			Organization:   "22222222-2222-2222-2222-222222222222",
+			Project:        "33333333-3333-3333-3333-333333333333",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Zone:           "fr-par-1",
+			Arch:           "x86_64",
+			BootType:       "local",
+			PrivateIP:      "10.10.10.10",
+			PublicIP: &serverIP{
+				Address: "51.15.10.10",
+			},
+			Tags: []string{"prod", "web"},
+		},
+		{
+			// instance without a public IP - should fall back to the private IP.
+			ID:             "44444444-4444-4444-4444-444444444444",
+			Name:           "internal-db-1",
+			Hostname:       "internal-db-1",
+			Organization:   "22222222-2222-2222-2222-222222222222",
+			Project:        "33333333-3333-3333-3333-333333333333",
+			CommercialType: "DEV1-M",
+			State:          "stopped",
+			Zone:           "nl-ams-2",
+			Arch:           "x86_64",
+			BootType:       "local",
+			PrivateIP:      "10.10.10.20",
+		},
+		{
+			// instance without any IP address - must be skipped.
+			ID:    "55555555-5555-5555-5555-555555555555",
+			Name:  "no-address",
+			State: "starting",
+			Zone:  "fr-par-1",
+		},
+	}
+
+	labelss := addServerLabels(servers, 9100)
+
+	expectedLabelss := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "51.15.10.10:9100",
+			"__meta_scaleway_instance_id":              "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":            "prod-web-1",
+			"__meta_scaleway_instance_hostname":        "prod-web-1",
+			"__meta_scaleway_instance_state":           "running",
+			"__meta_scaleway_instance_zone":            "fr-par-1",
+			"__meta_scaleway_instance_region":          "fr-par",
+			"__meta_scaleway_instance_type":            "DEV1-S",
+			"__meta_scaleway_instance_arch":            "x86_64",
+			"__meta_scaleway_instance_boot_type":       "local",
+			"__meta_scaleway_instance_organization_id": "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_project_id":      "33333333-3333-3333-3333-333333333333",
+			"__meta_scaleway_instance_public_ipv4":     "51.15.10.10",
+			"__meta_scaleway_instance_private_ipv4":    "10.10.10.10",
+			"__meta_scaleway_instance_tags":            ",prod,web,",
+		}),
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "10.10.10.20:9100",
+			"__meta_scaleway_instance_id":              "44444444-4444-4444-4444-444444444444",
+			"__meta_scaleway_instance_name":            "internal-db-1",
+			"__meta_scaleway_instance_hostname":        "internal-db-1",
+			"__meta_scaleway_instance_state":           "stopped",
+			"__meta_scaleway_instance_zone":            "nl-ams-2",
+			"__meta_scaleway_instance_region":          "nl-ams",
+			"__meta_scaleway_instance_type":            "DEV1-M",
+			"__meta_scaleway_instance_arch":            "x86_64",
+			"__meta_scaleway_instance_boot_type":       "local",
+			"__meta_scaleway_instance_organization_id": "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_project_id":      "33333333-3333-3333-3333-333333333333",
+			"__meta_scaleway_instance_public_ipv4":     "",
+			"__meta_scaleway_instance_private_ipv4":    "10.10.10.20",
+		}),
+	}
+
+	discoveryutil.TestEqualLabelss(t, labelss, expectedLabelss)
+}
+
+func TestZoneToRegion(t *testing.T) {
+	f := func(zone, expectedRegion string) {
+		t.Helper()
+		region := zoneToRegion(zone)
+		if region != expectedRegion {
+			t.Fatalf("unexpected region for zone %q; got %q; want %q", zone, region, expectedRegion)
+		}
+	}
+	f("fr-par-1", "fr-par")
+	f("fr-par-2", "fr-par")
+	f("nl-ams-1", "nl-ams")
+	f("pl-waw-1", "pl-waw")
+	f("", "")
+}
