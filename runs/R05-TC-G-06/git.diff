+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func TestGetInstanceLabels(t *testing.T) {
+	input := []Instance{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "scaleway-sd",
+			Hostname:       "scaleway-sd",
+			Zone:           "fr-par-1",
+			State:          "running",
+			CommercialType: "DEV1-S",
+			Tags:           []string{"web", "prod"},
+			Project:        "22222222-2222-2222-2222-222222222222",
+			Organization:   "33333333-3333-3333-3333-333333333333",
+			PrivateIP:      "10.14.0.5",
+			PublicIP: &ServerIP{
+				Address: "51.15.0.1",
+			},
+		},
+		{
+			// Instance without a public IP address - __address__ must fall back to the private IP.
+			ID:             "44444444-4444-4444-4444-444444444444",
+			Name:           "scaleway-sd-private-only",
+			Hostname:       "scaleway-sd-private-only",
+			Zone:           "fr-par-1",
+			State:          "running",
+			CommercialType: "DEV1-S",
+			PrivateIP:      "10.14.0.6",
+		},
+		{
+			// Instance without any IP address must be skipped.
+			ID:   "55555555-5555-5555-5555-555555555555",
+			Name: "scaleway-sd-no-ip",
+			Zone: "fr-par-1",
+		},
+	}
+
+	expect := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "51.15.0.1:8080",
+			"__meta_scaleway_instance_id":              "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":            "scaleway-sd",
+			"__meta_scaleway_instance_hostname":        "scaleway-sd",
+			"__meta_scaleway_instance_zone":            "fr-par-1",
+			"__meta_scaleway_instance_state":           "running",
+			"__meta_scaleway_instance_commercial_type": "DEV1-S",
+			"__meta_scaleway_instance_project_id":      "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_organization_id": "33333333-3333-3333-3333-333333333333",
+			"__meta_scaleway_instance_public_ip":       "51.15.0.1",
+			"__meta_scaleway_instance_private_ip":      "10.14.0.5",
+			"__meta_scaleway_instance_tags":            ",web,prod,",
+		}),
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "10.14.0.6:8080",
+			"__meta_scaleway_instance_id":              "44444444-4444-4444-4444-444444444444",
+			"__meta_scaleway_instance_name":            "scaleway-sd-private-only",
+			"__meta_scaleway_instance_hostname":        "scaleway-sd-private-only",
+			"__meta_scaleway_instance_zone":            "fr-par-1",
+			"__meta_scaleway_instance_state":           "running",
+			"__meta_scaleway_instance_commercial_type": "DEV1-S",
+			"__meta_scaleway_instance_project_id":      "",
+			"__meta_scaleway_instance_organization_id": "",
+			"__meta_scaleway_instance_public_ip":       "",
+			"__meta_scaleway_instance_private_ip":      "10.14.0.6",
+		}),
+	}
+	labels := getInstanceLabels(input, 8080)
+	discoveryutil.TestEqualLabelss(t, labels, expect)
+}
