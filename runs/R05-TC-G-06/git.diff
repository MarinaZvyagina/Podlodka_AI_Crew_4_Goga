@@ -0,0 +1,62 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	sdc := &SDConfig{}
+	baseDir := "."
+	_, err := newAPIConfig(sdc, baseDir)
+	if err == nil {
+		t.Fatalf("expecting non-nil error")
+	}
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		SecretKey: &promauth.Secret{
+			S: "foobar",
+		},
+	}
+	baseDir := "."
+	cfg, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	if cfg.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want 80", cfg.port)
+	}
+	if len(cfg.zones) != 1 || cfg.zones[0] != "fr-par-1" {
+		t.Fatalf("unexpected default zones; got %v; want [fr-par-1]", cfg.zones)
+	}
+}
+
+func TestNewAPIConfig_CustomZonesAndPort(t *testing.T) {
+	sdc := &SDConfig{
+		SecretKey: &promauth.Secret{
+			S: "foobar",
+		},
+		Zones:          []string{"fr-par-1", "nl-ams-1"},
+		Port:           9100,
+		ProjectID:      "project-id",
+		OrganizationID: "org-id",
+	}
+	baseDir := "."
+	cfg, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	if cfg.port != 9100 {
+		t.Fatalf("unexpected port; got %d; want 9100", cfg.port)
+	}
+	if len(cfg.zones) != 2 || cfg.zones[0] != "fr-par-1" || cfg.zones[1] != "nl-ams-1" {
+		t.Fatalf("unexpected zones; got %v", cfg.zones)
+	}
+	want := "organization=org-id&project=project-id"
+	if cfg.listQueryParams != want {
+		t.Fatalf("unexpected listQueryParams; got %q; want %q", cfg.listQueryParams, want)
+	}
+}
diff --git a/lib/promscrape/discovery/scaleway/instance.go b/lib/promscrape/discovery/scaleway/instance.go
new file mode 100644
index 0000000..1dc07be
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/instance.go
@@ -0,0 +1,91 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+)
+
+// instancesPerPage is the maximum number of instances requested per API call.
+const instancesPerPage = 100
+
+// listServersResponse is the response structure of the Scaleway Instances "list servers" API.
+//
+// See: https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type listServersResponse struct {
+	Servers    []Instance `json:"servers"`
+	TotalCount int        `json:"total_count"`
+}
+
+// Instance represents a Scaleway Instance (server).
+//
+// See: https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type Instance struct {
+	ID             string    `json:"id"`
+	Name           string    `json:"name"`
+	Hostname       string    `json:"hostname"`
+	Zone           string    `json:"zone"`
+	State          string    `json:"state"`
+	CommercialType string    `json:"commercial_type"`
+	Tags           []string  `json:"tags"`
+	Project        string    `json:"project"`
+	Organization   string    `json:"organization"`
+	PrivateIP      string    `json:"private_ip"`
+	PublicIP       *ServerIP `json:"public_ip"`
+}
+
+// ServerIP represents the public IP address attached to a Scaleway Instance.
+type ServerIP struct {
+	Address string `json:"address"`
+}
+
+// PublicIPAddress returns the public IPv4 address of the instance, or an empty string if it has none.
+func (inst *Instance) PublicIPAddress() string {
+	if inst.PublicIP == nil {
+		return ""
+	}
+	return inst.PublicIP.Address
+}
+
+// getInstances retrieves instances from the Scaleway Instances API across all the configured zones.
+func getInstances(cfg *apiConfig) ([]Instance, error) {
+	var instances []Instance
+	for _, zone := range cfg.zones {
+		zoneInstances, err := getInstancesForZone(cfg, zone)
+		if err != nil {
+			return nil, err
+		}
+		instances = append(instances, zoneInstances...)
+	}
+	return instances, nil
+}
+
+func getInstancesForZone(cfg *apiConfig, zone string) ([]Instance, error) {
+	var instances []Instance
+
+	page := 1
+	for {
+		// See: https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?%s&page=%d&per_page=%d", zone, cfg.listQueryParams, page, instancesPerPage)
+		data, err := cfg.c.GetAPIResponseWithReqParams(path, func(req *http.Request) {
+			req.Header.Set("X-Auth-Token", cfg.secretKey)
+		})
+		if err != nil {
+			return nil, fmt.Errorf("cannot get Scaleway response from %q: %w", path, err)
+		}
+
+		var resp listServersResponse
+		if err := json.Unmarshal(data, &resp); err != nil {
+			return nil, fmt.Errorf("cannot unmarshal listServersResponse obtained from %q: %w; response=%q", path, err, data)
+		}
+
+		instances = append(instances, resp.Servers...)
+
+		if len(resp.Servers) == 0 || len(instances) >= resp.TotalCount {
+			break
+		}
+		page++
+	}
+
+	return instances, nil
+}
