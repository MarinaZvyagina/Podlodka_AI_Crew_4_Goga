diff --git a/lib/promscrape/discovery/scaleway/api.go b/lib/promscrape/discovery/scaleway/api.go
new file mode 100644
index 0000000..e643fb4
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api.go
@@ -0,0 +1,150 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/url"
+	"strings"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+var configMap = discoveryutil.NewConfigMap()
+
+// apiConfig contains config for API server.
+type apiConfig struct {
+	client *discoveryutil.Client
+	port   int
+	zone   string
+
+	// filterQueryParam is either `project=<project_id>` or `organization=<organization_id>`,
+	// depending on which of these options is set in SDConfig.
+	filterQueryParam string
+}
+
+// getAPIConfig gets or creates API config from configMap.
+func getAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	v, err := configMap.Get(sdc, func() (any, error) { return newAPIConfig(sdc, baseDir) })
+	if err != nil {
+		return nil, err
+	}
+	return v.(*apiConfig), nil
+}
+
+func newAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	if sdc.Zone == "" {
+		return nil, fmt.Errorf("`zone` cannot be empty in `scaleway_sd_configs`")
+	}
+	if sdc.ProjectID == "" && sdc.OrganizationID == "" {
+		return nil, fmt.Errorf("either `project_id` or `organization_id` must be set in `scaleway_sd_configs`")
+	}
+
+	apiServer := sdc.Server
+	if apiServer == "" {
+		apiServer = "https://api.scaleway.com"
+	}
+	if !strings.Contains(apiServer, "://") {
+		scheme := "http"
+		if sdc.HTTPClientConfig.TLSConfig != nil {
+			scheme = "https"
+		}
+		apiServer = scheme + "://" + apiServer
+	}
+
+	ac, err := sdc.HTTPClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse auth config: %w", err)
+	}
+	proxyAC, err := sdc.ProxyClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse proxy auth config: %w", err)
+	}
+	client, err := discoveryutil.NewClient(apiServer, ac, sdc.ProxyURL, proxyAC, &sdc.HTTPClientConfig)
+	if err != nil {
+		return nil, fmt.Errorf("cannot create HTTP client for %q: %w", apiServer, err)
+	}
+
+	port := sdc.Port
+	if port == 0 {
+		port = 80
+	}
+
+	filterQueryParam := "project=" + url.QueryEscape(sdc.ProjectID)
+	if sdc.ProjectID == "" {
+		filterQueryParam = "organization=" + url.QueryEscape(sdc.OrganizationID)
+	}
+
+	cfg := &apiConfig{
+		client:           client,
+		port:             port,
+		zone:             sdc.Zone,
+		filterQueryParam: filterQueryParam,
+	}
+	return cfg, nil
+}
+
+// server represents a Scaleway Instance.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type server struct {
+	ID             string    `json:"id"`
+	Name           string    `json:"name"`
+	Hostname       string    `json:"hostname"`
+	CommercialType string    `json:"commercial_type"`
+	State          string    `json:"state"`
+	Tags           []string  `json:"tags"`
+	PublicIP       *publicIP `json:"public_ip"`
+	PrivateIP      *string   `json:"private_ip"`
+	IPv6           *ipv6     `json:"ipv6"`
+	Project        string    `json:"project"`
+	Organization   string    `json:"organization"`
+}
+
+type publicIP struct {
+	Address string `json:"address"`
+}
+
+type ipv6 struct {
+	Address string `json:"address"`
+}
+
+// listServersResponse is the response of the Scaleway `list servers` API.
+type listServersResponse struct {
+	Servers    []server `json:"servers"`
+	TotalCount int      `json:"total_count"`
+}
+
+const serversAPIPathFmt = "/instance/v1/zones/%s/servers"
+
+// getServers retrieves the list of servers (instances) from the Scaleway API.
+func getServers(cfg *apiConfig) ([]server, error) {
+	const perPage = 100
+
+	var servers []server
+	page := 1
+	for {
+		path := fmt.Sprintf("%s?%s&per_page=%d&page=%d", fmt.Sprintf(serversAPIPathFmt, cfg.zone), cfg.filterQueryParam, perPage, page)
+		data, err := cfg.client.GetAPIResponse(path)
+		if err != nil {
+			return nil, fmt.Errorf("cannot query Scaleway API for servers: %w", err)
+		}
+		resp, err := parseAPIResponse(data)
+		if err != nil {
+			return nil, err
+		}
+		servers = append(servers, resp.Servers...)
+		if len(resp.Servers) == 0 || len(servers) >= resp.TotalCount {
+			break
+		}
+		page++
+	}
+	return servers, nil
+}
+
+func parseAPIResponse(data []byte) (*listServersResponse, error) {
+	var resp listServersResponse
+	if err := json.Unmarshal(data, &resp); err != nil {
+		return nil, fmt.Errorf("cannot parse Scaleway API response %q: %w", data, err)
+	}
+	return &resp, nil
+}
diff --git a/lib/promscrape/discovery/scaleway/api_test.go b/lib/promscrape/discovery/scaleway/api_test.go
