--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/mock_server_test.go
@@ -0,0 +1,23 @@
+package scaleway
+
+import (
+	"net/http"
+	"net/http/httptest"
+)
+
+type mockScalewayServer struct {
+	*httptest.Server
+	responseFunc func() []byte
+}
+
+func newMockScalewayServer(responseFunc func() []byte) *mockScalewayServer {
+	var s mockScalewayServer
+	s.responseFunc = responseFunc
+	s.Server = httptest.NewServer(http.HandlerFunc(s.handler))
+	return &s
+}
+
+func (s *mockScalewayServer) handler(w http.ResponseWriter, _ *http.Request) {
+	data := s.responseFunc()
+	w.Write(data)
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway.go b/lib/promscrape/discovery/scaleway/scaleway.go
new file mode 100644
index 0000000..00b1651
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway.go
@@ -0,0 +1,116 @@
+package scaleway
+
+import (
+	"flag"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/VictoriaMetrics/metrics"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/proxy"
+)
+
+// SDCheckInterval defines interval for targets refresh.
+var SDCheckInterval = flag.Duration("promscrape.scalewaySDCheckInterval", 30*time.Second, "Interval for checking for changes in Scaleway. "+
+	"This works only if scaleway_sd_configs is configured in '-promscrape.config' file. "+
+	"See https://docs.victoriametrics.com/victoriametrics/sd_configs/#scaleway_sd_configs for details")
+
+// failuresTotal counts failed Scaleway SD refresh attempts.
+var failuresTotal = metrics.NewCounter(`vm_promscrape_discovery_scaleway_failures_total`)
+
+// SDConfig represents service discovery config for Scaleway Instances.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type SDConfig struct {
+	// Server is an optional Scaleway API server to query.
+	// By default, https://api.scaleway.com is used.
+	Server string `yaml:"server,omitempty"`
+
+	// Zone is the Scaleway zone to discover instances in, e.g. "fr-par-1".
+	// See https://www.scaleway.com/en/developers/api/#regions-and-zones for the list of available zones.
+	Zone string `yaml:"zone"`
+
+	// ProjectID is the id of the Scaleway project to discover instances in.
+	// Either ProjectID or OrganizationID must be set.
+	ProjectID string `yaml:"project_id,omitempty"`
+
+	// OrganizationID is the id of the Scaleway organization to discover instances in.
+	// It is used only if ProjectID isn't set.
+	OrganizationID string `yaml:"organization_id,omitempty"`
+
+	// Port is the port to scrape metrics from. By default, port 80 is used.
+	Port int `yaml:"port,omitempty"`
+
+	HTTPClientConfig  promauth.HTTPClientConfig  `yaml:",inline"`
+	ProxyURL          *proxy.URL                 `yaml:"proxy_url,omitempty"`
+	ProxyClientConfig promauth.ProxyClientConfig `yaml:",inline"`
+}
+
+// GetLabels returns Scaleway instance labels according to sdc.
+func (sdc *SDConfig) GetLabels(baseDir string) ([]*promutil.Labels, error) {
+	cfg, err := getAPIConfig(sdc, baseDir)
+	if err != nil {
+		failuresTotal.Inc()
+		return nil, fmt.Errorf("cannot get API config: %w", err)
+	}
+	servers, err := getServers(cfg)
+	if err != nil {
+		failuresTotal.Inc()
+		return nil, err
+	}
+	return addServerLabels(servers, cfg.zone, cfg.port), nil
+}
+
+func addServerLabels(servers []server, zone string, defaultPort int) []*promutil.Labels {
+	ms := make([]*promutil.Labels, 0, len(servers))
+	for _, srv := range servers {
+		var publicIPv4, privateIPv4, publicIPv6 string
+		if srv.PublicIP != nil {
+			publicIPv4 = srv.PublicIP.Address
+		}
+		if srv.PrivateIP != nil {
+			privateIPv4 = *srv.PrivateIP
+		}
+		if srv.IPv6 != nil {
+			publicIPv6 = srv.IPv6.Address
+		}
+		if publicIPv4 == "" && privateIPv4 == "" {
+			// Skip instances without any known address, since there is nothing to scrape.
+			continue
+		}
+
+		addr := discoveryutil.JoinHostPort(publicIPv4, defaultPort)
+		m := promutil.NewLabels(16)
+		m.Add("__address__", addr)
+		m.Add("__meta_scaleway_instance_id", srv.ID)
+		m.Add("__meta_scaleway_instance_name", srv.Name)
+		m.Add("__meta_scaleway_instance_hostname", srv.Hostname)
+		m.Add("__meta_scaleway_instance_type", srv.CommercialType)
+		m.Add("__meta_scaleway_instance_status", srv.State)
+		m.Add("__meta_scaleway_instance_zone", zone)
+		m.Add("__meta_scaleway_instance_public_ipv4", publicIPv4)
+		m.Add("__meta_scaleway_instance_private_ipv4", privateIPv4)
+		m.Add("__meta_scaleway_instance_public_ipv6", publicIPv6)
+		m.Add("__meta_scaleway_instance_project_id", srv.Project)
+		m.Add("__meta_scaleway_instance_organization_id", srv.Organization)
+		if len(srv.Tags) > 0 {
+			tags := "," + strings.Join(srv.Tags, ",") + ","
+			m.Add("__meta_scaleway_instance_tags", tags)
+		}
+		ms = append(ms, m)
+	}
+	return ms
+}
+
+// MustStop stops further usage for sdc.
+func (sdc *SDConfig) MustStop() {
+	v := configMap.Delete(sdc)
+	if v != nil {
+		cfg := v.(*apiConfig)
+		cfg.client.Stop()
+	}
+}
