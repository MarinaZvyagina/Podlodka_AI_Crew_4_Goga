+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func TestAddServerLabels(t *testing.T) {
+	privateIP := "10.10.10.10"
+	input := []server{
+		{
+			ID:             "fake-id-11111111-1111-1111-1111-fake",
+			Name:           "scw-sd-test",
+			Hostname:       "scw-sd-test",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Tags:           []string{"env:prod", "app:vmagent"},
+			PublicIP:       &publicIP{Address: "51.15.0.1"},
+			PrivateIP:      &privateIP,
+			IPv6:           &ipv6{Address: "2001:bc8::1"},
+			Project:        "project-id",
+			Organization:   "org-id",
+		},
+		{
+			// instance with no public IP, only private IP.
+			ID:             "fake-id-22222222-2222-2222-2222-fake",
+			Name:           "scw-sd-test-private",
+			Hostname:       "scw-sd-test-private",
+			CommercialType: "DEV1-M",
+			State:          "stopped",
+			PrivateIP:      &privateIP,
+			Project:        "project-id",
+			Organization:   "org-id",
+		},
+		{
+			// instance without any address must be skipped.
+			ID:             "fake-id-33333333-3333-3333-3333-fake",
+			Name:           "scw-sd-test-no-ip",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Project:        "project-id",
+			Organization:   "org-id",
+		},
+	}
+
+	expect := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "51.15.0.1:8080",
+			"__meta_scaleway_instance_id":              "fake-id-11111111-1111-1111-1111-fake",
+			"__meta_scaleway_instance_name":            "scw-sd-test",
+			"__meta_scaleway_instance_hostname":        "scw-sd-test",
+			"__meta_scaleway_instance_type":            "DEV1-S",
+			"__meta_scaleway_instance_status":          "running",
+			"__meta_scaleway_instance_zone":            "fr-par-1",
+			"__meta_scaleway_instance_public_ipv4":     "51.15.0.1",
+			"__meta_scaleway_instance_private_ipv4":    "10.10.10.10",
+			"__meta_scaleway_instance_public_ipv6":     "2001:bc8::1",
+			"__meta_scaleway_instance_project_id":      "project-id",
+			"__meta_scaleway_instance_organization_id": "org-id",
+			"__meta_scaleway_instance_tags":            ",env:prod,app:vmagent,",
+		}),
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              ":8080",
+			"__meta_scaleway_instance_id":              "fake-id-22222222-2222-2222-2222-fake",
+			"__meta_scaleway_instance_name":            "scw-sd-test-private",
+			"__meta_scaleway_instance_hostname":        "scw-sd-test-private",
+			"__meta_scaleway_instance_type":            "DEV1-M",
+			"__meta_scaleway_instance_status":          "stopped",
+			"__meta_scaleway_instance_zone":            "fr-par-1",
+			"__meta_scaleway_instance_public_ipv4":     "",
+			"__meta_scaleway_instance_private_ipv4":    "10.10.10.10",
+			"__meta_scaleway_instance_public_ipv6":     "",
+			"__meta_scaleway_instance_project_id":      "project-id",
+			"__meta_scaleway_instance_organization_id": "org-id",
+		}),
+	}
+
+	labels := addServerLabels(input, "fr-par-1", 8080)
+	discoveryutil.TestEqualLabelss(t, labels, expect)
+}
