@@ -0,0 +1,192 @@
+package scaleway
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	f := func(sdc *SDConfig) {
+		t.Helper()
+		if _, err := newAPIConfig(sdc, "."); err == nil {
+			t.Fatalf("expecting non-nil error")
+		}
+	}
+
+	// missing zone
+	f(&SDConfig{
+		ProjectID: "project-id",
+	})
+
+	// missing project_id and organization_id
+	f(&SDConfig{
+		Zone: "fr-par-1",
+	})
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		Zone:      "fr-par-1",
+		ProjectID: "project-id",
+		HTTPClientConfig: promauth.HTTPClientConfig{
+			BearerToken: &promauth.Secret{
+				S: "foobar",
+			},
+		},
+	}
+	cfg, err := newAPIConfig(sdc, ".")
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	if cfg.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want 80", cfg.port)
+	}
+	if cfg.zone != "fr-par-1" {
+		t.Fatalf("unexpected zone; got %q; want %q", cfg.zone, "fr-par-1")
+	}
+	if cfg.filterQueryParam != "project=project-id" {
+		t.Fatalf("unexpected filterQueryParam; got %q; want %q", cfg.filterQueryParam, "project=project-id")
+	}
+}
+
+func TestGetServers_Success(t *testing.T) {
+	s := newMockScalewayServer(func() []byte {
+		const resp = `{
+			"servers": [{
+				"id": "fake-id-11111111-1111-1111-1111-fake",
+				"name": "scw-sd-test",
+				"hostname": "scw-sd-test",
+				"commercial_type": "DEV1-S",
+				"state": "running",
+				"tags": ["env:prod", "app:vmagent"],
+				"public_ip": {"id": "fake-ip-id", "address": "51.15.0.1", "dynamic": false},
+				"private_ip": "10.10.10.10",
+				"ipv6": null,
+				"project": "project-id",
+				"organization": "org-id"
+			}],
+			"total_count": 1
+		}`
+		return []byte(resp)
+	})
+	defer s.Close()
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		client:           client,
+		port:             80,
+		zone:             "fr-par-1",
+		filterQueryParam: "project=project-id",
+	}
+
+	servers, err := getServers(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getServers(): %s", err)
+	}
+
+	privateIP := "10.10.10.10"
+	expectedServers := []server{
+		{
+			ID:             "fake-id-11111111-1111-1111-1111-fake",
+			Name:           "scw-sd-test",
+			Hostname:       "scw-sd-test",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Tags:           []string{"env:prod", "app:vmagent"},
+			PublicIP:       &publicIP{Address: "51.15.0.1"},
+			PrivateIP:      &privateIP,
+			Project:        "project-id",
+			Organization:   "org-id",
+		},
+	}
+	if !reflect.DeepEqual(servers, expectedServers) {
+		t.Fatalf("unexpected result\ngot\n%#v\nwant\n%#v", servers, expectedServers)
+	}
+}
+
+func TestGetServers_Failure(t *testing.T) {
+	s := newMockScalewayServer(func() []byte {
+		return []byte("some error")
+	})
+	defer s.Close()
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		client:           client,
+		port:             80,
+		zone:             "fr-par-1",
+		filterQueryParam: "project=project-id",
+	}
+
+	if _, err := getServers(cfg); err == nil {
+		t.Fatalf("expecting non-nil error from getServers()")
+	}
+}
+
+func TestGetServers_Paging(t *testing.T) {
+	requestCount := 0
+	s := newMockScalewayServer(func() []byte {
+		if requestCount == 0 {
+			requestCount++
+			return []byte(mockListServersPage0Resp)
+		}
+		return []byte(mockListServersPage1Resp)
+	})
+	defer s.Close()
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		client:           client,
+		port:             80,
+		zone:             "fr-par-1",
+		filterQueryParam: "project=project-id",
+	}
+
+	servers, err := getServers(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getServers(): %s", err)
+	}
+	if len(servers) != 2 {
+		t.Fatalf("unexpected number of servers; got %d; want 2", len(servers))
+	}
+	if servers[0].ID != "1-fake-id" || servers[1].ID != "2-fake-id" {
+		t.Fatalf("unexpected servers returned: %#v", servers)
+	}
+}
+
+var (
+	mockListServersPage0Resp = `{
+		"servers": [{
+			"id": "1-fake-id",
+			"name": "scw-sd-test-0",
+			"commercial_type": "DEV1-S",
+			"state": "running",
+			"public_ip": {"address": "51.15.0.1"},
+			"project": "project-id"
+		}],
+		"total_count": 2
+	}`
+	mockListServersPage1Resp = `{
+		"servers": [{
+			"id": "2-fake-id",
+			"name": "scw-sd-test-1",
+			"commercial_type": "DEV1-S",
+			"state": "running",
+			"public_ip": {"address": "51.15.0.2"},
+			"project": "project-id"
+		}],
+		"total_count": 2
+	}`
+)
diff --git a/lib/promscrape/discovery/scaleway/mock_server_test.go b/lib/promscrape/discovery/scaleway/mock_server_test.go
