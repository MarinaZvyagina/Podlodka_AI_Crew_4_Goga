@@ -0,0 +1,83 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func TestZoneRegion(t *testing.T) {
+	f := func(zone, regionExpected string) {
+		t.Helper()
+		region := zoneRegion(zone)
+		if region != regionExpected {
+			t.Fatalf("unexpected region for zone=%q; got %q; want %q", zone, region, regionExpected)
+		}
+	}
+	f("fr-par-1", "fr-par")
+	f("nl-ams-2", "nl-ams")
+	f("noregionsuffix", "noregionsuffix")
+}
+
+func TestAddServerLabels(t *testing.T) {
+	f := func(servers []server, zone string, port int, labelssExpected []*promutil.Labels) {
+		t.Helper()
+		labelss := addServerLabels(servers, zone, port)
+		discoveryutil.TestEqualLabelss(t, labelss, labelssExpected)
+	}
+
+	// full set of fields
+	servers := []server{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "web-1",
+			Hostname:       "web-1",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Tags:           []string{"web", "prod"},
+			Zone:           "fr-par-1",
+			Organization:   "org-id",
+			Project:        "project-id",
+			PrivateIP:      "10.0.0.1",
+			PublicIP:       &serverPublicIP{Address: "51.15.0.1"},
+			SecurityGroup:  &serverIDNamed{ID: "sg-id", Name: "default"},
+			Image:          &serverImage{ID: "img-id", Name: "ubuntu-jammy", Arch: "x86_64"},
+		},
+		// stopped instances must be skipped
+		{
+			ID:    "22222222-2222-2222-2222-222222222222",
+			Name:  "web-2",
+			State: "stopped",
+		},
+		// running instances without any IP address must be skipped
+		{
+			ID:    "33333333-3333-3333-3333-333333333333",
+			Name:  "web-3",
+			State: "running",
+		},
+	}
+	labelssExpected := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                                  "51.15.0.1:80",
+			"__meta_scaleway_instance_id":                  "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":                "web-1",
+			"__meta_scaleway_instance_hostname":            "web-1",
+			"__meta_scaleway_instance_status":              "running",
+			"__meta_scaleway_instance_type":                "DEV1-S",
+			"__meta_scaleway_instance_zone":                "fr-par-1",
+			"__meta_scaleway_instance_region":              "fr-par",
+			"__meta_scaleway_instance_project_id":          "project-id",
+			"__meta_scaleway_instance_organization_id":     "org-id",
+			"__meta_scaleway_instance_public_ipv4":         "51.15.0.1",
+			"__meta_scaleway_instance_private_ipv4":        "10.0.0.1",
+			"__meta_scaleway_instance_security_group_id":   "sg-id",
+			"__meta_scaleway_instance_security_group_name": "default",
+			"__meta_scaleway_instance_image_id":            "img-id",
+			"__meta_scaleway_instance_image_name":          "ubuntu-jammy",
+			"__meta_scaleway_instance_image_arch":          "x86_64",
+			"__meta_scaleway_instance_tags":                ",web,prod,",
+		}),
+	}
+	f(servers, "fr-par-1", 80, labelssExpected)
+}
