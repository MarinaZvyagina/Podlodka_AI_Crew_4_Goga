+import (
+	"net/http"
+	"net/http/httptest"
+)
+
+type mockScalewayServer struct {
+	*httptest.Server
+	responseFunc func(r *http.Request) []byte
+	requests     []*http.Request
+}
+
+func newMockScalewayServer(responseFunc func(r *http.Request) []byte) *mockScalewayServer {
+	var s mockScalewayServer
+	s.responseFunc = responseFunc
+	s.Server = httptest.NewServer(http.HandlerFunc(s.handler))
+	return &s
+}
+
+func (s *mockScalewayServer) handler(w http.ResponseWriter, r *http.Request) {
+	s.requests = append(s.requests, r)
+	data := s.responseFunc(r)
+	w.Write(data)
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway.go b/lib/promscrape/discovery/scaleway/scaleway.go
new file mode 100644
index 0000000..78ce9cc
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway.go
@@ -0,0 +1,168 @@
+package scaleway
+
+import (
+	"flag"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/proxy"
+)
+
+// SDCheckInterval defines interval for targets refresh.
+var SDCheckInterval = flag.Duration("promscrape.scalewaySDCheckInterval", 30*time.Second, "Interval for checking for changes in Scaleway Instances API. "+
+	"This works only if scaleway_sd_configs is configured in '-promscrape.config' file. "+
+	"See https://docs.victoriametrics.com/victoriametrics/sd_configs/#scaleway_sd_configs for details")
+
+// SDConfig represents service discovery config for Scaleway Instances.
+//
+// See https://prometheus.io/docs/prometheus/latest/configuration/configuration/#scaleway_sd_config
+type SDConfig struct {
+	APIURL string `yaml:"api_url,omitempty"`
+	Zone   string `yaml:"zone,omitempty"`
+
+	// ProjectID is the id of the Scaleway project to discover Instances in.
+	ProjectID string `yaml:"project_id"`
+
+	// SecretKey is the Scaleway API secret key (token) used for authentication.
+	// It is sent as the X-Auth-Token HTTP header on every API request.
+	SecretKey *promauth.Secret `yaml:"secret_key"`
+
+	// NameFilter, when set, limits the discovered Instances to those whose name matches the filter.
+	NameFilter string `yaml:"name_filter,omitempty"`
+
+	// TagsFilter, when set, limits the discovered Instances to those having all the given tags.
+	TagsFilter []string `yaml:"tags_filter,omitempty"`
+
+	Port int `yaml:"port,omitempty"`
+
+	HTTPClientConfig  promauth.HTTPClientConfig  `yaml:",inline"`
+	ProxyURL          *proxy.URL                 `yaml:"proxy_url,omitempty"`
+	ProxyClientConfig promauth.ProxyClientConfig `yaml:",inline"`
+}
+
+// GetLabels returns Scaleway Instance labels according to sdc.
+func (sdc *SDConfig) GetLabels(baseDir string) ([]*promutil.Labels, error) {
+	cfg, err := getAPIConfig(sdc, baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot get API config: %w", err)
+	}
+	servers, err := getServers(cfg)
+	if err != nil {
+		return nil, err
+	}
+	return addServerLabels(servers, cfg.zone, cfg.port), nil
+}
+
+// MustStop stops further usage for sdc.
+func (sdc *SDConfig) MustStop() {
+	v := configMap.Delete(sdc)
+	if v != nil {
+		cfg := v.(*apiConfig)
+		cfg.client.Stop()
+	}
+}
+
+// server is the subset of the Scaleway Instance API server object, which is needed for service discovery.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-instances-list-all-instances
+type server struct {
+	ID             string          `json:"id"`
+	Name           string          `json:"name"`
+	Hostname       string          `json:"hostname"`
+	CommercialType string          `json:"commercial_type"`
+	State          string          `json:"state"`
+	Tags           []string        `json:"tags"`
+	Zone           string          `json:"zone"`
+	Organization   string          `json:"organization"`
+	Project        string          `json:"project"`
+	PrivateIP      string          `json:"private_ip"`
+	PublicIP       *serverPublicIP `json:"public_ip"`
+	SecurityGroup  *serverIDNamed  `json:"security_group"`
+	Image          *serverImage    `json:"image"`
+}
+
+type serverPublicIP struct {
+	Address string `json:"address"`
+}
+
+type serverIDNamed struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+}
+
+type serverImage struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+	Arch string `json:"arch"`
+}
+
+// listServersResponse is the response of the Scaleway Instance API `list servers` call.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-instances-list-all-instances
+type listServersResponse struct {
+	Servers []server `json:"servers"`
+}
+
+// zoneRegion returns the region part of a Scaleway zone, e.g. `fr-par` for `fr-par-1`.
+func zoneRegion(zone string) string {
+	idx := strings.LastIndex(zone, "-")
+	if idx < 0 {
+		return zone
+	}
+	return zone[:idx]
+}
+
+func addServerLabels(servers []server, zone string, port int) []*promutil.Labels {
+	ms := make([]*promutil.Labels, 0, len(servers))
+	for _, s := range servers {
+		if s.State != "running" {
+			continue
+		}
+
+		var publicIP string
+		if s.PublicIP != nil {
+			publicIP = s.PublicIP.Address
+		}
+		addrHost := publicIP
+		if addrHost == "" {
+			addrHost = s.PrivateIP
+		}
+		if addrHost == "" {
+			continue
+		}
+
+		m := promutil.NewLabels(20)
+		m.Add("__address__", discoveryutil.JoinHostPort(addrHost, port))
+		m.Add("__meta_scaleway_instance_id", s.ID)
+		m.Add("__meta_scaleway_instance_name", s.Name)
+		m.Add("__meta_scaleway_instance_hostname", s.Hostname)
+		m.Add("__meta_scaleway_instance_status", s.State)
+		m.Add("__meta_scaleway_instance_type", s.CommercialType)
+		m.Add("__meta_scaleway_instance_zone", s.Zone)
+		m.Add("__meta_scaleway_instance_region", zoneRegion(zone))
+		m.Add("__meta_scaleway_instance_project_id", s.Project)
+		m.Add("__meta_scaleway_instance_organization_id", s.Organization)
+		m.Add("__meta_scaleway_instance_public_ipv4", publicIP)
+		m.Add("__meta_scaleway_instance_private_ipv4", s.PrivateIP)
+		if s.SecurityGroup != nil {
+			m.Add("__meta_scaleway_instance_security_group_id", s.SecurityGroup.ID)
+			m.Add("__meta_scaleway_instance_security_group_name", s.SecurityGroup.Name)
+		}
+		if s.Image != nil {
+			m.Add("__meta_scaleway_instance_image_id", s.Image.ID)
+			m.Add("__meta_scaleway_instance_image_name", s.Image.Name)
+			m.Add("__meta_scaleway_instance_image_arch", s.Image.Arch)
+		}
+		if len(s.Tags) > 0 {
+			tags := "," + strings.Join(s.Tags, ",") + ","
+			m.Add("__meta_scaleway_instance_tags", tags)
+		}
+
+		ms = append(ms, m)
+	}
+	return ms
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway_test.go b/lib/promscrape/discovery/scaleway/scaleway_test.go
