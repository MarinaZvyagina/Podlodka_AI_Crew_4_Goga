diff --git a/lib/promscrape/discovery/scaleway/api.go b/lib/promscrape/discovery/scaleway/api.go
new file mode 100644
index 0000000..e6a47ee
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api.go
@@ -0,0 +1,139 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+var configMap = discoveryutil.NewConfigMap()
+
+type apiConfig struct {
+	client *discoveryutil.Client
+
+	secretKey  string
+	zone       string
+	projectID  string
+	nameFilter string
+	tagsFilter []string
+	port       int
+}
+
+func newAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	if sdc.ProjectID == "" {
+		return nil, fmt.Errorf("project_id must be set")
+	}
+	if sdc.SecretKey == nil || sdc.SecretKey.String() == "" {
+		return nil, fmt.Errorf("secret_key must be set")
+	}
+
+	ac, err := sdc.HTTPClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse auth config: %w", err)
+	}
+
+	apiServer := sdc.APIURL
+	if apiServer == "" {
+		apiServer = "https://api.scaleway.com"
+	}
+	if !strings.Contains(apiServer, "://") {
+		scheme := "http"
+		if sdc.HTTPClientConfig.TLSConfig != nil {
+			scheme = "https"
+		}
+		apiServer = scheme + "://" + apiServer
+	}
+	proxyAC, err := sdc.ProxyClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse proxy auth config: %w", err)
+	}
+	client, err := discoveryutil.NewClient(apiServer, ac, sdc.ProxyURL, proxyAC, &sdc.HTTPClientConfig)
+	if err != nil {
+		return nil, fmt.Errorf("cannot create HTTP client for %q: %w", apiServer, err)
+	}
+
+	zone := sdc.Zone
+	if zone == "" {
+		zone = "fr-par-1"
+	}
+	port := sdc.Port
+	if port == 0 {
+		port = 80
+	}
+	cfg := &apiConfig{
+		client:     client,
+		secretKey:  sdc.SecretKey.String(),
+		zone:       zone,
+		projectID:  sdc.ProjectID,
+		nameFilter: sdc.NameFilter,
+		tagsFilter: sdc.TagsFilter,
+		port:       port,
+	}
+	return cfg, nil
+}
+
+func getAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	v, err := configMap.Get(sdc, func() (any, error) { return newAPIConfig(sdc, baseDir) })
+	if err != nil {
+		return nil, err
+	}
+	return v.(*apiConfig), nil
+}
+
+// setAuthHeader sets the X-Auth-Token header required by the Scaleway API.
+//
+// See https://www.scaleway.com/en/developers/api/#authentication
+func (cfg *apiConfig) setAuthHeader(req *http.Request) {
+	req.Header.Set("X-Auth-Token", cfg.secretKey)
+}
+
+const serversPerPage = 100
+
+// getServers returns the list of Scaleway Instances for the zone/project configured in cfg.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-instances-list-all-instances
+func getServers(cfg *apiConfig) ([]server, error) {
+	var servers []server
+	page := 1
+	for {
+		q := url.Values{}
+		q.Set("project", cfg.projectID)
+		q.Set("page", strconv.Itoa(page))
+		q.Set("per_page", strconv.Itoa(serversPerPage))
+		if cfg.nameFilter != "" {
+			q.Set("name", cfg.nameFilter)
+		}
+		for _, tag := range cfg.tagsFilter {
+			q.Add("tags", tag)
+		}
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?%s", url.PathEscape(cfg.zone), q.Encode())
+
+		data, err := cfg.client.GetAPIResponseWithReqParams(path, cfg.setAuthHeader)
+		if err != nil {
+			return nil, fmt.Errorf("cannot query scaleway instance api: %w", err)
+		}
+		resp, err := parseAPIResponse(data)
+		if err != nil {
+			return nil, err
+		}
+		servers = append(servers, resp.Servers...)
+		if len(resp.Servers) < serversPerPage {
+			break
+		}
+		page++
+	}
+	return servers, nil
+}
+
+func parseAPIResponse(data []byte) (*listServersResponse, error) {
+	var resp listServersResponse
+	if err := json.Unmarshal(data, &resp); err != nil {
+		return nil, fmt.Errorf("cannot parse scaleway instance api response: %q: %w", data, err)
+	}
+	return &resp, nil
+}
diff --git a/lib/promscrape/discovery/scaleway/api_test.go b/lib/promscrape/discovery/scaleway/api_test.go
new file mode 100644
index 0000000..e21bd97
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api_test.go
@@ -0,0 +1,211 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"reflect"
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	f := func(sdc *SDConfig) {
+		t.Helper()
+		if _, err := newAPIConfig(sdc, "."); err == nil {
+			t.Fatalf("expecting non-nil error")
+		}
+	}
+
+	// missing project_id and secret_key
+	f(&SDConfig{})
+
+	// missing secret_key
+	f(&SDConfig{
+		ProjectID: "project-id",
+	})
+
+	// missing project_id
+	f(&SDConfig{
+		SecretKey: promauth.NewSecret("secret-key"),
+	})
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		ProjectID: "project-id",
+		SecretKey: promauth.NewSecret("secret-key"),
+	}
+	cfg, err := newAPIConfig(sdc, ".")
+	if err != nil {
+		t.Fatalf("newAPIConfig() failed unexpectedly: %s", err)
+	}
+	if cfg.zone != "fr-par-1" {
+		t.Fatalf("unexpected default zone; got %q; want %q", cfg.zone, "fr-par-1")
+	}
+	if cfg.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want %d", cfg.port, 80)
+	}
+}
+
+func TestParseAPIResponse(t *testing.T) {
+	data := `{
+		"servers": [
+			{
+				"id": "11111111-1111-1111-1111-111111111111",
+				"name": "example",
+				"state": "running",
+				"zone": "fr-par-1"
+			}
+		]
+	}`
+	resp, err := parseAPIResponse([]byte(data))
+	if err != nil {
+		t.Fatalf("unexpected error in parseAPIResponse(): %s", err)
+	}
+	if len(resp.Servers) != 1 {
+		t.Fatalf("unexpected number of servers; got %d; want %d", len(resp.Servers), 1)
+	}
+	if resp.Servers[0].ID != "11111111-1111-1111-1111-111111111111" {
+		t.Fatalf("unexpected server id; got %q", resp.Servers[0].ID)
+	}
+}
+
+func TestParseAPIResponse_Failure(t *testing.T) {
+	if _, err := parseAPIResponse([]byte("not json")); err == nil {
+		t.Fatalf("expecting non-nil error")
+	}
+}
+
+func TestGetServers_Success(t *testing.T) {
+	s := newMockScalewayServer(func(r *http.Request) []byte {
+		if got := r.Header.Get("X-Auth-Token"); got != "secret-key" {
+			t.Errorf("unexpected X-Auth-Token header; got %q; want %q", got, "secret-key")
+		}
+		if got := r.URL.Query().Get("project"); got != "project-id" {
+			t.Errorf("unexpected project query arg; got %q; want %q", got, "project-id")
+		}
+		return []byte(`{
+			"servers": [
+				{
+					"id": "11111111-1111-1111-1111-111111111111",
+					"name": "web-1",
+					"hostname": "web-1",
+					"commercial_type": "DEV1-S",
+					"state": "running",
+					"tags": ["web", "prod"],
+					"zone": "fr-par-1",
+					"organization": "org-id",
+					"project": "project-id",
+					"private_ip": "10.0.0.1",
+					"public_ip": {"address": "51.15.0.1"}
+				}
+			]
+		}`)
+	})
+	defer s.Close()
+
+	client := newTestClient(t, s.URL)
+	cfg := &apiConfig{
+		client:    client,
+		secretKey: "secret-key",
+		zone:      "fr-par-1",
+		projectID: "project-id",
+		port:      80,
+	}
+
+	servers, err := getServers(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getServers(): %s", err)
+	}
+
+	expectedServers := []server{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "web-1",
+			Hostname:       "web-1",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Tags:           []string{"web", "prod"},
+			Zone:           "fr-par-1",
+			Organization:   "org-id",
+			Project:        "project-id",
+			PrivateIP:      "10.0.0.1",
+			PublicIP:       &serverPublicIP{Address: "51.15.0.1"},
+		},
+	}
+	if !reflect.DeepEqual(servers, expectedServers) {
+		t.Fatalf("unexpected servers\ngot\n%#v\nwant\n%#v", servers, expectedServers)
+	}
+}
+
+func TestGetServers_Failure(t *testing.T) {
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		return []byte("not json")
+	})
+	defer s.Close()
+
+	client := newTestClient(t, s.URL)
+	cfg := &apiConfig{
+		client:    client,
+		secretKey: "secret-key",
+		zone:      "fr-par-1",
+		projectID: "project-id",
+		port:      80,
+	}
+	if _, err := getServers(cfg); err == nil {
+		t.Fatalf("expecting non-nil error from getServers()")
+	}
+}
+
+func TestGetServers_Paging(t *testing.T) {
+	requestCount := 0
+	s := newMockScalewayServer(func(r *http.Request) []byte {
+		page := r.URL.Query().Get("page")
+		requestCount++
+		if page == "1" {
+			servers := make([]json.RawMessage, serversPerPage)
+			for i := range servers {
+				servers[i] = json.RawMessage(fmt.Sprintf(`{"id": "page1-%d", "state": "running"}`, i))
+			}
+			data, err := json.Marshal(map[string]any{"servers": servers})
+			if err != nil {
+				t.Fatalf("unexpected error marshaling test data: %s", err)
+			}
+			return data
+		}
+		return []byte(`{"servers": [{"id": "page2-0", "state": "running"}]}`)
+	})
+	defer s.Close()
+
+	client := newTestClient(t, s.URL)
+	cfg := &apiConfig{
+		client:    client,
+		secretKey: "secret-key",
+		zone:      "fr-par-1",
+		projectID: "project-id",
+		port:      80,
+	}
+
+	servers, err := getServers(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getServers(): %s", err)
+	}
+	if len(servers) != serversPerPage+1 {
+		t.Fatalf("unexpected number of servers; got %d; want %d", len(servers), serversPerPage+1)
+	}
+	if requestCount != 2 {
+		t.Fatalf("unexpected number of requests; got %d; want %d", requestCount, 2)
+	}
+}
+
+func newTestClient(t *testing.T, apiServer string) *discoveryutil.Client {
+	t.Helper()
+	client, err := discoveryutil.NewClient(apiServer, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	return client
+}
