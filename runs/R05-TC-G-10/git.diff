diff --git a/lib/promscrape/discovery/scaleway/api.go b/lib/promscrape/discovery/scaleway/api.go
new file mode 100644
index 0000000..3585884
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api.go
@@ -0,0 +1,122 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/url"
+	"strconv"
+	"strings"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+var configMap = discoveryutil.NewConfigMap()
+
+type apiConfig struct {
+	client *discoveryutil.Client
+	zone   string
+	port   int
+
+	// queryParams contains additional query params, which are sent with every list servers request.
+	queryParams string
+}
+
+func getAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	v, err := configMap.Get(sdc, func() (any, error) { return newAPIConfig(sdc, baseDir) })
+	if err != nil {
+		return nil, err
+	}
+	return v.(*apiConfig), nil
+}
+
+func newAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	if sdc.Project == "" {
+		return nil, fmt.Errorf("project_id cannot be empty")
+	}
+
+	ac, err := sdc.HTTPClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse auth config: %w", err)
+	}
+
+	apiServer := sdc.APIURL
+	if apiServer == "" {
+		apiServer = "https://api.scaleway.com"
+	}
+	if !strings.Contains(apiServer, "://") {
+		scheme := "http"
+		if sdc.HTTPClientConfig.TLSConfig != nil {
+			scheme = "https"
+		}
+		apiServer = scheme + "://" + apiServer
+	}
+
+	zone := sdc.Zone
+	if zone == "" {
+		zone = "fr-par-1"
+	}
+
+	proxyAC, err := sdc.ProxyClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse proxy auth config: %w", err)
+	}
+	client, err := discoveryutil.NewClient(apiServer, ac, sdc.ProxyURL, proxyAC, &sdc.HTTPClientConfig)
+	if err != nil {
+		return nil, fmt.Errorf("cannot create HTTP client for %q: %w", apiServer, err)
+	}
+
+	qp := url.Values{}
+	qp.Set("project", sdc.Project)
+	qp.Set("per_page", strconv.Itoa(serversPerPage))
+
+	cfg := &apiConfig{
+		client:      client,
+		zone:        zone,
+		port:        sdc.Port,
+		queryParams: qp.Encode(),
+	}
+	if cfg.port == 0 {
+		cfg.port = 80
+	}
+	return cfg, nil
+}
+
+// serversPerPage is the maximum number of servers requested per page.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+const serversPerPage = 100
+
+func serversAPIPath(zone string) string {
+	return fmt.Sprintf("/instance/v1/zones/%s/servers", zone)
+}
+
+func getServers(getAPIResponse func(string) ([]byte, error), zone, queryParams string) ([]server, error) {
+	var servers []server
+
+	page := 1
+	for {
+		path := fmt.Sprintf("%s?%s&page=%d", serversAPIPath(zone), queryParams, page)
+		data, err := getAPIResponse(path)
+		if err != nil {
+			return nil, fmt.Errorf("cannot fetch data from scaleway servers list api: %w", err)
+		}
+		resp, err := parseAPIResponse(data)
+		if err != nil {
+			return nil, err
+		}
+		servers = append(servers, resp.Servers...)
+		if len(resp.Servers) < serversPerPage {
+			break
+		}
+		page++
+	}
+	return servers, nil
+}
+
+func parseAPIResponse(data []byte) (*listServersResponse, error) {
+	var resp listServersResponse
+	if err := json.Unmarshal(data, &resp); err != nil {
+		return nil, fmt.Errorf("failed to parse scaleway api response: %q, err: %w", data, err)
+	}
+	return &resp, nil
+}
diff --git a/lib/promscrape/discovery/scaleway/api_test.go b/lib/promscrape/discovery/scaleway/api_test.go
new file mode 100644
index 0000000..77fed7d
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api_test.go
@@ -0,0 +1,102 @@
+package scaleway
+
+import (
+	"fmt"
+	"net/url"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestParseAPIResponse(t *testing.T) {
+	f := func(data string, responseExpected *listServersResponse) {
+		t.Helper()
+
+		response, err := parseAPIResponse([]byte(data))
+		if err != nil {
+			t.Fatalf("unexpected parseAPIResponse() error: %s", err)
+		}
+		if !reflect.DeepEqual(response, responseExpected) {
+			t.Fatalf("unexpected response\ngot\n%v\nwant\n%v", response, responseExpected)
+		}
+	}
+
+	data := `
+{
+  "servers": [
+    {
+      "id": "11111111-1111-1111-1111-111111111111",
+      "name": "my-server",
+      "zone": "fr-par-1",
+      "state": "running",
+      "hostname": "my-server",
+      "commercial_type": "DEV1-S",
+      "tags": ["tag1", "tag2"],
+      "project": "22222222-2222-2222-2222-222222222222",
+      "private_ip": "10.10.10.10",
+      "public_ip": {
+        "id": "33333333-3333-3333-3333-333333333333",
+        "address": "51.15.10.10",
+        "dynamic": false
+      }
+    }
+  ],
+  "total_count": 1
+}`
+
+	privateIP := "10.10.10.10"
+	responseExpected := &listServersResponse{
+		Servers: []server{
+			{
+				ID:             "11111111-1111-1111-1111-111111111111",
+				Name:           "my-server",
+				Zone:           "fr-par-1",
+				State:          "running",
+				Hostname:       "my-server",
+				CommercialType: "DEV1-S",
+				Tags:           []string{"tag1", "tag2"},
+				Project:        "22222222-2222-2222-2222-222222222222",
+				PrivateIP:      &privateIP,
+				PublicIP: &publicIP{
+					Address: "51.15.10.10",
+				},
+			},
+		},
+	}
+	f(data, responseExpected)
+}
+
+func TestGetServers(t *testing.T) {
+	f := func(getAPIResponse func(string) ([]byte, error), expectedServerCount int) {
+		t.Helper()
+
+		servers, err := getServers(getAPIResponse, "fr-par-1", "project=22222222-2222-2222-2222-222222222222&per_page=100")
+		if err != nil {
+			t.Fatalf("getServers() error: %s", err)
+		}
+		if len(servers) != expectedServerCount {
+			t.Fatalf("unexpected servers count; got %d; want %d\nservers:\n%v", len(servers), expectedServerCount, servers)
+		}
+	}
+
+	// generate a fake full first page (100 servers) followed by a partial second page (1 server)
+	// in order to verify pagination stops once a page smaller than serversPerPage is returned.
+	fullPage := make([]string, serversPerPage)
+	for i := range fullPage {
+		fullPage[i] = fmt.Sprintf(`{"id": "server-%d", "name": "server-%d", "zone": "fr-par-1", "state": "running"}`, i, i)
+	}
+	fullPageJSON := fmt.Sprintf(`{"servers": [%s], "total_count": 101}`, strings.Join(fullPage, ","))
+	partialPageJSON := `{"servers": [{"id": "server-100", "name": "server-100", "zone": "fr-par-1", "state": "running"}], "total_count": 101}`
+
+	getAPIResponse := func(path string) ([]byte, error) {
+		u, err := url.Parse(path)
+		if err != nil {
+			return nil, err
+		}
+		if u.Query().Get("page") == "1" {
+			return []byte(fullPageJSON), nil
+		}
+		return []byte(partialPageJSON), nil
+	}
+	f(getAPIResponse, serversPerPage+1)
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway.go b/lib/promscrape/discovery/scaleway/scaleway.go
new file mode 100644
index 0000000..ce3bec7
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway.go
@@ -0,0 +1,130 @@
+package scaleway
+
+import (
+	"flag"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/proxy"
+)
+
+// SDCheckInterval defines interval for targets refresh.
+var SDCheckInterval = flag.Duration("promscrape.scalewaySDCheckInterval", time.Minute, "Interval for checking for changes in Scaleway Instances API. "+
+	"This works only if scaleway_sd_configs is configured in '-promscrape.config' file. "+
+	"See https://docs.victoriametrics.com/victoriametrics/sd_configs/#scaleway_sd_configs for details")
+
+// SDConfig represents service discovery config for Scaleway Instances.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type SDConfig struct {
+	// APIURL is an optional Scaleway API server to query.
+	// By default, https://api.scaleway.com is used.
+	APIURL string `yaml:"api_url,omitempty"`
+
+	// Zone is the Scaleway availability zone to discover instances in, e.g. "fr-par-1".
+	// By default, "fr-par-1" is used.
+	Zone string `yaml:"zone,omitempty"`
+
+	// Project is the id of the Scaleway project (or organization) to discover instances in.
+	Project string `yaml:"project_id"`
+
+	// Port is an optional port to scrape metrics from. By default, port 80 is used.
+	Port int `yaml:"port,omitempty"`
+
+	HTTPClientConfig  promauth.HTTPClientConfig  `yaml:",inline"`
+	ProxyURL          *proxy.URL                 `yaml:"proxy_url,omitempty"`
+	ProxyClientConfig promauth.ProxyClientConfig `yaml:",inline"`
+}
+
+// GetLabels returns Scaleway instance labels according to sdc.
+func (sdc *SDConfig) GetLabels(baseDir string) ([]*promutil.Labels, error) {
+	cfg, err := getAPIConfig(sdc, baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot get API config: %w", err)
+	}
+	servers, err := getServers(cfg.client.GetAPIResponse, cfg.zone, cfg.queryParams)
+	if err != nil {
+		return nil, err
+	}
+	return addServerLabels(servers, cfg.port), nil
+}
+
+// MustStop stops further usage for sdc.
+func (sdc *SDConfig) MustStop() {
+	v := configMap.Delete(sdc)
+	if v != nil {
+		cfg := v.(*apiConfig)
+		cfg.client.Stop()
+	}
+}
+
+// server represents a Scaleway Instance.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type server struct {
+	ID             string    `json:"id"`
+	Name           string    `json:"name"`
+	Zone           string    `json:"zone"`
+	State          string    `json:"state"`
+	Hostname       string    `json:"hostname"`
+	CommercialType string    `json:"commercial_type"`
+	Tags           []string  `json:"tags"`
+	Project        string    `json:"project"`
+	PrivateIP      *string   `json:"private_ip"`
+	PublicIP       *publicIP `json:"public_ip"`
+}
+
+type publicIP struct {
+	Address string `json:"address"`
+}
+
+// listServersResponse is the response of the Scaleway Instance API for listing servers.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type listServersResponse struct {
+	Servers []server `json:"servers"`
+}
+
+func addServerLabels(servers []server, defaultPort int) []*promutil.Labels {
+	ms := make([]*promutil.Labels, 0, len(servers))
+	for _, s := range servers {
+		var publicIPv4 string
+		if s.PublicIP != nil {
+			publicIPv4 = s.PublicIP.Address
+		}
+		var privateIPv4 string
+		if s.PrivateIP != nil {
+			privateIPv4 = *s.PrivateIP
+		}
+
+		addr := publicIPv4
+		if addr == "" {
+			addr = privateIPv4
+		}
+		if addr == "" {
+			// Skip servers without any reachable IP address.
+			continue
+		}
+
+		m := promutil.NewLabels(12)
+		m.Add("__address__", discoveryutil.JoinHostPort(addr, defaultPort))
+		m.Add("__meta_scaleway_instance_id", s.ID)
+		m.Add("__meta_scaleway_instance_name", s.Name)
+		m.Add("__meta_scaleway_instance_zone", s.Zone)
+		m.Add("__meta_scaleway_instance_state", s.State)
+		m.Add("__meta_scaleway_instance_hostname", s.Hostname)
+		m.Add("__meta_scaleway_instance_type", s.CommercialType)
+		m.Add("__meta_scaleway_instance_project_id", s.Project)
+		m.Add("__meta_scaleway_instance_public_ipv4", publicIPv4)
+		m.Add("__meta_scaleway_instance_private_ipv4", privateIPv4)
+		if len(s.Tags) > 0 {
+			m.Add("__meta_scaleway_instance_tags", ","+strings.Join(s.Tags, ",")+",")
+		}
+		ms = append(ms, m)
+	}
+	return ms
+}
