+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func TestAddServerLabels(t *testing.T) {
+	f := func(servers []server, labelssExpected []*promutil.Labels) {
+		t.Helper()
+
+		labelss := addServerLabels(servers, 9100)
+		discoveryutil.TestEqualLabelss(t, labelss, labelssExpected)
+	}
+
+	// server with both public and private IPs
+	privateIP := "10.10.10.10"
+	servers := []server{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "my-server",
+			Zone:           "fr-par-1",
+			State:          "running",
+			Hostname:       "my-server",
+			CommercialType: "DEV1-S",
+			Tags:           []string{"tag1", "tag2"},
+			Project:        "22222222-2222-2222-2222-222222222222",
+			PrivateIP:      &privateIP,
+			PublicIP: &publicIP{
+				Address: "51.15.10.10",
+			},
+		},
+	}
+	labelssExpected := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                           "51.15.10.10:9100",
+			"__meta_scaleway_instance_id":           "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":         "my-server",
+			"__meta_scaleway_instance_zone":         "fr-par-1",
+			"__meta_scaleway_instance_state":        "running",
+			"__meta_scaleway_instance_hostname":     "my-server",
+			"__meta_scaleway_instance_type":         "DEV1-S",
+			"__meta_scaleway_instance_project_id":   "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_public_ipv4":  "51.15.10.10",
+			"__meta_scaleway_instance_private_ipv4": "10.10.10.10",
+			"__meta_scaleway_instance_tags":         ",tag1,tag2,",
+		}),
+	}
+	f(servers, labelssExpected)
+
+	// server without a public IP falls back to the private IP for __address__
+	servers = []server{
+		{
+			ID:             "33333333-3333-3333-3333-333333333333",
+			Name:           "private-only",
+			Zone:           "nl-ams-1",
+			State:          "running",
+			CommercialType: "DEV1-M",
+			Project:        "22222222-2222-2222-2222-222222222222",
+			PrivateIP:      &privateIP,
+		},
+	}
+	labelssExpected = []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                           "10.10.10.10:9100",
+			"__meta_scaleway_instance_id":           "33333333-3333-3333-3333-333333333333",
+			"__meta_scaleway_instance_name":         "private-only",
+			"__meta_scaleway_instance_zone":         "nl-ams-1",
+			"__meta_scaleway_instance_state":        "running",
+			"__meta_scaleway_instance_hostname":     "",
+			"__meta_scaleway_instance_type":         "DEV1-M",
+			"__meta_scaleway_instance_project_id":   "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_public_ipv4":  "",
+			"__meta_scaleway_instance_private_ipv4": "10.10.10.10",
+		}),
+	}
+	f(servers, labelssExpected)
+
+	// server without any IP address is skipped
+	servers = []server{
+		{
+			ID:   "44444444-4444-4444-4444-444444444444",
+			Name: "no-ip",
+		},
+	}
+	f(servers, nil)
+}
