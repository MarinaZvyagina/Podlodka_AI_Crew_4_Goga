+// testGenerateMetricRowsForName generates seriesCount rows belonging to
+// distinct series (distinct "instance" tag values) that all share the same
+// metric name.
+func testGenerateMetricRowsForName(rng *rand.Rand, metricName string, seriesCount int, tr TimeRange) []MetricRow {
+	var mrs []MetricRow
+	var mn MetricName
+	mn.MetricGroup = []byte(metricName)
+	for i := range seriesCount {
+		mn.Tags = []Tag{
+			{[]byte("job"), []byte("webservice")},
+			{[]byte("instance"), fmt.Appendf(nil, "instance_%d", i)},
+		}
+		metricNameRaw := mn.marshalRaw(nil)
+		timestamp := rng.Int63n(tr.MaxTimestamp-tr.MinTimestamp) + tr.MinTimestamp
+		value := rng.NormFloat64() * 1e6
+		mrs = append(mrs, MetricRow{
+			MetricNameRaw: metricNameRaw,
+			Timestamp:     timestamp,
+			Value:         value,
+		})
+	}
+	return mrs
+}
