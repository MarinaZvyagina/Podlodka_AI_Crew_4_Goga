+// GetDroppedSeriesStats returns up to topN metric names with the highest
+// number of samples dropped due to exceeding -storage.maxHourlySeries or
+// -storage.maxDailySeries, since the last call to ResetDroppedSeriesStats
+// (or Storage creation).
+//
+// If topN <= 0, all the tracked records are returned.
+func (s *Storage) GetDroppedSeriesStats(topN int) droppedseries.Stats {
+	return s.droppedSeriesTracker.GetTopRecords(topN)
+}
+
+// ResetDroppedSeriesStats resets the dropped series stats tracker.
+func (s *Storage) ResetDroppedSeriesStats() {
+	s.droppedSeriesTracker.Reset()
+}
