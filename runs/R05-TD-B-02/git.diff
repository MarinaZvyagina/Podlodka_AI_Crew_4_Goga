+// trackDroppedSeries registers a single dropped sample for the metric name
+// encoded in metricNameRaw at s.droppedSeriesTracker, if tracking is enabled.
+func (s *Storage) trackDroppedSeries(metricNameRaw []byte) {
+	if s.droppedSeriesTracker == nil {
+		return
+	}
+	metricGroup := extractMetricGroup(nil, metricNameRaw)
+	s.droppedSeriesTracker.IncrementDropCount(metricGroup)
+}
+
+// extractMetricGroup appends the metric name (the value stored under the
+// empty-key "__name__" pseudo-tag) encoded in metricNameRaw to dst and
+// returns the result.
+//
+// It avoids unmarshaling the whole MetricName just to obtain the metric
+// name.
+func extractMetricGroup(dst, metricNameRaw []byte) []byte {
+	src := metricNameRaw
+	for len(src) > 0 {
+		tail, key, err := unmarshalBytesFast(src)
+		if err != nil {
+			return dst
+		}
+		src = tail
+		tail, value, err := unmarshalBytesFast(src)
+		if err != nil {
+			return dst
+		}
+		src = tail
+		if len(key) == 0 {
+			return append(dst, value...)
+		}
+	}
+	return dst
+}
