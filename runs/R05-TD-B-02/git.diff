diff --git a/lib/storage/droppedseries/tracker.go b/lib/storage/droppedseries/tracker.go
new file mode 100644
index 0000000..00fedb4
--- /dev/null
+++ b/lib/storage/droppedseries/tracker.go
@@ -0,0 +1,166 @@
+// Package droppedseries provides an in-memory tracker for counting, per
+// metric name, how many samples were dropped because adding a new time
+// series for that metric name would have exceeded the configured
+// -storage.maxHourlySeries or -storage.maxDailySeries limit.
+//
+// The tracker only ever holds counters for a bounded number of distinct
+// metric names, so it cannot grow without bound even when a huge number of
+// distinct metric names hit the limit.
+package droppedseries
+
+import (
+	"sort"
+	"sync"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+// DefaultMaxTrackedNames is the default maximum number of unique metric
+// names tracked by Tracker.
+const DefaultMaxTrackedNames = 1000
+
+// Tracker tracks the number of dropped samples per metric name.
+//
+// A nil *Tracker is valid - all of its methods are safe no-ops, so it can be
+// left disabled with no overhead on the caller's hot path.
+//
+// It is safe to use Tracker from concurrent goroutines.
+type Tracker struct {
+	maxNames int
+
+	mu        sync.Mutex
+	m         map[string]uint64
+	createdAt uint64
+
+	// getCurrentTs is used for overriding the current time in tests.
+	getCurrentTs func() uint64
+}
+
+// NewTracker creates a Tracker, which can track drop counters for up to
+// maxNames unique metric names. If maxNames <= 0, DefaultMaxTrackedNames is
+// used instead.
+func NewTracker(maxNames int) *Tracker {
+	if maxNames <= 0 {
+		maxNames = DefaultMaxTrackedNames
+	}
+	t := &Tracker{
+		maxNames:     maxNames,
+		getCurrentTs: fasttime.UnixTimestamp,
+	}
+	t.resetLocked()
+	return t
+}
+
+// IncrementDropCount registers a single dropped sample for the given
+// metricName.
+//
+// It is a no-op for a nil Tracker.
+func (t *Tracker) IncrementDropCount(metricName []byte) {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if _, ok := t.m[string(metricName)]; !ok && len(t.m) >= t.maxNames {
+		// The tracker is full. Do not track drops for previously unseen
+		// metric names in order to bound memory usage.
+		return
+	}
+	t.m[string(metricName)]++
+}
+
+// MaxNames returns the maximum number of unique metric names t can track.
+func (t *Tracker) MaxNames() int {
+	if t == nil {
+		return 0
+	}
+	return t.maxNames
+}
+
+// EntriesCount returns the current number of unique metric names tracked
+// by t.
+func (t *Tracker) EntriesCount() int {
+	if t == nil {
+		return 0
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return len(t.m)
+}
+
+// Reset drops all the collected stats and starts a new collection period.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.resetLocked()
+	t.mu.Unlock()
+}
+
+func (t *Tracker) resetLocked() {
+	t.m = make(map[string]uint64)
+	t.createdAt = t.getCurrentTs()
+}
+
+// Record is a single (metric name, dropped samples count) pair.
+type Record struct {
+	MetricName  string `json:"metricName"`
+	DroppedRows uint64 `json:"droppedRows"`
+}
+
+// Stats is the result returned by Tracker.GetTopRecords.
+type Stats struct {
+	// CollectedSinceTs is the unix timestamp of the moment the current
+	// collection period started, i.e. since Tracker creation or the last
+	// Reset call.
+	CollectedSinceTs uint64 `json:"collectedSinceTimestamp"`
+
+	// MaxNames is the maximum number of unique metric names the tracker
+	// can hold. See Tracker.MaxNames.
+	MaxNames int `json:"maxTrackedNames"`
+
+	// CurrentNames is the number of unique metric names currently
+	// tracked. See Tracker.EntriesCount.
+	CurrentNames int `json:"currentTrackedNames"`
+
+	// Records contains the returned records sorted by DroppedRows in
+	// descending order.
+	Records []Record `json:"topRecords"`
+}
+
+// GetTopRecords returns up to topN metric names with the highest drop
+// counts, sorted in descending order of DroppedRows. Ties are broken by
+// metric name in ascending order for deterministic output.
+//
+// If topN <= 0, all the tracked records are returned.
+func (t *Tracker) GetTopRecords(topN int) Stats {
+	var s Stats
+	if t == nil {
+		return s
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	s.CollectedSinceTs = t.createdAt
+	s.MaxNames = t.maxNames
+	s.CurrentNames = len(t.m)
+
+	s.Records = make([]Record, 0, len(t.m))
+	for name, count := range t.m {
+		s.Records = append(s.Records, Record{
+			MetricName:  name,
+			DroppedRows: count,
+		})
+	}
+	sort.Slice(s.Records, func(i, j int) bool {
+		if s.Records[i].DroppedRows != s.Records[j].DroppedRows {
+			return s.Records[i].DroppedRows > s.Records[j].DroppedRows
+		}
+		return s.Records[i].MetricName < s.Records[j].MetricName
+	})
+	if topN > 0 && len(s.Records) > topN {
+		s.Records = s.Records[:topN]
+	}
+	return s
+}
diff --git a/lib/storage/droppedseries/tracker_test.go b/lib/storage/droppedseries/tracker_test.go
new file mode 100644
index 0000000..e5f648b
--- /dev/null
+++ b/lib/storage/droppedseries/tracker_test.go
@@ -0,0 +1,145 @@
+package droppedseries
+
+import (
+	"fmt"
+	"testing"
+)
+
+func TestTracker_NilIsNoOp(t *testing.T) {
+	var t0 *Tracker
+	t0.IncrementDropCount([]byte("foo"))
+	if n := t0.EntriesCount(); n != 0 {
+		t.Fatalf("unexpected EntriesCount for nil tracker: got %d, want 0", n)
+	}
+	if n := t0.MaxNames(); n != 0 {
+		t.Fatalf("unexpected MaxNames for nil tracker: got %d, want 0", n)
+	}
+	t0.Reset()
+	s := t0.GetTopRecords(10)
+	if len(s.Records) != 0 {
+		t.Fatalf("unexpected records for nil tracker: got %v, want empty", s.Records)
+	}
+}
+
+func TestTracker_IncrementDropCountAndGetTopRecords(t *testing.T) {
+	tr := NewTracker(100)
+
+	// Record drops for multiple metric names, with distinct counts.
+	for range 5 {
+		tr.IncrementDropCount([]byte("metric_a"))
+	}
+	for range 3 {
+		tr.IncrementDropCount([]byte("metric_b"))
+	}
+	tr.IncrementDropCount([]byte("metric_c"))
+
+	if n := tr.EntriesCount(); n != 3 {
+		t.Fatalf("unexpected EntriesCount: got %d, want 3", n)
+	}
+
+	s := tr.GetTopRecords(10)
+	if s.CurrentNames != 3 {
+		t.Fatalf("unexpected CurrentNames: got %d, want 3", s.CurrentNames)
+	}
+	if s.MaxNames != 100 {
+		t.Fatalf("unexpected MaxNames: got %d, want 100", s.MaxNames)
+	}
+	wantRecords := []Record{
+		{MetricName: "metric_a", DroppedRows: 5},
+		{MetricName: "metric_b", DroppedRows: 3},
+		{MetricName: "metric_c", DroppedRows: 1},
+	}
+	if len(s.Records) != len(wantRecords) {
+		t.Fatalf("unexpected number of records: got %d, want %d", len(s.Records), len(wantRecords))
+	}
+	for i, want := range wantRecords {
+		if s.Records[i] != want {
+			t.Fatalf("unexpected record at index %d: got %+v, want %+v", i, s.Records[i], want)
+		}
+	}
+
+	// Query with a smaller topN and verify only the highest offenders are returned.
+	top1 := tr.GetTopRecords(1)
+	if len(top1.Records) != 1 || top1.Records[0].MetricName != "metric_a" {
+		t.Fatalf("unexpected top1 records: %+v", top1.Records)
+	}
+}
+
+func TestTracker_GetTopRecordsTieBreak(t *testing.T) {
+	tr := NewTracker(100)
+	tr.IncrementDropCount([]byte("z_metric"))
+	tr.IncrementDropCount([]byte("a_metric"))
+
+	s := tr.GetTopRecords(10)
+	if len(s.Records) != 2 {
+		t.Fatalf("unexpected number of records: %d", len(s.Records))
+	}
+	// Equal drop counts must be broken by metric name ascending.
+	if s.Records[0].MetricName != "a_metric" || s.Records[1].MetricName != "z_metric" {
+		t.Fatalf("unexpected tie-break order: %+v", s.Records)
+	}
+}
+
+func TestTracker_MaxNamesBoundIsRespected(t *testing.T) {
+	const maxNames = 3
+	tr := NewTracker(maxNames)
+
+	// Attempt to track far more distinct metric names than the configured bound.
+	const distinctNames = 1000
+	for i := range distinctNames {
+		tr.IncrementDropCount(fmt.Appendf(nil, "metric_%d", i))
+	}
+
+	if n := tr.EntriesCount(); n != maxNames {
+		t.Fatalf("unexpected EntriesCount after exceeding bound: got %d, want %d", n, maxNames)
+	}
+	s := tr.GetTopRecords(0)
+	if len(s.Records) != maxNames {
+		t.Fatalf("unexpected number of records after exceeding bound: got %d, want %d", len(s.Records), maxNames)
+	}
+
+	// Names that were tracked before the tracker filled up must keep
+	// accumulating drop counts even after the bound has been reached.
+	for range 10 {
+		tr.IncrementDropCount([]byte("metric_0"))
+	}
+	if n := tr.EntriesCount(); n != maxNames {
+		t.Fatalf("unexpected EntriesCount growth for an already-tracked name: got %d, want %d", n, maxNames)
+	}
+	s = tr.GetTopRecords(1)
+	if s.Records[0].MetricName != "metric_0" || s.Records[0].DroppedRows != 11 {
+		t.Fatalf("unexpected top record after further increments: %+v", s.Records[0])
+	}
+}
+
+func TestTracker_DefaultMaxNames(t *testing.T) {
+	tr := NewTracker(0)
+	if n := tr.MaxNames(); n != DefaultMaxTrackedNames {
+		t.Fatalf("unexpected default MaxNames: got %d, want %d", n, DefaultMaxTrackedNames)
+	}
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(10)
+	tr.IncrementDropCount([]byte("metric_a"))
+	tr.IncrementDropCount([]byte("metric_b"))
+	if n := tr.EntriesCount(); n != 2 {
+		t.Fatalf("unexpected EntriesCount before reset: %d", n)
+	}
+
+	tr.Reset()
+
+	if n := tr.EntriesCount(); n != 0 {
+		t.Fatalf("unexpected EntriesCount after reset: got %d, want 0", n)
+	}
+	s := tr.GetTopRecords(10)
+	if len(s.Records) != 0 {
+		t.Fatalf("unexpected records after reset: %v", s.Records)
+	}
+
+	// The tracker must be usable again after reset.
+	tr.IncrementDropCount([]byte("metric_c"))
+	if n := tr.EntriesCount(); n != 1 {
+		t.Fatalf("unexpected EntriesCount after reset and increment: got %d, want 1", n)
+	}
+}
