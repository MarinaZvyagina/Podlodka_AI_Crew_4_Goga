diff --git a/lib/storage/droppedseriesstats/tracker.go b/lib/storage/droppedseriesstats/tracker.go
new file mode 100644
index 0000000..a10c6e5
--- /dev/null
+++ b/lib/storage/droppedseriesstats/tracker.go
@@ -0,0 +1,178 @@
+// Package droppedseriesstats tracks, per metric name, how many samples were
+// dropped because adding the corresponding series would have exceeded the
+// configured -storage.maxHourlySeries or -storage.maxDailySeries limit.
+//
+// This is meant to help support answer "which metric name(s) hit our
+// cardinality limit" without asking the customer to dig through their own
+// instrumentation.
+package droppedseriesstats
+
+import (
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+// entryOverheadBytes is a rough estimate of the per-entry memory overhead:
+// map bucket + counter + string header. It is used to bound the memory usage
+// of the tracker regardless of how many distinct metric names try to register drops.
+const entryOverheadBytes = 64
+
+// Tracker tracks the number of dropped samples per metric name.
+//
+// Memory usage is bounded by maxSizeBytes given to NewTracker: once that
+// budget is exhausted, drops for metric names that aren't tracked yet are
+// silently ignored, while counters for already-tracked names keep incrementing.
+// This guarantees the tracker cannot grow without bound even when millions of
+// distinct metric names are hitting the limiter.
+type Tracker struct {
+	maxSizeBytes uint64
+
+	creationTs       atomic.Uint64
+	currentSizeBytes atomic.Uint64
+
+	mu    sync.RWMutex
+	store map[string]*atomic.Uint64
+
+	// getCurrentTs is overridden in tests for deterministic results.
+	getCurrentTs func() uint64
+}
+
+// NewTracker creates a Tracker bounded by the given memory budget in bytes.
+//
+// If maxSizeBytes is 0, the tracker won't track anything besides names it has
+// already seen before reaching size 0, i.e. it effectively becomes a no-op.
+func NewTracker(maxSizeBytes uint64) *Tracker {
+	t := &Tracker{
+		maxSizeBytes: maxSizeBytes,
+		store:        make(map[string]*atomic.Uint64),
+		getCurrentTs: fasttime.UnixTimestamp,
+	}
+	t.creationTs.Store(t.getCurrentTs())
+	return t
+}
+
+// RegisterDrop increments the dropped-samples counter for the given metric name.
+//
+// metricName may reference reused/pooled memory - it is copied before being
+// used as a map key.
+//
+// It is a no-op when called on a nil Tracker, which allows call sites to keep
+// a possibly-nil *Tracker field and skip all bookkeeping when the feature is disabled.
+func (t *Tracker) RegisterDrop(metricName []byte) {
+	if t == nil {
+		return
+	}
+
+	t.mu.RLock()
+	c, ok := t.store[string(metricName)]
+	t.mu.RUnlock()
+	if ok {
+		c.Add(1)
+		return
+	}
+
+	if t.cacheIsFull() {
+		return
+	}
+
+	t.mu.Lock()
+	c, ok = t.store[string(metricName)]
+	if !ok {
+		c = &atomic.Uint64{}
+		t.store[string(metricName)] = c
+		t.currentSizeBytes.Add(uint64(len(metricName)) + entryOverheadBytes)
+	}
+	t.mu.Unlock()
+
+	c.Add(1)
+}
+
+func (t *Tracker) cacheIsFull() bool {
+	return t.currentSizeBytes.Load() >= t.maxSizeBytes
+}
+
+// Entry is a single per-metric-name drop counter.
+type Entry struct {
+	MetricName       string
+	DroppedRowsCount uint64
+}
+
+// StatsResult is the result of a GetTop call.
+type StatsResult struct {
+	// CollectedSinceTs is the unix timestamp in seconds since which the stats were collected.
+	CollectedSinceTs uint64
+
+	// TrackedMetricNames is the number of distinct metric names currently tracked.
+	TrackedMetricNames uint64
+
+	Entries []Entry
+}
+
+// GetTop returns up to limit metric names with the highest dropped-samples
+// count, sorted in the descending order of DroppedRowsCount.
+//
+// A non-positive limit returns all the tracked entries.
+func (t *Tracker) GetTop(limit int) StatsResult {
+	var result StatsResult
+	if t == nil {
+		return result
+	}
+
+	t.mu.RLock()
+	result.CollectedSinceTs = t.creationTs.Load()
+	result.TrackedMetricNames = uint64(len(t.store))
+	entries := make([]Entry, 0, len(t.store))
+	for name, c := range t.store {
+		entries = append(entries, Entry{
+			MetricName:       name,
+			DroppedRowsCount: c.Load(),
+		})
+	}
+	t.mu.RUnlock()
+
+	sort.Slice(entries, func(i, j int) bool {
+		if entries[i].DroppedRowsCount != entries[j].DroppedRowsCount {
+			return entries[i].DroppedRowsCount > entries[j].DroppedRowsCount
+		}
+		return entries[i].MetricName < entries[j].MetricName
+	})
+	if limit > 0 && len(entries) > limit {
+		entries = entries[:limit]
+	}
+	result.Entries = entries
+	return result
+}
+
+// Reset drops all the collected stats and resets the collection start time.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.store = make(map[string]*atomic.Uint64)
+	t.currentSizeBytes.Store(0)
+	t.creationTs.Store(t.getCurrentTs())
+	t.mu.Unlock()
+}
+
+// TrackerMetrics holds internal tracker metrics to report.
+type TrackerMetrics struct {
+	CurrentSizeBytes  uint64
+	CurrentItemsCount uint64
+	MaxSizeBytes      uint64
+}
+
+// UpdateMetrics writes internal metrics of t to dst.
+func (t *Tracker) UpdateMetrics(dst *TrackerMetrics) {
+	if t == nil {
+		return
+	}
+	t.mu.RLock()
+	dst.CurrentItemsCount = uint64(len(t.store))
+	t.mu.RUnlock()
+	dst.CurrentSizeBytes = t.currentSizeBytes.Load()
+	dst.MaxSizeBytes = t.maxSizeBytes
+}
diff --git a/lib/storage/droppedseriesstats/tracker_test.go b/lib/storage/droppedseriesstats/tracker_test.go
new file mode 100644
index 0000000..c35d990
--- /dev/null
+++ b/lib/storage/droppedseriesstats/tracker_test.go
@@ -0,0 +1,191 @@
+package droppedseriesstats
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestTracker_RegisterDrop_MultipleMetricNames(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	tr.RegisterDrop([]byte("metric_a"))
+	tr.RegisterDrop([]byte("metric_a"))
+	tr.RegisterDrop([]byte("metric_b"))
+	tr.RegisterDrop([]byte("metric_a"))
+	tr.RegisterDrop([]byte("metric_c"))
+	tr.RegisterDrop([]byte("metric_b"))
+
+	got := map[string]uint64{}
+	for _, e := range tr.GetTop(0).Entries {
+		got[e.MetricName] = e.DroppedRowsCount
+	}
+	want := map[string]uint64{
+		"metric_a": 3,
+		"metric_b": 2,
+		"metric_c": 1,
+	}
+	if len(got) != len(want) {
+		t.Fatalf("unexpected number of tracked metric names; got %v; want %v", got, want)
+	}
+	for name, count := range want {
+		if got[name] != count {
+			t.Fatalf("unexpected dropped rows count for %q; got %d; want %d", name, got[name], count)
+		}
+	}
+}
+
+func TestTracker_RegisterDrop_Concurrent(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	const goroutines = 10
+	const iterations = 1000
+	var wg sync.WaitGroup
+	for range goroutines {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for range iterations {
+				tr.RegisterDrop([]byte("metric_x"))
+			}
+		}()
+	}
+	wg.Wait()
+
+	res := tr.GetTop(10)
+	if len(res.Entries) != 1 {
+		t.Fatalf("unexpected number of entries: %d", len(res.Entries))
+	}
+	want := uint64(goroutines * iterations)
+	if res.Entries[0].DroppedRowsCount != want {
+		t.Fatalf("unexpected dropped rows count; got %d; want %d", res.Entries[0].DroppedRowsCount, want)
+	}
+}
+
+func TestTracker_GetTop(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	counts := map[string]int{
+		"metric_1": 5,
+		"metric_2": 1,
+		"metric_3": 10,
+		"metric_4": 3,
+	}
+	for name, n := range counts {
+		for range n {
+			tr.RegisterDrop([]byte(name))
+		}
+	}
+
+	top2 := tr.GetTop(2)
+	if len(top2.Entries) != 2 {
+		t.Fatalf("unexpected number of entries: %d", len(top2.Entries))
+	}
+	if top2.Entries[0].MetricName != "metric_3" || top2.Entries[0].DroppedRowsCount != 10 {
+		t.Fatalf("unexpected top entry: %+v", top2.Entries[0])
+	}
+	if top2.Entries[1].MetricName != "metric_1" || top2.Entries[1].DroppedRowsCount != 5 {
+		t.Fatalf("unexpected second entry: %+v", top2.Entries[1])
+	}
+
+	all := tr.GetTop(0)
+	if len(all.Entries) != len(counts) {
+		t.Fatalf("unexpected number of entries with limit=0: got %d; want %d", len(all.Entries), len(counts))
+	}
+	if all.TrackedMetricNames != uint64(len(counts)) {
+		t.Fatalf("unexpected TrackedMetricNames: got %d; want %d", all.TrackedMetricNames, len(counts))
+	}
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+	tr.RegisterDrop([]byte("metric_a"))
+	tr.RegisterDrop([]byte("metric_b"))
+
+	if len(tr.GetTop(0).Entries) != 2 {
+		t.Fatalf("expected 2 entries before reset")
+	}
+
+	firstCreationTs := tr.GetTop(0).CollectedSinceTs
+	tr.getCurrentTs = func() uint64 { return firstCreationTs + 100 }
+
+	tr.Reset()
+
+	res := tr.GetTop(0)
+	if len(res.Entries) != 0 {
+		t.Fatalf("expected no entries after reset, got %d", len(res.Entries))
+	}
+	if res.CollectedSinceTs != firstCreationTs+100 {
+		t.Fatalf("expected CollectedSinceTs to be updated on reset; got %d; want %d", res.CollectedSinceTs, firstCreationTs+100)
+	}
+
+	// Registering a drop for a previously tracked name after reset must start from zero.
+	tr.RegisterDrop([]byte("metric_a"))
+	res = tr.GetTop(0)
+	if len(res.Entries) != 1 || res.Entries[0].DroppedRowsCount != 1 {
+		t.Fatalf("unexpected entries after reset+register: %+v", res.Entries)
+	}
+}
+
+func TestTracker_MemoryBoundIsRespected(t *testing.T) {
+	// Only enough budget for a handful of entries.
+	const maxSizeBytes = 500
+	tr := NewTracker(maxSizeBytes)
+
+	// Try to register drops for far more distinct metric names than the budget allows.
+	for i := range 100_000 {
+		tr.RegisterDrop([]byte(fmt.Sprintf("metric_%d", i)))
+	}
+
+	res := tr.GetTop(0)
+	if len(res.Entries) == 0 {
+		t.Fatalf("expected at least some entries to be tracked")
+	}
+	if uint64(len(res.Entries)) >= 100_000 {
+		t.Fatalf("tracker did not bound its memory usage: tracked %d out of 100000 metric names", len(res.Entries))
+	}
+
+	var m TrackerMetrics
+	tr.UpdateMetrics(&m)
+	if m.CurrentSizeBytes > maxSizeBytes+entryOverheadBytes+64 {
+		// Allow a small slack for the entry that pushed the tracker over the
+		// limit and stopped further admissions.
+		t.Fatalf("tracker size %d exceeds configured bound %d by more than expected", m.CurrentSizeBytes, maxSizeBytes)
+	}
+	if m.MaxSizeBytes != maxSizeBytes {
+		t.Fatalf("unexpected MaxSizeBytes: got %d; want %d", m.MaxSizeBytes, maxSizeBytes)
+	}
+
+	// Counters for names admitted before the budget was exhausted must keep incrementing.
+	firstName := res.Entries[0].MetricName
+	tr.RegisterDrop([]byte(firstName))
+	res2 := tr.GetTop(0)
+	found := false
+	for _, e := range res2.Entries {
+		if e.MetricName == firstName {
+			found = true
+			if e.DroppedRowsCount != res.Entries[0].DroppedRowsCount+1 {
+				t.Fatalf("counter for already-tracked name did not increment correctly: got %d; want %d",
+					e.DroppedRowsCount, res.Entries[0].DroppedRowsCount+1)
+			}
+		}
+	}
+	if !found {
+		t.Fatalf("expected already-tracked name %q to remain tracked", firstName)
+	}
+}
+
+func TestTracker_NilTrackerIsNoOp(t *testing.T) {
+	var tr *Tracker
+	tr.RegisterDrop([]byte("metric_a"))
+	if res := tr.GetTop(10); len(res.Entries) != 0 {
+		t.Fatalf("expected no entries from nil tracker")
+	}
+	tr.Reset()
+
+	var m TrackerMetrics
+	tr.UpdateMetrics(&m)
+	if m != (TrackerMetrics{}) {
+		t.Fatalf("expected zero metrics from nil tracker, got %+v", m)
+	}
+}
