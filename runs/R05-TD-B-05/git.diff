+func TestStorageSeriesLimitExceededStats_TracksPerMetricName(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const maxHourlySeries = 5
+	opts := OpenOptions{
+		MaxHourlySeries:               maxHourlySeries,
+		TrackSeriesLimitExceededStats: true,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	minTimestamp := time.Now().UnixMilli()
+
+	newRow := func(metricGroup, instance string) MetricRow {
+		mn := MetricName{
+			MetricGroup: []byte(metricGroup),
+			Tags: []Tag{
+				{Key: []byte("instance"), Value: []byte(instance)},
+			},
+		}
+		return MetricRow{
+			MetricNameRaw: mn.marshalRaw(nil),
+			Timestamp:     minTimestamp,
+			Value:         1,
+		}
+	}
+
+	// Fill up the hourly series limit with unrelated series.
+	var fillerRows []MetricRow
+	for i := range maxHourlySeries {
+		fillerRows = append(fillerRows, newRow("filler_metric", fmt.Sprintf("%d", i)))
+	}
+	s.AddRows(fillerRows, defaultPrecisionBits)
+	s.DebugFlush()
+
+	// All of the following rows must be dropped, since the hourly series limit has already been reached.
+	var droppedRows []MetricRow
+	for i := range 5 {
+		droppedRows = append(droppedRows, newRow("metric_a", fmt.Sprintf("a%d", i)))
+	}
+	for i := range 3 {
+		droppedRows = append(droppedRows, newRow("metric_b", fmt.Sprintf("b%d", i)))
+	}
+	s.AddRows(droppedRows, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if got, want := m.HourlySeriesLimitRowsDropped, uint64(len(droppedRows)); got != want {
+		t.Fatalf("unexpected HourlySeriesLimitRowsDropped: got %d, want %d", got, want)
+	}
+
+	top := s.GetSeriesLimitExceededStats(10)
+	counts := make(map[string]uint64)
+	for _, e := range top.Entries {
+		counts[e.MetricName] = e.DroppedRowsCount
+	}
+	if got, want := counts["metric_a"], uint64(5); got != want {
+		t.Fatalf("unexpected dropped rows count for metric_a: got %d, want %d", got, want)
+	}
+	if got, want := counts["metric_b"], uint64(3); got != want {
+		t.Fatalf("unexpected dropped rows count for metric_b: got %d, want %d", got, want)
+	}
+
+	// GetSeriesLimitExceededStats with limit=1 must return only the metric name with the highest drop count.
+	top1 := s.GetSeriesLimitExceededStats(1)
+	if len(top1.Entries) != 1 || top1.Entries[0].MetricName != "metric_a" {
+		t.Fatalf("unexpected result with limit=1: %+v", top1.Entries)
+	}
+
+	s.ResetSeriesLimitExceededStats()
+	afterReset := s.GetSeriesLimitExceededStats(10)
+	if len(afterReset.Entries) != 0 {
+		t.Fatalf("expected no entries after ResetSeriesLimitExceededStats, got %+v", afterReset.Entries)
+	}
+}
