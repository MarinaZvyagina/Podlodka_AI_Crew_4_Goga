+// testGenerateMetricRowsForNames generates rows for the given metric names,
+// with seriesPerName distinct series (distinguished by the "series" tag) for
+// each of them.
+func testGenerateMetricRowsForNames(rng *rand.Rand, metricNames []string, seriesPerName int, tr TimeRange) []MetricRow {
+	var mrs []MetricRow
+	for _, name := range metricNames {
+		for i := range seriesPerName {
+			var mn MetricName
+			mn.MetricGroup = []byte(name)
+			mn.Tags = []Tag{
+				{[]byte("job"), []byte("webservice")},
+				{[]byte("series"), fmt.Appendf(nil, "%d", i)},
+			}
+			metricNameRaw := mn.marshalRaw(nil)
+			mrs = append(mrs, MetricRow{
+				MetricNameRaw: metricNameRaw,
+				Timestamp:     rng.Int63n(tr.MaxTimestamp-tr.MinTimestamp) + tr.MinTimestamp,
+				Value:         rng.NormFloat64() * 1e6,
+			})
+		}
+	}
+	return mrs
+}
