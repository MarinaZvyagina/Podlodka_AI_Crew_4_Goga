+func TestStorage_SeriesLimitExceededStatsMaxEntriesIsRespected(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const maxTrackedEntries = 2
+	SetSeriesLimitExceededTrackerMaxEntries(maxTrackedEntries)
+	defer SetSeriesLimitExceededTrackerMaxEntries(0)
+
+	const (
+		seriesPerName   = 100
+		maxHourlySeries = 50
+	)
+	metricNames := []string{"metric_a", "metric_b", "metric_c", "metric_d", "metric_e"}
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	tr := TimeRange{minTimestamp, maxTimestamp}
+	mrs := testGenerateMetricRowsForNames(rng, metricNames, seriesPerName, tr)
+
+	opts := OpenOptions{
+		MaxHourlySeries:               maxHourlySeries,
+		TrackSeriesLimitExceededStats: true,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped == 0 {
+		t.Fatalf("expected some rows to be dropped because of -storage.maxHourlySeries")
+	}
+	if got := m.SeriesLimitExceededTrackerMaxSize; got != maxTrackedEntries {
+		t.Fatalf("unexpected Metrics.SeriesLimitExceededTrackerMaxSize: got %d, want %d", got, maxTrackedEntries)
+	}
+	if got := m.SeriesLimitExceededTrackerSize; got > maxTrackedEntries {
+		t.Fatalf("unexpected Metrics.SeriesLimitExceededTrackerSize: got %d, want <= %d", got, maxTrackedEntries)
+	}
+
+	entries := s.GetSeriesLimitExceededStats(0)
+	if len(entries) > maxTrackedEntries {
+		t.Fatalf("expected at most %d tracked metric names, got %d: %+v", maxTrackedEntries, len(entries), entries)
+	}
+}
