+// trackSeriesLimitExceeded records a dropped sample for the metric name
+// encoded in metricNameRaw in s.seriesLimitExceededTracker.
+func (s *Storage) trackSeriesLimitExceeded(metricNameRaw []byte) {
+	if s.seriesLimitExceededTracker == nil {
+		return
+	}
+	mn := GetMetricName()
+	if err := mn.UnmarshalRaw(metricNameRaw); err == nil {
+		s.seriesLimitExceededTracker.IncrementFor(bytesutil.ToUnsafeString(mn.MetricGroup))
+	}
+	PutMetricName(mn)
+}
+
+// GetSeriesLimitExceededStats returns up to limit metric names, which had
+// the highest number of dropped samples because of hitting
+// -storage.maxHourlySeries or -storage.maxDailySeries, sorted by drop count
+// in descending order.
+//
+// It returns an empty slice if series-limit-exceeded tracking is disabled.
+func (s *Storage) GetSeriesLimitExceededStats(limit int) []droppedseriesstats.Entry {
+	return s.seriesLimitExceededTracker.GetTopEntries(limit)
+}
+
+// ResetSeriesLimitExceededStats resets the per-metric-name drop counters
+// collected because of hitting -storage.maxHourlySeries or
+// -storage.maxDailySeries.
+func (s *Storage) ResetSeriesLimitExceededStats() {
+	s.seriesLimitExceededTracker.Reset()
+}
