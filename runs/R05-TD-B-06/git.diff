diff --git a/lib/storage/droppedseriesstats/tracker.go b/lib/storage/droppedseriesstats/tracker.go
new file mode 100644
index 0000000..b5ee938
--- /dev/null
+++ b/lib/storage/droppedseriesstats/tracker.go
@@ -0,0 +1,151 @@
+// Package droppedseriesstats tracks, per metric name, how many samples were
+// dropped because adding the corresponding series would have exceeded the
+// configured -storage.maxHourlySeries or -storage.maxDailySeries limit.
+//
+// It is intentionally simple: it isn't persisted across restarts, isn't
+// tenant-aware and doesn't need to be, since it is only used for a single
+// storage node to help figure out which metric names are responsible for
+// hitting a series-limit setting.
+package droppedseriesstats
+
+import (
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+)
+
+// DefaultMaxTrackedMetricNames is the default number of distinct metric
+// names, which can be tracked by Tracker at once. It is used whenever
+// NewTracker is called with maxEntries<=0.
+const DefaultMaxTrackedMetricNames = 1000
+
+// Tracker keeps track of the number of dropped samples per metric name.
+//
+// The number of distinct tracked metric names is bounded by maxEntries in
+// order to protect against unbounded memory growth when a lot of distinct
+// metric names hit the series limit. Once the tracker is full, drops for new,
+// not-yet-tracked metric names are simply not accounted, while already
+// tracked metric names keep being updated.
+//
+// It is safe to call Tracker methods from concurrent goroutines.
+// It is safe to call methods on a nil *Tracker - they are no-ops returning
+// zero values.
+type Tracker struct {
+	maxEntries int
+
+	mu sync.RWMutex
+	m  map[string]*atomic.Uint64
+}
+
+// NewTracker creates a Tracker, which tracks at most maxEntries distinct
+// metric names. If maxEntries<=0, DefaultMaxTrackedMetricNames is used
+// instead.
+func NewTracker(maxEntries int) *Tracker {
+	if maxEntries <= 0 {
+		maxEntries = DefaultMaxTrackedMetricNames
+	}
+	return &Tracker{
+		maxEntries: maxEntries,
+		m:          make(map[string]*atomic.Uint64),
+	}
+}
+
+// IncrementFor increments the number of dropped samples for the given
+// metricName by 1.
+//
+// metricName isn't retained if it isn't already tracked and the tracker
+// has already reached its maxEntries limit.
+func (t *Tracker) IncrementFor(metricName string) {
+	if t == nil {
+		return
+	}
+	t.mu.RLock()
+	cnt, ok := t.m[metricName]
+	t.mu.RUnlock()
+	if ok {
+		cnt.Add(1)
+		return
+	}
+
+	t.mu.Lock()
+	cnt, ok = t.m[metricName]
+	if !ok {
+		if len(t.m) >= t.maxEntries {
+			t.mu.Unlock()
+			return
+		}
+		cnt = &atomic.Uint64{}
+		// Clone metricName, since it may be a substring of a larger,
+		// reused buffer.
+		t.m[strings.Clone(metricName)] = cnt
+	}
+	t.mu.Unlock()
+
+	cnt.Add(1)
+}
+
+// Entry represents the number of dropped samples for a single metric name.
+type Entry struct {
+	MetricName       string
+	DroppedRowsCount uint64
+}
+
+// GetTopEntries returns up to limit Entry values sorted by DroppedRowsCount
+// in descending order. If limit<=0, all the tracked entries are returned.
+func (t *Tracker) GetTopEntries(limit int) []Entry {
+	if t == nil {
+		return nil
+	}
+	t.mu.RLock()
+	entries := make([]Entry, 0, len(t.m))
+	for metricName, cnt := range t.m {
+		entries = append(entries, Entry{
+			MetricName:       metricName,
+			DroppedRowsCount: cnt.Load(),
+		})
+	}
+	t.mu.RUnlock()
+
+	sort.Slice(entries, func(i, j int) bool {
+		if entries[i].DroppedRowsCount != entries[j].DroppedRowsCount {
+			return entries[i].DroppedRowsCount > entries[j].DroppedRowsCount
+		}
+		return entries[i].MetricName < entries[j].MetricName
+	})
+	if limit > 0 && limit < len(entries) {
+		entries = entries[:limit]
+	}
+	return entries
+}
+
+// Reset drops all the tracked entries.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.m = make(map[string]*atomic.Uint64)
+	t.mu.Unlock()
+}
+
+// EntriesCount returns the number of currently tracked distinct metric
+// names.
+func (t *Tracker) EntriesCount() int {
+	if t == nil {
+		return 0
+	}
+	t.mu.RLock()
+	n := len(t.m)
+	t.mu.RUnlock()
+	return n
+}
+
+// MaxEntries returns the maximum number of distinct metric names, which can
+// be tracked at once.
+func (t *Tracker) MaxEntries() int {
+	if t == nil {
+		return 0
+	}
+	return t.maxEntries
+}
diff --git a/lib/storage/droppedseriesstats/tracker_test.go b/lib/storage/droppedseriesstats/tracker_test.go
new file mode 100644
index 0000000..3930569
--- /dev/null
+++ b/lib/storage/droppedseriesstats/tracker_test.go
@@ -0,0 +1,183 @@
+package droppedseriesstats
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestTracker_NilIsNoOp(t *testing.T) {
+	var t2 *Tracker
+	t2.IncrementFor("foo")
+	if got := t2.GetTopEntries(10); got != nil {
+		t.Fatalf("unexpected result for nil tracker: %v", got)
+	}
+	if got := t2.EntriesCount(); got != 0 {
+		t.Fatalf("unexpected EntriesCount for nil tracker: %d", got)
+	}
+	if got := t2.MaxEntries(); got != 0 {
+		t.Fatalf("unexpected MaxEntries for nil tracker: %d", got)
+	}
+	t2.Reset()
+}
+
+func TestTracker_RecordsDropsForMultipleMetricNames(t *testing.T) {
+	tr := NewTracker(100)
+
+	tr.IncrementFor("metric_a")
+	tr.IncrementFor("metric_a")
+	tr.IncrementFor("metric_a")
+	tr.IncrementFor("metric_b")
+	tr.IncrementFor("metric_c")
+	tr.IncrementFor("metric_c")
+
+	if got, want := tr.EntriesCount(), 3; got != want {
+		t.Fatalf("unexpected EntriesCount: got %d, want %d", got, want)
+	}
+
+	entries := tr.GetTopEntries(0)
+	got := make(map[string]uint64, len(entries))
+	for _, e := range entries {
+		got[e.MetricName] = e.DroppedRowsCount
+	}
+	want := map[string]uint64{
+		"metric_a": 3,
+		"metric_b": 1,
+		"metric_c": 2,
+	}
+	if len(got) != len(want) {
+		t.Fatalf("unexpected number of entries: got %v, want %v", got, want)
+	}
+	for name, cnt := range want {
+		if got[name] != cnt {
+			t.Fatalf("unexpected count for %q: got %d, want %d", name, got[name], cnt)
+		}
+	}
+}
+
+func TestTracker_GetTopEntriesRespectsLimitAndOrder(t *testing.T) {
+	tr := NewTracker(100)
+
+	counts := map[string]int{
+		"metric_low":    1,
+		"metric_mid":    5,
+		"metric_high":   10,
+		"metric_medium": 3,
+	}
+	for name, cnt := range counts {
+		for range cnt {
+			tr.IncrementFor(name)
+		}
+	}
+
+	top2 := tr.GetTopEntries(2)
+	if len(top2) != 2 {
+		t.Fatalf("unexpected number of entries: got %d, want 2", len(top2))
+	}
+	if top2[0].MetricName != "metric_high" || top2[0].DroppedRowsCount != 10 {
+		t.Fatalf("unexpected top entry: %+v", top2[0])
+	}
+	if top2[1].MetricName != "metric_mid" || top2[1].DroppedRowsCount != 5 {
+		t.Fatalf("unexpected second entry: %+v", top2[1])
+	}
+
+	all := tr.GetTopEntries(0)
+	if len(all) != len(counts) {
+		t.Fatalf("unexpected number of entries with limit=0: got %d, want %d", len(all), len(counts))
+	}
+	for i := 1; i < len(all); i++ {
+		if all[i-1].DroppedRowsCount < all[i].DroppedRowsCount {
+			t.Fatalf("entries aren't sorted in descending order: %+v", all)
+		}
+	}
+}
+
+func TestTracker_MaxEntriesIsRespected(t *testing.T) {
+	const maxEntries = 10
+	tr := NewTracker(maxEntries)
+
+	for i := range 1000 {
+		tr.IncrementFor(fmt.Sprintf("metric_%d", i))
+	}
+
+	if got := tr.EntriesCount(); got != maxEntries {
+		t.Fatalf("unexpected EntriesCount: got %d, want %d", got, maxEntries)
+	}
+	if got := tr.MaxEntries(); got != maxEntries {
+		t.Fatalf("unexpected MaxEntries: got %d, want %d", got, maxEntries)
+	}
+
+	// Already tracked metric names must keep being updated even after the
+	// tracker is full.
+	entriesBefore := tr.GetTopEntries(0)
+	trackedName := entriesBefore[0].MetricName
+	trackedCountBefore := entriesBefore[0].DroppedRowsCount
+	tr.IncrementFor(trackedName)
+
+	entriesAfter := tr.GetTopEntries(0)
+	if got := tr.EntriesCount(); got != maxEntries {
+		t.Fatalf("unexpected EntriesCount after update of already-tracked entry: got %d, want %d", got, maxEntries)
+	}
+	found := false
+	for _, e := range entriesAfter {
+		if e.MetricName == trackedName {
+			found = true
+			if e.DroppedRowsCount != trackedCountBefore+1 {
+				t.Fatalf("unexpected count for %q: got %d, want %d", trackedName, e.DroppedRowsCount, trackedCountBefore+1)
+			}
+		}
+	}
+	if !found {
+		t.Fatalf("expected %q to remain tracked", trackedName)
+	}
+}
+
+func TestTracker_DefaultMaxEntries(t *testing.T) {
+	tr := NewTracker(0)
+	if got := tr.MaxEntries(); got != DefaultMaxTrackedMetricNames {
+		t.Fatalf("unexpected default MaxEntries: got %d, want %d", got, DefaultMaxTrackedMetricNames)
+	}
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(100)
+	tr.IncrementFor("metric_a")
+	tr.IncrementFor("metric_b")
+	if got := tr.EntriesCount(); got != 2 {
+		t.Fatalf("unexpected EntriesCount before reset: %d", got)
+	}
+	tr.Reset()
+	if got := tr.EntriesCount(); got != 0 {
+		t.Fatalf("unexpected EntriesCount after reset: %d", got)
+	}
+	if got := tr.GetTopEntries(0); len(got) != 0 {
+		t.Fatalf("unexpected entries after reset: %v", got)
+	}
+}
+
+func TestTracker_ConcurrentAccess(t *testing.T) {
+	tr := NewTracker(50)
+
+	var wg sync.WaitGroup
+	const goroutines = 20
+	const iterations = 200
+	for g := range goroutines {
+		wg.Add(1)
+		go func(g int) {
+			defer wg.Done()
+			name := fmt.Sprintf("metric_%d", g%5)
+			for range iterations {
+				tr.IncrementFor(name)
+			}
+		}(g)
+	}
+	wg.Wait()
+
+	var total uint64
+	for _, e := range tr.GetTopEntries(0) {
+		total += e.DroppedRowsCount
+	}
+	if want := uint64(goroutines * iterations); total != want {
+		t.Fatalf("unexpected total dropped count: got %d, want %d", total, want)
+	}
+}
