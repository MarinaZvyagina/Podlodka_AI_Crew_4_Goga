+func TestStorage_SeriesLimitExceededStats(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const (
+		seriesPerName   = 200
+		maxHourlySeries = 150
+	)
+	metricNames := []string{"metric_a", "metric_b", "metric_c"}
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	tr := TimeRange{minTimestamp, maxTimestamp}
+	mrs := testGenerateMetricRowsForNames(rng, metricNames, seriesPerName, tr)
+
+	opts := OpenOptions{
+		MaxHourlySeries:               maxHourlySeries,
+		TrackSeriesLimitExceededStats: true,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped == 0 {
+		t.Fatalf("expected some rows to be dropped because of -storage.maxHourlySeries")
+	}
+
+	// Drops must be recorded for more than one metric name.
+	entries := s.GetSeriesLimitExceededStats(0)
+	if len(entries) < 2 {
+		t.Fatalf("expected drops to be recorded for multiple metric names, got %d entries: %+v", len(entries), entries)
+	}
+	seenNames := make(map[string]bool)
+	var totalDropped uint64
+	for i, e := range entries {
+		if !metricNamesContain(metricNames, e.MetricName) {
+			t.Fatalf("unexpected metric name in stats: %q", e.MetricName)
+		}
+		seenNames[e.MetricName] = true
+		totalDropped += e.DroppedRowsCount
+		if i > 0 && entries[i-1].DroppedRowsCount < e.DroppedRowsCount {
+			t.Fatalf("entries aren't sorted by DroppedRowsCount in descending order: %+v", entries)
+		}
+	}
+	if totalDropped != m.HourlySeriesLimitRowsDropped {
+		t.Fatalf("sum of per-metric-name drop counts %d doesn't match Metrics.HourlySeriesLimitRowsDropped %d", totalDropped, m.HourlySeriesLimitRowsDropped)
+	}
+
+	// Querying with a limit must return only the top offenders.
+	top1 := s.GetSeriesLimitExceededStats(1)
+	if len(top1) != 1 {
+		t.Fatalf("unexpected number of entries with limit=1: got %d, want 1", len(top1))
+	}
+	if top1[0] != entries[0] {
+		t.Fatalf("unexpected top entry: got %+v, want %+v", top1[0], entries[0])
+	}
+
+	// Reset must clear the recorded stats.
+	s.ResetSeriesLimitExceededStats()
+	if got := s.GetSeriesLimitExceededStats(0); len(got) != 0 {
+		t.Fatalf("expected no entries after reset, got %+v", got)
+	}
+}
