diff --git a/lib/storage/series_limit_dropped_names.go b/lib/storage/series_limit_dropped_names.go
new file mode 100644
index 0000000..42b9b7e
--- /dev/null
+++ b/lib/storage/series_limit_dropped_names.go
@@ -0,0 +1,119 @@
+package storage
+
+import (
+	"sort"
+	"sync"
+)
+
+// SeriesLimitDroppedName is a single metric name plus the number of samples
+// dropped for it because adding the corresponding series would have exceeded
+// -storage.maxHourlySeries or -storage.maxDailySeries.
+type SeriesLimitDroppedName struct {
+	MetricName     string
+	SamplesDropped uint64
+}
+
+// seriesLimitDroppedNamesTracker tracks, per metric name, how many samples
+// were dropped because adding the corresponding series would have exceeded
+// the configured hourly or daily unique-series limit.
+//
+// The number of distinct tracked metric names is bounded by maxEntries in
+// order to prevent unbounded memory growth on installations with millions of
+// distinct metric names hitting the limit. Once the bound is reached,
+// previously unseen metric names are simply not tracked - the aggregate drop
+// counter exposed elsewhere is unaffected.
+type seriesLimitDroppedNamesTracker struct {
+	maxEntries int
+
+	mu sync.RWMutex
+	m  map[string]*uint64Counter
+}
+
+// uint64Counter is a tiny non-atomic counter protected by seriesLimitDroppedNamesTracker.mu.
+//
+// A plain struct is used instead of atomic.Uint64 because every mutation is
+// already performed under the tracker's lock (see Increment), so there is no
+// need for a separate atomic type - this keeps the map values cheap to
+// allocate in bulk.
+type uint64Counter struct {
+	n uint64
+}
+
+func newSeriesLimitDroppedNamesTracker(maxEntries int) *seriesLimitDroppedNamesTracker {
+	return &seriesLimitDroppedNamesTracker{
+		maxEntries: maxEntries,
+		m:          make(map[string]*uint64Counter),
+	}
+}
+
+// Increment registers a single dropped sample for the given metric name.
+//
+// It is a no-op if t is nil, which allows callers to skip a nil check on the
+// hot path when the tracking feature is disabled.
+func (t *seriesLimitDroppedNamesTracker) Increment(metricName []byte) {
+	if t == nil {
+		return
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if c, ok := t.m[string(metricName)]; ok {
+		c.n++
+		return
+	}
+	if len(t.m) >= t.maxEntries {
+		return
+	}
+	t.m[string(metricName)] = &uint64Counter{n: 1}
+}
+
+// GetTop returns up to topN tracked metric names sorted by descending drop count.
+//
+// If topN <= 0, all tracked entries are returned.
+func (t *seriesLimitDroppedNamesTracker) GetTop(topN int) []SeriesLimitDroppedName {
+	if t == nil {
+		return nil
+	}
+
+	t.mu.RLock()
+	result := make([]SeriesLimitDroppedName, 0, len(t.m))
+	for name, c := range t.m {
+		result = append(result, SeriesLimitDroppedName{
+			MetricName:     name,
+			SamplesDropped: c.n,
+		})
+	}
+	t.mu.RUnlock()
+
+	sort.Slice(result, func(i, j int) bool {
+		if result[i].SamplesDropped != result[j].SamplesDropped {
+			return result[i].SamplesDropped > result[j].SamplesDropped
+		}
+		return result[i].MetricName < result[j].MetricName
+	})
+	if topN > 0 && topN < len(result) {
+		result = result[:topN]
+	}
+	return result
+}
+
+// EntriesCount returns the number of distinct metric names currently tracked.
+func (t *seriesLimitDroppedNamesTracker) EntriesCount() int {
+	if t == nil {
+		return 0
+	}
+	t.mu.RLock()
+	defer t.mu.RUnlock()
+	return len(t.m)
+}
+
+// Reset drops all the collected stats.
+func (t *seriesLimitDroppedNamesTracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.m = make(map[string]*uint64Counter)
+	t.mu.Unlock()
+}
