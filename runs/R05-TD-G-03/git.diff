new file mode 100644
index 0000000..78adaf8
--- /dev/null
+++ b/lib/storage/series_limit_dropped_names_test.go
@@ -0,0 +1,227 @@
+package storage
+
+import (
+	"fmt"
+	"math/rand"
+	"testing"
+	"time"
+)
+
+func TestSeriesLimitDroppedNamesTracker_IncrementAndGetTop(t *testing.T) {
+	tr := newSeriesLimitDroppedNamesTracker(100)
+
+	// Record drops for multiple distinct metric names, with different counts.
+	for range 5 {
+		tr.Increment([]byte("metric_a"))
+	}
+	for range 3 {
+		tr.Increment([]byte("metric_b"))
+	}
+	tr.Increment([]byte("metric_c"))
+
+	if got, want := tr.EntriesCount(), 3; got != want {
+		t.Fatalf("unexpected EntriesCount: got %d, want %d", got, want)
+	}
+
+	got := tr.GetTop(10)
+	want := []SeriesLimitDroppedName{
+		{MetricName: "metric_a", SamplesDropped: 5},
+		{MetricName: "metric_b", SamplesDropped: 3},
+		{MetricName: "metric_c", SamplesDropped: 1},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("unexpected number of entries: got %d, want %d; got=%+v", len(got), len(want), got)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("unexpected entry at index %d: got %+v, want %+v; full got=%+v", i, got[i], want[i], got)
+		}
+	}
+
+	// topN limiting.
+	top1 := tr.GetTop(1)
+	if len(top1) != 1 || top1[0].MetricName != "metric_a" {
+		t.Fatalf("unexpected GetTop(1) result: %+v", top1)
+	}
+
+	// topN <= 0 returns all the entries.
+	all := tr.GetTop(0)
+	if len(all) != 3 {
+		t.Fatalf("unexpected GetTop(0) result length: got %d, want 3", len(all))
+	}
+}
+
+func TestSeriesLimitDroppedNamesTracker_Reset(t *testing.T) {
+	tr := newSeriesLimitDroppedNamesTracker(100)
+	tr.Increment([]byte("metric_a"))
+	tr.Increment([]byte("metric_b"))
+	if got := tr.EntriesCount(); got != 2 {
+		t.Fatalf("unexpected EntriesCount before Reset: got %d, want 2", got)
+	}
+
+	tr.Reset()
+
+	if got := tr.EntriesCount(); got != 0 {
+		t.Fatalf("unexpected EntriesCount after Reset: got %d, want 0", got)
+	}
+	if got := tr.GetTop(10); len(got) != 0 {
+		t.Fatalf("unexpected GetTop() after Reset: %+v", got)
+	}
+
+	// The tracker must remain usable after Reset.
+	tr.Increment([]byte("metric_c"))
+	if got := tr.EntriesCount(); got != 1 {
+		t.Fatalf("unexpected EntriesCount after re-populating post-Reset: got %d, want 1", got)
+	}
+}
+
+func TestSeriesLimitDroppedNamesTracker_MemoryBoundRespected(t *testing.T) {
+	const maxEntries = 10
+	tr := newSeriesLimitDroppedNamesTracker(maxEntries)
+
+	// Ingest drops for far more distinct metric names than maxEntries allows.
+	const numNames = 10000
+	for i := range numNames {
+		tr.Increment(fmt.Appendf(nil, "metric_%d", i))
+	}
+
+	if got := tr.EntriesCount(); got != maxEntries {
+		t.Fatalf("tracker exceeded its memory bound: got %d entries, want exactly %d", got, maxEntries)
+	}
+	if got := len(tr.GetTop(0)); got != maxEntries {
+		t.Fatalf("GetTop() returned more entries than the configured bound: got %d, want %d", got, maxEntries)
+	}
+
+	// Already-tracked names must keep accumulating counts correctly even
+	// after the tracker becomes full and starts rejecting unseen names.
+	top := tr.GetTop(1)
+	if len(top) != 1 {
+		t.Fatalf("unexpected GetTop(1) result: %+v", top)
+	}
+	trackedName := top[0].MetricName
+	for range 41 {
+		tr.Increment([]byte(trackedName))
+	}
+	if got := tr.EntriesCount(); got != maxEntries {
+		t.Fatalf("tracker grew beyond its memory bound after incrementing an existing entry: got %d entries, want %d", got, maxEntries)
+	}
+	newTop := tr.GetTop(1)
+	if newTop[0].MetricName != trackedName || newTop[0].SamplesDropped != top[0].SamplesDropped+41 {
+		t.Fatalf("unexpected counter value for already-tracked name after tracker became full: got %+v, want name=%s count=%d",
+			newTop[0], trackedName, top[0].SamplesDropped+41)
+	}
+}
+
+func TestStorageSeriesLimitDroppedNames(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const maxHourlySeries = 3
+	s := MustOpenStorage(t.Name(), OpenOptions{
+		MaxHourlySeries:            maxHourlySeries,
+		MaxSeriesLimitDroppedNames: 100,
+	})
+	defer s.MustClose()
+
+	// Generate rows for a handful of distinct metric names, with a different
+	// number of rows (and hence distinct series, since tags differ per row)
+	// per metric name, so that dropped-sample counts differ across names.
+	var mrs []MetricRow
+	rowsPerName := map[string]int{
+		"metric_noisy":    20,
+		"metric_moderate": 8,
+		"metric_quiet":    2,
+	}
+	minTimestamp := time.Now().UnixMilli()
+	ts := minTimestamp
+	for name, n := range rowsPerName {
+		for i := range n {
+			var mn MetricName
+			mn.MetricGroup = []byte(name)
+			mn.Tags = []Tag{
+				{Key: []byte("iteration"), Value: fmt.Appendf(nil, "%d", i)},
+			}
+			mrs = append(mrs, MetricRow{
+				MetricNameRaw: mn.marshalRaw(nil),
+				Timestamp:     ts,
+				Value:         float64(i),
+			})
+			ts++
+		}
+	}
+
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped == 0 {
+		t.Fatalf("expected some rows to be dropped due to -storage.maxHourlySeries, got 0")
+	}
+
+	top := s.GetHourlySeriesLimitDroppedNames(10)
+	if len(top) == 0 {
+		t.Fatalf("expected GetHourlySeriesLimitDroppedNames to return at least one entry")
+	}
+
+	// Every returned entry must be one of the ingested metric names, with a
+	// drop count that is at most the number of series generated for it minus
+	// the configured limit (some of its series could have been let through
+	// before the limit was reached).
+	seen := make(map[string]uint64)
+	for _, e := range top {
+		n, ok := rowsPerName[e.MetricName]
+		if !ok {
+			t.Fatalf("unexpected metric name in top offenders: %q", e.MetricName)
+		}
+		if e.SamplesDropped == 0 || e.SamplesDropped > uint64(n) {
+			t.Fatalf("unexpected SamplesDropped for %q: got %d, want in range (0, %d]", e.MetricName, e.SamplesDropped, n)
+		}
+		seen[e.MetricName] = e.SamplesDropped
+	}
+
+	// Results must be sorted by descending drop count.
+	for i := 1; i < len(top); i++ {
+		if top[i-1].SamplesDropped < top[i].SamplesDropped {
+			t.Fatalf("GetHourlySeriesLimitDroppedNames() is not sorted by descending drop count: %+v", top)
+		}
+	}
+
+	// The daily limit was not configured, so there must be nothing to report for it.
+	if got := s.GetDailySeriesLimitDroppedNames(10); len(got) != 0 {
+		t.Fatalf("expected no daily series-limit drop stats, got %+v", got)
+	}
+
+	// After ResetSeriesLimitDroppedNames, previously collected stats must be gone.
+	s.ResetSeriesLimitDroppedNames()
+	if got := s.GetHourlySeriesLimitDroppedNames(10); len(got) != 0 {
+		t.Fatalf("expected no drop stats after ResetSeriesLimitDroppedNames, got %+v", got)
+	}
+}
+
+func TestStorageSeriesLimitDroppedNames_Disabled(t *testing.T) {
+	defer testRemoveAll(t)
+
+	// MaxSeriesLimitDroppedNames is 0 (the zero value), so the tracker is disabled
+	// even though the hourly limit itself is enabled and gets hit.
+	s := MustOpenStorage(t.Name(), OpenOptions{
+		MaxHourlySeries: 1,
+	})
+	defer s.MustClose()
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	mrs := testGenerateMetricRows(rng, 50, minTimestamp, maxTimestamp)
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped == 0 {
+		t.Fatalf("expected some rows to be dropped due to -storage.maxHourlySeries, got 0")
+	}
+
+	if got := s.GetHourlySeriesLimitDroppedNames(10); got != nil {
+		t.Fatalf("expected nil result when tracking is disabled, got %+v", got)
+	}
+}
