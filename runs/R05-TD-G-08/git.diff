new file mode 100644
index 0000000..6dadd12
--- /dev/null
+++ b/lib/storage/droppedseriesstats/tracker_test.go
@@ -0,0 +1,187 @@
+package droppedseriesstats
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestTracker_MultipleMetricNames(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	tr.IncHourly([]byte("metric_a"))
+	tr.IncHourly([]byte("metric_a"))
+	tr.IncDaily([]byte("metric_a"))
+
+	tr.IncHourly([]byte("metric_b"))
+
+	tr.IncDaily([]byte("metric_c"))
+	tr.IncDaily([]byte("metric_c"))
+	tr.IncDaily([]byte("metric_c"))
+
+	result := tr.GetTop(10)
+	if result.TrackedMetricNames != 3 {
+		t.Fatalf("unexpected TrackedMetricNames; got %d; want 3", result.TrackedMetricNames)
+	}
+	if len(result.Records) != 3 {
+		t.Fatalf("unexpected number of records; got %d; want 3", len(result.Records))
+	}
+
+	byName := make(map[string]Record)
+	for _, r := range result.Records {
+		byName[r.MetricName] = r
+	}
+
+	a := byName["metric_a"]
+	if a.HourlySeriesLimitRowsDropped != 2 || a.DailySeriesLimitRowsDropped != 1 {
+		t.Fatalf("unexpected counters for metric_a: %+v", a)
+	}
+	b := byName["metric_b"]
+	if b.HourlySeriesLimitRowsDropped != 1 || b.DailySeriesLimitRowsDropped != 0 {
+		t.Fatalf("unexpected counters for metric_b: %+v", b)
+	}
+	c := byName["metric_c"]
+	if c.HourlySeriesLimitRowsDropped != 0 || c.DailySeriesLimitRowsDropped != 3 {
+		t.Fatalf("unexpected counters for metric_c: %+v", c)
+	}
+}
+
+func TestTracker_GetTopOrderingAndLimit(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	names := map[string]int{
+		"metric_low":  1,
+		"metric_mid":  5,
+		"metric_high": 10,
+	}
+	for name, n := range names {
+		for i := 0; i < n; i++ {
+			tr.IncHourly([]byte(name))
+		}
+	}
+
+	result := tr.GetTop(2)
+	if len(result.Records) != 2 {
+		t.Fatalf("unexpected number of records; got %d; want 2", len(result.Records))
+	}
+	if result.Records[0].MetricName != "metric_high" {
+		t.Fatalf("unexpected top record; got %q; want metric_high", result.Records[0].MetricName)
+	}
+	if result.Records[1].MetricName != "metric_mid" {
+		t.Fatalf("unexpected second record; got %q; want metric_mid", result.Records[1].MetricName)
+	}
+	// TrackedMetricNames must reflect the total number of tracked names,
+	// regardless of the requested limit.
+	if result.TrackedMetricNames != 3 {
+		t.Fatalf("unexpected TrackedMetricNames; got %d; want 3", result.TrackedMetricNames)
+	}
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+	tr.IncHourly([]byte("metric_a"))
+	tr.IncDaily([]byte("metric_b"))
+
+	tr.Reset()
+
+	result := tr.GetTop(10)
+	if result.TrackedMetricNames != 0 {
+		t.Fatalf("unexpected TrackedMetricNames after reset; got %d; want 0", result.TrackedMetricNames)
+	}
+	if len(result.Records) != 0 {
+		t.Fatalf("unexpected records after reset; got %d; want 0", len(result.Records))
+	}
+
+	// tracking must work normally after reset
+	tr.IncHourly([]byte("metric_c"))
+	result = tr.GetTop(10)
+	if result.TrackedMetricNames != 1 {
+		t.Fatalf("unexpected TrackedMetricNames after post-reset tracking; got %d; want 1", result.TrackedMetricNames)
+	}
+}
+
+func TestTracker_MemoryBoundIsRespected(t *testing.T) {
+	// Choose a small maxSizeBytes, which can fit only a handful of entries.
+	const maxSizeBytes = 300
+	tr := NewTracker(maxSizeBytes)
+
+	const totalNames = 10000
+	for i := 0; i < totalNames; i++ {
+		name := fmt.Sprintf("metric_%d", i)
+		tr.IncHourly([]byte(name))
+	}
+
+	result := tr.GetTop(0)
+	if result.TrackedMetricNames == 0 {
+		t.Fatalf("expected at least some metric names to be tracked")
+	}
+	if result.TrackedMetricNames >= totalNames {
+		t.Fatalf("tracker didn't bound memory: tracked %d out of %d names", result.TrackedMetricNames, totalNames)
+	}
+	if result.CurrentSizeBytes > maxSizeBytes+entryOverheadBytes+64 {
+		// allow a small slack for the entry that pushed the tracker over the edge
+		t.Fatalf("tracker exceeded its memory bound: currentSizeBytes=%d, maxSizeBytes=%d", result.CurrentSizeBytes, maxSizeBytes)
+	}
+
+	// Counters for already-tracked metric names must keep being updated
+	// even after the tracker becomes full.
+	firstTracked := result.Records[0].MetricName
+	before := result.Records[0].HourlySeriesLimitRowsDropped
+	tr.IncHourly([]byte(firstTracked))
+	result = tr.GetTop(0)
+	var after uint64
+	for _, r := range result.Records {
+		if r.MetricName == firstTracked {
+			after = r.HourlySeriesLimitRowsDropped
+		}
+	}
+	if after != before+1 {
+		t.Fatalf("counter for already-tracked metric name wasn't updated after tracker became full: before=%d, after=%d", before, after)
+	}
+}
+
+func TestTracker_ConcurrentAccess(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	const goroutines = 20
+	const iterations = 200
+	var wg sync.WaitGroup
+	for g := 0; g < goroutines; g++ {
+		wg.Add(1)
+		go func(g int) {
+			defer wg.Done()
+			for i := 0; i < iterations; i++ {
+				name := fmt.Sprintf("metric_%d", i%10)
+				if g%2 == 0 {
+					tr.IncHourly([]byte(name))
+				} else {
+					tr.IncDaily([]byte(name))
+				}
+			}
+		}(g)
+	}
+	wg.Wait()
+
+	result := tr.GetTop(0)
+	if result.TrackedMetricNames != 10 {
+		t.Fatalf("unexpected TrackedMetricNames; got %d; want 10", result.TrackedMetricNames)
+	}
+	var total uint64
+	for _, r := range result.Records {
+		total += r.TotalRowsDropped()
+	}
+	if want := uint64(goroutines * iterations); total != want {
+		t.Fatalf("unexpected total dropped rows; got %d; want %d", total, want)
+	}
+}
+
+func TestTracker_NilTrackerIsNoOp(t *testing.T) {
+	var tr *Tracker
+	tr.IncHourly([]byte("metric_a"))
+	tr.IncDaily([]byte("metric_a"))
+	tr.Reset()
+	result := tr.GetTop(10)
+	if result.TrackedMetricNames != 0 || len(result.Records) != 0 {
+		t.Fatalf("expected empty result for nil tracker; got %+v", result)
+	}
+}
