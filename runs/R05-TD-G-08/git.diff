index 0000000..1dce74e
--- /dev/null
+++ b/lib/storage/droppedseriesstats/tracker.go
@@ -0,0 +1,255 @@
+// Package droppedseriesstats tracks, per metric name, how many samples were
+// dropped because adding a new series for that metric name would have
+// exceeded the configured -storage.maxHourlySeries or -storage.maxDailySeries
+// limit.
+//
+// This is intended to help support answer "which metric name(s) are hitting
+// our series-limit settings" without the customer having to dig through
+// their own instrumentation.
+package droppedseriesstats
+
+import (
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/bytesutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+const (
+	// metricNameBufSize is the size of the batch allocation for cloned metric names.
+	metricNameBufSize = 16 * 1024
+	// countersBufSize is the size of the batch allocation for counters entries.
+	countersBufSize = 1024
+
+	// entryOverheadBytes is an approximation of the per-entry memory overhead:
+	// map bucket, string header for the key and the pointer to counters.
+	entryOverheadBytes = 64
+)
+
+// Tracker is a bounded, in-memory tracker of per-metric-name series-limit
+// drop counts.
+//
+// Tracker is safe to use from concurrent goroutines. Its memory usage is
+// bounded by maxSizeBytes passed to NewTracker: once that bound is reached,
+// samples for metric names which aren't tracked yet stop being recorded,
+// while counters for the metric names which are already tracked keep growing.
+// This guarantees the tracker can't consume unbounded memory even in
+// installations with millions of distinct metric names.
+type Tracker struct {
+	maxSizeBytes uint64
+
+	creationTs       atomic.Uint64
+	currentSizeBytes atomic.Uint64
+
+	mu sync.RWMutex
+	m  map[string]*counters
+
+	// batch allocations in order to reduce the number of allocations
+	// and GC pressure.
+	metricNamesBuf []byte
+	countersBuf    []counters
+}
+
+type counters struct {
+	hourly atomic.Uint64
+	daily  atomic.Uint64
+}
+
+// NewTracker creates a Tracker, which can occupy up to maxSizeBytes of memory
+// for tracking distinct metric names.
+func NewTracker(maxSizeBytes uint64) *Tracker {
+	t := &Tracker{
+		maxSizeBytes: maxSizeBytes,
+	}
+	t.resetLocked()
+	return t
+}
+
+func (t *Tracker) resetLocked() {
+	t.m = make(map[string]*counters)
+	t.metricNamesBuf = nil
+	t.countersBuf = nil
+	t.currentSizeBytes.Store(0)
+	t.creationTs.Store(fasttime.UnixTimestamp())
+}
+
+// Reset drops all the collected stats and starts tracking from scratch.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.resetLocked()
+	t.mu.Unlock()
+}
+
+// IncHourly increments the number of samples dropped for metricName because
+// of -storage.maxHourlySeries limit.
+func (t *Tracker) IncHourly(metricName []byte) {
+	t.inc(metricName, true)
+}
+
+// IncDaily increments the number of samples dropped for metricName because
+// of -storage.maxDailySeries limit.
+func (t *Tracker) IncDaily(metricName []byte) {
+	t.inc(metricName, false)
+}
+
+func (t *Tracker) inc(metricName []byte, isHourly bool) {
+	if t == nil {
+		return
+	}
+
+	t.mu.RLock()
+	c, ok := t.m[bytesutil.ToUnsafeString(metricName)]
+	t.mu.RUnlock()
+	if !ok {
+		if t.isFull() {
+			// The tracker is full - do not track new metric names in order
+			// to bound memory usage. Counters for already-tracked metric
+			// names continue to be updated below.
+			return
+		}
+		t.mu.Lock()
+		// The entry could have been added concurrently, or the tracker
+		// could have become full while waiting for the lock.
+		c, ok = t.m[bytesutil.ToUnsafeString(metricName)]
+		if !ok {
+			if t.isFull() {
+				t.mu.Unlock()
+				return
+			}
+			c = t.nextCountersLocked()
+			name := t.cloneMetricNameLocked(metricName)
+			t.m[name] = c
+			t.mu.Unlock()
+			t.currentSizeBytes.Add(uint64(len(name)) + entryOverheadBytes)
+		} else {
+			t.mu.Unlock()
+		}
+	}
+
+	if isHourly {
+		c.hourly.Add(1)
+	} else {
+		c.daily.Add(1)
+	}
+}
+
+func (t *Tracker) isFull() bool {
+	return t.currentSizeBytes.Load() >= t.maxSizeBytes
+}
+
+func (t *Tracker) nextCountersLocked() *counters {
+	n := len(t.countersBuf) + 1
+	if n > cap(t.countersBuf) {
+		t.countersBuf = make([]counters, 0, countersBufSize)
+		n = 1
+	}
+	t.countersBuf = t.countersBuf[:n]
+	return &t.countersBuf[n-1]
+}
+
+// cloneMetricNameLocked clones metricName into a batch-allocated buffer in
+// order to reduce the number of allocations and GC pressure.
+func (t *Tracker) cloneMetricNameLocked(metricName []byte) string {
+	if len(metricName) > metricNameBufSize {
+		b := make([]byte, len(metricName))
+		copy(b, metricName)
+		return bytesutil.ToUnsafeString(b)
+	}
+	idx := len(t.metricNamesBuf)
+	n := len(metricName) + len(t.metricNamesBuf)
+	if n > cap(t.metricNamesBuf) {
+		t.metricNamesBuf = make([]byte, 0, metricNameBufSize)
+		idx = 0
+	}
+	t.metricNamesBuf = append(t.metricNamesBuf, metricName...)
+	return bytesutil.ToUnsafeString(t.metricNamesBuf[idx:])
+}
+
+// Record holds the drop stats collected for a single metric name.
+type Record struct {
+	MetricName                   string `json:"metricName"`
+	HourlySeriesLimitRowsDropped uint64 `json:"hourlySeriesLimitRowsDropped"`
+	DailySeriesLimitRowsDropped  uint64 `json:"dailySeriesLimitRowsDropped"`
+}
+
+// TotalRowsDropped returns the total number of dropped rows tracked for r.
+func (r *Record) TotalRowsDropped() uint64 {
+	return r.HourlySeriesLimitRowsDropped + r.DailySeriesLimitRowsDropped
+}
+
+// StatsResult is the result of a top-N stats query.
+type StatsResult struct {
+	// CollectedSinceTimestamp is the unix timestamp of the last Reset call
+	// (or of Tracker creation, if Reset was never called).
+	CollectedSinceTimestamp uint64 `json:"collectedSinceTimestamp"`
+
+	// TrackedMetricNames is the total number of distinct metric names
+	// currently tracked.
+	TrackedMetricNames uint64 `json:"trackedMetricNames"`
+
+	MaxSizeBytes     uint64 `json:"maxSizeBytes"`
+	CurrentSizeBytes uint64 `json:"currentSizeBytes"`
+
+	// Records contains up to the requested limit of top offenders sorted by
+	// TotalRowsDropped() in descending order.
+	Records []Record `json:"topRecords"`
+}
+
+// SizeStats returns the current tracked-entries count and memory usage of t,
+// without the cost of collecting and sorting all the tracked Records.
+//
+// It is suitable for being called on every metrics-exposition scrape.
+func (t *Tracker) SizeStats() (trackedMetricNames, currentSizeBytes, maxSizeBytes uint64) {
+	if t == nil {
+		return 0, 0, 0
+	}
+	t.mu.RLock()
+	trackedMetricNames = uint64(len(t.m))
+	t.mu.RUnlock()
+	return trackedMetricNames, t.currentSizeBytes.Load(), t.maxSizeBytes
+}
+
+// GetTop returns up to limit metric names with the highest number of dropped
+// rows, sorted in descending order of dropped rows.
+//
+// If limit <= 0, all tracked metric names are returned.
+func (t *Tracker) GetTop(limit int) StatsResult {
+	var result StatsResult
+	if t == nil {
+		return result
+	}
+
+	t.mu.RLock()
+	result.CollectedSinceTimestamp = t.creationTs.Load()
+	result.TrackedMetricNames = uint64(len(t.m))
+	result.MaxSizeBytes = t.maxSizeBytes
+	result.CurrentSizeBytes = t.currentSizeBytes.Load()
+
+	records := make([]Record, 0, len(t.m))
+	for name, c := range t.m {
+		records = append(records, Record{
+			MetricName:                   name,
+			HourlySeriesLimitRowsDropped: c.hourly.Load(),
+			DailySeriesLimitRowsDropped:  c.daily.Load(),
+		})
+	}
+	t.mu.RUnlock()
+
+	sort.Slice(records, func(i, j int) bool {
+		ti, tj := records[i].TotalRowsDropped(), records[j].TotalRowsDropped()
+		if ti == tj {
+			return records[i].MetricName < records[j].MetricName
+		}
+		return ti > tj
+	})
+	if limit > 0 && len(records) > limit {
+		records = records[:limit]
+	}
+	result.Records = records
+	return result
+}
