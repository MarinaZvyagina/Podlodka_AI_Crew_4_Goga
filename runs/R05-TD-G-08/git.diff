+func TestStorageSeriesLimitExceededStats(t *testing.T) {
+	defer testRemoveAll(t)
+
+	newRowForMetric := func(metricName, tagValue string, timestamp int64) MetricRow {
+		var mn MetricName
+		mn.MetricGroup = []byte(metricName)
+		mn.Tags = []Tag{{[]byte("instance"), []byte(tagValue)}}
+		return MetricRow{
+			MetricNameRaw: mn.marshalRaw(nil),
+			Timestamp:     timestamp,
+			Value:         1,
+		}
+	}
+
+	opts := OpenOptions{
+		MaxHourlySeries:               1,
+		TrackSeriesLimitExceededStats: true,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	now := time.Now().UnixMilli()
+
+	// Consume the only available hourly series slot, so that every
+	// subsequently ingested distinct series is rejected by the limiter.
+	s.AddRows([]MetricRow{newRowForMetric("seed_metric", "seed", now)}, defaultPrecisionBits)
+	s.DebugFlush()
+
+	// Ingest samples for multiple new metric names/series, all of which must
+	// be dropped because the hourly series limit is already exhausted.
+	var mrs []MetricRow
+	for i := range 5 {
+		mrs = append(mrs, newRowForMetric("cardinality_bomb_a", fmt.Sprintf("i%d", i), now))
+	}
+	for i := range 3 {
+		mrs = append(mrs, newRowForMetric("cardinality_bomb_b", fmt.Sprintf("i%d", i), now))
+	}
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if got, want := m.HourlySeriesLimitRowsDropped, uint64(8); got != want {
+		t.Fatalf("unexpected Metrics.HourlySeriesLimitRowsDropped: got %d, want %d", got, want)
+	}
+
+	// Querying for the top offenders must report per-metric-name drop counts.
+	stats := s.GetSeriesLimitExceededStats(10)
+	if got, want := stats.TrackedMetricNames, uint64(2); got != want {
+		t.Fatalf("unexpected TrackedMetricNames: got %d, want %d", got, want)
+	}
+	if len(stats.Records) != 2 {
+		t.Fatalf("unexpected number of records: got %d, want 2", len(stats.Records))
+	}
+	if got, want := stats.Records[0].MetricName, "cardinality_bomb_a"; got != want {
+		t.Fatalf("unexpected top offender: got %q, want %q", got, want)
+	}
+	if got, want := stats.Records[0].HourlySeriesLimitRowsDropped, uint64(5); got != want {
+		t.Fatalf("unexpected drop count for %q: got %d, want %d", stats.Records[0].MetricName, got, want)
+	}
+	if got, want := stats.Records[1].MetricName, "cardinality_bomb_b"; got != want {
+		t.Fatalf("unexpected second offender: got %q, want %q", got, want)
+	}
+	if got, want := stats.Records[1].HourlySeriesLimitRowsDropped, uint64(3); got != want {
+		t.Fatalf("unexpected drop count for %q: got %d, want %d", stats.Records[1].MetricName, got, want)
+	}
+
+	// A limited top-N query must still return the highest offender only.
+	top1 := s.GetSeriesLimitExceededStats(1)
+	if len(top1.Records) != 1 || top1.Records[0].MetricName != "cardinality_bomb_a" {
+		t.Fatalf("unexpected limited top query result: %+v", top1.Records)
+	}
+
+	// Resetting must drop all the collected stats.
+	s.ResetSeriesLimitExceededStats()
+	stats = s.GetSeriesLimitExceededStats(10)
+	if len(stats.Records) != 0 || stats.TrackedMetricNames != 0 {
+		t.Fatalf("expected empty stats after reset; got %+v", stats)
+	}
+}
