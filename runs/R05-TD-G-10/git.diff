diff --git a/lib/storage/droppedseriesnames/tracker.go b/lib/storage/droppedseriesnames/tracker.go
new file mode 100644
index 0000000..4196d8a
--- /dev/null
+++ b/lib/storage/droppedseriesnames/tracker.go
@@ -0,0 +1,166 @@
+// Package droppedseriesnames tracks, per metric name, how many samples were
+// dropped because adding the corresponding series would have exceeded
+// -storage.maxHourlySeries or -storage.maxDailySeries.
+package droppedseriesnames
+
+import (
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+// DefaultMaxItems is the default limit on the number of distinct metric
+// names tracked by Tracker when the caller doesn't override it.
+//
+// This bounds the tracker's memory usage regardless of how many distinct
+// metric names are actually hitting the series limit.
+const DefaultMaxItems = 1000
+
+// Tracker counts, per metric name, how many samples were dropped because
+// they would have exceeded the configured hourly or daily unique series
+// limit.
+//
+// The number of distinct tracked metric names is bounded by maxItems in
+// order to protect against unbounded memory growth when a lot of distinct
+// metric names are hitting the limit. Once the bound is reached, samples
+// for previously unseen metric names are no longer tracked, though counters
+// for already-tracked names keep growing.
+//
+// It is safe to call Tracker methods on a nil *Tracker - they are no-ops
+// in that case. This allows disabling the feature by simply not creating
+// a Tracker, with no overhead on the ingestion hot path.
+type Tracker struct {
+	maxItems int
+
+	mu sync.Mutex
+	m  map[string]uint64
+
+	since atomic.Uint64
+}
+
+// NewTracker creates a Tracker, which tracks at most maxItems distinct
+// metric names. If maxItems <= 0, DefaultMaxItems is used instead.
+func NewTracker(maxItems int) *Tracker {
+	if maxItems <= 0 {
+		maxItems = DefaultMaxItems
+	}
+	t := &Tracker{
+		maxItems: maxItems,
+		m:        make(map[string]uint64),
+	}
+	t.since.Store(fasttime.UnixTimestamp())
+	return t
+}
+
+// IncDropped registers a single dropped sample for the given metricName.
+//
+// If the tracker already holds maxItems distinct metric names and
+// metricName isn't among them, the call is ignored in order to keep
+// the tracker's memory usage bounded.
+func (t *Tracker) IncDropped(metricName []byte) {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if v, ok := t.m[string(metricName)]; ok {
+		t.m[string(metricName)] = v + 1
+		return
+	}
+	if len(t.m) >= t.maxItems {
+		return
+	}
+	t.m[string(metricName)] = 1
+}
+
+// Reset drops all the collected stats and restarts counting from scratch.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.m = make(map[string]uint64)
+	t.mu.Unlock()
+	t.since.Store(fasttime.UnixTimestamp())
+}
+
+// Len returns the number of distinct metric names currently tracked.
+func (t *Tracker) Len() int {
+	if t == nil {
+		return 0
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return len(t.m)
+}
+
+// MaxItems returns the configured limit on the number of distinct tracked
+// metric names.
+func (t *Tracker) MaxItems() int {
+	if t == nil {
+		return 0
+	}
+	return t.maxItems
+}
+
+// Entry represents a single metric name and the number of samples dropped
+// for it.
+type Entry struct {
+	MetricName  string
+	DroppedRows uint64
+}
+
+// Stats is the result of Tracker.Get.
+type Stats struct {
+	// Since is the unix timestamp of the last Reset call (or of tracker
+	// creation, if it was never reset).
+	Since uint64
+
+	// TotalTrackedNames is the number of distinct metric names currently
+	// tracked. It may be smaller than the real number of offending metric
+	// names if the maxItems bound has been reached.
+	TotalTrackedNames int
+
+	// Entries contains the top requested metric names sorted by
+	// DroppedRows in descending order.
+	Entries []Entry
+}
+
+// Get returns the top topN metric names by the number of dropped samples.
+//
+// If topN <= 0, all the tracked entries are returned.
+func (t *Tracker) Get(topN int) Stats {
+	if t == nil {
+		return Stats{}
+	}
+
+	t.mu.Lock()
+	entries := make([]Entry, 0, len(t.m))
+	for k, v := range t.m {
+		entries = append(entries, Entry{
+			MetricName:  k,
+			DroppedRows: v,
+		})
+	}
+	total := len(t.m)
+	t.mu.Unlock()
+
+	sort.Slice(entries, func(i, j int) bool {
+		if entries[i].DroppedRows != entries[j].DroppedRows {
+			return entries[i].DroppedRows > entries[j].DroppedRows
+		}
+		return entries[i].MetricName < entries[j].MetricName
+	})
+	if topN > 0 && topN < len(entries) {
+		entries = entries[:topN]
+	}
+
+	return Stats{
+		Since:             t.since.Load(),
+		TotalTrackedNames: total,
+		Entries:           entries,
+	}
+}
diff --git a/lib/storage/droppedseriesnames/tracker_test.go b/lib/storage/droppedseriesnames/tracker_test.go
new file mode 100644
index 0000000..bf12a45
--- /dev/null
+++ b/lib/storage/droppedseriesnames/tracker_test.go
@@ -0,0 +1,157 @@
+package droppedseriesnames
+
+import (
+	"fmt"
+	"testing"
+)
+
+func TestTracker_NilIsNoOp(t *testing.T) {
+	var tr *Tracker
+	tr.IncDropped([]byte("foo"))
+	tr.Reset()
+	if n := tr.Len(); n != 0 {
+		t.Fatalf("unexpected Len() for nil tracker: got %d, want 0", n)
+	}
+	if n := tr.MaxItems(); n != 0 {
+		t.Fatalf("unexpected MaxItems() for nil tracker: got %d, want 0", n)
+	}
+	st := tr.Get(10)
+	if len(st.Entries) != 0 {
+		t.Fatalf("unexpected entries for nil tracker: %v", st.Entries)
+	}
+}
+
+func TestTracker_RecordsMultipleMetricNames(t *testing.T) {
+	tr := NewTracker(100)
+
+	tr.IncDropped([]byte("metric_a"))
+	tr.IncDropped([]byte("metric_a"))
+	tr.IncDropped([]byte("metric_b"))
+	tr.IncDropped([]byte("metric_a"))
+	tr.IncDropped([]byte("metric_c"))
+
+	if n := tr.Len(); n != 3 {
+		t.Fatalf("unexpected number of tracked metric names: got %d, want 3", n)
+	}
+
+	st := tr.Get(0)
+	counts := make(map[string]uint64)
+	for _, e := range st.Entries {
+		counts[e.MetricName] = e.DroppedRows
+	}
+	want := map[string]uint64{
+		"metric_a": 3,
+		"metric_b": 1,
+		"metric_c": 1,
+	}
+	for name, wantCount := range want {
+		if counts[name] != wantCount {
+			t.Fatalf("unexpected drop count for %q: got %d, want %d", name, counts[name], wantCount)
+		}
+	}
+}
+
+func TestTracker_GetTopOffenders(t *testing.T) {
+	tr := NewTracker(100)
+
+	names := map[string]int{
+		"metric_low":    1,
+		"metric_medium": 5,
+		"metric_high":   10,
+		"metric_mid2":   3,
+	}
+	for name, count := range names {
+		for i := 0; i < count; i++ {
+			tr.IncDropped([]byte(name))
+		}
+	}
+
+	st := tr.Get(2)
+	if len(st.Entries) != 2 {
+		t.Fatalf("unexpected number of entries: got %d, want 2", len(st.Entries))
+	}
+	if st.Entries[0].MetricName != "metric_high" || st.Entries[0].DroppedRows != 10 {
+		t.Fatalf("unexpected top entry: %+v", st.Entries[0])
+	}
+	if st.Entries[1].MetricName != "metric_medium" || st.Entries[1].DroppedRows != 5 {
+		t.Fatalf("unexpected second entry: %+v", st.Entries[1])
+	}
+	if st.TotalTrackedNames != 4 {
+		t.Fatalf("unexpected TotalTrackedNames: got %d, want 4", st.TotalTrackedNames)
+	}
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(100)
+	tr.IncDropped([]byte("metric_a"))
+	tr.IncDropped([]byte("metric_b"))
+	if n := tr.Len(); n != 2 {
+		t.Fatalf("unexpected Len() before reset: got %d, want 2", n)
+	}
+
+	sinceBefore := tr.Get(0).Since
+
+	tr.Reset()
+	if n := tr.Len(); n != 0 {
+		t.Fatalf("unexpected Len() after reset: got %d, want 0", n)
+	}
+	st := tr.Get(0)
+	if len(st.Entries) != 0 {
+		t.Fatalf("unexpected entries after reset: %v", st.Entries)
+	}
+	if st.Since < sinceBefore {
+		t.Fatalf("Since timestamp must not decrease after reset: got %d, want >= %d", st.Since, sinceBefore)
+	}
+
+	tr.IncDropped([]byte("metric_a"))
+	if n := tr.Len(); n != 1 {
+		t.Fatalf("unexpected Len() after reset and new record: got %d, want 1", n)
+	}
+}
+
+func TestTracker_MemoryBoundIsRespected(t *testing.T) {
+	const maxItems = 10
+	tr := NewTracker(maxItems)
+
+	for i := 0; i < 10*maxItems; i++ {
+		tr.IncDropped([]byte(fmt.Sprintf("metric_%d", i)))
+	}
+
+	if n := tr.Len(); n != maxItems {
+		t.Fatalf("tracker exceeded its memory bound: got %d tracked names, want at most %d", n, maxItems)
+	}
+	st := tr.Get(0)
+	if len(st.Entries) != maxItems {
+		t.Fatalf("unexpected number of entries: got %d, want %d", len(st.Entries), maxItems)
+	}
+	if st.TotalTrackedNames != maxItems {
+		t.Fatalf("unexpected TotalTrackedNames: got %d, want %d", st.TotalTrackedNames, maxItems)
+	}
+
+	// Counters for already-tracked names must keep growing even after the
+	// bound is reached.
+	tr2 := NewTracker(1)
+	tr2.IncDropped([]byte("metric_a"))
+	tr2.IncDropped([]byte("metric_b")) // dropped due to the bound
+	tr2.IncDropped([]byte("metric_a"))
+	tr2.IncDropped([]byte("metric_a"))
+	if n := tr2.Len(); n != 1 {
+		t.Fatalf("unexpected Len(): got %d, want 1", n)
+	}
+	st2 := tr2.Get(0)
+	if len(st2.Entries) != 1 || st2.Entries[0].MetricName != "metric_a" || st2.Entries[0].DroppedRows != 3 {
+		t.Fatalf("unexpected entries: %+v", st2.Entries)
+	}
+}
+
+func TestTracker_DefaultMaxItems(t *testing.T) {
+	tr := NewTracker(0)
+	if tr.MaxItems() != DefaultMaxItems {
+		t.Fatalf("unexpected default MaxItems(): got %d, want %d", tr.MaxItems(), DefaultMaxItems)
+	}
+
+	tr = NewTracker(-5)
+	if tr.MaxItems() != DefaultMaxItems {
+		t.Fatalf("unexpected default MaxItems() for negative input: got %d, want %d", tr.MaxItems(), DefaultMaxItems)
+	}
+}
