+func TestStorage_DroppedSeriesLimitMetricNamesTrackingIsBounded(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const (
+		numRows         = 1000
+		maxHourlySeries = 500
+		maxTrackedNames = 10
+	)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	mrs := testGenerateMetricRows(rng, numRows, minTimestamp, maxTimestamp)
+
+	opts := OpenOptions{
+		MaxHourlySeries:                  maxHourlySeries,
+		MaxDroppedSeriesLimitMetricNames: maxTrackedNames,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if m.HourlySeriesLimitRowsDropped <= uint64(maxTrackedNames) {
+		t.Fatalf("test setup is broken: expected more dropped rows (%d) than the tracker bound (%d)", m.HourlySeriesLimitRowsDropped, maxTrackedNames)
+	}
+	if got := m.DroppedSeriesLimitNamesTrackerMaxSize; got != uint64(maxTrackedNames) {
+		t.Fatalf("unexpected Metrics.DroppedSeriesLimitNamesTrackerMaxSize: got %d, want %d", got, maxTrackedNames)
+	}
+	if got := m.DroppedSeriesLimitNamesTrackerSize; got != uint64(maxTrackedNames) {
+		t.Fatalf("unexpected Metrics.DroppedSeriesLimitNamesTrackerSize: got %d, want %d", got, maxTrackedNames)
+	}
+
+	st := s.GetDroppedSeriesLimitMetricNames(0)
+	if len(st.Entries) != maxTrackedNames {
+		t.Fatalf("tracker exceeded its configured memory bound: got %d tracked entries, want exactly %d", len(st.Entries), maxTrackedNames)
+	}
+}
