+func TestStorage_DroppedSeriesLimitMetricNamesTracking(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const (
+		numRows         = 1000
+		maxHourlySeries = 500
+	)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	mrs := testGenerateMetricRows(rng, numRows, minTimestamp, maxTimestamp)
+
+	opts := OpenOptions{
+		MaxHourlySeries:                  maxHourlySeries,
+		MaxDroppedSeriesLimitMetricNames: 10000,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	s.AddRows(mrs, defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	dropped := m.HourlySeriesLimitRowsDropped
+	if dropped == 0 {
+		t.Fatalf("expected some rows to be dropped because of the hourly series limit")
+	}
+
+	// testGenerateMetricRows generates a unique metric name per row, so every
+	// dropped row corresponds to a distinct tracked metric name with a drop
+	// count of exactly 1.
+	st := s.GetDroppedSeriesLimitMetricNames(0)
+	if uint64(len(st.Entries)) != dropped {
+		t.Fatalf("unexpected number of tracked dropped metric names: got %d, want %d", len(st.Entries), dropped)
+	}
+	for _, e := range st.Entries {
+		if e.DroppedRows != 1 {
+			t.Fatalf("unexpected DroppedRows for %q: got %d, want 1", e.MetricName, e.DroppedRows)
+		}
+		if !strings.HasPrefix(e.MetricName, "metric_") {
+			t.Fatalf("unexpected metric name tracked: %q", e.MetricName)
+		}
+	}
+
+	// Querying with a topN limit must return at most topN entries.
+	const topN = 3
+	stTop := s.GetDroppedSeriesLimitMetricNames(topN)
+	if len(stTop.Entries) != topN {
+		t.Fatalf("unexpected number of entries for topN=%d: got %d", topN, len(stTop.Entries))
+	}
+
+	// Resetting must clear the collected stats.
+	s.ResetDroppedSeriesLimitMetricNames()
+	st = s.GetDroppedSeriesLimitMetricNames(0)
+	if len(st.Entries) != 0 {
+		t.Fatalf("expected no tracked entries after reset, got %d", len(st.Entries))
+	}
+}
