diff --git a/server/auth/store_test.go b/server/auth/store_test.go
index fae3716..582c8a2 100644
--- a/server/auth/store_test.go
+++ b/server/auth/store_test.go
@@ -174,6 +174,38 @@ func TestUserAdd(t *testing.T) {
 	require.Truef(t, ok, "user %s should be added but it doesn't exist in rangePermCache", userName)
 }
 
+func TestUserAddEmptyPasswordRejected(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// no password and no hashed password given, and not opted into no-password mode
+	ua := &pb.AuthUserAddRequest{Name: "emptypass", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// explicitly opting into no-password mode must still work
+	ua = &pb.AuthUserAddRequest{Name: "emptypass", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	require.NoErrorf(t, err, "expected no-password user to be created, got %v", err)
+}
+
+func TestUserChangePasswordEmptyRejected(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// changing an existing (password-protected) user's password to blank must fail
+	_, err := as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo"})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a passwordless account must be unaffected by the empty-password check
+	ua := &pb.AuthUserAddRequest{Name: "nopassuser", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	require.NoErrorf(t, err, "expected no-password user to be created, got %v", err)
+
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "nopassuser"})
+	require.NoErrorf(t, err, "expected password change on no-password user to succeed, got %v", err)
+}
+
