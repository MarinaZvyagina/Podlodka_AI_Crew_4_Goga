+// isEmptyPasswordHash reports whether hashedPassword is the bcrypt hash of an
+// empty password, or is itself empty/invalid. The caller (e.g. EtcdServer)
+// bcrypt-hashes the password before it reaches the auth store, so an empty
+// password can no longer be detected by looking at the raw request fields.
+func isEmptyPasswordHash(hashedPassword []byte) bool {
+	if len(hashedPassword) == 0 {
+		return true
+	}
+	return bcrypt.CompareHashAndPassword(hashedPassword, []byte("")) == nil
+}
