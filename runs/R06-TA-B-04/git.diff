+func TestUserChangePasswordToEmpty(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// changing to a blank password is rejected for a regular (password-protected) user
+	_, err := as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo"})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// the user must still be able to authenticate with their original password
+	ctx := context.WithValue(context.WithValue(t.Context(), AuthenticateParamIndex{}, uint64(1)), AuthenticateParamSimpleTokenPrefix{}, "dummy")
+	_, err = as.Authenticate(ctx, "foo", "bar")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// a NoPassword account is untouched by this restriction
+	ua := &pb.AuthUserAddRequest{Name: "no-password-user", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "no-password-user"})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
