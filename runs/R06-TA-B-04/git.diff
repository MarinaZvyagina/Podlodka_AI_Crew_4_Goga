 }
 
+func TestUserAddWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// a blank password is rejected unless the user explicitly opts into NoPassword
+	ua := &pb.AuthUserAddRequest{Name: "blank-password-user", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	_, ok := as.rangePermCache["blank-password-user"]
+	require.Falsef(t, ok, "user should not have been added with a blank password")
+
+	// an explicitly passwordless account must keep working
+	ua = &pb.AuthUserAddRequest{Name: "no-password-user", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	if err != nil {
+		t.Fatal(err)
+	}
+}
