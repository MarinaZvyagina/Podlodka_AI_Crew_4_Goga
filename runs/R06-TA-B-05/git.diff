+// TestV3AuthUserAddWithEmptyPassword ensures that creating a user, or changing a user's
+// password, with a blank password is rejected unless the user opted into NoPassword mode.
+func TestV3AuthUserAddWithEmptyPassword(t *testing.T) {
+	integration.BeforeTest(t)
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	api := integration.ToGRPC(clus.Client(0))
+
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+
+	// creating a user with a blank password (no NoPassword opt-in) must fail.
+	_, err := api.Auth.UserAdd(ctx, &pb.AuthUserAddRequest{Name: "blank-pw-user", Options: &authpb.UserAddOptions{NoPassword: false}})
+	require.Truef(t, eqErrGRPC(err, rpctypes.ErrGRPCPasswordEmpty), "got %v, expected %v", err, rpctypes.ErrGRPCPasswordEmpty)
+
+	// creating a NoPassword user with a blank password must still succeed.
+	_, err = api.Auth.UserAdd(ctx, &pb.AuthUserAddRequest{Name: "nopass-user", Options: &authpb.UserAddOptions{NoPassword: true}})
+	require.NoError(t, err)
+
+	// creating a user with a real password must succeed.
+	_, err = api.Auth.UserAdd(ctx, &pb.AuthUserAddRequest{Name: "real-pw-user", Password: "s3cret", Options: &authpb.UserAddOptions{NoPassword: false}})
+	require.NoError(t, err)
+
+	// changing that user's password to blank must fail.
+	_, err = api.Auth.UserChangePassword(ctx, &pb.AuthUserChangePasswordRequest{Name: "real-pw-user"})
+	require.Truef(t, eqErrGRPC(err, rpctypes.ErrGRPCPasswordEmpty), "got %v, expected %v", err, rpctypes.ErrGRPCPasswordEmpty)
+
+	// changing the NoPassword user's (unused) password to blank must still succeed.
+	_, err = api.Auth.UserChangePassword(ctx, &pb.AuthUserChangePasswordRequest{Name: "nopass-user"})
+	require.NoError(t, err)
+}
