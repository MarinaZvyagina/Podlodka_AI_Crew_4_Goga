diff --git a/server/auth/store_test.go b/server/auth/store_test.go
index fae37161d..c8fbd0a06 100644
--- a/server/auth/store_test.go
+++ b/server/auth/store_test.go
@@ -1140,6 +1140,51 @@ func TestUserNoPasswordAdd(t *testing.T) {
 	require.ErrorIsf(t, err, ErrAuthFailed, "expected %v, got %v", ErrAuthFailed, err)
 }
 
+func TestUserAddWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	ua := &pb.AuthUserAddRequest{Name: "usernopass", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	_, err = as.UserGet(&pb.AuthUserGetRequest{Name: "usernopass"})
+	require.ErrorIsf(t, err, ErrUserNotFound, "user should not have been created, got %v", err)
+}
+
+func TestUserChangePasswordToEmpty(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	_, err := as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo"})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// existing password must remain usable after the rejected change
+	ctx := context.WithValue(context.WithValue(t.Context(), AuthenticateParamIndex{}, uint64(1)), AuthenticateParamSimpleTokenPrefix{}, "dummy")
+	_, err = as.Authenticate(ctx, "foo", "bar")
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestUserNoPasswordChangePasswordToEmpty(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	username := "usernopass"
+	ua := &pb.AuthUserAddRequest{Name: username, Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err := as.UserAdd(ua)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// a passwordless account must keep working exactly as before
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: username})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
