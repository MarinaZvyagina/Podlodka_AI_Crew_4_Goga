+// passwordIsEmpty reports whether the resolved password hash represents a
+// blank password, either because no hash was produced at all, or because the
+// hash validates against the empty string (e.g. it was derived from an empty
+// plaintext password before being hashed further up the stack).
+func passwordIsEmpty(password []byte) bool {
+	if len(password) == 0 {
+		return true
+	}
+	return bcrypt.CompareHashAndPassword(password, []byte("")) == nil
+}
