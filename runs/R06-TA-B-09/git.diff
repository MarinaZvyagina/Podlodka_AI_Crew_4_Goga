diff --git a/server/auth/store_test.go b/server/auth/store_test.go
index fae37161d..ba9b9315f 100644
--- a/server/auth/store_test.go
+++ b/server/auth/store_test.go
@@ -1151,6 +1151,27 @@ func TestUserAddWithOldLog(t *testing.T) {
 	}
 }
 
+func TestUserAddWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// no password material given at all
+	ua := &pb.AuthUserAddRequest{Name: "bar", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// hashed password that itself validates the empty string, as would be
+	// produced upstream when a client sends an empty plaintext password
+	ua = &pb.AuthUserAddRequest{Name: "bar", HashedPassword: encodePassword(""), Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err = as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a passwordless account must still be creatable without a password
+	ua = &pb.AuthUserAddRequest{Name: "bar", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	require.NoError(t, err)
+}
+
 func TestUserChangePasswordWithOldLog(t *testing.T) {
 	as, tearDown := setupAuthStore(t)
 	defer tearDown(t)
@@ -1177,3 +1198,22 @@ func TestUserChangePasswordWithOldLog(t *testing.T) {
 	require.Errorf(t, err, "expected %v, got %v", ErrUserNotFound, err)
 	require.ErrorIsf(t, err, ErrUserNotFound, "expected %v, got %v", ErrUserNotFound, err)
 }
+
+func TestUserChangePasswordWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// no password material given at all
+	_, err := as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo"})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// hashed password that itself validates the empty string
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo", HashedPassword: encodePassword("")})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a passwordless account must remain unaffected
+	_, err = as.UserAdd(&pb.AuthUserAddRequest{Name: "nopass", Options: &authpb.UserAddOptions{NoPassword: true}})
+	require.NoError(t, err)
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "nopass"})
+	require.NoError(t, err)
+}
