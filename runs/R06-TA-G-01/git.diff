+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// add a user with a blank password and no explicit no-password option
+	ua := &pb.AuthUserAddRequest{Name: "blank-pwd-user", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a user explicitly opted into no-password mode must still work
+	ua = &pb.AuthUserAddRequest{Name: "no-pwd-user", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	if err != nil {
+		t.Fatal(err)
+	}
+}
