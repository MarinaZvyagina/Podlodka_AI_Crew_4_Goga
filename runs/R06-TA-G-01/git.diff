+func TestUserAddWithEmptyPassword(t *testing.T) {
+	integration.BeforeTest(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	authapi := clus.RandClient()
+
+	// creating a user with a blank password, without opting into no-password
+	// mode, must be rejected rather than silently succeeding.
+	_, err := authapi.UserAdd(t.Context(), "blank-pwd-user", "")
+	require.ErrorIsf(t, err, rpctypes.ErrPasswordEmpty, "expected %v, got %v", rpctypes.ErrPasswordEmpty, err)
+
+	// a user explicitly opted into no-password mode must still work.
+	_, err = authapi.UserAddWithOptions(t.Context(), "no-pwd-user", "", &clientv3.UserAddOptions{NoPassword: true})
+	require.NoError(t, err)
+
+	// changing an existing user's password to blank must be rejected.
+	_, err = authapi.UserAdd(t.Context(), "pwd-user", "bar")
+	require.NoError(t, err)
+	_, err = authapi.UserChangePassword(t.Context(), "pwd-user", "")
+	require.ErrorIsf(t, err, rpctypes.ErrPasswordEmpty, "expected %v, got %v", rpctypes.ErrPasswordEmpty, err)
+
+	// changing a no-password account's password to blank must keep working.
+	_, err = authapi.UserChangePassword(t.Context(), "no-pwd-user", "")
+	require.NoError(t, err)
+}
