+// isEmptyPassword reports whether the resolved password bytes represent a
+// blank password, either because none was supplied at all, or because the
+// stored hash is itself a hash of the empty string.
+func isEmptyPassword(password []byte) bool {
+	if len(password) == 0 {
+		return true
+	}
+	return bcrypt.CompareHashAndPassword(password, []byte("")) == nil
+}
