@@ -174,6 +174,24 @@ func TestUserAdd(t *testing.T) {
 	require.Truef(t, ok, "user %s should be added but it doesn't exist in rangePermCache", userName)
 }
 
+func TestUserAddWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// adding a user with a blank password and no explicit NoPassword option must fail
+	ua := &pb.AuthUserAddRequest{Name: "blank-password-user", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	_, ok := as.rangePermCache["blank-password-user"]
+	require.Falsef(t, ok, "user should not have been created with a blank password")
+
+	// a blank password is fine when the account explicitly opts into no-password mode
+	ua = &pb.AuthUserAddRequest{Name: "passwordless-user", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	require.NoError(t, err)
+}
+
