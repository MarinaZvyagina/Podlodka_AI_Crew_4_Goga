+func TestUserChangePasswordToEmpty(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// changing a password-protected user's password to blank must fail
+	_, err := as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo"})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// the user's original password must still work
+	ctx := context.WithValue(context.WithValue(t.Context(), AuthenticateParamIndex{}, uint64(1)), AuthenticateParamSimpleTokenPrefix{}, "dummy")
+	_, err = as.Authenticate(ctx, "foo", "bar")
+	require.NoError(t, err)
+
+	// a passwordless account may still have its password "changed" to blank
+	_, err = as.UserAdd(&pb.AuthUserAddRequest{Name: "passwordless-user", Options: &authpb.UserAddOptions{NoPassword: true}})
+	require.NoError(t, err)
+
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "passwordless-user"})
+	require.NoError(t, err)
+}
