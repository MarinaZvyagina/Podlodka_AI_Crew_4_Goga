+// isPasswordEmpty reports whether the resolved password credential (as produced by
+// selectPassword) is blank, whether it arrived as an empty plaintext/hashed value or
+// as a bcrypt hash of the empty string.
+func isPasswordEmpty(password []byte) bool {
+	if len(password) == 0 {
+		return true
+	}
+	return bcrypt.CompareHashAndPassword(password, []byte("")) == nil
+}
