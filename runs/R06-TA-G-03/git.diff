diff --git a/server/auth/store_test.go b/server/auth/store_test.go
index fae3716..e5ff659 100644
--- a/server/auth/store_test.go
+++ b/server/auth/store_test.go
@@ -1177,3 +1177,37 @@ func TestUserChangePasswordWithOldLog(t *testing.T) {
 	require.Errorf(t, err, "expected %v, got %v", ErrUserNotFound, err)
 	require.ErrorIsf(t, err, ErrUserNotFound, "expected %v, got %v", ErrUserNotFound, err)
 }
+
+func TestUserAddWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// blank plaintext password, no HashedPassword given (old-log/legacy path)
+	_, err := as.UserAdd(&pb.AuthUserAddRequest{Name: "empty-pass-1", Options: &authpb.UserAddOptions{NoPassword: false}})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// hashed password of an empty string, as produced by the API layer for a blank password
+	_, err = as.UserAdd(&pb.AuthUserAddRequest{Name: "empty-pass-2", HashedPassword: encodePassword(""), Options: &authpb.UserAddOptions{NoPassword: false}})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a passwordless account must still be created without a password
+	_, err = as.UserAdd(&pb.AuthUserAddRequest{Name: "empty-pass-3", Options: &authpb.UserAddOptions{NoPassword: true}})
+	require.NoError(t, err)
+}
+
+func TestUserChangePasswordToEmpty(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	_, err := as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo"})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo", HashedPassword: encodePassword("")})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a passwordless account is unaffected by the empty-password check
+	_, err = as.UserAdd(&pb.AuthUserAddRequest{Name: "nopass", Options: &authpb.UserAddOptions{NoPassword: true}})
+	require.NoError(t, err)
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "nopass"})
+	require.NoError(t, err)
+}
