--- a/server/auth/store_test.go
+++ b/server/auth/store_test.go
@@ -1140,6 +1140,38 @@ func TestUserNoPasswordAdd(t *testing.T) {
 	require.ErrorIsf(t, err, ErrAuthFailed, "expected %v, got %v", ErrAuthFailed, err)
 }
 
+func TestUserAddWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	ua := &pb.AuthUserAddRequest{Name: "userwithemptypass", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	ua = &pb.AuthUserAddRequest{Name: "userwithemptypass", HashedPassword: encodePassword(""), Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err = as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+}
+
+func TestUserChangePasswordWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	_, err := as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo"})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo", HashedPassword: encodePassword("")})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a no-password account is unaffected by the empty password check
+	ua := &pb.AuthUserAddRequest{Name: "usernopass", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	require.NoError(t, err)
+
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "usernopass"})
+	require.NoError(t, err)
+}
