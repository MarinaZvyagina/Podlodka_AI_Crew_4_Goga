+// isEmptyPassword reports whether the given password hash represents a
+// blank password, either because no hash was produced at all, or because
+// the hash is a valid bcrypt hash of the empty string.
+func isEmptyPassword(hashedPassword []byte) bool {
+	if len(hashedPassword) == 0 {
+		return true
+	}
+	return bcrypt.CompareHashAndPassword(hashedPassword, []byte("")) == nil
+}
