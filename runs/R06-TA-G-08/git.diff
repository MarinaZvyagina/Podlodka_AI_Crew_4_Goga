+// TestV3AuthEmptyPasswordRejected ensures that creating a user, or changing a user's
+// password, with a blank password is rejected unless the account is explicitly
+// marked as a no-password account.
+func TestV3AuthEmptyPasswordRejected(t *testing.T) {
+	integration.BeforeTest(t)
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	api := integration.ToGRPC(clus.Client(0))
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+
+	_, err := api.Auth.UserAdd(ctx, &pb.AuthUserAddRequest{Name: "blank", Options: &authpb.UserAddOptions{NoPassword: false}})
+	require.ErrorIs(t, err, rpctypes.ErrGRPCPasswordEmpty)
+
+	_, err = api.Auth.UserAdd(ctx, &pb.AuthUserAddRequest{Name: "nopass", Options: &authpb.UserAddOptions{NoPassword: true}})
+	require.NoError(t, err)
+
+	_, err = api.Auth.UserAdd(ctx, &pb.AuthUserAddRequest{Name: "haspass", Password: "123", Options: &authpb.UserAddOptions{NoPassword: false}})
+	require.NoError(t, err)
+
+	_, err = api.Auth.UserChangePassword(ctx, &pb.AuthUserChangePasswordRequest{Name: "haspass"})
+	require.ErrorIs(t, err, rpctypes.ErrGRPCPasswordEmpty)
+
+	_, err = api.Auth.UserChangePassword(ctx, &pb.AuthUserChangePasswordRequest{Name: "nopass"})
+	require.NoError(t, err)
+}
