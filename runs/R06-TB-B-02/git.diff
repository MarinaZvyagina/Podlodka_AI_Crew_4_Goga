+func TestPutMaxLeaseKeys(t *testing.T) {
+	lg := zaptest.NewLogger(t)
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { betesting.Close(t, b) })
+
+	lessor := lease.NewLessor(lg, b, nil, lease.LessorConfig{MaxLeaseKeys: 2})
+	t.Cleanup(lessor.Stop)
+	s := mvcc.NewStore(lg, b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() { s.Close() })
+
+	_, err := lessor.Grant(1, 100)
+	require.NoError(t, err)
+
+	ctx := t.Context()
+
+	// First two new keys fit within the limit.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("a"), Lease: 1})
+	require.NoError(t, err)
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("b"), Lease: 1})
+	require.NoError(t, err)
+
+	// A third distinct key would exceed the limit and must be rejected cleanly.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("c"), Lease: 1})
+	require.ErrorIs(t, err, lease.ErrTooManyKeysForLease)
+
+	// Re-attaching a key already on the lease must not be rejected.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("a"), Lease: 1})
+	require.NoError(t, err)
+
+	// A write without a lease is unaffected by the limit.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("d")})
+	require.NoError(t, err)
+
+	require.ElementsMatch(t, []string{"a", "b"}, lessor.Lookup(1).Keys())
+}
+
+func TestTxnMaxLeaseKeysRejectsWholeTxn(t *testing.T) {
+	lg := zaptest.NewLogger(t)
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { betesting.Close(t, b) })
+
+	lessor := lease.NewLessor(lg, b, nil, lease.LessorConfig{MaxLeaseKeys: 2})
+	t.Cleanup(lessor.Stop)
+	s := mvcc.NewStore(lg, b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() { s.Close() })
+
+	_, err := lessor.Grant(1, 100)
+	require.NoError(t, err)
+	_, _, err = Put(t.Context(), lg, lessor, s, &pb.PutRequest{Key: []byte("a"), Lease: 1})
+	require.NoError(t, err)
+
+	// The lease already has 1 key attached; a Txn that would attach 2 more
+	// new keys (total 3) exceeds the limit of 2 and must fail atomically.
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("b"), Lease: 1}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("c"), Lease: 1}}},
+		},
+	}
+	_, _, err = Txn(t.Context(), lg, txn, false, s, lessor, false)
+	require.ErrorIs(t, err, lease.ErrTooManyKeysForLease)
+
+	// Neither key from the rejected txn should have been applied.
+	require.ElementsMatch(t, []string{"a"}, lessor.Lookup(1).Keys())
+	rr, err := s.Range(t.Context(), []byte("b"), nil, mvcc.RangeOptions{})
+	require.NoError(t, err)
+	require.Empty(t, rr.KVs)
+}
