+// TestLessorCheckAttachableMaxLeaseKeys verifies that CheckAttachable, the
+// pre-flight check the write path uses before attaching a key to a lease,
+// rejects attaching new keys once a lease is at the configured maximum
+// number of keys, while never rejecting a check for zero new keys (i.e. a
+// write that only re-attaches keys already on the lease).
+func TestLessorCheckAttachableMaxLeaseKeys(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	const maxKeys = 3
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL, MaxLeaseKeys: maxKeys})
+	defer le.Stop()
+
+	l, err := le.Grant(1, 60)
+	if err != nil {
+		t.Fatalf("could not grant lease 1 (%v)", err)
+	}
+
+	items := make([]LeaseItem, maxKeys)
+	for i := 0; i < maxKeys; i++ {
+		items[i] = LeaseItem{Key: fmt.Sprintf("foo%d", i)}
+	}
+	if err = le.Attach(l.ID, items); err != nil {
+		t.Fatalf("failed to attach items up to the limit: %v", err)
+	}
+
+	// Checking zero new keys (e.g. a write that only re-attaches keys
+	// already on the lease) must never be rejected, even though the lease
+	// is already at the limit.
+	if err = le.CheckAttachable(l.ID, 0); err != nil {
+		t.Fatalf("CheckAttachable with newKeyCount=0 unexpectedly failed: %v", err)
+	}
+
+	// Checking one more, distinct, key must be rejected.
+	if err = le.CheckAttachable(l.ID, 1); !errors.Is(err, ErrTooManyLeaseKeys) {
+		t.Fatalf("expected ErrTooManyLeaseKeys from CheckAttachable, got %v", err)
+	}
+
+	if le.Lookup(l.ID).Len() != maxKeys {
+		t.Fatalf("expected lease to have %d keys, got %d", maxKeys, le.Lookup(l.ID).Len())
+	}
+
+	if err := le.CheckAttachable(LeaseID(999), 1); !errors.Is(err, ErrLeaseNotFound) {
+		t.Fatalf("expected ErrLeaseNotFound for unknown lease, got %v", err)
+	}
+}
+
+// TestLessorCheckAttachableGrandfatheredLease verifies that a lease that
+// already exceeds the configured maximum (e.g. because the limit was
+// lowered, or the lease predates the limit being enabled) is not broken:
+// checking zero new keys keeps succeeding, only genuinely new keys are
+// rejected.
+func TestLessorCheckAttachableGrandfatheredLease(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	// Attach more keys than the limit while unconfigured (no limit), then
+	// verify a subsequently-lowered limit doesn't break re-attachment.
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL})
+	defer le.Stop()
+
+	l, err := le.Grant(1, 60)
+	if err != nil {
+		t.Fatalf("could not grant lease 1 (%v)", err)
+	}
+
+	items := make([]LeaseItem, 5)
+	for i := range items {
+		items[i] = LeaseItem{Key: fmt.Sprintf("foo%d", i)}
+	}
+	if err = le.Attach(l.ID, items); err != nil {
+		t.Fatalf("failed to attach items: %v", err)
+	}
+
+	le.maxLeaseKeys = 3 // simulate a lowered limit on an already-over-limit lease
+
+	if err = le.CheckAttachable(l.ID, 0); err != nil {
+		t.Fatalf("CheckAttachable with newKeyCount=0 on an over-limit lease unexpectedly failed: %v", err)
+	}
+	if err = le.CheckAttachable(l.ID, 1); !errors.Is(err, ErrTooManyLeaseKeys) {
+		t.Fatalf("expected ErrTooManyLeaseKeys for a new key on an over-limit lease, got %v", err)
+	}
+}
