+// TestLessorMaxLeaseKeysConfig verifies that MaxLeaseKeys is threaded through
+// from LessorConfig, and that Attach itself never enforces the limit -
+// enforcement happens in the apply path so that already-persisted state
+// (e.g. loaded during recovery, or configured before the limit was lowered)
+// can always be reattached.
+func TestLessorMaxLeaseKeysConfig(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL, MaxLeaseKeys: 1})
+	defer le.Stop()
+
+	if got := le.MaxLeaseKeys(); got != 1 {
+		t.Fatalf("MaxLeaseKeys() = %d, want 1", got)
+	}
+
+	le.Promote(0)
+	if _, err := le.Grant(1, minLeaseTTL); err != nil {
+		t.Fatalf("could not grant lease 1: %v", err)
+	}
+
+	if err := le.Attach(1, []LeaseItem{{Key: "a"}, {Key: "b"}, {Key: "c"}}); err != nil {
+		t.Fatalf("Attach unexpectedly failed: %v", err)
+	}
+	if l := le.Lookup(1); l.Len() != 3 {
+		t.Fatalf("lease has %d keys, want 3", l.Len())
+	}
+}
