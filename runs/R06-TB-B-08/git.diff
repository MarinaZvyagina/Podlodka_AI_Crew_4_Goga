+func TestPutMaxLeaseKeys(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { betesting.Close(t, b) })
+	lessor := &lease.FakeLessor{LeaseSet: map[lease.LeaseID]struct{}{}, MaxKeys: 2}
+	s := mvcc.NewStore(zaptest.NewLogger(t), b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() { s.Close() })
+
+	lessor.Grant(1, 0)
+	lessor.Grant(2, 0)
+	lg := zaptest.NewLogger(t)
+	ctx := t.Context()
+
+	putReq := func(key string, leaseID int64) *pb.PutRequest {
+		return &pb.PutRequest{Key: []byte(key), Value: []byte("v"), Lease: leaseID}
+	}
+
+	_, _, err := Put(ctx, lg, lessor, s, putReq("a", 1))
+	require.NoError(t, err)
+	_, _, err = Put(ctx, lg, lessor, s, putReq("b", 1))
+	require.NoError(t, err)
+
+	// a third distinct key on the same lease exceeds the configured limit
+	_, _, err = Put(ctx, lg, lessor, s, putReq("c", 1))
+	require.ErrorIs(t, err, lease.ErrTooManyLeaseKeys)
+
+	// re-attaching a key already on the lease is always allowed, since it
+	// does not grow the number of distinct keys
+	_, _, err = Put(ctx, lg, lessor, s, putReq("a", 1))
+	require.NoError(t, err)
+
+	// the server stays healthy: unrelated writes keep working after the
+	// rejection, including a write to a different, under-the-limit lease
+	_, _, err = Put(ctx, lg, lessor, s, putReq("other", 2))
+	require.NoError(t, err)
+}
+
+func TestTxnMaxLeaseKeysIsAtomic(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { betesting.Close(t, b) })
+	lessor := &lease.FakeLessor{LeaseSet: map[lease.LeaseID]struct{}{}, MaxKeys: 2}
+	s := mvcc.NewStore(zaptest.NewLogger(t), b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() { s.Close() })
+	lessor.Grant(1, 0)
+
+	lg := zaptest.NewLogger(t)
+	ctx := t.Context()
+
+	putOp := func(key string) *pb.RequestOp {
+		return &pb.RequestOp{Request: &pb.RequestOp_RequestPut{
+			RequestPut: &pb.PutRequest{Key: []byte(key), Value: []byte("v"), Lease: 1},
+		}}
+	}
+
+	// a single Txn attaching 3 new keys to a lease capped at 2 must be
+	// rejected wholesale: checking each Put individually against the
+	// lessor's pre-txn state would miss that they collectively overflow.
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{putOp("x"), putOp("y"), putOp("z")},
+	}
+	_, _, err := Txn(ctx, lg, txn, false, s, lessor, false)
+	require.ErrorIs(t, err, lease.ErrTooManyLeaseKeys)
+
+	// none of the keys from the rejected txn were applied
+	rangeResp, _, err := Range(ctx, lg, s, &pb.RangeRequest{Key: []byte("x"), RangeEnd: []byte("z\x00")}, true)
+	require.NoError(t, err)
+	require.Empty(t, rangeResp.Kvs)
