+// CheckLeaseKeyLimit checks whether attaching item to the lease with the
+// given id would exceed the configured maximum number of keys per lease.
+func (le *lessor) CheckLeaseKeyLimit(id LeaseID, item LeaseItem) error {
+	le.mu.RLock()
+	defer le.mu.RUnlock()
+
+	l := le.leaseMap[id]
+	if l == nil {
+		return ErrLeaseNotFound
+	}
+
+	if le.maxLeaseKeys <= 0 {
+		return nil
+	}
+
+	// re-attaching an item already on this lease never increases its key
+	// count, so it should never be rejected.
+	if owner, ok := le.itemMap[item]; ok && owner == id {
+		return nil
+	}
+
+	if l.Len() >= le.maxLeaseKeys {
+		return ErrTooManyKeysInLease
+	}
+	return nil
+}
