+// TestLessorCheckLeaseKeyLimit ensures that CheckLeaseKeyLimit rejects a new
+// key once a lease has reached the configured maximum, while continuing to
+// allow re-attaching a key that is already on the lease.
+func TestLessorCheckLeaseKeyLimit(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL, MaxLeaseKeys: 2})
+	defer le.Stop()
+
+	l, err := le.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("could not grant lease (%v)", err)
+	}
+
+	if err := le.CheckLeaseKeyLimit(2, LeaseItem{"foo"}); !errors.Is(err, ErrLeaseNotFound) {
+		t.Fatalf("expected ErrLeaseNotFound for unknown lease, got %v", err)
+	}
+
+	if err := le.CheckLeaseKeyLimit(l.ID, LeaseItem{"foo"}); err != nil {
+		t.Fatalf("expected first key to be allowed, got %v", err)
+	}
+	if err := le.Attach(l.ID, []LeaseItem{{"foo"}}); err != nil {
+		t.Fatalf("failed to attach item: %v", err)
+	}
+
+	// re-attaching the same key should never be rejected, even though the
+	// lease is already at MaxLeaseKeys.
+	if err := le.CheckLeaseKeyLimit(l.ID, LeaseItem{"foo"}); err != nil {
+		t.Fatalf("expected re-attaching an existing key to be allowed, got %v", err)
+	}
+
+	if err := le.CheckLeaseKeyLimit(l.ID, LeaseItem{"bar"}); err != nil {
+		t.Fatalf("expected second key to be allowed, got %v", err)
+	}
+	if err := le.Attach(l.ID, []LeaseItem{{"bar"}}); err != nil {
+		t.Fatalf("failed to attach item: %v", err)
+	}
+
+	// the lease is now at the limit; a brand new key must be rejected.
+	if err := le.CheckLeaseKeyLimit(l.ID, LeaseItem{"baz"}); !errors.Is(err, ErrTooManyKeysInLease) {
+		t.Fatalf("expected ErrTooManyKeysInLease for new key at limit, got %v", err)
+	}
+
+	// keys already on the lease remain unaffected.
+	if err := le.CheckLeaseKeyLimit(l.ID, LeaseItem{"foo"}); err != nil {
+		t.Fatalf("expected re-attaching an existing key to be allowed at limit, got %v", err)
+	}
+}
