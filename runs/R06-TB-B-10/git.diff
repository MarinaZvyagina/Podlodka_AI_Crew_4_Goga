+func TestLeaseMaxAttachedKeys(t *testing.T) {
+	integration.BeforeTest(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1, MaxLeaseKeys: 2})
+	defer clus.Terminate(t)
+
+	kv := clus.RandClient()
+
+	resp, err := kv.Grant(t.Context(), 100)
+	require.NoErrorf(t, err, "failed to create lease %v", err)
+	leaseID := resp.ID
+
+	_, err = kv.Put(t.Context(), "key1", "v1", clientv3.WithLease(leaseID))
+	require.NoErrorf(t, err, "failed to attach first key %v", err)
+
+	_, err = kv.Put(t.Context(), "key2", "v2", clientv3.WithLease(leaseID))
+	require.NoErrorf(t, err, "failed to attach second key %v", err)
+
+	// re-attaching an already-attached key must keep working, even though
+	// the lease is at the configured limit.
+	_, err = kv.Put(t.Context(), "key1", "v1-updated", clientv3.WithLease(leaseID))
+	require.NoErrorf(t, err, "failed to re-attach existing key %v", err)
+
+	// a new, distinct key must be rejected with a clean client-facing error.
+	_, err = kv.Put(t.Context(), "key3", "v3", clientv3.WithLease(leaseID))
+	require.ErrorIsf(t, err, rpctypes.ErrTooManyKeysInLease, "err = %v, want %v", err, rpctypes.ErrTooManyKeysInLease)
+
+	// the rejected key must not have been partially applied.
+	getResp, err := kv.Get(t.Context(), "key3")
+	require.NoError(t, err)
+	require.Zerof(t, getResp.Count, "key3 should not exist after rejected put")
+
+	// the server must remain healthy and continue serving unrelated writes.
+	_, err = kv.Put(t.Context(), "unrelated-key", "v", clientv3.WithLease(clientv3.NoLease))
+	require.NoErrorf(t, err, "server should still serve requests after rejection, got %v", err)
+}
