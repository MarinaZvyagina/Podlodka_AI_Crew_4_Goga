+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package apply
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/etcdserver/api/membership"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+	"go.etcd.io/etcd/server/v3/storage/schema"
+)
+
+// newBackendApplierWithMaxLeaseKeys wires up a real Lessor and mvcc.KV (not fakes), so that
+// key attachment counts are tracked for real, and returns the applierV3backend under test
+// together with the Lessor so tests can grant leases and inspect their attached keys.
+func newBackendApplierWithMaxLeaseKeys(t *testing.T, maxLeaseKeys int) (applierV3, lease.Lessor) {
+	lg := zaptest.NewLogger(t)
+	be, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() {
+		betesting.Close(t, be)
+	})
+
+	cluster := membership.NewCluster(lg)
+	cluster.SetBackend(schema.NewMembershipBackend(lg, be))
+	cluster.AddMember(&membership.Member{ID: memberID}, true)
+	lessor := lease.NewLessor(lg, be, cluster, lease.LessorConfig{MaxLeaseKeys: maxLeaseKeys})
+	kv := mvcc.NewStore(lg, be, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() {
+		kv.Close()
+	})
+
+	return newApplierV3Backend(ApplierOptions{Logger: lg, KV: kv, Lessor: lessor}), lessor
+}
+
+func TestApplierV3BackendPutRejectsExceedingLeaseKeyLimit(t *testing.T) {
+	a, lessor := newBackendApplierWithMaxLeaseKeys(t, 2)
+
+	_, err := lessor.Grant(1, 100)
+	require.NoError(t, err)
+
+	_, _, err = a.Put(&pb.PutRequest{Key: []byte("a"), Lease: 1})
+	require.NoError(t, err)
+
+	_, _, err = a.Put(&pb.PutRequest{Key: []byte("b"), Lease: 1})
+	require.NoError(t, err)
+
+	// A third distinct key would push the lease past its configured limit of 2.
+	_, _, err = a.Put(&pb.PutRequest{Key: []byte("c"), Lease: 1})
+	require.ErrorIs(t, err, lease.ErrTooManyKeys)
+
+	// Re-attaching a key that is already on the lease must still succeed, since it does not
+	// increase the distinct key count.
+	_, _, err = a.Put(&pb.PutRequest{Key: []byte("a"), Lease: 1, Value: []byte("updated")})
+	require.NoError(t, err)
+
+	assert.ElementsMatch(t, []string{"a", "b"}, lessor.Lookup(1).Keys())
+
+	// The server keeps serving unrelated requests after the rejection: no crash, no
+	// corrupted state.
+	_, _, err = a.Put(&pb.PutRequest{Key: []byte("unrelated")})
+	require.NoError(t, err)
+}
+
+func TestApplierV3BackendTxnRejectsExceedingLeaseKeyLimitAtomically(t *testing.T) {
+	a, lessor := newBackendApplierWithMaxLeaseKeys(t, 1)
+
+	_, err := lessor.Grant(1, 100)
+	require.NoError(t, err)
+
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a"), Lease: 1}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("b"), Lease: 1}}},
+		},
+	}
+
+	// The two puts would together attach 2 distinct keys to a lease limited to 1, even
+	// though neither put alone would exceed it.
+	_, _, err = a.Txn(txn, false)
+	require.ErrorIs(t, err, lease.ErrTooManyKeys)
+
+	// Neither put must have been applied: the transaction is all-or-nothing.
+	assert.Empty(t, lessor.Lookup(1).Keys())
+}
+
+func TestApplierV3BackendPutRejectsMovingKeyToLeaseAtLimit(t *testing.T) {
+	a, lessor := newBackendApplierWithMaxLeaseKeys(t, 1)
+
+	_, err := lessor.Grant(1, 100)
+	require.NoError(t, err)
+	_, err = lessor.Grant(2, 100)
+	require.NoError(t, err)
+
+	_, _, err = a.Put(&pb.PutRequest{Key: []byte("a"), Lease: 1})
+	require.NoError(t, err)
+	_, _, err = a.Put(&pb.PutRequest{Key: []byte("b"), Lease: 2})
+	require.NoError(t, err)
+
+	// Re-leasing an existing key to a different, already-full lease is still a new
+	// attachment for the target lease and must be rejected.
+	_, _, err = a.Put(&pb.PutRequest{Key: []byte("b"), Lease: 1})
+	require.ErrorIs(t, err, lease.ErrTooManyKeys)
+
+	// Neither lease's keys changed as a result of the rejected request.
+	assert.ElementsMatch(t, []string{"a"}, lessor.Lookup(1).Keys())
+	assert.ElementsMatch(t, []string{"b"}, lessor.Lookup(2).Keys())
+}
+
+func TestApplierV3BackendPutAllowsLeaseUnderLimit(t *testing.T) {
+	a, lessor := newBackendApplierWithMaxLeaseKeys(t, 100000)
+
+	_, err := lessor.Grant(1, 100)
+	require.NoError(t, err)
+
+	_, _, err = a.Put(&pb.PutRequest{Key: []byte("a"), Lease: 1})
+	require.NoError(t, err)
+
+	assert.ElementsMatch(t, []string{"a"}, lessor.Lookup(1).Keys())
+}
