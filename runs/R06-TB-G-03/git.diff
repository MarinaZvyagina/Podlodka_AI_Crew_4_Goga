 func checkLease(lessor lease.Lessor, p *pb.PutRequest) error {
+	return checkLeaseAttach(lessor, p, nil)
+}
+
+// checkLeaseAttach validates that p's lease exists and, if p would attach a new key to that
+// lease (one it does not already hold), that doing so would not exceed the lessor's configured
+// maximum number of keys per lease. Re-attaching a key the lease already holds is always allowed.
+//
+// pending tracks how many new keys earlier requests checked in the same pass (e.g. other ops in
+// the same Txn) have already reserved for a given lease, so a batch of new-key puts to the same
+// lease is accounted for cumulatively rather than each being checked in isolation. It may be nil
+// when checking a single, standalone request.
+func checkLeaseAttach(lessor lease.Lessor, p *pb.PutRequest, pending map[lease.LeaseID]int) error {
 	leaseID := lease.LeaseID(p.Lease)
-	if leaseID != lease.NoLease {
-		if l := lessor.Lookup(leaseID); l == nil {
-			return lease.ErrLeaseNotFound
-		}
+	if leaseID == lease.NoLease {
+		return nil
+	}
+	l := lessor.Lookup(leaseID)
+	if l == nil {
+		return lease.ErrLeaseNotFound
+	}
+	if l.Contains(lease.LeaseItem{Key: string(p.Key)}) {
+		return nil
+	}
+	if l.Len()+pending[leaseID] >= lessor.MaxLeaseKeys() {
+		return lease.ErrTooManyKeys
+	}
+	if pending != nil {
+		pending[leaseID]++
 	}
 	return nil
 }
