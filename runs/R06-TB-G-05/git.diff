+func (le *lessor) TooManyKeys(id LeaseID, item LeaseItem) bool {
+	if le.maxLeaseKeys <= 0 {
+		return false
+	}
+
+	le.mu.RLock()
+	l := le.leaseMap[id]
+	if l == nil {
+		le.mu.RUnlock()
+		return false
+	}
+	alreadyAttached := le.itemMap[item] == id
+	le.mu.RUnlock()
+
+	if alreadyAttached {
+		return false
+	}
+	return l.ItemCount() >= le.maxLeaseKeys
