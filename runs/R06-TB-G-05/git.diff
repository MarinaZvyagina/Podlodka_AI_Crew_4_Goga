+// TestLessorTooManyKeys ensures that once a lease has reached the
+// configured maximum number of keys, attaching another new key is
+// rejected, while re-attaching an already-attached key keeps working.
+func TestLessorTooManyKeys(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL, MaxLeaseKeys: 2})
+	defer le.Stop()
+
+	l, err := le.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("could not grant lease (%v)", err)
+	}
+
+	if got := le.TooManyKeys(l.ID, LeaseItem{"foo"}); got {
+		t.Fatalf("TooManyKeys() = %v, want false before any keys are attached", got)
+	}
+	if err := le.Attach(l.ID, []LeaseItem{{"foo"}}); err != nil {
+		t.Fatalf("failed to attach item to the lease: %v", err)
+	}
+
+	if got := le.TooManyKeys(l.ID, LeaseItem{"foo"}); got {
+		t.Fatalf("TooManyKeys() = %v, want false for a key already attached to the lease", got)
+	}
+	// re-attaching an existing key must never be rejected, even after the
+	// lease reaches the configured limit.
+	if err := le.Attach(l.ID, []LeaseItem{{"foo"}}); err != nil {
+		t.Fatalf("failed to re-attach existing item to the lease: %v", err)
+	}
+
+	if got := le.TooManyKeys(l.ID, LeaseItem{"bar"}); got {
+		t.Fatalf("TooManyKeys() = %v, want false while under the limit", got)
+	}
+	if err := le.Attach(l.ID, []LeaseItem{{"bar"}}); err != nil {
+		t.Fatalf("failed to attach item to the lease: %v", err)
+	}
+
+	// the lease now has 2 keys attached, which is the configured max.
+	if got := le.TooManyKeys(l.ID, LeaseItem{"baz"}); !got {
+		t.Fatalf("TooManyKeys() = %v, want true once the lease is at its key limit", got)
+	}
+	// re-attaching an already-attached key must still be allowed.
+	if got := le.TooManyKeys(l.ID, LeaseItem{"bar"}); got {
+		t.Fatalf("TooManyKeys() = %v, want false for re-attaching an existing key at the limit", got)
+	}
+	if err := le.Attach(l.ID, []LeaseItem{{"bar"}}); err != nil {
+		t.Fatalf("failed to re-attach existing item at the limit: %v", err)
+	}
+
+	if got := le.TooManyKeys(l.ID, LeaseItem{"foo"}); got {
+		t.Fatalf("TooManyKeys() = %v, want false for re-attaching an existing key at the limit", got)
+	}
+
+	// a lease with no configured limit is never too many.
+	le2 := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL})
+	defer le2.Stop()
+	l2, err := le2.Grant(2, 100)
+	if err != nil {
+		t.Fatalf("could not grant lease (%v)", err)
+	}
+	if got := le2.TooManyKeys(l2.ID, LeaseItem{"foo"}); got {
+		t.Fatalf("TooManyKeys() = %v, want false when no limit is configured", got)
+	}
+
+	// an unknown lease is never too many; that's ErrLeaseNotFound's job.
+	if got := le.TooManyKeys(999, LeaseItem{"foo"}); got {
+		t.Fatalf("TooManyKeys() = %v, want false for an unknown lease id", got)
+	}
+}
