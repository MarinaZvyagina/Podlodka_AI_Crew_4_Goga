+// TestPutRejectsExceedingLeaseMaxKeys ensures a Put that would attach a new
+// key past the lessor's configured max-keys-per-lease limit is rejected
+// with a clean error, while a Put that re-attaches a key already on the
+// lease (not increasing its distinct key count) keeps succeeding.
+func TestPutRejectsExceedingLeaseMaxKeys(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() {
+		betesting.Close(t, b)
+	})
+	lessor := lease.NewLessor(zaptest.NewLogger(t), b, clusterLatestStub{}, lease.LessorConfig{MaxLeaseKeys: 1})
+	t.Cleanup(lessor.Stop)
+	s := mvcc.NewStore(zaptest.NewLogger(t), b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() {
+		s.Close()
+	})
+
+	l, err := lessor.Grant(lease.LeaseID(1), 100)
+	require.NoError(t, err)
+
+	ctx := t.Context()
+
+	// first key attaches fine, reaching the configured limit of 1.
+	_, _, err = Put(ctx, zaptest.NewLogger(t), lessor, s, &pb.PutRequest{Key: []byte("foo"), Lease: int64(l.ID)})
+	require.NoError(t, err)
+
+	// a second, distinct key would exceed the limit and must be rejected.
+	_, _, err = Put(ctx, zaptest.NewLogger(t), lessor, s, &pb.PutRequest{Key: []byte("bar"), Lease: int64(l.ID)})
+	require.ErrorIs(t, err, lease.ErrTooManyLeaseKeys)
+
+	// re-attaching (overwriting) the already-attached key must keep working.
+	_, _, err = Put(ctx, zaptest.NewLogger(t), lessor, s, &pb.PutRequest{Key: []byte("foo"), Lease: int64(l.ID)})
+	require.NoError(t, err)
+
+	// the server must remain healthy: further, unrelated writes still work.
+	_, _, err = Put(ctx, zaptest.NewLogger(t), lessor, s, &pb.PutRequest{Key: []byte("baz")})
+	require.NoError(t, err)
+
+	if got := l.ItemCount(); got != 1 {
+		t.Fatalf("lease key count = %d, want 1 (rejected put must not have partially applied)", got)
+	}
+}
