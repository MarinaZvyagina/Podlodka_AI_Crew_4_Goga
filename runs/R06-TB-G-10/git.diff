+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package txn
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/Masterminds/semver/v3"
+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+// setupWithMaxLeaseKeys is like setup() but constructs a real lessor
+// (instead of lease.FakeLessor) with the given MaxLeaseKeys limit, since the
+// limit is only meaningful when the lessor tracks real attachment state.
+func setupWithMaxLeaseKeys(t *testing.T, maxLeaseKeys uint) (mvcc.KV, lease.Lessor) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() {
+		betesting.Close(t, b)
+	})
+	lg := zaptest.NewLogger(t)
+	lessor := lease.NewLessor(lg, b, fakeCluster{}, lease.LessorConfig{MaxLeaseKeys: maxLeaseKeys})
+	t.Cleanup(lessor.Stop)
+	s := mvcc.NewStore(lg, b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() {
+		s.Close()
+	})
+	return s, lessor
+}
+
+type fakeCluster struct{}
+
+func (fakeCluster) Version() *semver.Version { return nil }
+
+func TestPutRejectsNewKeyOverMaxLeaseKeys(t *testing.T) {
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+	s, lessor := setupWithMaxLeaseKeys(t, 2)
+
+	if _, err := lessor.Grant(1, 100); err != nil {
+		t.Fatalf("unexpected error granting lease: %v", err)
+	}
+
+	if _, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("a"), Lease: 1}); err != nil {
+		t.Fatalf("unexpected error on first put: %v", err)
+	}
+	if _, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("b"), Lease: 1}); err != nil {
+		t.Fatalf("unexpected error on second put: %v", err)
+	}
+
+	// The lease is now at its limit of 2 keys. A third, distinct key must
+	// be rejected with a clean, client-facing error.
+	_, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("c"), Lease: 1})
+	if !errors.Is(err, lease.ErrTooManyKeys) {
+		t.Fatalf("expected ErrTooManyKeys, got %v", err)
+	}
+
+	// Re-attaching a key that is already on the lease must not be rejected.
+	if _, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("a"), Lease: 1}); err != nil {
+		t.Fatalf("re-put of already-attached key unexpectedly failed: %v", err)
+	}
+
+	// The server must remain healthy and keep serving other requests, e.g.
+	// puts without a lease, or puts to a lease under its limit.
+	if _, err := lessor.Grant(2, 100); err != nil {
+		t.Fatalf("unexpected error granting second lease: %v", err)
+	}
+	if _, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("d"), Lease: 2}); err != nil {
+		t.Fatalf("unexpected error putting to a lease under its limit: %v", err)
+	}
+	if _, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("e")}); err != nil {
+		t.Fatalf("unexpected error putting without a lease: %v", err)
+	}
+}
+
+func TestTxnRejectsWhenCombinedNewKeysExceedMaxLeaseKeys(t *testing.T) {
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+	s, lessor := setupWithMaxLeaseKeys(t, 2)
+
+	if _, err := lessor.Grant(1, 100); err != nil {
+		t.Fatalf("unexpected error granting lease: %v", err)
+	}
+	if _, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("a"), Lease: 1}); err != nil {
+		t.Fatalf("unexpected error on setup put: %v", err)
+	}
+
+	// The lease has 1 key attached and a limit of 2. A single-op put of one
+	// more new key would be fine, but this Txn attaches two new distinct
+	// keys to the same lease in one request, which must be rejected as a
+	// whole -- none of the operations may be applied.
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("b"), Lease: 1}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("c"), Lease: 1}}},
+		},
+	}
+	_, _, err := Txn(ctx, lg, txn, false, s, lessor, false)
+	if !errors.Is(err, lease.ErrTooManyKeys) {
+		t.Fatalf("expected ErrTooManyKeys, got %v", err)
+	}
+
+	for _, key := range [][]byte{[]byte("b"), []byte("c")} {
+		tr := s.Read(mvcc.ConcurrentReadTxMode, traceutil.TODO())
+		rr, err := tr.Range(ctx, key, nil, mvcc.RangeOptions{})
+		tr.End()
+		if err != nil {
+			t.Fatalf("unexpected error reading key %q: %v", key, err)
+		}
+		if len(rr.KVs) != 0 {
+			t.Fatalf("key %q was written despite the rejected txn", key)
+		}
+	}
+}
+
+func TestTxnAllowsCombinedNewKeysWithinMaxLeaseKeys(t *testing.T) {
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+	s, lessor := setupWithMaxLeaseKeys(t, 2)
+
+	if _, err := lessor.Grant(1, 100); err != nil {
+		t.Fatalf("unexpected error granting lease: %v", err)
+	}
+
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a"), Lease: 1}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("b"), Lease: 1}}},
+		},
+	}
+	if _, _, err := Txn(ctx, lg, txn, false, s, lessor, false); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
