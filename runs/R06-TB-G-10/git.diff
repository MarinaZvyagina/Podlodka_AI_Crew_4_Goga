-func checkLease(lessor lease.Lessor, p *pb.PutRequest) error {
+// pendingLeaseAttachments tracks, for the requests checked so far within a
+// single Put or Txn call, which distinct keys are projected to be newly
+// attached to each lease. A multi-op Txn can attach several new keys to the
+// same lease in one request; each of those attachments must be counted
+// together against that lease's key limit before any of the request's
+// writes are applied, since the writes themselves are not allowed to fail
+// or apply partially (see etcdserver/txn.txn).
+type pendingLeaseAttachments map[lease.LeaseID]map[string]struct{}
+
+func checkLease(lessor lease.Lessor, p *pb.PutRequest, pending pendingLeaseAttachments) error {
 	leaseID := lease.LeaseID(p.Lease)
-	if leaseID != lease.NoLease {
-		if l := lessor.Lookup(leaseID); l == nil {
-			return lease.ErrLeaseNotFound
-		}
+	if leaseID == lease.NoLease {
+		return nil
+	}
+	l := lessor.Lookup(leaseID)
+	if l == nil {
+		return lease.ErrLeaseNotFound
+	}
+	maxKeys := lessor.MaxLeaseKeys()
+	if maxKeys == 0 {
+		return nil
+	}
+	if lessor.GetLease(lease.LeaseItem{Key: string(p.Key)}) == leaseID {
+		// the key is already attached to this lease; re-attaching it does
+		// not increase the lease's key count.
+		return nil
+	}
+	newKeys := pending[leaseID]
+	if newKeys == nil {
+		newKeys = make(map[string]struct{})
+		pending[leaseID] = newKeys
+	}
+	newKeys[string(p.Key)] = struct{}{}
+	if uint(len(l.Keys())+len(newKeys)) > maxKeys {
+		return lease.ErrTooManyKeys
 	}
 	return nil
 }
