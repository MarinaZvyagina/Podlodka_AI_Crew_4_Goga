+package v3rpc
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+	"go.uber.org/zap/zaptest/observer"
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+)
+
+type fakeAuditLogSource struct {
+	lg       *zap.Logger
+	authInfo *auth.AuthInfo
+	authErr  error
+}
+
+func (f *fakeAuditLogSource) Logger() *zap.Logger { return f.lg }
+
+func (f *fakeAuditLogSource) AuthInfoFromCtx(context.Context) (*auth.AuthInfo, error) {
+	return f.authInfo, f.authErr
+}
+
+func newObservedAuditSource(authInfo *auth.AuthInfo) (*fakeAuditLogSource, *observer.ObservedLogs) {
+	core, logs := observer.New(zap.InfoLevel)
+	return &fakeAuditLogSource{lg: zap.New(core), authInfo: authInfo}, logs
+}
+
+func TestAuditUnaryInterceptorCoversKVMethods(t *testing.T) {
+	tests := []struct {
+		method    string
+		req       any
+		wantOp    string
+		wantAudit bool
+	}{
+		{"/etcdserverpb.KV/Range", &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}, "read", true},
+		{"/etcdserverpb.KV/Put", &pb.PutRequest{Key: []byte("a")}, "write", true},
+		{"/etcdserverpb.KV/DeleteRange", &pb.DeleteRangeRequest{Key: []byte("a")}, "delete", true},
+		{"/etcdserverpb.KV/Txn", &pb.TxnRequest{}, "transaction", true},
+		// A hypothetical new KV method should still be audited, just under
+		// its raw method name, rather than silently skipped.
+		{"/etcdserverpb.KV/Watch", &pb.WatchRequest{}, "Watch", true},
+		// Compact is an administrative op, not a KV read/write/delete.
+		{"/etcdserverpb.KV/Compact", &pb.CompactionRequest{}, "", false},
+		// Non-KV services must not be touched by this interceptor.
+		{"/etcdserverpb.Lease/LeaseGrant", &pb.LeaseGrantRequest{}, "", false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.method, func(t *testing.T) {
+			src, logs := newObservedAuditSource(&auth.AuthInfo{Username: "alice"})
+			interceptor := newAuditUnaryInterceptor(src)
+
+			handlerCalled := false
+			_, err := interceptor(context.Background(), tt.req, &grpc.UnaryServerInfo{FullMethod: tt.method},
+				func(ctx context.Context, req any) (any, error) {
+					handlerCalled = true
+					return "response", nil
+				})
+			require.NoError(t, err)
+			assert.True(t, handlerCalled, "handler must always be invoked so functional behavior is unchanged")
+
+			if !tt.wantAudit {
+				assert.Equal(t, 0, logs.Len(), "expected no audit record")
+				return
+			}
+
+			require.Equal(t, 1, logs.Len(), "expected exactly one audit record")
+			entry := logs.All()[0]
+			assert.Equal(t, "kv audit", entry.Message)
+			fields := entry.ContextMap()
+			assert.Equal(t, "alice", fields["caller"])
+			assert.Equal(t, tt.wantOp, fields["operation"])
+			assert.Equal(t, "success", fields["outcome"])
+			assert.Contains(t, fields, "duration")
+		})
+	}
+}
+
+func TestAuditUnaryInterceptorUnauthenticated(t *testing.T) {
+	src, logs := newObservedAuditSource(nil)
+	interceptor := newAuditUnaryInterceptor(src)
+
+	_, err := interceptor(context.Background(), &pb.PutRequest{Key: []byte("k")}, &grpc.UnaryServerInfo{FullMethod: "/etcdserverpb.KV/Put"},
+		func(ctx context.Context, req any) (any, error) { return nil, nil })
+	require.NoError(t, err)
+
+	require.Equal(t, 1, logs.Len())
+	assert.Equal(t, "unauthenticated", logs.All()[0].ContextMap()["caller"])
+}
+
+func TestAuditUnaryInterceptorRecordsFailure(t *testing.T) {
+	src, logs := newObservedAuditSource(&auth.AuthInfo{Username: "alice"})
+	interceptor := newAuditUnaryInterceptor(src)
+
+	handlerErr := errors.New("boom")
+	_, err := interceptor(context.Background(), &pb.PutRequest{Key: []byte("k")}, &grpc.UnaryServerInfo{FullMethod: "/etcdserverpb.KV/Put"},
+		func(ctx context.Context, req any) (any, error) { return nil, handlerErr })
+	require.ErrorIs(t, err, handlerErr)
+
+	require.Equal(t, 1, logs.Len())
+	fields := logs.All()[0].ContextMap()
+	assert.Equal(t, "failure", fields["outcome"])
+	assert.Contains(t, fields, "error")
+}
+
+func TestAuditKeyFieldsForTxnCollectsAllKeys(t *testing.T) {
+	txn := &pb.TxnRequest{
+		Compare: []*pb.Compare{{Key: []byte("cmp")}},
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("put-key")}}},
+			{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("nested-del")}}},
+				},
+			}}},
+		},
+		Failure: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("range-key")}}},
+		},
+	}
+
+	keys := txnKeys(txn)
+	var got []string
+	for _, k := range keys {
+		got = append(got, string(k))
+	}
+	assert.ElementsMatch(t, []string{"cmp", "put-key", "nested-del", "range-key"}, got)
+}
+
+func TestAuditKeyFieldsForRangeIncludesRangeEndOnlyWhenSet(t *testing.T) {
+	fields := auditKeyFields(&pb.RangeRequest{Key: []byte("a")})
+	enc := zapFieldsToMap(fields)
+	assert.Contains(t, enc, "key")
+	assert.NotContains(t, enc, "range-end")
+
+	fields = auditKeyFields(&pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")})
+	enc = zapFieldsToMap(fields)
+	assert.Contains(t, enc, "range-end")
+}
+
+func zapFieldsToMap(fields []zap.Field) map[string]any {
+	core, logs := observer.New(zap.InfoLevel)
+	zap.New(core).Info("x", fields...)
+	return logs.All()[0].ContextMap()
+}
