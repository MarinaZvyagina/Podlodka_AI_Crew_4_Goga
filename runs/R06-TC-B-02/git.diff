+package v3rpc
+
+import (
+	"context"
+	"strings"
+	"time"
+
+	"go.uber.org/zap"
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+)
+
+// auditLogSource is the subset of *etcdserver.EtcdServer the audit
+// interceptor depends on, kept narrow so the interceptor can be exercised
+// against a fake in tests without standing up a full server.
+type auditLogSource interface {
+	Logger() *zap.Logger
+	AuthInfoFromCtx(ctx context.Context) (*auth.AuthInfo, error)
+}
+
+// kvServiceMethodPrefix is the gRPC method prefix for every request handled
+// by the KV service. Filtering on this prefix (rather than on individual
+// request/response types) guarantees that any request type added to the
+// service in the future is picked up automatically, without needing an
+// accompanying update here.
+const kvServiceMethodPrefix = "/etcdserverpb.KV/"
+
+// kvAuditOperations classifies the well-known KV methods into the audit
+// vocabulary compliance expects. Compact is intentionally omitted: it is an
+// administrative operation on the store rather than a read/write/delete on a
+// caller-specified key or range.
+var kvAuditOperations = map[string]string{
+	kvServiceMethodPrefix + "Range":       "read",
+	kvServiceMethodPrefix + "Put":         "write",
+	kvServiceMethodPrefix + "DeleteRange": "delete",
+	kvServiceMethodPrefix + "Txn":         "transaction",
+}
+
+// newAuditUnaryInterceptor returns a gRPC interceptor that records a
+// structured audit entry for every KV read, write, delete, and transaction
+// request handled by the server: caller identity, operation kind, key or key
+// range, duration, and outcome. It observes the request/response passing
+// through the handler but never mutates either, so it cannot change the
+// functional behavior of the underlying operation.
+func newAuditUnaryInterceptor(s auditLogSource) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		op, audited := auditedOperation(info.FullMethod)
+		if !audited {
+			return handler(ctx, req)
+		}
+
+		start := time.Now()
+		resp, err := handler(ctx, req)
+		logKVAudit(s, ctx, op, req, time.Since(start), err)
+		return resp, err
+	}
+}
+
+// auditedOperation reports whether fullMethod belongs to the KV service and,
+// if so, the operation kind to record for it. Methods not yet classified in
+// kvAuditOperations still get audited under their raw method name, so a
+// newly added KV RPC is never silently skipped.
+func auditedOperation(fullMethod string) (string, bool) {
+	if !strings.HasPrefix(fullMethod, kvServiceMethodPrefix) {
+		return "", false
+	}
+	if op, ok := kvAuditOperations[fullMethod]; ok {
+		return op, true
+	}
+	if fullMethod == kvServiceMethodPrefix+"Compact" {
+		return "", false
+	}
+	return strings.TrimPrefix(fullMethod, kvServiceMethodPrefix), true
+}
+
+func logKVAudit(s auditLogSource, ctx context.Context, op string, req any, duration time.Duration, err error) {
+	lg := s.Logger()
+	if lg == nil {
+		return
+	}
+
+	caller := "unauthenticated"
+	if authInfo, aerr := s.AuthInfoFromCtx(ctx); aerr == nil && authInfo != nil && authInfo.Username != "" {
+		caller = authInfo.Username
+	}
+
+	outcome := "success"
+	if err != nil {
+		outcome = "failure"
+	}
+
+	fields := []zap.Field{
+		zap.String("caller", caller),
+		zap.String("operation", op),
+		zap.Duration("duration", duration),
+		zap.String("outcome", outcome),
+	}
+	fields = append(fields, auditKeyFields(req)...)
+	if err != nil {
+		fields = append(fields, zap.Error(err))
+	}
+
+	lg.Info("kv audit", fields...)
+}
+
+// keyGetter and rangeEndGetter match the accessor methods protoc-gen-go
+// generates for any message with a "key" or "range_end" field. Using these
+// structural interfaces instead of a type switch means Range, Put, and
+// DeleteRange requests (and any future single-key or ranged KV request) are
+// covered without listing their concrete types here.
+type keyGetter interface {
+	GetKey() []byte
+}
+
+type rangeEndGetter interface {
+	GetRangeEnd() []byte
+}
+
+// auditKeyFields extracts the key or key range touched by req into audit log
+// fields. Transaction requests can reference many keys across their compare
+// and operation lists, so they're reported as a list rather than a single
+// key/range pair.
+func auditKeyFields(req any) []zap.Field {
+	if txn, ok := req.(*pb.TxnRequest); ok {
+		keys := txnKeys(txn)
+		keyStrings := make([]string, len(keys))
+		for i, k := range keys {
+			keyStrings[i] = string(k)
+		}
+		return []zap.Field{zap.Strings("keys", keyStrings)}
+	}
+
+	var fields []zap.Field
+	if kg, ok := req.(keyGetter); ok {
+		fields = append(fields, zap.ByteString("key", kg.GetKey()))
+	}
+	if rg, ok := req.(rangeEndGetter); ok {
+		if rangeEnd := rg.GetRangeEnd(); len(rangeEnd) > 0 {
+			fields = append(fields, zap.ByteString("range-end", rangeEnd))
+		}
+	}
+	return fields
+}
+
+// txnKeys collects every key referenced anywhere in a (possibly nested)
+// transaction: its compare list and the range/put/delete-range operations in
+// both its success and failure branches.
+func txnKeys(txn *pb.TxnRequest) [][]byte {
+	var keys [][]byte
+	for _, c := range txn.GetCompare() {
+		keys = append(keys, c.GetKey())
+	}
+	for _, op := range txn.GetSuccess() {
+		keys = append(keys, requestOpKeys(op)...)
+	}
+	for _, op := range txn.GetFailure() {
+		keys = append(keys, requestOpKeys(op)...)
+	}
+	return keys
+}
+
+func requestOpKeys(op *pb.RequestOp) [][]byte {
+	switch r := op.GetRequest().(type) {
+	case *pb.RequestOp_RequestRange:
+		return [][]byte{r.RequestRange.GetKey()}
+	case *pb.RequestOp_RequestPut:
+		return [][]byte{r.RequestPut.GetKey()}
+	case *pb.RequestOp_RequestDeleteRange:
+		return [][]byte{r.RequestDeleteRange.GetKey()}
+	case *pb.RequestOp_RequestTxn:
+		return txnKeys(r.RequestTxn)
+	default:
+		return nil
+	}
+}
