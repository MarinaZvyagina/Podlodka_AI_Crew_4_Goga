+
+package v3rpc
+
+import (
+	"context"
+	"io"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc"
+	"google.golang.org/protobuf/proto"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+// fakeServerStream is a minimal grpc.ServerStream that only supports
+// RecvMsg/Context, enough to exercise auditServerStream.
+type fakeServerStream struct {
+	grpc.ServerStream
+	msgs []proto.Message
+	idx  int
+}
+
+func (f *fakeServerStream) Context() context.Context { return context.Background() }
+
+func (f *fakeServerStream) RecvMsg(m any) error {
+	if f.idx >= len(f.msgs) {
+		return io.EOF
+	}
+	target, ok := m.(proto.Message)
+	if !ok {
+		return io.EOF
+	}
+	proto.Merge(target, f.msgs[f.idx])
+	f.idx++
+	return nil
+}
+
+func TestAuditServerStreamCapturesFirstMessage(t *testing.T) {
+	inner := &fakeServerStream{msgs: []proto.Message{&pb.RangeRequest{Key: []byte("foo")}}}
+	ss := &auditServerStream{ServerStream: inner}
+
+	req := new(pb.RangeRequest)
+	require.NoError(t, ss.RecvMsg(req))
+	assert.Equal(t, []byte("foo"), req.Key)
+
+	captured, ok := ss.req.(*pb.RangeRequest)
+	require.True(t, ok)
+	assert.Equal(t, []byte("foo"), captured.Key)
+	assert.Equal(t, []string{"foo"}, auditKeys(ss.req))
+}
+
+func TestAuditKeys(t *testing.T) {
+	tcs := []struct {
+		name string
+		req  any
+		want []string
+	}{
+		{
+			name: "single key request",
+			req:  &pb.RangeRequest{Key: []byte("foo")},
+			want: []string{"foo"},
+		},
+		{
+			name: "range request",
+			req:  &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")},
+			want: []string{"[a, z)"},
+		},
+		{
+			name: "put request",
+			req:  &pb.PutRequest{Key: []byte("foo"), Value: []byte("bar")},
+			want: []string{"foo"},
+		},
+		{
+			name: "delete range request",
+			req:  &pb.DeleteRangeRequest{Key: []byte("a"), RangeEnd: []byte("z")},
+			want: []string{"[a, z)"},
+		},
+		{
+			name: "txn request collects compare and branch keys",
+			req: &pb.TxnRequest{
+				Compare: []*pb.Compare{{Key: []byte("cmp")}},
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("succ-put")}}},
+				},
+				Failure: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("fail-del")}}},
+				},
+			},
+			want: []string{"cmp", "succ-put", "fail-del"},
+		},
+		{
+			name: "nested txn request recurses",
+			req: &pb.TxnRequest{
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+						Success: []*pb.RequestOp{
+							{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("nested-put")}}},
+						},
+					}}},
+				},
+			},
+			want: []string{"nested-put"},
+		},
+		{
+			name: "non kv request yields no keys",
+			req:  &pb.CompactionRequest{Revision: 1},
+			want: nil,
+		},
+		{
+			name: "non proto request yields no keys",
+			req:  "not a proto message",
+			want: nil,
+		},
+	}
+	for _, tc := range tcs {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.want, auditKeys(tc.req))
+		})
+	}
+}
+
+func TestKVOperationKindCoverage(t *testing.T) {
+	tcs := []struct {
+		method string
+		want   string
+	}{
+		{"/etcdserverpb.KV/Range", "read"},
+		{"/etcdserverpb.KV/Put", "write"},
+		{"/etcdserverpb.KV/DeleteRange", "delete"},
+		{"/etcdserverpb.KV/Txn", "transaction"},
+		{"/etcdserverpb.KV/Compact", "compact"},
+		// A hypothetical future KV method is still categorized, without
+		// requiring kvOperationKinds to be updated first.
+		{"/etcdserverpb.KV/FutureMethod", "futuremethod"},
+	}
+	for _, tc := range tcs {
+		t.Run(tc.method, func(t *testing.T) {
+			assert.Equal(t, tc.want, kvOperationKind(tc.method))
+		})
+	}
+}
