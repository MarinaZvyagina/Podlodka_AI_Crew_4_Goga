+
+package v3rpc
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	"go.uber.org/zap"
+	"google.golang.org/grpc"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/reflect/protoreflect"
+
+	"go.etcd.io/etcd/server/v3/etcdserver"
+)
+
+// kvServiceMethodPrefix is the gRPC method prefix shared by every method of
+// the etcdserverpb.KV service. Matching on it, rather than on a fixed list
+// of request/response types, means a KV method added in the future is
+// audited automatically instead of depending on someone remembering to
+// instrument it.
+const kvServiceMethodPrefix = "/etcdserverpb.KV/"
+
+// kvOperationKinds labels the well-known KV methods with the operation kind
+// used in the audit record. A method missing from this map (e.g. a new KV
+// RPC) is still audited; its kind falls back to the method name itself.
+var kvOperationKinds = map[string]string{
+	kvServiceMethodPrefix + "Range":       "read",
+	kvServiceMethodPrefix + "RangeStream": "read",
+	kvServiceMethodPrefix + "Put":         "write",
+	kvServiceMethodPrefix + "DeleteRange": "delete",
+	kvServiceMethodPrefix + "Txn":         "transaction",
+	kvServiceMethodPrefix + "Compact":     "compact",
+}
+
+// newAuditUnaryInterceptor returns an interceptor that emits one audit log
+// record for every key-value request the server handles, recording caller
+// identity, operation kind, key/range, duration, and outcome. It is placed
+// ahead of the capability/learner/leader checks in newUnaryInterceptor so
+// that requests rejected by those checks are still audited as failures.
+func newAuditUnaryInterceptor(s *etcdserver.EtcdServer) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		if !strings.HasPrefix(info.FullMethod, kvServiceMethodPrefix) {
+			return handler(ctx, req)
+		}
+
+		start := time.Now()
+		resp, err := handler(ctx, req)
+		duration := time.Since(start)
+
+		lg := s.Logger()
+		if lg == nil {
+			return resp, err
+		}
+
+		identity := "unauthenticated"
+		if authInfo, aerr := s.AuthInfoFromCtx(ctx); aerr == nil && authInfo != nil && authInfo.Username != "" {
+			identity = authInfo.Username
+		}
+
+		lg.Info("kv audit",
+			zap.String("identity", identity),
+			zap.String("operation", kvOperationKind(info.FullMethod)),
+			zap.String("method", info.FullMethod),
+			zap.Strings("keys", auditKeys(req)),
+			zap.Duration("duration", duration),
+			zap.Bool("success", err == nil),
+			zap.Error(err),
+		)
+
+		return resp, err
+	}
+}
+
+// newAuditStreamInterceptor mirrors newAuditUnaryInterceptor for the
+// server-streaming KV methods (currently only RangeStream). The single
+// request message is captured via auditServerStream as the RPC handler
+// reads it, so the same audit record shape can be emitted once the stream
+// completes.
+func newAuditStreamInterceptor(s *etcdserver.EtcdServer) grpc.StreamServerInterceptor {
+	return func(srv any, ss grpc.ServerStream, info *grpc.StreamServerInfo, handler grpc.StreamHandler) error {
+		if !strings.HasPrefix(info.FullMethod, kvServiceMethodPrefix) {
+			return handler(srv, ss)
+		}
+
+		start := time.Now()
+		auditSS := &auditServerStream{ServerStream: ss}
+		err := handler(srv, auditSS)
+		duration := time.Since(start)
+
+		lg := s.Logger()
+		if lg == nil {
+			return err
+		}
+
+		identity := "unauthenticated"
+		if authInfo, aerr := s.AuthInfoFromCtx(ss.Context()); aerr == nil && authInfo != nil && authInfo.Username != "" {
+			identity = authInfo.Username
+		}
+
+		lg.Info("kv audit",
+			zap.String("identity", identity),
+			zap.String("operation", kvOperationKind(info.FullMethod)),
+			zap.String("method", info.FullMethod),
+			zap.Strings("keys", auditKeys(auditSS.req)),
+			zap.Duration("duration", duration),
+			zap.Bool("success", err == nil),
+			zap.Error(err),
+		)
+
+		return err
+	}
+}
+
+// auditServerStream wraps a ServerStream to capture the first message the
+// RPC handler reads off it, so streaming KV requests can be audited the
+// same way as unary ones.
+type auditServerStream struct {
+	grpc.ServerStream
+	req any
+}
+
+func (ss *auditServerStream) RecvMsg(m any) error {
+	err := ss.ServerStream.RecvMsg(m)
+	if err == nil && ss.req == nil {
+		ss.req = m
+	}
+	return err
+}
+
+// kvOperationKind returns the audit operation kind for a KV method,
+// falling back to a name derived from the method itself when the method
+// isn't in kvOperationKinds (e.g. a newly added KV RPC).
+func kvOperationKind(method string) string {
+	if kind, ok := kvOperationKinds[method]; ok {
+		return kind
+	}
+	return strings.ToLower(strings.TrimPrefix(method, kvServiceMethodPrefix))
+}
+
+// auditKeys walks a KV request message and reports every key or key range it
+// touches, recursing into nested messages (e.g. Txn's Compare/Success/
+// Failure operations, including nested Txns) so compound requests report
+// every key/range they contain without hard-coding the shape of any
+// particular request type.
+func auditKeys(req any) []string {
+	msg, ok := req.(proto.Message)
+	if !ok {
+		return nil
+	}
+	var keys []string
+	collectAuditKeys(msg.ProtoReflect(), &keys)
+	return keys
+}
+
+func collectAuditKeys(m protoreflect.Message, keys *[]string) {
+	desc := m.Descriptor()
+	fields := desc.Fields()
+
+	if keyFD := fields.ByName("key"); keyFD != nil && keyFD.Kind() == protoreflect.BytesKind && m.Has(keyFD) {
+		key := m.Get(keyFD).Bytes()
+		if rangeEndFD := fields.ByName("range_end"); rangeEndFD != nil && m.Has(rangeEndFD) {
+			*keys = append(*keys, fmt.Sprintf("[%s, %s)", key, m.Get(rangeEndFD).Bytes()))
+		} else {
+			*keys = append(*keys, string(key))
+		}
+	}
+
+	for i := 0; i < fields.Len(); i++ {
+		fd := fields.Get(i)
+		if fd.Kind() != protoreflect.MessageKind || fd.IsMap() || !m.Has(fd) {
+			continue
+		}
+		if fd.IsList() {
+			list := m.Get(fd).List()
+			for j := 0; j < list.Len(); j++ {
+				collectAuditKeys(list.Get(j).Message(), keys)
+			}
+			continue
+		}
+		collectAuditKeys(m.Get(fd).Message(), keys)
+	}
+}
