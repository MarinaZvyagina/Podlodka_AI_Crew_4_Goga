+// limitations under the License.
+
+package v3rpc
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	"go.uber.org/zap"
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+)
+
+const (
+	// kvServiceMethodPrefix is the gRPC full-method prefix shared by every
+	// RPC on the KV service. Auditing is keyed off this prefix, rather than
+	// a hand-maintained list of method names, so any KV RPC added in the
+	// future (or reached through the grpc-gateway, which calls through the
+	// same gRPC methods) is audited without further code changes.
+	kvServiceMethodPrefix = "/etcdserverpb.KV/"
+
+	auditUnauthenticatedIdentity = "unauthenticated"
+
+	auditOutcomeSuccess = "success"
+	auditOutcomeFailure = "failure"
+)
+
+// auditIdentitySource resolves the caller identity carried on a context and
+// exposes the logger the audit trail is written to. *etcdserver.EtcdServer
+// satisfies this interface; it is kept narrow so the interceptors can be
+// exercised with lightweight fakes in tests.
+type auditIdentitySource interface {
+	AuthInfoFromCtx(ctx context.Context) (*auth.AuthInfo, error)
+	Logger() *zap.Logger
+}
+
+// newAuditUnaryInterceptor returns a unary interceptor that emits a
+// structured audit record -- caller identity, operation kind, key/range,
+// duration, and outcome -- for every unary KV request (Range, Put,
+// DeleteRange, Txn, Compact, and any RPC added to the KV service later).
+// It only observes the request and response; it never mutates them, so it
+// cannot change the functional behavior of the underlying call.
+func newAuditUnaryInterceptor(s auditIdentitySource) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		if !strings.HasPrefix(info.FullMethod, kvServiceMethodPrefix) {
+			return handler(ctx, req)
+		}
+
+		start := time.Now()
+		resp, err := handler(ctx, req)
+		logAuditRecord(s, ctx, info.FullMethod, req, time.Since(start), err)
+		return resp, err
+	}
+}
+
+// newAuditStreamInterceptor is the streaming counterpart of
+// newAuditUnaryInterceptor, needed because the KV service's RangeStream RPC
+// is server-streaming rather than unary. It captures the single request
+// message such a stream RPC receives so it can be audited the same way as
+// a unary request, without altering what is sent to the handler.
+func newAuditStreamInterceptor(s auditIdentitySource) grpc.StreamServerInterceptor {
+	return func(srv any, ss grpc.ServerStream, info *grpc.StreamServerInfo, handler grpc.StreamHandler) error {
+		if !strings.HasPrefix(info.FullMethod, kvServiceMethodPrefix) {
+			return handler(srv, ss)
+		}
+
+		capturing := &auditCapturingServerStream{ServerStream: ss}
+		start := time.Now()
+		err := handler(srv, capturing)
+		logAuditRecord(s, ss.Context(), info.FullMethod, capturing.req, time.Since(start), err)
+		return err
+	}
+}
+
+// auditCapturingServerStream wraps a ServerStream to remember the request
+// message the handler decodes, since a streaming handler (unlike a unary
+// one) never receives its request as a plain argument.
+type auditCapturingServerStream struct {
+	grpc.ServerStream
+	req any
+}
+
+func (s *auditCapturingServerStream) RecvMsg(m any) error {
+	err := s.ServerStream.RecvMsg(m)
+	if err == nil {
+		s.req = m
+	}
+	return err
+}
+
+func logAuditRecord(s auditIdentitySource, ctx context.Context, fullMethod string, req any, duration time.Duration, err error) {
+	lg := s.Logger()
+	if lg == nil {
+		return
+	}
+
+	outcome := auditOutcomeSuccess
+	fields := []zap.Field{
+		zap.String("identity", auditIdentity(s, ctx)),
+		zap.String("method", fullMethod),
+		zap.String("operation", auditOperationKind(fullMethod)),
+		zap.String("key", auditKeyRange(req)),
+		zap.Duration("duration", duration),
+	}
+	if err != nil {
+		outcome = auditOutcomeFailure
+		fields = append(fields, zap.Error(err))
+	}
+	fields = append(fields, zap.String("outcome", outcome))
+
+	lg.Info("kv audit", fields...)
+}
+
+// auditIdentity resolves the caller identity for the audit trail, falling
+// back to "unauthenticated" whenever auth is disabled or no identity can be
+// established. It never fails the request itself.
+func auditIdentity(s auditIdentitySource, ctx context.Context) string {
+	authInfo, err := s.AuthInfoFromCtx(ctx)
+	if err != nil || authInfo == nil || authInfo.Username == "" {
+		return auditUnauthenticatedIdentity
+	}
+	return authInfo.Username
+}
+
+// auditOperationKind classifies a KV RPC into the coarse operation kinds
+// compliance cares about, derived from the method name so that RPCs added
+// to the KV service later are classified without further code changes.
+func auditOperationKind(fullMethod string) string {
+	method := strings.TrimPrefix(fullMethod, kvServiceMethodPrefix)
+	switch {
+	case strings.Contains(method, "Txn"):
+		return "transaction"
+	case strings.Contains(method, "DeleteRange"):
+		return "delete"
+	case strings.Contains(method, "Put"):
+		return "write"
+	case strings.Contains(method, "Range"):
+		return "read"
+	default:
+		return "other"
+	}
+}
+
+// keyGetter and rangeEndGetter match the generated accessors shared by
+// every KV request that carries a single key or key range (Range, Put,
+// DeleteRange, and Compare within a Txn). Matching on these accessors,
+// rather than on the concrete request types, means request types added
+// later are picked up automatically as long as they follow the same
+// convention as the existing ones.
+type keyGetter interface {
+	GetKey() []byte
+}
+
+type rangeEndGetter interface {
+	GetRangeEnd() []byte
+}
+
+// auditKeyRange extracts the key or key range a KV request touches.
+func auditKeyRange(req any) string {
+	if txn, ok := req.(*pb.TxnRequest); ok {
+		return auditTxnKeyRange(txn)
+	}
+
+	var key, rangeEnd []byte
+	if kg, ok := req.(keyGetter); ok {
+		key = kg.GetKey()
+	}
+	if reg, ok := req.(rangeEndGetter); ok {
+		rangeEnd = reg.GetRangeEnd()
+	}
+	return formatKeyRange(key, rangeEnd)
+}
+
+func formatKeyRange(key, rangeEnd []byte) string {
+	if len(key) == 0 && len(rangeEnd) == 0 {
+		return ""
+	}
+	if len(rangeEnd) == 0 {
+		return string(key)
+	}
+	return fmt.Sprintf("[%s, %s)", key, rangeEnd)
+}
+
+// auditTxnKeyRange collects the distinct keys/ranges referenced anywhere in
+// a (possibly nested) transaction: its compare guards and every read,
+// write, or delete it performs on either branch.
+func auditTxnKeyRange(txn *pb.TxnRequest) string {
+	seen := make(map[string]struct{})
+	var ranges []string
+	add := func(key, rangeEnd []byte) {
+		kr := formatKeyRange(key, rangeEnd)
+		if kr == "" {
+			return
+		}
+		if _, ok := seen[kr]; ok {
+			return
+		}
+		seen[kr] = struct{}{}
+		ranges = append(ranges, kr)
+	}
+
+	var walkOps func(ops []*pb.RequestOp)
+	walkOps = func(ops []*pb.RequestOp) {
+		for _, op := range ops {
+			switch {
+			case op.GetRequestRange() != nil:
+				r := op.GetRequestRange()
+				add(r.GetKey(), r.GetRangeEnd())
+			case op.GetRequestPut() != nil:
+				add(op.GetRequestPut().GetKey(), nil)
+			case op.GetRequestDeleteRange() != nil:
+				r := op.GetRequestDeleteRange()
+				add(r.GetKey(), r.GetRangeEnd())
+			case op.GetRequestTxn() != nil:
+				nested := op.GetRequestTxn()
+				for _, c := range nested.GetCompare() {
+					add(c.GetKey(), c.GetRangeEnd())
+				}
+				walkOps(nested.GetSuccess())
+				walkOps(nested.GetFailure())
+			}
+		}
+	}
+
+	for _, c := range txn.GetCompare() {
+		add(c.GetKey(), c.GetRangeEnd())
+	}
+	walkOps(txn.GetSuccess())
+	walkOps(txn.GetFailure())
+
+	return strings.Join(ranges, ", ")
+}
