+
+package v3rpc
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"go.uber.org/zap"
+	"go.uber.org/zap/zaptest/observer"
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+)
+
+// fakeAuditIdentitySource is a lightweight stand-in for *etcdserver.EtcdServer
+// used to exercise the audit interceptors without constructing a real server.
+type fakeAuditIdentitySource struct {
+	lg       *zap.Logger
+	authInfo *auth.AuthInfo
+	authErr  error
+}
+
+func (f *fakeAuditIdentitySource) AuthInfoFromCtx(context.Context) (*auth.AuthInfo, error) {
+	return f.authInfo, f.authErr
+}
+
+func (f *fakeAuditIdentitySource) Logger() *zap.Logger { return f.lg }
+
+func newObservedFakeSource() (*fakeAuditIdentitySource, *observer.ObservedLogs) {
+	core, logs := observer.New(zap.InfoLevel)
+	return &fakeAuditIdentitySource{lg: zap.New(core)}, logs
+}
+
+func TestAuditOperationKind(t *testing.T) {
+	tests := []struct {
+		method string
+		want   string
+	}{
+		{"/etcdserverpb.KV/Range", "read"},
+		{"/etcdserverpb.KV/RangeStream", "read"},
+		{"/etcdserverpb.KV/Put", "write"},
+		{"/etcdserverpb.KV/DeleteRange", "delete"},
+		{"/etcdserverpb.KV/Txn", "transaction"},
+		{"/etcdserverpb.KV/Compact", "other"},
+		{"/etcdserverpb.KV/SomeFutureRangeQuery", "read"},
+	}
+	for _, tt := range tests {
+		if got := auditOperationKind(tt.method); got != tt.want {
+			t.Errorf("auditOperationKind(%q) = %q, want %q", tt.method, got, tt.want)
+		}
+	}
+}
+
+func TestAuditKeyRange(t *testing.T) {
+	tests := []struct {
+		name string
+		req  any
+		want string
+	}{
+		{"range single key", &pb.RangeRequest{Key: []byte("foo")}, "foo"},
+		{"range with end", &pb.RangeRequest{Key: []byte("foo"), RangeEnd: []byte("fop")}, "[foo, fop)"},
+		{"put", &pb.PutRequest{Key: []byte("bar")}, "bar"},
+		{"delete range", &pb.DeleteRangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}, "[a, z)"},
+		{"compact has no key", &pb.CompactionRequest{Revision: 5}, ""},
+	}
+	for _, tt := range tests {
+		if got := auditKeyRange(tt.req); got != tt.want {
+			t.Errorf("%s: auditKeyRange() = %q, want %q", tt.name, got, tt.want)
+		}
+	}
+}
+
+func TestAuditTxnKeyRange(t *testing.T) {
+	txn := &pb.TxnRequest{
+		Compare: []*pb.Compare{
+			{Key: []byte("cmp1")},
+		},
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("put1")}}},
+			{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}}},
+		},
+		Failure: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("del1")}}},
+			// duplicate of a key already seen in Success should be deduped.
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("put1")}}},
+			{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("nested")}}},
+				},
+			}}},
+		},
+	}
+
+	want := "cmp1, put1, [a, z), del1, nested"
+	if got := auditTxnKeyRange(txn); got != want {
+		t.Errorf("auditTxnKeyRange() = %q, want %q", got, want)
+	}
+}
+
+func TestAuditIdentity(t *testing.T) {
+	tests := []struct {
+		name string
+		src  *fakeAuditIdentitySource
+		want string
+	}{
+		{"authenticated", &fakeAuditIdentitySource{authInfo: &auth.AuthInfo{Username: "alice"}}, "alice"},
+		{"no auth info", &fakeAuditIdentitySource{}, auditUnauthenticatedIdentity},
+		{"empty username", &fakeAuditIdentitySource{authInfo: &auth.AuthInfo{}}, auditUnauthenticatedIdentity},
+		{"error resolving identity", &fakeAuditIdentitySource{authErr: errors.New("boom")}, auditUnauthenticatedIdentity},
+	}
+	for _, tt := range tests {
+		if got := auditIdentity(tt.src, context.Background()); got != tt.want {
+			t.Errorf("%s: auditIdentity() = %q, want %q", tt.name, got, tt.want)
+		}
+	}
+}
+
+func TestNewAuditUnaryInterceptor(t *testing.T) {
+	t.Run("logs kv requests with identity, operation, key, and outcome", func(t *testing.T) {
+		src, logs := newObservedFakeSource()
+		src.authInfo = &auth.AuthInfo{Username: "alice"}
+		interceptor := newAuditUnaryInterceptor(src)
+
+		info := &grpc.UnaryServerInfo{FullMethod: "/etcdserverpb.KV/Put"}
+		handler := func(ctx context.Context, req any) (any, error) {
+			return &pb.PutResponse{}, nil
+		}
+
+		_, err := interceptor(context.Background(), &pb.PutRequest{Key: []byte("foo")}, info, handler)
+		if err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+
+		entries := logs.All()
+		if len(entries) != 1 {
+			t.Fatalf("expected exactly 1 audit log entry, got %d", len(entries))
+		}
+		fields := entries[0].ContextMap()
+		if fields["identity"] != "alice" {
+			t.Errorf("identity = %v, want alice", fields["identity"])
+		}
+		if fields["operation"] != "write" {
+			t.Errorf("operation = %v, want write", fields["operation"])
+		}
+		if fields["key"] != "foo" {
+			t.Errorf("key = %v, want foo", fields["key"])
+		}
+		if fields["outcome"] != auditOutcomeSuccess {
+			t.Errorf("outcome = %v, want %v", fields["outcome"], auditOutcomeSuccess)
+		}
+	})
+
+	t.Run("records failure outcome without altering the returned error", func(t *testing.T) {
+		src, logs := newObservedFakeSource()
+		interceptor := newAuditUnaryInterceptor(src)
+		wantErr := errors.New("denied")
+
+		info := &grpc.UnaryServerInfo{FullMethod: "/etcdserverpb.KV/Range"}
+		handler := func(ctx context.Context, req any) (any, error) {
+			return nil, wantErr
+		}
+
+		_, err := interceptor(context.Background(), &pb.RangeRequest{Key: []byte("foo")}, info, handler)
+		if !errors.Is(err, wantErr) {
+			t.Fatalf("interceptor changed the error: got %v, want %v", err, wantErr)
+		}
+
+		fields := logs.All()[0].ContextMap()
+		if fields["outcome"] != auditOutcomeFailure {
+			t.Errorf("outcome = %v, want %v", fields["outcome"], auditOutcomeFailure)
+		}
+		if fields["identity"] != auditUnauthenticatedIdentity {
+			t.Errorf("identity = %v, want %v", fields["identity"], auditUnauthenticatedIdentity)
+		}
+	})
+
+	t.Run("does not audit non-kv services", func(t *testing.T) {
+		src, logs := newObservedFakeSource()
+		interceptor := newAuditUnaryInterceptor(src)
+
+		info := &grpc.UnaryServerInfo{FullMethod: "/etcdserverpb.Lease/LeaseGrant"}
+		called := false
+		handler := func(ctx context.Context, req any) (any, error) {
+			called = true
+			return nil, nil
+		}
+
+		if _, err := interceptor(context.Background(), struct{}{}, info, handler); err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+		if !called {
+			t.Fatal("handler was not invoked")
+		}
+		if len(logs.All()) != 0 {
+			t.Fatalf("expected no audit log entries, got %d", len(logs.All()))
+		}
+	})
+
+	t.Run("returns the handler response unchanged", func(t *testing.T) {
+		src, _ := newObservedFakeSource()
+		interceptor := newAuditUnaryInterceptor(src)
+		wantResp := &pb.PutResponse{}
+
+		info := &grpc.UnaryServerInfo{FullMethod: "/etcdserverpb.KV/Put"}
+		handler := func(ctx context.Context, req any) (any, error) {
+			return wantResp, nil
+		}
+
+		resp, err := interceptor(context.Background(), &pb.PutRequest{Key: []byte("foo")}, info, handler)
+		if err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+		if resp != any(wantResp) {
+			t.Fatalf("interceptor changed the response: got %v, want %v", resp, wantResp)
+		}
+	})
+}
+
+// fakeServerStream is a minimal grpc.ServerStream that plays back a single
+// pre-decoded request message from RecvMsg, mimicking what a generated KV
+// stream handler does when it decodes its first (and only) message.
+type fakeServerStream struct {
+	grpc.ServerStream
+	ctx context.Context
+	msg any
+}
+
+func (f *fakeServerStream) Context() context.Context { return f.ctx }
+
+func (f *fakeServerStream) RecvMsg(m any) error {
+	if rr, ok := m.(*pb.RangeRequest); ok {
+		if src, ok := f.msg.(*pb.RangeRequest); ok {
+			rr.Key = src.Key
+			rr.RangeEnd = src.RangeEnd
+		}
+	}
+	return nil
+}
+
+func TestNewAuditStreamInterceptor(t *testing.T) {
+	src, logs := newObservedFakeSource()
+	interceptor := newAuditStreamInterceptor(src)
+
+	stream := &fakeServerStream{ctx: context.Background(), msg: &pb.RangeRequest{Key: []byte("stream-key")}}
+	info := &grpc.StreamServerInfo{FullMethod: "/etcdserverpb.KV/RangeStream"}
+
+	handler := func(srv any, ss grpc.ServerStream) error {
+		// mimic the generated handler decoding its request off the stream.
+		req := new(pb.RangeRequest)
+		return ss.RecvMsg(req)
+	}
+
+	if err := interceptor(nil, stream, info, handler); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	entries := logs.All()
+	if len(entries) != 1 {
+		t.Fatalf("expected exactly 1 audit log entry, got %d", len(entries))
+	}
+	fields := entries[0].ContextMap()
+	if fields["key"] != "stream-key" {
+		t.Errorf("key = %v, want stream-key", fields["key"])
+	}
+	if fields["operation"] != "read" {
+		t.Errorf("operation = %v, want read", fields["operation"])
+	}
+}
