+package v3rpc
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"go.uber.org/zap"
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+	"go.etcd.io/etcd/server/v3/etcdserver"
+)
+
+// auditOperation identifies the category of key-value operation being audited.
+type auditOperation string
+
+const (
+	auditOperationRead        auditOperation = "read"
+	auditOperationWrite       auditOperation = "write"
+	auditOperationDelete      auditOperation = "delete"
+	auditOperationTransaction auditOperation = "transaction"
+
+	unauthenticatedCaller = "unauthenticated"
+
+	// maxAuditedTxnKeys bounds how many distinct keys a single transaction
+	// audit record will enumerate, so a huge transaction can't blow up the
+	// audit log.
+	maxAuditedTxnKeys = 20
+)
+
+// authInfoGetter is the subset of etcdserver.EtcdServer the audit
+// interceptor needs to resolve caller identity. It exists so the identity
+// resolution logic can be unit tested without standing up a full server.
+type authInfoGetter interface {
+	AuthInfoFromCtx(ctx context.Context) (*auth.AuthInfo, error)
+}
+
+// newAuditUnaryInterceptor returns a unary interceptor that emits a uniform
+// audit record for every key-value read, write, delete, and transaction
+// request handled by the server: who made the request, what kind of
+// operation it was, which key/range it targeted, how long it took, and
+// whether it succeeded.
+//
+// Because it classifies requests by their gRPC request type rather than
+// relying on each KV handler to log itself, coverage stays complete as
+// handlers are modified or new request kinds are added to the KV service —
+// there is no per-handler instrumentation to forget. It only inspects the
+// request/response and never mutates either, so it has no effect on the
+// functional behavior of the underlying operation.
+func newAuditUnaryInterceptor(s *etcdserver.EtcdServer) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		op, key, rangeEnd, keys, audited := classifyKVRequest(req)
+		if !audited {
+			return handler(ctx, req)
+		}
+
+		start := time.Now()
+		resp, err := handler(ctx, req)
+		duration := time.Since(start)
+
+		if lg := s.Logger(); lg != nil {
+			logAuditRecord(lg, s, ctx, op, key, rangeEnd, keys, duration, err)
+		}
+
+		return resp, err
+	}
+}
+
+func logAuditRecord(lg *zap.Logger, ag authInfoGetter, ctx context.Context, op auditOperation, key, rangeEnd []byte, keys []string, duration time.Duration, err error) {
+	fields := []zap.Field{
+		zap.String("caller", callerIdentity(ag, ctx)),
+		zap.String("operation", string(op)),
+		zap.Duration("duration", duration),
+		zap.Bool("success", err == nil),
+	}
+	if keys != nil {
+		fields = append(fields, zap.Strings("keys", keys))
+	} else {
+		fields = append(fields, zap.ByteString("key", key))
+		if len(rangeEnd) > 0 {
+			fields = append(fields, zap.ByteString("range_end", rangeEnd))
+		}
+	}
+	if err != nil {
+		fields = append(fields, zap.Error(err))
+	}
+
+	lg.Info("kv audit", fields...)
+}
+
+// callerIdentity resolves the identity of the caller for an audit record,
+// falling back to "unauthenticated" whenever authentication is disabled or
+// no identity can be established for the request.
+func callerIdentity(ag authInfoGetter, ctx context.Context) string {
+	authInfo, err := ag.AuthInfoFromCtx(ctx)
+	if err != nil || authInfo == nil || authInfo.Username == "" {
+		return unauthenticatedCaller
+	}
+	return authInfo.Username
+}
+
+// classifyKVRequest reports whether req is one of the audited key-value
+// request kinds (Range, Put, DeleteRange, Txn) and, if so, extracts the
+// operation kind and the key/range/keys it targets.
+func classifyKVRequest(req any) (op auditOperation, key, rangeEnd []byte, keys []string, audited bool) {
+	switch r := req.(type) {
+	case *pb.RangeRequest:
+		return auditOperationRead, r.GetKey(), r.GetRangeEnd(), nil, true
+	case *pb.PutRequest:
+		return auditOperationWrite, r.GetKey(), nil, nil, true
+	case *pb.DeleteRangeRequest:
+		return auditOperationDelete, r.GetKey(), r.GetRangeEnd(), nil, true
+	case *pb.TxnRequest:
+		return auditOperationTransaction, nil, nil, txnKeys(r), true
+	default:
+		return "", nil, nil, nil, false
+	}
+}
+
+// txnKeys collects the distinct keys referenced anywhere in a transaction —
+// its compare predicates and the nested Range/Put/DeleteRange/Txn requests in
+// both its success and failure branches — formatted for logging. The result
+// is capped at maxAuditedTxnKeys entries.
+func txnKeys(r *pb.TxnRequest) []string {
+	var raw [][]byte
+	for _, c := range r.GetCompare() {
+		raw = append(raw, c.GetKey())
+	}
+	raw = append(raw, requestOpKeys(r.GetSuccess())...)
+	raw = append(raw, requestOpKeys(r.GetFailure())...)
+
+	seen := make(map[string]struct{}, len(raw))
+	keys := make([]string, 0, len(raw))
+	for _, k := range raw {
+		sk := string(k)
+		if _, dup := seen[sk]; dup {
+			continue
+		}
+		seen[sk] = struct{}{}
+
+		if len(keys) >= maxAuditedTxnKeys {
+			keys = append(keys, "...")
+			break
+		}
+		keys = append(keys, fmt.Sprintf("%q", k))
+	}
+	return keys
+}
+
+// requestOpKeys extracts the keys referenced by a list of transaction
+// sub-requests, recursing into nested transactions.
+func requestOpKeys(ops []*pb.RequestOp) [][]byte {
+	var keys [][]byte
+	for _, op := range ops {
+		switch {
+		case op.GetRequestRange() != nil:
+			keys = append(keys, op.GetRequestRange().GetKey())
+		case op.GetRequestPut() != nil:
+			keys = append(keys, op.GetRequestPut().GetKey())
+		case op.GetRequestDeleteRange() != nil:
+			keys = append(keys, op.GetRequestDeleteRange().GetKey())
+		case op.GetRequestTxn() != nil:
+			txn := op.GetRequestTxn()
+			for _, c := range txn.GetCompare() {
+				keys = append(keys, c.GetKey())
+			}
+			keys = append(keys, requestOpKeys(txn.GetSuccess())...)
+			keys = append(keys, requestOpKeys(txn.GetFailure())...)
+		}
+	}
+	return keys
+}
diff --git a/server/etcdserver/api/v3rpc/audit_test.go b/server/etcdserver/api/v3rpc/audit_test.go
