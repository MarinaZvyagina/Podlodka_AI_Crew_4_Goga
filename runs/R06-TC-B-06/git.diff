+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package v3rpc
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+)
+
+func TestClassifyKVRequest(t *testing.T) {
+	tests := []struct {
+		name         string
+		req          any
+		wantOp       auditOperation
+		wantKey      []byte
+		wantRangeEnd []byte
+		wantKeys     []string
+		wantAudited  bool
+	}{
+		{
+			name:         "range",
+			req:          &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")},
+			wantOp:       auditOperationRead,
+			wantKey:      []byte("a"),
+			wantRangeEnd: []byte("z"),
+			wantAudited:  true,
+		},
+		{
+			name:        "put",
+			req:         &pb.PutRequest{Key: []byte("a"), Value: []byte("v")},
+			wantOp:      auditOperationWrite,
+			wantKey:     []byte("a"),
+			wantAudited: true,
+		},
+		{
+			name:         "delete range",
+			req:          &pb.DeleteRangeRequest{Key: []byte("a"), RangeEnd: []byte("z")},
+			wantOp:       auditOperationDelete,
+			wantKey:      []byte("a"),
+			wantRangeEnd: []byte("z"),
+			wantAudited:  true,
+		},
+		{
+			name: "txn",
+			req: &pb.TxnRequest{
+				Compare: []*pb.Compare{{Key: []byte("a")}},
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("b")}}},
+				},
+			},
+			wantOp:      auditOperationTransaction,
+			wantKeys:    []string{`"a"`, `"b"`},
+			wantAudited: true,
+		},
+		{
+			name:        "unrelated request is not audited",
+			req:         &pb.StatusRequest{},
+			wantAudited: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			op, key, rangeEnd, keys, audited := classifyKVRequest(tt.req)
+			assert.Equal(t, tt.wantAudited, audited)
+			if !tt.wantAudited {
+				return
+			}
+			assert.Equal(t, tt.wantOp, op)
+			assert.Equal(t, tt.wantKey, key)
+			assert.Equal(t, tt.wantRangeEnd, rangeEnd)
+			assert.Equal(t, tt.wantKeys, keys)
+		})
+	}
+}
+
+func TestTxnKeysRecursesIntoNestedTxnsAndDedupes(t *testing.T) {
+	req := &pb.TxnRequest{
+		Compare: []*pb.Compare{{Key: []byte("a")}},
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("a")}}}, // duplicate of compare key
+			{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("c")}}},
+				},
+			}}},
+		},
+		Failure: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("d")}}},
+		},
+	}
+
+	assert.Equal(t, []string{`"a"`, `"c"`, `"d"`}, txnKeys(req))
+}
+
+func TestTxnKeysCapsCount(t *testing.T) {
+	req := &pb.TxnRequest{}
+	for i := 0; i < maxAuditedTxnKeys+5; i++ {
+		req.Compare = append(req.Compare, &pb.Compare{Key: []byte{byte(i)}})
+	}
+
+	keys := txnKeys(req)
+	assert.Len(t, keys, maxAuditedTxnKeys+1) // capped entries plus the "..." marker
+	assert.Equal(t, "...", keys[len(keys)-1])
+}
+
+type fakeAuthInfoGetter struct {
+	authInfo *auth.AuthInfo
+	err      error
+}
+
+func (f fakeAuthInfoGetter) AuthInfoFromCtx(context.Context) (*auth.AuthInfo, error) {
+	return f.authInfo, f.err
+}
+
+func TestCallerIdentity(t *testing.T) {
+	tests := []struct {
+		name string
+		ag   authInfoGetter
+		want string
+	}{
+		{
+			name: "authenticated user",
+			ag:   fakeAuthInfoGetter{authInfo: &auth.AuthInfo{Username: "alice"}},
+			want: "alice",
+		},
+		{
+			name: "auth disabled: no identity available",
+			ag:   fakeAuthInfoGetter{},
+			want: unauthenticatedCaller,
+		},
+		{
+			name: "auth info lookup fails",
+			ag:   fakeAuthInfoGetter{err: errors.New("boom")},
+			want: unauthenticatedCaller,
+		},
+		{
+			name: "empty username",
+			ag:   fakeAuthInfoGetter{authInfo: &auth.AuthInfo{}},
+			want: unauthenticatedCaller,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, callerIdentity(tt.ag, context.Background()))
+		})
+	}
+}
