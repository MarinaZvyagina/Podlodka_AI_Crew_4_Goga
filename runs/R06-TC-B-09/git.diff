+
+package v3rpc
+
+import (
+	"testing"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestIsKVServiceMethod(t *testing.T) {
+	tests := []struct {
+		fullMethod string
+		want       bool
+	}{
+		{"/etcdserverpb.KV/Range", true},
+		{"/etcdserverpb.KV/Put", true},
+		{"/etcdserverpb.KV/DeleteRange", true},
+		{"/etcdserverpb.KV/Txn", true},
+		{"/etcdserverpb.KV/Compact", true},
+		{"/etcdserverpb.KV/SomeFutureMethod", true},
+		{"/etcdserverpb.Watch/Watch", false},
+		{"/etcdserverpb.Lease/LeaseGrant", false},
+		{"/etcdserverpb.Auth/Authenticate", false},
+	}
+	for _, tt := range tests {
+		if got := isKVServiceMethod(tt.fullMethod); got != tt.want {
+			t.Errorf("isKVServiceMethod(%q) = %v, want %v", tt.fullMethod, got, tt.want)
+		}
+	}
+}
+
+func TestKVOperationKind(t *testing.T) {
+	tests := []struct {
+		fullMethod string
+		want       string
+	}{
+		{"/etcdserverpb.KV/Range", "read"},
+		{"/etcdserverpb.KV/RangeStream", "read"},
+		{"/etcdserverpb.KV/Put", "write"},
+		{"/etcdserverpb.KV/DeleteRange", "delete"},
+		{"/etcdserverpb.KV/Txn", "transaction"},
+		{"/etcdserverpb.KV/Compact", "compact"},
+		// A hypothetical future KV method still yields a non-empty kind
+		// derived from its name, instead of being skipped.
+		{"/etcdserverpb.KV/Watch", "Watch"},
+	}
+	for _, tt := range tests {
+		if got := kvOperationKind(tt.fullMethod); got != tt.want {
+			t.Errorf("kvOperationKind(%q) = %q, want %q", tt.fullMethod, got, tt.want)
+		}
+	}
+}
+
+func TestAuditKeyRange(t *testing.T) {
+	tests := []struct {
+		name string
+		req  any
+		want string
+	}{
+		{
+			name: "range with end",
+			req:  &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")},
+			want: "[a, z)",
+		},
+		{
+			name: "range single key",
+			req:  &pb.RangeRequest{Key: []byte("a")},
+			want: "a",
+		},
+		{
+			name: "put",
+			req:  &pb.PutRequest{Key: []byte("foo"), Value: []byte("secret")},
+			want: "foo",
+		},
+		{
+			name: "delete range",
+			req:  &pb.DeleteRangeRequest{Key: []byte("a"), RangeEnd: []byte("b")},
+			want: "[a, b)",
+		},
+		{
+			name: "compact has no key",
+			req:  &pb.CompactionRequest{Revision: 5},
+			want: "",
+		},
+		{
+			name: "txn collects compare and op keys, including nested txn",
+			req: &pb.TxnRequest{
+				Compare: []*pb.Compare{{Key: []byte("c1")}},
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("p1")}}},
+					{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+						Success: []*pb.RequestOp{
+							{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("r1"), RangeEnd: []byte("r2")}}},
+						},
+					}}},
+				},
+				Failure: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("d1")}}},
+				},
+			},
+			want: "c1; p1; [r1, r2); d1",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := auditKeyRange(tt.req); got != tt.want {
+				t.Errorf("auditKeyRange(%v) = %q, want %q", tt.req, got, tt.want)
+			}
+		})
+	}
+}
+
+// TestAuditKeyRangeNeverIncludesValue guards against a regression where a
+// future edit accidentally logs request values (e.g. Put.Value) instead of
+// just keys, which would turn the audit log into a data leak.
+func TestAuditKeyRangeNeverIncludesValue(t *testing.T) {
+	req := &pb.PutRequest{Key: []byte("k"), Value: []byte("top-secret-value")}
+	got := auditKeyRange(req)
+	if got != "k" {
+		t.Errorf("auditKeyRange(%v) = %q, want %q (must not contain the value)", req, got, "k")
+	}
+}
