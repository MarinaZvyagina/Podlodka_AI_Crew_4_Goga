+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package v3rpc
+
+import (
+	"context"
+	"strings"
+	"time"
+
+	"go.uber.org/zap"
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/etcdserver"
+)
+
+// kvServiceMethodPrefix is the gRPC FullMethod prefix shared by every method
+// of the KV service. Gating on this prefix, rather than on an enumerated
+// list of method names, is what makes coverage uniform: any request type
+// added to the KV service in the future is audited automatically because it
+// is routed through this same interceptor, with no per-method registration
+// required.
+const kvServiceMethodPrefix = "/etcdserverpb.KV/"
+
+// kvOperationKinds maps a KV service FullMethod to the audit "operation
+// kind" required by the compliance record. Methods that are not listed here
+// (for example a method added after this table was written) still produce
+// an audit record via the fallback in kvOperationKind: coverage does not
+// depend on this table being kept exhaustive.
+var kvOperationKinds = map[string]string{
+	kvServiceMethodPrefix + "Range":       "read",
+	kvServiceMethodPrefix + "RangeStream": "read",
+	kvServiceMethodPrefix + "Put":         "write",
+	kvServiceMethodPrefix + "DeleteRange": "delete",
+	kvServiceMethodPrefix + "Txn":         "transaction",
+	kvServiceMethodPrefix + "Compact":     "compact",
+}
+
+// isKVServiceMethod reports whether fullMethod belongs to the KV gRPC
+// service, i.e. it is a key-value read, write, delete, or transaction
+// request that must be audited.
+func isKVServiceMethod(fullMethod string) bool {
+	return strings.HasPrefix(fullMethod, kvServiceMethodPrefix)
+}
+
+// kvOperationKind derives a human readable operation kind from a KV service
+// FullMethod. Unknown/future methods fall back to their bare method name so
+// that they still get a (less precisely labeled) audit record instead of
+// being silently skipped.
+func kvOperationKind(fullMethod string) string {
+	if kind, ok := kvOperationKinds[fullMethod]; ok {
+		return kind
+	}
+	return strings.TrimPrefix(fullMethod, kvServiceMethodPrefix)
+}
+
+// newAuditUnaryInterceptor returns an interceptor that produces a uniform
+// audit record for every unary key-value request (Range, Put, DeleteRange,
+// Txn, Compact, ...) handled by the server, regardless of which handler
+// eventually services it. Because it is keyed off the gRPC service name
+// rather than a per-request-type call inserted by hand, any KV request type
+// added later is covered automatically.
+func newAuditUnaryInterceptor(s *etcdserver.EtcdServer) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		if !isKVServiceMethod(info.FullMethod) {
+			return handler(ctx, req)
+		}
+
+		start := time.Now()
+		resp, err := handler(ctx, req)
+		auditKVRequest(s, ctx, kvOperationKind(info.FullMethod), req, start, err)
+		return resp, err
+	}
+}
+
+// auditKVRequest emits a single audit record describing a key-value
+// request. It is shared by the unary interceptor above and by the
+// server-streaming RangeStream call site (server/etcdserver/api/v3rpc/key.go),
+// which -- unlike unary RPCs -- does not expose its decoded request to a
+// generic stream interceptor, so it records the audit event directly using
+// this same helper to keep the record shape identical.
+func auditKVRequest(s *etcdserver.EtcdServer, ctx context.Context, operation string, req any, start time.Time, err error) {
+	lg := s.Logger()
+	if lg == nil {
+		return
+	}
+
+	outcome := "success"
+	if err != nil {
+		outcome = "failure"
+	}
+
+	lg.Info("kv audit",
+		zap.String("identity", auditIdentity(s, ctx)),
+		zap.String("operation", operation),
+		zap.String("key", auditKeyRange(req)),
+		zap.Duration("duration", time.Since(start)),
+		zap.String("outcome", outcome),
+	)
+}
+
+// auditIdentity returns the authenticated caller identity for the request,
+// or "unauthenticated" if auth is disabled or no identity could be
+// determined.
+func auditIdentity(s *etcdserver.EtcdServer, ctx context.Context) string {
+	authInfo, err := s.AuthInfoFromCtx(ctx)
+	if err != nil || authInfo == nil || authInfo.Username == "" {
+		return "unauthenticated"
+	}
+	return authInfo.Username
+}
+
+// keyGetter and keyRangeGetter match the generated accessors that every
+// current (and, by protobuf convention, future) KV request message with a
+// key or key range exposes. Matching on these interfaces instead of a type
+// switch over concrete request types means a new request message picks up
+// key/range auditing automatically as long as it follows the same
+// convention, without editing this file.
+type keyGetter interface {
+	GetKey() []byte
+}
+
+type keyRangeGetter interface {
+	GetKey() []byte
+	GetRangeEnd() []byte
+}
+
+// auditKeyRange renders the key or key range a request operates over. Value
+// fields are never inspected here, only keys, so auditing cannot change what
+// data is returned to callers or leak values into logs.
+func auditKeyRange(req any) string {
+	switch r := req.(type) {
+	case *pb.TxnRequest:
+		return formatKeyRanges(txnKeyRanges(r))
+	case keyRangeGetter:
+		return formatKeyRange(r.GetKey(), r.GetRangeEnd())
+	case keyGetter:
+		return formatKeyRange(r.GetKey(), nil)
+	default:
+		return ""
+	}
+}
+
+func formatKeyRange(key, rangeEnd []byte) string {
+	if len(rangeEnd) == 0 {
+		return string(key)
+	}
+	return "[" + string(key) + ", " + string(rangeEnd) + ")"
+}
+
+func formatKeyRanges(ranges []string) string {
+	return strings.Join(ranges, "; ")
+}
+
+// txnKeyRanges collects the key/range of every comparison and operation
+// referenced by a (possibly nested) Txn request, so the audit record can
+// describe which keys a transaction touched even though TxnRequest itself
+// has no single top-level key field.
+func txnKeyRanges(r *pb.TxnRequest) []string {
+	var ranges []string
+	for _, c := range r.GetCompare() {
+		ranges = append(ranges, formatKeyRange(c.GetKey(), c.GetRangeEnd()))
+	}
+	ranges = append(ranges, requestOpKeyRanges(r.GetSuccess())...)
+	ranges = append(ranges, requestOpKeyRanges(r.GetFailure())...)
+	return ranges
+}
+
+func requestOpKeyRanges(ops []*pb.RequestOp) []string {
+	var ranges []string
+	for _, op := range ops {
+		switch v := op.GetRequest().(type) {
+		case *pb.RequestOp_RequestRange:
+			ranges = append(ranges, formatKeyRange(v.RequestRange.GetKey(), v.RequestRange.GetRangeEnd()))
+		case *pb.RequestOp_RequestPut:
+			ranges = append(ranges, formatKeyRange(v.RequestPut.GetKey(), nil))
+		case *pb.RequestOp_RequestDeleteRange:
+			ranges = append(ranges, formatKeyRange(v.RequestDeleteRange.GetKey(), v.RequestDeleteRange.GetRangeEnd()))
+		case *pb.RequestOp_RequestTxn:
+			ranges = append(ranges, txnKeyRanges(v.RequestTxn)...)
+		}
+	}
+	return ranges
+}
