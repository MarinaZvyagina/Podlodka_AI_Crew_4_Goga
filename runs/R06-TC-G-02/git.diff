+
+package v3rpc
+
+import (
+	"reflect"
+	"testing"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestKeyRangesOf(t *testing.T) {
+	tests := []struct {
+		name string
+		req  any
+		want []keyRange
+	}{
+		{
+			name: "range with single key",
+			req:  &pb.RangeRequest{Key: []byte("a")},
+			want: []keyRange{{key: []byte("a")}},
+		},
+		{
+			name: "range with range end",
+			req:  &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")},
+			want: []keyRange{{key: []byte("a"), rangeEnd: []byte("z")}},
+		},
+		{
+			name: "put",
+			req:  &pb.PutRequest{Key: []byte("foo"), Value: []byte("bar")},
+			want: []keyRange{{key: []byte("foo")}},
+		},
+		{
+			name: "delete range",
+			req:  &pb.DeleteRangeRequest{Key: []byte("a"), RangeEnd: []byte("b")},
+			want: []keyRange{{key: []byte("a"), rangeEnd: []byte("b")}},
+		},
+		{
+			name: "compact has no keys",
+			req:  &pb.CompactionRequest{Revision: 5},
+			want: nil,
+		},
+		{
+			name: "txn collects compare, success, and failure keys, including nested txns",
+			req: &pb.TxnRequest{
+				Compare: []*pb.Compare{{Key: []byte("c1")}},
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("s1")}}},
+					{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+						Success: []*pb.RequestOp{
+							{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("nested")}}},
+						},
+					}}},
+				},
+				Failure: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("f1"), RangeEnd: []byte("f2")}}},
+				},
+			},
+			want: []keyRange{
+				{key: []byte("c1")},
+				{key: []byte("s1")},
+				{key: []byte("nested")},
+				{key: []byte("f1"), rangeEnd: []byte("f2")},
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := keyRangesOf(tt.req)
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("keyRangesOf() = %+v, want %+v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestFormatKeyRange(t *testing.T) {
+	tests := []struct {
+		name string
+		kr   keyRange
+		want string
+	}{
+		{name: "single key", kr: keyRange{key: []byte("foo")}, want: "foo"},
+		{name: "range", kr: keyRange{key: []byte("a"), rangeEnd: []byte("z")}, want: "[a, z)"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := formatKeyRange(tt.kr); got != tt.want {
+				t.Errorf("formatKeyRange() = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestKVOperationKindsCoverEveryKVMethod(t *testing.T) {
+	for _, m := range pb.KV_ServiceDesc.Methods {
+		if _, ok := kvOperationKinds[m.MethodName]; !ok {
+			t.Errorf("KV method %q has no entry in kvOperationKinds; it will still be audited, but as kind \"unknown\"", m.MethodName)
+		}
+	}
+	for _, s := range pb.KV_ServiceDesc.Streams {
+		if _, ok := kvOperationKinds[s.StreamName]; !ok {
+			t.Errorf("KV stream %q has no entry in kvOperationKinds; it will still be audited, but as kind \"unknown\"", s.StreamName)
+		}
+	}
+}
