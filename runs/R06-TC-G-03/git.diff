+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package v3rpc
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"go.uber.org/zap"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+	"go.etcd.io/etcd/server/v3/etcdserver"
+)
+
+// auditKVServer decorates a KVServer so that every request handled by it
+// produces a uniform audit record: caller identity, operation kind, key or
+// key range, duration, and outcome. Because it wraps the pb.KVServer
+// interface itself, a new method added to that interface without a
+// corresponding case here fails to compile, so no key-value request type can
+// silently go unaudited.
+type auditKVServer struct {
+	pb.KVServer
+	lg *zap.Logger
+	as auth.AuthStore
+}
+
+// NewAuditKVServer wraps kv so every request it handles is audited.
+func NewAuditKVServer(s *etcdserver.EtcdServer, kv pb.KVServer) pb.KVServer {
+	return &auditKVServer{
+		KVServer: kv,
+		lg:       s.Logger(),
+		as:       s.AuthStore(),
+	}
+}
+
+func (s *auditKVServer) Range(ctx context.Context, r *pb.RangeRequest) (*pb.RangeResponse, error) {
+	start := time.Now()
+	resp, err := s.KVServer.Range(ctx, r)
+	s.record(ctx, "read", keyRanges{{r.GetKey(), r.GetRangeEnd()}}, start, err)
+	return resp, err
+}
+
+func (s *auditKVServer) RangeStream(r *pb.RangeRequest, rs pb.KV_RangeStreamServer) error {
+	start := time.Now()
+	err := s.KVServer.RangeStream(r, rs)
+	s.record(rs.Context(), "read", keyRanges{{r.GetKey(), r.GetRangeEnd()}}, start, err)
+	return err
+}
+
+func (s *auditKVServer) Put(ctx context.Context, r *pb.PutRequest) (*pb.PutResponse, error) {
+	start := time.Now()
+	resp, err := s.KVServer.Put(ctx, r)
+	s.record(ctx, "write", keyRanges{{r.GetKey(), nil}}, start, err)
+	return resp, err
+}
+
+func (s *auditKVServer) DeleteRange(ctx context.Context, r *pb.DeleteRangeRequest) (*pb.DeleteRangeResponse, error) {
+	start := time.Now()
+	resp, err := s.KVServer.DeleteRange(ctx, r)
+	s.record(ctx, "delete", keyRanges{{r.GetKey(), r.GetRangeEnd()}}, start, err)
+	return resp, err
+}
+
+func (s *auditKVServer) Txn(ctx context.Context, r *pb.TxnRequest) (*pb.TxnResponse, error) {
+	start := time.Now()
+	resp, err := s.KVServer.Txn(ctx, r)
+	s.record(ctx, "transaction", txnKeyRanges(r), start, err)
+	return resp, err
+}
+
+func (s *auditKVServer) Compact(ctx context.Context, r *pb.CompactionRequest) (*pb.CompactionResponse, error) {
+	start := time.Now()
+	resp, err := s.KVServer.Compact(ctx, r)
+	s.record(ctx, "compact", nil, start, err)
+	return resp, err
+}
+
+// record emits one audit log entry for a completed key-value request.
+func (s *auditKVServer) record(ctx context.Context, operation string, krs keyRanges, start time.Time, err error) {
+	if s.lg == nil {
+		return
+	}
+	s.lg.Info("kv audit",
+		zap.String("identity", s.callerIdentity(ctx)),
+		zap.String("operation", operation),
+		zap.Strings("key", krs.strings()),
+		zap.Duration("duration", time.Since(start)),
+		zap.Bool("success", err == nil),
+	)
+}
+
+// callerIdentity returns the authenticated username for ctx, or
+// "unauthenticated" when auth is disabled or no identity is available.
+func (s *auditKVServer) callerIdentity(ctx context.Context) string {
+	if s.as == nil {
+		return "unauthenticated"
+	}
+	authInfo, err := s.as.AuthInfoFromCtx(ctx)
+	if err != nil || authInfo == nil || authInfo.Username == "" {
+		return "unauthenticated"
+	}
+	return authInfo.Username
+}
+
+// keyRange is a single key (rangeEnd empty) or key range touched by a
+// request.
+type keyRange struct {
+	key, rangeEnd []byte
+}
+
+type keyRanges []keyRange
+
+func (krs keyRanges) strings() []string {
+	out := make([]string, 0, len(krs))
+	for _, kr := range krs {
+		if len(kr.rangeEnd) == 0 {
+			out = append(out, string(kr.key))
+		} else {
+			out = append(out, fmt.Sprintf("[%s, %s)", kr.key, kr.rangeEnd))
+		}
+	}
+	return out
+}
+
+// txnKeyRanges collects every key and key range a (possibly nested) Txn
+// request touches, across its comparisons and both of its branches.
+func txnKeyRanges(r *pb.TxnRequest) keyRanges {
+	var krs keyRanges
+	for _, c := range r.GetCompare() {
+		krs = append(krs, keyRange{c.GetKey(), c.GetRangeEnd()})
+	}
+	krs = append(krs, requestOpKeyRanges(r.GetSuccess())...)
+	krs = append(krs, requestOpKeyRanges(r.GetFailure())...)
+	return krs
+}
+
+func requestOpKeyRanges(ops []*pb.RequestOp) keyRanges {
+	var krs keyRanges
+	for _, op := range ops {
+		switch req := op.GetRequest().(type) {
+		case *pb.RequestOp_RequestRange:
+			krs = append(krs, keyRange{req.RequestRange.GetKey(), req.RequestRange.GetRangeEnd()})
+		case *pb.RequestOp_RequestPut:
+			krs = append(krs, keyRange{req.RequestPut.GetKey(), nil})
+		case *pb.RequestOp_RequestDeleteRange:
+			krs = append(krs, keyRange{req.RequestDeleteRange.GetKey(), req.RequestDeleteRange.GetRangeEnd()})
+		case *pb.RequestOp_RequestTxn:
+			krs = append(krs, txnKeyRanges(req.RequestTxn)...)
+		}
+	}
+	return krs
+}
