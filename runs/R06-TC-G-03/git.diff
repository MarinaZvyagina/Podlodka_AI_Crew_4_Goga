+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package v3rpc
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+	"go.uber.org/zap/zaptest/observer"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+)
+
+// stubKVServer is a minimal pb.KVServer used to observe what the audit
+// decorator forwards to, and to control what it returns.
+type stubKVServer struct {
+	pb.UnimplementedKVServer
+	err error
+}
+
+func (s *stubKVServer) Range(context.Context, *pb.RangeRequest) (*pb.RangeResponse, error) {
+	return &pb.RangeResponse{}, s.err
+}
+
+func (s *stubKVServer) Put(context.Context, *pb.PutRequest) (*pb.PutResponse, error) {
+	return &pb.PutResponse{}, s.err
+}
+
+func (s *stubKVServer) DeleteRange(context.Context, *pb.DeleteRangeRequest) (*pb.DeleteRangeResponse, error) {
+	return &pb.DeleteRangeResponse{}, s.err
+}
+
+func (s *stubKVServer) Txn(context.Context, *pb.TxnRequest) (*pb.TxnResponse, error) {
+	return &pb.TxnResponse{}, s.err
+}
+
+func (s *stubKVServer) Compact(context.Context, *pb.CompactionRequest) (*pb.CompactionResponse, error) {
+	return &pb.CompactionResponse{}, s.err
+}
+
+// fakeAuthStore only overrides AuthInfoFromCtx; any other method panics if
+// called, which the tests below never do.
+type fakeAuthStore struct {
+	auth.AuthStore
+	authInfo *auth.AuthInfo
+	err      error
+}
+
+func (f *fakeAuthStore) AuthInfoFromCtx(context.Context) (*auth.AuthInfo, error) {
+	return f.authInfo, f.err
+}
+
+func newTestAuditServer(t *testing.T, kv pb.KVServer, as auth.AuthStore) (*auditKVServer, *observer.ObservedLogs) {
+	t.Helper()
+	core, logs := observer.New(zap.InfoLevel)
+	return &auditKVServer{KVServer: kv, lg: zap.New(core), as: as}, logs
+}
+
+func TestAuditKVServerRecordsIdentityOperationKeyAndOutcome(t *testing.T) {
+	tests := []struct {
+		name      string
+		authInfo  *auth.AuthInfo
+		authErr   error
+		wantIdent string
+	}{
+		{name: "auth disabled or no identity", wantIdent: "unauthenticated"},
+		{name: "authenticated user", authInfo: &auth.AuthInfo{Username: "alice"}, wantIdent: "alice"},
+		{name: "invalid token treated as unauthenticated", authErr: errors.New("invalid token"), wantIdent: "unauthenticated"},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			stub := &stubKVServer{}
+			s, logs := newTestAuditServer(t, stub, &fakeAuthStore{authInfo: tc.authInfo, err: tc.authErr})
+
+			_, err := s.Put(context.Background(), &pb.PutRequest{Key: []byte("foo")})
+			require.NoError(t, err)
+
+			entries := logs.TakeAll()
+			require.Len(t, entries, 1)
+			fields := entries[0].ContextMap()
+			require.Equal(t, tc.wantIdent, fields["identity"])
+			require.Equal(t, "write", fields["operation"])
+			require.Equal(t, true, fields["success"])
+		})
+	}
+}
+
+func TestAuditKVServerRecordsFailureOutcome(t *testing.T) {
+	stub := &stubKVServer{err: errors.New("boom")}
+	s, logs := newTestAuditServer(t, stub, &fakeAuthStore{})
+
+	_, err := s.Range(context.Background(), &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")})
+	require.Error(t, err)
+
+	entries := logs.TakeAll()
+	require.Len(t, entries, 1)
+	fields := entries[0].ContextMap()
+	require.Equal(t, "read", fields["operation"])
+	require.Equal(t, false, fields["success"])
+}
+
+func TestAuditKVServerRecordsTxnKeyRangesRecursively(t *testing.T) {
+	stub := &stubKVServer{}
+	s, logs := newTestAuditServer(t, stub, &fakeAuthStore{})
+
+	txn := &pb.TxnRequest{
+		Compare: []*pb.Compare{{Key: []byte("cmp")}},
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("p")}}},
+			{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("nested"), RangeEnd: []byte("nestedz")}}},
+				},
+			}}},
+		},
+		Failure: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("d")}}},
+		},
+	}
+
+	_, err := s.Txn(context.Background(), txn)
+	require.NoError(t, err)
+
+	entries := logs.TakeAll()
+	require.Len(t, entries, 1)
+	fields := entries[0].ContextMap()
+	require.Equal(t, "transaction", fields["operation"])
+	require.ElementsMatch(t, []any{"cmp", "p", "[nested, nestedz)", "d"}, fields["key"])
+}
