+package clientv3test
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	clientv3 "go.etcd.io/etcd/client/v3"
+	"go.etcd.io/etcd/tests/v3/framework/integration"
+)
+
+// TestKVAuditLogUnauthenticated verifies that every key-value read, write,
+// delete, and transaction request produces an audit log entry with the
+// caller identity, operation kind, key(s) involved, duration, and outcome,
+// even when authentication is disabled.
+func TestKVAuditLogUnauthenticated(t *testing.T) {
+	integration.BeforeTest(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	cli := clus.Client(0)
+	m := clus.Members[0]
+
+	_, err := cli.Put(t.Context(), "audit-key", "value")
+	require.NoError(t, err)
+	expectMemberLog(t, m, 5*time.Second, `"operation": "write"`, 1)
+	expectMemberLog(t, m, 5*time.Second, `"identity": "unauthenticated"`, 1)
+
+	_, err = cli.Get(t.Context(), "audit-key")
+	require.NoError(t, err)
+	expectMemberLog(t, m, 5*time.Second, `"operation": "read"`, 1)
+
+	_, err = cli.Delete(t.Context(), "audit-key")
+	require.NoError(t, err)
+	expectMemberLog(t, m, 5*time.Second, `"operation": "delete"`, 1)
+
+	_, err = cli.Txn(t.Context()).
+		If(clientv3.Compare(clientv3.CreateRevision("audit-key"), "=", 0)).
+		Then(clientv3.OpPut("audit-key", "txn-value")).
+		Commit()
+	require.NoError(t, err)
+	expectMemberLog(t, m, 5*time.Second, `"operation": "transaction"`, 1)
+
+	lines, err := m.LogObserver.Expect(t.Context(), `"success": true`, 4)
+	require.NoError(t, err)
+	require.Len(t, lines, 4)
+}
+
+// TestKVAuditLogAuthenticated verifies that once authentication is enabled,
+// audit records carry the authenticated caller's username rather than
+// "unauthenticated".
+func TestKVAuditLogAuthenticated(t *testing.T) {
+	integration.BeforeTest(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	m := clus.Members[0]
+	authSetupRoot(t, clus.Client(0).Auth)
+
+	cfg := clientv3.Config{
+		Endpoints:   clus.Client(0).Endpoints(),
+		DialTimeout: 5 * time.Second,
+		Username:    "root",
+		Password:    "123",
+	}
+	authed, err := integration.NewClient(t, cfg)
+	require.NoError(t, err)
+	defer authed.Close()
+
+	_, err = authed.Put(context.Background(), "audit-key", "value")
+	require.NoError(t, err)
+	expectMemberLog(t, m, 5*time.Second, `"identity": "root"`, 1)
+}
+
+func expectMemberLog(t *testing.T, m *integration.Member, timeout time.Duration, s string, count int) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), timeout)
+	defer cancel()
+
+	lines, err := m.LogObserver.Expect(ctx, s, count)
+	require.NoError(t, err)
+	for _, line := range lines {
+		t.Logf("[expected line]: %v", line)
+	}
+}
