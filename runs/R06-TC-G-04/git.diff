+package v3rpc
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"go.uber.org/zap"
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/etcdserver"
+)
+
+// unauthenticatedIdentity is recorded on an audit record when authentication
+// is disabled, when the request carries no token, or when no verifiable
+// identity could otherwise be established for it.
+const unauthenticatedIdentity = "unauthenticated"
+
+// auditKeyRange is a single key, or [key, rangeEnd) range, touched by a
+// key-value request.
+type auditKeyRange struct {
+	Key      []byte
+	RangeEnd []byte
+}
+
+// describeKVRequest recognizes the request messages behind the KV service's
+// read/write/delete/transaction RPCs (Range, Put, DeleteRange, Txn) by their
+// concrete type, independent of which gRPC method or decorator
+// (quota/auth) delivered them. Any request that isn't one of those types is
+// reported as not-a-KV-request so the caller can skip auditing it.
+func describeKVRequest(req any) (operation string, ranges []auditKeyRange, ok bool) {
+	switch r := req.(type) {
+	case *pb.RangeRequest:
+		return "read", []auditKeyRange{{Key: r.GetKey(), RangeEnd: r.GetRangeEnd()}}, true
+	case *pb.PutRequest:
+		return "write", []auditKeyRange{{Key: r.GetKey()}}, true
+	case *pb.DeleteRangeRequest:
+		return "delete", []auditKeyRange{{Key: r.GetKey(), RangeEnd: r.GetRangeEnd()}}, true
+	case *pb.TxnRequest:
+		return "transaction", txnKeyRanges(r), true
+	default:
+		return "", nil, false
+	}
+}
+
+// txnKeyRanges collects every key or key range a transaction touches: the
+// keys compared, plus the keys of every nested success/failure operation
+// (recursing into nested transactions, since RequestOp can itself wrap a
+// TxnRequest).
+func txnKeyRanges(t *pb.TxnRequest) []auditKeyRange {
+	var ranges []auditKeyRange
+	for _, c := range t.GetCompare() {
+		ranges = append(ranges, auditKeyRange{Key: c.GetKey(), RangeEnd: c.GetRangeEnd()})
+	}
+	ranges = append(ranges, requestOpKeyRanges(t.GetSuccess())...)
+	ranges = append(ranges, requestOpKeyRanges(t.GetFailure())...)
+	return ranges
+}
+
+func requestOpKeyRanges(ops []*pb.RequestOp) []auditKeyRange {
+	var ranges []auditKeyRange
+	for _, op := range ops {
+		switch {
+		case op.GetRequestRange() != nil:
+			r := op.GetRequestRange()
+			ranges = append(ranges, auditKeyRange{Key: r.GetKey(), RangeEnd: r.GetRangeEnd()})
+		case op.GetRequestPut() != nil:
+			ranges = append(ranges, auditKeyRange{Key: op.GetRequestPut().GetKey()})
+		case op.GetRequestDeleteRange() != nil:
+			r := op.GetRequestDeleteRange()
+			ranges = append(ranges, auditKeyRange{Key: r.GetKey(), RangeEnd: r.GetRangeEnd()})
+		case op.GetRequestTxn() != nil:
+			ranges = append(ranges, txnKeyRanges(op.GetRequestTxn())...)
+		}
+	}
+	return ranges
+}
+
+// requestorIdentity returns the caller identity for ctx, falling back to
+// unauthenticatedIdentity whenever auth is disabled, the request carries no
+// token, or the token doesn't resolve to a valid identity.
+func requestorIdentity(ctx context.Context, s *etcdserver.EtcdServer) string {
+	authInfo, err := s.AuthStore().AuthInfoFromCtx(ctx)
+	if err != nil || authInfo == nil || authInfo.Username == "" {
+		return unauthenticatedIdentity
+	}
+	return authInfo.Username
+}
+
+// newAuditUnaryInterceptor returns a gRPC unary interceptor that produces
+// exactly one audit record for every key-value read, write, delete, and
+// transaction request the server handles, recording the caller's identity,
+// the operation kind, the key(s)/range(s) involved, how long it took, and
+// whether it succeeded.
+//
+// Coverage comes from recognizing the request message type itself
+// (describeKVRequest), not from a hand-maintained list of RPC methods or
+// per-handler instrumentation, so it stays uniform across every request
+// that flows through this interceptor regardless of which decorators
+// (quota, auth) wrap the underlying KV service. It runs alongside, and does
+// not alter, the existing request-stats/latency-warning logging performed
+// by newLogUnaryInterceptor.
+func newAuditUnaryInterceptor(s *etcdserver.EtcdServer) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		operation, ranges, ok := describeKVRequest(req)
+		if !ok {
+			return handler(ctx, req)
+		}
+
+		start := time.Now()
+		resp, err := handler(ctx, req)
+		duration := time.Since(start)
+
+		if lg := s.Logger(); lg != nil {
+			keys := make([]string, len(ranges))
+			for i, kr := range ranges {
+				if len(kr.RangeEnd) > 0 {
+					keys[i] = fmt.Sprintf("[%q,%q)", kr.Key, kr.RangeEnd)
+				} else {
+					keys[i] = fmt.Sprintf("%q", kr.Key)
+				}
+			}
+
+			lg.Named("audit").Info("kv request audit",
+				zap.String("identity", requestorIdentity(ctx, s)),
+				zap.String("operation", operation),
+				zap.Strings("keys", keys),
+				zap.Duration("duration", duration),
+				zap.Bool("success", err == nil),
+			)
+		}
+
+		return resp, err
+	}
+}
