+package v3rpc
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestDescribeKVRequest(t *testing.T) {
+	tests := []struct {
+		name     string
+		req      any
+		wantOp   string
+		wantOK   bool
+		wantKeys []auditKeyRange
+	}{
+		{
+			name:     "range",
+			req:      &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")},
+			wantOp:   "read",
+			wantOK:   true,
+			wantKeys: []auditKeyRange{{Key: []byte("a"), RangeEnd: []byte("z")}},
+		},
+		{
+			name:     "put",
+			req:      &pb.PutRequest{Key: []byte("a"), Value: []byte("v")},
+			wantOp:   "write",
+			wantOK:   true,
+			wantKeys: []auditKeyRange{{Key: []byte("a")}},
+		},
+		{
+			name:     "delete range",
+			req:      &pb.DeleteRangeRequest{Key: []byte("a"), RangeEnd: []byte("z")},
+			wantOp:   "delete",
+			wantOK:   true,
+			wantKeys: []auditKeyRange{{Key: []byte("a"), RangeEnd: []byte("z")}},
+		},
+		{
+			name: "txn",
+			req: &pb.TxnRequest{
+				Compare: []*pb.Compare{{Key: []byte("cmp")}},
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("succ-put")}}},
+				},
+				Failure: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("fail-range"), RangeEnd: []byte("z")}}},
+				},
+			},
+			wantOp: "transaction",
+			wantOK: true,
+			wantKeys: []auditKeyRange{
+				{Key: []byte("cmp")},
+				{Key: []byte("succ-put")},
+				{Key: []byte("fail-range"), RangeEnd: []byte("z")},
+			},
+		},
+		{
+			name: "nested txn",
+			req: &pb.TxnRequest{
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+						Success: []*pb.RequestOp{
+							{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("nested")}}},
+						},
+					}}},
+				},
+			},
+			wantOp:   "transaction",
+			wantOK:   true,
+			wantKeys: []auditKeyRange{{Key: []byte("nested")}},
+		},
+		{
+			name:   "not a kv request",
+			req:    &pb.LeaseGrantRequest{},
+			wantOp: "",
+			wantOK: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			op, ranges, ok := describeKVRequest(tt.req)
+			require.Equal(t, tt.wantOK, ok)
+			require.Equal(t, tt.wantOp, op)
+			require.Equal(t, tt.wantKeys, ranges)
+		})
+	}
+}
