+package v3rpc
+
+import (
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+	"go.uber.org/zap/zaptest/observer"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestDescribeKVAuditRequest(t *testing.T) {
+	tests := []struct {
+		name        string
+		req         any
+		wantOp      kvAuditOp
+		wantOK      bool
+		wantNumKeys int
+	}{
+		{"range", &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}, kvAuditRead, true, 1},
+		{"put", &pb.PutRequest{Key: []byte("a")}, kvAuditWrite, true, 1},
+		{"delete", &pb.DeleteRangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}, kvAuditDelete, true, 1},
+		{
+			"txn",
+			&pb.TxnRequest{
+				Compare: []*pb.Compare{{Key: []byte("cmp")}},
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("succ-put")}}},
+				},
+				Failure: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("fail-range")}}},
+				},
+			},
+			kvAuditTransaction, true, 3,
+		},
+		{"not kv", &pb.AuthEnableRequest{}, "", false, 0},
+		{"nil", nil, "", false, 0},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			op, keys, ok := describeKVAuditRequest(tt.req)
+			assert.Equal(t, tt.wantOK, ok)
+			assert.Equal(t, tt.wantOp, op)
+			assert.Len(t, keys, tt.wantNumKeys)
+		})
+	}
+}
+
+func TestTxnAuditKeyRangesNested(t *testing.T) {
+	inner := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("nested-del")}}},
+		},
+	}
+	outer := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestTxn{RequestTxn: inner}},
+		},
+	}
+
+	krs := txnAuditKeyRanges(outer)
+	require.Len(t, krs, 1)
+	assert.Equal(t, []byte("nested-del"), krs[0].key)
+}
+
+func TestLogAuditRecord(t *testing.T) {
+	core, logs := observer.New(zap.InfoLevel)
+	lg := zap.New(core)
+
+	logAuditRecord(lg, "alice", kvAuditWrite, auditKeyRanges{{key: []byte("foo")}}, 5*time.Millisecond, nil)
+	logAuditRecord(lg, unauthenticatedCaller, kvAuditDelete, auditKeyRanges{{key: []byte("bar"), rangeEnd: []byte("baz")}}, time.Millisecond, errors.New("boom"))
+
+	entries := logs.All()
+	require.Len(t, entries, 2)
+
+	assertField := func(t *testing.T, fields []zapcore.Field, key string) zapcore.Field {
+		t.Helper()
+		for _, f := range fields {
+			if f.Key == key {
+				return f
+			}
+		}
+		t.Fatalf("field %q not found", key)
+		return zapcore.Field{}
+	}
+
+	success := entries[0]
+	assert.Equal(t, "audit", success.Message)
+	assert.Equal(t, "alice", assertField(t, success.Context, "caller").String)
+	assert.Equal(t, "write", assertField(t, success.Context, "operation").String)
+	assert.Equal(t, "success", assertField(t, success.Context, "outcome").String)
+
+	failure := entries[1]
+	assert.Equal(t, unauthenticatedCaller, assertField(t, failure.Context, "caller").String)
+	assert.Equal(t, "delete", assertField(t, failure.Context, "operation").String)
+	assert.Equal(t, "failure", assertField(t, failure.Context, "outcome").String)
+}
