+package v3rpc
+
+import (
+	"context"
+	"time"
+
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/etcdserver"
+)
+
+// kvAuditOp classifies the kind of key-value operation an audit record describes.
+type kvAuditOp string
+
+const (
+	kvAuditRead        kvAuditOp = "read"
+	kvAuditWrite       kvAuditOp = "write"
+	kvAuditDelete      kvAuditOp = "delete"
+	kvAuditTransaction kvAuditOp = "transaction"
+
+	unauthenticatedCaller = "unauthenticated"
+)
+
+// auditKeyRange is a single key, or [key, rangeEnd) range, touched by a request.
+type auditKeyRange struct {
+	key      []byte
+	rangeEnd []byte
+}
+
+func (kr auditKeyRange) MarshalLogObject(enc zapcore.ObjectEncoder) error {
+	enc.AddByteString("key", kr.key)
+	if len(kr.rangeEnd) > 0 {
+		enc.AddByteString("range_end", kr.rangeEnd)
+	}
+	return nil
+}
+
+type auditKeyRanges []auditKeyRange
+
+func (krs auditKeyRanges) MarshalLogArray(enc zapcore.ArrayEncoder) error {
+	for _, kr := range krs {
+		if err := enc.AppendObject(kr); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// newAuditUnaryInterceptor returns an interceptor that produces a uniform audit
+// record — caller identity, operation kind, key/range, duration, and outcome —
+// for every key-value read, write, delete, and transaction request. Coverage is
+// driven by the shape of the request message rather than per-handler
+// instrumentation, so any request of these kinds is captured automatically, and
+// the interceptor only observes the request/response; it never alters them.
+func newAuditUnaryInterceptor(s *etcdserver.EtcdServer) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		op, keys, ok := describeKVAuditRequest(req)
+		if !ok {
+			return handler(ctx, req)
+		}
+
+		start := time.Now()
+		resp, err := handler(ctx, req)
+
+		if lg := s.Logger(); lg != nil {
+			logAuditRecord(lg, callerIdentity(s, ctx), op, keys, time.Since(start), err)
+		}
+		return resp, err
+	}
+}
+
+func callerIdentity(s *etcdserver.EtcdServer, ctx context.Context) string {
+	authInfo, err := s.AuthInfoFromCtx(ctx)
+	if err != nil || authInfo == nil || authInfo.Username == "" {
+		return unauthenticatedCaller
+	}
+	return authInfo.Username
+}
+
+func logAuditRecord(lg *zap.Logger, caller string, op kvAuditOp, keys auditKeyRanges, duration time.Duration, err error) {
+	outcome := "success"
+	fields := []zap.Field{
+		zap.String("caller", caller),
+		zap.String("operation", string(op)),
+		zap.Array("keys", keys),
+		zap.Duration("duration", duration),
+	}
+	if err != nil {
+		outcome = "failure"
+		fields = append(fields, zap.Error(err))
+	}
+	fields = append(fields, zap.String("outcome", outcome))
+
+	lg.Info("audit", fields...)
+}
+
+// describeKVAuditRequest reports the operation kind and the keys/ranges a
+// key-value request touches. ok is false for any request that is not one of
+// the audited key-value operations.
+func describeKVAuditRequest(req any) (op kvAuditOp, keys auditKeyRanges, ok bool) {
+	switch r := req.(type) {
+	case *pb.RangeRequest:
+		return kvAuditRead, auditKeyRanges{{key: r.GetKey(), rangeEnd: r.GetRangeEnd()}}, true
+	case *pb.PutRequest:
+		return kvAuditWrite, auditKeyRanges{{key: r.GetKey()}}, true
+	case *pb.DeleteRangeRequest:
+		return kvAuditDelete, auditKeyRanges{{key: r.GetKey(), rangeEnd: r.GetRangeEnd()}}, true
+	case *pb.TxnRequest:
+		return kvAuditTransaction, txnAuditKeyRanges(r), true
+	default:
+		return "", nil, false
+	}
+}
+
+func txnAuditKeyRanges(r *pb.TxnRequest) auditKeyRanges {
+	var krs auditKeyRanges
+	for _, c := range r.GetCompare() {
+		krs = append(krs, auditKeyRange{key: c.GetKey(), rangeEnd: c.GetRangeEnd()})
+	}
+	krs = append(krs, requestOpAuditKeyRanges(r.GetSuccess())...)
+	krs = append(krs, requestOpAuditKeyRanges(r.GetFailure())...)
+	return krs
+}
+
+func requestOpAuditKeyRanges(ops []*pb.RequestOp) auditKeyRanges {
+	var krs auditKeyRanges
+	for _, op := range ops {
+		switch {
+		case op.GetRequestRange() != nil:
+			r := op.GetRequestRange()
+			krs = append(krs, auditKeyRange{key: r.GetKey(), rangeEnd: r.GetRangeEnd()})
+		case op.GetRequestPut() != nil:
+			krs = append(krs, auditKeyRange{key: op.GetRequestPut().GetKey()})
+		case op.GetRequestDeleteRange() != nil:
+			r := op.GetRequestDeleteRange()
+			krs = append(krs, auditKeyRange{key: r.GetKey(), rangeEnd: r.GetRangeEnd()})
+		case op.GetRequestTxn() != nil:
+			krs = append(krs, txnAuditKeyRanges(op.GetRequestTxn())...)
+		}
+	}
+	return krs
+}
