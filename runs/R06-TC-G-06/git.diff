+
+package v3rpc
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+	"go.uber.org/zap/zaptest/observer"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+)
+
+// fakeAuthGetter lets tests control the identity returned to the audit
+// decorator without standing up a real EtcdServer/AuthStore.
+type fakeAuthGetter struct {
+	authInfo *auth.AuthInfo
+	err      error
+}
+
+func (f *fakeAuthGetter) AuthInfoFromCtx(context.Context) (*auth.AuthInfo, error) {
+	return f.authInfo, f.err
+}
+
+func (f *fakeAuthGetter) AuthStore() auth.AuthStore { return nil }
+
+// fakeKVServer is a bare-bones pb.KVServer used to observe what the audit
+// decorator does (and does not) change about requests/responses.
+type fakeKVServer struct {
+	pb.UnimplementedKVServer
+
+	rangeResp *pb.RangeResponse
+	putResp   *pb.PutResponse
+	delResp   *pb.DeleteRangeResponse
+	txnResp   *pb.TxnResponse
+	err       error
+}
+
+func (f *fakeKVServer) Range(context.Context, *pb.RangeRequest) (*pb.RangeResponse, error) {
+	return f.rangeResp, f.err
+}
+
+func (f *fakeKVServer) Put(context.Context, *pb.PutRequest) (*pb.PutResponse, error) {
+	return f.putResp, f.err
+}
+
+func (f *fakeKVServer) DeleteRange(context.Context, *pb.DeleteRangeRequest) (*pb.DeleteRangeResponse, error) {
+	return f.delResp, f.err
+}
+
+func (f *fakeKVServer) Txn(context.Context, *pb.TxnRequest) (*pb.TxnResponse, error) {
+	return f.txnResp, f.err
+}
+
+func (f *fakeKVServer) Compact(context.Context, *pb.CompactionRequest) (*pb.CompactionResponse, error) {
+	return nil, f.err
+}
+
+func newObservedAuditServer(kv pb.KVServer, ag AuthGetter) (pb.KVServer, *observer.ObservedLogs) {
+	core, logs := observer.New(zapcore.InfoLevel)
+	return NewAuditKVServer(kv, ag, zap.New(core)), logs
+}
+
+func TestAuditKVServerRecordsEveryOperationKind(t *testing.T) {
+	wantResp := &pb.RangeResponse{}
+	fake := &fakeKVServer{rangeResp: wantResp, putResp: &pb.PutResponse{}, delResp: &pb.DeleteRangeResponse{}, txnResp: &pb.TxnResponse{}}
+	ag := &fakeAuthGetter{authInfo: &auth.AuthInfo{Username: "alice"}}
+	s, logs := newObservedAuditServer(fake, ag)
+
+	resp, err := s.Range(context.Background(), &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")})
+	require.NoError(t, err)
+	assert.Same(t, wantResp, resp, "audit wrapper must not alter the response")
+
+	_, err = s.Put(context.Background(), &pb.PutRequest{Key: []byte("k")})
+	require.NoError(t, err)
+
+	_, err = s.DeleteRange(context.Background(), &pb.DeleteRangeRequest{Key: []byte("k")})
+	require.NoError(t, err)
+
+	_, err = s.Txn(context.Background(), &pb.TxnRequest{
+		Compare: []*pb.Compare{{Key: []byte("c")}},
+		Success: []*pb.RequestOp{{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("s")}}}},
+	})
+	require.NoError(t, err)
+
+	_, err = s.Compact(context.Background(), &pb.CompactionRequest{})
+	require.NoError(t, err)
+
+	entries := logs.All()
+	require.Len(t, entries, 5)
+
+	ops := make([]string, len(entries))
+	for i, e := range entries {
+		ctx := e.ContextMap()
+		assert.Equal(t, "alice", ctx["identity"])
+		assert.Equal(t, "success", ctx["outcome"])
+		ops[i] = ctx["operation"].(string)
+	}
+	assert.Equal(t, []string{"read", "write", "delete", "transaction", "compact"}, ops)
+
+	txnCtx := entries[3].ContextMap()
+	keys, ok := txnCtx["keys"].([]any)
+	require.True(t, ok)
+	assert.ElementsMatch(t, []any{"c", "s"}, keys)
+}
+
+func TestAuditKVServerUnauthenticatedWhenNoIdentity(t *testing.T) {
+	fake := &fakeKVServer{putResp: &pb.PutResponse{}}
+	ag := &fakeAuthGetter{}
+	s, logs := newObservedAuditServer(fake, ag)
+
+	_, err := s.Put(context.Background(), &pb.PutRequest{Key: []byte("k")})
+	require.NoError(t, err)
+
+	require.Len(t, logs.All(), 1)
+	assert.Equal(t, "unauthenticated", logs.All()[0].ContextMap()["identity"])
+}
+
+func TestAuditKVServerRecordsFailureOutcome(t *testing.T) {
+	wantErr := errors.New("boom")
+	fake := &fakeKVServer{err: wantErr}
+	ag := &fakeAuthGetter{}
+	s, logs := newObservedAuditServer(fake, ag)
+
+	_, err := s.Put(context.Background(), &pb.PutRequest{Key: []byte("k")})
+	assert.Equal(t, wantErr, err, "audit wrapper must propagate the underlying error unchanged")
+
+	require.Len(t, logs.All(), 1)
+	assert.Equal(t, "failure", logs.All()[0].ContextMap()["outcome"])
+}
