+package v3rpc
+
+import (
+	"context"
+	"time"
+
+	"go.uber.org/zap"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+// auditKVServer decorates a KV server implementation so that every request it
+// handles produces a compliance audit record, regardless of which method is
+// called. Because the wrapping happens once per interface method here -
+// rather than via a log call hand-written inside each RPC handler - adding,
+// removing, or changing a KV operation cannot silently leave it unaudited:
+// any method that is not overridden below would fail to satisfy pb.KVServer
+// only if it did not already exist on the embedded implementation, and any
+// existing method goes through record() unconditionally.
+type auditKVServer struct {
+	pb.KVServer
+	ag AuthGetter
+	lg *zap.Logger
+}
+
+// NewAuditKVServer wraps kv so that every call produces a structured audit
+// record: caller identity, operation kind, key/range, duration, and outcome.
+// It never inspects or modifies the response, so it cannot change the
+// functional behavior or response content of the wrapped server.
+func NewAuditKVServer(kv pb.KVServer, ag AuthGetter, lg *zap.Logger) pb.KVServer {
+	return &auditKVServer{kv, ag, lg}
+}
+
+func (s *auditKVServer) Range(ctx context.Context, r *pb.RangeRequest) (*pb.RangeResponse, error) {
+	start := time.Now()
+	resp, err := s.KVServer.Range(ctx, r)
+	s.record(ctx, "read", start, err, r.Key, r.RangeEnd)
+	return resp, err
+}
+
+func (s *auditKVServer) RangeStream(r *pb.RangeRequest, rs pb.KV_RangeStreamServer) error {
+	start := time.Now()
+	err := s.KVServer.RangeStream(r, rs)
+	s.record(rs.Context(), "read", start, err, r.Key, r.RangeEnd)
+	return err
+}
+
+func (s *auditKVServer) Put(ctx context.Context, r *pb.PutRequest) (*pb.PutResponse, error) {
+	start := time.Now()
+	resp, err := s.KVServer.Put(ctx, r)
+	s.record(ctx, "write", start, err, r.Key, nil)
+	return resp, err
+}
+
+func (s *auditKVServer) DeleteRange(ctx context.Context, r *pb.DeleteRangeRequest) (*pb.DeleteRangeResponse, error) {
+	start := time.Now()
+	resp, err := s.KVServer.DeleteRange(ctx, r)
+	s.record(ctx, "delete", start, err, r.Key, r.RangeEnd)
+	return resp, err
+}
+
+func (s *auditKVServer) Txn(ctx context.Context, r *pb.TxnRequest) (*pb.TxnResponse, error) {
+	start := time.Now()
+	resp, err := s.KVServer.Txn(ctx, r)
+	s.recordTxn(ctx, start, err, r)
+	return resp, err
+}
+
+func (s *auditKVServer) Compact(ctx context.Context, r *pb.CompactionRequest) (*pb.CompactionResponse, error) {
+	start := time.Now()
+	resp, err := s.KVServer.Compact(ctx, r)
+	s.record(ctx, "compact", start, err, nil, nil)
+	return resp, err
+}
+
+// record emits one audit log entry for a single-key-range operation. It is
+// read-only with respect to ctx and never returns an error, so it cannot
+// affect the result already produced by the wrapped handler.
+func (s *auditKVServer) record(ctx context.Context, op string, start time.Time, err error, key, rangeEnd []byte) {
+	fields := []zap.Field{zap.ByteString("key", key)}
+	if len(rangeEnd) > 0 {
+		fields = append(fields, zap.ByteString("range-end", rangeEnd))
+	}
+	s.emit(ctx, op, start, err, fields)
+}
+
+// recordTxn emits one audit log entry covering every key and range touched
+// anywhere in a (possibly nested) transaction, by comparisons as well as by
+// the success/failure branches.
+func (s *auditKVServer) recordTxn(ctx context.Context, start time.Time, err error, r *pb.TxnRequest) {
+	var keys []string
+	collectTxnKeys(r, &keys)
+	s.emit(ctx, "transaction", start, err, []zap.Field{zap.Strings("keys", keys)})
+}
+
+func (s *auditKVServer) emit(ctx context.Context, op string, start time.Time, err error, fields []zap.Field) {
+	if s.lg == nil {
+		return
+	}
+	identity := "unauthenticated"
+	if authInfo, authErr := s.ag.AuthInfoFromCtx(ctx); authErr == nil && authInfo != nil && authInfo.Username != "" {
+		identity = authInfo.Username
+	}
+	outcome := "success"
+	if err != nil {
+		outcome = "failure"
+	}
+	allFields := append([]zap.Field{
+		zap.String("identity", identity),
+		zap.String("operation", op),
+	}, fields...)
+	allFields = append(allFields,
+		zap.Duration("duration", time.Since(start)),
+		zap.String("outcome", outcome),
+	)
+	s.lg.Info("kv audit", allFields...)
+}
+
+// collectTxnKeys walks a transaction's comparisons and both branches
+// (recursing into any nested transactions) and appends a human-readable
+// key or [key, range-end) entry for everything it finds.
+func collectTxnKeys(r *pb.TxnRequest, out *[]string) {
+	for _, c := range r.GetCompare() {
+		*out = append(*out, formatKeyRange(c.GetKey(), c.GetRangeEnd()))
+	}
+	for _, op := range r.GetSuccess() {
+		collectRequestOpKeys(op, out)
+	}
+	for _, op := range r.GetFailure() {
+		collectRequestOpKeys(op, out)
+	}
+}
+
+func collectRequestOpKeys(op *pb.RequestOp, out *[]string) {
+	switch req := op.GetRequest().(type) {
+	case *pb.RequestOp_RequestRange:
+		*out = append(*out, formatKeyRange(req.RequestRange.GetKey(), req.RequestRange.GetRangeEnd()))
+	case *pb.RequestOp_RequestPut:
+		*out = append(*out, formatKeyRange(req.RequestPut.GetKey(), nil))
+	case *pb.RequestOp_RequestDeleteRange:
+		*out = append(*out, formatKeyRange(req.RequestDeleteRange.GetKey(), req.RequestDeleteRange.GetRangeEnd()))
+	case *pb.RequestOp_RequestTxn:
+		collectTxnKeys(req.RequestTxn, out)
+	}
+}
+
+func formatKeyRange(key, rangeEnd []byte) string {
+	if len(rangeEnd) == 0 {
+		return string(key)
+	}
+	return "[" + string(key) + ", " + string(rangeEnd) + ")"
+}
