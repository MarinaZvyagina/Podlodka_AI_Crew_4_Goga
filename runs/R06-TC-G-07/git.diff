+// limitations under the License.
+
+package v3rpc
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	"go.uber.org/zap"
+	"google.golang.org/grpc"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/reflect/protoreflect"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/etcdserver"
+)
+
+// kvServiceMethodPrefix identifies every RPC belonging to the KV service, e.g.
+// "/etcdserverpb.KV/Range". Dispatching on this prefix rather than on
+// individual method names or request types means any request added to the KV
+// service in the future is audited automatically, without requiring this
+// file to be updated.
+var kvServiceMethodPrefix = "/" + pb.KV_ServiceDesc.ServiceName + "/"
+
+// kvOperationKinds maps well-known KV methods to the operation kind recorded
+// in the audit trail. Methods that aren't listed here (e.g. a new KV RPC)
+// still get audited, using the method name itself as the operation kind.
+var kvOperationKinds = map[string]string{
+	pb.KV_Range_FullMethodName:       "read",
+	pb.KV_Put_FullMethodName:         "write",
+	pb.KV_DeleteRange_FullMethodName: "delete",
+	pb.KV_Txn_FullMethodName:         "transaction",
+}
+
+// newAuditUnaryInterceptor returns an interceptor that produces a uniform
+// audit record for every key-value request handled by the server: caller
+// identity, operation kind, key or key range, duration, and outcome. It is
+// dispatched purely on the gRPC method's service, so newly added KV request
+// types are covered without any per-type instrumentation.
+func newAuditUnaryInterceptor(s *etcdserver.EtcdServer) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		if !strings.HasPrefix(info.FullMethod, kvServiceMethodPrefix) {
+			return handler(ctx, req)
+		}
+
+		start := time.Now()
+		resp, err := handler(ctx, req)
+		duration := time.Since(start)
+
+		lg := s.Logger()
+		if lg == nil {
+			return resp, err
+		}
+
+		fields := []zap.Field{
+			zap.String("identity", callerIdentity(s, ctx)),
+			zap.String("operation", auditOperationKind(info.FullMethod)),
+			zap.Strings("key", auditKeyRanges(info.FullMethod, req)),
+			zap.Duration("duration", duration),
+			zap.Bool("success", err == nil),
+		}
+		if err != nil {
+			fields = append(fields, zap.Error(err))
+		}
+		lg.Info("kv audit", fields...)
+
+		return resp, err
+	}
+}
+
+// callerIdentity returns the authenticated username for the request, or
+// "unauthenticated" when auth is disabled or no identity is available.
+func callerIdentity(s *etcdserver.EtcdServer, ctx context.Context) string {
+	authInfo, err := s.AuthInfoFromCtx(ctx)
+	if err != nil || authInfo == nil || authInfo.Username == "" {
+		return "unauthenticated"
+	}
+	return authInfo.Username
+}
+
+func auditOperationKind(fullMethod string) string {
+	if kind, ok := kvOperationKinds[fullMethod]; ok {
+		return kind
+	}
+	return strings.TrimPrefix(fullMethod, kvServiceMethodPrefix)
+}
+
+// auditKeyRanges returns a human-readable description of every key or key
+// range touched by req. Most KV requests carry a single "key"/"range_end"
+// pair, which is extracted generically via reflection so future request
+// types are covered without changes here. Txn requests are traversed
+// explicitly since they can reference many keys across nested operations.
+func auditKeyRanges(fullMethod string, req any) []string {
+	if fullMethod == pb.KV_Txn_FullMethodName {
+		if txn, ok := req.(*pb.TxnRequest); ok {
+			return formatKeyRanges(collectTxnKeyRanges(txn))
+		}
+		return nil
+	}
+	if key, rangeEnd, ok := extractKeyRange(req); ok {
+		return formatKeyRanges([]auditKeyRange{{key: key, rangeEnd: rangeEnd}})
+	}
+	return nil
+}
+
+type auditKeyRange struct {
+	key      []byte
+	rangeEnd []byte
+}
+
+// extractKeyRange reads "key" and "range_end" byte fields off req via proto
+// reflection, so any request message shaped like the common KV requests is
+// handled without a type-specific case.
+func extractKeyRange(req any) (key, rangeEnd []byte, ok bool) {
+	msg, isProtoMsg := req.(proto.Message)
+	if !isProtoMsg {
+		return nil, nil, false
+	}
+	fields := msg.ProtoReflect().Descriptor().Fields()
+	keyField := fields.ByName("key")
+	if keyField == nil || keyField.Kind() != protoreflect.BytesKind {
+		return nil, nil, false
+	}
+	key = msg.ProtoReflect().Get(keyField).Bytes()
+	if rangeEndField := fields.ByName("range_end"); rangeEndField != nil && rangeEndField.Kind() == protoreflect.BytesKind {
+		rangeEnd = msg.ProtoReflect().Get(rangeEndField).Bytes()
+	}
+	return key, rangeEnd, true
+}
+
+func collectTxnKeyRanges(txn *pb.TxnRequest) []auditKeyRange {
+	var out []auditKeyRange
+	for _, c := range txn.GetCompare() {
+		out = append(out, auditKeyRange{key: c.GetKey()})
+	}
+	for _, op := range txn.GetSuccess() {
+		out = append(out, collectRequestOpKeyRanges(op)...)
+	}
+	for _, op := range txn.GetFailure() {
+		out = append(out, collectRequestOpKeyRanges(op)...)
+	}
+	return out
+}
+
+func collectRequestOpKeyRanges(op *pb.RequestOp) []auditKeyRange {
+	switch r := op.GetRequest().(type) {
+	case *pb.RequestOp_RequestRange:
+		return []auditKeyRange{{key: r.RequestRange.GetKey(), rangeEnd: r.RequestRange.GetRangeEnd()}}
+	case *pb.RequestOp_RequestPut:
+		return []auditKeyRange{{key: r.RequestPut.GetKey()}}
+	case *pb.RequestOp_RequestDeleteRange:
+		return []auditKeyRange{{key: r.RequestDeleteRange.GetKey(), rangeEnd: r.RequestDeleteRange.GetRangeEnd()}}
+	case *pb.RequestOp_RequestTxn:
+		return collectTxnKeyRanges(r.RequestTxn)
+	default:
+		return nil
+	}
+}
+
+func formatKeyRanges(krs []auditKeyRange) []string {
+	if len(krs) == 0 {
+		return nil
+	}
+	out := make([]string, 0, len(krs))
+	for _, kr := range krs {
+		if len(kr.rangeEnd) == 0 {
+			out = append(out, string(kr.key))
+			continue
+		}
+		out = append(out, fmt.Sprintf("[%s, %s)", kr.key, kr.rangeEnd))
+	}
+	return out
+}
