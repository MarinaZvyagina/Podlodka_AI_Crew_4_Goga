+
+package v3rpc
+
+import (
+	"testing"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestAuditOperationKind(t *testing.T) {
+	tests := []struct {
+		method string
+		want   string
+	}{
+		{pb.KV_Range_FullMethodName, "read"},
+		{pb.KV_Put_FullMethodName, "write"},
+		{pb.KV_DeleteRange_FullMethodName, "delete"},
+		{pb.KV_Txn_FullMethodName, "transaction"},
+		{pb.KV_Compact_FullMethodName, "Compact"},
+		{"/etcdserverpb.KV/SomeFutureMethod", "SomeFutureMethod"},
+	}
+	for _, tt := range tests {
+		if got := auditOperationKind(tt.method); got != tt.want {
+			t.Errorf("auditOperationKind(%q) = %q, want %q", tt.method, got, tt.want)
+		}
+	}
+}
+
+func TestAuditKeyRangesSimpleRequests(t *testing.T) {
+	tests := []struct {
+		name   string
+		method string
+		req    any
+		want   []string
+	}{
+		{
+			name:   "range without range_end",
+			method: pb.KV_Range_FullMethodName,
+			req:    &pb.RangeRequest{Key: []byte("foo")},
+			want:   []string{"foo"},
+		},
+		{
+			name:   "range with range_end",
+			method: pb.KV_Range_FullMethodName,
+			req:    &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")},
+			want:   []string{"[a, z)"},
+		},
+		{
+			name:   "put",
+			method: pb.KV_Put_FullMethodName,
+			req:    &pb.PutRequest{Key: []byte("foo"), Value: []byte("bar")},
+			want:   []string{"foo"},
+		},
+		{
+			name:   "delete range",
+			method: pb.KV_DeleteRange_FullMethodName,
+			req:    &pb.DeleteRangeRequest{Key: []byte("a"), RangeEnd: []byte("b")},
+			want:   []string{"[a, b)"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := auditKeyRanges(tt.method, tt.req)
+			if len(got) != len(tt.want) {
+				t.Fatalf("auditKeyRanges() = %v, want %v", got, tt.want)
+			}
+			for i := range got {
+				if got[i] != tt.want[i] {
+					t.Errorf("auditKeyRanges()[%d] = %q, want %q", i, got[i], tt.want[i])
+				}
+			}
+		})
+	}
+}
+
+func TestAuditKeyRangesTxn(t *testing.T) {
+	txn := &pb.TxnRequest{
+		Compare: []*pb.Compare{
+			{Key: []byte("cmpkey")},
+		},
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("putkey")}}},
+			{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}}},
+				},
+			}}},
+		},
+		Failure: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("delkey")}}},
+		},
+	}
+
+	got := auditKeyRanges(pb.KV_Txn_FullMethodName, txn)
+	want := []string{"cmpkey", "putkey", "[a, z)", "delkey"}
+	if len(got) != len(want) {
+		t.Fatalf("auditKeyRanges() = %v, want %v", got, want)
+	}
+	for i := range got {
+		if got[i] != want[i] {
+			t.Errorf("auditKeyRanges()[%d] = %q, want %q", i, got[i], want[i])
+		}
+	}
+}
