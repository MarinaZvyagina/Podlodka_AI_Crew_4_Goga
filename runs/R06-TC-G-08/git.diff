+
+package v3rpc
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestSplitFullMethod(t *testing.T) {
+	tests := []struct {
+		fullMethod  string
+		wantService string
+		wantMethod  string
+	}{
+		{"/etcdserverpb.KV/Range", "etcdserverpb.KV", "Range"},
+		{"/etcdserverpb.KV/Put", "etcdserverpb.KV", "Put"},
+		{"/etcdserverpb.Maintenance/Snapshot", "etcdserverpb.Maintenance", "Snapshot"},
+		{"NoSlashes", "", "NoSlashes"},
+	}
+	for _, tt := range tests {
+		service, method := splitFullMethod(tt.fullMethod)
+		assert.Equal(t, tt.wantService, service, tt.fullMethod)
+		assert.Equal(t, tt.wantMethod, method, tt.fullMethod)
+	}
+}
+
+func TestAuditOperationKindFallback(t *testing.T) {
+	// Known KV methods map to the compliance vocabulary.
+	assert.Equal(t, "read", auditOperationKinds["Range"])
+	assert.Equal(t, "write", auditOperationKinds["Put"])
+	assert.Equal(t, "delete", auditOperationKinds["DeleteRange"])
+	assert.Equal(t, "transaction", auditOperationKinds["Txn"])
+
+	// A hypothetical future KV method with no explicit mapping still
+	// resolves to a usable operation kind via logKVAudit's fallback logic
+	// (lower-cased method name), so no request type is silently dropped.
+	_, ok := auditOperationKinds["Increment"]
+	assert.False(t, ok)
+}
+
+func TestAuditKeyRangeSimpleRequests(t *testing.T) {
+	key, rangeEnd, ok := auditKeyRange(&pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")})
+	assert.True(t, ok)
+	assert.Equal(t, "a", key)
+	assert.Equal(t, "z", rangeEnd)
+
+	key, rangeEnd, ok = auditKeyRange(&pb.PutRequest{Key: []byte("foo"), Value: []byte("secret")})
+	assert.True(t, ok)
+	assert.Equal(t, "foo", key)
+	assert.Empty(t, rangeEnd)
+
+	key, rangeEnd, ok = auditKeyRange(&pb.DeleteRangeRequest{Key: []byte("bar"), RangeEnd: []byte("baz")})
+	assert.True(t, ok)
+	assert.Equal(t, "bar", key)
+	assert.Equal(t, "baz", rangeEnd)
+
+	// A request type with no key-like fields is not audited with a key.
+	_, _, ok = auditKeyRange(&pb.CompactionRequest{Revision: 1})
+	assert.False(t, ok)
+}
+
+func TestAuditKeyRangePutValueIsNotLeaked(t *testing.T) {
+	key, _, ok := auditKeyRange(&pb.PutRequest{Key: []byte("foo"), Value: []byte("super-secret-value")})
+	assert.True(t, ok)
+	assert.Equal(t, "foo", key)
+	assert.NotContains(t, key, "super-secret-value")
+}
+
+func TestAuditKeyRangeTxn(t *testing.T) {
+	txn := &pb.TxnRequest{
+		Compare: []*pb.Compare{
+			{Key: []byte("c1")},
+		},
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("p1")}}},
+			{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("r1"), RangeEnd: []byte("r2")}}},
+		},
+		Failure: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("d1")}}},
+		},
+	}
+
+	key, rangeEnd, ok := auditKeyRange(txn)
+	assert.True(t, ok)
+	assert.Empty(t, rangeEnd)
+	assert.Equal(t, "c1, p1, [r1, r2), d1", key)
+}
+
+func TestAuditKeyRangeNestedTxn(t *testing.T) {
+	inner := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("nested")}}},
+		},
+	}
+	outer := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestTxn{RequestTxn: inner}},
+		},
+	}
+
+	key, _, ok := auditKeyRange(outer)
+	assert.True(t, ok)
+	assert.Equal(t, "nested", key)
+}
+
+func TestAuditKeyRangeEmptyTxn(t *testing.T) {
+	_, _, ok := auditKeyRange(&pb.TxnRequest{})
+	assert.False(t, ok)
+}
