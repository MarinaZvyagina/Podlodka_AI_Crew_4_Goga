+package v3rpc
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	"go.uber.org/zap"
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/etcdserver"
+)
+
+// kvServiceName is the gRPC service name (as it appears in
+// grpc.UnaryServerInfo.FullMethod) that every key-value read, write, delete
+// and transaction request is dispatched through. Any method added to the KV
+// service in the future automatically flows through newAuditUnaryInterceptor
+// without further changes here.
+const kvServiceName = "etcdserverpb.KV"
+
+// auditOperationKinds maps KV service method names to the operation kind
+// vocabulary compliance expects. A method that is not listed here (e.g. a
+// future addition to the KV service) still gets audited: its lower-cased
+// method name is used as the operation kind so no request type is ever
+// silently skipped.
+var auditOperationKinds = map[string]string{
+	"Range":       "read",
+	"Put":         "write",
+	"DeleteRange": "delete",
+	"Txn":         "transaction",
+}
+
+// auditMaxTxnDepth bounds recursion into nested transactions so a
+// maliciously deep Txn request cannot exhaust the stack while formatting an
+// audit record.
+const auditMaxTxnDepth = 64
+
+// auditKeyer and auditRangeKeyer are satisfied by every generated KV request
+// message that carries a key (and, for range-shaped requests, a range end).
+// Matching against these interfaces rather than concrete request types means
+// any new KV request message that follows the existing "key"/"range_end"
+// field convention is picked up automatically.
+type auditKeyer interface {
+	GetKey() []byte
+}
+
+type auditRangeKeyer interface {
+	GetKey() []byte
+	GetRangeEnd() []byte
+}
+
+// newAuditUnaryInterceptor returns a unary interceptor that produces a
+// compliance audit record for every key-value read, write, delete and
+// transaction request handled by the server: caller identity, operation
+// kind, key/key range, duration, and outcome. It wraps the whole handler
+// chain (including auth and capability checks) without altering the
+// response returned to the client, and applies uniformly to any request
+// routed through the KV service so new request types cannot be missed by
+// forgetting to instrument them individually.
+func newAuditUnaryInterceptor(s *etcdserver.EtcdServer) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		service, method := splitFullMethod(info.FullMethod)
+		if service != kvServiceName {
+			return handler(ctx, req)
+		}
+
+		startTime := time.Now()
+		resp, err := handler(ctx, req)
+
+		lg := s.Logger()
+		if lg != nil {
+			logKVAudit(lg, s, ctx, method, req, startTime, err)
+		}
+		return resp, err
+	}
+}
+
+func logKVAudit(lg *zap.Logger, s *etcdserver.EtcdServer, ctx context.Context, method string, req any, startTime time.Time, err error) {
+	operation, ok := auditOperationKinds[method]
+	if !ok {
+		operation = strings.ToLower(method)
+	}
+
+	outcome := "success"
+	if err != nil {
+		outcome = "failure"
+	}
+
+	fields := []zap.Field{
+		zap.String("caller", auditCallerIdentity(s, ctx)),
+		zap.String("operation", operation),
+		zap.Duration("duration", time.Since(startTime)),
+		zap.String("outcome", outcome),
+	}
+	if key, rangeEnd, ok := auditKeyRange(req); ok {
+		fields = append(fields, zap.String("key", key))
+		if rangeEnd != "" {
+			fields = append(fields, zap.String("range_end", rangeEnd))
+		}
+	}
+
+	lg.Info("kv audit", fields...)
+}
+
+// auditCallerIdentity returns the authenticated username for the request,
+// or "unauthenticated" when auth is disabled, no token was presented, or the
+// identity otherwise cannot be resolved. It never returns an error: identity
+// resolution must not affect whether the underlying operation succeeds.
+func auditCallerIdentity(s *etcdserver.EtcdServer, ctx context.Context) string {
+	authInfo, err := s.AuthInfoFromCtx(ctx)
+	if err != nil || authInfo == nil || authInfo.Username == "" {
+		return "unauthenticated"
+	}
+	return authInfo.Username
+}
+
+// auditKeyRange extracts the key (and, if present, range end) that a KV
+// request operates on. Simple requests are matched structurally via
+// auditKeyer/auditRangeKeyer; TxnRequest, which has no single key, is
+// unpacked into the comma-separated list of keys/ranges its compares and
+// nested operations touch.
+func auditKeyRange(req any) (key, rangeEnd string, ok bool) {
+	if txn, isTxn := req.(*pb.TxnRequest); isTxn {
+		keys := collectTxnKeys(txn, 0)
+		if len(keys) == 0 {
+			return "", "", false
+		}
+		return strings.Join(keys, ", "), "", true
+	}
+	if rk, isRangeKeyer := req.(auditRangeKeyer); isRangeKeyer {
+		return string(rk.GetKey()), string(rk.GetRangeEnd()), true
+	}
+	if k, isKeyer := req.(auditKeyer); isKeyer {
+		return string(k.GetKey()), "", true
+	}
+	return "", "", false
+}
+
+func collectTxnKeys(txn *pb.TxnRequest, depth int) []string {
+	if txn == nil || depth > auditMaxTxnDepth {
+		return nil
+	}
+	var keys []string
+	for _, c := range txn.GetCompare() {
+		keys = append(keys, formatKeyRange(c.GetKey(), c.GetRangeEnd()))
+	}
+	for _, op := range txn.GetSuccess() {
+		keys = append(keys, collectRequestOpKeys(op, depth)...)
+	}
+	for _, op := range txn.GetFailure() {
+		keys = append(keys, collectRequestOpKeys(op, depth)...)
+	}
+	return keys
+}
+
+func collectRequestOpKeys(op *pb.RequestOp, depth int) []string {
+	switch r := op.GetRequest().(type) {
+	case *pb.RequestOp_RequestRange:
+		return []string{formatKeyRange(r.RequestRange.GetKey(), r.RequestRange.GetRangeEnd())}
+	case *pb.RequestOp_RequestPut:
+		return []string{formatKeyRange(r.RequestPut.GetKey(), nil)}
+	case *pb.RequestOp_RequestDeleteRange:
+		return []string{formatKeyRange(r.RequestDeleteRange.GetKey(), r.RequestDeleteRange.GetRangeEnd())}
+	case *pb.RequestOp_RequestTxn:
+		return collectTxnKeys(r.RequestTxn, depth+1)
+	default:
+		return nil
+	}
+}
+
+func formatKeyRange(key, rangeEnd []byte) string {
+	if len(rangeEnd) == 0 {
+		return string(key)
+	}
+	return fmt.Sprintf("[%s, %s)", key, rangeEnd)
+}
+
+// splitFullMethod splits a gRPC FullMethod of the form "/service/method"
+// into its service and method components.
+func splitFullMethod(fullMethod string) (service, method string) {
+	fullMethod = strings.TrimPrefix(fullMethod, "/")
+	if i := strings.LastIndex(fullMethod, "/"); i >= 0 {
+		return fullMethod[:i], fullMethod[i+1:]
+	}
+	return "", fullMethod
+}
