+
+package v3rpc
+
+import (
+	"strings"
+	"testing"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestAuditOperationForMethod(t *testing.T) {
+	tests := []struct {
+		method string
+		want   auditOperation
+	}{
+		{pb.KV_Range_FullMethodName, auditOperationRead},
+		{pb.KV_RangeStream_FullMethodName, auditOperationRead},
+		{pb.KV_Put_FullMethodName, auditOperationWrite},
+		{pb.KV_DeleteRange_FullMethodName, auditOperationDelete},
+		{pb.KV_Txn_FullMethodName, auditOperationTransaction},
+		{pb.KV_Compact_FullMethodName, auditOperationOther},
+		{"/etcdserverpb.KV/SomeFutureMethod", auditOperationOther},
+	}
+	for _, tt := range tests {
+		if got := auditOperationForMethod(tt.method); got != tt.want {
+			t.Errorf("auditOperationForMethod(%q) = %q, want %q", tt.method, got, tt.want)
+		}
+	}
+}
+
+func TestAuditKeyRangeForRequest(t *testing.T) {
+	tests := []struct {
+		name string
+		req  any
+		want string
+	}{
+		{
+			name: "range single key",
+			req:  &pb.RangeRequest{Key: []byte("foo")},
+			want: `"foo"`,
+		},
+		{
+			name: "range with range end",
+			req:  &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")},
+			want: `["a", "z")`,
+		},
+		{
+			name: "put never includes the value",
+			req:  &pb.PutRequest{Key: []byte("foo"), Value: []byte("super-secret-value")},
+			want: `"foo"`,
+		},
+		{
+			name: "delete range",
+			req:  &pb.DeleteRangeRequest{Key: []byte("a"), RangeEnd: []byte("z")},
+			want: `["a", "z")`,
+		},
+		{
+			name: "compact has no key",
+			req:  &pb.CompactionRequest{Revision: 5},
+			want: "n/a",
+		},
+		{
+			name: "txn aggregates compare and branch keys",
+			req: &pb.TxnRequest{
+				Compare: []*pb.Compare{{Key: []byte("c1")}},
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("s1"), Value: []byte("secret")}}},
+				},
+				Failure: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("f1")}}},
+				},
+			},
+			want: `"c1", "s1", "f1"`,
+		},
+		{
+			name: "txn recurses into nested txn ops",
+			req: &pb.TxnRequest{
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+						Success: []*pb.RequestOp{
+							{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("nested")}}},
+						},
+					}}},
+				},
+			},
+			want: `"nested"`,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := auditKeyRangeForRequest(tt.req); got != tt.want {
+				t.Errorf("auditKeyRangeForRequest() = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestAuditKeyRangeForRequestNeverLeaksValue(t *testing.T) {
+	req := &pb.PutRequest{Key: []byte("k"), Value: []byte("top-secret")}
+	if got := auditKeyRangeForRequest(req); strings.Contains(got, "top-secret") {
+		t.Errorf("auditKeyRangeForRequest() = %q, must not contain the value", got)
+	}
+}
+
+func TestFormatKeyRangesDedupsAndCaps(t *testing.T) {
+	ranges := make([]keyRange, 0, maxAuditKeysLogged+5)
+	for i := 0; i < maxAuditKeysLogged+5; i++ {
+		ranges = append(ranges, keyRange{key: []byte{byte(i)}})
+	}
+	// duplicate the first entry; it must not be counted twice or inflate the "+N more" tail.
+	ranges = append(ranges, keyRange{key: []byte{0}})
+
+	got := formatKeyRanges(ranges)
+	wantParts := maxAuditKeysLogged
+	if n := strings.Count(got, ","); n != wantParts { // wantParts-1 separators + 1 for the "+N more" tail
+		t.Errorf("formatKeyRanges() = %q, want %d comma-separated segments, got %d", got, wantParts, n)
+	}
+	if !strings.HasSuffix(got, "+5 more") {
+		t.Errorf("formatKeyRanges() = %q, want suffix %q", got, "+5 more")
+	}
+}
+
+// fakeKeyRequest stands in for a hypothetical future KV request type: it isn't one of
+// the cases audit.go switches on explicitly, but follows the standard generated
+// GetKey/GetRangeEnd accessor shape.
+type fakeKeyRequest struct {
+	key      []byte
+	rangeEnd []byte
+}
+
+func (f fakeKeyRequest) GetKey() []byte      { return f.key }
+func (f fakeKeyRequest) GetRangeEnd() []byte { return f.rangeEnd }
+
+func TestAuditKeyRangeForRequestGenericFallback(t *testing.T) {
+	if got := auditKeyRangeForRequest(fakeKeyRequest{key: []byte("generic")}); got != `"generic"` {
+		t.Errorf("auditKeyRangeForRequest() = %q, want %q", got, `"generic"`)
+	}
+	if got := auditKeyRangeForRequest(fakeKeyRequest{key: []byte("a"), rangeEnd: []byte("z")}); got != `["a", "z")` {
+		t.Errorf("auditKeyRangeForRequest() = %q, want %q", got, `["a", "z")`)
+	}
+	if got := auditKeyRangeForRequest(struct{}{}); got != "n/a" {
+		t.Errorf("auditKeyRangeForRequest() = %q, want %q", got, "n/a")
+	}
+}
