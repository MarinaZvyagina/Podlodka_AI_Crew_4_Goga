+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package v3rpc
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	"go.uber.org/zap"
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/etcdserver"
+)
+
+// kvServicePrefix matches the gRPC full method name of every RPC belonging to the KV
+// service, present or future (e.g. "/etcdserverpb.KV/Range"). Auditing by service
+// prefix instead of enumerating individual method names is what makes coverage
+// uniform: any KV RPC added to the proto service later is audited automatically, with
+// no change required here.
+var kvServicePrefix = "/" + pb.KV_ServiceDesc.ServiceName + "/"
+
+// auditOperation classifies a KV request for the compliance audit trail.
+type auditOperation string
+
+const (
+	auditOperationRead        auditOperation = "read"
+	auditOperationWrite       auditOperation = "write"
+	auditOperationDelete      auditOperation = "delete"
+	auditOperationTransaction auditOperation = "transaction"
+	// auditOperationOther covers any KV RPC that isn't one of the well-known
+	// operations above (e.g. Compact, or a method added after this file was
+	// written). It is still audited uniformly -- only the label is generic.
+	auditOperationOther auditOperation = "other"
+
+	// maxAuditKeysLogged bounds how many distinct key ranges are rendered for a
+	// single audit record (relevant mainly to Txn requests, which may touch many
+	// keys), so the audit trail can't be used to force unbounded log lines.
+	maxAuditKeysLogged = 10
+)
+
+func auditOperationForMethod(fullMethod string) auditOperation {
+	switch fullMethod {
+	case pb.KV_Range_FullMethodName, pb.KV_RangeStream_FullMethodName:
+		return auditOperationRead
+	case pb.KV_Put_FullMethodName:
+		return auditOperationWrite
+	case pb.KV_DeleteRange_FullMethodName:
+		return auditOperationDelete
+	case pb.KV_Txn_FullMethodName:
+		return auditOperationTransaction
+	default:
+		return auditOperationOther
+	}
+}
+
+// newAuditUnaryInterceptor returns an interceptor that records one compliance audit
+// entry for every unary request handled by the KV service -- Range, Put, DeleteRange,
+// Txn, and any KV RPC added later -- regardless of whether it succeeds or fails. It
+// only observes the request and response to build the audit record; it never mutates
+// either, so it cannot change the behavior or response content of the underlying
+// operation.
+func newAuditUnaryInterceptor(s *etcdserver.EtcdServer) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		if !strings.HasPrefix(info.FullMethod, kvServicePrefix) {
+			return handler(ctx, req)
+		}
+
+		start := time.Now()
+		resp, err := handler(ctx, req)
+		duration := time.Since(start)
+
+		lg := s.Logger()
+		if lg == nil {
+			return resp, err
+		}
+
+		identity := "unauthenticated"
+		if authInfo, aerr := s.AuthStore().AuthInfoFromCtx(ctx); aerr == nil && authInfo != nil && authInfo.Username != "" {
+			identity = authInfo.Username
+		}
+
+		fields := []zap.Field{
+			zap.String("identity", identity),
+			zap.String("operation", string(auditOperationForMethod(info.FullMethod))),
+			zap.String("method", info.FullMethod),
+			zap.String("key", auditKeyRangeForRequest(req)),
+			zap.Duration("duration", duration),
+		}
+		if err != nil {
+			fields = append(fields, zap.String("outcome", "failure"), zap.Error(err))
+		} else {
+			fields = append(fields, zap.String("outcome", "success"))
+		}
+		lg.Info("kv audit", fields...)
+
+		return resp, err
+	}
+}
+
+// keyRange is a (key, rangeEnd) pair as accepted by the KV request messages: a
+// rangeEnd of nil/empty means the request addresses a single key.
+type keyRange struct {
+	key      []byte
+	rangeEnd []byte
+}
+
+// auditKeyRangeForRequest renders the key or key range a KV request addresses, for the
+// audit trail. Known request types are handled explicitly; a Txn is expanded into the
+// key ranges of its comparisons and nested operations. Any other request that exposes
+// the standard generated GetKey/GetRangeEnd accessors is handled generically, so a new
+// single-key KV request type is still rendered without needing a case added here.
+func auditKeyRangeForRequest(req any) string {
+	switch r := req.(type) {
+	case *pb.RangeRequest:
+		return formatKeyRange(r.GetKey(), r.GetRangeEnd())
+	case *pb.PutRequest:
+		return formatKeyRange(r.GetKey(), nil)
+	case *pb.DeleteRangeRequest:
+		return formatKeyRange(r.GetKey(), r.GetRangeEnd())
+	case *pb.TxnRequest:
+		return formatKeyRanges(collectTxnKeyRanges(r))
+	default:
+		kg, ok := req.(interface{ GetKey() []byte })
+		if !ok {
+			return "n/a"
+		}
+		var rangeEnd []byte
+		if reg, ok := req.(interface{ GetRangeEnd() []byte }); ok {
+			rangeEnd = reg.GetRangeEnd()
+		}
+		return formatKeyRange(kg.GetKey(), rangeEnd)
+	}
+}
+
+// collectTxnKeyRanges walks a (possibly nested) Txn request and returns every key
+// range it references: the comparisons, and the key/put/delete operations in both the
+// success and failure branches.
+func collectTxnKeyRanges(r *pb.TxnRequest) []keyRange {
+	var out []keyRange
+	for _, c := range r.GetCompare() {
+		out = append(out, keyRange{c.GetKey(), c.GetRangeEnd()})
+	}
+	out = append(out, collectRequestOpKeyRanges(r.GetSuccess())...)
+	out = append(out, collectRequestOpKeyRanges(r.GetFailure())...)
+	return out
+}
+
+func collectRequestOpKeyRanges(ops []*pb.RequestOp) []keyRange {
+	var out []keyRange
+	for _, op := range ops {
+		switch {
+		case op.GetRequestRange() != nil:
+			out = append(out, keyRange{op.GetRequestRange().GetKey(), op.GetRequestRange().GetRangeEnd()})
+		case op.GetRequestPut() != nil:
+			out = append(out, keyRange{op.GetRequestPut().GetKey(), nil})
+		case op.GetRequestDeleteRange() != nil:
+			out = append(out, keyRange{op.GetRequestDeleteRange().GetKey(), op.GetRequestDeleteRange().GetRangeEnd()})
+		case op.GetRequestTxn() != nil:
+			out = append(out, collectTxnKeyRanges(op.GetRequestTxn())...)
+		}
+	}
+	return out
+}
+
+func formatKeyRange(key, rangeEnd []byte) string {
+	if len(rangeEnd) == 0 {
+		return fmt.Sprintf("%q", key)
+	}
+	return fmt.Sprintf("[%q, %q)", key, rangeEnd)
+}
+
+func formatKeyRanges(ranges []keyRange) string {
+	if len(ranges) == 0 {
+		return ""
+	}
+	seen := make(map[string]struct{}, len(ranges))
+	var parts []string
+	for _, kr := range ranges {
+		s := formatKeyRange(kr.key, kr.rangeEnd)
+		if _, ok := seen[s]; ok {
+			continue
+		}
+		seen[s] = struct{}{}
+		if len(parts) < maxAuditKeysLogged {
+			parts = append(parts, s)
+		}
+	}
+	out := strings.Join(parts, ", ")
+	if len(seen) > maxAuditKeysLogged {
+		out = fmt.Sprintf("%s, +%d more", out, len(seen)-maxAuditKeysLogged)
+	}
+	return out
+}
