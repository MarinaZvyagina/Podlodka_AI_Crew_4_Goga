+func TestRangeCacheGetPutHit(t *testing.T) {
+	c := newRangeCache()
+	result := &RangeResult{
+		KVs: []*mvccpb.KeyValue{{Key: []byte("foo"), Value: []byte("bar")}},
+		Rev: 5,
+	}
+	c.put([]byte("foo"), nil, 5, RangeOptions{}, result)
+
+	got, ok := c.get([]byte("foo"), nil, 5, RangeOptions{})
+	if !ok {
+		t.Fatalf("expected cache hit")
+	}
+	if len(got.KVs) != 1 || string(got.KVs[0].Value) != "bar" {
+		t.Fatalf("unexpected cached result: %+v", got)
+	}
+
+	// The caller must own the returned KVs: mutating them must not corrupt
+	// the cache entry for a later hit.
+	got.KVs[0].Value = nil
+	got2, ok := c.get([]byte("foo"), nil, 5, RangeOptions{})
+	if !ok {
+		t.Fatalf("expected cache hit")
+	}
+	if string(got2.KVs[0].Value) != "bar" {
+		t.Fatalf("cached entry was mutated by a caller: %+v", got2.KVs[0])
+	}
+}
+
+func TestRangeCacheMissOnDifferentParameters(t *testing.T) {
+	c := newRangeCache()
+	result := &RangeResult{KVs: []*mvccpb.KeyValue{{Key: []byte("foo")}}, Rev: 5}
+	c.put([]byte("foo"), nil, 5, RangeOptions{}, result)
+
+	cases := []struct {
+		name          string
+		key, end      []byte
+		curRev        int64
+		ro            RangeOptions
+		wantCacheHitB bool
+	}{
+		{"same params", []byte("foo"), nil, 5, RangeOptions{}, true},
+		{"different key", []byte("bar"), nil, 5, RangeOptions{}, false},
+		{"different revision", []byte("foo"), nil, 6, RangeOptions{}, false},
+		{"different limit", []byte("foo"), nil, 5, RangeOptions{Limit: 1}, false},
+		{"different countOnly", []byte("foo"), nil, 5, RangeOptions{CountOnly: true}, false},
+		{"nil vs empty end", []byte("foo"), []byte{}, 5, RangeOptions{}, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, ok := c.get(tc.key, tc.end, tc.curRev, tc.ro)
+			if ok != tc.wantCacheHitB {
+				t.Fatalf("get(%q,%q,rev=%d,%+v) hit = %v, want %v", tc.key, tc.end, tc.curRev, tc.ro, ok, tc.wantCacheHitB)
+			}
+		})
+	}
+}
+
+func TestRangeCacheInvalidateSingleKey(t *testing.T) {
+	c := newRangeCache()
+	c.put([]byte("foo"), nil, 5, RangeOptions{}, &RangeResult{Rev: 5})
+	c.put([]byte("bar"), nil, 5, RangeOptions{}, &RangeResult{Rev: 5})
+
+	c.invalidate([]*mvccpb.KeyValue{{Key: []byte("foo")}})
+
+	if _, ok := c.get([]byte("foo"), nil, 5, RangeOptions{}); ok {
+		t.Fatalf("expected foo to be evicted after a write to foo")
+	}
+	if _, ok := c.get([]byte("bar"), nil, 5, RangeOptions{}); !ok {
+		t.Fatalf("expected bar to remain cached: a write to foo must not evict unrelated entries")
+	}
+}
+
+func TestRangeCacheInvalidateRange(t *testing.T) {
+	c := newRangeCache()
+	// A cached range [a, z) covering many keys.
+	c.put([]byte("a"), []byte("z"), 5, RangeOptions{}, &RangeResult{Rev: 5})
+	// A cached single key outside that range.
+	c.put([]byte("zz"), nil, 5, RangeOptions{}, &RangeResult{Rev: 5})
+	// A cached from-key-to-infinity range starting after the write.
+	c.put([]byte("zzz"), []byte{}, 5, RangeOptions{}, &RangeResult{Rev: 5})
+
+	c.invalidate([]*mvccpb.KeyValue{{Key: []byte("m")}})
+
+	if _, ok := c.get([]byte("a"), []byte("z"), 5, RangeOptions{}); ok {
+		t.Fatalf("expected [a,z) to be evicted: it covers the written key m")
+	}
+	if _, ok := c.get([]byte("zz"), nil, 5, RangeOptions{}); !ok {
+		t.Fatalf("expected zz to remain cached: it does not cover the written key")
+	}
+	if _, ok := c.get([]byte("zzz"), []byte{}, 5, RangeOptions{}); !ok {
+		t.Fatalf("expected [zzz,inf) to remain cached: it does not cover the written key")
+	}
+}
+
+func TestRangeCacheInvalidateUnboundedRangeCoversWrite(t *testing.T) {
+	c := newRangeCache()
+	c.put([]byte("m"), []byte{}, 5, RangeOptions{}, &RangeResult{Rev: 5})
+
+	c.invalidate([]*mvccpb.KeyValue{{Key: []byte("zzzzzz")}})
+
+	if _, ok := c.get([]byte("m"), []byte{}, 5, RangeOptions{}); ok {
+		t.Fatalf("expected [m,inf) to be evicted: it covers any key >= m")
+	}
+}
+
+func TestRangeCacheReset(t *testing.T) {
+	c := newRangeCache()
+	c.put([]byte("foo"), nil, 5, RangeOptions{}, &RangeResult{Rev: 5})
+	c.put([]byte("a"), []byte("z"), 5, RangeOptions{}, &RangeResult{Rev: 5})
+
+	c.reset()
+
+	if _, ok := c.get([]byte("foo"), nil, 5, RangeOptions{}); ok {
+		t.Fatalf("expected cache to be empty after reset")
+	}
+	if _, ok := c.get([]byte("a"), []byte("z"), 5, RangeOptions{}); ok {
+		t.Fatalf("expected cache to be empty after reset")
+	}
+	// reset must also clear the invalidation index, or a stale entry
+	// there could panic/leak on the next put+invalidate cycle.
+	c.put([]byte("foo"), nil, 5, RangeOptions{}, &RangeResult{Rev: 5})
+	c.invalidate([]*mvccpb.KeyValue{{Key: []byte("foo")}})
+	if _, ok := c.get([]byte("foo"), nil, 5, RangeOptions{}); ok {
+		t.Fatalf("expected foo to be evicted")
+	}
+}
+
+func TestRangeCacheHistoricalRevisionIgnoresCurRev(t *testing.T) {
+	c := newRangeCache()
+	// An explicit historical revision pins the entry regardless of the
+	// transaction's current snapshot revision.
+	c.put([]byte("foo"), nil, 9, RangeOptions{Rev: 3}, &RangeResult{Rev: 3})
+
+	if _, ok := c.get([]byte("foo"), nil, 42, RangeOptions{Rev: 3}); !ok {
+		t.Fatalf("expected a historical-revision read to hit regardless of curRev")
+	}
+	if _, ok := c.get([]byte("foo"), nil, 9, RangeOptions{}); ok {
+		t.Fatalf("a current-revision read must not reuse a pinned historical-revision entry")
+	}
+}
