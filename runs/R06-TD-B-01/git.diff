+// TestStoreRangeCacheReflectsWrites is a regression test for the read
+// cache: repeated identical Range requests must be served without
+// recomputation, but a write or delete that touches the requested range
+// must be visible to the very next read, and writes to unrelated keys must
+// not evict cache entries they don't affect.
+func TestStoreRangeCacheReflectsWrites(t *testing.T) {
+	lg := zaptest.NewLogger(t)
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	s := NewStore(lg, b, &lease.FakeLessor{}, StoreConfig{})
+	defer cleanup(s, b)
+
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+	s.Put([]byte("other"), []byte("untouched"), lease.NoLease)
+
+	rangeFoo := func() string {
+		tx := s.Read(ConcurrentReadTxMode, traceutil.TODO())
+		defer tx.End()
+		ret, err := tx.Range(t.Context(), []byte("foo"), nil, RangeOptions{})
+		if err != nil {
+			t.Fatalf("range failed: %v", err)
+		}
+		if len(ret.KVs) != 1 {
+			t.Fatalf("expected exactly one kv, got %d", len(ret.KVs))
+		}
+		return string(ret.KVs[0].Value)
+	}
+
+	if got := rangeFoo(); got != "bar" {
+		t.Fatalf("first range = %q, want %q", got, "bar")
+	}
+	if n := len(s.readCache.entries); n != 1 {
+		t.Fatalf("expected the first range to populate the cache, got %d entries", n)
+	}
+
+	// A repeated, identical read must hit the cache and return the same
+	// result, without adding a second entry.
+	if got := rangeFoo(); got != "bar" {
+		t.Fatalf("cached range = %q, want %q", got, "bar")
+	}
+	if n := len(s.readCache.entries); n != 1 {
+		t.Fatalf("expected the repeated range to hit the cache, got %d entries", n)
+	}
+
+	// A write to an unrelated key must not evict foo's cache entry.
+	s.Put([]byte("other"), []byte("changed"), lease.NoLease)
+	if n := len(s.readCache.entries); n != 1 {
+		t.Fatalf("write to an unrelated key evicted an unrelated cache entry: %d entries left", n)
+	}
+	if got := rangeFoo(); got != "bar" {
+		t.Fatalf("range after unrelated write = %q, want %q", got, "bar")
+	}
+
+	// A write to foo itself must be visible on the very next read, not
+	// just eventually.
+	s.Put([]byte("foo"), []byte("baz"), lease.NoLease)
+	if got := rangeFoo(); got != "baz" {
+		t.Fatalf("range after write to foo = %q, want %q (must not serve stale cached data)", got, "baz")
+	}
+
+	// Same for deletion.
+	s.DeleteRange([]byte("foo"), nil)
+	tx := s.Read(ConcurrentReadTxMode, traceutil.TODO())
+	ret, err := tx.Range(t.Context(), []byte("foo"), nil, RangeOptions{})
+	tx.End()
+	if err != nil {
+		t.Fatalf("range failed: %v", err)
+	}
+	if len(ret.KVs) != 0 {
+		t.Fatalf("expected foo to be deleted, got %+v", ret.KVs)
+	}
+}
