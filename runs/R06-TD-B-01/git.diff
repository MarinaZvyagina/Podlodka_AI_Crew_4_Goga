+func TestStoreRangeCacheHonorsSnapshotIsolation(t *testing.T) {
+	lg := zaptest.NewLogger(t)
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	s := NewStore(lg, b, &lease.FakeLessor{}, StoreConfig{})
+	defer cleanup(s, b)
+
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	oldTx := s.Read(ConcurrentReadTxMode, traceutil.TODO())
+	defer oldTx.End()
+
+	s.Put([]byte("foo"), []byte("newBar"), lease.NoLease)
+
+	// This populates the cache with the post-write value at the new
+	// revision.
+	newTx := s.Read(ConcurrentReadTxMode, traceutil.TODO())
+	newRet, err := newTx.Range(t.Context(), []byte("foo"), nil, RangeOptions{})
+	newTx.End()
+	if err != nil {
+		t.Fatalf("range failed: %v", err)
+	}
+	if string(newRet.KVs[0].Value) != "newBar" {
+		t.Fatalf("newTx range = %q, want %q", newRet.KVs[0].Value, "newBar")
+	}
+
+	// oldTx was opened before the write and must keep seeing its own
+	// snapshot, regardless of what got cached in the meantime.
+	oldRet, err := oldTx.Range(t.Context(), []byte("foo"), nil, RangeOptions{})
+	if err != nil {
+		t.Fatalf("range failed: %v", err)
+	}
+	if string(oldRet.KVs[0].Value) != "bar" {
+		t.Fatalf("oldTx range = %q, want %q (must not observe a write that happened after it opened)", oldRet.KVs[0].Value, "bar")
