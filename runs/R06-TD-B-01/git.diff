+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package mvcc
+
+import (
+	"sync"
+
+	"google.golang.org/protobuf/proto"
+
+	"go.etcd.io/etcd/api/v3/mvccpb"
+	"go.etcd.io/etcd/pkg/v3/adt"
+)
+
+// maxRangeCacheEntries bounds the memory the read cache can use. Once full,
+// new results simply aren't cached until invalidation frees up room; this
+// only affects hit rate, never correctness.
+const maxRangeCacheEntries = 8192
+
+// rangeCacheKey identifies a Range call by every parameter that can affect
+// its result, including the exact revision the result was computed at.
+// Pinning the resolved revision (rather than the raw, possibly-zero
+// RangeOptions.Rev) is what makes a cache hit safe for long-lived read
+// transactions: a TxnRead snapshots the store revision when it is opened,
+// and must keep returning data as of that revision no matter how much later
+// Range is actually called or how many unrelated writes land in between.
+type rangeCacheKey struct {
+	key, end string
+	// endIsNil distinguishes a single-key lookup (end == nil) from a
+	// from-key-to-infinity range whose end happens to stringify the same
+	// way (end == []byte{}, i.e. end == "").
+	endIsNil bool
+	// rev is the resolved revision the read was executed at: ro.Rev if the
+	// caller pinned an explicit historical revision, otherwise the reading
+	// transaction's own snapshot revision. Since revisions are immutable
+	// once committed, a hit here is correct by construction and needs no
+	// further freshness check.
+	rev            int64
+	limit          int64
+	countOnly      bool
+	fastKeysOnly   bool
+	withTotalCount bool
+}
+
+func makeRangeCacheKey(key, end []byte, curRev int64, ro RangeOptions) rangeCacheKey {
+	rev := ro.Rev
+	if rev <= 0 {
+		rev = curRev
+	}
+	return rangeCacheKey{
+		key:            string(key),
+		end:            string(end),
+		endIsNil:       end == nil,
+		rev:            rev,
+		limit:          ro.Limit,
+		countOnly:      ro.CountOnly,
+		fastKeysOnly:   ro.FastKeysOnly,
+		withTotalCount: ro.WithTotalCount,
+	}
+}
+
+type rangeCacheEntry struct {
+	k      rangeCacheKey
+	result *RangeResult
+}
+
+// rangeCache memoizes read-only Range results so that repeated requests for
+// identical parameters, at the same resolved revision, skip the
+// index/backend lookup entirely. Correctness does not rely on a timeout:
+// each entry is keyed by an already-committed, immutable revision, so once
+// stored it can never go stale. invalidate proactively evicts entries a
+// write affects — not for correctness, but so the cache doesn't keep
+// serving dead entries from before the write (no future read at the new,
+// post-write revision would ever match them anyway) and so their memory is
+// reclaimed promptly instead of waiting on the size cap.
+type rangeCache struct {
+	mu sync.RWMutex
+
+	entries map[rangeCacheKey]*rangeCacheEntry
+
+	// singleKey and ranges index entries by the key range they cover so
+	// that invalidate can find affected entries without scanning the
+	// whole cache. This mirrors watcherGroup's indexing scheme.
+	singleKey map[string]map[*rangeCacheEntry]struct{}
+	ranges    adt.IntervalTree
+}
+
+func newRangeCache() *rangeCache {
+	return &rangeCache{
+		entries:   make(map[rangeCacheKey]*rangeCacheEntry),
+		singleKey: make(map[string]map[*rangeCacheEntry]struct{}),
+		ranges:    adt.NewIntervalTree(),
+	}
+}
+
+func (c *rangeCache) get(key, end []byte, curRev int64, ro RangeOptions) (*RangeResult, bool) {
+	k := makeRangeCacheKey(key, end, curRev, ro)
+	c.mu.RLock()
+	e, ok := c.entries[k]
+	c.mu.RUnlock()
+	if !ok {
+		return nil, false
+	}
+	// Return a copy: callers (e.g. keys-only assembly, result pruning)
+	// mutate the RangeResult and its KeyValues in place.
+	return cloneRangeResult(e.result), true
+}
+
+func (c *rangeCache) put(key, end []byte, curRev int64, ro RangeOptions, result *RangeResult) {
+	k := makeRangeCacheKey(key, end, curRev, ro)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if _, ok := c.entries[k]; ok {
+		return
+	}
+	if len(c.entries) >= maxRangeCacheEntries {
+		return
+	}
+	e := &rangeCacheEntry{k: k, result: cloneRangeResult(result)}
+	c.entries[k] = e
+	c.link(e)
+}
+
+func (c *rangeCache) link(e *rangeCacheEntry) {
+	if e.k.endIsNil {
+		set := c.singleKey[e.k.key]
+		if set == nil {
+			set = make(map[*rangeCacheEntry]struct{})
+			c.singleKey[e.k.key] = set
+		}
+		set[e] = struct{}{}
+		return
+	}
+	ivl := adt.NewStringAffineInterval(e.k.key, e.k.end)
+	if iv := c.ranges.Find(ivl); iv != nil {
+		iv.Val.(map[*rangeCacheEntry]struct{})[e] = struct{}{}
+		return
+	}
+	set := map[*rangeCacheEntry]struct{}{e: {}}
+	c.ranges.Insert(ivl, set)
+}
+
+func (c *rangeCache) unlink(e *rangeCacheEntry) {
+	if e.k.endIsNil {
+		set := c.singleKey[e.k.key]
+		delete(set, e)
+		if len(set) == 0 {
+			delete(c.singleKey, e.k.key)
+		}
+		return
+	}
+	ivl := adt.NewStringAffineInterval(e.k.key, e.k.end)
+	iv := c.ranges.Find(ivl)
+	if iv == nil {
+		return
+	}
+	set := iv.Val.(map[*rangeCacheEntry]struct{})
+	delete(set, e)
+	if len(set) == 0 {
+		c.ranges.Delete(ivl)
+	}
+}
+
+// invalidate drops every cached entry whose range covers any of the given
+// keys. Every such entry was necessarily computed at a revision older than
+// this write (revisions only move forward), so no future read will ever
+// look it up again; evicting it now just reclaims the space immediately
+// instead of leaving it for the size cap to page out.
+func (c *rangeCache) invalidate(changes []*mvccpb.KeyValue) {
+	if len(changes) == 0 {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if len(c.entries) == 0 {
+		return
+	}
+	victims := make(map[*rangeCacheEntry]struct{})
+	for _, kv := range changes {
+		key := string(kv.Key)
+		for e := range c.singleKey[key] {
+			victims[e] = struct{}{}
+		}
+		for _, iv := range c.ranges.Stab(adt.NewStringAffinePoint(key)) {
+			for e := range iv.Val.(map[*rangeCacheEntry]struct{}) {
+				victims[e] = struct{}{}
+			}
+		}
+	}
+	for e := range victims {
+		delete(c.entries, e.k)
+		c.unlink(e)
+	}
+}
+
+// reset drops every cached entry. Used on compaction and restore: those can
+// change whether a historical-revision read succeeds or returns
+// ErrCompacted independent of any single key changing, so a blanket flush
+// is simplest and, since both events are rare, cheap.
+func (c *rangeCache) reset() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.entries = make(map[rangeCacheKey]*rangeCacheEntry)
+	c.singleKey = make(map[string]map[*rangeCacheEntry]struct{})
+	c.ranges = adt.NewIntervalTree()
+}
+
+func cloneRangeResult(r *RangeResult) *RangeResult {
+	kvs := make([]*mvccpb.KeyValue, len(r.KVs))
+	for i, kv := range r.KVs {
+		// proto.Clone, not a struct copy: mvccpb.KeyValue embeds protobuf
+		// internal state (including a mutex) that must not be copied by
+		// value.
+		kvs[i] = proto.Clone(kv).(*mvccpb.KeyValue)
+	}
+	return &RangeResult{KVs: kvs, Rev: r.Rev, Count: r.Count}
+}
