+// limitations under the License.
+
+package mvcc
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+)
+
+func TestRangeCacheHitAfterPut(t *testing.T) {
+	c := NewRangeCache()
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}}
+
+	_, seq, hit := c.Get(req)
+	require.False(t, hit)
+
+	c.Put(req, resp, seq)
+
+	got, _, hit := c.Get(req)
+	require.True(t, hit)
+	assert.Equal(t, int64(5), got.Header.Revision)
+	// The returned response must be a copy: mutating it must not corrupt
+	// the cached entry (the RPC layer fills in header fields in place).
+	got.Header.Revision = 99
+	got2, _, hit2 := c.Get(req)
+	require.True(t, hit2)
+	assert.Equal(t, int64(5), got2.Header.Revision)
+}
+
+func TestRangeCacheSerializableSharesEntryWithLinearizable(t *testing.T) {
+	c := NewRangeCache()
+	linReq := &pb.RangeRequest{Key: []byte("foo")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}
+
+	_, seq, _ := c.Get(linReq)
+	c.Put(linReq, resp, seq)
+
+	serReq := &pb.RangeRequest{Key: []byte("foo"), Serializable: true}
+	_, _, hit := c.Get(serReq)
+	require.True(t, hit, "a serializable request for the same key should reuse the cached entry")
+}
+
+func TestRangeCacheNeverCachesExplicitRevision(t *testing.T) {
+	c := NewRangeCache()
+	req := &pb.RangeRequest{Key: []byte("foo"), Revision: 3}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 3}}
+
+	_, seq, hit := c.Get(req)
+	require.False(t, hit)
+
+	c.Put(req, resp, seq)
+
+	_, _, hit = c.Get(req)
+	require.False(t, hit, "requests pinned to a historical revision must never be cached")
+	assert.Equal(t, 0, c.Size())
+}
+
+func TestRangeCacheInvalidateIsScopedToOverlappingRange(t *testing.T) {
+	c := NewRangeCache()
+
+	reqA := &pb.RangeRequest{Key: []byte("a")}
+	reqB := &pb.RangeRequest{Key: []byte("b")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}
+
+	_, seqA, _ := c.Get(reqA)
+	c.Put(reqA, resp, seqA)
+	_, seqB, _ := c.Get(reqB)
+	c.Put(reqB, resp, seqB)
+
+	c.Invalidate([]byte("a"), nil)
+
+	_, _, hitA := c.Get(reqA)
+	assert.False(t, hitA, "write to key a must evict the cache entry for key a")
+
+	_, _, hitB := c.Get(reqB)
+	assert.True(t, hitB, "write to key a must not evict an unrelated cache entry for key b")
+}
+
+func TestRangeCacheInvalidateCoversOverlappingRangeRequest(t *testing.T) {
+	c := NewRangeCache()
+
+	req := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}
+
+	_, seq, _ := c.Get(req)
+	c.Put(req, resp, seq)
+
+	c.Invalidate([]byte("m"), nil)
+
+	_, _, hit := c.Get(req)
+	assert.False(t, hit, "a write to a key inside a cached range must evict that range")
+}
+
+// TestRangeCachePutRejectsRaceWithConcurrentWrite verifies that a response
+// computed from a read that started before a concurrent write committed is
+// not cached once that write's invalidation has already been observed -
+// otherwise the stale response would sit in the cache with nothing left to
+// evict it.
+func TestRangeCachePutRejectsRaceWithConcurrentWrite(t *testing.T) {
+	c := NewRangeCache()
+	req := &pb.RangeRequest{Key: []byte("foo")}
+
+	_, seq, hit := c.Get(req)
+	require.False(t, hit)
+
+	// A write to the same key commits and invalidates while the read that
+	// produced staleResp is still in flight.
+	c.Invalidate([]byte("foo"), nil)
+
+	staleResp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}
+	c.Put(req, staleResp, seq)
+
+	_, _, hit = c.Get(req)
+	assert.False(t, hit, "a response racing with a concurrent write must not be cached")
+}
+
+func TestRangeCacheReset(t *testing.T) {
+	c := NewRangeCache()
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}
+
+	_, seq, _ := c.Get(req)
+	c.Put(req, resp, seq)
+	require.Equal(t, 1, c.Size())
+
+	c.Reset()
+
+	_, _, hit := c.Get(req)
+	assert.False(t, hit)
+	assert.Equal(t, 0, c.Size())
+}
+
+func TestWatchableStoreInvalidatesRangeCacheOnPut(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	s := New(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{})
+	defer cleanup(s, b)
+
+	rc := s.RangeCache()
+	reqFoo := &pb.RangeRequest{Key: []byte("foo")}
+	reqBar := &pb.RangeRequest{Key: []byte("bar")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}
+
+	_, seqFoo, _ := rc.Get(reqFoo)
+	rc.Put(reqFoo, resp, seqFoo)
+	_, seqBar, _ := rc.Get(reqBar)
+	rc.Put(reqBar, resp, seqBar)
+
+	s.Put([]byte("foo"), []byte("baz"), lease.NoLease)
+
+	_, _, hitFoo := rc.Get(reqFoo)
+	assert.False(t, hitFoo, "a Put to foo must invalidate the cached entry for foo")
+
+	_, _, hitBar := rc.Get(reqBar)
+	assert.True(t, hitBar, "a Put to foo must not invalidate the cached entry for bar")
+}
+
+func TestWatchableStoreInvalidatesRangeCacheOnRestore(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	s := New(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{})
+	defer cleanup(s, b)
+
+	rc := s.RangeCache()
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}
+
+	_, seq, _ := rc.Get(req)
+	rc.Put(req, resp, seq)
+	require.Equal(t, 1, rc.Size())
+
+	require.NoError(t, s.Restore(b))
+
+	_, _, hit := rc.Get(req)
+	assert.False(t, hit, "Restore must drop all cached entries")
+}
