+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package mvcc
+
+import (
+	"sync"
+
+	"google.golang.org/protobuf/proto"
+	"k8s.io/utils/lru"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/pkg/v3/adt"
+)
+
+// DefaultRangeCacheSize bounds the number of distinct Range requests cached
+// by a RangeCache.
+const DefaultRangeCacheSize = 2048
+
+// RangeCache caches RangeResponses for repeated Range requests pinned to the
+// current revision (Revision == 0), so that identical requests issued in
+// quick succession don't have to redo the underlying range scan.
+//
+// A cached response is only ever handed out while it is guaranteed to be
+// identical to what a fresh, uncached read would return: entries are removed
+// the instant a write commits to an overlapping key range (see Invalidate),
+// and a response is only cached in the first place if no such write raced
+// ahead of the read that produced it (see the seq check in Put). Requests
+// with an explicit historical Revision are never cached, since compaction
+// can retroactively invalidate them without touching any key.
+type RangeCache struct {
+	mu  sync.Mutex
+	lru *lru.Cache
+
+	// ranges is a reverse index from requested key range to cache keys,
+	// used to find and evict entries overlapping a write.
+	ranges adt.IntervalTree
+
+	// seq counts every Invalidate call. Put() only stores a response if
+	// seq hasn't moved since the caller observed a cache miss, so that a
+	// write racing with an in-flight read can never be papered over by a
+	// stale response landing in the cache after the fact.
+	seq int64
+}
+
+// NewRangeCache returns an empty RangeCache with the default size bound.
+func NewRangeCache() *RangeCache {
+	return &RangeCache{
+		lru:    lru.New(DefaultRangeCacheSize),
+		ranges: adt.NewIntervalTree(),
+	}
+}
+
+// cacheKey returns a canonical cache key for r. Serializable is normalized
+// away: the data at a given revision doesn't depend on how the caller chose
+// to become confident it is caught up to that revision.
+func cacheKey(r *pb.RangeRequest) string {
+	if r.Serializable {
+		clone := proto.Clone(r).(*pb.RangeRequest)
+		clone.Serializable = false
+		r = clone
+	}
+	b, err := proto.Marshal(r)
+	if err != nil {
+		panic(err)
+	}
+	return string(b)
+}
+
+// Get looks up the cached response for r. Requests with an explicit
+// historical Revision are always misses. On a miss, the returned seq must be
+// passed to a subsequent Put for the same request.
+func (c *RangeCache) Get(r *pb.RangeRequest) (resp *pb.RangeResponse, seq int64, hit bool) {
+	if r.Revision != 0 {
+		return nil, 0, false
+	}
+
+	key := cacheKey(r)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if v, ok := c.lru.Get(key); ok {
+		return proto.Clone(v.(*pb.RangeResponse)).(*pb.RangeResponse), 0, true
+	}
+	return nil, c.seq, false
+}
+
+// Put caches resp as the response for r, unless r pins a historical revision
+// or a write has been observed (via Invalidate) since seq was obtained from
+// Get, in which case resp may already be stale and is dropped instead.
+func (c *RangeCache) Put(r *pb.RangeRequest, resp *pb.RangeResponse, seq int64) {
+	if r.Revision != 0 {
+		return
+	}
+
+	key := cacheKey(r)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if c.seq != seq {
+		return
+	}
+
+	c.lru.Add(key, proto.Clone(resp).(*pb.RangeResponse))
+
+	var ivl adt.Interval
+	if len(r.RangeEnd) != 0 {
+		ivl = adt.NewStringAffineInterval(string(r.Key), string(r.RangeEnd))
+	} else {
+		ivl = adt.NewStringAffinePoint(string(r.Key))
+	}
+	if iv := c.ranges.Find(ivl); iv != nil {
+		iv.Val.(map[string]struct{})[key] = struct{}{}
+	} else {
+		c.ranges.Insert(ivl, map[string]struct{}{key: {}})
+	}
+}
+
+// Invalidate evicts every cached response whose requested range intersects
+// [key, end). It must be called for every committed write, on every node, so
+// that a subsequent read never observes data older than what an uncached
+// read would have returned at that point in time.
+func (c *RangeCache) Invalidate(key, end []byte) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	c.seq++
+
+	var ivl adt.Interval
+	if len(end) == 0 {
+		ivl = adt.NewStringAffinePoint(string(key))
+	} else {
+		ivl = adt.NewStringAffineInterval(string(key), string(end))
+	}
+
+	for _, iv := range c.ranges.Stab(ivl) {
+		for k := range iv.Val.(map[string]struct{}) {
+			c.lru.Remove(k)
+		}
+		c.ranges.Delete(iv.Ivl)
+	}
+}
+
+// Reset drops every cached entry. It is used when the underlying data is
+// replaced wholesale (e.g. restoring from a snapshot) rather than through an
+// incremental write that Invalidate can precisely account for.
+func (c *RangeCache) Reset() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	c.seq++
+	c.lru = lru.New(DefaultRangeCacheSize)
+	c.ranges = adt.NewIntervalTree()
+}
+
+// Size returns the number of responses currently cached.
+func (c *RangeCache) Size() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.lru.Len()
+}
