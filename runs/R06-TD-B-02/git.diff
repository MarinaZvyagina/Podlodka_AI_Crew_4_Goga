+// limitations under the License.
+
+package integration
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	clientv3 "go.etcd.io/etcd/client/v3"
+	"go.etcd.io/etcd/tests/v3/framework/integration"
+)
+
+// TestV3RangeRepeatedReadsNeverStale exercises the server-side Range cache:
+// repeated identical reads of the same key must never observe a value older
+// than what an equivalent uncached read would have returned at the time it
+// was made, for both linearizable and serializable requests.
+func TestV3RangeRepeatedReadsNeverStale(t *testing.T) {
+	integration.BeforeTest(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	client := clus.RandClient()
+	key := "cached-key"
+
+	getOpts := []clientv3.OpOption{}
+	serializableOpts := []clientv3.OpOption{clientv3.WithSerializable()}
+
+	assertRepeatedGetsSee := func(t *testing.T, opts []clientv3.OpOption, want string) {
+		t.Helper()
+		for i := 0; i < 20; i++ {
+			resp, err := client.Get(t.Context(), key, opts...)
+			require.NoError(t, err)
+			require.Len(t, resp.Kvs, 1)
+			require.Equal(t, want, string(resp.Kvs[0].Value))
+		}
+	}
+
+	_, err := client.Put(t.Context(), key, "v1")
+	require.NoError(t, err)
+	assertRepeatedGetsSee(t, getOpts, "v1")
+	assertRepeatedGetsSee(t, serializableOpts, "v1")
+
+	// A write that commits must be reflected immediately, not after some
+	// fixed delay: interleave writes and reads to a tight loop, and require
+	// every single read to observe the value from the most recent write.
+	for i := 0; i < 20; i++ {
+		val := "v" + string(rune('a'+i))
+		_, err := client.Put(t.Context(), key, val)
+		require.NoError(t, err)
+
+		resp, err := client.Get(t.Context(), key, getOpts...)
+		require.NoError(t, err)
+		require.Len(t, resp.Kvs, 1)
+		require.Equal(t, val, string(resp.Kvs[0].Value))
+
+		resp, err = client.Get(t.Context(), key, serializableOpts...)
+		require.NoError(t, err)
+		require.Len(t, resp.Kvs, 1)
+		require.Equal(t, val, string(resp.Kvs[0].Value))
+	}
+
+	_, err = client.Delete(t.Context(), key)
+	require.NoError(t, err)
+
+	resp, err := client.Get(t.Context(), key, getOpts...)
+	require.NoError(t, err)
+	require.Empty(t, resp.Kvs)
+}
+
+// TestV3RangeCacheDoesNotLeakBetweenUnrelatedKeys checks that caching one
+// key's Range response and then writing an unrelated key doesn't corrupt or
+// suppress reads of either key.
+func TestV3RangeCacheDoesNotLeakBetweenUnrelatedKeys(t *testing.T) {
+	integration.BeforeTest(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	client := clus.RandClient()
+
+	_, err := client.Put(t.Context(), "key-a", "a1")
+	require.NoError(t, err)
+	_, err = client.Put(t.Context(), "key-b", "b1")
+	require.NoError(t, err)
+
+	resp, err := client.Get(t.Context(), "key-a")
+	require.NoError(t, err)
+	require.Len(t, resp.Kvs, 1)
+	require.Equal(t, "a1", string(resp.Kvs[0].Value))
+
+	// Repeatedly write to key-b; key-a's cached response must stay correct.
+	for i := 0; i < 5; i++ {
+		_, err := client.Put(t.Context(), "key-b", "b2")
+		require.NoError(t, err)
+
+		resp, err := client.Get(t.Context(), "key-a")
+		require.NoError(t, err)
+		require.Len(t, resp.Kvs, 1)
+		require.Equal(t, "a1", string(resp.Kvs[0].Value))
+	}
+
+	resp, err = client.Get(t.Context(), "key-b")
+	require.NoError(t, err)
+	require.Len(t, resp.Kvs, 1)
+	require.Equal(t, "b2", string(resp.Kvs[0].Value))
+}
