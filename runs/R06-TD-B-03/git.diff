+
+// cachePutIfCurrent stores rr in the read cache, but only if rr.Rev is
+// still the store's live current revision. It must run under
+// revMu.RLock() so it can never race behind a concurrent write's
+// revMu-protected commit-and-invalidate section: either that write has
+// already committed by the time we check (so rr.Rev no longer matches
+// currentRev and we correctly skip caching a result the write just made
+// stale), or it hasn't started yet and must wait for our RLock to release
+// before it can invalidate -- guaranteeing it runs, and therefore evicts
+// what we insert here, after this insertion completes.
+func (s *store) cachePutIfCurrent(key, end []byte, ro RangeOptions, rr *RangeResult) {
+	s.revMu.RLock()
+	if rr.Rev == s.currentRev {
+		s.readCache.put(key, end, ro, rr)
+	}
+	s.revMu.RUnlock()
+}
