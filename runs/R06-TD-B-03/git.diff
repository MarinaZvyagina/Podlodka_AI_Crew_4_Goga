diff --git a/server/storage/mvcc/read_cache.go b/server/storage/mvcc/read_cache.go
new file mode 100644
index 000000000..5ab54d6e9
--- /dev/null
+++ b/server/storage/mvcc/read_cache.go
@@ -0,0 +1,195 @@
+// Copyright 2025 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package mvcc
+
+import (
+	"bytes"
+	"sync"
+
+	"go.etcd.io/etcd/api/v3/mvccpb"
+)
+
+// maxReadCacheEntries bounds the number of distinct queries the read cache
+// remembers, so a workload with unbounded query variety can't grow it
+// without limit. It is non-const so tests can shrink it.
+var maxReadCacheEntries = 10000
+
+// rangeCacheKey identifies a cached range read by the query parameters that
+// determine its result. Only reads pinned to the store's current revision
+// (RangeOptions.Rev <= 0) are ever cached or looked up: their result stays
+// correct for as long as no write touches the queried range, which is
+// exactly what readCache tracks. Historical, revision-pinned reads always
+// bypass the cache.
+type rangeCacheKey struct {
+	key    string
+	end    string
+	hasEnd bool // false means a single-key lookup (RangeOptions end == nil)
+
+	limit          int64
+	countOnly      bool
+	fastKeysOnly   bool
+	withTotalCount bool
+}
+
+func newRangeCacheKey(key, end []byte, ro RangeOptions) rangeCacheKey {
+	return rangeCacheKey{
+		key:            string(key),
+		end:            string(end),
+		hasEnd:         end != nil,
+		limit:          ro.Limit,
+		countOnly:      ro.CountOnly,
+		fastKeysOnly:   ro.FastKeysOnly,
+		withTotalCount: ro.WithTotalCount,
+	}
+}
+
+// contains reports whether a range read matching ck would have observed key k.
+func (ck rangeCacheKey) contains(k []byte) bool {
+	key := []byte(ck.key)
+	if bytes.Compare(k, key) < 0 {
+		return false
+	}
+	if !ck.hasEnd {
+		return bytes.Equal(k, key)
+	}
+	end := []byte(ck.end)
+	if len(end) == 0 {
+		return true
+	}
+	return bytes.Compare(k, end) < 0
+}
+
+// readCache caches the results of current-revision range reads so repeated
+// requests with identical parameters can skip the in-memory index walk and
+// backend reads. It is kept correct by precise, synchronous invalidation
+// instead of a timer: every write evicts exactly the cached entries whose
+// queried range covers a key it changed (see (*store).readCache usage in
+// storeTxnWrite.End), so a cache hit never returns data older than what an
+// uncached read would have returned at the time it was made.
+//
+// Each entry remembers the store revision it was computed at (RangeResult.Rev).
+// A long-lived read transaction opened before a write can still call Range
+// after a newer transaction has already populated the cache with the
+// write's result; get() rejects entries newer than the caller's own
+// revision so such a reader never observes data from the future relative to
+// its snapshot. put() is gated by (*store).cachePutIfCurrent, which only
+// inserts a result computed at exactly the store's live current revision,
+// so a result already superseded by a write in flight can never be written
+// into the cache behind that write's invalidation pass.
+type readCache struct {
+	mu      sync.RWMutex
+	entries map[rangeCacheKey]*RangeResult
+}
+
+func newReadCache() *readCache {
+	return &readCache{entries: make(map[rangeCacheKey]*RangeResult)}
+}
+
+// get returns a cached result for (key, end, ro), if one is present and was
+// computed at a revision no newer than curRev -- the requesting read's own
+// pinned revision. The caller's RangeOptions.Rev must already be known to
+// be <= 0 (a "current" read). The caller is responsible for stamping the
+// returned result's Rev with its own curRev before returning it, since an
+// older cached entry may still carry an earlier revision number.
+func (c *readCache) get(key, end []byte, ro RangeOptions, curRev int64) (*RangeResult, bool) {
+	c.mu.RLock()
+	rr, ok := c.entries[newRangeCacheKey(key, end, ro)]
+	c.mu.RUnlock()
+	if !ok || rr.Rev > curRev {
+		return nil, false
+	}
+	return &RangeResult{KVs: cloneKVs(rr.KVs), Count: rr.Count}, true
+}
+
+// put stores rr as the cached result for (key, end, ro), keyed alongside
+// rr.Rev. rr is cloned so later in-place mutations by callers (e.g.
+// stripping values for a keys-only response) can never corrupt the cached
+// copy. Callers must go through (*store).cachePutIfCurrent rather than
+// calling this directly, to avoid racing behind a concurrent write.
+func (c *readCache) put(key, end []byte, ro RangeOptions, rr *RangeResult) {
+	c.mu.Lock()
+	if len(c.entries) < maxReadCacheEntries {
+		c.entries[newRangeCacheKey(key, end, ro)] = &RangeResult{KVs: cloneKVs(rr.KVs), Count: rr.Count, Rev: rr.Rev}
+	}
+	c.mu.Unlock()
+}
+
+// invalidateManyKeysThreshold bounds the cost of invalidating a single
+// write: above this many changed keys, invalidateKeys falls back to
+// clearing the whole cache once instead of scanning every entry once per
+// key. Without this, a write touching a very large number of keys (e.g. a
+// broad DeleteRange or lease revocation) could turn invalidation into an
+// O(keys * entries) scan while revMu is held exclusively, stalling every
+// read on the node. It is non-const so tests can shrink it.
+var invalidateManyKeysThreshold = 64
+
+// invalidateKeys evicts every cached entry whose queried range covers any
+// of keys. It is called synchronously while committing a write that
+// changed those keys, so any read that opens after the write commits is
+// guaranteed to either miss the cache or find it already evicted for the
+// affected range.
+func (c *readCache) invalidateKeys(keys [][]byte) {
+	if len(keys) == 0 {
+		return
+	}
+	if len(keys) > invalidateManyKeysThreshold {
+		c.clear()
+		return
+	}
+	c.mu.Lock()
+	for ck := range c.entries {
+		for _, k := range keys {
+			if ck.contains(k) {
+				delete(c.entries, ck)
+				break
+			}
+		}
+	}
+	c.mu.Unlock()
+}
+
+// clear evicts all cached entries. It must be called whenever the store's
+// data is replaced wholesale outside of the normal write path, e.g. when
+// restoring from a snapshot.
+func (c *readCache) clear() {
+	c.mu.Lock()
+	c.entries = make(map[rangeCacheKey]*RangeResult)
+	c.mu.Unlock()
+}
+
+// cloneKVs builds independent mvccpb.KeyValue objects that share the
+// underlying Key/Value byte slices but not the struct itself, so that a
+// caller mutating a returned KeyValue's fields (e.g. stripping Value for a
+// keys-only response) can never affect the cache or another concurrent
+// caller. It constructs new messages field-by-field rather than copying
+// *kv, since proto-generated structs carry internal state that must not be
+// duplicated by value copy.
+func cloneKVs(kvs []*mvccpb.KeyValue) []*mvccpb.KeyValue {
+	if kvs == nil {
+		return nil
+	}
+	out := make([]*mvccpb.KeyValue, len(kvs))
+	for i, kv := range kvs {
+		out[i] = &mvccpb.KeyValue{
+			Key:            kv.Key,
+			CreateRevision: kv.CreateRevision,
+			ModRevision:    kv.ModRevision,
+			Version:        kv.Version,
+			Value:          kv.Value,
+			Lease:          kv.Lease,
+		}
+	}
+	return out
+}
diff --git a/server/storage/mvcc/read_cache_test.go b/server/storage/mvcc/read_cache_test.go
new file mode 100644
index 000000000..ffa5da7c2
--- /dev/null
+++ b/server/storage/mvcc/read_cache_test.go
@@ -0,0 +1,262 @@
+// Copyright 2025 The etcd Authors
+//
