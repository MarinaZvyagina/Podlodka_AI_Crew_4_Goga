+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package mvcc
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+)
+
+// countingIndex wraps an index and counts calls to Revisions/Range/CountRevisions,
+// the operations a cache hit is expected to skip.
+type countingIndex struct {
+	index
+	calls int
+}
+
+func (c *countingIndex) Revisions(key, end []byte, atRev int64, limit int, withTotalCount bool) ([]Revision, int) {
+	c.calls++
+	return c.index.Revisions(key, end, atRev, limit, withTotalCount)
+}
+
+func (c *countingIndex) Range(key, end []byte, atRev int64, limit int, withTotalCount bool) ([][]byte, []Revision, []Revision, []int64, int) {
+	c.calls++
+	return c.index.Range(key, end, atRev, limit, withTotalCount)
+}
+
+func (c *countingIndex) CountRevisions(key, end []byte, atRev int64) int {
+	c.calls++
+	return c.index.CountRevisions(key, end, atRev)
+}
+
+func newTestStoreWithCountingIndex(t *testing.T) (*store, *countingIndex) {
+	t.Helper()
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	s := NewStore(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{})
+	t.Cleanup(func() { cleanup(s, b) })
+	ci := &countingIndex{index: s.kvindex}
+	s.kvindex = ci
+	return s, ci
+}
+
+func TestReadCacheServesRepeatedRange(t *testing.T) {
+	s, ci := newTestStoreWithCountingIndex(t)
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	ro := RangeOptions{}
+	rr1, err := s.Range(context.Background(), []byte("foo"), nil, ro)
+	require.NoError(t, err)
+	require.Equal(t, 1, ci.calls, "first read should hit the index")
+
+	rr2, err := s.Range(context.Background(), []byte("foo"), nil, ro)
+	require.NoError(t, err)
+	assert.Equal(t, 1, ci.calls, "repeated identical read should be served from cache, not the index")
+	require.Len(t, rr2.KVs, 1)
+	assert.Equal(t, rr1.KVs[0].Key, rr2.KVs[0].Key)
+	assert.Equal(t, rr1.KVs[0].Value, rr2.KVs[0].Value)
+	assert.Equal(t, rr1.Rev, rr2.Rev)
+}
+
+func TestReadCacheMissForDifferentParameters(t *testing.T) {
+	s, ci := newTestStoreWithCountingIndex(t)
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	_, err := s.Range(context.Background(), []byte("foo"), nil, RangeOptions{})
+	require.NoError(t, err)
+	require.Equal(t, 1, ci.calls)
+
+	// Different limit -> different cache key -> miss.
+	_, err = s.Range(context.Background(), []byte("foo"), nil, RangeOptions{Limit: 1})
+	require.NoError(t, err)
+	assert.Equal(t, 2, ci.calls)
+
+	// Pinned historical revision is never cached/looked up.
+	_, err = s.Range(context.Background(), []byte("foo"), nil, RangeOptions{Rev: 1})
+	require.NoError(t, err)
+	assert.Equal(t, 3, ci.calls)
+	_, err = s.Range(context.Background(), []byte("foo"), nil, RangeOptions{Rev: 1})
+	require.NoError(t, err)
+	assert.Equal(t, 4, ci.calls, "pinned-revision reads should always bypass the cache")
+}
+
+func TestReadCacheInvalidatesOnOverlappingWrite(t *testing.T) {
+	s, ci := newTestStoreWithCountingIndex(t)
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	ro := RangeOptions{}
+	rr1, err := s.Range(context.Background(), []byte("foo"), nil, ro)
+	require.NoError(t, err)
+	require.Equal(t, 1, ci.calls)
+	require.Len(t, rr1.KVs, 1)
+	require.Equal(t, []byte("bar"), rr1.KVs[0].Value)
+
+	// A write to the cached key must be visible on the very next read,
+	// not after some expiration delay.
+	s.Put([]byte("foo"), []byte("baz"), lease.NoLease)
+
+	rr2, err := s.Range(context.Background(), []byte("foo"), nil, ro)
+	require.NoError(t, err)
+	assert.Equal(t, 2, ci.calls, "write overlapping the cached key must force a fresh read")
+	require.Len(t, rr2.KVs, 1)
+	assert.Equal(t, []byte("baz"), rr2.KVs[0].Value)
+}
+
+func TestReadCacheInvalidatesOnDeleteInRange(t *testing.T) {
+	s, ci := newTestStoreWithCountingIndex(t)
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	ro := RangeOptions{}
+	_, err := s.Range(context.Background(), []byte("foo"), []byte("fop"), ro)
+	require.NoError(t, err)
+	require.Equal(t, 1, ci.calls)
+
+	// DeleteRange itself performs an index Range call to find matching keys;
+	// what matters here is that the *next* read isn't served from cache.
+	s.DeleteRange([]byte("foo"), []byte("fop"))
+	callsAfterDelete := ci.calls
+
+	rr, err := s.Range(context.Background(), []byte("foo"), []byte("fop"), ro)
+	require.NoError(t, err)
+	assert.Equal(t, callsAfterDelete+1, ci.calls, "delete overlapping the cached range must force a fresh read")
+	assert.Empty(t, rr.KVs)
+}
+
+func TestReadCacheDoesNotInvalidateOnDisjointWrite(t *testing.T) {
+	s, ci := newTestStoreWithCountingIndex(t)
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	ro := RangeOptions{}
+	_, err := s.Range(context.Background(), []byte("foo"), nil, ro)
+	require.NoError(t, err)
+	require.Equal(t, 1, ci.calls)
+
+	// A write to an unrelated key must not evict the cached entry.
+	s.Put([]byte("unrelated"), []byte("value"), lease.NoLease)
+
+	rr, err := s.Range(context.Background(), []byte("foo"), nil, ro)
+	require.NoError(t, err)
+	assert.Equal(t, 1, ci.calls, "write to a disjoint key should not invalidate an unrelated cached range")
+	// The revision in the header still reflects the live store, even though
+	// the data was served from cache.
+	assert.Equal(t, s.Rev(), rr.Rev)
+}
+
+// TestReadCacheLargeWriteFallsBackToFullClear checks that a write touching
+// more keys than invalidateManyKeysThreshold evicts the whole cache in one
+// step instead of scanning every entry once per changed key.
+func TestReadCacheLargeWriteFallsBackToFullClear(t *testing.T) {
+	old := invalidateManyKeysThreshold
+	invalidateManyKeysThreshold = 4
+	t.Cleanup(func() { invalidateManyKeysThreshold = old })
+
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	s := NewStore(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{})
+	t.Cleanup(func() { cleanup(s, b) })
+
+	s.Put([]byte("unrelated"), []byte("value"), lease.NoLease)
+	_, err := s.Range(context.Background(), []byte("unrelated"), nil, RangeOptions{})
+	require.NoError(t, err)
+	require.Len(t, s.readCache.entries, 1)
+
+	txn := s.Write(traceutil.TODO())
+	for i := range invalidateManyKeysThreshold + 1 {
+		txn.Put([]byte{byte(i)}, []byte("v"), lease.NoLease)
+	}
+	txn.End()
+
+	assert.Empty(t, s.readCache.entries, "a write touching many keys should clear the whole cache")
+}
+
+// TestReadCacheKeysOnlyDoesNotCorruptSharedEntry guards against a subtle
+// aliasing bug: stripping Value for a keys-only response must never mutate
+// the cached copy backing a concurrent or subsequent full-value read.
+func TestReadCacheKeysOnlyDoesNotCorruptSharedEntry(t *testing.T) {
+	s, _ := newTestStoreWithCountingIndex(t)
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	txn := s.Read(ConcurrentReadTxMode, traceutil.TODO())
+	rr, err := txn.Range(context.Background(), []byte("foo"), nil, RangeOptions{})
+	txn.End()
+	require.NoError(t, err)
+	require.Len(t, rr.KVs, 1)
+	// Simulate what txn.asembleRangeResponse does for KeysOnly requests:
+	// mutate the returned KeyValue in place.
+	rr.KVs[0].Value = nil
+
+	// A subsequent read for the same key must still see the real value,
+	// proving the cache handed out an independent copy.
+	rr2, err := s.Range(context.Background(), []byte("foo"), nil, RangeOptions{})
+	require.NoError(t, err)
+	require.Len(t, rr2.KVs, 1)
+	assert.Equal(t, []byte("bar"), rr2.KVs[0].Value)
+}
+
+// TestReadCacheDoesNotServeFutureDataToStaleSnapshot guards against a
+// straddling-snapshot bug: a read transaction opened before a write must
+// never be served a cache entry that a different, later-opened transaction
+// populated after that write committed, even though the entry is sitting
+// right there in the cache when the older transaction finally queries it.
+func TestReadCacheDoesNotServeFutureDataToStaleSnapshot(t *testing.T) {
+	s, _ := newTestStoreWithCountingIndex(t)
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	// Open a long-lived read pinned to the pre-write revision, but don't
+	// query it yet.
+	staleTxn := s.Read(ConcurrentReadTxMode, traceutil.TODO())
+	defer staleTxn.End()
+
+	s.Put([]byte("foo"), []byte("newBar"), lease.NoLease)
+
+	// A fresh, current read populates the cache with the post-write value.
+	rr, err := s.Range(context.Background(), []byte("foo"), nil, RangeOptions{})
+	require.NoError(t, err)
+	require.Len(t, rr.KVs, 1)
+	require.Equal(t, []byte("newBar"), rr.KVs[0].Value)
+
+	// The stale transaction must still see its own snapshot, not the entry
+	// the fresh read just cached.
+	staleRR, err := staleTxn.Range(context.Background(), []byte("foo"), nil, RangeOptions{})
+	require.NoError(t, err)
+	require.Len(t, staleRR.KVs, 1)
+	assert.Equal(t, []byte("bar"), staleRR.KVs[0].Value, "a read opened before the write must not observe it via the cache")
+}
+
+func TestReadCacheClearedOnRestore(t *testing.T) {
+	s, ci := newTestStoreWithCountingIndex(t)
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	_, err := s.Range(context.Background(), []byte("foo"), nil, RangeOptions{})
+	require.NoError(t, err)
+	require.Equal(t, 1, ci.calls)
+
+	b2, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { b2.Close() })
+	require.NoError(t, s.Restore(b2))
+	// kvindex was reset by Restore; re-wrap it so the counter keeps working.
+	ci2 := &countingIndex{index: s.kvindex}
+	s.kvindex = ci2
+
+	_, err = s.Range(context.Background(), []byte("foo"), nil, RangeOptions{})
+	require.NoError(t, err)
+	assert.Equal(t, 1, ci2.calls, "cache must not survive a Restore with stale data")
+}
