diff --git a/server/etcdserver/read_cache.go b/server/etcdserver/read_cache.go
new file mode 100644
index 000000000..fecfe4d95
--- /dev/null
+++ b/server/etcdserver/read_cache.go
@@ -0,0 +1,222 @@
+// Copyright 2025 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package etcdserver
+
+import (
+	"sync"
+
+	"google.golang.org/protobuf/proto"
+	"k8s.io/utils/lru"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+	"go.etcd.io/etcd/pkg/v3/adt"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/storage/backend"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+// defaultReadCacheEntries bounds the number of distinct RangeRequests kept
+// in the read cache, mirroring grpcproxy's default range-cache size.
+const defaultReadCacheEntries = 2048
+
+// rangeReadCache caches the result of RangeRequests keyed on their
+// parameters, so that identical requests issued shortly after one another
+// can be served without re-executing the MVCC range scan.
+//
+// Entries are evicted synchronously as part of applying the write that
+// changes them (see invalidatingTxnWrite below), not on a timer, so a
+// cache hit always reflects every write that has been applied so far. This
+// is what makes it safe to serve linearizable reads from the cache: by the
+// time a linearizable read is allowed to proceed (after LinearizableReadNotify
+// confirms the local node has applied everything that was committed before
+// the read began) any write that would have invalidated a cache entry has
+// already run to completion, since invalidation happens inside the same
+// apply call that performs the write.
+type rangeReadCache struct {
+	mu         sync.Mutex
+	maxEntries int
+	lru        *lru.Cache
+	// ranges indexes cached entries by the [key, rangeEnd) they were
+	// computed over, so a write can find every cache entry it affects.
+	ranges adt.IntervalTree
+}
+
+func newRangeReadCache(maxEntries int) *rangeReadCache {
+	return &rangeReadCache{
+		maxEntries: maxEntries,
+		lru:        lru.New(maxEntries),
+		ranges:     adt.NewIntervalTree(),
+	}
+}
+
+// rangeCacheable reports whether r's result can ever be served from, or
+// added to, the cache. Requests pinned to an explicit historical revision
+// are passed through untouched: they are not the repeated-current-read
+// pattern this cache targets, and excluding them keeps invalidation simple.
+func rangeCacheable(r *pb.RangeRequest) bool {
+	return r.Revision == 0
+}
+
+// rangeCacheKey returns a key that is identical for two RangeRequests iff
+// they would produce the same result at the same revision. Serializable is
+// deliberately excluded: it only affects how fresh the answer must be, not
+// its content, so linearizable and serializable requests for the same
+// range/options share cache entries.
+func rangeCacheKey(r *pb.RangeRequest) string {
+	cr := &pb.RangeRequest{
+		Key:               r.Key,
+		RangeEnd:          r.RangeEnd,
+		Limit:             r.Limit,
+		SortOrder:         r.SortOrder,
+		SortTarget:        r.SortTarget,
+		KeysOnly:          r.KeysOnly,
+		CountOnly:         r.CountOnly,
+		MinModRevision:    r.MinModRevision,
+		MaxModRevision:    r.MaxModRevision,
+		MinCreateRevision: r.MinCreateRevision,
+		MaxCreateRevision: r.MaxCreateRevision,
+	}
+	b, err := proto.Marshal(cr)
+	if err != nil {
+		panic(err)
+	}
+	return string(b)
+}
+
+// rangeInterval returns the [key, rangeEnd) interval a RangeRequest reads
+// over, in the same terms mvcc itself uses: a request with no range end
+// reads a single key, and a range end of a single 0 byte means "no upper
+// bound" (mirrors txn.mkGteRange).
+func rangeInterval(key, rangeEnd []byte) adt.Interval {
+	if len(rangeEnd) == 0 {
+		return adt.NewStringAffinePoint(string(key))
+	}
+	end := rangeEnd
+	if len(end) == 1 && end[0] == 0 {
+		end = []byte{}
+	}
+	return adt.NewStringAffineInterval(string(key), string(end))
+}
+
+// Get returns the cached response for r, if any.
+func (c *rangeReadCache) Get(r *pb.RangeRequest) (*pb.RangeResponse, bool) {
+	if c == nil || !rangeCacheable(r) {
+		return nil, false
+	}
+	key := rangeCacheKey(r)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	v, ok := c.lru.Get(key)
+	if !ok {
+		return nil, false
+	}
+	return v.(*pb.RangeResponse), true
+}
+
+// Add stores resp as the cached answer for r.
+func (c *rangeReadCache) Add(r *pb.RangeRequest, resp *pb.RangeResponse) {
+	if c == nil || !rangeCacheable(r) {
+		return
+	}
+	key := rangeCacheKey(r)
+	// Store only the parts of the response that do not vary with the
+	// point in time the cache entry is served: Header.Revision is
+	// re-stamped with the live revision on every hit.
+	cached := &pb.RangeResponse{Kvs: resp.Kvs, More: resp.More, Count: resp.Count}
+	ivl := rangeInterval(r.Key, r.RangeEnd)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.lru.Add(key, cached)
+	if iv := c.ranges.Find(ivl); iv != nil {
+		iv.Val.(map[string]struct{})[key] = struct{}{}
+	} else {
+		c.ranges.Insert(ivl, map[string]struct{}{key: {}})
+	}
+}
+
+// invalidate evicts every cached entry whose range overlaps any of the
+// given key changes. It must be called synchronously with applying the
+// write that produced those changes, before the write becomes visible to
+// any other reader, so that no reader can observe a cache entry that is
+// older than the data it now covers.
+func (c *rangeReadCache) invalidate(changes []*mvccpb.KeyValue) {
+	if len(changes) == 0 {
+		return
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	var toDelete []adt.Interval
+	for _, kv := range changes {
+		ivs := c.ranges.Stab(adt.NewStringAffinePoint(string(kv.Key)))
+		for _, iv := range ivs {
+			for key := range iv.Val.(map[string]struct{}) {
+				c.lru.Remove(key)
+			}
+			toDelete = append(toDelete, iv.Ivl)
+		}
+	}
+	// Delete after evicting all keys since Stab results are invalidated by
+	// mutating the tree.
+	for _, ivl := range toDelete {
+		c.ranges.Delete(ivl)
+	}
+}
+
+// reset drops every cached entry. Used when the underlying data can change
+// in ways that do not go through the normal write path, such as a full
+// snapshot restore.
+func (c *rangeReadCache) reset() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.lru = lru.New(c.maxEntries)
+	c.ranges = adt.NewIntervalTree()
+}
+
+// cachingKV wraps a WatchableKV so that every write is synchronously
+// followed by invalidation of the matching cache entries, and a full
+// Restore invalidates the cache entirely.
+type cachingKV struct {
+	mvcc.WatchableKV
+	cache *rangeReadCache
+}
+
+func newCachingKV(kv mvcc.WatchableKV, cache *rangeReadCache) mvcc.WatchableKV {
+	return &cachingKV{WatchableKV: kv, cache: cache}
+}
+
+func (c *cachingKV) Write(trace *traceutil.Trace) mvcc.TxnWrite {
+	return &invalidatingTxnWrite{TxnWrite: c.WatchableKV.Write(trace), cache: c.cache}
+}
+
+func (c *cachingKV) Restore(b backend.Backend) error {
+	err := c.WatchableKV.Restore(b)
+	c.cache.reset()
+	return err
+}
+
+type invalidatingTxnWrite struct {
+	mvcc.TxnWrite
+	cache *rangeReadCache
+}
+
+func (tw *invalidatingTxnWrite) End() {
+	changes := tw.Changes()
+	tw.TxnWrite.End()
+	tw.cache.invalidate(changes)
+}
