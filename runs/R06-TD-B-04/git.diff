+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package etcdserver
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+	"go.etcd.io/etcd/server/v3/storage/backend"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+func TestRangeReadCacheHitMiss(t *testing.T) {
+	c := newRangeReadCache(16)
+	req := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}
+	resp := &pb.RangeResponse{Kvs: []*mvccpb.KeyValue{{Key: []byte("abc"), Value: []byte("1")}}, Count: 1}
+
+	_, ok := c.Get(req)
+	require.False(t, ok, "must miss before Add")
+
+	c.Add(req, resp)
+	got, ok := c.Get(req)
+	require.True(t, ok, "must hit after Add")
+	assert.Equal(t, resp.Kvs, got.Kvs)
+	assert.Equal(t, resp.Count, got.Count)
+
+	// A request differing only in an option that affects the result
+	// (CountOnly) must be a distinct cache entry.
+	req2 := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z"), CountOnly: true}
+	_, ok = c.Get(req2)
+	assert.False(t, ok, "different options must not share a cache entry")
+
+	// Serializable vs. linearizable requests for the same params must
+	// share the same cache entry: the flag only affects freshness, not
+	// content.
+	serReq := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z"), Serializable: true}
+	_, ok = c.Get(serReq)
+	assert.True(t, ok, "serializable and linearizable requests must share cache entries")
+}
+
+func TestRangeReadCacheSkipsPinnedRevision(t *testing.T) {
+	c := newRangeReadCache(16)
+	req := &pb.RangeRequest{Key: []byte("a"), Revision: 5}
+
+	c.Add(req, &pb.RangeResponse{Count: 1})
+	_, ok := c.Get(req)
+	assert.False(t, ok, "requests pinned to a historical revision must never be cached")
+}
+
+func TestRangeReadCacheNilSafe(t *testing.T) {
+	var c *rangeReadCache
+	req := &pb.RangeRequest{Key: []byte("a")}
+
+	_, ok := c.Get(req)
+	assert.False(t, ok)
+	assert.NotPanics(t, func() { c.Add(req, &pb.RangeResponse{}) })
+}
+
+func TestRangeReadCacheInvalidate(t *testing.T) {
+	c := newRangeReadCache(16)
+
+	single := &pb.RangeRequest{Key: []byte("foo")}
+	overlapping := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}
+	fromKey := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte{0}} // unbounded from "a"
+	disjoint := &pb.RangeRequest{Key: []byte("x"), RangeEnd: []byte("y")}
+
+	for _, r := range []*pb.RangeRequest{single, overlapping, fromKey, disjoint} {
+		c.Add(r, &pb.RangeResponse{Count: 1})
+	}
+
+	// A write to "foo" (which falls in [a,z), is >= "a", but is < "x")
+	// should invalidate every entry covering it and leave the disjoint
+	// entry untouched.
+	c.invalidate([]*mvccpb.KeyValue{{Key: []byte("foo")}})
+
+	_, ok := c.Get(single)
+	assert.False(t, ok, "single-key entry for the written key must be invalidated")
+	_, ok = c.Get(overlapping)
+	assert.False(t, ok, "overlapping range entry must be invalidated")
+	_, ok = c.Get(fromKey)
+	assert.False(t, ok, "unbounded-from-key entry covering the write must be invalidated")
+	_, ok = c.Get(disjoint)
+	assert.True(t, ok, "entry for a disjoint range must survive an unrelated write")
+}
+
+func TestRangeReadCacheReset(t *testing.T) {
+	c := newRangeReadCache(16)
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	c.Add(req, &pb.RangeResponse{Count: 1})
+
+	c.reset()
+
+	_, ok := c.Get(req)
+	assert.False(t, ok, "reset must drop every cached entry")
+}
+
+// fakeTxnWrite implements just enough of mvcc.TxnWrite to exercise
+// invalidatingTxnWrite; any unimplemented method promoted from the nil
+// embedded interface is never called by the code under test.
+type fakeTxnWrite struct {
+	mvcc.TxnWrite
+	changes []*mvccpb.KeyValue
+	ended   bool
+}
+
+func (f *fakeTxnWrite) Changes() []*mvccpb.KeyValue { return f.changes }
+func (f *fakeTxnWrite) End()                        { f.ended = true }
+
+func TestInvalidatingTxnWriteEvictsAfterCommit(t *testing.T) {
+	cache := newRangeReadCache(16)
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	cache.Add(req, &pb.RangeResponse{Count: 1})
+
+	ftw := &fakeTxnWrite{changes: []*mvccpb.KeyValue{{Key: []byte("foo")}}}
+	tw := &invalidatingTxnWrite{TxnWrite: ftw, cache: cache}
+	tw.End()
+
+	assert.True(t, ftw.ended, "the underlying commit must still happen")
+	_, ok := cache.Get(req)
+	assert.False(t, ok, "the write's key must be invalidated once End returns")
+}
+
+// fakeWatchableKV implements just enough of mvcc.WatchableKV to exercise
+// cachingKV.Restore.
+type fakeWatchableKV struct {
+	mvcc.WatchableKV
+}
+
+func (f *fakeWatchableKV) Restore(backend.Backend) error { return nil }
+
+func TestCachingKVRestoreResetsCache(t *testing.T) {
+	cache := newRangeReadCache(16)
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	cache.Add(req, &pb.RangeResponse{Count: 1})
+
+	kv := newCachingKV(&fakeWatchableKV{}, cache)
+	require.NoError(t, kv.Restore(nil))
+
+	_, ok := cache.Get(req)
+	assert.False(t, ok, "a full restore must invalidate every cached entry")
+}
