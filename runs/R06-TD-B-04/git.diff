+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package integration
+
+import (
+	"context"
+	"fmt"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/tests/v3/framework/integration"
+)
+
+// TestV3RangeCacheReflectsWrites repeats the same Range request (so the
+// server's read cache is warmed and then hit) immediately after every
+// write to the key it reads, for both linearizable and serializable
+// requests. A cached response must never be older than what an equivalent
+// uncached read would have returned at the time it was made, so every read
+// here must observe the value from the write that immediately preceded it.
+func TestV3RangeCacheReflectsWrites(t *testing.T) {
+	integration.BeforeTest(t)
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 3})
+	defer clus.Terminate(t)
+	kvc := integration.ToGRPC(clus.RandClient()).KV
+	ctx := context.Background()
+
+	key := []byte("cachekey")
+
+	for i := range 50 {
+		val := []byte(fmt.Sprintf("v%d", i))
+		putResp, err := kvc.Put(ctx, &pb.PutRequest{Key: key, Value: val})
+		require.NoError(t, err)
+
+		for _, serializable := range []bool{false, true} {
+			// Issue the read twice: the first (re)computes the cache
+			// entry for this key, the second should be served from it.
+			// Neither may return a value older than what was just
+			// written.
+			for attempt := range 2 {
+				rangeResp, err := kvc.Range(ctx, &pb.RangeRequest{Key: key, Serializable: serializable})
+				require.NoError(t, err)
+				require.Len(t, rangeResp.Kvs, 1)
+				assert.Equalf(t, val, rangeResp.Kvs[0].Value,
+					"iteration %d serializable=%v attempt=%d: stale read", i, serializable, attempt)
+				assert.GreaterOrEqualf(t, rangeResp.Header.Revision, putResp.Header.Revision,
+					"iteration %d serializable=%v attempt=%d: response revision went backwards", i, serializable, attempt)
+			}
+		}
+	}
+}
+
+// TestV3RangeCacheInvalidatesOnDelete warms the cache for a range read,
+// deletes one of the keys it covers, and checks that a repeated read of
+// the same range immediately reflects the deletion rather than replaying
+// the cached (now stale) key list.
+func TestV3RangeCacheInvalidatesOnDelete(t *testing.T) {
+	integration.BeforeTest(t)
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 3})
+	defer clus.Terminate(t)
+	kvc := integration.ToGRPC(clus.RandClient()).KV
+	ctx := context.Background()
+
+	for _, k := range []string{"a", "b", "c"} {
+		_, err := kvc.Put(ctx, &pb.PutRequest{Key: []byte(k), Value: []byte(k)})
+		require.NoError(t, err)
+	}
+
+	req := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}
+
+	// Warm the cache.
+	for range 3 {
+		resp, err := kvc.Range(ctx, req)
+		require.NoError(t, err)
+		require.Len(t, resp.Kvs, 3)
+	}
+
+	_, err := kvc.DeleteRange(ctx, &pb.DeleteRangeRequest{Key: []byte("b")})
+	require.NoError(t, err)
+
+	resp, err := kvc.Range(ctx, req)
+	require.NoError(t, err)
+	require.Len(t, resp.Kvs, 2, "deleted key must not be served from a stale cache entry")
+	for _, kv := range resp.Kvs {
+		assert.NotEqual(t, "b", string(kv.Key))
+	}
+}
+
+// TestV3RangeCacheSurvivesUnrelatedWrites checks that a cache entry for one
+// key range is not invalidated by writes to a disjoint key range: cached
+// reads must not behave any differently than the requirement mandates for
+// keys the write never touched.
+func TestV3RangeCacheSurvivesUnrelatedWrites(t *testing.T) {
+	integration.BeforeTest(t)
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 3})
+	defer clus.Terminate(t)
+	kvc := integration.ToGRPC(clus.RandClient()).KV
+	ctx := context.Background()
+
+	_, err := kvc.Put(ctx, &pb.PutRequest{Key: []byte("a"), Value: []byte("v0")})
+	require.NoError(t, err)
+
+	req := &pb.RangeRequest{Key: []byte("a")}
+	first, err := kvc.Range(ctx, req)
+	require.NoError(t, err)
+	require.Len(t, first.Kvs, 1)
+
+	for i := range 20 {
+		_, err = kvc.Put(ctx, &pb.PutRequest{Key: []byte("unrelated"), Value: []byte(fmt.Sprintf("v%d", i))})
+		require.NoError(t, err)
+	}
+
+	resp, err := kvc.Range(ctx, req)
+	require.NoError(t, err)
+	require.Len(t, resp.Kvs, 1)
+	assert.Equal(t, []byte("v0"), resp.Kvs[0].Value)
+}
