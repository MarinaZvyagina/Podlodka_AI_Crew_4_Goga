diff --git a/server/storage/mvcc/kvstore.go b/server/storage/mvcc/kvstore.go
index a9cb65c0c..16a541d30 100644
--- a/server/storage/mvcc/kvstore.go
+++ b/server/storage/mvcc/kvstore.go
@@ -48,6 +48,26 @@ var (
 type StoreConfig struct {
 	CompactionBatchLimit    int
 	CompactionSleepInterval time.Duration
+
+	// ReadCacheInvalidator, if set, is notified about every write and
+	// compaction so that a higher-level cache of Range results can stay
+	// coherent with the keyspace. It is optional; a nil value disables the
+	// notifications entirely.
+	ReadCacheInvalidator ReadCacheInvalidator
+}
+
+// ReadCacheInvalidator lets a cache of Range results (kept outside of mvcc)
+// stay coherent with the keyspace without polling or relying on a fixed
+// expiration: mvcc calls it synchronously as part of committing a write or
+// compaction, before the write/compaction is visible to any subsequent read.
+type ReadCacheInvalidator interface {
+	// Invalidate is called once per completed write, after rev is visible to
+	// new reads, with every key the write put or deleted.
+	Invalidate(rev int64, keys [][]byte)
+
+	// Compact is called after the store has compacted away revisions older
+	// than rev.
+	Compact(rev int64)
 }
 
 type store struct {
@@ -265,6 +285,9 @@ func (s *store) compactLockfree(rev int64) (<-chan struct{}, error) {
 	if err != nil {
 		return ch, err
 	}
+	if s.cfg.ReadCacheInvalidator != nil {
+		s.cfg.ReadCacheInvalidator.Compact(rev)
+	}
 
 	return s.compact(traceutil.TODO(), rev, prevCompactRev, prevCompactionCompleted), nil
 }
@@ -278,6 +301,9 @@ func (s *store) Compact(trace *traceutil.Trace, rev int64) (<-chan struct{}, err
 		s.mu.Unlock()
 		return ch, err
 	}
+	if s.cfg.ReadCacheInvalidator != nil {
+		s.cfg.ReadCacheInvalidator.Compact(rev)
+	}
 	s.mu.Unlock()
 
 	return s.compact(trace, rev, prevCompactRev, prevCompactionCompleted), nil
diff --git a/server/storage/mvcc/read_cache_test.go b/server/storage/mvcc/read_cache_test.go
new file mode 100644
index 000000000..a09b1928a
--- /dev/null
+++ b/server/storage/mvcc/read_cache_test.go
@@ -0,0 +1,140 @@
+// Copyright 2026 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package mvcc
+
+import (
+	"sync"
+	"testing"
+
+	"go.uber.org/zap/zaptest"
+
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+)
+
+// spyInvalidator records every Invalidate/Compact call it receives, so
+// tests can assert that mvcc notifies a registered ReadCacheInvalidator
+// exactly when writes and compactions commit.
+type spyInvalidator struct {
+	mu           sync.Mutex
+	invalidated  []spyInvalidation
+	compactedRev []int64
+}
+
+type spyInvalidation struct {
+	rev  int64
+	keys []string
+}
+
+func (s *spyInvalidator) Invalidate(rev int64, keys [][]byte) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	ks := make([]string, len(keys))
+	for i, k := range keys {
+		ks[i] = string(k)
+	}
+	s.invalidated = append(s.invalidated, spyInvalidation{rev: rev, keys: ks})
+}
+
+func (s *spyInvalidator) Compact(rev int64) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.compactedRev = append(s.compactedRev, rev)
+}
+
+func (s *spyInvalidator) calls() []spyInvalidation {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return append([]spyInvalidation(nil), s.invalidated...)
+}
+
+func TestWatchableStorePutNotifiesReadCacheInvalidator(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	spy := &spyInvalidator{}
+	s := New(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{ReadCacheInvalidator: spy})
+	defer cleanup(s, b)
+
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	calls := spy.calls()
+	if len(calls) != 1 {
+		t.Fatalf("got %d Invalidate calls, want 1: %+v", len(calls), calls)
+	}
+	if len(calls[0].keys) != 1 || calls[0].keys[0] != "foo" {
+		t.Fatalf("got keys %v, want [foo]", calls[0].keys)
+	}
+	if calls[0].rev != s.Rev() {
+		t.Fatalf("Invalidate rev = %d, want current store rev %d", calls[0].rev, s.Rev())
+	}
+}
+
+func TestWatchableStoreDeleteRangeNotifiesReadCacheInvalidator(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	spy := &spyInvalidator{}
+	s := New(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{ReadCacheInvalidator: spy})
+	defer cleanup(s, b)
+
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+	s.Put([]byte("foo2"), []byte("bar2"), lease.NoLease)
+
+	s.DeleteRange([]byte("foo"), []byte("foo9"))
+
+	calls := spy.calls()
+	if len(calls) != 3 {
+		t.Fatalf("got %d Invalidate calls, want 3 (2 puts + 1 delete range): %+v", len(calls), calls)
+	}
+	last := calls[2]
+	if len(last.keys) != 2 {
+		t.Fatalf("got %d deleted keys, want 2: %+v", len(last.keys), last)
+	}
+}
+
+func TestWatchableStoreTxnWithNoChangesDoesNotNotify(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	spy := &spyInvalidator{}
+	s := New(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{ReadCacheInvalidator: spy})
+	defer cleanup(s, b)
+
+	// DeleteRange over a key range with nothing in it makes no changes, so
+	// there is nothing to invalidate.
+	s.DeleteRange([]byte("nope"), nil)
+
+	if calls := spy.calls(); len(calls) != 0 {
+		t.Fatalf("got %d Invalidate calls, want 0: %+v", len(calls), calls)
+	}
+}
+
+func TestStoreCompactNotifiesReadCacheInvalidator(t *testing.T) {
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	spy := &spyInvalidator{}
+	s := New(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{ReadCacheInvalidator: spy})
+	defer cleanup(s, b)
+
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+	s.Put([]byte("foo"), []byte("bar2"), lease.NoLease)
+
+	ch, err := s.Compact(traceutil.TODO(), 2)
+	if err != nil {
+		t.Fatalf("Compact failed: %v", err)
+	}
+	<-ch
+
+	spy.mu.Lock()
+	defer spy.mu.Unlock()
+	if len(spy.compactedRev) != 1 || spy.compactedRev[0] != 2 {
+		t.Fatalf("got compacted revs %v, want [2]", spy.compactedRev)
+	}
+}
