diff --git a/server/etcdserver/rangecache/rangecache.go b/server/etcdserver/rangecache/rangecache.go
new file mode 100644
index 000000000..e731ffba3
--- /dev/null
+++ b/server/etcdserver/rangecache/rangecache.go
@@ -0,0 +1,228 @@
+// Copyright 2026 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Package rangecache caches Range responses so that repeated read requests
+// with identical parameters don't need to redo the full read path. It stays
+// coherent with the keyspace by implementing mvcc.ReadCacheInvalidator,
+// which the mvcc store calls synchronously on every write and compaction.
+package rangecache
+
+import (
+	"sync"
+
+	"google.golang.org/protobuf/proto"
+	"k8s.io/utils/lru"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/pkg/v3/adt"
+)
+
+// DefaultMaxEntries bounds the number of distinct requests the cache
+// remembers at once.
+const DefaultMaxEntries = 2048
+
+// Cache caches RangeResponses keyed by their RangeRequest parameters.
+//
+// A response is only cached if it was read at a revision no older than the
+// most recent write this cache has been told about via Invalidate, which
+// closes the race where a write commits (and invalidates any existing
+// entries) after a concurrent read fetched its result but before that read
+// stored it in the cache: whichever of Add/Invalidate runs second either
+// finds nothing to evict, or observes the newer lastWriteRev and refuses to
+// cache stale data.
+type Cache struct {
+	mu sync.Mutex
+
+	lru *lru.Cache
+
+	// ranges is a reverse index from a cached request's key range back to
+	// its lru key(s), so a write touching part of that range can find and
+	// evict them.
+	ranges adt.IntervalTree
+
+	// lastWriteRev is the highest revision passed to Invalidate so far.
+	lastWriteRev int64
+
+	// compactedRev is the highest revision passed to Compact so far.
+	compactedRev int64
+}
+
+// New creates a Cache holding up to maxEntries requests. maxEntries <= 0
+// uses DefaultMaxEntries.
+func New(maxEntries int) *Cache {
+	if maxEntries <= 0 {
+		maxEntries = DefaultMaxEntries
+	}
+	return &Cache{
+		lru:          lru.New(maxEntries),
+		ranges:       adt.NewIntervalTree(),
+		compactedRev: -1,
+	}
+}
+
+// Get returns a cached response for req, if any. The caller owns the
+// returned response and may mutate it (e.g. to fill in the cluster header)
+// without affecting the cache or any other caller. A nil Cache always
+// misses, so callers that never construct one behave exactly as if there
+// were no cache at all.
+func (c *Cache) Get(req *pb.RangeRequest) (*pb.RangeResponse, bool) {
+	if c == nil {
+		return nil, false
+	}
+
+	key := cacheKey(req)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if req.Revision != 0 && req.Revision <= c.compactedRev {
+		// A live read of this pinned revision would now fail with
+		// ErrCompacted; don't keep serving the response cached before the
+		// compaction ran.
+		c.lru.Remove(key)
+		return nil, false
+	}
+
+	v, ok := c.lru.Get(key)
+	if !ok {
+		return nil, false
+	}
+	return cloneResponse(v.(*pb.RangeResponse)), true
+}
+
+// Add caches resp as the response for req, unless a write that could have
+// raced with the read producing resp has already been observed. Add is a
+// no-op on a nil Cache.
+func (c *Cache) Add(req *pb.RangeRequest, resp *pb.RangeResponse) {
+	if c == nil || resp == nil || resp.Header == nil {
+		return
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if resp.Header.Revision < c.lastWriteRev {
+		return
+	}
+
+	key := cacheKey(req)
+	c.lru.Add(key, cloneResponse(resp))
+
+	if req.Revision != 0 {
+		// Pinned-revision reads are answered from immutable history; they
+		// don't need to be found and evicted by Invalidate.
+		return
+	}
+
+	ivl := requestInterval(req)
+	if iv := c.ranges.Find(ivl); iv != nil {
+		iv.Val.(map[string]struct{})[key] = struct{}{}
+	} else {
+		c.ranges.Insert(ivl, map[string]struct{}{key: {}})
+	}
+}
+
+// Invalidate implements mvcc.ReadCacheInvalidator. It evicts every cached
+// response whose range overlaps any of keys.
+func (c *Cache) Invalidate(rev int64, keys [][]byte) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if rev > c.lastWriteRev {
+		c.lastWriteRev = rev
+	}
+	for _, key := range keys {
+		c.evict(key)
+	}
+}
+
+// Compact implements mvcc.ReadCacheInvalidator.
+func (c *Cache) Compact(rev int64) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if rev > c.compactedRev {
+		c.compactedRev = rev
+	}
+}
+
+// Size returns the number of responses currently cached.
+func (c *Cache) Size() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.lru.Len()
+}
+
+func (c *Cache) evict(key []byte) {
+	ivl := adt.NewStringAffinePoint(string(key))
+	matched := c.ranges.Stab(ivl)
+	for _, iv := range matched {
+		for lruKey := range iv.Val.(map[string]struct{}) {
+			c.lru.Remove(lruKey)
+		}
+	}
+	for _, iv := range matched {
+		c.ranges.Delete(iv.Ivl)
+	}
+}
+
+func requestInterval(req *pb.RangeRequest) adt.Interval {
+	if len(req.RangeEnd) != 0 {
+		return adt.NewStringAffineInterval(string(req.Key), string(req.RangeEnd))
+	}
+	return adt.NewStringAffinePoint(string(req.Key))
+}
+
+// cacheKey returns a lookup key that identifies req's parameters.
+// Serializable is normalized so a linearizable and a serializable read of
+// otherwise-identical parameters share a cache entry: by the time either
+// reaches the cache, the caller has already applied whatever consistency
+// wait its request required, so a hit reflects data no older than either
+// read would otherwise have observed.
+func cacheKey(req *pb.RangeRequest) string {
+	// req is exclusively owned by the goroutine handling this request, so it
+	// is safe to flip Serializable for the marshal and restore it right
+	// after, without copying the message (which would copy the proto
+	// internal lock and trip go vet's copylocks check).
+	orig := req.Serializable
+	req.Serializable = true
+	b, err := proto.Marshal(req)
+	req.Serializable = orig
+	if err != nil {
+		panic(err)
+	}
+	return string(b)
+}
+
+// cloneResponse returns a shallow copy of resp with its own Header, so the
+// caller can safely fill in per-request fields (cluster ID, member ID, raft
+// term) without mutating a value shared with the cache or other callers.
+// Kvs is shared: nothing mutates the returned key-values after they are
+// built.
+func cloneResponse(resp *pb.RangeResponse) *pb.RangeResponse {
+	clone := &pb.RangeResponse{
+		Kvs:   resp.Kvs,
+		More:  resp.More,
+		Count: resp.Count,
+	}
+	if resp.Header != nil {
+		clone.Header = &pb.ResponseHeader{
+			ClusterId: resp.Header.ClusterId,
+			MemberId:  resp.Header.MemberId,
+			Revision:  resp.Header.Revision,
+			RaftTerm:  resp.Header.RaftTerm,
+		}
+	}
+	return clone
+}
diff --git a/server/etcdserver/rangecache/rangecache_test.go b/server/etcdserver/rangecache/rangecache_test.go
new file mode 100644
index 000000000..634785100
--- /dev/null
+++ b/server/etcdserver/rangecache/rangecache_test.go
@@ -0,0 +1,198 @@
+// Copyright 2026 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package rangecache
+
+import (
+	"testing"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestGetMissOnEmptyCache(t *testing.T) {
+	c := New(0)
+	req := &pb.RangeRequest{Key: []byte("a")}
+	if _, ok := c.Get(req); ok {
+		t.Fatal("expected miss on empty cache")
+	}
+}
+
+func TestAddThenGetHits(t *testing.T) {
+	c := New(0)
+	req := &pb.RangeRequest{Key: []byte("a")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}}
+	c.Add(req, resp)
+
+	got, ok := c.Get(req)
+	if !ok {
+		t.Fatal("expected hit after Add")
+	}
+	if got.Header.Revision != 5 {
+		t.Fatalf("got revision %d, want 5", got.Header.Revision)
+	}
+}
+
+func TestLinearizableAndSerializableShareEntry(t *testing.T) {
+	c := New(0)
+	req := &pb.RangeRequest{Key: []byte("a"), Serializable: false}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}}
+	c.Add(req, resp)
+
+	serReq := &pb.RangeRequest{Key: []byte("a"), Serializable: true}
+	if _, ok := c.Get(serReq); !ok {
+		t.Fatal("expected a serializable read to hit an entry cached by a linearizable read of the same params")
+	}
+
+	// The request object used for the lookup must come back unmodified.
+	if req.Serializable {
+		t.Fatal("Add must not mutate the caller's request")
+	}
+}
+
+func TestDifferentParamsDoNotAlias(t *testing.T) {
+	c := New(0)
+	base := &pb.RangeRequest{Key: []byte("a")}
+	c.Add(base, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	variants := []*pb.RangeRequest{
+		{Key: []byte("b")},
+		{Key: []byte("a"), RangeEnd: []byte("z")},
+		{Key: []byte("a"), Limit: 10},
+		{Key: []byte("a"), KeysOnly: true},
+		{Key: []byte("a"), CountOnly: true},
+		{Key: []byte("a"), Revision: 3},
+		{Key: []byte("a"), SortOrder: pb.RangeRequest_DESCEND},
+	}
+	for _, v := range variants {
+		if _, ok := c.Get(v); ok {
+			t.Fatalf("request %+v must not hit an entry cached for a different request", v)
+		}
+	}
+}
+
+func TestInvalidateEvictsOverlappingRange(t *testing.T) {
+	c := New(0)
+	req := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}
+	c.Add(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	c.Invalidate(2, [][]byte{[]byte("m")})
+
+	if _, ok := c.Get(req); ok {
+		t.Fatal("expected entry to be evicted by an overlapping write")
+	}
+}
+
+func TestInvalidateLeavesNonOverlappingRangeAlone(t *testing.T) {
+	c := New(0)
+	req := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("b")}
+	c.Add(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	c.Invalidate(2, [][]byte{[]byte("m")})
+
+	if _, ok := c.Get(req); !ok {
+		t.Fatal("write outside the cached range must not evict it")
+	}
+}
+
+// TestAddRejectsStaleReadRaceWithInvalidate covers the core correctness
+// property: if a write commits (and invalidates) after a read fetched its
+// snapshot but
+// before that read is stored in the cache, the entry must not be cached,
+// regardless of the order Add/Invalidate happen to run in.
+func TestAddRejectsStaleReadRaceWithInvalidate(t *testing.T) {
+	c := New(0)
+	req := &pb.RangeRequest{Key: []byte("a")}
+	staleResp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}
+
+	// The write's Invalidate call (rev=2) lands before the racing read's Add
+	// call (which is still carrying the pre-write snapshot at rev=1).
+	c.Invalidate(2, [][]byte{[]byte("a")})
+	c.Add(req, staleResp)
+
+	if _, ok := c.Get(req); ok {
+		t.Fatal("must not cache a read whose revision is older than an already-observed write")
+	}
+}
+
+func TestAddBeforeInvalidateStillGetsEvicted(t *testing.T) {
+	c := New(0)
+	req := &pb.RangeRequest{Key: []byte("a")}
+	staleResp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}
+
+	// The racing read's Add call (rev=1) lands first, then the write's
+	// Invalidate call (rev=2) for the same key arrives.
+	c.Add(req, staleResp)
+	c.Invalidate(2, [][]byte{[]byte("a")})
+
+	if _, ok := c.Get(req); ok {
+		t.Fatal("an entry added before a conflicting write's Invalidate call must still be evicted")
+	}
+}
+
+func TestGetReturnsIndependentHeader(t *testing.T) {
+	c := New(0)
+	req := &pb.RangeRequest{Key: []byte("a")}
+	c.Add(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+
+	first, ok := c.Get(req)
+	if !ok {
+		t.Fatal("expected hit")
+	}
+	first.Header.RaftTerm = 42
+
+	second, ok := c.Get(req)
+	if !ok {
+		t.Fatal("expected hit")
+	}
+	if second.Header.RaftTerm == 42 {
+		t.Fatal("mutating one caller's response header must not affect another caller's copy")
+	}
+}
+
+func TestPinnedRevisionEvictedAfterCompact(t *testing.T) {
+	c := New(0)
+	req := &pb.RangeRequest{Key: []byte("a"), Revision: 5}
+	c.Add(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 100}})
+
+	if _, ok := c.Get(req); !ok {
+		t.Fatal("expected hit before compaction")
+	}
+
+	c.Compact(10)
+
+	if _, ok := c.Get(req); ok {
+		t.Fatal("a pinned-revision read older than the compacted revision must miss, so the real path can return ErrCompacted")
+	}
+}
+
+func TestPinnedRevisionNotAffectedByUnrelatedWrite(t *testing.T) {
+	c := New(0)
+	req := &pb.RangeRequest{Key: []byte("a"), Revision: 5}
+	c.Add(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 100}})
+
+	c.Invalidate(101, [][]byte{[]byte("a")})
+
+	if _, ok := c.Get(req); !ok {
+		t.Fatal("pinned-revision reads are immutable and must survive later writes to the same key")
+	}
+}
+
+func TestNilCacheIsANoOp(t *testing.T) {
+	var c *Cache
+	req := &pb.RangeRequest{Key: []byte("a")}
+	c.Add(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+	if _, ok := c.Get(req); ok {
+		t.Fatal("nil cache must always miss")
+	}
+}
