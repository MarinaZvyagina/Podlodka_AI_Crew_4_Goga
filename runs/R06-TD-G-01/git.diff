+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package mvcc
+
+import (
+	"testing"
+	"time"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+	"google.golang.org/protobuf/testing/protocmp"
+
+	"go.etcd.io/etcd/api/v3/mvccpb"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+)
+
+func newRangeCacheTestStore(t *testing.T) *store {
+	t.Helper()
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	s := NewStore(zaptest.NewLogger(t), b, &lease.FakeLessor{}, StoreConfig{})
+	t.Cleanup(func() { cleanup(s, b) })
+	return s
+}
+
+// doRange is a small helper around the exported ReadView.Range so tests can
+// read with the default (all-values) options used throughout this file.
+func doRange(t *testing.T, s *store, key, end []byte) *RangeResult {
+	t.Helper()
+	r, err := s.Range(t.Context(), key, end, RangeOptions{})
+	require.NoError(t, err)
+	return r
+}
+
+func TestRangeCacheServesRepeatedIdenticalRead(t *testing.T) {
+	s := newRangeCacheTestStore(t)
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	first := doRange(t, s, []byte("foo"), nil)
+	require.Len(t, s.rangeCache.entries, 1, "first read should populate the cache")
+
+	second := doRange(t, s, []byte("foo"), nil)
+	require.Len(t, s.rangeCache.entries, 1, "identical repeated read should reuse the entry, not add another")
+	if diff := cmp.Diff(first.KVs, second.KVs, protocmp.Transform()); diff != "" {
+		t.Fatalf("cached read differs from original (-first +second):\n%s", diff)
+	}
+	require.Equal(t, first.Rev, second.Rev)
+}
+
+func TestRangeCacheMissBehavesLikeUncached(t *testing.T) {
+	// A distinct request (different limit) must not be affected by an
+	// unrelated cached entry, and must return correct, uncached data.
+	s := newRangeCacheTestStore(t)
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+	s.Put([]byte("foo1"), []byte("bar1"), lease.NoLease)
+
+	doRange(t, s, []byte("foo"), []byte("fop")) // populate one entry
+
+	r, err := s.Range(t.Context(), []byte("foo"), []byte("fop"), RangeOptions{Limit: 1})
+	require.NoError(t, err)
+	require.Len(t, r.KVs, 1)
+	require.Equal(t, []byte("foo"), r.KVs[0].Key)
+}
+
+func TestRangeCachePutInvalidatesOverlappingRange(t *testing.T) {
+	s := newRangeCacheTestStore(t)
+	s.Put([]byte("foo"), []byte("v1"), lease.NoLease)
+	s.Put([]byte("other"), []byte("unrelated"), lease.NoLease)
+
+	first := doRange(t, s, []byte("foo"), nil)
+	require.Equal(t, []byte("v1"), first.KVs[0].Value)
+
+	otherEntry := doRange(t, s, []byte("other"), nil)
+	require.Equal(t, []byte("unrelated"), otherEntry.KVs[0].Value)
+
+	// A write to "foo" must be visible on the very next read, and must not
+	// disturb the cached entry for the unrelated "other" key.
+	s.Put([]byte("foo"), []byte("v2"), lease.NoLease)
+
+	second := doRange(t, s, []byte("foo"), nil)
+	require.Equal(t, []byte("v2"), second.KVs[0].Value, "read after write must never return stale cached data")
+
+	stillOther := doRange(t, s, []byte("other"), nil)
+	require.Equal(t, []byte("unrelated"), stillOther.KVs[0].Value)
+}
+
+func TestRangeCacheDeleteInvalidatesRange(t *testing.T) {
+	s := newRangeCacheTestStore(t)
+	s.Put([]byte("foo"), []byte("v1"), lease.NoLease)
+	doRange(t, s, []byte("foo"), nil)
+
+	s.DeleteRange([]byte("foo"), nil)
+
+	r := doRange(t, s, []byte("foo"), nil)
+	require.Empty(t, r.KVs, "read after delete must never return the deleted, cached value")
+}
+
+// TestRangeCacheDoesNotLeakFutureDataToOlderSnapshot mirrors
+// TestConcurrentReadNotBlockingWrite: a read transaction opened before a
+// write must keep seeing pre-write data, even if a second, newer read
+// transaction has since populated the shared range cache with the
+// post-write value for the very same key.
+func TestRangeCacheDoesNotLeakFutureDataToOlderSnapshot(t *testing.T) {
+	s := newRangeCacheTestStore(t)
+	s.Put([]byte("foo"), []byte("bar"), lease.NoLease)
+
+	readTx1 := s.Read(ConcurrentReadTxMode, traceutil.TODO())
+	defer readTx1.End()
+
+	done := make(chan struct{}, 1)
+	go func() {
+		s.Put([]byte("foo"), []byte("newBar"), lease.NoLease)
+		done <- struct{}{}
+	}()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("write should not be blocked by read")
+	}
+
+	readTx2 := s.Read(ConcurrentReadTxMode, traceutil.TODO())
+	ro := RangeOptions{Limit: 1}
+	newResult, err := readTx2.Range(t.Context(), []byte("foo"), nil, ro)
+	require.NoError(t, err)
+	require.Equal(t, []byte("newBar"), newResult.KVs[0].Value)
+	readTx2.End()
+
+	oldResult, err := readTx1.Range(t.Context(), []byte("foo"), nil, ro)
+	require.NoError(t, err)
+	require.Equal(t, []byte("bar"), oldResult.KVs[0].Value,
+		"a read transaction opened before the write must not observe the newer, cached value")
+}
+
+func TestRangeCacheResetOnCompact(t *testing.T) {
+	s := newRangeCacheTestStore(t)
+	s.Put([]byte("foo"), []byte("v1"), lease.NoLease) // rev 2
+	s.Put([]byte("foo"), []byte("v2"), lease.NoLease) // rev 3
+
+	// Populate a cache entry pinned to the now-superseded revision 2.
+	r, err := s.Range(t.Context(), []byte("foo"), nil, RangeOptions{Rev: 2})
+	require.NoError(t, err)
+	require.Equal(t, []byte("v1"), r.KVs[0].Value)
+	require.NotEmpty(t, s.rangeCache.entries)
+
+	ch, err := s.Compact(traceutil.TODO(), 3)
+	require.NoError(t, err)
+	<-ch
+
+	require.Empty(t, s.rangeCache.entries, "compaction must drop cached entries that could now be ErrCompacted")
+
+	_, err = s.Range(t.Context(), []byte("foo"), nil, RangeOptions{Rev: 2})
+	require.ErrorIs(t, err, ErrCompacted, "a live read for the compacted revision must still return ErrCompacted")
+}
+
+func TestRangeCacheResetOnRestore(t *testing.T) {
+	s := newRangeCacheTestStore(t)
+	s.Put([]byte("foo"), []byte("v1"), lease.NoLease)
+	doRange(t, s, []byte("foo"), nil)
+	require.NotEmpty(t, s.rangeCache.entries)
+
+	require.NoError(t, s.Restore(s.b))
+	require.Empty(t, s.rangeCache.entries, "restore must drop every cached entry")
+}
+
+func TestRangeCacheEvictsOnCapacity(t *testing.T) {
+	s := newRangeCacheTestStore(t)
+	s.rangeCache = newRangeCache(2)
+	s.Put([]byte("a"), []byte("1"), lease.NoLease)
+	s.Put([]byte("b"), []byte("2"), lease.NoLease)
+	s.Put([]byte("c"), []byte("3"), lease.NoLease)
+
+	doRange(t, s, []byte("a"), nil)
+	doRange(t, s, []byte("b"), nil)
+	doRange(t, s, []byte("c"), nil)
+
+	require.LessOrEqual(t, len(s.rangeCache.entries), 2, "cache must stay within its configured bound")
+}
+
+func TestRangeContainsKey(t *testing.T) {
+	cases := []struct {
+		name       string
+		key, end   []byte
+		k          []byte
+		wantResult bool
+	}{
+		{"single key match", []byte("foo"), nil, []byte("foo"), true},
+		{"single key mismatch", []byte("foo"), nil, []byte("foo1"), false},
+		{"from-key within", []byte("foo"), []byte{}, []byte("zzz"), true},
+		{"from-key before", []byte("foo"), []byte{}, []byte("bar"), false},
+		{"explicit range within", []byte("foo"), []byte("foz"), []byte("fop"), true},
+		{"explicit range at end (exclusive)", []byte("foo"), []byte("foz"), []byte("foz"), false},
+		{"explicit range before start", []byte("foo"), []byte("foz"), []byte("bar"), false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			require.Equal(t, tc.wantResult, rangeContainsKey(tc.key, tc.end, tc.k))
+		})
+	}
+}
+
+func TestCloneRangeResultIsIndependentCopy(t *testing.T) {
+	original := &RangeResult{
+		Rev:   5,
+		Count: 1,
+		KVs:   []*mvccpb.KeyValue{{Key: []byte("foo"), Value: []byte("bar")}},
+	}
+	clone := cloneRangeResult(original)
+	clone.KVs[0].Value = []byte("mutated")
+
+	require.Equal(t, []byte("bar"), original.KVs[0].Value, "mutating a clone must not affect the source")
+}
