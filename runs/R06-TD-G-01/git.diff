diff --git a/server/storage/mvcc/kvstore_range_cache.go b/server/storage/mvcc/kvstore_range_cache.go
new file mode 100644
index 000000000..33ca2643e
--- /dev/null
+++ b/server/storage/mvcc/kvstore_range_cache.go
@@ -0,0 +1,205 @@
+// Copyright 2025 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package mvcc
+
+import (
+	"bytes"
+	"sync"
+
+	"google.golang.org/protobuf/proto"
+
+	"go.etcd.io/etcd/api/v3/mvccpb"
+)
+
+// defaultRangeCacheMaxEntries bounds how many distinct Range queries the
+// read cache remembers at once, so that a client hitting many distinct
+// key ranges cannot grow the cache without bound.
+const defaultRangeCacheMaxEntries = 10000
+
+// rangeCache memoizes the result of ReadView.Range calls made through a
+// plain (non-write) read transaction, so that repeated requests for the
+// same key/range and options don't have to re-walk the in-memory index and
+// re-read the backend when nothing in that range has changed.
+//
+// Every entry is tagged with the store revision (rev) that was current
+// when it was computed. A reader may reuse an entry as long as its own
+// snapshot revision is at or after that tag: since entries are evicted the
+// instant a write touches an overlapping range (see invalidate), an entry
+// that has survived until "now" is guaranteed to still be accurate for any
+// reader whose snapshot falls in [tag, now]. Readers with an older
+// snapshot than the tag (e.g. a long-lived ConcurrentReadTxMode
+// transaction racing a concurrent write) simply miss and fall back to a
+// normal read, so they never observe data from "the future".
+type rangeCache struct {
+	mu         sync.Mutex
+	entries    map[rangeCacheKey]*rangeCacheEntry
+	maxEntries int
+}
+
+type rangeCacheKey struct {
+	key, end       string
+	endIsNil       bool
+	limit          int64
+	rev            int64
+	countOnly      bool
+	fastKeysOnly   bool
+	withTotalCount bool
+}
+
+type rangeCacheEntry struct {
+	key, end []byte
+	rev      int64
+	result   *RangeResult
+}
+
+func newRangeCache(maxEntries int) *rangeCache {
+	if maxEntries <= 0 {
+		maxEntries = defaultRangeCacheMaxEntries
+	}
+	return &rangeCache{
+		entries:    make(map[rangeCacheKey]*rangeCacheEntry),
+		maxEntries: maxEntries,
+	}
+}
+
+func newRangeCacheKey(key, end []byte, ro RangeOptions) rangeCacheKey {
+	return rangeCacheKey{
+		key:            string(key),
+		end:            string(end),
+		endIsNil:       end == nil,
+		limit:          ro.Limit,
+		rev:            ro.Rev,
+		countOnly:      ro.CountOnly,
+		fastKeysOnly:   ro.FastKeysOnly,
+		withTotalCount: ro.WithTotalCount,
+	}
+}
+
+// get returns a cached result for (key, end, ro), provided it is still
+// valid for a reader whose own snapshot revision is readerRev. The
+// returned RangeResult is a private copy with Rev set to readerRev, safe
+// for the caller to use and mutate freely.
+func (c *rangeCache) get(key, end []byte, ro RangeOptions, readerRev int64) (*RangeResult, bool) {
+	k := newRangeCacheKey(key, end, ro)
+
+	c.mu.Lock()
+	e, ok := c.entries[k]
+	c.mu.Unlock()
+
+	if !ok || e.rev > readerRev {
+		return nil, false
+	}
+
+	result := cloneRangeResult(e.result)
+	result.Rev = readerRev
+	return result, true
+}
+
+// put caches result for (key, end, ro) as computed by a reader whose
+// snapshot revision is readAtRev, but only if the store's current revision
+// is still readAtRev: if a write has committed since the read began, the
+// result might already be stale with respect to that write, so it must
+// not enter the cache. The caller is expected to hold s.revMu (at least
+// for reading) across the freshness check that produced readAtRev and
+// this call, so that no write can slip in between.
+func (c *rangeCache) put(key, end []byte, ro RangeOptions, result *RangeResult, readAtRev int64) {
+	k := newRangeCacheKey(key, end, ro)
+	entry := &rangeCacheEntry{
+		key:    append([]byte(nil), key...),
+		end:    cloneNillableBytes(end),
+		rev:    readAtRev,
+		result: cloneRangeResult(result),
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if _, exists := c.entries[k]; !exists && len(c.entries) >= c.maxEntries {
+		// Cheap, non-LRU bound: drop one arbitrary entry to make room
+		// rather than growing without limit.
+		for existing := range c.entries {
+			delete(c.entries, existing)
+			break
+		}
+	}
+	c.entries[k] = entry
+}
+
+// invalidate drops every cached entry whose requested range could contain
+// any of the given keys. Called once per applied write, with the exact
+// keys it changed, so that a subsequent read for an affected range never
+// observes a cached value older than what a fresh read would return.
+func (c *rangeCache) invalidate(changes []*mvccpb.KeyValue) {
+	if len(changes) == 0 {
+		return
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if len(c.entries) == 0 {
+		return
+	}
+	for ck, e := range c.entries {
+		for _, change := range changes {
+			if rangeContainsKey(e.key, e.end, change.Key) {
+				delete(c.entries, ck)
+				break
+			}
+		}
+	}
+}
+
+// reset drops every cached entry. Used when the meaning of "cached" breaks
+// down independently of any single key changing: compaction (a cached
+// historical read may now be ErrCompacted) and restore (the whole
+// keyspace is replaced).
+func (c *rangeCache) reset() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.entries = make(map[rangeCacheKey]*rangeCacheEntry)
+}
+
+// rangeContainsKey reports whether k falls within the range [key, end)
+// using mvcc's range-end convention: end == nil means a single-key lookup,
+// an empty non-nil end means "from key to the end of the keyspace".
+func rangeContainsKey(key, end, k []byte) bool {
+	if bytes.Compare(k, key) < 0 {
+		return false
+	}
+	if end == nil {
+		return bytes.Equal(k, key)
+	}
+	if len(end) == 0 {
+		return true
+	}
+	return bytes.Compare(k, end) < 0
+}
+
+func cloneNillableBytes(b []byte) []byte {
+	if b == nil {
+		return nil
+	}
+	return append([]byte{}, b...)
+}
+
+func cloneRangeResult(rr *RangeResult) *RangeResult {
+	clone := &RangeResult{Rev: rr.Rev, Count: rr.Count}
+	if len(rr.KVs) > 0 {
+		clone.KVs = make([]*mvccpb.KeyValue, len(rr.KVs))
+		for i, kv := range rr.KVs {
+			clone.KVs[i] = proto.Clone(kv).(*mvccpb.KeyValue)
+		}
+	}
+	return clone
+}
diff --git a/server/storage/mvcc/kvstore_range_cache_test.go b/server/storage/mvcc/kvstore_range_cache_test.go
