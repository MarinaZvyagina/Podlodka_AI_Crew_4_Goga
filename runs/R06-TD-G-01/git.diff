diff --git a/server/storage/mvcc/kvstore_txn.go b/server/storage/mvcc/kvstore_txn.go
index f46c79766..b3281881c 100644
--- a/server/storage/mvcc/kvstore_txn.go
+++ b/server/storage/mvcc/kvstore_txn.go
@@ -66,8 +66,34 @@ func (s *store) Read(mode ReadTxMode, trace *traceutil.Trace) TxnRead {
 func (tr *storeTxnCommon) FirstRev() int64 { return tr.firstRev }
 func (tr *storeTxnCommon) Rev() int64      { return tr.rev }
 
+// Range serves cache hits/misses on behalf of read-only transactions.
+// storeTxnWrite defines its own Range below and never reaches this one, so
+// it is safe to consult and populate the store's shared range cache here:
+// every caller of this method is a plain read, never a write-in-progress
+// view of uncommitted changes.
 func (tr *storeTxnCommon) Range(ctx context.Context, key, end []byte, ro RangeOptions) (r *RangeResult, err error) {
-	return tr.rangeKeys(ctx, key, end, tr.Rev(), ro)
