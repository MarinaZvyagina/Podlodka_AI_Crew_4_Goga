+		rangeCacheHitCounter.Inc()
+		return cached, nil
+	}
+	rangeCacheMissCounter.Inc()
+
+	r, err = tr.rangeKeys(ctx, key, end, tr.Rev(), ro)
+	if err != nil {
+		return r, err
+	}
+
+	// Only cache the result if no write has committed since tr.rev was
+	// pinned: otherwise it might already be stale with respect to that
+	// write. Holding revMu across the check and the cache write closes
+	// the race with a concurrent write's own revMu-guarded invalidation.
+	tr.s.revMu.RLock()
+	if tr.s.currentRev == tr.rev {
+		tr.s.rangeCache.put(key, end, ro, r, tr.rev)
+	}
+	tr.s.revMu.RUnlock()
+
+	return r, nil
 }
 
 func (tr *storeTxnCommon) rangeKeys(ctx context.Context, key, end []byte, curRev int64, ro RangeOptions) (*RangeResult, error) {
@@ -212,6 +238,10 @@ func (tw *storeTxnWrite) End() {
 		// hold revMu lock to prevent new read txns from opening until writeback.
