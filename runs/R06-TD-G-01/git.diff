+		// Evict any cached range that could contain one of the changed
+		// keys, and do it while still holding revMu so it can't race
+		// with a concurrent read's cache write (see storeTxnCommon.Range).
+		tw.s.rangeCache.invalidate(tw.changes)
 	}
 	tw.tx.Unlock()
 	if len(tw.changes) != 0 {
