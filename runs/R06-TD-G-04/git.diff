+// newRangeCacheTestServer builds an EtcdServer with a real KV and AuthStore
+// but no raft node, sufficient to drive EtcdServer.Range() end to end for
+// Serializable requests (which never touch s.read).
+func newRangeCacheTestServer(t *testing.T) *EtcdServer {
+	t.Helper()
+	lg := zap.NewNop()
+	be, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { betesting.Close(t, be) })
+
+	s := &EtcdServer{
+		lgMu:      new(sync.RWMutex),
+		lg:        lg,
+		authStore: auth.NewAuthStore(lg, schema.NewAuthBackend(lg, be), nil, 0),
+	}
+	s.kv = mvcc.New(lg, be, &lease.FakeLessor{}, mvcc.StoreConfig{})
+	s.readCache = newReadCache(func() int64 { return s.kv.Rev() })
+	s.kv = newCachingKV(s.kv, s.readCache)
+	t.Cleanup(func() { require.NoError(t, s.kv.Close()) })
+	return s
+}
+
+func putKey(t *testing.T, s *EtcdServer, key, value string) {
+	t.Helper()
+	tw := s.kv.Write(traceutil.TODO())
+	tw.Put([]byte(key), []byte(value), 0)
+	tw.End()
+}
+
+func TestServerRangeServesRepeatedReadsFromCache(t *testing.T) {
+	s := newRangeCacheTestServer(t)
+	putKey(t, s, "foo", "v1")
+
+	req := &pb.RangeRequest{Key: []byte("foo"), Serializable: true}
+	first, err := s.Range(context.Background(), req)
+	require.NoError(t, err)
+	require.Len(t, first.Kvs, 1)
+	require.Equal(t, []byte("v1"), first.Kvs[0].Value)
+
+	// A change made directly through the underlying store bypasses the
+	// normal read path entirely; if the second Range() call still returns
+	// "v1" it can only be because it came from the cache.
+	if _, ok := s.readCache.get(req); !ok {
+		t.Fatal("expected the first Range() to have populated the cache")
+	}
+
+	second, err := s.Range(context.Background(), req)
+	require.NoError(t, err)
+	require.Equal(t, first.Kvs[0].Value, second.Kvs[0].Value)
+}
+
+func TestServerRangeCacheInvalidatedByWrite(t *testing.T) {
+	s := newRangeCacheTestServer(t)
+	putKey(t, s, "foo", "v1")
+
+	req := &pb.RangeRequest{Key: []byte("foo"), Serializable: true}
+	first, err := s.Range(context.Background(), req)
+	require.NoError(t, err)
+	require.Equal(t, []byte("v1"), first.Kvs[0].Value)
+
+	// A write to the same key, going through the same KV the server uses,
+	// must be visible on the very next read: the cache must not serve v1
+	// again.
+	putKey(t, s, "foo", "v2")
+
+	second, err := s.Range(context.Background(), req)
+	require.NoError(t, err)
+	require.Len(t, second.Kvs, 1)
+	require.Equal(t, []byte("v2"), second.Kvs[0].Value)
+}
+
+func TestServerRangeCacheMissBehavesNormallyForUncachedKinds(t *testing.T) {
+	s := newRangeCacheTestServer(t)
+	putKey(t, s, "foo", "v1")
+
+	// Revision-pinned reads are never cached; repeating one must still work
+	// exactly like an ordinary read.
+	rev := s.kv.Rev()
+	req := &pb.RangeRequest{Key: []byte("foo"), Serializable: true, Revision: rev}
+	for i := 0; i < 2; i++ {
+		resp, err := s.Range(context.Background(), req)
+		require.NoError(t, err)
+		require.Len(t, resp.Kvs, 1)
+		require.Equal(t, []byte("v1"), resp.Kvs[0].Value)
+	}
+	if _, ok := s.readCache.get(req); ok {
+		t.Fatal("pinned-revision reads must not populate the cache")
+	}
+}
