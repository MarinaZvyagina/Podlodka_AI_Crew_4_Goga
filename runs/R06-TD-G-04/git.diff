+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package etcdserver
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+)
+
+func newFixedRevCache(rev int64) (*readCache, *int64) {
+	r := rev
+	return newReadCache(func() int64 { return r }), &r
+}
+
+func TestReadCacheGetPutRoundTrip(t *testing.T) {
+	cache, _ := newFixedRevCache(5)
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	resp := &pb.RangeResponse{
+		Header: &pb.ResponseHeader{Revision: 5},
+		Kvs:    []*mvccpb.KeyValue{{Key: []byte("foo"), Value: []byte("bar")}},
+	}
+
+	if _, ok := cache.get(req); ok {
+		t.Fatal("expected a miss before anything is cached")
+	}
+
+	cache.put(req, resp)
+
+	got, ok := cache.get(req)
+	require.True(t, ok, "expected a hit after put")
+	require.Equal(t, resp.Kvs, got.Kvs)
+	require.Equal(t, int64(5), got.Header.Revision)
+
+	// The returned response must not alias the cached one, so that the
+	// gRPC layer's in-place Header mutation doesn't race other readers of
+	// the same cached entry.
+	got.Header.Revision = 999
+	got2, ok := cache.get(req)
+	require.True(t, ok)
+	require.Equal(t, int64(5), got2.Header.Revision)
+}
+
+func TestReadCacheSkipsUncacheableRequests(t *testing.T) {
+	cache, _ := newFixedRevCache(5)
+	req := &pb.RangeRequest{Key: []byte("foo"), Revision: 3}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 3}}
+
+	cache.put(req, resp)
+	if _, ok := cache.get(req); ok {
+		t.Fatal("pinned-revision reads must not be cached")
+	}
+}
+
+func TestReadCacheKeyDistinguishesRequestOptions(t *testing.T) {
+	cache, _ := newFixedRevCache(1)
+	base := &pb.RangeRequest{Key: []byte("foo"), RangeEnd: []byte("fop")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}
+	cache.put(base, resp)
+
+	variants := []*pb.RangeRequest{
+		{Key: []byte("foo"), RangeEnd: []byte("fop"), Limit: 1},
+		{Key: []byte("foo"), RangeEnd: []byte("fop"), KeysOnly: true},
+		{Key: []byte("foo"), RangeEnd: []byte("fop"), CountOnly: true},
+		{Key: []byte("foo"), RangeEnd: []byte("fop"), SortOrder: pb.RangeRequest_DESCEND},
+		{Key: []byte("foo"), RangeEnd: []byte("fop"), SortTarget: pb.RangeRequest_VALUE},
+		{Key: []byte("foo"), RangeEnd: []byte("foq")},
+		{Key: []byte("bar"), RangeEnd: []byte("fop")},
+	}
+	for i, v := range variants {
+		if _, ok := cache.get(v); ok {
+			t.Fatalf("variant %d unexpectedly hit the cache for a different request shape", i)
+		}
+	}
+
+	// Serializable does not change the result, so it should share the entry.
+	same := &pb.RangeRequest{Key: []byte("foo"), RangeEnd: []byte("fop"), Serializable: true}
+	if _, ok := cache.get(same); !ok {
+		t.Fatal("expected Serializable to be irrelevant to the cache key")
+	}
+}
+
+func TestReadCachePutSkipsWhenRevisionMoved(t *testing.T) {
+	cache, rev := newFixedRevCache(5)
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}}
+
+	// Simulate a write having committed after resp was computed but before
+	// we get around to inserting it: put must refuse to cache a result that
+	// might already be stale.
+	*rev = 6
+	cache.put(req, resp)
+
+	if _, ok := cache.get(req); ok {
+		t.Fatal("expected put to skip caching a response computed at a stale revision")
+	}
+}
+
+func TestReadCacheInvalidateOverlap(t *testing.T) {
+	tests := []struct {
+		name       string
+		key, end   []byte
+		changedKey []byte
+		wantHit    bool
+	}{
+		{"exact key match", []byte("foo"), nil, []byte("foo"), false},
+		{"different single key", []byte("foo"), nil, []byte("bar"), true},
+		{"range contains key", []byte("a"), []byte("z"), []byte("m"), false},
+		{"range excludes end boundary", []byte("a"), []byte("z"), []byte("z"), true},
+		{"range excludes key before start", []byte("a"), []byte("z"), []byte("0"), true},
+		{"from-key open range", []byte("m"), []byte{0}, []byte("zzz"), false},
+		{"from-key open range excludes earlier key", []byte("m"), []byte{0}, []byte("a"), true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			cache, _ := newFixedRevCache(1)
+			req := &pb.RangeRequest{Key: tc.key, RangeEnd: tc.end}
+			resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}
+			cache.put(req, resp)
+
+			cache.invalidate([]*mvccpb.KeyValue{{Key: tc.changedKey}})
+
+			_, ok := cache.get(req)
+			require.Equal(t, tc.wantHit, ok)
+		})
+	}
+}
+
+func TestReadCacheLRUEviction(t *testing.T) {
+	cache, rev := newFixedRevCache(0)
+	for i := 0; i < maxReadCacheEntries+10; i++ {
+		*rev = int64(i)
+		req := &pb.RangeRequest{Key: []byte(fmt.Sprintf("key-%04d", i))}
+		resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: int64(i)}}
+		cache.put(req, resp)
+	}
+
+	cache.mu.Lock()
+	size := len(cache.entries)
+	cache.mu.Unlock()
+	require.LessOrEqual(t, size, maxReadCacheEntries)
+
+	// The oldest entry should have been evicted, the newest should remain.
+	if _, ok := cache.get(&pb.RangeRequest{Key: []byte("key-0000")}); ok {
+		t.Fatal("expected the least-recently-used entry to have been evicted")
+	}
+	last := maxReadCacheEntries + 9
+	if _, ok := cache.get(&pb.RangeRequest{Key: []byte(fmt.Sprintf("key-%04d", last))}); !ok {
+		t.Fatal("expected the most recently inserted entry to survive eviction")
+	}
+}
+
+func TestReadCachePurge(t *testing.T) {
+	cache, _ := newFixedRevCache(1)
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}
+	cache.put(req, resp)
+
+	cache.purge()
+
+	if _, ok := cache.get(req); ok {
+		t.Fatal("expected purge to drop all entries")
+	}
+}
+
+func TestReadCacheNilIsSafe(t *testing.T) {
+	var cache *readCache
+	req := &pb.RangeRequest{Key: []byte("foo")}
+	if _, ok := cache.get(req); ok {
+		t.Fatal("nil cache must always miss")
+	}
+	// Must not panic.
+	cache.put(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}})
+}
