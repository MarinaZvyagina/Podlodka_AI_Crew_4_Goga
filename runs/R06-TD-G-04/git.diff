index 000000000..0630036e9
--- /dev/null
+++ b/server/etcdserver/caching_kv.go
@@ -0,0 +1,75 @@
+// Copyright 2026 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package etcdserver
+
+import (
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/lease"
+	"go.etcd.io/etcd/server/v3/storage/backend"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+// cachingKV wraps a mvcc.WatchableKV so that every write committed through
+// it synchronously invalidates the affected entries of a readCache. All
+// mutations in this codebase go through Write (Put and DeleteRange on KV
+// itself are thin wrappers around it, mirrored here), so overriding Write
+// is sufficient to observe every change.
+type cachingKV struct {
+	mvcc.WatchableKV
+	cache *readCache
+}
+
+func newCachingKV(kv mvcc.WatchableKV, cache *readCache) mvcc.WatchableKV {
+	return &cachingKV{WatchableKV: kv, cache: cache}
+}
+
+func (c *cachingKV) Write(trace *traceutil.Trace) mvcc.TxnWrite {
+	return &cachingTxnWrite{TxnWrite: c.WatchableKV.Write(trace), cache: c.cache}
+}
+
+func (c *cachingKV) Put(key, value []byte, lease lease.LeaseID) int64 {
+	tw := c.Write(traceutil.TODO())
+	defer tw.End()
+	return tw.Put(key, value, lease)
+}
+
+func (c *cachingKV) DeleteRange(key, end []byte) (n, rev int64) {
+	tw := c.Write(traceutil.TODO())
+	defer tw.End()
+	return tw.DeleteRange(key, end)
+}
+
+// Restore replaces the store's data wholesale (e.g. when a follower
+// receives a snapshot), so per-key invalidation doesn't apply: drop
+// everything.
+func (c *cachingKV) Restore(b backend.Backend) error {
+	defer c.cache.purge()
+	return c.WatchableKV.Restore(b)
+}
+
+// cachingTxnWrite defers cache invalidation until after the wrapped
+// TxnWrite has actually committed, so that a linearizable read which has
+// observed the commit (via LinearizableReadNotify + applied index) is also
+// guaranteed to observe the invalidation; see readCache's doc comment for
+// the full argument.
+type cachingTxnWrite struct {
+	mvcc.TxnWrite
+	cache *readCache
+}
+
+func (tw *cachingTxnWrite) End() {
+	tw.TxnWrite.End()
+	tw.cache.invalidate(tw.TxnWrite.Changes())
+}
