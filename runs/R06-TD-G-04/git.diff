+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package etcdserver
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+func newTestCachingKV(t *testing.T) (mvcc.WatchableKV, *readCache) {
+	t.Helper()
+	be, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { betesting.Close(t, be) })
+
+	inner := mvcc.New(zap.NewNop(), be, &lease.FakeLessor{}, mvcc.StoreConfig{})
+	t.Cleanup(func() { require.NoError(t, inner.Close()) })
+
+	cache := newReadCache(func() int64 { return inner.Rev() })
+	kv := newCachingKV(inner, cache)
+	return kv, cache
+}
+
+func TestCachingKVInvalidatesOnPut(t *testing.T) {
+	kv, cache := newTestCachingKV(t)
+
+	tw := kv.Write(traceutil.TODO())
+	tw.Put([]byte("foo"), []byte("bar"), 0)
+	tw.End()
+
+	// Prime the cache directly (as EtcdServer.Range would) for a range that
+	// covers the key we're about to change.
+	req := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: kv.Rev()}}
+	cache.put(req, resp)
+	if _, ok := cache.get(req); !ok {
+		t.Fatal("expected cache to hold the freshly inserted entry")
+	}
+
+	tw = kv.Write(traceutil.TODO())
+	tw.Put([]byte("foo"), []byte("baz"), 0)
+	tw.End()
+
+	if _, ok := cache.get(req); ok {
+		t.Fatal("expected Put to invalidate the overlapping cache entry")
+	}
+}
+
+func TestCachingKVInvalidatesOnDeleteRange(t *testing.T) {
+	kv, cache := newTestCachingKV(t)
+
+	tw := kv.Write(traceutil.TODO())
+	tw.Put([]byte("key1"), []byte("v1"), 0)
+	tw.End()
+
+	req := &pb.RangeRequest{Key: []byte("key1")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: kv.Rev()}}
+	cache.put(req, resp)
+
+	n, _ := kv.DeleteRange([]byte("key1"), nil)
+	if n != 1 {
+		t.Fatalf("expected to delete 1 key, deleted %d", n)
+	}
+
+	if _, ok := cache.get(req); ok {
+		t.Fatal("expected DeleteRange to invalidate the matching cache entry")
+	}
+}
+
+func TestCachingKVDoesNotInvalidateUnrelatedKeys(t *testing.T) {
+	kv, cache := newTestCachingKV(t)
+
+	tw := kv.Write(traceutil.TODO())
+	tw.Put([]byte("other"), []byte("v"), 0)
+	tw.End()
+
+	req := &pb.RangeRequest{Key: []byte("key1")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: kv.Rev()}}
+	cache.put(req, resp)
+
+	tw = kv.Write(traceutil.TODO())
+	tw.Put([]byte("unrelated"), []byte("v2"), 0)
+	tw.End()
+
+	if _, ok := cache.get(req); !ok {
+		t.Fatal("expected an unrelated write to leave the cache entry in place")
+	}
+}
+
+func TestCachingKVRestorePurgesCache(t *testing.T) {
+	kv, cache := newTestCachingKV(t)
+
+	req := &pb.RangeRequest{Key: []byte("key1")}
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: kv.Rev()}}
+	cache.put(req, resp)
+	if _, ok := cache.get(req); !ok {
+		t.Fatal("expected cache to hold the freshly inserted entry")
+	}
+
+	be, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() { betesting.Close(t, be) })
+	require.NoError(t, kv.Restore(be))
+
+	if _, ok := cache.get(req); ok {
+		t.Fatal("expected Restore to purge the cache")
+	}
+}
diff --git a/server/etcdserver/read_cache.go b/server/etcdserver/read_cache.go
new file mode 100644
index 000000000..293418304
--- /dev/null
+++ b/server/etcdserver/read_cache.go
@@ -0,0 +1,270 @@
+// Copyright 2026 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package etcdserver
+
+import (
+	"bytes"
+	"container/list"
+	"sync"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+)
+
+// maxReadCacheEntries bounds the read cache so that a workload touching many
+// distinct keys can't grow it without bound; entries beyond the bound are
+// evicted least-recently-used first.
+const maxReadCacheEntries = 512
+
+// rangeCacheKey identifies a Range request by every field that affects its
+// result. Serializable is deliberately excluded: it changes how the result
+// is obtained (whether the local apply state is first confirmed against the
+// leader), not what the result is, so linearizable and serializable
+// requests for the same data share a cache entry.
+type rangeCacheKey struct {
+	key               string
+	rangeEnd          string
+	limit             int64
+	sortOrder         pb.RangeRequest_SortOrder
+	sortTarget        pb.RangeRequest_SortTarget
+	keysOnly          bool
+	countOnly         bool
+	minModRevision    int64
+	maxModRevision    int64
+	minCreateRevision int64
+	maxCreateRevision int64
+}
+
+func newRangeCacheKey(r *pb.RangeRequest) rangeCacheKey {
+	return rangeCacheKey{
+		key:               string(r.Key),
+		rangeEnd:          string(r.RangeEnd),
+		limit:             r.Limit,
+		sortOrder:         r.SortOrder,
+		sortTarget:        r.SortTarget,
+		keysOnly:          r.KeysOnly,
+		countOnly:         r.CountOnly,
+		minModRevision:    r.MinModRevision,
+		maxModRevision:    r.MaxModRevision,
+		minCreateRevision: r.MinCreateRevision,
+		maxCreateRevision: r.MaxCreateRevision,
+	}
+}
+
+// rangeCacheable reports whether r may be served from, or stored in, the
+// read cache. Only requests for the latest data ("give me what's there
+// now") are cached: a pinned-revision read is immutable data with its own
+// compaction semantics, and isn't the repeated-burst pattern this cache
+// targets.
+func rangeCacheable(r *pb.RangeRequest) bool {
+	return r.Revision == 0
+}
+
+// rangeCacheEntry is the cached response for one rangeCacheKey, together
+// with the key range it was computed over (used to match it against writes
+// for invalidation).
+type rangeCacheEntry struct {
+	key      []byte
+	rangeEnd []byte
+	resp     *pb.RangeResponse
+}
+
+// overlapsKey reports whether a change to k could affect this entry's
+// result, using the same [key, rangeEnd) conventions as pb.RangeRequest:
+// an empty rangeEnd means "just key", and a rangeEnd of []byte{0} means
+// "key and everything after it".
+func (e *rangeCacheEntry) overlapsKey(k []byte) bool {
+	switch {
+	case len(e.rangeEnd) == 0:
+		return bytes.Equal(e.key, k)
+	case len(e.rangeEnd) == 1 && e.rangeEnd[0] == 0:
+		return bytes.Compare(k, e.key) >= 0
+	default:
+		return bytes.Compare(k, e.key) >= 0 && bytes.Compare(k, e.rangeEnd) < 0
+	}
+}
+
+// readCache caches Range responses so that repeated, identical read
+// requests arriving in a short burst (e.g. many replicas requesting the
+// same keys at startup) can be served without redoing the full read path.
+//
+// Correctness rests on two properties, both enforced by this type together
+// with cachingKV:
+//
+//  1. invalidate is called synchronously by cachingKV, after (never before)
+//     the write that produced the change has committed and become visible
+//     to new reads. Because it runs inside the same call that applies the
+//     write, a linearizable read that has passed LinearizableReadNotify is
+//     guaranteed to observe any invalidation for a write ordered before it.
+//  2. put re-validates, atomically with the insert (both under mu), that
+//     the store's current revision still matches the revision the response
+//     was computed at. Combined with (1), this closes the remaining race
+//     for serializable reads: if a concurrent write had already committed
+//     by the time put runs, either it invalidated this exact entry after
+//     the insert (in which case the entry is removed), or put's own
+//     revision check observes the new revision and skips the insert.
+//     See kvstore_txn.go's use of revMu for why "current revision" is a
+//     safe, linearizable value to compare against here.
+//
+// A result that fails the revalidation is simply not cached; the next
+// request recomputes it the normal way, so this never affects correctness,
+// only how often the cache is filled while writes are in flight.
+type readCache struct {
+	// currentRev returns the store's current revision (s.KV().Rev()).
+	currentRev func() int64
+
+	mu      sync.Mutex
+	entries map[rangeCacheKey]*list.Element // -> *readCacheNode
+	lru     *list.List
+}
+
+type readCacheNode struct {
+	key   rangeCacheKey
+	entry *rangeCacheEntry
+}
+
+func newReadCache(currentRev func() int64) *readCache {
+	return &readCache{
+		currentRev: currentRev,
+		entries:    make(map[rangeCacheKey]*list.Element),
+		lru:        list.New(),
+	}
+}
+
+// get returns a cached response for r, if any. The returned response is a
+// shallow copy safe for the caller to mutate its Header on (as the gRPC
+// layer does), without affecting the cached entry or other callers.
+func (c *readCache) get(r *pb.RangeRequest) (*pb.RangeResponse, bool) {
+	if c == nil || !rangeCacheable(r) {
+		return nil, false
+	}
+	key := newRangeCacheKey(r)
+
+	c.mu.Lock()
+	el, ok := c.entries[key]
+	if !ok {
+		c.mu.Unlock()
+		return nil, false
+	}
+	c.lru.MoveToFront(el)
+	resp := el.Value.(*readCacheNode).entry.resp
+	c.mu.Unlock()
+
+	return copyRangeResponse(resp), true
+}
+
+// put stores resp as the cached result for r, unless the store has moved on
+// to a newer revision since resp was computed, in which case put is a
+// no-op. See the readCache doc comment for why this check is required.
+func (c *readCache) put(r *pb.RangeRequest, resp *pb.RangeResponse) {
+	if c == nil || !rangeCacheable(r) || resp.Header == nil {
+		return
+	}
+	key := newRangeCacheKey(r)
+	node := &readCacheNode{
+		key: key,
+		entry: &rangeCacheEntry{
+			key:      r.Key,
+			rangeEnd: r.RangeEnd,
+			resp:     copyRangeResponse(resp),
+		},
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if c.currentRev() != resp.Header.Revision {
+		// A write has committed since resp was computed: resp may already
+		// be stale, and its invalidation (if any) may have already run
+		// with nothing to find, since we hadn't inserted yet. Don't cache
+		// it; the next request will recompute and retry.
+		return
+	}
+
+	if el, ok := c.entries[key]; ok {
+		el.Value = node
+		c.lru.MoveToFront(el)
+		return
+	}
+	el := c.lru.PushFront(node)
+	c.entries[key] = el
+
+	for c.lru.Len() > maxReadCacheEntries {
+		oldest := c.lru.Back()
+		if oldest == nil {
+			break
+		}
+		c.lru.Remove(oldest)
+		delete(c.entries, oldest.Value.(*readCacheNode).key)
+	}
+}
+
+// invalidate drops every cached entry whose range could contain one of the
+// given changed keys. It must be called only after the write that produced
+// changes has been committed and made visible (see the readCache doc
+// comment).
+func (c *readCache) invalidate(changes []*mvccpb.KeyValue) {
+	if len(changes) == 0 {
+		return
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if len(c.entries) == 0 {
+		return
+	}
+	for _, kv := range changes {
+		for key, el := range c.entries {
+			if el.Value.(*readCacheNode).entry.overlapsKey(kv.Key) {
+				c.lru.Remove(el)
+				delete(c.entries, key)
+			}
+		}
+	}
+}
+
+// purge drops every cached entry. It is used when the underlying store is
+// replaced wholesale, e.g. by restoring from a snapshot, where per-key
+// invalidation doesn't apply.
+func (c *readCache) purge() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.entries = make(map[rangeCacheKey]*list.Element)
+	c.lru.Init()
+}
+
+// copyRangeResponse builds a new RangeResponse sharing resp's (immutable
+// once produced) key-value data but with its own Header, so that the
+// caller can safely mutate the returned Header (as the gRPC layer does to
+// stamp cluster/member/term info) without racing other holders of a cached
+// entry. It's built field-by-field rather than via a struct copy of resp to
+// avoid copying the generated message's internal protoimpl.MessageState.
+func copyRangeResponse(resp *pb.RangeResponse) *pb.RangeResponse {
+	cp := &pb.RangeResponse{
+		Kvs:   resp.Kvs,
+		More:  resp.More,
+		Count: resp.Count,
+	}
+	if resp.Header != nil {
+		cp.Header = &pb.ResponseHeader{
+			ClusterId: resp.Header.ClusterId,
+			MemberId:  resp.Header.MemberId,
+			Revision:  resp.Header.Revision,
+			RaftTerm:  resp.Header.RaftTerm,
+		}
+	}
+	return cp
+}
diff --git a/server/etcdserver/read_cache_test.go b/server/etcdserver/read_cache_test.go
new file mode 100644
index 000000000..25fba203a
--- /dev/null
+++ b/server/etcdserver/read_cache_test.go
@@ -0,0 +1,190 @@
+// Copyright 2026 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
