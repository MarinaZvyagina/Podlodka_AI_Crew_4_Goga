+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package txn
+
+import (
+	"sync"
+
+	"github.com/prometheus/client_golang/prometheus"
+	"google.golang.org/protobuf/proto"
+	"k8s.io/utils/lru"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+	"go.etcd.io/etcd/pkg/v3/adt"
+)
+
+// DefaultRangeCacheEntries bounds how many distinct RangeRequests a
+// RangeCache remembers at once.
+const DefaultRangeCacheEntries = 2048
+
+// RangeCache memoizes RangeResponses for RangeRequests that ask for the
+// current state of the store (Revision == 0), so that bursts of identical
+// reads -- e.g. many replicas polling the same keys at startup, or on a
+// timer -- don't each have to redo the underlying index/backend scan.
+//
+// A cached entry is only ever handed back while it still reflects the live
+// store. OnChange must be wired to fire synchronously, in revision order,
+// for every write the store commits (including lease-expiry deletes),
+// before that write's revision becomes visible to new read transactions --
+// see mvcc.Watchable.SetChangeHook. Add only admits a response that is
+// still current, as of that same call under the cache's own lock, so a
+// response racing a concurrent write is simply left uncached rather than
+// risking a stale hit; the next repeated read just misses and recomputes.
+// Reset must be called whenever the underlying store is replaced or
+// rebuilt wholesale (startup, snapshot restore), since previously cached
+// entries may no longer correspond to the same data even if the revision
+// number happens to coincide.
+//
+// RangeCache is safe for concurrent use.
+type RangeCache struct {
+	mu         sync.Mutex
+	maxEntries int
+	lru        *lru.Cache
+	// spans indexes cached entries by the key range their RangeRequest
+	// covers, so that a write to a single key can invalidate every cached
+	// response whose range contains it without scanning the whole cache.
+	spans adt.IntervalTree
+	// rev is the revision as of the most recently processed write (or the
+	// revision passed to the last Reset). A response is only cached, or
+	// served from cache, while its own revision still equals rev.
+	rev int64
+}
+
+// NewRangeCache returns an empty RangeCache that admits up to maxEntries
+// responses at a time.
+func NewRangeCache(maxEntries int) *RangeCache {
+	c := &RangeCache{maxEntries: maxEntries}
+	c.Reset(0)
+	return c
+}
+
+// Reset drops every cached entry and re-anchors the cache to rev, the
+// current store revision.
+func (c *RangeCache) Reset(rev int64) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.lru = lru.New(c.maxEntries)
+	c.spans = adt.NewIntervalTree()
+	c.rev = rev
+}
+
+// Get returns the cached response for req, if any. A request pinned to a
+// specific historical revision (Revision != 0) always misses; it is left
+// to the normal read path since RangeCache only tracks the current state
+// of the store.
+func (c *RangeCache) Get(req *pb.RangeRequest) (*pb.RangeResponse, bool) {
+	if req.Revision != 0 {
+		return nil, false
+	}
+	key := rangeCacheKey(req)
+
+	c.mu.Lock()
+	v, ok := c.lru.Get(key)
+	c.mu.Unlock()
+	if !ok {
+		rangeCacheMisses.Inc()
+		return nil, false
+	}
+	rangeCacheHits.Inc()
+	return proto.Clone(v.(*pb.RangeResponse)).(*pb.RangeResponse), true
+}
+
+// Add caches resp as the answer for req, provided resp still reflects the
+// live store, i.e. nothing has changed the cache's notion of the current
+// revision since resp was computed.
+func (c *RangeCache) Add(req *pb.RangeRequest, resp *pb.RangeResponse) {
+	if req.Revision != 0 || resp.GetHeader() == nil {
+		return
+	}
+	key := rangeCacheKey(req)
+
+	var span adt.Interval
+	if len(req.RangeEnd) != 0 {
+		span = adt.NewBytesAffineInterval(req.Key, req.RangeEnd)
+	} else {
+		span = adt.NewBytesAffinePoint(req.Key)
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if resp.Header.Revision != c.rev {
+		// A write raced with the read that produced resp: it may already
+		// be stale relative to the store, so don't risk caching it.
+		return
+	}
+	c.lru.Add(key, proto.Clone(resp))
+	if iv := c.spans.Find(span); iv != nil {
+		iv.Val.(map[string]struct{})[key] = struct{}{}
+	} else {
+		c.spans.Insert(span, map[string]struct{}{key: {}})
+	}
+}
+
+// OnChange is an mvcc.ChangeHook. It advances the cache's notion of the
+// current revision and evicts every cached entry whose range contains a
+// changed key.
+func (c *RangeCache) OnChange(rev int64, changes []*mvccpb.KeyValue) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.rev = rev
+	for _, kv := range changes {
+		hits := c.spans.Stab(adt.NewBytesAffinePoint(kv.Key))
+		for _, iv := range hits {
+			for key := range iv.Val.(map[string]struct{}) {
+				c.lru.Remove(key)
+			}
+		}
+		for _, iv := range hits {
+			c.spans.Delete(iv.Ivl)
+		}
+	}
+}
+
+// rangeCacheKey returns a canonical key for req covering only the
+// parameters that can change its answer, so that a serializable and a
+// linearizable request for the same range share a cache entry.
+func rangeCacheKey(req *pb.RangeRequest) string {
+	norm := proto.Clone(req).(*pb.RangeRequest)
+	norm.Serializable = false
+	b, err := proto.Marshal(norm)
+	if err != nil {
+		panic(err)
+	}
+	return string(b)
+}
+
+var (
+	rangeCacheHits = prometheus.NewCounter(prometheus.CounterOpts{
+		Namespace: "etcd",
+		Subsystem: "server",
+		Name:      "range_cache_hits_total",
+		Help:      "The total number of Range requests served from the read cache.",
+	})
+	rangeCacheMisses = prometheus.NewCounter(prometheus.CounterOpts{
+		Namespace: "etcd",
+		Subsystem: "server",
+		Name:      "range_cache_misses_total",
+		Help:      "The total number of Range requests not served from the read cache.",
+	})
+)
+
+func init() {
+	prometheus.MustRegister(rangeCacheHits)
+	prometheus.MustRegister(rangeCacheMisses)
+}
