 	// watch events happened or happening on the KV.
 	NewWatchStream() WatchStream
+
+	// SetChangeHook registers a callback that is invoked synchronously,
+	// once per committed write (including lease-expiry deletes), with the
+	// write's new revision and the exact key-value changes it produced.
+	// The hook runs before that write's revision becomes visible to new
+	// read transactions, and writes are never concurrent with each other,
+	// so the hook observes every write exactly once, in revision order.
+	// Registering a hook replaces any previously registered one; passing
+	// nil disables the hook.
+	SetChangeHook(hook ChangeHook)
 }
+
+// ChangeHook is the callback type accepted by Watchable.SetChangeHook.
+type ChangeHook func(rev int64, changes []*mvccpb.KeyValue)
