+@Composable
+fun SnoozeUpdatesDialog(
+    isSnoozed: Boolean,
+    onDismissRequest: () -> Unit,
+    onSnooze: (untilMillis: Long) -> Unit,
+    onClearSnooze: () -> Unit,
+) {
+    var showDatePicker by rememberSaveable { mutableStateOf(false) }
+    val timeZone = TimeZone.currentSystemDefault()
+
+    if (showDatePicker) {
+        val initialMillis = remember {
+            Clock.System.now().plus(1, DateTimeUnit.DAY, timeZone).toEpochMilliseconds()
+        }
+        val todayStartMillis = remember {
+            Clock.System.now().plus(1, DateTimeUnit.DAY, timeZone)
+                .toEpochMilliseconds()
+                .let { it - (it % (24 * 60 * 60 * 1000L)) }
+        }
+        val datePickerState = rememberDatePickerState(
+            initialSelectedDateMillis = initialMillis,
+            selectableDates = object : SelectableDates {
+                override fun isSelectableDate(utcTimeMillis: Long): Boolean {
+                    return utcTimeMillis >= todayStartMillis
+                }
+            },
+        )
+        DatePickerDialog(
+            onDismissRequest = { showDatePicker = false },
+            dismissButton = {
+                TextButton(onClick = { showDatePicker = false }) {
+                    Text(text = stringResource(MR.strings.action_cancel))
+                }
+            },
+            confirmButton = {
+                TextButton(
+                    onClick = {
+                        val millis = datePickerState.selectedDateMillis
+                        showDatePicker = false
+                        if (millis != null) {
+                            onSnooze(millis)
+                            onDismissRequest()
+                        }
+                    },
+                ) {
+                    Text(text = stringResource(MR.strings.action_ok))
+                }
+            },
+        ) {
+            DatePicker(state = datePickerState)
+        }
+        return
+    }
+
+    AlertDialog(
+        onDismissRequest = onDismissRequest,
+        title = { Text(text = stringResource(MR.strings.action_snooze_updates)) },
+        text = {
+            Column {
+                SnoozeOptionRow(
+                    text = stringResource(MR.strings.snooze_option_tomorrow),
+                    onClick = {
+                        onSnooze(Clock.System.now().plus(1, DateTimeUnit.DAY, timeZone).toEpochMilliseconds())
+                        onDismissRequest()
+                    },
+                )
+                SnoozeOptionRow(
+                    text = stringResource(MR.strings.snooze_option_next_week),
+                    onClick = {
+                        onSnooze(Clock.System.now().plus(7, DateTimeUnit.DAY, timeZone).toEpochMilliseconds())
+                        onDismissRequest()
+                    },
+                )
+                SnoozeOptionRow(
+                    text = stringResource(MR.strings.snooze_option_custom_date),
+                    onClick = { showDatePicker = true },
+                )
+                if (isSnoozed) {
+                    SnoozeOptionRow(
+                        text = stringResource(MR.strings.action_clear_snooze),
+                        onClick = {
+                            onClearSnooze()
+                            onDismissRequest()
+                        },
+                    )
+                }
+            }
+        },
+        confirmButton = {},
+        dismissButton = {
+            TextButton(onClick = onDismissRequest) {
+                Text(text = stringResource(MR.strings.action_cancel))
+            }
+        },
+    )
+}
+
+@Composable
+private fun SnoozeOptionRow(text: String, onClick: () -> Unit) {
+    Text(
+        text = text,
+        style = MaterialTheme.typography.bodyLarge,
+        modifier = Modifier
+            .fillMaxWidth()
+            .clickable(onClick = onClick)
+            .padding(vertical = 12.dp),
+    )
+}
