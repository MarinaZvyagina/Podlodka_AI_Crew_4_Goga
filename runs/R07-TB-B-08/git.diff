@@ -0,0 +1,123 @@
+package eu.kanade.presentation.manga.components
+
+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.AlertDialog
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.SelectableDates
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import eu.kanade.presentation.track.TrackDateSelector
+import kotlinx.datetime.DateTimeUnit
+import kotlinx.datetime.LocalDate
+import kotlinx.datetime.TimeZone
+import kotlinx.datetime.atStartOfDayIn
+import kotlinx.datetime.plus
+import kotlinx.datetime.toLocalDateTime
+import tachiyomi.i18n.MR
+import tachiyomi.presentation.core.components.material.padding
+import tachiyomi.presentation.core.i18n.stringResource
+import kotlin.time.Clock
+import kotlin.time.Instant
+
+/**
+ * "Remind me later" dialog used to snooze a series' updates.
+ *
+ * @param onClearSnooze null hides the "Clear snooze" option, e.g. when nothing is snoozed yet.
+ */
+@Composable
+fun SnoozeDialog(
+    onDismissRequest: () -> Unit,
+    onSnooze: (snoozedUntil: Long) -> Unit,
+    onClearSnooze: (() -> Unit)?,
+) {
+    var showDatePicker by remember { mutableStateOf(false) }
+    val tomorrow = remember { startOfLocalDay(todayLocalDate().plus(1, DateTimeUnit.DAY)) }
+
+    if (showDatePicker) {
+        TrackDateSelector(
+            title = stringResource(MR.strings.snooze_option_custom_date),
+            initialSelectedDateMillis = tomorrow,
+            selectableDates = remember {
+                object : SelectableDates {
+                    override fun isSelectableDate(utcTimeMillis: Long): Boolean {
+                        return utcTimeMillis >= tomorrow
+                    }
+                }
+            },
+            onConfirm = {
+                onSnooze(localStartOfDayFromUtcPickerMillis(it))
+                onDismissRequest()
+            },
+            onRemove = null,
+            onDismissRequest = { showDatePicker = false },
+        )
+        return
+    }
+
+    AlertDialog(
+        onDismissRequest = onDismissRequest,
+        title = { Text(text = stringResource(MR.strings.action_remind_me_later)) },
+        text = {
+            Column {
+                SnoozeOptionRow(stringResource(MR.strings.snooze_option_tomorrow)) {
+                    onSnooze(tomorrow)
+                    onDismissRequest()
+                }
+                SnoozeOptionRow(stringResource(MR.strings.snooze_option_next_week)) {
+                    onSnooze(startOfLocalDay(todayLocalDate().plus(7, DateTimeUnit.DAY)))
+                    onDismissRequest()
+                }
+                SnoozeOptionRow(stringResource(MR.strings.snooze_option_custom_date)) {
+                    showDatePicker = true
+                }
+                if (onClearSnooze != null) {
+                    SnoozeOptionRow(stringResource(MR.strings.action_clear_snooze)) {
+                        onClearSnooze()
+                        onDismissRequest()
+                    }
+                }
+            }
+        },
+        confirmButton = {
+            TextButton(onClick = onDismissRequest) {
+                Text(text = stringResource(MR.strings.action_cancel))
+            }
+        },
+    )
+}
+
+@Composable
+private fun SnoozeOptionRow(text: String, onClick: () -> Unit) {
+    Text(
+        text = text,
+        style = MaterialTheme.typography.bodyLarge,
+        modifier = Modifier
+            .fillMaxWidth()
+            .clickable(onClick = onClick)
+            .padding(vertical = MaterialTheme.padding.small),
+    )
+}
+
+private fun todayLocalDate(): LocalDate {
+    return Clock.System.now().toLocalDateTime(TimeZone.currentSystemDefault()).date
+}
+
+private fun startOfLocalDay(date: LocalDate): Long {
+    return date.atStartOfDayIn(TimeZone.currentSystemDefault()).toEpochMilliseconds()
+}
+
+// The date picker reports the selected date at midnight UTC regardless of locale;
+// re-anchor it to the start of that calendar day in the device's own timezone.
+private fun localStartOfDayFromUtcPickerMillis(utcMillis: Long): Long {
+    val date = Instant.fromEpochMilliseconds(utcMillis).toLocalDateTime(TimeZone.UTC).date
+    return startOfLocalDay(date)
+}
