+import kotlinx.datetime.atStartOfDayIn
+import kotlinx.datetime.plus
+import kotlinx.datetime.toLocalDateTime
+import tachiyomi.i18n.MR
+import tachiyomi.presentation.core.components.material.TextButton
+import tachiyomi.presentation.core.components.material.padding
+import tachiyomi.presentation.core.i18n.stringResource
+import kotlin.time.Clock
+
+/**
+ * "Remind me later" duration picker for hiding a manga from the updates feed until [onSnoozeUntil].
+ */
+@Composable
+fun SnoozeDialog(
+    isCurrentlySnoozed: Boolean,
+    onDismissRequest: () -> Unit,
+    onSnoozeUntil: (Long) -> Unit,
+    onClearSnooze: () -> Unit,
+) {
+    var showCustomDatePicker by remember { mutableStateOf(false) }
+
+    if (showCustomDatePicker) {
+        SnoozeCustomDatePicker(
+            onDismissRequest = onDismissRequest,
+            onConfirm = onSnoozeUntil,
+        )
+        return
+    }
+
+    AlertDialog(
+        onDismissRequest = onDismissRequest,
+        title = { Text(text = stringResource(MR.strings.action_snooze)) },
+        text = {
+            Column {
+                SnoozeOptionRow(
+                    text = stringResource(MR.strings.snooze_option_tomorrow),
+                    onClick = { onSnoozeUntil(startOfDayInMillis(1)) },
+                )
+                SnoozeOptionRow(
+                    text = stringResource(MR.strings.snooze_option_next_week),
+                    onClick = { onSnoozeUntil(startOfDayInMillis(7)) },
+                )
+                SnoozeOptionRow(
+                    text = stringResource(MR.strings.snooze_option_custom_date),
+                    onClick = { showCustomDatePicker = true },
+                )
+                if (isCurrentlySnoozed) {
+                    SnoozeOptionRow(
+                        text = stringResource(MR.strings.action_clear_snooze),
+                        onClick = {
+                            onClearSnooze()
+                            onDismissRequest()
+                        },
+                    )
+                }
+            }
+        },
+        confirmButton = {
+            TextButton(onClick = onDismissRequest) {
+                Text(text = stringResource(MR.strings.action_cancel))
+            }
+        },
+    )
+}
+
+@Composable
+private fun SnoozeOptionRow(text: String, onClick: () -> Unit) {
+    Text(
+        text = text,
+        style = MaterialTheme.typography.bodyMedium,
+        modifier = Modifier
+            .fillMaxWidth()
+            .clickable(onClick = onClick)
+            .minimumInteractiveComponentSize()
+            .padding(vertical = MaterialTheme.padding.small),
+    )
+}
+
+@Composable
+private fun SnoozeCustomDatePicker(
+    onDismissRequest: () -> Unit,
+    onConfirm: (Long) -> Unit,
+) {
+    val todayStartMillis = remember { startOfDayInMillis(0) }
+    val pickerState = rememberDatePickerState(
+        initialSelectedDateMillis = todayStartMillis,
+        selectableDates = object : SelectableDates {
+            override fun isSelectableDate(utcTimeMillis: Long): Boolean {
+                return utcTimeMillis >= todayStartMillis
+            }
+        },
+    )
+    DatePickerDialog(
+        onDismissRequest = onDismissRequest,
+        confirmButton = {
+            TextButton(
+                onClick = {
+                    pickerState.selectedDateMillis?.let(onConfirm)
+                    onDismissRequest()
+                },
+            ) {
+                Text(text = stringResource(MR.strings.action_ok))
+            }
+        },
+        dismissButton = {
+            TextButton(onClick = onDismissRequest) {
+                Text(text = stringResource(MR.strings.action_cancel))
+            }
+        },
+    ) {
+        DatePicker(state = pickerState)
+    }
+}
+
+private fun startOfDayInMillis(daysFromNow: Int): Long {
+    val timeZone = TimeZone.currentSystemDefault()
+    val today = Clock.System.now().toLocalDateTime(timeZone).date
+    return today.plus(daysFromNow, DateTimeUnit.DAY).atStartOfDayIn(timeZone).toEpochMilliseconds()
+}
