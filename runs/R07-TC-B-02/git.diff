@@ -0,0 +1,88 @@
+package eu.kanade.tachiyomi.data.track.libresync
+
+import eu.kanade.tachiyomi.data.track.libresync.dto.LSAuthResponseDto
+import eu.kanade.tachiyomi.data.track.libresync.dto.LSSearchResultDto
+import eu.kanade.tachiyomi.data.track.libresync.dto.LSSeriesDto
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import uy.kohesive.injekt.injectLazy
+
+class LibreSyncApi(
+    private val client: OkHttpClient,
+    interceptor: LibreSyncInterceptor,
+) {
+    private val json: Json by injectLazy()
+
+    private val authClient by lazy {
+        client.newBuilder()
+            .addInterceptor(interceptor)
+            .build()
+    }
+
+    suspend fun login(serverUrl: String, username: String, password: String): LSAuthResponseDto {
+        val body = buildJsonObject {
+            put("username", username)
+            put("password", password)
+        }
+        return with(json) {
+            client.newCall(
+                POST(
+                    url = "$serverUrl/api/auth/login",
+                    body = body.toString().toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<LSAuthResponseDto>()
+        }
+    }
+
+    suspend fun search(serverUrl: String, query: String): List<LSSeriesDto> {
+        val url = "$serverUrl/api/series/search".toHttpUrl().newBuilder()
+            .addQueryParameter("query", query)
+            .build()
+        return with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<LSSearchResultDto>()
+                .results
+        }
+    }
+
+    suspend fun getSeries(serverUrl: String, seriesId: Long): LSSeriesDto {
+        return with(json) {
+            authClient.newCall(GET("$serverUrl/api/series/$seriesId"))
+                .awaitSuccess()
+                .parseAs<LSSeriesDto>()
+        }
+    }
+
+    suspend fun updateProgress(serverUrl: String, seriesId: Long, chaptersRead: Double): LSSeriesDto {
+        val body = buildJsonObject {
+            put("chapters_read", chaptersRead)
+        }
+        return with(json) {
+            authClient.newCall(
+                PUT(
+                    url = "$serverUrl/api/series/$seriesId/progress",
+                    body = body.toString().toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<LSSeriesDto>()
+        }
+    }
+
+    companion object {
+        private val CONTENT_TYPE = "application/json".toMediaType()
+    }
+}
