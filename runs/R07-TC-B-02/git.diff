@@ -0,0 +1,59 @@
+package eu.kanade.tachiyomi.data.track.libresync.dto
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.libresync.LibreSync
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class LSSeriesDto(
+    val id: Long,
+    val title: String,
+    val url: String,
+    @SerialName("cover_url")
+    val coverUrl: String? = null,
+    @SerialName("total_chapters")
+    val totalChapters: Long = 0,
+    @SerialName("chapters_read")
+    val chaptersRead: Double = 0.0,
+)
+
+@Serializable
+data class LSSearchResultDto(
+    val results: List<LSSeriesDto> = emptyList(),
+)
+
+@Serializable
+data class LSAuthResponseDto(
+    val token: String,
+    val username: String,
+)
+
+fun LSSeriesDto.toTrackSearch(trackerId: Long): TrackSearch {
+    return TrackSearch.create(trackerId).apply {
+        remote_id = this@toTrackSearch.id
+        title = this@toTrackSearch.title
+        tracking_url = this@toTrackSearch.url
+        cover_url = this@toTrackSearch.coverUrl.orEmpty()
+        total_chapters = this@toTrackSearch.totalChapters
+        last_chapter_read = this@toTrackSearch.chaptersRead
+        status = deriveStatus(this@toTrackSearch.chaptersRead, this@toTrackSearch.totalChapters)
+        score = -1.0
+    }
+}
+
+fun LSSeriesDto.applyTo(track: Track) {
+    track.remote_id = id
+    track.title = title
+    track.tracking_url = url
+    track.total_chapters = totalChapters
+    track.last_chapter_read = chaptersRead
+    track.status = deriveStatus(chaptersRead, totalChapters)
+}
+
+private fun deriveStatus(chaptersRead: Double, totalChapters: Long): Long = when {
+    totalChapters > 0 && chaptersRead.toLong() >= totalChapters -> LibreSync.COMPLETED
+    chaptersRead > 0 -> LibreSync.READING
+    else -> LibreSync.UNREAD
+}
