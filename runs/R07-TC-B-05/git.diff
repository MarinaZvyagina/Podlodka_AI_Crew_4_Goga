@@ -0,0 +1,68 @@
+package eu.kanade.tachiyomi.data.track.tsundoku
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import tachiyomi.core.common.util.lang.withIOContext
+import uy.kohesive.injekt.injectLazy
+
+private val JSON_MEDIA_TYPE = "application/json".toMediaType()
+
+class TsundokuApi(
+    private val trackId: Long,
+    private val client: OkHttpClient,
+    interceptor: TsundokuInterceptor,
+) {
+
+    private val json: Json by injectLazy()
+
+    private val authClient by lazy { client.newBuilder().addInterceptor(interceptor).build() }
+
+    suspend fun login(apiUrl: String, username: String, password: String): LoginResponseDto = withIOContext {
+        val body = json.encodeToString(LoginRequestDto(username, password)).toRequestBody(JSON_MEDIA_TYPE)
+        with(json) {
+            client.newCall(POST("$apiUrl/api/auth/login", body = body))
+                .awaitSuccess()
+                .parseAs<LoginResponseDto>()
+        }
+    }
+
+    suspend fun search(apiUrl: String, query: String): List<TrackSearch> = withIOContext {
+        val url = "$apiUrl/api/series".toHttpUrl().newBuilder()
+            .addQueryParameter("search", query)
+            .build()
+        with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<List<SeriesDto>>()
+                .map { it.toTrack(trackId, apiUrl) }
+        }
+    }
+
+    suspend fun getTrackSearch(url: String): TrackSearch = withIOContext {
+        with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<SeriesDto>()
+                .toTrack(trackId, url.substringBefore("/api/series"))
+        }
+    }
+
+    suspend fun updateProgress(track: Track): Track = withIOContext {
+        val body = json.encodeToString(ProgressUpdateDto(track.last_chapter_read, track.status))
+            .toRequestBody(JSON_MEDIA_TYPE)
+        authClient.newCall(PUT(track.tracking_url, body = body)).awaitSuccess()
+
+        val remoteTrack = getTrackSearch(track.tracking_url)
+        track.apply { total_chapters = remoteTrack.total_chapters }
+    }
+}
