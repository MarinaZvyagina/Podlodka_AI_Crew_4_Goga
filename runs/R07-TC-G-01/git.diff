@@ -0,0 +1,30 @@
+package eu.kanade.tachiyomi.data.track.mangana
+
+import eu.kanade.tachiyomi.BuildConfig
+import okhttp3.Interceptor
+import okhttp3.Response
+import java.io.IOException
+
+class ManganaInterceptor(
+    mangana: Mangana,
+) : Interceptor {
+
+    private var apiKey: String? = mangana.restoreApiKey()
+
+    override fun intercept(chain: Interceptor.Chain): Response {
+        val originalRequest = chain.request()
+
+        val apiKey = apiKey ?: throw IOException("Not authenticated with Mangana")
+
+        val authRequest = originalRequest.newBuilder()
+            .addHeader("Authorization", "Bearer $apiKey")
+            .header("User-Agent", "Mihon v${BuildConfig.VERSION_NAME} (${BuildConfig.APPLICATION_ID})")
+            .build()
+
+        return chain.proceed(authRequest)
+    }
+
+    fun newAuth(apiKey: String?) {
+        this.apiKey = apiKey
+    }
+}
