@@ -0,0 +1,89 @@
+package eu.kanade.tachiyomi.data.track.mangana
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import tachiyomi.core.common.util.lang.withIOContext
+import uy.kohesive.injekt.injectLazy
+
+class ManganaApi(
+    private val client: OkHttpClient,
+    interceptor: ManganaInterceptor,
+) {
+    private val json: Json by injectLazy()
+
+    private val authClient by lazy {
+        client.newBuilder()
+            .addInterceptor(interceptor)
+            .build()
+    }
+
+    private fun seriesUrl(baseUrl: String, seriesId: Long) = "${baseUrl.trimEnd('/')}/api/series/$seriesId"
+
+    suspend fun login(baseUrl: String, username: String, password: String): SessionDto = withIOContext {
+        val body = json.encodeToString(LoginRequestDto(username, password))
+        with(json) {
+            client.newCall(
+                POST(
+                    url = "${baseUrl.trimEnd('/')}/api/auth/login",
+                    body = body.toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<SessionDto>()
+        }
+    }
+
+    suspend fun search(baseUrl: String, trackerId: Long, query: String): List<TrackSearch> = withIOContext {
+        val url = "${baseUrl.trimEnd('/')}/api/series"
+            .toHttpUrl()
+            .newBuilder()
+            .addQueryParameter("search", query)
+            .build()
+
+        with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<List<SeriesDto>>()
+        }
+            .map { it.toTrack(trackerId, seriesUrl(baseUrl, it.id)) }
+    }
+
+    suspend fun getTrackSearch(trackerId: Long, url: String): TrackSearch = withIOContext {
+        with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<SeriesDto>()
+        }
+            .toTrack(trackerId, url)
+    }
+
+    suspend fun updateProgress(trackerId: Long, track: Track): Track {
+        val body = json.encodeToString(ProgressUpdateDto(track.last_chapter_read))
+        authClient.newCall(
+            PUT(
+                url = "${track.tracking_url}/progress",
+                body = body.toRequestBody(CONTENT_TYPE),
+            ),
+        )
+            .awaitSuccess()
+
+        val remoteTrack = getTrackSearch(trackerId, track.tracking_url)
+        track.total_chapters = remoteTrack.total_chapters
+        return track
+    }
+
+    companion object {
+        private val CONTENT_TYPE = "application/json".toMediaType()
+    }
+}
