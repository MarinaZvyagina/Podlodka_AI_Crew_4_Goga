@@ -0,0 +1,50 @@
+package eu.kanade.tachiyomi.data.track.stump
+
+import okhttp3.Interceptor
+import okhttp3.Response
+import java.io.IOException
+
+class StumpInterceptor(private val stump: Stump) : Interceptor {
+
+    private var auth: StumpAuth? = stump.loadAuth()
+
+    override fun intercept(chain: Interceptor.Chain): Response {
+        val originalRequest = chain.request()
+        val currentAuth = auth ?: throw IOException("Stump: User is not authenticated")
+
+        val validAuth = if (currentAuth.isExpired()) {
+            refreshAuth(originalRequest.baseUrl(), currentAuth)
+        } else {
+            currentAuth
+        }
+
+        val authRequest = originalRequest.newBuilder()
+            .addHeader("Authorization", "Bearer ${validAuth.accessToken}")
+            .build()
+
+        return chain.proceed(authRequest)
+    }
+
+    fun setAuth(newAuth: StumpAuth?) {
+        auth = newAuth
+        stump.saveAuth(newAuth)
+    }
+
+    private fun refreshAuth(baseUrl: String, staleAuth: StumpAuth): StumpAuth = synchronized(this) {
+        auth?.takeUnless { it.isExpired() }?.let { return@synchronized it }
+        val refreshToken = staleAuth.refreshToken
+            ?: throw IOException("Stump: Session expired, please log in again")
+
+        val newAuth = try {
+            stump.api.refreshTokenBlocking(baseUrl, refreshToken)
+        } catch (e: Exception) {
+            throw IOException("Stump: Failed to refresh session, please log in again", e)
+        }
+
+        setAuth(newAuth)
+        newAuth
+    }
+
+    private fun okhttp3.Request.baseUrl(): String =
+        url.newBuilder().encodedPath("/").query(null).build().toString().trimEnd('/')
+}
