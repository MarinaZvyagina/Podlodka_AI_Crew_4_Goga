+package eu.kanade.tachiyomi.data.track.stump
+
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class StumpUserDto(
+    val id: String,
+    val username: String,
+)
+
+/**
+ * Response of `POST /api/v2/auth/login?generate_token=true&create_session=false`.
+ * Stump's `LoginResponse` is a serde-untagged enum; requesting a token always yields the
+ * `AccessToken` variant, which flattens the token pair alongside the authenticated user.
+ */
+@Serializable
+data class StumpLoginResponseDto(
+    val accessToken: String? = null,
+    val refreshToken: String? = null,
+    val expiresAt: String? = null,
+    val forUser: StumpUserDto? = null,
+)
+
+/**
+ * Locally persisted session. [expiresAt] is an ISO-8601 timestamp for the short-lived access
+ * token; once it's close to expiring the interceptor exchanges [refreshToken] for a new pair.
+ */
+@Serializable
+data class StumpAuth(
+    val accessToken: String,
+    val refreshToken: String? = null,
+    val expiresAt: String? = null,
+) {
+    fun isExpired(): Boolean {
+        val expiry = expiresAt?.let { runCatching { java.time.OffsetDateTime.parse(it) }.getOrNull() }
+            ?: return false
+        return !expiry.isAfter(java.time.OffsetDateTime.now().plusSeconds(30))
+    }
+}
+
+@Serializable
+data class StumpImageRefDto(
+    val url: String,
+)
+
+@Serializable
+data class StumpSeriesDto(
+    val id: String,
+    val name: String,
+    val resolvedName: String? = null,
+    val resolvedDescription: String? = null,
+    val mediaCount: Int = 0,
+    val readCount: Int = 0,
+    val isComplete: Boolean = false,
+    val thumbnail: StumpImageRefDto? = null,
+) {
+    fun toTrackSearch(trackId: Long, baseUrl: String): TrackSearch = TrackSearch.create(trackId).apply {
+        title = resolvedName?.takeIf { it.isNotBlank() } ?: name
+        summary = resolvedDescription.orEmpty()
+        cover_url = thumbnail?.url.orEmpty()
+        tracking_url = "$baseUrl/api/v2/series/$id"
+        total_chapters = mediaCount.toLong()
+        status = when {
+            isComplete -> Stump.COMPLETED
+            readCount == 0 -> Stump.UNREAD
+            else -> Stump.READING
+        }
+    }
+}
+
+@Serializable
+data class StumpMediaDto(
+    val id: String,
+    val seriesPosition: Int? = null,
+)
+
+@Serializable
+data class StumpMediaConnectionDto(
+    val nodes: List<StumpMediaDto> = emptyList(),
+)
+
+@Serializable
+data class StumpSeriesConnectionDto(
+    val nodes: List<StumpSeriesDto> = emptyList(),
+)
+
+@Serializable
+data class StumpSeriesTrackData(
+    val seriesById: StumpSeriesDto? = null,
+    val media: StumpMediaConnectionDto? = null,
+)
+
+@Serializable
+data class StumpSeriesTrackResult(
+    val data: StumpSeriesTrackData? = null,
+)
+
+@Serializable
+data class StumpSeriesSearchData(
+    val series: StumpSeriesConnectionDto? = null,
+)
+
+@Serializable
+data class StumpSeriesSearchResult(
+    val data: StumpSeriesSearchData? = null,
+)
+
+@Serializable
+data class StumpSeriesMediaData(
+    val media: StumpMediaConnectionDto? = null,
+)
+
+@Serializable
+data class StumpSeriesMediaResult(
+    val data: StumpSeriesMediaData? = null,
+)
