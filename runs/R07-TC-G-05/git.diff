@@ -0,0 +1,229 @@
+package eu.kanade.tachiyomi.data.track.stump
+
+import eu.kanade.tachiyomi.BuildConfig
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.jsonMime
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import kotlinx.serialization.json.putJsonObject
+import okhttp3.Headers
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import tachiyomi.core.common.util.lang.withIOContext
+import uy.kohesive.injekt.injectLazy
+import java.io.IOException
+
+class StumpApi(
+    private val trackId: Long,
+    private val client: OkHttpClient,
+    interceptor: StumpInterceptor,
+) {
+
+    private val json: Json by injectLazy()
+
+    // Bearer-authenticated client, used for every call except login/refresh which carry their
+    // own explicit token in the Authorization header.
+    private val authClient by lazy { client.newBuilder().addInterceptor(interceptor).build() }
+
+    private val headers: Headers by lazy {
+        Headers.Builder()
+            .add("User-Agent", "Mihon v${BuildConfig.VERSION_NAME} (${BuildConfig.APPLICATION_ID})")
+            .add("Content-Type", "application/json")
+            .build()
+    }
+
+    suspend fun login(baseUrl: String, username: String, password: String): StumpLoginResponseDto =
+        withIOContext {
+            val payload = buildJsonObject {
+                put("username", username)
+                put("password", password)
+            }
+            // Field names here are the server's raw (snake_case) query-string keys, unlike the
+            // camelCase JSON body/response.
+            val request = Request.Builder()
+                .url("$baseUrl/api/v2/auth/login?generate_token=true&create_session=false")
+                .headers(headers)
+                .post(payload.toString().toRequestBody(jsonMime))
+                .build()
+            try {
+                with(json) {
+                    client.newCall(request).awaitSuccess().parseAs<StumpLoginResponseDto>()
+                }
+            } catch (e: Exception) {
+                throw IOException("Stump: Login failed, check the server URL and credentials", e)
+            }
+        }
+
+    /**
+     * Synchronous by design: called from [StumpInterceptor] while it's already intercepting a
+     * request on an OkHttp dispatcher thread, not from suspend/UI call sites.
+     */
+    fun refreshTokenBlocking(baseUrl: String, refreshToken: String): StumpAuth {
+        val request = Request.Builder()
+            .url("$baseUrl/api/v2/auth/refresh-token")
+            .headers(headers)
+            .header("Authorization", "Bearer $refreshToken")
+            .post("{}".toRequestBody(jsonMime))
+            .build()
+        return with(json) {
+            client.newCall(request).execute().use {
+                if (!it.isSuccessful) throw IOException("Stump: Failed to refresh session (HTTP ${it.code})")
+                it.parseAs<StumpAuth>()
+            }
+        }
+    }
+
+    suspend fun search(baseUrl: String, query: String): List<TrackSearch> = withIOContext {
+        val gqlQuery = $$"""
+        |query SearchSeries($name: String!) {
+        |  series(
+        |    filter: { name: { contains: $name } }
+        |    orderBy: [{ series: { field: NAME, direction: ASC } }]
+        |    pagination: { offset: { page: 1, pageSize: 20 } }
+        |  ) {
+        |    nodes {
+        |      id
+        |      name
+        |      resolvedName
+        |      resolvedDescription
+        |      mediaCount
+        |      readCount
+        |      isComplete
+        |      thumbnail { url }
+        |    }
+        |  }
+        |}
+        """.trimMargin()
+
+        val result = graphql<StumpSeriesSearchResult>(
+            baseUrl,
+            gqlQuery,
+            buildJsonObject { put("name", query) },
+        )
+        result.data?.series?.nodes.orEmpty().map { it.toTrackSearch(trackId, baseUrl) }
+    }
+
+    suspend fun getTrackSearch(trackingUrl: String): TrackSearch = withIOContext {
+        val baseUrl = trackingUrl.baseUrl()
+        val seriesId = trackingUrl.seriesId()
+
+        val query = $$"""
+        |query SeriesTrack($id: ID!, $mediaFilter: MediaFilterInput!) {
+        |  seriesById(id: $id) {
+        |    id
+        |    name
+        |    resolvedName
+        |    resolvedDescription
+        |    mediaCount
+        |    readCount
+        |    isComplete
+        |    thumbnail { url }
+        |  }
+        |  media(
+        |    filter: $mediaFilter
+        |    orderBy: [{ media: { field: NAME, direction: ASC } }]
+        |    pagination: { none: { unpaginated: true } }
+        |  ) {
+        |    nodes { id seriesPosition }
+        |  }
+        |}
+        """.trimMargin()
+
+        val variables = buildJsonObject {
+            put("id", seriesId)
+            putJsonObject("mediaFilter") {
+                putJsonObject("seriesId") { put("eq", seriesId) }
+                putJsonObject("readingStatus") { put("is", "FINISHED") }
+            }
+        }
+
+        val result = graphql<StumpSeriesTrackResult>(baseUrl, query, variables)
+        val series = result.data?.seriesById ?: throw IOException("Stump: Series not found: $seriesId")
+        val lastFinishedPosition = result.data.media?.nodes.orEmpty()
+            .mapNotNull { it.seriesPosition }
+            .maxOrNull() ?: 0
+
+        series.toTrackSearch(trackId, baseUrl).apply {
+            last_chapter_read = lastFinishedPosition.toDouble()
+        }
+    }
+
+    suspend fun updateProgress(track: Track): Track = withIOContext {
+        val baseUrl = track.tracking_url.baseUrl()
+        val seriesId = track.tracking_url.seriesId()
+
+        if (track.status == Stump.COMPLETED) {
+            val finishSeriesMutation = $$"""
+            |mutation FinishSeries($id: ID!) {
+            |  finishSeriesProgress(id: $id)
+            |}
+            """.trimMargin()
+            mutate(baseUrl, finishSeriesMutation, buildJsonObject { put("id", seriesId) })
+        } else {
+            val mediaListQuery = $$"""
+            |query SeriesMedia($seriesId: String!) {
+            |  media(
+            |    filter: { seriesId: { eq: $seriesId } }
+            |    orderBy: [{ media: { field: NAME, direction: ASC } }]
+            |    pagination: { none: { unpaginated: true } }
+            |  ) {
+            |    nodes { id seriesPosition }
+            |  }
+            |}
+            """.trimMargin()
+            val mediaResult = graphql<StumpSeriesMediaResult>(
+                baseUrl,
+                mediaListQuery,
+                buildJsonObject { put("seriesId", seriesId) },
+            )
+
+            val finishMediaMutation = $$"""
+            |mutation FinishMedia($id: ID!) {
+            |  finishMediaProgress(id: $id)
+            |}
+            """.trimMargin()
+            mediaResult.data?.media?.nodes.orEmpty()
+                .filter { (it.seriesPosition ?: Int.MAX_VALUE) <= track.last_chapter_read.toInt() }
+                .forEach { media ->
+                    mutate(baseUrl, finishMediaMutation, buildJsonObject { put("id", media.id) })
+                }
+        }
+
+        getTrackSearch(track.tracking_url)
+    }
+
+    private suspend inline fun <reified T> graphql(baseUrl: String, query: String, variables: JsonObject): T {
+        val request = graphqlRequest(baseUrl, query, variables)
+        return with(json) {
+            authClient.newCall(request).awaitSuccess().parseAs<T>()
+        }
+    }
+
+    /** Like [graphql], but for mutations whose result payload we don't need. */
+    private suspend fun mutate(baseUrl: String, query: String, variables: JsonObject) {
+        val request = graphqlRequest(baseUrl, query, variables)
+        authClient.newCall(request).awaitSuccess().close()
+    }
+
+    private fun graphqlRequest(baseUrl: String, query: String, variables: JsonObject): Request {
+        val payload = buildJsonObject {
+            put("query", query)
+            put("variables", variables)
+        }
+        return Request.Builder()
+            .url("$baseUrl/api/graphql")
+            .headers(headers)
+            .post(payload.toString().toRequestBody(jsonMime))
+            .build()
+    }
+
+    private fun String.baseUrl() = substringBefore("/api/v2/series/")
+
+    private fun String.seriesId() = substringAfterLast("/")
+}
