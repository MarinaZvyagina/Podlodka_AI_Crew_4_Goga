+package eu.kanade.tachiyomi.data.track.librereader.dto
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.librereader.LibreReader
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class LRLoginResponse(
+    val displayName: String = "",
+)
+
+@Serializable
+data class LRSeriesDto(
+    val id: Long,
+    val title: String,
+    val summary: String = "",
+    val totalChapters: Long = 0,
+    val lastChapterRead: Double = 0.0,
+    val status: Long = LibreReader.UNREAD,
+)
+
+@Serializable
+data class LRSearchResponseDto(
+    val results: List<LRSeriesDto> = emptyList(),
+)
+
+@Serializable
+data class LRProgressUpdateDto(
+    val lastChapterRead: Double,
+    val status: Long,
+)
+
+fun LRSeriesDto.toTrack(trackerId: Long): TrackSearch = TrackSearch.create(trackerId).also {
+    it.remote_id = id
+    it.title = title
+    it.summary = summary
+    it.total_chapters = totalChapters
+    it.last_chapter_read = lastChapterRead
+    it.status = status
+}
+
+fun LRSeriesDto.copyTo(track: Track): Track = track.apply {
+    remote_id = this@copyTo.id
+    total_chapters = totalChapters
+    last_chapter_read = lastChapterRead
+    status = this@copyTo.status
+}
