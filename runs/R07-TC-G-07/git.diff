@@ -0,0 +1,95 @@
+package eu.kanade.tachiyomi.data.track.librereader
+
+import eu.kanade.tachiyomi.BuildConfig
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRLoginResponse
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRProgressUpdateDto
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRSearchResponseDto
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRSeriesDto
+import eu.kanade.tachiyomi.data.track.librereader.dto.toTrack
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import eu.kanade.tachiyomi.network.DELETE
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import okhttp3.Credentials
+import okhttp3.Headers
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import uy.kohesive.injekt.injectLazy
+
+class LibreReaderApi(
+    private val libreReader: LibreReader,
+    private val client: OkHttpClient,
+) {
+    private val json: Json by injectLazy()
+
+    private val authClient by lazy {
+        client.newBuilder()
+            .addInterceptor(LibreReaderInterceptor(libreReader))
+            .build()
+    }
+
+    suspend fun login(serverUrl: String, username: String, password: String): LRLoginResponse {
+        val headers = Headers.Builder()
+            .add("Authorization", Credentials.basic(username, password))
+            .add("User-Agent", "Mihon v${BuildConfig.VERSION_NAME} (${BuildConfig.APPLICATION_ID})")
+            .build()
+        return with(json) {
+            client.newCall(GET(url = "$serverUrl/api/auth/me", headers = headers))
+                .awaitSuccess()
+                .parseAs<LRLoginResponse>()
+        }
+    }
+
+    suspend fun search(query: String): List<TrackSearch> {
+        val url = "${libreReader.getServerUrl()}/api/series/search".toHttpUrl().newBuilder()
+            .addQueryParameter("query", query)
+            .build()
+        return with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<LRSearchResponseDto>()
+                .results
+                .map { it.toTrack(libreReader.id) }
+        }
+    }
+
+    suspend fun getSeries(remoteId: Long): LRSeriesDto {
+        return with(json) {
+            authClient.newCall(GET("${libreReader.getServerUrl()}/api/series/$remoteId"))
+                .awaitSuccess()
+                .parseAs<LRSeriesDto>()
+        }
+    }
+
+    suspend fun startTracking(remoteId: Long): LRSeriesDto {
+        return with(json) {
+            authClient.newCall(POST("${libreReader.getServerUrl()}/api/series/$remoteId/track"))
+                .awaitSuccess()
+                .parseAs<LRSeriesDto>()
+        }
+    }
+
+    suspend fun updateProgress(track: Track): LRSeriesDto {
+        val body = json.encodeToString(LRProgressUpdateDto(track.last_chapter_read, track.status))
+            .toRequestBody("application/json".toMediaType())
+        return with(json) {
+            authClient.newCall(
+                PUT(url = "${libreReader.getServerUrl()}/api/series/${track.remote_id}/progress", body = body),
+            )
+                .awaitSuccess()
+                .parseAs<LRSeriesDto>()
+        }
+    }
+
+    suspend fun deleteSeries(remoteId: Long) {
+        authClient.newCall(DELETE("${libreReader.getServerUrl()}/api/series/$remoteId/track"))
+            .awaitSuccess()
+    }
+}
