+package eu.kanade.tachiyomi.data.track.librereads
+
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class LRUserDto(
+    val username: String,
+)
+
+@Serializable
+data class LRSeriesDto(
+    val id: Long,
+    val title: String,
+    val coverUrl: String? = null,
+    val summary: String? = null,
+    val totalChapters: Long = 0,
+    val lastChapterRead: Double = 0.0,
+    val status: Long = 1L,
+) {
+    fun toTrackSearch(trackerId: Long, serverUrl: String): TrackSearch = TrackSearch.create(trackerId).also {
+        it.title = title
+        it.summary = summary.orEmpty()
+        it.cover_url = coverUrl.orEmpty()
+        it.remote_id = id
+        it.tracking_url = "$serverUrl/api/v1/series/$id"
+        it.total_chapters = totalChapters
+        it.last_chapter_read = lastChapterRead
+        it.status = status
+    }
+}
+
+@Serializable
+data class LRProgressUpdateDto(
+    val lastChapterRead: Double,
+    val status: Long,
+)
