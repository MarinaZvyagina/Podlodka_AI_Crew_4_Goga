@@ -0,0 +1,76 @@
+package eu.kanade.tachiyomi.data.track.librereads
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.jsonMime
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import okhttp3.Headers
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import tachiyomi.core.common.util.lang.withIOContext
+import uy.kohesive.injekt.injectLazy
+
+class LibreReadsApi(
+    private val trackId: Long,
+    private val client: OkHttpClient,
+    interceptor: LibreReadsInterceptor,
+) {
+
+    private val json: Json by injectLazy()
+
+    private val authClient = client.newBuilder().addInterceptor(interceptor).build()
+
+    /**
+     * Verifies that [serverUrl]/[apiKey] are a valid pair and returns the account's display name.
+     * Uses the plain client since the credentials haven't been saved yet, so the auth
+     * interceptor (which reads them from preferences) can't be relied on.
+     */
+    suspend fun getCurrentUser(serverUrl: String, apiKey: String): String = withIOContext {
+        with(json) {
+            client.newCall(
+                GET(
+                    "$serverUrl/api/v1/tachiyomi/whoami",
+                    Headers.Builder().add("Authorization", "Bearer $apiKey").build(),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<LRUserDto>()
+                .username
+        }
+    }
+
+    suspend fun search(serverUrl: String, query: String): List<TrackSearch> = withIOContext {
+        val url = "$serverUrl/api/v1/series".toHttpUrl().newBuilder()
+            .addQueryParameter("search", query)
+            .build()
+        with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<List<LRSeriesDto>>()
+                .map { it.toTrackSearch(trackId, serverUrl) }
+        }
+    }
+
+    suspend fun getTrackSearch(url: String): TrackSearch = withIOContext {
+        with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<LRSeriesDto>()
+                .toTrackSearch(trackId, url.substringBefore("/api/v1/series"))
+        }
+    }
+
+    suspend fun updateProgress(track: Track): Track {
+        val payload = json.encodeToString(LRProgressUpdateDto(track.last_chapter_read, track.status))
+        authClient.newCall(
+            PUT("${track.tracking_url}/progress", body = payload.toRequestBody(jsonMime)),
+        )
+            .awaitSuccess()
+        return getTrackSearch(track.tracking_url)
+    }
+}
