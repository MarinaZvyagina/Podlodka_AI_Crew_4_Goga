@@ -0,0 +1,98 @@
+package eu.kanade.tachiyomi.data.track.librereads
+
+import dev.icerock.moko.resources.StringResource
+import eu.kanade.tachiyomi.R
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.BaseTracker
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import okhttp3.Dns
+import okhttp3.OkHttpClient
+import tachiyomi.i18n.MR
+import tachiyomi.domain.track.model.Track as DomainTrack
+
+/**
+ * Tracker for a self-hosted manga/comic library server, authenticated with a server URL + API key
+ * pair (entered as the "username"/"password" fields of the generic login dialog). Unlike the
+ * enhanced trackers (Komga, Kavita), library entries aren't auto-matched by source URL: the user
+ * searches the server's library and links entries manually, same as MangaUpdates/Kitsu.
+ */
+class LibreReads(id: Long) : BaseTracker(id, "LibreReads") {
+
+    companion object {
+        const val UNREAD = 1L
+        const val READING = 2L
+        const val COMPLETED = 3L
+    }
+
+    override val client: OkHttpClient by lazy {
+        networkService.client.newBuilder()
+            .dns(Dns.SYSTEM) // don't use DNS over HTTPS as it breaks resolving local/LAN servers
+            .build()
+    }
+
+    private val interceptor by lazy { LibreReadsInterceptor(this) }
+
+    val api by lazy { LibreReadsApi(id, client, interceptor) }
+
+    fun getServerUrl(): String = getUsername()
+
+    fun getApiKey(): String = getPassword()
+
+    override fun getLogo() = R.drawable.brand_librereads
+
+    override fun getStatusList(): List<Long> = listOf(UNREAD, READING, COMPLETED)
+
+    override fun getStatus(status: Long): StringResource? = when (status) {
+        UNREAD -> MR.strings.unread
+        READING -> MR.strings.reading
+        COMPLETED -> MR.strings.completed
+        else -> null
+    }
+
+    override fun getReadingStatus(): Long = READING
+
+    override fun getRereadingStatus(): Long = -1
+
+    override fun getCompletionStatus(): Long = COMPLETED
+
+    override fun getScoreList(): List<String> = emptyList()
+
+    override fun displayScore(track: DomainTrack): String = ""
+
+    override suspend fun update(track: Track, didReadChapter: Boolean): Track {
+        if (track.status != COMPLETED) {
+            if (didReadChapter) {
+                val isFullyRead = track.total_chapters > 0 && track.last_chapter_read.toLong() == track.total_chapters
+                track.status = if (isFullyRead) COMPLETED else READING
+            }
+        }
+
+        return api.updateProgress(track)
+    }
+
+    override suspend fun bind(track: Track, hasReadChapters: Boolean): Track {
+        track.status = if (hasReadChapters) READING else UNREAD
+        return update(track, hasReadChapters)
+    }
+
+    override suspend fun search(query: String): List<TrackSearch> = api.search(getServerUrl(), query)
+
+    override suspend fun refresh(track: Track): Track {
+        val remoteTrack = api.getTrackSearch(track.tracking_url)
+        track.copyPersonalFrom(remoteTrack)
+        track.total_chapters = remoteTrack.total_chapters
+        return track
+    }
+
+    override suspend fun login(username: String, password: String) {
+        val serverUrl = username.trim().trimEnd('/')
+        val apiKey = password.trim()
+        require(serverUrl.startsWith("http://") || serverUrl.startsWith("https://")) {
+            "Server URL must start with http:// or https://"
+        }
+
+        val displayName = api.getCurrentUser(serverUrl, apiKey)
+        saveCredentials(serverUrl, apiKey)
+        saveDisplayUsername(displayName)
+    }
+}
