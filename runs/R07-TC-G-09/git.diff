+package eu.kanade.tachiyomi.data.track.tsundoku
+
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class TsundokuSessionDto(
+    val token: String,
+    val username: String,
+)
+
+@Serializable
+data class TsundokuLibraryEntryDto(
+    val id: Long,
+    val title: String,
+    val coverUrl: String? = null,
+    val totalChapters: Long = 0,
+    val lastChapterRead: Double = 0.0,
+    val status: String = "reading",
+)
+
+fun TsundokuLibraryEntryDto.toTrackSearch(trackerId: Long, baseUrl: String): TrackSearch =
+    TrackSearch.create(trackerId).also {
+        it.remote_id = id
+        it.title = title
+        it.cover_url = coverUrl.orEmpty()
+        it.total_chapters = totalChapters
+        it.last_chapter_read = lastChapterRead
+        it.status = Tsundoku.statusFromRemote(status)
+        it.summary = ""
+        it.tracking_url = "$baseUrl/api/v1/library/$id"
+    }
