@@ -0,0 +1,107 @@
+package eu.kanade.tachiyomi.data.track.selfhosted
+
+import dev.icerock.moko.resources.StringResource
+import eu.kanade.tachiyomi.R
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.BaseTracker
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import tachiyomi.i18n.MR
+import tachiyomi.domain.track.model.Track as DomainTrack
+
+/**
+ * Tracker for a user's own self-hosted manga/comic library server (e.g. a home server exposing
+ * the sync API described in [SelfHostedApi]). Unlike the companion-source-based self-hosted
+ * trackers (Komga/Kavita/Suwayomi), this tracker logs in independently of any source, using
+ * credentials entered directly in the app, since it isn't tied to a specific source extension.
+ */
+class SelfHosted(id: Long) : BaseTracker(id, "Self-hosted") {
+
+    companion object {
+        const val UNREAD = 1L
+        const val READING = 2L
+        const val COMPLETED = 3L
+    }
+
+    private val interceptor by lazy { SelfHostedInterceptor(this) }
+    private val api by lazy { SelfHostedApi(client, interceptor) }
+
+    override fun getLogo(): Int = R.drawable.brand_selfhosted
+
+    override fun getStatusList(): List<Long> = listOf(UNREAD, READING, COMPLETED)
+
+    override fun getStatus(status: Long): StringResource? = when (status) {
+        UNREAD -> MR.strings.unread
+        READING -> MR.strings.reading
+        COMPLETED -> MR.strings.completed
+        else -> null
+    }
+
+    override fun getReadingStatus(): Long = READING
+
+    override fun getRereadingStatus(): Long = -1L
+
+    override fun getCompletionStatus(): Long = COMPLETED
+
+    override fun getScoreList(): List<String> = emptyList()
+
+    override fun displayScore(track: DomainTrack): String = ""
+
+    override suspend fun update(track: Track, didReadChapter: Boolean): Track {
+        if (track.status != COMPLETED && didReadChapter) {
+            track.status = if (track.total_chapters in 1..track.last_chapter_read.toLong()) {
+                COMPLETED
+            } else {
+                READING
+            }
+        }
+        api.updateProgress(getServerUrl(), track)
+        return track
+    }
+
+    override suspend fun bind(track: Track, hasReadChapters: Boolean): Track {
+        val serverUrl = getServerUrl()
+        val remote = api.getSeries(serverUrl, track.remote_id).toTrackSearch(id, serverUrl)
+        track.copyPersonalFrom(remote, copyRemotePrivate = false)
+        track.title = remote.title
+        track.total_chapters = remote.total_chapters
+        track.tracking_url = remote.tracking_url
+        return track
+    }
+
+    override suspend fun search(query: String): List<TrackSearch> {
+        val serverUrl = getServerUrl()
+        return api.search(serverUrl, query).map { it.toTrackSearch(id, serverUrl) }
+    }
+
+    override suspend fun refresh(track: Track): Track {
+        val serverUrl = getServerUrl()
+        val remote = api.getSeries(serverUrl, track.remote_id).toTrackSearch(id, serverUrl)
+        track.copyPersonalFrom(remote)
+        track.total_chapters = remote.total_chapters
+        return track
+    }
+
+    override suspend fun login(username: String, password: String) {
+        login(getServerUrl(), username, password)
+    }
+
+    suspend fun login(serverUrl: String, username: String, password: String) {
+        val url = serverUrl.trimEnd('/')
+        val response = api.login(url, username, password)
+        trackPreferences.trackServerUrl(this).set(url)
+        interceptor.newAuth(response.token)
+        saveCredentials(response.username, response.token)
+    }
+
+    override fun logout() {
+        super.logout()
+        trackPreferences.trackServerUrl(this).set("")
+        interceptor.newAuth(null)
+    }
+
+    fun getServerUrl(): String = trackPreferences.trackServerUrl(this).get()
+
+    // The session token is stashed in the password slot (never the real account password),
+    // mirroring how MangaUpdates persists its session token, so it survives process death.
+    fun restoreToken(): String? = trackPreferences.trackPassword(this).get().ifBlank { null }
+}
