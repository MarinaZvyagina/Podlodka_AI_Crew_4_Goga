@@ -0,0 +1,91 @@
+package eu.kanade.tachiyomi.data.track.selfhosted
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import uy.kohesive.injekt.injectLazy
+
+/**
+ * Talks to a self-hosted manga/comic library server's Tachiyomi-sync API.
+ *
+ * A compatible server exposes, under the user-supplied base URL:
+ *  - POST /api/tachiyomi/v1/auth/login          {username, password} -> {token, username}
+ *  - GET  /api/tachiyomi/v1/series?query=<text>                      -> [SeriesDto]
+ *  - GET  /api/tachiyomi/v1/series/{id}                              -> SeriesDto
+ *  - PUT  /api/tachiyomi/v1/series/{id}/progress {chapterRead}       -> SeriesDto
+ * Every endpoint other than login requires an `Authorization: Bearer <token>` header.
+ */
+class SelfHostedApi(
+    private val client: OkHttpClient,
+    private val interceptor: SelfHostedInterceptor,
+) {
+    private val json: Json by injectLazy()
+
+    private val authClient by lazy { client.newBuilder().addInterceptor(interceptor).build() }
+
+    private fun apiUrl(serverUrl: String, path: String) = "${serverUrl.trimEnd('/')}/api/tachiyomi/v1$path"
+
+    suspend fun login(serverUrl: String, username: String, password: String): SelfHostedLoginResponseDto {
+        val body = buildJsonObject {
+            put("username", username)
+            put("password", password)
+        }
+        return with(json) {
+            client.newCall(
+                POST(
+                    url = apiUrl(serverUrl, "/auth/login"),
+                    body = body.toString().toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs()
+        }
+    }
+
+    suspend fun search(serverUrl: String, query: String): List<SelfHostedSeriesDto> {
+        val url = apiUrl(serverUrl, "/series").toHttpUrl().newBuilder()
+            .addQueryParameter("query", query)
+            .build()
+        return with(json) {
+            authClient.newCall(GET(url)).awaitSuccess().parseAs()
+        }
+    }
+
+    suspend fun getSeries(serverUrl: String, remoteId: Long): SelfHostedSeriesDto {
+        return with(json) {
+            authClient.newCall(GET(apiUrl(serverUrl, "/series/$remoteId")))
+                .awaitSuccess()
+                .parseAs()
+        }
+    }
+
+    suspend fun updateProgress(serverUrl: String, track: Track): SelfHostedSeriesDto {
+        val body = buildJsonObject {
+            put("chapterRead", track.last_chapter_read)
+        }
+        return with(json) {
+            authClient.newCall(
+                PUT(
+                    url = apiUrl(serverUrl, "/series/${track.remote_id}/progress"),
+                    body = body.toString().toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs()
+        }
+    }
+
+    companion object {
+        private val CONTENT_TYPE = "application/json".toMediaType()
+    }
+}
