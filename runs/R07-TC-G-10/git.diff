+package eu.kanade.tachiyomi.data.track.selfhosted
+
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class SelfHostedLoginResponseDto(
+    val token: String,
+    val username: String,
+)
+
+@Serializable
+data class SelfHostedSeriesDto(
+    val id: Long,
+    val title: String,
+    val coverUrl: String? = null,
+    val totalChapters: Long = 0,
+    val lastChapterRead: Double = 0.0,
+    val status: Long = SelfHosted.UNREAD,
+) {
+    fun toTrackSearch(trackerId: Long, serverUrl: String): TrackSearch = TrackSearch.create(trackerId).also {
+        it.remote_id = id
+        it.title = title
+        it.cover_url = coverUrl.orEmpty()
+        it.summary = ""
+        it.total_chapters = totalChapters
+        it.last_chapter_read = lastChapterRead
+        it.status = status
+        it.tracking_url = "${serverUrl.trimEnd('/')}/series/$id"
+    }
+}
