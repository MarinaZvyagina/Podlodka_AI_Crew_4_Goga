diff --git a/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt b/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt
new file mode 100644
index 0000000..c2d58cf
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt
@@ -0,0 +1,68 @@
+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.FilterList
+import eu.kanade.tachiyomi.source.model.MangasPage
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.time.Duration.Companion.minutes
+
+/**
+ * In-memory cache of a source's browse/search results, keyed per page. Repeating the same
+ * listing (popular, latest, or a search with the same query and filters) shortly after a
+ * previous fetch reuses the cached [MangasPage] instead of hitting the network again.
+ *
+ * `FilterList.equals`/`hashCode` are intentionally unusable for keying (always unequal/mutable),
+ * so filters are reduced to each [eu.kanade.tachiyomi.source.model.Filter]'s name and state.
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourceListingCache {
+
+    private val cache = ConcurrentHashMap<Key, Entry>()
+
+    suspend fun getOrPut(
+        sourceId: Long,
+        listing: String,
+        query: String,
+        filters: FilterList,
+        page: Int,
+        forceRefresh: Boolean,
+        fetch: suspend () -> MangasPage,
+    ): MangasPage {
+        val key = Key(sourceId, listing, query, filters.toStateKey(), page)
+
+        if (!forceRefresh) {
+            val entry = cache[key]
+            if (entry != null && !entry.isExpired()) {
+                return entry.mangasPage
+            }
+        }
+
+        val mangasPage = fetch()
+        cache[key] = Entry(mangasPage, System.currentTimeMillis())
+        return mangasPage
+    }
+
+    private fun FilterList.toStateKey(): List<Pair<String, Any?>> = list.map { it.name to it.state }
+
+    private data class Key(
+        val sourceId: Long,
+        val listing: String,
+        val query: String,
+        val filterState: List<Pair<String, Any?>>,
+        val page: Int,
+    )
+
+    private data class Entry(
+        val mangasPage: MangasPage,
+        val timestamp: Long,
+    ) {
+        fun isExpired() = System.currentTimeMillis() - timestamp >= CACHE_TTL
+    }
+
+    companion object {
+        private val CACHE_TTL = 5.minutes.inWholeMilliseconds
+    }
+}
