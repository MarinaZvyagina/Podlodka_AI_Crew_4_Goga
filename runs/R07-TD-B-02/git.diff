+++ b/domain/src/main/java/tachiyomi/domain/source/interactor/InvalidateSourceCache.kt
@@ -0,0 +1,19 @@
+package tachiyomi.domain.source.interactor
+
+import dev.zacsweers.metro.Inject
+import eu.kanade.tachiyomi.source.model.FilterList
+import tachiyomi.domain.source.repository.SourceRepository
+
+@Inject
+class InvalidateSourceCache(
+    private val repository: SourceRepository,
+) {
+
+    operator fun invoke(sourceId: Long, query: String, filterList: FilterList) {
+        when (query) {
+            GetRemoteManga.QUERY_POPULAR -> repository.invalidatePopularCache(sourceId)
+            GetRemoteManga.QUERY_LATEST -> repository.invalidateLatestCache(sourceId)
+            else -> repository.invalidateSearchCache(sourceId, query, filterList)
+        }
+    }
+}
