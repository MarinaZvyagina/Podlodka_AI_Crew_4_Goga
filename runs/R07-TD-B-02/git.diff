--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourcePagingCache.kt
@@ -0,0 +1,67 @@
+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.FilterList
+import eu.kanade.tachiyomi.source.model.MangasPage
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.time.Duration.Companion.minutes
+
+/**
+ * In-memory cache of source listing pages (popular/latest/search), keyed by source, listing
+ * and page. Lets repeating an identical browse request shortly after (e.g. re-entering a
+ * source, or scrolling back to an already-loaded page) reuse the previous network response
+ * instead of hitting the source again.
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourcePagingCache {
+
+    data class Key(
+        val sourceId: Long,
+        val query: String,
+        val filters: FilterList,
+    )
+
+    private data class Entry(
+        val mangasPage: MangasPage,
+        val timestamp: Long,
+    )
+
+    private val entries = ConcurrentHashMap<Pair<Key, Int>, Entry>()
+
+    /**
+     * Returns the cached page for [key]/[page] if it's still fresh, otherwise runs [fetch],
+     * caches its result, and returns it. Failures from [fetch] are not cached.
+     */
+    suspend fun getOrPut(key: Key, page: Int, fetch: suspend () -> MangasPage): MangasPage {
+        val entryKey = key to page
+        val cached = entries[entryKey]
+        val now = System.currentTimeMillis()
+        if (cached != null && now - cached.timestamp <= CACHE_DURATION_MS) {
+            return cached.mangasPage
+        }
+
+        val mangasPage = fetch()
+        entries[entryKey] = Entry(mangasPage, now)
+        return mangasPage
+    }
+
+    /**
+     * Drops every cached page for [key], forcing the next [getOrPut] call for it to hit the
+     * network again.
+     */
+    fun invalidate(key: Key) {
+        entries.keys.removeAll { it.first == key }
+    }
+
+    companion object {
+        private val CACHE_DURATION_MS = 5.minutes.inWholeMilliseconds
+
+        // Reserved query values so popular/latest listings can't collide with a literal
+        // search query of the same text.
+        const val POPULAR_QUERY = "::popular::"
+        const val LATEST_QUERY = "::latest::"
+    }
+}
