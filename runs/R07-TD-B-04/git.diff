diff --git a/data/src/main/java/tachiyomi/data/source/SourcePagingCache.kt b/data/src/main/java/tachiyomi/data/source/SourcePagingCache.kt
new file mode 100644
index 0000000..0d478cf
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourcePagingCache.kt
@@ -0,0 +1,66 @@
+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.FilterList
+import eu.kanade.tachiyomi.source.model.MangasPage
+import kotlin.time.Duration.Companion.minutes
+import kotlin.time.TimeSource
+
+/**
+ * Short-lived in-memory cache for source listing/search pages, keyed by the exact
+ * request that produced them. Lets repeated identical popular/latest/search page loads
+ * (e.g. navigating back to the same search shortly after) avoid hitting the network again,
+ * without keeping results around indefinitely.
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourcePagingCache {
+
+    private data class Key(
+        val sourceId: Long,
+        val mode: String,
+        val query: String,
+        val filters: List<Filter<*>>,
+        val page: Int,
+    )
+
+    private class Entry(val mangasPage: MangasPage) {
+        private val mark = TimeSource.Monotonic.markNow()
+        val isExpired get() = mark.elapsedNow() > CACHE_TTL
+    }
+
+    private val entries = mutableMapOf<Key, Entry>()
+
+    suspend fun getOrPut(
+        sourceId: Long,
+        mode: String,
+        query: String,
+        filters: FilterList,
+        page: Int,
+        bypassCache: Boolean,
+        fetch: suspend () -> MangasPage,
+    ): MangasPage {
+        val key = Key(sourceId, mode, query, filters.toList(), page)
+
+        if (!bypassCache) {
+            val cached = synchronized(entries) { entries[key] }
+            if (cached != null && !cached.isExpired) {
+                return cached.mangasPage
+            }
+        }
+
+        val result = fetch()
+        synchronized(entries) {
+            entries.values.removeAll { it.isExpired }
+            entries[key] = Entry(result)
+        }
+        return result
+    }
+
+    companion object {
+        private val CACHE_TTL = 5.minutes
+    }
+}
