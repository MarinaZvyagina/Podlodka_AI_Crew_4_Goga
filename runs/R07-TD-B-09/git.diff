@@ -0,0 +1,86 @@
+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.FilterList
+import eu.kanade.tachiyomi.source.model.MangasPage
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.time.Clock
+import kotlin.time.Duration.Companion.minutes
+import kotlin.time.Instant
+
+/**
+ * Short-lived in-memory cache for a source's popular/latest/search listings, keyed per page.
+ * Avoids re-hitting the network when the user repeats the same listing shortly after
+ * (e.g. navigating back to browse, or re-running the same search).
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourceListingCache {
+
+    private val cache = ConcurrentHashMap<Key, Entry>()
+
+    fun getPopular(sourceId: Long, page: Int): MangasPage? {
+        return get(Key.Popular(sourceId, page))
+    }
+
+    fun putPopular(sourceId: Long, page: Int, mangasPage: MangasPage) {
+        put(Key.Popular(sourceId, page), mangasPage)
+    }
+
+    fun getLatest(sourceId: Long, page: Int): MangasPage? {
+        return get(Key.Latest(sourceId, page))
+    }
+
+    fun putLatest(sourceId: Long, page: Int, mangasPage: MangasPage) {
+        put(Key.Latest(sourceId, page), mangasPage)
+    }
+
+    fun getSearch(sourceId: Long, query: String, filters: FilterList, page: Int): MangasPage? {
+        return get(Key.Search(sourceId, query, filters.toState(), page))
+    }
+
+    fun putSearch(sourceId: Long, query: String, filters: FilterList, page: Int, mangasPage: MangasPage) {
+        put(Key.Search(sourceId, query, filters.toState(), page), mangasPage)
+    }
+
+    /** Drops every cached listing for [sourceId] so the next request fetches fresh data. */
+    fun invalidate(sourceId: Long) {
+        cache.keys.removeAll { it.sourceId == sourceId }
+    }
+
+    private fun get(key: Key): MangasPage? {
+        val entry = cache[key] ?: return null
+        if (Clock.System.now() >= entry.expiresAt) {
+            cache.remove(key, entry)
+            return null
+        }
+        return entry.mangasPage
+    }
+
+    private fun put(key: Key, mangasPage: MangasPage) {
+        cache[key] = Entry(mangasPage, Clock.System.now() + CACHE_TTL)
+    }
+
+    private fun FilterList.toState(): List<Pair<String, Any?>> = map { it.name to it.state }
+
+    private data class Entry(val mangasPage: MangasPage, val expiresAt: Instant)
+
+    private sealed interface Key {
+        val sourceId: Long
+
+        data class Popular(override val sourceId: Long, val page: Int) : Key
+        data class Latest(override val sourceId: Long, val page: Int) : Key
+        data class Search(
+            override val sourceId: Long,
+            val query: String,
+            val filterState: List<Pair<String, Any?>>,
+            val page: Int,
+        ) : Key
+    }
+
+    companion object {
+        private val CACHE_TTL = 10.minutes
+    }
+}
