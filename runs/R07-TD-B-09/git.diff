@@ -0,0 +1,126 @@
+package tachiyomi.data.source
+
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.FilterList
+import eu.kanade.tachiyomi.source.model.MangasPage
+import eu.kanade.tachiyomi.source.model.SManga
+import io.kotest.matchers.shouldBe
+import io.kotest.matchers.shouldNotBe
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.parallel.Execution
+import org.junit.jupiter.api.parallel.ExecutionMode
+
+@Execution(ExecutionMode.CONCURRENT)
+class SourceListingCacheTest {
+
+    private class TestTextFilter(state: String) : Filter.Text("query", state)
+
+    private fun mangasPage(title: String) = MangasPage(listOf(SManga.create().apply { this.title = title }), false)
+
+    @Test
+    fun `returns null when nothing has been cached`() {
+        val cache = SourceListingCache()
+        cache.getPopular(sourceId = 1L, page = 1) shouldBe null
+        cache.getLatest(sourceId = 1L, page = 1) shouldBe null
+        cache.getSearch(sourceId = 1L, query = "one piece", filters = FilterList(), page = 1) shouldBe null
+    }
+
+    @Test
+    fun `returns the cached page for an identical popular request`() {
+        val cache = SourceListingCache()
+        val page = mangasPage("Cached")
+
+        cache.putPopular(sourceId = 1L, page = 1, mangasPage = page)
+
+        cache.getPopular(sourceId = 1L, page = 1) shouldBe page
+    }
+
+    @Test
+    fun `returns the cached page for an identical search request`() {
+        val cache = SourceListingCache()
+        val filters = FilterList(TestTextFilter("shounen"))
+        val page = mangasPage("Cached")
+
+        cache.putSearch(sourceId = 1L, query = "one piece", filters = filters, page = 1, mangasPage = page)
+
+        cache.getSearch(sourceId = 1L, query = "one piece", filters = filters, page = 1) shouldBe page
+    }
+
+    @Test
+    fun `keeps each paginated page separate so scrolling still fetches new pages`() {
+        val cache = SourceListingCache()
+        val firstPage = mangasPage("Page 1")
+
+        cache.putSearch(sourceId = 1L, query = "one piece", filters = FilterList(), page = 1, mangasPage = firstPage)
+
+        cache.getSearch(sourceId = 1L, query = "one piece", filters = FilterList(), page = 2) shouldBe null
+        cache.getSearch(sourceId = 1L, query = "one piece", filters = FilterList(), page = 1) shouldBe firstPage
+    }
+
+    @Test
+    fun `does not confuse popular, latest and search listings on the same source`() {
+        val cache = SourceListingCache()
+        val popular = mangasPage("Popular")
+        val latest = mangasPage("Latest")
+        val search = mangasPage("Search")
+
+        cache.putPopular(sourceId = 1L, page = 1, mangasPage = popular)
+        cache.putLatest(sourceId = 1L, page = 1, mangasPage = latest)
+        cache.putSearch(sourceId = 1L, query = "", filters = FilterList(), page = 1, mangasPage = search)
+
+        cache.getPopular(sourceId = 1L, page = 1) shouldBe popular
+        cache.getLatest(sourceId = 1L, page = 1) shouldBe latest
+        cache.getSearch(sourceId = 1L, query = "", filters = FilterList(), page = 1) shouldBe search
+    }
+
+    @Test
+    fun `does not return a cached page for a different query or filter state`() {
+        val cache = SourceListingCache()
+        val page = mangasPage("One Piece results")
+
+        cache.putSearch(sourceId = 1L, query = "one piece", filters = FilterList(), page = 1, mangasPage = page)
+
+        cache.getSearch(sourceId = 1L, query = "naruto", filters = FilterList(), page = 1) shouldBe null
+        cache.getSearch(
+            sourceId = 1L,
+            query = "one piece",
+            filters = FilterList(TestTextFilter("shounen")),
+            page = 1,
+        ) shouldBe null
+    }
+
+    @Test
+    fun `does not return a cached page for a different source`() {
+        val cache = SourceListingCache()
+        val page = mangasPage("Cached")
+
+        cache.putPopular(sourceId = 1L, page = 1, mangasPage = page)
+
+        cache.getPopular(sourceId = 2L, page = 1) shouldBe null
+    }
+
+    @Test
+    fun `invalidate clears every listing for a source but leaves other sources untouched`() {
+        val cache = SourceListingCache()
+        val sourceOnePopular = mangasPage("Source 1 popular")
+        val sourceTwoPopular = mangasPage("Source 2 popular")
+
+        cache.putPopular(sourceId = 1L, page = 1, mangasPage = sourceOnePopular)
+        cache.putLatest(sourceId = 1L, page = 1, mangasPage = sourceOnePopular)
+        cache.putSearch(
+            sourceId = 1L,
+            query = "one piece",
+            filters = FilterList(),
+            page = 1,
+            mangasPage = sourceOnePopular,
+        )
+        cache.putPopular(sourceId = 2L, page = 1, mangasPage = sourceTwoPopular)
+
+        cache.invalidate(sourceId = 1L)
+
+        cache.getPopular(sourceId = 1L, page = 1) shouldBe null
+        cache.getLatest(sourceId = 1L, page = 1) shouldBe null
+        cache.getSearch(sourceId = 1L, query = "one piece", filters = FilterList(), page = 1) shouldBe null
+        cache.getPopular(sourceId = 2L, page = 1) shouldNotBe null
+    }
+}
