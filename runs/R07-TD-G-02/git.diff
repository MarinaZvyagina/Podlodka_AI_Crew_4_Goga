diff --git a/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt b/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt
new file mode 100644
index 0000000..8f6b97a
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt
@@ -0,0 +1,58 @@
+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.MangasPage
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.time.Clock
+
+/**
+ * Identifies a distinct manga listing for a source: either one of its fixed listings
+ * (popular/latest) or a search with a specific query and filter state.
+ */
+sealed class ListingKey {
+    data object Popular : ListingKey()
+    data object Latest : ListingKey()
+    data class Search(val query: String, val filters: List<Filter<*>>) : ListingKey()
+}
+
+/**
+ * Short-lived in-memory cache of [MangasPage] results per source listing and page, so that
+ * repeating the same popular/latest/search request shortly after doesn't hit the network again.
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourceListingCache {
+
+    private data class CacheKey(val sourceId: Long, val listingKey: ListingKey, val page: Int)
+
+    private class CacheEntry(val mangasPage: MangasPage, val expiresAt: Long)
+
+    private val entries = ConcurrentHashMap<CacheKey, CacheEntry>()
+
+    suspend fun getOrPut(
+        sourceId: Long,
+        listingKey: ListingKey,
+        page: Int,
+        fetch: suspend () -> MangasPage,
+    ): MangasPage {
+        val key = CacheKey(sourceId, listingKey, page)
+        val now = Clock.System.now().toEpochMilliseconds()
+
+        entries[key]?.takeIf { it.expiresAt > now }?.let { return it.mangasPage }
+
+        val mangasPage = fetch()
+        entries[key] = CacheEntry(mangasPage, now + EXPIRY_MILLIS)
+        return mangasPage
+    }
+
+    fun invalidate(sourceId: Long, listingKey: ListingKey) {
+        entries.keys.removeAll { it.sourceId == sourceId && it.listingKey == listingKey }
+    }
+
+    companion object {
+        private const val EXPIRY_MILLIS = 5 * 60 * 1000L
+    }
+}
