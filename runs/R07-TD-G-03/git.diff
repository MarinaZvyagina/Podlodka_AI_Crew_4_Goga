diff --git a/data/src/main/java/tachiyomi/data/source/SourceMangaCache.kt b/data/src/main/java/tachiyomi/data/source/SourceMangaCache.kt
new file mode 100644
index 0000000..853da42
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourceMangaCache.kt
@@ -0,0 +1,55 @@
+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.MangasPage
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.time.Clock
+import kotlin.time.Duration.Companion.minutes
+import kotlin.time.Instant
+
+/**
+ * Caches paginated [MangasPage] results per source listing so that repeating the same
+ * popular/latest/search request shortly after fetches nothing over the network.
+ *
+ * Keyed per page, so scrolling through several pages of a cached listing is served entirely
+ * from cache. Entries expire after [ENTRY_LIFETIME] to avoid serving stale results forever.
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourceMangaCache {
+
+    private val cache = ConcurrentHashMap<Key, ConcurrentHashMap<Int, Entry>>()
+
+    fun get(key: Key, page: Int): MangasPage? {
+        val entry = cache[key]?.get(page) ?: return null
+        if (Clock.System.now() >= entry.expiresAt) return null
+        return entry.mangasPage
+    }
+
+    fun put(key: Key, page: Int, mangasPage: MangasPage) {
+        cache.computeIfAbsent(key) { ConcurrentHashMap() }[page] =
+            Entry(mangasPage, Clock.System.now() + ENTRY_LIFETIME)
+    }
+
+    private data class Entry(val mangasPage: MangasPage, val expiresAt: Instant)
+
+    data class Key(
+        val sourceId: Long,
+        val listing: Listing,
+        // FilterList#equals always returns false, so a plain structural List is used instead.
+        val filters: List<Filter<*>>,
+    )
+
+    sealed interface Listing {
+        data object Popular : Listing
+        data object Latest : Listing
+        data class Search(val query: String) : Listing
+    }
+
+    companion object {
+        private val ENTRY_LIFETIME = 5.minutes
+    }
+}
