diff --git a/data/src/main/java/tachiyomi/data/source/SourcePagingCache.kt b/data/src/main/java/tachiyomi/data/source/SourcePagingCache.kt
new file mode 100644
index 0000000..0bc8901
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourcePagingCache.kt
@@ -0,0 +1,54 @@
+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.MangasPage
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.time.Clock
+import kotlin.time.Duration.Companion.minutes
+import kotlin.time.Instant
+
+/**
+ * In-memory cache of source listing results (popular/latest/search), so that repeating the same
+ * listing shortly after fetching it (e.g. navigating back, or re-running the same search) does
+ * not hit the network again. Entries expire after [EXPIRY] and can be force-invalidated to make
+ * the next request bypass the cache.
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourcePagingCache {
+
+    data class Listing(val sourceId: Long, val mode: String, val query: String, val filtersHash: Int)
+
+    private data class PageKey(val listing: Listing, val page: Int)
+    private class Entry(val mangasPage: MangasPage, val savedAt: Instant)
+
+    private val entries = ConcurrentHashMap<PageKey, Entry>()
+
+    suspend fun getOrPut(listing: Listing, page: Int, fetch: suspend () -> MangasPage): MangasPage {
+        val key = PageKey(listing, page)
+        val cached = entries[key]
+        if (cached != null && Clock.System.now() - cached.savedAt < EXPIRY) {
+            return cached.mangasPage
+        }
+
+        val mangasPage = fetch()
+        entries[key] = Entry(mangasPage, Clock.System.now())
+        evictExpired()
+        return mangasPage
+    }
+
+    fun invalidate(listing: Listing) {
+        entries.keys.removeAll { it.listing == listing }
+    }
+
+    private fun evictExpired() {
+        val now = Clock.System.now()
+        entries.entries.removeAll { now - it.value.savedAt >= EXPIRY }
+    }
+
+    companion object {
+        private val EXPIRY = 5.minutes
+    }
+}
