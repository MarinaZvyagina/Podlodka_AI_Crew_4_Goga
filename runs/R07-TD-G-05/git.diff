+++ b/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt
@@ -0,0 +1,52 @@
+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.FilterList
+import eu.kanade.tachiyomi.source.model.MangasPage
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.time.Clock
+import kotlin.time.Duration.Companion.minutes
+
+/**
+ * In-memory cache of [MangasPage] results per source listing (popular/latest/search), keyed by
+ * the exact query/filters/page combination used to fetch them. Entries expire after [CACHE_TTL]
+ * so that browsing back to a previously viewed listing shortly after doesn't hit the network
+ * again, while older entries eventually fall back to a live fetch.
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourceListingCache {
+
+    private val cache = ConcurrentHashMap<Key, Entry>()
+
+    fun get(key: Key): MangasPage? {
+        val entry = cache[key] ?: return null
+        if (Clock.System.now().toEpochMilliseconds() - entry.timestamp > CACHE_TTL) {
+            cache.remove(key)
+            return null
+        }
+        return entry.mangasPage
+    }
+
+    fun put(key: Key, mangasPage: MangasPage) {
+        cache[key] = Entry(mangasPage, Clock.System.now().toEpochMilliseconds())
+    }
+
+    data class Key(
+        val sourceId: Long,
+        val query: String,
+        val filters: FilterList,
+        val page: Int,
+    )
+
+    private data class Entry(
+        val mangasPage: MangasPage,
+        val timestamp: Long,
+    )
+
+    companion object {
+        private val CACHE_TTL = 5.minutes.inWholeMilliseconds
+    }
+}
