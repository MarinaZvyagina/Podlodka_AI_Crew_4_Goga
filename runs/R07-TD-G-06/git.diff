diff --git a/data/src/main/java/tachiyomi/data/source/SourceMangaCache.kt b/data/src/main/java/tachiyomi/data/source/SourceMangaCache.kt
new file mode 100644
index 0000000..30171cd
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourceMangaCache.kt
@@ -0,0 +1,59 @@
+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.MangasPage
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * In-memory cache of [MangasPage] results per source listing (popular/latest/search), keyed by
+ * source, listing kind, query, filters and page number. Entries expire after [CACHE_TTL_MILLIS]
+ * so that repeating an identical browse/search shortly after skips the network round-trip.
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourceMangaCache {
+
+    private data class Key(
+        val sourceId: Long,
+        val kind: String,
+        val query: String,
+        val filters: List<Filter<*>>,
+        val page: Int,
+    )
+
+    private data class Entry(val mangasPage: MangasPage, val expiresAtMillis: Long)
+
+    private val cache = ConcurrentHashMap<Key, Entry>()
+
+    fun get(sourceId: Long, kind: String, query: String, filters: List<Filter<*>>, page: Int): MangasPage? {
+        val key = Key(sourceId, kind, query, filters, page)
+        val entry = cache[key] ?: return null
+        if (System.currentTimeMillis() > entry.expiresAtMillis) {
+            cache.remove(key, entry)
+            return null
+        }
+        return entry.mangasPage
+    }
+
+    fun put(sourceId: Long, kind: String, query: String, filters: List<Filter<*>>, page: Int, mangasPage: MangasPage) {
+        val key = Key(sourceId, kind, query, filters, page)
+        cache[key] = Entry(mangasPage, System.currentTimeMillis() + CACHE_TTL_MILLIS)
+    }
+
+    fun invalidate(sourceId: Long, kind: String, query: String, filters: List<Filter<*>>) {
+        cache.keys.removeIf {
+            it.sourceId == sourceId && it.kind == kind && it.query == query && it.filters == filters
+        }
+    }
+
+    companion object {
+        const val KIND_POPULAR = "popular"
+        const val KIND_LATEST = "latest"
+        const val KIND_SEARCH = "search"
+
+        private const val CACHE_TTL_MILLIS = 5 * 60 * 1000L
+    }
+}
