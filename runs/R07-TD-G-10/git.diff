diff --git a/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt b/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt
new file mode 100644
index 0000000..378bffb
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/source/SourceListingCache.kt
@@ -0,0 +1,66 @@
+package tachiyomi.data.source
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import eu.kanade.tachiyomi.source.model.FilterList
+import eu.kanade.tachiyomi.source.model.MangasPage
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.locks.ReentrantLock
+import kotlin.concurrent.withLock
+import kotlin.time.Duration.Companion.minutes
+
+/**
+ * Caches paginated source listing results (popular, latest, search) so that repeating
+ * the same listing shortly after a previous fetch is served from memory instead of
+ * hitting the source again. Entries expire after [EXPIRATION_MS] and can be dropped
+ * on demand via [invalidate] to force a fresh fetch (e.g. pull-to-refresh).
+ */
+@Inject
+@SingleIn(AppScope::class)
+class SourceListingCache {
+
+    private data class Key(val sourceId: Long, val query: String, val filters: List<*>)
+
+    private class Bucket(val fetchedAt: Long) {
+        val pages = ConcurrentHashMap<Int, MangasPage>()
+    }
+
+    private val lock = ReentrantLock()
+    private val buckets = ConcurrentHashMap<Key, Bucket>()
+
+    suspend fun getOrLoad(
+        sourceId: Long,
+        query: String,
+        filters: FilterList,
+        page: Int,
+        loader: suspend () -> MangasPage,
+    ): MangasPage {
+        val key = Key(sourceId, query, filters.list)
+        val now = System.currentTimeMillis()
+
+        // Look up (or start) the bucket for this listing atomically so a concurrent
+        // expiry check can't hand out a bucket that's about to be replaced.
+        val bucket = lock.withLock {
+            val current = buckets[key]
+            if (current != null && now - current.fetchedAt < EXPIRATION_MS) {
+                current
+            } else {
+                Bucket(now).also { buckets[key] = it }
+            }
+        }
+
+        bucket.pages[page]?.let { return it }
+
+        return loader().also { bucket.pages[page] = it }
+    }
+
+    /** Drops any cached pages for this listing so the next load fetches fresh data. */
+    fun invalidate(sourceId: Long, query: String, filters: FilterList) {
+        buckets.remove(Key(sourceId, query, filters.list))
+    }
+
+    companion object {
+        private val EXPIRATION_MS = 5.minutes.inWholeMilliseconds
+    }
+}
