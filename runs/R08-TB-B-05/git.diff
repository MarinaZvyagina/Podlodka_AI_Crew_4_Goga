+
+package org.signal.mediasend.screens.edit
+
+import android.app.Application
+import androidx.compose.ui.test.assertIsDisplayed
+import androidx.compose.ui.test.assertIsOff
+import androidx.compose.ui.test.assertIsOn
+import androidx.compose.ui.test.junit4.createComposeRule
+import androidx.compose.ui.test.onNodeWithTag
+import androidx.compose.ui.test.performClick
+import androidx.test.core.app.ApplicationProvider
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.signal.core.ui.CoreUiDependenciesRule
+import org.signal.core.ui.compose.theme.SignalTheme
+import org.signal.mediasend.MediaSendDependenciesRule
+import org.signal.mediasend.SentMediaQuality
+import org.signal.mediasend.test.TestTags
+
+/**
+ * Covers the per-item "send this item in full quality" checkbox: it is only offered for a multi-item batch, and
+ * toggling it reports the opposite of whatever it currently shows.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(application = Application::class)
+class QualitySelectorSheetContentTest {
+
+  @get:Rule
+  val composeTestRule = createComposeRule()
+
+  @get:Rule
+  val coreUiDependenciesRule = CoreUiDependenciesRule(ApplicationProvider.getApplicationContext())
+
+  @get:Rule
+  val mediaSendDependenciesRule = MediaSendDependenciesRule(ApplicationProvider.getApplicationContext())
+
+  @Test
+  fun `Given a single item selection, when rendering the sheet, then the full quality override is not offered`() {
+    setContent(isFullQualityOverrideAvailable = false, isFullQualityOverrideEnabled = false)
+
+    composeTestRule.onNodeWithTag(TestTags.MEDIA_EDITOR_TOOLBAR_QUALITY_FULL_QUALITY_OVERRIDE_CHECKBOX).assertDoesNotExist()
+  }
+
+  @Test
+  fun `Given a multi item selection, when rendering the sheet, then the full quality override reflects its current state`() {
+    setContent(isFullQualityOverrideAvailable = true, isFullQualityOverrideEnabled = true)
+
+    composeTestRule.onNodeWithTag(TestTags.MEDIA_EDITOR_TOOLBAR_QUALITY_FULL_QUALITY_OVERRIDE_CHECKBOX)
+      .assertIsDisplayed()
+      .assertIsOn()
+  }
+
+  @Test
+  fun `Given the full quality override is off, when it is clicked, then it reports being turned on`() {
+    var reported: Boolean? = null
+
+    setContent(
+      isFullQualityOverrideAvailable = true,
+      isFullQualityOverrideEnabled = false,
+      onFullQualityOverrideChanged = { reported = it }
+    )
+
+    composeTestRule.onNodeWithTag(TestTags.MEDIA_EDITOR_TOOLBAR_QUALITY_FULL_QUALITY_OVERRIDE_CHECKBOX)
+      .assertIsOff()
+      .performClick()
+
+    assert(reported == true) { "Expected the override to report turning on, but got $reported" }
+  }
+
+  private fun setContent(
+    isFullQualityOverrideAvailable: Boolean,
+    isFullQualityOverrideEnabled: Boolean,
+    onFullQualityOverrideChanged: (Boolean) -> Unit = {}
+  ) {
+    composeTestRule.setContent {
+      SignalTheme {
+        QualitySelectorSheetContent(
+          quality = SentMediaQuality.STANDARD,
+          onQualitySelected = {},
+          isFullQualityOverrideAvailable = isFullQualityOverrideAvailable,
+          isFullQualityOverrideEnabled = isFullQualityOverrideEnabled,
+          onFullQualityOverrideChanged = onFullQualityOverrideChanged
+        )
+      }
+    }
+  }
+}
