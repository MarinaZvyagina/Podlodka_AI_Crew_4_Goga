+  /**
+   * Marks (or unmarks) a single item to be sent at full/original quality, skipping the normal compression pass for
+   * just that item while the rest of the batch keeps [MediaSendFlowState.sentMediaQuality] as usual.
+   *
+   * Cancels any pre-upload already running (or finished) for the old copy of the media, the same way a video
+   * trim/mute edit invalidates an in-flight pre-upload -- the new copy is not re-uploaded here, it is uploaded fresh,
+   * along with anything else still pending, at [send].
+   */
+  private fun setFullQualityOverride(media: Media, enabled: Boolean) {
+    val snapshot = state.value
+    val current = snapshot.selectedMedia.firstOrNull { it.uri == media.uri } ?: return
+    val currentProperties = current.transformProperties ?: TransformProperties.empty()
+    if (currentProperties.skipTransform == enabled) return
+
+    val updated = current.copy(transformProperties = currentProperties.copy(skipTransform = enabled))
+
+    updateState {
+      copy(
+        selectedMedia = selectedMedia.map { if (it.uri == media.uri) updated else it },
+        focusedMedia = if (focusedMedia?.uri == media.uri) updated else focusedMedia
+      )
+    }
+
+    preUploadController.cancelUpload(current)
+
+    if (enabled) {
+      fullQualityToastEvent(updated)?.let { internalToastEvents.trySend(it) }
+    }
+  }
+
+  /** Only the notable direction (turning the override on) is worth confirming, same as [toggleVideoMuted]. */
+  private fun fullQualityToastEvent(media: Media): ToastEvent? {
+    val message = when {
+      isNonGifVideo(media) -> ToastMessage.Text(R.string.MediaReviewFragment__video_set_to_full_quality)
+      ContentTypeUtil.isImageType(media.contentType) -> ToastMessage.Text(R.string.MediaReviewFragment__photo_set_to_full_quality)
+      else -> {
+        Log.i(TAG, "No full quality confirmation for an attachment of type: ${media.contentType}")
+        return null
+      }
+    }
+
+    return ToastEvent(icon = SignalIcons.QualityHigh, message = message)
+  }
+
   //endregion
 
   //region Video Editing
