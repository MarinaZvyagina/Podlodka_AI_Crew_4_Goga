+  /**
+   * Toggles whether the focused item bypasses the batch's compression pass entirely, so it is sent at its original
+   * quality regardless of [MediaSendFlowState.sentMediaQuality]. The flag lives on the item's own
+   * [org.signal.core.models.media.TransformProperties], so it rides along in [MediaSendFlowState.selectedMedia] --
+   * persisted by [SavedStateHandle] -- and is written into the attachment row itself once the item is (re-)uploaded.
+   *
+   * Any pre-upload already running or finished for this item is canceled so the change takes effect even if
+   * compression had already started: the item re-uploads at send time using its updated properties, the same way an
+   * edited video's trim or mute change does.
+   */
+  private fun toggleFullQuality() {
+    val snapshot = state.value
+    val uri = snapshot.focusedMedia?.uri ?: return
+    val media = snapshot.selectedMedia.firstOrNull { it.uri == uri } ?: return
+
+    val current = media.transformProperties ?: TransformProperties.empty()
+    val updated = media.copy(transformProperties = current.copy(skipTransform = !current.skipTransform))
+
+    updateState {
+      copy(
+        selectedMedia = selectedMedia.map { if (it.uri == uri) updated else it },
+        focusedMedia = if (focusedMedia?.uri == uri) updated else focusedMedia
+      )
+    }
+
+    preUploadController.cancelUpload(media)
+
+    if (updated.transformProperties?.skipTransform == true) {
+      internalToastEvents.trySend(
+        ToastEvent(
+          icon = SignalIcons.Maximize,
+          message = ToastMessage.Text(R.string.MediaSendViewModel__item_will_be_sent_at_full_quality)
+        )
+      )
+    }
+  }
+
   //endregion
 
