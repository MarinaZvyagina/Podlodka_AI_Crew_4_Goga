+  /**
+   * A chunked version of [deleteAbandonedAttachmentFiles] intended for use by a job that wants to make
+   * incremental, resumable progress rather than reconciling the entire attachments directory in one shot.
+   *
+   * Files are considered in a stable sorted order, and only those sorting after [afterFileName] are examined,
+   * up to [limit] of them. This lets a caller persist [AbandonedAttachmentFileCleanupResult.lastExaminedFileName]
+   * and pass it back in on a subsequent call to pick up where it left off, even if the process died in between.
+   */
+  fun deleteAbandonedAttachmentFiles(afterFileName: String?, limit: Int): AbandonedAttachmentFileCleanupResult {
+    val diskFiles = context.getDir(DIRECTORY, Context.MODE_PRIVATE).listFiles() ?: return AbandonedAttachmentFileCleanupResult(deletedCount = 0, lastExaminedFileName = null, isFinished = true)
+
+    val candidateFiles: List<File> = diskFiles
+      .filter { file: File -> !PartFileProtector.isProtected(file) }
+      .sortedBy { file: File -> file.name }
+      .let { sorted -> if (afterFileName != null) sorted.filter { it.name > afterFileName } else sorted }
+
+    if (candidateFiles.isEmpty()) {
+      return AbandonedAttachmentFileCleanupResult(deletedCount = 0, lastExaminedFileName = null, isFinished = true)
+    }
+
+    val chunk = candidateFiles.take(limit)
+
+    val filesInDb: MutableSet<String> = HashSet()
+
+    readableDatabase.withinTransaction { db ->
+      db.select(DATA_FILE, THUMBNAIL_FILE)
+        .from(TABLE_NAME)
+        .run()
+        .forEach { cursor ->
+          cursor.requireString(DATA_FILE)?.let { filesInDb += it }
+          cursor.requireString(THUMBNAIL_FILE)?.let { filesInDb += it }
+        }
+    }
+
+    filesInDb += SignalDatabase.stickers.getAllStickerFiles()
+
+    var deletedCount = 0
+    for (file in chunk) {
+      if (file.absolutePath !in filesInDb) {
+        if (file.delete()) {
+          deletedCount++
+        } else {
+          Log.w(TAG, "[deleteAbandonedAttachmentFiles] Failed to delete attachment file. ${file.absolutePath}")
+        }
+      }
+    }
+
+    return AbandonedAttachmentFileCleanupResult(
+      deletedCount = deletedCount,
+      lastExaminedFileName = chunk.last().name,
+      isFinished = chunk.size == candidateFiles.size
+    )
+  }
+
+  data class AbandonedAttachmentFileCleanupResult(
+    val deletedCount: Int,
+    val lastExaminedFileName: String?,
+    val isFinished: Boolean
+  )
+
