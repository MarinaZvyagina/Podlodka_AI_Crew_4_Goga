+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.jobs
+
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.SignalDatabase.Companion.attachments
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.JsonJobData
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+import kotlin.time.Duration.Companion.days
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * Periodically scans the attachment storage directory for cached thumbnail/preview files that no longer
+ * correspond to any attachment or message still in the app, deleting them to reclaim disk space.
+ *
+ * Runs in small chunks so a single pass never blocks other work for long, and so that progress survives
+ * being killed partway through (which happens routinely on Android): each chunk persists the name of the
+ * last file it examined, and the next attempt resumes after that point instead of rescanning everything or
+ * losing its place.
+ */
+class ThumbnailCleanupJob private constructor(
+  parameters: Parameters,
+  private var lastExaminedFileName: String?
+) : Job(parameters) {
+
+  companion object {
+    private val TAG = Log.tag(ThumbnailCleanupJob::class)
+
+    const val KEY = "ThumbnailCleanupJob"
+
+    private const val KEY_LAST_EXAMINED_FILE_NAME = "last_examined_file_name"
+
+    /** Number of files reconciled against the database per run, keeping each invocation short-lived. */
+    private const val CHUNK_SIZE = 500
+  }
+
+  constructor() : this(
+    parameters = Parameters.Builder()
+      .setMaxInstancesForFactory(1)
+      .setLifespan(1.days.inWholeMilliseconds)
+      .setMaxAttempts(Parameters.UNLIMITED)
+      .addConstraint(BatteryNotLowConstraint.KEY)
+      .addConstraint(NotInCallConstraint.KEY)
+      .build(),
+    lastExaminedFileName = null
+  )
+
+  override fun serialize(): ByteArray? {
+    return JsonJobData.Builder()
+      .putString(KEY_LAST_EXAMINED_FILE_NAME, lastExaminedFileName)
+      .build()
+      .serialize()
+  }
+
+  override fun getFactoryKey(): String = KEY
+
+  override fun onFailure() = Unit
+
+  override fun run(): Result {
+    val result = attachments.deleteAbandonedAttachmentFiles(afterFileName = lastExaminedFileName, limit = CHUNK_SIZE)
+
+    if (result.deletedCount > 0) {
+      Log.i(TAG, "Deleted ${result.deletedCount} orphaned thumbnail/attachment files.")
+    }
+
+    if (result.isFinished) {
+      return Result.success()
+    }
+
+    lastExaminedFileName = result.lastExaminedFileName
+    return Result.retry(1.seconds.inWholeMilliseconds)
+  }
+
+  class Factory : Job.Factory<ThumbnailCleanupJob> {
+    override fun create(parameters: Parameters, serializedData: ByteArray?): ThumbnailCleanupJob {
+      val data = JsonJobData.deserialize(serializedData)
+      return ThumbnailCleanupJob(parameters, data.getStringOrDefault(KEY_LAST_EXAMINED_FILE_NAME, null))
+    }
+  }
+}
