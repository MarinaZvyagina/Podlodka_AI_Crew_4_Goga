+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.service
+
+import android.content.Context
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.jobs.DeleteAbandonedAttachmentFilesJob
+import org.thoughtcrime.securesms.keyvalue.SignalStore
+import org.thoughtcrime.securesms.util.toMillis
+import java.security.SecureRandom
+import java.time.LocalDateTime
+
+/**
+ * Schedules a pass of [DeleteAbandonedAttachmentFilesJob] to run once a day at a randomized early-morning time. The job itself is what enforces the
+ * "not during a call" / "not on critically low battery" / low priority behavior, so all this listener does is guarantee the job gets queued on a
+ * recurring cadence without any user action.
+ */
+class AbandonedAttachmentFileCleanupAlarmListener : PersistentAlarmManagerListener() {
+  companion object {
+    @JvmStatic
+    fun schedule(context: Context?) {
+      AbandonedAttachmentFileCleanupAlarmListener().onReceive(context, getScheduleIntent())
+    }
+  }
+
+  override fun shouldScheduleExact(): Boolean {
+    return true
+  }
+
+  override fun getNextScheduledExecutionTime(context: Context): Long {
+    var nextTime = SignalStore.misc.nextAbandonedAttachmentFileCleanupTime
+
+    if (nextTime == 0L) {
+      nextTime = getNextTime()
+      SignalStore.misc.nextAbandonedAttachmentFileCleanupTime = nextTime
+    }
+
+    return nextTime
+  }
+
+  override fun onAlarm(context: Context, scheduledTime: Long): Long {
+    AppDependencies.jobManager.add(DeleteAbandonedAttachmentFilesJob())
+
+    val nextTime = getNextTime()
+    SignalStore.misc.nextAbandonedAttachmentFileCleanupTime = nextTime
+
+    return nextTime
+  }
+
+  private fun getNextTime(): Long {
+    val random = SecureRandom()
+    return LocalDateTime
+      .now()
+      .plusDays(1)
+      .withHour(2 + random.nextInt(3))
+      .withMinute(random.nextInt(60))
+      .withSecond(random.nextInt(60))
+      .toMillis()
+  }
+}
