+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.jobs
+
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.SignalDatabase.Companion.attachments
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.JsonJobData
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * Periodically walks the attachment storage directory looking for thumbnail and data files that no longer belong to any attachment (and therefore no
+ * message), deleting them a bounded batch at a time.
+ *
+ * This only does a bounded amount of work per [run], tracking its position on disk in [lastFileProcessed] and retrying itself until a batch comes back
+ * short, i.e. there's nothing left to clean up. Because that cursor is part of the job's serialized state, a pass that gets killed partway through
+ * (routine on Android) resumes from where it left off on the next attempt instead of restarting the scan or stalling forever.
+ *
+ * Runs at the lowest priority and is skipped entirely while the user is on a call or the battery is critically low, so it never competes with anything
+ * the user is actively doing.
+ */
+class DeleteAbandonedAttachmentFilesJob private constructor(
+  parameters: Parameters,
+  private var lastFileProcessed: String?
+) : Job(parameters) {
+
+  companion object {
+    private val TAG = Log.tag(DeleteAbandonedAttachmentFilesJob::class)
+    const val KEY = "DeleteAbandonedAttachmentFilesJob"
+
+    private const val KEY_LAST_FILE_PROCESSED = "last_file_processed"
+    private const val BATCH_SIZE = 500
+  }
+
+  constructor() : this(
+    parameters = Parameters.Builder()
+      .setMaxInstancesForFactory(1)
+      .setMaxAttempts(Parameters.UNLIMITED)
+      .setLifespan(Parameters.IMMORTAL)
+      .setGlobalPriority(Parameters.PRIORITY_LOWER)
+      .addConstraint(NotInCallConstraint.KEY)
+      .addConstraint(BatteryNotLowConstraint.KEY)
+      .build(),
+    lastFileProcessed = null
+  )
+
+  override fun serialize(): ByteArray {
+    return JsonJobData.Builder()
+      .putString(KEY_LAST_FILE_PROCESSED, lastFileProcessed)
+      .build()
+      .serialize()
+  }
+
+  override fun getFactoryKey(): String = KEY
+
+  override fun onFailure() = Unit
+
+  override fun run(): Result {
+    val batch = attachments.deleteAbandonedAttachmentFiles(afterFile = lastFileProcessed, limit = BATCH_SIZE)
+
+    if (batch.deletedCount > 0) {
+      Log.i(TAG, "Deleted ${batch.deletedCount} abandoned attachment file(s).")
+    }
+
+    if (!batch.hasMore) {
+      lastFileProcessed = null
+      return Result.success()
+    }
+
+    lastFileProcessed = batch.lastFile
+    return Result.retry(1.seconds.inWholeMilliseconds)
+  }
+
+  class Factory : Job.Factory<DeleteAbandonedAttachmentFilesJob> {
+    override fun create(parameters: Parameters, serializedData: ByteArray?): DeleteAbandonedAttachmentFilesJob {
+      val data = JsonJobData.deserialize(serializedData)
+      return DeleteAbandonedAttachmentFilesJob(parameters, data.getStringOrDefault(KEY_LAST_FILE_PROCESSED, null))
+    }
+  }
+}
