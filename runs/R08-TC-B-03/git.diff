+  /**
+   * Deletes a bounded batch of abandoned attachment/thumbnail files (files on disk that are no longer referenced by any attachment or sticker).
+   *
+   * Unlike [deleteAbandonedAttachmentFiles], this processes at most [limit] candidate files per call, ordered by their absolute path, and only considers
+   * files that sort after [afterFile]. This lets a caller make incremental, resumable progress through a potentially large directory across multiple
+   * invocations (e.g. separate job runs) by passing [AbandonedAttachmentFilesCleanupResult.lastFile] from the previous call back in as [afterFile].
+   */
+  fun deleteAbandonedAttachmentFiles(afterFile: String?, limit: Int): AbandonedAttachmentFilesCleanupResult {
+    val diskFiles = context.getDir(DIRECTORY, Context.MODE_PRIVATE).listFiles() ?: return AbandonedAttachmentFilesCleanupResult(deletedCount = 0, lastFile = null, hasMore = false)
+
+    val candidateFiles: List<String> = diskFiles
+      .asSequence()
+      .filter { file: File -> !PartFileProtector.isProtected(file) }
+      .map { file: File -> file.absolutePath }
+      .filter { path: String -> afterFile == null || path > afterFile }
+      .sorted()
+      .take(limit)
+      .toList()
+
+    if (candidateFiles.isEmpty()) {
+      return AbandonedAttachmentFilesCleanupResult(deletedCount = 0, lastFile = null, hasMore = false)
+    }
+
+    val filesInDb: MutableSet<String> = HashSet()
+
+    readableDatabase.withinTransaction { db ->
+      db.select(DATA_FILE, THUMBNAIL_FILE)
+        .from(TABLE_NAME)
+        .run()
+        .forEach { cursor ->
+          cursor.requireString(DATA_FILE)?.let { filesInDb += it }
+          cursor.requireString(THUMBNAIL_FILE)?.let { filesInDb += it }
+        }
+    }
+
+    filesInDb += SignalDatabase.stickers.getAllStickerFiles()
+
+    var deletedCount = 0
+    for (path in candidateFiles) {
+      if (path !in filesInDb) {
+        if (File(path).delete()) {
+          deletedCount++
+        } else {
+          Log.w(TAG, "[deleteAbandonedAttachmentFiles] Failed to delete attachment file. $path")
+        }
+      }
+    }
+
+    return AbandonedAttachmentFilesCleanupResult(deletedCount = deletedCount, lastFile = candidateFiles.last(), hasMore = candidateFiles.size == limit)
+  }
+
+  data class AbandonedAttachmentFilesCleanupResult(val deletedCount: Int, val lastFile: String?, val hasMore: Boolean)
