index 0000000..0688316
--- /dev/null
+++ b/app/src/main/java/org/thoughtcrime/securesms/service/DeleteAbandonedAttachmentsAlarmListener.kt
@@ -0,0 +1,58 @@
+package org.thoughtcrime.securesms.service
+
+import android.content.Context
+import org.thoughtcrime.securesms.jobs.DeleteAbandonedAttachmentsJob
+import org.thoughtcrime.securesms.keyvalue.SignalStore
+import org.thoughtcrime.securesms.util.toMillis
+import java.security.SecureRandom
+import java.time.LocalDateTime
+
+/**
+ * Schedules a daily sweep to delete attachment and thumbnail cache files that no longer belong to
+ * any attachment or message still in the database. The actual work is done by
+ * [DeleteAbandonedAttachmentsJob], which is constrained to not run during a call or when the
+ * battery is low; this alarm is just what guarantees the sweep happens on its own regular cadence
+ * rather than only right after an app update or a specific user action.
+ *
+ * Uses an inexact alarm (rather than [shouldScheduleExact]) since this is low-priority
+ * housekeeping that the OS is free to batch with other work.
+ */
+class DeleteAbandonedAttachmentsAlarmListener : PersistentAlarmManagerListener() {
+  companion object {
+    @JvmStatic
+    fun schedule(context: Context?) {
+      DeleteAbandonedAttachmentsAlarmListener().onReceive(context, getScheduleIntent())
+    }
+  }
+
+  override fun getNextScheduledExecutionTime(context: Context): Long {
+    var nextTime = SignalStore.misc.nextAbandonedAttachmentFileCleanupTime
+
+    if (nextTime == 0L) {
+      nextTime = getNextTime()
+      SignalStore.misc.nextAbandonedAttachmentFileCleanupTime = nextTime
+    }
+
+    return nextTime
+  }
+
+  override fun onAlarm(context: Context, scheduledTime: Long): Long {
+    DeleteAbandonedAttachmentsJob.enqueue()
+
+    val nextTime = getNextTime()
+    SignalStore.misc.nextAbandonedAttachmentFileCleanupTime = nextTime
+
+    return nextTime
+  }
+
+  private fun getNextTime(): Long {
+    val random = SecureRandom()
+    return LocalDateTime
+      .now()
+      .plusDays(1)
+      .withHour(2 + random.nextInt(3))
+      .withMinute(random.nextInt(60))
+      .withSecond(random.nextInt(60))
+      .toMillis()
+  }
+}
