diff --git a/app/src/main/java/org/thoughtcrime/securesms/service/DeleteAbandonedAttachmentsAlarmListener.kt b/app/src/main/java/org/thoughtcrime/securesms/service/DeleteAbandonedAttachmentsAlarmListener.kt
