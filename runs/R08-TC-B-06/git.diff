+package org.thoughtcrime.securesms.service
+
+import android.content.Context
+import org.thoughtcrime.securesms.jobs.ThumbnailCacheCleanupJob
+import org.thoughtcrime.securesms.keyvalue.SignalStore
+import org.thoughtcrime.securesms.util.toMillis
+import java.security.SecureRandom
+import java.time.LocalDateTime
+
+/**
+ * Schedules a periodic sweep for orphaned thumbnail cache files, once a day.
+ *
+ * This only enqueues the job on a recurring cadence; [ThumbnailCacheCleanupJob] itself is
+ * responsible for respecting call/battery constraints and resuming an interrupted pass.
+ */
+class ThumbnailCacheCleanupAlarmListener : PersistentAlarmManagerListener() {
+  companion object {
+    @JvmStatic
+    fun schedule(context: Context?) {
+      ThumbnailCacheCleanupAlarmListener().onReceive(context, getScheduleIntent())
+    }
+  }
+
+  override fun getNextScheduledExecutionTime(context: Context): Long {
+    var nextTime = SignalStore.misc.nextThumbnailCacheCleanupTime
+
+    if (nextTime == 0L) {
+      nextTime = getNextTime()
+      SignalStore.misc.nextThumbnailCacheCleanupTime = nextTime
+    }
+
+    return nextTime
+  }
+
+  override fun onAlarm(context: Context, scheduledTime: Long): Long {
+    ThumbnailCacheCleanupJob.enqueue()
+
+    val nextTime = getNextTime()
+    SignalStore.misc.nextThumbnailCacheCleanupTime = nextTime
+
+    return nextTime
+  }
+
+  private fun getNextTime(): Long {
+    val random = SecureRandom()
+    return LocalDateTime
+      .now()
+      .plusDays(1)
+      .withHour(2 + random.nextInt(3))
+      .withMinute(random.nextInt(60))
+      .withSecond(random.nextInt(60))
+      .toMillis()
+  }
+}
