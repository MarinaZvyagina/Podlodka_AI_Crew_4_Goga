+
+package org.thoughtcrime.securesms.jobs
+
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.SignalDatabase.Companion.attachments
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.JsonJobData
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+import kotlin.time.Duration.Companion.days
+
+/**
+ * Sweeps the attachment/thumbnail cache directory for files that no longer correspond to any
+ * attachment or message still in the database, deleting them to reclaim disk space.
+ *
+ * Each run only processes a bounded batch of files. If there's more to scan, this job re-enqueues
+ * a follow-up instance carrying a cursor (the last file path it looked at) so a later attempt picks
+ * up where this one left off instead of rescanning everything or leaving the sweep unfinished.
+ */
+class ThumbnailCacheCleanupJob private constructor(parameters: Parameters, private val cursor: String?) : Job(parameters) {
+
+  companion object {
+    private val TAG = Log.tag(ThumbnailCacheCleanupJob::class)
+    const val KEY = "ThumbnailCacheCleanupJob"
+
+    private const val KEY_CURSOR = "cursor"
+    private const val BATCH_SIZE = 200
+
+    @JvmStatic
+    fun enqueue() {
+      AppDependencies.jobManager.add(ThumbnailCacheCleanupJob())
+    }
+  }
+
+  constructor() : this(cursor = null)
+
+  private constructor(cursor: String?) : this(
+    parameters = Parameters.Builder()
+      .setQueue(KEY)
+      .setMaxInstancesForFactory(2)
+      .setLifespan(1.days.inWholeMilliseconds)
+      .addConstraint(NotInCallConstraint.KEY)
+      .addConstraint(BatteryNotLowConstraint.KEY)
+      .build(),
+    cursor = cursor
+  )
+
+  override fun serialize(): ByteArray? {
+    return cursor?.let { JsonJobData.Builder().putString(KEY_CURSOR, it).serialize() }
+  }
+
+  override fun getFactoryKey(): String = KEY
+
+  override fun onFailure() = Unit
+
+  override fun run(): Result {
+    val result = attachments.deleteOrphanedAttachmentFileBatch(afterPath = cursor, batchSize = BATCH_SIZE)
+
+    if (result.deletedCount > 0) {
+      Log.i(TAG, "Deleted ${result.deletedCount} orphaned thumbnail cache file(s).")
+    }
+
+    if (!result.isComplete) {
+      AppDependencies.jobManager.add(ThumbnailCacheCleanupJob(result.lastScannedPath))
+    }
+
+    return Result.success()
+  }
+
+  class Factory : Job.Factory<ThumbnailCacheCleanupJob> {
+    override fun create(parameters: Parameters, serializedData: ByteArray?): ThumbnailCacheCleanupJob {
+      val cursor = JsonJobData.deserialize(serializedData).getStringOrDefault(KEY_CURSOR, null)
+      return ThumbnailCacheCleanupJob(parameters, cursor)
+    }
+  }
+}
