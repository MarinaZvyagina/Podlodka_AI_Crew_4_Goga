+  /**
+   * Scans a single batch of files (ordered by path, starting after [afterPath]) in the attachment/thumbnail cache
+   * directory and deletes any that no longer correspond to an attachment, thumbnail, or sticker in the database.
+   *
+   * This is used to sweep the directory for orphaned thumbnail cache files in bounded chunks, so that a single pass
+   * over a large directory can be resumed across multiple job runs (via [OrphanedAttachmentFileScanResult.lastScannedPath])
+   * instead of redoing the whole scan or blocking on it in one shot.
+   */
+  fun deleteOrphanedAttachmentFileBatch(afterPath: String?, batchSize: Int): OrphanedAttachmentFileScanResult {
+    val diskFiles = context.getDir(DIRECTORY, Context.MODE_PRIVATE).listFiles() ?: emptyArray()
+
+    val batch: List<String> = diskFiles
+      .asSequence()
+      .filter { file -> !PartFileProtector.isProtected(file) }
+      .map { file -> file.absolutePath }
+      .filter { path -> afterPath == null || path > afterPath }
+      .sorted()
+      .take(batchSize)
+      .toList()
+
+    if (batch.isEmpty()) {
+      return OrphanedAttachmentFileScanResult(deletedCount = 0, lastScannedPath = null, isComplete = true)
+    }
+
+    val referencedFiles = getAllReferencedFilePaths()
+    var deletedCount = 0
+
+    for (filePath in batch) {
+      if (filePath !in referencedFiles) {
+        if (File(filePath).delete()) {
+          deletedCount++
+        } else {
+          Log.w(TAG, "[deleteOrphanedAttachmentFileBatch] Failed to delete orphaned file. $filePath")
+        }
+      }
+    }
+
+    return OrphanedAttachmentFileScanResult(
+      deletedCount = deletedCount,
+      lastScannedPath = batch.last(),
+      isComplete = batch.size < batchSize
+    )
+  }
+
+  data class OrphanedAttachmentFileScanResult(
+    val deletedCount: Int,
+    val lastScannedPath: String?,
+    val isComplete: Boolean
+  )
