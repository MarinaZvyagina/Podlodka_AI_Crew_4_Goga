+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.jobs
+
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.JsonJobData
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * Reconciles the thumbnail/attachment cache directory against the database and deletes whatever files no
+ * longer belong to an existing attachment, message, or sticker.
+ *
+ * Thumbnails and full attachment files live side by side on disk with no way to tell them apart once their
+ * owning attachment row is gone, so this walks the whole directory the same way [DeleteAbandonedAttachmentsJob]
+ * does. What's different here is that it's meant to run unattended on a routine cadence rather than in
+ * response to a specific user action:
+ * - It only checks a small batch of files per run (see [FILES_PER_BATCH]) and re-enqueues itself via
+ *   [Job.Result.retry] until the whole directory has been checked, so a single pass never blocks the job
+ *   queue for long.
+ * - It requires [NotInCallConstraint] and [BatteryNotLowConstraint] so it never competes with an active call
+ *   or drains a device that's already critically low on battery.
+ * - Its progress (the last file path it finished checking) is serialized with the job, so if the process is
+ *   killed partway through a pass, the next attempt resumes right after that path instead of rescanning the
+ *   whole directory or losing track of the pass entirely.
+ */
+class ThumbnailCacheCleanupJob private constructor(
+  parameters: Parameters,
+  private var lastCheckedPath: String?
+) : Job(parameters) {
+
+  companion object {
+    private val TAG = Log.tag(ThumbnailCacheCleanupJob::class.java)
+    const val KEY = "ThumbnailCacheCleanupJob"
+
+    private const val KEY_LAST_CHECKED_PATH = "last_checked_path"
+    private const val FILES_PER_BATCH = 200
+    private val RETRY_BACKOFF = 5.seconds.inWholeMilliseconds
+
+    @JvmStatic
+    fun enqueue() {
+      AppDependencies.jobManager.add(ThumbnailCacheCleanupJob())
+    }
+  }
+
+  constructor() : this(
+    parameters = Parameters.Builder()
+      .setMaxInstancesForFactory(1)
+      .setLifespan(Parameters.IMMORTAL)
+      .setMaxAttempts(Parameters.UNLIMITED)
+      .addConstraint(NotInCallConstraint.KEY)
+      .addConstraint(BatteryNotLowConstraint.KEY)
+      .build(),
+    lastCheckedPath = null
+  )
+
+  override fun serialize(): ByteArray? {
+    return JsonJobData.Builder()
+      .putString(KEY_LAST_CHECKED_PATH, lastCheckedPath)
+      .build()
+      .serialize()
+  }
+
+  override fun getFactoryKey(): String = KEY
+
+  override fun onFailure() = Unit
+
+  override fun run(): Result {
+    val allPaths = SignalDatabase.attachments.getAttachmentDirectoryFilesSorted()
+
+    val checkedPath = lastCheckedPath
+    val startIndex = if (checkedPath == null) {
+      0
+    } else {
+      // allPaths is sorted, so binarySearch gives us the resume point in O(log n): right after
+      // checkedPath if it's still present, or the first path greater than it otherwise.
+      val index = allPaths.binarySearch(checkedPath)
+      if (index >= 0) index + 1 else -(index + 1)
+    }
+
+    if (startIndex >= allPaths.size) {
+      Log.i(TAG, "Finished a thumbnail cache cleanup pass. Nothing left to check.")
+      return Result.success()
+    }
+
+    val batch = allPaths.subList(startIndex, minOf(startIndex + FILES_PER_BATCH, allPaths.size))
+    val deleted = SignalDatabase.attachments.deleteFilesNotReferenced(batch)
+
+    Log.i(TAG, "Checked ${batch.size} files, deleted $deleted orphaned files.")
+
+    lastCheckedPath = batch.last()
+
+    return if (startIndex + batch.size < allPaths.size) {
+      Result.retry(RETRY_BACKOFF)
+    } else {
+      Log.i(TAG, "Finished a thumbnail cache cleanup pass.")
+      Result.success()
+    }
+  }
+
+  class Factory : Job.Factory<ThumbnailCacheCleanupJob> {
+    override fun create(parameters: Parameters, serializedData: ByteArray?): ThumbnailCacheCleanupJob {
+      val data = JsonJobData.deserialize(serializedData)
+      return ThumbnailCacheCleanupJob(parameters, data.getStringOrDefault(KEY_LAST_CHECKED_PATH, null))
+    }
+  }
+}
