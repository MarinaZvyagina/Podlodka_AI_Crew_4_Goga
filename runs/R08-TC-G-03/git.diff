+  /**
+   * Lists every file currently sitting in the attachment/thumbnail directory (minus ones protected because
+   * they're mid-write), sorted so a caller can page through them in fixed-size batches and resume from an
+   * exact path if interrupted partway through, rather than re-scanning from the start or losing its place.
+   */
+  fun getAttachmentDirectoryFilesSorted(): List<String> {
+    val diskFiles = context.getDir(DIRECTORY, Context.MODE_PRIVATE).listFiles() ?: return emptyList()
+
+    return diskFiles
+      .filter { file: File -> !PartFileProtector.isProtected(file) }
+      .map { file: File -> file.absolutePath }
+      .sorted()
+  }
+
+  /**
+   * Deletes whichever of [candidatePaths] are no longer referenced by any attachment or sticker. Meant to be
+   * called with small batches of [getAttachmentDirectoryFilesSorted] so a full reconciliation pass can be
+   * spread across many job runs instead of doing it all at once. Returns the number of files deleted.
+   */
+  fun deleteFilesNotReferenced(candidatePaths: List<String>): Int {
+    if (candidatePaths.isEmpty()) {
+      return 0
+    }
+
+    val referenced: MutableSet<String> = HashSet(candidatePaths.size)
+
+    readableDatabase.withinTransaction { db ->
+      SqlUtil.buildCollectionQuery(DATA_FILE, candidatePaths).forEach { query ->
+        db.select(DATA_FILE).from(TABLE_NAME).where(query.where, query.whereArgs).run()
+          .forEach { cursor -> cursor.requireString(DATA_FILE)?.let { referenced += it } }
+      }
+      SqlUtil.buildCollectionQuery(THUMBNAIL_FILE, candidatePaths).forEach { query ->
+        db.select(THUMBNAIL_FILE).from(TABLE_NAME).where(query.where, query.whereArgs).run()
+          .forEach { cursor -> cursor.requireString(THUMBNAIL_FILE)?.let { referenced += it } }
+      }
+    }
+
+    val stickerFiles = SignalDatabase.stickers.getAllStickerFiles()
+    referenced += candidatePaths.filter { it in stickerFiles }
+
+    var deletedCount = 0
+    for (path in candidatePaths) {
+      if (path !in referenced) {
+        if (File(path).delete()) {
+          deletedCount++
+        } else {
+          Log.w(TAG, "[deleteFilesNotReferenced] Failed to delete file. $path")
+        }
+      }
+    }
+
+    return deletedCount
+  }
