+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.jobs
+
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.SignalDatabase.Companion.attachments
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+import java.io.File
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * Periodically scans for attachment/thumbnail files on disk (e.g. cached photo and video previews) that no longer
+ * correspond to any attachment or message in the database, and deletes them.
+ *
+ * There can be a large number of files to check on a device that's been in use for a long time, so this only
+ * deletes one batch of orphaned files per run. If there's more work left to do, it retries itself. Because
+ * re-running simply recomputes the orphan set (and already-deleted files naturally drop out of it), this makes
+ * forward progress no matter where a previous, interrupted attempt left off - there's no separate cursor to
+ * track or lose.
+ */
+class RoutineOrphanedAttachmentCleanupJob private constructor(parameters: Parameters) : Job(parameters) {
+
+  companion object {
+    private val TAG = Log.tag(RoutineOrphanedAttachmentCleanupJob::class)
+    const val KEY = "RoutineOrphanedAttachmentCleanupJob"
+
+    private const val BATCH_SIZE = 500
+  }
+
+  constructor() : this(
+    Parameters.Builder()
+      .setMaxInstancesForFactory(1)
+      .setMaxAttempts(Parameters.UNLIMITED)
+      .addConstraint(NotInCallConstraint.KEY)
+      .addConstraint(BatteryNotLowConstraint.KEY)
+      .build()
+  )
+
+  override fun serialize(): ByteArray? = null
+  override fun getFactoryKey(): String = KEY
+  override fun onFailure() = Unit
+
+  override fun run(): Result {
+    val orphaned = attachments.getOrphanedAttachmentFilePaths()
+
+    if (orphaned.isEmpty()) {
+      Log.i(TAG, "No orphaned thumbnail/attachment files found.")
+      return Result.success()
+    }
+
+    val batch = orphaned.take(BATCH_SIZE)
+    var deleted = 0
+
+    for (filePath in batch) {
+      if (File(filePath).delete()) {
+        deleted++
+      } else {
+        Log.w(TAG, "Failed to delete orphaned thumbnail/attachment file.")
+      }
+    }
+
+    Log.i(TAG, "Deleted $deleted/${batch.size} orphaned thumbnail/attachment files this pass. ${orphaned.size - batch.size} remaining.")
+
+    return if (orphaned.size > batch.size) {
+      Result.retry(1.seconds.inWholeMilliseconds)
+    } else {
+      Result.success()
+    }
+  }
+
+  class Factory : Job.Factory<RoutineOrphanedAttachmentCleanupJob> {
+    override fun create(parameters: Parameters, serializedData: ByteArray?): RoutineOrphanedAttachmentCleanupJob {
+      return RoutineOrphanedAttachmentCleanupJob(parameters)
+    }
+  }
+}
