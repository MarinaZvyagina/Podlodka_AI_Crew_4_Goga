diff --git a/app/src/main/java/org/thoughtcrime/securesms/jobs/ThumbnailCleanupJob.kt b/app/src/main/java/org/thoughtcrime/securesms/jobs/ThumbnailCleanupJob.kt
new file mode 100644
index 0000000..94dcc9f
--- /dev/null
+++ b/app/src/main/java/org/thoughtcrime/securesms/jobs/ThumbnailCleanupJob.kt
@@ -0,0 +1,97 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.jobs
+
+import org.signal.core.util.logging.Log
+import org.signal.core.util.nullIfBlank
+import org.thoughtcrime.securesms.database.SignalDatabase.Companion.attachments
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+import org.thoughtcrime.securesms.jobs.protos.ThumbnailCleanupJobData
+import org.thoughtcrime.securesms.keyvalue.SignalStore
+import kotlin.time.Duration.Companion.days
+
+/**
+ * Backstop that periodically sweeps the attachment directory for thumbnail/preview cache files that no longer correspond to any attachment or
+ * message still in the app (e.g. because the attachment or its message was deleted), deleting them to reclaim disk space.
+ *
+ * The directory can be large on a long-lived device, so each run only processes a bounded batch and checkpoints a cursor, rescheduling itself via
+ * [Result.retry] until the whole directory has been swept. Since the cursor is persisted with the job (see [serialize]), a pass that gets killed
+ * partway through (which routinely happens on Android) resumes from the last checkpoint on its next attempt instead of restarting from scratch or
+ * never finishing.
+ */
+class ThumbnailCleanupJob private constructor(
+  private var cursor: String?,
+  parameters: Parameters
+) : Job(parameters) {
+
+  companion object {
+    private val TAG = Log.tag(ThumbnailCleanupJob::class)
+    const val KEY = "ThumbnailCleanupJob"
+
+    private val SCAN_INTERVAL = 3.days
+    private const val BATCH_SIZE = 500
+
+    /**
+     * Enqueues a sweep if we haven't completed one recently. Safe to call frequently (e.g. every app foreground) since it self-throttles.
+     */
+    @JvmStatic
+    fun enqueueIfNecessary() {
+      val timeSinceLastRun = System.currentTimeMillis() - SignalStore.misc.lastThumbnailCleanupTime
+
+      if (timeSinceLastRun < SCAN_INTERVAL.inWholeMilliseconds) {
+        return
+      }
+
+      AppDependencies.jobManager.add(ThumbnailCleanupJob())
+    }
+  }
+
+  constructor() : this(
+    cursor = null,
+    parameters = Parameters.Builder()
+      .setQueue(KEY)
+      .addConstraint(NotInCallConstraint.KEY)
+      .addConstraint(BatteryNotLowConstraint.KEY)
+      .setGlobalPriority(Parameters.PRIORITY_LOWER)
+      .setMaxInstancesForFactory(1)
+      .setMaxAttempts(Parameters.UNLIMITED)
+      .setLifespan(Parameters.IMMORTAL)
+      .build()
+  )
+
+  override fun serialize(): ByteArray = ThumbnailCleanupJobData(cursor = cursor ?: "").encode()
+
+  override fun getFactoryKey(): String = KEY
+
+  override fun onFailure() = Unit
+
+  override fun run(): Result {
+    val batch = attachments.deleteAbandonedAttachmentFilesBatch(cursor, BATCH_SIZE)
+
+    if (batch.filesDeleted > 0) {
+      Log.i(TAG, "Deleted ${batch.filesDeleted} orphaned cache file(s) in this batch.")
+    }
+
+    if (!batch.isComplete) {
+      cursor = batch.nextCursor
+      return Result.retry(0)
+    }
+
+    Log.i(TAG, "Finished a full sweep of the attachment directory.")
+    SignalStore.misc.lastThumbnailCleanupTime = System.currentTimeMillis()
+    return Result.success()
+  }
+
+  class Factory : Job.Factory<ThumbnailCleanupJob> {
+    override fun create(parameters: Parameters, serializedData: ByteArray?): ThumbnailCleanupJob {
+      val data = serializedData?.let { ThumbnailCleanupJobData.ADAPTER.decode(it) }
+      return ThumbnailCleanupJob(cursor = data?.cursor?.nullIfBlank(), parameters = parameters)
+    }
+  }
+}
