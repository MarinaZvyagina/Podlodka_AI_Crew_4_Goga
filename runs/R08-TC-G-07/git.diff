   }
 
+  /**
+   * Pages through the attachment directory looking for files (attachment data files, and the thumbnail/preview cache files stored alongside them)
+   * that are no longer referenced by any attachment or sticker, deleting whichever of them it finds, and reports how far it got.
+   *
+   * Used by [org.thoughtcrime.securesms.jobs.ThumbnailCleanupJob] to sweep the whole directory in bounded batches instead of doing it all in one
+   * pass: each call only looks at files sorted after [afterFile], so if the caller checkpoints [AbandonedAttachmentFileScanResult.nextCursor]
+   * between calls, an interrupted sweep can pick back up where it left off rather than rescanning files it already handled.
+   */
+  fun deleteAbandonedAttachmentFilesBatch(afterFile: String?, limit: Int): AbandonedAttachmentFileScanResult {
+    val diskFiles = context.getDir(DIRECTORY, Context.MODE_PRIVATE).listFiles() ?: return AbandonedAttachmentFileScanResult(nextCursor = null, filesDeleted = 0)
+
+    val filtered: List<String> = diskFiles
+      .map { file: File -> file.absolutePath }
+      .filter { afterFile == null || it > afterFile }
+      .sorted()
+
+    val candidates: List<String> = filtered.take(limit)
+
+    if (candidates.isEmpty()) {
+      return AbandonedAttachmentFileScanResult(nextCursor = null, filesDeleted = 0)
+    }
+
+    val referenced: MutableSet<String> = HashSet()
+
+    readableDatabase.withinTransaction { db ->
+      for (query in SqlUtil.buildCollectionQuery(DATA_FILE, candidates)) {
+        db.select(DATA_FILE).from(TABLE_NAME).where(query.where, query.whereArgs).run().forEach { cursor ->
+          cursor.requireString(DATA_FILE)?.let { referenced += it }
+        }
+      }
+      for (query in SqlUtil.buildCollectionQuery(THUMBNAIL_FILE, candidates)) {
+        db.select(THUMBNAIL_FILE).from(TABLE_NAME).where(query.where, query.whereArgs).run().forEach { cursor ->
+          cursor.requireString(THUMBNAIL_FILE)?.let { referenced += it }
+        }
+      }
+    }
+
+    referenced += SignalDatabase.stickers.getAllStickerFiles().filter { it in candidates }
+
+    var filesDeleted = 0
+    for (path in candidates) {
+      if (path in referenced) {
+        continue
+      }
+
+      val file = File(path)
+      if (PartFileProtector.isProtected(file)) {
+        continue
+      }
+
+      if (file.delete()) {
+        filesDeleted++
+      } else {
+        Log.w(TAG, "[deleteAbandonedAttachmentFilesBatch] Failed to delete attachment file. $path")
+      }
+    }
+
+    val nextCursor = if (filtered.size > candidates.size) candidates.last() else null
+
+    return AbandonedAttachmentFileScanResult(nextCursor = nextCursor, filesDeleted = filesDeleted)
+  }
+
