@@ -0,0 +1,90 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.jobs
+
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.JsonJobData
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+import kotlin.time.Duration.Companion.days
+import kotlin.time.Duration.Companion.milliseconds
+
+/**
+ * Scans the attachment directory for thumbnail/data files that no longer correspond to any attachment still in the
+ * database (e.g. because the owning attachment or message was deleted) and deletes them.
+ *
+ * A device that's been used for a long time can have a large number of files to check, so this job processes them in
+ * bounded batches, retrying itself and persisting its place ([lastProcessedFile]) after each batch. If the job gets
+ * killed partway through a pass, the persisted cursor lets the next attempt resume where it left off instead of
+ * rescanning everything from the start or losing track of the remaining work.
+ */
+class ThumbnailCleanupJob private constructor(
+  parameters: Parameters,
+  private var lastProcessedFile: String?
+) : Job(parameters) {
+
+  companion object {
+    private val TAG = Log.tag(ThumbnailCleanupJob::class)
+
+    const val KEY = "ThumbnailCleanupJob"
+
+    private const val KEY_LAST_PROCESSED_FILE = "last_processed_file"
+    private const val BATCH_SIZE = 500
+    private val BATCH_DELAY = 250.milliseconds
+
+    @JvmStatic
+    fun enqueue() {
+      AppDependencies.jobManager.add(ThumbnailCleanupJob())
+    }
+  }
+
+  constructor() : this(
+    parameters = Parameters.Builder()
+      .setMaxInstancesForFactory(1)
+      .setLifespan(1.days.inWholeMilliseconds)
+      .setMaxAttempts(Parameters.UNLIMITED)
+      .setGlobalPriority(Parameters.PRIORITY_LOWER)
+      .addConstraint(NotInCallConstraint.KEY)
+      .addConstraint(BatteryNotLowConstraint.KEY)
+      .build(),
+    lastProcessedFile = null
+  )
+
+  override fun serialize(): ByteArray? = JsonJobData.Builder()
+    .putString(KEY_LAST_PROCESSED_FILE, lastProcessedFile)
+    .build()
+    .serialize()
+
+  override fun getFactoryKey(): String = KEY
+
+  override fun onFailure() = Unit
+
+  override fun run(): Result {
+    val batch = SignalDatabase.attachments.deleteAbandonedAttachmentFilesBatch(lastProcessedFile, BATCH_SIZE)
+
+    if (batch.deletedCount > 0) {
+      Log.i(TAG, "Deleted ${batch.deletedCount} abandoned attachment file(s) in this batch.")
+    }
+
+    if (batch.lastExaminedFile == null) {
+      Log.i(TAG, "Finished a full cleanup pass.")
+      return Result.success()
+    }
+
+    lastProcessedFile = batch.lastExaminedFile
+    return Result.retry(BATCH_DELAY.inWholeMilliseconds)
+  }
+
+  class Factory : Job.Factory<ThumbnailCleanupJob> {
+    override fun create(parameters: Parameters, serializedData: ByteArray?): ThumbnailCleanupJob {
+      val data = JsonJobData.deserialize(serializedData)
+      return ThumbnailCleanupJob(parameters, data.getStringOrDefault(KEY_LAST_PROCESSED_FILE, null))
+    }
+  }
+}
