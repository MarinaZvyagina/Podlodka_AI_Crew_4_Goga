diff --git a/app/src/main/java/org/thoughtcrime/securesms/service/ThumbnailCacheCleanupAlarmListener.kt b/app/src/main/java/org/thoughtcrime/securesms/service/ThumbnailCacheCleanupAlarmListener.kt
