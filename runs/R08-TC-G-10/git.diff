+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.jobs
+
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.SignalDatabase.Companion.attachments
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.JsonJobData
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+import kotlin.time.Duration.Companion.days
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * Sweeps the on-disk attachment/thumbnail cache for files that no longer correspond to any attachment (and
+ * therefore no message) in the database, and deletes them.
+ *
+ * Thumbnails are stored alongside full attachment data files in the same on-disk store (see
+ * [org.thoughtcrime.securesms.database.AttachmentTable]), so deleting a message or attachment can leave its
+ * cached thumbnail behind on disk with nothing left to reference it. This job finds and removes exactly those
+ * leftover files. It's scheduled to run periodically by [org.thoughtcrime.securesms.service.ThumbnailCacheCleanupAlarmListener].
+ *
+ * A device can accumulate a very large number of these files over time, so this job processes them in bounded
+ * batches, retrying itself via [Result.retry] until the whole store has been swept. Progress is persisted via
+ * [serialize], so if the process is killed mid-sweep, the next run resumes after the last file it processed
+ * instead of restarting the sweep from scratch or leaving it permanently unfinished.
+ */
+class DeleteOrphanedThumbnailCacheJob private constructor(
+  parameters: Parameters,
+  private var lastProcessedFileName: String?
+) : Job(parameters) {
+
+  companion object {
+    private val TAG = Log.tag(DeleteOrphanedThumbnailCacheJob::class)
+
+    const val KEY = "DeleteOrphanedThumbnailCacheJob"
+
+    private const val KEY_LAST_PROCESSED_FILE_NAME = "last_processed_file_name"
+    private const val BATCH_SIZE = 500
+
+    @JvmStatic
+    fun enqueue() {
+      AppDependencies.jobManager.add(DeleteOrphanedThumbnailCacheJob())
+    }
+  }
+
+  constructor() : this(
+    parameters = Parameters.Builder()
+      .setMaxInstancesForFactory(1)
+      .setMaxAttempts(Parameters.UNLIMITED)
+      .setLifespan(1.days.inWholeMilliseconds)
+      .addConstraint(NotInCallConstraint.KEY)
+      .addConstraint(BatteryNotLowConstraint.KEY)
+      .build(),
+    lastProcessedFileName = null
+  )
+
+  override fun serialize(): ByteArray? {
+    return JsonJobData.Builder()
+      .putString(KEY_LAST_PROCESSED_FILE_NAME, lastProcessedFileName)
+      .build()
+      .serialize()
+  }
+
+  override fun getFactoryKey(): String = KEY
+
+  override fun onFailure() = Unit
+
+  override fun run(): Result {
+    val batchResult = attachments.deleteAbandonedAttachmentFilesBatch(batchSize = BATCH_SIZE, afterFileName = lastProcessedFileName)
+
+    if (batchResult.deletedCount > 0) {
+      Log.i(TAG, "Deleted ${batchResult.deletedCount} orphaned thumbnail cache file(s).")
+    }
+
+    if (batchResult.isComplete) {
+      Log.i(TAG, "Finished sweeping the thumbnail cache.")
+      return Result.success()
+    }
+
+    lastProcessedFileName = batchResult.lastFileNameProcessed
+    return Result.retry(1.seconds.inWholeMilliseconds)
+  }
+
+  class Factory : Job.Factory<DeleteOrphanedThumbnailCacheJob> {
+    override fun create(parameters: Parameters, serializedData: ByteArray?): DeleteOrphanedThumbnailCacheJob {
+      val data = JsonJobData.deserialize(serializedData)
+      return DeleteOrphanedThumbnailCacheJob(parameters, data.getStringOrDefault(KEY_LAST_PROCESSED_FILE_NAME, null))
+    }
+  }
+}
