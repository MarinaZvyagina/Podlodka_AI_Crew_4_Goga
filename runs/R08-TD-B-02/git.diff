+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import android.app.Application
+import assertk.assertThat
+import assertk.assertions.hasSize
+import assertk.assertions.isNotSameInstanceAs
+import assertk.assertions.isSameInstanceAs
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.thoughtcrime.securesms.testutil.RecipientTestRule
+
+/**
+ * Verifies that repeating an identical chat-list search hits an in-memory cache instead of
+ * re-scanning the database, and that the cache never serves results that predate a call to
+ * [SearchRepository.invalidateCache] -- the hook the real app wires up to database change
+ * notifications (see [SearchRepository.ensureCacheInvalidationRegistered] in production code).
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class SearchRepositoryCacheTest {
+
+  @get:Rule
+  val recipients = RecipientTestRule()
+
+  @Before
+  fun setUp() {
+    SearchRepository.invalidateCache()
+  }
+
+  @Test
+  fun `repeating an identical thread search returns the cached result`() {
+    val alice = recipients.createRecipient("Alice Wonderland")
+    recipients.insertOutgoingMessage(alice)
+
+    val repository = SearchRepository("Note to Self")
+
+    val first = repository.queryThreadsSync("Alice", false)
+    val second = repository.queryThreadsSync("Alice", false)
+
+    assertThat(second).isSameInstanceAs(first)
+  }
+
+  @Test
+  fun `a different query is not served from another query's cache entry`() {
+    val alice = recipients.createRecipient("Alice Wonderland")
+    recipients.insertOutgoingMessage(alice)
+    val bob = recipients.createRecipient("Bob Builder")
+    recipients.insertOutgoingMessage(bob)
+
+    val repository = SearchRepository("Note to Self")
+
+    val aliceResult = repository.queryThreadsSync("Alice", false)
+    val bobResult = repository.queryThreadsSync("Bob", false)
+
+    assertThat(bobResult).isNotSameInstanceAs(aliceResult)
+    assertThat(aliceResult.results).hasSize(1)
+    assertThat(bobResult.results).hasSize(1)
+  }
+
+  @Test
+  fun `a new matching conversation is reflected after cache invalidation`() {
+    val alice = recipients.createRecipient("Alice Wonderland")
+    recipients.insertOutgoingMessage(alice)
+
+    val repository = SearchRepository("Note to Self")
+
+    val before = repository.queryThreadsSync("Ali", false)
+    assertThat(before.results).hasSize(1)
+
+    val alina = recipients.createRecipient("Alina Baker")
+    recipients.insertOutgoingMessage(alina)
+    SearchRepository.invalidateCache()
+
+    val after = repository.queryThreadsSync("Ali", false)
+    assertThat(after.results).hasSize(2)
+  }
+}
