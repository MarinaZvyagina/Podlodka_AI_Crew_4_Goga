@@ -0,0 +1,102 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import assertk.assertThat
+import assertk.assertions.isEqualTo
+import assertk.assertions.isNotNull
+import assertk.assertions.isNull
+import assertk.assertions.isSameAs
+import org.junit.After
+import org.junit.Test
+
+class SearchResultCacheTest {
+
+  @After
+  fun tearDown() {
+    SearchResultCache.clear()
+  }
+
+  @Test
+  fun `returns null when nothing cached yet`() {
+    assertThat(SearchResultCache.getMessages("hello", SearchFilter.EMPTY)).isNull()
+    assertThat(SearchResultCache.getThreads("hello", unreadOnly = false)).isNull()
+  }
+
+  @Test
+  fun `returns the same instance that was cached for an identical query and filter`() {
+    val result = MessageSearchResult(emptyList(), "hello")
+
+    SearchResultCache.putMessages("hello", SearchFilter.EMPTY, result)
+
+    assertThat(SearchResultCache.getMessages("hello", SearchFilter.EMPTY)).isSameAs(result)
+  }
+
+  @Test
+  fun `different query text is cached independently`() {
+    val helloResult = MessageSearchResult(emptyList(), "hello")
+    val worldResult = MessageSearchResult(emptyList(), "world")
+
+    SearchResultCache.putMessages("hello", SearchFilter.EMPTY, helloResult)
+    SearchResultCache.putMessages("world", SearchFilter.EMPTY, worldResult)
+
+    assertThat(SearchResultCache.getMessages("hello", SearchFilter.EMPTY)).isSameAs(helloResult)
+    assertThat(SearchResultCache.getMessages("world", SearchFilter.EMPTY)).isSameAs(worldResult)
+  }
+
+  @Test
+  fun `different filters for the same query text are cached independently`() {
+    val unfiltered = MessageSearchResult(emptyList(), "hello")
+    val filtered = MessageSearchResult(emptyList(), "hello")
+    val dateFilter = SearchFilter(startDate = 100L)
+
+    SearchResultCache.putMessages("hello", SearchFilter.EMPTY, unfiltered)
+    SearchResultCache.putMessages("hello", dateFilter, filtered)
+
+    assertThat(SearchResultCache.getMessages("hello", SearchFilter.EMPTY)).isSameAs(unfiltered)
+    assertThat(SearchResultCache.getMessages("hello", dateFilter)).isSameAs(filtered)
+  }
+
+  @Test
+  fun `unread-only is a distinct cache key from thread search`() {
+    val allThreads = ThreadSearchResult(emptyList(), "hello")
+    val unreadThreads = ThreadSearchResult(emptyList(), "hello")
+
+    SearchResultCache.putThreads("hello", unreadOnly = false, result = allThreads)
+    SearchResultCache.putThreads("hello", unreadOnly = true, result = unreadThreads)
+
+    assertThat(SearchResultCache.getThreads("hello", unreadOnly = false)).isSameAs(allThreads)
+    assertThat(SearchResultCache.getThreads("hello", unreadOnly = true)).isSameAs(unreadThreads)
+  }
+
+  @Test
+  fun `clear discards all cached entries`() {
+    SearchResultCache.putMessages("hello", SearchFilter.EMPTY, MessageSearchResult(emptyList(), "hello"))
+    SearchResultCache.putThreads("hello", unreadOnly = false, result = ThreadSearchResult(emptyList(), "hello"))
+
+    SearchResultCache.clear()
+
+    assertThat(SearchResultCache.getMessages("hello", SearchFilter.EMPTY)).isNull()
+    assertThat(SearchResultCache.getThreads("hello", unreadOnly = false)).isNull()
+  }
+
+  @Test
+  fun `evicts the least recently used entry once past capacity`() {
+    repeat(20) { i ->
+      SearchResultCache.putMessages("query$i", SearchFilter.EMPTY, MessageSearchResult(emptyList(), "query$i"))
+    }
+
+    // Touch query0 so it's no longer the least-recently-used entry.
+    SearchResultCache.getMessages("query0", SearchFilter.EMPTY)
+
+    // Adding one more entry should evict query1 (now the least-recently-used), not query0.
+    SearchResultCache.putMessages("query20", SearchFilter.EMPTY, MessageSearchResult(emptyList(), "query20"))
+
+    assertThat(SearchResultCache.getMessages("query0", SearchFilter.EMPTY)).isNotNull()
+    assertThat(SearchResultCache.getMessages("query1", SearchFilter.EMPTY)).isNull()
+    assertThat(SearchResultCache.getMessages("query20", SearchFilter.EMPTY)?.query).isEqualTo("query20")
+  }
+}
