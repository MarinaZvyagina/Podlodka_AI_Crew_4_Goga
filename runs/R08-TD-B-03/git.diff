diff --git a/app/src/main/java/org/thoughtcrime/securesms/search/SearchResultCache.kt b/app/src/main/java/org/thoughtcrime/securesms/search/SearchResultCache.kt
new file mode 100644
index 0000000..6ae7dd9
--- /dev/null
+++ b/app/src/main/java/org/thoughtcrime/securesms/search/SearchResultCache.kt
@@ -0,0 +1,72 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+package org.thoughtcrime.securesms.search
+
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+
+/**
+ * Caches chat list search results (conversations and messages), keyed by the exact query text
+ * and filters used to produce them, so that repeating an identical search can skip re-scanning
+ * the database.
+ *
+ * The cache never returns stale data because [clear] is wired up (via [registerForInvalidation])
+ * to fire on every conversation-list-affecting database change, which covers all of the tables
+ * search reads from (messages, threads, recipients, groups).
+ */
+object SearchResultCache {
+
+  private const val MAX_ENTRIES = 20
+
+  private data class ThreadCacheKey(val query: String, val unreadOnly: Boolean)
+  private data class MessageCacheKey(val query: String, val filter: SearchFilter)
+
+  private val threadResults: MutableMap<ThreadCacheKey, ThreadSearchResult> = boundedLruMap()
+  private val messageResults: MutableMap<MessageCacheKey, MessageSearchResult> = boundedLruMap()
+
+  private var invalidationRegistered = false
+
+  @Synchronized
+  fun getThreads(query: String, unreadOnly: Boolean): ThreadSearchResult? {
+    return threadResults[ThreadCacheKey(query, unreadOnly)]
+  }
+
+  @Synchronized
+  fun putThreads(query: String, unreadOnly: Boolean, result: ThreadSearchResult) {
+    threadResults[ThreadCacheKey(query, unreadOnly)] = result
+  }
+
+  @Synchronized
+  fun getMessages(query: String, filter: SearchFilter): MessageSearchResult? {
+    return messageResults[MessageCacheKey(query, filter)]
+  }
+
+  @Synchronized
+  fun putMessages(query: String, filter: SearchFilter, result: MessageSearchResult) {
+    messageResults[MessageCacheKey(query, filter)] = result
+  }
+
+  /** Discards all cached results. */
+  @Synchronized
+  fun clear() {
+    threadResults.clear()
+    messageResults.clear()
+  }
+
+  /** Idempotent: ensures [clear] runs on every conversation-list-affecting database change. */
+  @Synchronized
+  fun registerForInvalidation() {
+    if (invalidationRegistered) {
+      return
+    }
+    invalidationRegistered = true
+    AppDependencies.databaseObserver.registerConversationListObserver { clear() }
+  }
+
+  private fun <K, V> boundedLruMap(): MutableMap<K, V> {
+    return object : LinkedHashMap<K, V>(16, 0.75f, true) {
+      override fun removeEldestEntry(eldest: MutableMap.MutableEntry<K, V>): Boolean = size > MAX_ENTRIES
+    }
+  }
+}
diff --git a/app/src/test/java/org/thoughtcrime/securesms/search/SearchResultCacheTest.kt b/app/src/test/java/org/thoughtcrime/securesms/search/SearchResultCacheTest.kt
