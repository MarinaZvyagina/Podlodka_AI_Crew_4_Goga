+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import android.app.Application
+import assertk.assertThat
+import assertk.assertions.isNull
+import assertk.assertions.isSameInstanceAs
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.thoughtcrime.securesms.database.model.ThreadWithRecipient
+import org.thoughtcrime.securesms.testutil.MockAppDependenciesRule
+
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class SearchResultCacheTest {
+
+  @get:Rule
+  val appDependencies = MockAppDependenciesRule()
+
+  @Before
+  fun setUp() {
+    SearchResultCache.clear()
+  }
+
+  @Test
+  fun `thread cache hit returns the same instance that was stored`() {
+    val result = ThreadSearchResult(emptyList<ThreadWithRecipient>(), "alice")
+
+    SearchResultCache.putThreads("alice", false, result)
+
+    assertThat(SearchResultCache.getThreads("alice", false)).isSameInstanceAs(result)
+  }
+
+  @Test
+  fun `thread cache miss for a different query`() {
+    SearchResultCache.putThreads("alice", false, ThreadSearchResult(emptyList<ThreadWithRecipient>(), "alice"))
+
+    assertThat(SearchResultCache.getThreads("bob", false)).isNull()
+  }
+
+  @Test
+  fun `thread cache miss for the same query with a different filter value`() {
+    SearchResultCache.putThreads("alice", false, ThreadSearchResult(emptyList<ThreadWithRecipient>(), "alice"))
+
+    assertThat(SearchResultCache.getThreads("alice", true)).isNull()
+  }
+
+  @Test
+  fun `message cache hit returns the same instance that was stored`() {
+    val result = MessageSearchResult(emptyList(), "alice")
+
+    SearchResultCache.putMessages("alice", SearchFilter.EMPTY, result)
+
+    assertThat(SearchResultCache.getMessages("alice", SearchFilter.EMPTY)).isSameInstanceAs(result)
+  }
+
+  @Test
+  fun `message cache miss for the same query with a different filter`() {
+    SearchResultCache.putMessages("alice", SearchFilter.EMPTY, MessageSearchResult(emptyList(), "alice"))
+
+    val differentFilter = SearchFilter(startDate = 100L)
+
+    assertThat(SearchResultCache.getMessages("alice", differentFilter)).isNull()
+  }
+
+  @Test
+  fun `thread and message caches are independent`() {
+    SearchResultCache.putThreads("alice", false, ThreadSearchResult(emptyList<ThreadWithRecipient>(), "alice"))
+
+    assertThat(SearchResultCache.getMessages("alice", SearchFilter.EMPTY)).isNull()
+  }
+
+  @Test
+  fun `clear removes all cached entries`() {
+    SearchResultCache.putThreads("alice", false, ThreadSearchResult(emptyList<ThreadWithRecipient>(), "alice"))
+    SearchResultCache.putMessages("alice", SearchFilter.EMPTY, MessageSearchResult(emptyList(), "alice"))
+
+    SearchResultCache.clear()
+
+    assertThat(SearchResultCache.getThreads("alice", false)).isNull()
+    assertThat(SearchResultCache.getMessages("alice", SearchFilter.EMPTY)).isNull()
+  }
+}
