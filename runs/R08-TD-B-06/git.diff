+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import androidx.annotation.VisibleForTesting
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+
+/**
+ * Caches chat list search results so that repeating an identical search (same query text and
+ * filters) can skip re-querying the database.
+ *
+ * The cache is invalidated in bulk whenever anything that could affect search results changes --
+ * new/edited/deleted messages, renamed contacts or groups, etc. -- by piggybacking on the
+ * conversation list observer, which already fires for all of those cases.
+ */
+object SearchResultCache {
+
+  private const val MAX_ENTRIES = 20
+
+  private val threadResults: LinkedHashMap<ThreadKey, ThreadSearchResult> = lruMap()
+  private val messageResults: LinkedHashMap<MessageKey, MessageSearchResult> = lruMap()
+
+  init {
+    AppDependencies.databaseObserver.registerConversationListObserver { clear() }
+  }
+
+  @JvmStatic
+  fun getThreads(query: String, unreadOnly: Boolean): ThreadSearchResult? {
+    return synchronized(threadResults) { threadResults[ThreadKey(query, unreadOnly)] }
+  }
+
+  @JvmStatic
+  fun putThreads(query: String, unreadOnly: Boolean, result: ThreadSearchResult) {
+    synchronized(threadResults) { threadResults[ThreadKey(query, unreadOnly)] = result }
+  }
+
+  @JvmStatic
+  fun getMessages(query: String, filter: SearchFilter): MessageSearchResult? {
+    return synchronized(messageResults) { messageResults[MessageKey(query, filter)] }
+  }
+
+  @JvmStatic
+  fun putMessages(query: String, filter: SearchFilter, result: MessageSearchResult) {
+    synchronized(messageResults) { messageResults[MessageKey(query, filter)] = result }
+  }
+
+  @VisibleForTesting
+  @JvmStatic
+  fun clear() {
+    synchronized(threadResults) { threadResults.clear() }
+    synchronized(messageResults) { messageResults.clear() }
+  }
+
+  private fun <K, V> lruMap(): LinkedHashMap<K, V> {
+    return object : LinkedHashMap<K, V>(16, 0.75f, true) {
+      override fun removeEldestEntry(eldest: MutableMap.MutableEntry<K, V>): Boolean {
+        return size > MAX_ENTRIES
+      }
+    }
+  }
+
+  private data class ThreadKey(val query: String, val unreadOnly: Boolean)
+  private data class MessageKey(val query: String, val filter: SearchFilter)
+}
