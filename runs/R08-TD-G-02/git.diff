+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import assertk.assertThat
+import assertk.assertions.isEqualTo
+import org.junit.Test
+
+class SearchResultCacheTest {
+
+  @Test
+  fun getOrComputeOnlyComputesOnceForTheSameKey() {
+    val cache = SearchResultCache<String, Int>()
+    var computeCount = 0
+
+    val first = cache.getOrCompute("hello") { computeCount++; 1 }
+    val second = cache.getOrCompute("hello") { computeCount++; 2 }
+
+    assertThat(first).isEqualTo(1)
+    assertThat(second).isEqualTo(1)
+    assertThat(computeCount).isEqualTo(1)
+  }
+
+  @Test
+  fun getOrComputeTreatsDifferentKeysIndependently() {
+    val cache = SearchResultCache<String, Int>()
+    var computeCount = 0
+
+    val hello = cache.getOrCompute("hello") { computeCount++; 1 }
+    val world = cache.getOrCompute("world") { computeCount++; 2 }
+
+    assertThat(hello).isEqualTo(1)
+    assertThat(world).isEqualTo(2)
+    assertThat(computeCount).isEqualTo(2)
+  }
+
+  @Test
+  fun invalidateClearsEveryEntrySoTheNextGetRecomputes() {
+    val cache = SearchResultCache<String, Int>()
+    var computeCount = 0
+
+    cache.getOrCompute("hello") { computeCount++; 1 }
+    cache.invalidate()
+    val afterInvalidate = cache.getOrCompute("hello") { computeCount++; 2 }
+
+    assertThat(afterInvalidate).isEqualTo(2)
+    assertThat(computeCount).isEqualTo(2)
+  }
+
+  @Test
+  fun threadSearchCacheKeyDistinguishesUnreadOnly() {
+    val cache = SearchResultCache<ThreadSearchCacheKey, Int>()
+    var computeCount = 0
+
+    val allChats = cache.getOrCompute(ThreadSearchCacheKey("hello", unreadOnly = false)) { computeCount++; 1 }
+    val unreadOnly = cache.getOrCompute(ThreadSearchCacheKey("hello", unreadOnly = true)) { computeCount++; 2 }
+
+    assertThat(allChats).isEqualTo(1)
+    assertThat(unreadOnly).isEqualTo(2)
+    assertThat(computeCount).isEqualTo(2)
+  }
+
+  @Test
+  fun messageSearchCacheKeyDistinguishesFilter() {
+    val cache = SearchResultCache<MessageSearchCacheKey, Int>()
+    var computeCount = 0
+
+    val unfiltered = cache.getOrCompute(MessageSearchCacheKey("hello", SearchFilter.EMPTY)) { computeCount++; 1 }
+    val filtered = cache.getOrCompute(MessageSearchCacheKey("hello", SearchFilter(startDate = 1L))) { computeCount++; 2 }
+    val unfilteredAgain = cache.getOrCompute(MessageSearchCacheKey("hello", SearchFilter.EMPTY)) { computeCount++; 3 }
+
+    assertThat(unfiltered).isEqualTo(1)
+    assertThat(filtered).isEqualTo(2)
+    assertThat(unfilteredAgain).isEqualTo(1)
+    assertThat(computeCount).isEqualTo(2)
+  }
+}
