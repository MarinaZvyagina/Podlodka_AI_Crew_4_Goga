+++ b/app/src/main/java/org/thoughtcrime/securesms/search/SearchResultCache.kt
@@ -0,0 +1,49 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * A generic memoizing cache. There's no per-entry invalidation -- callers call [invalidate] to
+ * drop everything whenever anything that could affect any cached value changes, since a cached
+ * value alone can't tell whether a given change is relevant to it.
+ */
+class SearchResultCache<K : Any, V : Any> {
+  private val cache = ConcurrentHashMap<K, V>()
+
+  fun getOrCompute(key: K, compute: () -> V): V = cache.computeIfAbsent(key) { compute() }
+
+  fun invalidate() = cache.clear()
+}
+
+data class ThreadSearchCacheKey(val query: String, val unreadOnly: Boolean)
+data class MessageSearchCacheKey(val query: String, val filter: SearchFilter)
+
+/**
+ * Caches the results of [SearchRepository]'s chat-list search queries, so repeating an identical
+ * search (same text, same filters) is instant instead of re-scanning the database.
+ *
+ * Shared process-wide -- rather than owned per [SearchRepository] instance -- so it survives
+ * screens being torn down and recreated (every caller just constructs a new [SearchRepository]
+ * freely) and is only ever registered with [AppDependencies.databaseObserver] once.
+ *
+ * Invalidated wholesale on any conversation-list-relevant change (new/edited/deleted messages,
+ * renamed contacts or groups, etc.), since a cached result can't tell on its own whether a given
+ * change affects it.
+ */
+object ConversationSearchCache {
+  val threads = SearchResultCache<ThreadSearchCacheKey, ThreadSearchResult>()
+  val messages = SearchResultCache<MessageSearchCacheKey, MessageSearchResult>()
+
+  init {
+    AppDependencies.databaseObserver.registerConversationListObserver {
+      threads.invalidate()
+      messages.invalidate()
+    }
+  }
+}
