+package org.thoughtcrime.securesms.search
+
+import org.thoughtcrime.securesms.database.RxDatabaseObserver
+import java.util.concurrent.atomic.AtomicLong
+
+/**
+ * Tracks how many times conversation data (messages or threads) has changed, so [SearchResultCache]
+ * instances can tell a cached result apart from one computed against stale data with a single
+ * cheap comparison, instead of every cache having to register and unregister its own database
+ * observer.
+ *
+ * Subscribes once for the lifetime of the app -- there's nothing to unregister, since all this
+ * holds onto is a counter.
+ */
+object SearchInvalidationTracker {
+
+  private val version = AtomicLong(0)
+
+  init {
+    RxDatabaseObserver.conversationList.subscribe { version.incrementAndGet() }
+  }
+
+  val currentVersion: Long
+    get() = version.get()
+}
