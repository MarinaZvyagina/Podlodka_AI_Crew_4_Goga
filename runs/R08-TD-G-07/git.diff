index 0000000..7a2543c
--- /dev/null
+++ b/app/src/main/java/org/thoughtcrime/securesms/search/SearchResultCache.kt
@@ -0,0 +1,38 @@
+package org.thoughtcrime.securesms.search
+
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * Caches values by [K] until [currentVersion] reports that the underlying data has moved on.
+ *
+ * Each entry is stamped with the version it was computed under, so a data change doesn't need to
+ * reach in and clear the map -- a stale entry just fails its version check on the next [get] and
+ * is recomputed in place. Different keys are unaffected by each other; a version bump just means
+ * every key's next lookup recomputes once.
+ */
+class SearchResultCache<K : Any, V>(
+  private val currentVersion: () -> Long = { SearchInvalidationTracker.currentVersion }
+) {
+
+  private val entries = ConcurrentHashMap<K, Entry<V>>()
+
+  fun get(key: K, compute: () -> V): V {
+    val version = currentVersion()
+
+    entries[key]?.let { entry ->
+      if (entry.version == version) {
+        return entry.value
+      }
+    }
+
+    val value = compute()
+    entries[key] = Entry(value, version)
+    return value
+  }
+
+  private class Entry<V>(val value: V, val version: Long)
+}
+
+data class MessageSearchCacheKey(val query: String, val filter: SearchFilter)
+
+data class ThreadSearchCacheKey(val query: String, val unreadOnly: Boolean)
