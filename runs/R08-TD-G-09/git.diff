+  /**
+   * Looks up a cached value, treating it as a miss if it was computed before the last
+   * conversation-list-relevant database mutation (see {@link org.thoughtcrime.securesms.database.DatabaseObserver#getConversationListGeneration()}).
+   * This is how the cache stays correct without needing to register/unregister a listener for
+   * this repository's lifecycle: a search term is only ever served from cache while nothing that
+   * could affect its results has changed since it was computed.
+   */
+  private <K, V> @Nullable V getCached(@NonNull Map<K, CacheEntry<V>> cache, @NonNull Object lock, @NonNull K key) {
+    long generation = AppDependencies.getDatabaseObserver().getConversationListGeneration();
+    synchronized (lock) {
+      CacheEntry<V> entry = cache.get(key);
+      return (entry != null && entry.generation == generation) ? entry.value : null;
+    }
+  }
+
+  private <K, V> void putCached(@NonNull Map<K, CacheEntry<V>> cache, @NonNull Object lock, @NonNull K key, @NonNull V value) {
+    long generation = AppDependencies.getDatabaseObserver().getConversationListGeneration();
+    synchronized (lock) {
+      cache.put(key, new CacheEntry<>(generation, value));
+    }
+  }
+
+  private static class CacheEntry<V> {
+    private final long generation;
+    private final V    value;
+
+    private CacheEntry(long generation, @NonNull V value) {
+      this.generation = generation;
+      this.value      = value;
+    }
+  }
