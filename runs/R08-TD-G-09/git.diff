+
+package org.thoughtcrime.securesms.search
+
+import android.app.Application
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.mockkObject
+import io.mockk.unmockkAll
+import io.mockk.verify
+import org.junit.After
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.thoughtcrime.securesms.database.GroupTable
+import org.thoughtcrime.securesms.database.MentionTable
+import org.thoughtcrime.securesms.database.MessageTable
+import org.thoughtcrime.securesms.database.RecipientTable
+import org.thoughtcrime.securesms.database.SearchTable
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.database.ThreadTable
+import org.thoughtcrime.securesms.testutil.MockAppDependenciesRule
+
+/**
+ * Verifies that repeating an identical [SearchRepository.queryThreadsSync] call is served from
+ * an in-memory cache rather than hitting the database again, and that distinct queries don't
+ * collide with each other's cached results. Invalidation on database change is covered by
+ * [org.thoughtcrime.securesms.database.DatabaseObserverTest], since that's what the cache keys
+ * off of.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class SearchRepositoryCacheTest {
+
+  @get:Rule
+  val appDependencies = MockAppDependenciesRule()
+
+  private lateinit var threadTable: ThreadTable
+  private lateinit var repository: SearchRepository
+
+  @Before
+  fun setUp() {
+    threadTable = mockk(relaxed = true)
+
+    mockkObject(SignalDatabase)
+    every { SignalDatabase.threads } returns threadTable
+    every { SignalDatabase.recipients } returns mockk<RecipientTable>(relaxed = true)
+    every { SignalDatabase.groups } returns mockk<GroupTable> {
+      every { queryGroupsByTitle(any(), any(), any(), any()) } returns GroupTable.Reader(null)
+    }
+    every { SignalDatabase.mentions } returns mockk<MentionTable>(relaxed = true)
+    every { SignalDatabase.messages } returns mockk<MessageTable>(relaxed = true)
+    every { SignalDatabase.messageSearch } returns mockk<SearchTable>(relaxed = true)
+
+    every { threadTable.getFilteredConversationList(any(), any()) } returns null
+
+    repository = SearchRepository("Note to Self")
+  }
+
+  @After
+  fun tearDown() {
+    unmockkAll()
+  }
+
+  @Test
+  fun `repeated identical search is served from cache`() {
+    repository.queryThreadsSync("alice", false)
+    repository.queryThreadsSync("alice", false)
+    repository.queryThreadsSync("alice", false)
+
+    // queryConversations hits getFilteredConversationList twice per uncached call (once for
+    // contacts, once for groups-by-title), so three uncached calls would be six invocations.
+    verify(exactly = 2) { threadTable.getFilteredConversationList(any(), any()) }
+  }
+
+  @Test
+  fun `distinct queries are cached independently`() {
+    repository.queryThreadsSync("alice", false)
+    repository.queryThreadsSync("bob", false)
+    repository.queryThreadsSync("alice", false)
+    repository.queryThreadsSync("bob", false)
+
+    verify(exactly = 4) { threadTable.getFilteredConversationList(any(), any()) }
+  }
+
+  @Test
+  fun `same text with a different filter is cached independently`() {
+    repository.queryThreadsSync("alice", unreadOnly = false)
+    repository.queryThreadsSync("alice", unreadOnly = true)
+
+    verify(exactly = 4) { threadTable.getFilteredConversationList(any(), any()) }
+  }
+}
