+    // MARK: - Removing Data
+    @MainActor
+    func testRemoveWindowData_removesPrimaryAndBackupFiles() async throws {
+        let subject = createSubject()
+        let primaryURL = URL(string: "some/directory1/window-\(defaultTestTabWindowUUID.uuidString)")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.pathContents = [primaryURL]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        let expectedBackupURL = URL(string: "some/directory2/window-\(defaultTestTabWindowUUID.uuidString)")!
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(primaryURL))
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(expectedBackupURL))
+    }
+
+    @MainActor
+    func testRemoveWindowData_leavesUnrelatedWindowsUntouched() async throws {
+        let subject = createSubject()
+        let keptUUID = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        let removedURL = URL(string: "some/directory1/window-\(defaultTestTabWindowUUID.uuidString)")!
+        let keptURL = URL(string: "some/directory1/window-\(keptUUID.uuidString)")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.pathContents = [removedURL, keptURL]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertFalse(mockFileManager.removedFileURLs.contains(keptURL))
+        XCTAssertFalse(mockFileManager.removedFileURLs.contains(
+            URL(string: "some/directory2/window-\(keptUUID.uuidString)")!
+        ))
+    }
+
+    @MainActor
+    func testRemoveWindowData_noBackupDirectory_doesNotCrash() async throws {
+        let subject = createSubject()
+        let primaryURL = URL(string: "some/directory1/window-\(defaultTestTabWindowUUID.uuidString)")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.pathContents = [primaryURL]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 1)
