diff --git a/BrowserKit/Tests/TabDataStoreTests/TabDataStoreTests.swift b/BrowserKit/Tests/TabDataStoreTests/TabDataStoreTests.swift
index aa02381..3b75480 100644
--- a/BrowserKit/Tests/TabDataStoreTests/TabDataStoreTests.swift
+++ b/BrowserKit/Tests/TabDataStoreTests/TabDataStoreTests.swift
@@ -220,6 +220,49 @@ final class TabDataStoreTests: XCTestCase, @unchecked Sendable {
         XCTAssertEqual(mockFileManager.removeAllFilesAtCalledCount, 2)
     }
 
+    // MARK: - Removing Window Data
+    @MainActor
+    func testRemoveWindowData_removesPrimaryAndBackupFiles() async throws {
+        let subject = createSubject()
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.pathContents = [URL(string: "some/directory1/window-\(defaultTestTabWindowUUID.uuidString)")!]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+    }
+
+    @MainActor
+    func testRemoveWindowData_leavesUnrelatedWindowsUntouched() async throws {
+        let subject = createSubject()
+        let otherUUID = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.pathContents = [
+            URL(string: "some/directory1/window-\(defaultTestTabWindowUUID.uuidString)")!,
+            URL(string: "some/directory1/window-\(otherUUID.uuidString)")!
+        ]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        // Only the target window's primary and backup files should be removed
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+    }
+
+    @MainActor
+    func testRemoveWindowData_noBackupDirectory_doesNotError() async throws {
+        let subject = createSubject()
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = nil
+        mockFileManager.pathContents = [URL(string: "some/directory1/window-\(defaultTestTabWindowUUID.uuidString)")!]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        // No backup directory means only the primary file removal is attempted
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 1)
+    }
+
