+    // MARK: - Removing Window Data
+    @MainActor
+    func testRemoveWindowData_removesBothPrimaryAndBackupFiles() async throws {
+        let subject = createSubject()
+        let uuidToRemove = WindowUUID(uuidString: defaultTestTabWindowUUID.uuidString)!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/primary")
+        mockFileManager.backupDirectoryURL = URL(string: "some/backup")
+        mockFileManager.primaryPathContents = [URL(string: "some/primary/window-\(defaultTestTabWindowUUID.uuidString)")!]
+        mockFileManager.backupPathContents = [URL(string: "some/backup/window-\(defaultTestTabWindowUUID.uuidString)")!]
+
+        await subject.removeWindowData(forUUIDs: [uuidToRemove])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertEqual(mockFileManager.removedFileURLs.filter {
+            $0.lastPathComponent == "window-\(defaultTestTabWindowUUID.uuidString)"
+        }.count, 2)
+    }
+
+    @MainActor
+    func testRemoveWindowData_leavesFilesForOtherUUIDsUntouched() async throws {
+        let subject = createSubject()
+        let uuidToRemove = WindowUUID(uuidString: defaultTestTabWindowUUID.uuidString)!
+        let uuidToKeep = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/primary")
+        mockFileManager.backupDirectoryURL = URL(string: "some/backup")
+        mockFileManager.primaryPathContents = [
+            URL(string: "some/primary/window-\(defaultTestTabWindowUUID.uuidString)")!,
+            URL(string: "some/primary/window-\(uuidToKeep.uuidString)")!
+        ]
+        mockFileManager.backupPathContents = [
+            URL(string: "some/backup/window-\(defaultTestTabWindowUUID.uuidString)")!,
+            URL(string: "some/backup/window-\(uuidToKeep.uuidString)")!
+        ]
+
+        await subject.removeWindowData(forUUIDs: [uuidToRemove])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertFalse(mockFileManager.removedFileURLs.contains {
+            $0.lastPathComponent == "window-\(uuidToKeep.uuidString)"
+        })
+    }
+
+    @MainActor
