+    // MARK: - Removing Data
+    @MainActor
+    func testRemoveWindowData_removesPrimaryAndBackupCopies() async throws {
+        let subject = createSubject()
+        let uuidToRemove = defaultTestTabWindowUUID
+        let uuidToKeep = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        let primaryFileToRemove = mockFileManager.primaryDirectoryURL!.appendingPathComponent("window-\(uuidToRemove.uuidString)")
+        let primaryFileToKeep = mockFileManager.primaryDirectoryURL!.appendingPathComponent("window-\(uuidToKeep.uuidString)")
+        let backupFileToRemove = mockFileManager.backupDirectoryURL!.appendingPathComponent("window-\(uuidToRemove.uuidString)")
+        mockFileManager.pathContents = [primaryFileToRemove, primaryFileToKeep]
+        mockFileManager.backupPathContents = [backupFileToRemove]
+
+        await subject.removeWindowData(forUUIDs: [uuidToRemove])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(primaryFileToRemove))
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(backupFileToRemove))
+        XCTAssertFalse(mockFileManager.removedFileURLs.contains(primaryFileToKeep))
+    }
+
+    @MainActor
+    func testRemoveWindowData_noBackupFile_doesNotError() async throws {
+        let subject = createSubject()
+        let uuidToRemove = defaultTestTabWindowUUID
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        let primaryFileToRemove = mockFileManager.primaryDirectoryURL!.appendingPathComponent("window-\(uuidToRemove.uuidString)")
+        mockFileManager.pathContents = [primaryFileToRemove]
+        mockFileManager.backupPathContents = []
+
+        await subject.removeWindowData(forUUIDs: [uuidToRemove])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 1)
+        XCTAssertEqual(mockFileManager.removedFileURLs, [primaryFileToRemove])
+    }
+
