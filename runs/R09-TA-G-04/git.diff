+    // MARK: - Removing Data
+    @MainActor
+    func testRemoveWindowData_removesPrimaryAndBackupFiles() async throws {
+        let subject = createSubject()
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        let primaryURL = URL(string: "some/directory1/window-\(defaultTestTabWindowUUID.uuidString)")!
+        let backupURL = URL(string: "some/directory2/window-\(defaultTestTabWindowUUID.uuidString)")!
+        mockFileManager.pathContents = [primaryURL]
+        mockFileManager.backupPathContents = [backupURL]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(primaryURL))
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(backupURL))
+    }
+
+    @MainActor
+    func testRemoveWindowData_noBackupFile_removesPrimaryOnlyWithoutError() async throws {
+        let subject = createSubject()
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        let primaryURL = URL(string: "some/directory1/window-\(defaultTestTabWindowUUID.uuidString)")!
+        mockFileManager.pathContents = [primaryURL]
+        mockFileManager.backupPathContents = []
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 1)
+        XCTAssertEqual(mockFileManager.removedFileURLs, [primaryURL])
+    }
+
+    @MainActor
+    func testRemoveWindowData_leavesUnrelatedWindowsUntouched() async throws {
+        let subject = createSubject()
+        let otherUUID = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        let primaryURLToRemove = URL(string: "some/directory1/window-\(defaultTestTabWindowUUID.uuidString)")!
+        let backupURLToRemove = URL(string: "some/directory2/window-\(defaultTestTabWindowUUID.uuidString)")!
+        let primaryURLToKeep = URL(string: "some/directory1/window-\(otherUUID.uuidString)")!
+        let backupURLToKeep = URL(string: "some/directory2/window-\(otherUUID.uuidString)")!
+        mockFileManager.pathContents = [primaryURLToRemove, primaryURLToKeep]
+        mockFileManager.backupPathContents = [backupURLToRemove, backupURLToKeep]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertFalse(mockFileManager.removedFileURLs.contains(primaryURLToKeep))
+        XCTAssertFalse(mockFileManager.removedFileURLs.contains(backupURLToKeep))
+    }
