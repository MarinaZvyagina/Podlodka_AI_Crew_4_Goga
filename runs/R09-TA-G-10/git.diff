+    // MARK: - Removing Window Data
+    @MainActor
+    func testRemoveWindowData_removesMatchingFilesFromPrimaryAndBackup() async throws {
+        let subject = createSubject()
+        let uuidToRemove = defaultTestTabWindowUUID
+        let uuidToKeep = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        let primaryRemoveURL = URL(string: "some/directory1/window-\(uuidToRemove.uuidString)")!
+        let primaryKeepURL = URL(string: "some/directory1/window-\(uuidToKeep.uuidString)")!
+        let backupRemoveURL = URL(string: "some/directory2/window-\(uuidToRemove.uuidString)")!
+        mockFileManager.pathContents = [primaryRemoveURL, primaryKeepURL]
+        mockFileManager.backupPathContents = [backupRemoveURL]
+
+        await subject.removeWindowData(forUUIDs: [uuidToRemove])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertTrue(mockFileManager.removedFileAtPaths.contains(primaryRemoveURL))
+        XCTAssertTrue(mockFileManager.removedFileAtPaths.contains(backupRemoveURL))
+        XCTAssertFalse(mockFileManager.removedFileAtPaths.contains(primaryKeepURL))
+    }
+
+    @MainActor
+    func testRemoveWindowData_windowWithoutBackupFile_removesPrimaryOnlyWithoutError() async throws {
+        let subject = createSubject()
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        let primaryRemoveURL = URL(string: "some/directory1/window-\(defaultTestTabWindowUUID.uuidString)")!
+        mockFileManager.pathContents = [primaryRemoveURL]
+        mockFileManager.backupPathContents = []
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 1)
+        XCTAssertEqual(mockFileManager.removedFileAtPaths, [primaryRemoveURL])
+    }
+
