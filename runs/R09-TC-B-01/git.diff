diff --git a/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
new file mode 100644
index 0000000..3ecf4e5
--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,73 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import AVFoundation
+
+/// A stand-in transcription engine representing an alternative speech-to-text pipeline.
+///
+/// Used to A/B test transcription quality and latency against `SFSpeechRecognizerEngine`/
+/// `SpeechAnalyzerEngine`. Captures audio the same way as those engines so permission handling
+/// and audio session behavior stay identical, but produces a simulated transcript instead of
+/// calling a real on-device or remote recognizer.
+///
+/// Replace the simulated streaming with a call to the real alternative provider once available.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    private static let defaultSimulatedTranscript = ["What", "is", "the", "weather", "today"]
+    private static let defaultWordDelayNanoseconds: UInt64 = 150_000_000
+
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let simulatedTranscript: [String]
+    private let wordDelayNanoseconds: UInt64
+
+    private var streamingTask: Task<Void, Never>?
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        simulatedTranscript: [String] = AlternativeTranscriptionEngine.defaultSimulatedTranscript,
+        wordDelayNanoseconds: UInt64 = AlternativeTranscriptionEngine.defaultWordDelayNanoseconds
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.simulatedTranscript = simulatedTranscript
+        self.wordDelayNanoseconds = wordDelayNanoseconds
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        streamingTask?.cancel()
+        streamingTask = Task { [simulatedTranscript, wordDelayNanoseconds] in
+            var words: [String] = []
+            for word in simulatedTranscript {
+                guard !Task.isCancelled else { return }
+                words.append(word)
+
+                let isFinal = words.count == simulatedTranscript.count
+                continuation.yield(SpeechResult(text: words.joined(separator: " "), isFinal: isFinal))
+
+                if isFinal {
+                    continuation.finish()
+                    return
+                }
+                try? await Task.sleep(nanoseconds: wordDelayNanoseconds)
+            }
+        }
+    }
+
+    func stop() throws {
+        streamingTask?.cancel()
+        streamingTask = nil
+        try audioManager.stopEngine()
+    }
+}
