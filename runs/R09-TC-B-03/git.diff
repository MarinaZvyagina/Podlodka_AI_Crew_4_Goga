diff --git a/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
new file mode 100644
index 0000000..e0788f7
--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,69 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+/// A stand-in for an alternative third-party speech-to-text pipeline, used to A/B test
+/// transcription quality/latency against the platform's built-in engine (`SFSpeechRecognizerEngine`/
+/// `SpeechAnalyzerEngine`).
+///
+/// Shares the same permission and microphone capture flow as the built-in engines so that
+/// permission handling and audio lifecycle stay identical regardless of which pipeline is active,
+/// but streams a simulated transcript instead of calling a real third-party service.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let simulatedTranscript: [String]
+    private let wordDelayNanoseconds: UInt64
+
+    private var streamingTask: Task<Void, Never>?
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        simulatedTranscript: [String] = ["What", "is", "the", "weather", "today?"],
+        wordDelayNanoseconds: UInt64 = 200_000_000
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.simulatedTranscript = simulatedTranscript
+        self.wordDelayNanoseconds = wordDelayNanoseconds
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        streamingTask?.cancel()
+        streamingTask = Task { [simulatedTranscript, wordDelayNanoseconds] in
+            var accumulated = ""
+            for (index, word) in simulatedTranscript.enumerated() {
+                do {
+                    try await Task.sleep(nanoseconds: wordDelayNanoseconds)
+                } catch {
+                    return
+                }
+                if Task.isCancelled { return }
+
+                accumulated = accumulated.isEmpty ? word : "\(accumulated) \(word)"
+                let isFinal = index == simulatedTranscript.count - 1
+                continuation.yield(SpeechResult(text: accumulated, isFinal: isFinal))
+                if isFinal {
+                    continuation.finish()
+                }
+            }
+        }
+    }
+
+    func stop() throws {
+        streamingTask?.cancel()
+        streamingTask = nil
+        try audioManager.stopEngine()
+    }
+}
