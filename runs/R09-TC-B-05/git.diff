+
+/// The speech-to-text pipeline used to transcribe voice search audio.
+///
+/// Used to A/B test an alternative transcription pipeline against the default one, behind a
+/// Nimbus experiment flag. Enrolled and non-enrolled users each get their own `TranscriptionEngine`
+/// instance, so the two variants never share mutable state.
+public enum TranscriptionEngineVariant: String, Sendable {
+    case standard
+    case alternative
+}
