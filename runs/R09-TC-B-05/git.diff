diff --git a/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
new file mode 100644
index 0000000..29fff79
--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,66 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+/// A stand-in for a third-party speech-to-text pipeline, used to A/B test transcription quality
+/// and latency against the default `SFSpeechRecognizerEngine`/`SpeechAnalyzerEngine` pipeline.
+///
+/// Mirrors `SFSpeechRecognizerEngine`'s permission and audio-capture flow so recording, streaming
+/// of partial results, and error handling are indistinguishable to the user. Transcription itself
+/// is simulated rather than backed by a real engine, which is sufficient for wiring up the
+/// experiment; `resultsProvider` can be swapped for a real pipeline later.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let resultsProvider: () -> [SpeechResult]
+    private let chunkDelayNanoseconds: UInt64
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        resultsProvider: @escaping () -> [SpeechResult] = AlternativeTranscriptionEngine.defaultResults,
+        chunkDelayNanoseconds: UInt64 = 300_000_000
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.resultsProvider = resultsProvider
+        self.chunkDelayNanoseconds = chunkDelayNanoseconds
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        for result in resultsProvider() {
+            try Task.checkCancellation()
+            if chunkDelayNanoseconds > 0 {
+                try await Task.sleep(nanoseconds: chunkDelayNanoseconds)
+            }
+            continuation.yield(result)
+            if result.isFinal {
+                continuation.finish()
+                return
+            }
+        }
+        continuation.finish()
+    }
+
+    func stop() throws {
+        try audioManager.stopEngine()
+    }
+
+    private nonisolated static func defaultResults() -> [SpeechResult] {
+        [
+            SpeechResult(text: "[alternative pipeline]", isFinal: false),
+            SpeechResult(text: "[alternative pipeline] mock", isFinal: false),
+            SpeechResult(text: "[alternative pipeline] mock transcription", isFinal: true)
+        ]
+    }
+}
