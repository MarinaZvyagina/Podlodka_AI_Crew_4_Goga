diff --git a/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
new file mode 100644
index 0000000..5b202c8
--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,72 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+/// A stand-in transcription engine used to A/B test an alternative speech-to-text pipeline
+/// against the platform-provided `SFSpeechRecognizerEngine` / `SpeechAnalyzerEngine`.
+///
+/// It goes through the same permission and audio-capture flow as the other engines so the rest
+/// of the feature (recording UI, error handling, cancellation) behaves identically regardless of
+/// which engine is active. In place of a real third-party engine, it synthesizes incremental
+/// transcription results at a fixed cadence while audio is captured.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    static let defaultWords = ["testing", "the", "alternative", "transcription", "pipeline"]
+    static let defaultIntervalNanoseconds: UInt64 = 300_000_000
+
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let words: [String]
+    private let intervalNanoseconds: UInt64
+    private var streamingTask: Task<Void, Never>?
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        words: [String] = AlternativeTranscriptionEngine.defaultWords,
+        intervalNanoseconds: UInt64 = AlternativeTranscriptionEngine.defaultIntervalNanoseconds
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.words = words
+        self.intervalNanoseconds = intervalNanoseconds
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        guard !words.isEmpty else {
+            continuation.finish()
+            return
+        }
+
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        streamingTask?.cancel()
+        streamingTask = Task { [words, intervalNanoseconds] in
+            for wordCount in 1...words.count {
+                try? await Task.sleep(nanoseconds: intervalNanoseconds)
+                guard !Task.isCancelled else { return }
+
+                let text = words.prefix(wordCount).joined(separator: " ")
+                let isFinal = wordCount == words.count
+                continuation.yield(SpeechResult(text: text, isFinal: isFinal))
+
+                if isFinal {
+                    continuation.finish()
+                }
+            }
+        }
+    }
+
+    func stop() throws {
+        streamingTask?.cancel()
+        streamingTask = nil
+        try audioManager.stopEngine()
+    }
+}
