--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,66 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import AVFoundation
+
+/// A stand-in `TranscriptionEngine` used to A/B test an alternative speech-to-text pipeline
+/// against `SFSpeechRecognizerEngine`/`SpeechAnalyzerEngine`.
+///
+/// Requests the same permissions and captures audio the same way as the default engines, but
+/// streams back a simulated transcript instead of running real recognition. Swap this out for a
+/// production integration once one is selected for the experiment.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let simulatedWords: [String]
+    private let chunkDelayNanoseconds: UInt64
+
+    private var transcriptionTask: Task<Void, Never>?
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        simulatedWords: [String] = ["What", "is", "the", "weather", "today?"],
+        chunkDelayNanoseconds: UInt64 = 150_000_000
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.simulatedWords = simulatedWords
+        self.chunkDelayNanoseconds = chunkDelayNanoseconds
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        transcriptionTask = Task { [simulatedWords, chunkDelayNanoseconds] in
+            var accumulated: [String] = []
+            for word in simulatedWords {
+                guard !Task.isCancelled else { return }
+
+                accumulated.append(word)
+                let isFinal = accumulated.count == simulatedWords.count
+                continuation.yield(SpeechResult(text: accumulated.joined(separator: " "), isFinal: isFinal))
+
+                if isFinal {
+                    continuation.finish()
+                    return
+                }
+                try? await Task.sleep(nanoseconds: chunkDelayNanoseconds)
+            }
+        }
+    }
+
+    func stop() throws {
+        transcriptionTask?.cancel()
+        transcriptionTask = nil
+        try audioManager.stopEngine()
+    }
+}
