diff --git a/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
new file mode 100644
index 0000000..d70709b
--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,72 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import Foundation
+
+/// A stand-in implementation of the alternative speech-to-text pipeline under experimentation.
+///
+/// Reuses the same permission and audio session flow as the other engines so the recording UX
+/// (record button, streaming, error handling, stop/cancel) is indistinguishable to the user
+/// regardless of which pipeline is active. Instead of forwarding captured audio to a real
+/// recognizer, it streams a simulated transcript, standing in for a production-grade third-party
+/// engine that would be wired in here later.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    private static let defaultSimulatedTranscript = ["best", "pizza", "near", "me"]
+    private static let defaultWordIntervalNanoseconds: UInt64 = 250_000_000
+
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let simulatedTranscript: [String]
+    private let wordIntervalNanoseconds: UInt64
+
+    private var streamingTask: Task<Void, Never>?
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        simulatedTranscript: [String] = AlternativeTranscriptionEngine.defaultSimulatedTranscript,
+        wordIntervalNanoseconds: UInt64 = AlternativeTranscriptionEngine.defaultWordIntervalNanoseconds
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.simulatedTranscript = simulatedTranscript
+        self.wordIntervalNanoseconds = wordIntervalNanoseconds
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        streamingTask?.cancel()
+        streamingTask = Task { [simulatedTranscript, wordIntervalNanoseconds] in
+            var accumulated = ""
+            for (index, word) in simulatedTranscript.enumerated() {
+                guard !Task.isCancelled else { return }
+                accumulated += accumulated.isEmpty ? word : " \(word)"
+
+                let isFinal = index == simulatedTranscript.count - 1
+                continuation.yield(SpeechResult(text: accumulated, isFinal: isFinal))
+
+                if isFinal {
+                    continuation.finish()
+                } else {
+                    try? await Task.sleep(nanoseconds: wordIntervalNanoseconds)
+                }
+            }
+        }
+    }
+
+    func stop() throws {
+        streamingTask?.cancel()
+        streamingTask = nil
+        try audioManager.stopEngine()
+    }
+}
