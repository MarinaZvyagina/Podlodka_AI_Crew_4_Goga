index 0000000..2ac1d5e
--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,68 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import Foundation
+
+/// A stand-in speech transcription engine used to A/B test an alternative speech-to-text
+/// pipeline against the default (`SFSpeechRecognizerEngine`/`SpeechAnalyzerEngine`).
+///
+/// Reuses the same microphone permission and capture flow as the other engines so recording,
+/// streaming, and error behavior are identical from the user's point of view. The transcription
+/// itself is simulated rather than backed by a real third-party recognizer.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let simulatedTranscript: [String]
+    private let chunkInterval: TimeInterval
+
+    private var transcriptionTask: Task<Void, Never>?
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        simulatedTranscript: [String] = ["this", "is", "a", "test", "query"],
+        chunkInterval: TimeInterval = 0.15
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.simulatedTranscript = simulatedTranscript
+        self.chunkInterval = chunkInterval
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        transcriptionTask = Task { [simulatedTranscript, chunkInterval] in
+            var accumulatedWords: [String] = []
+            for word in simulatedTranscript {
+                if Task.isCancelled { return }
+
+                accumulatedWords.append(word)
+                let isFinal = accumulatedWords.count == simulatedTranscript.count
+                continuation.yield(SpeechResult(text: accumulatedWords.joined(separator: " "), isFinal: isFinal))
+
+                if isFinal {
+                    continuation.finish()
+                    return
+                }
+
+                try? await Task.sleep(nanoseconds: UInt64(chunkInterval * 1_000_000_000))
+            }
+        }
+    }
+
+    func stop() async throws {
+        transcriptionTask?.cancel()
+        transcriptionTask = nil
+        try audioManager.stopEngine()
+    }
+}
