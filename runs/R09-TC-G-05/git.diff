+    /// Builds a `TranscriptionEngine` for `kind`. `audioManager`/`authorizer` are injectable so tests
+    /// can verify engine selection without touching real microphone/speech permissions.
+    static func makeDefaultEngine(
+        kind: SpeechEngineKind,
+        audioManager: AudioManagerProtocol = AudioManager(),
+        authorizer: AuthorizeProvider = AuthorizationHandler()
+    ) -> TranscriptionEngine {
+        switch kind {
+        case .alternative:
+            return AlternativeTranscriptionEngine(
                 audioManager: audioManager,
                 authorizer: authorizer
             )
+        case .standard:
+            if #available(iOS 26.0, *) {
+                return SpeechAnalyzerEngine(
+                    audioManager: audioManager,
+                    authorizer: authorizer
+                )
+            } else {
+                return SFSpeechRecognizerEngine(
+                    audioManager: audioManager,
+                    authorizer: authorizer
+                )
+            }
         }
     }
 }
diff --git a/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
