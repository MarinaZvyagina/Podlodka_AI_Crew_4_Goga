+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,70 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import Foundation
+
+/// A stand-in transcription engine for the experimental `TranscriptionPipeline.alternative` pipeline.
+///
+/// It shares the same audio session and permission handling as `SFSpeechRecognizerEngine`/
+/// `SpeechAnalyzerEngine`, so the recording lifecycle and error handling are identical from the
+/// caller's point of view; only the source of transcription results differs.
+///
+/// - Note: This is a placeholder implementation for A/B testing the wiring of a second pipeline.
+///   Swap `resultsProvider` for a real third-party integration when one is available.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let resultsProvider: () -> AsyncThrowingStream<SpeechResult, Error>
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        resultsProvider: @escaping () -> AsyncThrowingStream<SpeechResult, Error> = Self.placeholderResults
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.resultsProvider = resultsProvider
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        do {
+            for try await result in resultsProvider() {
+                continuation.yield(result)
+                if result.isFinal {
+                    continuation.finish()
+                    return
+                }
+            }
+            continuation.finish()
+        } catch {
+            continuation.finish(throwing: error)
+        }
+    }
+
+    func stop() throws {
+        try audioManager.stopEngine()
+    }
+
+    private static func placeholderResults() -> AsyncThrowingStream<SpeechResult, Error> {
+        AsyncThrowingStream { continuation in
+            Task {
+                try? await Task.sleep(nanoseconds: 300_000_000)
+                continuation.yield(SpeechResult(text: "Listening", isFinal: false))
+                try? await Task.sleep(nanoseconds: 700_000_000)
+                continuation.yield(SpeechResult(text: "Listening for your search", isFinal: true))
+                continuation.finish()
+            }
+        }
+    }
+}
