diff --git a/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
new file mode 100644
index 0000000..959f7c2
--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,73 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+/// A stand-in transcription engine used to A/B test an alternative speech-to-text pipeline
+/// against the platform default (`SFSpeechRecognizerEngine`/`SpeechAnalyzerEngine`).
+///
+/// It shares the same permission and audio session handling as the default engines so that
+/// permission errors and recording lifecycle behave identically regardless of which engine is
+/// selected. The recognition step itself is simulated rather than backed by a real third-party
+/// engine.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    static let defaultSimulatedResults: [SpeechResult] = [
+        SpeechResult(text: "What is the weather", isFinal: false),
+        SpeechResult(text: "What is the weather today", isFinal: true)
+    ]
+
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let simulatedResults: [SpeechResult]
+    private let resultDelayNanoseconds: UInt64
+
+    private var transcriptionTask: Task<Void, Never>?
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        simulatedResults: [SpeechResult] = AlternativeTranscriptionEngine.defaultSimulatedResults,
+        resultDelayNanoseconds: UInt64 = 200_000_000
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.simulatedResults = simulatedResults
+        self.resultDelayNanoseconds = resultDelayNanoseconds
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        transcriptionTask?.cancel()
+        transcriptionTask = Task { [simulatedResults, resultDelayNanoseconds] in
+            do {
+                for result in simulatedResults {
+                    try Task.checkCancellation()
+                    if resultDelayNanoseconds > 0 {
+                        try await Task.sleep(nanoseconds: resultDelayNanoseconds)
+                    }
+                    continuation.yield(result)
+                    if result.isFinal {
+                        continuation.finish()
+                        return
+                    }
+                }
+                continuation.finish()
+            } catch is CancellationError {
+                continuation.finish()
+            } catch {
+                continuation.finish(throwing: error)
+            }
+        }
+    }
+
+    func stop() throws {
+        transcriptionTask?.cancel()
+        transcriptionTask = nil
+        try audioManager.stopEngine()
+    }
+}
