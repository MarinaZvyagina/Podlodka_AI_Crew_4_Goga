diff --git a/SignalServiceKit/Search/MessageAttachmentSearchFinder.swift b/SignalServiceKit/Search/MessageAttachmentSearchFinder.swift
new file mode 100644
index 0000000..b64eaf7
--- /dev/null
+++ b/SignalServiceKit/Search/MessageAttachmentSearchFinder.swift
@@ -0,0 +1,74 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+import GRDB
+
+/// Looks up which messages in a thread have a "body" attachment — a photo,
+/// video, voice message, or generic file the user sent or received as the
+/// content of a message.
+///
+/// This intentionally excludes other attachment owner types (link preview
+/// thumbnails, quoted-reply thumbnails, stickers, contact share avatars) as
+/// well as view-once media and past edit revisions, matching what a user
+/// would recognize as "shared media" in the conversation.
+///
+/// Results always reflect the live `MessageAttachmentReference` table, so
+/// they're immediately correct as attachments are associated with (or
+/// removed from) messages; there's no separate index to rebuild or fall out
+/// of sync.
+public enum MessageAttachmentSearchFinder {
+    public typealias RecordType = AttachmentReference.MessageAttachmentReferenceRecord
+
+    private static func baseQuery(threadRowId: Int64) -> QueryInterfaceRequest<RecordType> {
+        let threadRowIdColumn = Column(RecordType.CodingKeys.threadRowId)
+        let ownerTypeColumn = Column(RecordType.CodingKeys.ownerType)
+        let isViewOnceColumn = Column(RecordType.CodingKeys.isViewOnce)
+        let isPastEditRevisionColumn = Column(RecordType.CodingKeys.ownerIsPastEditRevision)
+
+        return RecordType
+            .filter(threadRowIdColumn == threadRowId)
+            .filter(ownerTypeColumn == RecordType.OwnerType.bodyAttachment.rawValue)
+            .filter(isViewOnceColumn == false)
+            .filter(isPastEditRevisionColumn == false)
+    }
+
+    /// The row IDs of every message in the thread with a qualifying
+    /// attachment. Order is unspecified; use for membership testing.
+    public static func messageRowIdsWithAttachments(
+        threadRowId: Int64,
+        tx: DBReadTransaction,
+    ) -> Set<Int64> {
+        let ownerRowIdColumn = Column(RecordType.CodingKeys.ownerRowId)
+        do {
+            return try baseQuery(threadRowId: threadRowId)
+                .select(ownerRowIdColumn, as: Int64.self)
+                .fetchSet(tx.database)
+        } catch {
+            owsFailDebug("Error fetching attachment owner row ids: \(error.grdbErrorForLogging)")
+            return []
+        }
+    }
+
+    /// The row IDs of messages in the thread with a qualifying attachment,
+    /// most recently received first.
+    public static func messageRowIdsWithAttachments(
+        threadRowId: Int64,
+        limit: Int,
+        tx: DBReadTransaction,
+    ) -> [Int64] {
+        let ownerRowIdColumn = Column(RecordType.CodingKeys.ownerRowId)
+        do {
+            return try baseQuery(threadRowId: threadRowId)
+                .select(ownerRowIdColumn, as: Int64.self)
+                .distinct()
+                .order(ownerRowIdColumn.desc)
+                .limit(limit)
+                .fetchAll(tx.database)
+        } catch {
+            owsFailDebug("Error fetching attachment owner row ids: \(error.grdbErrorForLogging)")
+            return []
+        }
+    }
+}
