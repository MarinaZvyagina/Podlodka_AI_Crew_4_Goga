diff --git a/SignalServiceKit/Storage/MediaGallery/MediaGalleryAttachmentFinder.swift b/SignalServiceKit/Storage/MediaGallery/MediaGalleryAttachmentFinder.swift
index 3bc78c0..5fea7ac 100644
--- a/SignalServiceKit/Storage/MediaGallery/MediaGalleryAttachmentFinder.swift
+++ b/SignalServiceKit/Storage/MediaGallery/MediaGalleryAttachmentFinder.swift
@@ -268,6 +268,49 @@ public struct MediaGalleryAttachmentFinder {
         ).count)
     }
 
+    /// Returns the sqlite row ids of messages in the given thread that have at least one
+    /// body attachment (of any type: photo, video, voice message, or file), optionally
+    /// restricted to a given set of message row ids.
+    ///
+    /// Deliberately disregards `AllMediaFilter`, since "has any attachment" is not one of
+    /// its categories. Queries the same attachment reference table the media gallery already
+    /// uses, so results always reflect the attachment's current association with the message.
+    public static func messageRowIdsWithBodyAttachments(
+        inThreadId threadRowId: Int64,
+        restrictedToMessageRowIds: Set<Int64>?,
+        limit: Int? = nil,
+        tx: DBReadTransaction,
+    ) -> Set<Int64> {
+        let threadIdColumn = Column(RecordType.CodingKeys.threadRowId)
+        let ownerTypeColumn = Column(RecordType.CodingKeys.ownerType)
+        let isViewOnceColumn = Column(RecordType.CodingKeys.isViewOnce)
+        let isPastEditRevisionColumn = Column(RecordType.CodingKeys.ownerIsPastEditRevision)
+        let ownerIdColumn = Column(RecordType.CodingKeys.ownerRowId)
+
+        var recordQuery: QueryInterfaceRequest<RecordType> = RecordType
+            .filter(threadIdColumn == threadRowId)
+            .filter(ownerTypeColumn == RecordType.OwnerType.bodyAttachment.rawValue)
+            .filter(isViewOnceColumn == false)
+            .filter(isPastEditRevisionColumn == false)
+
+        if let restrictedToMessageRowIds {
+            recordQuery = recordQuery.filter(restrictedToMessageRowIds.contains(ownerIdColumn))
+        }
+
+        var idQuery = recordQuery.select(ownerIdColumn, as: Int64.self).distinct()
+
+        if restrictedToMessageRowIds == nil, let limit {
+            idQuery = idQuery.order(ownerIdColumn.desc).limit(limit)
+        }
+
+        do {
+            return Set(try idQuery.fetchAll(tx.database))
+        } catch {
+            owsFailDebug("Error fetching message row ids with body attachments: \(error)")
+            return []
+        }
+    }
+
     // MARK: - Private
 
     typealias RecordType = AttachmentReference.MessageAttachmentReferenceRecord
