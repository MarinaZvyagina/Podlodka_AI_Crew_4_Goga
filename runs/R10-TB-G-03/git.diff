index 3bc78c0..97e87ae 100644
--- a/SignalServiceKit/Storage/MediaGallery/MediaGalleryAttachmentFinder.swift
+++ b/SignalServiceKit/Storage/MediaGallery/MediaGalleryAttachmentFinder.swift
@@ -268,6 +268,58 @@ public struct MediaGalleryAttachmentFinder {
         ).count)
     }
 
+    /// Row ids (`TSInteraction.sqliteRowId`) of messages in `threadId` that have at least one body attachment
+    /// (photo, video, voice message, or file), regardless of its specific type, most-recent-first. Disregards
+    /// `filter`, since this answers "does this message have a shared-media attachment at all", not "which category".
+    ///
+    /// If `messageRowIds` is provided, only those messages are considered; this lets a caller intersect with
+    /// another result set (e.g. text search matches) without a full thread scan.
+    ///
+    /// Reads directly off `MessageAttachmentReference`, which is kept in sync with attachment download/association
+    /// state as it changes, so results reflect the current state of each attachment without any separate index to
+    /// maintain.
+    public static func messageRowIdsWithBodyAttachments(
+        inThreadId threadId: Int64,
+        restrictedToMessageRowIds messageRowIds: Set<Int64>?,
+        limit: Int,
+        tx: DBReadTransaction,
+    ) -> [Int64] {
+        let threadIdColumn = Column(RecordType.CodingKeys.threadRowId)
+        let ownerTypeColumn = Column(RecordType.CodingKeys.ownerType)
+        let ownerRowIdColumn = Column(RecordType.CodingKeys.ownerRowId)
+        let isViewOnceColumn = Column(RecordType.CodingKeys.isViewOnce)
+        let isPastEditRevisionColumn = Column(RecordType.CodingKeys.ownerIsPastEditRevision)
+        let receivedAtTimestampColumn = Column(RecordType.CodingKeys.receivedAtTimestamp)
+
+        var query: QueryInterfaceRequest<RecordType> = RecordType
+            .filter(threadIdColumn == threadId)
+            // Only body attachments count as "shared media" (not link previews, quotes, or stickers).
+            .filter(ownerTypeColumn == RecordType.OwnerType.bodyAttachment.rawValue)
+            .filter(isViewOnceColumn == false)
+            .filter(isPastEditRevisionColumn == false)
+
+        if let messageRowIds {
+            query = query.filter(messageRowIds.contains(ownerRowIdColumn))
+        }
+
+        query = query.order(receivedAtTimestampColumn.desc, ownerRowIdColumn.desc)
+
+        do {
+            var seenOwnerRowIds = Set<Int64>()
+            var result = [Int64]()
+            let cursor = try query.fetchCursor(tx.database)
+            while result.count < limit, let record = try cursor.next() {
+                if seenOwnerRowIds.insert(record.ownerRowId).inserted {
+                    result.append(record.ownerRowId)
+                }
+            }
+            return result
+        } catch {
+            owsFailDebug("Error fetching messages with attachments: \(error)")
+            return []
+        }
+    }
+
     // MARK: - Private
 
     typealias RecordType = AttachmentReference.MessageAttachmentReferenceRecord
