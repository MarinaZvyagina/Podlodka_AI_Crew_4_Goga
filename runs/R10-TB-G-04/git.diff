diff --git a/SignalServiceKit/Search/ConversationSearchAttachmentFinder.swift b/SignalServiceKit/Search/ConversationSearchAttachmentFinder.swift
new file mode 100644
index 0000000..ae43ec7
--- /dev/null
+++ b/SignalServiceKit/Search/ConversationSearchAttachmentFinder.swift
@@ -0,0 +1,46 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+import GRDB
+
+/// Finds messages within a thread that have a photo, video, voice message, or
+/// generic file attached to their body, for use by the "media only" filter on
+/// in-conversation search.
+///
+/// This queries the live `MessageAttachmentReference` table directly rather
+/// than a separate index: that table is written in the same transaction as
+/// the owning message (see `AttachmentManager`), so it always reflects
+/// whether an attachment is currently associated with a message, and there is
+/// nothing to backfill for a new install of this feature.
+public enum ConversationSearchAttachmentFinder {
+    /// Row ids (equivalent to `TSInteraction.sortId`/`sqliteRowId`) of messages
+    /// in the given thread with a qualifying body attachment, most recent first.
+    public static func fetchRowIdsOfMessagesWithAttachments(
+        threadRowId: Int64,
+        tx: DBReadTransaction,
+    ) -> [Int64] {
+        typealias RecordType = AttachmentReference.MessageAttachmentReferenceRecord
+
+        let ownerRowIdColumn = Column(RecordType.CodingKeys.ownerRowId)
+
+        let query = RecordType
+            .select(ownerRowIdColumn, as: Int64.self)
+            .filter(Column(RecordType.CodingKeys.threadRowId) == threadRowId)
+            .filter(Column(RecordType.CodingKeys.ownerType) == RecordType.OwnerType.bodyAttachment.rawValue)
+            // View-once media disappears after being viewed; excluded for the
+            // same reason it's excluded from the text search index.
+            .filter(Column(RecordType.CodingKeys.isViewOnce) == false)
+            .filter(Column(RecordType.CodingKeys.ownerIsPastEditRevision) == false)
+            .distinct()
+            .order(ownerRowIdColumn.desc)
+
+        do {
+            return try query.fetchAll(tx.database)
+        } catch {
+            owsFailDebug("Error fetching attachment message row ids: \(error.grdbErrorForLogging)")
+            return []
+        }
+    }
+}
diff --git a/SignalServiceKit/Storage/MediaGallery/ConversationSearchAttachmentFinderTest.swift b/SignalServiceKit/Storage/MediaGallery/ConversationSearchAttachmentFinderTest.swift
new file mode 100644
index 0000000..56ea4db
--- /dev/null
+++ b/SignalServiceKit/Storage/MediaGallery/ConversationSearchAttachmentFinderTest.swift
@@ -0,0 +1,147 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+import GRDB
+import XCTest
+@testable import SignalServiceKit
+
+class ConversationSearchAttachmentFinderTest: XCTestCase {
+    private let attachmentStore = AttachmentStore()
+    private var db: InMemoryDB!
+
+    override func setUp() async throws {
+        db = InMemoryDB()
+    }
+
+    func testFiltersByThreadOwnerTypeViewOnceAndPastEditRevision() throws {
+        let (threadA, messageRowIdA) = insertThreadAndInteraction()
+        let (threadB, messageRowIdB) = insertThreadAndInteraction()
+        let threadRowIdA = threadA.sqliteRowId!
+        let threadRowIdB = threadB.sqliteRowId!
+
+        // A message in another thread; should never show up for threadA.
+        insertBodyAttachment(messageRowId: messageRowIdB, threadRowId: threadRowIdB, orderInMessage: 0)
+
+        // A message with no attachment at all; only exists so its rowId isn't
+        // accidentally in range of a matching one.
+        _ = insertThreadAndInteraction()
+
+        // A qualifying photo/video/voice-message/file attachment.
+        let qualifyingMessageRowId = messageRowIdA
+        insertBodyAttachment(messageRowId: qualifyingMessageRowId, threadRowId: threadRowIdA, orderInMessage: 0)
+
+        // A view-once attachment; excluded.
+        let (_, viewOnceMessageRowId) = insertThreadAndInteraction(thread: threadA)
+        insertBodyAttachment(messageRowId: viewOnceMessageRowId, threadRowId: threadRowIdA, orderInMessage: 0, isViewOnce: true)
+
+        // A past-edit-revision attachment; excluded.
+        let (_, pastRevisionMessageRowId) = insertThreadAndInteraction(thread: threadA)
+        insertBodyAttachment(messageRowId: pastRevisionMessageRowId, threadRowId: threadRowIdA, orderInMessage: 0, isPastEditRevision: true)
+
+        // A link preview attachment; not a body attachment, excluded.
+        let (_, linkPreviewMessageRowId) = insertThreadAndInteraction(thread: threadA)
+        insertLinkPreviewAttachment(messageRowId: linkPreviewMessageRowId, threadRowId: threadRowIdA)
+
+        let results = db.read { tx in
+            ConversationSearchAttachmentFinder.fetchRowIdsOfMessagesWithAttachments(threadRowId: threadRowIdA, tx: tx)
+        }
+
+        XCTAssertEqual(results, [qualifyingMessageRowId])
+    }
+
+    func testOrdersMostRecentFirstAndDedupesMultipleAttachmentsOnOneMessage() throws {
+        // Inserted first, so it has the smaller (older) row id.
+        let (thread, olderMessageRowId) = insertThreadAndInteraction()
+        let threadRowId = thread.sqliteRowId!
+        insertBodyAttachment(messageRowId: olderMessageRowId, threadRowId: threadRowId, orderInMessage: 0)
+
+        // Inserted second, so it has the larger (more recent) row id. An album
+        // message with two attachments should only appear once.
+        let (_, newerMessageRowId) = insertThreadAndInteraction(thread: thread)
+        insertBodyAttachment(messageRowId: newerMessageRowId, threadRowId: threadRowId, orderInMessage: 0)
+        insertBodyAttachment(messageRowId: newerMessageRowId, threadRowId: threadRowId, orderInMessage: 1)
+
+        let results = db.read { tx in
+            ConversationSearchAttachmentFinder.fetchRowIdsOfMessagesWithAttachments(threadRowId: threadRowId, tx: tx)
+        }
+
+        XCTAssertEqual(results, [newerMessageRowId, olderMessageRowId])
+    }
+
+    // MARK: - Helpers
+
+    private func insertThreadAndInteraction(thread existingThread: TSThread? = nil) -> (thread: TSThread, interactionRowId: Int64) {
+        let thread = existingThread ?? TSThread(uniqueId: UUID().uuidString)
+        let interaction = TSInteraction(timestamp: 0, receivedAtTimestamp: 0, thread: thread)
+
+        db.write { tx in
+            if existingThread == nil {
+                try! thread.insert(tx.database)
+            }
+            try! interaction.asRecord().insert(tx.database)
+        }
+
+        return (thread, interaction.sqliteRowId!)
+    }
+
+    @discardableResult
+    private func insertBodyAttachment(
+        messageRowId: Int64,
+        threadRowId: Int64,
+        orderInMessage: UInt32,
+        isViewOnce: Bool = false,
+        isPastEditRevision: Bool = false,
+    ) -> Attachment.IDType {
+        db.write { tx in
+            var attachmentRecord = Attachment.Record.mockStream(mimeType: "image/jpeg")
+            try! attachmentRecord.insert(tx.database)
+
+            let attachmentRowId = attachmentRecord.sqliteId!
+
+            let referenceParams = AttachmentReference.ConstructionParams.mockMessageBodyAttachmentReference(
+                attachmentRecord: attachmentRecord,
+                messageRowId: messageRowId,
+                threadRowId: threadRowId,
+                isViewOnce: isViewOnce,
+                isPastEditRevision: isPastEditRevision,
+                orderInMessage: orderInMessage,
+            )
+
+            attachmentStore.addReference(
+                referenceParams,
+                attachmentRowId: attachmentRowId,
+                tx: tx,
+            )
+
+            return attachmentRowId
+        }
+    }
+
+    private func insertLinkPreviewAttachment(messageRowId: Int64, threadRowId: Int64) {
+        db.write { tx in
+            var attachmentRecord = Attachment.Record.mockStream(mimeType: "image/jpeg")
+            try! attachmentRecord.insert(tx.database)
+
+            let attachment = Attachment(record: attachmentRecord)
+
+            let referenceParams = AttachmentReference.ConstructionParams.mock(
+                owner: .message(.linkPreview(.init(
+                    messageRowId: messageRowId,
+                    receivedAtTimestamp: 0,
+                    threadRowId: threadRowId,
+                    contentType: attachment.contentType,
+                    mimeType: attachment.mimeType,
+                    isPastEditRevision: false,
+                ))),
+            )
+
+            attachmentStore.addReference(
+                referenceParams,
+                attachmentRowId: attachment.id,
+                tx: tx,
+            )
+        }
+    }
+}
