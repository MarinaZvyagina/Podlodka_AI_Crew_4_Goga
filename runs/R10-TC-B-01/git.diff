+    // MARK: - Message Retention
+
+    private static let messageRetentionPeriodDayOptions: [UInt32?] = [nil, 30, 90, 365]
+
+    private static func formatMessageRetentionPeriodDays(_ days: UInt32?) -> String {
+        guard let days else {
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_FOREVER",
+                comment: "Label indicating that messages are kept forever, in the 'message retention' setting.",
+            )
+        }
+        if days == 365 {
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_1_YEAR",
+                comment: "Label indicating that messages are kept for one year, in the 'message retention' setting.",
+            )
+        }
+        return String(
+            format: OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_N_DAYS_FORMAT",
+                comment: "Label indicating that messages are kept for a number of days, in the 'message retention' setting. Embeds {{ the number of days }}.",
+            ),
+            String(days),
+        )
+    }
+
+    private func showMessageRetentionPicker() {
+        let actionSheet = ActionSheetController(title: OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_TITLE",
+            comment: "Title for the 'message retention' setting, which lets users automatically delete old messages.",
+        ))
+
+        for retentionPeriodDays in Self.messageRetentionPeriodDayOptions {
+            actionSheet.addAction(.init(
+                title: Self.formatMessageRetentionPeriodDays(retentionPeriodDays),
+                handler: { [weak self] _ in
+                    self?.didSelectMessageRetentionPeriodDays(retentionPeriodDays)
+                },
+            ))
+        }
+
+        actionSheet.addAction(OWSActionSheets.cancelAction)
+
+        presentActionSheet(actionSheet)
+    }
+
+    private func didSelectMessageRetentionPeriodDays(_ retentionPeriodDays: UInt32?) {
+        Logger.info("selected message retention: \(String(describing: retentionPeriodDays))")
+
+        let threadStore = DependenciesBridge.shared.threadStore
+        let bulkDeleteInteractionJobQueue = SSKEnvironment.shared.bulkDeleteInteractionJobQueueRef
+
+        SSKEnvironment.shared.databaseStorageRef.asyncWrite { tx in
+            SSKPreferences.setMessageRetentionPeriodDays(retentionPeriodDays, transaction: tx)
+
+            // Apply retroactively, immediately, rather than waiting for the
+            // next throttled sweep — this is the user explicitly opting into
+            // (or changing) a retention window right now.
+            if let retentionPeriodDays {
+                bulkDeleteInteractionJobQueue.sweepMessageRetention(
+                    retentionPeriodDays: retentionPeriodDays,
+                    now: Date(),
+                    threadStore: threadStore,
+                    tx: tx,
+                )
+            }
+        } completion: { [weak self] in
+            self?.updateTableContents()
+        }
+    }
