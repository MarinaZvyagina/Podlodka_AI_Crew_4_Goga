diff --git a/SignalServiceKit/Jobs/BulkDeleteInteractionJobQueue.swift b/SignalServiceKit/Jobs/BulkDeleteInteractionJobQueue.swift
index d7b0be7..162cbb0 100644
--- a/SignalServiceKit/Jobs/BulkDeleteInteractionJobQueue.swift
+++ b/SignalServiceKit/Jobs/BulkDeleteInteractionJobQueue.swift
@@ -64,6 +64,67 @@ public final class BulkDeleteInteractionJobQueue {
             self.jobQueueRunner.addPersistedJob(jobRecord)
         }
     }
+
+    private enum MessageRetentionConstants {
+        static let secondsPerDay: TimeInterval = 24 * 60 * 60
+        static let minSweepInterval: TimeInterval = 24 * 60 * 60
+    }
+
+    /// Enqueues bulk-delete jobs for every thread with messages older than
+    /// the given retention window. Safe to call unconditionally; threads with
+    /// nothing to delete are skipped.
+    public func sweepMessageRetention(
+        retentionPeriodDays: UInt32,
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        let cutoffDate = now.addingTimeInterval(-TimeInterval(retentionPeriodDays) * MessageRetentionConstants.secondsPerDay)
+        let cutoffTimestamp = cutoffDate.ows_millisecondsSince1970
+
+        threadStore.enumerateNonStoryThreads(tx: tx) { thread in
+            let interactionFinder = InteractionFinder(threadUniqueId: thread.uniqueId)
+            let anchorRowId = interactionFinder.rowIdOfNewestInteraction(receivedAtOrBefore: cutoffTimestamp, tx: tx)
+            if anchorRowId > 0 {
+                self.addJob(
+                    anchorMessageRowId: anchorRowId,
+                    isFullThreadDelete: false,
+                    threadUniqueId: thread.uniqueId,
+                    tx: tx,
+                )
+            }
+            return true
+        }
+
+        SSKPreferences.setLastMessageRetentionSweepAt(now, transaction: tx)
+    }
+
+    /// Throttled wrapper around `sweepMessageRetention` for routine/automatic
+    /// triggers (e.g. app launch/foreground), so we don't re-scan every
+    /// thread's messages more than once a day.
+    func sweepMessageRetentionIfNeeded(
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        guard let retentionPeriodDays = SSKPreferences.messageRetentionPeriodDays(transaction: tx) else {
+            return
+        }
+
+        if
+            let lastSweptAt = SSKPreferences.lastMessageRetentionSweepAt(transaction: tx),
+            now.timeIntervalSince(lastSweptAt) < MessageRetentionConstants.minSweepInterval
+        {
+            return
+        }
+
+        sweepMessageRetention(
+            retentionPeriodDays: retentionPeriodDays,
+            now: now,
+            threadStore: threadStore,
+            tx: tx,
+        )
+    }
 }
 
