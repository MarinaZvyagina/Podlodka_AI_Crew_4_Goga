index 0000000..fd64366
--- /dev/null
+++ b/SignalServiceKit/Messages/Retention/MessageRetentionManager.swift
@@ -0,0 +1,53 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+/// Orchestrates the "keep messages for N days" retention setting: it owns the
+/// persisted setting and keeps the durable cleanup job (see
+/// ``MessageRetentionCleanupJobQueue``) in sync with it.
+public final class MessageRetentionManager {
+    private let messageRetentionCleanupJobQueue: MessageRetentionCleanupJobQueue
+    private let messageRetentionSettingStore: MessageRetentionSettingStore
+
+    init(
+        messageRetentionCleanupJobQueue: MessageRetentionCleanupJobQueue,
+        messageRetentionSettingStore: MessageRetentionSettingStore,
+    ) {
+        self.messageRetentionCleanupJobQueue = messageRetentionCleanupJobQueue
+        self.messageRetentionSettingStore = messageRetentionSettingStore
+    }
+
+    /// `nil` means retention is disabled and history is kept forever.
+    public func retentionPeriodDays(tx: DBReadTransaction) -> UInt32? {
+        messageRetentionSettingStore.retentionPeriodDays(tx: tx)
+    }
+
+    /// Updates the retention window. This applies retroactively: if
+    /// `newValue` is smaller than before (or is set for the first time),
+    /// existing messages older than the new window are enqueued for deletion
+    /// immediately, not just messages received from now on. Pass `nil` to
+    /// disable retention and keep history forever.
+    public func setRetentionPeriodDays(_ newValue: UInt32?, tx: DBWriteTransaction) {
+        messageRetentionSettingStore.setRetentionPeriodDays(newValue, tx: tx)
+        scheduleCleanup(retentionPeriodDays: newValue, tx: tx)
+    }
+
+    /// Re-evaluates the current setting and (re)schedules cleanup accordingly.
+    /// Safe, and expected, to call on every app launch: because the cutoff is
+    /// always computed relative to "now", this is what causes older and older
+    /// messages to keep getting swept up as they age past the window, not just
+    /// the messages that were already too old when the setting was first
+    /// turned on.
+    public func reconcileScheduledCleanup(tx: DBWriteTransaction) {
+        scheduleCleanup(retentionPeriodDays: retentionPeriodDays(tx: tx), tx: tx)
+    }
+
+    private func scheduleCleanup(retentionPeriodDays: UInt32?, tx: DBWriteTransaction) {
+        guard let retentionPeriodDays else {
+            return
+        }
+        let cutoffTimestamp = NSDate.ows_millisecondTimeStamp() - UInt64(retentionPeriodDays) * UInt64.dayInMs
+        messageRetentionCleanupJobQueue.addOrUpdateJob(cutoffTimestamp: cutoffTimestamp, tx: tx)
+    }
+}
