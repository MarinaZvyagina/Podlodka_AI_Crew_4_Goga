new file mode 100644
index 0000000..759b550
--- /dev/null
+++ b/SignalServiceKit/Messages/Retention/MessageRetentionSettingStore.swift
@@ -0,0 +1,41 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+/// Persists the user's chosen message retention window: how many days of
+/// chat history to keep before older messages are automatically deleted.
+///
+/// A `nil` value means retention is disabled and history is kept forever.
+public class MessageRetentionSettingStore {
+    private enum Constants {
+        static let retentionPeriodDaysKey = "retentionPeriodDays"
+    }
+
+    private let keyValueStore: KeyValueStore
+
+    init(keyValueStore: KeyValueStore) {
+        self.keyValueStore = keyValueStore
+    }
+
+    public func retentionPeriodDays(tx: DBReadTransaction) -> UInt32? {
+        guard let storedValue = keyValueStore.getUInt32(Constants.retentionPeriodDaysKey, transaction: tx), storedValue > 0 else {
+            return nil
+        }
+        return storedValue
+    }
+
+    func setRetentionPeriodDays(_ newValue: UInt32?, tx: DBWriteTransaction) {
+        guard let newValue, newValue > 0 else {
+            keyValueStore.removeValue(forKey: Constants.retentionPeriodDaysKey, transaction: tx)
+            return
+        }
+        keyValueStore.setUInt32(newValue, key: Constants.retentionPeriodDaysKey, transaction: tx)
+    }
+
+#if TESTABLE_BUILD
+    static func mock() -> MessageRetentionSettingStore {
+        return MessageRetentionSettingStore(keyValueStore: KeyValueStore(collection: "MessageRetentionSettingStoreTest"))
+    }
+#endif
+}
