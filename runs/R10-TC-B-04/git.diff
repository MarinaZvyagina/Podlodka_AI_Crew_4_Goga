+++ b/Signal/src/ViewControllers/AppSettings/MessageRetentionSettingsViewController.swift
@@ -0,0 +1,76 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+import SignalServiceKit
+import SignalUI
+
+class MessageRetentionSettingsViewController: OWSTableViewController2 {
+    /// `nil` represents "keep messages forever" (retention disabled).
+    private static let options: [UInt32?] = [nil, 30, 90, 365]
+
+    private var selectedRetentionPeriodDays: UInt32?
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+
+        title = OWSLocalizedString(
+            "MESSAGE_RETENTION_SETTINGS_TITLE",
+            comment: "Title for the message retention settings view.",
+        )
+
+        selectedRetentionPeriodDays = SSKEnvironment.shared.databaseStorageRef.read { tx in
+            DependenciesBridge.shared.messageRetentionManager.retentionPeriodDays(tx: tx)
+        }
+
+        updateTableContents()
+    }
+
+    private func updateTableContents() {
+        let contents = OWSTableContents()
+
+        let section = OWSTableSection()
+        section.footerTitle = OWSLocalizedString(
+            "MESSAGE_RETENTION_SETTINGS_FOOTER",
+            comment: "Footer explaining that messages older than the chosen retention window are deleted from every chat, and that changing it applies to existing history too.",
+        )
+
+        for retentionPeriodDays in Self.options {
+            section.add(OWSTableItem(
+                text: Self.title(forRetentionPeriodDays: retentionPeriodDays),
+                actionBlock: { [weak self] in
+                    self?.didSelect(retentionPeriodDays: retentionPeriodDays)
+                },
+                accessoryType: retentionPeriodDays == selectedRetentionPeriodDays ? .checkmark : .none,
+            ))
+        }
+        contents.add(section)
+
+        self.contents = contents
+    }
+
+    private func didSelect(retentionPeriodDays: UInt32?) {
+        guard retentionPeriodDays != selectedRetentionPeriodDays else { return }
+
+        selectedRetentionPeriodDays = retentionPeriodDays
+        SSKEnvironment.shared.databaseStorageRef.write { tx in
+            DependenciesBridge.shared.messageRetentionManager.setRetentionPeriodDays(retentionPeriodDays, tx: tx)
+        }
+        updateTableContents()
+    }
+
+    static func title(forRetentionPeriodDays retentionPeriodDays: UInt32?) -> String {
+        guard let retentionPeriodDays else {
+            return OWSLocalizedString(
+                "MESSAGE_RETENTION_SETTINGS_OFF",
+                comment: "Option to disable automatic deletion of old messages, keeping chat history forever.",
+            )
+        }
+        let format = OWSLocalizedString(
+            "MESSAGE_RETENTION_SETTINGS_DAYS_FORMAT",
+            comment: "Option describing how many days of chat history are kept before older messages are automatically deleted. Embeds {{ the number of days }}.",
+        )
+        return String(format: format, retentionPeriodDays)
+    }
+}
