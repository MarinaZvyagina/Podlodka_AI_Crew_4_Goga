diff --git a/SignalServiceKit/Jobs/JobRecords/MessageRetentionCleanupJobRecord.swift b/SignalServiceKit/Jobs/JobRecords/MessageRetentionCleanupJobRecord.swift
new file mode 100644
index 0000000..5f4bf23
--- /dev/null
+++ b/SignalServiceKit/Jobs/JobRecords/MessageRetentionCleanupJobRecord.swift
@@ -0,0 +1,50 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+/// Deletes every interaction, across every thread, received at or before a
+/// fixed cutoff timestamp.
+///
+/// At most one of these jobs should exist at a time; the cutoff is updated
+/// in place (see ``MessageRetentionCleanupJobQueue/addOrUpdateJob``) whenever
+/// the user's retention window setting changes, rather than enqueueing a
+/// second, competing job.
+final class MessageRetentionCleanupJobRecord: JobRecord {
+    override class var jobRecordType: JobRecord.JobRecordType { .messageRetentionCleanup }
+
+    /// Interactions received at or before this timestamp (milliseconds since
+    /// epoch) should be deleted.
+    private(set) var cutoffTimestamp: UInt64
+
+    init(
+        cutoffTimestamp: UInt64,
+        failureCount: UInt = 0,
+        status: Status = .ready,
+    ) {
+        self.cutoffTimestamp = cutoffTimestamp
+
+        super.init(
+            failureCount: failureCount,
+            status: status,
+        )
+    }
+
+    required init(inheritableDecoder decoder: any Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+
+        cutoffTimestamp = try container.decode(UInt64.self, forKey: .MRCJR_cutoffTimestamp)
+
+        try super.init(inheritableDecoder: decoder)
+    }
+
+    override func encode(to encoder: any Encoder) throws {
+        try super.encode(to: encoder)
+        var container = encoder.container(keyedBy: CodingKeys.self)
+        try container.encode(cutoffTimestamp, forKey: .MRCJR_cutoffTimestamp)
+    }
+
+    func updateCutoffTimestamp(_ newValue: UInt64, tx: DBWriteTransaction) {
+        anyUpdate(transaction: tx) { $0.cutoffTimestamp = newValue }
+    }
+}
diff --git a/SignalServiceKit/Jobs/MessageRetentionCleanupJobQueue.swift b/SignalServiceKit/Jobs/MessageRetentionCleanupJobQueue.swift
new file mode 100644
index 0000000..f6d7ced
--- /dev/null
+++ b/SignalServiceKit/Jobs/MessageRetentionCleanupJobQueue.swift
@@ -0,0 +1,224 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+/// Enforces a user-configured message retention window by deleting
+/// interactions, across every conversation, that are older than a cutoff.
+///
+/// The cleanup is durable (backed by a ``MessageRetentionCleanupJobRecord``)
+/// and batches its deletes with ``TimeGatedBatch``, so it's safe to run over
+/// arbitrarily large histories: it never blocks the main thread, and if the
+/// app is killed, backgrounded, or the user signs out partway through, the
+/// job simply resumes (or is discarded, on sign-out) the next time it's
+/// started, without leaving any thread in a partially-deleted state, since
+/// each batch is deleted in its own committed transaction.
+public final class MessageRetentionCleanupJobQueue {
+    private let jobRunnerFactory: MessageRetentionCleanupJobRunnerFactory
+    private let jobQueueRunner: JobQueueRunner<
+        JobRecordFinderImpl<MessageRetentionCleanupJobRecord>,
+        MessageRetentionCleanupJobRunnerFactory,
+    >
+    private let db: any DB
+    private var jobSerializer = CompletionSerializer()
+
+    init(
+        db: any DB,
+        interactionDeleteManager: InteractionDeleteManager,
+        threadStore: ThreadStore,
+    ) {
+        self.db = db
+        self.jobRunnerFactory = MessageRetentionCleanupJobRunnerFactory(
+            db: db,
+            interactionDeleteManager: interactionDeleteManager,
+            threadStore: threadStore,
+        )
+        self.jobQueueRunner = JobQueueRunner(
+            canExecuteJobsConcurrently: false,
+            db: db,
+            jobFinder: JobRecordFinderImpl(db: db),
+            jobRunnerFactory: self.jobRunnerFactory,
+        )
+    }
+
+    func start(appContext: AppContext) {
+        jobQueueRunner.start(shouldRestartExistingJobs: appContext.isMainApp)
+    }
+
+    /// Ensures a single cleanup job exists with the given cutoff, updating an
+    /// already-enqueued job in place rather than enqueueing a second one.
+    ///
+    /// Pass `nil` to indicate retention is disabled; this leaves any
+    /// already-running job to finish (it can only delete messages that were
+    /// already past its previously-configured cutoff), but won't create a new
+    /// one.
+    func addOrUpdateJob(cutoffTimestamp: UInt64?, tx: DBWriteTransaction) {
+        guard let cutoffTimestamp else {
+            return
+        }
+
+        if let existingJobRecord = Self.findExistingJobRecord(tx: tx) {
+            existingJobRecord.updateCutoffTimestamp(cutoffTimestamp, tx: tx)
+            return
+        }
+
+        let jobRecord = MessageRetentionCleanupJobRecord(cutoffTimestamp: cutoffTimestamp)
+        jobRecord.anyInsert(transaction: tx)
+
+        jobSerializer.addOrderedSyncCompletion(tx: tx) {
+            self.jobQueueRunner.addPersistedJob(jobRecord)
+        }
+    }
+
+    private static func findExistingJobRecord(tx: DBReadTransaction) -> MessageRetentionCleanupJobRecord? {
+        let sql = """
+        SELECT * FROM \(MessageRetentionCleanupJobRecord.databaseTableName)
+        WHERE "\(MessageRetentionCleanupJobRecord.columnName(.label))" = ?
+        LIMIT 1
+        """
+        return try? MessageRetentionCleanupJobRecord.fetchOne(
+            tx.database,
+            sql: sql,
+            arguments: [MessageRetentionCleanupJobRecord.jobRecordType.jobRecordLabel],
+        )
+    }
+}
+
+// MARK: -
+
+private class MessageRetentionCleanupJobRunner: JobRunner {
+    typealias JobRecordType = MessageRetentionCleanupJobRecord
+
+    private enum Constants {
+        static let maxRetries: UInt = 110
+        static let deletionBatchSize: Int = 500
+    }
+
+    private let db: any DB
+    private let interactionDeleteManager: InteractionDeleteManager
+    private let threadStore: ThreadStore
+
+    private let logger = PrefixedLogger(prefix: "[MessageRetention]")
+
+    init(
+        db: any DB,
+        interactionDeleteManager: InteractionDeleteManager,
+        threadStore: ThreadStore,
+    ) {
+        self.db = db
+        self.interactionDeleteManager = interactionDeleteManager
+        self.threadStore = threadStore
+    }
+
+    func runJobAttempt(_ jobRecord: MessageRetentionCleanupJobRecord) async -> JobAttemptResult<Void> {
+        return await JobAttemptResult.executeBlockWithDefaultErrorHandler(
+            jobRecord: jobRecord,
+            retryLimit: Constants.maxRetries,
+            db: db,
+            block: {
+                try await self._runJobAttempt(jobRecord)
+            },
+        )
+    }
+
+    func didFinishJob(_ jobRecordId: JobRecord.RowId, result: JobResult<Void>) async {
+        switch result.ranSuccessfullyOrError {
+        case .success:
+            break
+        case .failure(let failure):
+            logger.error("Failed to perform message retention cleanup! \(failure)")
+        }
+    }
+
+    private func _runJobAttempt(_ jobRecord: MessageRetentionCleanupJobRecord) async throws {
+        let cutoffTimestamp = jobRecord.cutoffTimestamp
+
+        logger.info("Attempting to delete interactions received before \(cutoffTimestamp).")
+
+        var deletedCount = 0
+        await TimeGatedBatch.processAll(db: db) { tx -> TimeGatedBatch.ProcessBatchResult<Void> in
+            let batchDeletedCount = self.deleteSomeInteractions(cutoffTimestamp: cutoffTimestamp, tx: tx)
+            deletedCount += batchDeletedCount
+            return batchDeletedCount == 0 ? .done(()) : .more
+        }
+
+        logger.info("Deleted \(deletedCount) messages for retention cleanup before \(cutoffTimestamp).")
+
+        await db.awaitableWrite { tx in
+            jobRecord.anyRemove(transaction: tx)
+        }
+    }
+
+    /// Deletes a batch of interactions and returns how many were deleted. A
+    /// return value of 0 means there's nothing left to delete.
+    private func deleteSomeInteractions(cutoffTimestamp: UInt64, tx: DBWriteTransaction) -> Int {
+        let interactionsToDelete = InteractionFinder.oldestInteractions(
+            receivedAtOrBefore: cutoffTimestamp,
+            limit: Constants.deletionBatchSize,
+            transaction: tx,
+        )
+
+        if interactionsToDelete.isEmpty { return 0 }
+
+        var affectedThreadUniqueIds = Set<String>()
+        for interaction in interactionsToDelete {
+            affectedThreadUniqueIds.insert(interaction.uniqueThreadId)
+            interactionDeleteManager.delete(
+                interaction,
+                sideEffects: .custom(
+                    associatedCallDelete: .localDeleteOnly,
+                    updateThreadOnInteractionDelete: .doNotUpdate,
+                ),
+                tx: tx,
+            )
+        }
+
+        /// We skipped the per-interaction thread update above (it's
+        /// comparatively expensive) in favor of a single update per affected
+        /// thread once per transaction, so that anyone reading in between our
+        /// time-gated batches sees threads with up-to-date previews & unread
+        /// counts.
+        tx.addFinalizationBlock(key: "MessageRetentionCleanupJobQueue") { tx in
+            for threadUniqueId in affectedThreadUniqueIds {
+                guard let thread = self.threadStore.fetchThread(uniqueId: threadUniqueId, tx: tx) else {
+                    continue
+                }
+                thread.updateOnInteractionsRemoved(
+                    needsToUpdateLastInteractionRowId: true,
+                    needsToUpdateLastVisibleSortId: true,
+                    tx: tx,
+                )
+            }
+        }
+
+        return interactionsToDelete.count
+    }
+}
+
+// MARK: -
+
+private class MessageRetentionCleanupJobRunnerFactory: JobRunnerFactory {
+    typealias JobRunnerType = MessageRetentionCleanupJobRunner
+
+    private let db: any DB
+    private let interactionDeleteManager: InteractionDeleteManager
+    private let threadStore: ThreadStore
+
+    init(
+        db: any DB,
+        interactionDeleteManager: InteractionDeleteManager,
+        threadStore: ThreadStore,
+    ) {
+        self.db = db
+        self.interactionDeleteManager = interactionDeleteManager
+        self.threadStore = threadStore
+    }
+
+    func buildRunner() -> MessageRetentionCleanupJobRunner {
+        return MessageRetentionCleanupJobRunner(
+            db: db,
+            interactionDeleteManager: interactionDeleteManager,
+            threadStore: threadStore,
+        )
+    }
+}
diff --git a/SignalServiceKit/Messages/Retention/MessageRetentionManager.swift b/SignalServiceKit/Messages/Retention/MessageRetentionManager.swift
