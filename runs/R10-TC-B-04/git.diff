diff --git a/Signal/src/ViewControllers/AppSettings/MessageRetentionSettingsViewController.swift b/Signal/src/ViewControllers/AppSettings/MessageRetentionSettingsViewController.swift
new file mode 100644
index 0000000..9f4a889
