index 10ddd2a..5b963ff 100644
--- a/SignalServiceKit/Storage/Database/Records/InteractionFinder.swift
+++ b/SignalServiceKit/Storage/Database/Records/InteractionFinder.swift
@@ -1347,6 +1347,27 @@ public class InteractionFinder: NSObject {
 
         return mostRecentRowId
     }
+
+    /// The SQLite row ID of the newest interaction in this thread that was
+    /// received at or before `receivedAtOrBefore`, or `0` if there is none.
+    func rowIdOfNewestInteraction(receivedAtOrBefore: UInt64, tx: DBReadTransaction) -> Int64 {
+        let sql = """
+        SELECT MAX(\(interactionColumn: .id))
+        FROM \(InteractionRecord.databaseTableName)
+        WHERE \(interactionColumn: .threadUniqueId) = ?
+        AND \(interactionColumn: .receivedAtTimestamp) <= ?
+        """
+        do {
+            return try Int64.fetchOne(
+                tx.database,
+                sql: sql,
+                arguments: [threadUniqueId, receivedAtOrBefore],
+            ) ?? 0
+        } catch {
+            owsFailDebug("Failed to find newest interaction row ID at or before cutoff: \(error)")
+            return 0
+        }
+    }
 }
 
