+    // MARK: - Message Retention
+
+    private static let messageRetentionPeriodDaysOptions: [UInt32?] = [nil, 30, 90, 365]
+
+    private func formatMessageRetentionPeriodDays(_ days: UInt32?) -> String {
+        guard let days else {
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_FOREVER",
+                comment: "Option indicating that chat history should be kept forever.",
+            )
+        }
+        if days == 365 {
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_1_YEAR",
+                comment: "Option indicating that chat history should be kept for 1 year.",
+            )
+        }
+        let format = OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_N_DAYS_FORMAT",
+            comment: "Option indicating that chat history should be kept for a number of days. Embeds {{ the number of days }}.",
+        )
+        return String(format: format, days)
+    }
+
+    private func showMessageRetentionPicker() {
+        let actionSheet = ActionSheetController(title: OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_TITLE",
+            comment: "Title for setting that lets the user automatically delete old messages after a chosen number of days.",
+        ))
+
+        for days in Self.messageRetentionPeriodDaysOptions {
+            actionSheet.addAction(.init(
+                title: formatMessageRetentionPeriodDays(days),
+                handler: { [weak self] _ in
+                    self?.didSelectMessageRetentionPeriodDays(days)
+                },
+            ))
+        }
+
+        actionSheet.addAction(OWSActionSheets.cancelAction)
+
+        presentActionSheet(actionSheet)
+    }
+
+    private func didSelectMessageRetentionPeriodDays(_ days: UInt32?) {
+        Logger.info("selected message retention period days: \(String(describing: days))")
+
+        let threadStore = DependenciesBridge.shared.threadStore
+        let bulkDeleteInteractionJobQueue = SSKEnvironment.shared.bulkDeleteInteractionJobQueueRef
+
+        SSKEnvironment.shared.databaseStorageRef.asyncWrite { tx in
+            SSKPreferences.setMessageRetentionPeriodDays(days, transaction: tx)
+
+            if let days {
+                // Apply retroactively, immediately, rather than waiting for
+                // the throttled launch/foreground sweep.
+                bulkDeleteInteractionJobQueue.sweepMessageRetention(
+                    retentionPeriodDays: days,
+                    now: Date(),
+                    threadStore: threadStore,
+                    tx: tx,
+                )
+            }
+        } completion: { [weak self] in
+            self?.updateTableContents()
+        }
+    }
