+    // MARK: - Message Retention
+
+    private static let messageRetentionPeriodDaysOptions: [UInt32?] = [nil, 30, 90, 365]
+
+    private func showMessageRetentionPicker() {
+        let actionSheet = ActionSheetController(title: OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_TITLE",
+            comment: "Label for the 'keep messages' retention setting in the Chats settings.",
+        ))
+
+        for option in Self.messageRetentionPeriodDaysOptions {
+            actionSheet.addAction(.init(
+                title: formatMessageRetentionPeriodDays(option),
+                handler: { [weak self] _ in
+                    self?.didSelectMessageRetentionPeriodDays(option)
+                },
+            ))
+        }
+
+        actionSheet.addAction(OWSActionSheets.cancelAction)
+
+        presentActionSheet(actionSheet)
+    }
+
+    private func didSelectMessageRetentionPeriodDays(_ newValue: UInt32?) {
+        Logger.info("selected: \(String(describing: newValue))")
+        let db = DependenciesBridge.shared.db
+        let threadStore = DependenciesBridge.shared.threadStore
+        let bulkDeleteInteractionJobQueue = SSKEnvironment.shared.bulkDeleteInteractionJobQueueRef
+
+        db.write { tx in
+            SSKPreferences.setMessageRetentionPeriodDays(newValue, transaction: tx)
+
+            // Apply retroactively right away, rather than waiting for the
+            // next throttled sweep.
+            if let newValue {
+                bulkDeleteInteractionJobQueue.sweepMessageRetention(
+                    retentionPeriodDays: newValue,
+                    now: Date(),
+                    threadStore: threadStore,
+                    tx: tx,
+                )
+            }
+        }
+
+        updateTableContents()
+    }
+
+    private func formatMessageRetentionPeriodDays(_ value: UInt32?) -> String {
+        guard let value else {
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_FOREVER",
+                comment: "Indicates that chat history is kept forever, in the 'keep messages' retention setting.",
+            )
+        }
+        if value == 365 {
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_1_YEAR",
+                comment: "Indicates that chat history is kept for one year, in the 'keep messages' retention setting.",
+            )
+        }
+        let format = OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_N_DAYS_FORMAT",
+            comment: "Indicates that chat history is kept for a number of days, in the 'keep messages' retention setting. Embeds {{ the number of days }}.",
+        )
+        return String(format: format, Int(value))
+    }
