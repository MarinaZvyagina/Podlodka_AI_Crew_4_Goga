             self.jobQueueRunner.addPersistedJob(jobRecord)
         }
     }
+
+    // MARK: - Message Retention
+
+    private enum RetentionConstants {
+        static let secondsPerDay: TimeInterval = 24 * 60 * 60
+
+        /// Don't bother re-sweeping more often than this, since a sweep just
+        /// enqueues no-op jobs for threads that have nothing new to delete.
+        static let minSweepInterval: TimeInterval = secondsPerDay
+    }
+
+    /// Enqueues a bulk-delete job for every thread with messages older than
+    /// the given retention window, unconditionally (i.e., regardless of when
+    /// we last swept). Used when the user changes the retention setting, so
+    /// the new window is applied retroactively right away.
+    public func sweepMessageRetention(
+        retentionPeriodDays: UInt32,
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        let retentionInterval = TimeInterval(retentionPeriodDays) * RetentionConstants.secondsPerDay
+        let cutoffTimestamp = (now - retentionInterval).ows_millisecondsSince1970
+
+        threadStore.enumerateNonStoryThreads(tx: tx) { thread in
+            if
+                let anchorRowId = InteractionFinder(threadUniqueId: thread.uniqueId)
+                    .rowIdOfNewestInteraction(receivedAtOrBefore: cutoffTimestamp, tx: tx)
+            {
+                self.addJob(
+                    anchorMessageRowId: anchorRowId,
+                    isFullThreadDelete: false,
+                    threadUniqueId: thread.uniqueId,
+                    tx: tx,
+                )
+            }
+            return true
+        }
+
+        SSKPreferences.setLastMessageRetentionSweepAt(now, transaction: tx)
+    }
+
+    /// Throttled variant of `sweepMessageRetention`, for routine/automatic
+    /// triggers (app launch, foregrounding). No-ops if retention is disabled
+    /// or we swept recently.
+    func sweepMessageRetentionIfNeeded(
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        guard let retentionPeriodDays = SSKPreferences.messageRetentionPeriodDays(transaction: tx) else {
+            return
+        }
+
+        if
+            let lastSweepAt = SSKPreferences.lastMessageRetentionSweepAt(transaction: tx),
+            now.timeIntervalSince(lastSweepAt) < RetentionConstants.minSweepInterval
+        {
+            return
+        }
+
+        sweepMessageRetention(
+            retentionPeriodDays: retentionPeriodDays,
+            now: now,
+            threadStore: threadStore,
+            tx: tx,
+        )
+    }
 }
 
