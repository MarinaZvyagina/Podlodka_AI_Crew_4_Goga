+    // MARK: - Message Retention
+
+    /// `nil` represents "forever" (no automatic deletion).
+    private static let messageRetentionPeriodDaysOptions: [UInt32?] = [nil, 30, 90, 365]
+
+    private static func formatMessageRetentionPeriodDays(_ days: UInt32?) -> String {
+        guard let days else {
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_FOREVER",
+                comment: "Label indicating that chat history is kept forever, in the 'keep messages' setting picker.",
+            )
+        }
+        if days == 365 {
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_1_YEAR",
+                comment: "Label indicating that chat history is kept for 1 year, in the 'keep messages' setting picker.",
+            )
+        }
+        let format = OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_N_DAYS_FORMAT",
+            comment: "Label indicating that chat history is kept for a number of days, in the 'keep messages' setting picker. Embeds {{ the number of days }}.",
+        )
+        return String(format: format, days)
+    }
+
+    private func showMessageRetentionPicker() {
+        let actionSheet = ActionSheetController(title: OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_TITLE",
+            comment: "Label for the 'keep messages' setting, which lets the user choose how long to keep chat history before it's automatically deleted.",
+        ))
+
+        for option in Self.messageRetentionPeriodDaysOptions {
+            actionSheet.addAction(.init(
+                title: Self.formatMessageRetentionPeriodDays(option),
+                handler: { [weak self] _ in
+                    self?.didSelectMessageRetentionPeriodDays(option)
+                },
+            ))
+        }
+
+        actionSheet.addAction(OWSActionSheets.cancelAction)
+
+        presentActionSheet(actionSheet)
+    }
+
+    private func didSelectMessageRetentionPeriodDays(_ days: UInt32?) {
+        Logger.info("selected message retention period days: \(String(describing: days))")
+
+        SSKEnvironment.shared.databaseStorageRef.asyncWrite { tx in
+            SSKPreferences.setMessageRetentionPeriodDays(days, transaction: tx)
+
+            // Apply retroactively (bypassing the sweep throttle) so a newly
+            // set or changed window takes effect immediately rather than
+            // waiting for the next throttled sweep.
+            guard let days else { return }
+            SSKEnvironment.shared.bulkDeleteInteractionJobQueueRef.sweepMessageRetention(
+                retentionPeriodDays: days,
+                now: Date(),
+                threadStore: DependenciesBridge.shared.threadStore,
+                tx: tx,
+            )
+        }
+
+        updateTableContents()
+    }
