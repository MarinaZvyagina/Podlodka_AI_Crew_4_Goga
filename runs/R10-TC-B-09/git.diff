+    // MARK: - Message Retention
+
+    private enum RetentionConstants {
+        /// The minimum time between automatic (non-user-initiated) retention
+        /// sweeps, to avoid re-scanning every thread on every foreground.
+        static let minSweepInterval: TimeInterval = 24 * 60 * 60
+    }
+
+    /// Enumerates all (non-story) threads and enqueues a bulk-delete job for
+    /// any thread with messages older than the given retention window. Safe
+    /// to call unconditionally/repeatedly: threads with nothing to delete are
+    /// skipped, and jobs are resumable/idempotent via the existing job queue.
+    public func sweepMessageRetention(
+        retentionPeriodDays: UInt32,
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        let secondsPerDay: TimeInterval = 24 * 60 * 60
+        let cutoffDate = now.addingTimeInterval(-TimeInterval(retentionPeriodDays) * secondsPerDay)
+        let cutoffTimestamp = cutoffDate.ows_millisecondsSince1970
+
+        threadStore.enumerateNonStoryThreads(tx: tx) { thread -> Bool in
+            let anchorMessageRowId = InteractionFinder(threadUniqueId: thread.uniqueId)
+                .rowIdOfNewestInteraction(receivedAtOrBefore: cutoffTimestamp, tx: tx)
+
+            if anchorMessageRowId > 0 {
+                self.addJob(
+                    anchorMessageRowId: anchorMessageRowId,
+                    isFullThreadDelete: false,
+                    threadUniqueId: thread.uniqueId,
+                    tx: tx,
+                )
+            }
+
+            return true
+        }
+    }
+
+    /// Throttled wrapper around `sweepMessageRetention`, intended for
+    /// routine/automatic triggers (app launch, foregrounding). No-ops if
+    /// retention is disabled or a sweep ran too recently.
+    func sweepMessageRetentionIfNeeded(
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        guard let retentionPeriodDays = SSKPreferences.messageRetentionPeriodDays(transaction: tx) else {
+            return
+        }
+
+        if
+            let lastSweepAt = SSKPreferences.lastMessageRetentionSweepAt(transaction: tx),
+            now.timeIntervalSince(lastSweepAt) < RetentionConstants.minSweepInterval
+        {
+            return
+        }
+
+        sweepMessageRetention(
+            retentionPeriodDays: retentionPeriodDays,
+            now: now,
+            threadStore: threadStore,
+            tx: tx,
+        )
+        SSKPreferences.setLastMessageRetentionSweepAt(now, transaction: tx)
+    }
 }
 
