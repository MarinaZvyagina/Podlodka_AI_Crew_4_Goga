             self.jobQueueRunner.addPersistedJob(jobRecord)
         }
     }
+
+    // MARK: - Message Retention
+
+    private enum MessageRetentionConstants {
+        static let secondsPerDay: TimeInterval = 24 * 60 * 60
+        static let minSweepInterval: TimeInterval = 24 * 60 * 60
+    }
+
+    /// Enumerates every non-story thread and enqueues a bulk-delete job for
+    /// any thread that has messages older than the given retention window.
+    public func sweepMessageRetention(
+        retentionPeriodDays: UInt32,
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        let cutoffDate = now.addingTimeInterval(
+            -TimeInterval(retentionPeriodDays) * MessageRetentionConstants.secondsPerDay,
+        )
+        let cutoffTimestamp = cutoffDate.ows_millisecondsSince1970
+
+        threadStore.enumerateNonStoryThreads(tx: tx) { thread in
+            let anchorRowId = InteractionFinder(threadUniqueId: thread.uniqueId)
+                .rowIdOfNewestInteraction(receivedAtOrBefore: cutoffTimestamp, tx: tx)
+
+            if anchorRowId > 0 {
+                self.addJob(
+                    anchorMessageRowId: anchorRowId,
+                    isFullThreadDelete: false,
+                    threadUniqueId: thread.uniqueId,
+                    tx: tx,
+                )
+            }
+
+            return true
+        }
+
+        SSKPreferences.setLastMessageRetentionSweepAt(now, transaction: tx)
+    }
+
+    /// A throttled wrapper around `sweepMessageRetention`, suitable for
+    /// routine/automatic triggers (app launch, foregrounding). Does nothing
+    /// if retention is disabled or if a sweep already ran recently.
+    func sweepMessageRetentionIfNeeded(
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        guard let retentionPeriodDays = SSKPreferences.messageRetentionPeriodDays(transaction: tx) else {
+            return
+        }
+
+        if
+            let lastSweepAt = SSKPreferences.lastMessageRetentionSweepAt(transaction: tx),
+            now.timeIntervalSince(lastSweepAt) < MessageRetentionConstants.minSweepInterval
+        {
+            return
+        }
+
+        sweepMessageRetention(
+            retentionPeriodDays: retentionPeriodDays,
+            now: now,
+            threadStore: threadStore,
+            tx: tx,
+        )
+    }
 }
 
