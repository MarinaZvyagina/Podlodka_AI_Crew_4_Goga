@@ -1330,6 +1330,28 @@ public class InteractionFinder: NSObject {
 
     // MARK: -
 
+    /// The SQLite row ID of the newest interaction in this finder's thread
+    /// whose `receivedAtTimestamp` is at or before the given timestamp, or
+    /// `0` if there is no such interaction.
+    func rowIdOfNewestInteraction(receivedAtOrBefore timestamp: UInt64, tx: DBReadTransaction) -> Int64 {
+        let sql = """
+        SELECT MAX(\(interactionColumn: .id))
+        FROM \(InteractionRecord.databaseTableName)
+        WHERE \(interactionColumn: .threadUniqueId) = ?
+        AND \(interactionColumn: .receivedAtTimestamp) <= ?
+        """
+        do {
+            return try Int64.fetchOne(
+                tx.database,
+                sql: sql,
+                arguments: [threadUniqueId, timestamp],
+            ) ?? 0
+        } catch {
+            owsFailDebug("Failed to find newest interaction row ID at or before timestamp: \(error)")
+            return 0
+        }
+    }
+
