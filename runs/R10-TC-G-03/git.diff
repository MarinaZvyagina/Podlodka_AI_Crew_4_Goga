diff --git a/SignalServiceKit/MessageRetention/MessageRetentionExpirationJob.swift b/SignalServiceKit/MessageRetention/MessageRetentionExpirationJob.swift
new file mode 100644
index 0000000..9052014
--- /dev/null
+++ b/SignalServiceKit/MessageRetention/MessageRetentionExpirationJob.swift
@@ -0,0 +1,88 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+/// Continuously deletes messages older than the user's configured
+/// ``MessageRetentionSettingsStore`` retention window, across every
+/// conversation.
+///
+/// This follows the same shape as ``DisappearingMessagesExpirationJob``:
+/// each pass re-derives its work (the oldest remaining interaction, and
+/// today's cutoff) directly from the database rather than from any
+/// persisted checkpoint. That makes it naturally resumable — if the app is
+/// killed, backgrounded, or loses network mid-sweep, the next launch's pass
+/// simply picks up wherever the data was left, deleting forward from the
+/// oldest surviving message instead of restarting the whole sweep. Deletes
+/// are committed in small batches (see ``TimeGatedBatch``), so a large
+/// backlog (e.g. a first-time retroactive cleanup) can't hold one long
+/// write transaction or block the UI.
+public final class MessageRetentionExpirationJob: ExpirationJob<TSInteraction> {
+    private let interactionDeleteManager: InteractionDeleteManager
+    private let messageRetentionSettingsStore: MessageRetentionSettingsStore
+
+    /// The retention window observed the last time `nextExpiringElement`
+    /// ran, cached so `expirationDate(ofElement:)` — which has no
+    /// transaction of its own — can use the same value without re-reading
+    /// the setting mid-computation.
+    private let cachedRetentionPeriodDays: AtomicValue<UInt32?>
+
+    init(
+        dateProvider: @escaping DateProvider,
+        db: DB,
+        interactionDeleteManager: InteractionDeleteManager,
+        messageRetentionSettingsStore: MessageRetentionSettingsStore,
+    ) {
+        self.interactionDeleteManager = interactionDeleteManager
+        self.messageRetentionSettingsStore = messageRetentionSettingsStore
+        self.cachedRetentionPeriodDays = AtomicValue(nil, lock: .init())
+
+        super.init(
+            dateProvider: dateProvider,
+            db: db,
+            logger: PrefixedLogger(prefix: "[MessageRetentionExpJob]"),
+        )
+    }
+
+    // MARK: -
+
+    override public func nextExpiringElement(tx: DBReadTransaction) -> TSInteraction? {
+        let retentionPeriodDays = messageRetentionSettingsStore.retentionPeriodDays(tx: tx)
+        cachedRetentionPeriodDays.set(retentionPeriodDays)
+
+        guard retentionPeriodDays != nil else {
+            // Retention cleanup is disabled; nothing is ever "expiring".
+            return nil
+        }
+
+        return InteractionFinder.oldestInteractionForRetention(transaction: tx)
+    }
+
+    override public func expirationDate(ofElement interaction: TSInteraction) -> Date {
+        guard let retentionPeriodDays = cachedRetentionPeriodDays.get() else {
+            return .distantFuture
+        }
+        let retentionPeriodMs = UInt64(retentionPeriodDays) * UInt64.dayInMs
+        return Date(millisecondsSince1970: interaction.receivedAtTimestamp + retentionPeriodMs)
+    }
+
+    override public func deleteExpiredElement(_ interaction: TSInteraction, tx: DBWriteTransaction) {
+        interactionDeleteManager.delete(
+            interaction,
+            sideEffects: .custom(associatedCallDelete: .localDeleteOnly),
+            tx: tx,
+        )
+    }
+
+    // MARK: -
+
+    /// Tells the job that the retention window setting just changed (e.g.
+    /// the user turned it on, off, or shortened/lengthened the window from
+    /// Settings). This may unblock deletions that were previously waiting on
+    /// a far-future expiration date, and it makes turning retention on for
+    /// the first time apply retroactively to existing history rather than
+    /// only to future messages.
+    public func settingsDidChange() {
+        restart()
+    }
+}
diff --git a/SignalServiceKit/MessageRetention/MessageRetentionSettingsStore.swift b/SignalServiceKit/MessageRetention/MessageRetentionSettingsStore.swift
new file mode 100644
index 0000000..c82bebd
--- /dev/null
+++ b/SignalServiceKit/MessageRetention/MessageRetentionSettingsStore.swift
@@ -0,0 +1,40 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+import Foundation
+
+/// Stores the user's global message retention window preference.
+///
+/// When set, messages older than the configured number of days are
+/// eligible for automatic deletion by ``MessageRetentionExpirationJob``,
+/// across every conversation. A `nil` value means retention-based cleanup
+/// is disabled and no messages are automatically deleted for being old.
+public class MessageRetentionSettingsStore {
+    private let kvStore = KeyValueStore(collection: "MessageRetentionSettingsStore")
+
+    private var retentionPeriodDaysKey: String { "retentionPeriodDays" }
+
+    public init() {}
+
+    /// The number of days of message history to retain, or `nil` if
+    /// retention-based automatic cleanup is disabled.
+    public func retentionPeriodDays(tx: DBReadTransaction) -> UInt32? {
+        let rawValue = kvStore.getUInt32(retentionPeriodDaysKey, defaultValue: 0, transaction: tx)
+        return rawValue > 0 ? rawValue : nil
+    }
+
+    /// Sets the number of days of message history to retain. Pass `nil` to
+    /// disable retention-based automatic cleanup.
+    ///
+    /// - Important
+    /// This does not, by itself, cause any cleanup to happen. Callers should
+    /// also call ``MessageRetentionExpirationJob/settingsDidChange()`` (after
+    /// this transaction commits) so a running job picks up the change and,
+    /// if a shorter window was just configured, retroactively sweeps
+    /// existing history.
+    public func setRetentionPeriodDays(_ retentionPeriodDays: UInt32?, tx: DBWriteTransaction) {
+        kvStore.setUInt32(retentionPeriodDays ?? 0, key: retentionPeriodDaysKey, transaction: tx)
+    }
+}
diff --git a/SignalServiceKit/Storage/Database/Records/InteractionFinder.swift b/SignalServiceKit/Storage/Database/Records/InteractionFinder.swift
index 10ddd2a..989b517 100644
--- a/SignalServiceKit/Storage/Database/Records/InteractionFinder.swift
+++ b/SignalServiceKit/Storage/Database/Records/InteractionFinder.swift
@@ -250,6 +250,33 @@ public class InteractionFinder: NSObject {
 
     // MARK: -
 
+    /// Returns the oldest interaction (by `receivedAtTimestamp`) across every
+    /// conversation, regardless of whether it's actually eligible for
+    /// deletion under the current message retention window.
+    ///
+    /// Used by ``MessageRetentionExpirationJob`` to find the next candidate
+    /// for retention-based cleanup.
+    public class func oldestInteractionForRetention(
+        transaction: DBReadTransaction,
+    ) -> TSInteraction? {
+        let sql = """
+        SELECT *
+        FROM \(InteractionRecord.databaseTableName)
+        ORDER BY \(interactionColumn: .receivedAtTimestamp) ASC
+        LIMIT 1
+        """
+        let cursor = TSInteraction.grdbFetchCursor(
+            sql: sql,
+            transaction: transaction,
+        )
+
+        return failIfThrows {
+            try cursor.next()
+        }
+    }
+
+    // MARK: -
+
     public class func interactions(
         withInteractionIds interactionIds: Set<String>,
         transaction: DBReadTransaction,
