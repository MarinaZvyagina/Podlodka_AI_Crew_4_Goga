diff --git a/SignalServiceKit/Util/MessageRetentionManager.swift b/SignalServiceKit/Util/MessageRetentionManager.swift
new file mode 100644
index 0000000..3f67ff9
--- /dev/null
+++ b/SignalServiceKit/Util/MessageRetentionManager.swift
@@ -0,0 +1,85 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+import Foundation
+
+extension NSNotification.Name {
+    /// Posted on the main thread whenever the message retention window setting changes.
+    public static let messageRetentionPeriodDidChange = NSNotification.Name("MessageRetentionPeriodDidChange")
+}
+
+/// Manages the user's global "message retention window" setting: how many
+/// days of chat history to keep before older messages are automatically
+/// deleted across every conversation.
+///
+/// This setting is distinct from per-conversation "disappearing messages",
+/// which is a sender-driven TTL negotiated per-thread. Retention is a purely
+/// local, receiver-side cleanup policy.
+public protocol MessageRetentionManager {
+    /// The number of days of history to keep, or `nil` if retention is
+    /// disabled (messages are kept forever).
+    func getRetentionPeriodDays(tx: DBReadTransaction) -> Int?
+
+    /// Enables retention with the given number of days, or disables it if
+    /// `days` is `nil`. Takes effect immediately and retroactively: any
+    /// existing messages older than the new cutoff will be removed by
+    /// ``MessageRetentionCleanupJob`` the next time it runs, which happens
+    /// automatically as soon as this is called.
+    func setRetentionPeriodDays(_ days: Int?, tx: DBWriteTransaction)
+
+    /// The timestamp (milliseconds since epoch) before which messages should
+    /// be deleted, computed relative to "now", or `nil` if retention is
+    /// disabled. This is a rolling window: callers should re-derive this
+    /// value each time they want to sweep for expired messages, rather than
+    /// caching it, since it advances as time passes.
+    func cutoffTimestampMs(tx: DBReadTransaction) -> UInt64?
+}
+
+public class MessageRetentionManagerImpl: MessageRetentionManager {
+    private enum Constants {
+        static let retentionPeriodDaysKey = "retentionPeriodDays"
+        static let msPerDay: UInt64 = 24 * 60 * 60 * 1000
+    }
+
+    private let dateProvider: DateProvider
+    private let kvStore = KeyValueStore(collection: "MessageRetentionManager")
+
+    public init(dateProvider: @escaping DateProvider) {
+        self.dateProvider = dateProvider
+    }
+
+    public func getRetentionPeriodDays(tx: DBReadTransaction) -> Int? {
+        guard let days = kvStore.getInt(Constants.retentionPeriodDaysKey, transaction: tx), days > 0 else {
+            return nil
+        }
+        return days
+    }
+
+    public func setRetentionPeriodDays(_ days: Int?, tx: DBWriteTransaction) {
+        if let days {
+            owsPrecondition(days > 0, "Retention period must be positive; pass nil to disable.")
+            kvStore.setInt(days, key: Constants.retentionPeriodDaysKey, transaction: tx)
+        } else {
+            kvStore.removeValue(forKey: Constants.retentionPeriodDaysKey, transaction: tx)
+        }
+
+        tx.addSyncCompletion {
+            NotificationCenter.default.postOnMainThread(name: .messageRetentionPeriodDidChange, object: nil)
+        }
+    }
+
+    public func cutoffTimestampMs(tx: DBReadTransaction) -> UInt64? {
+        guard let days = getRetentionPeriodDays(tx: tx) else {
+            return nil
+        }
+        let retentionWindowMs = UInt64(days) * Constants.msPerDay
+        let nowMs = dateProvider().ows_millisecondsSince1970
+        guard nowMs > retentionWindowMs else {
+            // "Now" is within the retention window of the epoch; nothing is old enough to delete yet.
+            return nil
+        }
+        return nowMs - retentionWindowMs
+    }
+}
