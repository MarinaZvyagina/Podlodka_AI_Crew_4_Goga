+    /// Fetches interactions across *all* threads whose `timestamp` is older
+    /// than the given cutoff, oldest first. Used by ``MessageRetentionCleanupJob``
+    /// to sweep for messages past the user's configured retention window.
+    ///
+    /// - Parameter limit: The maximum number of interactions to return. Batch
+    /// callers so a single, unbounded query doesn't run against huge histories.
+    public class func fetchInteractions(
+        olderThan cutoffTimestampMs: UInt64,
+        limit: Int,
+        transaction: DBReadTransaction,
+    ) throws -> [TSInteraction] {
+        let sql = """
+            SELECT *
+            FROM \(InteractionRecord.databaseTableName)
+            \(DEBUG_INDEXED_BY("Interaction_timestamp"))
+            WHERE \(interactionColumn: .timestamp) < ?
+            ORDER BY \(interactionColumn: .timestamp) ASC
+            LIMIT ?
+        """
+
+        return try TSInteraction.grdbFetchCursor(
+            sql: sql,
+            arguments: [cutoffTimestampMs, limit],
+            transaction: transaction,
+        ).all()
+    }
