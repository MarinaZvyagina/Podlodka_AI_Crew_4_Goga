new file mode 100644
index 0000000..9c76989
--- /dev/null
+++ b/SignalServiceKit/Jobs/MessageRetentionCleanupJob.swift
@@ -0,0 +1,210 @@
+//
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+import Foundation
+
+/// Continuously sweeps for, and deletes, messages older than the user's
+/// configured message retention window (see ``MessageRetentionManager``),
+/// across every conversation.
+///
+/// This runs as a long-lived task for the lifetime of the app process,
+/// mirroring ``ExpirationJob``. Deletion happens in small batches via
+/// ``TimeGatedBatch`` so a single sweep never holds a write transaction open
+/// long enough to freeze the UI, even across huge histories.
+///
+/// Because the deletion criterion ("timestamp is older than the current
+/// cutoff") is stateless and idempotent, this job needs no persisted
+/// checkpoint to resume correctly: if the app is killed, backgrounded, or
+/// the sweep is otherwise interrupted, simply restarting the loop - which
+/// happens automatically the next time the app launches - picks up exactly
+/// where it left off by re-querying for anything still older than the
+/// cutoff. Each batch is deleted and committed atomically, so an interrupted
+/// sweep never leaves a conversation half-deleted.
+public final class MessageRetentionCleanupJob {
+    private let db: DB
+    private let interactionDeleteManager: InteractionDeleteManager
+    private let messageRetentionManager: MessageRetentionManager
+    private let threadStore: ThreadStore
+    private let tsAccountManager: any TSAccountManager
+
+    private let logger = PrefixedLogger(prefix: "[MessageRetention]")
+
+    private enum Constants {
+        /// How many interactions to fetch-and-delete per query. Kept small
+        /// so a single query/delete/thread-touch round-trip stays cheap.
+        static let deletionBatchSize = 500
+        /// Once we've caught up (nothing left to delete), how long to wait
+        /// before re-checking. The retention window is a rolling cutoff that
+        /// advances with time, so previously-safe messages will eventually
+        /// age out and need another sweep.
+        static let recheckInterval: TimeInterval = 60 * 60
+    }
+
+    private struct State {
+        var isRunning = false
+        var restartValidityToken: UInt = 0
+        var sleepTask: Task<Void, Never>?
+    }
+    private let state = AtomicValue(State(), lock: .init())
+
+    public init(
+        db: DB,
+        interactionDeleteManager: InteractionDeleteManager,
+        messageRetentionManager: MessageRetentionManager,
+        threadStore: ThreadStore,
+        tsAccountManager: any TSAccountManager,
+    ) {
+        self.db = db
+        self.interactionDeleteManager = interactionDeleteManager
+        self.messageRetentionManager = messageRetentionManager
+        self.threadStore = threadStore
+        self.tsAccountManager = tsAccountManager
+    }
+
+    /// Wakes the job immediately, e.g. because the retention setting changed
+    /// and there may be new (or no more) work to do. Callers don't need to
+    /// call this for the passage of time alone; the job re-checks
+    /// periodically on its own.
+    public final func restart() {
+        state.update { _state in
+            _state.restartValidityToken += 1
+            _state.sleepTask?.cancel()
+        }
+    }
+
+    public func run() async throws {
+        state.update {
+            owsPrecondition(!$0.isRunning)
+            $0.isRunning = true
+        }
+        defer {
+            state.update { $0.isRunning = false }
+        }
+
+        let observer = NotificationCenter.default.addObserver(
+            name: .messageRetentionPeriodDidChange,
+            block: { [weak self] _ in
+                self?.restart()
+            },
+        )
+        defer {
+            NotificationCenter.default.removeObserver(observer)
+        }
+
+        while true {
+            let restartValidityToken = state.get().restartValidityToken
+
+            try await deleteExpiredInteractions()
+
+            let sleepTask = state.update { _state -> Task<Void, Never> in
+                // If we were restarted while sweeping, don't wait: there may
+                // be a new cutoff (or the feature may have just been
+                // disabled) that we haven't accounted for yet.
+                let delay: TimeInterval = _state.restartValidityToken == restartValidityToken
+                    ? Constants.recheckInterval
+                    : 0
+
+                let sleepTask = Task {
+                    _ = try? await Task.sleep(nanoseconds: delay.clampedNanoseconds)
+                }
+                _state.sleepTask = sleepTask
+                return sleepTask
+            }
+
+            await withTaskCancellationHandler(
+                operation: { await sleepTask.value },
+                onCancel: { sleepTask.cancel() },
+            )
+            // Distinguish between "run() was canceled" and "restart() was called".
+            try Task.checkCancellation()
+        }
+    }
+
+    private func deleteExpiredInteractions() async throws {
+        try Task.checkCancellation()
+
+        var totalDeletedCount = 0
+        try await TimeGatedBatch.processAll(
+            db: db,
+            buildTxContext: { _ in Set<String>() },
+            processBatch: { (tx: DBWriteTransaction, affectedThreadUniqueIds: inout Set<String>) throws -> TimeGatedBatch.ProcessBatchResult<Void> in
+                try Task.checkCancellation()
+
+                // Don't do destructive work while signed out / re-registering;
+                // the outer loop will simply try again later.
+                guard self.tsAccountManager.registrationState(tx: tx).isRegistered else {
+                    return .done(())
+                }
+                guard let cutoffTimestampMs = self.messageRetentionManager.cutoffTimestampMs(tx: tx) else {
+                    return .done(())
+                }
+
+                let batch = self.deleteSomeInteractions(olderThan: cutoffTimestampMs, tx: tx)
+                totalDeletedCount += batch.deletedCount
+                affectedThreadUniqueIds.formUnion(batch.affectedThreadUniqueIds)
+                return batch.deletedCount == 0 ? .done(()) : .more
+            },
+            concludeTx: { tx, affectedThreadUniqueIds in
+                // We skip per-interaction thread updates below to avoid
+                // redundant churn during a bulk delete; instead, touch each
+                // affected thread once per transaction so conversation list
+                // previews/unread counts are correct as soon as this commits,
+                // not just after the whole sweep (or a relaunch) completes.
+                for threadUniqueId in affectedThreadUniqueIds {
+                    guard let thread = self.threadStore.fetchThread(uniqueId: threadUniqueId, tx: tx) else {
+                        continue
+                    }
+                    thread.updateOnInteractionsRemoved(
+                        needsToUpdateLastInteractionRowId: true,
+                        needsToUpdateLastVisibleSortId: true,
+                        tx: tx,
+                    )
+                }
+            },
+        )
+
+        if totalDeletedCount > 0 {
+            logger.info("Deleted \(totalDeletedCount) interaction(s) past the retention cutoff.")
+        }
+    }
+
+    /// Deletes a batch of interactions older than the given cutoff.
+    /// - Returns: The number of interactions deleted, and the set of threads
+    /// they belonged to. A deleted count of 0 means there's nothing left to
+    /// delete right now.
+    private func deleteSomeInteractions(
+        olderThan cutoffTimestampMs: UInt64,
+        tx: DBWriteTransaction,
+    ) -> (deletedCount: Int, affectedThreadUniqueIds: Set<String>) {
+        let interactionsToDelete: [TSInteraction]
+        do {
+            interactionsToDelete = try InteractionFinder.fetchInteractions(
+                olderThan: cutoffTimestampMs,
+                limit: Constants.deletionBatchSize,
+                transaction: tx,
+            )
+        } catch {
+            owsFailDebug("Failed to fetch interactions for retention cleanup! \(error)")
+            return (0, [])
+        }
+
+        if interactionsToDelete.isEmpty {
+            return (0, [])
+        }
+
+        let affectedThreadUniqueIds = Set(interactionsToDelete.map(\.uniqueThreadId))
+
+        interactionDeleteManager.delete(
+            interactions: interactionsToDelete,
+            sideEffects: .custom(
+                associatedCallDelete: .localDeleteOnly,
+                updateThreadOnInteractionDelete: .doNotUpdate,
+            ),
+            tx: tx,
+        )
+
+        return (interactionsToDelete.count, affectedThreadUniqueIds)
+    }
+}
