diff --git a/SignalServiceKit/Jobs/DeleteAllOutgoingInteractionsJobQueue.swift b/SignalServiceKit/Jobs/DeleteAllOutgoingInteractionsJobQueue.swift
new file mode 100644
index 0000000..da3e1ea
--- /dev/null
+++ b/SignalServiceKit/Jobs/DeleteAllOutgoingInteractionsJobQueue.swift
@@ -0,0 +1,244 @@
+//
+// Copyright 2024 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+/// Manages a durable, batched job that deletes every interaction "authored"
+/// by the local user in a given thread (i.e., a "delete my messages in this
+/// chat" action), leaving other participants' interactions untouched.
+///
+/// Deletions performed by this queue are synced to linked devices via a
+/// `DeleteForMe` sync message, and any ``CallRecord``s associated with a
+/// deleted interaction (e.g., an outgoing call the local user placed) are
+/// kept consistent by deleting them alongside their interaction.
+public final class DeleteAllOutgoingInteractionsJobQueue {
+    private let jobRunnerFactory: DeleteAllOutgoingInteractionsJobRunnerFactory
+    private let jobQueueRunner: JobQueueRunner<
+        JobRecordFinderImpl<DeleteAllOutgoingInteractionsJobRecord>,
+        DeleteAllOutgoingInteractionsJobRunnerFactory,
+    >
+    private var jobSerializer = CompletionSerializer()
+
+    init(
+        db: any DB,
+        interactionDeleteManager: InteractionDeleteManager,
+        threadStore: ThreadStore,
+    ) {
+        self.jobRunnerFactory = DeleteAllOutgoingInteractionsJobRunnerFactory(
+            db: db,
+            interactionDeleteManager: interactionDeleteManager,
+            threadStore: threadStore,
+        )
+        self.jobQueueRunner = JobQueueRunner(
+            canExecuteJobsConcurrently: false,
+            db: db,
+            jobFinder: JobRecordFinderImpl(db: db),
+            jobRunnerFactory: self.jobRunnerFactory,
+        )
+    }
+
+    func start(appContext: AppContext) {
+        jobQueueRunner.start(shouldRestartExistingJobs: appContext.isMainApp)
+    }
+
+    /// Enqueue a job to delete every interaction "authored" by the local user
+    /// in the given thread, as of the time this method is called. Messages
+    /// sent or received after this point are unaffected.
+    ///
+    /// - Returns
+    /// Whether a job was enqueued. No job is enqueued if the thread currently
+    /// has no locally-authored interactions to delete.
+    @discardableResult
+    public func addJob(
+        threadUniqueId: String,
+        tx: DBWriteTransaction,
+    ) -> Bool {
+        guard
+            let anchorMessageRowId = InteractionFinder(threadUniqueId: threadUniqueId)
+                .mostRecentLocallyAuthoredRowId(tx: tx)
+        else {
+            return false
+        }
+
+        let jobRecord = DeleteAllOutgoingInteractionsJobRecord(
+            anchorMessageRowId: anchorMessageRowId,
+            threadUniqueId: threadUniqueId,
+        )
+
+        jobRecord.anyInsert(transaction: tx)
+
+        jobSerializer.addOrderedSyncCompletion(tx: tx) {
+            self.jobQueueRunner.addPersistedJob(jobRecord)
+        }
+
+        return true
+    }
+}
+
+// MARK: -
+
+private class DeleteAllOutgoingInteractionsJobRunner: JobRunner {
+    typealias JobRecordType = DeleteAllOutgoingInteractionsJobRecord
+
+    private enum Constants {
+        static let maxRetries: UInt = 110
+        static let deletionBatchSize: Int = 500
+    }
+
+    private let db: any DB
+    private let interactionDeleteManager: InteractionDeleteManager
+    private let threadStore: ThreadStore
+
+    private let logger = PrefixedLogger(prefix: "[DeleteAllOutgoingInteractions]")
+
+    init(
+        db: any DB,
+        interactionDeleteManager: InteractionDeleteManager,
+        threadStore: ThreadStore,
+    ) {
+        self.db = db
+        self.interactionDeleteManager = interactionDeleteManager
+        self.threadStore = threadStore
+    }
+
+    func runJobAttempt(
+        _ jobRecord: DeleteAllOutgoingInteractionsJobRecord,
+    ) async -> JobAttemptResult<Void> {
+        return await JobAttemptResult.executeBlockWithDefaultErrorHandler(
+            jobRecord: jobRecord,
+            retryLimit: Constants.maxRetries,
+            db: db,
+            block: {
+                try await self._runJobAttempt(jobRecord)
+            },
+        )
+    }
+
+    func didFinishJob(_ jobRecordId: JobRecord.RowId, result: JobResult<Void>) async {
+        switch result.ranSuccessfullyOrError {
+        case .success:
+            break
+        case .failure(let failure):
+            logger.error("Failed to perform delete-all-outgoing-interactions bulk action! \(failure)")
+        }
+    }
+
+    private func _runJobAttempt(
+        _ jobRecord: DeleteAllOutgoingInteractionsJobRecord,
+    ) async throws {
+        let anchorMessageRowId = jobRecord.anchorMessageRowId
+        let threadUniqueId = jobRecord.threadUniqueId
+
+        logger.info("Attempting to bulk-delete locally-authored interactions for thread \(threadUniqueId).")
+
+        var deletedCount = 0
+        await TimeGatedBatch.processAll(db: db) { tx -> TimeGatedBatch.ProcessBatchResult in
+            let batchDeletedCount = self.deleteSomeInteractions(
+                threadUniqueId: threadUniqueId,
+                anchorMessageRowId: anchorMessageRowId,
+                tx: tx,
+            )
+            deletedCount += batchDeletedCount
+            return batchDeletedCount == 0 ? .done(()) : .more
+        }
+
+        logger.info("Deleted \(deletedCount) locally-authored interactions for thread \(threadUniqueId).")
+
+        await db.awaitableWrite { tx in
+            jobRecord.anyRemove(transaction: tx)
+        }
+    }
+
+    /// Delete a batch of locally-authored interactions, and send a
+    /// `DeleteForMe` sync message about them.
+    /// - Returns
+    /// The number of interactions deleted. A return value of 0 indicates that
+    /// there are no more interactions to delete.
+    private func deleteSomeInteractions(
+        threadUniqueId: String,
+        anchorMessageRowId: Int64,
+        tx: DBWriteTransaction,
+    ) -> Int {
+        guard let thread = threadStore.fetchThread(uniqueId: threadUniqueId, tx: tx) else {
+            owsFailDebug("Missing thread for bulk-delete!")
+            return 0
+        }
+
+        let interactionsToDelete: [TSInteraction]
+        do {
+            interactionsToDelete = try InteractionFinder(
+                threadUniqueId: threadUniqueId,
+            ).fetchAllLocallyAuthoredInteractions(
+                rowIdFilter: .atOrBefore(anchorMessageRowId),
+                limit: Constants.deletionBatchSize,
+                tx: tx,
+            )
+        } catch {
+            owsFailDebug("Failed to get interactions to delete!")
+            return 0
+        }
+
+        if interactionsToDelete.isEmpty { return 0 }
+
+        /// This single call also sends a `DeleteForMe` sync message about
+        /// every interaction in this batch, so linked devices delete them
+        /// too. Any ``CallRecord`` associated with a deleted interaction
+        /// (e.g., an outgoing call) is deleted alongside it.
+        interactionDeleteManager.delete(
+            interactions: interactionsToDelete,
+            sideEffects: .custom(
+                associatedCallDelete: .localDeleteOnly,
+                updateThreadOnInteractionDelete: .doNotUpdate,
+                deleteForMeSyncMessage: .sendSyncMessage(interactionsThread: thread),
+            ),
+            tx: tx,
+        )
+
+        /// Above, we're skipping a per-interaction thread update that would
+        /// otherwise set various "last visible" properties on the thread. To
+        /// compensate, we'll do a single thread update at the end of each
+        /// transaction (note that because we're in a `TimeGatedBatch`, we don't
+        /// know how many interactions will be deleted in a single transaction).
+        /// This also touches the thread row, which drives the live chat-list
+        /// and conversation-view updates via database change observation.
+        tx.addFinalizationBlock(key: "DeleteAllOutgoingInteractionsJobQueue") { tx in
+            if let thread = self.threadStore.fetchThread(uniqueId: threadUniqueId, tx: tx) {
+                thread.updateOnInteractionsRemoved(
+                    needsToUpdateLastInteractionRowId: true,
+                    needsToUpdateLastVisibleSortId: true,
+                    tx: tx,
+                )
+            }
+        }
+
+        return interactionsToDelete.count
+    }
+}
+
+// MARK: -
+
+private class DeleteAllOutgoingInteractionsJobRunnerFactory: JobRunnerFactory {
+    typealias JobRunnerType = DeleteAllOutgoingInteractionsJobRunner
+
+    private let db: any DB
+    private let interactionDeleteManager: InteractionDeleteManager
+    private let threadStore: ThreadStore
+
+    init(
+        db: any DB,
+        interactionDeleteManager: InteractionDeleteManager,
+        threadStore: ThreadStore,
+    ) {
+        self.db = db
+        self.interactionDeleteManager = interactionDeleteManager
+        self.threadStore = threadStore
+    }
+
+    func buildRunner() -> DeleteAllOutgoingInteractionsJobRunner {
+        return DeleteAllOutgoingInteractionsJobRunner(
+            db: db,
+            interactionDeleteManager: interactionDeleteManager,
+            threadStore: threadStore,
+        )
+    }
+}
diff --git a/SignalServiceKit/Jobs/JobRecords/DeleteAllOutgoingInteractionsJobRecord.swift b/SignalServiceKit/Jobs/JobRecords/DeleteAllOutgoingInteractionsJobRecord.swift
new file mode 100644
index 0000000..c3b6e8a
--- /dev/null
+++ b/SignalServiceKit/Jobs/JobRecords/DeleteAllOutgoingInteractionsJobRecord.swift
@@ -0,0 +1,46 @@
+//
+// Copyright 2024 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+final class DeleteAllOutgoingInteractionsJobRecord: JobRecord {
+    override class var jobRecordType: JobRecord.JobRecordType { .deleteAllOutgoingInteractionsJobRecord }
+
+    /// The row ID of the most-recent interaction "authored" by the local
+    /// user, at or before which we want to bulk-delete. See
+    /// ``InteractionFinder/fetchAllLocallyAuthoredInteractions(rowIdFilter:limit:tx:)``.
+    let anchorMessageRowId: Int64
+    /// The unique ID of the thread within which to bulk-delete.
+    let threadUniqueId: String
+
+    init(
+        anchorMessageRowId: Int64,
+        threadUniqueId: String,
+        failureCount: UInt = 0,
+        status: Status = .ready,
+    ) {
+        self.anchorMessageRowId = anchorMessageRowId
+        self.threadUniqueId = threadUniqueId
+
+        super.init(
+            failureCount: failureCount,
+            status: status,
+        )
+    }
+
+    required init(inheritableDecoder decoder: any Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+
+        anchorMessageRowId = try container.decode(Int64.self, forKey: .DAOIJR_anchorMessageRowId)
+        threadUniqueId = try container.decode(String.self, forKey: .DAOIJR_threadUniqueId)
+
+        try super.init(inheritableDecoder: decoder)
+    }
+
+    override func encode(to encoder: any Encoder) throws {
+        try super.encode(to: encoder)
+        var container = encoder.container(keyedBy: CodingKeys.self)
+        try container.encode(anchorMessageRowId, forKey: .DAOIJR_anchorMessageRowId)
+        try container.encode(threadUniqueId, forKey: .DAOIJR_threadUniqueId)
+    }
+}
