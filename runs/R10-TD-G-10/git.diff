diff --git a/SignalServiceKit/Calls/Individual/TSCall.swift b/SignalServiceKit/Calls/Individual/TSCall.swift
index 4bdd063..c670d42 100644
--- a/SignalServiceKit/Calls/Individual/TSCall.swift
+++ b/SignalServiceKit/Calls/Individual/TSCall.swift
@@ -11,6 +11,33 @@ extension RPRecentCallType: CustomStringConvertible {
     }
 }
 
+// MARK: - Authorship
+
+extension TSCall {
+    /// Whether this call was placed by the local user, as opposed to
+    /// received from another party.
+    var wasPlacedByLocalUser: Bool {
+        switch callType {
+        case .outgoing, .outgoingIncomplete, .outgoingMissed:
+            return true
+        case
+            .incoming,
+            .incomingMissed,
+            .incomingDeclined,
+            .incomingIncomplete,
+            .incomingMissedBecauseOfChangedIdentity,
+            .incomingAnsweredElsewhere,
+            .incomingDeclinedElsewhere,
+            .incomingBusyElsewhere,
+            .incomingMissedBecauseOfDoNotDisturb,
+            .incomingMissedBecauseBlockedSystemContact:
+            return false
+        @unknown default:
+            return false
+        }
+    }
+}
+
 // MARK: - Disappearing messages
 
 extension TSCall: ExpiringCallInteraction {
