@@ -155,6 +165,77 @@ final class ThreadDeletionManagerImpl: ThreadDeletionManager {
         }
     }
 
+    func removeAllInteractionsAuthoredByLocalUser(
+        thread: TSThread,
+        localIdentifiers: LocalIdentifiers,
+        tx: DBWriteTransaction,
+    ) {
+        var deletedMessages = [TSMessage]()
+
+        do {
+            var rowIdFilter: InteractionFinder.RowIdFilter = .newest
+            var moreInteractionsRemaining = true
+            while moreInteractionsRemaining {
+                try autoreleasepool {
+                    let interactionBatch = try InteractionFinder(
+                        threadUniqueId: thread.uniqueId,
+                    ).fetchAllInteractions(
+                        rowIdFilter: rowIdFilter,
+                        limit: Constants.interactionDeletionBatchSize,
+                        tx: tx,
+                    )
+
+                    moreInteractionsRemaining = interactionBatch.count == Constants.interactionDeletionBatchSize
+                    if let oldestRowIdInBatch = interactionBatch.compactMap({ $0.sqliteRowId }).min() {
+                        rowIdFilter = .before(oldestRowIdInBatch)
+                    }
+
+                    let ownInteractions = interactionBatch.filter { Self.isAuthoredByLocalUser($0) }
+                    guard !ownInteractions.isEmpty else { return }
+
+                    deletedMessages.append(contentsOf: ownInteractions.compactMap { $0 as? TSMessage })
+
+                    interactionDeleteManager.delete(
+                        interactions: ownInteractions,
+                        sideEffects: .custom(
+                            updateThreadOnInteractionDelete: .doNotUpdate,
+                        ),
+                        tx: tx,
+                    )
+                }
+            }
+        } catch {
+            owsFailDebug("Failed to delete batch of interactions!")
+            return
+        }
+
+        /// Because we skipped updating the thread for each deleted
+        /// interaction, now that we're done deleting we'll do a one-time
+        /// update so the chat list and conversation view refresh immediately.
+        thread.updateOnInteractionsRemoved(
+            needsToUpdateLastInteractionRowId: true,
+            needsToUpdateLastVisibleSortId: true,
+            tx: tx,
+        )
+
+        deleteForMeOutgoingSyncMessageManager.send(
+            deletedMessages: deletedMessages,
+            thread: thread,
+            localIdentifiers: localIdentifiers,
+            tx: tx,
+        )
+    }
+
+    private static func isAuthoredByLocalUser(_ interaction: TSInteraction) -> Bool {
+        if interaction is TSOutgoingMessage {
+            return true
+        }
+        if let call = interaction as? TSCall {
+            return call.wasPlacedByLocalUser
+        }
+        return false
+    }
+
     func removeIntentsForTerminatedGroup(threadUniqueId: String) {
         intentsManager.deleteAllIntents(withGroupIdentifier: threadUniqueId)
     }
