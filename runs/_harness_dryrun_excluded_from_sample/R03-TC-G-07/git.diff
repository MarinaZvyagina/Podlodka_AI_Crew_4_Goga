+import { Maintenance, MAINTENANCE_METADATA_KEY } from './maintenance.decorator.js';
+
+class SampleController {
+  @Maintenance()
+  affectedRoute() {}
+
+  plainRoute() {}
+}
+
+@Maintenance()
+class SampleAffectedController {}
+
+describe('@Maintenance()', () => {
+  it('flags a decorated method', () => {
+    expect(
+      Reflect.getMetadata(
+        MAINTENANCE_METADATA_KEY,
+        SampleController.prototype.affectedRoute,
+      ),
+    ).toBe(true);
+  });
+
+  it('leaves an undecorated method untouched', () => {
+    expect(
+      Reflect.getMetadata(
+        MAINTENANCE_METADATA_KEY,
+        SampleController.prototype.plainRoute,
+      ),
+    ).toBeUndefined();
+  });
+
+  it('flags a decorated class', () => {
+    expect(
+      Reflect.getMetadata(MAINTENANCE_METADATA_KEY, SampleAffectedController),
+    ).toBe(true);
+  });
+});
