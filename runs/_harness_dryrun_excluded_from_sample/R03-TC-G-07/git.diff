+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the runtime maintenance-mode flag. A single instance is shared
+ * across the whole application (default singleton scope), so toggling it
+ * from anywhere (an admin endpoint, a CLI command, a scheduled job, ...)
+ * immediately affects every handler marked with `@Maintenance()`.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  enable(): void {
+    this.enabled = true;
+  }
+
+  disable(): void {
+    this.enabled = false;
+  }
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+}
