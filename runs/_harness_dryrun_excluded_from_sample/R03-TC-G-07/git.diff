+import { Controller, Get, Post } from '@nestjs/common';
+import { MaintenanceModeService } from './maintenance.service.js';
+
+/**
+ * Lets an operator flip maintenance mode on/off from within the running
+ * application, without a redeploy. This controller is intentionally never
+ * marked with `@Maintenance()`, so it keeps working while maintenance mode
+ * is enabled.
+ */
+@Controller('maintenance')
+export class MaintenanceController {
+  constructor(private readonly maintenanceModeService: MaintenanceModeService) {}
+
+  @Get('status')
+  getStatus() {
+    return { enabled: this.maintenanceModeService.isEnabled() };
+  }
+
+  @Post('enable')
+  enable() {
+    this.maintenanceModeService.enable();
+    return { enabled: true };
+  }
+
+  @Post('disable')
+  disable() {
+    this.maintenanceModeService.disable();
+    return { enabled: false };
+  }
+}
