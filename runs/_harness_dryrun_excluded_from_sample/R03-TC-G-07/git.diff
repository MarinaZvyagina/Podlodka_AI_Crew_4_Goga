+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../../src/app.module.js';
+
+describe('E2E Maintenance Mode Sample', () => {
+  let app: INestApplication;
+
+  beforeAll(async () => {
+    const modRef = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = modRef.createNestApplication();
+    await app.init();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('serves unaffected and affected routes normally while maintenance mode is off', async () => {
+    await request(app.getHttpServer()).get('/cats').expect(200);
+    await request(app.getHttpServer()).post('/cats/reindex').expect(201);
+  });
+
+  it('blocks only the marked route once maintenance mode is switched on', async () => {
+    await request(app.getHttpServer())
+      .post('/maintenance/enable')
+      .expect(201, { enabled: true });
+
+    await request(app.getHttpServer()).get('/cats').expect(200);
+    await request(app.getHttpServer()).post('/cats/reindex').expect(503);
+
+    await request(app.getHttpServer())
+      .post('/maintenance/disable')
+      .expect(201, { enabled: false });
+
+    await request(app.getHttpServer()).post('/cats/reindex').expect(201);
+  });
+});
