@@ -0,0 +1,11 @@
+import { SetMetadata } from '@nestjs/common';
+
+export const MAINTENANCE_METADATA_KEY = 'maintenance:affected';
+
+/**
+ * Marks a route handler, an entire controller, a WebSocket message handler,
+ * or an entire gateway as affected by maintenance mode. While maintenance
+ * mode is enabled, calls to anything marked with this decorator are
+ * rejected by `MaintenanceGuard` before the handler body runs.
+ */
+export const Maintenance = () => SetMetadata(MAINTENANCE_METADATA_KEY, true);
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts
new file mode 100644
index 0000000..c730bf7
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.spec.ts
@@ -0,0 +1,145 @@
+import { ExecutionContext, ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { Maintenance } from './maintenance.decorator.js';
+import { MaintenanceGuard } from './maintenance.guard.js';
+import { MaintenanceModeService } from './maintenance.service.js';
+
+class UnmarkedController {
+  plainRoute() {}
+}
+
+class PartlyAffectedController {
+  @Maintenance()
+  affectedRoute() {}
+
+  plainRoute() {}
+}
+
+@Maintenance()
+class FullyAffectedController {
+  someRoute() {}
+}
+
+function createExecutionContext(
+  handler: Function,
+  cls: Function,
+  type: 'http' | 'ws',
+): ExecutionContext {
+  return {
+    getHandler: () => handler,
+    getClass: () => cls,
+    getType: () => type,
+    switchToHttp: () => ({
+      getRequest: () => ({}),
+      getResponse: () => ({}),
+      getNext: () => undefined,
+    }),
+    switchToWs: () => ({
+      getClient: () => ({}),
+      getData: () => ({}),
+      getPattern: () => '',
+    }),
+    switchToRpc: () => ({
+      getData: () => undefined,
+      getContext: () => undefined,
+    }),
+    getArgs: () => [],
+    getArgByIndex: () => undefined,
+  } as unknown as ExecutionContext;
+}
+
+describe('MaintenanceGuard', () => {
+  let guard: MaintenanceGuard;
+  let maintenanceModeService: MaintenanceModeService;
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceGuard(new Reflector(), maintenanceModeService);
+  });
+
+  it('allows unmarked handlers through, even while maintenance mode is on', () => {
+    maintenanceModeService.enable();
+    const context = createExecutionContext(
+      UnmarkedController.prototype.plainRoute,
+      UnmarkedController,
+      'http',
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('allows marked handlers through while maintenance mode is off', () => {
+    const context = createExecutionContext(
+      PartlyAffectedController.prototype.affectedRoute,
+      PartlyAffectedController,
+      'http',
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('rejects a marked HTTP handler while maintenance mode is on', () => {
+    maintenanceModeService.enable();
+    const context = createExecutionContext(
+      PartlyAffectedController.prototype.affectedRoute,
+      PartlyAffectedController,
+      'http',
+    );
+
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('leaves other handlers on the same controller unaffected', () => {
+    maintenanceModeService.enable();
+    const context = createExecutionContext(
+      PartlyAffectedController.prototype.plainRoute,
+      PartlyAffectedController,
+      'http',
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('rejects a marked WebSocket message handler with a WsException while maintenance mode is on', () => {
+    maintenanceModeService.enable();
+    const context = createExecutionContext(
+      PartlyAffectedController.prototype.affectedRoute,
+      PartlyAffectedController,
+      'ws',
+    );
+
+    expect(() => guard.canActivate(context)).toThrow(WsException);
+  });
+
+  it('rejects every handler of a class marked as affected as a whole', () => {
+    maintenanceModeService.enable();
+    const context = createExecutionContext(
+      FullyAffectedController.prototype.someRoute,
+      FullyAffectedController,
+      'http',
+    );
+
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('stops rejecting marked handlers as soon as maintenance mode is switched off', () => {
+    maintenanceModeService.enable();
+    const context = createExecutionContext(
+      PartlyAffectedController.prototype.affectedRoute,
+      PartlyAffectedController,
+      'http',
+    );
+    expect(() => guard.canActivate(context)).toThrow(
+      ServiceUnavailableException,
+    );
+
+    maintenanceModeService.disable();
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+});
diff --git a/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
new file mode 100644
index 0000000..0d13ae5
--- /dev/null
+++ b/sample/37-maintenance-mode/src/maintenance/maintenance.guard.ts
@@ -0,0 +1,48 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { WsException } from '@nestjs/websockets';
+import { MAINTENANCE_METADATA_KEY } from './maintenance.decorator.js';
+import { MaintenanceModeService } from './maintenance.service.js';
+
+const MAINTENANCE_MESSAGE =
+  'This operation is temporarily unavailable due to maintenance.';
+
+/**
+ * Rejects calls to any handler (HTTP route or WebSocket message handler)
+ * marked with `@Maintenance()`, but only while maintenance mode is
+ * switched on. Handler-level metadata takes precedence over class-level
+ * metadata, and unmarked handlers are never affected, regardless of the
+ * flag's state.
+ *
+ * Registering this guard once, globally, is enough to cover both HTTP
+ * controllers and WebSocket gateways: Nest's `ExecutionContext` abstracts
+ * over both, so a single guard implementation applies to each uniformly.
+ */
+@Injectable()
+export class MaintenanceGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isAffected = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_METADATA_KEY,
+      [context.getHandler(), context.getClass()],
+    );
+
+    if (!isAffected || !this.maintenanceModeService.isEnabled()) {
+      return true;
+    }
+
+    if (context.getType() === 'ws') {
+      throw new WsException(MAINTENANCE_MESSAGE);
+    }
+    throw new ServiceUnavailableException(MAINTENANCE_MESSAGE);
+  }
+}
