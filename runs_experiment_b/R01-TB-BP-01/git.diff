+
+    def get_underlying_currency_exposure(self, currency: str) -> float:
+        """
+        Sum of stake_amount currently committed to open trades whose pair is priced in
+        (or settled against) the given underlying currency.
+        :param currency: Underlying (quote/settlement) currency to sum exposure for.
+        """
+        return sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if self._exchange.get_pair_quote_currency(trade.pair) == currency
+        )
+
+    def _check_underlying_currency_exposure(self, pair: str, stake_amount: float) -> float:
+        """
+        Reduce (or zero out) stake_amount so that opening this trade doesn't push the combined
+        exposure to the pair's underlying currency above `max_underlying_currency_exposure`.
+        :return: float: (possibly reduced) stake amount
+        """
+        max_exposure_ratio = self._config.get("max_underlying_currency_exposure")
+        if not max_exposure_ratio or stake_amount <= 0:
+            return stake_amount
+
+        currency = self._exchange.get_pair_quote_currency(pair)
+        if not currency:
+            return stake_amount
+
+        max_exposure = self.get_total_stake_amount() * max_exposure_ratio
+        current_exposure = self.get_underlying_currency_exposure(currency)
+        available_exposure = max_exposure - current_exposure
+
+        if available_exposure <= 0:
+            self._local_log(
+                f"Underlying currency exposure limit reached for {currency} "
+                f"({current_exposure:.8f} already committed, limit is {max_exposure:.8f} = "
+                f"{max_exposure_ratio:.2%} of tradable capital). Skipping trade for {pair}.",
+                level="warning",
+            )
+            return 0
+
+        if stake_amount > available_exposure:
+            self._local_log(
+                f"Stake amount for pair {pair} is too big for the {currency} underlying "
+                f"currency exposure limit ({max_exposure_ratio:.2%} of tradable capital), "
+                f"adjusting from {stake_amount:.8f} to {available_exposure:.8f}."
+            )
+            stake_amount = available_exposure
+
+        return stake_amount
 
     def validate_stake_amount(
         self,
