+def test_get_trade_stake_amount_underlying_currency_exposure_live_backtest_parity(
+    mocker, default_conf_usdt
+):
+    """
+    The exposure cap is implemented once in Wallets.get_trade_stake_amount, which is the
+    exact method called by both live/dry-run (FreqtradeBot) and backtesting (Backtesting).
+    This confirms both entry points reach it and get the same answer for the same inputs.
+    """
+    conf = deepcopy(default_conf_usdt)
+    conf["stake_amount"] = 300
+    conf["max_underlying_currency_exposure"] = 0.5
+
+    freqtrade = get_patched_freqtradebot(mocker, deepcopy(conf))
+
+    patch_exchange(mocker)
+    mocker.patch(f"{EXMS}.get_fee", return_value=0.0025)
+    try:
+        backtesting = Backtesting(deepcopy(conf))
+        backtesting._set_strategy(backtesting.strategylist[0])
+
+        mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=1000)
+        mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+        mocker.patch("freqtrade.wallets.Wallets.get_underlying_currency_exposure", return_value=400)
+
+        live_result = freqtrade.wallets.get_trade_stake_amount("ETH/USDT", 5)
+        backtest_result = backtesting.wallets.get_trade_stake_amount("ETH/USDT", 5)
+    finally:
+        # Backtesting() disables DB-backed Trade access for the process - restore it so
+        # other tests relying on live/dry-run (DB-backed) Trade semantics aren't affected.
+        enable_database_use()
+
+    # Available headroom (1000 * 0.5 - 400 = 100) is below the requested 300, so both
+    # code paths must reduce the stake identically instead of only one of them doing so.
+    assert live_result == backtest_result == 100
