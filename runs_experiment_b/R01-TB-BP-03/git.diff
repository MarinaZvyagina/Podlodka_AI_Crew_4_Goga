+    def _get_max_stake_for_currency_exposure(self, pair: str, trade_amount: float | None) -> float:
+        """
+        Determine how much additional stake can be committed to `pair` without pushing the
+        combined exposure to its underlying currency (the currency all positions on this pair
+        are ultimately settled/quoted in) over the strategy's configured `max_currency_exposure`.
+        Shared by live, dry-run and backtesting - both funnel through `validate_stake_amount`.
+        :return: float('inf') if no limit is configured, else the remaining stake allowed.
+        """
+        max_currency_exposure = self._config.get("max_currency_exposure")
+        if max_currency_exposure is None:
+            return float("inf")
+
+        currency = self._exchange.get_pair_underlying_currency(pair)
+        current_exposure = sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if self._exchange.get_pair_underlying_currency(trade.pair) == currency
+        )
+        if trade_amount:
+            # `pair`'s own open trade is already included above - we're sizing an addition to it.
+            current_exposure -= trade_amount
+
+        max_currency_stake = self.get_total_stake_amount() * max_currency_exposure
+        return max(max_currency_stake - current_exposure, 0)
+
