+@pytest.mark.parametrize(
+    "requested_stake,existing_stake,max_currency_exposure,trade_amount,expected,capped",
+    [
+        # 30% of 1000 total capital = 300 max for the currency.
+        # 250 already committed to ETH/USDT (same "USDT" underlying) - only 50 left.
+        (100, 250, 0.3, None, 50, True),
+        # Plenty of room left under the cap - request is granted in full.
+        (100, 100, 0.3, None, 100, False),
+        # Exposure already at (or above) the cap - new trade is fully rejected.
+        (100, 300, 0.3, None, 0, True),
+        # Rebuy/DCA on the same pair - its own existing stake must not be double-counted.
+        (100, 250, 0.3, 250, 100, False),
+        # No cap configured - request is granted in full, regardless of existing exposure.
+        (100, 900, None, None, 100, False),
+    ],
+)
+def test_validate_stake_amount_currency_exposure(
+    mocker,
+    default_conf,
+    caplog,
+    requested_stake,
+    existing_stake,
+    max_currency_exposure,
+    trade_amount,
+    expected,
+    capped,
+):
+    if max_currency_exposure is not None:
+        default_conf["max_currency_exposure"] = max_currency_exposure
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=10000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+    other_trade = MagicMock(pair="ETH/USDT", stake_amount=existing_stake)
+    mocker.patch("freqtrade.persistence.Trade.get_open_trades", return_value=[other_trade])
+
+    res = freqtrade.wallets.validate_stake_amount(
+        "XRP/USDT", requested_stake, 1, 10000, trade_amount
+    )
+    assert res == expected
+    if capped:
+        assert log_has_re(r"Stake amount for pair XRP/USDT is limited by.*USDT.*", caplog)
+
+
+def test_get_max_stake_for_currency_exposure_disabled(mocker, default_conf):
+    """No cap configured -> always unlimited, regardless of open trades."""
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    assert "max_currency_exposure" not in freqtrade.config or not freqtrade.config.get(
+        "max_currency_exposure"
+    )
+    assert freqtrade.wallets._get_max_stake_for_currency_exposure("XRP/USDT", None) == float("inf")
+
+
