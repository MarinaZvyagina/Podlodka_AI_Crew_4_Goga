+@pytest.mark.parametrize("only_per_pair", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses_perpair(mocker, default_conf, fee, caplog, only_per_pair):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "trade_limit": 2,
+            "stop_duration": 60,
+            "only_per_pair": only_per_pair,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .* consecutive losses\."
+    pair = "XRP/BTC"
+
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=200,
+        min_ago_close=100,
+        profit_rate=0.9,
+    )
+    # Only 1 loss so far for `pair` (and bot-wide) - not enough yet.
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # Loss on a *different* pair - counts towards the bot-wide streak, not towards `pair`'s own.
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=90,
+        min_ago_close=30,
+        profit_rate=0.9,
+    )
+
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert freqtrade.protections.global_stop() != only_per_pair
+    if not only_per_pair:
+        assert log_has_re(message, caplog)
+        assert PairLocks.is_global_lock()
+    else:
+        assert not log_has_re(message, caplog)
+        assert not PairLocks.is_global_lock()
+    caplog.clear()
+
+    # 2nd consecutive loss for `pair` itself now triggers the local (per-pair) lock too.
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=20,
+        min_ago_close=10,
+        profit_rate=0.9,
+    )
+
+    assert freqtrade.protections.stop_per_pair(pair)
+    assert PairLocks.is_pair_locked(pair)
+
+
+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses_streak_reset_and_unlock(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "trade_limit": 2,
+            "stop_duration": 60,
+            "only_per_pair": True,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    pair = "XRP/BTC"
+
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=200,
+        min_ago_close=100,
+        profit_rate=0.9,
+    )
+    # A win breaks the streak - the following loss only starts a new streak of 1.
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        min_ago_open=90,
+        min_ago_close=50,
+        profit_rate=1.1,
+    )
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=40,
+        min_ago_close=20,
+        profit_rate=0.9,
+    )
+
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not PairLocks.is_pair_locked(pair)
+
+    # 2nd consecutive loss of the new streak triggers the lock.
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=10,
+        min_ago_close=5,
+        profit_rate=0.9,
+    )
+    assert freqtrade.protections.stop_per_pair(pair)
+    assert PairLocks.is_pair_locked(pair)
+
+    # Once the cooldown period elapses, new trades on the pair are allowed again automatically.
+    end_time = PairLocks.get_pair_longest_lock(pair).lock_end_time + timedelta(minutes=5)
+    freqtrade.protections.stop_per_pair(pair, end_time)
+    assert not PairLocks.is_pair_locked(pair, end_time)
+
