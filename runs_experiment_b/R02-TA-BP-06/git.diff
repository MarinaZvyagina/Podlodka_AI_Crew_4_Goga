+def _to_percent(value):
+    """
+    Normalize a threshold value (e.g. "50%" or 50) to a float, passing
+    through None so unset min/max thresholds stay unset.
+    """
+    if value is None:
+        return None
+    if isinstance(value, str) and "%" in value:
+        value = re.sub("%", "", value)
+    return float(value)
diff --git a/tests/pytests/unit/beacons/test_diskusage.py b/tests/pytests/unit/beacons/test_diskusage.py
