@@ -0,0 +1,128 @@
+"""
+Unit tests for the sqlite3_cache cache module.
+"""
+
+import os
+
+import pytest
+
+import salt.cache.sqlite3_cache as sqlite3_cache
+
+
+@pytest.fixture
+def opts(tmp_path):
+    return {"cachedir": str(tmp_path)}
+
+
+@pytest.fixture
+def configure_loader_modules(opts):
+    return {sqlite3_cache: {"__opts__": opts, "__context__": {}}}
+
+
+def _reconnect():
+    """
+    Drop the module's cached connection so the next call reopens the
+    database file from scratch, simulating a master restart.
+    """
+    ctx = sqlite3_cache.__context__.get("sqlite3_cache")
+    if ctx and ctx.get("conn") is not None:
+        ctx["conn"].close()
+    sqlite3_cache.__context__.pop("sqlite3_cache", None)
+
+
+def test_virtual():
+    assert sqlite3_cache.__virtual__() == "sqlite3"
+
+
+def test_database_defaults_under_cachedir(opts):
+    expected = os.path.join(opts["cachedir"], "salt_cache.sqlite3")
+    assert sqlite3_cache._database_path() == expected
+
+
+def test_database_path_is_overridable(opts):
+    custom = os.path.join(opts["cachedir"], "custom.db")
+    opts["sqlite3.database"] = custom
+    assert sqlite3_cache._database_path() == custom
+
+
+def test_store_and_fetch():
+    sqlite3_cache.store("bank", "key", {"a": 1})
+    assert sqlite3_cache.fetch("bank", "key") == {"a": 1}
+
+
+def test_fetch_missing_key_returns_empty():
+    assert sqlite3_cache.fetch("bank", "missing") == {}
+
+
+def test_store_overwrite():
+    sqlite3_cache.store("bank", "key", {"v": 1})
+    sqlite3_cache.store("bank", "key", {"v": 2})
+    assert sqlite3_cache.fetch("bank", "key") == {"v": 2}
+
+
+def test_updated_missing_returns_none():
+    assert sqlite3_cache.updated("bank", "missing") is None
+
+
+def test_updated_returns_int_epoch():
+    sqlite3_cache.store("bank", "key", {"v": 1})
+    assert isinstance(sqlite3_cache.updated("bank", "key"), int)
+
+
+def test_flush_existing_key():
+    sqlite3_cache.store("bank", "key", {"v": 1})
+    assert sqlite3_cache.flush("bank", "key") is True
+    assert sqlite3_cache.fetch("bank", "key") == {}
+
+
+def test_flush_missing_key_returns_false():
+    assert sqlite3_cache.flush("bank", "missing") is False
+
+
+def test_flush_bank_removes_subbanks():
+    sqlite3_cache.store("grains/minion1", "data", {"os": "Linux"})
+    sqlite3_cache.store("grains/minion2", "data", {"os": "Windows"})
+    assert sqlite3_cache.flush("grains") is True
+    assert sqlite3_cache.fetch("grains/minion1", "data") == {}
+    assert sqlite3_cache.fetch("grains/minion2", "data") == {}
+
+
+def test_list_returns_keys_and_subbanks():
+    sqlite3_cache.store("grains/minion1", "data", {"os": "Linux"})
+    sqlite3_cache.store("grains/minion2", "data", {"os": "Windows"})
+    sqlite3_cache.store("grains", "some_key", {"v": 1})
+    assert set(sqlite3_cache.list_("grains")) == {"minion1", "minion2", "some_key"}
+
+
+def test_list_empty_bank_returns_empty():
+    assert sqlite3_cache.list_("ghost_bank") == []
+
+
+def test_contains_key():
+    sqlite3_cache.store("bank", "key", {"v": 1})
+    assert sqlite3_cache.contains("bank", "key") is True
+    assert sqlite3_cache.contains("bank", "missing") is False
+
+
+def test_contains_bank_existence_via_subbank():
+    sqlite3_cache.store("grains/minion1", "data", {"os": "Linux"})
+    assert sqlite3_cache.contains("grains", None) is True
+    assert sqlite3_cache.contains("ghost", None) is False
+
+
+def test_data_survives_reconnect():
+    """
+    The whole point of this backend: data written before a simulated
+    master restart (a fresh connection to the same database file) must
+    still be readable afterwards.
+    """
+    sqlite3_cache.store("minions/alpha", "data", {"grain": "value"})
+
+    _reconnect()
+
+    assert sqlite3_cache.fetch("minions/alpha", "data") == {"grain": "value"}
+
+
+def test_database_file_is_created_on_disk(opts):
+    sqlite3_cache.store("bank", "key", {"v": 1})
+    assert os.path.isfile(sqlite3_cache._database_path())
