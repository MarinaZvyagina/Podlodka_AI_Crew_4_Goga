+"""
+Cache data in a single SQLite3 database file.
+
+.. versionadded:: 3009.0
+
+The ``sqlite3`` cache module stores the minion data cache (cached grains,
+mine data, job returns, and similar) in a single SQLite database file on
+disk, using only the :py:mod:`sqlite3` module that ships with the Python
+standard library. No external database service (Redis, MySQL, etc.) needs
+to be installed or run.
+
+This makes it a durable alternative to the default ``localfs`` cache for
+small, single-node Salt masters: data written to the cache survives a
+restart of the master process, without the operational overhead of a
+separate database service.
+
+To use the sqlite3 cache backend, set the master ``cache`` config value to
+``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+Optionally, the following values can be set in the master config. These
+are the defaults:
+
+.. code-block:: yaml
+
+    sqlite3.database: <cachedir>/salt_cache.sqlite3
+    sqlite3.timeout: 5.0
+
+``sqlite3.database``
+    Path to the SQLite database file. Defaults to a file inside the
+    master's :conf_master:`cachedir`, so no extra configuration is needed
+    to get durable, on-restart-surviving storage.
+
+``sqlite3.timeout``
+    Number of seconds to wait for the database to become unlocked before
+    giving up, when another process/thread holds a write lock on it.
+"""
+
+import logging
+import os
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+import salt.utils.path
+from salt.exceptions import SaltCacheError
+
+try:
+    import sqlite3
+
+    HAS_SQLITE3 = True
+except ImportError:
+    HAS_SQLITE3 = False
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+_DEFAULT_FILENAME = "salt_cache.sqlite3"
+_DEFAULT_TIMEOUT = 5.0
+_TABLE = "cache"
+
+_CREATE_TABLE = f"""
+CREATE TABLE IF NOT EXISTS {_TABLE} (
+    bank TEXT NOT NULL,
+    cache_key TEXT NOT NULL,
+    data BLOB,
+    updated INTEGER NOT NULL,
+    PRIMARY KEY (bank, cache_key)
+)
+"""
+
+
+def __virtual__():
+    """
+    The sqlite3 module ships with the Python standard library, so this is
+    only unavailable on Python builds compiled without it.
+    """
+    if not HAS_SQLITE3:
+        return (False, "Python was built without the sqlite3 module.")
+    return __virtualname__
+
+
+def _database_path():
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    return __opts__.get(
+        "sqlite3.database", salt.utils.path.join(cachedir, _DEFAULT_FILENAME)
+    )
+
+
+def _connect():
+    database = _database_path()
+    basedir = os.path.dirname(database)
+    if basedir and not os.path.isdir(basedir):
+        try:
+            os.makedirs(basedir)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"Could not create the sqlite3 cache directory {basedir}: {exc}"
+            )
+
+    timeout = __opts__.get("sqlite3.timeout", _DEFAULT_TIMEOUT)
+    try:
+        conn = sqlite3.connect(database, timeout=timeout, check_same_thread=False)
+        # WAL keeps readers unblocked while a write is in progress, and
+        # survives a hard master restart just as well as the default
+        # rollback-journal mode since committed transactions are always
+        # flushed to the underlying file.
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute("PRAGMA synchronous=NORMAL")
+        conn.execute(_CREATE_TABLE)
+        conn.commit()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(
+            f'Could not open the sqlite3 cache database "{database}": {exc}'
+        )
+    return conn
+
+
+def _client():
+    """
+    Return the (connection, lock) pair for the configured database file,
+    lazily opening it (and creating its table) on first use.
+
+    One connection is kept alive for the life of the process and reused by
+    every call; a lock serializes access to it since a single sqlite3
+    connection is not safe to use concurrently from multiple threads.
+    """
+    ctx = __context__.setdefault("sqlite3_cache", {})
+    database = _database_path()
+    if ctx.get("conn") is None or ctx.get("database") != database:
+        if ctx.get("conn") is not None:
+            try:
+                ctx["conn"].close()
+            except sqlite3.Error:
+                pass
+        ctx["conn"] = _connect()
+        ctx["lock"] = threading.Lock()
+        ctx["database"] = database
+    return ctx["conn"], ctx["lock"]
+
+
+def _execute(query, params=(), commit=False):
+    conn, lock = _client()
+    with lock:
+        try:
+            cur = conn.execute(query, params)
+            if commit:
+                conn.commit()
+            return cur
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f"sqlite3 cache error running {query!r}: {exc}")
+
+
+def store(bank, key, data):
+    """
+    Store a key value.
+    """
+    raw = salt.payload.dumps(data)
+    _execute(
+        f"INSERT OR REPLACE INTO {_TABLE} (bank, cache_key, data, updated) "
+        "VALUES (?, ?, ?, ?)",
+        (bank, key, raw, int(time.time())),
+        commit=True,
+    )
+
+
+def fetch(bank, key):
+    """
+    Fetch a key value.
+    """
+    cur = _execute(
+        f"SELECT data FROM {_TABLE} WHERE bank=? AND cache_key=?", (bank, key)
+    )
+    row = cur.fetchone()
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key):
+    """
+    Return the Unix Epoch timestamp of when the key was last updated, or
+    ``None`` if the key does not exist.
+    """
+    cur = _execute(
+        f"SELECT updated FROM {_TABLE} WHERE bank=? AND cache_key=?", (bank, key)
+    )
+    row = cur.fetchone()
+    return None if row is None else int(row[0])
+
+
+def flush(bank, key=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key
+    is specified, remove the entire bank -- including any sub-banks -- along
+    with all keys inside it.
+    """
+    if key is None:
+        cur = _execute(
+            f"DELETE FROM {_TABLE} WHERE bank=? OR bank LIKE ?",
+            (bank, f"{bank}/%"),
+            commit=True,
+        )
+    else:
+        cur = _execute(
+            f"DELETE FROM {_TABLE} WHERE bank=? AND cache_key=?",
+            (bank, key),
+            commit=True,
+        )
+    return cur.rowcount > 0
+
+
+def list_(bank):
+    """
+    Return an iterable object containing all entries stored directly in the
+    specified bank, plus the names of any direct sub-banks.
+    """
+    cur = _execute(f"SELECT cache_key FROM {_TABLE} WHERE bank=?", (bank,))
+    names = {row[0] for row in cur.fetchall()}
+
+    prefix = f"{bank}/" if bank else ""
+    cur = _execute(
+        f"SELECT DISTINCT bank FROM {_TABLE} WHERE bank LIKE ?", (f"{prefix}%",)
+    )
+    for (subbank,) in cur.fetchall():
+        remainder = subbank[len(prefix) :]
+        if remainder:
+            names.add(remainder.split("/", 1)[0])
+    return list(names)
+
+
+def contains(bank, key=None):
+    """
+    Checks if the specified bank contains the specified key (or, if ``key``
+    is ``None``, whether the bank -- or any sub-bank of it -- exists at
+    all).
+    """
+    if key is None:
+        pattern = f"{bank}/%" if bank else "%"
+        cur = _execute(
+            f"SELECT 1 FROM {_TABLE} WHERE bank=? OR bank LIKE ? LIMIT 1",
+            (bank, pattern),
+        )
+        return cur.fetchone() is not None
+
+    cur = _execute(
+        f"SELECT 1 FROM {_TABLE} WHERE bank=? AND cache_key=? LIMIT 1", (bank, key)
+    )
+    return cur.fetchone() is not None
