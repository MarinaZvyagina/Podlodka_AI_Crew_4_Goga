diff --git a/changelog/69890.changed.md b/changelog/69890.changed.md
new file mode 100644
index 0000000..95117b9
--- /dev/null
+++ b/changelog/69890.changed.md
@@ -0,0 +1,3 @@
+``disk.usage`` now caches its result in ``__context__`` per set of ``df`` flags, so
+repeated calls within the same execution/state run no longer re-invoke and
+re-parse ``df`` output. The cache does not persist across separate Salt runs.
diff --git a/salt/modules/disk.py b/salt/modules/disk.py
index f766769..d618837 100644
--- a/salt/modules/disk.py
+++ b/salt/modules/disk.py
@@ -94,6 +94,9 @@ def usage(args=None):
         salt '*' disk.usage
     """
     flags = _clean_flags(args, "disk.usage")
+    cache_key = f"disk.usage.{flags}"
+    if cache_key in __context__:
+        return __context__[cache_key]
     if not os.path.isfile("/etc/mtab") and __grains__["kernel"] == "Linux":
         log.error("df cannot run without /etc/mtab")
         if __grains__.get("virtual_subtype") == "LXC":
@@ -157,6 +160,7 @@ def usage(args=None):
         except IndexError:
             log.error("Problem parsing disk usage information")
             ret = {}
+    __context__[cache_key] = ret
     return ret
 
 
diff --git a/tests/pytests/unit/modules/test_disk.py b/tests/pytests/unit/modules/test_disk.py
index 11b2170..560cae4 100644
--- a/tests/pytests/unit/modules/test_disk.py
+++ b/tests/pytests/unit/modules/test_disk.py
@@ -162,6 +162,36 @@ def test_usage_none():
             assert "" == disk.usage(args=None)
 
 
+def test_usage_caches_result_per_run():
+    """
+    disk.usage should only shell out to df once per set of flags within
+    a single run, and __context__ isn't shared across runs, so a fresh
+    context still triggers a real call.
+    """
+    df_output = (
+        "Filesystem     1024-blocks     Used Available Capacity Mounted on\n"
+        "/dev/sda1          10000     5000      5000      50% /"
+    )
+    mock_cmd = MagicMock(return_value=df_output)
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch.dict(
+        disk.__salt__, {"cmd.run": mock_cmd}
+    ), patch("os.path.isfile", MagicMock(return_value=True)):
+        first = disk.usage()
+        second = disk.usage()
+        assert first == second
+        mock_cmd.assert_called_once()
+
+        # A different set of flags is not served from the cached entry.
+        disk.usage(args="h")
+        assert mock_cmd.call_count == 2
+
+        # A fresh __context__ (as happens on a new, independent run)
+        # forces df to be re-run instead of reusing stale data.
+        disk.__context__.clear()
+        disk.usage()
+        assert mock_cmd.call_count == 3
+
+
 def test_inodeusage(stub_disk_inodeusage):
