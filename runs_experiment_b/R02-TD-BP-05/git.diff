diff --git a/tests/pytests/unit/modules/test_disk.py b/tests/pytests/unit/modules/test_disk.py
index 11b2170..9d79d31 100644
--- a/tests/pytests/unit/modules/test_disk.py
+++ b/tests/pytests/unit/modules/test_disk.py
@@ -162,6 +162,30 @@ def test_usage_none():
             assert "" == disk.usage(args=None)
 
 
+def test_usage_is_cached_within_a_run():
+    """
+    Repeated calls with the same args should only shell out to df once,
+    with the cached result served from __context__.
+    """
+    df_output = (
+        "Filesystem 1K-blocks Used Available Capacity Mounted\n"
+        "/dev/sda1 10000 5000 5000 50% /"
+    )
+    mock_cmd = MagicMock(return_value=df_output)
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch(
+        "os.path.isfile", MagicMock(return_value=True)
+    ), patch.dict(disk.__salt__, {"cmd.run": mock_cmd}):
+        first = disk.usage()
+        second = disk.usage()
+
+        assert first == second
+        mock_cmd.assert_called_once()
+
+        # Different args should not hit the cached entry for the prior call.
+        disk.usage(args="h")
+        assert mock_cmd.call_count == 2
+
+
 def test_inodeusage(stub_disk_inodeusage):
     with patch.dict(disk.__grains__, {"kernel": "OpenBSD"}), patch(
