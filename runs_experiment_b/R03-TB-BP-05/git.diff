   public async close(server: Server): Promise<void> {
+    const notified = this.notifyClientsOfShutdown(server);
+    if (notified) {
+      // engine.io flushes an emitted packet to the underlying transport
+      // synchronously, but `Server#close()` force-closes every transport
+      // (bypassing its normal "wait for the write buffer to drain" path)
+      // moments later in the same call. Yielding one event-loop tick lets
+      // Node actually hand the just-written bytes off to the socket before
+      // that force-close tears it down, so the notice isn't dropped.
+      await new Promise(resolve => setImmediate(resolve));
+    }
+
     if (this.forceCloseConnections && server.httpServer === this.httpServer) {
       return;
     }
 
     return super.close(server);
   }
+
+  /**
+   * Gives still-connected clients a chance to distinguish a deploy/shutdown
+   * from a dropped connection before the server disconnects them. `server`
+   * may be the root `Server` (default namespace) or a `Namespace` returned
+   * by `create()` — only the former exposes `.of()`, so it's used here to
+   * resolve down to the `Namespace` that actually tracks local sockets.
+   */
+  private notifyClientsOfShutdown(server: Server | Namespace): boolean {
+    const namespace: Namespace = isFunction((server as Server).of)
+      ? (server as Server).sockets
+      : (server as Namespace);
+
+    if (!namespace?.sockets?.size) {
+      return false;
+    }
+    namespace.sockets.forEach(socket =>
+      socket.emit(SERVER_SHUTTING_DOWN_EVENT, {
+        message: SERVER_SHUTTING_DOWN_MESSAGE,
+      }),
+    );
+    return true;
+  }
 }
