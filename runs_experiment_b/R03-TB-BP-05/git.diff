+   * Gives still-connected clients a chance to distinguish a deploy/shutdown
+   * from a dropped connection before `close()` terminates them. Waits for
+   * each `send()` to be handed off to the underlying socket (not for the
+   * client to receive it) so the immediately-following `terminate()` calls
+   * don't race the just-queued frame off of Node's write buffer.
+   */
+  private notifyClientsOfShutdown(server: any): Promise<unknown> {
+    if (!server.clients) {
+      return Promise.resolve();
+    }
+    const payload = JSON.stringify({
+      event: SERVER_SHUTTING_DOWN_EVENT,
+      data: { message: SERVER_SHUTTING_DOWN_MESSAGE },
+    });
+    return Promise.all(
+      Array.from(server.clients as Iterable<any>)
+        .filter(ws => ws.readyState === READY_STATE.OPEN_STATE)
+        .map(
+          ws => new Promise<void>(resolve => ws.send(payload, () => resolve())),
+        ),
+    );
+  }
