+import { INestApplication } from '@nestjs/common';
+import { SERVER_SHUTTING_DOWN_EVENT } from '@nestjs/websockets';
+import { WsAdapter } from '@nestjs/platform-ws';
+import { Test } from '@nestjs/testing';
+import { io } from 'socket.io-client';
+import WebSocket from 'ws';
+import { ApplicationGateway } from '../src/app.gateway.js';
+
+async function createNestApp(...gateways: any[]): Promise<INestApplication> {
+  const testingModule = await Test.createTestingModule({
+    providers: gateways,
+  }).compile();
+  return testingModule.createNestApplication();
+}
+
+describe('WebSocketGateway shutdown notice', () => {
+  let app: INestApplication;
+
+  afterEach(async () => {
+    if (app) {
+      await app.close();
+    }
+  });
+
+  it('notifies a connected socket.io client before closing its connection', async () => {
+    app = await createNestApp(ApplicationGateway);
+    await app.listen(3000);
+
+    const client = io('http://localhost:8080');
+    await new Promise<void>((resolve, reject) => {
+      client.on('connect', resolve);
+      client.on('connect_error', reject);
+    });
+
+    const noticePromise = new Promise<any>(resolve =>
+      client.once(SERVER_SHUTTING_DOWN_EVENT, resolve),
+    );
+    const disconnectPromise = new Promise<void>(resolve =>
+      client.once('disconnect', () => resolve()),
+    );
+
+    await app.close();
+    app = undefined as any;
+
+    const notice = await noticePromise;
+    expect(notice).toMatchObject({ message: expect.any(String) });
+    await disconnectPromise;
+
+    client.close();
+  });
+
+  it('notifies a connected ws client before closing its connection', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [ApplicationGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    app.useWebSocketAdapter(new WsAdapter(app) as any);
+    await app.listen(3000);
+
+    const client = new WebSocket('ws://localhost:8080');
+    await new Promise(resolve => client.on('open', resolve));
+
+    const noticePromise = new Promise<any>(resolve =>
+      client.once('message', data => resolve(JSON.parse(data.toString()))),
+    );
+    const closePromise = new Promise<void>(resolve =>
+      client.once('close', () => resolve()),
+    );
+
+    await app.close();
+    app = undefined as any;
+
+    const notice = await noticePromise;
+    expect(notice).toEqual({
+      event: SERVER_SHUTTING_DOWN_EVENT,
+      data: { message: expect.any(String) },
+    });
+    await closePromise;
+  });
+
+  it('closes a gateway with no connected clients without error', async () => {
+    app = await createNestApp(ApplicationGateway);
+    await app.listen(3000);
+
+    await expect(app.close()).resolves.toBeUndefined();
+    app = undefined as any;
+  });
+
+  it('closes an app with no WebSocket gateways without error', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [],
+    }).compile();
+    app = testingModule.createNestApplication();
+    await app.listen(3000);
+
+    await expect(app.close()).resolves.toBeUndefined();
+    app = undefined as any;
+  });
+});
