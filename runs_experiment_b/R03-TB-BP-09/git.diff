+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import { io } from 'socket.io-client';
+import { ApplicationGateway } from '../src/app.gateway.js';
+
+async function createNestApp(
+  notifyWebSocketClientsOnShutdown: boolean,
+): Promise<INestApplication> {
+  const testingModule = await Test.createTestingModule({
+    providers: [ApplicationGateway],
+  }).compile();
+  return testingModule.createNestApplication({
+    notifyWebSocketClientsOnShutdown,
+  });
+}
+
+describe('WebSocketGateway shutdown notification (IoAdapter)', () => {
+  it('should notify a connected client before disconnecting it on shutdown', async () => {
+    const app = await createNestApp(true);
+    await app.listen(3000);
+
+    const client = io('http://localhost:8080');
+    await new Promise<void>(resolve => client.on('connect', resolve));
+
+    const receivedMessage = new Promise<any>((resolve, reject) => {
+      client.once('shutdown', resolve);
+      client.once('disconnect', () =>
+        reject(new Error('disconnected before receiving a message')),
+      );
+    });
+
+    await app.close();
+
+    const message = await receivedMessage;
+    expect(message).toEqual('Server is shutting down');
+
+    client.close();
+  });
+
+  it('should not send anything when the option is disabled', async () => {
+    const app = await createNestApp(false);
+    await app.listen(3000);
+
+    const client = io('http://localhost:8080');
+    await new Promise<void>(resolve => client.on('connect', resolve));
+
+    const onShutdown = vi.fn();
+    client.on('shutdown', onShutdown);
+    const disconnected = new Promise<void>(resolve =>
+      client.once('disconnect', () => resolve()),
+    );
+
+    await app.close();
+    await disconnected;
+
+    expect(onShutdown).not.toHaveBeenCalled();
+    client.close();
+  });
+});
