@@ -0,0 +1,57 @@
+import { INestApplication } from '@nestjs/common';
+import { WsAdapter } from '@nestjs/platform-ws';
+import { Test } from '@nestjs/testing';
+import WebSocket from 'ws';
+import { ApplicationGateway } from '../src/app.gateway.js';
+
+async function createNestApp(
+  notifyWebSocketClientsOnShutdown: boolean,
+): Promise<INestApplication> {
+  const testingModule = await Test.createTestingModule({
+    providers: [ApplicationGateway],
+  }).compile();
+  const app = testingModule.createNestApplication({
+    notifyWebSocketClientsOnShutdown,
+  });
+  app.useWebSocketAdapter(new WsAdapter(app) as any);
+  return app;
+}
+
+describe('WebSocketGateway shutdown notification (WsAdapter)', () => {
+  it('should notify a connected client before terminating it on shutdown', async () => {
+    const app = await createNestApp(true);
+    await app.listen(3000);
+
+    const ws = new WebSocket('ws://localhost:8080');
+    await new Promise(resolve => ws.on('open', resolve));
+
+    const receivedMessage = new Promise<any>((resolve, reject) => {
+      ws.once('message', data => resolve(JSON.parse(data.toString())));
+      ws.once('close', () =>
+        reject(new Error('connection closed before receiving a message')),
+      );
+    });
+
+    await app.close();
+
+    const message = await receivedMessage;
+    expect(message.event).toEqual('shutdown');
+  });
+
+  it('should not send anything when the option is disabled', async () => {
+    const app = await createNestApp(false);
+    await app.listen(3000);
+
+    const ws = new WebSocket('ws://localhost:8080');
+    await new Promise(resolve => ws.on('open', resolve));
+
+    const onMessage = vi.fn();
+    ws.on('message', onMessage);
+    const closed = new Promise<void>(resolve => ws.once('close', resolve));
+
+    await app.close();
+    await closed;
+
+    expect(onMessage).not.toHaveBeenCalled();
+  });
+});
