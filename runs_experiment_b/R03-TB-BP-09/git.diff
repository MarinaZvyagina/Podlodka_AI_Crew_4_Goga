diff --git a/packages/platform-ws/test/ws-adapter.spec.ts b/packages/platform-ws/test/ws-adapter.spec.ts
new file mode 100644
index 0000000..7536be2
--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,68 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+function createFakeClient(readyState = 1) {
+  return {
+    readyState,
+    send: vi.fn(),
+    terminate: vi.fn(),
+  };
+}
+
+function createFakeServer(clients: any[]) {
+  return {
+    clients: new Set(clients),
+    close: vi.fn(callback => callback()),
+  } as any;
+}
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('close', () => {
+    it('should send a shutdown notification to every open client before terminating it when enabled', async () => {
+      adapter.notifyClientsOnShutdown = true;
+      const client = createFakeClient();
+      const server = createFakeServer([client]);
+
+      await adapter.close(server);
+
+      expect(client.send).toHaveBeenCalledWith(
+        JSON.stringify({ event: 'shutdown', data: 'Server is shutting down' }),
+      );
+      expect(client.terminate).toHaveBeenCalled();
+    });
+
+    it('should not notify clients that are not open', async () => {
+      adapter.notifyClientsOnShutdown = true;
+      const client = createFakeClient(3); // CLOSED
+      const server = createFakeServer([client]);
+
+      await adapter.close(server);
+
+      expect(client.send).not.toHaveBeenCalled();
+      expect(client.terminate).toHaveBeenCalled();
+    });
+
+    it('should not send anything when disabled', async () => {
+      adapter.notifyClientsOnShutdown = false;
+      const client = createFakeClient();
+      const server = createFakeServer([client]);
+
+      await adapter.close(server);
+
+      expect(client.send).not.toHaveBeenCalled();
+      expect(client.terminate).toHaveBeenCalled();
+    });
+
+    it('should not throw when there are no connected clients', async () => {
+      adapter.notifyClientsOnShutdown = true;
+      const server = createFakeServer([]);
+
+      await expect(adapter.close(server)).resolves.toBeUndefined();
+    });
+  });
+});
