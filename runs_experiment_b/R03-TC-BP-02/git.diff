+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the application's maintenance mode state.
+ *
+ * Toggling this service does not by itself affect any request or message
+ * handler — it is consulted by `MaintenanceGuard`, which denies access to
+ * handlers marked with `@Maintenance()` while maintenance mode is enabled.
+ *
+ * Inject this service wherever maintenance mode needs to be switched on or
+ * off at runtime (e.g. from an internal admin endpoint), without redeploying
+ * the application.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private maintenanceModeEnabled = false;
+
+  /**
+   * Switches maintenance mode on. Handlers marked with `@Maintenance()` will
+   * start being rejected by `MaintenanceGuard`.
+   */
+  enable(): void {
+    this.maintenanceModeEnabled = true;
+  }
+
+  /**
+   * Switches maintenance mode off. Handlers marked with `@Maintenance()`
+   * resume working normally.
+   */
+  disable(): void {
+    this.maintenanceModeEnabled = false;
+  }
+
+  /**
+   * Returns whether maintenance mode is currently enabled.
+   */
+  isEnabled(): boolean {
+    return this.maintenanceModeEnabled;
+  }
+}
diff --git a/packages/core/maintenance/maintenance.guard.ts b/packages/core/maintenance/maintenance.guard.ts
new file mode 100644
index 0000000..df8df80
--- /dev/null
+++ b/packages/core/maintenance/maintenance.guard.ts
@@ -0,0 +1,52 @@
+import {
+  type CanActivate,
+  type ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { MAINTENANCE_METADATA } from '@nestjs/common/internal';
+import { Reflector } from '../services/reflector.service.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Denies access to any handler marked with `@Maintenance()` while
+ * `MaintenanceModeService` reports maintenance mode as enabled, before the
+ * handler's own logic runs.
+ *
+ * Because it implements `CanActivate`, this guard is evaluated the same way
+ * for HTTP route handlers, WebSocket message handlers, and RPC handlers —
+ * there is a single marking mechanism (`@Maintenance()`) and a single
+ * enforcement mechanism (this guard) for all of them.
+ *
+ * Register it as a global guard (e.g. via `APP_GUARD`) so it observes every
+ * handler and only acts on the ones explicitly marked.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    if (!this.maintenanceModeService.isEnabled()) {
+      return true;
+    }
+
+    const isAffectedByMaintenanceMode =
+      this.reflector.getAllAndOverride<boolean>(MAINTENANCE_METADATA, [
+        context.getHandler(),
+        context.getClass(),
+      ]);
+
+    if (isAffectedByMaintenanceMode) {
+      throw new ServiceUnavailableException(
+        'This endpoint is temporarily unavailable for maintenance.',
+      );
+    }
+
+    return true;
+  }
+}
