+import { MAINTENANCE_METADATA } from '../../constants.js';
+import { Maintenance } from '../../decorators/core/maintenance.decorator.js';
+
+describe('@Maintenance', () => {
+  @Maintenance()
+  class MarkedController {
+    unmarkedHandler() {}
+
+    @Maintenance()
+    markedHandler() {}
+  }
+
+  class UnmarkedController {
+    handler() {}
+  }
+
+  it('should mark a decorated class with maintenance metadata', () => {
+    expect(Reflect.getMetadata(MAINTENANCE_METADATA, MarkedController)).toBe(
+      true,
+    );
+  });
+
+  it('should mark a decorated method with maintenance metadata', () => {
+    expect(
+      Reflect.getMetadata(
+        MAINTENANCE_METADATA,
+        MarkedController.prototype.markedHandler,
+      ),
+    ).toBe(true);
+  });
+
+  it('should not mark an undecorated method on a decorated class', () => {
+    expect(
+      Reflect.getMetadata(
+        MAINTENANCE_METADATA,
+        MarkedController.prototype.unmarkedHandler,
+      ),
+    ).toBeUndefined();
+  });
+
+  it('should not mark an undecorated class or its handlers', () => {
+    expect(
+      Reflect.getMetadata(MAINTENANCE_METADATA, UnmarkedController),
+    ).toBeUndefined();
+    expect(
+      Reflect.getMetadata(
+        MAINTENANCE_METADATA,
+        UnmarkedController.prototype.handler,
+      ),
+    ).toBeUndefined();
+  });
+});
