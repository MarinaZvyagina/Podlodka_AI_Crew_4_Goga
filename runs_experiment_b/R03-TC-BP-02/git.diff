@@ -0,0 +1,20 @@
+import { MAINTENANCE_METADATA } from '../../constants.js';
+import { CustomDecorator, SetMetadata } from './set-metadata.decorator.js';
+
+/**
+ * Marks a controller or an individual route/message handler as affected by
+ * maintenance mode.
+ *
+ * When applied to a handler, only that handler is affected. When applied to
+ * a controller or gateway class, every handler it declares is affected.
+ *
+ * The marking itself has no effect by default — pair it with a guard (such as
+ * a `MaintenanceGuard`) that checks this metadata against the current
+ * maintenance mode state and denies the request/message accordingly.
+ *
+ * @see [Guards](https://docs.nestjs.com/guards)
+ *
+ * @publicApi
+ */
+export const Maintenance = (): CustomDecorator<string> =>
+  SetMetadata(MAINTENANCE_METADATA, true);
