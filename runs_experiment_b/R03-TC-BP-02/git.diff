+import { MaintenanceModeService } from '../../maintenance/maintenance-mode.service.js';
+
+describe('MaintenanceModeService', () => {
+  let service: MaintenanceModeService;
+
+  beforeEach(() => {
+    service = new MaintenanceModeService();
+  });
+
+  it('should be disabled by default', () => {
+    expect(service.isEnabled()).toBe(false);
+  });
+
+  it('should report enabled after enable() is called', () => {
+    service.enable();
+    expect(service.isEnabled()).toBe(true);
+  });
+
+  it('should report disabled again after disable() is called', () => {
+    service.enable();
+    service.disable();
+    expect(service.isEnabled()).toBe(false);
+  });
+});
diff --git a/packages/core/test/maintenance/maintenance.guard.spec.ts b/packages/core/test/maintenance/maintenance.guard.spec.ts
new file mode 100644
index 0000000..a8f897a
--- /dev/null
+++ b/packages/core/test/maintenance/maintenance.guard.spec.ts
@@ -0,0 +1,101 @@
+import { Maintenance, ServiceUnavailableException } from '@nestjs/common';
+import { ExecutionContextHost } from '../../helpers/execution-context-host.js';
+import { MaintenanceModeService } from '../../maintenance/maintenance-mode.service.js';
+import { MaintenanceGuard } from '../../maintenance/maintenance.guard.js';
+import { Reflector } from '../../services/reflector.service.js';
+
+describe('MaintenanceGuard', () => {
+  let guard: MaintenanceGuard;
+  let maintenanceModeService: MaintenanceModeService;
+
+  class UnmarkedController {
+    handler() {}
+  }
+
+  class ControllerWithMarkedHandler {
+    @Maintenance()
+    affectedHandler() {}
+
+    unaffectedHandler() {}
+  }
+
+  @Maintenance()
+  class FullyMarkedController {
+    handler() {}
+  }
+
+  const contextFor = (constructorRef: Function, handler: Function) =>
+    new ExecutionContextHost([], constructorRef as any, handler);
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceGuard(new Reflector(), maintenanceModeService);
+  });
+
+  describe('when maintenance mode is disabled', () => {
+    it('allows a handler that is marked with @Maintenance()', () => {
+      const context = contextFor(
+        ControllerWithMarkedHandler,
+        ControllerWithMarkedHandler.prototype.affectedHandler,
+      );
+      expect(guard.canActivate(context)).toBe(true);
+    });
+
+    it('allows a handler that is not marked', () => {
+      const context = contextFor(
+        UnmarkedController,
+        UnmarkedController.prototype.handler,
+      );
+      expect(guard.canActivate(context)).toBe(true);
+    });
+  });
+
+  describe('when maintenance mode is enabled', () => {
+    beforeEach(() => maintenanceModeService.enable());
+
+    it('blocks a handler marked directly with @Maintenance()', () => {
+      const context = contextFor(
+        ControllerWithMarkedHandler,
+        ControllerWithMarkedHandler.prototype.affectedHandler,
+      );
+      expect(() => guard.canActivate(context)).toThrow(
+        ServiceUnavailableException,
+      );
+    });
+
+    it('does not block a sibling handler on the same controller that is not marked', () => {
+      const context = contextFor(
+        ControllerWithMarkedHandler,
+        ControllerWithMarkedHandler.prototype.unaffectedHandler,
+      );
+      expect(guard.canActivate(context)).toBe(true);
+    });
+
+    it('blocks every handler on a controller marked at the class level', () => {
+      const context = contextFor(
+        FullyMarkedController,
+        FullyMarkedController.prototype.handler,
+      );
+      expect(() => guard.canActivate(context)).toThrow(
+        ServiceUnavailableException,
+      );
+    });
+
+    it('does not block handlers on an entirely unmarked controller', () => {
+      const context = contextFor(
+        UnmarkedController,
+        UnmarkedController.prototype.handler,
+      );
+      expect(guard.canActivate(context)).toBe(true);
+    });
+
+    it('allows the handler again once maintenance mode is disabled', () => {
+      maintenanceModeService.disable();
+      const context = contextFor(
+        ControllerWithMarkedHandler,
+        ControllerWithMarkedHandler.prototype.affectedHandler,
+      );
+      expect(guard.canActivate(context)).toBe(true);
+    });
+  });
+});
