@@ -0,0 +1,21 @@
+import { Controller, Get } from '@nestjs/common';
+import { AffectedByMaintenance } from './affected-by-maintenance.decorator.js';
+
+/**
+ * An entire controller can be marked at once, rather than annotating every
+ * handler individually, for the case where a whole slice of the API depends
+ * on the data being migrated.
+ */
+@Controller('legacy-data')
+@AffectedByMaintenance()
+export class LegacyDataController {
+  @Get()
+  findAll() {
+    return { data: [] };
+  }
+
+  @Get('summary')
+  summary() {
+    return { summary: 'ok' };
+  }
+}
