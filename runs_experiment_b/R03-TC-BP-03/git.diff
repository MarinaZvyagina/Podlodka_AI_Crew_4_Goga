+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { io } from 'socket.io-client';
+import { AppModule } from '../src/app.module.js';
+
+describe('Maintenance mode (e2e)', () => {
+  let app: INestApplication;
+
+  beforeEach(async () => {
+    const testingModule = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = testingModule.createNestApplication();
+    await app.listen(3000);
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  it('lets unmarked routes through no matter what', async () => {
+    await request(app.getHttpServer()).get('/status').expect(200);
+
+    await request(app.getHttpServer())
+      .post('/admin/maintenance-mode/enable')
+      .expect(201);
+
+    await request(app.getHttpServer()).get('/status').expect(200);
+  });
+
+  it('blocks a method-marked route only while maintenance mode is on', async () => {
+    await request(app.getHttpServer()).get('/reports').expect(200);
+
+    await request(app.getHttpServer())
+      .post('/admin/maintenance-mode/enable')
+      .expect(201);
+
+    await request(app.getHttpServer()).get('/reports').expect(403);
+
+    await request(app.getHttpServer())
+      .post('/admin/maintenance-mode/disable')
+      .expect(201);
+
+    await request(app.getHttpServer()).get('/reports').expect(200);
+  });
+
+  it('blocks every route on a class-marked controller while maintenance mode is on', async () => {
+    await request(app.getHttpServer())
+      .post('/admin/maintenance-mode/enable')
+      .expect(201);
+
+    await request(app.getHttpServer()).get('/legacy-data').expect(403);
+    await request(app.getHttpServer()).get('/legacy-data/summary').expect(403);
+  });
+
+  it('blocks a marked WebSocket message handler while maintenance mode is on, leaving others working', async () => {
+    await request(app.getHttpServer())
+      .post('/admin/maintenance-mode/enable')
+      .expect(201);
+
+    const ws = io('http://localhost:3000');
+
+    await new Promise<void>(resolve => {
+      ws.on('pong', () => resolve());
+      ws.emit('ping', {});
+    });
+
+    await new Promise<void>(resolve => {
+      ws.on('exception', error => {
+        expect(error.status).toEqual('error');
+        expect(error.message).toEqual('Forbidden resource');
+        resolve();
+      });
+      ws.emit('migrateRecord', {});
+    });
+
+    ws.close();
+  });
+});
