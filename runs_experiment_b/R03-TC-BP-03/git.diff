new file mode 100644
index 0000000..9ad549a
--- /dev/null
+++ b/integration/maintenance-mode/test/maintenance-mode.guard.spec.ts
@@ -0,0 +1,100 @@
+import { ExecutionContext } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { AffectedByMaintenance } from '../src/affected-by-maintenance.decorator.js';
+import { MaintenanceModeGuard } from '../src/maintenance-mode.guard.js';
+import { MaintenanceModeService } from '../src/maintenance-mode.service.js';
+
+class UnmarkedController {
+  normalHandler() {}
+}
+
+class PartiallyMarkedController {
+  normalHandler() {}
+
+  @AffectedByMaintenance()
+  markedHandler() {}
+}
+
+@AffectedByMaintenance()
+class FullyMarkedController {
+  anyHandler() {}
+}
+
+function contextFor(instance: object, handlerName: string): ExecutionContext {
+  const handler = (instance as any)[handlerName];
+  return {
+    getHandler: () => handler,
+    getClass: () => instance.constructor,
+  } as unknown as ExecutionContext;
+}
+
+describe('MaintenanceModeGuard', () => {
+  let guard: MaintenanceModeGuard;
+  let maintenanceMode: MaintenanceModeService;
+
+  beforeEach(() => {
+    maintenanceMode = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(new Reflector(), maintenanceMode);
+  });
+
+  it('allows a handler with no @AffectedByMaintenance() marker, maintenance on or off', () => {
+    const context = contextFor(new UnmarkedController(), 'normalHandler');
+
+    expect(guard.canActivate(context)).toBe(true);
+
+    maintenanceMode.enable();
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('allows a method-marked handler while maintenance mode is off', () => {
+    const context = contextFor(
+      new PartiallyMarkedController(),
+      'markedHandler',
+    );
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks a method-marked handler while maintenance mode is on', () => {
+    const context = contextFor(
+      new PartiallyMarkedController(),
+      'markedHandler',
+    );
+
+    maintenanceMode.enable();
+
+    expect(guard.canActivate(context)).toBe(false);
+  });
+
+  it('leaves an unmarked handler on the same controller unaffected', () => {
+    const context = contextFor(
+      new PartiallyMarkedController(),
+      'normalHandler',
+    );
+
+    maintenanceMode.enable();
+
+    expect(guard.canActivate(context)).toBe(true);
+  });
+
+  it('blocks every handler on a class-level marked controller while maintenance mode is on', () => {
+    const context = contextFor(new FullyMarkedController(), 'anyHandler');
+
+    maintenanceMode.enable();
+
+    expect(guard.canActivate(context)).toBe(false);
+  });
+
+  it('restores access once maintenance mode is disabled again', () => {
+    const context = contextFor(
+      new PartiallyMarkedController(),
+      'markedHandler',
+    );
+
+    maintenanceMode.enable();
+    expect(guard.canActivate(context)).toBe(false);
+
+    maintenanceMode.disable();
+    expect(guard.canActivate(context)).toBe(true);
+  });
+});
