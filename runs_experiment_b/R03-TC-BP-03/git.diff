+import { CanActivate, ExecutionContext, Injectable } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { AffectedByMaintenance } from './affected-by-maintenance.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Denies calls to handlers marked `@AffectedByMaintenance()` while
+ * maintenance mode is on, before any of their own logic runs. Everything
+ * else passes through unaffected, regardless of whether maintenance mode is
+ * on or off.
+ *
+ * Applies uniformly to HTTP route handlers and WebSocket message handlers:
+ * both are dispatched through the same guard pipeline (`GuardsConsumer`),
+ * so this one guard is all that's needed for either transport.
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceMode: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isAffected = this.reflector.getAllAndOverride(AffectedByMaintenance, [
+      context.getHandler(),
+      context.getClass(),
+    ]);
+    return !isAffected || !this.maintenanceMode.isEnabled();
+  }
+}
