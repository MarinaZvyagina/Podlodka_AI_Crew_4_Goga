--- /dev/null
+++ b/integration/maintenance-mode/src/affected-by-maintenance.decorator.ts
@@ -0,0 +1,13 @@
+import { Reflector } from '@nestjs/core';
+
+/**
+ * Marks a route handler, a WebSocket message handler, or an entire
+ * controller/gateway as affected by maintenance mode. `MaintenanceModeGuard`
+ * looks this metadata up (method first, falling back to the class) to decide
+ * whether to reject a call while maintenance mode is switched on.
+ *
+ * Works the same way on both HTTP and WebSocket contexts because it's plain
+ * Nest metadata read through the shared guard pipeline, not a
+ * transport-specific mechanism.
+ */
+export const AffectedByMaintenance = Reflector.createDecorator<void>();
