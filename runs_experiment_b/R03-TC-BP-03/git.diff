+import { Controller, Get } from '@nestjs/common';
+import { AffectedByMaintenance } from './affected-by-maintenance.decorator.js';
+
+@Controller()
+export class AppController {
+  @Get('status')
+  getStatus() {
+    return { ok: true };
+  }
+
+  @Get('reports')
+  @AffectedByMaintenance()
+  getReports() {
+    return { report: 'ready' };
+  }
+}
