+import { SubscribeMessage, WebSocketGateway } from '@nestjs/websockets';
+import { AffectedByMaintenance } from './affected-by-maintenance.decorator.js';
+
+@WebSocketGateway()
+export class EventsGateway {
+  @SubscribeMessage('ping')
+  onPing() {
+    return { event: 'pong', data: {} };
+  }
+
+  @SubscribeMessage('migrateRecord')
+  @AffectedByMaintenance()
+  onMigrateRecord() {
+    return { event: 'migrateRecordAck', data: {} };
+  }
+}
