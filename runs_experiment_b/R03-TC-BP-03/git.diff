@@ -0,0 +1,22 @@
+import { Injectable } from '@nestjs/common';
+
+/**
+ * Holds the application's maintenance-mode flag in memory so it can be
+ * flipped at runtime (e.g. from an admin endpoint) without a redeploy.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  enable(): void {
+    this.enabled = true;
+  }
+
+  disable(): void {
+    this.enabled = false;
+  }
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+}
