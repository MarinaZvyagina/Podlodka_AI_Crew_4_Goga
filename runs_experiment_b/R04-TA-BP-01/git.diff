diff --git a/packages/excalidraw/data/filename.test.ts b/packages/excalidraw/data/filename.test.ts
new file mode 100644
index 0000000..5643f68
--- /dev/null
+++ b/packages/excalidraw/data/filename.test.ts
@@ -0,0 +1,34 @@
+import { sanitizeFilename } from "./filename";
+
+describe("sanitizeFilename", () => {
+  it("leaves an already-safe name untouched", () => {
+    expect(sanitizeFilename("My drawing")).toEqual({
+      name: "My drawing",
+      wasSanitized: false,
+    });
+  });
+
+  it("replaces characters forbidden on Windows/macOS/Linux", () => {
+    expect(sanitizeFilename('a/b\\c:d*e?f"g<h>i|j').name).toBe(
+      "a_b_c_d_e_f_g_h_i_j",
+    );
+  });
+
+  it("strips trailing dots and spaces", () => {
+    expect(sanitizeFilename("My drawing.").name).toBe("My drawing");
+    expect(sanitizeFilename("My drawing   ").name).toBe("My drawing");
+    expect(sanitizeFilename("My drawing... ").name).toBe("My drawing");
+  });
+
+  it("falls back to the default name when empty or only whitespace", () => {
+    expect(sanitizeFilename("").name).toBe("Untitled");
+    expect(sanitizeFilename("   ").name).toBe("Untitled");
+    expect(sanitizeFilename("...").name).toBe("Untitled");
+  });
+
+  it("reports whether the name had to be adjusted", () => {
+    expect(sanitizeFilename("My drawing").wasSanitized).toBe(false);
+    expect(sanitizeFilename("My drawing ").wasSanitized).toBe(true);
+    expect(sanitizeFilename("a/b").wasSanitized).toBe(true);
+  });
+});
diff --git a/packages/excalidraw/data/filename.ts b/packages/excalidraw/data/filename.ts
new file mode 100644
index 0000000..a4e02e6
--- /dev/null
+++ b/packages/excalidraw/data/filename.ts
@@ -0,0 +1,27 @@
+import { DEFAULT_FILENAME } from "@excalidraw/common";
+
+// characters forbidden in file names on Windows/macOS/Linux, plus ASCII
+// control characters, which are unsafe across all of them
+// eslint-disable-next-line no-control-regex
+const INVALID_FILENAME_CHARS_REGEX = /[/\\:*?"<>|\x00-\x1f]/g;
+
+// Windows silently strips trailing dots/spaces from a file name when saving,
+// so we strip them upfront to keep the saved file name in sync with what's
+// shown in the editor
+const TRAILING_DOTS_AND_SPACES_REGEX = /[.\s]+$/;
+
+/**
+ * Turns an arbitrary, user-supplied string into a name that's safe to use
+ * as a file name on Windows, macOS, and Linux.
+ */
+export const sanitizeFilename = (
+  name: string,
+): { name: string; wasSanitized: boolean } => {
+  const sanitized = name
+    .replace(INVALID_FILENAME_CHARS_REGEX, "_")
+    .replace(TRAILING_DOTS_AND_SPACES_REGEX, "");
+
+  const safeName = sanitized || DEFAULT_FILENAME;
+
+  return { name: safeName, wasSanitized: safeName !== name };
+};
