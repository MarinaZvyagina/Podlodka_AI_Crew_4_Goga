+import { polygonArea, round } from "@excalidraw/math";
+
+import {
+  isLineElement,
+  isFreeDrawElement,
+  isPathALoop,
+} from "@excalidraw/element";
+
+import type { NonDeletedExcalidrawElement } from "@excalidraw/element/types";
+
+import { t } from "../../i18n";
+
+const MIN_POLYGON_POINTS = 3;
+
+// Only shapes with a well-defined enclosed region get an area readout.
+// Lines and freedraw strokes only qualify once they form a closed outline;
+// everything else (arrows, text, images, frames, ...) is left out on purpose.
+export const getElementArea = (
+  element: NonDeletedExcalidrawElement,
+): number | null => {
+  if (isLineElement(element)) {
+    return element.polygon && element.points.length >= MIN_POLYGON_POINTS
+      ? polygonArea(element.points)
+      : null;
+  }
+
+  if (isFreeDrawElement(element)) {
+    return isPathALoop(element.points) ? polygonArea(element.points) : null;
+  }
+
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      // bounding box diagonals (width, height) are perpendicular, so
+      // area of the diamond is exactly half their product
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    default:
+      return null;
+  }
+};
+
+interface AreaProps {
+  element: NonDeletedExcalidrawElement;
+}
+
+const Area = ({ element }: AreaProps) => {
+  const area = getElementArea(element);
+
+  if (area === null) {
+    return null;
+  }
+
+  return (
+    <div
+      className="exc-stats__row"
+      data-testid="stats-area"
+      style={{ gridTemplateColumns: "repeat(2, 1fr)" }}
+    >
+      <div>{t("stats.area")}</div>
+      <div>{round(area, 2)}</div>
+    </div>
+  );
+};
+
+export default Area;
