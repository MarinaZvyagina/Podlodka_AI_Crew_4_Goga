new file mode 100644
index 0000000..3d22050
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
@@ -0,0 +1,209 @@
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { Keyboard } from "../tests/helpers/ui";
+import { render } from "../tests/test-utils";
+
+import { actionSnapToGrid } from "./actionSnapToGrid";
+
+const { h } = window;
+
+describe("actionSnapToGrid", () => {
+  beforeEach(async () => {
+    await render(
+      <Excalidraw
+        initialData={{ appState: { gridSize: 20 } }}
+        handleKeyboardGlobally
+      />,
+    );
+  });
+
+  it("snaps the selected shape's position and size to the grid", () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 41,
+    });
+
+    API.setElements([rect]);
+    API.setSelectedElements([rect]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated = API.getElement(rect);
+    expect(updated.x).toBe(20);
+    expect(updated.y).toBe(20);
+    expect(updated.width).toBe(40);
+    expect(updated.height).toBe(40);
+  });
+
+  it("snaps each selected shape independently, not as a group", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 11,
+      y: 11,
+      width: 30,
+      height: 30,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 109,
+      y: 9,
+      width: 30,
+      height: 30,
+    });
+
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([rect1, rect2]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect1).x).toBe(20);
+    expect(API.getElement(rect1).y).toBe(20);
+    expect(API.getElement(rect2).x).toBe(100);
+    expect(API.getElement(rect2).y).toBe(0);
+  });
+
+  it("snaps every shape on the canvas when nothing is selected", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 11,
+      y: 11,
+      width: 30,
+      height: 30,
+    });
+    const rect2 = API.createElement({
+      type: "ellipse",
+      x: 109,
+      y: 9,
+      width: 30,
+      height: 30,
+    });
+
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect1).x).toBe(20);
+    expect(API.getElement(rect1).y).toBe(20);
+    expect(API.getElement(rect2).x).toBe(100);
+    expect(API.getElement(rect2).y).toBe(0);
+  });
+
+  it("moves a bound arrow along with the shape it's attached to", () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 11,
+      y: 11,
+      width: 30,
+      height: 30,
+      boundElements: [{ type: "arrow", id: "arrow1" }],
+    });
+    const arrow = API.createElement({
+      type: "arrow",
+      id: "arrow1",
+      x: 41,
+      y: 26,
+      width: 50,
+      height: 0,
+      startBinding: {
+        elementId: rect.id,
+        fixedPoint: [1, 0.5],
+        mode: "orbit",
+      },
+      endBinding: null,
+    });
+
+    API.setElements([rect, arrow]);
+    API.setSelectedElements([rect]);
+
+    API.executeAction(actionSnapToGrid);
+
+    // the arrow's bound endpoint should have been repositioned to follow
+    // the rectangle's new, grid-snapped edge rather than staying at its
+    // stale pre-snap coordinates
+    const updatedRect = API.getElement(rect);
+    const updatedArrow = API.getElement(arrow);
+    expect(updatedArrow.x).not.toBe(41);
+    expect(updatedArrow.x).toBeGreaterThanOrEqual(updatedRect.x);
+    expect(updatedArrow.x).toBeLessThanOrEqual(
+      updatedRect.x + updatedRect.width + 20,
+    );
+  });
+
+  it("reverts the snap in a single undo step", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 41,
+    });
+    const rect2 = API.createElement({
+      type: "ellipse",
+      x: 8,
+      y: 91,
+      width: 22,
+      height: 18,
+    });
+
+    API.updateScene({
+      elements: [rect1, rect2],
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    });
+    API.setSelectedElements([rect1, rect2]);
+
+    const undoStackAfterCreation = API.getUndoStack().length;
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect1).x).toBe(20);
+    expect(API.getElement(rect2).y).toBe(100);
+    // the snap should push exactly one entry, on top of the creation entry
+    expect(API.getUndoStack().length).toBe(undoStackAfterCreation + 1);
+
+    Keyboard.undo();
+
+    // a single undo fully reverts the snap — the elements still exist,
+    // they're just back at their pre-snap position/size
+    expect(API.getUndoStack().length).toBe(undoStackAfterCreation);
+    expect(API.getElement(rect1).x).toBe(12);
+    expect(API.getElement(rect1).y).toBe(27);
+    expect(API.getElement(rect1).width).toBe(53);
+    expect(API.getElement(rect1).height).toBe(41);
+    expect(API.getElement(rect2).x).toBe(8);
+    expect(API.getElement(rect2).y).toBe(91);
+  });
+
+  it("is a no-op when the shape is already aligned to the grid", () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 20,
+      y: 40,
+      width: 60,
+      height: 80,
+    });
+
+    API.setElements([rect]);
+    API.setSelectedElements([rect]);
+
+    const versionBefore = API.getElement(rect).version;
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect).version).toBe(versionBefore);
+  });
+
+  it("is disabled when the canvas is empty", () => {
+    API.setElements([]);
+    API.setSelectedElements([]);
+
+    expect(actionSnapToGrid.predicate!(h.elements, h.state, {}, h.app)).toBe(
+      false,
+    );
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
