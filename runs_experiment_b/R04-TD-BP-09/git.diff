index 0000000..53626d8
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,145 @@
+import { getGridPoint } from "@excalidraw/common";
+
+import {
+  getNonDeletedElements,
+  getBoundTextElement,
+  updateBoundElements,
+  resizeSingleElement,
+  isTextElement,
+  isLinearElement,
+  isFreeDrawElement,
+  isFrameLikeElement,
+  CaptureUpdateAction,
+} from "@excalidraw/element";
+
+import type { Scene } from "@excalidraw/element";
+import type {
+  ExcalidrawElement,
+  NonDeletedExcalidrawElement,
+} from "@excalidraw/element/types";
+
+import { gridIcon } from "../components/icons";
+
+import { register } from "./register";
+
+import type { AppClassProperties, AppState, NullableGridSize } from "../types";
+
+const getSnapToGridTargets = (
+  elements: readonly ExcalidrawElement[],
+  appState: AppState,
+  app: AppClassProperties,
+): NonDeletedExcalidrawElement[] => {
+  const selectedElements = app.scene.getSelectedElements(appState);
+  if (selectedElements.length > 0) {
+    return selectedElements;
+  }
+
+  // nothing selected → snap every shape on the canvas
+  return getNonDeletedElements(elements).filter(
+    (element) =>
+      !element.locked && !(isTextElement(element) && element.containerId),
+  );
+};
+
+// linear/freedraw elements store their geometry as `points` relative to
+// (x, y) rather than deriving it from width/height, and resizing a bound
+// arrow would unbind it — so those, along with text and frames, are only
+// translated to the nearest grid line, never resized
+const isResizableToGrid = (element: ExcalidrawElement) =>
+  !isTextElement(element) &&
+  !isLinearElement(element) &&
+  !isFreeDrawElement(element) &&
+  !isFrameLikeElement(element);
+
+// `gridSize` is always a concrete number here (unlike interactive dragging,
+// this command isn't gated on grid mode being toggled on), but `getGridPoint`
+// takes the nominally-branded `NullableGridSize` used elsewhere for snapping
+const toGridPoint = (x: number, y: number, gridSize: number) =>
+  getGridPoint(x, y, gridSize as unknown as NullableGridSize);
+
+const snapElementToGrid = (
+  element: NonDeletedExcalidrawElement,
+  scene: Scene,
+  gridSize: number,
+) => {
+  const elementsMap = scene.getNonDeletedElementsMap();
+  const [newX, newY] = toGridPoint(element.x, element.y, gridSize);
+
+  if (!isResizableToGrid(element)) {
+    if (newX === element.x && newY === element.y) {
+      return;
+    }
+
+    const dx = newX - element.x;
+    const dy = newY - element.y;
+
+    scene.mutateElement(element, { x: newX, y: newY });
+
+    const boundTextElement = getBoundTextElement(element, elementsMap);
+    if (boundTextElement) {
+      scene.mutateElement(boundTextElement, {
+        x: boundTextElement.x + dx,
+        y: boundTextElement.y + dy,
+      });
+    }
+
+    updateBoundElements(element, scene);
+    return;
+  }
+
+  const [newX2, newY2] = toGridPoint(
+    element.x + element.width,
+    element.y + element.height,
+    gridSize,
+  );
+  const newWidth = newX2 - newX;
+  const newHeight = newY2 - newY;
+
+  if (
+    newX === element.x &&
+    newY === element.y &&
+    newWidth === element.width &&
+    newHeight === element.height
+  ) {
+    return;
+  }
+
+  scene.mutateElement(element, { x: newX, y: newY });
+
+  if (newWidth > 0 && newHeight > 0) {
+    resizeSingleElement(
+      newWidth,
+      newHeight,
+      element,
+      element,
+      elementsMap,
+      scene,
+      "se",
+    );
+  } else {
+    updateBoundElements(element, scene);
+  }
+};
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  keywords: ["grid", "align", "snap"],
+  trackEvent: { category: "element" },
+  predicate: (elements, appState, appProps, app) =>
+    getSnapToGridTargets(elements, appState, app).length > 0,
+  perform: (elements, appState, _, app) => {
+    const targets = getSnapToGridTargets(elements, appState, app);
+
+    targets.forEach((element) => {
+      snapElementToGrid(element, app.scene, appState.gridSize);
+    });
+
+    return {
+      elements,
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
