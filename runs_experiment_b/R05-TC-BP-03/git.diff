+package scaleway
+
+import (
+	"net/http"
+	"reflect"
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+func TestGetInstances_Success(t *testing.T) {
+	var gotAuthToken string
+	s := newMockScalewayServer(func(req *http.Request) []byte {
+		gotAuthToken = req.Header.Get("X-Auth-Token")
+
+		const resp = `{
+			"servers": [{
+				"id": "fake-id-07f7-4b68-88ac-fake-id",
+				"name": "scaleway-sd",
+				"organization": "fake-org-id",
+				"project": "fake-project-id",
+				"tags": ["mock-tag"],
+				"commercial_type": "DEV1-S",
+				"state": "running",
+				"hostname": "scaleway-sd",
+				"private_ip": "10.10.10.1",
+				"public_ip": {"address": "51.15.0.1"},
+				"ipv6": {"address": "2001:bc8::1"},
+				"zone": "fr-par-1",
+				"boot_type": "local",
+				"arch": "x86_64",
+				"security_group": {"id": "fake-sg-id", "name": "Default security group"}
+			}]
+		}`
+
+		return []byte(resp)
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:         client,
+		secretKey: "fake-secret-key",
+	}
+
+	instances, err := getInstances(cfg, "fr-par-1")
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+
+	if gotAuthToken != "fake-secret-key" {
+		t.Fatalf("unexpected X-Auth-Token header sent to the server; got %q; want %q", gotAuthToken, "fake-secret-key")
+	}
+
+	expectedInstances := []Instance{
+		{
+			ID:             "fake-id-07f7-4b68-88ac-fake-id",
+			Name:           "scaleway-sd",
+			Organization:   "fake-org-id",
+			Project:        "fake-project-id",
+			Tags:           []string{"mock-tag"},
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Hostname:       "scaleway-sd",
+			PrivateIP:      "10.10.10.1",
+			PublicIP:       &PublicIP{Address: "51.15.0.1"},
+			IPv6:           &IPv6{Address: "2001:bc8::1"},
+			Zone:           "fr-par-1",
+			BootType:       "local",
+			Arch:           "x86_64",
+			SecurityGroup:  SecurityGroup{ID: "fake-sg-id", Name: "Default security group"},
+		},
+	}
+	if !reflect.DeepEqual(instances, expectedInstances) {
+		t.Fatalf("unexpected result\ngot\n%#v\nwant\n%#v", instances, expectedInstances)
+	}
+}
+
+func TestGetInstances_Failure(t *testing.T) {
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		return []byte("some error")
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c: client,
+	}
+
+	if _, err := getInstances(cfg, "fr-par-1"); err == nil {
+		t.Fatalf("expecting non-nil error from getInstances()")
+	}
+}
+
+func TestGetInstances_Paging(t *testing.T) {
+	requestCount := 0
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		if requestCount == 0 {
+			requestCount++
+			return []byte(mockListServersFullPageResp)
+		}
+		return []byte(mockListServersLastPageResp)
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c: client,
+	}
+
+	instances, err := getInstances(cfg, "fr-par-1")
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+	if len(instances) != instancesPerPage+1 {
+		t.Fatalf("unexpected number of instances returned; got %d; want %d", len(instances), instancesPerPage+1)
+	}
+}
+
+// ------------ Test dataset ------------
+
+var mockListServersFullPageResp = buildMockServersPage(instancesPerPage, "page0")
+var mockListServersLastPageResp = buildMockServersPage(1, "page1")
+
+func buildMockServersPage(count int, prefix string) string {
+	resp := `{"servers": [`
+	for i := 0; i < count; i++ {
+		if i > 0 {
+			resp += ","
+		}
+		resp += `{
+			"id": "` + prefix + `-fake-id",
+			"name": "scaleway-sd",
+			"state": "running",
+			"private_ip": "10.10.10.1",
+			"zone": "fr-par-1"
+		}`
+	}
+	resp += `]}`
+	return resp
+}
diff --git a/lib/promscrape/discovery/scaleway/mock_server_test.go b/lib/promscrape/discovery/scaleway/mock_server_test.go
new file mode 100644
