diff --git a/lib/promscrape/discovery/scaleway/api.go b/lib/promscrape/discovery/scaleway/api.go
new file mode 100644
index 0000000..6ad4616
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api.go
@@ -0,0 +1,93 @@
+package scaleway
+
+import (
+	"fmt"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+// defaultAPIServer is the default Scaleway API endpoint.
+const defaultAPIServer = "https://api.scaleway.com"
+
+// defaultZones is the list of Scaleway zones queried when `zone` isn't set explicitly in SDConfig.
+//
+// See: https://www.scaleway.com/en/developers/api/#regions-and-zones
+var defaultZones = []string{
+	"fr-par-1", "fr-par-2", "fr-par-3",
+	"nl-ams-1", "nl-ams-2", "nl-ams-3",
+	"pl-waw-1", "pl-waw-2", "pl-waw-3",
+}
+
+// apiConfig contains config for API server.
+type apiConfig struct {
+	c    *discoveryutil.Client
+	port int
+
+	project      string
+	organization string
+	secretKey    string
+	nameFilter   string
+	tagsFilter   []string
+	zones        []string
+}
+
+// getAPIConfig get or create API config from configMap.
+func getAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	v, err := configMap.Get(sdc, func() (any, error) { return newAPIConfig(sdc, baseDir) })
+	if err != nil {
+		return nil, err
+	}
+	return v.(*apiConfig), nil
+}
+
+// newAPIConfig create API Config.
+func newAPIConfig(sdc *SDConfig, baseDir string) (*apiConfig, error) {
+	port := sdc.Port
+	if port == 0 {
+		port = 80
+	}
+
+	if sdc.SecretKey == nil {
+		return nil, fmt.Errorf("missing `secret_key` option")
+	}
+	if sdc.Project == "" && sdc.Organization == "" {
+		return nil, fmt.Errorf("missing `project_id` or `organization_id` option; at least one of them must be set")
+	}
+
+	apiServer := sdc.APIURL
+	if apiServer == "" {
+		apiServer = defaultAPIServer
+	}
+
+	ac, err := sdc.HTTPClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse auth config: %w", err)
+	}
+	proxyAC, err := sdc.ProxyClientConfig.NewConfig(baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse proxy auth config: %w", err)
+	}
+
+	c, err := discoveryutil.NewClient(apiServer, ac, sdc.ProxyURL, proxyAC, &sdc.HTTPClientConfig)
+	if err != nil {
+		return nil, fmt.Errorf("cannot create client for %q: %w", apiServer, err)
+	}
+
+	zones := defaultZones
+	if sdc.Zone != "" {
+		zones = []string{sdc.Zone}
+	}
+
+	cfg := &apiConfig{
+		c:    c,
+		port: port,
+
+		project:      sdc.Project,
+		organization: sdc.Organization,
+		secretKey:    sdc.SecretKey.String(),
+		nameFilter:   sdc.NameFilter,
+		tagsFilter:   sdc.TagsFilter,
+		zones:        zones,
+	}
+	return cfg, nil
+}
diff --git a/lib/promscrape/discovery/scaleway/api_test.go b/lib/promscrape/discovery/scaleway/api_test.go
new file mode 100644
index 0000000..4eb07a0
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/api_test.go
@@ -0,0 +1,65 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	f := func(sdc *SDConfig) {
+		t.Helper()
+		baseDir := "."
+		if _, err := newAPIConfig(sdc, baseDir); err == nil {
+			t.Fatalf("expecting non-nil error")
+		}
+	}
+
+	// Missing secret_key
+	f(&SDConfig{
+		Project: "fake-project-id",
+	})
+
+	// Missing project_id and organization_id
+	f(&SDConfig{
+		SecretKey: &promauth.Secret{S: "fake-secret-key"},
+	})
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		Project:   "fake-project-id",
+		SecretKey: &promauth.Secret{S: "fake-secret-key"},
+	}
+	baseDir := "."
+	ac, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	if ac.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want %d", ac.port, 80)
+	}
+	if len(ac.zones) != len(defaultZones) {
+		t.Fatalf("unexpected number of default zones; got %d; want %d", len(ac.zones), len(defaultZones))
+	}
+}
+
+func TestNewAPIConfig_SuccessWithZone(t *testing.T) {
+	sdc := &SDConfig{
+		Organization: "fake-org-id",
+		SecretKey:    &promauth.Secret{S: "fake-secret-key"},
+		Zone:         "fr-par-2",
+		Port:         9100,
+	}
+	baseDir := "."
+	ac, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	if ac.port != 9100 {
+		t.Fatalf("unexpected port; got %d; want %d", ac.port, 9100)
+	}
+	if len(ac.zones) != 1 || ac.zones[0] != "fr-par-2" {
+		t.Fatalf("unexpected zones; got %v; want %v", ac.zones, []string{"fr-par-2"})
+	}
+}
