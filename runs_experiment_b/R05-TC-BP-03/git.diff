@@ -0,0 +1,101 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+)
+
+// instancesPerPage is the maximum number of instances requested per API call.
+const instancesPerPage = 100
+
+// Instance represents a Scaleway Instance server.
+//
+// See: https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+type Instance struct {
+	ID             string        `json:"id"`
+	Name           string        `json:"name"`
+	Organization   string        `json:"organization"`
+	Project        string        `json:"project"`
+	Tags           []string      `json:"tags"`
+	CommercialType string        `json:"commercial_type"`
+	State          string        `json:"state"`
+	Hostname       string        `json:"hostname"`
+	PrivateIP      string        `json:"private_ip"`
+	PublicIP       *PublicIP     `json:"public_ip"`
+	IPv6           *IPv6         `json:"ipv6"`
+	Zone           string        `json:"zone"`
+	BootType       string        `json:"boot_type"`
+	Arch           string        `json:"arch"`
+	SecurityGroup  SecurityGroup `json:"security_group"`
+}
+
+// PublicIP represents the public IPv4 address attached to a Scaleway Instance.
+type PublicIP struct {
+	Address string `json:"address"`
+}
+
+// IPv6 represents the public IPv6 address attached to a Scaleway Instance.
+type IPv6 struct {
+	Address string `json:"address"`
+}
+
+// SecurityGroup represents the security group a Scaleway Instance belongs to.
+type SecurityGroup struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+}
+
+// listServersResponse is the response structure of the Scaleway list servers API.
+type listServersResponse struct {
+	Servers []Instance `json:"servers"`
+}
+
+// getInstances retrieves the list of Instances from the given Scaleway zone.
+func getInstances(ac *apiConfig, zone string) ([]Instance, error) {
+	var instances []Instance
+
+	qp := url.Values{}
+	if ac.project != "" {
+		qp.Set("project", ac.project)
+	}
+	if ac.organization != "" {
+		qp.Set("organization", ac.organization)
+	}
+	if ac.nameFilter != "" {
+		qp.Set("name", ac.nameFilter)
+	}
+	if len(ac.tagsFilter) > 0 {
+		qp.Set("tags", strings.Join(ac.tagsFilter, ","))
+	}
+	qp.Set("per_page", strconv.Itoa(instancesPerPage))
+
+	for page := 1; ; page++ {
+		qp.Set("page", strconv.Itoa(page))
+
+		// See: https://www.scaleway.com/en/developers/api/instance/#path-servers-list-all-servers
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?%s", zone, qp.Encode())
+		data, err := ac.c.GetAPIResponseWithReqParams(path, func(req *http.Request) {
+			req.Header.Set("X-Auth-Token", ac.secretKey)
+		})
+		if err != nil {
+			return nil, fmt.Errorf("cannot get Scaleway response from %q: %w", path, err)
+		}
+
+		var resp listServersResponse
+		if err := json.Unmarshal(data, &resp); err != nil {
+			return nil, fmt.Errorf("cannot unmarshal listServersResponse obtained from %q: %w; response=%q", path, err, data)
+		}
+
+		instances = append(instances, resp.Servers...)
+
+		if len(resp.Servers) < instancesPerPage {
+			break
+		}
+	}
+
+	return instances, nil
+}
