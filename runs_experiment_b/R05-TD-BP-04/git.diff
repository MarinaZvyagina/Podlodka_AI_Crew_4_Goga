+// seriesLimitExceededRecord is a single JSON record returned by
+// /internal/series_limit_exceeded .
+type seriesLimitExceededRecord struct {
+	MetricName       string `json:"metricName"`
+	DroppedRowsCount uint64 `json:"droppedRowsCount"`
+}
+
+// handleSeriesLimitExceededRequest serves /internal/series_limit_exceeded* requests.
+//
+// subPath is the remaining URL path after the "/internal/series_limit_exceeded" prefix has been stripped.
+func (vms *VMStorage) handleSeriesLimitExceededRequest(w http.ResponseWriter, r *http.Request, subPath string) bool {
+	w.Header().Set("Content-Type", "application/json")
+	switch subPath {
+	case "", "/":
+		seriesLimitExceededRequests.Inc()
+		limit := 10
+		if s := r.FormValue("limit"); len(s) > 0 {
+			n, err := strconv.Atoi(s)
+			if err != nil || n <= 0 {
+				seriesLimitExceededErrors.Inc()
+				jsonResponseError(w, fmt.Errorf("cannot parse `limit` arg %q: it must be a positive integer", s))
+				return true
+			}
+			limit = n
+		}
+		names := vms.s.GetSeriesLimitExceededMetricNames(limit)
+		records := make([]seriesLimitExceededRecord, len(names))
+		for i, n := range names {
+			records[i] = seriesLimitExceededRecord{
+				MetricName:       n.MetricName,
+				DroppedRowsCount: n.DroppedRowsCount,
+			}
+		}
+		data, err := json.Marshal(struct {
+			Status              string                      `json:"status"`
+			SeriesLimitExceeded []seriesLimitExceededRecord `json:"seriesLimitExceeded"`
+		}{
+			Status:              "ok",
+			SeriesLimitExceeded: records,
+		})
+		if err != nil {
+			logger.Panicf("BUG: cannot marshal series_limit_exceeded response: %s", err)
+		}
+		w.Write(data)
+		return true
+	case "/reset":
+		seriesLimitExceededResetRequests.Inc()
+		vms.s.ResetSeriesLimitExceededMetricNames()
+		fmt.Fprintf(w, `{"status":"ok"}`)
+		return true
+	default:
+		seriesLimitExceededErrors.Inc()
+		jsonResponseError(w, fmt.Errorf("unsupported path %q", subPath))
+		return true
+	}
+}
+
+var (
+	seriesLimitExceededRequests      = metrics.NewCounter(`vm_http_requests_total{path="/internal/series_limit_exceeded"}`)
+	seriesLimitExceededErrors        = metrics.NewCounter(`vm_http_request_errors_total{path="/internal/series_limit_exceeded"}`)
+	seriesLimitExceededResetRequests = metrics.NewCounter(`vm_http_requests_total{path="/internal/series_limit_exceeded/reset"}`)
+)
+
 var (
 	activeForceMerges = metrics.NewCounter("vm_active_force_merges")
 
