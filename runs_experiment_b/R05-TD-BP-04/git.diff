+func TestStorageSeriesLimitExceededMetricNames(t *testing.T) {
+	defer testRemoveAll(t)
+
+	const maxHourlySeries = 2
+
+	minTimestamp := time.Now().UnixMilli()
+
+	t.Run("TrackingEnabled", func(t *testing.T) {
+		opts := OpenOptions{
+			MaxHourlySeries:          maxHourlySeries,
+			TrackSeriesLimitExceeded: true,
+		}
+		s := MustOpenStorage(t.Name(), opts)
+		defer s.MustClose()
+
+		// Fill up the hourly series limit with allowed series.
+		var kept []MetricRow
+		for i := range maxHourlySeries {
+			kept = append(kept, testMetricRowForName(fmt.Sprintf("kept_%d", i), minTimestamp))
+		}
+		s.AddRows(kept, defaultPrecisionBits)
+		s.DebugFlush()
+
+		// Insert rows for two metric names that will be rejected because the
+		// limit has already been reached. Insert them across multiple calls
+		// in order to verify that per-name counters accumulate over time.
+		const badACount = 5
+		const badBCount = 3
+		for range badACount {
+			s.AddRows([]MetricRow{testMetricRowForName("bad_a", minTimestamp)}, defaultPrecisionBits)
+		}
+		for range badBCount {
+			s.AddRows([]MetricRow{testMetricRowForName("bad_b", minTimestamp)}, defaultPrecisionBits)
+		}
+		s.DebugFlush()
+
+		records := s.GetSeriesLimitExceededMetricNames(10)
+		got := make(map[string]uint64)
+		for _, r := range records {
+			got[r.MetricName] = r.DroppedRowsCount
+		}
+		if got["bad_a"] != badACount {
+			t.Fatalf("unexpected drop count for bad_a: got %d, want %d", got["bad_a"], badACount)
+		}
+		if got["bad_b"] != badBCount {
+			t.Fatalf("unexpected drop count for bad_b: got %d, want %d", got["bad_b"], badBCount)
+		}
+		if _, ok := got["kept_0"]; ok {
+			t.Fatalf("kept_0 must not be tracked as a dropped series")
+		}
+
+		// Querying with a smaller limit must return only the top offender.
+		top1 := s.GetSeriesLimitExceededMetricNames(1)
+		if len(top1) != 1 || top1[0].MetricName != "bad_a" {
+			t.Fatalf("unexpected top1 result: %+v", top1)
+		}
+
+		s.ResetSeriesLimitExceededMetricNames()
+		if records := s.GetSeriesLimitExceededMetricNames(10); len(records) != 0 {
+			t.Fatalf("expected no records after reset, got %+v", records)
+		}
+	})
+
+	t.Run("TrackingDisabled", func(t *testing.T) {
+		opts := OpenOptions{
+			MaxHourlySeries: maxHourlySeries,
+			// TrackSeriesLimitExceeded is intentionally left false.
+		}
+		s := MustOpenStorage(t.Name(), opts)
