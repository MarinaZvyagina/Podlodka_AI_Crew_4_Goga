 * FEATURE: [vmagent](https://docs.victoriametrics.com/victoriametrics/vmagent/), [vmsingle](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/), `vmstorage` and `vmselect` in [VictoriaMetrics cluster](https://docs.victoriametrics.com/victoriametrics/cluster-victoriametrics/): expose the `vm_app_prev_shutdown_unclean` gauge. It is set to `1` when the previous process run didn't shut down cleanly. Added the `UncleanShutdown` [alerting rule](https://github.com/VictoriaMetrics/VictoriaMetrics/blob/master/deployment/docker/rules/alerts-health.yml), which fires for 10 minutes after an unclean shutdown is detected. See [#8443](https://github.com/VictoriaMetrics/VictoriaMetrics/issues/8443).
 * FEATURE: [vmui](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/#vmui): show the selected time zone UTC offset next to the date/time controls and allow opening time zone settings from it. See [#11332](https://github.com/VictoriaMetrics/VictoriaMetrics/pull/11332).
 * FEATURE: [vmsingle](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/), [vmagent](https://docs.victoriametrics.com/victoriametrics/vmagent/), [vmalert](https://docs.victoriametrics.com/victoriametrics/vmalert/), and `vmselect` in [VictoriaMetrics cluster](https://docs.victoriametrics.com/victoriametrics/cluster-victoriametrics/): show how the default value is calculated for command-line flags which derive it from the number of available CPU cores. For example, `-maxConcurrentInserts` now prints `(default 16 = 2*cgroup.AvailableCPUs())` in `-help` output instead of `(default 16)`. Updated flags: `-search.maxConcurrentRequests`, `-search.maxWorkersPerQuery`, `-fs.maxConcurrency`, `-remoteWrite.concurrency`, `-remoteWrite.queues`. See [#9680](https://github.com/VictoriaMetrics/VictoriaMetrics/issues/9680). Thanks to @Vandit1604 for contribution.
+* FEATURE: [vmsingle](https://docs.victoriametrics.com/victoriametrics/single-server-victoriametrics/) and `vmstorage` in [VictoriaMetrics cluster](https://docs.victoriametrics.com/victoriametrics/cluster-victoriametrics/): track the number of samples dropped per metric name because of exceeding `-storage.maxHourlySeries` or `-storage.maxDailySeries`. The collected data is exposed at the new `/internal/series_limit_exceeded` HTTP endpoint, which returns the metric names with the highest drop counts since the last reset (`/internal/series_limit_exceeded/reset`). This makes it possible to tell which metric names are responsible for hitting the series limit without digging through the client's own instrumentation. The tracker's memory usage is bounded and configurable via `-storage.cacheSizeSeriesLimitExceededTracker`, and the tracking can be fully disabled via `-storage.trackSeriesLimitExceededMetricNames=false`.
 
 * BUGFIX: [vmagent](https://docs.victoriametrics.com/victoriametrics/vmagent/) and `vminsert` in [VictoriaMetrics cluster](https://docs.victoriametrics.com/victoriametrics/cluster-victoriametrics/): fix infinite loop in the OpenTelemetry Firehose ingestion endpoint (`/opentelemetry/api/v1/push`) when receiving a malformed record with an incomplete varint in the `data` field. Previously this caused the goroutine to spin forever, permanently consuming CPU until the process was restarted.
 * BUGFIX: [vmalert-tool](https://docs.victoriametrics.com/victoriametrics/vmalert-tool/): reuse connections to `-remoteWrite.url` when writing the results of recording rules and alerts. Previously every series was sent over a new connection, which left a lot of sockets in `TIME_WAIT` state and could exhaust the ephemeral port range. The number of idle connections can be tuned via the new `-remoteWrite.maxIdleConnections` command-line flag. Thanks @evkuzin for contribution.
diff --git a/lib/storage/droppedseries/tracker.go b/lib/storage/droppedseries/tracker.go
new file mode 100644
index 0000000..eeeb830
--- /dev/null
+++ b/lib/storage/droppedseries/tracker.go
@@ -0,0 +1,157 @@
+// Package droppedseries tracks, per metric name, how many samples were
+// dropped because adding the corresponding series would have exceeded the
+// configured -storage.maxHourlySeries or -storage.maxDailySeries limit.
+//
+// The main purpose of the tracker is to help answer support questions like
+// "which metric is responsible for us hitting the series limit", without
+// requiring the customer to dig through their own instrumentation.
+package droppedseries
+
+import (
+	"sort"
+	"sync"
+	"sync/atomic"
+)
+
+// entryOverheadBytes is a rough estimate of the extra memory used by the
+// tracker for every unique metric name, on top of the metric name bytes
+// themselves: the map bucket, the string header and the counter allocation.
+const entryOverheadBytes = 64
+
+// Tracker accumulates the number of dropped samples per metric name.
+//
+// A nil *Tracker is valid and turns every method into a cheap no-op. This is
+// used to implement the "feature disabled" state with no measurable
+// overhead on the ingestion path.
+//
+// Tracker is safe for concurrent use.
+type Tracker struct {
+	maxSizeBytes uint64
+
+	currentSizeBytes atomic.Uint64
+
+	mu    sync.RWMutex
+	store map[string]*atomic.Uint64
+}
+
+// NewTracker creates a Tracker whose memory usage is bounded by maxSizeBytes.
+//
+// Once the bound is reached, samples dropped for metric names that aren't
+// already tracked are silently ignored - this prevents unbounded memory
+// growth on installations with a huge number of distinct metric names.
+// Counters for metric names that are already tracked keep being updated.
+func NewTracker(maxSizeBytes uint64) *Tracker {
+	return &Tracker{
+		maxSizeBytes: maxSizeBytes,
+		store:        make(map[string]*atomic.Uint64),
+	}
+}
+
+// Add increments the drop counter for the given metricName by one.
+func (t *Tracker) Add(metricName []byte) {
+	if t == nil {
+		return
+	}
+
+	t.mu.RLock()
+	cnt, ok := t.store[string(metricName)]
+	t.mu.RUnlock()
+	if ok {
+		cnt.Add(1)
+		return
+	}
+
+	t.mu.Lock()
+	cnt, ok = t.store[string(metricName)]
+	if !ok {
+		if t.currentSizeBytes.Load()+uint64(len(metricName))+entryOverheadBytes > t.maxSizeBytes {
+			// The tracker has reached its memory bound. Drop the new
+			// metric name instead of growing memory usage without bound.
+			t.mu.Unlock()
+			return
+		}
+		cnt = &atomic.Uint64{}
+		t.store[string(metricName)] = cnt
+		t.currentSizeBytes.Add(uint64(len(metricName)) + entryOverheadBytes)
+	}
+	t.mu.Unlock()
+
+	cnt.Add(1)
+}
+
+// Record is a single metric name together with its drop counter value.
+type Record struct {
+	MetricName       string
+	DroppedRowsCount uint64
+}
+
+// GetTop returns up to limit Records with the highest DroppedRowsCount,
+// sorted by DroppedRowsCount in descending order.
+//
+// A non-positive limit returns all tracked records.
+func (t *Tracker) GetTop(limit int) []Record {
+	if t == nil {
+		return nil
+	}
+
+	t.mu.RLock()
+	records := make([]Record, 0, len(t.store))
+	for name, cnt := range t.store {
+		records = append(records, Record{
+			MetricName:       name,
+			DroppedRowsCount: cnt.Load(),
+		})
+	}
+	t.mu.RUnlock()
+
+	sort.Slice(records, func(i, j int) bool {
+		if records[i].DroppedRowsCount != records[j].DroppedRowsCount {
+			return records[i].DroppedRowsCount > records[j].DroppedRowsCount
+		}
+		return records[i].MetricName < records[j].MetricName
+	})
+
+	if limit > 0 && limit < len(records) {
+		records = records[:limit]
+	}
+	return records
+}
+
+// Reset drops all the accumulated state.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.store = make(map[string]*atomic.Uint64)
+	t.currentSizeBytes.Store(0)
+	t.mu.Unlock()
+}
+
+// CurrentSizeBytes returns the approximate current memory usage of the
+// tracker in bytes.
+func (t *Tracker) CurrentSizeBytes() uint64 {
+	if t == nil {
+		return 0
+	}
+	return t.currentSizeBytes.Load()
+}
+
+// MaxSizeBytes returns the configured memory bound of the tracker in bytes.
+func (t *Tracker) MaxSizeBytes() uint64 {
+	if t == nil {
+		return 0
+	}
+	return t.maxSizeBytes
+}
+
+// ItemsCount returns the number of unique metric names currently tracked.
+func (t *Tracker) ItemsCount() uint64 {
+	if t == nil {
+		return 0
+	}
+	t.mu.RLock()
+	n := uint64(len(t.store))
+	t.mu.RUnlock()
+	return n
+}
diff --git a/lib/storage/droppedseries/tracker_test.go b/lib/storage/droppedseries/tracker_test.go
new file mode 100644
index 0000000..ffcd511
--- /dev/null
+++ b/lib/storage/droppedseries/tracker_test.go
@@ -0,0 +1,180 @@
+package droppedseries
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestTracker_AddMultipleMetricNames(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	tr.Add([]byte("foo"))
+	tr.Add([]byte("foo"))
+	tr.Add([]byte("foo"))
+	tr.Add([]byte("bar"))
+	tr.Add([]byte("baz"))
+	tr.Add([]byte("baz"))
+
+	if n := tr.ItemsCount(); n != 3 {
+		t.Fatalf("unexpected ItemsCount: got %d, want 3", n)
+	}
+
+	got := make(map[string]uint64)
+	for _, r := range tr.GetTop(0) {
+		got[r.MetricName] = r.DroppedRowsCount
+	}
+	want := map[string]uint64{
+		"foo": 3,
+		"bar": 1,
+		"baz": 2,
+	}
+	for name, wantCount := range want {
+		if got[name] != wantCount {
+			t.Fatalf("unexpected drop count for %q: got %d, want %d", name, got[name], wantCount)
+		}
+	}
+}
+
+func TestTracker_AddConcurrent(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	const goroutines = 10
+	const iterations = 1000
+
+	var wg sync.WaitGroup
+	for range goroutines {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for range iterations {
+				tr.Add([]byte("shared_metric"))
+			}
+		}()
+	}
+	wg.Wait()
+
+	records := tr.GetTop(0)
+	if len(records) != 1 {
+		t.Fatalf("unexpected number of records: got %d, want 1", len(records))
+	}
+	if want := uint64(goroutines * iterations); records[0].DroppedRowsCount != want {
+		t.Fatalf("unexpected drop count: got %d, want %d", records[0].DroppedRowsCount, want)
+	}
+}
+
+func TestTracker_GetTopLimit(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	// metric_0 gets 0 extra hits, metric_9 gets 9 extra hits, etc.
+	for i := range 10 {
+		name := fmt.Sprintf("metric_%d", i)
+		for range i + 1 {
+			tr.Add([]byte(name))
+		}
+	}
+
+	top3 := tr.GetTop(3)
+	if len(top3) != 3 {
+		t.Fatalf("unexpected number of records: got %d, want 3", len(top3))
+	}
+	wantOrder := []string{"metric_9", "metric_8", "metric_7"}
+	for i, want := range wantOrder {
+		if top3[i].MetricName != want {
+			t.Fatalf("unexpected record at position %d: got %q, want %q", i, top3[i].MetricName, want)
+		}
+	}
+	for i := 1; i < len(top3); i++ {
+		if top3[i-1].DroppedRowsCount < top3[i].DroppedRowsCount {
+			t.Fatalf("records aren't sorted in descending order: %+v", top3)
+		}
+	}
+
+	all := tr.GetTop(0)
+	if len(all) != 10 {
+		t.Fatalf("unexpected number of records with limit=0: got %d, want 10", len(all))
+	}
+}
+
+func TestTracker_MemoryBoundRespected(t *testing.T) {
+	// Only a handful of entries should fit into this budget.
+	const maxSizeBytes = 300
+	tr := NewTracker(maxSizeBytes)
+
+	const distinctMetricNames = 100_000
+	for i := range distinctMetricNames {
+		tr.Add([]byte(fmt.Sprintf("metric_%d", i)))
+	}
+
+	if got := tr.CurrentSizeBytes(); got > maxSizeBytes {
+		t.Fatalf("tracker exceeded its memory bound: currentSizeBytes=%d, maxSizeBytes=%d", got, maxSizeBytes)
+	}
+	if n := tr.ItemsCount(); n >= distinctMetricNames {
+		t.Fatalf("tracker didn't bound the number of tracked items: got %d items for %d distinct metric names", n, distinctMetricNames)
+	}
+	if n := tr.ItemsCount(); n == 0 {
+		t.Fatalf("expected at least some metric names to be tracked before the bound was reached")
+	}
+
+	// Existing entries must keep being updated even after the bound is reached.
+	records := tr.GetTop(1)
+	if len(records) != 1 {
+		t.Fatalf("unexpected number of records: got %d, want 1", len(records))
+	}
+	firstTrackedName := records[0].MetricName
+	beforeCount := records[0].DroppedRowsCount
+	tr.Add([]byte(firstTrackedName))
+	after := tr.GetTop(0)
+	var afterCount uint64
+	for _, r := range after {
+		if r.MetricName == firstTrackedName {
+			afterCount = r.DroppedRowsCount
+		}
+	}
+	if afterCount != beforeCount+1 {
+		t.Fatalf("existing entry wasn't updated after the memory bound was reached: got %d, want %d", afterCount, beforeCount+1)
+	}
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+	tr.Add([]byte("foo"))
+	tr.Add([]byte("bar"))
+
+	if n := tr.ItemsCount(); n != 2 {
+		t.Fatalf("unexpected ItemsCount before reset: got %d, want 2", n)
+	}
+
+	tr.Reset()
+
+	if n := tr.ItemsCount(); n != 0 {
+		t.Fatalf("unexpected ItemsCount after reset: got %d, want 0", n)
+	}
+	if n := tr.CurrentSizeBytes(); n != 0 {
+		t.Fatalf("unexpected CurrentSizeBytes after reset: got %d, want 0", n)
+	}
+	if records := tr.GetTop(0); len(records) != 0 {
+		t.Fatalf("unexpected records after reset: %+v", records)
+	}
+}
+
+func TestTracker_NilIsNoOp(t *testing.T) {
+	var tr *Tracker
+
+	// None of these must panic.
+	tr.Add([]byte("foo"))
+	tr.Reset()
+
+	if got := tr.GetTop(10); got != nil {
+		t.Fatalf("unexpected GetTop result for nil tracker: %+v", got)
+	}
+	if got := tr.CurrentSizeBytes(); got != 0 {
+		t.Fatalf("unexpected CurrentSizeBytes for nil tracker: %d", got)
+	}
+	if got := tr.MaxSizeBytes(); got != 0 {
+		t.Fatalf("unexpected MaxSizeBytes for nil tracker: %d", got)
+	}
+	if got := tr.ItemsCount(); got != 0 {
+		t.Fatalf("unexpected ItemsCount for nil tracker: %d", got)
+	}
+}
