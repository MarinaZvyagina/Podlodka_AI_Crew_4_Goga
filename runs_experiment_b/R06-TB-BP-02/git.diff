-func checkLease(lessor lease.Lessor, p *pb.PutRequest) error {
+// leasePendingAttach tracks, across the requests checked within a single txn,
+// which not-yet-applied new keys are being considered for attachment to each
+// lease. This lets checkLease account for multiple RequestPut ops in the same
+// txn that target the same lease, so the lease key limit is enforced against
+// the cumulative effect of the whole txn rather than each op in isolation.
+// A nil map disables the cross-request accounting (used for standalone Put).
+type leasePendingAttach map[lease.LeaseID]map[string]struct{}
+
+func (p leasePendingAttach) has(id lease.LeaseID, key string) bool {
+	_, ok := p[id][key]
+	return ok
+}
+
+func (p leasePendingAttach) count(id lease.LeaseID) int {
+	return len(p[id])
+}
+
+func (p leasePendingAttach) add(id lease.LeaseID, key string) {
+	if p == nil {
+		return
+	}
+	if p[id] == nil {
+		p[id] = make(map[string]struct{})
+	}
+	p[id][key] = struct{}{}
+}
+
+// checkLease validates that leaseID (if any) exists and, when it does, that
+// attaching p.Key to it would not exceed the lease's configured maximum
+// number of attached keys. Re-attaching a key already on the lease is always
+// allowed, regardless of the limit.
+func checkLease(lessor lease.Lessor, p *pb.PutRequest, pending leasePendingAttach) error {
 	leaseID := lease.LeaseID(p.Lease)
-	if leaseID != lease.NoLease {
-		if l := lessor.Lookup(leaseID); l == nil {
-			return lease.ErrLeaseNotFound
-		}
+	if leaseID == lease.NoLease {
+		return nil
+	}
+	l := lessor.Lookup(leaseID)
+	if l == nil {
+		return lease.ErrLeaseNotFound
+	}
+	key := string(p.Key)
+	if l.Contains(lease.LeaseItem{Key: key}) || pending.has(leaseID, key) {
+		return nil
+	}
+	if max := lessor.MaxLeaseKeys(); max > 0 && l.TotalItemCount()+pending.count(leaseID) >= max {
+		return lease.ErrTooManyLeaseKeys
 	}
+	pending.add(leaseID, key)
 	return nil
 }
 
