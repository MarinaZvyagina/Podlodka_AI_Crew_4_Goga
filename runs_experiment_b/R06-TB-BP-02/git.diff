+package lease
+
+import "testing"
+
+func TestLeaseTotalItemCountAndContains(t *testing.T) {
+	l := NewLease(1, 60)
+	if got := l.TotalItemCount(); got != 0 {
+		t.Fatalf("expected a fresh lease to have 0 items, got %d", got)
+	}
+
+	item := LeaseItem{Key: "foo"}
+	if l.Contains(item) {
+		t.Fatalf("expected item not to be present before it is set")
+	}
+
+	l.SetLeaseItem(item)
+	if !l.Contains(item) {
+		t.Fatalf("expected item to be present after SetLeaseItem")
+	}
+	if got := l.TotalItemCount(); got != 1 {
+		t.Fatalf("expected 1 item, got %d", got)
+	}
+
+	// re-setting the same item must not increase the count.
+	l.SetLeaseItem(item)
+	if got := l.TotalItemCount(); got != 1 {
+		t.Fatalf("re-setting an existing item should not increase the count, got %d", got)
+	}
+
+	other := LeaseItem{Key: "bar"}
+	l.SetLeaseItem(other)
+	if got := l.TotalItemCount(); got != 2 {
+		t.Fatalf("expected 2 items after adding a distinct item, got %d", got)
+	}
+}
