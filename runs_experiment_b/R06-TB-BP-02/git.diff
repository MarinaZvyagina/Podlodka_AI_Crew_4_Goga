+// limitations under the License.
+
+package txn
+
+import (
+	"errors"
+	"testing"
+
+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+// newLimitedStore returns a real (non-fake) lessor and mvcc store wired
+// together, with the lease key limit set to maxLeaseKeys, so the tests
+// below exercise the actual Attach/itemSet bookkeeping rather than a mock.
+func newLimitedStore(t *testing.T, maxLeaseKeys int) (mvcc.KV, lease.Lessor) {
+	t.Helper()
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() {
+		betesting.Close(t, b)
+	})
+
+	lessor := lease.NewLessor(zaptest.NewLogger(t), b, nil, lease.LessorConfig{MaxLeaseKeys: maxLeaseKeys})
+	t.Cleanup(lessor.Stop)
+	s := mvcc.NewStore(zaptest.NewLogger(t), b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() {
+		s.Close()
+	})
+	return s, lessor
+}
+
+func TestPutRejectsNewKeyOverLeaseLimit(t *testing.T) {
+	s, lessor := newLimitedStore(t, 2)
+	l, err := lessor.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("failed to grant lease: %v", err)
+	}
+
+	for _, key := range []string{"a", "b"} {
+		if _, _, err := Put(t.Context(), zaptest.NewLogger(t), lessor, s, &pb.PutRequest{Key: []byte(key), Lease: int64(l.ID)}); err != nil {
+			t.Fatalf("put %q should succeed under the limit: %v", key, err)
+		}
+	}
+
+	_, _, err = Put(t.Context(), zaptest.NewLogger(t), lessor, s, &pb.PutRequest{Key: []byte("c"), Lease: int64(l.ID)})
+	if !errors.Is(err, lease.ErrTooManyLeaseKeys) {
+		t.Fatalf("expected ErrTooManyLeaseKeys, got %v", err)
+	}
+
+	// The server must remain healthy and keep serving unrelated writes
+	// after the rejection.
+	if _, _, err := Put(t.Context(), zaptest.NewLogger(t), lessor, s, &pb.PutRequest{Key: []byte("unrelated")}); err != nil {
+		t.Fatalf("unrelated put should still succeed after rejection: %v", err)
+	}
+}
+
+func TestPutReattachExistingKeyAtLimitSucceeds(t *testing.T) {
+	s, lessor := newLimitedStore(t, 1)
+	l, err := lessor.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("failed to grant lease: %v", err)
+	}
+
+	if _, _, err := Put(t.Context(), zaptest.NewLogger(t), lessor, s, &pb.PutRequest{Key: []byte("a"), Lease: int64(l.ID)}); err != nil {
+		t.Fatalf("initial put should succeed: %v", err)
+	}
+
+	// The lease is now at its limit (1 key). Re-attaching the same key
+	// (e.g. overwriting its value) must still succeed since it does not
+	// increase the distinct key count.
+	if _, _, err := Put(t.Context(), zaptest.NewLogger(t), lessor, s, &pb.PutRequest{Key: []byte("a"), Value: []byte("v2"), Lease: int64(l.ID)}); err != nil {
+		t.Fatalf("re-attaching the same key at the limit should succeed: %v", err)
+	}
+}
+
+func TestTxnRejectsCumulativeNewKeysOverLeaseLimit(t *testing.T) {
+	s, lessor := newLimitedStore(t, 1)
+	l, err := lessor.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("failed to grant lease: %v", err)
+	}
+
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a"), Lease: int64(l.ID)}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("b"), Lease: int64(l.ID)}}},
+		},
+	}
+	_, _, err = Txn(t.Context(), zaptest.NewLogger(t), txn, false, s, lessor, false)
+	if !errors.Is(err, lease.ErrTooManyLeaseKeys) {
+		t.Fatalf("expected ErrTooManyLeaseKeys for a txn whose ops cumulatively exceed the limit, got %v", err)
+	}
+
+	// The whole txn must have been rejected before any writes were
+	// applied: neither key should exist. Read directly off the store
+	// (rather than through txn.Range) to avoid perturbing the package's
+	// shared Range latency metric asserted by TestRangeSecObserve.
+	for _, k := range []string{"a", "b"} {
+		r, err := s.Range(t.Context(), []byte(k), nil, mvcc.RangeOptions{})
+		if err != nil {
+			t.Fatalf("range failed: %v", err)
+		}
+		if len(r.KVs) != 0 {
+			t.Fatalf("key %q should not have been applied by the rejected txn", k)
+		}
+	}
+
+	// The server must remain healthy and keep serving unrelated writes.
+	if _, _, err := Put(t.Context(), zaptest.NewLogger(t), lessor, s, &pb.PutRequest{Key: []byte("unrelated")}); err != nil {
+		t.Fatalf("unrelated put should still succeed after rejection: %v", err)
+	}
+}
+
+func TestTxnAllowsSecondOpReattachingSameKeyAtLimit(t *testing.T) {
+	s, lessor := newLimitedStore(t, 1)
+	l, err := lessor.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("failed to grant lease: %v", err)
+	}
+
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a"), Lease: int64(l.ID)}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a"), Value: []byte("v2"), Lease: int64(l.ID)}}},
+		},
+	}
+	if _, _, err := Txn(t.Context(), zaptest.NewLogger(t), txn, false, s, lessor, false); err != nil {
+		t.Fatalf("txn putting the same key twice within the limit should succeed: %v", err)
+	}
+}
