+// TestLessorMaxLeaseKeysDefault ensures a lessor falls back to
+// defaultMaxLeaseKeys when LessorConfig.MaxLeaseKeys is unset, so that
+// existing callers that don't set it keep working unmodified.
+func TestLessorMaxLeaseKeysDefault(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL})
+	defer le.Stop()
+
+	if got := le.MaxLeaseKeys(); got != defaultMaxLeaseKeys {
+		t.Fatalf("MaxLeaseKeys() = %d, want default %d", got, defaultMaxLeaseKeys)
+	}
+}
+
+// TestLessorMaxLeaseKeysConfigured ensures an explicitly configured
+// MaxLeaseKeys value is honored instead of the default.
+func TestLessorMaxLeaseKeysConfigured(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL, MaxLeaseKeys: 5})
+	defer le.Stop()
+
+	if got := le.MaxLeaseKeys(); got != 5 {
+		t.Fatalf("MaxLeaseKeys() = %d, want 5", got)
+	}
+}
+
+// TestLessorAttachIgnoresMaxLeaseKeys documents that Attach itself never
+// enforces the configured limit: the limit is only enforced by write
+// validation above the lessor (see server/etcdserver/txn). Attach must stay
+// unconditional because it is also used to reattach keys during backend
+// recovery, where rejecting an over-the-limit lease would silently drop
+// keys from the lease's item set and corrupt cleanup-on-revoke behavior.
+func TestLessorAttachIgnoresMaxLeaseKeys(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL, MaxLeaseKeys: 2})
+	defer le.Stop()
+	le.SetRangeDeleter(func() TxnDelete { return newFakeDeleter(be) })
+
+	l, err := le.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("could not grant lease: %v", err)
+	}
+
+	items := []LeaseItem{{"a"}, {"b"}, {"c"}}
+	if err := le.Attach(l.ID, items); err != nil {
+		t.Fatalf("Attach should not enforce MaxLeaseKeys, got error: %v", err)
+	}
+	if got := l.TotalItemCount(); got != len(items) {
+		t.Fatalf("expected %d items attached, got %d", len(items), got)
+	}
+}
