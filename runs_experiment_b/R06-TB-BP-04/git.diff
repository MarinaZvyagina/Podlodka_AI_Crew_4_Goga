+// checkLeaseKeyLimit verifies that attaching key to leaseID would not push the
+// lease beyond the server's configured maximum number of attached keys.
+// Re-attaching a key that is already on the lease never counts against the
+// limit. pendingLeaseKeys, when non-nil, accumulates the distinct new keys
+// that earlier operations within the same request (e.g. other Put ops inside
+// the same transaction) have already counted towards leaseID's limit, so the
+// whole request is validated against its cumulative effect rather than each
+// operation being checked in isolation.
+func checkLeaseKeyLimit(lessor lease.Lessor, key []byte, leaseID lease.LeaseID, pendingLeaseKeys map[lease.LeaseID]map[string]struct{}) error {
+	if leaseID == lease.NoLease {
+		return nil
+	}
+	maxKeys := lessor.MaxLeaseKeys()
+	if maxKeys <= 0 {
+		return nil
+	}
+	l := lessor.Lookup(leaseID)
+	if l == nil {
+		return lease.ErrLeaseNotFound
+	}
+	if lessor.GetLease(lease.LeaseItem{Key: string(key)}) == leaseID {
+		// already attached to this lease; re-attaching does not grow it
+		return nil
+	}
+
+	ks := string(key)
+	pendingCount := 0
+	var newForLease map[string]struct{}
+	if pendingLeaseKeys != nil {
+		newForLease = pendingLeaseKeys[leaseID]
+		if _, ok := newForLease[ks]; ok {
+			// already counted by an earlier operation in this same request
+			return nil
+		}
+		pendingCount = len(newForLease)
+	}
+
+	if l.ItemCount()+pendingCount+1 > maxKeys {
+		return lease.ErrTooManyKeys
+	}
+
+	if pendingLeaseKeys != nil {
+		if newForLease == nil {
+			newForLease = make(map[string]struct{}, 1)
+			pendingLeaseKeys[leaseID] = newForLease
+		}
+		newForLease[ks] = struct{}{}
+	}
+	return nil
+}
