+package txn
+
+import (
+	"context"
+	"testing"
+
+	"github.com/Masterminds/semver/v3"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+)
+
+// readKeyExists avoids the txn package's exported Range helper, which
+// records package-level latency metrics that other tests assert on in
+// isolation; a direct mvcc read has no such side effect.
+func readKeyExists(kv mvcc.KV, key []byte) bool {
+	txnRead := kv.Read(mvcc.ConcurrentReadTxMode, traceutil.TODO())
+	defer txnRead.End()
+	rr, err := txnRead.Range(context.Background(), key, nil, mvcc.RangeOptions{})
+	if err != nil {
+		return false
+	}
+	return len(rr.KVs) != 0
+}
+
+// fakeCluster is a minimal cluster implementation sufficient for constructing
+// a real lessor in tests.
+type fakeCluster struct{}
+
+func (fakeCluster) Version() *semver.Version { return nil }
+
+func setupWithMaxLeaseKeys(t *testing.T, maxLeaseKeys int) (mvcc.KV, lease.Lessor) {
+	t.Helper()
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() {
+		betesting.Close(t, b)
+	})
+	lessor := lease.NewLessor(zaptest.NewLogger(t), b, fakeCluster{}, lease.LessorConfig{MaxLeaseKeys: maxLeaseKeys})
+	t.Cleanup(lessor.Stop)
+	s := mvcc.NewStore(zaptest.NewLogger(t), b, lessor, mvcc.StoreConfig{})
+	t.Cleanup(func() {
+		s.Close()
+	})
+	return s, lessor
+}
+
+func TestPutRejectsKeyOverLeaseLimit(t *testing.T) {
+	s, lessor := setupWithMaxLeaseKeys(t, 2)
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+
+	_, err := lessor.Grant(1, 0)
+	require.NoError(t, err)
+
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("a"), Value: []byte("v"), Lease: 1})
+	require.NoError(t, err)
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("b"), Value: []byte("v"), Lease: 1})
+	require.NoError(t, err)
+
+	// lease 1 is now at its 2-key limit; attaching a third, new key must fail cleanly.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("c"), Value: []byte("v"), Lease: 1})
+	require.ErrorIs(t, err, lease.ErrTooManyKeys)
+
+	// the rejected write must not have been applied at all.
+	require.False(t, readKeyExists(s, []byte("c")), "key rejected for exceeding the lease limit must not be persisted")
+
+	require.Equal(t, 2, lessor.Lookup(1).ItemCount())
+
+	// re-attaching (updating) a key already on the lease must keep working, even at the limit.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("a"), Value: []byte("v2"), Lease: 1})
+	require.NoError(t, err)
+	require.Equal(t, 2, lessor.Lookup(1).ItemCount())
+}
+
+func TestPutUnderLeaseLimitStillWorks(t *testing.T) {
+	s, lessor := setupWithMaxLeaseKeys(t, 2)
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+
+	_, err := lessor.Grant(1, 0)
+	require.NoError(t, err)
+
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("a"), Value: []byte("v"), Lease: 1})
+	require.NoError(t, err)
+	require.Equal(t, 1, lessor.Lookup(1).ItemCount())
+}
+
+func TestTxnRejectsCumulativeOverLeaseLimit(t *testing.T) {
+	s, lessor := setupWithMaxLeaseKeys(t, 2)
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+
+	_, err := lessor.Grant(1, 0)
+	require.NoError(t, err)
+
+	putOp := func(key string) *pb.RequestOp {
+		return &pb.RequestOp{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{
+			Key: []byte(key), Value: []byte("v"), Lease: 1,
+		}}}
+	}
+
+	txn := &pb.TxnRequest{Success: []*pb.RequestOp{putOp("a"), putOp("b"), putOp("c")}}
+	_, _, err = Txn(ctx, lg, txn, false, s, lessor, false)
+	require.ErrorIs(t, err, lease.ErrTooManyKeys)
+
+	// the whole transaction must be atomic: none of its keys should have been written.
+	for _, k := range []string{"a", "b", "c"} {
+		require.Falsef(t, readKeyExists(s, []byte(k)), "key %q from a rejected txn must not be persisted", k)
+	}
+	require.Equal(t, 0, lessor.Lookup(1).ItemCount())
+}
+
+func TestTxnRepeatedKeyCountsOnce(t *testing.T) {
+	s, lessor := setupWithMaxLeaseKeys(t, 1)
+	ctx := t.Context()
+	lg := zaptest.NewLogger(t)
+
+	_, err := lessor.Grant(1, 0)
+	require.NoError(t, err)
+
+	putOp := func(key, val string) *pb.RequestOp {
+		return &pb.RequestOp{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{
+			Key: []byte(key), Value: []byte(val), Lease: 1,
+		}}}
+	}
+
+	// two puts to the *same* key within one txn must count as a single new attachment.
+	txn := &pb.TxnRequest{Success: []*pb.RequestOp{putOp("a", "v1"), putOp("a", "v2")}}
+	_, _, err = Txn(ctx, lg, txn, false, s, lessor, false)
+	require.NoError(t, err)
+	require.Equal(t, 1, lessor.Lookup(1).ItemCount())
+}
