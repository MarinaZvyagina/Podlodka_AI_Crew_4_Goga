+// TestPutRejectsKeyOverLeaseLimit verifies that a standalone Put attaching a
+// brand-new key to a lease that is already at its configured key limit is
+// cleanly rejected (no panic, no write to the backend), while re-attaching a
+// key already on that lease keeps working.
+func TestPutRejectsKeyOverLeaseLimit(t *testing.T) {
+	lg := zaptest.NewLogger(t)
+	b, bePath := betesting.NewDefaultTmpBackend(t)
+	lessor := lease.NewLessor(lg, b, nil, lease.LessorConfig{MinLeaseTTL: 1, MaxLeaseKeys: 1})
+	s := mvcc.NewStore(lg, b, lessor, mvcc.StoreConfig{})
+	defer s.Close()
+
+	if _, err := lessor.Grant(1, 100); err != nil {
+		t.Fatalf("failed to grant lease: %v", err)
+	}
+
+	ctx := t.Context()
+	_, _, err := Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("foo"), Value: []byte("v1"), Lease: 1})
+	require.NoError(t, err)
+
+	dbHashBefore, err := computeFileHash(bePath)
+	require.NoErrorf(t, err, "failed to compute DB file hash before rejected put")
+
+	// A new key pushes the lease over its limit of 1: must be rejected
+	// cleanly, without panicking and without writing anything.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("bar"), Value: []byte("v1"), Lease: 1})
+	require.ErrorIs(t, err, lease.ErrTooManyLeaseKeys)
+
+	dbHashAfter, err := computeFileHash(bePath)
+	require.NoErrorf(t, err, "failed to compute DB file hash after rejected put")
+	require.Equalf(t, dbHashBefore, dbHashAfter, "rejected put must not write to the backend")
+
+	// Re-attaching (re-Put'ing) the same key that is already on the lease
+	// must keep working even though the lease is at its limit.
+	_, _, err = Put(ctx, lg, lessor, s, &pb.PutRequest{Key: []byte("foo"), Value: []byte("v2"), Lease: 1})
+	require.NoError(t, err)
+}
+
+// TestTxnRejectsLeaseLimitAtomically verifies that a Txn attaching two
+// distinct new keys to a lease that only has room for one is rejected as a
+// whole, with neither key written to the store — even though each Put, if
+// checked independently against already-committed lease state, would appear
+// to fit under the limit.
+func TestTxnRejectsLeaseLimitAtomically(t *testing.T) {
+	lg := zaptest.NewLogger(t)
+	b, _ := betesting.NewDefaultTmpBackend(t)
+	lessor := lease.NewLessor(lg, b, nil, lease.LessorConfig{MinLeaseTTL: 1, MaxLeaseKeys: 1})
+	s := mvcc.NewStore(lg, b, lessor, mvcc.StoreConfig{})
+	defer s.Close()
+
+	if _, err := lessor.Grant(1, 100); err != nil {
+		t.Fatalf("failed to grant lease: %v", err)
+	}
+
+	txn := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("foo"), Value: []byte("v1"), Lease: 1}}},
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("bar"), Value: []byte("v1"), Lease: 1}}},
+		},
+	}
+
+	_, _, err := Txn(t.Context(), lg, txn, false, s, lessor, false)
+	require.ErrorIs(t, err, lease.ErrTooManyLeaseKeys)
+
+	rr, err := s.Range(t.Context(), []byte("foo"), []byte("bar\x00"), mvcc.RangeOptions{})
+	require.NoError(t, err)
+	require.Emptyf(t, rr.KVs, "rejected txn must not partially apply any of its puts")
+}
