+// TestLessorAttachMaxKeys ensures that Attach rejects a new key once a
+// lease is at its configured key limit, that re-attaching an already
+// attached key never fails, and that Attach either fully applies a batch
+// of items or rejects all of them.
+func TestLessorAttachMaxKeys(t *testing.T) {
+	lg := zap.NewNop()
+	dir, be := NewTestBackend(t)
+	defer os.RemoveAll(dir)
+	defer be.Close()
+
+	le := newLessor(lg, be, clusterLatest(), LessorConfig{MinLeaseTTL: minLeaseTTL, MaxLeaseKeys: 2})
+	defer le.Stop()
+	le.SetRangeDeleter(func() TxnDelete { return newFakeDeleter(be) })
+
+	l, err := le.Grant(1, 100)
+	if err != nil {
+		t.Fatalf("could not grant lease for 100s ttl (%v)", err)
+	}
+
+	if err := le.Attach(l.ID, []LeaseItem{{"foo"}, {"bar"}}); err != nil {
+		t.Fatalf("failed to attach items up to the limit: %v", err)
+	}
+
+	// Re-attaching already-attached items must never be rejected, even
+	// though the lease is already at its limit.
+	if err := le.Attach(l.ID, []LeaseItem{{"foo"}, {"bar"}}); err != nil {
+		t.Fatalf("re-attaching existing items should not fail: %v", err)
+	}
+
+	// A brand-new key must be rejected once the lease is at its limit.
+	if err := le.Attach(l.ID, []LeaseItem{{"baz"}}); !errors.Is(err, ErrTooManyLeaseKeys) {
+		t.Fatalf("expected ErrTooManyLeaseKeys, got %v", err)
+	}
+
+	l = le.Lookup(l.ID)
+	if len(l.itemSet) != 2 {
+		t.Fatalf("len(l.itemSet) = %d, want 2 (rejected attach must not partially apply)", len(l.itemSet))
+	}
+	if _, ok := l.itemSet[LeaseItem{"baz"}]; ok {
+		t.Fatalf("rejected item %q must not be attached", "baz")
+	}
+
+	// A batch that mixes an already-attached item with a new item that
+	// would exceed the limit must be rejected in its entirety.
+	if err := le.Attach(l.ID, []LeaseItem{{"foo"}, {"qux"}}); !errors.Is(err, ErrTooManyLeaseKeys) {
+		t.Fatalf("expected ErrTooManyLeaseKeys, got %v", err)
+	}
+	l = le.Lookup(l.ID)
+	if _, ok := l.itemSet[LeaseItem{"qux"}]; ok {
+		t.Fatalf("partially-rejected batch must not attach any new item")
+	}
+}
