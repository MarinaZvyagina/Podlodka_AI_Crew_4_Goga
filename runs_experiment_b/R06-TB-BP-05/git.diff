+// ErrLeaseNotFound is returned.
+func (le *lessor) CanAttach(id LeaseID, additionalKeys int) error {
+	le.mu.RLock()
+	l := le.leaseMap[id]
+	le.mu.RUnlock()
+	if l == nil {
+		return ErrLeaseNotFound
+	}
+
+	l.mu.RLock()
+	count := len(l.itemSet)
+	l.mu.RUnlock()
+
+	if count+additionalKeys > le.maxLeaseKeys {
+		return ErrTooManyLeaseKeys
+	}
 	return nil
