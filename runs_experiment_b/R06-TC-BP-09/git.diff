+package v3rpc
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestAuditKeyRange(t *testing.T) {
+	tests := []struct {
+		name string
+		req  any
+		want string
+	}{
+		{
+			name: "single key request",
+			req:  &pb.PutRequest{Key: []byte("foo")},
+			want: "foo",
+		},
+		{
+			name: "range request",
+			req:  &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")},
+			want: "[a, z)",
+		},
+		{
+			name: "delete single key",
+			req:  &pb.DeleteRangeRequest{Key: []byte("foo")},
+			want: "foo",
+		},
+		{
+			name: "request without a key",
+			req:  &pb.CompactionRequest{Revision: 1},
+			want: "",
+		},
+		{
+			name: "txn aggregates unique keys across compare/success/failure",
+			req: &pb.TxnRequest{
+				Compare: []*pb.Compare{{Key: []byte("a")}},
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("a")}}},
+					{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("b"), RangeEnd: []byte("c")}}},
+				},
+				Failure: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("d")}}},
+				},
+			},
+			want: "a,[b, c),d",
+		},
+		{
+			name: "nested txn is traversed recursively",
+			req: &pb.TxnRequest{
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+						Success: []*pb.RequestOp{
+							{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("nested")}}},
+						},
+					}}},
+				},
+			},
+			want: "nested",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := auditKeyRange(tt.req); got != tt.want {
+				t.Errorf("auditKeyRange() = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestAuditOperationKindFallback(t *testing.T) {
+	tests := []struct {
+		method string
+		want   string
+	}{
+		{"Range", "read"},
+		{"RangeStream", "read"},
+		{"Put", "write"},
+		{"DeleteRange", "delete"},
+		{"Txn", "transaction"},
+		{"SomeFutureMethod", "other"},
+	}
+
+	for _, tt := range tests {
+		kind, ok := auditOperationKinds[tt.method]
+		if !ok {
+			kind = "other"
+		}
+		if kind != tt.want {
+			t.Errorf("operation kind for %q = %q, want %q", tt.method, kind, tt.want)
+		}
+	}
+}
+
+// fakeServerStream is a minimal grpc.ServerStream used to exercise
+// auditRecvStream without a real gRPC connection.
+type fakeServerStream struct {
+	grpc.ServerStream
+	ctx context.Context
+	msg any
+	err error
+}
+
+func (f *fakeServerStream) Context() context.Context { return f.ctx }
+
+func (f *fakeServerStream) RecvMsg(m any) error {
+	if f.err != nil {
+		return f.err
+	}
+	if req, ok := f.msg.(*pb.RangeRequest); ok {
+		if out, ok := m.(*pb.RangeRequest); ok {
+			out.Key = req.Key
+			out.RangeEnd = req.RangeEnd
+		}
+	}
+	return nil
+}
+
+func TestAuditRecvStreamCapturesFirstMessageOnly(t *testing.T) {
+	want := &pb.RangeRequest{Key: []byte("watched-key")}
+	var captured []any
+	s := &auditRecvStream{
+		ServerStream: &fakeServerStream{ctx: context.Background(), msg: want},
+		onRecv:       func(m any) { captured = append(captured, m) },
+	}
+
+	m1 := &pb.RangeRequest{}
+	if err := s.RecvMsg(m1); err != nil {
+		t.Fatalf("RecvMsg() error = %v", err)
+	}
+	m2 := &pb.RangeRequest{}
+	if err := s.RecvMsg(m2); err != nil {
+		t.Fatalf("RecvMsg() error = %v", err)
+	}
+
+	if len(captured) != 1 {
+		t.Fatalf("onRecv called %d times, want 1", len(captured))
+	}
+	if got := captured[0].(*pb.RangeRequest); string(got.Key) != "watched-key" {
+		t.Errorf("captured key = %q, want %q", got.Key, "watched-key")
+	}
+}
+
+func TestAuditRecvStreamPropagatesRecvError(t *testing.T) {
+	wantErr := errors.New("boom")
+	called := false
+	s := &auditRecvStream{
+		ServerStream: &fakeServerStream{ctx: context.Background(), err: wantErr},
+		onRecv:       func(any) { called = true },
+	}
+
+	if err := s.RecvMsg(&pb.RangeRequest{}); !errors.Is(err, wantErr) {
+		t.Fatalf("RecvMsg() error = %v, want %v", err, wantErr)
+	}
+	if called {
+		t.Errorf("onRecv should not be called when RecvMsg fails")
+	}
+}
