+package v3rpc
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	"go.uber.org/zap"
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/etcdserver"
+)
+
+// kvServiceMethodPrefix is the gRPC full-method prefix shared by every
+// method of the KV service. Filtering on it, rather than on a fixed list of
+// method names, is what lets the audit interceptors below cover every
+// key-value read, write, delete, and transaction request handled by the
+// server — including any method added to the KV service in the future —
+// without each one needing to be wired up by hand.
+const kvServiceMethodPrefix = "/etcdserverpb.KV/"
+
+// auditOperationKinds classifies the KV methods known today. A method that
+// isn't listed here is still audited: it is reported under the "other" kind
+// instead of being silently skipped, so a newly added or renamed KV method
+// never falls out of the audit trail even before this map is updated for it.
+var auditOperationKinds = map[string]string{
+	"Range":       "read",
+	"RangeStream": "read",
+	"Put":         "write",
+	"DeleteRange": "delete",
+	"Txn":         "transaction",
+}
+
+// newAuditUnaryInterceptor produces one audit record for every unary KV
+// request (Range, Put, DeleteRange, Txn, Compact, ...) handled by the
+// server, capturing caller identity, operation kind, key/range, duration,
+// and outcome. It never alters the request, the response, or the error
+// returned by the wrapped handler.
+func newAuditUnaryInterceptor(s *etcdserver.EtcdServer) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		if !strings.HasPrefix(info.FullMethod, kvServiceMethodPrefix) {
+			return handler(ctx, req)
+		}
+
+		start := time.Now()
+		resp, err := handler(ctx, req)
+		recordAuditEvent(s, ctx, info.FullMethod, req, start, err)
+		return resp, err
+	}
+}
+
+// newAuditStreamInterceptor mirrors newAuditUnaryInterceptor for server-
+// streaming KV requests (RangeStream). The request message is only
+// available once the generated handler reads it off the stream, so it's
+// captured via a wrapping ServerStream rather than read directly here.
+func newAuditStreamInterceptor(s *etcdserver.EtcdServer) grpc.StreamServerInterceptor {
+	return func(srv any, ss grpc.ServerStream, info *grpc.StreamServerInfo, handler grpc.StreamHandler) error {
+		if !strings.HasPrefix(info.FullMethod, kvServiceMethodPrefix) {
+			return handler(srv, ss)
+		}
+
+		start := time.Now()
+		var req any
+		err := handler(srv, &auditRecvStream{ServerStream: ss, onRecv: func(m any) { req = m }})
+		recordAuditEvent(s, ss.Context(), info.FullMethod, req, start, err)
+		return err
+	}
+}
+
+// auditRecvStream wraps a ServerStream to capture the first message read
+// off it, which for a server-streaming RPC is the client's request.
+type auditRecvStream struct {
+	grpc.ServerStream
+	onRecv   func(any)
+	captured bool
+}
+
+func (s *auditRecvStream) RecvMsg(m any) error {
+	err := s.ServerStream.RecvMsg(m)
+	if err == nil && !s.captured {
+		s.captured = true
+		s.onRecv(m)
+	}
+	return err
+}
+
+func recordAuditEvent(s *etcdserver.EtcdServer, ctx context.Context, fullMethod string, req any, start time.Time, err error) {
+	lg := s.Logger()
+	if lg == nil {
+		return
+	}
+
+	method := strings.TrimPrefix(fullMethod, kvServiceMethodPrefix)
+	kind, ok := auditOperationKinds[method]
+	if !ok {
+		kind = "other"
+	}
+
+	lg.Info("audit",
+		zap.String("caller", auditCallerIdentity(s, ctx)),
+		zap.String("operation", kind),
+		zap.String("key", auditKeyRange(req)),
+		zap.Duration("duration", time.Since(start)),
+		zap.Bool("success", err == nil),
+	)
+}
+
+func auditCallerIdentity(s *etcdserver.EtcdServer, ctx context.Context) string {
+	authInfo, err := s.AuthInfoFromCtx(ctx)
+	if err != nil || authInfo == nil || authInfo.Username == "" {
+		return "unauthenticated"
+	}
+	return authInfo.Username
+}
+
+// auditKeyer and auditRangeEnder match the Get* accessors that protoc
+// generates for every KV request carrying a key or key range. Extracting
+// the key this way, instead of via a type switch over concrete request
+// types, means a request type gains audit key/range reporting automatically
+// as soon as it exposes these accessors — no update to this file required.
+type auditKeyer interface{ GetKey() []byte }
+type auditRangeEnder interface{ GetRangeEnd() []byte }
+
+func auditKeyRange(req any) string {
+	if txn, ok := req.(*pb.TxnRequest); ok {
+		return auditTxnKeyRange(txn)
+	}
+	return formatAuditKeyRange(req)
+}
+
+func formatAuditKeyRange(req any) string {
+	k, ok := req.(auditKeyer)
+	if !ok {
+		return ""
+	}
+	key := k.GetKey()
+	var end []byte
+	if re, ok := req.(auditRangeEnder); ok {
+		end = re.GetRangeEnd()
+	}
+	if len(end) == 0 {
+		return string(key)
+	}
+	return fmt.Sprintf("[%s, %s)", key, end)
+}
+
+// auditTxnKeyRange collects the distinct keys/ranges touched by a
+// transaction's compares and nested operations, including nested Txns.
+func auditTxnKeyRange(txn *pb.TxnRequest) string {
+	if txn == nil {
+		return ""
+	}
+
+	seen := make(map[string]struct{})
+	var keys []string
+	add := func(k string) {
+		if k == "" {
+			return
+		}
+		if _, ok := seen[k]; ok {
+			return
+		}
+		seen[k] = struct{}{}
+		keys = append(keys, k)
+	}
+
+	for _, c := range txn.GetCompare() {
+		add(formatAuditKeyRange(c))
+	}
+	for _, op := range txn.GetSuccess() {
+		add(auditRequestOpKeyRange(op))
+	}
+	for _, op := range txn.GetFailure() {
+		add(auditRequestOpKeyRange(op))
+	}
+	return strings.Join(keys, ",")
+}
+
+func auditRequestOpKeyRange(op *pb.RequestOp) string {
+	switch r := op.GetRequest().(type) {
+	case *pb.RequestOp_RequestRange:
+		return formatAuditKeyRange(r.RequestRange)
+	case *pb.RequestOp_RequestPut:
+		return formatAuditKeyRange(r.RequestPut)
+	case *pb.RequestOp_RequestDeleteRange:
+		return formatAuditKeyRange(r.RequestDeleteRange)
+	case *pb.RequestOp_RequestTxn:
+		return auditTxnKeyRange(r.RequestTxn)
+	default:
+		return ""
+	}
+}
