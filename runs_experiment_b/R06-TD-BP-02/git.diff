 type WatchableKV interface {
 	KV
 	Watchable
+
+	// SetChangeNotifier registers fn to be called synchronously for every
+	// write transaction that mutates at least one key, from within the same
+	// critical section that makes the commit visible to new reads. It covers
+	// every source of mutation, including lease-expiry driven deletes, not
+	// just explicit Put/DeleteRange/Txn requests. Passing nil disables the
+	// notification. Callers use it to keep an invalidation-based read cache
+	// exactly in sync with the store instead of relying on a fixed expiry.
+	SetChangeNotifier(fn func(changes []*mvccpb.KeyValue))
 }
 
 // Watchable is the interface that wraps the NewWatchStream function.
