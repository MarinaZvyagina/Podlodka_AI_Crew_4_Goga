+// TestKVRangeCacheUnderConcurrentWrites hammers a single key with sequential
+// puts while concurrently polling it, and checks that the sequence of values
+// observed by the reader never goes backwards: once a Get has observed the
+// Nth write, no later Get may observe an earlier one. A cache relying on a
+// fixed expiration window instead of prompt, write-driven invalidation could
+// violate this under exactly this kind of concurrent write pressure.
+func TestKVRangeCacheUnderConcurrentWrites(t *testing.T) {
+	integration.BeforeTest(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	kv := clus.RandClient()
+	ctx := t.Context()
+	key := "hot-key"
+
+	const writes = 300
+	if _, err := kv.Put(ctx, key, "0"); err != nil {
+		t.Fatalf("initial put: %v", err)
+	}
+
+	var wg sync.WaitGroup
+	errCh := make(chan error, 2)
+	stop := make(chan struct{})
+
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		defer close(stop)
+		for i := 1; i <= writes; i++ {
+			if _, err := kv.Put(ctx, key, strconv.Itoa(i)); err != nil {
+				errCh <- fmt.Errorf("put %d: %w", i, err)
+				return
+			}
+		}
+	}()
+
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		maxSeen := 0
+		for {
+			resp, err := kv.Get(ctx, key)
+			if err != nil {
+				errCh <- fmt.Errorf("get: %w", err)
+				return
+			}
+			v, err := strconv.Atoi(string(resp.Kvs[0].Value))
+			if err != nil {
+				errCh <- fmt.Errorf("unexpected value %q: %w", resp.Kvs[0].Value, err)
+				return
+			}
+			if v < maxSeen {
+				errCh <- fmt.Errorf("observed stale value %d after already having observed %d", v, maxSeen)
+				return
+			}
+			maxSeen = v
+			select {
+			case <-stop:
+				return
+			default:
+			}
+		}
+	}()
+
+	wg.Wait()
+	close(errCh)
+	for err := range errCh {
+		t.Fatal(err)
+	}
+}
