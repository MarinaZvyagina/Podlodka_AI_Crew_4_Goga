index 000000000..162fcb6ef
--- /dev/null
+++ b/server/etcdserver/rangecache/rangecache.go
@@ -0,0 +1,260 @@
+// Copyright 2026 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Package rangecache caches the results of read-only Range requests so that
+// repeated requests with identical parameters don't have to redo the full
+// read path (index lookup, backend reads, filtering and sorting) every time.
+//
+// Entries are kept fresh by invalidation rather than by expiry: the server
+// wires CommitWrite into every mvcc write commit (Put, DeleteRange, Txn, and
+// lease-expiry driven deletes), so a cached entry is dropped as soon as a
+// write touches its key range, promptly and independently of any timer.
+package rangecache
+
+import (
+	"bytes"
+	"encoding/binary"
+	"sync"
+
+	"github.com/prometheus/client_golang/prometheus"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+)
+
+var (
+	cacheHits = prometheus.NewCounter(prometheus.CounterOpts{
+		Namespace: "etcd",
+		Subsystem: "server",
+		Name:      "range_cache_hits_total",
+		Help:      "Total number of Range requests served from the read cache.",
+	})
+	cacheMisses = prometheus.NewCounter(prometheus.CounterOpts{
+		Namespace: "etcd",
+		Subsystem: "server",
+		Name:      "range_cache_misses_total",
+		Help:      "Total number of cacheable Range requests not found in the read cache.",
+	})
+)
+
+func init() {
+	prometheus.MustRegister(cacheHits)
+	prometheus.MustRegister(cacheMisses)
+}
+
+// maxEntries bounds the cache's memory footprint. It is intentionally a
+// simple, fixed cap rather than a tunable knob: entries are cheap and small,
+// and the cache is only meant to absorb a modest set of hot, repeated
+// requests, not to act as a general-purpose result store.
+const maxEntries = 100_000
+
+type cacheEntry struct {
+	start, end []byte
+	resp       *pb.RangeResponse
+}
+
+// Cache is a read-through, invalidation-based cache of RangeResponses.
+// It is safe for concurrent use.
+type Cache struct {
+	mu sync.RWMutex
+	// epoch counts write commits observed by CommitWrite. It lets Put refuse
+	// to cache a response that raced with a concurrent write: if the epoch
+	// observed right before the underlying read (via Epoch) doesn't match the
+	// epoch at insertion time, some write - possibly one overlapping this very
+	// range - committed while the read was in flight, and its invalidation
+	// pass may have already run before this entry existed to be invalidated.
+	// Discarding the entry in that case is the only way to avoid resurrecting
+	// stale data; the window is only as wide as a single Range call, so it
+	// rarely costs a cacheable entry in practice.
+	epoch   uint64
+	entries map[string]cacheEntry
+}
+
+// New returns an empty Cache.
+func New() *Cache {
+	return &Cache{entries: make(map[string]cacheEntry)}
+}
+
+// Eligible reports whether r is a candidate for caching. Only requests
+// pinned to the current revision are cached: a request for an explicit
+// historical revision would need its own compaction-aware invalidation,
+// which isn't worth the complexity for the "repeated read of live data"
+// use case this cache targets.
+func Eligible(r *pb.RangeRequest) bool {
+	return r.Revision == 0
+}
+
+// RequestKey returns a canonical cache key for r's parameters. Two requests
+// that would produce the same RangeResponse map to the same key.
+func RequestKey(r *pb.RangeRequest) string {
+	var buf bytes.Buffer
+	writeLenPrefixed(&buf, r.Key)
+	writeLenPrefixed(&buf, r.RangeEnd)
+	_ = binary.Write(&buf, binary.BigEndian, r.Limit)
+	_ = binary.Write(&buf, binary.BigEndian, int32(r.SortOrder))
+	_ = binary.Write(&buf, binary.BigEndian, int32(r.SortTarget))
+	_ = binary.Write(&buf, binary.BigEndian, r.KeysOnly)
+	_ = binary.Write(&buf, binary.BigEndian, r.CountOnly)
+	_ = binary.Write(&buf, binary.BigEndian, r.MinModRevision)
+	_ = binary.Write(&buf, binary.BigEndian, r.MaxModRevision)
+	_ = binary.Write(&buf, binary.BigEndian, r.MinCreateRevision)
+	_ = binary.Write(&buf, binary.BigEndian, r.MaxCreateRevision)
+	return buf.String()
+}
+
+func writeLenPrefixed(buf *bytes.Buffer, b []byte) {
+	var lenBuf [4]byte
+	binary.BigEndian.PutUint32(lenBuf[:], uint32(len(b)))
+	buf.Write(lenBuf[:])
+	buf.Write(b)
+}
+
+// Epoch returns the number of write commits observed so far. Callers must
+// capture it right before performing the underlying read that they intend to
+// cache, and pass it to Put.
+func (c *Cache) Epoch() uint64 {
+	if c == nil {
+		return 0
+	}
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	return c.epoch
+}
+
+// Get returns a cached response for key, if any. The returned response is a
+// fresh copy so that callers can safely mutate its header without racing
+// with other readers of the same cache entry. A nil Cache always misses,
+// so that an EtcdServer built without going through NewServer (as plenty of
+// unit tests do) behaves as if caching were simply disabled.
+func (c *Cache) Get(key string) (*pb.RangeResponse, bool) {
+	if c == nil {
+		return nil, false
+	}
+	c.mu.RLock()
+	e, ok := c.entries[key]
+	c.mu.RUnlock()
+	if !ok {
+		cacheMisses.Inc()
+		return nil, false
+	}
+	cacheHits.Inc()
+	return cloneResponse(e.resp), true
+}
+
+// Put caches resp, computed for the range [start, end) using the semantics
+// of pb.RangeRequest.RangeEnd, under key. epochAtRead must be the value
+// returned by Epoch, captured before the underlying read began; if any write
+// has committed since, the entry is discarded instead of risking staleness.
+func (c *Cache) Put(key string, start, end []byte, resp *pb.RangeResponse, epochAtRead uint64) {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.epoch != epochAtRead {
+		return
+	}
+	if _, exists := c.entries[key]; !exists && len(c.entries) >= maxEntries {
+		c.evictOneLocked()
+	}
+	c.entries[key] = cacheEntry{
+		start: bytes.Clone(start),
+		end:   bytes.Clone(end),
+		resp:  cloneResponse(resp),
+	}
+}
+
+// evictOneLocked drops an arbitrary entry to make room for a new one.
+// Go's map iteration order is randomized, so this is effectively a cheap
+// random-eviction policy; correctness never depends on which entry it picks.
+func (c *Cache) evictOneLocked() {
+	for k := range c.entries {
+		delete(c.entries, k)
+		return
+	}
+}
+
+// CommitWrite must be called synchronously, as part of the same critical
+// section as the mvcc write commit that produced changes, before that
+// commit's effects can be observed by a new read. It drops every cached
+// entry whose range overlaps any changed key, and advances the epoch so that
+// reads already in flight will not cache a response that could have raced
+// with this write.
+func (c *Cache) CommitWrite(changes []*mvccpb.KeyValue) {
+	if c == nil || len(changes) == 0 {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.epoch++
+	// Bounded by maxEntries, so this scan is cheap regardless of how large
+	// the keyspace or the write's key set is.
+	for k, e := range c.entries {
+		for _, ch := range changes {
+			if inRange(ch.Key, e.start, e.end) {
+				delete(c.entries, k)
+				break
+			}
+		}
+	}
+}
+
+// Reset drops every cached entry. It must be called after any change to the
+// store that doesn't go through a normal write commit, such as restoring
+// from a snapshot.
+func (c *Cache) Reset() {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.epoch++
+	c.entries = make(map[string]cacheEntry)
+}
+
+// inRange reports whether key falls within [start, end) using the same
+// RangeEnd conventions as pb.RangeRequest: an empty end means a single key,
+// and a one-byte \x00 end means "start to the end of the keyspace".
+func inRange(key, start, end []byte) bool {
+	switch {
+	case len(end) == 0:
+		return bytes.Equal(key, start)
+	case len(end) == 1 && end[0] == 0:
+		return bytes.Compare(key, start) >= 0
+	default:
+		return bytes.Compare(key, start) >= 0 && bytes.Compare(key, end) < 0
+	}
+}
+
+// cloneResponse builds a fresh RangeResponse sharing resp's Kvs slice (never
+// mutated once produced) but with its own Header, so that concurrent callers
+// each get a header they can safely fill in without racing with one another.
+// It assigns fields individually rather than copying the structs wholesale
+// because the generated proto types embed a sync.Mutex-bearing MessageState.
+func cloneResponse(resp *pb.RangeResponse) *pb.RangeResponse {
+	out := &pb.RangeResponse{
+		Kvs:   resp.Kvs,
+		More:  resp.More,
+		Count: resp.Count,
+	}
+	if resp.Header != nil {
+		out.Header = &pb.ResponseHeader{
+			ClusterId: resp.Header.ClusterId,
+			MemberId:  resp.Header.MemberId,
+			Revision:  resp.Header.Revision,
+			RaftTerm:  resp.Header.RaftTerm,
+		}
+	}
+	return out
+}
diff --git a/server/etcdserver/rangecache/rangecache_test.go b/server/etcdserver/rangecache/rangecache_test.go
new file mode 100644
index 000000000..2526849b1
--- /dev/null
+++ b/server/etcdserver/rangecache/rangecache_test.go
@@ -0,0 +1,150 @@
+// Copyright 2026 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package rangecache
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+)
+
+func TestEligible(t *testing.T) {
+	assert.True(t, Eligible(&pb.RangeRequest{Key: []byte("a")}))
+	assert.False(t, Eligible(&pb.RangeRequest{Key: []byte("a"), Revision: 5}))
+}
+
+func TestRequestKeyDistinguishesParameters(t *testing.T) {
+	base := &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}
+	variants := []*pb.RangeRequest{
+		base,
+		{Key: []byte("a"), RangeEnd: []byte("y")},
+		{Key: []byte("a"), RangeEnd: []byte("z"), Limit: 1},
+		{Key: []byte("a"), RangeEnd: []byte("z"), KeysOnly: true},
+		{Key: []byte("a"), RangeEnd: []byte("z"), CountOnly: true},
+		{Key: []byte("a"), RangeEnd: []byte("z"), SortOrder: pb.RangeRequest_DESCEND},
+		{Key: []byte("a"), RangeEnd: []byte("z"), MinModRevision: 3},
+	}
+	seen := map[string]bool{}
+	for i, v := range variants {
+		k := RequestKey(v)
+		assert.Falsef(t, seen[k], "variant %d collided with an earlier one", i)
+		seen[k] = true
+	}
+	// Identical requests must map to the identical key.
+	assert.Equal(t, RequestKey(base), RequestKey(&pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}))
+}
+
+func TestGetPutRoundTrip(t *testing.T) {
+	c := New()
+	key := "k"
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 7}, Count: 1}
+
+	_, ok := c.Get(key)
+	require.False(t, ok)
+
+	c.Put(key, []byte("a"), nil, resp, c.Epoch())
+	got, ok := c.Get(key)
+	require.True(t, ok)
+	assert.Equal(t, int64(7), got.Header.Revision)
+
+	// The returned response must be independent of the cached copy and of
+	// other concurrent readers: mutating it must not corrupt future hits.
+	got.Header.Revision = 999
+	got2, ok := c.Get(key)
+	require.True(t, ok)
+	assert.Equal(t, int64(7), got2.Header.Revision)
+}
+
+func TestPutRejectsStaleRead(t *testing.T) {
+	c := New()
+	epoch := c.Epoch()
+
+	// A write commits (e.g. to some unrelated key) while our read was in
+	// flight: epoch has moved on since we captured it.
+	c.CommitWrite([]*mvccpb.KeyValue{{Key: []byte("unrelated")}})
+
+	c.Put("k", []byte("a"), nil, &pb.RangeResponse{Header: &pb.ResponseHeader{}}, epoch)
+	_, ok := c.Get("k")
+	assert.False(t, ok, "a response computed before a concurrent commit must not be cached")
+}
+
+func TestCommitWriteInvalidatesOverlappingSingleKey(t *testing.T) {
+	c := New()
+	c.Put("k", []byte("foo"), nil, &pb.RangeResponse{Header: &pb.ResponseHeader{}}, c.Epoch())
+
+	c.CommitWrite([]*mvccpb.KeyValue{{Key: []byte("bar")}})
+	_, ok := c.Get("k")
+	assert.True(t, ok, "a write to an unrelated key must not invalidate the cache")
+
+	c.CommitWrite([]*mvccpb.KeyValue{{Key: []byte("foo")}})
+	_, ok = c.Get("k")
+	assert.False(t, ok, "a write to the cached key must invalidate the cache")
+}
+
+func TestCommitWriteInvalidatesOverlappingRange(t *testing.T) {
+	c := New()
+	c.Put("k", []byte("a"), []byte("m"), &pb.RangeResponse{Header: &pb.ResponseHeader{}}, c.Epoch())
+
+	c.CommitWrite([]*mvccpb.KeyValue{{Key: []byte("z")}})
+	_, ok := c.Get("k")
+	assert.True(t, ok, "a write outside [a, m) must not invalidate the cache")
+
+	c.CommitWrite([]*mvccpb.KeyValue{{Key: []byte("c")}})
+	_, ok = c.Get("k")
+	assert.False(t, ok, "a write inside [a, m) must invalidate the cache")
+}
+
+func TestCommitWriteInvalidatesFromKeyRange(t *testing.T) {
+	c := New()
+	// RangeEnd == {0} means "from Key to the end of the keyspace".
+	c.Put("k", []byte("m"), []byte{0}, &pb.RangeResponse{Header: &pb.ResponseHeader{}}, c.Epoch())
+
+	c.CommitWrite([]*mvccpb.KeyValue{{Key: []byte("a")}})
+	_, ok := c.Get("k")
+	assert.True(t, ok, "a write before the start key must not invalidate the cache")
+
+	c.CommitWrite([]*mvccpb.KeyValue{{Key: []byte("zzz")}})
+	_, ok = c.Get("k")
+	assert.False(t, ok, "a write at or after the start key must invalidate the cache")
+}
+
+func TestResetDropsEverythingAndBumpsEpoch(t *testing.T) {
+	c := New()
+	epoch := c.Epoch()
+	c.Put("k", []byte("a"), nil, &pb.RangeResponse{Header: &pb.ResponseHeader{}}, epoch)
+	_, ok := c.Get("k")
+	require.True(t, ok)
+
+	c.Reset()
+	_, ok = c.Get("k")
+	assert.False(t, ok)
+	assert.NotEqual(t, epoch, c.Epoch())
+}
+
+func TestNilCacheIsANoOp(t *testing.T) {
+	var c *Cache
+	assert.NotPanics(t, func() {
+		assert.Equal(t, uint64(0), c.Epoch())
+		_, ok := c.Get("k")
+		assert.False(t, ok)
+		c.Put("k", []byte("a"), nil, &pb.RangeResponse{Header: &pb.ResponseHeader{}}, 0)
+		c.CommitWrite([]*mvccpb.KeyValue{{Key: []byte("a")}})
+		c.Reset()
+	})
+}
