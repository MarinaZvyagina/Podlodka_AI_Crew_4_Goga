+// rangeWithCache serves r from the range cache when possible, falling back
+// to the normal read path on a miss. By the time this runs, any linearizable
+// read confirmation required by r has already completed, so a cache hit here
+// is exactly as fresh as redoing the read would be: every write that could
+// have affected the cached range has already invalidated it (see
+// rangecache.Cache and mvcc.WatchableKV.SetChangeNotifier).
+func (s *EtcdServer) rangeWithCache(ctx context.Context, r *pb.RangeRequest) (*pb.RangeResponse, error) {
+	if !rangecache.Eligible(r) {
+		resp, _, err := txn.Range(ctx, s.Logger(), s.KV(), r, true)
+		return resp, err
+	}
+
+	key := rangecache.RequestKey(r)
+	if cached, ok := s.rangeCache.Get(key); ok {
+		return cached, nil
+	}
+
+	epoch := s.rangeCache.Epoch()
+	resp, _, err := txn.Range(ctx, s.Logger(), s.KV(), r, true)
+	if err != nil {
+		return nil, err
+	}
+	s.rangeCache.Put(key, r.Key, r.RangeEnd, resp, epoch)
+	return resp, nil
+}
