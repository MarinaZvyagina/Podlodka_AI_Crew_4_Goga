+// TestKVRangeCacheFreshness checks that repeated identical reads keep
+// returning the correct value, and that a write to a previously read (and
+// therefore possibly cached) key is visible on the very next read - for
+// both linearizable (the default) and serializable reads.
+func TestKVRangeCacheFreshness(t *testing.T) {
+	integration.BeforeTest(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	kv := clus.RandClient()
+	ctx := t.Context()
+	key := "cached-key"
+
+	if _, err := kv.Put(ctx, key, "v0"); err != nil {
+		t.Fatalf("put: %v", err)
+	}
+
+	for i := 0; i < 20; i++ {
+		resp, err := kv.Get(ctx, key)
+		if err != nil {
+			t.Fatalf("get #%d: %v", i, err)
+		}
+		if len(resp.Kvs) != 1 || string(resp.Kvs[0].Value) != "v0" {
+			t.Fatalf("get #%d: unexpected value %+v", i, resp.Kvs)
+		}
+	}
+
+	putResp, err := kv.Put(ctx, key, "v1")
+	if err != nil {
+		t.Fatalf("put: %v", err)
+	}
+
+	linResp, err := kv.Get(ctx, key)
+	if err != nil {
+		t.Fatalf("linearizable get: %v", err)
+	}
+	if len(linResp.Kvs) != 1 || string(linResp.Kvs[0].Value) != "v1" {
+		t.Fatalf("linearizable get after write: unexpected value %+v", linResp.Kvs)
+	}
+	if linResp.Header.Revision < putResp.Header.Revision {
+		t.Fatalf("linearizable get returned revision %d older than the put's revision %d", linResp.Header.Revision, putResp.Header.Revision)
+	}
+
+	serResp, err := kv.Get(ctx, key, clientv3.WithSerializable())
+	if err != nil {
+		t.Fatalf("serializable get: %v", err)
+	}
+	if len(serResp.Kvs) != 1 || string(serResp.Kvs[0].Value) != "v1" {
+		t.Fatalf("serializable get after write: unexpected value %+v", serResp.Kvs)
+	}
+}
