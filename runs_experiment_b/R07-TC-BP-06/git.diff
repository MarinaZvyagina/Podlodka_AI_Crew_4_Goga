+package eu.kanade.tachiyomi.data.track.librereader
+
+import dev.icerock.moko.resources.StringResource
+import eu.kanade.tachiyomi.R
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.BaseTracker
+import eu.kanade.tachiyomi.data.track.DeletableTracker
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import tachiyomi.i18n.MR
+import tachiyomi.domain.track.model.Track as DomainTrack
+
+class LibreReader(id: Long) : BaseTracker(id, "LibreReader"), DeletableTracker {
+
+    companion object {
+        const val READING = 1L
+        const val COMPLETED = 2L
+        const val ON_HOLD = 3L
+        const val DROPPED = 4L
+        const val PLAN_TO_READ = 5L
+    }
+
+    private val interceptor by lazy { LibreReaderInterceptor(this) }
+
+    private val api by lazy { LibreReaderApi(this, interceptor, client) }
+
+    override fun getLogo(): Int = R.drawable.brand_librereader
+
+    override fun getStatusList(): List<Long> = listOf(READING, COMPLETED, ON_HOLD, DROPPED, PLAN_TO_READ)
+
+    override fun getStatus(status: Long): StringResource? = when (status) {
+        READING -> MR.strings.reading
+        COMPLETED -> MR.strings.completed
+        ON_HOLD -> MR.strings.on_hold
+        DROPPED -> MR.strings.dropped
+        PLAN_TO_READ -> MR.strings.plan_to_read
+        else -> null
+    }
+
+    override fun getReadingStatus(): Long = READING
+
+    override fun getRereadingStatus(): Long = -1
+
+    override fun getCompletionStatus(): Long = COMPLETED
+
+    override fun getScoreList(): List<String> = emptyList()
+
+    override fun displayScore(track: DomainTrack): String = ""
+
+    override suspend fun update(track: Track, didReadChapter: Boolean): Track {
+        if (track.status != COMPLETED && didReadChapter) {
+            track.status = READING
+        }
+        api.updateLibraryEntry(track)
+        return track
+    }
+
+    override suspend fun delete(track: DomainTrack) {
+        api.deleteLibraryEntry(track.remoteId)
+    }
+
+    override suspend fun bind(track: Track, hasReadChapters: Boolean): Track {
+        return try {
+            api.getLibraryEntry(track)
+        } catch (e: Exception) {
+            track.status = if (hasReadChapters) READING else PLAN_TO_READ
+            api.addToLibrary(track)
+        }
+    }
+
+    override suspend fun search(query: String): List<TrackSearch> = api.search(query)
+
+    override suspend fun refresh(track: Track): Track = api.getLibraryEntry(track)
+
+    override suspend fun login(username: String, password: String) {
+        val apiUrl = getApiUrl()
+        require(apiUrl.isNotBlank()) { "Server URL is required" }
+        api.authenticate(apiUrl, username, password)
+        saveCredentials(username, password)
+    }
+
+    fun getApiUrl(): String = trackPreferences.trackApiUrl(this).get()
+
+    fun saveApiUrl(url: String) {
+        trackPreferences.trackApiUrl(this).set(url.removeSuffix("/"))
+    }
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/data/track/librereader/LibreReaderApi.kt b/app/src/main/java/eu/kanade/tachiyomi/data/track/librereader/LibreReaderApi.kt
new file mode 100644
index 0000000..5faa3f4
--- /dev/null
+++ b/app/src/main/java/eu/kanade/tachiyomi/data/track/librereader/LibreReaderApi.kt
@@ -0,0 +1,145 @@
+package eu.kanade.tachiyomi.data.track.librereader
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRLibraryEntry
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRSeries
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRUser
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import eu.kanade.tachiyomi.network.DELETE
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import okhttp3.Credentials
+import okhttp3.Headers
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import uy.kohesive.injekt.injectLazy
+
+class LibreReaderApi(
+    private val libreReader: LibreReader,
+    interceptor: LibreReaderInterceptor,
+    private val client: OkHttpClient,
+) {
+    private val json: Json by injectLazy()
+
+    private val authClient by lazy {
+        client.newBuilder()
+            .addInterceptor(interceptor)
+            .build()
+    }
+
+    suspend fun authenticate(apiUrl: String, username: String, password: String): LRUser {
+        val headers = Headers.Builder()
+            .add("Authorization", Credentials.basic(username, password))
+            .build()
+        return with(json) {
+            client.newCall(GET("$apiUrl/api/v1/user", headers = headers))
+                .awaitSuccess()
+                .parseAs<LRUser>()
+        }
+    }
+
+    suspend fun search(query: String): List<TrackSearch> {
+        val apiUrl = libreReader.getApiUrl()
+        return with(json) {
+            authClient.newCall(GET("$apiUrl/api/v1/series/search?q=$query"))
+                .awaitSuccess()
+                .parseAs<List<LRSeries>>()
+                .map { parseSearchItem(it) }
+        }
+    }
+
+    suspend fun getLibraryEntry(track: Track): Track {
+        val apiUrl = libreReader.getApiUrl()
+        val entry = with(json) {
+            authClient.newCall(GET("$apiUrl/api/v1/library/${track.remote_id}"))
+                .awaitSuccess()
+                .parseAs<LRLibraryEntry>()
+        }
+        return applyEntry(track, entry)
+    }
+
+    suspend fun addToLibrary(track: Track): Track {
+        val apiUrl = libreReader.getApiUrl()
+        val body = buildJsonObject {
+            put("series_id", track.remote_id)
+            put("status", track.status.toStatusString())
+            put("last_chapter_read", track.last_chapter_read)
+        }
+        val entry = with(json) {
+            authClient.newCall(
+                POST(
+                    url = "$apiUrl/api/v1/library",
+                    body = body.toString().toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<LRLibraryEntry>()
+        }
+        return applyEntry(track, entry)
+    }
+
+    suspend fun updateLibraryEntry(track: Track) {
+        val apiUrl = libreReader.getApiUrl()
+        val body = buildJsonObject {
+            put("status", track.status.toStatusString())
+            put("last_chapter_read", track.last_chapter_read)
+        }
+        authClient.newCall(
+            PUT(
+                url = "$apiUrl/api/v1/library/${track.remote_id}",
+                body = body.toString().toRequestBody(CONTENT_TYPE),
+            ),
+        )
+            .awaitSuccess()
+    }
+
+    suspend fun deleteLibraryEntry(seriesId: Long) {
+        val apiUrl = libreReader.getApiUrl()
+        authClient.newCall(DELETE(url = "$apiUrl/api/v1/library/$seriesId"))
+            .awaitSuccess()
+    }
+
+    private fun parseSearchItem(series: LRSeries): TrackSearch {
+        return TrackSearch.create(libreReader.id).apply {
+            remote_id = series.id
+            title = series.title
+            cover_url = series.coverUrl ?: ""
+            summary = series.summary ?: ""
+            total_chapters = series.totalChapters ?: 0
+            tracking_url = "${libreReader.getApiUrl()}/series/${series.id}"
+        }
+    }
+
+    private fun applyEntry(track: Track, entry: LRLibraryEntry): Track {
+        track.status = entry.status.toStatusLong()
+        track.last_chapter_read = entry.lastChapterRead
+        return track
+    }
+
+    private fun String.toStatusLong(): Long = when (this) {
+        "reading" -> LibreReader.READING
+        "completed" -> LibreReader.COMPLETED
+        "on_hold" -> LibreReader.ON_HOLD
+        "dropped" -> LibreReader.DROPPED
+        else -> LibreReader.PLAN_TO_READ
+    }
+
+    private fun Long.toStatusString(): String = when (this) {
+        LibreReader.READING -> "reading"
+        LibreReader.COMPLETED -> "completed"
+        LibreReader.ON_HOLD -> "on_hold"
+        LibreReader.DROPPED -> "dropped"
+        else -> "plan_to_read"
+    }
+
+    companion object {
+        private val CONTENT_TYPE = "application/json".toMediaType()
+    }
+}
