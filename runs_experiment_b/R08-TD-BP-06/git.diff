+
+package org.thoughtcrime.securesms.database
+
+import android.app.Application
+import assertk.assertThat
+import assertk.assertions.hasSize
+import io.mockk.every
+import io.mockk.mockkStatic
+import io.mockk.unmockkStatic
+import org.junit.After
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.search.SearchRepository
+import org.thoughtcrime.securesms.testutil.RecipientTestRule
+
+/**
+ * Verifies the chat-list search result cache added to [SearchRepository]: repeated identical
+ * queries are served from cache, but that cache is dropped as soon as the conversation list
+ * changes so a later identical search never returns stale results.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class SearchRepositoryCacheTest {
+
+  @get:Rule
+  val recipients = RecipientTestRule()
+
+  private lateinit var observer: DatabaseObserver
+  private lateinit var repository: SearchRepository
+
+  @Before
+  fun setUp() {
+    observer = DatabaseObserver()
+    mockkStatic(AppDependencies::class)
+    every { AppDependencies.databaseObserver } returns observer
+
+    repository = SearchRepository("Note to Self")
+  }
+
+  @After
+  fun tearDown() {
+    unmockkStatic(AppDependencies::class)
+  }
+
+  @Test
+  fun `queryThreadsSync serves cached results until the conversation list changes`() {
+    val alice = recipients.createRecipient("Alice Wonderland")
+    recipients.insertIncomingMessage(alice)
+
+    assertThat(repository.queryThreadsSync("Alice", false).results).hasSize(1)
+
+    // A second matching thread appears, but the observer hasn't fired yet: the cached result
+    // for the exact same query should still be served, proving the second call was a cache hit
+    // rather than a fresh database query.
+    val aliceToo = recipients.createRecipient("Alice Two")
+    recipients.insertIncomingMessage(aliceToo)
+    assertThat(repository.queryThreadsSync("Alice", false).results).hasSize(1)
+
+    // Once the conversation list change is signalled, the same query must reflect current data.
+    observer.notifyConversationListListeners()
+    observer.flush()
+    assertThat(repository.queryThreadsSync("Alice", false).results).hasSize(2)
+  }
+
+  @Test
+  fun `different queries are cached independently`() {
+    val alice = recipients.createRecipient("Alice Wonderland")
+    recipients.insertIncomingMessage(alice)
+    val bob = recipients.createRecipient("Bob Builder")
+    recipients.insertIncomingMessage(bob)
+
+    assertThat(repository.queryThreadsSync("Alice", false).results).hasSize(1)
+    assertThat(repository.queryThreadsSync("Bob", false).results).hasSize(1)
+
+    // Re-querying "Alice" must still return only the Alice thread, i.e. the "Bob" cache entry
+    // didn't clobber it.
+    assertThat(repository.queryThreadsSync("Alice", false).results).hasSize(1)
+  }
+}
