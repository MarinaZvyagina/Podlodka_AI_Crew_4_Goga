+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import android.app.Application
+import io.mockk.CapturingSlot
+import io.mockk.every
+import io.mockk.just
+import io.mockk.mockk
+import io.mockk.mockkObject
+import io.mockk.runs
+import io.mockk.slot
+import io.mockk.unmockkAll
+import io.mockk.verify
+import org.junit.After
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.thoughtcrime.securesms.database.DatabaseObserver
+import org.thoughtcrime.securesms.database.GroupTable
+import org.thoughtcrime.securesms.database.RecipientTable
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.database.ThreadTable
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.testutil.MockAppDependenciesRule
+
+/**
+ * Verifies that [SearchRepository] caches results for repeated identical searches and only
+ * invalidates that cache when something relevant to search results actually changes.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class SearchRepositoryCacheTest {
+
+  @get:Rule
+  val appDependencies = MockAppDependenciesRule()
+
+  private lateinit var recipientTable: RecipientTable
+  private lateinit var threadTable: ThreadTable
+  private lateinit var observerSlot: CapturingSlot<DatabaseObserver.Observer>
+
+  @Before
+  fun setUp() {
+    recipientTable = mockk(relaxed = true)
+    threadTable = mockk(relaxed = true)
+    val groupTable = mockk<GroupTable>(relaxed = true)
+
+    mockkObject(SignalDatabase)
+    every { SignalDatabase.recipients } returns recipientTable
+    every { SignalDatabase.threads } returns threadTable
+    every { SignalDatabase.groups } returns groupTable
+    every { SignalDatabase.mentions } returns mockk(relaxed = true)
+    every { SignalDatabase.messages } returns mockk(relaxed = true)
+    every { SignalDatabase.messageSearch } returns mockk(relaxed = true)
+
+    every { recipientTable.queryAllContacts(any(), any()) } returns null
+    every { groupTable.queryGroupsByTitle(any(), any(), any(), any()) } returns GroupTable.Reader(null)
+    every { threadTable.getFilteredConversationList(any(), any()) } returns null
+
+    observerSlot = slot()
+    every { AppDependencies.databaseObserver.registerConversationListObserver(capture(observerSlot)) } just runs
+  }
+
+  @After
+  fun cleanup() {
+    unmockkAll()
+  }
+
+  @Test
+  fun repeatedIdenticalQueryIsServedFromCache() {
+    val repository = SearchRepository("Note to Self")
+
+    repository.queryThreadsSync("hello", false)
+    repository.queryThreadsSync("hello", false)
+
+    verify(exactly = 1) { recipientTable.queryAllContacts(any(), any()) }
+  }
+
+  @Test
+  fun differentQueryTextIsNotServedFromCache() {
+    val repository = SearchRepository("Note to Self")
+
+    repository.queryThreadsSync("hello", false)
+    repository.queryThreadsSync("world", false)
+
+    verify(exactly = 2) { recipientTable.queryAllContacts(any(), any()) }
+  }
+
+  @Test
+  fun conversationListChangeInvalidatesTheCache() {
+    val repository = SearchRepository("Note to Self")
+
+    repository.queryThreadsSync("hello", false)
+    observerSlot.captured.onChanged()
+    repository.queryThreadsSync("hello", false)
+
+    verify(exactly = 2) { recipientTable.queryAllContacts(any(), any()) }
+  }
+}
