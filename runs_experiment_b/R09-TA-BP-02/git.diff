+    // MARK: - Removing Data
+    @MainActor
+    func testRemoveWindowData_removesPrimaryAndBackup_whenBackupExists() async throws {
+        let subject = createSubject()
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        let primaryURL = URL(string: "some/directory1/window-\(defaultTestTabWindowUUID.uuidString)")!
+        mockFileManager.pathContents = [primaryURL]
+        mockFileManager.fileExists = true
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        let expectedBackupURL = URL(string: "some/directory2/window-\(defaultTestTabWindowUUID.uuidString)")!
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertEqual(mockFileManager.removedFilePaths, [primaryURL, expectedBackupURL])
+    }
+
+    @MainActor
+    func testRemoveWindowData_removesOnlyPrimary_whenNoBackupExists() async throws {
+        let subject = createSubject()
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        let primaryURL = URL(string: "some/directory1/window-\(defaultTestTabWindowUUID.uuidString)")!
+        mockFileManager.pathContents = [primaryURL]
+        mockFileManager.fileExists = false
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 1)
+        XCTAssertEqual(mockFileManager.removedFilePaths, [primaryURL])
+    }
+
+    @MainActor
+    func testRemoveWindowData_leavesUnlistedWindowsAndBackupsUntouched() async throws {
+        let subject = createSubject()
+        let otherUUID = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        let removedPrimaryURL = URL(string: "some/directory1/window-\(defaultTestTabWindowUUID.uuidString)")!
+        let untouchedPrimaryURL = URL(string: "some/directory1/window-\(otherUUID.uuidString)")!
+        mockFileManager.pathContents = [removedPrimaryURL, untouchedPrimaryURL]
+        mockFileManager.fileExists = true
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        let removedBackupURL = URL(string: "some/directory2/window-\(defaultTestTabWindowUUID.uuidString)")!
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertEqual(mockFileManager.removedFilePaths, [removedPrimaryURL, removedBackupURL])
+        XCTAssertFalse(mockFileManager.removedFilePaths.contains(untouchedPrimaryURL))
+    }
