diff --git a/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
new file mode 100644
index 0000000..df43469
--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,70 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import Foundation
+
+/// A stand-in transcription engine for A/B testing an alternative speech-to-text pipeline.
+///
+/// Captures audio through the same `AudioManagerProtocol`/`AuthorizeProvider` abstractions as
+/// `SFSpeechRecognizerEngine` so permission handling and audio session behavior are identical
+/// regardless of which engine is active. Recognition itself is simulated by streaming a canned
+/// phrase word-by-word rather than calling into a real third-party engine.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let simulatedWords: [String]
+    private let simulatedWordDelayNanoseconds: UInt64
+
+    private var simulationTask: Task<Void, Never>?
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        simulatedWords: [String] = ["this", "is", "the", "alternative", "pipeline"],
+        simulatedWordDelayNanoseconds: UInt64 = 300_000_000
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.simulatedWords = simulatedWords
+        self.simulatedWordDelayNanoseconds = simulatedWordDelayNanoseconds
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        simulationTask?.cancel()
+        simulationTask = Task { [weak self] in
+            guard let self else { return }
+            for count in 1...self.simulatedWords.count {
+                try? await Task.sleep(nanoseconds: self.simulatedWordDelayNanoseconds)
+                guard !Task.isCancelled else { return }
+
+                let isFinal = count == self.simulatedWords.count
+                let speechResult = SpeechResult(
+                    text: self.simulatedWords[0..<count].joined(separator: " "),
+                    isFinal: isFinal
+                )
+                continuation.yield(speechResult)
+
+                if isFinal {
+                    continuation.finish()
+                }
+            }
+        }
+    }
+
+    func stop() throws {
+        simulationTask?.cancel()
+        simulationTask = nil
+        try audioManager.stopEngine()
+    }
+}
