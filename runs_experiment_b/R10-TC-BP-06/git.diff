+
+    private static let secondsPerDay: TimeInterval = 24 * 60 * 60
+
+    /// Minimum time between automatic (non-user-initiated) retention sweeps.
+    private static let minimumSweepInterval: TimeInterval = secondsPerDay
+
+    /// Enqueues bulk-delete jobs for any threads with messages older than
+    /// the given retention window, unconditionally (bypassing throttling).
+    /// Used both for routine sweeps and to apply a newly-changed retention
+    /// setting retroactively right away.
+    public func sweepMessageRetention(
+        retentionPeriodDays: UInt32,
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        let cutoffTimestamp = now
+            .addingTimeInterval(-TimeInterval(retentionPeriodDays) * Self.secondsPerDay)
+            .ows_millisecondsSince1970
+
+        threadStore.enumerateNonStoryThreads(tx: tx) { thread -> Bool in
+            guard
+                let anchorMessageRowId = InteractionFinder(threadUniqueId: thread.uniqueId)
+                    .rowIdOfNewestInteraction(receivedAtOrBefore: cutoffTimestamp, tx: tx)
+            else {
+                return true
+            }
+
+            self.addJob(
+                anchorMessageRowId: anchorMessageRowId,
+                isFullThreadDelete: false,
+                threadUniqueId: thread.uniqueId,
+                tx: tx,
+            )
+
+            return true
+        }
+
+        SSKPreferences.setLastMessageRetentionSweepAt(now, transaction: tx)
+    }
+
+    /// Throttled wrapper around `sweepMessageRetention`, for use at routine
+    /// automatic trigger points (app launch, foregrounding). Does nothing if
+    /// retention is disabled or a sweep already ran recently.
+    func sweepMessageRetentionIfNeeded(
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        guard let retentionPeriodDays = SSKPreferences.messageRetentionPeriodDays(transaction: tx) else {
+            return
+        }
+
+        if
+            let lastSweepAt = SSKPreferences.lastMessageRetentionSweepAt(transaction: tx),
+            now.timeIntervalSince(lastSweepAt) < Self.minimumSweepInterval
+        {
+            return
+        }
+
+        sweepMessageRetention(
+            retentionPeriodDays: retentionPeriodDays,
+            now: now,
+            threadStore: threadStore,
+            tx: tx,
+        )
+    }
 }
 
