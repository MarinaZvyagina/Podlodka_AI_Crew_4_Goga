+    // MARK: - Message Retention
+
+    private static let messageRetentionPeriodDaysOptions: [UInt32?] = [nil, 30, 90, 365]
+
+    private static func formatMessageRetentionPeriod(_ days: UInt32?) -> String {
+        switch days {
+        case nil:
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_FOREVER",
+                comment: "Label indicating that messages are kept forever, in the 'message retention' setting of the Chats settings.",
+            )
+        case 365:
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_1_YEAR",
+                comment: "Label indicating that messages are kept for one year, in the 'message retention' setting of the Chats settings.",
+            )
+        case .some(let days):
+            let format = OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_N_DAYS_FORMAT",
+                comment: "Label indicating that messages are kept for a number of days, in the 'message retention' setting of the Chats settings. Embeds {{ the number of days }}.",
+            )
+            return String(format: format, String(days))
+        }
+    }
+
+    private func showMessageRetentionPicker() {
+        let actionSheet = ActionSheetController(title: OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_TITLE",
+            comment: "Label for the 'message retention' setting in the Chats settings, which lets the user automatically delete old messages.",
+        ))
+
+        for option in Self.messageRetentionPeriodDaysOptions {
+            actionSheet.addAction(.init(
+                title: Self.formatMessageRetentionPeriod(option),
+                handler: { [weak self] _ in
+                    self?.didSelectMessageRetentionPeriod(option)
+                },
+            ))
+        }
+
+        actionSheet.addAction(OWSActionSheets.cancelAction)
+
+        presentActionSheet(actionSheet)
+    }
+
+    private func didSelectMessageRetentionPeriod(_ days: UInt32?) {
+        Logger.info("selected message retention period: \(String(describing: days))")
+        let threadStore = DependenciesBridge.shared.threadStore
+
+        SSKEnvironment.shared.databaseStorageRef.asyncWrite { tx in
+            SSKPreferences.setMessageRetentionPeriodDays(days, transaction: tx)
+
+            // Apply retroactively, right away, rather than waiting for the
+            // next throttled routine sweep.
+            if let days {
+                SSKEnvironment.shared.bulkDeleteInteractionJobQueueRef.sweepMessageRetention(
+                    retentionPeriodDays: days,
+                    now: Date(),
+                    threadStore: threadStore,
+                    tx: tx,
+                )
+            }
+        } completion: { [weak self] in
+            self?.updateTableContents()
+        }
+    }
