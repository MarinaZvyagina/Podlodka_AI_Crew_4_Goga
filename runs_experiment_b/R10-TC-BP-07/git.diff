diff --git a/SignalServiceKit/Storage/Database/Records/InteractionFinder.swift b/SignalServiceKit/Storage/Database/Records/InteractionFinder.swift
index 10ddd2a..4bdd9b1 100644
--- a/SignalServiceKit/Storage/Database/Records/InteractionFinder.swift
+++ b/SignalServiceKit/Storage/Database/Records/InteractionFinder.swift
@@ -1495,4 +1495,30 @@ extension InteractionFinder {
             return 0
         }
     }
+
+    /// The row ID of the most-recently-received interaction in the given
+    /// thread whose `receivedAtTimestamp` is at or before the given cutoff.
+    /// Returns `nil` if there's no such interaction.
+    public class func rowIdOfNewestInteraction(
+        threadUniqueId: String,
+        receivedAtOrBefore timestamp: UInt64,
+        tx: DBReadTransaction,
+    ) -> Int64? {
+        let sql = """
+        SELECT MAX(\(interactionColumn: .id))
+        FROM \(InteractionRecord.databaseTableName)
+        WHERE \(interactionColumn: .threadUniqueId) = ?
+        AND \(interactionColumn: .receivedAtTimestamp) <= ?
+        """
+        do {
+            return try Int64.fetchOne(
+                tx.database,
+                sql: sql,
+                arguments: [threadUniqueId, timestamp],
+            )
+        } catch {
+            owsFailDebug("Failed to find newest interaction row ID: \(error)")
+            return nil
+        }
+    }
 }
