+
+    // MARK: - Message Retention Sweep
+
+    private enum RetentionSweepConstants {
+        static let secondsPerDay: TimeInterval = 24 * 60 * 60
+        static let minimumSweepInterval: TimeInterval = 24 * 60 * 60
+    }
+
+    /// Enqueues a bulk-delete job for every thread that has messages older
+    /// than the given retention window, unconditionally (i.e. regardless of
+    /// when the last sweep ran). Used both for routine sweeps and to apply a
+    /// newly-set/changed retention window retroactively right away.
+    public func sweepMessageRetention(
+        retentionPeriodDays: UInt32,
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        let cutoffTimestamp = now
+            .addingTimeInterval(-TimeInterval(retentionPeriodDays) * RetentionSweepConstants.secondsPerDay)
+            .ows_millisecondsSince1970
+
+        threadStore.enumerateNonStoryThreads(tx: tx) { thread in
+            if
+                let anchorMessageRowId = InteractionFinder.rowIdOfNewestInteraction(
+                    threadUniqueId: thread.uniqueId,
+                    receivedAtOrBefore: cutoffTimestamp,
+                    tx: tx,
+                )
+            {
+                self.addJob(
+                    anchorMessageRowId: anchorMessageRowId,
+                    isFullThreadDelete: false,
+                    threadUniqueId: thread.uniqueId,
+                    tx: tx,
+                )
+            }
+            return true
+        }
+
+        SSKPreferences.setLastMessageRetentionSweepAt(now, transaction: tx)
+    }
+
+    /// A throttled wrapper around `sweepMessageRetention` intended for
+    /// routine/automatic triggers (e.g. app launch, foreground). Does nothing
+    /// if retention is disabled or if a sweep already ran recently.
+    func sweepMessageRetentionIfNeeded(
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        guard let retentionPeriodDays = SSKPreferences.messageRetentionPeriodDays(transaction: tx) else {
+            return
+        }
+
+        if
+            let lastSweptAt = SSKPreferences.lastMessageRetentionSweepAt(transaction: tx),
+            now.timeIntervalSince(lastSweptAt) < RetentionSweepConstants.minimumSweepInterval
+        {
+            return
+        }
+
+        sweepMessageRetention(
+            retentionPeriodDays: retentionPeriodDays,
+            now: now,
+            threadStore: threadStore,
+            tx: tx,
+        )
+    }
 }
 
