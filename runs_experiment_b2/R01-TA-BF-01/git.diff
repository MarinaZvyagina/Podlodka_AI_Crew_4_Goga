+def _validate_capital_config(conf: dict[str, Any]) -> None:
+    """
+    `available_capital` and `tradable_balance_ratio` both size the tradable stake, but only
+    one of them is ever used - `available_capital` takes precedence and `tradable_balance_ratio`
+    is silently ignored when both are present.
+    """
+    if "available_capital" in conf and "tradable_balance_ratio" in conf:
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in the config. "
+            "Only one of these settings is used to determine the tradable capital, and the "
+            "other one will be ignored. Please remove one of these settings."
+        )
+
