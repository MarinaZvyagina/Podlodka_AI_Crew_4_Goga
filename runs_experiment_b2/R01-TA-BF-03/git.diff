+def _validate_capital_config(conf: dict[str, Any]) -> None:
+    """
+    `available_capital` and `tradable_balance_ratio` cannot be usefully combined - whichever
+    starting-balance calculation is used, only one of the two settings takes effect and the
+    other is silently ignored. Fail fast instead of surprising the user at runtime.
+    """
+    if "available_capital" in conf and "tradable_balance_ratio" in conf:
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in your "
+            "configuration. Only one of these settings is used to determine the starting "
+            "capital, and the other will be silently ignored. Please remove one of them."
+        )
+
