+def _validate_capital_config(conf: dict[str, Any]) -> None:
+    """
+    `available_capital` and `tradable_balance_ratio` both control starting capital sizing,
+    but only one of them takes effect - whichever is set wins, and the other is silently
+    ignored. Setting both is almost always a misconfiguration, so fail fast instead of
+    quietly using one and dropping the other.
+    """
+    if "available_capital" in conf and "tradable_balance_ratio" in conf:
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in your config. "
+            "Only one of these settings is used to determine your starting capital - the "
+            "other is ignored. Please remove one of these settings."
+        )
+
