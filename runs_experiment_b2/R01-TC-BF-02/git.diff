@@ -0,0 +1,113 @@
+import logging
+from datetime import datetime
+from typing import Any
+
+from freqtrade.constants import Config, LongShort
+from freqtrade.persistence import LocalTrade, Trade
+from freqtrade.plugins.protections import IProtection, ProtectionReturn
+
+
+logger = logging.getLogger(__name__)
+
+
+class MaxConsecutiveLosses(IProtection):
+    has_global_stop: bool = True
+    has_local_stop: bool = True
+
+    def __init__(self, config: Config, protection_config: dict[str, Any]) -> None:
+        super().__init__(config, protection_config)
+
+        self._trade_limit = protection_config.get("trade_limit", 4)
+        self._disable_global_stop = protection_config.get("only_per_pair", False)
+        self._only_per_side = protection_config.get("only_per_side", False)
+        self._profit_limit = protection_config.get("required_profit", 0.0)
+
+    def short_desc(self) -> str:
+        """
+        Short method description - used for startup-messages
+        """
+        return (
+            f"{self.name} - Max consecutive losses, stop trading after {self._trade_limit} "
+            f"trades in a row with profit < {self._profit_limit:.2%}."
+        )
+
+    def _reason(self) -> str:
+        """
+        LockReason to use
+        """
+        return f"{self._trade_limit} consecutive losses, locking {self.unlock_reason_time_element}."
+
+    def _most_recent_losing_streak(self, trades: list[LocalTrade]) -> list[LocalTrade]:
+        """
+        From the given (unsorted) closed trades, return the most recent run of
+        consecutive losing trades - i.e. the trailing streak ending at the latest close_date.
+        Stops as soon as a trade with profit >= required_profit is encountered.
+        """
+        trades_sorted = sorted(trades, key=lambda t: t.close_date, reverse=True)
+
+        streak: list[LocalTrade] = []
+        for trade in trades_sorted:
+            if trade.close_profit is not None and trade.close_profit < self._profit_limit:
+                streak.append(trade)
+            else:
+                break
+        return streak
+
+    def _consecutive_losses(
+        self, date_now: datetime, pair: str | None, side: LongShort
+    ) -> ProtectionReturn | None:
+        """
+        Evaluate most recent trades for a consecutive-loss streak
+        """
+        trades = Trade.get_trades_proxy(pair=pair, is_open=False)
+
+        if self._only_per_side:
+            # Long or short trades only
+            trades = [trade for trade in trades if trade.trade_direction == side]
+
+        if len(trades) < self._trade_limit:
+            # Not enough trades yet to reach the configured streak length
+            return None
+
+        streak = self._most_recent_losing_streak(trades)
+
+        if len(streak) < self._trade_limit:
+            return None
+
+        self.log_once(
+            f"Trading stopped due to {self._trade_limit} consecutive losses"
+            f"{f' for {pair}' if pair else ''}.",
+            logger.info,
+        )
+        until = self.calculate_lock_end(streak)
+
+        return ProtectionReturn(
+            lock=True,
+            until=until,
+            reason=self._reason(),
+            lock_side=(side if self._only_per_side else "*"),
+        )
+
+    def global_stop(
+        self, date_now: datetime, side: LongShort, starting_balance: float
+    ) -> ProtectionReturn | None:
+        """
+        Stops trading (position entering) for all pairs
+        This must evaluate to true for the whole period of the "cooldown period".
+        :return: Tuple of [bool, until, reason].
+            If true, all pairs will be locked with <reason> until <until>
+        """
+        if self._disable_global_stop:
+            return None
+        return self._consecutive_losses(date_now, None, side)
+
+    def stop_per_pair(
+        self, pair: str, date_now: datetime, side: LongShort, starting_balance: float
+    ) -> ProtectionReturn | None:
+        """
+        Stops trading (position entering) for this pair
+        This must evaluate to true for the whole period of the "cooldown period".
+        :return: Tuple of [bool, until, reason].
+            If true, this pair will be locked with <reason> until <until>
+        """
+        return self._consecutive_losses(date_now, pair, side)
