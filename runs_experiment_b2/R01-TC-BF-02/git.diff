+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses_per_pair(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "trade_limit": 3,
+            "stop_duration": 60,
+            "only_per_pair": True,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*"
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2 losses in a row - below trade_limit, no lock yet.
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=200,
+        min_ago_close=90,
+        profit_rate=0.9,
+    )
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=150,
+        min_ago_close=60,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert not PairLocks.is_pair_locked("XRP/BTC")
+
+    # A winning trade resets the streak, even though 2 losses preceded it.
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        min_ago_open=100,
+        min_ago_close=40,
+        profit_rate=1.1,
+    )
+    Trade.commit()
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert not PairLocks.is_pair_locked("XRP/BTC")
+
+    # Losses on another pair must not count towards this pair's streak.
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=90,
+        min_ago_close=35,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+
+    # 3 fresh losses in a row for XRP/BTC -> pair gets locked.
+    for min_ago_close in (30, 20, 10):
+        generate_mock_trade(
+            "XRP/BTC",
+            fee.return_value,
+            False,
+            exit_reason=ExitType.STOP_LOSS.value,
+            min_ago_open=min_ago_close + 60,
+            min_ago_close=min_ago_close,
+            profit_rate=0.9,
+        )
+    Trade.commit()
+
+    assert freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_pair_locked("XRP/BTC")
+    # only_per_pair disables the bot-wide check entirely.
+    assert not freqtrade.protections.global_stop()
+    assert not PairLocks.is_global_lock()
+    # The unrelated pair (only 1 loss) stays unaffected.
+    assert not PairLocks.is_pair_locked("ETH/BTC")
+
+
+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses_global(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "trade_limit": 3,
+            "stop_duration": 60,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*"
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 3 consecutive losses closed in a row, spread across 3 different pairs.
+    for pair, min_ago_close in (("XRP/BTC", 90), ("ETH/BTC", 60), ("LTC/BTC", 30)):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.STOP_LOSS.value,
+            min_ago_open=min_ago_close + 60,
+            min_ago_close=min_ago_close,
+            profit_rate=0.9,
+        )
+    Trade.commit()
+
+    # None of the individual pairs had 3 losses of their own.
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert not freqtrade.protections.stop_per_pair("ETH/BTC")
+    assert not freqtrade.protections.stop_per_pair("LTC/BTC")
+
+    # But bot-wide, 3 losses closed in a row -> lock everything.
+    assert freqtrade.protections.global_stop()
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_global_lock()
+
+    # Once stop_duration has elapsed, the lock is no longer active.
+    end_time = PairLocks.get_pair_longest_lock("*").lock_end_time + timedelta(minutes=5)
+    assert not freqtrade.protections.global_stop(end_time)
+    assert not PairLocks.is_global_lock(end_time)
+
