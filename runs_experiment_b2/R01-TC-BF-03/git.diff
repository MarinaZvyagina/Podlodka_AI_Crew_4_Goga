+@pytest.mark.parametrize("is_short", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses_global(mocker, default_conf, fee, caplog, is_short):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 1000,
+            "stop_duration": 40,
+            "trade_limit": 3,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*"
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2 losses in a row - not enough yet
+    for pair, min_ago in (("XRP/BTC", 200), ("BCH/BTC", 150)):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.STOP_LOSS.value,
+            min_ago_open=min_ago + 30,
+            min_ago_close=min_ago,
+            profit_rate=0.9,
+            is_short=is_short,
+        )
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # A win resets the streak - even though 3 losing trades exist in total.
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        min_ago_open=130,
+        min_ago_close=100,
+        profit_rate=1.1,
+        is_short=is_short,
+    )
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2 more losses back-to-back after the win - now 2 in a row, still not enough.
+    for pair, min_ago in (("LTC/BTC", 80), ("ETC/BTC", 60)):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.STOP_LOSS.value,
+            min_ago_open=min_ago + 20,
+            min_ago_close=min_ago,
+            profit_rate=0.9,
+            is_short=is_short,
+        )
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 3rd consecutive loss since the win - streak of 3, protection triggers.
+    generate_mock_trade(
+        "ADA/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=50,
+        min_ago_close=30,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    assert freqtrade.protections.global_stop()
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_global_lock()
+
+    # Test 5m after lock-period - this should try and relock the pair, but end-time
+    # should be the previous end-time
+    end_time = PairLocks.get_pair_longest_lock("*").lock_end_time + timedelta(minutes=5)
+    freqtrade.protections.global_stop(end_time)
+    assert not PairLocks.is_global_lock(end_time)
+
+
+@pytest.mark.parametrize("only_per_pair", [False, True])
+@pytest.mark.parametrize("only_per_side", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses_perpair(
+    mocker, default_conf, fee, caplog, only_per_pair, only_per_side
+):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 1000,
+            "trade_limit": 2,
+            "stop_duration": 60,
+            "only_per_pair": only_per_pair,
+            "only_per_side": only_per_side,
+        }
+    ]
+    check_side = "long" if only_per_side else "*"
+    is_short = False
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*"
+    pair = "XRP/BTC"
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 1st loss for pair - not enough yet.
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=200,
+        min_ago_close=30,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # Loss on a different pair - counts for global_stop, not for stop_per_pair(pair).
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=190,
+        min_ago_close=25,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert freqtrade.protections.global_stop() != only_per_pair
+    if not only_per_pair:
+        assert log_has_re(message, caplog)
+    else:
+        assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # Trade does not count potentially, as it's in the wrong direction
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=150,
+        min_ago_close=20,
+        profit_rate=0.9,
+        is_short=not is_short,
+    )
+    freqtrade.protections.stop_per_pair(pair)
+    assert freqtrade.protections.global_stop() != only_per_pair
+    assert PairLocks.is_pair_locked(pair, side=check_side) != (only_per_side and only_per_pair)
+    assert PairLocks.is_global_lock(side=check_side) != only_per_pair
+    if only_per_side:
+        assert not PairLocks.is_pair_locked(pair, side="*")
+        assert not PairLocks.is_global_lock(side="*")
+    caplog.clear()
+
+    # 2nd consecutive loss for pair, correct side - triggers stop_per_pair.
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=100,
+        min_ago_close=10,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    freqtrade.protections.stop_per_pair(pair)
+    assert freqtrade.protections.global_stop() != only_per_pair
+    assert PairLocks.is_pair_locked(pair, side=check_side)
+
+
