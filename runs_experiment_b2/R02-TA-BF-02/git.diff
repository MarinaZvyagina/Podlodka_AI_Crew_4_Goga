--- a/salt/beacons/diskusage.py
+++ b/salt/beacons/diskusage.py
@@ -40,9 +40,42 @@ def validate(config):
     # Configuration for diskusage beacon should be a list of dicts
     if not isinstance(config, list):
         return False, "Configuration for diskusage beacon must be a list."
+
+    for mounts in config:
+        if not isinstance(mounts, dict):
+            continue
+        for mount, thresholds in mounts.items():
+            if not isinstance(thresholds, dict):
+                continue
+            unknown = set(thresholds) - {"high", "low"}
+            if unknown:
+                return (
+                    False,
+                    "Configuration for diskusage beacon mount '{}' contains "
+                    "unknown threshold(s): {}.".format(
+                        mount, ", ".join(sorted(unknown))
+                    ),
+                )
+            if not thresholds:
+                return (
+                    False,
+                    "Configuration for diskusage beacon mount '{}' must specify"
+                    " at least one of 'high' or 'low'.".format(mount),
+                )
+
     return True, "Valid beacon configuration"
 
 
+def _to_percent(value):
+    """
+    Normalize a configured threshold (a percent string like "50%" or a bare
+    number) to a float percentage.
+    """
+    if isinstance(value, str) and "%" in value:
+        value = re.sub("%", "", value)
+    return float(value)
+
+
 def beacon(config):
     r"""
     Monitor the disk usage of the minion
@@ -83,6 +116,28 @@ def beacon(config):
     which means that if a regular expression matches another defined mount point,
     it will override the previously defined threshold.
 
+    A mount can also be watched for usage dropping below an expected level.
+    This is normally a sign that the filesystem failed to mount (so what
+    looks like the real disk is actually the empty backing directory on the
+    root filesystem), rather than that space was genuinely freed. To
+    configure this, use a mapping with ``high`` and/or ``low`` keys instead
+    of a bare percentage:
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /: 63%
+            - /mnt/nfs:
+                high: 50%
+                low: 5%
+
+    ``high`` behaves exactly like the bare percentage form above: a beacon
+    fires when usage is at or above it. ``low`` fires a beacon when usage is
+    at or below it. Either key may be used on its own, and the bare
+    percentage form and the ``high``/``low`` mapping form can both be used
+    at once, for the same or different mounts.
+
     """
     whitelist = []
     config = salt.utils.beacons.remove_hidden_options(config, whitelist)
