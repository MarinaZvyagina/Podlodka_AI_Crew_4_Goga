diff --git a/changelog/69921.added.md b/changelog/69921.added.md
new file mode 100644
index 0000000..031a9d7
--- /dev/null
+++ b/changelog/69921.added.md
@@ -0,0 +1,5 @@
+Added a ``low`` threshold to the ``diskusage`` beacon so it can also alert when a
+mount's usage drops below an expected level, which typically means the
+filesystem failed to mount. Configure it with ``high``/``low`` keys instead of a
+bare percentage, e.g. ``/mnt/nfs: {high: 50%, low: 5%}``; existing bare-percentage
+configuration continues to work unchanged.
diff --git a/salt/beacons/diskusage.py b/salt/beacons/diskusage.py
