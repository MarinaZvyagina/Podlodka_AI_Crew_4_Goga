index 0000000..ee17b42
--- /dev/null
+++ b/changelog/69890.added.md
@@ -0,0 +1 @@
+Added ``min``/``max`` mapping support to the ``diskusage`` beacon, so a mount can alert both when usage rises above a threshold (``max``, matching the existing plain-percentage behavior) and when it unexpectedly drops below one (``min``) — e.g. when a mount silently failed to mount. Existing plain-percentage configuration is unaffected.
diff --git a/salt/beacons/diskusage.py b/salt/beacons/diskusage.py
index da904cf..cc034fe 100644
--- a/salt/beacons/diskusage.py
+++ b/salt/beacons/diskusage.py
@@ -40,6 +40,15 @@ def validate(config):
     # Configuration for diskusage beacon should be a list of dicts
     if not isinstance(config, list):
         return False, "Configuration for diskusage beacon must be a list."
+
+    for mounts in config:
+        for threshold in mounts.values():
+            if isinstance(threshold, dict) and not {"min", "max"} & set(threshold):
+                return (
+                    False,
+                    "Configuration for diskusage beacon: mapping thresholds must"
+                    " contain a 'min' and/or 'max' key.",
+                )
     return True, "Valid beacon configuration"
 
 
@@ -83,6 +92,28 @@ def beacon(config):
     which means that if a regular expression matches another defined mount point,
     it will override the previously defined threshold.
 
+    A mount can also be configured with a mapping of ``min`` and/or ``max``
+    thresholds instead of a plain percentage. ``max`` behaves exactly like the
+    plain percentage form above: it alerts when usage is at or above the given
+    value. ``min`` alerts when usage drops *below* the given value, which is
+    useful for catching a mount that silently failed to mount (so what looks
+    like the real filesystem is actually an emptyish directory on the root
+    filesystem) rather than being genuinely low on data.
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /mnt/nfs:
+                min: 15%
+                max: 90%
+            - /mnt/backup:
+                min: 5%
+
+    ``min`` and ``max`` can be used together, or either one on its own, and are
+    independent of the plain-percentage form so both styles of alert can be
+    configured for the same or different mounts.
+
     """
     whitelist = []
     config = salt.utils.beacons.remove_hidden_options(config, whitelist)
