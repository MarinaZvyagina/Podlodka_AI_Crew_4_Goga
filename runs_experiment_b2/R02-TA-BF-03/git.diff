+            max_usage = thresholds
+
+        if isinstance(min_usage, str):
+            min_usage = re.sub("%", "", min_usage)
+        if isinstance(max_usage, str):
+            max_usage = re.sub("%", "", max_usage)
+        if min_usage is not None:
+            min_usage = float(min_usage)
+        if max_usage is not None:
+            max_usage = float(max_usage)
 
         # Because we're using regular expressions
         # if our mount doesn't end with a $, insert one.
