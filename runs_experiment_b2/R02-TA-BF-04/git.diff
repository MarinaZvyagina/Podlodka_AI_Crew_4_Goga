new file mode 100644
index 0000000..742fb43
--- /dev/null
+++ b/changelog/69890.added.md
@@ -0,0 +1,5 @@
+Added a ``low`` usage threshold to the ``diskusage`` beacon so it can alert when a mount's
+usage unexpectedly drops (often a sign the filesystem failed to mount), alongside the existing
+``high`` threshold. A mount's value can now be a mapping of ``high``/``low`` percentages instead
+of a bare percentage; existing bare-percentage configuration is unaffected and keeps alerting
+exactly as before.
diff --git a/salt/beacons/diskusage.py b/salt/beacons/diskusage.py
index da904cf..e3d418c 100644
--- a/salt/beacons/diskusage.py
+++ b/salt/beacons/diskusage.py
@@ -40,9 +40,46 @@ def validate(config):
     # Configuration for diskusage beacon should be a list of dicts
     if not isinstance(config, list):
         return False, "Configuration for diskusage beacon must be a list."
+
+    whitelist = []
+    for mounts in salt.utils.beacons.remove_hidden_options(list(config), whitelist):
+        if not mounts:
+            continue
+        mount = next(iter(mounts))
+        mount_config = mounts[mount]
+        if isinstance(mount_config, dict):
+            if "high" not in mount_config and "low" not in mount_config:
+                return (
+                    False,
+                    "Configuration for diskusage beacon mount {} must include "
+                    "'high' and/or 'low'.".format(mount),
+                )
     return True, "Valid beacon configuration"
 
 
+def _to_percent(value):
+    if isinstance(value, str) and "%" in value:
+        value = value.replace("%", "")
+    return float(value)
+
+
+def _high_low_thresholds(mount_config):
+    """
+    Return a (high, low) tuple of percentage thresholds for a mount's
+    configured value. A bare percentage is the historical format and is
+    treated as a high-usage threshold only, so existing configuration keeps
+    alerting exactly as it does today.
+    """
+    if isinstance(mount_config, dict):
+        high = mount_config.get("high")
+        low = mount_config.get("low")
+        return (
+            _to_percent(high) if high is not None else None,
+            _to_percent(low) if low is not None else None,
+        )
+    return _to_percent(mount_config), None
+
+
