diff --git a/changelog/68221.added.md b/changelog/68221.added.md
new file mode 100644
index 0000000..80f0e99
--- /dev/null
+++ b/changelog/68221.added.md
@@ -0,0 +1,6 @@
+Added support for a low-usage ("dropped below expected") alert to the
+``diskusage`` beacon. A mount can now be configured with ``min``/``max``
+thresholds instead of a single percentage, so an alert also fires when
+usage on a normally busy mount unexpectedly drops, which is usually a sign
+the filesystem failed to mount. Existing single-percentage configuration
+keeps working unchanged.
diff --git a/salt/beacons/diskusage.py b/salt/beacons/diskusage.py
index da904cf..9269689 100644
--- a/salt/beacons/diskusage.py
+++ b/salt/beacons/diskusage.py
@@ -43,6 +43,15 @@ def validate(config):
     return True, "Valid beacon configuration"
 
 
+def _to_percent(value):
+    """
+    Normalize a threshold value (e.g. ``"63%"`` or ``63``) to a float.
+    """
+    if isinstance(value, str) and "%" in value:
+        value = re.sub("%", "", value)
+    return float(value)
+
+
 def beacon(config):
     r"""
     Monitor the disk usage of the minion
@@ -83,6 +92,25 @@ def beacon(config):
     which means that if a regular expression matches another defined mount point,
     it will override the previously defined threshold.
 
+    A mount can also be given a ``min`` and/or ``max`` threshold, in which case a
+    beacon is emitted when usage rises to/above ``max`` (same behavior as the
+    plain percentage form above) and/or when it drops below ``min``. The latter
+    is useful to catch a mount that normally runs busy suddenly reporting very
+    low usage, which in practice is almost always a sign that the filesystem
+    failed to mount rather than that space was genuinely freed up.
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /mnt/nfs:
+                min: 15%
+                max: 90%
+
+    ``min`` and ``max`` can each be used on their own, so a mount can be
+    watched for a drop in usage without also configuring a high-usage
+    threshold.
+
     """
     whitelist = []
     config = salt.utils.beacons.remove_hidden_options(config, whitelist)
