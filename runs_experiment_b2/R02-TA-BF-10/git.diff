+def test_minimum_threshold_dict_config():
+    config = [{"/": {"minimum": "5%"}}]
+
+    ret = diskusage.validate(config)
+    assert ret == (True, "Valid beacon configuration")
+
+
+def test_minimum_and_maximum_threshold_dict_config():
+    config = [{"/": {"minimum": "5%", "maximum": "80%"}}]
+
+    ret = diskusage.validate(config)
+    assert ret == (True, "Valid beacon configuration")
+
+
+def test_threshold_dict_config_unknown_key():
+    config = [{"/": {"minimum": "5%", "bogus": "1%"}}]
+
+    ret = diskusage.validate(config)
+    assert ret == (
+        False,
+        "Configuration for diskusage beacon mount '/' contains unknown "
+        "threshold(s): bogus.",
+    )
+
+
+def test_threshold_dict_config_empty():
+    config = [{"/": {}}]
+
+    ret = diskusage.validate(config)
+    assert ret == (
+        False,
+        "Configuration for diskusage beacon mount '/' must specify a "
+        "'minimum' and/or 'maximum' threshold.",
+    )
+
+
+def test_diskusage_minimum_match(stub_disk_usage, stub_disk_partition):
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        # stub_disk_usage reports 50% used for "/"
+        config = [{"/": {"minimum": "60%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == [{"diskusage": 50, "mount": "/", "tag": "low"}]
+
+
+def test_diskusage_minimum_nomatch(stub_disk_usage, stub_disk_partition):
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        # stub_disk_usage reports 50% used for "/"
+        config = [{"/": {"minimum": "10%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == []
+
+
+def test_diskusage_minimum_and_maximum_both_fire(stub_disk_usage, stub_disk_partition):
+    disk_usage_mock = Mock(side_effect=stub_disk_usage)
+    with patch("salt.utils.platform.is_windows", MagicMock(return_value=False)), patch(
+        "psutil.disk_partitions", MagicMock(return_value=stub_disk_partition)
+    ), patch("psutil.disk_usage", disk_usage_mock):
+        # stub_disk_usage reports 50% used for "/"
+        config = [{"/": {"minimum": "60%", "maximum": "40%"}}]
+
+        ret = diskusage.validate(config)
+        assert ret == (True, "Valid beacon configuration")
+
+        ret = diskusage.beacon(config)
+        assert ret == [
+            {"diskusage": 50, "mount": "/"},
+            {"diskusage": 50, "mount": "/", "tag": "low"},
+        ]
+
