+def test_status_beacons_preserved_across_refresh(minion_opts):
+    """
+    Test that beacon_status can be threaded into a new Beacon instance, the
+    way minion.py's beacons_refresh() preserves interval_map, so history
+    survives a beacon config refresh instead of being wiped out.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    refreshed = salt.beacons.Beacon(minion_opts, [], status_map=beacon.beacon_status)
+
+    assert refreshed.beacon_status == beacon.beacon_status
