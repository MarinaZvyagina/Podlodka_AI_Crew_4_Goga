+def test_status_beacons_reports_never_run(minion_opts):
+    """
+    Test that status_beacons() clearly reports last_run/last_error as None
+    for a beacon that is configured but has not fired yet, rather than a
+    stale or made-up value.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+    beacon = salt.beacons.Beacon(minion_opts, [])
+
+    fire_event_mock = MagicMock()
+    with patch("salt.utils.event.get_event") as get_event_mock:
+        get_event_mock.return_value.__enter__.return_value.fire_event = (
+            fire_event_mock
+        )
+        beacon.status_beacons()
+
+    fire_event_mock.assert_called_once_with(
+        {
+            "complete": True,
+            "beacons": {"watch_apache": {"last_run": None, "last_error": None}},
+        },
+        tag="/salt/minion/minion_beacons_status_complete",
+    )
+
