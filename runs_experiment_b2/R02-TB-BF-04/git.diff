+def test_beacon_status_tracks_successful_run(minion_opts):
+    """
+    Test that process() records a last_run timestamp and no error for a
+    beacon that executed successfully.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    assert "watch_apache" not in beacon.beacon_status
+
+    before = time.time()
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+    after = time.time()
+
+    status = beacon.beacon_status["watch_apache"]
+    assert status["last_error"] is None
+    assert before <= status["last_run"] <= after
+
+
+def test_beacon_status_tracks_failed_run(minion_opts):
+    """
+    Test that process() records the error raised by a beacon that failed,
+    keyed by the configured beacon name rather than the beacon_module.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+    beacon_mock = MagicMock(side_effect=Exception("Global Thermonuclear War"))
+    beacon_mock.__globals__ = {}
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.beacons["ps.beacon"] = beacon_mock
+
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    status = beacon.beacon_status["watch_apache"]
+    assert status["last_error"] == "Global Thermonuclear War"
+    assert status["last_run"] is not None
+
