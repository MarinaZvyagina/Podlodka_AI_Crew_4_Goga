+def status(name=None, **kwargs):
+    """
+    Return when each configured beacon last actually ran and whether that
+    run produced an error. This reflects live beacon activity as tracked by
+    the running minion process, not log data, so it is accurate immediately
+    after a beacon fires rather than only after a subsequent probe cycle.
+
+    A beacon that is configured but has not fired yet is reported with
+    ``last_run`` set to ``None``, rather than a stale or made-up value.
+
+    :param name:            Name of a single beacon to check. If omitted,
+                             the status of all currently configured beacons
+                             is returned.
+    :return:                Dictionary keyed by beacon name, each mapping to
+                             a dictionary with ``last_run`` (epoch time of
+                             the most recent execution, or ``None`` if the
+                             beacon has never run) and ``last_error`` (the
+                             error raised by the most recent execution, or
+                             ``None`` if it did not error or has never run).
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+
+        salt '*' beacons.status ps
+
+    """
+    status_ = None
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {"func": "status", "name": name}, "manage_beacons"
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacons_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                if event_ret and event_ret["complete"]:
+                    status_ = event_ret["beacons"]
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+        return ret
+
+    return status_ if status_ is not None else {}
+
+
