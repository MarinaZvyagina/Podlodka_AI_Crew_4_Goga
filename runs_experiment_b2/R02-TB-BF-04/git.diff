+def test_status_beacons_reports_last_run_and_error(minion_opts):
+    """
+    Test that status_beacons() reports the tracked last_run/last_error for
+    a beacon that has actually executed, and can be filtered by name.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    fire_event_mock = MagicMock()
+    with patch("salt.utils.event.get_event") as get_event_mock:
+        get_event_mock.return_value.__enter__.return_value.fire_event = (
+            fire_event_mock
+        )
+        beacon.status_beacons(name="watch_apache")
+
+    (event_data,), kwargs = fire_event_mock.call_args
+    assert kwargs["tag"] == "/salt/minion/minion_beacons_status_complete"
+    assert event_data["complete"] is True
+    assert list(event_data["beacons"]) == ["watch_apache"]
+    assert event_data["beacons"]["watch_apache"]["last_error"] is None
+    assert event_data["beacons"]["watch_apache"]["last_run"] is not None
+
