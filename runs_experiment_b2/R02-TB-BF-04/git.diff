+    def status_beacons(self, name=None):
+        """
+        Return the last run time and error status of configured beacons,
+        reflecting live in-memory state rather than log data, so it is
+        accurate as of the most recent time each beacon actually fired.
+
+        name: Return the status for a single named beacon, or all
+              configured beacons when not specified.
+        """
+        beacons = self._get_beacons()
+        status = {}
+        for mod in beacons:
+            if mod == "enabled":
+                continue
+            if name and mod != name:
+                continue
+            entry = self.beacon_status.get(mod)
+            if entry is None:
+                # The beacon is configured but has not fired yet.
+                status[mod] = {"last_run": None, "last_error": None}
+            else:
+                status[mod] = dict(entry)
+
+        # Fire the complete event back along with the beacon status
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacons": status},
+                tag="/salt/minion/minion_beacons_status_complete",
+            )
+
+        return True
