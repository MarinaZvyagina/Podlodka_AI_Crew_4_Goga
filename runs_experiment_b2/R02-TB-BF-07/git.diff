+def test_beacon_process_records_status_on_success(minion_opts):
+    """
+    Test that process() records a last_run timestamp and no error
+    for a beacon that fired successfully.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    status = beacon.beacon_status["watch_apache"]
+    assert isinstance(status["last_run"], datetime.datetime)
+    assert status["last_error"] is None
+
+
+def test_beacon_process_records_status_on_error(minion_opts):
+    """
+    Test that process() records a last_run timestamp and the error
+    message for a beacon whose execution raised an exception.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+    beacon_mock = MagicMock(side_effect=Exception("Global Thermonuclear War"))
+    beacon_mock.__globals__ = {}
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.beacons["ps.beacon"] = beacon_mock
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    status = beacon.beacon_status["watch_apache"]
+    assert isinstance(status["last_run"], datetime.datetime)
+    assert status["last_error"] == "Global Thermonuclear War"
+
+
+def test_list_beacons_status(minion_opts):
+    """
+    Test that list_beacons_status() reports a formatted last_run/last_error
+    for a beacon that has fired, and explicit Nones for a beacon that is
+    configured but has not fired yet.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ],
+        "never_fired": [{"something": True}],
+    }
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    with patch("salt.utils.event.get_event") as get_event_mock:
+        evt_mock = get_event_mock.return_value.__enter__.return_value
+        result = beacon.list_beacons_status()
+
+    assert result is True
+    evt_mock.fire_event.assert_called_once()
+    args, kwargs = evt_mock.fire_event.call_args
+    assert kwargs["tag"] == "/salt/minion/minion_beacons_status_complete"
+    payload = args[0]
+    assert payload["complete"] is True
+
+    status = payload["beacons"]
+    assert status["never_fired"] == {"last_run": None, "last_error": None}
+    assert status["watch_apache"]["last_error"] is None
+    assert isinstance(status["watch_apache"]["last_run"], str)
+
