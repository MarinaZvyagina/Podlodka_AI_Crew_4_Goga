+def status(return_yaml=True, **kwargs):
+    """
+    Return the last run time and last error, if any, for each of the
+    beacons currently configured on the minion. This reflects live beacon
+    activity as tracked in memory by the running minion: it does not wait
+    for a new probe cycle, does not read log files, and does not require
+    restarting the minion or touching the beacon configuration.
+
+    A beacon that is configured but has not fired yet is reported with a
+    ``last_run`` of ``None``.
+
+    :param return_yaml:    Whether to return YAML formatted output,
+                           default ``True``
+
+    :return:               Dictionary of beacon names mapped to their
+                           last run time and last error.
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+
+    """
+    beacons_status = None
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"]({"func": "status"}, "manage_beacons")
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacons_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                log.debug("event_ret %s", event_ret)
+                if event_ret and event_ret["complete"]:
+                    beacons_status = event_ret["beacons"]
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+        return ret
+
+    if return_yaml:
+        tmp = {"beacons": beacons_status}
+        return salt.utils.yaml.safe_dump(tmp, default_flow_style=False)
+    else:
+        return beacons_status
+
+
