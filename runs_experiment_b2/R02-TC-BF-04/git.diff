@@ -0,0 +1,281 @@
+"""
+Cache data in a single SQLite database file.
+
+.. versionadded:: 3009.0
+
+``sqlite3`` is a drop-in replacement for the ``localfs`` cache backend that
+keeps every bank/key entry as a row in one on-disk SQLite database instead of
+one file per entry. It requires nothing beyond the Python standard library
+(the :mod:`sqlite3` module), so it is a convenient way to get durable,
+survives-a-restart caching on a small, single-node master without standing up
+Redis, MySQL, or another external service.
+
+Configuration (all optional, can be set in ``/etc/salt/master``):
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+    # Path to the database file. Defaults to <cachedir>/cache.sqlite3
+    cache.sqlite3.database: /var/cache/salt/master/cache.sqlite3
+
+    # Seconds to wait on a locked database before giving up (maps to the
+    # sqlite3 connection's busy timeout).
+    cache.sqlite3.timeout: 5.0
+
+One connection to the database file is opened per process and reused for the
+life of the process; the database is created (and its table/index added) on
+first use if it does not already exist. Because the data lives in an ordinary
+file on disk, it survives a restart of the master process the same way the
+default ``localfs`` backend does.
+"""
+
+import logging
+import os
+import sqlite3
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+import salt.utils.path
+from salt.exceptions import SaltCacheError
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+_TABLE = "cache"
+
+
+def __virtual__():
+    """
+    Always available: the sqlite3 module ships with the Python standard
+    library. Declared so the loader honors ``__virtualname__`` and exposes
+    this driver as ``sqlite3`` (its filename is ``sqlite3_cache`` to avoid
+    shadowing the standard library's own ``sqlite3`` module on import).
+    """
+    return __virtualname__
+
+
+def __cachedir(kwargs=None):
+    if kwargs and "cachedir" in kwargs:
+        return kwargs["cachedir"]
+    return __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+
+
+def init_kwargs(kwargs):
+    """
+    Return the canonical keyword arguments for this cache driver.
+    """
+    return {"cachedir": __cachedir(kwargs)}
+
+
+def get_storage_id(kwargs):
+    """
+    Return a unique identifier for this cache driver instance.
+    """
+    return ("sqlite3", _database_path(kwargs))
+
+
+def _database_path(kwargs=None):
+    configured = __opts__.get("cache.sqlite3.database")
+    if configured:
+        return configured
+    return salt.utils.path.join(__cachedir(kwargs), "cache.sqlite3")
+
+
+def _connection(kwargs=None):
+    """
+    Return the ``(connection, lock)`` pair for this database file, opening
+    and initializing it on first use. One pair is kept per database path for
+    the life of the process (stashed on ``__context__``) so repeated cache
+    operations reuse a single connection rather than reopening the file each
+    time. The lock serializes access to that connection across threads
+    within this process; cross-process access is handled by SQLite's own
+    file locking, backstopped by the busy timeout below.
+    """
+    path = _database_path(kwargs)
+    registry = __context__.setdefault("sqlite3_cache", {})
+    entry = registry.get(path)
+    if entry is not None:
+        return entry
+
+    dirname = os.path.dirname(path)
+    if dirname:
+        try:
+            os.makedirs(dirname, exist_ok=True)
+        except OSError as exc:
+            raise SaltCacheError(
+                f"The cache directory, {dirname}, could not be created: {exc}"
+            )
+
+    timeout = __opts__.get("cache.sqlite3.timeout", 5.0)
+    try:
+        conn = sqlite3.connect(path, timeout=timeout, check_same_thread=False)
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute(
+            f"CREATE TABLE IF NOT EXISTS {_TABLE} ("
+            "bank TEXT NOT NULL, "
+            "key TEXT NOT NULL, "
+            "data BLOB NOT NULL, "
+            "last_update REAL NOT NULL, "
+            "PRIMARY KEY (bank, key))"
+        )
+        conn.commit()
+    except sqlite3.Error as exc:
+        raise SaltCacheError(f'There was an error opening the cache database "{path}": {exc}')
+
+    entry = (conn, threading.RLock())
+    registry[path] = entry
+    return entry
+
+
+def _escape_like(value):
+    return value.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+
+
+def store(bank, key, data, cachedir=None):
+    """
+    Store information in the database.
+    """
+    conn, lock = _connection({"cachedir": cachedir} if cachedir else None)
+    raw = salt.payload.dumps(data)
+    with lock:
+        try:
+            conn.execute(
+                f"INSERT OR REPLACE INTO {_TABLE} "
+                "(bank, key, data, last_update) VALUES (?, ?, ?, ?)",
+                (bank, key, raw, time.time()),
+            )
+            conn.commit()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f'There was an error writing the cache entry "{bank}/{key}": {exc}'
+            )
+
+
+def fetch(bank, key, cachedir=None):
+    """
+    Fetch information from the database.
+    """
+    conn, lock = _connection({"cachedir": cachedir} if cachedir else None)
+    with lock:
+        try:
+            row = conn.execute(
+                f"SELECT data FROM {_TABLE} WHERE bank=? AND key=?", (bank, key)
+            ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f'There was an error reading the cache entry "{bank}/{key}": {exc}'
+            )
+    if row is None:
+        return {}
+    return salt.payload.loads(row[0])
+
+
+def updated(bank, key, cachedir=None):
+    """
+    Return the epoch of the last update for this cache entry.
+    """
+    conn, lock = _connection({"cachedir": cachedir} if cachedir else None)
+    with lock:
+        try:
+            row = conn.execute(
+                f"SELECT last_update FROM {_TABLE} WHERE bank=? AND key=?", (bank, key)
+            ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f'There was an error reading the update time for "{bank}/{key}": {exc}'
+            )
+    if row is None:
+        return None
+    return int(row[0])
+
+
+def flush(bank, key=None, cachedir=None):
+    """
+    Remove the key from the cache bank with all the key content, or the
+    entire bank (and any sub-banks nested under it) when ``key`` is omitted.
+    """
+    conn, lock = _connection({"cachedir": cachedir} if cachedir else None)
+    with lock:
+        try:
+            if key is None:
+                prefix = _escape_like(bank) + "/%"
+                cur = conn.execute(
+                    f"SELECT COUNT(*) FROM {_TABLE} WHERE bank=? OR bank LIKE ? ESCAPE '\\'",
+                    (bank, prefix),
+                )
+                if not cur.fetchone()[0]:
+                    return False
+                conn.execute(
+                    f"DELETE FROM {_TABLE} WHERE bank=? OR bank LIKE ? ESCAPE '\\'",
+                    (bank, prefix),
+                )
+            else:
+                cur = conn.execute(
+                    f"SELECT COUNT(*) FROM {_TABLE} WHERE bank=? AND key=?", (bank, key)
+                )
+                if not cur.fetchone()[0]:
+                    return False
+                conn.execute(
+                    f"DELETE FROM {_TABLE} WHERE bank=? AND key=?", (bank, key)
+                )
+            conn.commit()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f'There was an error removing "{bank}/{key}": {exc}')
+    return True
+
+
+def list_(bank, cachedir=None):
+    """
+    Return an iterable object containing all entries and immediate
+    sub-banks stored directly under the specified bank.
+    """
+    conn, lock = _connection({"cachedir": cachedir} if cachedir else None)
+    with lock:
+        try:
+            keys = [
+                row[0]
+                for row in conn.execute(
+                    f"SELECT DISTINCT key FROM {_TABLE} WHERE bank=?", (bank,)
+                )
+            ]
+            prefix = _escape_like(bank) + "/%"
+            sub_rows = conn.execute(
+                f"SELECT DISTINCT bank FROM {_TABLE} WHERE bank LIKE ? ESCAPE '\\'",
+                (prefix,),
+            )
+            skip = len(bank) + 1
+            sub_banks = {row[0][skip:].split("/", 1)[0] for row in sub_rows}
+        except sqlite3.Error as exc:
+            raise SaltCacheError(f'There was an error listing bank "{bank}": {exc}')
+    return keys + sorted(sub_banks)
+
+
+def contains(bank, key=None, cachedir=None):
+    """
+    Checks if the specified bank contains the specified key. If ``key`` is
+    omitted, checks whether the bank itself (including nested sub-banks)
+    exists.
+    """
+    conn, lock = _connection({"cachedir": cachedir} if cachedir else None)
+    with lock:
+        try:
+            if key is None:
+                prefix = _escape_like(bank) + "/%"
+                row = conn.execute(
+                    f"SELECT 1 FROM {_TABLE} WHERE bank=? OR bank LIKE ? ESCAPE '\\' LIMIT 1",
+                    (bank, prefix),
+                ).fetchone()
+            else:
+                row = conn.execute(
+                    f"SELECT 1 FROM {_TABLE} WHERE bank=? AND key=? LIMIT 1", (bank, key)
+                ).fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f'There was an error checking for "{bank}/{key}": {exc}'
+            )
+    return row is not None
