@@ -0,0 +1,108 @@
+"""
+Unit tests for the sqlite3_cache cache driver.
+"""
+
+import os
+
+import pytest
+
+import salt.cache.sqlite3_cache as sqlite3_cache
+from salt.exceptions import SaltCacheError
+from tests.support.mock import patch
+
+
+@pytest.fixture
+def configure_loader_modules():
+    return {sqlite3_cache: {}}
+
+
+@pytest.fixture(autouse=True)
+def _close_connections():
+    yield
+    registry = sqlite3_cache.__context__.pop("sqlite3_cache", {})
+    for conn, _lock in registry.values():
+        conn.close()
+
+
+def test_default_database_path(tmp_path):
+    """The database defaults to cache.sqlite3 under cachedir."""
+    cachedir = str(tmp_path)
+    path = sqlite3_cache._database_path({"cachedir": cachedir})
+    assert path == os.path.join(cachedir, "cache.sqlite3")
+
+
+def test_database_path_override(tmp_path):
+    """cache.sqlite3.database overrides the default location."""
+    override = str(tmp_path / "custom" / "salt.db")
+    with patch.dict(sqlite3_cache.__opts__, {"cache.sqlite3.database": override}):
+        assert sqlite3_cache._database_path({"cachedir": str(tmp_path)}) == override
+
+
+def test_creates_database_file(tmp_path):
+    """Storing a value creates the sqlite3 database file on disk."""
+    cachedir = str(tmp_path)
+    db_path = os.path.join(cachedir, "cache.sqlite3")
+    assert not os.path.exists(db_path)
+    sqlite3_cache.store(bank="bank", key="key", data={"a": 1}, cachedir=cachedir)
+    assert os.path.exists(db_path)
+
+
+def test_data_survives_reconnect(tmp_path):
+    """
+    Data written by one connection is visible from a fresh connection opened
+    afterward, simulating data surviving a master restart.
+    """
+    cachedir = str(tmp_path)
+    sqlite3_cache.store(bank="minions/alpha", key="data", data={"os": "linux"}, cachedir=cachedir)
+
+    # Simulate a restart: drop the cached connection and reopen the file.
+    registry = sqlite3_cache.__context__.pop("sqlite3_cache", {})
+    for conn, _lock in registry.values():
+        conn.close()
+
+    result = sqlite3_cache.fetch(bank="minions/alpha", key="data", cachedir=cachedir)
+    assert result == {"os": "linux"}
+
+
+def test_list_returns_immediate_subbanks(tmp_path):
+    """list() on a parent bank returns immediate sub-bank names, like localfs."""
+    cachedir = str(tmp_path)
+    sqlite3_cache.store(bank="minions/alpha", key="data", data={}, cachedir=cachedir)
+    sqlite3_cache.store(bank="minions/beta", key="data", data={}, cachedir=cachedir)
+    assert set(sqlite3_cache.list_(bank="minions", cachedir=cachedir)) == {"alpha", "beta"}
+
+
+def test_flush_bank_removes_subbanks(tmp_path):
+    """Flushing a bank with no key removes nested sub-banks too."""
+    cachedir = str(tmp_path)
+    sqlite3_cache.store(bank="minions/alpha", key="data", data={}, cachedir=cachedir)
+    sqlite3_cache.store(bank="minions/beta", key="data", data={}, cachedir=cachedir)
+    assert sqlite3_cache.flush(bank="minions", cachedir=cachedir) is True
+    assert sqlite3_cache.list_(bank="minions", cachedir=cachedir) == []
+    assert sqlite3_cache.fetch(bank="minions/alpha", key="data", cachedir=cachedir) == {}
+
+
+def test_bank_names_with_like_wildcards_are_escaped(tmp_path):
+    """Bank names containing SQL LIKE wildcard characters do not leak matches."""
+    cachedir = str(tmp_path)
+    sqlite3_cache.store(bank="weird_bank", key="k1", data={"v": 1}, cachedir=cachedir)
+    sqlite3_cache.store(bank="weirdXbank", key="k2", data={"v": 2}, cachedir=cachedir)
+    # "weird_bank" as a sub-bank prefix should not match "weirdXbank" even
+    # though "_" is a single-character LIKE wildcard.
+    assert sqlite3_cache.list_(bank="weird_bank", cachedir=cachedir) == ["k1"]
+    assert sqlite3_cache.contains(bank="weirdXbank", key=None, cachedir=cachedir) is True
+    assert sqlite3_cache.flush(bank="weird_bank", cachedir=cachedir) is True
+    assert sqlite3_cache.fetch(bank="weirdXbank", key="k2", cachedir=cachedir) == {"v": 2}
+
+
+def test_store_error_wrapped(tmp_path):
+    """A sqlite3 error during store is raised as SaltCacheError."""
+    cachedir = str(tmp_path)
+    sqlite3_cache.store(bank="bank", key="key", data={}, cachedir=cachedir)
+    conn, _lock = sqlite3_cache._connection({"cachedir": cachedir})
+    # Closing the underlying connection out from under the driver forces the
+    # next statement to fail with a real sqlite3.Error, exercising the
+    # SaltCacheError-wrapping path without needing to mock a C-level slot.
+    conn.close()
+    with pytest.raises(SaltCacheError):
+        sqlite3_cache.store(bank="bank", key="key", data={}, cachedir=cachedir)
