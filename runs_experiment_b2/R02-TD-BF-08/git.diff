diff --git a/changelog/70135.changed.md b/changelog/70135.changed.md
new file mode 100644
index 0000000..fc3752f
--- /dev/null
+++ b/changelog/70135.changed.md
@@ -0,0 +1,4 @@
+``disk.usage`` now caches its result in ``__context__`` per set of ``df`` flags, so repeated
+calls within the same Salt run (e.g. checking free space before and after a large file
+operation) no longer re-run and re-parse ``df`` each time. The cache is scoped the same way
+other ``__context__`` data is: it does not persist into a later, independent Salt run.
diff --git a/salt/modules/disk.py b/salt/modules/disk.py
index f766769..a5ff1e5 100644
--- a/salt/modules/disk.py
+++ b/salt/modules/disk.py
@@ -87,6 +87,12 @@ def usage(args=None):
 
         Default for SunOS changed to 1 kilobyte blocks
 
+    .. versionchanged:: 3008.0
+
+        Repeated calls with the same ``args`` during the same Salt run are
+        served from ``__context__`` instead of re-running ``df``. The cache
+        does not persist across separate Salt runs.
+
     CLI Example:
 
     .. code-block:: bash
@@ -94,6 +100,9 @@ def usage(args=None):
         salt '*' disk.usage
     """
     flags = _clean_flags(args, "disk.usage")
+    cache_key = f"disk.usage.{flags}"
+    if cache_key in __context__:
+        return __context__[cache_key]
     if not os.path.isfile("/etc/mtab") and __grains__["kernel"] == "Linux":
         log.error("df cannot run without /etc/mtab")
         if __grains__.get("virtual_subtype") == "LXC":
@@ -157,6 +166,7 @@ def usage(args=None):
         except IndexError:
             log.error("Problem parsing disk usage information")
             ret = {}
+    __context__[cache_key] = ret
     return ret
 
 
