 @pytest.fixture
 def configure_loader_modules():
-    return {disk: {}}
+    return {disk: {"__context__": {}}}
 
 
 def test_usage_dict(stub_disk_usage):
@@ -162,6 +162,33 @@ def test_usage_none():
             assert "" == disk.usage(args=None)
 
 
+def test_usage_caches_result_in_context():
+    df_output = (
+        "Filesystem     1K-blocks    Used Available Capacity Mounted on\n"
+        "/dev/sda1        10000       5000      5000       50% /"
+    )
+    mock_cmd = MagicMock(return_value=df_output)
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch.dict(
+        disk.__salt__, {"cmd.run": mock_cmd}
+    ), patch.dict(disk.__context__, {}, clear=True), patch(
+        "os.path.isfile", MagicMock(return_value=True)
+    ):
+        first = disk.usage()
+        second = disk.usage()
+        assert first == second
+        mock_cmd.assert_called_once()
+
+        # A different set of flags is a cache miss, not a hit.
+        disk.usage(args="h")
+        assert mock_cmd.call_count == 2
+
+        # A fresh __context__, as happens between independent Salt runs,
+        # forces df to be re-run instead of returning stale data.
+        disk.__context__.clear()
+        disk.usage()
+        assert mock_cmd.call_count == 3
+
+
 def test_inodeusage(stub_disk_inodeusage):
     with patch.dict(disk.__grains__, {"kernel": "OpenBSD"}), patch(
         "salt.modules.disk.inodeusage", MagicMock(return_value=stub_disk_inodeusage)
