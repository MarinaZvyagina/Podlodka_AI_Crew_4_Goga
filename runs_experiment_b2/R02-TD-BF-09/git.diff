@@ -3,6 +3,7 @@
 """
 
 import decimal
+import time
 
 import pytest
 
@@ -153,6 +154,46 @@ def test_usage_dict(stub_disk_usage):
             assert stub_disk_usage == disk.usage(args=None)
 
 
+def test_usage_caches_within_context():
+    """
+    Repeated calls with the same args, sharing a __context__ (i.e. the same
+    Salt run), should only shell out to df once.
+    """
+    out = "Filesystem 1K-blocks Used Available Capacity Mounted\n/dev/sda1 100 10 90 10% /"
+    mock_cmd = MagicMock(return_value=out)
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch(
+        "os.path.isfile", MagicMock(return_value=True)
+    ), patch.dict(disk.__opts__, {"disk_usage_cache_ttl": 60}), patch.dict(
+        disk.__salt__, {"cmd.run": mock_cmd}
+    ):
+        first = disk.usage()
+        second = disk.usage()
+        assert first == second
+        mock_cmd.assert_called_once()
+
+        # Different args are not served from the same cache entry.
+        disk.usage(args="h")
+        assert mock_cmd.call_count == 2
+
+
+def test_usage_refreshes_after_ttl_expiry():
+    """
+    A later call outside the TTL window (e.g. a separate, independent Salt
+    run) must not see a stale result left over from an earlier call.
+    """
+    out = "Filesystem 1K-blocks Used Available Capacity Mounted\n/dev/sda1 100 10 90 10% /"
+    mock_cmd = MagicMock(return_value=out)
+    with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch(
+        "os.path.isfile", MagicMock(return_value=True)
+    ), patch.dict(disk.__opts__, {"disk_usage_cache_ttl": 0.05}), patch.dict(
+        disk.__salt__, {"cmd.run": mock_cmd}
+    ):
+        disk.usage()
+        time.sleep(0.1)
+        disk.usage()
+        assert mock_cmd.call_count == 2
+
+
 def test_usage_none():
     with patch.dict(disk.__grains__, {"kernel": "Linux"}), patch(
         "salt.modules.disk.usage", MagicMock(return_value="")
