+import salt.utils.cache
 import salt.utils.decorators
 import salt.utils.decorators.path
 import salt.utils.path
@@ -87,6 +88,17 @@ def usage(args=None):
 
         Default for SunOS changed to 1 kilobyte blocks
 
+    .. versionchanged:: 3008.0
+
+        Repeated calls with the same ``args`` re-use the previous result
+        instead of re-running ``df``, for up to ``disk_usage_cache_ttl``
+        seconds (30 by default). This avoids re-running and re-parsing
+        ``df`` for every call made in quick succession over the course of a
+        single Salt run (e.g. checking free space before and after an
+        operation), while still picking up changes made since an earlier,
+        unrelated run. Set ``disk_usage_cache_ttl`` to ``0`` to always query
+        ``df`` directly.
+
     CLI Example:
 
     .. code-block:: bash
@@ -94,6 +106,14 @@ def usage(args=None):
         salt '*' disk.usage
     """
     flags = _clean_flags(args, "disk.usage")
+
+    cache = __context__.setdefault(
+        "disk.usage.cache",
+        salt.utils.cache.CacheDict(__opts__.get("disk_usage_cache_ttl", 30)),
+    )
+    if flags in cache:
+        return cache[flags]
+
     if not os.path.isfile("/etc/mtab") and __grains__["kernel"] == "Linux":
         log.error("df cannot run without /etc/mtab")
         if __grains__.get("virtual_subtype") == "LXC":
@@ -157,6 +177,7 @@ def usage(args=None):
         except IndexError:
             log.error("Problem parsing disk usage information")
             ret = {}
+    cache[flags] = ret
     return ret
 
 
diff --git a/tests/pytests/unit/modules/test_disk.py b/tests/pytests/unit/modules/test_disk.py
