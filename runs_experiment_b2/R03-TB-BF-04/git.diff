+import { SocketModule } from '../socket-module.js';
+
+describe('SocketModule', () => {
+  let socketModule: SocketModule;
+
+  beforeEach(() => {
+    socketModule = new SocketModule();
+  });
+
+  describe('close', () => {
+    it('should call "beforeClose" before "close" for every registered server', async () => {
+      const calls: string[] = [];
+      const server = {};
+      const adapter = {
+        beforeClose: vi.fn(async () => {
+          calls.push('beforeClose');
+        }),
+        close: vi.fn(async () => {
+          calls.push('close');
+        }),
+        dispose: vi.fn(async () => {}),
+      };
+      (socketModule as any).applicationConfig = {
+        getIoAdapter: () => adapter,
+      };
+      (socketModule as any).socketsContainer = {
+        getAll: () => new Map([['token', { server }]]),
+        clear: vi.fn(),
+      };
+
+      await socketModule.close();
+
+      expect(adapter.beforeClose).toHaveBeenCalledWith(server);
+      expect(adapter.close).toHaveBeenCalledWith(server);
+      expect(calls).toEqual(['beforeClose', 'close']);
+    });
+
+    it('should not fail when the adapter does not implement "beforeClose"', async () => {
+      const server = {};
+      const adapter = {
+        close: vi.fn(async () => {}),
+        dispose: vi.fn(async () => {}),
+      };
+      (socketModule as any).applicationConfig = {
+        getIoAdapter: () => adapter,
+      };
+      (socketModule as any).socketsContainer = {
+        getAll: () => new Map([['token', { server }]]),
+        clear: vi.fn(),
+      };
+
+      await socketModule.close();
+
+      expect(adapter.close).toHaveBeenCalledWith(server);
+    });
+
+    it('should do nothing when there is no adapter registered', async () => {
+      (socketModule as any).applicationConfig = {
+        getIoAdapter: () => null,
+      };
+
+      await expect(socketModule.close()).resolves.toBeUndefined();
+    });
+  });
+});
