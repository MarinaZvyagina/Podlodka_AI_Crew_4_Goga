@@ -0,0 +1,32 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('beforeClose', () => {
+    it('should send a "shutdown" message to every open client', async () => {
+      const openClient = { readyState: 1, send: vi.fn((_, cb) => cb()) };
+      const connectingClient = { readyState: 0, send: vi.fn((_, cb) => cb()) };
+      const fakeServer = { clients: new Set([openClient, connectingClient]) };
+
+      await adapter.beforeClose(fakeServer);
+
+      expect(openClient.send).toHaveBeenCalledTimes(1);
+      expect(openClient.send.mock.calls[0][0]).toEqual(
+        JSON.stringify({
+          event: 'shutdown',
+          data: { message: 'Server is shutting down' },
+        }),
+      );
+      expect(connectingClient.send).not.toHaveBeenCalled();
+    });
+
+    it('should be a no-op when the server has no clients registry', async () => {
+      await expect(adapter.beforeClose({} as any)).resolves.toBeUndefined();
+    });
+  });
+});
diff --git a/packages/websockets/adapters/CODEMANIFEST b/packages/websockets/adapters/CODEMANIFEST
new file mode 100644
index 0000000..f0b94da
--- /dev/null
+++ b/packages/websockets/adapters/CODEMANIFEST
@@ -0,0 +1,73 @@
+Annotations: |
+  Defines the abstract WebSocket-adapter contract that decouples the WebSockets
+  subsystem from any specific realtime library. Concrete platform packages
+  extend this class to bind their library's server/client objects to the
+  gateway lifecycle (connect, message, disconnect), and to the graceful
+  application-shutdown sequence.
+
+---
+
+"AbstractWsAdapter(appOrHttpServer?: INestApplicationContext | Object<string, any>)":
+  location: ws-adapter.ts
+  annotations: |
+    Abstract base class for platform WebSocket adapters. Concrete subclasses wrap
+    a specific realtime library (socket.io, ws) behind this common surface so the
+    rest of the WebSockets subsystem never depends on a particular library's API.
+
+    appOrHttpServer: either a running Nest application (its underlying HTTP
+    server is reused for the WS server) or a raw HTTP server / nothing, in which
+    case subclasses may create their own.
+
+    Algorithm:
+    1. The framework lazily instantiates the configured adapter once, the first
+       time a gateway connects
+    2. For every registered gateway server, the framework's graceful-shutdown
+       sequence first calls beforeClose(server), if implemented, to give
+       connected clients a heads-up, then calls close(server) to actually tear
+       the server down
+    3. forceCloseConnections (mirrored from the application's own option of the
+       same name) lets subclasses decide whether to wait for clients to
+       disconnect on their own or force-close them immediately
+  properties:
+    "forceCloseConnections -> boolean": |
+      Whether close should force-disconnect remaining clients immediately rather
+      than waiting for them, mirroring the same-named application option.
+  methods:
+    "bindClientConnect(server: TServer, callback: Function)": |
+      Register callback to run on every new client connection accepted by
+      server.
+    "bindClientDisconnect(client: TClient, callback: Function)": |
+      Register callback to run once, the next time client disconnects.
+    "close(server: TServer) -> result: Promise<void>": |
+      Stop server from accepting new connections and wait for it to fully shut
+      down. Base implementation calls the underlying server's own close method,
+      if any.
+    "beforeClose(server: TServer) -> result: any": |
+      Optional. Called once per server, immediately before close, as part of the
+      same graceful-shutdown sequence already triggered for the rest of the
+      application. Lets a concrete adapter notify still-connected clients that
+      the server is about to go away. Not implemented on the abstract base —
+      adapters that don't implement it are simply skipped, so this hook is
+      strictly additive and safe by default: it must not throw for a server with
+      no connected clients, and applications that never register a WebSocket
+      gateway see no change in behavior at all.
+    "dispose() -> result: Promise<void>": |
+      Release any adapter-level resources not tied to a single server (e.g. a
+      registry of HTTP servers created for path-based gateways). Base
+      implementation is a no-op.
+    "create(port: number, options: TOptions) -> server: TServer": |
+      Abstract. Create (or reuse) the underlying server instance for a gateway
+      listening on port.
+    "bindMessageHandlers(client: TClient, handlers: Array<WsMessageHandler>, transform: Function) -> result: any": |
+      Abstract. Wire each handlers entry's callback to the matching inbound
+      message event on client, passing responses through transform.
+
+---
+
+Author: Goga
+CreatedAt: 26/09/17
+Description: |
+  Documents the WebSockets adapter extension point, including the
+  graceful-shutdown notification hook (beforeClose) that lets connected
+  realtime clients be told the server is going away before their connection is
+  torn down, as part of the application's existing shutdown sequence.
