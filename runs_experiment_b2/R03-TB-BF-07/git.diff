@@ -0,0 +1,61 @@
+import { SocketModule } from '../socket-module.js';
+
+describe('SocketModule', () => {
+  describe('close', () => {
+    it('should notify each server before closing it', async () => {
+      const callOrder: string[] = [];
+      const fakeServer = {};
+      const adapter = {
+        notifyShutdown: vi.fn(() => callOrder.push('notify')),
+        close: vi.fn(async () => {
+          callOrder.push('close');
+        }),
+        dispose: vi.fn(),
+      };
+
+      const socketModule = new SocketModule();
+      (socketModule as any).applicationConfig = {
+        getIoAdapter: () => adapter,
+      };
+      (socketModule as any).socketsContainer.addOne(
+        {},
+        { server: fakeServer } as any,
+      );
+
+      await socketModule.close();
+
+      expect(adapter.notifyShutdown).toHaveBeenCalledWith(fakeServer);
+      expect(adapter.close).toHaveBeenCalledWith(fakeServer);
+      expect(callOrder).toEqual(['notify', 'close']);
+    });
+
+    it('should not throw when the adapter does not implement notifyShutdown', async () => {
+      const fakeServer = {};
+      const adapter = {
+        close: vi.fn(async () => {}),
+        dispose: vi.fn(),
+      };
+
+      const socketModule = new SocketModule();
+      (socketModule as any).applicationConfig = {
+        getIoAdapter: () => adapter,
+      };
+      (socketModule as any).socketsContainer.addOne(
+        {},
+        { server: fakeServer } as any,
+      );
+
+      await expect(socketModule.close()).resolves.not.toThrow();
+      expect(adapter.close).toHaveBeenCalledWith(fakeServer);
+    });
+
+    it('should be a no-op when no adapter has been registered', async () => {
+      const socketModule = new SocketModule();
+      (socketModule as any).applicationConfig = {
+        getIoAdapter: () => undefined,
+      };
+
+      await expect(socketModule.close()).resolves.not.toThrow();
+    });
+  });
+});
