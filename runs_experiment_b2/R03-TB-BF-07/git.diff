@@ -0,0 +1,103 @@
+import { INestApplication } from '@nestjs/common';
+import { WsAdapter } from '@nestjs/platform-ws';
+import { Test } from '@nestjs/testing';
+import { io } from 'socket.io-client';
+import WebSocket from 'ws';
+import { ApplicationGateway } from '../src/app.gateway.js';
+
+describe('WebSocket graceful shutdown', () => {
+  let app: INestApplication;
+
+  afterEach(async () => {
+    if (app) {
+      await app.close();
+    }
+  });
+
+  it('should notify connected socket.io clients before closing them on app.close()', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [ApplicationGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    await app.listen(3000);
+
+    const client = io('http://localhost:8080');
+    await new Promise<void>(resolve => client.on('connect', resolve));
+
+    const shutdownEventPromise = new Promise<any>(resolve =>
+      client.on('shutdown', resolve),
+    );
+    const disconnectPromise = new Promise<void>(resolve =>
+      client.on('disconnect', () => resolve()),
+    );
+
+    await app.close();
+    app = undefined as any;
+
+    const shutdownPayload = await shutdownEventPromise;
+    expect(shutdownPayload).toEqual(
+      expect.objectContaining({ message: expect.any(String) }),
+    );
+
+    // The shutdown notice must arrive before the connection actually closes.
+    await disconnectPromise;
+
+    client.close();
+  });
+
+  it('should not error when closing a socket.io gateway with no connected clients', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [ApplicationGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    await app.listen(3000);
+
+    await expect(app.close()).resolves.not.toThrow();
+    app = undefined as any;
+  });
+
+  it('should notify connected ws clients before closing them on app.close()', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [ApplicationGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    app.useWebSocketAdapter(new WsAdapter(app) as any);
+    await app.listen(3000);
+
+    const client = new WebSocket('ws://localhost:8080');
+    await new Promise(resolve => client.on('open', resolve));
+
+    const messages: any[] = [];
+    const closePromise = new Promise<void>(resolve =>
+      client.on('close', () => resolve()),
+    );
+    client.on('message', data => {
+      messages.push(JSON.parse(data.toString()));
+    });
+
+    await app.close();
+    app = undefined as any;
+
+    await closePromise;
+
+    expect(messages).toHaveLength(1);
+    expect(messages[0]).toEqual(
+      expect.objectContaining({
+        event: 'shutdown',
+        data: expect.objectContaining({ message: expect.any(String) }),
+      }),
+    );
+  });
+
+  it('should not error when closing a ws gateway with no connected clients', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [ApplicationGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    app.useWebSocketAdapter(new WsAdapter(app) as any);
+    await app.listen(3000);
+
+    await expect(app.close()).resolves.not.toThrow();
+    app = undefined as any;
+  });
+});
