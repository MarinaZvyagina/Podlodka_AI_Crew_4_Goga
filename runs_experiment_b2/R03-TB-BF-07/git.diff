--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,34 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('notifyShutdown', () => {
+    it('should send a shutdown message to every open client', () => {
+      const openClient = { readyState: 1, send: vi.fn() };
+      const connectingClient = { readyState: 0, send: vi.fn() };
+      const server = { clients: new Set([openClient, connectingClient]) };
+
+      adapter.notifyShutdown(server);
+
+      expect(openClient.send).toHaveBeenCalledTimes(1);
+      const payload = JSON.parse(openClient.send.mock.calls[0][0]);
+      expect(payload.event).toEqual('shutdown');
+      expect(payload.data.message).toEqual(expect.any(String));
+
+      expect(connectingClient.send).not.toHaveBeenCalled();
+    });
+
+    it('should not throw when the server has no clients', () => {
+      expect(() => adapter.notifyShutdown({} as any)).not.toThrow();
+    });
+
+    it('should not throw when the server is not defined', () => {
+      expect(() => adapter.notifyShutdown(undefined as any)).not.toThrow();
+    });
+  });
+});
