@@ -0,0 +1,18 @@
+import { SetMetadata } from '../decorators/core/index.js';
+
+export const MAINTENANCE_MODE_METADATA = '__maintenanceModeAffected__';
+
+/**
+ * Marks a controller class, a `@WebSocketGateway()` class, or an individual
+ * handler method (an HTTP route handler or a `@SubscribeMessage()` handler)
+ * as affected by maintenance mode.
+ *
+ * While maintenance mode is switched on, calls to exactly the marked
+ * targets are rejected before their logic runs. Everything else keeps
+ * working normally.
+ *
+ * @see [Guards](https://docs.nestjs.com/guards)
+ *
+ * @publicApi
+ */
+export const Maintenance = () => SetMetadata(MAINTENANCE_MODE_METADATA, true);
diff --git a/packages/common/maintenance/maintenance-mode.service.ts b/packages/common/maintenance/maintenance-mode.service.ts
new file mode 100644
index 0000000..ea23345
--- /dev/null
+++ b/packages/common/maintenance/maintenance-mode.service.ts
@@ -0,0 +1,32 @@
+import { Injectable } from '../decorators/core/index.js';
+
+/**
+ * Holds the single runtime maintenance-mode flag for the application.
+ *
+ * Register it once (the default singleton provider scope) so the same
+ * instance can be toggled from within the running application — e.g. from
+ * an admin controller or an internal script — and read by
+ * `MaintenanceModeGuard` without requiring a redeploy.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private _enabled = false;
+
+  get enabled(): boolean {
+    return this._enabled;
+  }
+
+  enable(): void {
+    this._enabled = true;
+  }
+
+  disable(): void {
+    this._enabled = false;
+  }
+
+  isEnabled(): boolean {
+    return this._enabled;
+  }
+}
