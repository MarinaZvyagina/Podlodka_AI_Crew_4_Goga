new file mode 100644
index 0000000..d57e095
--- /dev/null
+++ b/packages/core/maintenance/maintenance-mode.guard.ts
@@ -0,0 +1,41 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  MAINTENANCE_MODE_METADATA,
+  MaintenanceModeService,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '../services/reflector.service.js';
+
+/**
+ * Rejects calls to handlers marked with `@Maintenance()` while maintenance
+ * mode is switched on, before their own logic runs.
+ *
+ * Registering this one guard (e.g. as an `APP_GUARD`, or via `@UseGuards()`
+ * on a controller/gateway) protects both HTTP route handlers and WebSocket
+ * `@SubscribeMessage()` handlers identically — guards are transport-agnostic,
+ * evaluated the same way by `packages/core/router` and `packages/websockets`.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    const isAffected = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_MODE_METADATA,
+      [context.getHandler(), context.getClass()],
+    );
+    if (!isAffected || !this.maintenanceModeService.isEnabled()) {
+      return true;
+    }
+    throw new ServiceUnavailableException(
+      'Service is temporarily unavailable due to maintenance',
+    );
+  }
+}
