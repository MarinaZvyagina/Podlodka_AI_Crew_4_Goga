+import {
+  MAINTENANCE_MODE_METADATA,
+  Maintenance,
+} from '../../maintenance/maintenance-mode.decorator.js';
+
+describe('@Maintenance', () => {
+  @Maintenance()
+  class MarkedController {}
+
+  class UnmarkedController {}
+
+  class MixedController {
+    @Maintenance()
+    public static affectedHandler() {}
+
+    public static normalHandler() {}
+  }
+
+  it('should mark a class with the maintenance-mode metadata', () => {
+    expect(
+      Reflect.getMetadata(MAINTENANCE_MODE_METADATA, MarkedController),
+    ).toBe(true);
+  });
+
+  it('should leave an unmarked class without the metadata', () => {
+    expect(
+      Reflect.getMetadata(MAINTENANCE_MODE_METADATA, UnmarkedController),
+    ).toBeUndefined();
+  });
+
+  it('should mark an individual handler method with the metadata', () => {
+    expect(
+      Reflect.getMetadata(
+        MAINTENANCE_MODE_METADATA,
+        MixedController.affectedHandler,
+      ),
+    ).toBe(true);
+  });
+
+  it('should leave a sibling, unmarked handler method without the metadata', () => {
+    expect(
+      Reflect.getMetadata(
+        MAINTENANCE_MODE_METADATA,
+        MixedController.normalHandler,
+      ),
+    ).toBeUndefined();
+  });
+});
