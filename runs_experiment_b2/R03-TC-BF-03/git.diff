+import {
+  MaintenanceModeService,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { MaintenanceModeGuard } from '../../maintenance/maintenance-mode.guard.js';
+
+describe('MaintenanceModeGuard', () => {
+  let reflector: { getAllAndOverride: ReturnType<typeof vi.fn> };
+  let maintenanceModeService: MaintenanceModeService;
+  let guard: MaintenanceModeGuard;
+
+  const httpHandler = function affectedHttpHandler() {};
+  const httpController = class AffectedController {};
+  const wsHandler = function affectedSubscribeMessageHandler() {};
+  const wsGateway = class AffectedGateway {};
+
+  const createContext = (handler: Function, controller: Function): any => ({
+    getHandler: () => handler,
+    getClass: () => controller,
+  });
+
+  beforeEach(() => {
+    reflector = { getAllAndOverride: vi.fn() };
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceModeGuard(
+      reflector as any,
+      maintenanceModeService,
+    );
+  });
+
+  describe('when the target is not marked with @Maintenance()', () => {
+    beforeEach(() => reflector.getAllAndOverride.mockReturnValue(undefined));
+
+    it('should allow the call while maintenance mode is off', () => {
+      expect(
+        guard.canActivate(createContext(httpHandler, httpController)),
+      ).toBe(true);
+    });
+
+    it('should still allow the call while maintenance mode is on', () => {
+      maintenanceModeService.enable();
+
+      expect(
+        guard.canActivate(createContext(httpHandler, httpController)),
+      ).toBe(true);
+    });
+  });
+
+  describe('when the target is marked with @Maintenance()', () => {
+    beforeEach(() => reflector.getAllAndOverride.mockReturnValue(true));
+
+    it('should allow the call while maintenance mode is off', () => {
+      expect(
+        guard.canActivate(createContext(httpHandler, httpController)),
+      ).toBe(true);
+    });
+
+    it('should reject an HTTP-style handler with a clear, typed error while maintenance mode is on', () => {
+      maintenanceModeService.enable();
+
+      expect(() =>
+        guard.canActivate(createContext(httpHandler, httpController)),
+      ).toThrow(ServiceUnavailableException);
+    });
+
+    it('should equally reject a WebSocket-style @SubscribeMessage() handler while maintenance mode is on', () => {
+      maintenanceModeService.enable();
+
+      expect(() =>
+        guard.canActivate(createContext(wsHandler, wsGateway)),
+      ).toThrow(ServiceUnavailableException);
+    });
+
+    it('should resume allowing the call again once maintenance mode is switched back off', () => {
+      maintenanceModeService.enable();
+      expect(() =>
+        guard.canActivate(createContext(httpHandler, httpController)),
+      ).toThrow(ServiceUnavailableException);
+
+      maintenanceModeService.disable();
+
+      expect(
