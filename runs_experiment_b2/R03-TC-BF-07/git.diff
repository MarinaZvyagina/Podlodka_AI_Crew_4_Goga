@@ -0,0 +1,21 @@
+import {
+  CustomDecorator,
+  SetMetadata,
+} from '../decorators/core/set-metadata.decorator.js';
+import { MAINTENANCE_MODE_METADATA } from './maintenance.constants.js';
+
+/**
+ * Marks a handler method, or an entire controller/gateway class, as affected
+ * by maintenance mode. While maintenance mode is switched on (see
+ * `MaintenanceModeService`), calls to a marked handler are rejected by
+ * `MaintenanceGuard` before the handler's own logic runs. Handlers without
+ * this marker are never affected, regardless of the maintenance mode state.
+ *
+ * Applies uniformly to HTTP route handlers and WebSocket message handlers.
+ *
+ * @see [Guards](https://docs.nestjs.com/guards)
+ *
+ * @publicApi
+ */
+export const Maintenance = (): CustomDecorator<string> =>
+  SetMetadata(MAINTENANCE_MODE_METADATA, true);
diff --git a/packages/common/maintenance/maintenance.guard.ts b/packages/common/maintenance/maintenance.guard.ts
new file mode 100644
index 0000000..84b6a70
--- /dev/null
+++ b/packages/common/maintenance/maintenance.guard.ts
@@ -0,0 +1,45 @@
+import { Injectable } from '../decorators/core/injectable.decorator.js';
+import { ServiceUnavailableException } from '../exceptions/service-unavailable.exception.js';
+import { CanActivate, ExecutionContext } from '../interfaces/index.js';
+import { MAINTENANCE_MODE_METADATA } from './maintenance.constants.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Rejects calls to handlers marked with `@Maintenance()` while maintenance
+ * mode is switched on, before their own logic runs. Unmarked handlers are
+ * never affected, and every handler works normally again once maintenance
+ * mode is switched off.
+ *
+ * Meant to be registered once, globally, for the whole application. It is
+ * transport-agnostic: it only inspects the resolved handler and
+ * controller/gateway class carried by the execution context, so it behaves
+ * identically for HTTP requests and WebSocket messages.
+ *
+ * @see [Guards](https://docs.nestjs.com/guards)
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceGuard implements CanActivate {
+  constructor(
+    private readonly maintenanceModeService: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    if (!this.maintenanceModeService.isEnabled()) {
+      return true;
+    }
+
+    const isAffected =
+      Reflect.getMetadata(MAINTENANCE_MODE_METADATA, context.getHandler()) ??
+      Reflect.getMetadata(MAINTENANCE_MODE_METADATA, context.getClass());
+
+    if (!isAffected) {
+      return true;
+    }
+
+    throw new ServiceUnavailableException(
+      'This operation is temporarily unavailable due to maintenance.',
+    );
+  }
+}
