@@ -0,0 +1,35 @@
+import { MAINTENANCE_MODE_METADATA } from '../../maintenance/maintenance.constants.js';
+import { Maintenance } from '../../maintenance/maintenance.decorator.js';
+
+describe('@Maintenance', () => {
+  @Maintenance()
+  class TestController {}
+
+  class TestControllerWithMethod {
+    @Maintenance()
+    public static affected() {}
+
+    public static unaffected() {}
+  }
+
+  it('should mark the class with maintenance metadata', () => {
+    expect(Reflect.getMetadata(MAINTENANCE_MODE_METADATA, TestController)).toBe(
+      true,
+    );
+  });
+
+  it('should mark only the decorated method with maintenance metadata', () => {
+    expect(
+      Reflect.getMetadata(
+        MAINTENANCE_MODE_METADATA,
+        TestControllerWithMethod.affected,
+      ),
+    ).toBe(true);
+    expect(
+      Reflect.getMetadata(
+        MAINTENANCE_MODE_METADATA,
+        TestControllerWithMethod.unaffected,
+      ),
+    ).toBeUndefined();
+  });
+});
diff --git a/packages/common/test/maintenance/maintenance.guard.spec.ts b/packages/common/test/maintenance/maintenance.guard.spec.ts
new file mode 100644
index 0000000..b4899b6
--- /dev/null
+++ b/packages/common/test/maintenance/maintenance.guard.spec.ts
@@ -0,0 +1,97 @@
+import { ExecutionContext } from '../../interfaces/index.js';
+import { Maintenance } from '../../maintenance/maintenance.decorator.js';
+import { MaintenanceGuard } from '../../maintenance/maintenance.guard.js';
+import { MaintenanceModeService } from '../../maintenance/maintenance-mode.service.js';
+
+const createContext = (handler: Function, clazz: Function): ExecutionContext =>
+  ({
+    getHandler: () => handler,
+    getClass: () => clazz,
+  }) as ExecutionContext;
+
+describe('MaintenanceGuard', () => {
+  class UnmarkedGateway {
+    static handleEcho() {}
+  }
+
+  class MarkedGateway {
+    @Maintenance()
+    static handleExport() {}
+
+    static handleEcho() {}
+  }
+
+  @Maintenance()
+  class FullyMarkedGateway {
+    static handleAnything() {}
+  }
+
+  let maintenanceModeService: MaintenanceModeService;
+  let guard: MaintenanceGuard;
+
+  beforeEach(() => {
+    maintenanceModeService = new MaintenanceModeService();
+    guard = new MaintenanceGuard(maintenanceModeService);
+  });
+
+  it('should allow every handler while maintenance mode is off, marked or not', () => {
+    expect(
+      guard.canActivate(
+        createContext(MarkedGateway.handleExport, MarkedGateway),
+      ),
+    ).toBe(true);
+    expect(
+      guard.canActivate(
+        createContext(UnmarkedGateway.handleEcho, UnmarkedGateway),
+      ),
+    ).toBe(true);
+  });
+
+  describe('when maintenance mode is on', () => {
+    beforeEach(() => {
+      maintenanceModeService.enable();
+    });
+
+    it('should reject a handler marked directly', () => {
+      expect(() =>
+        guard.canActivate(
+          createContext(MarkedGateway.handleExport, MarkedGateway),
+        ),
+      ).toThrow();
+    });
+
+    it('should allow a sibling handler on the same class that is not marked', () => {
+      expect(
+        guard.canActivate(
+          createContext(MarkedGateway.handleEcho, MarkedGateway),
+        ),
+      ).toBe(true);
+    });
+
+    it('should allow a handler whose class is not marked at all', () => {
+      expect(
+        guard.canActivate(
+          createContext(UnmarkedGateway.handleEcho, UnmarkedGateway),
+        ),
+      ).toBe(true);
+    });
+
+    it('should reject every handler on a class marked at the class level', () => {
+      expect(() =>
+        guard.canActivate(
+          createContext(FullyMarkedGateway.handleAnything, FullyMarkedGateway),
+        ),
+      ).toThrow();
+    });
+
+    it('should resume allowing a previously marked handler once disabled again', () => {
+      maintenanceModeService.disable();
+
+      expect(
+        guard.canActivate(
+          createContext(MarkedGateway.handleExport, MarkedGateway),
+        ),
+      ).toBe(true);
+    });
+  });
+});
