--- /dev/null
+++ b/packages/common/maintenance/maintenance-mode.service.ts
@@ -0,0 +1,39 @@
+import { Injectable } from '../decorators/core/injectable.decorator.js';
+
+/**
+ * Process-wide, runtime-toggleable maintenance mode flag.
+ *
+ * Holds no reference to any request, transport, or handler — inject it
+ * wherever the running application needs to flip maintenance mode on or off
+ * (an admin endpoint, an internal CLI command, a migration script) without
+ * redeploying. `MaintenanceGuard` reads `isEnabled()` on every guarded call.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  /**
+   * Switch maintenance mode on. From this point, handlers marked with
+   * `@Maintenance()` are turned away until `disable()` is called.
+   */
+  enable(): void {
+    this.enabled = true;
+  }
+
+  /**
+   * Switch maintenance mode off. Handlers marked with `@Maintenance()` resume
+   * running normally.
+   */
+  disable(): void {
+    this.enabled = false;
+  }
+
+  /**
+   * @returns `true` while maintenance mode is switched on.
+   */
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+}
