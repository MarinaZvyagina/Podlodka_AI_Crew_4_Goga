@@ -0,0 +1,23 @@
+import { randomUUID } from 'node:crypto';
+import { Injectable, type NestMiddleware } from '@nestjs/common';
+import { REQUEST_ID_HEADER } from './request-id.constants.js';
+import { RequestIdStorage } from './request-id.storage.js';
+
+/**
+ * @publicApi
+ */
+@Injectable()
+export class RequestIdMiddleware implements NestMiddleware {
+  public use(req: any, res: any, next: (error?: any) => void): void {
+    const inboundHeader = req.headers?.[REQUEST_ID_HEADER.toLowerCase()];
+    const inboundId = Array.isArray(inboundHeader)
+      ? inboundHeader[0]
+      : inboundHeader;
+
+    const id = inboundId || randomUUID();
+
+    res.setHeader(REQUEST_ID_HEADER, id);
+
+    RequestIdStorage.run(id, () => next());
+  }
+}
diff --git a/packages/core/request-id/request-id.storage.ts b/packages/core/request-id/request-id.storage.ts
