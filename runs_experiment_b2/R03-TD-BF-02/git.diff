+++ b/packages/core/request-id/request-id.storage.ts
@@ -0,0 +1,16 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+
+/**
+ * @publicApi
+ */
+export class RequestIdStorage {
+  private static readonly storage = new AsyncLocalStorage<string>();
+
+  public static run<T>(id: string, callback: () => T): T {
+    return this.storage.run(id, callback);
+  }
+
+  public static getId(): string | null {
+    return this.storage.getStore() ?? null;
+  }
+}
