+import {
+  Controller,
+  Get,
+  MiddlewareConsumer,
+  Module,
+  NestModule,
+} from '@nestjs/common';
+import { RequestIdMiddleware, RequestIdStorage } from '@nestjs/core';
+import {
+  FastifyAdapter,
+  NestFastifyApplication,
+} from '@nestjs/platform-fastify';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+
+@Controller()
+class RequestIdTestController {
+  @Get('request-id')
+  getId() {
+    return { id: RequestIdStorage.getId() };
+  }
+}
+
+@Module({
+  controllers: [RequestIdTestController],
+})
+class RequestIdTestModule implements NestModule {
+  configure(consumer: MiddlewareConsumer) {
+    consumer.apply(RequestIdMiddleware).forRoutes('*');
+  }
+}
+
+describe('Request id (FastifyAdapter)', () => {
+  let app: NestFastifyApplication;
+
+  beforeEach(async () => {
+    app = (
+      await Test.createTestingModule({
+        imports: [RequestIdTestModule],
+      }).compile()
+    ).createNestApplication<NestFastifyApplication>(new FastifyAdapter());
+
+    await app.init();
+    await app.getHttpAdapter().getInstance().ready();
+  });
+
+  it('should generate a request id and return it on the response header', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/request-id')
+      .expect(200);
+
+    expect(response.headers['x-request-id']).toBeTruthy();
+  });
+
+  it('should expose the same id to the route handler as the response header carries', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/request-id')
+      .expect(200);
+
+    expect(response.body.id).toEqual(response.headers['x-request-id']);
+  });
+
+  it('should reuse an inbound x-request-id header instead of generating a new one', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/request-id')
+      .set('x-request-id', 'caller-supplied-id')
+      .expect(200);
+
+    expect(response.headers['x-request-id']).toEqual('caller-supplied-id');
+    expect(response.body.id).toEqual('caller-supplied-id');
+  });
+
+  it('should generate a different id for each request with no inbound header', async () => {
+    const [first, second] = await Promise.all([
+      request(app.getHttpServer()).get('/request-id'),
+      request(app.getHttpServer()).get('/request-id'),
+    ]);
+
+    expect(first.headers['x-request-id']).not.toEqual(
+      second.headers['x-request-id'],
+    );
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+});
