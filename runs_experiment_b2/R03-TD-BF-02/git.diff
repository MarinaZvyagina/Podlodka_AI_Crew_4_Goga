+import { REQUEST_ID_HEADER } from '../../request-id/request-id.constants.js';
+import { RequestIdMiddleware } from '../../request-id/request-id.middleware.js';
+import { RequestIdStorage } from '../../request-id/request-id.storage.js';
+
+describe('RequestIdMiddleware', () => {
+  let middleware: RequestIdMiddleware;
+  let res: { setHeader: ReturnType<typeof vi.fn> };
+  let next: ReturnType<typeof vi.fn>;
+
+  beforeEach(() => {
+    middleware = new RequestIdMiddleware();
+    res = { setHeader: vi.fn() };
+    next = vi.fn();
+  });
+
+  it('should reuse an inbound request id header verbatim', () => {
+    const req = { headers: { 'x-request-id': 'incoming-id' } };
+
+    middleware.use(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledWith(REQUEST_ID_HEADER, 'incoming-id');
+  });
+
+  it('should generate a new id when no header is supplied', () => {
+    const req = { headers: {} };
+
+    middleware.use(req, res, next);
+
+    const [, generatedId] = res.setHeader.mock.calls[0];
+    expect(generatedId).toEqual(expect.any(String));
+    expect(generatedId.length).toBeGreaterThan(0);
+  });
+
+  it('should generate a new id when the header is present but empty', () => {
+    const req = { headers: { 'x-request-id': '' } };
+
+    middleware.use(req, res, next);
+
+    const [, generatedId] = res.setHeader.mock.calls[0];
+    expect(generatedId).not.toEqual('');
+  });
+
+  it('should generate a different id on each call with no inbound header', () => {
+    middleware.use({ headers: {} }, res, next);
+    const [, firstId] = res.setHeader.mock.calls[0];
+
+    const res2 = { setHeader: vi.fn() };
+    middleware.use({ headers: {} }, res2, next);
+    const [, secondId] = res2.setHeader.mock.calls[0];
+
+    expect(firstId).not.toEqual(secondId);
+  });
+
+  it('should call next() exactly once', () => {
+    middleware.use({ headers: {} }, res, next);
+    expect(next).toHaveBeenCalledOnce();
+  });
+
+  it('should make the resolved id observable via RequestIdStorage while next() runs', () => {
+    const req = { headers: { 'x-request-id': 'incoming-id' } };
+    next.mockImplementation(() => {
+      expect(RequestIdStorage.getId()).toEqual('incoming-id');
+    });
+
+    middleware.use(req, res, next);
+
+    expect(next).toHaveBeenCalledOnce();
+  });
+
+  it('should not leave the id active once use() returns', () => {
+    middleware.use({ headers: { 'x-request-id': 'incoming-id' } }, res, next);
+    expect(RequestIdStorage.getId()).toBeNull();
+  });
+
+  it('should take the first value when the header arrives as an array', () => {
+    const req = { headers: { 'x-request-id': ['first-id', 'second-id'] } };
+
+    middleware.use(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledWith(REQUEST_ID_HEADER, 'first-id');
+  });
+});
