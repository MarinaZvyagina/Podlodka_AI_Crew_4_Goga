+import { RequestIdStorage } from '../../request-id/request-id.storage.js';
+
+describe('RequestIdStorage', () => {
+  describe('getId', () => {
+    it('should return null outside of a run scope', () => {
+      expect(RequestIdStorage.getId()).toBeNull();
+    });
+  });
+
+  describe('run', () => {
+    it('should expose the bound id via getId() within the callback', () => {
+      RequestIdStorage.run('req-1', () => {
+        expect(RequestIdStorage.getId()).toEqual('req-1');
+      });
+    });
+
+    it('should return the callback result', () => {
+      const result = RequestIdStorage.run('req-1', () => 42);
+      expect(result).toEqual(42);
+    });
+
+    it('should not leak the id outside of the run scope', () => {
+      RequestIdStorage.run('req-1', () => undefined);
+      expect(RequestIdStorage.getId()).toBeNull();
+    });
+
+    it('should preserve the id across an async continuation', async () => {
+      const observed = await RequestIdStorage.run('req-async', async () => {
+        await new Promise(resolve => setTimeout(resolve, 0));
+        return RequestIdStorage.getId();
+      });
+      expect(observed).toEqual('req-async');
+    });
+
+    it('should isolate concurrent run scopes from each other', async () => {
+      const [first, second] = await Promise.all([
+        RequestIdStorage.run('req-a', async () => {
+          await new Promise(resolve => setTimeout(resolve, 10));
+          return RequestIdStorage.getId();
+        }),
+        RequestIdStorage.run('req-b', async () => {
+          await new Promise(resolve => setTimeout(resolve, 0));
+          return RequestIdStorage.getId();
+        }),
+      ]);
+      expect(first).toEqual('req-a');
+      expect(second).toEqual('req-b');
+    });
+  });
+});
