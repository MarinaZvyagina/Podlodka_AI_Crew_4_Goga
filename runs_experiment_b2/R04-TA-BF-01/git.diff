diff --git a/packages/excalidraw/data/filenameUtils.ts b/packages/excalidraw/data/filenameUtils.ts
new file mode 100644
index 0000000..660a96d
--- /dev/null
+++ b/packages/excalidraw/data/filenameUtils.ts
@@ -0,0 +1,24 @@
+import { DEFAULT_FILENAME } from "@excalidraw/common";
+
+// Reserved/unsafe on Windows (also avoided on macOS/Linux since they carry
+// path-separator or shell meaning there).
+const INVALID_FILENAME_CHARS_REGEX = /[/\\:*?"<>|]/g;
+
+// Windows silently strips trailing dots and spaces, which would otherwise
+// make the saved file name mismatch what the user typed.
+const TRAILING_DOTS_AND_SPACES_REGEX = /[. ]+$/;
+
+/**
+ * Turns an arbitrary user-typed drawing name into a name that's safe to use
+ * as a file name on Windows, macOS, and Linux. Falls back to
+ * `DEFAULT_FILENAME` if nothing safe is left.
+ */
+export const getSanitizedFilename = (name: string): string => {
+  const sanitized = name
+    .replace(INVALID_FILENAME_CHARS_REGEX, "-")
+    .trim()
+    .replace(TRAILING_DOTS_AND_SPACES_REGEX, "")
+    .trim();
+
+  return sanitized || DEFAULT_FILENAME;
+};
