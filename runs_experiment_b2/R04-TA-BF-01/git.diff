diff --git a/packages/excalidraw/tests/data/filenameUtils.test.ts b/packages/excalidraw/tests/data/filenameUtils.test.ts
new file mode 100644
index 0000000..9351ad6
--- /dev/null
+++ b/packages/excalidraw/tests/data/filenameUtils.test.ts
@@ -0,0 +1,32 @@
+import { getSanitizedFilename } from "../../data/filenameUtils";
+
+describe("getSanitizedFilename", () => {
+  it("leaves an already-safe name untouched", () => {
+    expect(getSanitizedFilename("My Drawing")).toBe("My Drawing");
+  });
+
+  it("replaces characters reserved/unsafe on Windows, macOS, or Linux", () => {
+    expect(getSanitizedFilename('a/b\\c:d*e?f"g<h>i|j')).toBe(
+      "a-b-c-d-e-f-g-h-i-j",
+    );
+  });
+
+  it("strips trailing dots and spaces", () => {
+    expect(getSanitizedFilename("My Drawing...")).toBe("My Drawing");
+    expect(getSanitizedFilename("My Drawing   ")).toBe("My Drawing");
+    expect(getSanitizedFilename("My Drawing. . .")).toBe("My Drawing");
+  });
+
+  it("trims leading/trailing whitespace", () => {
+    expect(getSanitizedFilename("  My Drawing  ")).toBe("My Drawing");
+  });
+
+  it("falls back to the default filename when empty or whitespace-only", () => {
+    expect(getSanitizedFilename("")).toBe("Untitled");
+    expect(getSanitizedFilename("   ")).toBe("Untitled");
+  });
+
+  it("falls back to the default filename when only dots remain", () => {
+    expect(getSanitizedFilename("...")).toBe("Untitled");
+  });
+});
