diff --git a/packages/excalidraw/data/filename.test.ts b/packages/excalidraw/data/filename.test.ts
new file mode 100644
index 0000000..e8bfb60
--- /dev/null
+++ b/packages/excalidraw/data/filename.test.ts
@@ -0,0 +1,30 @@
+import { getSanitizedFilename } from "./filename";
+
+describe("getSanitizedFilename", () => {
+  it("leaves an already-safe name untouched", () => {
+    expect(getSanitizedFilename("My Drawing")).toBe("My Drawing");
+  });
+
+  it("replaces characters invalid on Windows/macOS/Linux", () => {
+    expect(getSanitizedFilename('a/b\\c:d*e?f"g<h>i|j')).toBe(
+      "a-b-c-d-e-f-g-h-i-j",
+    );
+  });
+
+  it("strips trailing dots and spaces", () => {
+    expect(getSanitizedFilename("My Drawing.")).toBe("My Drawing");
+    expect(getSanitizedFilename("My Drawing ")).toBe("My Drawing");
+    expect(getSanitizedFilename("My Drawing. . .")).toBe("My Drawing");
+  });
+
+  it("strips leading/trailing whitespace", () => {
+    expect(getSanitizedFilename("  My Drawing  ")).toBe("My Drawing");
+  });
+
+  it("returns an empty string when nothing safe remains", () => {
+    expect(getSanitizedFilename("")).toBe("");
+    expect(getSanitizedFilename("   ")).toBe("");
+    expect(getSanitizedFilename("...")).toBe("");
+    expect(getSanitizedFilename(" . . ")).toBe("");
+  });
+});
diff --git a/packages/excalidraw/data/filename.ts b/packages/excalidraw/data/filename.ts
new file mode 100644
index 0000000..7d7f974
--- /dev/null
+++ b/packages/excalidraw/data/filename.ts
@@ -0,0 +1,24 @@
+// characters disallowed (or reserved) in file names on Windows, macOS, and Linux
+const INVALID_FILENAME_CHARS_REGEX = /[/\\:*?"<>|]/g;
+
+/**
+ * Turns an arbitrary user-supplied string into a name that's safe to use as
+ * a file name on Windows, macOS, and Linux. Returns an empty string if
+ * nothing safe-to-use remains (e.g. the input was blank or made up only of
+ * reserved characters), letting the caller fall back to a default name.
+ */
+export const getSanitizedFilename = (name: string): string => {
+  let sanitized = name.replace(INVALID_FILENAME_CHARS_REGEX, "-");
+
+  // Windows silently strips trailing dots/spaces when saving, which would
+  // otherwise make the saved file's name differ from what's shown in the
+  // editor, so strip them ourselves (repeatedly, since removing one can
+  // expose another, e.g. "name. .").
+  let previous;
+  do {
+    previous = sanitized;
+    sanitized = sanitized.trim().replace(/\.+$/, "");
+  } while (sanitized !== previous);
+
+  return sanitized;
+};
