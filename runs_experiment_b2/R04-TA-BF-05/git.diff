@@ -0,0 +1,60 @@
+import { sanitizeFilename } from "./filename";
+
+describe("sanitizeFilename", () => {
+  it("leaves an already-safe name untouched", () => {
+    expect(sanitizeFilename("My Drawing")).toBe("My Drawing");
+  });
+
+  it("replaces characters forbidden on Windows/macOS/Linux", () => {
+    expect(sanitizeFilename('a/b\\c:d*e?f"g<h>i|j')).toBe(
+      "a_b_c_d_e_f_g_h_i_j",
+    );
+  });
+
+  it("strips ASCII control characters", () => {
+    expect(sanitizeFilename("a\x00b\x1fc")).toBe("a_b_c");
+  });
+
+  it("strips trailing dots, which Windows silently drops", () => {
+    expect(sanitizeFilename("My Drawing...")).toBe("My Drawing");
+  });
+
+  it("strips trailing spaces, which Windows silently drops", () => {
+    expect(sanitizeFilename("My Drawing   ")).toBe("My Drawing");
+  });
+
+  it("strips a mix of trailing dots and spaces", () => {
+    expect(sanitizeFilename("My Drawing . . ")).toBe("My Drawing");
+  });
+
+  it("strips leading spaces", () => {
+    expect(sanitizeFilename("   My Drawing")).toBe("My Drawing");
+  });
+
+  it("preserves internal spaces while typing multi-word names", () => {
+    expect(sanitizeFilename("My Awesome Drawing")).toBe("My Awesome Drawing");
+  });
+
+  it("reduces a name made up only of spaces to an empty string", () => {
+    expect(sanitizeFilename("   ")).toBe("");
+  });
+
+  it("reduces an empty name to an empty string", () => {
+    expect(sanitizeFilename("")).toBe("");
+  });
+
+  it("replaces a name made up only of invalid characters, without emptying it", () => {
+    expect(sanitizeFilename("///")).toBe("___");
+  });
+
+  it("suffixes Windows-reserved device names", () => {
+    expect(sanitizeFilename("CON")).toBe("CON_");
+    expect(sanitizeFilename("con")).toBe("con_");
+    expect(sanitizeFilename("COM1")).toBe("COM1_");
+    expect(sanitizeFilename("LPT9")).toBe("LPT9_");
+  });
+
+  it("does not touch names that merely contain a reserved word", () => {
+    expect(sanitizeFilename("CONstruction plan")).toBe("CONstruction plan");
+  });
+});
diff --git a/packages/excalidraw/data/filename.ts b/packages/excalidraw/data/filename.ts
new file mode 100644
index 0000000..faa2b7d
--- /dev/null
+++ b/packages/excalidraw/data/filename.ts
@@ -0,0 +1,31 @@
+// Characters forbidden in filenames on Windows (also disallowed or awkward on
+// macOS/Linux), plus ASCII control characters.
+// eslint-disable-next-line no-control-regex
+const INVALID_FILENAME_CHARS_REGEX = /[\\/:*?"<>|\x00-\x1f]/g;
+
+// Windows silently strips trailing dots/spaces when writing a file, so a name
+// ending in either would otherwise look different on disk than what the user typed.
+const TRAILING_DOTS_AND_SPACES_REGEX = /[.\s]+$/;
+const LEADING_SPACES_REGEX = /^\s+/;
+
+// Reserved on Windows regardless of extension or case.
+const WINDOWS_RESERVED_NAME_REGEX =
+  /^(CON|PRN|AUX|NUL|COM[0-9¹²³]|LPT[0-9¹²³])$/i;
+
+/**
+ * Sanitizes a user-supplied drawing name so it's safe to use as a filename
+ * on Windows, macOS, and Linux. Returns an empty string if nothing safe is
+ * left (e.g. the input was empty or made up only of invalid characters).
+ */
+export const sanitizeFilename = (name: string): string => {
+  let sanitized = name
+    .replace(INVALID_FILENAME_CHARS_REGEX, "_")
+    .replace(LEADING_SPACES_REGEX, "")
+    .replace(TRAILING_DOTS_AND_SPACES_REGEX, "");
+
+  if (WINDOWS_RESERVED_NAME_REGEX.test(sanitized)) {
+    sanitized += "_";
+  }
+
+  return sanitized;
+};
