diff --git a/packages/excalidraw/data/filenameSanitizer.test.ts b/packages/excalidraw/data/filenameSanitizer.test.ts
new file mode 100644
index 0000000..4e00c64
--- /dev/null
+++ b/packages/excalidraw/data/filenameSanitizer.test.ts
@@ -0,0 +1,33 @@
+import { sanitizeFilename } from "./filenameSanitizer";
+
+describe("sanitizeFilename", () => {
+  it("leaves an already-safe name untouched", () => {
+    expect(sanitizeFilename("My Drawing")).toBe("My Drawing");
+  });
+
+  it("replaces characters reserved on Windows/macOS/Linux", () => {
+    expect(sanitizeFilename('a/b\\c:d*e?f"g<h>i|j')).toBe(
+      "a_b_c_d_e_f_g_h_i_j",
+    );
+  });
+
+  it("strips ASCII control characters", () => {
+    expect(sanitizeFilename("a\x00b\x1fc")).toBe("a_b_c");
+  });
+
+  it("strips trailing dots and spaces (silently stripped by Windows)", () => {
+    expect(sanitizeFilename("My Drawing...")).toBe("My Drawing");
+    expect(sanitizeFilename("My Drawing   ")).toBe("My Drawing");
+    expect(sanitizeFilename("My Drawing. . ")).toBe("My Drawing");
+  });
+
+  it("trims leading/trailing whitespace", () => {
+    expect(sanitizeFilename("  My Drawing  ")).toBe("My Drawing");
+  });
+
+  it("falls back to the default name when empty or blank", () => {
+    expect(sanitizeFilename("")).toBe("Untitled");
+    expect(sanitizeFilename("   ")).toBe("Untitled");
+    expect(sanitizeFilename("...")).toBe("Untitled");
+  });
+});
diff --git a/packages/excalidraw/data/filenameSanitizer.ts b/packages/excalidraw/data/filenameSanitizer.ts
new file mode 100644
index 0000000..638b12a
--- /dev/null
+++ b/packages/excalidraw/data/filenameSanitizer.ts
@@ -0,0 +1,23 @@
+import { DEFAULT_FILENAME } from "@excalidraw/common";
+
+// Characters reserved/disallowed in file names on Windows (also covers the
+// path separators `/` and `\` that are unsafe on macOS/Linux as well), plus
+// ASCII control characters.
+// eslint-disable-next-line no-control-regex
+const UNSAFE_FILENAME_CHARS_REGEX = /[<>:"/\\|?*\x00-\x1f]/g;
+
+/**
+ * Turns an arbitrary user-provided string into a name that's safe to use as
+ * a file name on Windows, macOS, and Linux. Does NOT touch the string the
+ * user sees/edits in the UI — only the value that ends up on disk.
+ */
+export const sanitizeFilename = (name: string): string => {
+  const sanitized = name
+    .replace(UNSAFE_FILENAME_CHARS_REGEX, "_")
+    .trim()
+    // Windows silently strips trailing dots/spaces, which would otherwise
+    // desync the name shown to the user from the name saved to disk.
+    .replace(/[.\s]+$/, "");
+
+  return sanitized || DEFAULT_FILENAME;
+};
