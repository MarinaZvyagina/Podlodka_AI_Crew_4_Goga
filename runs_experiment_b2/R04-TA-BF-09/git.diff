diff --git a/packages/excalidraw/tests/filesystem.test.ts b/packages/excalidraw/tests/filesystem.test.ts
new file mode 100644
index 0000000..5012ca2
--- /dev/null
+++ b/packages/excalidraw/tests/filesystem.test.ts
@@ -0,0 +1,51 @@
+import { sanitizeFilename } from "../data/filesystem";
+
+describe("sanitizeFilename", () => {
+  it("keeps an already-safe name unchanged", () => {
+    expect(sanitizeFilename("my drawing")).toBe("my drawing");
+  });
+
+  it("replaces characters forbidden on Windows/macOS/Linux", () => {
+    expect(sanitizeFilename('a/b\\c:d*e?f"g<h>i|j')).toBe(
+      "a-b-c-d-e-f-g-h-i-j",
+    );
+  });
+
+  it("strips ASCII control characters", () => {
+    expect(sanitizeFilename("name\x01with\x1fcontrol")).toBe(
+      "name-with-control",
+    );
+  });
+
+  it("strips trailing dots and spaces (silently stripped by Windows)", () => {
+    expect(sanitizeFilename("my drawing...")).toBe("my drawing");
+    expect(sanitizeFilename("my drawing   ")).toBe("my drawing");
+    expect(sanitizeFilename("my drawing. . ")).toBe("my drawing");
+  });
+
+  it("strips leading spaces", () => {
+    expect(sanitizeFilename("   my drawing")).toBe("my drawing");
+  });
+
+  it("falls back to the default name when empty or whitespace-only", () => {
+    expect(sanitizeFilename("")).toBe("Untitled");
+    expect(sanitizeFilename("   ")).toBe("Untitled");
+    expect(sanitizeFilename("...")).toBe("Untitled");
+  });
+
+  it("falls back to a custom fallback when supplied", () => {
+    expect(sanitizeFilename("", "fallback")).toBe("fallback");
+  });
+
+  it("falls back for Windows-reserved device names", () => {
+    expect(sanitizeFilename("CON")).toBe("Untitled");
+    expect(sanitizeFilename("con")).toBe("Untitled");
+    expect(sanitizeFilename("LPT1")).toBe("Untitled");
+    expect(sanitizeFilename("COM3.txt")).toBe("Untitled");
+  });
+
+  it("does not treat names merely containing a reserved word as reserved", () => {
+    expect(sanitizeFilename("CONcept")).toBe("CONcept");
+    expect(sanitizeFilename("my CON drawing")).toBe("my CON drawing");
+  });
+});
