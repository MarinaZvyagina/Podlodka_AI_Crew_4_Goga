 import { normalizeFile } from "./blob";
 
 type FILE_EXTENSION = Exclude<keyof typeof MIME_TYPES, "binary">;
 
+// characters disallowed (or reserved) in file names on Windows/macOS/Linux,
+// plus ASCII control characters
+// eslint-disable-next-line no-control-regex
+const UNSAFE_FILENAME_CHARS_REGEX = /[\\/:*?"<>|\x00-\x1f]/g;
+// Windows silently strips trailing dots/spaces, which can desync the typed
+// name from the name the file actually gets saved under
+const TRAILING_DOTS_OR_SPACES_REGEX = /[.\s]+$/;
+const LEADING_SPACES_REGEX = /^\s+/;
+// reserved device names on Windows (case-insensitive, with or without an
+// extension)
+const WINDOWS_RESERVED_NAME_REGEX =
+  /^(CON|PRN|AUX|NUL|COM[0-9]|LPT[0-9])(\..*)?$/i;
+
+export const sanitizeFilename = (
+  name: string,
+  fallback: string = DEFAULT_FILENAME,
+): string => {
+  const sanitized = name
+    .replace(UNSAFE_FILENAME_CHARS_REGEX, "-")
+    .replace(LEADING_SPACES_REGEX, "")
+    .replace(TRAILING_DOTS_OR_SPACES_REGEX, "");
+
+  if (!sanitized || WINDOWS_RESERVED_NAME_REGEX.test(sanitized)) {
+    return fallback;
+  }
+
+  return sanitized;
+};
