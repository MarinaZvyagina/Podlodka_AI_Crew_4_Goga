+/**
+ * The area enclosed by the element's outline, in scene units squared, for
+ * element types whose outline encloses a filled region. Rectangle/diamond/
+ * ellipse areas come from `width`/`height`, which excludes rotation, so a
+ * rotated shape reports the same area as before rotation. Line/freedraw
+ * areas come from the shoelace formula over the raw (unrotated) points,
+ * which is rotation-invariant for the same reason.
+ *
+ * Returns null for element types that don't enclose a meaningful region
+ * (text, arrows, open lines/freedraw paths, images, etc).
+ */
+export const getElementArea = (element: ExcalidrawElement): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+  }
+
+  if (isLineElement(element)) {
+    return element.polygon && isValidPolygon(element.points)
+      ? polygonArea(element.points)
+      : null;
+  }
+
+  if (isFreeDrawElement(element)) {
+    return isPathALoop(element.points) ? polygonArea(element.points) : null;
+  }
+
+  return null;
+};
