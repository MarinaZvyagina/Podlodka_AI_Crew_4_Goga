+/**
+ * The area a shape encloses, in scene units squared, or null if the shape
+ * doesn't enclose a region (e.g. an open line, an arrow, or text).
+ *
+ * Rotation doesn't change area, so width/height (already angle-independent)
+ * is enough for the regular shapes. A line or freedraw stroke only encloses
+ * a region once its outline closes into a loop — the same rule the renderer
+ * itself uses to decide whether to paint a background fill (see
+ * `isPathALoop`) — so its area is measured via the shoelace formula over
+ * its (local, therefore also angle-independent) points.
+ */
+export const getElementArea = (element: ExcalidrawElement): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    case "line":
+    case "freedraw":
+      return isPathALoop(element.points) ? polygonArea(element.points) : null;
+    default:
+      return null;
+  }
+};
