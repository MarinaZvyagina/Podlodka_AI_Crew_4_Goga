+describe("stats area readout per shape type", () => {
+  beforeEach(async () => {
+    localStorage.clear();
+    renderStaticScene.mockClear();
+    reseed(7);
+    setDateTimeForTests("201933152653");
+
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+
+    API.setElements([]);
+
+    fireEvent.contextMenu(GlobalTestState.interactiveCanvas, {
+      button: 2,
+      clientX: 1,
+      clientY: 1,
+    });
+    const contextMenu = UI.queryContextMenu();
+    fireEvent.click(queryByTestId(contextMenu!, "stats")!);
+    stats = UI.queryStats();
+  });
+
+  beforeAll(() => {
+    mockBoundingClientRect();
+  });
+
+  afterAll(() => {
+    restoreOriginalGetBoundingClientRect();
+  });
+
+  const selectSingleElement = (element: ExcalidrawElement) => {
+    API.setAppState({ selectedElementIds: { [element.id]: true } });
+    elementStats = stats?.querySelector("#elementStats");
+  };
+
+  it("shows width * height / 2 for a diamond", () => {
+    const diamond = API.createElement({
+      type: "diamond",
+      width: 200,
+      height: 100,
+    });
+    API.setElements([diamond]);
+    selectSingleElement(diamond);
+
+    expect(
+      queryByTestId(elementStats!, "stats-area")?.lastChild?.textContent,
+    ).toBe("10000");
+  });
+
+  it("shows pi * (width/2) * (height/2) for an ellipse", () => {
+    const ellipse = API.createElement({
+      type: "ellipse",
+      width: 200,
+      height: 100,
+    });
+    API.setElements([ellipse]);
+    selectSingleElement(ellipse);
+
+    const expected = ((Math.PI * 200 * 100) / 4).toFixed(2);
+    expect(
+      queryByTestId(elementStats!, "stats-area")?.lastChild?.textContent,
+    ).toBe(expected);
+  });
+
+  it("shows the shoelace area for a closed line, but omits it for an open line", () => {
+    const closedLine = API.createElement({
+      type: "line",
+      width: 100,
+      height: 100,
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+        pointFrom(0, 0),
+      ],
+    });
+    API.setElements([closedLine]);
+    selectSingleElement(closedLine);
+
+    expect(
+      queryByTestId(elementStats!, "stats-area")?.lastChild?.textContent,
+    ).toBe("10000");
+
+    const openLine = API.createElement({
+      type: "line",
+      width: 100,
+      height: 100,
+      points: [pointFrom(0, 0), pointFrom(100, 0), pointFrom(100, 100)],
+    });
+    API.setElements([openLine]);
+    selectSingleElement(openLine);
+
+    expect(queryByTestId(elementStats!, "stats-area")).toBeFalsy();
+  });
+
+  it("omits the area readout for shapes without a meaningful enclosed area", () => {
+    const arrow = API.createElement({
+      type: "arrow",
+      width: 100,
+      height: 100,
+    });
+    API.setElements([arrow]);
+    selectSingleElement(arrow);
+
+    expect(queryByTestId(elementStats!, "stats-area")).toBeFalsy();
+
+    const text = API.createElement({ type: "text", width: 100, height: 25 });
+    API.setElements([text]);
+    selectSingleElement(text);
+
+    expect(queryByTestId(elementStats!, "stats-area")).toBeFalsy();
+  });
+});
