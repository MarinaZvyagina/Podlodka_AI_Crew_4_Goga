+describe("getElementArea", () => {
+  it("returns width * height for a rectangle", () => {
+    const element = API.createElement({
+      type: "rectangle",
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(element)).toBeCloseTo(5000, EPSILON_DIGITS);
+  });
+
+  it("returns width * height / 2 for a diamond", () => {
+    const element = API.createElement({
+      type: "diamond",
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(element)).toBeCloseTo(2500, EPSILON_DIGITS);
+  });
+
+  it("returns pi * (width/2) * (height/2) for an ellipse", () => {
+    const element = API.createElement({
+      type: "ellipse",
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(element)).toBeCloseTo(
+      Math.PI * 50 * 25,
+      EPSILON_DIGITS,
+    );
+  });
+
+  it("is unaffected by rotation", () => {
+    const unrotated = API.createElement({
+      type: "rectangle",
+      width: 100,
+      height: 50,
+    });
+    const rotated = API.createElement({
+      type: "rectangle",
+      width: 100,
+      height: 50,
+      angle: degreesToRadians(37 as Degrees),
+    });
+    expect(getElementArea(rotated)).toBeCloseTo(
+      getElementArea(unrotated)!,
+      EPSILON_DIGITS,
+    );
+  });
+
+  it("returns the shoelace area for a closed line", () => {
+    const element = API.createElement({
+      type: "line",
+      width: 100,
+      height: 100,
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+        pointFrom(0, 0),
+      ],
+    });
+    expect(getElementArea(element)).toBeCloseTo(10000, EPSILON_DIGITS);
+  });
+
+  it("returns null for an open line", () => {
+    const element = API.createElement({
+      type: "line",
+      width: 100,
+      height: 100,
+      points: [pointFrom(0, 0), pointFrom(100, 0), pointFrom(100, 100)],
+    });
+    expect(getElementArea(element)).toBeNull();
+  });
+
+  it("returns the shoelace area for a closed (looped) freedraw outline", () => {
+    const element = API.createElement({
+      type: "freedraw",
+      width: 100,
+      height: 100,
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+        pointFrom(0, 0),
+      ],
+    });
+    expect(getElementArea(element)).toBeCloseTo(10000, EPSILON_DIGITS);
+  });
+
+  it("returns null for a non-looped freedraw stroke", () => {
+    const element = API.createElement({
+      type: "freedraw",
+      width: 100,
+      height: 100,
+      points: [pointFrom(0, 0), pointFrom(50, 50), pointFrom(100, 0)],
+    });
+    expect(getElementArea(element)).toBeNull();
+  });
+
+  it("returns null for shapes without a meaningful enclosed area", () => {
+    expect(getElementArea(API.createElement({ type: "arrow" }))).toBeNull();
+    expect(getElementArea(API.createElement({ type: "text" }))).toBeNull();
+    expect(getElementArea(API.createElement({ type: "image" }))).toBeNull();
+  });
+});
