diff --git a/packages/excalidraw/actions/actionToggleHideBoundText.test.tsx b/packages/excalidraw/actions/actionToggleHideBoundText.test.tsx
new file mode 100644
index 0000000..ae7c155
--- /dev/null
+++ b/packages/excalidraw/actions/actionToggleHideBoundText.test.tsx
@@ -0,0 +1,68 @@
+import React from "react";
+
+import { getBoundTextElement } from "@excalidraw/element";
+
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { render } from "../tests/test-utils";
+
+import { actionToggleHideBoundText } from "./actionToggleHideBoundText";
+
+const { h } = window;
+
+describe("hiding bound text captions", () => {
+  it("is off by default and toggles on/off without touching elements", async () => {
+    await render(<Excalidraw />);
+
+    const container = API.createElement({ type: "rectangle" });
+    const text = API.createElement({
+      type: "text",
+      text: "label",
+      containerId: container.id,
+    });
+    API.setElements([
+      { ...container, boundElements: [{ id: text.id, type: "text" }] },
+      text,
+    ]);
+
+    expect(h.state.hideBoundTextEnabled).toBe(false);
+
+    const elementsBefore = h.elements;
+
+    API.executeAction(actionToggleHideBoundText);
+    expect(h.state.hideBoundTextEnabled).toBe(true);
+    expect(h.elements).toBe(elementsBefore);
+
+    const boundText = getBoundTextElement(
+      h.elements[0],
+      h.app.scene.getNonDeletedElementsMap(),
+    );
+    expect(boundText).not.toBe(null);
+    expect(boundText?.text).toBe("label");
+
+    API.executeAction(actionToggleHideBoundText);
+    expect(h.state.hideBoundTextEnabled).toBe(false);
+    expect(h.elements).toBe(elementsBefore);
+  });
+
+  it("does not affect other view toggles", async () => {
+    await render(<Excalidraw />);
+
+    API.setAppState({ gridModeEnabled: true });
+    API.executeAction(actionToggleHideBoundText);
+
+    expect(h.state.hideBoundTextEnabled).toBe(true);
+    expect(h.state.gridModeEnabled).toBe(true);
+  });
+
+  it("is not persisted to the exported appState", async () => {
+    const { cleanAppStateForExport } = await import("../appState");
+    await render(<Excalidraw />);
+
+    API.executeAction(actionToggleHideBoundText);
+    expect(h.state.hideBoundTextEnabled).toBe(true);
+
+    const exported = cleanAppStateForExport(h.state);
+    expect(exported).not.toHaveProperty("hideBoundTextEnabled");
+  });
+});
diff --git a/packages/excalidraw/actions/actionToggleHideBoundText.tsx b/packages/excalidraw/actions/actionToggleHideBoundText.tsx
new file mode 100644
index 0000000..605f106
--- /dev/null
+++ b/packages/excalidraw/actions/actionToggleHideBoundText.tsx
@@ -0,0 +1,31 @@
+import { CODES, KEYS } from "@excalidraw/common";
+
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { eyeClosedIcon } from "../components/icons";
+
+import { register } from "./register";
+
+export const actionToggleHideBoundText = register({
+  name: "hideBoundText",
+  icon: eyeClosedIcon,
+  keywords: ["caption", "label", "text"],
+  label: "labels.hideCaptions",
+  viewMode: true,
+  trackEvent: {
+    category: "canvas",
+    predicate: (appState) => !appState.hideBoundTextEnabled,
+  },
+  perform(elements, appState) {
+    return {
+      appState: {
+        ...appState,
+        hideBoundTextEnabled: !this.checked!(appState),
+      },
+      captureUpdate: CaptureUpdateAction.EVENTUALLY,
+    };
+  },
+  checked: (appState) => appState.hideBoundTextEnabled,
+  keyTest: (event) =>
+    !event[KEYS.CTRL_OR_CMD] && event.altKey && event.code === CODES.C,
+});
