diff --git a/packages/excalidraw/tests/hideBoundTextCaptions.test.tsx b/packages/excalidraw/tests/hideBoundTextCaptions.test.tsx
new file mode 100644
index 0000000..ebdfdd8
--- /dev/null
+++ b/packages/excalidraw/tests/hideBoundTextCaptions.test.tsx
@@ -0,0 +1,191 @@
+import React from "react";
+
+import { vi } from "vitest";
+
+import { CODES, KEYS } from "@excalidraw/common";
+
+import * as ElementPkg from "@excalidraw/element";
+
+import { exportToCanvas } from "@excalidraw/utils";
+
+import { actionToggleGridMode } from "../actions/actionToggleGridMode";
+import { actionToggleHideBoundTextCaptions } from "../actions/actionToggleHideBoundTextCaptions";
+import { getDefaultAppState } from "../appState";
+import { Excalidraw } from "../index";
+
+import type { Action } from "../actions/types";
+
+import { API } from "./helpers/api";
+import {
+  mockBoundingClientRect,
+  render,
+  restoreOriginalGetBoundingClientRect,
+  waitFor,
+} from "./test-utils";
+
+const { h } = window;
+
+describe("hiding bound text captions", () => {
+  let renderElementSpy: ReturnType<typeof vi.spyOn>;
+
+  const renderedIds = () =>
+    renderElementSpy.mock.calls.map((call: any) => call[0]?.id);
+
+  beforeEach(async () => {
+    renderElementSpy = vi.spyOn(ElementPkg, "renderElement");
+    mockBoundingClientRect();
+    await render(<Excalidraw />);
+    await waitFor(() => expect(h.state.width).toBe(200));
+  });
+
+  afterEach(() => {
+    renderElementSpy.mockRestore();
+    restoreOriginalGetBoundingClientRect();
+  });
+
+  it("defaults to captions visible", () => {
+    expect(h.state.hideBoundTextCaptions).toBe(false);
+    expect(actionToggleHideBoundTextCaptions.checked!(h.state)).toBe(false);
+  });
+
+  it("recognizes its keyboard shortcut (Alt+C)", () => {
+    const keyTest = actionToggleHideBoundTextCaptions.keyTest as NonNullable<
+      Action["keyTest"]
+    >;
+    expect(
+      keyTest(
+        new KeyboardEvent("keydown", { altKey: true, code: CODES.C }),
+        h.state,
+        h.elements,
+        h.app,
+      ),
+    ).toBe(true);
+    // ctrl/cmd+alt+C is a different shortcut and must not match
+    expect(
+      keyTest(
+        new KeyboardEvent("keydown", {
+          altKey: true,
+          code: CODES.C,
+          ctrlKey: true,
+          metaKey: true,
+        }),
+        h.state,
+        h.elements,
+        h.app,
+      ),
+    ).toBe(false);
+  });
+
+  it("is available whether or not a shape is selected", () => {
+    expect(
+      h.app.actionManager.isActionEnabled(actionToggleHideBoundTextCaptions),
+    ).toBe(true);
+
+    const [rectangle, text] = API.createTextContainer();
+    API.setElements([rectangle, text]);
+    API.setSelectedElements([rectangle]);
+
+    expect(
+      h.app.actionManager.isActionEnabled(actionToggleHideBoundTextCaptions),
+    ).toBe(true);
+  });
+
+  it("hides a shape's caption and restores it, without touching the underlying elements", () => {
+    const [rectangle, text] = API.createTextContainer({
+      label: { text: "caption" },
+    });
+    API.setElements([rectangle, text]);
+
+    expect(renderedIds()).toEqual(expect.arrayContaining([text.id]));
+
+    renderElementSpy.mockClear();
+    API.executeAction(actionToggleHideBoundTextCaptions);
+
+    expect(h.state.hideBoundTextCaptions).toBe(true);
+    expect(renderedIds()).toEqual(expect.arrayContaining([rectangle.id]));
+    expect(renderedIds()).not.toEqual(expect.arrayContaining([text.id]));
+    // the underlying elements are untouched: still bound, still present
+    expect(h.elements).toEqual([
+      expect.objectContaining({
+        id: rectangle.id,
+        isDeleted: false,
+        boundElements: [{ type: "text", id: text.id }],
+      }),
+      expect.objectContaining({
+        id: text.id,
+        isDeleted: false,
+        containerId: rectangle.id,
+        text: "caption",
+      }),
+    ]);
+
+    renderElementSpy.mockClear();
+    API.executeAction(actionToggleHideBoundTextCaptions);
+
+    expect(h.state.hideBoundTextCaptions).toBe(false);
+    expect(renderedIds()).toEqual(expect.arrayContaining([text.id]));
+  });
+
+  it("hides an arrow's bound label the same way", () => {
+    const [arrow, label] = API.createLabeledArrow({
+      label: { text: "arrow-caption" },
+    });
+    API.setElements([arrow, label]);
+
+    expect(renderedIds()).toEqual(expect.arrayContaining([label.id]));
+
+    renderElementSpy.mockClear();
+    API.setAppState({ hideBoundTextCaptions: true });
+
+    expect(renderedIds()).not.toEqual(expect.arrayContaining([label.id]));
+  });
+
+  it("does not affect freestanding text unbound to any shape", () => {
+    const freestanding = API.createElement({
+      type: "text",
+      text: "freestanding",
+    });
+    API.setElements([freestanding]);
+    renderElementSpy.mockClear();
+
+    API.setAppState({ hideBoundTextCaptions: true });
+
+    expect(renderedIds()).toEqual(expect.arrayContaining([freestanding.id]));
+  });
+
+  it("combines with other view toggles without either overriding the other's state", () => {
+    API.setAppState({ gridModeEnabled: true });
+
+    API.executeAction(actionToggleHideBoundTextCaptions);
+    expect(h.state.hideBoundTextCaptions).toBe(true);
+    expect(h.state.gridModeEnabled).toBe(true);
+
+    // toggling grid mode off must not reset the caption toggle
+    API.executeAction(actionToggleGridMode);
+    expect(h.state.gridModeEnabled).toBe(false);
+    expect(h.state.hideBoundTextCaptions).toBe(true);
+  });
+
+  it("is not persisted into the exported scene file (transient view preference)", () => {
+    expect(getDefaultAppState().hideBoundTextCaptions).toBe(false);
+  });
+
+  it("never interferes with image export, regardless of the in-app toggle", async () => {
+    const [rectangle, text] = API.createTextContainer({
+      label: { text: "export-caption" },
+    });
+
+    renderElementSpy.mockClear();
+    await exportToCanvas({
+      elements: [rectangle, text],
+      appState: {
+        hideBoundTextCaptions: true,
+        exportBackground: true,
+        viewBackgroundColor: "#ffffff",
+      },
+      files: null,
+    });
+
+    expect(renderedIds()).toEqual(expect.arrayContaining([text.id]));
+  });
+});
