diff --git a/packages/excalidraw/actions/actionToggleHideBoundTextCaptions.test.tsx b/packages/excalidraw/actions/actionToggleHideBoundTextCaptions.test.tsx
new file mode 100644
index 0000000..96bc92f
--- /dev/null
+++ b/packages/excalidraw/actions/actionToggleHideBoundTextCaptions.test.tsx
@@ -0,0 +1,66 @@
+import { CODES } from "@excalidraw/common";
+
+import type { ExcalidrawTextElement } from "@excalidraw/element/types";
+
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { act, fireEvent, render } from "../tests/test-utils";
+
+import { actionToggleHideBoundTextCaptions } from "./actionToggleHideBoundTextCaptions";
+
+const { h } = window;
+
+describe("actionToggleHideBoundTextCaptions", () => {
+  beforeEach(async () => {
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+  });
+
+  it("defaults to captions visible", () => {
+    expect(h.state.hideBoundTextCaptions).toBe(false);
+  });
+
+  it("toggling on and off never mutates the container or its bound text", () => {
+    const [rectangle, text] = API.createTextContainer();
+    API.setElements([rectangle, text]);
+
+    const rectangleBefore = { ...h.elements[0] };
+    const textBefore = { ...h.elements[1] };
+
+    API.executeAction(actionToggleHideBoundTextCaptions);
+    expect(h.state.hideBoundTextCaptions).toBe(true);
+    expect(h.elements).toEqual([rectangleBefore, textBefore]);
+    expect((h.elements[1] as ExcalidrawTextElement).containerId).toBe(
+      rectangle.id,
+    );
+    expect(h.elements[1].isDeleted).toBe(false);
+
+    API.executeAction(actionToggleHideBoundTextCaptions);
+    expect(h.state.hideBoundTextCaptions).toBe(false);
+    expect(h.elements).toEqual([rectangleBefore, textBefore]);
+  });
+
+  it("is available with nothing selected", () => {
+    expect(h.state.selectedElementIds).toEqual({});
+    expect(
+      h.app.actionManager.isActionEnabled(actionToggleHideBoundTextCaptions),
+    ).toBe(true);
+  });
+
+  it("toggles via its keyboard shortcut (Alt+C)", () => {
+    expect(h.state.hideBoundTextCaptions).toBe(false);
+
+    act(() => {
+      fireEvent.keyDown(document, { code: CODES.C, altKey: true });
+    });
+
+    expect(h.state.hideBoundTextCaptions).toBe(true);
+  });
+
+  it("does not couple with other view toggles (grid mode)", () => {
+    API.executeAction(actionToggleHideBoundTextCaptions);
+    API.setAppState({ gridModeEnabled: true });
+
+    expect(h.state.hideBoundTextCaptions).toBe(true);
+    expect(h.state.gridModeEnabled).toBe(true);
+  });
+});
diff --git a/packages/excalidraw/actions/actionToggleHideBoundTextCaptions.tsx b/packages/excalidraw/actions/actionToggleHideBoundTextCaptions.tsx
new file mode 100644
index 0000000..e7423d1
--- /dev/null
+++ b/packages/excalidraw/actions/actionToggleHideBoundTextCaptions.tsx
@@ -0,0 +1,30 @@
+import { CODES, KEYS } from "@excalidraw/common";
+
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { eyeClosedIcon } from "../components/icons";
+
+import { register } from "./register";
+
+export const actionToggleHideBoundTextCaptions = register({
+  name: "hideBoundTextCaptions",
+  label: "labels.hideBoundTextCaptions",
+  icon: eyeClosedIcon,
+  viewMode: true,
+  trackEvent: {
+    category: "canvas",
+    predicate: (appState) => !appState.hideBoundTextCaptions,
+  },
+  perform(elements, appState) {
+    return {
+      appState: {
+        ...appState,
+        hideBoundTextCaptions: !this.checked!(appState),
+      },
+      captureUpdate: CaptureUpdateAction.EVENTUALLY,
+    };
+  },
+  checked: (appState) => appState.hideBoundTextCaptions,
+  keyTest: (event) =>
+    !event[KEYS.CTRL_OR_CMD] && event.altKey && event.code === CODES.C,
+});
