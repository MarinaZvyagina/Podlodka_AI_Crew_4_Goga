diff --git a/packages/element/src/snapToGrid.ts b/packages/element/src/snapToGrid.ts
new file mode 100644
index 0000000..b498042
--- /dev/null
+++ b/packages/element/src/snapToGrid.ts
@@ -0,0 +1,70 @@
+import { getGridPoint } from "@excalidraw/common";
+
+import type { NullableGridSize } from "@excalidraw/excalidraw/types";
+
+import { updateBoundElements } from "./binding";
+import { resizeSingleElement } from "./resizeElements";
+import { getBoundTextElement } from "./textElement";
+import { isBoundToContainer, isElbowArrow } from "./typeChecks";
+
+import type { Scene } from "./Scene";
+import type { NonDeletedExcalidrawElement } from "./types";
+
+const roundToGrid = (value: number, gridSize: number) =>
+  Math.round(value / gridSize) * gridSize;
+
+/**
+ * Rounds `element`'s position and size to the nearest grid line, the same
+ * way a manual grid-snapped drag (position) followed by a grid-snapped
+ * corner resize (size) would. Bound text/arrows are kept in sync via
+ * `updateBoundElements`, exactly as they are during an interactive drag.
+ */
+export const snapElementToGrid = (
+  element: NonDeletedExcalidrawElement,
+  scene: Scene,
+  gridSize: NullableGridSize,
+): void => {
+  if (
+    !gridSize ||
+    isBoundToContainer(element) ||
+    (isElbowArrow(element) && (element.startBinding || element.endBinding))
+  ) {
+    return;
+  }
+
+  const [nextX, nextY] = getGridPoint(element.x, element.y, gridSize);
+  if (nextX !== element.x || nextY !== element.y) {
+    const offsetX = nextX - element.x;
+    const offsetY = nextY - element.y;
+
+    scene.mutateElement(element, { x: nextX, y: nextY });
+
+    const boundTextElement = getBoundTextElement(
+      element,
+      scene.getNonDeletedElementsMap(),
+    );
+    if (boundTextElement) {
+      scene.mutateElement(boundTextElement, {
+        x: boundTextElement.x + offsetX,
+        y: boundTextElement.y + offsetY,
+      });
+    }
+
+    updateBoundElements(element, scene);
+  }
+
+  const nextWidth = Math.max(roundToGrid(element.width, gridSize), gridSize);
+  const nextHeight = Math.max(roundToGrid(element.height, gridSize), gridSize);
+
+  if (nextWidth !== element.width || nextHeight !== element.height) {
+    resizeSingleElement(
+      nextWidth,
+      nextHeight,
+      element,
+      element,
+      scene.getNonDeletedElementsMap(),
+      scene,
+      "se",
+    );
+  }
+};
diff --git a/packages/excalidraw/actions/actionSnapToGrid.test.tsx b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
new file mode 100644
index 0000000..ccf9b40
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
@@ -0,0 +1,134 @@
+import type { NonDeletedExcalidrawElement } from "@excalidraw/element/types";
+
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { Keyboard, UI } from "../tests/helpers/ui";
+import { render } from "../tests/test-utils";
+
+import { actionSnapToGrid } from "./actionSnapToGrid";
+
+// gridSize defaults to 20 (DEFAULT_GRID_SIZE)
+describe("snap to grid", () => {
+  beforeEach(async () => {
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+  });
+
+  it("snaps position and size of the selected elements independently", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 11,
+      y: 9,
+      width: 47,
+      height: 53,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 103,
+      y: 97,
+      width: 22,
+      height: 31,
+    });
+
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([rect1, rect2]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const el1 = API.getElement(rect1);
+    expect(el1.x).toBe(20);
+    expect(el1.y).toBe(0);
+    expect(el1.width).toBe(40);
+    expect(el1.height).toBe(60);
+
+    const el2 = API.getElement(rect2);
+    expect(el2.x).toBe(100);
+    expect(el2.y).toBe(100);
+    expect(el2.width).toBe(20);
+    expect(el2.height).toBe(40);
+  });
+
+  it("applies to every non-deleted, unlocked shape when nothing is selected", () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 9,
+      y: 9,
+      width: 18,
+      height: 18,
+    });
+    const lockedRect = API.createElement({
+      type: "rectangle",
+      x: 9,
+      y: 9,
+      width: 18,
+      height: 18,
+      locked: true,
+    });
+
+    API.setElements([rect, lockedRect]);
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect).x).toBe(0);
+    expect(API.getElement(rect).y).toBe(0);
+    expect(API.getElement(lockedRect).x).toBe(9);
+    expect(API.getElement(lockedRect).y).toBe(9);
+  });
+
+  it("moves a bound text label along with its container", () => {
+    const container = API.createElement({
+      type: "rectangle",
+      id: "container",
+      x: 11,
+      y: 9,
+      width: 80,
+      height: 80,
+      boundElements: [{ id: "text", type: "text" }],
+    });
+    const text = API.createElement({
+      type: "text",
+      id: "text",
+      x: 21,
+      y: 19,
+      width: 60,
+      height: 25,
+      containerId: "container",
+    });
+
+    API.setElements([container, text]);
+    API.setSelectedElements([container]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const nextContainer = API.getElement(container);
+    const nextText = API.getElement(text);
+    const offsetX = 21 - 11;
+    const offsetY = 19 - 9;
+
+    expect(nextText.x).toBe(nextContainer.x + offsetX);
+    expect(nextText.y).toBe(nextContainer.y + offsetY);
+  });
+
+  it("is undoable in a single step", () => {
+    const rect = UI.createElement("rectangle", {
+      x: 11,
+      y: 9,
+      width: 47,
+      height: 53,
+    });
+
+    API.setSelectedElements([
+      rect.get() as NonDeletedExcalidrawElement,
+    ]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect).x).toBe(20);
+    expect(API.getElement(rect).y).toBe(0);
+
+    Keyboard.undo();
+
+    expect(API.getElement(rect).x).toBe(11);
+    expect(API.getElement(rect).y).toBe(9);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..7fcb711
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,59 @@
+import { getNonDeletedElements } from "@excalidraw/element";
+import { isFrameLikeElement } from "@excalidraw/element";
+import { snapElementToGrid } from "@excalidraw/element";
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import type {
+  ExcalidrawElement,
+  NonDeletedExcalidrawElement,
+} from "@excalidraw/element/types";
+
+import { getSelectedElements } from "../scene";
+
+import { gridIcon } from "../components/icons";
+
+import { register } from "./register";
+
+import type {
+  AppClassProperties,
+  NullableGridSize,
+  UIAppState,
+} from "../types";
+
+const getSnapToGridTargets = (
+  elements: readonly ExcalidrawElement[],
+  appState: UIAppState,
+): NonDeletedExcalidrawElement[] => {
+  const nonDeletedElements = getNonDeletedElements(elements);
+  const selectedElements = getSelectedElements(nonDeletedElements, appState);
+
+  const candidates =
+    selectedElements.length > 0
+      ? selectedElements
+      : nonDeletedElements.filter((element) => !element.locked);
+
+  return candidates.filter((element) => !isFrameLikeElement(element));
+};
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  trackEvent: { category: "element" },
+  predicate: (elements, appState) =>
+    !!appState.gridSize && getSnapToGridTargets(elements, appState).length > 0,
+  perform: (elements, appState, _, app: AppClassProperties) => {
+    const targets = getSnapToGridTargets(elements, appState);
+    const gridSize = appState.gridSize as NullableGridSize;
+
+    targets.forEach((element) =>
+      snapElementToGrid(element, app.scene, gridSize),
+    );
+
+    return {
+      appState,
+      elements,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
