+	case "trim":
+		// Store the whitespace-trimmed `source_labels` joined with `separator` at `target_label`
+		bb := relabelBufPool.Get()
+		bb.B = concatLabelValues(bb.B[:0], src, prc.SourceLabels, prc.Separator)
