+// buildStaticScrapeConfigYAML builds a scrape config with jobName and targetsCount static targets.
+// If maxTargets > 0, it sets max_scrape_targets_per_job to maxTargets for the job.
+func buildStaticScrapeConfigYAML(jobName string, maxTargets, targetsCount int) string {
+	var sb strings.Builder
+	fmt.Fprintf(&sb, "scrape_configs:\n- job_name: %s\n", jobName)
+	if maxTargets > 0 {
+		fmt.Fprintf(&sb, "  max_scrape_targets_per_job: %d\n", maxTargets)
+	}
+	sb.WriteString("  static_configs:\n  - targets:\n")
+	for i := range targetsCount {
+		fmt.Fprintf(&sb, "    - \"127.0.0.1:%d\"\n", 12000+i)
+	}
+	return sb.String()
+}
+
+// countDroppedTargetsForJob returns the number of entries in droppedTargetsMap with the given
+// jobName and dropReason.
+func countDroppedTargetsForJob(jobName string, reason targetDropReason) int {
+	n := 0
+	for _, dt := range droppedTargetsMap.getTargetsList() {
+		if dt.dropReason == reason && dt.originalLabels.getJob() == jobName {
+			n++
+		}
+	}
+	return n
+}
