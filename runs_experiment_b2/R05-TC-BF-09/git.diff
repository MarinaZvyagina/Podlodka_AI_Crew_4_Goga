+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+)
+
+func TestGetInstanceLabels(t *testing.T) {
+	privateIP := "10.0.0.1"
+	input := []Instance{
+		// a running instance with public, private and ipv6 addresses and tags.
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "scaleway-sd",
+			Organization:   "22222222-2222-2222-2222-222222222222",
+			Project:        "33333333-3333-3333-3333-333333333333",
+			Tags:           []string{"mock", "tag"},
+			CommercialType: "DEV1-S",
+			Hostname:       "scaleway-sd",
+			State:          "running",
+			Zone:           "fr-par-1",
+			Arch:           "x86_64",
+			BootType:       "local",
+			PrivateIP:      &privateIP,
+			PublicIP:       &ServerIP{Address: "51.15.0.1"},
+			IPv6:           &ServerIPv6{Address: "2001:bc8::1"},
+		},
+		// a stopped instance must be skipped.
+		{
+			ID:       "stopped-id",
+			Name:     "scaleway-stopped",
+			State:    "stopped",
+			Zone:     "fr-par-1",
+			PublicIP: &ServerIP{Address: "51.15.0.2"},
+		},
+		// a running instance without a public IP must fall back to the private IP.
+		{
+			ID:        "private-only-id",
+			Name:      "scaleway-private-only",
+			State:     "running",
+			Zone:      "fr-par-1",
+			PrivateIP: &privateIP,
+		},
+		// a running instance without any IP must be skipped.
+		{
+			ID:    "no-ip-id",
+			Name:  "scaleway-no-ip",
+			State: "running",
+			Zone:  "fr-par-1",
+		},
+	}
+
+	expect := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                           "51.15.0.1:8080",
+			"__meta_scaleway_instance_id":           "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":         "scaleway-sd",
+			"__meta_scaleway_instance_zone":         "fr-par-1",
+			"__meta_scaleway_instance_state":        "running",
+			"__meta_scaleway_instance_type":         "DEV1-S",
+			"__meta_scaleway_instance_hostname":     "scaleway-sd",
+			"__meta_scaleway_instance_arch":         "x86_64",
+			"__meta_scaleway_instance_boot_type":    "local",
+			"__meta_scaleway_instance_organization": "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_project":      "33333333-3333-3333-3333-333333333333",
+			"__meta_scaleway_instance_public_ip":    "51.15.0.1",
+			"__meta_scaleway_instance_private_ip":   "10.0.0.1",
+			"__meta_scaleway_instance_ipv6":         "2001:bc8::1",
+			"__meta_scaleway_instance_tags":         ",mock,tag,",
+		}),
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                           "10.0.0.1:8080",
+			"__meta_scaleway_instance_id":           "private-only-id",
+			"__meta_scaleway_instance_name":         "scaleway-private-only",
+			"__meta_scaleway_instance_zone":         "fr-par-1",
+			"__meta_scaleway_instance_state":        "running",
+			"__meta_scaleway_instance_type":         "",
+			"__meta_scaleway_instance_hostname":     "",
+			"__meta_scaleway_instance_arch":         "",
+			"__meta_scaleway_instance_boot_type":    "",
+			"__meta_scaleway_instance_organization": "",
+			"__meta_scaleway_instance_project":      "",
+			"__meta_scaleway_instance_public_ip":    "",
+			"__meta_scaleway_instance_private_ip":   "10.0.0.1",
+		}),
+	}
+	labels := getInstanceLabels(input, 8080)
+	discoveryutil.TestEqualLabelss(t, labels, expect)
+}
