+				"arch": "x86_64",
+				"boot_type": "local",
+				"private_ip": "10.0.0.1",
+				"public_ip": {"address": "51.15.0.1"},
+				"ipv6": {"address": "2001:bc8::1"}
+			}],
+			"total_count": 1
+		}`
+		return []byte(resp)
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:    client,
+		zone: "fr-par-1",
+	}
+
+	instances, err := getInstances(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+
+	privateIP := "10.0.0.1"
+	expectedInstances := []Instance{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "scaleway-sd",
+			Organization:   "22222222-2222-2222-2222-222222222222",
+			Project:        "33333333-3333-3333-3333-333333333333",
+			Tags:           []string{"mock", "tag"},
+			CommercialType: "DEV1-S",
+			Hostname:       "scaleway-sd",
+			State:          "running",
+			Zone:           "fr-par-1",
+			Arch:           "x86_64",
+			BootType:       "local",
+			PrivateIP:      &privateIP,
+			PublicIP:       &ServerIP{Address: "51.15.0.1"},
+			IPv6:           &ServerIPv6{Address: "2001:bc8::1"},
+		},
+	}
+	if !reflect.DeepEqual(instances, expectedInstances) {
+		t.Fatalf("unexpected result\ngot\n%#v\nwant\n%#v", instances, expectedInstances)
+	}
+}
+
+func TestGetInstances_Failure(t *testing.T) {
+	s := newMockScalewayServer(func() []byte {
+		return []byte("some error")
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:    client,
+		zone: "fr-par-1",
+	}
+
+	if _, err := getInstances(cfg); err == nil {
+		t.Fatalf("expecting non-nil error from getInstances()")
+	}
+}
+
+func TestGetInstances_Paging(t *testing.T) {
+	requestCount := 0
+	s := newMockScalewayServer(func() []byte {
+		requestCount++
+		if requestCount == 1 {
+			return []byte(mockListServersPage0Resp)
+		}
+		return []byte(mockListServersPage1Resp)
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:    client,
+		zone: "fr-par-1",
+	}
+
+	instances, err := getInstances(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+	if !reflect.DeepEqual(expectPagingInstances, instances) {
+		t.Fatalf("unexpected getInstances() result\ngot\n%#v\nwant\n%#v", instances, expectPagingInstances)
+	}
+	if requestCount != 2 {
+		t.Fatalf("unexpected number of requests; got %d; want 2", requestCount)
+	}
+}
+
+// ------------ Test dataset ------------
+var (
+	mockListServersPage0Resp = `{
+		"servers": [{
+			"id": "1-fake-id",
+			"name": "scaleway-sd-0",
+			"state": "running",
+			"zone": "fr-par-1",
+			"public_ip": {"address": "51.15.0.1"}
+		}],
+		"total_count": 2
+	}`
+	mockListServersPage1Resp = `{
+		"servers": [{
+			"id": "2-fake-id",
+			"name": "scaleway-sd-1",
+			"state": "running",
+			"zone": "fr-par-1",
+			"public_ip": {"address": "51.15.0.2"}
+		}],
+		"total_count": 2
+	}`
+	expectPagingInstances = []Instance{
+		{
+			ID:       "1-fake-id",
+			Name:     "scaleway-sd-0",
+			State:    "running",
+			Zone:     "fr-par-1",
+			PublicIP: &ServerIP{Address: "51.15.0.1"},
+		},
+		{
+			ID:       "2-fake-id",
+			Name:     "scaleway-sd-1",
+			State:    "running",
+			Zone:     "fr-par-1",
+			PublicIP: &ServerIP{Address: "51.15.0.2"},
+		},
+	}
+)
diff --git a/lib/promscrape/discovery/scaleway/mock_server_test.go b/lib/promscrape/discovery/scaleway/mock_server_test.go
new file mode 100644
index 0000000..25bd44c
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/mock_server_test.go
@@ -0,0 +1,23 @@
+package scaleway
+
+import (
+	"net/http"
+	"net/http/httptest"
+)
+
+type mockScalewayServer struct {
+	*httptest.Server
+	responseFunc func() []byte
+}
+
+func newMockScalewayServer(responseFunc func() []byte) *mockScalewayServer {
+	var s mockScalewayServer
+	s.responseFunc = responseFunc
+	s.Server = httptest.NewServer(http.HandlerFunc(s.handler))
+	return &s
+}
+
+func (s *mockScalewayServer) handler(w http.ResponseWriter, _ *http.Request) {
+	data := s.responseFunc()
+	w.Write(data)
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway.go b/lib/promscrape/discovery/scaleway/scaleway.go
new file mode 100644
index 0000000..dd1166a
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway.go
@@ -0,0 +1,123 @@
+package scaleway
+
+import (
+	"flag"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/proxy"
+)
+
+// SDCheckInterval defines interval for Scaleway targets refresh.
+var SDCheckInterval = flag.Duration("promscrape.scalewaySDCheckInterval", 30*time.Second, "Interval for checking for changes in Scaleway. "+
+	"This works only if scaleway_sd_configs is configured in '-promscrape.config' file. "+
+	"See https://docs.victoriametrics.com/victoriametrics/sd_configs/#scaleway_sd_configs for details")
+
+// SDConfig represents service discovery config for Scaleway Instances.
+//
+// See: https://prometheus.io/docs/prometheus/latest/configuration/configuration/#scaleway_sd_config
+type SDConfig struct {
+	// SecretKey is the Scaleway API secret key used for authenticating requests (mandatory).
+	// See: https://www.scaleway.com/en/docs/generate-api-keys/
+	SecretKey *promauth.Secret `yaml:"secret_key"`
+
+	// Zone is the Scaleway zone to discover instances in, e.g. "fr-par-1", "nl-ams-1", "pl-waw-1".
+	// See: https://www.scaleway.com/en/docs/console/account/reference-content/products-availability/
+	Zone string `yaml:"zone,omitempty"`
+
+	// Project is the Scaleway project ID to filter instances by. All of Project and Organization are optional.
+	Project string `yaml:"project_id,omitempty"`
+
+	// Organization is the Scaleway organization ID to filter instances by.
+	Organization string `yaml:"organization_id,omitempty"`
+
+	// The port to scrape metrics from. Default 80.
+	Port int `yaml:"port,omitempty"`
+
+	// General HTTP / Auth configs.
+	HTTPClientConfig  promauth.HTTPClientConfig  `yaml:",inline"`
+	ProxyURL          *proxy.URL                 `yaml:"proxy_url,omitempty"`
+	ProxyClientConfig promauth.ProxyClientConfig `yaml:",inline"`
+
+	// refresh_interval is obtained from `-promscrape.scalewaySDCheckInterval` command-line option.
+}
+
+var configMap = discoveryutil.NewConfigMap()
+
+// GetLabels returns Scaleway instances' labels according to sdc.
+func (sdc *SDConfig) GetLabels(baseDir string) ([]*promutil.Labels, error) {
+	ac, err := getAPIConfig(sdc, baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot get API config: %w", err)
+	}
+	instances, err := getInstances(ac)
+	if err != nil {
+		return nil, err
+	}
+	return getInstanceLabels(instances, ac.port), nil
+}
+
+// MustStop stops further usage for sdc.
+func (sdc *SDConfig) MustStop() {
+	_ = configMap.Delete(sdc)
+}
+
+// getInstanceLabels returns labels for running Scaleway instances obtained from the given instances.
+func getInstanceLabels(instances []Instance, port int) []*promutil.Labels {
+	ms := make([]*promutil.Labels, 0, len(instances))
+
+	for _, instance := range instances {
+		if instance.State != "running" {
+			continue
+		}
+
+		var publicIP, privateIP string
+		if instance.PublicIP != nil {
+			publicIP = instance.PublicIP.Address
+		}
+		if instance.PrivateIP != nil {
+			privateIP = *instance.PrivateIP
+		}
+		addr := publicIP
+		if addr == "" {
+			addr = privateIP
+		}
+		if addr == "" {
+			// The instance has no address to scrape.
+			continue
+		}
+
+		m := promutil.NewLabels(16)
+		m.Add("__address__", discoveryutil.JoinHostPort(addr, port))
+		m.Add("__meta_scaleway_instance_id", instance.ID)
+		m.Add("__meta_scaleway_instance_name", instance.Name)
+		m.Add("__meta_scaleway_instance_zone", instance.Zone)
+		m.Add("__meta_scaleway_instance_state", instance.State)
+		m.Add("__meta_scaleway_instance_type", instance.CommercialType)
+		m.Add("__meta_scaleway_instance_hostname", instance.Hostname)
+		m.Add("__meta_scaleway_instance_arch", instance.Arch)
+		m.Add("__meta_scaleway_instance_boot_type", instance.BootType)
+		m.Add("__meta_scaleway_instance_organization", instance.Organization)
+		m.Add("__meta_scaleway_instance_project", instance.Project)
+		m.Add("__meta_scaleway_instance_public_ip", publicIP)
+		m.Add("__meta_scaleway_instance_private_ip", privateIP)
+		if instance.IPv6 != nil {
+			m.Add("__meta_scaleway_instance_ipv6", instance.IPv6.Address)
+		}
+		if len(instance.Tags) > 0 {
+			m.Add("__meta_scaleway_instance_tags", joinStrings(instance.Tags))
+		}
+
+		ms = append(ms, m)
+	}
+
+	return ms
+}
+
+func joinStrings(a []string) string {
+	return "," + strings.Join(a, ",") + ","
+}
