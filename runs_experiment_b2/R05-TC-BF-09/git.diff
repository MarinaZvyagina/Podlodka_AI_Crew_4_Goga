@@ -0,0 +1,54 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	sdc := &SDConfig{}
+	baseDir := "."
+	_, err := newAPIConfig(sdc, baseDir)
+	if err == nil {
+		t.Fatalf("expecting non-nil error")
+	}
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		SecretKey: &promauth.Secret{
+			S: "foobar",
+		},
+	}
+	baseDir := "."
+	ac, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	if ac.zone != defaultZone {
+		t.Fatalf("unexpected default zone; got %q; want %q", ac.zone, defaultZone)
+	}
+}
+
+func TestNewAPIConfig_WithFilters(t *testing.T) {
+	sdc := &SDConfig{
+		SecretKey: &promauth.Secret{
+			S: "foobar",
+		},
+		Zone:         "nl-ams-1",
+		Project:      "project-id",
+		Organization: "org-id",
+	}
+	baseDir := "."
+	ac, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	if ac.zone != "nl-ams-1" {
+		t.Fatalf("unexpected zone; got %q; want %q", ac.zone, "nl-ams-1")
+	}
+	if ac.listQueryParams != "organization=org-id&project=project-id" {
+		t.Fatalf("unexpected listQueryParams; got %q", ac.listQueryParams)
+	}
+}
diff --git a/lib/promscrape/discovery/scaleway/instance.go b/lib/promscrape/discovery/scaleway/instance.go
new file mode 100644
index 0000000..9acecce
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/instance.go
@@ -0,0 +1,76 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+)
+
+// perPage is the maximum number of servers requested per page.
+//
+// See: https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+const perPage = 100
+
+// listServersResponse is the response structure of Scaleway List servers API.
+type listServersResponse struct {
+	Servers    []Instance `json:"servers"`
+	TotalCount int        `json:"total_count"`
+}
+
+// Instance represents a Scaleway Instance (server).
+//
+// See: https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type Instance struct {
+	ID             string      `json:"id"`
+	Name           string      `json:"name"`
+	Organization   string      `json:"organization"`
+	Project        string      `json:"project"`
+	Tags           []string    `json:"tags"`
+	CommercialType string      `json:"commercial_type"`
+	Hostname       string      `json:"hostname"`
+	State          string      `json:"state"`
+	Zone           string      `json:"zone"`
+	Arch           string      `json:"arch"`
+	BootType       string      `json:"boot_type"`
+	PrivateIP      *string     `json:"private_ip"`
+	PublicIP       *ServerIP   `json:"public_ip"`
+	IPv6           *ServerIPv6 `json:"ipv6"`
+}
+
+// ServerIP represents a Scaleway Instance public IP address.
+type ServerIP struct {
+	Address string `json:"address"`
+}
+
+// ServerIPv6 represents a Scaleway Instance IPv6 address.
+type ServerIPv6 struct {
+	Address string `json:"address"`
+}
+
+// getInstances retrieves the list of instances from Scaleway HTTP API.
+func getInstances(cfg *apiConfig) ([]Instance, error) {
+	var instances []Instance
+
+	page := 1
+	for {
+		// See: https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?%s&per_page=%d&page=%d", cfg.zone, cfg.listQueryParams, perPage, page)
+		data, err := cfg.c.GetAPIResponseWithReqParams(path, cfg.setAuthHeader)
+		if err != nil {
+			return nil, fmt.Errorf("cannot get Scaleway response from %q: %w", path, err)
+		}
+
+		var resp listServersResponse
+		if err := json.Unmarshal(data, &resp); err != nil {
+			return nil, fmt.Errorf("cannot unmarshal listServersResponse obtained from %q: %w; response=%q", path, err, data)
+		}
+
+		instances = append(instances, resp.Servers...)
+
+		if len(resp.Servers) == 0 || len(instances) >= resp.TotalCount {
+			break
+		}
+		page++
+	}
+
+	return instances, nil
+}
