+package droppedseriesstats
+
+import (
+	"fmt"
+	"testing"
+)
+
+func TestTracker_NilIsNoOp(t *testing.T) {
+	var tr *Tracker
+
+	tr.Add([]byte("foo"), 10)
+	tr.Reset()
+
+	result := tr.GetTop(10)
+	if len(result.Records) != 0 {
+		t.Fatalf("unexpected records for nil tracker: %v", result.Records)
+	}
+
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+	if tm.CurrentItemsCount != 0 || tm.CurrentSizeBytes != 0 {
+		t.Fatalf("unexpected non-zero metrics for nil tracker: %+v", tm)
+	}
+}
+
+func TestTracker_AddAndGetTop(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+
+	tr.Add([]byte("metric_a"), 5)
+	tr.Add([]byte("metric_b"), 20)
+	tr.Add([]byte("metric_c"), 1)
+	tr.Add([]byte("metric_a"), 3) // second drop for the same metric name must accumulate
+
+	result := tr.GetTop(10)
+	if result.TotalRecords != 3 {
+		t.Fatalf("unexpected TotalRecords; got %d; want 3", result.TotalRecords)
+	}
+	if len(result.Records) != 3 {
+		t.Fatalf("unexpected number of records; got %d; want 3", len(result.Records))
+	}
+
+	// Records must be sorted by DroppedRowsCount descending.
+	wantOrder := []Record{
+		{MetricName: "metric_b", DroppedRowsCount: 20},
+		{MetricName: "metric_a", DroppedRowsCount: 8},
+		{MetricName: "metric_c", DroppedRowsCount: 1},
+	}
+	for i, want := range wantOrder {
+		got := result.Records[i]
+		if got != want {
+			t.Fatalf("unexpected record at position %d; got %+v; want %+v", i, got, want)
+		}
+	}
+}
+
+func TestTracker_GetTopLimit(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+	for i := 0; i < 10; i++ {
+		tr.Add([]byte(fmt.Sprintf("metric_%02d", i)), uint64(i+1))
+	}
+
+	result := tr.GetTop(3)
+	if len(result.Records) != 3 {
+		t.Fatalf("unexpected number of records; got %d; want 3", len(result.Records))
+	}
+	if result.TotalRecords != 10 {
+		t.Fatalf("unexpected TotalRecords; got %d; want 10", result.TotalRecords)
+	}
+	// top-3 must be metric_09 (10), metric_08 (9), metric_07 (8)
+	wantNames := []string{"metric_09", "metric_08", "metric_07"}
+	for i, want := range wantNames {
+		if result.Records[i].MetricName != want {
+			t.Fatalf("unexpected metric name at position %d; got %q; want %q", i, result.Records[i].MetricName, want)
+		}
+	}
+}
+
+func TestTracker_MultipleMetricNames(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+	names := []string{"cpu_usage", "mem_usage", "disk_io", "network_bytes"}
+	for i, name := range names {
+		for j := 0; j <= i; j++ {
+			tr.Add([]byte(name), 1)
+		}
+	}
+
+	result := tr.GetTop(-1)
+	if len(result.Records) != len(names) {
+		t.Fatalf("unexpected number of records; got %d; want %d", len(result.Records), len(names))
+	}
+	counts := make(map[string]uint64)
+	for _, r := range result.Records {
+		counts[r.MetricName] = r.DroppedRowsCount
+	}
+	for i, name := range names {
+		if counts[name] != uint64(i+1) {
+			t.Fatalf("unexpected count for %q; got %d; want %d", name, counts[name], i+1)
+		}
+	}
+}
+
+func TestTracker_MemoryBoundIsRespected(t *testing.T) {
+	// Allow only a handful of entries.
+	maxSizeBytes := uint64(5 * (entryOverheadBytes + 16))
+	tr := NewTracker(maxSizeBytes)
+
+	const totalMetrics = 100000
+	for i := 0; i < totalMetrics; i++ {
+		tr.Add([]byte(fmt.Sprintf("metric_name_with_some_length_%d", i)), 1)
+	}
+
+	var tm TrackerMetrics
+	tr.UpdateMetrics(&tm)
+
+	if tm.CurrentSizeBytes > maxSizeBytes {
+		t.Fatalf("tracker exceeded its memory bound: currentSizeBytes=%d, maxSizeBytes=%d", tm.CurrentSizeBytes, maxSizeBytes)
+	}
+	if tm.CurrentItemsCount >= totalMetrics {
+		t.Fatalf("tracker should have refused to track all %d distinct metric names given the configured bound; tracked %d", totalMetrics, tm.CurrentItemsCount)
+	}
+	// Sanity: the bound is small enough that only a handful of entries should have been accepted.
+	if tm.CurrentItemsCount == 0 {
+		t.Fatalf("expected at least one tracked metric name")
+	}
+	if tm.CurrentItemsCount > 10 {
+		t.Fatalf("expected the tracker to accept only a handful of entries given the tight bound; got %d", tm.CurrentItemsCount)
+	}
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(1024 * 1024)
+	tr.Add([]byte("metric_a"), 5)
+	tr.Add([]byte("metric_b"), 7)
+
+	before := tr.GetTop(10)
+	if len(before.Records) != 2 {
+		t.Fatalf("unexpected number of records before reset; got %d; want 2", len(before.Records))
+	}
+
+	tr.Reset()
+
+	after := tr.GetTop(10)
+	if len(after.Records) != 0 {
+		t.Fatalf("unexpected number of records after reset; got %d; want 0", len(after.Records))
+	}
+	if after.CollectedSinceTs < before.CollectedSinceTs {
+		t.Fatalf("CollectedSinceTs must not go backwards after reset")
+	}
+
+	// Tracker must be usable again after reset.
+	tr.Add([]byte("metric_c"), 1)
+	afterAdd := tr.GetTop(10)
+	if len(afterAdd.Records) != 1 || afterAdd.Records[0].MetricName != "metric_c" {
+		t.Fatalf("unexpected records after reset+add: %v", afterAdd.Records)
+	}
+}
