new file mode 100644
index 0000000..b75cf3f
--- /dev/null
+++ b/app/vmselect/stats/dropped_series_stats_test.go
@@ -0,0 +1,85 @@
+package stats
+
+import (
+	"encoding/json"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/querytracer"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/storage/droppedseriesstats"
+)
+
+func TestWriteDroppedSeriesStatsResponse(t *testing.T) {
+	stats := &droppedseriesstats.StatsResult{
+		CollectedSinceTs: 12345,
+		TotalRecords:     2,
+		CurrentSizeBytes: 128,
+		MaxSizeBytes:     4096,
+		Records: []droppedseriesstats.Record{
+			{MetricName: "cpu_usage", DroppedRowsCount: 42},
+			{MetricName: "mem_usage", DroppedRowsCount: 7},
+		},
+	}
+
+	w := httptest.NewRecorder()
+	WriteDroppedSeriesStatsResponse(w, stats, querytracer.New(false, ""))
+
+	var parsed struct {
+		Status                         string `json:"status"`
+		StatsCollectedSince            uint64 `json:"statsCollectedSince"`
+		StatsCollectedRecordsTotal     uint64 `json:"statsCollectedRecordsTotal"`
+		TrackerMemoryMaxSizeBytes      uint64 `json:"trackerMemoryMaxSizeBytes"`
+		TrackerCurrentMemoryUsageBytes uint64 `json:"trackerCurrentMemoryUsageBytes"`
+		Records                        []struct {
+			MetricName       string `json:"metricName"`
+			DroppedRowsCount uint64 `json:"droppedRowsCount"`
+		} `json:"records"`
+	}
+	if err := json.Unmarshal(w.Body.Bytes(), &parsed); err != nil {
+		t.Fatalf("cannot unmarshal response: %s; body=%s", err, w.Body.String())
+	}
+
+	if parsed.Status != "success" {
+		t.Fatalf("unexpected status: %q", parsed.Status)
+	}
+	if parsed.StatsCollectedSince != stats.CollectedSinceTs {
+		t.Fatalf("unexpected statsCollectedSince: got %d, want %d", parsed.StatsCollectedSince, stats.CollectedSinceTs)
+	}
+	if parsed.StatsCollectedRecordsTotal != stats.TotalRecords {
+		t.Fatalf("unexpected statsCollectedRecordsTotal: got %d, want %d", parsed.StatsCollectedRecordsTotal, stats.TotalRecords)
+	}
+	if parsed.TrackerMemoryMaxSizeBytes != stats.MaxSizeBytes {
+		t.Fatalf("unexpected trackerMemoryMaxSizeBytes: got %d, want %d", parsed.TrackerMemoryMaxSizeBytes, stats.MaxSizeBytes)
+	}
+	if parsed.TrackerCurrentMemoryUsageBytes != stats.CurrentSizeBytes {
+		t.Fatalf("unexpected trackerCurrentMemoryUsageBytes: got %d, want %d", parsed.TrackerCurrentMemoryUsageBytes, stats.CurrentSizeBytes)
+	}
+	if len(parsed.Records) != len(stats.Records) {
+		t.Fatalf("unexpected number of records: got %d, want %d", len(parsed.Records), len(stats.Records))
+	}
+	for i, want := range stats.Records {
+		got := parsed.Records[i]
+		if got.MetricName != want.MetricName || got.DroppedRowsCount != want.DroppedRowsCount {
+			t.Fatalf("unexpected record at %d: got %+v, want %+v", i, got, want)
+		}
+	}
+}
+
+func TestWriteDroppedSeriesStatsResponse_Empty(t *testing.T) {
+	stats := &droppedseriesstats.StatsResult{}
+
+	w := httptest.NewRecorder()
+	WriteDroppedSeriesStatsResponse(w, stats, querytracer.New(false, ""))
+
+	var parsed map[string]any
+	if err := json.Unmarshal(w.Body.Bytes(), &parsed); err != nil {
+		t.Fatalf("cannot unmarshal response: %s; body=%s", err, w.Body.String())
+	}
+	records, ok := parsed["records"].([]any)
+	if !ok {
+		t.Fatalf("expected records field to be an array, got %T", parsed["records"])
+	}
+	if len(records) != 0 {
+		t.Fatalf("expected no records, got %d", len(records))
+	}
+}
