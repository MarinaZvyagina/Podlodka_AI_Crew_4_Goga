diff --git a/lib/storage/droppedseriesstats/tracker.go b/lib/storage/droppedseriesstats/tracker.go
new file mode 100644
index 0000000..9473a11
--- /dev/null
+++ b/lib/storage/droppedseriesstats/tracker.go
@@ -0,0 +1,210 @@
+// Package droppedseriesstats tracks, per metric name, how many samples were
+// dropped because adding the corresponding series would have exceeded the
+// configured -storage.maxHourlySeries or -storage.maxDailySeries limit.
+//
+// The tracked state is kept purely in memory (it is meant for ad-hoc
+// troubleshooting of "why did series stop being written" support requests,
+// not for durable accounting) and is bounded by maxSizeBytes so that
+// installations with millions of distinct offending metric names cannot make
+// the tracker consume unbounded memory: once the bound is reached, counts for
+// already-tracked metric names keep growing, but new, previously unseen
+// metric names are silently not tracked until the tracker is Reset.
+package droppedseriesstats
+
+import (
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/bytesutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+const (
+	// metricNameBufSize is the size of batch allocations backing cloned metric names.
+	metricNameBufSize = 4 * 1024
+
+	// entryOverheadBytes is a rough estimate of the per-entry overhead of the
+	// map (bucket, pointer, atomic counter, string header) on top of the
+	// metric name bytes themselves. It is intentionally conservative so that
+	// the configured memory bound isn't exceeded in practice.
+	entryOverheadBytes = 64
+)
+
+// Tracker accumulates per-metric-name counts of dropped samples.
+//
+// It is safe for concurrent use. The nil *Tracker is valid and turns every
+// method into a no-op, so that the feature can be disabled with no overhead
+// on the ingestion hot path.
+type Tracker struct {
+	maxSizeBytes uint64
+
+	creationTs       atomic.Uint64
+	currentSizeBytes atomic.Uint64
+
+	mu             sync.Mutex
+	m              map[string]*atomic.Uint64
+	metricNamesBuf []byte
+
+	// getCurrentTs is overridden in tests.
+	getCurrentTs func() uint64
+}
+
+// NewTracker creates a Tracker whose memory usage for tracked metric names is
+// bounded by maxSizeBytes.
+func NewTracker(maxSizeBytes uint64) *Tracker {
+	t := &Tracker{
+		maxSizeBytes: maxSizeBytes,
+		getCurrentTs: fasttime.UnixTimestamp,
+	}
+	t.resetLocked()
+	return t
+}
+
+func (t *Tracker) resetLocked() {
+	t.m = make(map[string]*atomic.Uint64)
+	t.metricNamesBuf = nil
+	t.currentSizeBytes.Store(0)
+	t.creationTs.Store(t.getCurrentTs())
+}
+
+// Add increments the dropped-samples counter for the given metricName by n.
+//
+// Once the tracker's memory bound is reached, counters for previously unseen
+// metric names are no longer created; already-tracked metric names keep
+// accumulating.
+func (t *Tracker) Add(metricName []byte, n uint64) {
+	if t == nil {
+		return
+	}
+
+	t.mu.Lock()
+	cnt, ok := t.m[bytesutil.ToUnsafeString(metricName)]
+	if !ok {
+		entrySize := uint64(len(metricName)) + entryOverheadBytes
+		if t.currentSizeBytes.Load()+entrySize > t.maxSizeBytes {
+			// The tracker is full - do not track new metric names in order
+			// to bound memory usage. Samples dropped for metric names that
+			// didn't make it into the tracker are still reflected in the
+			// aggregate vm_hourly_series_limit_rows_dropped_total /
+			// vm_daily_series_limit_rows_dropped_total counters.
+			t.mu.Unlock()
+			return
+		}
+		name := t.cloneMetricNameLocked(metricName)
+		cnt = &atomic.Uint64{}
+		t.m[name] = cnt
+		t.currentSizeBytes.Add(entrySize)
+	}
+	t.mu.Unlock()
+
+	cnt.Add(n)
+}
+
+// cloneMetricNameLocked returns a copy of metricName that doesn't reference
+// the (possibly reused) caller-owned backing array. It must be called with
+// t.mu held.
+func (t *Tracker) cloneMetricNameLocked(metricName []byte) string {
+	if len(metricName) > metricNameBufSize {
+		b := make([]byte, len(metricName))
+		copy(b, metricName)
+		return bytesutil.ToUnsafeString(b)
+	}
+	idx := len(t.metricNamesBuf)
+	n := len(metricName) + len(t.metricNamesBuf)
+	if n > cap(t.metricNamesBuf) {
+		t.metricNamesBuf = make([]byte, 0, metricNameBufSize)
+		idx = 0
+	}
+	t.metricNamesBuf = append(t.metricNamesBuf, metricName...)
+	return bytesutil.ToUnsafeString(t.metricNamesBuf[idx:])
+}
+
+// Record is a single per-metric-name entry returned by GetTop.
+type Record struct {
+	// MetricName is the offending metric name (the value of its __name__ label).
+	MetricName string
+	// DroppedRowsCount is the number of samples dropped for this metric name
+	// because adding the corresponding series would have exceeded the
+	// configured hourly or daily series limit.
+	DroppedRowsCount uint64
+}
+
+// StatsResult is the result of a GetTop call.
+type StatsResult struct {
+	// CollectedSinceTs is the unix timestamp of the last Reset (or tracker creation).
+	CollectedSinceTs uint64
+	// TotalRecords is the total number of distinct metric names currently tracked.
+	TotalRecords uint64
+	// CurrentSizeBytes is the tracker's current, approximate memory usage.
+	CurrentSizeBytes uint64
+	// MaxSizeBytes is the tracker's configured memory bound.
+	MaxSizeBytes uint64
+	// Records holds up to `limit` records, sorted by DroppedRowsCount in descending order.
+	Records []Record
+}
+
+// GetTop returns the top `limit` metric names by dropped rows count.
+//
+// If limit <= 0, all tracked records are returned.
+func (t *Tracker) GetTop(limit int) StatsResult {
+	var result StatsResult
+	if t == nil {
+		return result
+	}
+
+	t.mu.Lock()
+	result.CollectedSinceTs = t.creationTs.Load()
+	result.TotalRecords = uint64(len(t.m))
+	result.CurrentSizeBytes = t.currentSizeBytes.Load()
+	result.MaxSizeBytes = t.maxSizeBytes
+	result.Records = make([]Record, 0, len(t.m))
+	for name, cnt := range t.m {
+		result.Records = append(result.Records, Record{
+			MetricName:       name,
+			DroppedRowsCount: cnt.Load(),
+		})
+	}
+	t.mu.Unlock()
+
+	sort.Slice(result.Records, func(i, j int) bool {
+		if result.Records[i].DroppedRowsCount != result.Records[j].DroppedRowsCount {
+			return result.Records[i].DroppedRowsCount > result.Records[j].DroppedRowsCount
+		}
+		return result.Records[i].MetricName < result.Records[j].MetricName
+	})
+	if limit > 0 && len(result.Records) > limit {
+		result.Records = result.Records[:limit]
+	}
+	return result
+}
+
+// Reset drops all the tracked stats and restarts the CollectedSinceTs window.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.resetLocked()
+	t.mu.Unlock()
+}
+
+// TrackerMetrics holds internal metrics to report.
+type TrackerMetrics struct {
+	CurrentSizeBytes  uint64
+	CurrentItemsCount uint64
+	MaxSizeBytes      uint64
+}
+
+// UpdateMetrics writes internal metrics of t to dst.
+func (t *Tracker) UpdateMetrics(dst *TrackerMetrics) {
+	if t == nil {
+		return
+	}
+	dst.CurrentSizeBytes = t.currentSizeBytes.Load()
+	dst.MaxSizeBytes = t.maxSizeBytes
+
+	t.mu.Lock()
+	dst.CurrentItemsCount = uint64(len(t.m))
+	t.mu.Unlock()
+}
