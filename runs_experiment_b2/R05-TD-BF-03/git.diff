diff --git a/app/vmselect/stats/dropped_series_stats.go b/app/vmselect/stats/dropped_series_stats.go
new file mode 100644
index 0000000..0f1faf6
--- /dev/null
+++ b/app/vmselect/stats/dropped_series_stats.go
@@ -0,0 +1,59 @@
+package stats
+
+import (
+	"fmt"
+	"net/http"
+	"strconv"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/app/vmselect/netstorage"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/querytracer"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/storage/droppedseriesstats"
+)
+
+// DroppedSeriesStatsHandler returns, per metric name, how many samples were
+// dropped because they exceeded -storage.maxHourlySeries or
+// -storage.maxDailySeries, collected since the last reset.
+func DroppedSeriesStatsHandler(qt *querytracer.Tracer, w http.ResponseWriter, r *http.Request) error {
+	limit := 1000
+	limitStr := r.FormValue("limit")
+	if len(limitStr) > 0 {
+		n, err := strconv.Atoi(limitStr)
+		if err != nil {
+			return fmt.Errorf("cannot parse `limit` arg %q: %w", limitStr, err)
+		}
+		if n > 0 {
+			limit = n
+		}
+	}
+	result, err := netstorage.GetDroppedSeriesStats(qt, limit)
+	if err != nil {
+		return err
+	}
+	WriteDroppedSeriesStatsResponse(w, &result, qt)
+	return nil
+}
+
+// ResetDroppedSeriesStatsHandler resets the dropped series stats tracker state.
+func ResetDroppedSeriesStatsHandler(qt *querytracer.Tracer) error {
+	return netstorage.ResetDroppedSeriesStats(qt)
+}
+
+// WriteDroppedSeriesStatsResponse writes stats as JSON to w.
+func WriteDroppedSeriesStatsResponse(w http.ResponseWriter, stats *droppedseriesstats.StatsResult, qt *querytracer.Tracer) {
+	w.Header().Set("Content-Type", "application/json")
+	fmt.Fprintf(w, `{"status":"success","statsCollectedSince":%d,"statsCollectedRecordsTotal":%d,`+
+		`"trackerMemoryMaxSizeBytes":%d,"trackerCurrentMemoryUsageBytes":%d,"records":[`,
+		stats.CollectedSinceTs, stats.TotalRecords, stats.MaxSizeBytes, stats.CurrentSizeBytes)
+	for i, rec := range stats.Records {
+		if i > 0 {
+			fmt.Fprint(w, `,`)
+		}
+		fmt.Fprintf(w, `{"metricName":%s,"droppedRowsCount":%d}`, strconv.Quote(rec.MetricName), rec.DroppedRowsCount)
+	}
+	fmt.Fprint(w, `]`)
+	qt.Done()
+	if traceJSON := qt.ToJSON(); traceJSON != "" {
+		fmt.Fprintf(w, `,"trace":%s`, traceJSON)
+	}
+	fmt.Fprint(w, `}`)
+}
