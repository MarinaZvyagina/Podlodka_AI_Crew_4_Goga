+// TestV3AuthEmptyPasswordUserAdd ensures a blank password is rejected on user creation
+// unless the request explicitly opts the account into no-password mode, and that this
+// holds over the raw gRPC AuthClient — independent of any particular SDK or CLI.
+func TestV3AuthEmptyPasswordUserAdd(t *testing.T) {
+	integration.BeforeTest(t)
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	api := integration.ToGRPC(clus.Client(0))
+
+	_, err := api.Auth.UserAdd(t.Context(), &pb.AuthUserAddRequest{Name: "blank-pw-user"})
+	require.Truef(t, eqErrGRPC(err, rpctypes.ErrGRPCPasswordEmpty), "got %v, expected %v", err, rpctypes.ErrGRPCPasswordEmpty)
+
+	// a request that explicitly opts into no-password mode is unaffected
+	_, err = api.Auth.UserAdd(t.Context(), &pb.AuthUserAddRequest{
+		Name:    "nopass-user",
+		Options: &authpb.UserAddOptions{NoPassword: true},
+	})
+	require.NoError(t, err)
+}
+
+// TestV3AuthEmptyPasswordUserChangePassword ensures changing an existing user's password to
+// blank is rejected the same way, unless that account is already a no-password account.
+func TestV3AuthEmptyPasswordUserChangePassword(t *testing.T) {
+	integration.BeforeTest(t)
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	api := integration.ToGRPC(clus.Client(0))
+
+	_, err := api.Auth.UserAdd(t.Context(), &pb.AuthUserAddRequest{Name: "pw-user", Password: "secret123"})
+	require.NoError(t, err)
+
+	_, err = api.Auth.UserChangePassword(t.Context(), &pb.AuthUserChangePasswordRequest{Name: "pw-user"})
+	require.Truef(t, eqErrGRPC(err, rpctypes.ErrGRPCPasswordEmpty), "got %v, expected %v", err, rpctypes.ErrGRPCPasswordEmpty)
+
+	_, err = api.Auth.UserAdd(t.Context(), &pb.AuthUserAddRequest{
+		Name:    "nopass-change-user",
+		Options: &authpb.UserAddOptions{NoPassword: true},
+	})
+	require.NoError(t, err)
+	_, err = api.Auth.UserChangePassword(t.Context(), &pb.AuthUserChangePasswordRequest{Name: "nopass-change-user"})
+	require.NoError(t, err)
+}
