+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package txn
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/lease"
+)
+
+// leaseLimitFakeLessor lets tests control Lookup/GetLease precisely, unlike
+// the shared lease.FakeLessor (whose Lookup/GetLease always report leases as
+// empty, which is not useful for exercising the key-limit check).
+type leaseLimitFakeLessor struct {
+	lease.FakeLessor
+	lease   *lease.Lease
+	current lease.LeaseID // the LeaseID GetLease reports the requested key already belongs to
+}
+
+func (l *leaseLimitFakeLessor) Lookup(id lease.LeaseID) *lease.Lease {
+	if l.lease != nil && l.lease.ID == id {
+		return l.lease
+	}
+	return nil
+}
+
+func (l *leaseLimitFakeLessor) GetLease(lease.LeaseItem) lease.LeaseID {
+	return l.current
+}
+
+func newLeaseWithNKeys(id lease.LeaseID, n int) *lease.Lease {
+	l := lease.NewLease(id, 0)
+	for i := 0; i < n; i++ {
+		l.SetLeaseItem(lease.LeaseItem{Key: fmt.Sprintf("key-%d", i)})
+	}
+	return l
+}
+
+func TestCheckLeaseKeyLimit(t *testing.T) {
+	const limit = 3
+
+	t.Run("new key rejected once lease is at the limit", func(t *testing.T) {
+		fl := &leaseLimitFakeLessor{lease: newLeaseWithNKeys(1, limit)}
+		p := &pb.PutRequest{Key: []byte("new-key"), Lease: 1}
+		err := checkLeaseKeyLimit(fl, p, limit, make(map[lease.LeaseID]map[string]struct{}))
+		if !errors.Is(err, lease.ErrTooManyKeys) {
+			t.Fatalf("expected ErrTooManyKeys, got %v", err)
+		}
+	})
+
+	t.Run("re-attaching a key already on the lease is always allowed", func(t *testing.T) {
+		fl := &leaseLimitFakeLessor{lease: newLeaseWithNKeys(1, limit), current: 1}
+		p := &pb.PutRequest{Key: []byte("key-0"), Lease: 1}
+		if err := checkLeaseKeyLimit(fl, p, limit, make(map[lease.LeaseID]map[string]struct{})); err != nil {
+			t.Fatalf("expected no error, got %v", err)
+		}
+	})
+
+	t.Run("cumulative growth within one request is capped", func(t *testing.T) {
+		fl := &leaseLimitFakeLessor{lease: newLeaseWithNKeys(2, limit-1)} // one slot free
+		reserved := make(map[lease.LeaseID]map[string]struct{})
+
+		p1 := &pb.PutRequest{Key: []byte("first-new-key"), Lease: 2}
+		if err := checkLeaseKeyLimit(fl, p1, limit, reserved); err != nil {
+			t.Fatalf("first put in the request should fit in the remaining slot: %v", err)
+		}
+
+		p2 := &pb.PutRequest{Key: []byte("second-new-key"), Lease: 2}
+		if err := checkLeaseKeyLimit(fl, p2, limit, reserved); !errors.Is(err, lease.ErrTooManyKeys) {
+			t.Fatalf("second put should be rejected once the reserved slot from the same request is used, got %v", err)
+		}
+	})
+
+	t.Run("under the limit behaves as before", func(t *testing.T) {
+		fl := &leaseLimitFakeLessor{lease: newLeaseWithNKeys(3, limit-1)}
+		p := &pb.PutRequest{Key: []byte("room-for-one-more"), Lease: 3}
+		if err := checkLeaseKeyLimit(fl, p, limit, make(map[lease.LeaseID]map[string]struct{})); err != nil {
+			t.Fatalf("expected no error, got %v", err)
+		}
+	})
+
+	t.Run("IgnoreLease put is never rejected", func(t *testing.T) {
+		fl := &leaseLimitFakeLessor{lease: newLeaseWithNKeys(1, limit)}
+		p := &pb.PutRequest{Key: []byte("new-key"), IgnoreLease: true}
+		if err := checkLeaseKeyLimit(fl, p, limit, make(map[lease.LeaseID]map[string]struct{})); err != nil {
+			t.Fatalf("expected no error, got %v", err)
+		}
+	})
+
+	t.Run("zero limit disables the check", func(t *testing.T) {
+		fl := &leaseLimitFakeLessor{lease: newLeaseWithNKeys(1, limit)}
+		p := &pb.PutRequest{Key: []byte("new-key"), Lease: 1}
+		if err := checkLeaseKeyLimit(fl, p, 0, make(map[lease.LeaseID]map[string]struct{})); err != nil {
+			t.Fatalf("expected no error, got %v", err)
+		}
+	})
+}
