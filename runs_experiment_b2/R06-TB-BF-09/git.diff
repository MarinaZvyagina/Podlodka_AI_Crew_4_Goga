+// checkLeaseKeyLimit rejects a put that would attach a new, distinct key to a
+// lease that has already reached maxLeaseKeys. A maxLeaseKeys of 0 (or less)
+// disables the check. Re-attaching a key that is already on the target lease
+// never counts as growth and is always allowed, which also covers the
+// IgnoreLease case: the effective lease for such a put is always the key's
+// current lease, so it can never grow the lease's key count.
+//
+// reservedLeaseKeys accumulates the keys tentatively counted against a lease
+// by earlier calls within the same request (a Txn may batch many puts against
+// the same lease before any of them actually attach), so growth is capped
+// cumulatively across the whole request rather than per individual put.
+func checkLeaseKeyLimit(lessor lease.Lessor, p *pb.PutRequest, maxLeaseKeys int, reservedLeaseKeys map[lease.LeaseID]map[string]struct{}) error {
+	if maxLeaseKeys <= 0 || p.IgnoreLease {
+		return nil
+	}
+	leaseID := lease.LeaseID(p.Lease)
+	if leaseID == lease.NoLease {
+		return nil
+	}
+	item := lease.LeaseItem{Key: string(p.Key)}
+	if lessor.GetLease(item) == leaseID {
+		return nil
+	}
+	pending := reservedLeaseKeys[leaseID]
+	if _, ok := pending[item.Key]; ok {
+		return nil
+	}
+	l := lessor.Lookup(leaseID)
+	if l == nil {
+		return lease.ErrLeaseNotFound
+	}
+	if l.Len()+len(pending) >= maxLeaseKeys {
+		return lease.ErrTooManyKeys
+	}
+	if pending == nil {
+		pending = make(map[string]struct{})
+		reservedLeaseKeys[leaseID] = pending
+	}
+	pending[item.Key] = struct{}{}
+	return nil
+}
