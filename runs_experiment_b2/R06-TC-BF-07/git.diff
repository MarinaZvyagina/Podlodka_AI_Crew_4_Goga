+// limitations under the License.
+
+package v3rpc
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"go.uber.org/zap"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+	"go.etcd.io/etcd/server/v3/etcdserver"
+)
+
+// auditOperation categorizes a key-value request for the compliance audit trail.
+type auditOperation string
+
+const (
+	auditOperationRead        auditOperation = "read"
+	auditOperationWrite       auditOperation = "write"
+	auditOperationDelete      auditOperation = "delete"
+	auditOperationTransaction auditOperation = "transaction"
+)
+
+// auditUnauthenticatedIdentity is recorded as the caller identity when
+// authentication is disabled or no identity can be resolved for a request.
+const auditUnauthenticatedIdentity = "unauthenticated"
+
+// auditKeyRange is a single key, or [key, rangeEnd) key range, touched by an
+// audited request.
+type auditKeyRange struct {
+	key      []byte
+	rangeEnd []byte
+}
+
+// auditServer is the subset of EtcdServer the audit decorator depends on:
+// caller identity resolution and the logger every audit record is written to.
+type auditServer interface {
+	AuthInfoFromCtx(ctx context.Context) (*auth.AuthInfo, error)
+	Logger() *zap.Logger
+}
+
+// auditKVServer decorates a KVServer with a compliance audit record — caller
+// identity, operation kind, key/range, duration, and outcome — for every
+// Range, Put, DeleteRange, and Txn call. It wraps the whole call so the
+// record reflects the final outcome after any inner decorator (quota, auth)
+// has run, and it never alters the wrapped request or response.
+type auditKVServer struct {
+	pb.KVServer
+	s auditServer
+}
+
+// NewAuditKVServer wraps next with the compliance audit decorator described
+// on auditKVServer.
+func NewAuditKVServer(next pb.KVServer, s *etcdserver.EtcdServer) pb.KVServer {
+	return &auditKVServer{next, s}
+}
+
+func (a *auditKVServer) Range(ctx context.Context, r *pb.RangeRequest) (resp *pb.RangeResponse, err error) {
+	start := time.Now()
+	defer func() {
+		a.record(ctx, auditOperationRead, []auditKeyRange{{r.Key, r.RangeEnd}}, start, err)
+	}()
+	return a.KVServer.Range(ctx, r)
+}
+
+func (a *auditKVServer) Put(ctx context.Context, r *pb.PutRequest) (resp *pb.PutResponse, err error) {
+	start := time.Now()
+	defer func() {
+		a.record(ctx, auditOperationWrite, []auditKeyRange{{r.Key, nil}}, start, err)
+	}()
+	return a.KVServer.Put(ctx, r)
+}
+
+func (a *auditKVServer) DeleteRange(ctx context.Context, r *pb.DeleteRangeRequest) (resp *pb.DeleteRangeResponse, err error) {
+	start := time.Now()
+	defer func() {
+		a.record(ctx, auditOperationDelete, []auditKeyRange{{r.Key, r.RangeEnd}}, start, err)
+	}()
+	return a.KVServer.DeleteRange(ctx, r)
+}
+
+func (a *auditKVServer) Txn(ctx context.Context, r *pb.TxnRequest) (resp *pb.TxnResponse, err error) {
+	start := time.Now()
+	defer func() {
+		a.record(ctx, auditOperationTransaction, auditTxnKeyRanges(r), start, err)
+	}()
+	return a.KVServer.Txn(ctx, r)
+}
+
+// record writes one audit log entry. It never returns an error and never
+// touches the request/response being audited, so it cannot change the
+// outcome of the call it instruments.
+func (a *auditKVServer) record(ctx context.Context, op auditOperation, krs []auditKeyRange, start time.Time, err error) {
+	lg := a.s.Logger()
+	if lg == nil {
+		return
+	}
+
+	fields := []zap.Field{
+		zap.String("identity", a.identity(ctx)),
+		zap.String("operation", string(op)),
+		zap.Strings("key ranges", formatAuditKeyRanges(krs)),
+		zap.Duration("duration", time.Since(start)),
+		zap.Bool("success", err == nil),
+	}
+	if err != nil {
+		fields = append(fields, zap.Error(err))
+	}
+	lg.Info("kv audit", fields...)
+}
+
+func (a *auditKVServer) identity(ctx context.Context) string {
+	authInfo, err := a.s.AuthInfoFromCtx(ctx)
+	return auditIdentity(authInfo, err)
+}
+
+// auditIdentity resolves the caller identity to record for an audit entry,
+// falling back to auditUnauthenticatedIdentity whenever authentication is
+// disabled, absent, or could not be resolved.
+func auditIdentity(authInfo *auth.AuthInfo, err error) string {
+	if err != nil || authInfo == nil || authInfo.Username == "" {
+		return auditUnauthenticatedIdentity
+	}
+	return authInfo.Username
+}
+
+// auditTxnKeyRanges collects every key and key range a Txn request may touch:
+// its compare conditions plus, recursively, the range/put/delete-range/txn
+// operations in both its success and failure branches.
+func auditTxnKeyRanges(r *pb.TxnRequest) []auditKeyRange {
+	var krs []auditKeyRange
+	for _, c := range r.GetCompare() {
+		krs = append(krs, auditKeyRange{c.GetKey(), c.GetRangeEnd()})
+	}
+	krs = append(krs, auditRequestOpKeyRanges(r.GetSuccess())...)
+	krs = append(krs, auditRequestOpKeyRanges(r.GetFailure())...)
+	return krs
+}
+
+func auditRequestOpKeyRanges(ops []*pb.RequestOp) []auditKeyRange {
+	var krs []auditKeyRange
+	for _, op := range ops {
+		switch {
+		case op.GetRequestRange() != nil:
+			r := op.GetRequestRange()
+			krs = append(krs, auditKeyRange{r.Key, r.RangeEnd})
+		case op.GetRequestPut() != nil:
+			krs = append(krs, auditKeyRange{op.GetRequestPut().Key, nil})
+		case op.GetRequestDeleteRange() != nil:
+			r := op.GetRequestDeleteRange()
+			krs = append(krs, auditKeyRange{r.Key, r.RangeEnd})
+		case op.GetRequestTxn() != nil:
+			krs = append(krs, auditTxnKeyRanges(op.GetRequestTxn())...)
+		}
+	}
+	return krs
+}
+
+func formatAuditKeyRanges(krs []auditKeyRange) []string {
+	out := make([]string, len(krs))
+	for i, kr := range krs {
+		out[i] = formatAuditKeyRange(kr)
+	}
+	return out
+}
+
+func formatAuditKeyRange(kr auditKeyRange) string {
+	if len(kr.rangeEnd) == 0 {
+		return string(kr.key)
+	}
+	return fmt.Sprintf("[%s, %s)", kr.key, kr.rangeEnd)
+}
