+package v3rpc
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"go.uber.org/zap"
+	"go.uber.org/zap/zaptest/observer"
+	"google.golang.org/grpc/status"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+)
+
+func TestAuditIdentity(t *testing.T) {
+	tests := []struct {
+		name     string
+		authInfo *auth.AuthInfo
+		err      error
+		want     string
+	}{
+		{"authenticated user", &auth.AuthInfo{Username: "alice"}, nil, "alice"},
+		{"auth disabled, no info", nil, nil, auditUnauthenticatedIdentity},
+		{"lookup error", &auth.AuthInfo{Username: "alice"}, errors.New("boom"), auditUnauthenticatedIdentity},
+		{"empty username", &auth.AuthInfo{Username: ""}, nil, auditUnauthenticatedIdentity},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := auditIdentity(tt.authInfo, tt.err); got != tt.want {
+				t.Errorf("auditIdentity() = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestFormatAuditKeyRange(t *testing.T) {
+	tests := []struct {
+		name string
+		kr   auditKeyRange
+		want string
+	}{
+		{"single key", auditKeyRange{key: []byte("foo")}, "foo"},
+		{"range", auditKeyRange{key: []byte("a"), rangeEnd: []byte("z")}, "[a, z)"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := formatAuditKeyRange(tt.kr); got != tt.want {
+				t.Errorf("formatAuditKeyRange() = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestAuditTxnKeyRanges(t *testing.T) {
+	txn := &pb.TxnRequest{
+		Compare: []*pb.Compare{{Key: []byte("cmp")}},
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("put")}}},
+			{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("nested"), RangeEnd: []byte("nested_end")}}},
+				},
+			}}},
+		},
+		Failure: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("del"), RangeEnd: []byte("del_end")}}},
+		},
+	}
+
+	got := formatAuditKeyRanges(auditTxnKeyRanges(txn))
+	want := []string{"cmp", "put", "[nested, nested_end)", "[del, del_end)"}
+
+	if len(got) != len(want) {
+		t.Fatalf("auditTxnKeyRanges() = %v, want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Errorf("auditTxnKeyRanges()[%d] = %q, want %q", i, got[i], want[i])
+		}
+	}
+}
+
+// fakeAuditKVServer is a minimal pb.KVServer used to observe whether the
+// audit decorator calls through to the wrapped server unchanged.
+type fakeAuditKVServer struct {
+	pb.UnimplementedKVServer
+	rangeResp *pb.RangeResponse
+	putErr    error
+}
+
+func (f *fakeAuditKVServer) Range(context.Context, *pb.RangeRequest) (*pb.RangeResponse, error) {
+	return f.rangeResp, nil
+}
+
+func (f *fakeAuditKVServer) Put(context.Context, *pb.PutRequest) (*pb.PutResponse, error) {
+	return nil, f.putErr
+}
+
+// fakeAuditServer is a minimal auditServer used to drive the audit decorator
+// in isolation from a real EtcdServer.
+type fakeAuditServer struct {
+	lg       *zap.Logger
+	authInfo *auth.AuthInfo
+	authErr  error
+}
+
+func (f *fakeAuditServer) AuthInfoFromCtx(context.Context) (*auth.AuthInfo, error) {
+	return f.authInfo, f.authErr
+}
+
+func (f *fakeAuditServer) Logger() *zap.Logger { return f.lg }
+
+func TestAuditKVServerRecordsSuccess(t *testing.T) {
+	core, logs := observer.New(zap.InfoLevel)
+	inner := &fakeAuditKVServer{rangeResp: &pb.RangeResponse{Count: 3}}
+	a := &auditKVServer{
+		KVServer: inner,
+		s:        &fakeAuditServer{lg: zap.New(core), authInfo: &auth.AuthInfo{Username: "alice"}},
+	}
+
+	resp, err := a.Range(context.Background(), &pb.RangeRequest{Key: []byte("foo"), RangeEnd: []byte("fop")})
+	if err != nil {
+		t.Fatalf("Range() error = %v", err)
+	}
+	if resp != inner.rangeResp {
+		t.Fatalf("Range() response was altered by the audit decorator: got %v, want %v", resp, inner.rangeResp)
+	}
+
+	entries := logs.All()
+	if len(entries) != 1 {
+		t.Fatalf("expected 1 audit log entry, got %d", len(entries))
+	}
+	fields := entries[0].ContextMap()
+	if fields["identity"] != "alice" {
+		t.Errorf("identity = %v, want alice", fields["identity"])
+	}
+	if fields["operation"] != string(auditOperationRead) {
+		t.Errorf("operation = %v, want %v", fields["operation"], auditOperationRead)
+	}
+	if fields["success"] != true {
+		t.Errorf("success = %v, want true", fields["success"])
+	}
+}
+
+func TestAuditKVServerRecordsFailureAndUnauthenticated(t *testing.T) {
+	core, logs := observer.New(zap.InfoLevel)
+	wantErr := status.Error(1, "denied")
+	inner := &fakeAuditKVServer{putErr: wantErr}
+	a := &auditKVServer{
+		KVServer: inner,
+		s:        &fakeAuditServer{lg: zap.New(core)}, // auth disabled: no identity
+	}
+
+	_, err := a.Put(context.Background(), &pb.PutRequest{Key: []byte("foo")})
+	if !errors.Is(err, wantErr) {
+		t.Fatalf("Put() error = %v, want %v", err, wantErr)
+	}
+
+	entries := logs.All()
+	if len(entries) != 1 {
+		t.Fatalf("expected 1 audit log entry, got %d", len(entries))
+	}
+	fields := entries[0].ContextMap()
+	if fields["identity"] != auditUnauthenticatedIdentity {
+		t.Errorf("identity = %v, want %v", fields["identity"], auditUnauthenticatedIdentity)
+	}
+	if fields["operation"] != string(auditOperationWrite) {
+		t.Errorf("operation = %v, want %v", fields["operation"], auditOperationWrite)
+	}
+	if fields["success"] != false {
+		t.Errorf("success = %v, want false", fields["success"])
+	}
+}
