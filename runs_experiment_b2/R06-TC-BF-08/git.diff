+package v3rpc
+
+import (
+	"context"
+	"time"
+
+	"go.uber.org/zap"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+)
+
+// auditIdentitySource resolves the caller identity and logger an audit
+// record is written with. *etcdserver.EtcdServer satisfies this.
+type auditIdentitySource interface {
+	Logger() *zap.Logger
+	AuthInfoFromCtx(ctx context.Context) (*auth.AuthInfo, error)
+}
+
+// unauthenticatedIdentity is recorded as the audit caller identity when
+// authentication is disabled or no caller identity could be resolved from
+// the request context.
+const unauthenticatedIdentity = "unauthenticated"
+
+const (
+	auditOpRead        = "read"
+	auditOpWrite       = "write"
+	auditOpDelete      = "delete"
+	auditOpTransaction = "transaction"
+)
+
+// auditKVServer wraps a pb.KVServer to produce a uniform audit record for
+// every key-value read, write, delete, and transaction request, regardless
+// of which layers underneath (validation, quota, raft, auth) ultimately
+// handle it. It only observes the call and its outcome; it never alters the
+// request or response.
+type auditKVServer struct {
+	pb.UnsafeKVServer
+
+	kv pb.KVServer
+	s  auditIdentitySource
+}
+
+// NewAuditKVServer wraps kv so that every Range/RangeStream/Put/DeleteRange/
+// Txn call handled by the server produces an audit log record with caller
+// identity, operation kind, key/range, duration, and outcome. Wrap the
+// outermost KVServer decorator (e.g. the quota decorator) so the audit trail
+// also covers requests rejected by inner decorators.
+func NewAuditKVServer(kv pb.KVServer, s auditIdentitySource) pb.KVServer {
+	return &auditKVServer{kv: kv, s: s}
+}
+
+func (a *auditKVServer) Range(ctx context.Context, r *pb.RangeRequest) (*pb.RangeResponse, error) {
+	start := time.Now()
+	resp, err := a.kv.Range(ctx, r)
+	a.record(ctx, auditOpRead, r.GetKey(), r.GetRangeEnd(), start, err)
+	return resp, err
+}
+
+func (a *auditKVServer) RangeStream(r *pb.RangeRequest, rs pb.KV_RangeStreamServer) error {
+	start := time.Now()
+	err := a.kv.RangeStream(r, rs)
+	a.record(rs.Context(), auditOpRead, r.GetKey(), r.GetRangeEnd(), start, err)
+	return err
+}
+
+func (a *auditKVServer) Put(ctx context.Context, r *pb.PutRequest) (*pb.PutResponse, error) {
+	start := time.Now()
+	resp, err := a.kv.Put(ctx, r)
+	a.record(ctx, auditOpWrite, r.GetKey(), nil, start, err)
+	return resp, err
+}
+
+func (a *auditKVServer) DeleteRange(ctx context.Context, r *pb.DeleteRangeRequest) (*pb.DeleteRangeResponse, error) {
+	start := time.Now()
+	resp, err := a.kv.DeleteRange(ctx, r)
+	a.record(ctx, auditOpDelete, r.GetKey(), r.GetRangeEnd(), start, err)
+	return resp, err
+}
+
+func (a *auditKVServer) Txn(ctx context.Context, r *pb.TxnRequest) (*pb.TxnResponse, error) {
+	start := time.Now()
+	resp, err := a.kv.Txn(ctx, r)
+	// A transaction has no single key or range of its own: it bundles
+	// independently-keyed compare/success/failure operations.
+	a.record(ctx, auditOpTransaction, nil, nil, start, err)
+	return resp, err
+}
+
+func (a *auditKVServer) Compact(ctx context.Context, r *pb.CompactionRequest) (*pb.CompactionResponse, error) {
+	return a.kv.Compact(ctx, r)
+}
+
+func (a *auditKVServer) record(ctx context.Context, op string, key, rangeEnd []byte, start time.Time, err error) {
+	lg := a.s.Logger()
+	if lg == nil {
+		return
+	}
+
+	identity := unauthenticatedIdentity
+	if authInfo, aerr := a.s.AuthInfoFromCtx(ctx); aerr == nil && authInfo != nil && authInfo.Username != "" {
+		identity = authInfo.Username
+	}
+
+	fields := make([]zap.Field, 0, 6)
+	fields = append(fields,
+		zap.String("identity", identity),
+		zap.String("operation", op),
+		zap.Duration("duration", time.Since(start)),
+		zap.Bool("success", err == nil),
+	)
+	if len(key) > 0 {
+		fields = append(fields, zap.ByteString("key", key))
+	}
+	if len(rangeEnd) > 0 {
+		fields = append(fields, zap.ByteString("range-end", rangeEnd))
+	}
+	if err != nil {
+		fields = append(fields, zap.Error(err))
+	}
+	lg.Info("kv audit", fields...)
+}
