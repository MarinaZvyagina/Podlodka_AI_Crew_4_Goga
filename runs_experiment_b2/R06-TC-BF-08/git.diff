+package v3rpc
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+	"go.uber.org/zap/zaptest/observer"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+)
+
+// stubKVServer returns canned responses/errors without doing any real work,
+// so tests can assert the audit decorator passes them through unchanged.
+type stubKVServer struct {
+	pb.UnsafeKVServer
+
+	rangeResp *pb.RangeResponse
+	putResp   *pb.PutResponse
+	delResp   *pb.DeleteRangeResponse
+	txnResp   *pb.TxnResponse
+	err       error
+}
+
+func (s *stubKVServer) Range(context.Context, *pb.RangeRequest) (*pb.RangeResponse, error) {
+	return s.rangeResp, s.err
+}
+
+func (s *stubKVServer) RangeStream(*pb.RangeRequest, pb.KV_RangeStreamServer) error {
+	return s.err
+}
+
+func (s *stubKVServer) Put(context.Context, *pb.PutRequest) (*pb.PutResponse, error) {
+	return s.putResp, s.err
+}
+
+func (s *stubKVServer) DeleteRange(context.Context, *pb.DeleteRangeRequest) (*pb.DeleteRangeResponse, error) {
+	return s.delResp, s.err
+}
+
+func (s *stubKVServer) Txn(context.Context, *pb.TxnRequest) (*pb.TxnResponse, error) {
+	return s.txnResp, s.err
+}
+
+func (s *stubKVServer) Compact(context.Context, *pb.CompactionRequest) (*pb.CompactionResponse, error) {
+	return nil, s.err
+}
+
+// stubIdentitySource lets tests control the resolved caller identity and
+// capture emitted log records.
+type stubIdentitySource struct {
+	lg       *zap.Logger
+	authInfo *auth.AuthInfo
+	authErr  error
+}
+
+func (s *stubIdentitySource) Logger() *zap.Logger { return s.lg }
+
+func (s *stubIdentitySource) AuthInfoFromCtx(context.Context) (*auth.AuthInfo, error) {
+	return s.authInfo, s.authErr
+}
+
+func TestAuditKVServerRecordsCallerIdentity(t *testing.T) {
+	tests := []struct {
+		name     string
+		authInfo *auth.AuthInfo
+		authErr  error
+		want     string
+	}{
+		{name: "auth disabled", authInfo: nil, authErr: nil, want: unauthenticatedIdentity},
+		{name: "auth error", authInfo: &auth.AuthInfo{Username: "alice"}, authErr: errors.New("boom"), want: unauthenticatedIdentity},
+		{name: "empty username", authInfo: &auth.AuthInfo{Username: ""}, want: unauthenticatedIdentity},
+		{name: "authenticated", authInfo: &auth.AuthInfo{Username: "alice"}, want: "alice"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			core, logs := observer.New(zap.InfoLevel)
+			a := &auditKVServer{
+				kv: &stubKVServer{putResp: &pb.PutResponse{}},
+				s:  &stubIdentitySource{lg: zap.New(core), authInfo: tt.authInfo, authErr: tt.authErr},
+			}
+
+			resp, err := a.Put(context.Background(), &pb.PutRequest{Key: []byte("foo")})
+			require.NoError(t, err)
+			require.NotNil(t, resp)
+
+			entries := logs.All()
+			require.Len(t, entries, 1)
+			ctxMap := entries[0].ContextMap()
+			assert.Equal(t, tt.want, ctxMap["identity"])
+		})
+	}
+}
+
+func TestAuditKVServerRecordsOperationKindAndKey(t *testing.T) {
+	core, logs := observer.New(zap.InfoLevel)
+	id := &stubIdentitySource{lg: zap.New(core)}
+	inner := &stubKVServer{
+		rangeResp: &pb.RangeResponse{},
+		putResp:   &pb.PutResponse{},
+		delResp:   &pb.DeleteRangeResponse{},
+		txnResp:   &pb.TxnResponse{},
+	}
+	a := &auditKVServer{kv: inner, s: id}
+
+	_, err := a.Range(context.Background(), &pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")})
+	require.NoError(t, err)
+	_, err = a.Put(context.Background(), &pb.PutRequest{Key: []byte("k")})
+	require.NoError(t, err)
+	_, err = a.DeleteRange(context.Background(), &pb.DeleteRangeRequest{Key: []byte("k"), RangeEnd: []byte("kz")})
+	require.NoError(t, err)
+	_, err = a.Txn(context.Background(), &pb.TxnRequest{})
+	require.NoError(t, err)
+
+	entries := logs.All()
+	require.Len(t, entries, 4)
+
+	wantOps := []string{auditOpRead, auditOpWrite, auditOpDelete, auditOpTransaction}
+	for i, want := range wantOps {
+		ctxMap := entries[i].ContextMap()
+		assert.Equal(t, want, ctxMap["operation"])
+		assert.Equal(t, true, ctxMap["success"])
+	}
+
+	assert.Equal(t, "a", entries[0].ContextMap()["key"])
+	assert.Equal(t, "z", entries[0].ContextMap()["range-end"])
+	assert.Equal(t, "k", entries[1].ContextMap()["key"])
+	assert.NotContains(t, entries[1].ContextMap(), "range-end")
+	assert.NotContains(t, entries[3].ContextMap(), "key")
+}
+
+func TestAuditKVServerRecordsFailureOutcomeAndPassesErrorThrough(t *testing.T) {
+	core, logs := observer.New(zap.InfoLevel)
+	wantErr := errors.New("permission denied")
+	a := &auditKVServer{
+		kv: &stubKVServer{err: wantErr},
+		s:  &stubIdentitySource{lg: zap.New(core)},
+	}
+
+	resp, err := a.Put(context.Background(), &pb.PutRequest{Key: []byte("k")})
+	assert.Nil(t, resp)
+	assert.Equal(t, wantErr, err)
+
+	entries := logs.All()
+	require.Len(t, entries, 1)
+	assert.Equal(t, false, entries[0].ContextMap()["success"])
+}
+
+func TestAuditKVServerDoesNotAlterResponse(t *testing.T) {
+	core, _ := observer.New(zap.InfoLevel)
+	want := &pb.PutResponse{Header: &pb.ResponseHeader{Revision: 42}}
+	a := &auditKVServer{
+		kv: &stubKVServer{putResp: want},
+		s:  &stubIdentitySource{lg: zap.New(core)},
+	}
+
+	got, err := a.Put(context.Background(), &pb.PutRequest{Key: []byte("k")})
+	require.NoError(t, err)
+	assert.Same(t, want, got)
+}
