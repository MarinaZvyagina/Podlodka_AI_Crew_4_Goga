+
+package v3rpc
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+)
+
+func TestAuditOperationKind(t *testing.T) {
+	tests := []struct {
+		fullMethod string
+		want       string
+	}{
+		{"/etcdserverpb.KV/Range", "read"},
+		{"/etcdserverpb.KV/Put", "write"},
+		{"/etcdserverpb.KV/DeleteRange", "delete"},
+		{"/etcdserverpb.KV/Txn", "transaction"},
+		{"/etcdserverpb.KV/Compact", "compact"},
+		{"NoSlashes", "noslashes"},
+	}
+	for _, tt := range tests {
+		assert.Equal(t, tt.want, auditOperationKind(tt.fullMethod), tt.fullMethod)
+	}
+}
+
+func TestAuditIdentity(t *testing.T) {
+	tests := []struct {
+		name     string
+		authInfo *auth.AuthInfo
+		err      error
+		want     string
+	}{
+		{"auth disabled", nil, nil, unauthenticatedIdentity},
+		{"lookup error", &auth.AuthInfo{Username: "root"}, errors.New("boom"), unauthenticatedIdentity},
+		{"empty username", &auth.AuthInfo{Username: ""}, nil, unauthenticatedIdentity},
+		{"authenticated", &auth.AuthInfo{Username: "alice"}, nil, "alice"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, auditIdentity(tt.authInfo, tt.err))
+		})
+	}
+}
+
+func TestAuditKeySpansSimpleRequests(t *testing.T) {
+	assert.Equal(t,
+		[]keySpan{{Key: []byte("a"), RangeEnd: []byte("z")}},
+		auditKeySpans(&pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}, &pb.RangeResponse{}))
+
+	assert.Equal(t,
+		[]keySpan{{Key: []byte("a")}},
+		auditKeySpans(&pb.PutRequest{Key: []byte("a")}, &pb.PutResponse{}))
+
+	assert.Equal(t,
+		[]keySpan{{Key: []byte("a"), RangeEnd: []byte("z")}},
+		auditKeySpans(&pb.DeleteRangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}, &pb.DeleteRangeResponse{}))
+
+	assert.Nil(t, auditKeySpans(&pb.AuthEnableRequest{}, &pb.AuthEnableResponse{}))
+}
+
+func TestAuditKeySpansTxn(t *testing.T) {
+	req := &pb.TxnRequest{
+		Compare: []*pb.Compare{
+			{Key: []byte("cmp"), RangeEnd: []byte("cmp-end")},
+		},
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("success-put")}}},
+			{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("success-range"), RangeEnd: []byte("success-range-end")}}},
+		},
+		Failure: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("failure-del")}}},
+		},
+	}
+
+	succeeded := auditKeySpans(req, &pb.TxnResponse{Succeeded: true})
+	assert.Equal(t, []keySpan{
+		{Key: []byte("cmp"), RangeEnd: []byte("cmp-end")},
+		{Key: []byte("success-put")},
+		{Key: []byte("success-range"), RangeEnd: []byte("success-range-end")},
+	}, succeeded)
+
+	failed := auditKeySpans(req, &pb.TxnResponse{Succeeded: false})
+	assert.Equal(t, []keySpan{
+		{Key: []byte("cmp"), RangeEnd: []byte("cmp-end")},
+		{Key: []byte("failure-del")},
+	}, failed)
+}
+
+func TestAuditKeySpansNestedTxn(t *testing.T) {
+	inner := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("nested-put")}}},
+		},
+	}
+	outer := &pb.TxnRequest{
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestTxn{RequestTxn: inner}},
+		},
+	}
+
+	assert.Equal(t, []keySpan{{Key: []byte("nested-put")}}, auditKeySpans(outer, &pb.TxnResponse{Succeeded: true}))
+}
