+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package v3rpc
+
+import (
+	"context"
+	"strings"
+	"time"
+
+	"go.uber.org/zap"
+	"google.golang.org/grpc"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+	"go.etcd.io/etcd/server/v3/etcdserver"
+)
+
+// kvServiceMethodPrefix is the gRPC full-method prefix shared by every method
+// of the KV service (Range, Put, DeleteRange, Txn, ...). Matching on the
+// service rather than enumerating individual method names means any KV
+// method added to the service in the future is audited automatically,
+// without editing this file.
+const kvServiceMethodPrefix = "/etcdserverpb.KV/"
+
+const unauthenticatedIdentity = "unauthenticated"
+
+// keyRanged is implemented by any protobuf message that carries a single
+// key, e.g. PutRequest, DeleteRangeRequest, RangeRequest, and Compare. It is
+// used to extract the audited key generically, so a future KV request
+// message following the same field convention is covered without adding a
+// case here.
+type keyRanged interface {
+	GetKey() []byte
+}
+
+// rangeEnded is implemented in addition to keyRanged by messages that carry
+// a [key, rangeEnd) span rather than a single key.
+type rangeEnded interface {
+	GetRangeEnd() []byte
+}
+
+// keySpan is a single key or [Key, RangeEnd) range touched by a KV request.
+type keySpan struct {
+	Key      []byte
+	RangeEnd []byte
+}
+
+// newAuditUnaryInterceptor returns a unary gRPC interceptor that records one
+// audit log entry for every request handled by the KV service: caller
+// identity, operation kind, key/range, duration, and outcome. It is wired
+// into the fixed interceptor chain in Server() below, so it covers every KV
+// request type uniformly and cannot be skipped by forgetting to instrument a
+// newly added request type by hand. It only observes the request/response
+// that already flow through the chain and never mutates them, so it cannot
+// change functional behavior or response content.
+func newAuditUnaryInterceptor(s *etcdserver.EtcdServer) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		if !strings.HasPrefix(info.FullMethod, kvServiceMethodPrefix) {
+			return handler(ctx, req)
+		}
+
+		start := time.Now()
+		resp, err := handler(ctx, req)
+		logKVAudit(s, ctx, info.FullMethod, start, req, resp, err)
+		return resp, err
+	}
+}
+
+func logKVAudit(s *etcdserver.EtcdServer, ctx context.Context, fullMethod string, start time.Time, req, resp any, err error) {
+	lg := s.Logger()
+	if lg == nil {
+		return
+	}
+
+	authInfo, aerr := s.AuthInfoFromCtx(ctx)
+
+	fields := []zap.Field{
+		zap.String("identity", auditIdentity(authInfo, aerr)),
+		zap.String("operation", auditOperationKind(fullMethod)),
+		zap.Duration("duration", time.Since(start)),
+		zap.Bool("success", err == nil),
+	}
+	for _, span := range auditKeySpans(req, resp) {
+		fields = append(fields, zap.ByteString("key", span.Key))
+		if len(span.RangeEnd) > 0 {
+			fields = append(fields, zap.ByteString("range_end", span.RangeEnd))
+		}
+	}
+	if err != nil {
+		fields = append(fields, zap.Error(err))
+	}
+
+	lg.Info("kv audit", fields...)
+}
+
+// auditIdentity reports the caller identity for an audit record: the
+// authenticated username, or unauthenticatedIdentity when auth is disabled,
+// no credentials were presented, or identity lookup failed.
+func auditIdentity(authInfo *auth.AuthInfo, err error) string {
+	if err != nil || authInfo == nil || authInfo.Username == "" {
+		return unauthenticatedIdentity
+	}
+	return authInfo.Username
+}
+
+// auditOperationKind maps a KV service gRPC method to the audited operation
+// kind. Methods not in this known set (e.g. a future addition to the KV
+// service) still produce an audit record — their operation kind is simply
+// the lowercased method name — rather than being silently dropped.
+func auditOperationKind(fullMethod string) string {
+	method := fullMethod
+	if i := strings.LastIndexByte(fullMethod, '/'); i >= 0 {
+		method = fullMethod[i+1:]
+	}
+	switch method {
+	case "Range":
+		return "read"
+	case "Put":
+		return "write"
+	case "DeleteRange":
+		return "delete"
+	case "Txn":
+		return "transaction"
+	default:
+		return strings.ToLower(method)
+	}
+}
+
+// auditKeySpans extracts every key or key range a KV request touches. Txn is
+// unwrapped recursively into the compare list and whichever branch actually
+// ran (per resp.GetSucceeded()); any other request is handled generically
+// through the keyRanged/rangeEnded interfaces.
+func auditKeySpans(req, resp any) []keySpan {
+	if txnReq, ok := req.(*pb.TxnRequest); ok {
+		txnResp, _ := resp.(*pb.TxnResponse)
+		return txnKeySpans(txnReq, txnResp)
+	}
+	if kr, ok := req.(keyRanged); ok {
+		return []keySpan{spanOf(kr)}
+	}
+	return nil
+}
+
+func txnKeySpans(req *pb.TxnRequest, resp *pb.TxnResponse) []keySpan {
+	var spans []keySpan
+	for _, cmp := range req.GetCompare() {
+		spans = append(spans, spanOf(cmp))
+	}
+
+	branch := req.GetSuccess()
+	if resp != nil && !resp.GetSucceeded() {
+		branch = req.GetFailure()
+	}
+	for _, op := range branch {
+		switch {
+		case op.GetRequestRange() != nil:
+			spans = append(spans, spanOf(op.GetRequestRange()))
+		case op.GetRequestPut() != nil:
+			spans = append(spans, spanOf(op.GetRequestPut()))
+		case op.GetRequestDeleteRange() != nil:
+			spans = append(spans, spanOf(op.GetRequestDeleteRange()))
+		case op.GetRequestTxn() != nil:
+			spans = append(spans, txnKeySpans(op.GetRequestTxn(), nil)...)
+		}
+	}
+	return spans
+}
+
+func spanOf(v keyRanged) keySpan {
+	span := keySpan{Key: v.GetKey()}
+	if re, ok := v.(rangeEnded); ok {
+		span.RangeEnd = re.GetRangeEnd()
+	}
+	return span
+}
