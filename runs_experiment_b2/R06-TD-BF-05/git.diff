+package readcache
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func rangeReq(key, end string) *pb.RangeRequest {
+	r := &pb.RangeRequest{Key: []byte(key)}
+	if end != "" {
+		r.RangeEnd = []byte(end)
+	}
+	return r
+}
+
+func TestGetMissOnEmptyCache(t *testing.T) {
+	c := New(16)
+	_, ok := c.Get(rangeReq("foo", ""))
+	assert.False(t, ok)
+}
+
+func TestAddThenGetHit(t *testing.T) {
+	c := New(16)
+	req := rangeReq("foo", "")
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}
+
+	epoch := c.StartRead()
+	c.Add(req, resp, epoch)
+
+	got, ok := c.Get(req)
+	require.True(t, ok)
+	assert.Equal(t, resp, got)
+}
+
+func TestGetIgnoresSerializableFlag(t *testing.T) {
+	c := New(16)
+	req := rangeReq("foo", "")
+	req.Serializable = false
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}
+
+	epoch := c.StartRead()
+	c.Add(req, resp, epoch)
+
+	serializableReq := rangeReq("foo", "")
+	serializableReq.Serializable = true
+	got, ok := c.Get(serializableReq)
+	require.True(t, ok)
+	assert.Equal(t, resp, got)
+}
+
+func TestAddRejectsWhenEpochAdvancedDuringRead(t *testing.T) {
+	c := New(16)
+	req := rangeReq("foo", "")
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}
+
+	epoch := c.StartRead()
+	// A write touching an overlapping (or any) range commits while the read
+	// that produced resp is still in flight.
+	c.Invalidate([]byte("foo"), nil)
+
+	c.Add(req, resp, epoch)
+
+	_, ok := c.Get(req)
+	assert.False(t, ok, "Add must not cache a result whose read raced a concurrent invalidation")
+}
+
+func TestInvalidateOnlyClearsOverlappingRanges(t *testing.T) {
+	c := New(16)
+
+	point := rangeReq("foo", "")
+	prefix := rangeReq("bar/", "bar0")
+	disjoint := rangeReq("zzz", "")
+
+	for _, req := range []*pb.RangeRequest{point, prefix, disjoint} {
+		epoch := c.StartRead()
+		c.Add(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}, epoch)
+	}
+
+	// Invalidate a key inside the "bar/"-"bar0" range and equal to "foo".
+	c.Invalidate([]byte("foo"), nil)
+	_, ok := c.Get(point)
+	assert.False(t, ok, "point entry overlapping the invalidated key must be evicted")
+
+	c.Invalidate([]byte("bar/x"), nil)
+	_, ok = c.Get(prefix)
+	assert.False(t, ok, "range entry overlapping the invalidated key must be evicted")
+
+	_, ok = c.Get(disjoint)
+	assert.True(t, ok, "entry with no overlap must survive unrelated invalidations")
+}
+
+func TestPinnedRevisionSurvivesInvalidateButNotCompact(t *testing.T) {
+	c := New(16)
+	req := rangeReq("foo", "")
+	req.Revision = 5
+	resp := &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 5}}
+
+	epoch := c.StartRead()
+	c.Add(req, resp, epoch)
+
+	c.Invalidate([]byte("foo"), nil)
+	got, ok := c.Get(req)
+	require.True(t, ok, "pinned-revision entries are immutable and must not be evicted by writes")
+	assert.Equal(t, resp, got)
+
+	c.Compact(5)
+	_, ok = c.Get(req)
+	assert.False(t, ok, "pinned-revision entries at or below the compacted revision must be evicted")
+}
+
+func TestCompactRejectsFutureAddsAtOrBelowRevision(t *testing.T) {
+	c := New(16)
+	c.Compact(10)
+
+	req := rangeReq("foo", "")
+	req.Revision = 10
+	epoch := c.StartRead()
+	c.Add(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 10}}, epoch)
+
+	_, ok := c.Get(req)
+	assert.False(t, ok)
+}
+
+func TestNilCacheIsSafeNoOp(t *testing.T) {
+	var c *Cache
+
+	_, ok := c.Get(rangeReq("foo", ""))
+	assert.False(t, ok)
+
+	assert.Equal(t, uint64(0), c.StartRead())
+
+	assert.NotPanics(t, func() {
+		c.Add(rangeReq("foo", ""), &pb.RangeResponse{}, 0)
+	})
+	assert.NotPanics(t, func() {
+		c.Invalidate([]byte("foo"), nil)
+	})
+	assert.NotPanics(t, func() {
+		c.Compact(1)
+	})
+	assert.Equal(t, 0, c.Size())
+}
+
+func TestSizeReflectsEntryCount(t *testing.T) {
+	c := New(16)
+	assert.Equal(t, 0, c.Size())
+
+	epoch := c.StartRead()
+	c.Add(rangeReq("foo", ""), &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}, epoch)
+	assert.Equal(t, 1, c.Size())
+}
