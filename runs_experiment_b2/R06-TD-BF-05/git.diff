+package apply
+
+import (
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/etcdserver/readcache"
+)
+
+// applierV3CacheInvalidate wraps an applierV3 and invalidates the server's
+// read cache synchronously, immediately after every write it forwards
+// succeeds, so a read observing the newly committed data can never find a
+// stale cache entry left over from before the write.
+type applierV3CacheInvalidate struct {
+	applierV3
+	cache *readcache.Cache
+}
+
+// newApplierV3CacheInvalidate wraps base so that every successful Put,
+// DeleteRange, Txn or Compaction it applies invalidates the matching range
+// in cache. Wrapping base directly (rather than an outer decorator) ensures
+// invalidation fires for every write that actually reaches the store,
+// regardless of which other decorators (auth, quota, ...) also wrap it.
+func newApplierV3CacheInvalidate(base applierV3, cache *readcache.Cache) applierV3 {
+	return &applierV3CacheInvalidate{applierV3: base, cache: cache}
+}
+
+func (a *applierV3CacheInvalidate) Put(p *pb.PutRequest) (*pb.PutResponse, *traceutil.Trace, error) {
+	resp, trace, err := a.applierV3.Put(p)
+	if err == nil {
+		a.cache.Invalidate(p.Key, nil)
+	}
+	return resp, trace, err
+}
+
+func (a *applierV3CacheInvalidate) DeleteRange(dr *pb.DeleteRangeRequest) (*pb.DeleteRangeResponse, *traceutil.Trace, error) {
+	resp, trace, err := a.applierV3.DeleteRange(dr)
+	if err == nil {
+		a.cache.Invalidate(dr.Key, dr.RangeEnd)
+	}
+	return resp, trace, err
+}
+
+func (a *applierV3CacheInvalidate) Txn(rt *pb.TxnRequest, skipRangeExecution bool) (*pb.TxnResponse, *traceutil.Trace, error) {
+	resp, trace, err := a.applierV3.Txn(rt, skipRangeExecution)
+	if err == nil {
+		invalidateTxnWrites(a.cache, rt, resp)
+	}
+	return resp, trace, err
+}
+
+func (a *applierV3CacheInvalidate) Compaction(compaction *pb.CompactionRequest) (*pb.CompactionResponse, <-chan struct{}, *traceutil.Trace, error) {
+	resp, ch, trace, err := a.applierV3.Compaction(compaction)
+	if err == nil {
+		a.cache.Compact(compaction.Revision)
+	}
+	return resp, ch, trace, err
+}
+
+// invalidateTxnWrites walks the branch of rt that actually executed
+// (Success if resp.Succeeded, else Failure, mirroring the selection logic in
+// server/etcdserver/txn.executeTxn) and invalidates the cache for every Put
+// or DeleteRange it contains, recursing into nested transactions using each
+// nested response's own Succeeded flag to pick its executed branch. Compare
+// clauses and RequestRange sub-operations are read-only and never need
+// invalidation.
+func invalidateTxnWrites(cache *readcache.Cache, rt *pb.TxnRequest, resp *pb.TxnResponse) {
+	reqs := rt.Success
+	if !resp.Succeeded {
+		reqs = rt.Failure
+	}
+	for i, req := range reqs {
+		if i >= len(resp.Responses) {
+			return
+		}
+		switch tv := req.Request.(type) {
+		case *pb.RequestOp_RequestPut:
+			cache.Invalidate(tv.RequestPut.Key, nil)
+		case *pb.RequestOp_RequestDeleteRange:
+			cache.Invalidate(tv.RequestDeleteRange.Key, tv.RequestDeleteRange.RangeEnd)
+		case *pb.RequestOp_RequestTxn:
+			if nested, ok := resp.Responses[i].Response.(*pb.ResponseOp_ResponseTxn); ok {
+				invalidateTxnWrites(cache, tv.RequestTxn, nested.ResponseTxn)
+			}
+		}
+	}
+}
