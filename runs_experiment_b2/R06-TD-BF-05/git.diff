diff --git a/server/etcdserver/readcache/CODEMANIFEST b/server/etcdserver/readcache/CODEMANIFEST
new file mode 100644
index 000000000..c0c10dcb2
--- /dev/null
+++ b/server/etcdserver/readcache/CODEMANIFEST
@@ -0,0 +1,85 @@
+Usages:
+  race_guard: |
+    A read is only cached if no `Invalidate` ran between the moment it started
+    reading the store (`StartRead`) and the moment it is ready to insert its
+    result (`Add`). Capture the epoch via `StartRead` before scanning the
+    store, then pass it back to `Add`. If the epoch changed in between, some
+    write may have raced the read, so the result must not be cached.
+
+Annotations: |
+  Use `race_guard` for `Add`.
+
+  Every method must be safe to call on a nil `*Cache` receiver, returning the
+  zero value / a miss / a no-op, so callers holding a possibly-unconfigured
+  cache never need a nil check.
+
+---
+
+"Cache()":
+  location: readcache.go
+  annotations: |
+    Caches RangeRequest/RangeResponse pairs for repeated identical reads,
+    invalidated by explicit range writes rather than time-based expiration.
+  methods:
+    "Get(req RangeRequest) -> resp:RangeResponse, ok:bool": |
+      Look up a previously cached response for `req`.
+
+      `req`: the range request being served
+      `resp`: the cached response, valid only when `ok` is true
+      `ok`: whether a usable cache entry was found
+
+      A request pinned to a historical revision that has since been
+      compacted away must report a miss (and be evicted), since the store
+      itself could no longer serve it either.
+    "StartRead() -> epoch:uint64": |
+      Return the current invalidation epoch.
+
+      `epoch`: must be captured before reading the store and passed back to
+      `Add`, per `race_guard`.
+    "Add(req RangeRequest, resp RangeResponse, startEpoch uint64)": |
+      Cache `resp` as the response for `req`, subject to `race_guard`.
+
+      `req`: the request that produced `resp`
+      `resp`: the response to cache
+      `startEpoch`: the epoch returned by `StartRead` before this read began
+
+      Algorithm:
+      1. If `req` is pinned to a historical revision, cache it unconditionally
+         (immutable data) unless that revision has already been compacted;
+         never register it for range invalidation.
+      2. Otherwise, if the current epoch no longer matches `startEpoch`, drop
+         the result without caching it.
+      3. Otherwise cache the result and register its key range so a future
+         `Invalidate` covering it can find and evict it.
+    "Invalidate(key []byte, end []byte)": |
+      Evict every cached entry whose range overlaps `[key, end)` and advance
+      the epoch.
+
+      `key`: start of the written/deleted range
+      `end`: exclusive end of the range, or empty for a single key
+
+      Must run synchronously on the write path, after the write is visible to
+      readers, so no read started afterward can find a stale entry.
+    "Compact(revision int64)": |
+      Record that revisions at or below `revision` are no longer servable by
+      the store.
+
+      `revision`: the compaction revision
+
+      Pinned-revision entries at or below it are evicted lazily, the next
+      time `Get` or `Add` observes them.
+    "Size() -> count:int": |
+      Return the number of entries currently cached.
+
+      `count`: current entry count
+
+---
+
+Author: Goga
+CreatedAt: 14/09/26
+Description: |
+  Read-through cache for the etcd server's own Range read path. Consumed by
+  `server/etcdserver` (populate/lookup on the read path) and
+  `server/etcdserver/apply` (invalidate on the write/apply path), so repeated
+  identical reads in a short burst skip the backend scan while writes are
+  reflected at least as promptly as an equivalent uncached read would be.
diff --git a/server/etcdserver/readcache/readcache.go b/server/etcdserver/readcache/readcache.go
new file mode 100644
index 000000000..e259db2bf
--- /dev/null
+++ b/server/etcdserver/readcache/readcache.go
@@ -0,0 +1,226 @@
+// Copyright 2025 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Package readcache caches RangeRequest/RangeResponse pairs for the etcd
+// server's own Range read path, invalidated synchronously off the write
+// apply path rather than by time-based expiration.
+package readcache
+
+import (
+	"sync"
+
+	"google.golang.org/protobuf/proto"
+	"k8s.io/utils/lru"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/pkg/v3/adt"
+)
+
+// DefaultMaxEntries bounds the number of cached RangeRequest/RangeResponse pairs.
+var DefaultMaxEntries = 2048
+
+// Cache maps RangeRequests to previously observed RangeResponses. A nil
+// *Cache is valid and behaves as an always-miss, no-op cache, so callers
+// need not nil-check before use.
+type Cache struct {
+	mu  sync.Mutex
+	lru *lru.Cache
+
+	// cachedRanges is a reverse index from key range to cache keys, used to
+	// invalidate every entry a write touches.
+	cachedRanges adt.IntervalTree
+
+	// epoch increases on every Invalidate call. A read may only populate the
+	// cache if no invalidation happened between the moment it started reading
+	// the store (StartRead) and the moment it is ready to cache the result
+	// (Add); otherwise it may be caching data a concurrent write already made
+	// stale, so it must be dropped rather than inserted.
+	epoch uint64
+
+	// compactedRev is the highest revision passed to Compact. Cached
+	// pinned-revision entries at or below it are no longer servable by the
+	// store and are lazily evicted on access.
+	compactedRev int64
+}
+
+// New builds an empty Cache bounded to maxEntries.
+func New(maxEntries int) *Cache {
+	return &Cache{
+		lru:          lru.New(maxEntries),
+		cachedRanges: adt.NewIntervalTree(),
+		compactedRev: -1,
+	}
+}
+
+// keyFunc returns the lookup key for a request, normalized so that a
+// serializable and a linearizable request for identical range parameters
+// share a cache entry (the consistency guarantee is enforced by the caller
+// before it ever calls Get/Add, not by the cached bytes themselves).
+func keyFunc(req *pb.RangeRequest) string {
+	normalized, ok := proto.Clone(req).(*pb.RangeRequest)
+	if !ok {
+		panic("readcache: proto.Clone did not return *pb.RangeRequest")
+	}
+	normalized.Serializable = false
+	b, err := proto.Marshal(normalized)
+	if err != nil {
+		panic(err)
+	}
+	return string(b)
+}
+
+// Get returns the cached response for req, if any. Entries pinned to a
+// revision that has since been compacted away are evicted and reported as a
+// miss, since the store itself could no longer serve them either.
+func (c *Cache) Get(req *pb.RangeRequest) (*pb.RangeResponse, bool) {
+	if c == nil {
+		return nil, false
+	}
+	key := keyFunc(req)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if req.Revision > 0 && req.Revision <= c.compactedRev {
+		c.lru.Remove(key)
+		return nil, false
+	}
+
+	v, ok := c.lru.Get(key)
+	if !ok {
+		return nil, false
+	}
+	return v.(*pb.RangeResponse), true
+}
+
+// StartRead returns the current invalidation epoch. Callers must capture it
+// before reading from the store and pass it back to Add, so Add can detect
+// whether a write invalidated the range being read while the read was still
+// in flight.
+func (c *Cache) StartRead() uint64 {
+	if c == nil {
+		return 0
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.epoch
+}
+
+// Add caches resp as the response for req, unless doing so could introduce
+// staleness:
+//   - for a request pinned to a historical revision (req.Revision != 0), the
+//     data is immutable, so it is cached unconditionally (subject only to
+//     compaction) and never registered for range invalidation.
+//   - for a request against the current revision (req.Revision == 0), the
+//     insert is accepted only if startEpoch still matches the current epoch,
+//     i.e. no write invalidated an overlapping range while the read that
+//     produced resp was in flight. A mismatch means a concurrent write may
+//     have raced the read, so the result is discarded rather than cached.
+func (c *Cache) Add(req *pb.RangeRequest, resp *pb.RangeResponse, startEpoch uint64) {
+	if c == nil {
+		return
+	}
+	key := keyFunc(req)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if req.Revision > 0 {
+		if req.Revision <= c.compactedRev {
+			return
+		}
+		c.lru.Add(key, resp)
+		return
+	}
+
+	if c.epoch != startEpoch {
+		// A write touching some range committed while this read was in
+		// flight; resp may already be stale. Drop it rather than risk
+		// caching data older than a live read would now return.
+		return
+	}
+
+	c.lru.Add(key, resp)
+
+	var ivl adt.Interval
+	if len(req.RangeEnd) != 0 {
+		ivl = adt.NewBytesAffineInterval(req.Key, req.RangeEnd)
+	} else {
+		ivl = adt.NewBytesAffinePoint(req.Key)
+	}
+
+	if iv := c.cachedRanges.Find(ivl); iv != nil {
+		val := iv.Val.(map[string]struct{})
+		val[key] = struct{}{}
+		iv.Val = val
+	} else {
+		c.cachedRanges.Insert(ivl, map[string]struct{}{key: {}})
+	}
+}
+
+// Invalidate drops every cached entry whose range overlaps [key, end) and
+// advances the epoch so that any read already in flight over an overlapping
+// range will refuse to populate the cache with what may now be stale data.
+// If end is empty, key is treated as a single point.
+func (c *Cache) Invalidate(key, end []byte) {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	c.epoch++
+
+	var ivl adt.Interval
+	if len(end) == 0 {
+		ivl = adt.NewBytesAffinePoint(key)
+	} else {
+		ivl = adt.NewBytesAffineInterval(key, end)
+	}
+
+	ivs := c.cachedRanges.Stab(ivl)
+	for _, iv := range ivs {
+		keys := iv.Val.(map[string]struct{})
+		for k := range keys {
+			c.lru.Remove(k)
+		}
+	}
+	// Delete after removing all keys, since deleting is destructive to ivs.
+	c.cachedRanges.Delete(ivl)
+}
+
+// Compact records that revisions at or below revision are no longer
+// servable by the store. Matching pinned-revision entries are evicted
+// lazily, on the next Get/Add that observes them.
+func (c *Cache) Compact(revision int64) {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if revision > c.compactedRev {
+		c.compactedRev = revision
+	}
+}
+
+// Size returns the number of entries currently cached.
+func (c *Cache) Size() int {
+	if c == nil {
+		return 0
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.lru.Len()
+}
