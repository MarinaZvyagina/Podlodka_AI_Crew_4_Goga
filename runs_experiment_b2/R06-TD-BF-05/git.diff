+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package integration
+
+import (
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	clientv3 "go.etcd.io/etcd/client/v3"
+	"go.etcd.io/etcd/tests/v3/framework/integration"
+)
+
+// TestV3KVReadCacheNeverStale exercises the server-side Range read cache: it
+// repeats identical Range requests (both linearizable and serializable) in a
+// short burst and asserts that a concurrent write is always reflected in the
+// very next read, for the written key as well as for a disjoint key that a
+// naive/global cache invalidation could have wrongly evicted.
+func TestV3KVReadCacheNeverStale(t *testing.T) {
+	integration.BeforeTest(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	client := clus.RandClient()
+	ctx := t.Context()
+
+	_, err := client.Put(ctx, "hot", "v1")
+	require.NoError(t, err)
+	_, err = client.Put(ctx, "unrelated", "u1")
+	require.NoError(t, err)
+
+	// Repeated identical linearizable reads before any write must all agree.
+	for i := 0; i < 5; i++ {
+		resp, err := client.Get(ctx, "hot")
+		require.NoError(t, err)
+		require.Len(t, resp.Kvs, 1)
+		require.Equal(t, "v1", string(resp.Kvs[0].Value))
+	}
+
+	// Repeated identical serializable reads before any write must all agree.
+	for i := 0; i < 5; i++ {
+		resp, err := client.Get(ctx, "hot", clientv3.WithSerializable())
+		require.NoError(t, err)
+		require.Len(t, resp.Kvs, 1)
+		require.Equal(t, "v1", string(resp.Kvs[0].Value))
+	}
+
+	_, err = client.Put(ctx, "hot", "v2")
+	require.NoError(t, err)
+
+	// The very next linearizable read must observe the new value, never v1.
+	resp, err := client.Get(ctx, "hot")
+	require.NoError(t, err)
+	require.Len(t, resp.Kvs, 1)
+	require.Equal(t, "v2", string(resp.Kvs[0].Value), "linearizable read must not return a cached value older than the write that just completed")
+
+	// The very next serializable read must also observe the new value.
+	resp, err = client.Get(ctx, "hot", clientv3.WithSerializable())
+	require.NoError(t, err)
+	require.Len(t, resp.Kvs, 1)
+	require.Equal(t, "v2", string(resp.Kvs[0].Value), "serializable read must not return a cached value older than the write that just completed")
+
+	// A write to "hot" must not have invalidated the disjoint "unrelated" key.
+	resp, err = client.Get(ctx, "unrelated")
+	require.NoError(t, err)
+	require.Len(t, resp.Kvs, 1)
+	require.Equal(t, "u1", string(resp.Kvs[0].Value))
+
+	// Repeated reads after the write must keep agreeing with each other and
+	// with the write, both linearizable and serializable.
+	for i := 0; i < 5; i++ {
+		resp, err := client.Get(ctx, "hot")
+		require.NoError(t, err)
+		require.Equal(t, "v2", string(resp.Kvs[0].Value))
+
+		resp, err = client.Get(ctx, "hot", clientv3.WithSerializable())
+		require.NoError(t, err)
+		require.Equal(t, "v2", string(resp.Kvs[0].Value))
+	}
+}
+
+// TestV3KVReadCacheConcurrentWritesNeverObserveStaleRevision hammers a single
+// key with concurrent linearizable Get and Put calls and asserts that the
+// observed revision for that key is always monotonically non-decreasing —
+// i.e. no read ever returns data staler than a revision already observed by
+// an earlier read, regardless of how reads and the cache race against writes.
+func TestV3KVReadCacheConcurrentWritesNeverObserveStaleRevision(t *testing.T) {
+	integration.BeforeTest(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 1})
+	defer clus.Terminate(t)
+
+	client := clus.RandClient()
+	ctx := t.Context()
+
+	_, err := client.Put(ctx, "race", "0")
+	require.NoError(t, err)
+
+	const writes = 50
+	done := make(chan struct{})
+	var wg sync.WaitGroup
+
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		defer close(done)
+		for i := 1; i <= writes; i++ {
+			_, err := client.Put(ctx, "race", string(rune('0'+(i%10))))
+			require.NoError(t, err)
+		}
+	}()
+
+	var maxSeenRev int64
+	readLoop := func() {
+		for {
+			select {
+			case <-done:
+				return
+			default:
+			}
+			resp, err := client.Get(ctx, "race")
+			require.NoError(t, err)
+			require.GreaterOrEqual(t, resp.Header.Revision, maxSeenRev,
+				"a later read observed an earlier revision than a previous read: stale cache data")
+			if resp.Header.Revision > maxSeenRev {
+				maxSeenRev = resp.Header.Revision
+			}
+			time.Sleep(time.Millisecond)
+		}
+	}
+
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		readLoop()
+	}()
+
+	wg.Wait()
+}
