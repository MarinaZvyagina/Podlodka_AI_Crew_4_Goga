+package apply
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+	"golang.org/x/crypto/bcrypt"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/pkg/v3/traceutil"
+	"go.etcd.io/etcd/server/v3/auth"
+	"go.etcd.io/etcd/server/v3/etcdserver/api/membership"
+	"go.etcd.io/etcd/server/v3/etcdserver/api/v3alarm"
+	"go.etcd.io/etcd/server/v3/etcdserver/cindex"
+	"go.etcd.io/etcd/server/v3/etcdserver/readcache"
+	"go.etcd.io/etcd/server/v3/lease"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+	"go.etcd.io/etcd/server/v3/storage/mvcc"
+	"go.etcd.io/etcd/server/v3/storage/schema"
+)
+
+// uberApplierWithCache builds a real UberApplier wired to the given cache,
+// mirroring defaultUberApplier's setup so Put/DeleteRange/Txn/Compaction
+// exercise the actual applierV3CacheInvalidate decorator against a real
+// mvcc store.
+func uberApplierWithCache(t *testing.T, cache *readcache.Cache) UberApplier {
+	lg := zaptest.NewLogger(t)
+	be, _ := betesting.NewDefaultTmpBackend(t)
+	t.Cleanup(func() {
+		betesting.Close(t, be)
+	})
+
+	cluster := membership.NewCluster(lg)
+	cluster.SetBackend(schema.NewMembershipBackend(lg, be))
+	cluster.AddMember(&membership.Member{ID: memberID}, true)
+	lessor := lease.NewLessor(lg, be, cluster, lease.LessorConfig{})
+	kv := mvcc.NewStore(lg, be, lessor, mvcc.StoreConfig{})
+	alarmStore, err := v3alarm.NewAlarmStore(lg, schema.NewAlarmBackend(lg, be))
+	require.NoError(t, err)
+
+	tp, err := auth.NewTokenProvider(lg, "simple", dummyIndexWaiter, 300*time.Second)
+	require.NoError(t, err)
+	authStore := auth.NewAuthStore(
+		lg,
+		schema.NewAuthBackend(lg, be),
+		tp,
+		bcrypt.DefaultCost,
+	)
+	consistentIndex := cindex.NewConsistentIndex(be)
+	opts := ApplierOptions{
+		Logger:                       lg,
+		KV:                           kv,
+		ReadCache:                    cache,
+		AlarmStore:                   alarmStore,
+		AuthStore:                    authStore,
+		Lessor:                       lessor,
+		Cluster:                      cluster,
+		RaftStatus:                   &fakeRaftStatusGetter{},
+		SnapshotServer:               &fakeSnapshotServer{},
+		ConsistentIndex:              consistentIndex,
+		TxnModeWriteWithSharedBuffer: false,
+		Backend:                      be,
+		QuotaBackendBytesCfg:         16 * 1024 * 1024, // 16MB
+		WarningApplyDuration:         time.Hour,
+	}
+	return NewUberApplier(opts)
+}
+
+// primeCacheEntry inserts an unconditionally-valid current-revision cache
+// entry for [key, end) so a later invalidation can be observed as a miss.
+func primeCacheEntry(cache *readcache.Cache, key, end []byte) {
+	req := &pb.RangeRequest{Key: key, RangeEnd: end}
+	epoch := cache.StartRead()
+	cache.Add(req, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 1}}, epoch)
+}
+
+func TestApplierV3CacheInvalidate_Put(t *testing.T) {
+	cache := readcache.New(16)
+	ua := uberApplierWithCache(t, cache)
+
+	primeCacheEntry(cache, []byte("foo"), nil)
+	require.Equal(t, 1, cache.Size())
+
+	result := ua.Apply(&InternalRaftRequestWrapper{InternalRaftRequest: &pb.InternalRaftRequest{
+		Put: &pb.PutRequest{Key: []byte("foo"), Value: []byte("bar")},
+	}}, membership.ApplyBoth)
+	require.NotNil(t, result)
+	require.NoError(t, result.Err)
+
+	_, ok := cache.Get(&pb.RangeRequest{Key: []byte("foo")})
+	require.False(t, ok, "Put must invalidate a previously cached entry for the same key")
+}
+
+func TestApplierV3CacheInvalidate_DeleteRange(t *testing.T) {
+	cache := readcache.New(16)
+	ua := uberApplierWithCache(t, cache)
+
+	primeCacheEntry(cache, []byte("a"), []byte("z"))
+	require.Equal(t, 1, cache.Size())
+
+	result := ua.Apply(&InternalRaftRequestWrapper{InternalRaftRequest: &pb.InternalRaftRequest{
+		DeleteRange: &pb.DeleteRangeRequest{Key: []byte("m")},
+	}}, membership.ApplyBoth)
+	require.NotNil(t, result)
+	require.NoError(t, result.Err)
+
+	_, ok := cache.Get(&pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")})
+	require.False(t, ok, "DeleteRange must invalidate a previously cached overlapping range entry")
+}
+
+func TestApplierV3CacheInvalidate_TxnSuccessBranch(t *testing.T) {
+	cache := readcache.New(16)
+	ua := uberApplierWithCache(t, cache)
+
+	primeCacheEntry(cache, []byte("succ-key"), nil)
+	primeCacheEntry(cache, []byte("fail-key"), nil)
+	require.Equal(t, 2, cache.Size())
+
+	// Compare succeeds (create_revision == 0, i.e. key does not exist yet), so
+	// the Success branch (Put succ-key) executes and Failure (Put fail-key)
+	// does not.
+	result := ua.Apply(&InternalRaftRequestWrapper{InternalRaftRequest: &pb.InternalRaftRequest{
+		Txn: &pb.TxnRequest{
+			Compare: []*pb.Compare{{
+				Key:         []byte("succ-key"),
+				Result:      pb.Compare_EQUAL,
+				Target:      pb.Compare_CREATE,
+				TargetUnion: &pb.Compare_CreateRevision{CreateRevision: 0},
+			}},
+			Success: []*pb.RequestOp{{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("succ-key"), Value: []byte("v")}}}},
+			Failure: []*pb.RequestOp{{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("fail-key"), Value: []byte("v")}}}},
+		},
+	}}, membership.ApplyBoth)
+	require.NotNil(t, result)
+	require.NoError(t, result.Err)
+
+	_, ok := cache.Get(&pb.RangeRequest{Key: []byte("succ-key")})
+	require.False(t, ok, "the executed (success) branch's Put must invalidate its key")
+
+	_, ok = cache.Get(&pb.RangeRequest{Key: []byte("fail-key")})
+	require.True(t, ok, "the non-executed (failure) branch's key must remain cached")
+}
+
+func TestApplierV3CacheInvalidate_TxnFailureBranch(t *testing.T) {
+	cache := readcache.New(16)
+	ua := uberApplierWithCache(t, cache)
+
+	primeCacheEntry(cache, []byte("succ-key"), nil)
+	primeCacheEntry(cache, []byte("fail-key"), nil)
+	require.Equal(t, 2, cache.Size())
+
+	// Compare fails (key already has a create_revision, since a prior Put in
+	// this test is not made -- instead require a nonzero create_revision that
+	// won't match an unset key), so the Failure branch (Put fail-key)
+	// executes and Success (Put succ-key) does not.
+	result := ua.Apply(&InternalRaftRequestWrapper{InternalRaftRequest: &pb.InternalRaftRequest{
+		Txn: &pb.TxnRequest{
+			Compare: []*pb.Compare{{
+				Key:         []byte("succ-key"),
+				Result:      pb.Compare_EQUAL,
+				Target:      pb.Compare_CREATE,
+				TargetUnion: &pb.Compare_CreateRevision{CreateRevision: 999}, // never matches a nonexistent key
+			}},
+			Success: []*pb.RequestOp{{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("succ-key"), Value: []byte("v")}}}},
+			Failure: []*pb.RequestOp{{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("fail-key"), Value: []byte("v")}}}},
+		},
+	}}, membership.ApplyBoth)
+	require.NotNil(t, result)
+	require.NoError(t, result.Err)
+
+	_, ok := cache.Get(&pb.RangeRequest{Key: []byte("fail-key")})
+	require.False(t, ok, "the executed (failure) branch's Put must invalidate its key")
+
+	_, ok = cache.Get(&pb.RangeRequest{Key: []byte("succ-key")})
+	require.True(t, ok, "the non-executed (success) branch's key must remain cached")
+}
+
+// stubApplierV3 is a minimal applierV3 stand-in used to test
+// applierV3CacheInvalidate.Compaction's wiring in isolation, without driving
+// the real mvcc backend's asynchronous compaction machinery (exercised
+// separately, and unaffected by this change, in the mvcc/apply/backend test
+// suites).
+type stubApplierV3 struct {
+	applierV3
+}
+
+func (stubApplierV3) Compaction(compaction *pb.CompactionRequest) (*pb.CompactionResponse, <-chan struct{}, *traceutil.Trace, error) {
+	return &pb.CompactionResponse{}, nil, nil, nil
+}
+
+func TestApplierV3CacheInvalidate_Compaction(t *testing.T) {
+	cache := readcache.New(16)
+	a := newApplierV3CacheInvalidate(stubApplierV3{}, cache)
+
+	pinned := &pb.RangeRequest{Key: []byte("foo"), Revision: 2}
+	epoch := cache.StartRead()
+	cache.Add(pinned, &pb.RangeResponse{Header: &pb.ResponseHeader{Revision: 2}}, epoch)
+	_, ok := cache.Get(pinned)
+	require.True(t, ok)
+
+	_, _, _, err := a.Compaction(&pb.CompactionRequest{Revision: 2})
+	require.NoError(t, err)
+
+	_, ok = cache.Get(pinned)
+	require.False(t, ok, "Compaction must evict pinned-revision entries at or below the compacted revision")
+}
