+
+private enum class SnoozeOption {
+    TOMORROW,
+    NEXT_WEEK,
+    CUSTOM,
+}
+
+@Composable
+fun SnoozeDialog(
+    snoozedUntil: Long?,
+    onDismissRequest: () -> Unit,
+    onSnooze: (Long) -> Unit,
+    onClearSnooze: () -> Unit,
+) {
+    val timeZone = TimeZone.currentSystemDefault()
+    var selectedOption by rememberSaveable { mutableStateOf(SnoozeOption.TOMORROW) }
+    var customDateMillis by rememberSaveable { mutableStateOf<Long?>(null) }
+    var showDatePicker by rememberSaveable { mutableStateOf(false) }
+
+    val resolvedSnoozeUntil = when (selectedOption) {
+        SnoozeOption.TOMORROW -> Clock.System.now().plus(1, DateTimeUnit.DAY, timeZone).toEpochMilliseconds()
+        SnoozeOption.NEXT_WEEK -> Clock.System.now().plus(7, DateTimeUnit.DAY, timeZone).toEpochMilliseconds()
+        SnoozeOption.CUSTOM -> customDateMillis
+    }
+
+    AlertDialog(
+        onDismissRequest = onDismissRequest,
+        title = { Text(stringResource(MR.strings.action_remind_me_later)) },
+        text = {
+            Column {
+                if (snoozedUntil != null && snoozedUntil > Clock.System.now().toEpochMilliseconds()) {
+                    Text(
+                        stringResource(
+                            MR.strings.snooze_active_until,
+                            relativeTimeSpanString(snoozedUntil),
+                        ),
+                    )
+                    Spacer(Modifier.height(MaterialTheme.padding.small))
+                }
+
+                SnoozeOptionRow(
+                    text = stringResource(MR.strings.action_snooze_tomorrow),
+                    selected = selectedOption == SnoozeOption.TOMORROW,
+                    onClick = { selectedOption = SnoozeOption.TOMORROW },
+                )
+                SnoozeOptionRow(
+                    text = stringResource(MR.strings.action_snooze_next_week),
+                    selected = selectedOption == SnoozeOption.NEXT_WEEK,
+                    onClick = { selectedOption = SnoozeOption.NEXT_WEEK },
+                )
+                SnoozeOptionRow(
+                    text = customDateMillis?.let {
+                        stringResource(MR.strings.action_snooze_custom_date_selected, relativeTimeSpanString(it))
+                    } ?: stringResource(MR.strings.action_snooze_custom_date),
+                    selected = selectedOption == SnoozeOption.CUSTOM,
+                    onClick = {
+                        selectedOption = SnoozeOption.CUSTOM
+                        showDatePicker = true
+                    },
+                )
+            }
+        },
+        dismissButton = {
+            Row {
+                if (snoozedUntil != null) {
+                    TextButton(
+                        onClick = {
+                            onClearSnooze()
+                            onDismissRequest()
+                        },
+                    ) {
+                        Text(text = stringResource(MR.strings.action_clear_reminder))
+                    }
+                }
+                TextButton(onClick = onDismissRequest) {
+                    Text(text = stringResource(MR.strings.action_cancel))
+                }
+            }
+        },
+        confirmButton = {
+            TextButton(
+                onClick = {
+                    resolvedSnoozeUntil?.let(onSnooze)
+                    onDismissRequest()
+                },
+            ) {
+                Text(text = stringResource(MR.strings.action_ok))
+            }
+        },
+    )
+
+    if (showDatePicker) {
+        val datePickerState = rememberDatePickerState(initialSelectedDateMillis = customDateMillis)
+        DatePickerDialog(
+            onDismissRequest = { showDatePicker = false },
+            confirmButton = {
+                TextButton(
+                    onClick = {
+                        datePickerState.selectedDateMillis?.let { customDateMillis = it }
+                        showDatePicker = false
+                    },
+                ) {
+                    Text(text = stringResource(MR.strings.action_ok))
+                }
+            },
+            dismissButton = {
+                TextButton(onClick = { showDatePicker = false }) {
+                    Text(text = stringResource(MR.strings.action_cancel))
+                }
+            },
+        ) {
+            DatePicker(state = datePickerState)
+        }
+    }
+}
+
+@Composable
+private fun SnoozeOptionRow(
+    text: String,
+    selected: Boolean,
+    onClick: () -> Unit,
+) {
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .selectable(selected = selected, onClick = onClick),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        RadioButton(selected = selected, onClick = onClick)
+        Text(text = text)
+    }
+}
