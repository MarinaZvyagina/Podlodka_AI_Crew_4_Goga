+@Inject
+class SetMangaSnooze(
+    private val mangaRepository: MangaRepository,
+) {
+
+    suspend fun await(mangaId: Long, snoozedUntil: Long?) {
+        try {
+            mangaRepository.setMangaSnooze(mangaId, snoozedUntil)
+        } catch (e: Exception) {
+            logcat(LogPriority.ERROR, e)
+        }
+    }
+}
