+@Composable
+fun SnoozeDialog(
+    isSnoozed: Boolean,
+    onDismissRequest: () -> Unit,
+    onConfirm: (Long) -> Unit,
+    onClear: () -> Unit,
+) {
+    var showDatePicker by rememberSaveable { mutableStateOf(false) }
+
+    if (showDatePicker) {
+        val selectableDates = remember {
+            object : SelectableDates {
+                override fun isSelectableDate(utcTimeMillis: Long): Boolean {
+                    val targetDate = Instant.fromEpochMilliseconds(utcTimeMillis).toLocalDateTime(TimeZone.UTC).date
+                    val today = Clock.System.now().toLocalDateTime(TimeZone.UTC).date
+                    return targetDate >= today
+                }
+            }
+        }
+        val pickerState = rememberDatePickerState(selectableDates = selectableDates)
+        AlertDialog(
+            onDismissRequest = onDismissRequest,
+            title = { Text(text = stringResource(MR.strings.snooze_option_custom_date)) },
+            text = { DatePicker(state = pickerState, showModeToggle = false) },
+            dismissButton = {
+                TextButton(onClick = onDismissRequest) {
+                    Text(text = stringResource(MR.strings.action_cancel))
+                }
+            },
+            confirmButton = {
+                TextButton(
+                    onClick = {
+                        pickerState.selectedDateMillis?.let(onConfirm)
+                        onDismissRequest()
+                    },
+                ) {
+                    Text(text = stringResource(MR.strings.action_ok))
+                }
+            },
+        )
+        return
+    }
+
+    AlertDialog(
+        onDismissRequest = onDismissRequest,
+        title = { Text(text = stringResource(MR.strings.action_snooze)) },
+        text = {
+            Column {
+                val timeZone = TimeZone.currentSystemDefault()
+                SnoozeOptionRow(stringResource(MR.strings.snooze_option_tomorrow)) {
+                    onConfirm(Clock.System.now().plus(1, DateTimeUnit.DAY, timeZone).toEpochMilliseconds())
+                    onDismissRequest()
+                }
+                SnoozeOptionRow(stringResource(MR.strings.snooze_option_next_week)) {
+                    onConfirm(Clock.System.now().plus(7, DateTimeUnit.DAY, timeZone).toEpochMilliseconds())
+                    onDismissRequest()
+                }
+                SnoozeOptionRow(stringResource(MR.strings.snooze_option_custom_date)) {
+                    showDatePicker = true
+                }
+            }
+        },
+        dismissButton = if (isSnoozed) {
+            {
+                TextButton(onClick = { onClear(); onDismissRequest() }) {
+                    Text(text = stringResource(MR.strings.action_clear_snooze))
+                }
+            }
+        } else {
+            null
+        },
+        confirmButton = {
+            TextButton(onClick = onDismissRequest) {
+                Text(text = stringResource(MR.strings.action_cancel))
+            }
+        },
+    )
+}
+
+@Composable
+private fun SnoozeOptionRow(text: String, onClick: () -> Unit) {
+    Text(
+        text = text,
+        modifier = Modifier
+            .fillMaxWidth()
+            .clickable(onClick = onClick)
+            .padding(vertical = 12.dp),
+    )
+}
