+package eu.kanade.tachiyomi.data.track.librereader.dto
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class LRSeries(
+    val id: Long,
+    val title: String,
+    val coverUrl: String? = null,
+    val description: String? = null,
+    val totalChapters: Long? = null,
+)
+
+@Serializable
+data class LRSearchResult(
+    val results: List<LRSeries>,
+)
+
+@Serializable
+data class LRLibraryEntry(
+    val id: Long,
+    val seriesId: Long,
+    val title: String,
+    val coverUrl: String? = null,
+    val status: Long,
+    val lastChapterRead: Double = 0.0,
+    val totalChapters: Long = 0,
+)
+
+@Serializable
+data class LRUser(
+    val username: String,
+)
+
+fun parseSearchItem(series: LRSeries, trackerId: Long): TrackSearch = TrackSearch.create(trackerId).apply {
+    remote_id = series.id
+    title = series.title
+    cover_url = series.coverUrl.orEmpty()
+    summary = series.description.orEmpty()
+    total_chapters = series.totalChapters ?: 0
+}
+
+fun Track.copyFrom(entry: LRLibraryEntry): Track = apply {
+    library_id = entry.id
+    remote_id = entry.seriesId
+    title = entry.title
+    status = entry.status
+    last_chapter_read = entry.lastChapterRead
+    total_chapters = entry.totalChapters
+}
