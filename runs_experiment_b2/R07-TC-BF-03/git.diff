@@ -0,0 +1,116 @@
+package eu.kanade.tachiyomi.data.track.librereader
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRLibraryEntry
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRSearchResult
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRUser
+import eu.kanade.tachiyomi.data.track.librereader.dto.copyFrom
+import eu.kanade.tachiyomi.data.track.librereader.dto.parseSearchItem
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import eu.kanade.tachiyomi.network.DELETE
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.jsonMime
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import okhttp3.Credentials
+import okhttp3.Headers
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import tachiyomi.core.common.util.lang.withIOContext
+import uy.kohesive.injekt.injectLazy
+import tachiyomi.domain.track.model.Track as DomainTrack
+
+class LibreReaderApi(
+    private val libreReader: LibreReader,
+    private val client: OkHttpClient,
+    interceptor: LibreReaderInterceptor,
+) {
+
+    private val json: Json by injectLazy()
+
+    private val authClient by lazy { client.newBuilder().addInterceptor(interceptor).build() }
+
+    private val baseUrl get() = libreReader.getApiUrl()
+
+    suspend fun authenticate(username: String, password: String): LRUser = withIOContext {
+        val headers = Headers.Builder()
+            .add("Authorization", Credentials.basic(username, password))
+            .build()
+
+        with(json) {
+            client.newCall(GET(url = "$baseUrl/api/auth/whoami", headers = headers))
+                .awaitSuccess()
+                .parseAs<LRUser>()
+        }
+    }
+
+    suspend fun search(query: String): List<TrackSearch> = withIOContext {
+        val url = "$baseUrl/api/series/search".toHttpUrl().newBuilder()
+            .addQueryParameter("query", query)
+            .build()
+
+        with(json) {
+            authClient.newCall(GET(url))
+                .awaitSuccess()
+                .parseAs<LRSearchResult>()
+                .results
+                .map { parseSearchItem(it, libreReader.id) }
+        }
+    }
+
+    suspend fun findLibraryEntry(track: Track): Track? = withIOContext {
+        val url = "$baseUrl/api/library".toHttpUrl().newBuilder()
+            .addQueryParameter("seriesId", track.remote_id.toString())
+            .build()
+
+        try {
+            val entry = with(json) {
+                authClient.newCall(GET(url))
+                    .awaitSuccess()
+                    .parseAs<LRLibraryEntry>()
+            }
+            track.copyFrom(entry)
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    suspend fun createLibraryEntry(track: Track): Track = withIOContext {
+        val body = buildJsonObject {
+            put("seriesId", track.remote_id)
+            put("status", track.status)
+        }.toString().toRequestBody(jsonMime)
+
+        val entry = with(json) {
+            authClient.newCall(POST(url = "$baseUrl/api/library", body = body))
+                .awaitSuccess()
+                .parseAs<LRLibraryEntry>()
+        }
+        track.copyFrom(entry)
+    }
+
+    suspend fun updateLibraryEntry(track: Track): Track = withIOContext {
+        val body = buildJsonObject {
+            put("status", track.status)
+            put("lastChapterRead", track.last_chapter_read)
+        }.toString().toRequestBody(jsonMime)
+
+        val entry = with(json) {
+            authClient.newCall(PUT(url = "$baseUrl/api/library/${track.library_id}", body = body))
+                .awaitSuccess()
+                .parseAs<LRLibraryEntry>()
+        }
+        track.copyFrom(entry)
+    }
+
+    suspend fun deleteLibraryEntry(track: DomainTrack) = withIOContext {
+        authClient.newCall(DELETE(url = "$baseUrl/api/library/${track.libraryId}"))
+            .awaitSuccess()
+    }
+}
