+  /**
+   * Marks the focused item to bypass compression and send at full/original quality, overriding [sentMediaQuality]
+   * for that one item only; toggling it on for a different item replaces any previous choice. The rest of the
+   * batch is unaffected.
+   *
+   * If this item's pre-upload is already running (or already finished under the old, compressed properties),
+   * only its own pre-upload is canceled and restarted with the new properties — every other item's pre-upload
+   * continues untouched. The new properties are written to durable storage as part of that restart, so the
+   * choice survives the process being killed mid-send.
+   */
+  fun toggleFullQuality() {
+    val snapshot = state.value
+    val focused = snapshot.focusedMedia ?: return
+    val enabling = snapshot.fullQualityMediaUri != focused.uri
+    val newFullQualityUri = if (enabling) focused.uri else null
+
+    val current = snapshot.selectedMedia.firstOrNull { it.uri == focused.uri } ?: return
+    val updatedTransformProperties = if (enabling) {
+      (current.transformProperties ?: TransformProperties.empty()).withSkipTransform()
+    } else {
+      current.transformProperties?.copy(skipTransform = false)
+    }
+    val updatedMedia = current.copy(transformProperties = updatedTransformProperties)
+
+    updateState {
+      copy(
+        fullQualityMediaUri = newFullQualityUri,
+        selectedMedia = selectedMedia.map { if (it.uri == focused.uri) updatedMedia else it },
+        focusedMedia = updatedMedia
+      )
+    }
+
+    if (snapshot.isPreUploadEnabled) {
+      preUploadController.startUpload(listOf(updatedMedia), snapshot.recipientId)
+    }
+  }
