+package org.thoughtcrime.securesms.mediasend;
+
+import android.content.Context;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.WorkerThread;
+
+import org.signal.core.models.media.Media;
+import org.signal.core.models.media.TransformProperties;
+
+/**
+ * Marks the transformed media to bypass compression entirely and be sent at full/original
+ * quality, regardless of the batch's {@link SentMediaQuality}. Safe to use in a pipeline with
+ * other transforms: preserves every other {@link TransformProperties} field.
+ */
+public final class FullQualityTransform implements MediaTransform {
+
+  @WorkerThread
+  @Override
+  public @NonNull Media transform(@NonNull Context context, @NonNull Media media) {
+    TransformProperties existing = media.getTransformProperties();
+    TransformProperties updated = existing != null ? existing.withSkipTransform() : TransformProperties.forSkipTransform();
+
+    return new Media(media.getUri(),
+                     media.getContentType(),
+                     media.getDate(),
+                     media.getWidth(),
+                     media.getHeight(),
+                     media.getSize(),
+                     media.getDuration(),
+                     media.isBorderless(),
+                     media.isVideoGif(),
+                     media.getBucketId(),
+                     media.getCaption(),
+                     updated,
+                     media.getFileName());
+  }
+}
