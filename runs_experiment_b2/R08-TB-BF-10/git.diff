+  /**
+   * Toggles whether the focused item alone is sent at full/original quality, overriding [MediaSendFlowState.sentMediaQuality]
+   * for just that one item.
+   *
+   * The choice is baked directly into that item's [Media.transformProperties] -- the same field [SentMediaQuality] is
+   * baked into at selection time -- so it rides along through [MediaSendFlowState.selectedMedia] (and so survives
+   * process death, since that is [SavedStateHandle]-backed) and into whatever attachment row ends up representing it.
+   * [AttachmentCompressionJob][org.thoughtcrime.securesms.jobs.AttachmentCompressionJob] reads this flag fresh from
+   * that row every time it runs, including after an app restart, so it is honored no matter when it fires.
+   */
+  private fun toggleFullQuality() {
+    mutateSelection {
+      val snapshot = state.value
+      val focused = snapshot.focusedMedia ?: return@mutateSelection
+      val currentProperties = focused.transformProperties ?: TransformProperties.forSentMediaQuality(snapshot.sentMediaQuality.code)
+      val isNowFullQuality = !currentProperties.skipTransform
+      val updated = focused.copy(transformProperties = currentProperties.copy(skipTransform = isNowFullQuality))
+
+      updateState {
+        copy(
+          selectedMedia = selectedMedia.map { if (it.uri == updated.uri) updated else it },
+          focusedMedia = updated
+        )
+      }
+
+      fullQualityToastEvent(updated, isNowFullQuality)?.let { internalToastEvents.trySend(it) }
+
+      // Restarts pre-upload for just this item, discarding any already-compressed copy in flight rather than sending it.
+      val storySendRequirements = repository.getStorySendRequirements(listOf(updated))
+      startUpload(listOf(updated), storySendRequirements)
+    }
+  }
+
+  /**
+   * Copy confirming [media] alone was switched to or off full quality. Null for anything neither a video nor an
+   * image, which there is nothing to say about.
+   */
+  private fun fullQualityToastEvent(media: Media, isFullQuality: Boolean): ToastEvent? {
+    val message = when {
+      isNonGifVideo(media) -> ToastMessage.Text(
+        if (isFullQuality) R.string.MediaReviewFragment__video_set_to_full_quality else R.string.MediaReviewFragment__video_will_be_compressed_normally
+      )
+
+      ContentTypeUtil.isImageType(media.contentType) -> ToastMessage.Text(
+        if (isFullQuality) R.string.MediaReviewFragment__photo_set_to_full_quality else R.string.MediaReviewFragment__photo_will_be_compressed_normally
+      )
+
+      else -> {
+        Log.i(TAG, "No full-quality confirmation for an attachment of type: ${media.contentType}")
+        return null
+      }
+    }
+
+    return ToastEvent(
+      icon = if (isFullQuality) SignalIcons.QualityHigh else SignalIcons.QualityHighSlash,
+      message = message
+    )
+  }
+
   //endregion
 
   //region Video Editing
