+  /**
+   * Like [deleteAbandonedAttachmentFiles], but scans at most [limit] on-disk files whose name sorts after
+   * [afterFileName] instead of diffing the entire directory at once. This lets a caller sweep a large
+   * directory across multiple calls (e.g. separate job runs, possibly spanning process restarts) by feeding
+   * back [AbandonedAttachmentFilesPage.nextCursor] as [afterFileName] on the next call, rather than either
+   * re-scanning everything from the start or doing the whole directory in one long-running pass.
+   *
+   * @return the deleted count for this page, and the cursor to resume from, or a null cursor if this page
+   * reached the end of the directory.
+   */
+  fun deleteAbandonedAttachmentFilesPage(afterFileName: String?, limit: Int): AbandonedAttachmentFilesPage {
+    val diskFiles = context.getDir(DIRECTORY, Context.MODE_PRIVATE).listFiles() ?: return AbandonedAttachmentFilesPage(null, 0)
+
+    val page: List<File> = diskFiles
+      .filter { file: File -> !PartFileProtector.isProtected(file) }
+      .sortedBy { file: File -> file.name }
+      .filter { file: File -> afterFileName == null || file.name > afterFileName }
+      .take(limit)
+
+    if (page.isEmpty()) {
+      return AbandonedAttachmentFilesPage(null, 0)
+    }
+
+    val candidatePaths: Set<String> = page.map { it.absolutePath }.toSet()
+    val referencedPaths: MutableSet<String> = HashSet(candidatePaths.size)
+
+    readableDatabase.withinTransaction { db ->
+      for (query in SqlUtil.buildCollectionQuery(DATA_FILE, candidatePaths.toList())) {
+        db.select(DATA_FILE)
+          .from(TABLE_NAME)
+          .where(query.where, query.whereArgs)
+          .run()
+          .forEach { cursor -> cursor.requireString(DATA_FILE)?.let { referencedPaths += it } }
+      }
+
+      for (query in SqlUtil.buildCollectionQuery(THUMBNAIL_FILE, candidatePaths.toList())) {
+        db.select(THUMBNAIL_FILE)
+          .from(TABLE_NAME)
+          .where(query.where, query.whereArgs)
+          .run()
+          .forEach { cursor -> cursor.requireString(THUMBNAIL_FILE)?.let { referencedPaths += it } }
+      }
+    }
+
+    referencedPaths += SignalDatabase.stickers.getAllStickerFiles().filter { it in candidatePaths }
+
+    var deleteCount = 0
+    for (path in candidatePaths - referencedPaths) {
+      if (File(path).delete()) {
+        deleteCount++
+      } else {
+        Log.w(TAG, "[deleteAbandonedAttachmentFilesPage] Failed to delete attachment file. $path")
+      }
+    }
+
+    val nextCursor = if (page.size < limit) null else page.last().name
+    return AbandonedAttachmentFilesPage(nextCursor, deleteCount)
+  }
+
+  data class AbandonedAttachmentFilesPage(val nextCursor: String?, val deletedCount: Int)
+
