+  /**
+   * Repeating an identical search is common (retyping after a misfire, revisiting the chat list),
+   * and re-scanning every message/thread from scratch each time is wasteful when nothing relevant
+   * has changed since the last time that exact query ran. These caches are keyed by the full query
+   * (text + filters) and shared across every {@link SearchRepository} instance -- the class is
+   * newly constructed on essentially every search screen open, so an instance-scoped cache would
+   * rarely survive long enough to pay off. They're invalidated wholesale via the same conversation
+   * list change signal the rest of the app already uses to know the list needs refreshing (new,
+   * edited, or deleted messages/threads, recipient/group renames, etc.), which is registered once
+   * per process below.
+   */
+  private static final int CACHE_SIZE = 20;
+
+  private static final LruCache<ThreadQueryKey, ThreadSearchResult>   threadResultCache  = new LruCache<>(CACHE_SIZE);
+  private static final LruCache<MessageQueryKey, MessageSearchResult> messageResultCache = new LruCache<>(CACHE_SIZE);
+  private static volatile boolean                                    cacheInvalidationRegistered;
+
+  /**
+   * Registered lazily, on first actual use, rather than in a static initializer: this class is
+   * touched by pure-function unit tests that never construct an instance or spin up
+   * {@link AppDependencies}, and eagerly reaching into it at class-load time would break them.
+   */
+  private static void ensureCacheInvalidationRegistered() {
+    if (!cacheInvalidationRegistered) {
+      synchronized (SearchRepository.class) {
+        if (!cacheInvalidationRegistered) {
+          AppDependencies.getDatabaseObserver().registerConversationListObserver(() -> {
+            threadResultCache.evictAll();
+            messageResultCache.evictAll();
+          });
+          cacheInvalidationRegistered = true;
+        }
+      }
+    }
+  }
