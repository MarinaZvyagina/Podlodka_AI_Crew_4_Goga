+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import android.app.Application
+import androidx.test.core.app.ApplicationProvider
+import assertk.assertThat
+import assertk.assertions.hasSize
+import assertk.assertions.isSameAs
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.database.TestSms
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.dependencies.MockApplicationDependencyProvider
+import org.thoughtcrime.securesms.recipients.RecipientId
+import org.thoughtcrime.securesms.testutil.SignalDatabaseRule
+
+/**
+ * Verifies that repeating an identical search hits [SearchRepository]'s result cache instead of
+ * re-querying. Invalidation on data changes is covered by tracing every call site of
+ * [org.thoughtcrime.securesms.database.DatabaseObserver.notifyConversationListListeners] (the
+ * signal the cache clears on), which already fires on message insert/edit/delete and
+ * recipient/group renames -- the same broad signal the rest of the app relies on to know the
+ * conversation list needs refreshing.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class SearchRepositoryCacheTest {
+
+  @get:Rule
+  val signalDatabaseRule = SignalDatabaseRule()
+
+  @Before
+  fun setUp() {
+    if (!AppDependencies.isInitialized) {
+      AppDependencies.init(ApplicationProvider.getApplicationContext(), MockApplicationDependencyProvider())
+    }
+  }
+
+  @Test
+  fun `repeating an identical message search returns the cached instance instead of re-querying`() {
+    val threadId = SignalDatabase.threads.getOrCreateThreadIdFor(RecipientId.from(1), false)
+    TestSms.insert(signalDatabaseRule.writeableDatabase, encodedBody = "SearchRepositoryCacheTest-messages needle", threadId = threadId)
+
+    val repository = SearchRepository("Note to Self")
+
+    val first  = repository.queryMessagesSync("SearchRepositoryCacheTest-messages", SearchFilter.EMPTY)
+    val second = repository.queryMessagesSync("SearchRepositoryCacheTest-messages", SearchFilter.EMPTY)
+
+    assertThat(first.results).hasSize(1)
+    assertThat(second).isSameAs(first)
+  }
+
+  @Test
+  fun `repeating an identical thread search returns the cached instance instead of re-querying`() {
+    val repository = SearchRepository("SearchRepositoryCacheTest-note-to-self")
+
+    val first  = repository.queryThreadsSync("SearchRepositoryCacheTest-threads", false)
+    val second = repository.queryThreadsSync("SearchRepositoryCacheTest-threads", false)
+
+    assertThat(second).isSameAs(first)
+  }
+}
