diff --git a/app/src/main/java/org/thoughtcrime/securesms/search/SearchResultCache.kt b/app/src/main/java/org/thoughtcrime/securesms/search/SearchResultCache.kt
new file mode 100644
index 0000000..e3912f5
--- /dev/null
+++ b/app/src/main/java/org/thoughtcrime/securesms/search/SearchResultCache.kt
@@ -0,0 +1,71 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import org.signal.core.util.LRUCache
+import org.thoughtcrime.securesms.database.DatabaseObserver
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+
+/**
+ * Caches [SearchRepository] thread/message query results so that repeating an identical chat-list
+ * search is fast, while staying correct by dropping every cached entry whenever the underlying
+ * data could have changed.
+ *
+ * Invalidation is coarse -- the whole cache is wiped rather than just the affected entries --
+ * because the available signals ([DatabaseObserver]'s conversation-list and message-update
+ * observers) only say that *something* changed, not which search terms it could affect. Queries
+ * are cheap to recompute and the cache is small, so this trades a bit of avoidable recomputation
+ * for never risking a stale result.
+ */
+class SearchResultCache(databaseObserver: DatabaseObserver) {
+
+  private val lock = Any()
+  private val threadResults = LRUCache<ThreadQueryKey, ThreadSearchResult>(MAX_CACHED_QUERIES)
+  private val messageResults = LRUCache<MessageQueryKey, MessageSearchResult>(MAX_CACHED_QUERIES)
+
+  init {
+    databaseObserver.registerConversationListObserver { invalidate() }
+    databaseObserver.registerMessageUpdateObserver { invalidate() }
+  }
+
+  fun getThreads(query: String, unreadOnly: Boolean): ThreadSearchResult? = synchronized(lock) {
+    threadResults[ThreadQueryKey(query, unreadOnly)]
+  }
+
+  fun putThreads(query: String, unreadOnly: Boolean, result: ThreadSearchResult) {
+    synchronized(lock) {
+      threadResults[ThreadQueryKey(query, unreadOnly)] = result
+    }
+  }
+
+  fun getMessages(query: String, filter: SearchFilter): MessageSearchResult? = synchronized(lock) {
+    messageResults[MessageQueryKey(query, filter)]
+  }
+
+  fun putMessages(query: String, filter: SearchFilter, result: MessageSearchResult) {
+    synchronized(lock) {
+      messageResults[MessageQueryKey(query, filter)] = result
+    }
+  }
+
+  private fun invalidate() {
+    synchronized(lock) {
+      threadResults.clear()
+      messageResults.clear()
+    }
+  }
+
+  private data class ThreadQueryKey(val query: String, val unreadOnly: Boolean)
+  private data class MessageQueryKey(val query: String, val filter: SearchFilter)
+
+  companion object {
+    private const val MAX_CACHED_QUERIES = 20
+
+    /** Process-wide instance shared by every [SearchRepository], registered with the live [DatabaseObserver] exactly once. */
+    @JvmStatic
+    val shared: SearchResultCache by lazy { SearchResultCache(AppDependencies.databaseObserver) }
+  }
+}
diff --git a/app/src/test/java/org/thoughtcrime/securesms/search/SearchResultCacheTest.kt b/app/src/test/java/org/thoughtcrime/securesms/search/SearchResultCacheTest.kt
