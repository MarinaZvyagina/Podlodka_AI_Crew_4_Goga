+++ b/app/src/test/java/org/thoughtcrime/securesms/search/SearchResultCacheTest.kt
@@ -0,0 +1,111 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import assertk.assertThat
+import assertk.assertions.isEqualTo
+import assertk.assertions.isNull
+import assertk.assertions.isSameAs
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.slot
+import org.junit.Before
+import org.junit.Test
+import org.thoughtcrime.securesms.database.DatabaseObserver
+import org.thoughtcrime.securesms.database.model.MessageId
+
+class SearchResultCacheTest {
+
+  private val conversationListObserver = slot<DatabaseObserver.Observer>()
+  private val messageUpdateObserver = slot<DatabaseObserver.MessageObserver>()
+  private lateinit var cache: SearchResultCache
+
+  @Before
+  fun setUp() {
+    val databaseObserver = mockk<DatabaseObserver>(relaxed = true)
+    every { databaseObserver.registerConversationListObserver(capture(conversationListObserver)) } returns Unit
+    every { databaseObserver.registerMessageUpdateObserver(capture(messageUpdateObserver)) } returns Unit
+
+    cache = SearchResultCache(databaseObserver)
+  }
+
+  @Test
+  fun `repeating an identical thread query is a cache hit`() {
+    val result = ThreadSearchResult(emptyList(), "alice")
+    cache.putThreads("alice", unreadOnly = false, result = result)
+
+    assertThat(cache.getThreads("alice", unreadOnly = false)).isSameAs(result)
+  }
+
+  @Test
+  fun `a different query is a cache miss`() {
+    cache.putThreads("alice", unreadOnly = false, result = ThreadSearchResult(emptyList(), "alice"))
+
+    assertThat(cache.getThreads("bob", unreadOnly = false)).isNull()
+  }
+
+  @Test
+  fun `unreadOnly is part of the cache key`() {
+    cache.putThreads("alice", unreadOnly = false, result = ThreadSearchResult(emptyList(), "alice"))
+
+    assertThat(cache.getThreads("alice", unreadOnly = true)).isNull()
+  }
+
+  @Test
+  fun `repeating an identical message query is a cache hit`() {
+    val result = MessageSearchResult(emptyList(), "alice")
+    cache.putMessages("alice", SearchFilter.EMPTY, result = result)
+
+    assertThat(cache.getMessages("alice", SearchFilter.EMPTY)).isSameAs(result)
+  }
+
+  @Test
+  fun `a different filter is a cache miss`() {
+    cache.putMessages("alice", SearchFilter.EMPTY, result = MessageSearchResult(emptyList(), "alice"))
+
+    assertThat(cache.getMessages("alice", SearchFilter(startDate = 1L))).isNull()
+  }
+
+  @Test
+  fun `thread and message caches are independent`() {
+    cache.putThreads("alice", unreadOnly = false, result = ThreadSearchResult(emptyList(), "alice"))
+
+    assertThat(cache.getMessages("alice", SearchFilter.EMPTY)).isNull()
+  }
+
+  @Test
+  fun `a conversation list change clears every cached query`() {
+    cache.putThreads("alice", unreadOnly = false, result = ThreadSearchResult(emptyList(), "alice"))
+    cache.putMessages("bob", SearchFilter.EMPTY, result = MessageSearchResult(emptyList(), "bob"))
+
+    conversationListObserver.captured.onChanged()
+
+    assertThat(cache.getThreads("alice", unreadOnly = false)).isNull()
+    assertThat(cache.getMessages("bob", SearchFilter.EMPTY)).isNull()
+  }
+
+  @Test
+  fun `a message update clears every cached query`() {
+    cache.putThreads("alice", unreadOnly = false, result = ThreadSearchResult(emptyList(), "alice"))
+    cache.putMessages("bob", SearchFilter.EMPTY, result = MessageSearchResult(emptyList(), "bob"))
+
+    messageUpdateObserver.captured.onMessageChanged(MessageId(1L))
+
+    assertThat(cache.getThreads("alice", unreadOnly = false)).isNull()
+    assertThat(cache.getMessages("bob", SearchFilter.EMPTY)).isNull()
+  }
+
+  @Test
+  fun `stale results are recomputed and re-cached after invalidation`() {
+    cache.putThreads("alice", unreadOnly = false, result = ThreadSearchResult(emptyList(), "alice"))
+    conversationListObserver.captured.onChanged()
+
+    val fresh = ThreadSearchResult(emptyList(), "alice")
+    cache.putThreads("alice", unreadOnly = false, result = fresh)
+
+    assertThat(cache.getThreads("alice", unreadOnly = false)).isSameAs(fresh)
+  }
+}
