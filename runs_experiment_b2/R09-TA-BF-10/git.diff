+    // MARK: - Removing Window Data
+    @MainActor
+    func testRemoveWindowData_removesPrimaryAndBackupFilesForGivenUUID() async throws {
+        let subject = createSubject()
+        let primaryDirectory = URL(string: "some/directory1")!
+        let backupDirectory = URL(string: "some/directory2")!
+        mockFileManager.primaryDirectoryURL = primaryDirectory
+        mockFileManager.backupDirectoryURL = backupDirectory
+        let primaryFileURL = primaryDirectory.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        let backupFileURL = backupDirectory.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        mockFileManager.primaryPathContents = [primaryFileURL]
+        mockFileManager.backupPathContents = [backupFileURL]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(primaryFileURL))
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(backupFileURL))
+    }
+
+    @MainActor
+    func testRemoveWindowData_windowWithoutBackupFile_removesOnlyPrimaryWithoutError() async throws {
+        let subject = createSubject()
+        let primaryDirectory = URL(string: "some/directory1")!
+        let backupDirectory = URL(string: "some/directory2")!
+        mockFileManager.primaryDirectoryURL = primaryDirectory
+        mockFileManager.backupDirectoryURL = backupDirectory
+        let primaryFileURL = primaryDirectory.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        mockFileManager.primaryPathContents = [primaryFileURL]
+        mockFileManager.backupPathContents = []
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 1)
+        XCTAssertEqual(mockFileManager.removedFileURLs, [primaryFileURL])
+    }
+
+    @MainActor
+    func testRemoveWindowData_leavesUntargetedWindowsAndTheirBackupsUntouched() async throws {
+        let subject = createSubject()
+        let primaryDirectory = URL(string: "some/directory1")!
+        let backupDirectory = URL(string: "some/directory2")!
+        mockFileManager.primaryDirectoryURL = primaryDirectory
+        mockFileManager.backupDirectoryURL = backupDirectory
+        let otherUUID = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        let targetPrimaryFileURL = primaryDirectory.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        let targetBackupFileURL = backupDirectory.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        let otherPrimaryFileURL = primaryDirectory.appendingPathComponent("window-\(otherUUID.uuidString)")
+        let otherBackupFileURL = backupDirectory.appendingPathComponent("window-\(otherUUID.uuidString)")
+        mockFileManager.primaryPathContents = [targetPrimaryFileURL, otherPrimaryFileURL]
+        mockFileManager.backupPathContents = [targetBackupFileURL, otherBackupFileURL]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(targetPrimaryFileURL))
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(targetBackupFileURL))
+        XCTAssertFalse(mockFileManager.removedFileURLs.contains(otherPrimaryFileURL))
+        XCTAssertFalse(mockFileManager.removedFileURLs.contains(otherBackupFileURL))
+    }
+
