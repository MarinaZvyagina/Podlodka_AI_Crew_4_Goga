diff --git a/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
new file mode 100644
index 00000000..e38eb1ab
--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,51 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import AVFoundation
+
+/// A stand-in for an alternative speech-to-text pipeline, used to A/B test transcription quality
+/// and latency against the default engine (`SFSpeechRecognizerEngine`/`SpeechAnalyzerEngine`).
+///
+/// Mirrors the permission and audio-capture flow of the other engines so the rest of the
+/// Quick Answers feature (recording UI, streaming, error handling) behaves identically regardless
+/// of which engine is active. The transcription step itself is a mocked placeholder to be swapped
+/// for a real third-party engine once one is selected.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    private static let mockTranscriptWords = ["What", "is", "the", "weather", "today?"]
+
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        var accumulatedWords: [String] = []
+        for word in Self.mockTranscriptWords {
+            accumulatedWords.append(word)
+            let isFinal = accumulatedWords.count == Self.mockTranscriptWords.count
+            continuation.yield(SpeechResult(text: accumulatedWords.joined(separator: " "), isFinal: isFinal))
+        }
+        continuation.finish()
+    }
+
+    func stop() throws {
+        try audioManager.stopEngine()
+    }
+}
