@@ -0,0 +1,33 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+/// Creates the `TranscriptionEngine` used for a voice search recording session.
+@MainActor
+protocol TranscriptionEngineFactory {
+    /// - Parameter isAlternativeEnabled: Whether the user is enrolled in the alternative
+    /// speech-to-text pipeline experiment. When `true`, the alternative engine is returned
+    /// regardless of platform; otherwise the default, platform-appropriate engine is returned.
+    func makeEngine(isAlternativeEnabled: Bool) -> TranscriptionEngine
+}
+
+/// Default engine selection:
+/// - Enrolled in the experiment: `AlternativeTranscriptionEngine`.
+/// - iOS 26+: `SpeechAnalyzerEngine`.
+/// - Earlier versions: `SFSpeechRecognizerEngine`.
+struct DefaultTranscriptionEngineFactory: TranscriptionEngineFactory {
+    func makeEngine(isAlternativeEnabled: Bool) -> TranscriptionEngine {
+        let audioManager = AudioManager()
+        let authorizer = AuthorizationHandler()
+
+        if isAlternativeEnabled {
+            return AlternativeTranscriptionEngine(audioManager: audioManager, authorizer: authorizer)
+        }
+
+        if #available(iOS 26.0, *) {
+            return SpeechAnalyzerEngine(audioManager: audioManager, authorizer: authorizer)
+        } else {
+            return SFSpeechRecognizerEngine(audioManager: audioManager, authorizer: authorizer)
+        }
+    }
+}
