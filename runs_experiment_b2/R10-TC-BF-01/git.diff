+    private static let messageRetentionPeriodDayOptions: [UInt32?] = [nil, 30, 90, 365]
+
+    private static func formatMessageRetentionPeriod(_ days: UInt32?) -> String {
+        guard let days else {
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_FOREVER",
+                comment: "Label indicating that messages are kept forever, i.e. automatic deletion is disabled.",
+            )
+        }
+        switch days {
+        case 365:
+            return OWSLocalizedString(
+                "SETTINGS_MESSAGE_RETENTION_1_YEAR",
+                comment: "Label indicating that messages are kept for one year before being automatically deleted.",
+            )
+        default:
+            return String(
+                format: OWSLocalizedString(
+                    "SETTINGS_MESSAGE_RETENTION_N_DAYS_FORMAT",
+                    comment: "Label indicating that messages are kept for a number of days before being automatically deleted. Embeds {{ the number of days }}.",
+                ),
+                String(days),
+            )
+        }
+    }
+
+    private func showMessageRetentionPicker() {
+        let actionSheet = ActionSheetController(title: OWSLocalizedString(
+            "SETTINGS_MESSAGE_RETENTION_TITLE",
+            comment: "Title for setting that lets a user automatically delete old messages after a chosen retention window.",
+        ))
+
+        for days in Self.messageRetentionPeriodDayOptions {
+            actionSheet.addAction(.init(
+                title: Self.formatMessageRetentionPeriod(days),
+                handler: { [weak self] _ in
+                    self?.didSelectMessageRetentionPeriod(days: days)
+                },
+            ))
+        }
+
+        actionSheet.addAction(OWSActionSheets.cancelAction)
+
+        presentActionSheet(actionSheet)
+    }
+
+    private func didSelectMessageRetentionPeriod(days: UInt32?) {
+        Logger.info("selected message retention period: \(String(describing: days))")
+
+        let currentValue = SSKEnvironment.shared.databaseStorageRef.read { SSKPreferences.messageRetentionPeriodDays(transaction: $0) }
+        guard currentValue != days else { return }
+
+        SSKEnvironment.shared.databaseStorageRef.asyncWrite { tx in
+            SSKPreferences.setMessageRetentionPeriodDays(days, transaction: tx)
+
+            guard let days else { return }
+
+            // Apply retroactively, unconditionally (bypassing the routine
+            // throttle), so a newly-set or changed window takes effect
+            // immediately rather than waiting for the next throttled sweep.
+            SSKEnvironment.shared.bulkDeleteInteractionJobQueueRef.sweepMessageRetention(
+                retentionPeriodDays: days,
+                now: Date(),
+                threadStore: DependenciesBridge.shared.threadStore,
+                tx: tx,
+            )
+        } completion: { [weak self] in
+            self?.updateTableContents()
+        }
+    }
