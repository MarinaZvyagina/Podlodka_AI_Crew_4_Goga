+def test__validate_capital_config(default_conf) -> None:
+    conf = deepcopy(default_conf)
+    conf["available_capital"] = 1000
+    conf["original_config"] = deepcopy(conf)
+    with pytest.raises(
+        ConfigurationError,
+        match=r"Both `available_capital` and `tradable_balance_ratio` are set.*",
+    ):
+        validate_config_consistency(conf)
+
+    # Simulate a config where the user never set `tradable_balance_ratio` themselves, but the
+    # schema default has already been filled in at the top level by a prior validation pass
+    # (as happens for backtesting, where validate_config_consistency runs twice). This should
+    # not be treated as a conflict, since the user never actually configured it.
+    del conf["original_config"]["tradable_balance_ratio"]
+    validate_config_consistency(conf)
+
