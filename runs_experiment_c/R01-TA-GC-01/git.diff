+def _validate_capital_config(conf: dict[str, Any]) -> None:
+    """
+    `available_capital` and `tradable_balance_ratio` both influence the starting
+    trading capital, but only one of them is ever actually used - whichever is
+    present takes effect and the other is silently ignored.
+    Check against the originally supplied configuration, since `tradable_balance_ratio`
+    gets a schema default applied later, which would otherwise make it look like both
+    settings were explicitly configured.
+    """
+    source = conf.get("original_config", conf)
+    if "available_capital" in source and "tradable_balance_ratio" in source:
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in your "
+            "configuration. Only one of these settings is used to determine your starting "
+            "trading capital - the other will be silently ignored. Please remove one of them."
+        )
+
+
