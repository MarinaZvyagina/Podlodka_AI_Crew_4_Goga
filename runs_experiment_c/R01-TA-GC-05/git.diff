+def _validate_capital_settings(conf: dict[str, Any]) -> None:
+    """
+    `available_capital` and `tradable_balance_ratio` both influence how much capital is
+    used for trading, but only one of them ever takes effect - whichever is set wins, and
+    the other is silently ignored. Only warn when the user explicitly set both, since
+    `tradable_balance_ratio` otherwise carries a schema default.
+    """
+    if "available_capital" in conf and "tradable_balance_ratio" in conf:
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in your config. "
+            "Only one of these settings can take effect at a time - `available_capital` will "
+            "be used and `tradable_balance_ratio` will be ignored. Please remove one of them."
+        )
+
