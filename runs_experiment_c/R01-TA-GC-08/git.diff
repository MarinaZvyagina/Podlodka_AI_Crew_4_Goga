+def _validate_capital_settings(conf: dict[str, Any]) -> None:
+    """
+    `available_capital` and `tradable_balance_ratio` are two different ways to size the bot's
+    starting capital. Only one of them is ever used (available_capital takes precedence) - the
+    other is silently ignored, which surprises users who set both expecting them to combine.
+    """
+    tradable_balance_ratio_default = CONF_SCHEMA["properties"]["tradable_balance_ratio"]["default"]
+    if "available_capital" in conf and conf.get(
+        "tradable_balance_ratio", tradable_balance_ratio_default
+    ) != tradable_balance_ratio_default:
+        raise ConfigurationError(
+            "Both `available_capital` and `tradable_balance_ratio` are set in your "
+            "configuration. Only one of these settings is used to size your starting "
+            "capital, and the other one will be silently ignored. Please remove one of them."
+        )
+
