+@pytest.mark.parametrize(
+    "max_currency_exposure,total_stake,open_trades,pair,expected",
+    [
+        # Disabled (default) - no cap applied regardless of open trades.
+        (1.0, 1000, [], "ETH/USDT", None),
+        # No open trades sharing the currency - full share of total capital available.
+        (0.5, 1000, [], "ETH/USDT", 500),
+        # Existing exposure in the same currency reduces the remaining allowance.
+        (0.5, 1000, [("LTC/USDT", 300)], "ETH/USDT", 200),
+        # Existing exposure in a different currency does not affect the allowance.
+        (0.5, 1000, [("BTC/EUR", 300)], "ETH/USDT", 500),
+        # Exposure already at/above the cap - no remaining allowance, floored at 0.
+        (0.5, 1000, [("LTC/USDT", 600)], "ETH/USDT", 0),
+    ],
+)
+def test_get_max_stake_for_currency_exposure(
+    mocker, default_conf, max_currency_exposure, total_stake, open_trades, pair, expected
+):
+    default_conf["max_currency_exposure"] = max_currency_exposure
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=total_stake)
+    mocker.patch(
+        f"{EXMS}.get_pair_quote_currency", side_effect=lambda pair: pair.split("/")[1]
+    )
+    mocker.patch(
+        "freqtrade.wallets.Trade.get_open_trades",
+        return_value=[MagicMock(pair=p, stake_amount=s) for p, s in open_trades],
+    )
+
+    assert freqtrade.wallets._get_max_stake_for_currency_exposure(pair) == expected
+
+
+def test_validate_stake_amount_currency_exposure(mocker, default_conf):
+    default_conf["max_currency_exposure"] = 0.5
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=1000)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=1000)
+    mocker.patch(
+        f"{EXMS}.get_pair_quote_currency", side_effect=lambda pair: pair.split("/")[1]
+    )
+    mocker.patch(
+        "freqtrade.wallets.Trade.get_open_trades",
+        return_value=[MagicMock(pair="LTC/USDT", stake_amount=300)],
+    )
+
+    # Remaining allowance for USDT is 500 - 300 = 200, so the 300 requested is capped to 200.
+    res = freqtrade.wallets.validate_stake_amount("ETH/USDT", 300, 10, 10000, None)
+    assert res == 200
+
+    # A pair quoted in a different currency is unaffected by USDT exposure.
+    res = freqtrade.wallets.validate_stake_amount("BTC/EUR", 300, 10, 10000, None)
+    assert res == 300
+
+    # Remaining allowance below min_stake_amount - trade is skipped entirely.
+    res = freqtrade.wallets.validate_stake_amount("ETH/USDT", 300, 250, 10000, None)
+    assert res == 0
+
+
+def test_execute_entry_max_currency_exposure(mocker, default_conf, limit_buy_order_open, fee):
+    """
+    Mirrors test_backtest__enter_trade_max_currency_exposure in test_backtesting.py:
+    same config (dry_run_wallet=1000, tradable_balance_ratio=0.99, max_open_trades=2,
