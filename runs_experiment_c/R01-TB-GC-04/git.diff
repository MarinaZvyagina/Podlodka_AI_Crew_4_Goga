+def test_backtest__enter_trade_max_currency_exposure(default_conf, fee, mocker) -> None:
+    default_conf["use_exit_signal"] = False
+    mocker.patch(f"{EXMS}.get_fee", fee)
+    mocker.patch(f"{EXMS}.get_min_pair_stake_amount", return_value=0.00001)
+    mocker.patch(f"{EXMS}.get_max_pair_stake_amount", return_value=float("inf"))
+    patch_exchange(mocker)
+    default_conf["stake_amount"] = "unlimited"
+    default_conf["max_open_trades"] = 2
+    default_conf["max_currency_exposure"] = 0.3
+    backtesting = Backtesting(default_conf)
+    backtesting._set_strategy(backtesting.strategylist[0])
+    pair = "UNITTEST/BTC"
+    row = [
+        pd.Timestamp(year=2020, month=1, day=1, hour=5, minute=0),
+        1,  # Buy
+        0.001,  # Open
+        0.0011,  # Close
+        0,  # Sell
+        0.00099,  # Low
+        0.0012,  # High
+        "",  # Buy Signal Name
+    ]
+    # Unlimited stake with max_open_trades=2 would normally propose 495 (990 available / 2),
+    # but max_currency_exposure=0.3 caps combined BTC exposure to 990 * 0.3 = 297.
+    trade = backtesting._enter_trade(pair, row=row, direction="long")
+    assert isinstance(trade, LocalTrade)
+    assert trade.stake_amount == pytest.approx(297)
+
+    LocalTrade.bt_trades_open.pop()
+
