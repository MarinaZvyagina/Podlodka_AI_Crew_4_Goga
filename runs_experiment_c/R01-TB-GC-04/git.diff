+    def _get_currency_exposure_stake(self, currency: str) -> float:
+        """
+        Sum of stake amounts currently committed to open trades whose pair shares
+        the given (quote) currency.
+        """
+        return sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if self._exchange.get_pair_quote_currency(trade.pair) == currency
+        )
+
+    def _get_max_stake_for_currency_exposure(self, pair: str) -> float | None:
+        """
+        Determine the remaining stake amount that may still be committed to trades
+        sharing the same underlying (quote) currency as `pair`, based on the configured
+        `max_currency_exposure`.
+        :return: None if no cap is configured (or the configured cap does not restrict
+        anything), else the remaining stake amount still available for that currency.
+        """
+        max_currency_exposure = self._config.get("max_currency_exposure", 1.0)
+        if max_currency_exposure >= 1:
+            return None
+
+        currency = self._exchange.get_pair_quote_currency(pair)
+        max_exposure_stake = self.get_total_stake_amount() * max_currency_exposure
+        current_exposure_stake = self._get_currency_exposure_stake(currency)
+        return max(max_exposure_stake - current_exposure_stake, 0)
+
