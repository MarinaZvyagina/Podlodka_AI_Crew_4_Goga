+def test_get_currency_exposure(mocker, default_conf):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+
+    open_trades = [
+        MagicMock(pair="ETH/USDT", stake_amount=100.0, safe_quote_currency="USDT"),
+        MagicMock(pair="BTC/USDT", stake_amount=50.0, safe_quote_currency="USDT"),
+        MagicMock(pair="ETH/BTC", stake_amount=10.0, safe_quote_currency="BTC"),
+    ]
+    mocker.patch(
+        "freqtrade.persistence.trade_model.Trade.get_open_trades", return_value=open_trades
+    )
+
+    assert freqtrade.wallets.get_currency_exposure("USDT") == 150.0
+    assert freqtrade.wallets.get_currency_exposure("USDT", exclude_pair="ETH/USDT") == 50.0
+    assert freqtrade.wallets.get_currency_exposure("BTC") == 10.0
+    assert freqtrade.wallets.get_currency_exposure("EUR") == 0.0
+
+
+@pytest.mark.parametrize(
+    "max_exposure,other_exposure,total_stake,trade_amount,stake_amount,expected",
+    [
+        # No cap configured - unrestricted.
+        (None, 400, 1000, None, 500, 500),
+        # 50% cap, 400 already committed to this currency -> 100 headroom left.
+        (0.5, 400, 1000, None, 500, 100),
+        # 50% cap, nothing committed yet -> full stake amount allowed.
+        (0.5, 0, 1000, None, 500, 500),
+        # 50% cap already exceeded by other trades -> new trade fully blocked.
+        (0.5, 600, 1000, None, 500, 0),
+        # DCA: 50% cap, 200 in other pairs, this trade already holds 200,
+        # adding 200 more would total 600 > 500 cap -> capped to 100 additional.
+        (0.5, 200, 1000, 200, 200, 100),
+    ],
+)
+def test_validate_stake_amount_max_currency_exposure(
+    mocker,
+    default_conf,
+    max_exposure,
+    other_exposure,
+    total_stake,
+    trade_amount,
+    stake_amount,
+    expected,
+):
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    if max_exposure is not None:
+        freqtrade.config["max_currency_exposure"] = max_exposure
+
+    mocker.patch("freqtrade.wallets.Wallets.get_available_stake_amount", return_value=stake_amount)
+    mocker.patch("freqtrade.wallets.Wallets.get_total_stake_amount", return_value=total_stake)
+    mocker.patch("freqtrade.wallets.Wallets.get_currency_exposure", return_value=other_exposure)
+
+    res = freqtrade.wallets.validate_stake_amount(
+        "XRP/USDT", stake_amount, None, 10000, trade_amount
+    )
+    assert res == expected
+
+
