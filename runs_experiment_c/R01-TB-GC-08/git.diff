+def test_strategy_override_max_currency_exposure(caplog, default_conf):
+    caplog.set_level(logging.INFO)
+    default_conf.update({"strategy": CURRENT_TEST_STRATEGY, "max_currency_exposure": 0.4})
+    strategy = StrategyResolver.load_strategy(default_conf)
+
+    assert strategy.max_currency_exposure == 0.4
+    assert log_has(
+        "Override strategy 'max_currency_exposure' with value from the configuration: 0.4.",
+        caplog,
+    )
+
+
+def test_strategy_default_max_currency_exposure(default_conf):
+    default_conf.update({"strategy": CURRENT_TEST_STRATEGY})
+    strategy = StrategyResolver.load_strategy(default_conf)
+
+    assert strategy.max_currency_exposure is None
+    assert "max_currency_exposure" not in default_conf
+
