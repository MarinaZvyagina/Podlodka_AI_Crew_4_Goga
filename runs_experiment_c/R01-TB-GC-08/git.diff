+    def get_currency_exposure(self, currency: str, exclude_pair: str | None = None) -> float:
+        """
+        Sum of stake amounts currently committed to open trades that share the given
+        underlying (quote/settlement) currency.
+        :param currency: Underlying currency to sum exposure for.
+        :param exclude_pair: Pair to exclude from the sum (the trade being sized itself).
+        """
+        return sum(
+            trade.stake_amount
+            for trade in Trade.get_open_trades()
+            if trade.safe_quote_currency == currency and trade.pair != exclude_pair
+        )
+
+    def _currency_exposure_headroom(self, pair: str, trade_amount: float | None) -> float | None:
+        """
+        Remaining stake headroom for `pair`'s underlying currency before
+        `max_currency_exposure` - the configured maximum fraction of tradable capital
+        allowed in a single underlying currency across all open trades - is reached.
+        :return: None if max_currency_exposure is not configured, else the remaining headroom.
+        """
+        max_exposure_ratio = self._config.get("max_currency_exposure")
+        if not max_exposure_ratio:
+            return None
+
+        currency = self._exchange.get_pair_quote_currency(pair)
+        currency_cap = self.get_total_stake_amount() * max_exposure_ratio
+        other_exposure = self.get_currency_exposure(
+            currency, exclude_pair=pair if trade_amount else None
+        )
+        headroom = max(currency_cap - other_exposure - (trade_amount or 0), 0)
+        self._local_log(
+            f"Currency exposure for {pair} ({currency}): {other_exposure:.8f} already "
+            f"committed, {headroom:.8f} of {currency_cap:.8f} cap "
+            f"({max_exposure_ratio:.0%}) remaining.",
+            level="debug",
+        )
+        return headroom
+
