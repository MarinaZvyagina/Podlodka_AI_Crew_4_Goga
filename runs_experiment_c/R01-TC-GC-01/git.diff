+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses_per_pair(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "trade_limit": 3,
+            "stop_duration": 60,
+            "only_per_pair": True,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*consecutive losses.*"
+    pair = "XRP/BTC"
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2 consecutive losses - not yet enough to lock.
+    for i in range(2):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.STOP_LOSS.value,
+            min_ago_open=200 - i * 10,
+            min_ago_close=150 - i * 10,
+            profit_rate=0.9,
+        )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not log_has_re(message, caplog)
+
+    # A winning trade breaks the streak.
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        min_ago_open=100,
+        min_ago_close=90,
+        profit_rate=1.15,
+    )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not log_has_re(message, caplog)
+
+    # 2 consecutive losses after the win - still not 3 in a row.
+    for i in range(2):
+        generate_mock_trade(
+            pair,
+            fee.return_value,
+            False,
+            exit_reason=ExitType.STOP_LOSS.value,
+            min_ago_open=80 - i * 10,
+            min_ago_close=70 - i * 10,
+            profit_rate=0.9,
+        )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=50,
+        min_ago_close=40,
+        profit_rate=0.9,
+    )
+    # 3rd consecutive loss - now locked.
+    assert freqtrade.protections.stop_per_pair(pair)
+    assert PairLocks.is_pair_locked(pair)
+    assert log_has_re(message, caplog)
+    # only_per_pair disables the bot-wide check.
+    assert not freqtrade.protections.global_stop()
+    assert not PairLocks.is_global_lock()
+
+
+@pytest.mark.parametrize("only_per_pair", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses_global(mocker, default_conf, fee, caplog, only_per_pair):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "trade_limit": 2,
+            "stop_duration": 60,
+            "only_per_pair": only_per_pair,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*consecutive losses.*"
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=200,
+        min_ago_close=100,
+        profit_rate=0.9,
+    )
+    # Only 1 losing trade overall - not enough for either check.
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2nd consecutive loss, on a different pair.
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=90,
+        min_ago_close=50,
+        profit_rate=0.9,
+    )
+    # ETH/BTC itself only has 1 losing trade, so the per-pair check does not lock it.
+    assert not freqtrade.protections.stop_per_pair("ETH/BTC")
+    assert not PairLocks.is_pair_locked("ETH/BTC")
+    # But 2 losses in a row across all pairs trips the bot-wide check, unless disabled.
+    assert freqtrade.protections.global_stop() != only_per_pair
+    assert PairLocks.is_global_lock() != only_per_pair
+    assert log_has_re(message, caplog) != only_per_pair
+
