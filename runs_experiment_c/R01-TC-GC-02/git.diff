+@pytest.mark.usefixtures("init_persistence")
+def test_MaxLossStreak(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {"method": "MaxLossStreak", "lookback_period": 400, "stop_duration": 40, "trade_limit": 3}
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*"
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 1st loss in a row
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=200,
+        min_ago_close=150,
+        profit_rate=0.9,
+    )
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2nd loss in a row
+    generate_mock_trade(
+        "BCH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=140,
+        min_ago_close=100,
+        profit_rate=0.9,
+    )
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # A winning trade resets the streak
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=90,
+        min_ago_close=80,
+        profit_rate=1.1,
+    )
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # Only 2 fresh losses since the win - not enough yet
+    generate_mock_trade(
+        "LTC/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=70,
+        min_ago_close=60,
+        profit_rate=0.9,
+    )
+    generate_mock_trade(
+        "ADA/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=50,
+        min_ago_close=40,
+        profit_rate=0.9,
+    )
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 3rd loss in a row triggers the guard, locking all pairs
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=30,
+        min_ago_close=20,
+        profit_rate=0.9,
+    )
+    assert freqtrade.protections.global_stop()
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_global_lock()
+
