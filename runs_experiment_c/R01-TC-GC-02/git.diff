+def test_MaxLossStreak_only_per_pair(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxLossStreak",
+            "lookback_period": 400,
+            "stop_duration": 40,
+            "trade_limit": 2,
+            "only_per_pair": True,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*"
+
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=140,
+        min_ago_close=100,
+        profit_rate=0.9,
+    )
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=90,
+        min_ago_close=60,
+        profit_rate=0.9,
+    )
+    # Bot-wide streak of 2 losses in a row - but global_stop is disabled via only_per_pair.
+    assert not freqtrade.protections.global_stop()
