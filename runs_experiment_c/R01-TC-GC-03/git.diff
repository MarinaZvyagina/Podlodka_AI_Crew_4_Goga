+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses_streak_reset_by_win(mocker, default_conf, fee):
+    # A single winning (or breakeven) trade must reset the streak - this protection is about
+    # consecutive losses, not total/windowed profit (that's LowProfitPairs/StoplossGuard).
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 300,
+            "stop_duration": 40,
+            "trade_limit": 3,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    pair = "XRP/BTC"
+
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=150,
+        min_ago_close=120,
+        profit_rate=0.9,
+    )
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=100,
+        min_ago_close=80,
+        profit_rate=0.9,
+    )
+    assert not freqtrade.protections.global_stop()
+
+    # Winning trade breaks the streak
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=70,
+        min_ago_close=50,
+        profit_rate=1.1,
+    )
+    assert not freqtrade.protections.global_stop()
+
+    # 2 more losses after the win - streak restarted, still below trade_limit of 3
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=40,
+        min_ago_close=30,
+        profit_rate=0.9,
+    )
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=20,
+        min_ago_close=10,
+        profit_rate=0.9,
+    )
+    assert not freqtrade.protections.global_stop()
+
+    # 3rd consecutive loss since the win triggers the lock
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=9,
+        min_ago_close=5,
+        profit_rate=0.9,
+    )
+    assert freqtrade.protections.global_stop()
+    assert PairLocks.is_global_lock()
+
+
+@pytest.mark.parametrize("only_per_pair", [False, True])
+@pytest.mark.parametrize("only_per_side", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_max_consecutive_losses_perpair(
+    mocker, default_conf, fee, caplog, only_per_pair, only_per_side
+):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "lookback_period": 60,
+            "trade_limit": 2,
+            "stop_duration": 60,
+            "only_per_pair": only_per_pair,
+            "only_per_side": only_per_side,
+        }
+    ]
+    check_side = "long" if only_per_side else "*"
+    is_short = False
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*"
+    pair = "XRP/BTC"
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=200,
+        min_ago_close=30,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+    # Trade does not count for per pair stop as it's the wrong pair.
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=240,
+        min_ago_close=30,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert freqtrade.protections.global_stop() != only_per_pair
+    if not only_per_pair:
+        assert log_has_re(message, caplog)
+    else:
+        assert not log_has_re(message, caplog)
+
+    caplog.clear()
+
+    # Trade does not count potentially, as it's in the wrong direction
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=150,
+        min_ago_close=25,
+        profit_rate=0.9,
+        is_short=not is_short,
+    )
+    freqtrade.protections.stop_per_pair(pair)
+    assert freqtrade.protections.global_stop() != only_per_pair
+    assert PairLocks.is_pair_locked(pair, side=check_side) != (only_per_side and only_per_pair)
+    assert PairLocks.is_global_lock(side=check_side) != only_per_pair
+    if only_per_side:
+        assert not PairLocks.is_pair_locked(pair, side="*")
+        assert not PairLocks.is_global_lock(side="*")
+
+    caplog.clear()
+
+    # 2nd Trade that counts with correct pair
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.EXIT_SIGNAL.value,
+        min_ago_open=180,
+        min_ago_close=20,
+        profit_rate=0.9,
+        is_short=is_short,
+    )
+
+    freqtrade.protections.stop_per_pair(pair)
+    assert freqtrade.protections.global_stop() != only_per_pair
+    assert PairLocks.is_pair_locked(pair, side=check_side)
+    assert PairLocks.is_global_lock(side=check_side) != only_per_pair
+    if only_per_side:
+        assert not PairLocks.is_pair_locked(pair, side="*")
+        assert not PairLocks.is_global_lock(side="*")
+
