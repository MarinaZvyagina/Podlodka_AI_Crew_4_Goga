+import logging
+from datetime import datetime, timedelta
+from typing import Any
+
+from freqtrade.constants import Config, LongShort
+from freqtrade.persistence import Trade
+from freqtrade.plugins.protections import IProtection, ProtectionReturn
+
+
+logger = logging.getLogger(__name__)
+
+
+class MaxLosingStreak(IProtection):
+    has_global_stop: bool = True
+    has_local_stop: bool = True
+
+    def __init__(self, config: Config, protection_config: dict[str, Any]) -> None:
+        super().__init__(config, protection_config)
+
+        self._trade_limit = protection_config.get("trade_limit", 4)
+        self._disable_global_stop = protection_config.get("only_per_pair", False)
+        self._required_profit = protection_config.get("required_profit", 0.0)
+
+    def short_desc(self) -> str:
+        """
+        Short method description - used for startup-messages
+        """
+        return (
+            f"{self.name} - Max Losing Streak Guard, stop trading after "
+            f"{self._trade_limit} consecutive losses within {self.lookback_period_str}."
+        )
+
+    def _reason(self) -> str:
+        """
+        LockReason to use
+        """
+        return f"{self._trade_limit} consecutive losses, locking {self.unlock_reason_time_element}."
+
+    def _find_losing_streak(self, trades: list) -> list:
+        """
+        Walk trades from most-recent to oldest, collecting an unbroken run of losses.
+        Stops at the first trade that isn't a loss.
+        """
+        streak = []
+        for trade in sorted(trades, key=lambda t: t.close_date, reverse=True):
+            if trade.close_profit is not None and trade.close_profit < self._required_profit:
+                streak.append(trade)
+            else:
+                break
+        return streak
+
+    def _max_losing_streak(
+        self, date_now: datetime, pair: str | None, side: LongShort
+    ) -> ProtectionReturn | None:
+        """
+        Evaluate recent trades for a consecutive-loss streak
+        """
+        look_back_until = date_now - timedelta(minutes=self._lookback_period)
+        trades = Trade.get_trades_proxy(pair=pair, is_open=False, close_date=look_back_until)
+
+        streak = self._find_losing_streak(trades)
+        if len(streak) < self._trade_limit:
+            return None
+
+        self.log_once(
+            f"Trading stopped due to {self._trade_limit} consecutive losses "
+            f"for {pair if pair else 'all pairs'}.",
+            logger.info,
+        )
+        until = self.calculate_lock_end(streak)
+        return ProtectionReturn(
+            lock=True,
+            until=until,
+            reason=self._reason(),
+        )
+
+    def global_stop(
+        self, date_now: datetime, side: LongShort, starting_balance: float
+    ) -> ProtectionReturn | None:
+        """
+        Stops trading (position entering) for all pairs
+        This must evaluate to true for the whole period of the "cooldown period".
+        :return: Tuple of [bool, until, reason].
+            If true, all pairs will be locked with <reason> until <until>
+        """
+        if self._disable_global_stop:
+            return None
+        return self._max_losing_streak(date_now, None, side)
+
+    def stop_per_pair(
+        self, pair: str, date_now: datetime, side: LongShort, starting_balance: float
+    ) -> ProtectionReturn | None:
+        """
+        Stops trading (position entering) for this pair
+        This must evaluate to true for the whole period of the "cooldown period".
+        :return: Tuple of [bool, until, reason].
+            If true, this pair will be locked with <reason> until <until>
+        """
+        return self._max_losing_streak(date_now, pair, side)
