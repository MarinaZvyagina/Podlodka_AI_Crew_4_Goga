+@pytest.mark.usefixtures("init_persistence")
+def test_MaxLosingStreak(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxLosingStreak",
+            "lookback_period": 400,
+            "stop_duration": 60,
+            "trade_limit": 3,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*consecutive losses.*"
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2 losses in a row - not enough yet
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=100,
+        min_ago_close=90,
+        profit_rate=0.9,
+    )
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=85,
+        min_ago_close=80,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    assert not freqtrade.protections.global_stop()
+
+    # A win in between breaks the streak - the 2 prior losses no longer count
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        min_ago_open=75,
+        min_ago_close=70,
+        profit_rate=1.1,
+    )
+    Trade.commit()
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+
+    # Fresh streak of 3 consecutive losses, starting after the win
+    generate_mock_trade(
+        "NEO/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=65,
+        min_ago_close=60,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    assert not freqtrade.protections.global_stop()
+
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=45,
+        min_ago_close=40,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    assert not freqtrade.protections.global_stop()
+
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=15,
+        min_ago_close=10,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    assert freqtrade.protections.global_stop()
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_global_lock()
+
+
+@pytest.mark.parametrize("only_per_pair", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_MaxLosingStreak_perpair(mocker, default_conf, fee, only_per_pair):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxLosingStreak",
+            "lookback_period": 400,
+            "stop_duration": 60,
+            "trade_limit": 2,
+            "only_per_pair": only_per_pair,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    pair = "XRP/BTC"
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=70,
+        min_ago_close=50,
+        profit_rate=0.9,
+    )
+    # Different pair - does not add to XRP/BTC's per-pair streak,
+    # but does contribute to the bot-wide streak.
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=60,
+        min_ago_close=40,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert freqtrade.protections.global_stop() != only_per_pair
+
+    # 2nd consecutive loss on XRP/BTC - now locks per-pair regardless of only_per_pair
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=30,
+        min_ago_close=10,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+
+    assert freqtrade.protections.stop_per_pair(pair)
+    assert PairLocks.is_pair_locked(pair)
+
