+@pytest.mark.parametrize("only_per_pair", [False, True])
+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses_perpair(mocker, default_conf, fee, caplog, only_per_pair):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "max_consecutive_losses": 2,
+            "stop_duration": 60,
+            "only_per_pair": only_per_pair,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*"
+    pair = "XRP/BTC"
+
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not freqtrade.protections.global_stop()
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 1 loss - not enough yet
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=200,
+        min_ago_close=100,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # A win breaks the streak
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.ROI.value,
+        min_ago_open=90,
+        min_ago_close=50,
+        profit_rate=1.15,
+    )
+    Trade.commit()
+    assert not freqtrade.protections.stop_per_pair(pair)
+
+    # 1 loss after the win - streak restarts, still not enough
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=45,
+        min_ago_close=30,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    assert not freqtrade.protections.stop_per_pair(pair)
+    assert not log_has_re(message, caplog)
+    caplog.clear()
+
+    # 2nd consecutive loss - locks the pair (and, unless only_per_pair, the whole bot)
+    generate_mock_trade(
+        pair,
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=25,
+        min_ago_close=10,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+
+    assert freqtrade.protections.stop_per_pair(pair)
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_pair_locked(pair)
+
+    global_lock = freqtrade.protections.global_stop()
+    assert (global_lock is not None) != only_per_pair
+    assert PairLocks.is_global_lock() != only_per_pair
+
+
+@pytest.mark.usefixtures("init_persistence")
+def test_MaxConsecutiveLosses_global_crosses_pairs(mocker, default_conf, fee, caplog):
+    default_conf["_strategy_protections"] = [
+        {
+            "method": "MaxConsecutiveLosses",
+            "max_consecutive_losses": 2,
+            "stop_duration": 60,
+        }
+    ]
+    freqtrade = get_patched_freqtradebot(mocker, default_conf)
+    message = r"Trading stopped due to .*"
+
+    # 1 loss on XRP/BTC, then 1 loss on ETH/BTC - not enough on either pair alone,
+    # but 2 losses in a row bot-wide.
+    generate_mock_trade(
+        "XRP/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=100,
+        min_ago_close=60,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+    generate_mock_trade(
+        "ETH/BTC",
+        fee.return_value,
+        False,
+        exit_reason=ExitType.STOP_LOSS.value,
+        min_ago_open=50,
+        min_ago_close=20,
+        profit_rate=0.9,
+    )
+    Trade.commit()
+
+    # Neither pair reached its own consecutive-loss streak yet
+    assert not freqtrade.protections.stop_per_pair("XRP/BTC")
+    assert not freqtrade.protections.stop_per_pair("ETH/BTC")
+    assert not log_has_re(message, caplog)
+    assert not PairLocks.is_global_lock()
+
+    # ...but 2 losses in a row bot-wide trip the global lock
+    assert freqtrade.protections.global_stop()
+    assert log_has_re(message, caplog)
+    assert PairLocks.is_global_lock()
+
+
