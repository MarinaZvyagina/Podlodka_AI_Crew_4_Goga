+def test_ticker_cache(mocker, default_conf, tickers, time_machine):
+    start_dt = datetime.now(UTC)
+    time_machine.move_to(start_dt, tick=False)
+
+    ticker_mock = MagicMock(return_value=tickers()["ETH/BTC"])
+    mocker.patch(f"{EXMS}.fetch_ticker", ticker_mock)
+    exchange = get_patched_exchange(mocker, default_conf)
+    dp = DataProvider(default_conf, exchange)
+
+    res = dp.ticker("ETH/BTC")
+    assert res["symbol"] == "ETH/BTC"
+    assert ticker_mock.call_count == 1
+
+    # Requesting again within the cache window must not hit the exchange again.
+    res = dp.ticker("ETH/BTC")
+    assert res["symbol"] == "ETH/BTC"
+    assert ticker_mock.call_count == 1
+
+    # A different pair is not affected by the cache for "ETH/BTC".
+    dp.ticker("BTC/USDT")
+    assert ticker_mock.call_count == 2
+
+    # Once the cache expires, the ticker is fetched again.
+    time_machine.move_to(start_dt + timedelta(seconds=5), tick=False)
+    dp.ticker("ETH/BTC")
+    assert ticker_mock.call_count == 3
+
+    # A failed fetch must not be cached - the next call should retry.
+    ticker_mock.reset_mock()
+    ticker_mock.side_effect = ExchangeError("Pair not found")
+    assert dp.ticker("XRP/USDT") == {}
+    assert dp.ticker("XRP/USDT") == {}
+    assert ticker_mock.call_count == 2
+
+
