+@pytest.mark.parametrize("exchange_name", EXCHANGES)
+def test_fetch_ticker_cached(default_conf, mocker, exchange_name, time_machine):
+    start_dt = datetime(2023, 12, 1, 0, 10, 0, tzinfo=UTC)
+    time_machine.move_to(start_dt, tick=False)
+    api_mock = MagicMock()
+    tick = {
+        "symbol": "ETH/BTC",
+        "bid": 0.00001098,
+        "ask": 0.00001099,
+        "last": 0.0001,
+    }
+    api_mock.fetch_ticker = MagicMock(return_value=tick)
+    api_mock.markets = {"ETH/BTC": {"active": True}}
+    exchange = get_patched_exchange(mocker, default_conf, api_mock, exchange=exchange_name)
+
+    # Uncached calls always hit the exchange.
+    exchange.fetch_ticker(pair="ETH/BTC")
+    exchange.fetch_ticker(pair="ETH/BTC")
+    assert api_mock.fetch_ticker.call_count == 2
+
+    api_mock.fetch_ticker.reset_mock()
+    exchange._fetch_ticker_cache.clear()
+    # First cached call still has to hit the exchange ...
+    ticker = exchange.fetch_ticker(pair="ETH/BTC", cached=True)
+    assert api_mock.fetch_ticker.call_count == 1
+    assert ticker == tick
+
+    # ... but a 2nd cached call shortly after reuses the cached ticker.
+    tick2 = {"symbol": "ETH/BTC", "bid": 0.5, "ask": 1, "last": 42}
+    api_mock.fetch_ticker = MagicMock(return_value=tick2)
+    ticker = exchange.fetch_ticker(pair="ETH/BTC", cached=True)
+    assert api_mock.fetch_ticker.call_count == 0
+    assert ticker == tick
+
+    # Once the (short) cache ttl elapses, a cached call fetches again.
+    time_machine.move_to(start_dt + timedelta(seconds=5), tick=False)
+    ticker = exchange.fetch_ticker(pair="ETH/BTC", cached=True)
+    assert api_mock.fetch_ticker.call_count == 1
+    assert ticker == tick2
+
+
