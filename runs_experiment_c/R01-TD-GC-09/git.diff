+@pytest.mark.parametrize("exchange_name", EXCHANGES)
+def test_fetch_ticker_cached(default_conf, mocker, exchange_name, time_machine):
+    start_dt = datetime(2023, 12, 1, 0, 10, 0, tzinfo=UTC)
+    time_machine.move_to(start_dt, tick=False)
+    api_mock = MagicMock()
+    tick = {
+        "symbol": "ETH/BTC",
+        "bid": 0.00001098,
+        "ask": 0.00001099,
+        "last": 0.0001,
+    }
+    api_mock.fetch_ticker = MagicMock(return_value=tick)
+    api_mock.markets = {"ETH/BTC": {"active": True}}
+    exchange = get_patched_exchange(mocker, default_conf, api_mock, exchange=exchange_name)
+
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert ticker == tick
+    assert api_mock.fetch_ticker.call_count == 1
+
+    # Requesting again within the short TTL window reuses the cached ticker
+    # instead of hitting the exchange again.
+    time_machine.move_to(start_dt + timedelta(seconds=1), tick=False)
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert ticker == tick
+    assert api_mock.fetch_ticker.call_count == 1
+
+    # Once the cache expires, the ticker is fetched again from the exchange.
+    time_machine.move_to(start_dt + timedelta(seconds=3), tick=False)
+    ticker = exchange.fetch_ticker(pair="ETH/BTC")
+    assert ticker == tick
+    assert api_mock.fetch_ticker.call_count == 2
+
+
