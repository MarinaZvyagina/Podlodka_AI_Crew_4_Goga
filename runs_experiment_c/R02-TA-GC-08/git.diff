@@ -83,6 +102,23 @@ def beacon(config):
     which means that if a regular expression matches another defined mount point,
     it will override the previously defined threshold.
 
+    A mount can also be monitored for usage dropping below an expected
+    floor, which in practice almost always means the filesystem silently
+    failed to mount rather than that space was genuinely freed up. To do
+    so, use a mapping of ``minimum_usage`` and/or ``maximum_usage`` instead
+    of a bare percentage. Both can be given together to watch the same
+    mount for high and low usage at once.
+
+    .. code-block:: yaml
+
+        beacons:
+          diskusage:
+            - /mnt/nfs:
+                minimum_usage: 10%
+                maximum_usage: 90%
+            - /mnt/backup:
+                minimum_usage: 5%
+
     """
     whitelist = []
     config = salt.utils.beacons.remove_hidden_options(config, whitelist)
@@ -90,6 +126,14 @@ def beacon(config):
     ret = []
     for mounts in config:
         mount = next(iter(mounts))
+        thresholds = mounts[mount]
+
+        if isinstance(thresholds, dict):
+            maximum_usage = thresholds.get("maximum_usage")
+            minimum_usage = thresholds.get("minimum_usage")
+        else:
+            maximum_usage = thresholds
+            minimum_usage = None
 
         # Because we're using regular expressions
         # if our mount doesn't end with a $, insert one.
@@ -117,10 +161,18 @@ def beacon(config):
                     continue
 
                 current_usage = _current_usage.percent
-                monitor_usage = mounts[mount]
-                if isinstance(monitor_usage, str) and "%" in monitor_usage:
-                    monitor_usage = re.sub("%", "", monitor_usage)
-                monitor_usage = float(monitor_usage)
-                if current_usage >= monitor_usage:
-                    ret.append({"diskusage": current_usage, "mount": _mount})
+
+                if maximum_usage is not None:
+                    if current_usage >= _to_percent(maximum_usage):
+                        ret.append({"diskusage": current_usage, "mount": _mount})
+
+                if minimum_usage is not None:
+                    if current_usage <= _to_percent(minimum_usage):
+                        ret.append(
+                            {
