+@pytest.mark.slow_test
+def test_status():
+    """
+    Test getting the last-run status of configured beacons, including one
+    that has never fired.
+    """
+    event_returns = [
+        {
+            "complete": True,
+            "tag": "/salt/minion/minion_beacons_status_complete",
+            "beacons": {
+                "ps": {"last_run": 1700000000.0, "last_error": None},
+                "inotify": {"last_run": None, "last_error": None},
+                "load": {
+                    "last_run": 1700000005.0,
+                    "last_error": "watched file missing",
+                },
+            },
+        },
+    ]
+
+    mock = MagicMock(return_value=True)
+    with patch.dict(beacons.__salt__, {"event.fire": mock}):
+        with patch.object(SaltEvent, "get_event", side_effect=event_returns):
+            ret = beacons.status()
+
+    expected_ps_last_run = datetime.datetime.fromtimestamp(1700000000.0).strftime(
+        "%Y-%m-%dT%H:%M:%S"
+    )
+    assert ret["ps"] == {
+        "last_run": expected_ps_last_run,
+        "last_error": None,
+    }
+    assert ret["inotify"] == {"last_run": None, "last_error": None}
+    assert ret["load"]["last_error"] == "watched file missing"
+
