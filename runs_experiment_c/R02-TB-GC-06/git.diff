+def status(time_fmt="%Y-%m-%dT%H:%M:%S", **kwargs):
+    """
+    Show whether each of the minion's currently configured beacons is
+    actually running: the time it last fired and whether that run raised
+    an error.
+
+    .. versionadded:: 3008.0
+
+    This reflects live beacon activity as tracked by the running minion
+    process itself, so it is accurate immediately after a beacon fires --
+    no log parsing, waiting for a new probe cycle, or minion restart
+    required. A beacon that hasn't fired yet since the minion (re)loaded
+    its beacons reports ``last_run`` as ``None``.
+
+    :param time_fmt:    strftime format used to render each beacon's
+                        ``last_run``, default ``"%Y-%m-%dT%H:%M:%S"``.
+    :return:            Dict keyed by beacon name, each value a dict with
+                        ``last_run`` (``None`` if the beacon has never
+                        fired) and ``last_error`` (the error raised by
+                        the last run, or ``None`` if it succeeded or has
+                        never fired).
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+    """
+    status = None
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"]({"func": "status"}, "manage_beacons")
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacons_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                if event_ret and event_ret["complete"]:
+                    status = event_ret["beacons"]
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret = {}
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+        return ret
+
+    if not status:
+        return {}
+
+    return {
+        beacon_name: {
+            "last_run": (
+                datetime.datetime.fromtimestamp(info["last_run"]).strftime(time_fmt)
+                if info["last_run"] is not None
+                else None
+            ),
+            "last_error": info["last_error"],
+        }
+        for beacon_name, info in status.items()
+    }
+
+
