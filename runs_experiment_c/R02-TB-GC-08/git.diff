+def test_beacon_status_map_preserved_across_instances(minion_opts):
+    """
+    Test that passing a previous status_map into a new Beacon (as
+    beacons_refresh() does on the minion) keeps the collected status
+    history instead of resetting it.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+    prev_status = beacon.status
+
+    new_beacon = salt.beacons.Beacon(minion_opts, [], status_map=prev_status)
+
+    assert new_beacon.status is prev_status
+    assert "watch_apache" in new_beacon.status
