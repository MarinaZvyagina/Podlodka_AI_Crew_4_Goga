+    def list_beacons_status(self, include_pillar=True, include_opts=True):
+        """
+        Return, for each currently configured beacon, when it last actually
+        executed and whether that execution raised an error.
+
+        This is populated live as beacons run in process(), so it reflects
+        real activity rather than a probe or the configuration itself. A
+        beacon that is configured but has not yet run reports
+        ``last_run: None``.
+
+        include_pillar: Whether to include beacons that are
+                        configured in pillar, default is True.
+
+        include_opts:   Whether to include beacons that are
+                        configured in opts, default is True.
+        """
+        beacons = self._get_beacons(
+            include_pillar=include_pillar, include_opts=include_opts
+        )
+
+        status = {}
+        for name in beacons:
+            if name == "enabled":
+                continue
+            beacon_status = self.status.get(name)
+            if beacon_status is None:
+                status[name] = {"last_run": None, "last_error": None}
+            else:
+                status[name] = dict(beacon_status)
+
+        # Fire the complete event back along with the beacon status
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacons": status},
+                tag="/salt/minion/minion_beacons_status_complete",
+            )
+
+        return True
