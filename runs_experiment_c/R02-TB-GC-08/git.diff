+@pytest.mark.slow_test
+def test_list_status():
+    """
+    Test showing the last-run/error status of configured beacons, and
+    that a beacon which hasn't fired yet reports last_run as None.
+    """
+    last_run = datetime.datetime(2023, 1, 1, 12, 0, 0)
+    event_returns = [
+        {
+            "complete": True,
+            "tag": "/salt/minion/minion_beacons_status_complete",
+            "beacons": {
+                "ps": {"last_run": last_run, "last_error": None},
+                "inotify": {"last_run": None, "last_error": None},
+                "failing": {"last_run": last_run, "last_error": "boom"},
+            },
+        },
+    ]
+
+    mock = MagicMock(return_value=True)
+    with patch.dict(beacons.__salt__, {"event.fire": mock}):
+        with patch.object(SaltEvent, "get_event", side_effect=event_returns):
+            ret = beacons.list_status(return_yaml=False)
+
+    assert ret["ps"] == {"last_run": "2023-01-01T12:00:00", "last_error": None}
+    assert ret["inotify"] == {"last_run": None, "last_error": None}
+    assert ret["failing"] == {"last_run": "2023-01-01T12:00:00", "last_error": "boom"}
+
+
