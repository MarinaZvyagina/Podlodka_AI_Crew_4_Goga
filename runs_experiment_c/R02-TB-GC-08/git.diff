+def test_beacon_process_records_status_on_success(minion_opts):
+    """
+    Test that process() records that a beacon actually ran, along with
+    the time it ran, even though it produced no error.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    assert beacon.status == {}
+
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    status = beacon.status["watch_apache"]
+    assert isinstance(status["last_run"], datetime.datetime)
+    assert status["last_error"] is None
+
+
+def test_beacon_process_records_status_on_error(minion_opts):
+    """
+    Test that process() records the error raised by a beacon, so it's
+    possible to tell that a beacon ran but failed, rather than never
+    having run at all.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "watch_apache": [
+            {"processes": {"apache2": "stopped"}},
+            {"beacon_module": "ps"},
+        ]
+    }
+    beacon_mock = MagicMock(side_effect=Exception("Global Thermonuclear War"))
+    beacon_mock.__globals__ = {}
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+    beacon.beacons["ps.beacon"] = beacon_mock
+
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    status = beacon.status["watch_apache"]
+    assert isinstance(status["last_run"], datetime.datetime)
+    assert status["last_error"] == "Global Thermonuclear War"
+
+
+def test_list_beacons_status_reports_never_run(minion_opts):
+    """
+    Test that a beacon that is configured but hasn't fired yet reports
+    last_run as None instead of a stale or made up value.
+    """
+    minion_opts["id"] = "minion"
+    minion_opts["__role"] = "minion"
+    minion_opts["beacons"] = {
+        "enabled": True,
+        "status": [{"time": ["all"]}],
+    }
+
+    beacon = salt.beacons.Beacon(minion_opts, [])
+
+    evt_mock = MagicMock()
+    with patch("salt.utils.event.get_event") as get_event_mock:
+        get_event_mock.return_value.__enter__.return_value = evt_mock
+        beacon.list_beacons_status()
+
+    fired = evt_mock.fire_event.call_args[0][0]
+    assert fired["complete"] is True
+    assert "enabled" not in fired["beacons"]
+    assert fired["beacons"]["status"] == {"last_run": None, "last_error": None}
+
+
