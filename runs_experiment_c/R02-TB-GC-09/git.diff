+
+    assert "ps" not in beacon.run_status
+
+    beacon.process(minion_opts["beacons"], minion_opts["grains"])
+
+    assert "ps" in beacon.run_status
+    assert beacon.run_status["ps"]["error"] is None
+    assert beacon.run_status["ps"]["run_time"] > 0
