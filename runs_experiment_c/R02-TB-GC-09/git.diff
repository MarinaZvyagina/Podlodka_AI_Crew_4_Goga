+    def list_status(self, name=None, fmt="%Y, %b %d %H:%M:%S"):
+        """
+        Return, for each configured beacon (or just ``name`` if given),
+        when it last actually executed and whether that execution errored.
+
+        A beacon that is configured but has not fired yet since this
+        minion process started is reported with ``has_run: False`` rather
+        than a fabricated or stale timestamp.
+        """
+        beacons = self._get_beacons()
+
+        status = {}
+        for beacon_name in beacons:
+            if beacon_name == "enabled":
+                continue
+            if name is not None and beacon_name != name:
+                continue
+            run_status = self.run_status.get(beacon_name)
+            if run_status is None:
+                status[beacon_name] = {
+                    "has_run": False,
+                    "last_run": None,
+                    "last_error": None,
+                }
+            else:
+                status[beacon_name] = {
+                    "has_run": True,
+                    "last_run": time.strftime(
+                        fmt, time.localtime(run_status["run_time"])
+                    ),
+                    "last_error": run_status["error"],
+                }
+
+        # Fire the complete event back along with the beacon status
+        with salt.utils.event.get_event("minion", opts=self.opts) as evt:
+            evt.fire_event(
+                {"complete": True, "beacon_status": status},
+                tag="/salt/minion/minion_beacon_status_complete",
+            )
+
+        return True
