         return {"beacons": {}}
 
 
+def status(name=None, **kwargs):
+    """
+    Show, for each beacon currently configured on the minion (or just for
+    ``name`` if given), when it last actually fired and whether that run
+    raised an error.
+
+    This reflects live beacon activity tracked by the running minion
+    process, not log files, so it is accurate as of the last time the
+    beacon ran and does not require waiting for a new probe or restarting
+    the minion.
+
+    :param name:    Only return the status for this beacon, default is
+                     ``None`` which returns the status of every configured
+                     beacon.
+    :return:         Dictionary keyed by beacon name. Each value has
+                     ``has_run`` (``False`` if the beacon has never fired
+                     since the minion started), ``last_run`` (timestamp
+                     string, or ``None`` if it has never run), and
+                     ``last_error`` (the error from the last run, or
+                     ``None`` if the last run succeeded or it has never
+                     run).
+
+    CLI Example:
+
+    .. code-block:: bash
+
+        salt '*' beacons.status
+
+        salt '*' beacons.status ps
+    """
+    ret = {"comment": [], "result": True}
+
+    if name is not None and name not in list_(return_yaml=False, **kwargs):
+        ret["comment"] = f"Beacon {name} is not currently configured."
+        ret["result"] = False
+        return ret
+
+    try:
+        with salt.utils.event.get_event(
+            "minion", opts=__opts__, listen=True
+        ) as event_bus:
+            res = __salt__["event.fire"](
+                {"func": "list_status", "name": name}, "manage_beacons"
+            )
+            if res:
+                event_ret = event_bus.get_event(
+                    tag="/salt/minion/minion_beacon_status_complete",
+                    wait=kwargs.get("timeout", default_event_wait),
+                )
+                if event_ret and event_ret["complete"]:
+                    ret["result"] = True
+                    ret["beacons"] = event_ret["beacon_status"]
+                    del ret["comment"]
+                else:
+                    ret["result"] = False
+                    ret["comment"] = (
+                        "Did not receive the beacon status complete event before"
+                        " the timeout of {}s".format(
+                            kwargs.get("timeout", default_event_wait)
+                        )
+                    )
+    except KeyError:
+        # Effectively a no-op, since we can't really return without an event system
+        ret["result"] = False
+        ret["comment"] = "Event module not available. Beacon status failed."
+    return ret
+
+
