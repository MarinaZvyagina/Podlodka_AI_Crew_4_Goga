+# ---------------------------------------------------------------------------
+# list_all
+# ---------------------------------------------------------------------------
+
+
+def test_list_all_without_data(database):
+    sqlite3_cache.store("bank", "a", {"x": 1}, database)
+    sqlite3_cache.store("bank", "b", {"x": 2}, database)
+    result = sqlite3_cache.list_all("bank", database, include_data=False)
+    assert result == {"a": {}, "b": {}}
+
+
+def test_list_all_with_data(database):
+    sqlite3_cache.store("bank", "a", {"x": 1}, database)
+    sqlite3_cache.store("bank", "b", {"x": 2}, database)
+    result = sqlite3_cache.list_all("bank", database, include_data=True)
+    assert result == {"a": {"x": 1}, "b": {"x": 2}}
+
