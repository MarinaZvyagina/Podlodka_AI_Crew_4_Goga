+"""
+Functional tests for the salt.cache sqlite3 driver.
+
+These exercise the full salt.cache.Cache() public API backed by the real
+sqlite3 driver with a real opts dict and a real on-disk database file --
+the same path production code takes. The persistence tests below simulate
+a master restart by dropping the in-process connection registry and
+reopening the same database file with a fresh Cache() instance.
+"""
+
+import pytest
+
+import salt.cache
+import salt.cache.sqlite3_cache as sqlite3_cache
+import salt.config
+
+# ---------------------------------------------------------------------------
+# Fixtures
+# ---------------------------------------------------------------------------
+
+
+@pytest.fixture
+def opts(tmp_path):
+    o = salt.config.DEFAULT_MASTER_OPTS.copy()
+    o["cachedir"] = str(tmp_path / "cache")
+    o["cache"] = "sqlite3"
+    return o
+
+
+@pytest.fixture
+def cache(opts):
+    return salt.cache.Cache(opts, driver="sqlite3")
+
+
+@pytest.fixture(autouse=True)
+def clear_registry():
+    sqlite3_cache._connections.clear()
+    yield
+    sqlite3_cache._connections.clear()
+
+
+# ---------------------------------------------------------------------------
+# Basic CRUD
+# ---------------------------------------------------------------------------
+
+
+class TestCacheDriverCRUD:
+    def test_store_and_fetch(self, cache):
+        cache.store("mybank", "mykey", {"hello": "world"})
+        result = cache.fetch("mybank", "mykey")
+        assert result == {"hello": "world"}
+
+    def test_fetch_missing_key_returns_empty(self, cache):
+        assert cache.fetch("nobank", "nokey") == {}
+
+    def test_store_overwrite(self, cache):
+        cache.store("bank", "key", "first")
+        cache.store("bank", "key", "second")
+        assert cache.fetch("bank", "key") == "second"
+
+    def test_flush_key(self, cache):
+        cache.store("bank", "key", "value")
+        assert cache.flush("bank", "key") is True
+        assert cache.fetch("bank", "key") == {}
+
+    def test_flush_missing_key(self, cache):
+        assert cache.flush("bank", "ghost") is False
+
+    def test_flush_bank(self, cache):
+        cache.store("bank", "k1", "v1")
+        cache.store("bank", "k2", "v2")
+        cache.flush("bank")
+        assert cache.fetch("bank", "k1") == {}
+        assert cache.fetch("bank", "k2") == {}
+
+    def test_contains_existing(self, cache):
+        cache.store("bank", "key", "val")
+        assert cache.contains("bank", "key") is True
+
+    def test_contains_missing(self, cache):
+        assert cache.contains("bank", "ghost") is False
+
+    def test_list_keys(self, cache):
+        cache.store("bank", "a", 1)
+        cache.store("bank", "b", 2)
+        cache.store("bank", "c", 3)
+        assert sorted(cache.list("bank")) == ["a", "b", "c"]
+
+    def test_list_empty_bank(self, cache):
+        assert cache.list("empty") == []
+
+
+# ---------------------------------------------------------------------------
+# Expiry (opts-driven ``expires``, honoured via Cache's manual envelope)
+# ---------------------------------------------------------------------------
+
+
+class TestCacheDriverExpiry:
+    def test_expires_makes_entry_disappear(self, cache):
+        cache.store("bank", "key", "value", expires=-1)
+        assert cache.fetch("bank", "key") == {}
+
+    def test_clean_expired_removes_only_expired(self, cache):
+        cache.store("bank", "stale", "old", expires=-1)
+        cache.store("bank", "fresh", "new", expires=3600)
+        cache.clean_expired("bank")
+        assert cache.contains("bank", "stale") is False
+        assert cache.fetch("bank", "fresh") == "new"
+
+
+# ---------------------------------------------------------------------------
+# Persistence across a simulated master restart
+# ---------------------------------------------------------------------------
+
+
+class TestCacheDriverPersistence:
+    def test_data_persists_across_restart(self, opts):
+        c1 = salt.cache.Cache(opts, driver="sqlite3")
+        c1.store("minions/web1", "grains", {"os": "Linux"})
+        c1.store("minions/web1", "mine", {"fqdn": "web1.example.com"})
+
+        # Simulate the master process restarting: drop every in-process
+        # connection so the next Cache() re-opens the on-disk file cold.
+        sqlite3_cache._connections.clear()
+
+        c2 = salt.cache.Cache(opts, driver="sqlite3")
+        assert c2.fetch("minions/web1", "grains") == {"os": "Linux"}
+        assert c2.fetch("minions/web1", "mine") == {"fqdn": "web1.example.com"}
+
+    def test_list_persists_across_restart(self, opts):
+        c1 = salt.cache.Cache(opts, driver="sqlite3")
+        c1.store("minions", "web1", {})
+        c1.store("minions", "web2", {})
+
+        sqlite3_cache._connections.clear()
+
+        c2 = salt.cache.Cache(opts, driver="sqlite3")
+        assert sorted(c2.list("minions")) == ["web1", "web2"]
+
+    def test_deployments_not_opted_in_are_unaffected(self, tmp_path):
+        """The default cache config (localfs) is untouched by this backend existing."""
+        o = salt.config.DEFAULT_MASTER_OPTS.copy()
+        o["cachedir"] = str(tmp_path / "cache")
+        default_cache = salt.cache.Cache(o)
+        assert default_cache.driver == "localfs"
+        default_cache.store("bank", "key", {"a": 1})
+        assert default_cache.fetch("bank", "key") == {"a": 1}
