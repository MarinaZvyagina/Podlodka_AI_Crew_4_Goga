+# ---------------------------------------------------------------------------
+# error paths
+# ---------------------------------------------------------------------------
+
+
+def test_store_raises_on_serialisation_failure(database):
+    with pytest.raises(SaltCacheError, match="error serializing"):
+        sqlite3_cache.store("bank", "key", object(), database)
+
+
+def test_store_does_not_accept_expires_kwarg(database):
+    # Cache.store relies on this raising TypeError to trigger its manual
+    # _expires envelope fallback.
+    with pytest.raises(TypeError):
+        sqlite3_cache.store("bank", "key", {"a": 1}, database, expires=60)
