+"""
+Unit tests for the sqlite3_cache cache backend.
+
+Contract tests shared with localfs/mmap_cache (store/fetch/flush/list/
+contains/updated) live in ``test_cache_backends.py``. This module covers
+sqlite3-specific wiring: database path resolution, table setup, sub-bank
+listing/flushing via LIKE-prefix matching, and error paths.
+"""
+
+import sqlite3
+
+import pytest
+
+import salt.cache.sqlite3_cache as sqlite3_cache
+from salt.exceptions import SaltCacheError
+from tests.support.mock import patch
+
+
+@pytest.fixture
+def database(tmp_path):
+    return str(tmp_path / "sub" / "cache.sqlite3")
+
+
+@pytest.fixture
+def configure_loader_modules(tmp_path):
+    return {sqlite3_cache: {"__opts__": {"cachedir": str(tmp_path)}}}
+
+
+@pytest.fixture(autouse=True)
+def clear_registry():
+    sqlite3_cache._connections.clear()
+    yield
+    sqlite3_cache._connections.clear()
+
+
+# ---------------------------------------------------------------------------
+# __virtual__
+# ---------------------------------------------------------------------------
+
+
+def test_virtual_true_when_sqlite3_available():
+    assert sqlite3_cache.__virtual__() == "sqlite3"
+
+
+def test_virtual_false_without_sqlite3():
+    with patch.object(sqlite3_cache, "HAS_SQLITE3", False):
+        result = sqlite3_cache.__virtual__()
+    assert result[0] is False
+
