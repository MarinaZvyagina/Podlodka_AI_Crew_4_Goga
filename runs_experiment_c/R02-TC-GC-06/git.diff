+# ---------------------------------------------------------------------------
+# database path resolution
+# ---------------------------------------------------------------------------
+
+
+def test_database_path_kwargs_takes_priority(database):
+    result = sqlite3_cache._database_path({"database": database})
+    assert result == database
+
+
+def test_database_path_falls_back_to_opts(tmp_path):
+    with patch.dict(sqlite3_cache.__opts__, {"sqlite3.database": "/custom/path.db"}):
+        result = sqlite3_cache._database_path({})
+    assert result == "/custom/path.db"
+
+
+def test_database_path_defaults_under_cachedir(tmp_path):
+    result = sqlite3_cache._database_path({})
+    assert result == str(tmp_path / "cache.sqlite3")
+
+
+def test_init_kwargs_returns_database(database):
+    assert sqlite3_cache.init_kwargs({"database": database}) == {"database": database}
+
+
+def test_get_storage_id(database):
+    assert sqlite3_cache.get_storage_id({"database": database}) == (
+        "sqlite3",
+        database,
+    )
+
