+# ---------------------------------------------------------------------------
+# connection setup
+# ---------------------------------------------------------------------------
+
+
+def test_connect_creates_parent_directories_and_table(database):
+    sqlite3_cache.store("bank", "key", {"a": 1}, database)
+    conn = sqlite3.connect(database)
+    cur = conn.execute(
+        "SELECT name FROM sqlite_master WHERE type='table' AND name='cache'"
+    )
+    assert cur.fetchone() is not None
+    conn.close()
+
+
+def test_connect_reuses_existing_connection(database):
+    sqlite3_cache.store("bank", "key", {"a": 1}, database)
+    conn1, _ = sqlite3_cache._connections[database]
+    sqlite3_cache.store("bank", "key2", {"b": 2}, database)
+    conn2, _ = sqlite3_cache._connections[database]
+    assert conn1 is conn2
+
+
+def test_connect_raises_saltcacheerror_on_bad_path(tmp_path):
+    # A regular file can't be used as a directory component.
+    blocker = tmp_path / "blocker"
+    blocker.write_text("not a directory")
+    bad_database = str(blocker / "cache.sqlite3")
+    with pytest.raises(SaltCacheError):
+        sqlite3_cache.store("bank", "key", {"a": 1}, bad_database)
+
+
+# ---------------------------------------------------------------------------
+# nested bank listing / flushing
+# ---------------------------------------------------------------------------
+
+
+def test_list_immediate_children_only(database):
+    sqlite3_cache.store("minions", "toplevel", {}, database)
+    sqlite3_cache.store("minions/alpha", "data", {}, database)
+    sqlite3_cache.store("minions/alpha/nested", "deep", {}, database)
+    sqlite3_cache.store("minions/beta", "data", {}, database)
+    result = sorted(sqlite3_cache.list_("minions", database))
+    assert result == ["alpha", "beta", "toplevel"]
+
+
+def test_list_root_bank(database):
+    sqlite3_cache.store("", "root_key", {}, database)
+    sqlite3_cache.store("minions", "data", {}, database)
+    result = sorted(sqlite3_cache.list_("", database))
+    assert result == ["minions", "root_key"]
+
+
+def test_flush_bank_removes_nested_subbanks(database):
+    sqlite3_cache.store("minions/alpha", "data", {"v": 1}, database)
+    sqlite3_cache.store("minions/alpha/nested", "deep", {"v": 2}, database)
+    sqlite3_cache.store("other", "data", {"v": 3}, database)
+
+    assert sqlite3_cache.flush("minions", None, database) is True
+
+    assert sqlite3_cache.contains("minions/alpha", "data", database) is False
+    assert sqlite3_cache.contains("minions/alpha/nested", "deep", database) is False
+    assert sqlite3_cache.fetch("other", "data", database) == {"v": 3}
+
+
+def test_flush_bank_does_not_match_sibling_with_shared_prefix(database):
+    sqlite3_cache.store("minions", "data", {}, database)
+    sqlite3_cache.store("minions_extra", "data", {}, database)
+
+    sqlite3_cache.flush("minions", None, database)
+
+    assert sqlite3_cache.contains("minions_extra", "data", database) is True
+
+
+def test_bank_name_with_like_wildcards_is_escaped(database):
+    sqlite3_cache.store("weird%bank", "key", {"v": 1}, database)
+    sqlite3_cache.store("weird%bank_sibling", "key", {"v": 2}, database)
+
+    assert sqlite3_cache.contains("weird%bank", "key", database) is True
+    sqlite3_cache.flush("weird%bank", None, database)
+    assert sqlite3_cache.contains("weird%bank", "key", database) is False
+    # A LIKE pattern of "weird%bank/%" must not accidentally sweep up the
+    # unrelated "weird%bank_sibling" entry.
+    assert sqlite3_cache.contains("weird%bank_sibling", "key", database) is True
+
