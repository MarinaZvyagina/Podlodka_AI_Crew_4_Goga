+"""
+Cache data in a single SQLite database file on disk.
+
+.. versionadded:: 3009.0
+
+``sqlite3`` is a durable, single-file cache backend built entirely on the
+Python standard library -- no external database service and no third-party
+package are required. It is intended for small, single-node masters that
+want their minion data cache (grains, mine data, job returns, etc.) to
+survive a master restart without standing up Redis, MySQL, or similar.
+
+Unlike :mod:`salt.cache.localfs <salt.cache.localfs>`, which fans keys out
+into one file per entry, every bank/key pair here is a row in one ``cache``
+table inside a single ``.sqlite3`` file. Bank paths are stored verbatim (as
+with ``localfs``, a bank may contain ``/`` to nest sub-banks), so ``list``
+and ``contains`` return the immediate children of a bank -- direct keys plus
+immediate sub-bank names -- matching ``localfs`` semantics.
+
+To use this cache backend, set the master ``cache`` config value to
+``sqlite3``:
+
+.. code-block:: yaml
+
+    cache: sqlite3
+
+Optional configuration (default shown, resolved under ``cachedir``)::
+
+    sqlite3.database: /var/cache/salt/master/cache.sqlite3
+
+The database file (and its ``-wal``/``-shm`` siblings, used by SQLite's
+write-ahead log) is created on first use, along with any missing parent
+directories.
+"""
+
+import logging
+import os
+import threading
+import time
+
+import salt.payload
+import salt.syspaths
+import salt.utils.path
+from salt.exceptions import SaltCacheError
+
+try:
+    # Some minimal/embedded Python builds are compiled without SQLite
+    # support, in which case the standard library sqlite3 module is absent.
+    import sqlite3
+
+    HAS_SQLITE3 = True
+except ImportError:
+    HAS_SQLITE3 = False
+
+log = logging.getLogger(__name__)
+
+__virtualname__ = "sqlite3"
+__func_alias__ = {"list_": "list"}
+
+
+def __virtual__():
+    if not HAS_SQLITE3:
+        return (
+            False,
+            "This Python installation was built without sqlite3 support.",
+        )
+    return __virtualname__
+
+
+# Module-level registry of open connections, keyed by resolved database
+# path, so every Cache() instance pointed at the same file shares one
+# connection instead of re-opening (and re-creating the table on) every
+# call. Mirrors the pattern used by salt.cache.mmap_cache's `_caches`.
+_connections = {}
+_connections_lock = threading.Lock()
+
+
+def _default_database():
+    cachedir = __opts__.get("cachedir", salt.syspaths.CACHE_DIR)
+    return salt.utils.path.join(cachedir, "cache.sqlite3")
+
+
+def _database_path(kwargs=None):
+    if kwargs and kwargs.get("database"):
+        return kwargs["database"]
+    return __opts__.get("sqlite3.database") or _default_database()
+
+
+def init_kwargs(kwargs):
+    return {"database": _database_path(kwargs)}
+
+
+def get_storage_id(kwargs):
+    return ("sqlite3", _database_path(kwargs))
+
+
+def _escape_like(value):
+    # Neutralize LIKE wildcards in bank names so a bank literally named
+    # e.g. "foo%bar" can't accidentally match unrelated sub-banks.
+    return value.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+
+
+def _connect(database):
+    with _connections_lock:
+        entry = _connections.get(database)
+        if entry is not None:
+            return entry
+
+        directory = os.path.dirname(database)
+        if directory:
+            try:
+                os.makedirs(directory, exist_ok=True)
+            except OSError as exc:
+                raise SaltCacheError(
+                    f"sqlite3 cache: could not create cache directory "
+                    f"{directory}: {exc}"
+                ) from exc
+
+        try:
+            conn = sqlite3.connect(
+                database,
+                timeout=30,
+                check_same_thread=False,
+                isolation_level=None,
+            )
+            conn.execute("PRAGMA journal_mode=WAL")
+            conn.execute("PRAGMA synchronous=NORMAL")
+            conn.execute(
+                "CREATE TABLE IF NOT EXISTS cache ("
+                "bank TEXT NOT NULL, "
+                "cache_key TEXT NOT NULL, "
+                "data BLOB, "
+                "last_update REAL NOT NULL, "
+                "PRIMARY KEY (bank, cache_key))"
+            )
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f'sqlite3 cache: error opening database "{database}": {exc}'
+            ) from exc
+
+        entry = (conn, threading.Lock())
+        _connections[database] = entry
+        return entry
+
+
+def store(bank, key, data, database):
+    """
+    Store a key value.
+
+    Deliberately does not accept an ``expires`` keyword: :class:`salt.cache.Cache.store`
+    always calls drivers with ``expires=...`` first and only falls back to
+    wrapping the value with a manual ``_expires`` envelope when that raises
+    ``TypeError``, so omitting the parameter here (matching
+    :mod:`salt.cache.mysql_cache` and :mod:`salt.cache.consul`) is what
+    makes expiry work.
+    """
+    conn, lock = _connect(database)
+    try:
+        payload = salt.payload.dumps(data)
+    except Exception as exc:  # pylint: disable=broad-except
+        raise SaltCacheError(
+            f"sqlite3 cache: error serializing {bank}/{key}: {exc}"
+        ) from exc
+
+    with lock:
+        try:
+            conn.execute(
+                "INSERT OR REPLACE INTO cache "
+                "(bank, cache_key, data, last_update) VALUES (?, ?, ?, ?)",
+                (bank, key, payload, time.time()),
+            )
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f"sqlite3 cache: error storing {bank}/{key}: {exc}"
+            ) from exc
+
+
+def fetch(bank, key, database):
+    """
+    Fetch a key value.
+    """
+    conn, lock = _connect(database)
+    with lock:
+        try:
+            cur = conn.execute(
+                "SELECT data FROM cache WHERE bank = ? AND cache_key = ?",
+                (bank, key),
+            )
+            row = cur.fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f"sqlite3 cache: error fetching {bank}/{key}: {exc}"
+            ) from exc
+
+    if row is None:
+        return {}
+    return salt.payload.loads(bytes(row[0]))
+
+
+def updated(bank, key, database):
+    """
+    Return the Unix epoch of the last update for the specified key, or
+    ``None`` if it doesn't exist.
+    """
+    conn, lock = _connect(database)
+    with lock:
+        try:
+            cur = conn.execute(
+                "SELECT last_update FROM cache WHERE bank = ? AND cache_key = ?",
+                (bank, key),
+            )
+            row = cur.fetchone()
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f"sqlite3 cache: error reading timestamp for {bank}/{key}: {exc}"
+            ) from exc
+    return int(row[0]) if row else None
+
+
+def flush(bank, key=None, database=None):
+    """
+    Remove the key from the cache bank with all the key content. If no key
+    is specified remove the entire bank, including any sub-banks nested
+    under it.
+    """
+    if database is None:
+        database = _database_path()
+    conn, lock = _connect(database)
+    with lock:
+        try:
+            if key is None:
+                pattern = _escape_like(bank + "/") + "%"
+                cur = conn.execute(
+                    "DELETE FROM cache WHERE bank = ? OR bank LIKE ? ESCAPE '\\'",
+                    (bank, pattern),
+                )
+            else:
+                cur = conn.execute(
+                    "DELETE FROM cache WHERE bank = ? AND cache_key = ?",
+                    (bank, key),
+                )
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f"sqlite3 cache: error flushing bank={bank} key={key}: {exc}"
+            ) from exc
+    return cur.rowcount > 0
+
+
+def list_(bank, database):
+    """
+    Return an iterable object containing all entries stored in the
+    specified bank: direct keys plus immediate sub-bank names.
+    """
+    conn, lock = _connect(database)
+    prefix = f"{bank}/" if bank else ""
+    pattern = _escape_like(prefix) + "%"
+    with lock:
+        try:
+            cur = conn.execute(
+                "SELECT cache_key FROM cache WHERE bank = ?", (bank,)
+            )
+            names = [row[0] for row in cur.fetchall()]
+            cur = conn.execute(
+                "SELECT DISTINCT bank FROM cache WHERE bank LIKE ? ESCAPE '\\'",
+                (pattern,),
+            )
+            subbanks = [row[0] for row in cur.fetchall()]
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f'sqlite3 cache: error listing bank "{bank}": {exc}'
+            ) from exc
+
+    seen = set(names)
+    for subbank in subbanks:
+        if not subbank.startswith(prefix):
+            continue
+        child = subbank[len(prefix) :].split("/", 1)[0]
+        if child and child not in seen:
+            seen.add(child)
+            names.append(child)
+    return names
+
+
+def list_all(bank, database, include_data=False):
+    """
+    Return ``{key: data}`` for every entry directly stored in the specified
+    bank in a single pass.
+    """
+    conn, lock = _connect(database)
+    with lock:
+        try:
+            if include_data:
+                cur = conn.execute(
+                    "SELECT cache_key, data FROM cache WHERE bank = ?", (bank,)
+                )
+                rows = cur.fetchall()
+            else:
+                cur = conn.execute(
+                    "SELECT cache_key FROM cache WHERE bank = ?", (bank,)
+                )
+                rows = [(row[0], None) for row in cur.fetchall()]
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f'sqlite3 cache: error listing bank "{bank}": {exc}'
+            ) from exc
+
+    if not include_data:
+        return {key: {} for key, _ in rows}
+    return {key: salt.payload.loads(bytes(data)) for key, data in rows}
+
+
+def contains(bank, key, database):
+    """
+    Checks if the specified bank contains the specified key. If ``key`` is
+    ``None``, checks whether the bank itself (or any sub-bank nested under
+    it) exists.
+    """
+    conn, lock = _connect(database)
+    with lock:
+        try:
+            if key is None:
+                pattern = _escape_like(bank + "/") + "%"
+                cur = conn.execute(
+                    "SELECT 1 FROM cache WHERE bank = ? OR bank LIKE ? "
+                    "ESCAPE '\\' LIMIT 1",
+                    (bank, pattern),
+                )
+            else:
+                cur = conn.execute(
+                    "SELECT 1 FROM cache WHERE bank = ? AND cache_key = ? LIMIT 1",
+                    (bank, key),
+                )
+            return cur.fetchone() is not None
+        except sqlite3.Error as exc:
+            raise SaltCacheError(
+                f"sqlite3 cache: error checking bank={bank} key={key}: {exc}"
+            ) from exc
