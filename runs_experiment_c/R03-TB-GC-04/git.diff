   public async close(server: Server): Promise<void> {
+    await this.notifyClientsOfShutdown(server);
+
     if (this.forceCloseConnections && server.httpServer === this.httpServer) {
       return;
     }
 
     return super.close(server);
   }
+
+  /**
+   * Broadcasts a heads-up to every client still connected to this server (or
+   * namespace) right before it is closed, so disconnects caused by a graceful
+   * shutdown can be told apart from a crash or network failure on the client.
+   * Yields one tick after emitting so the packet reaches the transport's
+   * write buffer before the server (and its sockets) are torn down.
+   */
+  protected async notifyClientsOfShutdown(
+    server: Server | Namespace,
+  ): Promise<void> {
+    if (!isFunction((server as { emit?: unknown })?.emit)) {
+      return;
+    }
+    server.emit(SHUTDOWN_EVENT, SHUTDOWN_MESSAGE);
+    await new Promise<void>(resolve => setImmediate(resolve));
+  }
 }
