@@ -0,0 +1,70 @@
+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import { io } from 'socket.io-client';
+import { ServerGateway } from '../src/server.gateway.js';
+
+async function createNestApp(options?: Record<string, unknown>) {
+  const testingModule = await Test.createTestingModule({
+    providers: [ServerGateway],
+  }).compile();
+  return testingModule.createNestApplication(options as any);
+}
+
+describe('WebSocketGateway shutdown notice (socket.io)', () => {
+  let app: INestApplication;
+
+  afterEach(async () => {
+    if (app) {
+      await app.close();
+    }
+  });
+
+  it('should notify a connected client before disconnecting it on app.close()', async () => {
+    app = await createNestApp();
+    await app.listen(3000);
+
+    const client = io('http://localhost:3000', { reconnection: false });
+    await new Promise<void>(resolve => client.on('connect', resolve));
+
+    const events: string[] = [];
+    const shutdownNotice = new Promise<any>(resolve =>
+      client.on('shutdown', data => {
+        events.push('shutdown');
+        resolve(data);
+      }),
+    );
+    client.on('disconnect', () => events.push('disconnect'));
+
+    await app.close();
+    const message = await shutdownNotice;
+
+    expect(message).toBeTruthy();
+    expect(events[0]).toEqual('shutdown');
+    client.close();
+  });
+
+  it('should not hang or throw when closing with no connected clients', async () => {
+    app = await createNestApp();
+    await app.listen(3000);
+
+    await expect(app.close()).resolves.toBeUndefined();
+  });
+
+  it('should still notify clients when forceCloseConnections is enabled', async () => {
+    app = await createNestApp({ forceCloseConnections: true });
+    await app.listen(3000);
+
+    const client = io('http://localhost:3000', { reconnection: false });
+    await new Promise<void>(resolve => client.on('connect', resolve));
+
+    const shutdownNotice = new Promise<any>(resolve =>
+      client.on('shutdown', resolve),
+    );
+
+    await app.close();
+    const message = await shutdownNotice;
+
+    expect(message).toBeTruthy();
+    client.close();
+  });
+});
