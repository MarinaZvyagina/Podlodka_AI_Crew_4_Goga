diff --git a/packages/platform-ws/test/ws-adapter.spec.ts b/packages/platform-ws/test/ws-adapter.spec.ts
new file mode 100644
index 0000000..871a604
--- /dev/null
+++ b/packages/platform-ws/test/ws-adapter.spec.ts
@@ -0,0 +1,82 @@
+import { SHUTDOWN_EVENT, SHUTDOWN_MESSAGE } from '@nestjs/websockets/internal';
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+function createClient(readyState = 1) {
+  return {
+    readyState,
+    send: vi.fn((_payload: string, cb: Function) => cb()),
+    terminate: vi.fn(),
+  };
+}
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('close', () => {
+    it('should send a shutdown notice to every open client before terminating it', async () => {
+      const client1 = createClient();
+      const client2 = createClient();
+      const closeSpy = vi.fn((cb: Function) => cb());
+      const fakeServer = {
+        close: closeSpy,
+        clients: new Set([client1, client2]),
+      } as any;
+
+      await adapter.close(fakeServer);
+
+      const expectedPayload = JSON.stringify({
+        event: SHUTDOWN_EVENT,
+        data: SHUTDOWN_MESSAGE,
+      });
+      for (const client of [client1, client2]) {
+        expect(client.send).toHaveBeenCalledWith(
+          expectedPayload,
+          expect.any(Function),
+        );
+        expect(client.terminate).toHaveBeenCalled();
+      }
+      expect(closeSpy).toHaveBeenCalled();
+    });
+
+    it('should terminate clients that are not open without sending a notice', async () => {
+      const closingClient = createClient(2);
+      const closeSpy = vi.fn((cb: Function) => cb());
+      const fakeServer = {
+        close: closeSpy,
+        clients: new Set([closingClient]),
+      } as any;
+
+      await adapter.close(fakeServer);
+
+      expect(closingClient.send).not.toHaveBeenCalled();
+      expect(closingClient.terminate).toHaveBeenCalled();
+    });
+
+    it('should terminate a client even if sending the notice throws', async () => {
+      const client = createClient();
+      client.send = vi.fn(() => {
+        throw new Error('socket hang up');
+      });
+      const closeSpy = vi.fn((cb: Function) => cb());
+      const fakeServer = {
+        close: closeSpy,
+        clients: new Set([client]),
+      } as any;
+
+      await expect(adapter.close(fakeServer)).resolves.toBeUndefined();
+      expect(client.terminate).toHaveBeenCalled();
+    });
+
+    it('should not fail when the server has no clients collection', async () => {
+      const closeSpy = vi.fn((cb: Function) => cb());
+      const fakeServer = { close: closeSpy } as any;
+
+      await expect(adapter.close(fakeServer)).resolves.toBeUndefined();
+      expect(closeSpy).toHaveBeenCalled();
+    });
+  });
+});
