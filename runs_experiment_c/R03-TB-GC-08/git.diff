+    const namespace: Namespace = isFunction((server as Server).of)
+      ? (server as Server).sockets
+      : (server as Namespace);
+    const payload = { message: 'The server is shutting down.' };
+    await Promise.all(
+      Array.from(namespace.sockets.values()).map(socket => {
+        socket.emit(SHUTDOWN_EVENT, payload);
+        if (!socket.connected) {
+          return;
+        }
+        // "Server#close()" (called right after this hook) tears down the
+        // underlying engine.io clients without waiting for buffered
+        // writes to flush. Disconnecting gracefully here first, and
+        // waiting for that to actually complete, ensures the notice
+        // above reaches the client before its connection goes away.
+        return Promise.race([
+          new Promise<void>(resolve => {
+            socket.conn.once('close', () => resolve());
+            socket.disconnect(true);
+          }),
+          new Promise<void>(resolve =>
+            setTimeout(resolve, SHUTDOWN_NOTICE_TIMEOUT),
+          ),
+        ]);
+      }),
+    );
+  }
