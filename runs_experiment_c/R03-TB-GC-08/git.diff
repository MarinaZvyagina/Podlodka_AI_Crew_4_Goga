@@ -0,0 +1,107 @@
+import { ApplicationConfig } from '@nestjs/core/application-config.js';
+import { AbstractWsAdapter } from '../adapters/ws-adapter.js';
+import { SocketModule } from '../socket-module.js';
+import { SocketsContainer } from '../sockets-container.js';
+
+class NoopAdapter extends AbstractWsAdapter {
+  public create(port: number, options?: any) {}
+  public bindMessageHandlers(client: any, handlers) {}
+  public async notifyShutdown(server: any) {}
+}
+
+describe('SocketModule', () => {
+  let socketModule: SocketModule;
+  let socketsContainer: SocketsContainer;
+
+  beforeEach(() => {
+    socketModule = new SocketModule();
+    socketsContainer = new SocketsContainer();
+    (socketModule as any).socketsContainer = socketsContainer;
+  });
+
+  describe('close', () => {
+    it('should do nothing when the module was never registered', async () => {
+      await expect(socketModule.close()).resolves.toBeUndefined();
+    });
+
+    it('should do nothing when no adapter is configured', async () => {
+      (socketModule as any).applicationConfig = new ApplicationConfig(null);
+      await expect(socketModule.close()).resolves.toBeUndefined();
+    });
+
+    it('should call "notifyShutdown" before "close" for every connected server', async () => {
+      const adapter = new NoopAdapter();
+      const calls: string[] = [];
+      const notifyShutdown = vi
+        .spyOn(adapter, 'notifyShutdown' as any)
+        .mockImplementation(async () => {
+          calls.push('notifyShutdown');
+        });
+      const close = vi.spyOn(adapter, 'close').mockImplementation(async () => {
+        calls.push('close');
+      });
+      const dispose = vi.spyOn(adapter, 'dispose').mockResolvedValue(undefined);
+
+      (socketModule as any).applicationConfig = new ApplicationConfig(adapter);
+      const server = { test: true };
+      socketsContainer.addOne({ port: 1 } as any, { server } as any);
+
+      await socketModule.close();
+
+      expect(notifyShutdown).toHaveBeenCalledWith(server);
+      expect(close).toHaveBeenCalledWith(server);
+      expect(calls).toEqual(['notifyShutdown', 'close']);
+      expect(dispose).toHaveBeenCalled();
+    });
+
+    it('should skip gateways without a registered server', async () => {
+      const adapter = new NoopAdapter();
+      const notifyShutdown = vi.spyOn(adapter, 'notifyShutdown' as any);
+      const close = vi.spyOn(adapter, 'close');
+      vi.spyOn(adapter, 'dispose').mockResolvedValue(undefined);
+
+      (socketModule as any).applicationConfig = new ApplicationConfig(adapter);
+      socketsContainer.addOne({ port: 1 } as any, { server: null } as any);
+
+      await socketModule.close();
+
+      expect(notifyShutdown).not.toHaveBeenCalled();
+      expect(close).not.toHaveBeenCalled();
+    });
+
+    it('should still close the server when the adapter does not implement "notifyShutdown"', async () => {
+      class AdapterWithoutNotify extends AbstractWsAdapter {
+        public create(port: number, options?: any) {}
+        public bindMessageHandlers(client: any, handlers) {}
+      }
+      const adapter = new AdapterWithoutNotify();
+      expect((adapter as any).notifyShutdown).toBeUndefined();
+
+      const close = vi.spyOn(adapter, 'close').mockResolvedValue(undefined);
+      vi.spyOn(adapter, 'dispose').mockResolvedValue(undefined);
+
+      (socketModule as any).applicationConfig = new ApplicationConfig(adapter);
+      const server = { test: true };
+      socketsContainer.addOne({ port: 1 } as any, { server } as any);
+
+      await expect(socketModule.close()).resolves.toBeUndefined();
+      expect(close).toHaveBeenCalledWith(server);
+    });
+
+    it('should still close the server when "notifyShutdown" throws', async () => {
+      const adapter = new NoopAdapter();
+      vi.spyOn(adapter, 'notifyShutdown' as any).mockRejectedValue(
+        new Error('boom'),
+      );
+      const close = vi.spyOn(adapter, 'close').mockResolvedValue(undefined);
+      vi.spyOn(adapter, 'dispose').mockResolvedValue(undefined);
+
+      (socketModule as any).applicationConfig = new ApplicationConfig(adapter);
+      const server = { test: true };
+      socketsContainer.addOne({ port: 1 } as any, { server } as any);
+
+      await expect(socketModule.close()).resolves.toBeUndefined();
+      expect(close).toHaveBeenCalledWith(server);
+    });
+  });
+});
