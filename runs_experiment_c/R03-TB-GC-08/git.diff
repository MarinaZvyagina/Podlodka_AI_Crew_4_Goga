@@ -13,3 +13,10 @@ export const CONNECTION_EVENT = 'connection';
 export const DISCONNECT_EVENT = 'disconnect';
 export const CLOSE_EVENT = 'close';
 export const ERROR_EVENT = 'error';
+export const SHUTDOWN_EVENT = 'shutdown';
+/**
+ * Upper bound (in ms) an adapter's `notifyShutdown` hook may spend waiting
+ * for a single client's shutdown notice to be delivered before the
+ * framework moves on and closes the connection anyway.
+ */
+export const SHUTDOWN_NOTICE_TIMEOUT = 1000;
