@@ -0,0 +1,90 @@
+import { INestApplication } from '@nestjs/common';
+import { WsAdapter } from '@nestjs/platform-ws';
+import { Test } from '@nestjs/testing';
+import { io, Socket as IoSocket } from 'socket.io-client';
+import WebSocket from 'ws';
+import { ApplicationGateway } from '../src/app.gateway.js';
+
+describe('WebSocket graceful shutdown notice', () => {
+  let app: INestApplication;
+
+  afterEach(async () => {
+    if (app) {
+      await app.close();
+    }
+  });
+
+  it('should notify connected socket.io clients before closing the connection', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [ApplicationGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    await app.listen(3000);
+
+    const client: IoSocket = io('http://localhost:8080');
+    await new Promise<void>((resolve, reject) => {
+      client.on('connect', resolve);
+      client.on('connect_error', reject);
+    });
+
+    const shutdownNotice = new Promise<any>(resolve =>
+      client.on('shutdown', resolve),
+    );
+    const disconnected = new Promise<void>(resolve =>
+      client.on('disconnect', () => resolve()),
+    );
+
+    const closePromise = app.close();
+
+    const notice = await shutdownNotice;
+    expect(notice).toMatchObject({ message: expect.any(String) });
+
+    // The client must still learn about the shutdown before its
+    // connection actually goes away.
+    await disconnected;
+    await closePromise;
+  });
+
+  it('should notify connected ws clients before closing the connection', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [ApplicationGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    app.useWebSocketAdapter(new WsAdapter(app));
+    await app.listen(3000);
+
+    const client = new WebSocket('ws://localhost:8080');
+    await new Promise<void>((resolve, reject) => {
+      client.on('open', resolve);
+      client.on('error', reject);
+    });
+
+    const shutdownNotice = new Promise<any>(resolve => {
+      client.on('message', data => {
+        const parsed = JSON.parse(data.toString());
+        if (parsed.event === 'shutdown') {
+          resolve(parsed.data);
+        }
+      });
+    });
+    const closed = new Promise<void>(resolve => client.on('close', () => resolve()));
+
+    const closePromise = app.close();
+
+    const notice = await shutdownNotice;
+    expect(notice).toMatchObject({ message: expect.any(String) });
+
+    await closed;
+    await closePromise;
+  });
+
+  it('should not error when no clients are connected at shutdown time', async () => {
+    const testingModule = await Test.createTestingModule({
+      providers: [ApplicationGateway],
+    }).compile();
+    app = testingModule.createNestApplication();
+    await app.listen(3000);
+
+    await expect(app.close()).resolves.toBeUndefined();
+  });
+});
