@@ -0,0 +1,43 @@
+import { WsAdapter } from '../adapters/ws-adapter.js';
+
+describe('WsAdapter', () => {
+  let adapter: WsAdapter;
+
+  beforeEach(() => {
+    adapter = new WsAdapter();
+  });
+
+  describe('notifyShutdown', () => {
+    it('should send a shutdown message to every open client and wait for delivery', async () => {
+      const openClient = { readyState: 1, send: vi.fn((_data, cb) => cb()) };
+      const connectingClient = {
+        readyState: 0,
+        send: vi.fn((_data, cb) => cb()),
+      };
+      const server = { clients: new Set([openClient, connectingClient]) };
+
+      await adapter.notifyShutdown(server as any);
+
+      expect(openClient.send).toHaveBeenCalledTimes(1);
+      const [payload] = openClient.send.mock.calls[0];
+      expect(JSON.parse(payload)).toEqual({
+        event: 'shutdown',
+        data: { message: expect.any(String) },
+      });
+      expect(connectingClient.send).not.toHaveBeenCalled();
+    });
+
+    it('should not throw when the server exposes no client registry', async () => {
+      await expect(
+        adapter.notifyShutdown({} as any),
+      ).resolves.toBeUndefined();
+    });
+
+    it('should resolve even when a client is already gone', async () => {
+      const server = { clients: new Set() };
+      await expect(
+        adapter.notifyShutdown(server as any),
+      ).resolves.toBeUndefined();
+    });
+  });
+});
