@@ -0,0 +1,29 @@
+import { isFunction, isNumber } from '@nestjs/common/internal';
+
+/**
+ * Determines whether the given client is a native WebSocket (e.g. from the
+ * `ws` package) as opposed to a Socket.IO socket/server/namespace. Native
+ * WebSocket objects expose a numeric `readyState` property per the
+ * WebSocket specification, whereas Socket.IO objects don't.
+ */
+export function isNativeWebSocketClient(
+  client: Record<string, any>,
+): client is { send: Function; readyState: number } {
+  return isNumber(client?.readyState) && isFunction(client?.send);
+}
+
+/**
+ * Sends a message to a WebSocket client, or broadcasts it through a
+ * Socket.IO server/namespace. Native WebSocket clients (which only expose
+ * `send`) receive a `{ event, data }` envelope, matching the payload shape
+ * Socket.IO clients receive through `emit`.
+ */
+export function emitWsMessage<
+  TClient extends { emit?: Function; send?: Function },
+>(client: TClient, event: string, payload?: unknown): void {
+  if (isNativeWebSocketClient(client)) {
+    client.send(JSON.stringify({ event, data: payload }));
+  } else if (isFunction(client.emit)) {
+    client.emit(event, payload);
+  }
+}
