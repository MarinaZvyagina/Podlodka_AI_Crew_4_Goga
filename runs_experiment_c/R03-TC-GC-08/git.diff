@@ -0,0 +1,51 @@
+import { ExecutionContext, ServiceUnavailableException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+import { MaintenanceGuard } from './maintenance.guard.js';
+
+// A fresh handler/class per context, since metadata is attached directly to
+// the function/class object and must not leak between test cases; no
+// controller or gateway is instantiated, so no server or socket is ever created.
+function createContext(isAffected: boolean): ExecutionContext {
+  const handler = () => undefined;
+  const controllerClass = class {};
+  if (isAffected) {
+    Reflect.defineMetadata('maintenance:affected', true, handler);
+  }
+  return {
+    getHandler: () => handler,
+    getClass: () => controllerClass,
+  } as unknown as ExecutionContext;
+}
+
+describe('MaintenanceGuard', () => {
+  let maintenanceMode: MaintenanceModeService;
+  let guard: MaintenanceGuard;
+
+  beforeEach(() => {
+    maintenanceMode = new MaintenanceModeService();
+    guard = new MaintenanceGuard(new Reflector(), maintenanceMode);
+  });
+
+  it('allows an affected handler when maintenance mode is off', () => {
+    expect(guard.canActivate(createContext(true))).toBe(true);
+  });
+
+  it('allows an unaffected handler when maintenance mode is on', () => {
+    maintenanceMode.enable();
+    expect(guard.canActivate(createContext(false))).toBe(true);
+  });
+
+  it('blocks an affected handler when maintenance mode is on', () => {
+    maintenanceMode.enable();
+    expect(() => guard.canActivate(createContext(true))).toThrow(
+      ServiceUnavailableException,
+    );
+  });
+
+  it('lets an affected handler work again once maintenance mode is switched off', () => {
+    maintenanceMode.enable();
+    maintenanceMode.disable();
+    expect(guard.canActivate(createContext(true))).toBe(true);
+  });
+});
