index 0000000..d4f9a20
--- /dev/null
+++ b/sample/02-gateways/src/maintenance/maintenance.guard.ts
@@ -0,0 +1,41 @@
+import {
+  CanActivate,
+  ExecutionContext,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { MAINTENANCE_MODE_METADATA } from './affected-by-maintenance.decorator.js';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Runs before every handler (HTTP or WS, both flow through Nest's
+ * CanActivate pipeline via ExecutionContext). Only handlers marked with
+ * `@AffectedByMaintenance()` are rejected, and only while maintenance mode
+ * is on; everything else is untouched.
+ */
+@Injectable()
+export class MaintenanceGuard implements CanActivate {
+  constructor(
+    private readonly reflector: Reflector,
+    private readonly maintenanceMode: MaintenanceModeService,
+  ) {}
+
+  canActivate(context: ExecutionContext): boolean {
+    if (!this.maintenanceMode.isEnabled()) {
+      return true;
+    }
+
+    const isAffected = this.reflector.getAllAndOverride<boolean>(
+      MAINTENANCE_MODE_METADATA,
+      [context.getHandler(), context.getClass()],
+    );
+    if (!isAffected) {
+      return true;
+    }
+
+    throw new ServiceUnavailableException(
+      'This endpoint is temporarily unavailable due to maintenance.',
+    );
+  }
+}
