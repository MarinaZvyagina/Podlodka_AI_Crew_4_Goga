@@ -0,0 +1,13 @@
+import { SetMetadata } from '@nestjs/common';
+
+export const MAINTENANCE_MODE_METADATA = 'maintenance:affected';
+
+/**
+ * Marks a route handler, a `@SubscribeMessage` handler, or an entire
+ * controller/gateway as affected by maintenance mode. Reads are plain
+ * metadata (no transport-specific logic), so the same decorator applies to
+ * HTTP controllers and WebSocket gateways alike; `MaintenanceGuard` is what
+ * turns the marker into a block.
+ */
+export const AffectedByMaintenance = () =>
+  SetMetadata(MAINTENANCE_MODE_METADATA, true);
