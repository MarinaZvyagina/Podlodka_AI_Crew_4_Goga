@@ -0,0 +1,24 @@
+import { Injectable } from '@nestjs/common';
+
+/**
+ * Runtime, in-process toggle for maintenance mode. A single instance is
+ * shared across the app (register it once, e.g. as a global provider), so
+ * flipping it here immediately affects every handler guarded by
+ * `MaintenanceGuard` without a redeploy.
+ */
+@Injectable()
+export class MaintenanceModeService {
+  private enabled = false;
+
+  enable(): void {
+    this.enabled = true;
+  }
+
+  disable(): void {
+    this.enabled = false;
+  }
+
+  isEnabled(): boolean {
+    return this.enabled;
+  }
+}
