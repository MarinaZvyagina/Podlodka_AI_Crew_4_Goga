+import { Controller, Post } from '@nestjs/common';
+import { MaintenanceModeService } from './maintenance-mode.service.js';
+
+/**
+ * Internal toggle for maintenance mode. Deliberately not marked with
+ * `@AffectedByMaintenance()` so it keeps working while maintenance mode is
+ * on — otherwise nobody could switch it back off.
+ */
+@Controller('internal/maintenance')
+export class MaintenanceAdminController {
+  constructor(private readonly maintenanceMode: MaintenanceModeService) {}
+
+  @Post('enable')
+  enable(): { enabled: boolean } {
+    this.maintenanceMode.enable();
+    return { enabled: true };
+  }
+
+  @Post('disable')
+  disable(): { enabled: boolean } {
+    this.maintenanceMode.disable();
+    return { enabled: false };
+  }
+}
