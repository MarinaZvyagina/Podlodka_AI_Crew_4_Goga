+import {
+  FastifyAdapter,
+  NestFastifyApplication,
+} from '@nestjs/platform-fastify';
+import { Test } from '@nestjs/testing';
+import { AppModule } from '../src/app.module.js';
+
+describe('Fastify Request Id', () => {
+  let app: NestFastifyApplication;
+
+  beforeAll(async () => {
+    const module = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = module.createNestApplication<NestFastifyApplication>(
+      new FastifyAdapter(),
+      { requestId: true },
+    );
+
+    await app.init();
+    await app.getHttpAdapter().getInstance().ready();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('generates a request id and reflects it on the response header', async () => {
+    const { statusCode, headers } = await app.inject({
+      method: 'GET',
+      url: '/',
+    });
+
+    expect(statusCode).toBe(200);
+    expect(headers['x-request-id']).toBeTruthy();
+  });
+
+  it('exposes the same id to application code as the response header', async () => {
+    const { headers, payload } = await app.inject({
+      method: 'GET',
+      url: '/',
+    });
+
+    expect(JSON.parse(payload).requestId).toEqual(headers['x-request-id']);
+  });
+
+  it('reuses an id supplied by the caller instead of generating a new one', async () => {
+    const { headers, payload } = await app.inject({
+      method: 'GET',
+      url: '/',
+      headers: { 'x-request-id': 'incoming-request-id' },
+    });
+
+    expect(headers['x-request-id']).toEqual('incoming-request-id');
+    expect(JSON.parse(payload).requestId).toEqual('incoming-request-id');
+  });
+
+  it('generates a distinct id per request when none is supplied', async () => {
+    const first = await app.inject({ method: 'GET', url: '/' });
+    const second = await app.inject({ method: 'GET', url: '/' });
+
+    expect(first.headers['x-request-id']).not.toEqual(
+      second.headers['x-request-id'],
+    );
+  });
+});
