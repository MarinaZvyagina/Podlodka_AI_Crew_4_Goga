+/**
+ * Interface describing request id tracking options.
+ *
+ * @publicApi
+ */
+export interface RequestIdOptions {
+  /**
+   * Name of the header the request id is read from (if present on the
+   * incoming request) and written to (on the outgoing response).
+   * @default 'X-Request-Id'
+   */
+  header?: string;
+  /**
+   * Used to generate a request id when the incoming request does not
+   * already carry one.
+   * @default crypto.randomUUID
+   */
+  generator?: () => string;
+}
