+import { NestExpressApplication } from '@nestjs/platform-express';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { AppModule } from '../src/app.module.js';
+
+describe('Express Request Id', () => {
+  let app: NestExpressApplication;
+
+  beforeAll(async () => {
+    const module = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = module.createNestApplication<NestExpressApplication>({
+      requestId: true,
+    });
+
+    await app.init();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('generates a request id and reflects it on the response header', async () => {
+    const response = await request(app.getHttpServer()).get('/').expect(200);
+
+    expect(response.headers['x-request-id']).toBeTruthy();
+  });
+
+  it('exposes the same id to application code as the response header', async () => {
+    const response = await request(app.getHttpServer()).get('/').expect(200);
+
+    expect(response.body.requestId).toEqual(response.headers['x-request-id']);
+  });
+
+  it('reuses an id supplied by the caller instead of generating a new one', async () => {
+    const response = await request(app.getHttpServer())
+      .get('/')
+      .set('X-Request-Id', 'incoming-request-id')
+      .expect(200);
+
+    expect(response.headers['x-request-id']).toEqual('incoming-request-id');
+    expect(response.body.requestId).toEqual('incoming-request-id');
+  });
+
+  it('generates a distinct id per request when none is supplied', async () => {
+    const first = await request(app.getHttpServer()).get('/').expect(200);
+    const second = await request(app.getHttpServer()).get('/').expect(200);
+
+    expect(first.headers['x-request-id']).not.toEqual(
+      second.headers['x-request-id'],
+    );
+  });
+});
