+import { randomUUID } from 'crypto';
+import type { RequestIdOptions } from '@nestjs/common/internal';
+import type { AbstractHttpAdapter } from '../../adapters/index.js';
+import { DEFAULT_REQUEST_ID_HEADER } from './request-id.constants.js';
+import { runWithRequestId } from './request-id-store.js';
+
+/**
+ * Wires request-id tracking onto `httpAdapter` via `setOnRequestHook`, the
+ * one extensibility point both the Express and the Fastify adapter run at
+ * the very start of every request, ahead of body parsing, module
+ * middleware, and routing. This keeps the behaviour identical across both
+ * HTTP adapters instead of depending on adapter-specific packages/hooks.
+ */
+export function registerRequestIdHook(
+  httpAdapter: AbstractHttpAdapter,
+  options: RequestIdOptions = {},
+): void {
+  const header = options.header ?? DEFAULT_REQUEST_ID_HEADER;
+  const headerKey = header.toLowerCase();
+  const generateRequestId = options.generator ?? randomUUID;
+
+  httpAdapter.setOnRequestHook(
+    (req: any, res: any, next: (err?: any) => void) => {
+      const incomingHeader = req?.headers?.[headerKey];
+      const requestId =
+        (Array.isArray(incomingHeader) ? incomingHeader[0] : incomingHeader) ||
+        generateRequestId();
+
+      httpAdapter.setHeader(res, header, requestId);
+      runWithRequestId(requestId, () => next());
+    },
+  );
+}
