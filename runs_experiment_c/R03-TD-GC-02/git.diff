diff --git a/packages/core/test/middleware/request-id.spec.ts b/packages/core/test/middleware/request-id.spec.ts
new file mode 100644
index 0000000..76f7daf
--- /dev/null
+++ b/packages/core/test/middleware/request-id.spec.ts
@@ -0,0 +1,67 @@
+import { getRequestId } from '../../middleware/request-id/request-id-store.js';
+import { registerRequestIdHook } from '../../middleware/request-id/request-id.utils.js';
+
+describe('Request id', () => {
+  function createFakeAdapter() {
+    const headers: Record<string, string> = {};
+    let onRequestHook: (req: any, res: any, next: (err?: any) => void) => void;
+
+    return {
+      headers,
+      setOnRequestHook: (hook: any) => (onRequestHook = hook),
+      setHeader: (_res: any, name: string, value: string) => {
+        headers[name] = value;
+      },
+      triggerRequest(req: any) {
+        let observedRequestId: string | undefined;
+        let nextCalled = false;
+        onRequestHook(req, {}, () => {
+          nextCalled = true;
+          observedRequestId = getRequestId();
+        });
+        return { nextCalled, observedRequestId };
+      },
+    };
+  }
+
+  it('generates a request id and sets it on the response header when none was supplied', () => {
+    const adapter = createFakeAdapter();
+    registerRequestIdHook(adapter as any);
+
+    const { nextCalled, observedRequestId } = adapter.triggerRequest({
+      headers: {},
+    });
+
+    expect(nextCalled).toBe(true);
+    expect(adapter.headers['X-Request-Id']).toBeTruthy();
+    expect(observedRequestId).toEqual(adapter.headers['X-Request-Id']);
+  });
+
+  it('reuses an incoming request id instead of generating a new one', () => {
+    const adapter = createFakeAdapter();
+    registerRequestIdHook(adapter as any);
+
+    const { observedRequestId } = adapter.triggerRequest({
+      headers: { 'x-request-id': 'caller-supplied-id' },
+    });
+
+    expect(adapter.headers['X-Request-Id']).toEqual('caller-supplied-id');
+    expect(observedRequestId).toEqual('caller-supplied-id');
+  });
+
+  it('supports a custom header name and generator', () => {
+    const adapter = createFakeAdapter();
+    registerRequestIdHook(adapter as any, {
+      header: 'X-Correlation-Id',
+      generator: () => 'generated-id',
+    });
+
+    adapter.triggerRequest({ headers: {} });
+
+    expect(adapter.headers['X-Correlation-Id']).toEqual('generated-id');
+  });
+
+  it('returns undefined outside of a tracked request', () => {
+    expect(getRequestId()).toBeUndefined();
+  });
+});
