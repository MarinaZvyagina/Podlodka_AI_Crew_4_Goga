@@ -0,0 +1,27 @@
+import { AsyncLocalStorage } from 'async_hooks';
+
+interface RequestIdStore {
+  requestId: string;
+}
+
+const requestIdStorage = new AsyncLocalStorage<RequestIdStore>();
+
+/**
+ * Runs `callback` with `requestId` attached to the current async context, so
+ * that any code invoked (synchronously or asynchronously) from within it can
+ * retrieve the same id via {@link getRequestId}, regardless of which HTTP
+ * adapter (Express or Fastify) produced the request.
+ */
+export function runWithRequestId<T>(requestId: string, callback: () => T): T {
+  return requestIdStorage.run({ requestId }, callback);
+}
+
+/**
+ * Returns the request id associated with the request currently being
+ * handled, or `undefined` if called outside of a request (or when request
+ * id tracking was never enabled via `NestApplication#enableRequestId`).
+ * @publicApi
+ */
+export function getRequestId(): string | undefined {
+  return requestIdStorage.getStore()?.requestId;
+}
