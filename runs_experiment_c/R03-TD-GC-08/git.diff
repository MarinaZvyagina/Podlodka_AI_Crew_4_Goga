+++ b/packages/core/test/router/request-id/request-id.middleware.spec.ts
@@ -0,0 +1,103 @@
+import { REQUEST_ID_HEADER } from '../../../router/request-id/request-id.constants.js';
+import { requestIdMiddleware } from '../../../router/request-id/request-id.middleware.js';
+import { RequestIdStorage } from '../../../router/request-id/request-id.storage.js';
+
+describe('requestIdMiddleware', () => {
+  const createResponse = () => ({ setHeader: vi.fn() });
+
+  it('generates a request id when none was supplied', () => {
+    const req = { headers: {} };
+    const res = createResponse();
+    const next = vi.fn();
+
+    requestIdMiddleware(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledOnce();
+    const [headerName, requestId] = res.setHeader.mock.calls[0];
+    expect(headerName).toBe(REQUEST_ID_HEADER);
+    expect(typeof requestId).toBe('string');
+    expect(requestId.length).toBeGreaterThan(0);
+    expect(next).toHaveBeenCalledOnce();
+  });
+
+  it('reuses a well-formed incoming request id instead of generating a new one', () => {
+    const req = { headers: { [REQUEST_ID_HEADER]: 'caller-supplied-id-123' } };
+    const res = createResponse();
+    const next = vi.fn();
+
+    requestIdMiddleware(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledWith(
+      REQUEST_ID_HEADER,
+      'caller-supplied-id-123',
+    );
+  });
+
+  it('generates a fresh id when the incoming header is malformed', () => {
+    const req = {
+      headers: { [REQUEST_ID_HEADER]: 'bad value\r\nX-Injected: 1' },
+    };
+    const res = createResponse();
+    const next = vi.fn();
+
+    requestIdMiddleware(req, res, next);
+
+    const [, requestId] = res.setHeader.mock.calls[0];
+    expect(requestId).not.toBe('bad value\r\nX-Injected: 1');
+  });
+
+  it('generates a fresh id when the incoming header is an empty array', () => {
+    const req = { headers: { [REQUEST_ID_HEADER]: [] } };
+    const res = createResponse();
+    const next = vi.fn();
+
+    requestIdMiddleware(req, res, next);
+
+    const [, requestId] = res.setHeader.mock.calls[0];
+    expect(typeof requestId).toBe('string');
+    expect(requestId.length).toBeGreaterThan(0);
+  });
+
+  it('takes the first value when the incoming header repeats', () => {
+    const req = {
+      headers: { [REQUEST_ID_HEADER]: ['first-id', 'second-id'] },
+    };
+    const res = createResponse();
+    const next = vi.fn();
+
+    requestIdMiddleware(req, res, next);
+
+    expect(res.setHeader).toHaveBeenCalledWith(REQUEST_ID_HEADER, 'first-id');
+  });
+
+  it('makes the resolved id readable from RequestIdStorage while next() runs', () => {
+    const req = { headers: { [REQUEST_ID_HEADER]: 'trace-42' } };
+    const res = createResponse();
+    let observed: string | undefined;
+
+    requestIdMiddleware(req, res, () => {
+      observed = RequestIdStorage.get();
+    });
+
+    expect(observed).toBe('trace-42');
+    expect(RequestIdStorage.get()).toBeUndefined();
+  });
+
+  it('keeps the id available across an async continuation of next()', async () => {
+    const req = { headers: {} };
+    const res = createResponse();
+    let observed: string | undefined;
+
+    await new Promise<void>(resolve => {
+      requestIdMiddleware(req, res, () => {
+        setTimeout(() => {
+          observed = RequestIdStorage.get();
+          resolve();
+        }, 0);
+      });
+    });
+
+    const [, requestId] = res.setHeader.mock.calls[0];
+    expect(observed).toBe(requestId);
+  });
+});
diff --git a/packages/core/test/router/request-id/request-id.storage.spec.ts b/packages/core/test/router/request-id/request-id.storage.spec.ts
