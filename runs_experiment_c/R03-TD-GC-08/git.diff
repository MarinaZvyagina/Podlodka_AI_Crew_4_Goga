@@ -0,0 +1,9 @@
+export const REQUEST_ID_HEADER = 'x-request-id';
+
+/**
+ * Incoming values are only reused when they match this shape; anything else
+ * (empty, oversized, or containing characters that could corrupt the
+ * response headers) is replaced with a freshly generated id instead of being
+ * reflected back to the caller.
+ */
+export const REQUEST_ID_PATTERN = /^[\w.-]{1,128}$/;
diff --git a/packages/core/router/request-id/request-id.middleware.ts b/packages/core/router/request-id/request-id.middleware.ts
new file mode 100644
index 0000000..17846ba
--- /dev/null
+++ b/packages/core/router/request-id/request-id.middleware.ts
@@ -0,0 +1,35 @@
+import { randomUUID } from 'crypto';
+import {
+  REQUEST_ID_HEADER,
+  REQUEST_ID_PATTERN,
+} from './request-id.constants.js';
+import { RequestIdStorage } from './request-id.storage.js';
+
+function readIncomingRequestId(req: any): string | undefined {
+  const header = req?.headers?.[REQUEST_ID_HEADER];
+  const value = Array.isArray(header) ? header[0] : header;
+  return typeof value === 'string' && REQUEST_ID_PATTERN.test(value)
+    ? value
+    : undefined;
+}
+
+/**
+ * Framework-agnostic (req, res, next) middleware that assigns every request a
+ * correlation id: the caller-supplied `x-request-id` header when present and
+ * well-formed, otherwise a freshly generated one. The id is written back as a
+ * response header and, for the remainder of the request, made available to
+ * application code via `RequestIdStorage.get()`.
+ *
+ * Registered through `app.use()`, this runs identically on every platform
+ * adapter that supports Express-style middleware (Express directly, Fastify
+ * via its middie integration) — there is nothing adapter-specific here.
+ */
+export function requestIdMiddleware(
+  req: any,
+  res: any,
+  next: (err?: any) => void,
+): void {
+  const requestId = readIncomingRequestId(req) ?? randomUUID();
+  res.setHeader(REQUEST_ID_HEADER, requestId);
+  RequestIdStorage.run(requestId, () => next());
+}
diff --git a/packages/core/router/request-id/request-id.storage.ts b/packages/core/router/request-id/request-id.storage.ts
new file mode 100644
index 0000000..7a9e9a9
--- /dev/null
+++ b/packages/core/router/request-id/request-id.storage.ts
@@ -0,0 +1,20 @@
+import { AsyncLocalStorage } from 'async_hooks';
+
+/**
+ * Propagates the current request's correlation id through async control flow
+ * so code invoked while handling a request (log statements, services,
+ * exception filters, ...) can read the same id that was written to the
+ * response header, without threading it through every call or re-parsing it
+ * off the request/response objects.
+ */
+export class RequestIdStorage {
+  private static readonly storage = new AsyncLocalStorage<string>();
+
+  static run<T>(requestId: string, callback: () => T): T {
+    return this.storage.run(requestId, callback);
+  }
+
+  static get(): string | undefined {
+    return this.storage.getStore();
+  }
+}
diff --git a/packages/core/test/router/request-id/request-id.middleware.spec.ts b/packages/core/test/router/request-id/request-id.middleware.spec.ts
new file mode 100644
index 0000000..cfde921
