@@ -0,0 +1,43 @@
+import { RequestIdStorage } from '../../../router/request-id/request-id.storage.js';
+
+describe('RequestIdStorage', () => {
+  it('returns undefined outside of a run() call', () => {
+    expect(RequestIdStorage.get()).toBeUndefined();
+  });
+
+  it('exposes the bound id for the duration of the callback', () => {
+    const result = RequestIdStorage.run('abc-123', () => RequestIdStorage.get());
+    expect(result).toBe('abc-123');
+  });
+
+  it('isolates concurrent runs from each other', async () => {
+    const observations: string[] = [];
+
+    await Promise.all([
+      RequestIdStorage.run('req-1', async () => {
+        await new Promise(resolve => setTimeout(resolve, 10));
+        observations.push(RequestIdStorage.get()!);
+      }),
+      RequestIdStorage.run('req-2', async () => {
+        await new Promise(resolve => setTimeout(resolve, 0));
+        observations.push(RequestIdStorage.get()!);
+      }),
+    ]);
+
+    expect(observations.sort()).toEqual(['req-1', 'req-2']);
+  });
+
+  it('supports nested runs, restoring the outer id afterwards', () => {
+    const seen: Array<string | undefined> = [];
+
+    RequestIdStorage.run('outer', () => {
+      seen.push(RequestIdStorage.get());
+      RequestIdStorage.run('inner', () => {
+        seen.push(RequestIdStorage.get());
+      });
+      seen.push(RequestIdStorage.get());
+    });
+
+    expect(seen).toEqual(['outer', 'inner', 'outer']);
+  });
+});
