+++ b/integration/hello-world/e2e/request-id.spec.ts
@@ -0,0 +1,117 @@
+import { Controller, Get, INestApplication, Module } from '@nestjs/common';
+import {
+  NestFactory,
+  REQUEST_ID_HEADER,
+  RequestIdStorage,
+  requestIdMiddleware,
+} from '@nestjs/core';
+import { ExpressAdapter } from '@nestjs/platform-express';
+import {
+  FastifyAdapter,
+  NestFastifyApplication,
+} from '@nestjs/platform-fastify';
+import request from 'supertest';
+
+@Controller()
+class RequestIdTestController {
+  @Get('echo')
+  echo() {
+    return { requestId: RequestIdStorage.get() };
+  }
+}
+
+@Module({ controllers: [RequestIdTestController] })
+class RequestIdTestModule {}
+
+describe('Request id correlation header', () => {
+  // The exact same controller and the exact same `app.use(requestIdMiddleware)`
+  // call are reused for both platforms below — proving application code does
+  // not need to differ depending on which HTTP adapter a service runs on.
+  const adapters: Array<{
+    name: string;
+    createApp: () => Promise<INestApplication>;
+  }> = [
+    {
+      name: 'ExpressAdapter',
+      createApp: async () => {
+        const app = await NestFactory.create(
+          RequestIdTestModule,
+          new ExpressAdapter(),
+          { logger: false },
+        );
+        app.use(requestIdMiddleware);
+        await app.init();
+        return app;
+      },
+    },
+    {
+      name: 'FastifyAdapter',
+      createApp: async () => {
+        const app = await NestFactory.create<NestFastifyApplication>(
+          RequestIdTestModule,
+          new FastifyAdapter(),
+          { logger: false },
+        );
+        app.use(requestIdMiddleware);
+        await app.init();
+        await app.getHttpAdapter().getInstance().ready();
+        return app;
+      },
+    },
+  ];
+
+  for (const { name, createApp } of adapters) {
+    describe(name, () => {
+      let app: INestApplication;
+
+      afterEach(async () => {
+        await app.close();
+      });
+
+      it('generates a request id and returns it as a response header when the caller sends none', async () => {
+        app = await createApp();
+
+        const response = await request(app.getHttpServer()).get('/echo');
+
+        const headerValue = response.headers[REQUEST_ID_HEADER];
+        expect(headerValue).toBeTruthy();
+        expect(response.body.requestId).toBe(headerValue);
+      });
+
+      it('reuses the caller-supplied request id in both the response header and application code', async () => {
+        app = await createApp();
+
+        const response = await request(app.getHttpServer())
+          .get('/echo')
+          .set(REQUEST_ID_HEADER, 'caller-trace-id-1');
+
+        expect(response.headers[REQUEST_ID_HEADER]).toBe('caller-trace-id-1');
+        expect(response.body.requestId).toBe('caller-trace-id-1');
+      });
+
+      it('includes the request id header on a 404 response', async () => {
+        app = await createApp();
+
+        const response = await request(app.getHttpServer()).get(
+          '/does-not-exist',
+        );
+
+        expect(response.status).toBe(404);
+        expect(response.headers[REQUEST_ID_HEADER]).toBeTruthy();
+      });
+
+      it('assigns a different id to each request that supplies none', async () => {
+        app = await createApp();
+
+        const [first, second] = await Promise.all([
+          request(app.getHttpServer()).get('/echo'),
+          request(app.getHttpServer()).get('/echo'),
+        ]);
+
+        expect(first.headers[REQUEST_ID_HEADER]).not.toBe(
+          second.headers[REQUEST_ID_HEADER],
+        );
+      });
+    });
+  }
+});
