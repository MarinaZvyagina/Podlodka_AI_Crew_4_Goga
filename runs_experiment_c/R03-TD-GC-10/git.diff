+/**
+ * Name of the HTTP header that carries the request/correlation identifier,
+ * both on incoming requests (when a caller already provides one) and on
+ * outgoing responses.
+ *
+ * @publicApi
+ */
+export const REQUEST_ID_HEADER = 'x-request-id';
