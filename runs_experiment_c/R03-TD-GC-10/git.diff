+import { AsyncLocalStorage } from 'async_hooks';
+
+export interface RequestIdStore {
+  requestId: string;
+}
+
+/**
+ * Holds the request/correlation identifier for the lifetime of a single
+ * incoming request using `AsyncLocalStorage`, so that any application code
+ * running downstream of {@link RequestIdMiddleware} (guards, interceptors,
+ * pipes, controllers, services, ...) can read it without access to the
+ * request/response objects and regardless of the underlying HTTP adapter.
+ *
+ * @publicApi
+ */
+export class RequestIdStorage {
+  private static readonly storage = new AsyncLocalStorage<RequestIdStore>();
+
+  /**
+   * Runs `callback` within a context that exposes `store` via {@link requestId}.
+   */
+  public static run<T>(store: RequestIdStore, callback: () => T): T {
+    return this.storage.run(store, callback);
+  }
+
+  /**
+   * The identifier of the request currently being handled, or `undefined`
+   * when called outside of a request initiated through
+   * {@link RequestIdMiddleware}.
+   */
+  public static get requestId(): string | undefined {
+    return this.storage.getStore()?.requestId;
+  }
+}
