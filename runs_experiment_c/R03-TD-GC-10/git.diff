+import {
+  Controller,
+  Get,
+  MiddlewareConsumer,
+  Module,
+  NestModule,
+} from '@nestjs/common';
+import { REQUEST_ID_HEADER, RequestIdMiddleware, RequestIdStorage } from '@nestjs/core';
+import {
+  FastifyAdapter,
+  NestFastifyApplication,
+} from '@nestjs/platform-fastify';
+import { Test } from '@nestjs/testing';
+
+@Controller()
+class RequestIdTestController {
+  @Get('request-id')
+  getRequestId() {
+    return { requestId: RequestIdStorage.requestId };
+  }
+}
+
+@Module({
+  controllers: [RequestIdTestController],
+})
+class RequestIdTestModule implements NestModule {
+  configure(consumer: MiddlewareConsumer) {
+    consumer.apply(RequestIdMiddleware).forRoutes('*');
+  }
+}
+
+describe('Request id (FastifyAdapter)', () => {
+  let app: NestFastifyApplication;
+
+  beforeEach(async () => {
+    app = (
+      await Test.createTestingModule({
+        imports: [RequestIdTestModule],
+      }).compile()
+    ).createNestApplication<NestFastifyApplication>(new FastifyAdapter());
+
+    await app.init();
+    await app.getHttpAdapter().getInstance().ready();
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  it('should generate and return a request id header when the caller does not send one', async () => {
+    const response = await app.inject({ method: 'GET', url: '/request-id' });
+
+    expect(response.statusCode).toEqual(200);
+    const headerValue = response.headers[REQUEST_ID_HEADER];
+    expect(headerValue).toEqual(expect.any(String));
+    expect((headerValue as string).length).toBeGreaterThan(0);
+  });
+
+  it('should reuse the caller-supplied request id instead of generating a new one', async () => {
+    const response = await app.inject({
+      method: 'GET',
+      url: '/request-id',
+      headers: { [REQUEST_ID_HEADER]: 'caller-supplied-id' },
+    });
+
+    expect(response.headers[REQUEST_ID_HEADER]).toEqual('caller-supplied-id');
+  });
+
+  it('should generate a different id per request', async () => {
+    const first = await app.inject({ method: 'GET', url: '/request-id' });
+    const second = await app.inject({ method: 'GET', url: '/request-id' });
+
+    expect(first.headers[REQUEST_ID_HEADER]).not.toEqual(
+      second.headers[REQUEST_ID_HEADER],
+    );
+  });
+
+  it('should expose the same id to application code as the one returned in the response header', async () => {
+    const response = await app.inject({
+      method: 'GET',
+      url: '/request-id',
+      headers: { [REQUEST_ID_HEADER]: 'caller-supplied-id' },
+    });
+
+    const payload = JSON.parse(response.payload);
+    expect(payload.requestId).toEqual('caller-supplied-id');
+    expect(payload.requestId).toEqual(response.headers[REQUEST_ID_HEADER]);
+  });
+});
