+import { RequestIdStorage } from '../../../middleware/request-id/request-id-storage.js';
+
+describe('RequestIdStorage', () => {
+  it('should return undefined outside of a run() context', () => {
+    expect(RequestIdStorage.requestId).toBeUndefined();
+  });
+
+  it('should expose the requestId of the current context', () => {
+    RequestIdStorage.run({ requestId: 'abc-123' }, () => {
+      expect(RequestIdStorage.requestId).toEqual('abc-123');
+    });
+  });
+
+  it('should return the value produced by the callback', () => {
+    const result = RequestIdStorage.run({ requestId: 'abc-123' }, () => 42);
+    expect(result).toEqual(42);
+  });
+
+  it('should isolate concurrent contexts from each other', async () => {
+    const observed: Array<string | undefined> = [];
+
+    await Promise.all([
+      RequestIdStorage.run({ requestId: 'first' }, async () => {
+        await new Promise(resolve => setTimeout(resolve, 10));
+        observed.push(RequestIdStorage.requestId);
+      }),
+      RequestIdStorage.run({ requestId: 'second' }, async () => {
+        observed.push(RequestIdStorage.requestId);
+      }),
+    ]);
+
+    expect(observed).toEqual(['second', 'first']);
+  });
+
+  it('should not leak the requestId once the context has exited', () => {
+    RequestIdStorage.run({ requestId: 'abc-123' }, () => {});
+    expect(RequestIdStorage.requestId).toBeUndefined();
+  });
+});
diff --git a/packages/core/test/middleware/request-id/request-id.middleware.spec.ts b/packages/core/test/middleware/request-id/request-id.middleware.spec.ts
