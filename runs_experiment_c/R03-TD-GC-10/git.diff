+++ b/packages/core/middleware/request-id/request-id.middleware.ts
@@ -0,0 +1,35 @@
+import { Injectable, NestMiddleware } from '@nestjs/common';
+import { randomStringGenerator } from '@nestjs/common/internal';
+import { REQUEST_ID_HEADER } from './request-id.constants.js';
+import { RequestIdStorage } from './request-id-storage.js';
+
+/**
+ * Ensures every response carries a `x-request-id` header, reusing the value
+ * supplied by the caller (if any) instead of generating a new one, so a
+ * single identifier can be traced across a chain of internal calls.
+ *
+ * Works identically regardless of the underlying HTTP adapter (Express or
+ * Fastify), since middleware registered through `MiddlewareConsumer` always
+ * receives the raw Node.js request/response objects on both platforms.
+ *
+ * @publicApi
+ */
+@Injectable()
+export class RequestIdMiddleware implements NestMiddleware {
+  use(
+    req: { headers?: Record<string, string | string[] | undefined> },
+    res: { setHeader: (name: string, value: string) => void },
+    next: (error?: any) => void,
+  ) {
+    const requestId = this.resolveRequestId(req.headers?.[REQUEST_ID_HEADER]);
+    res.setHeader(REQUEST_ID_HEADER, requestId);
+    RequestIdStorage.run({ requestId }, next);
+  }
+
+  private resolveRequestId(headerValue: string | string[] | undefined) {
+    const incomingId = Array.isArray(headerValue)
+      ? headerValue[0]
+      : headerValue;
+    return incomingId || randomStringGenerator();
+  }
+}
