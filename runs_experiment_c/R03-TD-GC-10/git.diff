+import { REQUEST_ID_HEADER } from '../../../middleware/request-id/request-id.constants.js';
+import { RequestIdStorage } from '../../../middleware/request-id/request-id-storage.js';
+import { RequestIdMiddleware } from '../../../middleware/request-id/request-id.middleware.js';
+
+describe('RequestIdMiddleware', () => {
+  let middleware: RequestIdMiddleware;
+  let setHeader: ReturnType<typeof vi.fn>;
+
+  beforeEach(() => {
+    middleware = new RequestIdMiddleware();
+    setHeader = vi.fn();
+  });
+
+  it('should generate a new id and set it on the response when the caller does not provide one', () => {
+    const next = vi.fn();
+
+    middleware.use({ headers: {} }, { setHeader }, next);
+
+    expect(setHeader).toHaveBeenCalledTimes(1);
+    const [headerName, headerValue] = setHeader.mock.calls[0];
+    expect(headerName).toEqual(REQUEST_ID_HEADER);
+    expect(headerValue).toEqual(expect.any(String));
+    expect(headerValue.length).toBeGreaterThan(0);
+    expect(next).toHaveBeenCalledTimes(1);
+  });
+
+  it('should reuse the id supplied by the caller instead of generating a new one', () => {
+    const next = vi.fn();
+
+    middleware.use(
+      { headers: { [REQUEST_ID_HEADER]: 'caller-supplied-id' } },
+      { setHeader },
+      next,
+    );
+
+    expect(setHeader).toHaveBeenCalledWith(
+      REQUEST_ID_HEADER,
+      'caller-supplied-id',
+    );
+  });
+
+  it('should generate distinct ids across separate requests', () => {
+    middleware.use({ headers: {} }, { setHeader }, () => {});
+    middleware.use({ headers: {} }, { setHeader }, () => {});
+
+    const [firstId] = setHeader.mock.calls[0].slice(1);
+    const [secondId] = setHeader.mock.calls[1].slice(1);
+    expect(firstId).not.toEqual(secondId);
+  });
+
+  it('should make the same id available via RequestIdStorage while next() runs', () => {
+    let idSeenByDownstreamCode: string | undefined;
+    const next = () => {
+      idSeenByDownstreamCode = RequestIdStorage.requestId;
+    };
+
+    middleware.use(
+      { headers: { [REQUEST_ID_HEADER]: 'caller-supplied-id' } },
+      { setHeader },
+      next,
+    );
+
+    expect(idSeenByDownstreamCode).toEqual('caller-supplied-id');
+  });
+
+  it('should not leak the request id outside of the request context', () => {
+    middleware.use(
+      { headers: { [REQUEST_ID_HEADER]: 'caller-supplied-id' } },
+      { setHeader },
+      () => {},
+    );
+
+    expect(RequestIdStorage.requestId).toBeUndefined();
+  });
+});
