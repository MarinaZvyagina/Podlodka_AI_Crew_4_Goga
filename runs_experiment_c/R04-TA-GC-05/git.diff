@@ -0,0 +1,24 @@
+import { DEFAULT_FILENAME } from "./constants";
+
+// characters forbidden in file names on Windows, plus `/` which is
+// forbidden on macOS/Linux as well (Windows also forbids `\`, both are
+// covered below)
+const INVALID_FILENAME_CHARS_REGEX = /[\\/:*?"<>|]/g;
+
+/**
+ * Turns a user-supplied drawing name into a name that's safe to use as a
+ * file name on Windows, macOS, and Linux, by stripping characters that are
+ * invalid on any of them and trimming the leading/trailing whitespace and
+ * trailing dots that Windows silently drops when saving a file (dropping
+ * them here too keeps the name shown to the user in sync with what
+ * actually ends up on disk).
+ */
+export const getSanitizedFilename = (name: string): string => {
+  let sanitized = name.replace(INVALID_FILENAME_CHARS_REGEX, "-").trim();
+
+  while (sanitized.length && /[ .]$/.test(sanitized)) {
+    sanitized = sanitized.slice(0, -1);
+  }
+
+  return sanitized || DEFAULT_FILENAME;
+};
