+import { getSanitizedFilename } from "@excalidraw/common";
+
+describe("@excalidraw/common/filename", () => {
+  describe("getSanitizedFilename()", () => {
+    it("should leave already-safe names untouched", () => {
+      expect(getSanitizedFilename("My Drawing")).toEqual("My Drawing");
+    });
+
+    it("should replace characters invalid on Windows/macOS/Linux", () => {
+      expect(getSanitizedFilename('a/b\\c:d*e?f"g<h>i|j')).toEqual(
+        "a-b-c-d-e-f-g-h-i-j",
+      );
+    });
+
+    it("should trim leading/trailing whitespace", () => {
+      expect(getSanitizedFilename("  My Drawing  ")).toEqual("My Drawing");
+    });
+
+    it("should strip trailing dots and spaces (silently stripped by Windows)", () => {
+      expect(getSanitizedFilename("My Drawing.")).toEqual("My Drawing");
+      expect(getSanitizedFilename("My Drawing...")).toEqual("My Drawing");
+      expect(getSanitizedFilename("My Drawing . . ")).toEqual("My Drawing");
+    });
+
+    it("should fall back to the default name when empty or blank", () => {
+      expect(getSanitizedFilename("")).toEqual("Untitled");
+      expect(getSanitizedFilename("   ")).toEqual("Untitled");
+      expect(getSanitizedFilename("...")).toEqual("Untitled");
+    });
+  });
+});
