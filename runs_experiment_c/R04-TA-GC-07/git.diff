@@ -0,0 +1,35 @@
+import { sanitizeFilename } from "@excalidraw/common";
+
+describe("sanitizeFilename", () => {
+  it("leaves a normal name untouched", () => {
+    expect(sanitizeFilename("My drawing")).toBe("My drawing");
+  });
+
+  it("strips characters forbidden on Windows/macOS/Linux", () => {
+    expect(sanitizeFilename('a/b\\c:d*e?f"g<h>i|j')).toBe("abcdefghij");
+  });
+
+  it("strips ASCII control characters", () => {
+    const withControlChars = ["abc", String.fromCharCode(0), "def"].join("");
+    expect(sanitizeFilename(withControlChars)).toBe("abcdef");
+  });
+
+  it("strips trailing dots and spaces", () => {
+    expect(sanitizeFilename("My drawing.")).toBe("My drawing");
+    expect(sanitizeFilename("My drawing   ")).toBe("My drawing");
+    expect(sanitizeFilename("My drawing . . ")).toBe("My drawing");
+  });
+
+  it("falls back to the default name when empty", () => {
+    expect(sanitizeFilename("")).toBe("Untitled");
+  });
+
+  it("falls back to the default name when made up only of spaces", () => {
+    expect(sanitizeFilename("   ")).toBe("Untitled");
+  });
+
+  it("falls back to the default name when only unsafe characters remain", () => {
+    expect(sanitizeFilename("???")).toBe("Untitled");
+    expect(sanitizeFilename("...")).toBe("Untitled");
+  });
+});
