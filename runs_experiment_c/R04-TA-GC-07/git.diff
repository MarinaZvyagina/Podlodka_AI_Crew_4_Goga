@@ -0,0 +1,21 @@
+import { DEFAULT_FILENAME } from "./constants";
+
+// characters reserved/forbidden in file names on Windows, plus ASCII control
+// characters, which are also rejected or cause trouble on macOS/Linux tooling
+// eslint-disable-next-line no-control-regex
+const UNSAFE_FILENAME_CHARS = /["*/:<>?\\|\x00-\x1f]/g;
+
+/**
+ * Sanitizes a user-provided drawing name so it's safe to use as a file name
+ * when saving/exporting to disk on Windows, macOS, and Linux.
+ */
+export const sanitizeFilename = (name: string): string => {
+  const sanitized = name
+    .replace(UNSAFE_FILENAME_CHARS, "")
+    // Windows silently strips trailing dots/spaces, which would otherwise
+    // make the saved file name mismatch what the user typed
+    .replace(/[\s.]+$/, "")
+    .trim();
+
+  return sanitized || DEFAULT_FILENAME;
+};
