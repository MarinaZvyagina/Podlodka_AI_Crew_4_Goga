+/**
+ * The area enclosed by an element's outline, in scene units squared.
+ * Computed from the element's local (un-rotated) geometry, so it's
+ * unaffected by the element's rotation angle.
+ *
+ * Returns `null` for elements that don't enclose a region (e.g. arrows,
+ * text, or a line/freedraw path whose ends aren't joined into a loop).
+ */
+export const getElementArea = (
+  element: ExcalidrawElement,
+  zoomValue?: Zoom["value"],
+): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    case "line":
+    case "freedraw":
+      if (
+        (isLineElement(element) || isFreeDrawElement(element)) &&
+        isPathALoop(element.points, zoomValue)
+      ) {
+        return polygonArea(element.points);
+      }
+      return null;
+    default:
+      return null;
+  }
+};
