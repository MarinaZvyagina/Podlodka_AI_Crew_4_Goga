index 0000000..dffbd34
--- /dev/null
+++ b/packages/element/tests/shape.test.ts
@@ -0,0 +1,149 @@
+import { pointFrom, type LocalPoint, type Radians } from "@excalidraw/math";
+import { arrayToMap } from "@excalidraw/common";
+import { API } from "@excalidraw/excalidraw/tests/helpers/api";
+
+import { getElementArea } from "../src/shape";
+
+describe("getElementArea", () => {
+  it("computes rectangle area", () => {
+    const element = API.createElement({
+      type: "rectangle",
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(element, arrayToMap([element]))).toBeCloseTo(5000);
+  });
+
+  it("is rotation-invariant for a rectangle", () => {
+    const element = API.createElement({
+      type: "rectangle",
+      width: 100,
+      height: 50,
+      angle: (Math.PI / 6) as Radians,
+    });
+    expect(getElementArea(element, arrayToMap([element]))).toBeCloseTo(5000);
+  });
+
+  it("computes diamond area", () => {
+    const element = API.createElement({
+      type: "diamond",
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(element, arrayToMap([element]))).toBeCloseTo(2500);
+  });
+
+  it("is rotation-invariant for a diamond", () => {
+    const element = API.createElement({
+      type: "diamond",
+      width: 100,
+      height: 50,
+      angle: (Math.PI / 4) as Radians,
+    });
+    expect(getElementArea(element, arrayToMap([element]))).toBeCloseTo(2500);
+  });
+
+  it("computes ellipse area", () => {
+    const element = API.createElement({
+      type: "ellipse",
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(element, arrayToMap([element]))).toBeCloseTo(
+      Math.PI * 50 * 25,
+    );
+  });
+
+  it("is rotation-invariant for an ellipse", () => {
+    const element = API.createElement({
+      type: "ellipse",
+      width: 100,
+      height: 50,
+      angle: 1.1 as Radians,
+    });
+    expect(getElementArea(element, arrayToMap([element]))).toBeCloseTo(
+      Math.PI * 50 * 25,
+    );
+  });
+
+  it("returns null for a non-enclosing text element", () => {
+    const element = API.createElement({
+      type: "text",
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(element, arrayToMap([element]))).toBeNull();
+  });
+
+  it("returns null for an open line", () => {
+    const element = API.createElement({
+      type: "line",
+      width: 100,
+      height: 50,
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 50),
+      ],
+      polygon: false,
+    });
+    expect(getElementArea(element, arrayToMap([element]))).toBeNull();
+  });
+
+  it("computes area for a closed (polygon) line", () => {
+    const element = API.createElement({
+      type: "line",
+      width: 100,
+      height: 50,
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 50),
+        pointFrom<LocalPoint>(0, 50),
+        pointFrom<LocalPoint>(0, 0),
+      ],
+      polygon: true,
+    });
+    expect(getElementArea(element, arrayToMap([element]))).toBeCloseTo(5000);
+  });
+
+  it("returns null for an open (non-loop) freedraw stroke", () => {
+    const element = API.createElement({
+      type: "freedraw",
+      width: 100,
+      height: 50,
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 50),
+      ],
+    });
+    expect(getElementArea(element, arrayToMap([element]))).toBeNull();
+  });
+
+  it("computes area for a closed (looped) freedraw stroke", () => {
+    const element = API.createElement({
+      type: "freedraw",
+      width: 100,
+      height: 50,
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 50),
+        pointFrom<LocalPoint>(0, 50),
+        pointFrom<LocalPoint>(0, 0),
+      ],
+    });
+    expect(getElementArea(element, arrayToMap([element]))).toBeCloseTo(5000);
+  });
+
+  it("returns null for an arrow", () => {
+    const element = API.createElement({
+      type: "arrow",
+      width: 100,
+      height: 50,
+      points: [pointFrom<LocalPoint>(0, 0), pointFrom<LocalPoint>(100, 50)],
+    });
+    expect(getElementArea(element, arrayToMap([element]))).toBeNull();
+  });
+});
