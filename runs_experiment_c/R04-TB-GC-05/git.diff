+/**
+ * Returns the enclosed area of an element, or `null` if the element doesn't
+ * enclose a region (e.g. an open line, an arrow, or a text label).
+ *
+ * The result is rotation-invariant: rotating an element doesn't change how
+ * much space it covers.
+ */
+export const getElementArea = (
+  element: ExcalidrawElement,
+  elementsMap: ElementsMap,
+): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return Math.PI * (element.width / 2) * (element.height / 2);
+    case "line": {
+      if (!isLineElement(element) || !element.polygon) {
+        return null;
+      }
+      const roughShape = ShapeCache.generateElementShape(element, null)[0];
+      const [, , , , cx, cy] = getElementAbsoluteCoords(element, elementsMap);
+      const shape = getClosedCurveShape(
+        element,
+        roughShape,
+        pointFrom(element.x, element.y),
+        element.angle,
+        pointFrom(cx, cy),
+      );
+      return shape.type === "polygon" ? polygonArea(shape.data) : null;
+    }
+    case "freedraw": {
+      if (!isPathALoop(element.points)) {
+        return null;
+      }
+      const [, , , , cx, cy] = getElementAbsoluteCoords(element, elementsMap);
+      const shape = getFreedrawShape(element, pointFrom(cx, cy), true);
+      return shape.type === "polygon" ? polygonArea(shape.data) : null;
+    }
+    default:
+      return null;
+  }
+};
