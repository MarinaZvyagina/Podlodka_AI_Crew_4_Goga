+    API.setElements([rectangle]);
+    API.setSelectedElements([rectangle]);
+
+    expect(getAreaValue()).toBe("20000");
+
+    act(() => {
+      h.app.scene.mutateElement(rectangle, {
+        angle: degreesToRadians(35 as Degrees),
+      });
+    });
+
+    expect(getAreaValue()).toBe("20000");
+  });
+
+  it("shows half of width x height for a diamond", () => {
