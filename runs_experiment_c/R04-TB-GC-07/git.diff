+/**
+ * The area enclosed by an element's outline, or `null` if the element
+ * doesn't enclose a region (e.g. an open line/freedraw path, an arrow, or
+ * text). Rotation doesn't affect the result, since rotating a shape doesn't
+ * change the area it covers.
+ */
+export const getElementArea = (element: ExcalidrawElement): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    case "line":
+    case "freedraw":
+      return isPathALoop(element.points)
+        ? polygonArea(polygonFromPoints([...element.points]))
+        : null;
+    default:
+      return null;
+  }
+};
