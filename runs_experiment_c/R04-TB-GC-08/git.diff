+import { pointFrom } from "@excalidraw/math";
+
+import { getElementArea } from "../sizeHelpers";
+
+import type { ExcalidrawElement } from "../types";
+
+const asElement = (partial: Record<string, unknown>) =>
+  partial as unknown as ExcalidrawElement;
+
+describe("getElementArea", () => {
+  it("computes rectangle area regardless of rotation", () => {
+    const rectangle = asElement({
+      type: "rectangle",
+      width: 100,
+      height: 50,
+      angle: 0,
+    });
+
+    expect(getElementArea(rectangle)).toBe(5000);
+    expect(getElementArea(asElement({ ...rectangle, angle: 0.7854 }))).toBe(
+      5000,
+    );
+  });
+
+  it("computes diamond area as half the bounding box", () => {
+    const diamond = asElement({
+      type: "diamond",
+      width: 100,
+      height: 50,
+    });
+
+    expect(getElementArea(diamond)).toBe(2500);
+  });
+
+  it("computes ellipse area", () => {
+    const ellipse = asElement({
+      type: "ellipse",
+      width: 100,
+      height: 50,
+    });
+
+    expect(getElementArea(ellipse)).toBeCloseTo((Math.PI * 100 * 50) / 4, 5);
+  });
+
+  it("computes area of a closed, filled line as a polygon", () => {
+    const closedLine = asElement({
+      type: "line",
+      width: 100,
+      height: 100,
+      backgroundColor: "#ffffff",
+      polygon: true,
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+        pointFrom(0, 0),
+      ],
+    });
+
+    expect(getElementArea(closedLine)).toBe(10000);
+  });
+
+  it("returns null for an open line", () => {
+    const openLine = asElement({
+      type: "line",
+      width: 100,
+      height: 100,
+      backgroundColor: "#ffffff",
+      polygon: false,
+      points: [pointFrom(0, 0), pointFrom(100, 0), pointFrom(100, 100)],
+    });
+
+    expect(getElementArea(openLine)).toBeNull();
+  });
+
+  it("returns null for a closed line with no background fill", () => {
+    const unfilledLoop = asElement({
+      type: "line",
+      width: 100,
+      height: 100,
+      backgroundColor: "transparent",
+      polygon: true,
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+        pointFrom(0, 0),
+      ],
+    });
+
+    expect(getElementArea(unfilledLoop)).toBeNull();
+  });
+
+  it("computes area of a closed, filled freedraw loop", () => {
+    const closedFreedraw = asElement({
+      type: "freedraw",
+      width: 100,
+      height: 100,
+      backgroundColor: "#ffffff",
+      points: [
+        pointFrom(0, 0),
+        pointFrom(100, 0),
+        pointFrom(100, 100),
+        pointFrom(0, 100),
+        pointFrom(0, 0),
+      ],
+    });
+
+    expect(getElementArea(closedFreedraw)).toBe(10000);
+  });
+
+  it("returns null for an open freedraw stroke", () => {
+    const openFreedraw = asElement({
+      type: "freedraw",
+      width: 100,
+      height: 100,
+      backgroundColor: "#ffffff",
+      points: [pointFrom(0, 0), pointFrom(50, 20), pointFrom(100, 100)],
+    });
+
+    expect(getElementArea(openFreedraw)).toBeNull();
+  });
+
+  it("returns null for elements with no enclosed area", () => {
+    const text = asElement({ type: "text", width: 100, height: 20 });
+    const arrow = asElement({
+      type: "arrow",
+      width: 100,
+      height: 100,
+      points: [pointFrom(0, 0), pointFrom(100, 100)],
+    });
+
+    expect(getElementArea(text)).toBeNull();
+    expect(getElementArea(arrow)).toBeNull();
+  });
+});
