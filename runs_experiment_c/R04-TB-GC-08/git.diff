+/**
+ * The area enclosed by `element`, or `null` if it doesn't enclose a region
+ * (e.g. an open line/arrow or a text element). Rotation-invariant.
+ */
+export const getElementArea = (element: ExcalidrawElement): number | null => {
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      // a rhombus whose diagonals are the bounding box's width and height
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    case "line":
+    case "freedraw":
+      return isPathALoop(element.points) &&
+        !isTransparent(element.backgroundColor)
+        ? polygonArea(element.points)
+        : null;
+    default:
+      return null;
+  }
+};
