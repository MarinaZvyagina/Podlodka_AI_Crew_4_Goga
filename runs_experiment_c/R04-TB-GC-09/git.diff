+import { polygonArea, round } from "@excalidraw/math";
+
+import {
+  isFreeDrawElement,
+  isLineElement,
+  isPathALoop,
+  isValidPolygon,
+} from "@excalidraw/element";
+
+import type { NonDeletedExcalidrawElement } from "@excalidraw/element/types";
+
+import { t } from "../../i18n";
+
+/**
+ * Area is computed from the element's own (unrotated) local geometry, so it
+ * stays correct regardless of the element's angle. Returns `null` for
+ * elements that don't enclose a region (e.g. an open line/freedraw or text).
+ */
+export const getElementArea = (
+  element: NonDeletedExcalidrawElement,
+): number | null => {
+  if (element.type === "rectangle") {
+    return element.width * element.height;
+  }
+  if (element.type === "diamond") {
+    return (element.width * element.height) / 2;
+  }
+  if (element.type === "ellipse") {
+    return (Math.PI * element.width * element.height) / 4;
+  }
+  if (isLineElement(element)) {
+    return element.polygon && isValidPolygon(element.points)
+      ? polygonArea(element.points)
+      : null;
+  }
+  if (isFreeDrawElement(element)) {
+    return isPathALoop(element.points) ? polygonArea(element.points) : null;
+  }
+  return null;
+};
+
+interface AreaProps {
+  element: NonDeletedExcalidrawElement;
+}
+
+const Area = ({ element }: AreaProps) => {
+  const area = getElementArea(element);
+
+  if (area === null) {
+    return null;
+  }
+
+  return (
+    <>
+      <div>{t("stats.area")}</div>
+      <div>{round(area, 2)}</div>
+    </>
+  );
+};
+
+export default Area;
