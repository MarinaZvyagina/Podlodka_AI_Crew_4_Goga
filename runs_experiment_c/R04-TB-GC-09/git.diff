+describe("stats: area", () => {
+  beforeEach(async () => {
+    localStorage.clear();
+    renderStaticScene.mockClear();
+    reseed(7);
+    setDateTimeForTests("201933152653");
+
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+
+    API.setElements([]);
+
+    fireEvent.contextMenu(GlobalTestState.interactiveCanvas, {
+      button: 2,
+      clientX: 1,
+      clientY: 1,
+    });
+    const contextMenu = UI.queryContextMenu();
+    fireEvent.click(queryByTestId(contextMenu!, "stats")!);
+    stats = UI.queryStats();
+  });
+
+  beforeAll(() => {
+    mockBoundingClientRect();
+  });
+
+  afterAll(() => {
+    restoreOriginalGetBoundingClientRect();
+  });
+
+  const getAreaRowValue = () => {
+    elementStats = stats?.querySelector("#elementStats");
+    const rows = Array.from(
+      elementStats?.querySelectorAll(".exc-stats__row") ?? [],
+    );
+    const row = rows.find(
+      (row) => row.firstElementChild?.textContent === t("stats.area"),
+    );
+    return row?.lastElementChild?.textContent ?? null;
+  };
+
+  it("shows width * height for a rectangle", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 200,
+      height: 50,
+    });
+    API.setElements([rectangle]);
+    API.setSelectedElements([rectangle]);
+
+    expect(getAreaRowValue()).toBe("10000");
+  });
+
+  it("shows (width * height) / 2 for a diamond", () => {
+    const diamond = API.createElement({
+      type: "diamond",
+      width: 200,
+      height: 50,
+    });
+    API.setElements([diamond]);
+    API.setSelectedElements([diamond]);
+
+    expect(getAreaRowValue()).toBe("5000");
+  });
+
+  it("shows pi * w/2 * h/2 for an ellipse", () => {
+    const ellipse = API.createElement({
+      type: "ellipse",
+      width: 200,
+      height: 50,
+    });
+    API.setElements([ellipse]);
+    API.setSelectedElements([ellipse]);
+
+    const expected = round((Math.PI * 200 * 50) / 4, 2);
+    expect(getAreaRowValue()).toBe(expected.toString());
+  });
+
+  it("reports the same area before and after rotation", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      width: 200,
+      height: 50,
+    });
+    API.setElements([rectangle]);
+    API.setSelectedElements([rectangle]);
+
+    const areaBeforeRotation = getAreaRowValue();
+
+    act(() => {
+      h.app.scene.mutateElement(rectangle, {
+        angle: degreesToRadians(37 as Degrees),
+      });
+    });
+
+    expect(getAreaRowValue()).toBe(areaBeforeRotation);
+  });
+
+  it("does not show an area for a text element", () => {
+    const text = API.createElement({ type: "text", text: "Hello!" });
+    API.setElements([text]);
+    API.setSelectedElements([text]);
+
+    expect(getAreaRowValue()).toBe(null);
+  });
+
+  it("does not show an area for an open line", () => {
+    const line = API.createElement({
+      type: "line",
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 100),
+      ],
+      polygon: false,
+    });
+    API.setElements([line]);
+    API.setSelectedElements([line]);
+
+    expect(getAreaRowValue()).toBe(null);
+  });
+
+  it("shows the polygon area for a closed line", () => {
+    const line = API.createElement({
+      type: "line",
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 100),
+        pointFrom<LocalPoint>(0, 100),
+        pointFrom<LocalPoint>(0, 0),
+      ],
+      polygon: true,
+    });
+    API.setElements([line]);
+    API.setSelectedElements([line]);
+
+    expect(getAreaRowValue()).toBe("10000");
+  });
+
+  it("does not show an area for an open freedraw stroke", () => {
+    const freedraw = API.createElement({
+      type: "freedraw",
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 100),
+      ],
+    });
+    API.setElements([freedraw]);
+    API.setSelectedElements([freedraw]);
+
+    expect(getAreaRowValue()).toBe(null);
+  });
+
+  it("shows the polygon area for a closed (looping) freedraw stroke", () => {
+    const freedraw = API.createElement({
+      type: "freedraw",
+      points: [
+        pointFrom<LocalPoint>(0, 0),
+        pointFrom<LocalPoint>(100, 0),
+        pointFrom<LocalPoint>(100, 100),
+        pointFrom<LocalPoint>(0, 100),
+        pointFrom<LocalPoint>(0, 0),
+      ],
+    });
+    API.setElements([freedraw]);
+    API.setSelectedElements([freedraw]);
+
+    expect(getAreaRowValue()).toBe("10000");
+  });
+});
