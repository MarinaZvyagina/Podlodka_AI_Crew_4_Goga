+import { polygonArea } from "@excalidraw/math";
+
+import { isFreeDrawElement, isLineElement } from "./typeChecks";
+import { isPathALoop } from "./utils";
+
+import type { ExcalidrawElement } from "./types";
+
+/**
+ * Returns the area enclosed by an element, or `null` if the element doesn't
+ * enclose a region (e.g. an open line, an arrow, or a text label).
+ *
+ * Rotation-invariant, since rotation is a rigid transform that preserves area.
+ */
+export const getElementArea = (element: ExcalidrawElement): number | null => {
+  if (isLineElement(element)) {
+    return element.polygon ? polygonArea(element.points) : null;
+  }
+
+  if (isFreeDrawElement(element)) {
+    return isPathALoop(element.points) ? polygonArea(element.points) : null;
+  }
+
+  switch (element.type) {
+    case "rectangle":
+      return element.width * element.height;
+    case "diamond":
+      return (element.width * element.height) / 2;
+    case "ellipse":
+      return (Math.PI * element.width * element.height) / 4;
+    default:
+      return null;
+  }
+};
