+import { pointFrom } from "@excalidraw/math";
+import { API } from "@excalidraw/excalidraw/tests/helpers/api";
+
+import { getElementArea } from "../src/area";
+
+describe("getElementArea", () => {
+  it("returns width * height for a rectangle", () => {
+    const element = API.createElement({
+      type: "rectangle",
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(element)).toBe(5000);
+  });
+
+  it("is unaffected by rotation", () => {
+    const element = API.createElement({
+      type: "rectangle",
+      width: 100,
+      height: 50,
+      angle: Math.PI / 4,
+    });
+    expect(getElementArea(element)).toBe(5000);
+  });
+
+  it("returns (w * h) / 2 for a diamond", () => {
+    const element = API.createElement({
+      type: "diamond",
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(element)).toBe(2500);
+  });
+
+  it("returns pi * (w/2) * (h/2) for an ellipse", () => {
+    const element = API.createElement({
+      type: "ellipse",
+      width: 100,
+      height: 50,
+    });
+    expect(getElementArea(element)).toBeCloseTo((Math.PI * 100 * 50) / 4);
+  });
+
+  it("returns the polygon area for a closed line", () => {
+    const element = API.createElement({
+      type: "line",
+      polygon: true,
+      points: [
+        pointFrom(0, 0),
+        pointFrom(10, 0),
+        pointFrom(10, 10),
+        pointFrom(0, 10),
+        pointFrom(0, 0),
+      ],
+    });
+    expect(getElementArea(element)).toBe(100);
+  });
+
+  it("returns null for an open line", () => {
+    const element = API.createElement({
+      type: "line",
+      polygon: false,
+      points: [pointFrom(0, 0), pointFrom(10, 0), pointFrom(10, 10)],
+    });
+    expect(getElementArea(element)).toBeNull();
+  });
+
+  it("returns the polygon area for a closed (looped) freedraw shape", () => {
+    const element = API.createElement({
+      type: "freedraw",
+      points: [
+        pointFrom(0, 0),
+        pointFrom(10, 0),
+        pointFrom(10, 10),
+        pointFrom(0, 10),
+        pointFrom(0, 0.5),
+      ],
+    });
+    expect(getElementArea(element)).not.toBeNull();
+    expect(getElementArea(element)).toBeCloseTo(100, 0);
+  });
+
+  it("returns null for an open freedraw stroke", () => {
+    const element = API.createElement({
+      type: "freedraw",
+      points: [pointFrom(0, 0), pointFrom(10, 0), pointFrom(10, 10)],
+    });
+    expect(getElementArea(element)).toBeNull();
+  });
+
+  it("returns null for a text element", () => {
+    const element = API.createElement({ type: "text" });
+    expect(getElementArea(element)).toBeNull();
+  });
+
+  it("returns null for an arrow", () => {
+    const element = API.createElement({
+      type: "arrow",
+      points: [
+        pointFrom(0, 0),
+        pointFrom(10, 0),
+        pointFrom(10, 10),
+        pointFrom(0, 0),
+      ],
+    });
+    expect(getElementArea(element)).toBeNull();
+  });
+});
