diff --git a/packages/excalidraw/tests/actionToggleCaptions.test.tsx b/packages/excalidraw/tests/actionToggleCaptions.test.tsx
new file mode 100644
index 0000000..6147e92
--- /dev/null
+++ b/packages/excalidraw/tests/actionToggleCaptions.test.tsx
@@ -0,0 +1,60 @@
+import { queryByText } from "@testing-library/react";
+
+import { CODES } from "@excalidraw/common";
+
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { Keyboard } from "../tests/helpers/ui";
+import {
+  act,
+  fireEvent,
+  GlobalTestState,
+  render,
+} from "../tests/test-utils";
+
+const { h } = window;
+
+describe("actionToggleCaptions", () => {
+  beforeEach(async () => {
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+  });
+
+  afterEach(async () => {
+    await act(async () => {});
+  });
+
+  it("toggles boundTextElementsHidden on and off via Alt+L without touching the elements", () => {
+    const [rectangle, text] = API.createTextContainer();
+    API.setElements([rectangle, text]);
+
+    expect(h.state.boundTextElementsHidden).toBe(false);
+
+    Keyboard.withModifierKeys({ alt: true }, () => {
+      Keyboard.codeDown(CODES.L);
+    });
+    expect(h.state.boundTextElementsHidden).toBe(true);
+    expect(h.elements.map((el) => el.id)).toEqual([rectangle.id, text.id]);
+    expect(h.elements.find((el) => el.id === text.id)?.isDeleted).toBe(false);
+
+    Keyboard.withModifierKeys({ alt: true }, () => {
+      Keyboard.codeDown(CODES.L);
+    });
+    expect(h.state.boundTextElementsHidden).toBe(false);
+    expect(h.elements.map((el) => el.id)).toEqual([rectangle.id, text.id]);
+  });
+
+  it("toggles boundTextElementsHidden via the canvas context menu, with no selection", async () => {
+    expect(h.state.boundTextElementsHidden).toBe(false);
+
+    fireEvent.contextMenu(GlobalTestState.interactiveCanvas, {
+      button: 2,
+      clientX: 1,
+      clientY: 1,
+    });
+    const contextMenu = document.querySelector(".context-menu");
+    fireEvent.click(
+      queryByText(contextMenu as HTMLElement, "Toggle captions")!,
+    );
+    expect(h.state.boundTextElementsHidden).toBe(true);
+  });
+});
