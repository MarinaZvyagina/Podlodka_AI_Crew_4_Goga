@@ -0,0 +1,31 @@
+import { CODES, KEYS } from "@excalidraw/common";
+
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { eyeClosedIcon } from "../components/icons";
+
+import { register } from "./register";
+
+export const actionToggleCaptions = register({
+  name: "toggleCaptions",
+  icon: eyeClosedIcon,
+  keywords: ["labels", "text", "hide"],
+  label: "labels.toggleCaptions",
+  viewMode: true,
+  trackEvent: {
+    category: "canvas",
+    predicate: (appState) => !appState.boundTextElementsHidden,
+  },
+  perform(elements, appState) {
+    return {
+      appState: {
+        ...appState,
+        boundTextElementsHidden: !this.checked!(appState),
+      },
+      captureUpdate: CaptureUpdateAction.EVENTUALLY,
+    };
+  },
+  checked: (appState) => appState.boundTextElementsHidden,
+  keyTest: (event) =>
+    !event[KEYS.CTRL_OR_CMD] && event.altKey && event.code === CODES.L,
+});
