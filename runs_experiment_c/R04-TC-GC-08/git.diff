diff --git a/packages/excalidraw/tests/hideBoundText.test.tsx b/packages/excalidraw/tests/hideBoundText.test.tsx
new file mode 100644
index 0000000..6de5683
--- /dev/null
+++ b/packages/excalidraw/tests/hideBoundText.test.tsx
@@ -0,0 +1,82 @@
+import React from "react";
+
+import { CODES } from "@excalidraw/common";
+
+import { actionToggleHideBoundText } from "../actions/actionToggleHideBoundText";
+import { Excalidraw } from "../index";
+
+import { API } from "./helpers/api";
+import { Keyboard } from "./helpers/ui";
+import { render } from "./test-utils";
+
+const { h } = window;
+
+const createContainerWithBoundText = () => {
+  const container = API.createElement({
+    type: "rectangle",
+    width: 100,
+  });
+  const text = API.createElement({
+    type: "text",
+    text: "caption",
+    containerId: container.id,
+  });
+  h.app.scene.mutateElement(container, {
+    boundElements: [{ id: text.id, type: "text" }],
+  });
+  API.setElements([container, text]);
+  return { container, text };
+};
+
+describe("hide bound text", () => {
+  beforeEach(async () => {
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+  });
+
+  it("is off by default", () => {
+    expect(h.state.hideBoundTextEnabled).toBe(false);
+  });
+
+  it("toggles via keyboard shortcut without a selection", () => {
+    expect(h.state.selectedElementIds).toEqual({});
+
+    Keyboard.withModifierKeys({ alt: true }, () => {
+      Keyboard.codePress(CODES.T);
+    });
+    expect(h.state.hideBoundTextEnabled).toBe(true);
+
+    Keyboard.withModifierKeys({ alt: true }, () => {
+      Keyboard.codePress(CODES.T);
+    });
+    expect(h.state.hideBoundTextEnabled).toBe(false);
+  });
+
+  it("toggles via the action regardless of selection, without mutating elements", () => {
+    const { container, text } = createContainerWithBoundText();
+    API.setSelectedElements([container]);
+
+    const elementsBefore = h.elements.map((el) => ({ ...el }));
+
+    API.executeAction(actionToggleHideBoundText);
+    expect(h.state.hideBoundTextEnabled).toBe(true);
+    expect(h.elements.map((el) => ({ ...el }))).toEqual(elementsBefore);
+    expect(h.elements.find((el) => el.id === text.id)?.isDeleted).toBe(false);
+    expect(
+      h.elements.find((el) => el.id === container.id)?.boundElements,
+    ).toEqual([{ id: text.id, type: "text" }]);
+
+    API.executeAction(actionToggleHideBoundText);
+    expect(h.state.hideBoundTextEnabled).toBe(false);
+    expect(h.elements.map((el) => ({ ...el }))).toEqual(elementsBefore);
+  });
+
+  it("does not override, or get overridden by, other display toggles", () => {
+    API.setAppState({ zenModeEnabled: true, gridModeEnabled: true });
+
+    API.executeAction(actionToggleHideBoundText);
+
+    expect(h.state.hideBoundTextEnabled).toBe(true);
+    expect(h.state.zenModeEnabled).toBe(true);
+    expect(h.state.gridModeEnabled).toBe(true);
+  });
+});
