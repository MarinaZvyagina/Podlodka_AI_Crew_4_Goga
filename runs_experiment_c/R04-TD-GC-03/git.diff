diff --git a/packages/excalidraw/actions/actionSnapToGrid.test.tsx b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
new file mode 100644
index 0000000..084a222
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
@@ -0,0 +1,94 @@
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { Keyboard } from "../tests/helpers/ui";
+import { render } from "../tests/test-utils";
+
+import { actionSnapToGrid } from "./actionSnapToGrid";
+
+describe("snap to grid", () => {
+  beforeEach(async () => {
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+    API.setAppState({ gridSize: 20 });
+  });
+
+  it("snaps position and size of selected elements independently", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 23,
+      width: 47,
+      height: 31,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 101,
+      y: 8,
+      width: 19,
+      height: 54,
+    });
+
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([rect1, rect2]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updatedRect1 = API.getElement(rect1);
+    expect(updatedRect1.x).toBe(20);
+    expect(updatedRect1.y).toBe(20);
+    expect(updatedRect1.width).toBe(40);
+    expect(updatedRect1.height).toBe(40);
+
+    const updatedRect2 = API.getElement(rect2);
+    expect(updatedRect2.x).toBe(100);
+    expect(updatedRect2.y).toBe(0);
+    expect(updatedRect2.width).toBe(20);
+    expect(updatedRect2.height).toBe(60);
+  });
+
+  it("applies to every element when nothing is selected", () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 23,
+      width: 47,
+      height: 31,
+    });
+
+    API.setElements([rect]);
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated = API.getElement(rect);
+    expect(updated.x).toBe(20);
+    expect(updated.y).toBe(20);
+  });
+
+  it("undoes in a single step", () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 23,
+      width: 47,
+      height: 31,
+    });
+
+    API.updateScene({
+      elements: [rect],
+      appState: { selectedElementIds: { [rect.id]: true } },
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    });
+
+    API.executeAction(actionSnapToGrid);
+    expect(API.getElement(rect).x).toBe(20);
+
+    Keyboard.undo();
+
+    expect(API.getElement(rect).x).toBe(12);
+    expect(API.getElement(rect).y).toBe(23);
+    expect(API.getElement(rect).width).toBe(47);
+    expect(API.getElement(rect).height).toBe(31);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..aa6c506
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,127 @@
+import {
+  CaptureUpdateAction,
+  getBoundTextElement,
+  getNonDeletedElements,
+  isBoundToContainer,
+  resizeSingleElement,
+  updateBoundElements,
+  updateFrameMembershipOfSelectedElements,
+} from "@excalidraw/element";
+
+import { arrayToMap, getGridPoint } from "@excalidraw/common";
+
+import type { Scene } from "@excalidraw/element";
+import type {
+  ExcalidrawElement,
+  NonDeletedExcalidrawElement,
+} from "@excalidraw/element/types";
+
+import { gridIcon } from "../components/icons";
+
+import { register } from "./register";
+
+import type { NullableGridSize } from "../types";
+
+// snaps a single element's position and size to the grid independently of
+// any other element, mirroring what dragging/resizing it by hand with grid
+// snapping enabled would produce
+const snapElementToGrid = (
+  element: NonDeletedExcalidrawElement,
+  gridSize: NullableGridSize,
+  scene: Scene,
+) => {
+  const [snappedX, snappedY] = getGridPoint(element.x, element.y, gridSize);
+  const [snappedX2, snappedY2] = getGridPoint(
+    element.x + element.width,
+    element.y + element.height,
+    gridSize,
+  );
+
+  const dx = snappedX - element.x;
+  const dy = snappedY - element.y;
+
+  if (dx !== 0 || dy !== 0) {
+    scene.mutateElement(element, { x: element.x + dx, y: element.y + dy });
+
+    const boundTextElement = getBoundTextElement(
+      element,
+      scene.getNonDeletedElementsMap(),
+    );
+    if (boundTextElement) {
+      scene.mutateElement(boundTextElement, {
+        x: boundTextElement.x + dx,
+        y: boundTextElement.y + dy,
+      });
+    }
+
+    updateBoundElements(element, scene);
+  }
+
+  const nextWidth = snappedX2 - snappedX;
+  const nextHeight = snappedY2 - snappedY;
+
+  if (
+    nextWidth > 0 &&
+    nextHeight > 0 &&
+    (nextWidth !== element.width || nextHeight !== element.height)
+  ) {
+    resizeSingleElement(
+      nextWidth,
+      nextHeight,
+      element,
+      element,
+      scene.getNonDeletedElementsMap(),
+      scene,
+      "se",
+    );
+  }
+};
+
+const snapElementsToGrid = (
+  elements: readonly ExcalidrawElement[],
+  targets: readonly NonDeletedExcalidrawElement[],
+  gridSize: NullableGridSize,
+  scene: Scene,
+) => {
+  targets.forEach((element) => snapElementToGrid(element, gridSize, scene));
+
+  const updatedElementsMap = arrayToMap(scene.getNonDeletedElements());
+  return elements.map(
+    (element) => updatedElementsMap.get(element.id) || element,
+  );
+};
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  keywords: ["grid", "align", "snap"],
+  trackEvent: { category: "element" },
+  predicate: (elements) => getNonDeletedElements(elements).length > 0,
+  perform: (elements, appState, _, app) => {
+    const selectedElements = app.scene.getSelectedElements(appState);
+    const targets =
+      selectedElements.length > 0
+        ? selectedElements
+        : getNonDeletedElements(elements).filter(
+            (element) => !isBoundToContainer(element),
+          );
+
+    const updatedElements = snapElementsToGrid(
+      elements,
+      targets,
+      appState.gridSize as NullableGridSize,
+      app.scene,
+    );
+
+    return {
+      elements: updateFrameMembershipOfSelectedElements(
+        updatedElements,
+        appState,
+        app,
+      ),
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
