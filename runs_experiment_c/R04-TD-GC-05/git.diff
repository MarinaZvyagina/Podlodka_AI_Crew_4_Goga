diff --git a/packages/element/src/snapToGrid.ts b/packages/element/src/snapToGrid.ts
new file mode 100644
index 0000000..4d04ccb
--- /dev/null
+++ b/packages/element/src/snapToGrid.ts
@@ -0,0 +1,82 @@
+import { getGridPoint } from "@excalidraw/common";
+
+import type { NullableGridSize } from "@excalidraw/excalidraw/types";
+
+import { getElementBounds } from "./bounds";
+import { resizeSingleElement } from "./resizeElements";
+import {
+  isElbowArrow,
+  isFrameLikeElement,
+  isBoundToContainer,
+} from "./typeChecks";
+
+import type { Scene } from "./Scene";
+
+import type { NonDeletedExcalidrawElement } from "./types";
+
+/**
+ * Snaps the position and size of each given element to the configured grid,
+ * independently of the other elements (no group behavior). Mirrors the
+ * rounding a user would get by manually dragging/resizing each shape with
+ * grid snapping enabled.
+ */
+export const snapElementsToGrid = (
+  elements: readonly NonDeletedExcalidrawElement[],
+  gridSize: number,
+  scene: Scene,
+): NonDeletedExcalidrawElement[] => {
+  const elementsToSnap = elements.filter(
+    (element) =>
+      !isFrameLikeElement(element) &&
+      !isBoundToContainer(element) &&
+      // both-sided bound elbow arrows derive their geometry from the
+      // elements they're bound to and are re-routed automatically once
+      // those elements move/resize
+      !(isElbowArrow(element) && element.startBinding && element.endBinding),
+  );
+
+  elementsToSnap.forEach((element) => {
+    const elementsMap = scene.getNonDeletedElementsMap();
+
+    // snap position: move the element so its (unrotated) bounding box
+    // top-left corner lands on the nearest grid line
+    const [x1, y1] = getElementBounds(element, elementsMap, true);
+    const [snappedX1, snappedY1] = getGridPoint(
+      x1,
+      y1,
+      gridSize as NullableGridSize,
+    );
+    const offsetX = snappedX1 - x1;
+    const offsetY = snappedY1 - y1;
+
+    if (offsetX !== 0 || offsetY !== 0) {
+      scene.mutateElement(element, {
+        x: element.x + offsetX,
+        y: element.y + offsetY,
+      });
+    }
+
+    // snap size: grow/shrink the element from its top-left corner so its
+    // width/height become multiples of the grid size
+    const nextWidth = Math.max(
+      gridSize,
+      Math.round(element.width / gridSize) * gridSize,
+    );
+    const nextHeight = Math.max(
+      gridSize,
+      Math.round(element.height / gridSize) * gridSize,
+    );
+
+    resizeSingleElement(
+      nextWidth,
+      nextHeight,
+      element,
+      element,
+      scene.getNonDeletedElementsMap(),
+      scene,
+      "se",
+    );
+  });
+
+  return elementsToSnap;
+};
diff --git a/packages/element/tests/snapToGrid.test.tsx b/packages/element/tests/snapToGrid.test.tsx
