+import { actionSnapToGrid } from "@excalidraw/excalidraw/actions";
+import { defaultLang, setLanguage } from "@excalidraw/excalidraw/i18n";
+import { Excalidraw } from "@excalidraw/excalidraw";
+
+import { API } from "@excalidraw/excalidraw/tests/helpers/api";
+import { Keyboard, UI } from "@excalidraw/excalidraw/tests/helpers/ui";
+import {
+  act,
+  unmountComponent,
+  render,
+} from "@excalidraw/excalidraw/tests/test-utils";
+
+describe("snapping elements to grid", () => {
+  beforeEach(async () => {
+    unmountComponent();
+
+    await act(() => {
+      return setLanguage(defaultLang);
+    });
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+
+    // gridSize defaults to 20, keep it explicit for readability
+    API.setAppState({ gridSize: 20 });
+  });
+
+  it("snaps the position and size of a selected element to the grid", () => {
+    const rectangle = API.createElement({
+      type: "rectangle",
+      x: 3,
+      y: 4,
+      width: 13,
+      height: 17,
+    });
+
+    API.setElements([rectangle]);
+    API.setSelectedElements([rectangle]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updated = API.getElement(rectangle);
+    expect(updated.x).toEqual(0);
+    expect(updated.y).toEqual(0);
+    expect(updated.width).toEqual(20);
+    expect(updated.height).toEqual(20);
+  });
+
+  it("only snaps the selected elements, leaving others untouched", () => {
+    const selected = API.createElement({
+      type: "rectangle",
+      x: 11,
+      y: 9,
+      width: 13,
+      height: 13,
+    });
+    const untouched = API.createElement({
+      type: "rectangle",
+      x: 33,
+      y: 41,
+      width: 12,
+      height: 12,
+    });
+
+    API.setElements([selected, untouched]);
+    API.setSelectedElements([selected]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(selected).x).toEqual(20);
+    expect(API.getElement(selected).y).toEqual(0);
+
+    expect(API.getElement(untouched).x).toEqual(33);
+    expect(API.getElement(untouched).y).toEqual(41);
+    expect(API.getElement(untouched).width).toEqual(12);
+    expect(API.getElement(untouched).height).toEqual(12);
+  });
+
+  it("snaps every element on the canvas when nothing is selected", () => {
+    const first = API.createElement({
+      type: "rectangle",
+      x: 3,
+      y: 4,
+      width: 13,
+      height: 17,
+    });
+    const second = API.createElement({
+      type: "ellipse",
+      x: 46,
+      y: 51,
+      width: 22,
+      height: 9,
+    });
+
+    API.setElements([first, second]);
+    expect(API.getSelectedElements().length).toEqual(0);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(first).x).toEqual(0);
+    expect(API.getElement(first).y).toEqual(0);
+
+    expect(API.getElement(second).x).toEqual(40);
+    expect(API.getElement(second).y).toEqual(60);
+    expect(API.getElement(second).width).toEqual(20);
+    expect(API.getElement(second).height).toEqual(20);
+  });
+
+  it("snaps multiple selected elements independently rather than as a group", () => {
+    const first = API.createElement({
+      type: "rectangle",
+      x: 9,
+      y: 9,
+      width: 10,
+      height: 10,
+    });
+    const second = API.createElement({
+      type: "rectangle",
+      x: 111,
+      y: 9,
+      width: 10,
+      height: 10,
+    });
+
+    API.setElements([first, second]);
+    API.setSelectedElements([first, second]);
+
+    API.executeAction(actionSnapToGrid);
+
+    // each snapped to its own nearest grid line, not to a shared offset
+    expect(API.getElement(first).x).toEqual(0);
+    expect(API.getElement(first).y).toEqual(0);
+    expect(API.getElement(second).x).toEqual(120);
+    expect(API.getElement(second).y).toEqual(0);
+  });
+
+  it("undoes the snap in a single step", () => {
+    const rectangle = UI.createElement("rectangle", {
+      x: 3,
+      y: 4,
+      width: 13,
+      height: 17,
+    });
+
+    const undoStackSizeBeforeSnap = API.getUndoStack().length;
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rectangle).x).toEqual(0);
+    expect(API.getElement(rectangle).y).toEqual(0);
+    expect(API.getElement(rectangle).width).toEqual(20);
+    expect(API.getElement(rectangle).height).toEqual(20);
+    expect(API.getUndoStack().length).toEqual(undoStackSizeBeforeSnap + 1);
+
+    Keyboard.undo();
+
+    const reverted = API.getElement(rectangle);
+    expect(reverted.x).toEqual(3);
+    expect(reverted.y).toEqual(4);
+    expect(reverted.width).toEqual(13);
+    expect(reverted.height).toEqual(17);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..4472aec
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,66 @@
+import { getNonDeletedElements } from "@excalidraw/element";
+import { snapElementsToGrid } from "@excalidraw/element";
+import { updateFrameMembershipOfSelectedElements } from "@excalidraw/element";
+import { arrayToMap } from "@excalidraw/common";
+
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import type { ExcalidrawElement } from "@excalidraw/element/types";
+
+import { gridIcon } from "../components/icons";
+
+import { isSomeElementSelected, getSelectedElements } from "../scene";
+
+import { register } from "./register";
+
+import type { AppClassProperties, AppState } from "../types";
+
+const snapToGridActionPredicate = (
+  elements: readonly ExcalidrawElement[],
+  appState: AppState,
+) => appState.gridSize > 0 && getNonDeletedElements(elements).length > 0;
+
+const snapElementsOnCanvasToGrid = (
+  elements: readonly ExcalidrawElement[],
+  appState: Readonly<AppState>,
+  app: AppClassProperties,
+) => {
+  const nonDeletedElements = getNonDeletedElements(elements);
+
+  const targetElements = isSomeElementSelected(nonDeletedElements, appState)
+    ? getSelectedElements(nonDeletedElements, appState, {
+        includeBoundTextElement: false,
+        includeElementsInFrames: true,
+      })
+    : nonDeletedElements;
+
+  const updatedElements = snapElementsToGrid(
+    targetElements,
+    appState.gridSize,
+    app.scene,
+  );
+
+  const updatedElementsMap = arrayToMap(updatedElements);
+
+  return updateFrameMembershipOfSelectedElements(
+    elements.map((element) => updatedElementsMap.get(element.id) || element),
+    appState,
+    app,
+  );
+};
+
+export const actionSnapToGrid = register({
+  name: "snapSelectedElementsToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  trackEvent: { category: "element" },
+  predicate: (elements, appState) =>
+    snapToGridActionPredicate(elements, appState as AppState),
+  perform: (elements, appState, _, app) => {
+    return {
+      appState,
+      elements: snapElementsOnCanvasToGrid(elements, appState, app),
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
