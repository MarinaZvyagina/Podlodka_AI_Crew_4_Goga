@@ -0,0 +1,92 @@
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { Keyboard, UI } from "../tests/helpers/ui";
+import { render } from "../tests/test-utils";
+
+import { actionSnapToGrid } from "./actionSnapToGrid";
+
+const { h } = window;
+
+describe("snap to grid action", () => {
+  beforeEach(async () => {
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+    API.setAppState({ gridModeEnabled: false, gridSize: 20 });
+  });
+
+  it("snaps the position and size of each selected element independently", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 12,
+      y: 8,
+      width: 47,
+      height: 53,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      x: 101,
+      y: 205,
+      width: 33,
+      height: 12,
+    });
+
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([rect1, rect2]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updatedRect1 = API.getElement(rect1);
+    expect(updatedRect1.x).toBe(20);
+    expect(updatedRect1.y).toBe(0);
+    expect(updatedRect1.width).toBe(40);
+    expect(updatedRect1.height).toBe(60);
+
+    const updatedRect2 = API.getElement(rect2);
+    expect(updatedRect2.x).toBe(100);
+    expect(updatedRect2.y).toBe(200);
+    expect(updatedRect2.width).toBe(40);
+    expect(updatedRect2.height).toBe(20);
+  });
+
+  it("applies to every element on canvas when nothing is selected", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      x: 11,
+      y: 9,
+      width: 50,
+      height: 50,
+    });
+
+    API.setElements([rect1]);
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updatedRect1 = API.getElement(rect1);
+    expect(updatedRect1.x).toBe(20);
+    expect(updatedRect1.y).toBe(0);
+  });
+
+  it("undoes the snap in a single step", () => {
+    // created via simulated pointer interaction (rather than API.setElements)
+    // so the scene has a committed history baseline to undo back to
+    const rect1 = UI.createElement("rectangle", {
+      x: 12,
+      y: 8,
+      width: 47,
+      height: 53,
+    });
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect1).x).toBe(20);
+
+    Keyboard.undo();
+
+    const revertedRect1 = h.elements.find((el) => el.id === rect1.id)!;
+    expect(revertedRect1.isDeleted).toBe(false);
+    expect(revertedRect1.x).toBe(12);
+    expect(revertedRect1.y).toBe(8);
+    expect(revertedRect1.width).toBe(47);
+    expect(revertedRect1.height).toBe(53);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..c117b79
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,137 @@
+import { getGridPoint } from "@excalidraw/common";
+
+import {
+  CaptureUpdateAction,
+  getBoundTextElement,
+  getNonDeletedElements,
+  isBoundToContainer,
+  isFrameLikeElement,
+  resizeSingleElement,
+  updateBoundElements,
+} from "@excalidraw/element";
+
+import type { Scene } from "@excalidraw/element";
+import type {
+  ExcalidrawElement,
+  NonDeletedExcalidrawElement,
+} from "@excalidraw/element/types";
+
+import { gridIcon } from "../components/icons";
+
+import { register } from "./register";
+
+import type { NullableGridSize } from "../types";
+
+// snaps a single element's position & size to the grid, independently of
+// any other element, mirroring the result of manually dragging/resizing it
+// with grid snapping turned on
+const snapElementToGrid = (
+  element: NonDeletedExcalidrawElement,
+  elementsBeingSnapped: readonly NonDeletedExcalidrawElement[],
+  scene: Scene,
+  gridSize: number,
+) => {
+  const nextWidth = Math.max(
+    gridSize,
+    Math.round(element.width / gridSize) * gridSize,
+  );
+  const nextHeight = Math.max(
+    gridSize,
+    Math.round(element.height / gridSize) * gridSize,
+  );
+
+  if (nextWidth !== element.width || nextHeight !== element.height) {
+    // "se" keeps the top-left corner (x, y) as the resize anchor, so this
+    // only affects width/height, leaving the position snap below to handle x/y
+    resizeSingleElement(
+      nextWidth,
+      nextHeight,
+      element,
+      element,
+      scene.getNonDeletedElementsMap(),
+      scene,
+      "se",
+    );
+  }
+
+  const elementsMap = scene.getNonDeletedElementsMap();
+  const latestElement = elementsMap.get(element.id);
+  if (!latestElement) {
+    return;
+  }
+
+  const [nextX, nextY] = getGridPoint(
+    latestElement.x,
+    latestElement.y,
+    gridSize as NullableGridSize,
+  );
+  const deltaX = nextX - latestElement.x;
+  const deltaY = nextY - latestElement.y;
+
+  if (deltaX === 0 && deltaY === 0) {
+    return;
+  }
+
+  scene.mutateElement(latestElement, { x: nextX, y: nextY });
+
+  // bound text doesn't move on its own when the container is translated,
+  // so it has to be carried along explicitly (see dragSelectedElements)
+  const boundTextElement = getBoundTextElement(latestElement, elementsMap);
+  if (boundTextElement) {
+    scene.mutateElement(boundTextElement, {
+      x: boundTextElement.x + deltaX,
+      y: boundTextElement.y + deltaY,
+    });
+  }
+
+  updateBoundElements(latestElement, scene, {
+    simultaneouslyUpdated: elementsBeingSnapped,
+  });
+};
+
+const snapElementsToGrid = (
+  elements: readonly ExcalidrawElement[],
+  elementsToSnap: readonly NonDeletedExcalidrawElement[],
+  scene: Scene,
+  gridSize: number,
+): readonly ExcalidrawElement[] => {
+  // frames aren't really "shapes" and resizing them requires reconciling
+  // frame membership, so they're left untouched by this action
+  const snappableElements = elementsToSnap.filter(
+    (element) => !isBoundToContainer(element) && !isFrameLikeElement(element),
+  );
+
+  snappableElements.forEach((element) =>
+    snapElementToGrid(element, snappableElements, scene, gridSize),
+  );
+
+  const elementsMap = scene.getNonDeletedElementsMap();
+
+  return elements.map((element) => elementsMap.get(element.id) ?? element);
+};
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  keywords: ["grid", "align", "snap"],
+  trackEvent: { category: "element" },
+  predicate: (elements) => getNonDeletedElements(elements).length > 0,
+  perform: (elements, appState, _, app) => {
+    const selectedElements = app.scene.getSelectedElements(appState);
+    const elementsToSnap = selectedElements.length
+      ? selectedElements
+      : getNonDeletedElements(elements);
+
+    return {
+      appState,
+      elements: snapElementsToGrid(
+        elements,
+        elementsToSnap,
+        app.scene,
+        appState.gridSize,
+      ),
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
