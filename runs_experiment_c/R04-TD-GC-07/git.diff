@@ -0,0 +1,96 @@
+import { updateBoundElements } from "./binding";
+import { handleBindTextResize } from "./textElement";
+import { rescalePointsInElement } from "./resizeElements";
+import {
+  isBindingElement,
+  isBoundToContainer,
+  isFreeDrawElement,
+  isLinearElement,
+  isTextElement,
+} from "./typeChecks";
+
+import type { ElementUpdate } from "./mutateElement";
+import type { Scene } from "./Scene";
+import type { NonDeletedExcalidrawElement } from "./types";
+
+// snaps a [start, start + size] span to the grid independently at both ends,
+// so both edges of the element land on a grid line (matches what you'd get
+// nudging each edge individually while grid snapping is on)
+const snapSpanToGrid = (start: number, size: number, gridSize: number) => {
+  const snappedStart = Math.round(start / gridSize) * gridSize;
+  const snappedEnd = Math.round((start + size) / gridSize) * gridSize;
+  return {
+    start: snappedStart,
+    // never collapse an element into nothing when it's smaller than one
+    // grid cell
+    size: snappedEnd - snappedStart || gridSize,
+  };
+};
+
+const snapElementToGrid = (
+  element: NonDeletedExcalidrawElement,
+  scene: Scene,
+  gridSize: number,
+) => {
+  // repositioned/resized together with its container, below
+  if (isBoundToContainer(element)) {
+    return;
+  }
+
+  // bound arrows are kept in place by the shapes they're attached to;
+  // re-snapping their own coordinates would detach or misalign them
+  // (the same way manually resizing a bound arrow's handle unbinds it).
+  // They're repositioned automatically via updateBoundElements() once the
+  // shape(s) they're bound to are snapped below.
+  if (
+    isBindingElement(element) &&
+    (element.startBinding || element.endBinding)
+  ) {
+    return;
+  }
+
+  const { start: x, size: width } = snapSpanToGrid(
+    element.x,
+    element.width,
+    gridSize,
+  );
+  const { start: y, size: height } = snapSpanToGrid(
+    element.y,
+    element.height,
+    gridSize,
+  );
+
+  if (isTextElement(element)) {
+    // text dimensions are derived from font metrics/content, not free-form
+    scene.mutateElement(element, { x, y });
+    return;
+  }
+
+  const update: ElementUpdate<NonDeletedExcalidrawElement> = {
+    x,
+    y,
+    width,
+    height,
+  };
+
+  if (isLinearElement(element) || isFreeDrawElement(element)) {
+    Object.assign(update, rescalePointsInElement(element, width, height, true));
+  }
+
+  scene.mutateElement(element, update);
+
+  handleBindTextResize(element, scene, "se");
+  updateBoundElements(element, scene);
+};
+
+/**
+ * Snaps the position and size of each element to the drawing's grid,
+ * independently of the others (no group-relative offsets are preserved).
+ */
+export const snapElementsToGrid = (
+  elements: readonly NonDeletedExcalidrawElement[],
+  gridSize: number,
+  scene: Scene,
+) => {
+  elements.forEach((element) => snapElementToGrid(element, scene, gridSize));
+};
diff --git a/packages/excalidraw/actions/actionSnapToGrid.test.tsx b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
new file mode 100644
index 0000000..1fdd177
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
@@ -0,0 +1,172 @@
+import { pointFrom } from "@excalidraw/math";
+
+import { isArrowElement } from "@excalidraw/element";
+
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { Keyboard } from "../tests/helpers/ui";
+import { render, waitFor } from "../tests/test-utils";
+
+import { actionSnapToGrid } from "./actionSnapToGrid";
+
+const { h } = window;
+
+describe("snap to grid", () => {
+  it("snaps position and size of the selected element to the nearest grid lines", async () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      id: "rect",
+      x: 11,
+      y: 12,
+      width: 47,
+      height: 53,
+    });
+    await render(<Excalidraw initialData={{ elements: [rect] }} />);
+
+    API.setSelectedElements([rect]);
+    API.executeAction(actionSnapToGrid);
+
+    const updated = h.elements.find((el) => el.id === "rect")!;
+    expect(updated.x % 20).toBe(0);
+    expect(updated.y % 20).toBe(0);
+    expect((updated.x + updated.width) % 20).toBe(0);
+    expect((updated.y + updated.height) % 20).toBe(0);
+  });
+
+  it("snaps every element independently, not as a single group", async () => {
+    const rectA = API.createElement({
+      type: "rectangle",
+      id: "rectA",
+      x: 11,
+      y: 12,
+      width: 47,
+      height: 53,
+    });
+    const rectB = API.createElement({
+      type: "rectangle",
+      id: "rectB",
+      x: 111,
+      y: 132,
+      width: 27,
+      height: 33,
+    });
+    await render(<Excalidraw initialData={{ elements: [rectA, rectB] }} />);
+
+    API.setSelectedElements([rectA, rectB]);
+    API.executeAction(actionSnapToGrid);
+
+    const a = h.elements.find((el) => el.id === "rectA")!;
+    const b = h.elements.find((el) => el.id === "rectB")!;
+
+    for (const el of [a, b]) {
+      expect(el.x % 20).toBe(0);
+      expect(el.y % 20).toBe(0);
+      expect((el.x + el.width) % 20).toBe(0);
+      expect((el.y + el.height) % 20).toBe(0);
+    }
+  });
+
+  it("snaps every element on the canvas when nothing is selected", async () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      id: "rect",
+      x: 11,
+      y: 12,
+      width: 47,
+      height: 53,
+    });
+    await render(<Excalidraw initialData={{ elements: [rect] }} />);
+
+    API.setSelectedElements([]);
+    API.executeAction(actionSnapToGrid);
+
+    const updated = h.elements.find((el) => el.id === "rect")!;
+    expect(updated.x % 20).toBe(0);
+    expect(updated.y % 20).toBe(0);
+  });
+
+  it("does not detach a bound arrow's own endpoints from its shapes", async () => {
+    const rec1 = API.createElement({
+      type: "rectangle",
+      id: "rec1",
+      x: 11,
+      y: 12,
+      width: 100,
+      height: 100,
+      boundElements: [{ id: "arr", type: "arrow" }],
+    });
+    const rec2 = API.createElement({
+      type: "rectangle",
+      id: "rec2",
+      x: 231,
+      y: 262,
+      width: 100,
+      height: 100,
+      boundElements: [{ id: "arr", type: "arrow" }],
+    });
+    const arrow = API.createElement({
+      type: "arrow",
+      id: "arr",
+      x: 111,
+      y: 62,
+      width: 120,
+      height: 200,
+      startBinding: {
+        elementId: "rec1",
+        fixedPoint: [0.5, 0],
+        mode: "orbit",
+      },
+      endBinding: {
+        elementId: "rec2",
+        fixedPoint: [0, 0.5],
+        mode: "orbit",
+      },
+      points: [pointFrom(0, 0), pointFrom(120, 200)],
+    });
+
+    await render(
+      <Excalidraw initialData={{ elements: [rec1, rec2, arrow] }} />,
+    );
+
+    API.setSelectedElements([rec1, rec2, arrow]);
+    API.executeAction(actionSnapToGrid);
+
+    const updatedArrow = h.elements.find((el) => el.id === "arr")!;
+    expect(isArrowElement(updatedArrow)).toBe(true);
+    expect(
+      isArrowElement(updatedArrow) && updatedArrow.startBinding?.elementId,
+    ).toBe("rec1");
+    expect(
+      isArrowElement(updatedArrow) && updatedArrow.endBinding?.elementId,
+    ).toBe("rec2");
+  });
+
+  it("is undoable in a single step", async () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      id: "rect",
+      x: 11,
+      y: 12,
+      width: 47,
+      height: 53,
+    });
+    await render(
+      <Excalidraw initialData={{ elements: [rect] }} handleKeyboardGlobally />,
+    );
+    await waitFor(() => expect(h.history.isUndoStackEmpty).toBeTruthy());
+
+    API.setSelectedElements([rect]);
+    API.executeAction(actionSnapToGrid);
+
+    const snapped = h.elements.find((el) => el.id === "rect")!;
+    expect(snapped.x).not.toBe(11);
+
+    Keyboard.undo();
+
+    const undone = h.elements.find((el) => el.id === "rect")!;
+    expect(undone.x).toBe(11);
+    expect(undone.y).toBe(12);
+    expect(undone.width).toBe(47);
+    expect(undone.height).toBe(53);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..b896007
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,41 @@
+import {
+  CaptureUpdateAction,
+  getNonDeletedElements,
+  snapElementsToGrid,
+  updateFrameMembershipOfSelectedElements,
+} from "@excalidraw/element";
+
+import { gridIcon } from "../components/icons";
+
+import { register } from "./register";
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  keywords: ["snap", "grid", "align"],
+  trackEvent: { category: "element" },
+  predicate: (elements) => getNonDeletedElements(elements).length > 0,
+  perform: (elements, appState, _, app) => {
+    const selectedElements = app.scene.getSelectedElements({
+      selectedElementIds: appState.selectedElementIds,
+      includeElementsInFrames: true,
+    });
+
+    const targetElements = selectedElements.length
+      ? selectedElements
+      : getNonDeletedElements(elements).filter((element) => !element.locked);
+
+    snapElementsToGrid(targetElements, appState.gridSize, app.scene);
+
+    return {
+      elements: updateFrameMembershipOfSelectedElements(
+        elements,
+        appState,
+        app,
+      ),
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
