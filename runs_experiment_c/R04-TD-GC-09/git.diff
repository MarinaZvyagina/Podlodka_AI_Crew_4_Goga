diff --git a/packages/element/src/snapToGrid.ts b/packages/element/src/snapToGrid.ts
new file mode 100644
index 0000000..9da0deb
--- /dev/null
+++ b/packages/element/src/snapToGrid.ts
@@ -0,0 +1,78 @@
+import { getGridPoint, MIN_WIDTH_OR_HEIGHT } from "@excalidraw/common";
+
+import type { AppState, NullableGridSize } from "@excalidraw/excalidraw/types";
+
+import { bindOrUnbindBindingElements, updateBoundElements } from "./binding";
+import { rescalePointsInElement } from "./resizeElements";
+import { getBoundTextElement, redrawTextBoundingBox } from "./textElement";
+import {
+  isArrowElement,
+  isBoundToContainer,
+  isFrameLikeElement,
+  isFreeDrawElement,
+  isLinearElement,
+} from "./typeChecks";
+
+import type { Scene } from "./Scene";
+import type { NonDeletedExcalidrawElement } from "./types";
+
+/**
+ * Snaps each element's position and size independently to the nearest grid
+ * line, as if the element had been nudged by hand with grid snapping on.
+ * Bound text follows its container instead of being snapped on its own, and
+ * frames are left untouched (their geometry is governed by their children).
+ */
+export const snapElementsToGrid = (
+  elements: readonly NonDeletedExcalidrawElement[],
+  scene: Scene,
+  appState: Readonly<AppState>,
+  gridSize: NullableGridSize,
+): NonDeletedExcalidrawElement[] => {
+  if (!gridSize) {
+    return [];
+  }
+
+  const targets = elements.filter(
+    (element) => !isBoundToContainer(element) && !isFrameLikeElement(element),
+  );
+
+  const updatedElements = targets.map((element) => {
+    const [x, y] = getGridPoint(element.x, element.y, gridSize);
+    const [x2, y2] = getGridPoint(
+      element.x + element.width,
+      element.y + element.height,
+      gridSize,
+    );
+    const width = Math.max(MIN_WIDTH_OR_HEIGHT, x2 - x);
+    const height = Math.max(MIN_WIDTH_OR_HEIGHT, y2 - y);
+
+    const sizeUpdate =
+      isLinearElement(element) || isFreeDrawElement(element)
+        ? rescalePointsInElement(element, width, height, true)
+        : { width, height };
+
+    return scene.mutateElement(element, { x, y, ...sizeUpdate });
+  });
+
+  updatedElements.forEach((element) => {
+    updateBoundElements(element, scene, {
+      simultaneouslyUpdated: updatedElements,
+    });
+
+    const boundText = getBoundTextElement(
+      element,
+      scene.getNonDeletedElementsMap(),
+    );
+    if (boundText) {
+      redrawTextBoundingBox(boundText, element, scene);
+    }
+  });
+
+  bindOrUnbindBindingElements(
+    updatedElements.filter(isArrowElement),
+    scene,
+    appState,
+  );
+
+  return updatedElements;
+};
diff --git a/packages/excalidraw/actions/actionSnapToGrid.test.tsx b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
new file mode 100644
index 0000000..3d53d7a
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.test.tsx
@@ -0,0 +1,142 @@
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { Keyboard } from "../tests/helpers/ui";
+import { render } from "../tests/test-utils";
+
+import { actionSnapToGrid } from "./actionSnapToGrid";
+
+const { h } = window;
+
+describe("snap to grid", () => {
+  beforeEach(async () => {
+    await render(<Excalidraw handleKeyboardGlobally={true} />);
+    API.setAppState({ gridModeEnabled: true, gridSize: 10 });
+  });
+
+  it("snaps position and size of selected elements to the grid, independently", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      id: "rect1",
+      x: 13,
+      y: 7,
+      width: 24,
+      height: 11,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      id: "rect2",
+      x: 101,
+      y: 52,
+      width: 9,
+      height: 9,
+    });
+
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([rect1]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updatedRect1 = API.getElement(rect1);
+    expect(updatedRect1.x).toBe(10);
+    expect(updatedRect1.y).toBe(10);
+    expect(updatedRect1.width).toBe(30);
+    expect(updatedRect1.height).toBe(10);
+
+    // unselected element is left untouched
+    const untouchedRect2 = API.getElement(rect2);
+    expect(untouchedRect2.x).toBe(101);
+    expect(untouchedRect2.y).toBe(52);
+  });
+
+  it("snaps every shape on the canvas independently when nothing is selected", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      id: "rect1",
+      x: 13,
+      y: 7,
+      width: 24,
+      height: 11,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      id: "rect2",
+      x: 101,
+      y: 52,
+      width: 9,
+      height: 9,
+    });
+
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updatedRect1 = API.getElement(rect1);
+    expect(updatedRect1.x).toBe(10);
+    expect(updatedRect1.y).toBe(10);
+    expect(updatedRect1.width).toBe(30);
+    expect(updatedRect1.height).toBe(10);
+
+    const updatedRect2 = API.getElement(rect2);
+    expect(updatedRect2.x).toBe(100);
+    expect(updatedRect2.y).toBe(50);
+    expect(updatedRect2.width).toBe(10);
+    expect(updatedRect2.height).toBe(10);
+  });
+
+  it("undoes the snap in a single step", () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      id: "rect",
+      x: 13,
+      y: 7,
+      width: 24,
+      height: 11,
+    });
+
+    // capture the pre-snap state as its own undo entry, establishing
+    // the store baseline the snap action's undo will revert to
+    API.updateScene({
+      elements: [rect],
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    });
+    API.setSelectedElements([rect]);
+
+    expect(API.getUndoStack().length).toBe(1);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(rect).x).toBe(10);
+    expect(API.getElement(rect).y).toBe(10);
+    expect(API.getUndoStack().length).toBe(2);
+
+    Keyboard.undo();
+
+    const restored = API.getElement(rect);
+    expect(restored.x).toBe(13);
+    expect(restored.y).toBe(7);
+    expect(restored.width).toBe(24);
+    expect(restored.height).toBe(11);
+    expect(API.getUndoStack().length).toBe(1);
+  });
+
+  it("is a no-op when grid mode is disabled", () => {
+    API.setAppState({ gridModeEnabled: false });
+
+    const rect = API.createElement({
+      type: "rectangle",
+      id: "rect",
+      x: 13,
+      y: 7,
+      width: 24,
+      height: 11,
+    });
+
+    API.setElements([rect]);
+    API.setSelectedElements([rect]);
+
+    expect(h.app.actionManager.isActionEnabled(actionSnapToGrid)).toBe(false);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..7cf30f6
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,43 @@
+import { arrayToMap } from "@excalidraw/common";
+
+import { CaptureUpdateAction, snapElementsToGrid } from "@excalidraw/element";
+
+import { gridIcon } from "../components/icons";
+
+import { isGridModeEnabled } from "../snapping";
+
+import { register } from "./register";
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  keywords: ["snap", "grid", "align"],
+  trackEvent: { category: "element" },
+  predicate: (elements, appState, appProps, app) =>
+    isGridModeEnabled(app) && app.scene.getNonDeletedElements().length > 0,
+  perform: (elements, appState, _, app) => {
+    const selectedElements = app.scene.getSelectedElements(appState);
+    const targetElements =
+      selectedElements.length > 0
+        ? selectedElements
+        : app.scene.getNonDeletedElements();
+
+    const updatedElements = snapElementsToGrid(
+      targetElements,
+      app.scene,
+      appState,
+      app.getEffectiveGridSize(),
+    );
+
+    const updatedElementsMap = arrayToMap(updatedElements);
+
+    return {
+      appState,
+      elements: elements.map(
+        (element) => updatedElementsMap.get(element.id) || element,
+      ),
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
