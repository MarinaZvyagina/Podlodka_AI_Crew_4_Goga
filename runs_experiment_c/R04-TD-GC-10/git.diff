@@ -0,0 +1,208 @@
+import React from "react";
+
+import { Excalidraw } from "../index";
+import { API } from "../tests/helpers/api";
+import { render } from "../tests/test-utils";
+
+import { createUndoAction } from "./actionHistory";
+import { actionSnapToGrid } from "./actionSnapToGrid";
+
+const { h } = window;
+
+describe("snap to grid", () => {
+  beforeEach(async () => {
+    await render(<Excalidraw />);
+  });
+
+  it("snaps position and size of selected elements independently to the configured grid", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      id: "rect1",
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 48,
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      id: "rect2",
+      x: 101,
+      y: 8,
+      width: 37,
+      height: 62,
+    });
+
+    // captured before the action runs: scene mutations happen in place, so
+    // `rect1`/`rect2` themselves reflect post-snap values afterwards
+    const original = { x1: rect1.x, x2: rect2.x };
+
+    API.setElements([rect1, rect2]);
+    API.setSelectedElements([rect1, rect2]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const gridSize = h.state.gridSize;
+
+    const r1 = API.getElement(rect1);
+    expect(r1.x % gridSize).toBe(0);
+    expect(r1.y % gridSize).toBe(0);
+    expect((r1.x + r1.width) % gridSize).toBe(0);
+    expect((r1.y + r1.height) % gridSize).toBe(0);
+
+    const r2 = API.getElement(rect2);
+    expect(r2.x % gridSize).toBe(0);
+    expect(r2.y % gridSize).toBe(0);
+    expect((r2.x + r2.width) % gridSize).toBe(0);
+    expect((r2.y + r2.height) % gridSize).toBe(0);
+
+    // the two rectangles started at a different offset from the grid, so an
+    // independent snap must not move them by the same amount (as a group
+    // move would)
+    expect(r1.x - original.x1).not.toBe(r2.x - original.x2);
+  });
+
+  it("applies to every non-locked element when nothing is selected", () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      id: "rect",
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 48,
+    });
+    const locked = API.createElement({
+      type: "rectangle",
+      id: "locked",
+      x: 13,
+      y: 29,
+      width: 53,
+      height: 48,
+      locked: true,
+    });
+
+    API.setElements([rect, locked]);
+    API.setSelectedElements([]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const gridSize = h.state.gridSize;
+
+    const r = API.getElement(rect);
+    expect(r.x % gridSize).toBe(0);
+    expect(r.y % gridSize).toBe(0);
+
+    const l = API.getElement(locked);
+    expect(l.x).toBe(locked.x);
+    expect(l.y).toBe(locked.y);
+  });
+
+  it("keeps a bound arrow attached when it snaps together with both bound shapes", () => {
+    const rect1 = API.createElement({
+      type: "rectangle",
+      id: "rect1",
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 48,
+      boundElements: [{ type: "arrow", id: "arrow1" }],
+    });
+    const rect2 = API.createElement({
+      type: "rectangle",
+      id: "rect2",
+      x: 201,
+      y: 19,
+      width: 42,
+      height: 39,
+      boundElements: [{ type: "arrow", id: "arrow1" }],
+    });
+    const arrow = API.createElement({
+      type: "arrow",
+      id: "arrow1",
+      x: 65,
+      y: 51,
+      width: 136,
+      height: 3,
+      startBinding: {
+        elementId: rect1.id,
+        fixedPoint: [1, 0.5],
+        mode: "orbit",
+      },
+      endBinding: {
+        elementId: rect2.id,
+        fixedPoint: [0, 0.5],
+        mode: "orbit",
+      },
+    });
+
+    API.setElements([rect1, rect2, arrow]);
+    API.setSelectedElements([rect1, rect2, arrow]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const updatedArrow = API.getElement(arrow);
+    expect(updatedArrow.startBinding?.elementId).toBe(rect1.id);
+    expect(updatedArrow.endBinding?.elementId).toBe(rect2.id);
+  });
+
+  it("unbinds an arrow that is snapped independently of its bound shape", () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      id: "rect",
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 48,
+      boundElements: [{ type: "arrow", id: "arrow1" }],
+    });
+    const arrow = API.createElement({
+      type: "arrow",
+      id: "arrow1",
+      x: 65,
+      y: 51,
+      width: 100,
+      height: 3,
+      startBinding: {
+        elementId: rect.id,
+        fixedPoint: [1, 0.5],
+        mode: "orbit",
+      },
+    });
+
+    API.setElements([rect, arrow]);
+    API.setSelectedElements([arrow]);
+
+    API.executeAction(actionSnapToGrid);
+
+    expect(API.getElement(arrow).startBinding).toBe(null);
+  });
+
+  it("undoes the snap in a single step", async () => {
+    const rect = API.createElement({
+      type: "rectangle",
+      id: "rect",
+      x: 12,
+      y: 27,
+      width: 53,
+      height: 48,
+    });
+
+    await render(<Excalidraw initialData={{ elements: [rect] }} />);
+
+    API.setSelectedElements([API.getElement(rect)]);
+
+    API.executeAction(actionSnapToGrid);
+
+    const snapped = API.getElement(rect);
+    expect(snapped.x).not.toBe(12);
+    expect(API.getUndoStack().length).toBe(1);
+
+    const undoAction = createUndoAction(h.history);
+    API.executeAction(undoAction);
+
+    const reverted = API.getElement(rect);
+    expect(reverted.x).toBe(12);
+    expect(reverted.y).toBe(27);
+    expect(reverted.width).toBe(53);
+    expect(reverted.height).toBe(48);
+  });
+});
diff --git a/packages/excalidraw/actions/actionSnapToGrid.ts b/packages/excalidraw/actions/actionSnapToGrid.ts
new file mode 100644
index 0000000..a010951
--- /dev/null
+++ b/packages/excalidraw/actions/actionSnapToGrid.ts
@@ -0,0 +1,159 @@
+import { getFontString, getGridPoint } from "@excalidraw/common";
+
+import {
+  CaptureUpdateAction,
+  getApproxMinLineHeight,
+  getApproxMinLineWidth,
+  getBoundTextElement,
+  getNonDeletedElements,
+  handleBindTextResize,
+  isArrowElement,
+  isBoundToContainer,
+  isFreeDrawElement,
+  isLinearElement,
+  isTextElement,
+  unbindBindingElement,
+  updateBoundElements,
+} from "@excalidraw/element";
+
+import type { Scene } from "@excalidraw/element";
+import type { NonDeletedExcalidrawElement } from "@excalidraw/element/types";
+
+import { gridIcon } from "../components/icons";
+
+import { register } from "./register";
+
+import type { NullableGridSize } from "../types";
+
+const snapElementsToGrid = (
+  targetElements: readonly NonDeletedExcalidrawElement[],
+  scene: Scene,
+  gridSize: NullableGridSize,
+) => {
+  if (!gridSize) {
+    return;
+  }
+
+  const elementsMap = scene.getNonDeletedElementsMap();
+  const targetElementIds = new Set(targetElements.map((element) => element.id));
+  // elements whose x/y/width/height we actually change directly; arrows bound
+  // on both ends to elements in this set are re-routed via updateBoundElements
+  // below instead, so they must stay out of it
+  const movedElements: NonDeletedExcalidrawElement[] = [];
+
+  targetElements.forEach((element) => {
+    if (isBoundToContainer(element)) {
+      // repositioned together with its container below
+      return;
+    }
+
+    if (isArrowElement(element)) {
+      const startBoundToMovingPartner =
+        !!element.startBinding &&
+        targetElementIds.has(element.startBinding.elementId);
+      const endBoundToMovingPartner =
+        !!element.endBinding &&
+        targetElementIds.has(element.endBinding.elementId);
+
+      if (startBoundToMovingPartner || endBoundToMovingPartner) {
+        // its shape is derived entirely from the bound element(s), which are
+        // snapped independently below and will re-route it via their own
+        // updateBoundElements call
+        return;
+      }
+
+      // moving this arrow on its own no longer matches whatever it used to
+      // be bound to, same as an unbound manual drag
+      if (element.startBinding) {
+        unbindBindingElement(element, "start", scene);
+      }
+      if (element.endBinding) {
+        unbindBindingElement(element, "end", scene);
+      }
+    }
+
+    const [x, y] = getGridPoint(element.x, element.y, gridSize);
+
+    if (
+      isLinearElement(element) ||
+      isFreeDrawElement(element) ||
+      isTextElement(element)
+    ) {
+      // rescaling points/font to fit a snapped width/height would distort
+      // the shape or its content, so only the position is snapped here,
+      // same as a plain drag
+      scene.mutateElement(element, { x, y });
+      movedElements.push(element);
+      return;
+    }
+
+    const [x2, y2] = getGridPoint(
+      element.x + element.width,
+      element.y + element.height,
+      gridSize,
+    );
+
+    let width = Math.max(x2 - x, gridSize);
+    let height = Math.max(y2 - y, gridSize);
+
+    const boundTextElement = getBoundTextElement(element, elementsMap);
+    if (boundTextElement) {
+      width = Math.max(
+        width,
+        getApproxMinLineWidth(
+          getFontString(boundTextElement),
+          boundTextElement.lineHeight,
+        ),
+      );
+      height = Math.max(
+        height,
+        getApproxMinLineHeight(
+          boundTextElement.fontSize,
+          boundTextElement.lineHeight,
+        ),
+      );
+    }
+
+    scene.mutateElement(element, { x, y, width, height });
+    movedElements.push(element);
+
+    if (boundTextElement) {
+      handleBindTextResize(element, scene, "se");
+    }
+  });
+
+  movedElements.forEach((element) => {
+    updateBoundElements(element, scene, {
+      simultaneouslyUpdated: movedElements,
+    });
+  });
+};
+
+export const actionSnapToGrid = register({
+  name: "snapToGrid",
+  label: "labels.snapToGrid",
+  icon: gridIcon,
+  trackEvent: { category: "element" },
+  predicate: (elements) => getNonDeletedElements(elements).length > 0,
+  perform: (elements, appState, _, app) => {
+    const selectedElements = app.scene.getSelectedElements(appState);
+    const targetElements: readonly NonDeletedExcalidrawElement[] =
+      selectedElements.length
+        ? selectedElements
+        : app.scene
+            .getNonDeletedElements()
+            .filter((element) => !element.locked);
+
+    snapElementsToGrid(
+      targetElements,
+      app.scene,
+      appState.gridSize as NullableGridSize,
+    );
+
+    return {
+      elements,
+      appState,
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
