+func TestGetTargetsStatusByJobExcludedTargets(t *testing.T) {
+	const jobName = "TestGetTargetsStatusByJobExcludedTargets-job"
+
+	tsm := newTargetStatusMap()
+	for i := 0; i < 2; i++ {
+		sw := &scrapeWork{
+			Config: &ScrapeWork{
+				jobNameOriginal:  jobName,
+				MaxScrapeTargets: 2,
+				ScrapeURL:        fmt.Sprintf("http://host%d:80/metrics", i),
+				OriginalLabels: newCompressedLabels(promutil.NewLabelsFromMap(map[string]string{
+					"__address__": fmt.Sprintf("host%d:80", i),
+				})),
+			},
+		}
+		if !tsm.Register(sw) {
+			t.Fatalf("target %d must be registered because it is under the limit", i)
+		}
+	}
+
+	// Simulate the targets excluded because of the max_scrape_targets limit, like scraper.go does
+	// when targetStatusMap.Register() returns false.
+	var excludedHashKeys []uint64
+	for i := 2; i < 5; i++ {
+		originalLabels := newCompressedLabels(promutil.NewLabelsFromMap(map[string]string{
+			"__address__": fmt.Sprintf("host%d:80", i),
+			"job":         jobName,
+		}))
+		excludedHashKeys = append(excludedHashKeys, originalLabels.getHashKey())
+		droppedTargetsMap.Register(originalLabels, nil, targetDropReasonMaxScrapeTargets, nil)
+	}
+	t.Cleanup(func() {
+		droppedTargetsMap.mu.Lock()
+		for _, k := range excludedHashKeys {
+			delete(droppedTargetsMap.m, k)
+		}
+		droppedTargetsMap.mu.Unlock()
+	})
+
+	tsr := tsm.getTargetsStatusByJob(&requestFilter{originalJobName: jobName})
+	if len(tsr.jobTargetsStatuses) != 1 {
+		t.Fatalf("unexpected number of jobs; got %d; want 1", len(tsr.jobTargetsStatuses))
+	}
+	jts := tsr.jobTargetsStatuses[0]
+	if jts.targetsTotal != 2 {
+		t.Fatalf("unexpected targetsTotal; got %d; want 2", jts.targetsTotal)
+	}
+	if jts.excludedTargetsCount != 3 {
+		t.Fatalf("unexpected excludedTargetsCount; got %d; want 3", jts.excludedTargetsCount)
+	}
+}
