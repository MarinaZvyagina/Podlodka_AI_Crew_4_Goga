+func TestTargetStatusMapRegisterMaxScrapeTargets(t *testing.T) {
+	newSW := func(jobName, address string, maxScrapeTargets int) *scrapeWork {
+		return &scrapeWork{
+			Config: &ScrapeWork{
+				jobNameOriginal:  jobName,
+				MaxScrapeTargets: maxScrapeTargets,
+				OriginalLabels: newCompressedLabels(promutil.NewLabelsFromMap(map[string]string{
+					"__address__": address,
+				})),
+			},
+		}
+	}
+	registeredCount := func(tsm *targetStatusMap, jobName string) int {
+		return tsm.upByJob[jobName] + tsm.downByJob[jobName]
+	}
+
+	// The default behavior (MaxScrapeTargets=0) must be unlimited - all discovered targets are registered.
+	tsm := newTargetStatusMap()
+	for i := 0; i < 10; i++ {
+		sw := newSW("unlimited-job", fmt.Sprintf("host%d:80", i), 0)
+		if !tsm.Register(sw) {
+			t.Fatalf("target %d must be registered because there is no configured limit", i)
+		}
+	}
+	if got := registeredCount(tsm, "unlimited-job"); got != 10 {
+		t.Fatalf("unexpected number of registered targets for unlimited-job; got %d; want 10", got)
+	}
+
+	// A job with a target count under the configured limit must be unaffected.
+	tsm = newTargetStatusMap()
+	for i := 0; i < 3; i++ {
+		sw := newSW("under-limit-job", fmt.Sprintf("host%d:80", i), 5)
+		if !tsm.Register(sw) {
+			t.Fatalf("target %d must be registered because it is under the limit", i)
+		}
+	}
+	if got := registeredCount(tsm, "under-limit-job"); got != 3 {
+		t.Fatalf("unexpected number of registered targets for under-limit-job; got %d; want 3", got)
+	}
+
+	// A job with a target count over the configured limit must be truncated to the limit,
+	// and the excess targets must be rejected instead of crashing or being silently scraped.
+	tsm = newTargetStatusMap()
+	var registered, rejected int
+	for i := 0; i < 10; i++ {
+		sw := newSW("over-limit-job", fmt.Sprintf("host%d:80", i), 4)
+		if tsm.Register(sw) {
+			registered++
+		} else {
+			rejected++
+		}
+	}
+	if registered != 4 {
+		t.Fatalf("unexpected number of registered targets for over-limit-job; got %d; want 4", registered)
+	}
+	if rejected != 6 {
+		t.Fatalf("unexpected number of rejected targets for over-limit-job; got %d; want 6", rejected)
+	}
+	if got := registeredCount(tsm, "over-limit-job"); got != 4 {
+		t.Fatalf("unexpected number of registered targets in targetStatusMap for over-limit-job; got %d; want 4", got)
+	}
+}
