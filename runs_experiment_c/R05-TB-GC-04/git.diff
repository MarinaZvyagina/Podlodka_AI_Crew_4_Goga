@@ -445,6 +451,62 @@ func (sg *scraperGroup) update(sws []*ScrapeWork) {
 	}
 }
 
+// dropScrapeWorksExceedingJobLimits returns a subset of sws, which doesn't exceed
+// -promscrape.maxScrapeTargetsPerJob (or the job-specific max_scrape_targets override)
+// for any of the job_name values seen in sws.
+//
+// The limit is applied uniformly regardless of which service discovery mechanism produced
+// the target, since it is enforced against tsmGlobal, which is shared by all the scraperGroups.
+// Targets dropped because of the limit are registered in droppedTargetsMap, so they become
+// visible at /service-discovery and /api/v1/targets, same as targets dropped by relabeling.
+func dropScrapeWorksExceedingJobLimits(sws []*ScrapeWork) []*ScrapeWork {
+	swsByJob := make(map[string][]*ScrapeWork)
+	for _, sw := range sws {
+		if sw.maxScrapeTargets > 0 {
+			swsByJob[sw.jobNameOriginal] = append(swsByJob[sw.jobNameOriginal], sw)
+		}
+	}
+	if len(swsByJob) == 0 {
+		// Fast path - no limits are configured for the given sws.
+		return sws
+	}
+
+	excluded := make(map[*ScrapeWork]struct{})
+	for jobName, jobSws := range swsByJob {
+		maxScrapeTargets := jobSws[0].maxScrapeTargets
+		budget := maxScrapeTargets - tsmGlobal.ActiveTargetsCountByJob(jobName)
+		if budget < 0 {
+			budget = 0
+		}
+		if budget >= len(jobSws) {
+			continue
+		}
+		// Sort candidates deterministically, so the same set of targets keeps winning
+		// the budget across consecutive service discovery rounds instead of flapping.
+		sort.Slice(jobSws, func(i, j int) bool {
+			return jobSws[i].ScrapeURL < jobSws[j].ScrapeURL
+		})
+		for _, sw := range jobSws[budget:] {
+			excluded[sw] = struct{}{}
+			droppedTargetsMap.Register(sw.OriginalLabels, sw.RelabelConfigs, targetDropReasonJobLimit, nil)
+		}
+	}
+	if len(excluded) == 0 {
+		return sws
+	}
+
+	logger.Warnf("some scrape targets were dropped because they exceed -promscrape.maxScrapeTargetsPerJob (or max_scrape_targets) limit for their job_name; "+
+		"see /service-discovery page for details; dropped targets: %d", len(excluded))
+
+	dst := sws[:0]
+	for _, sw := range sws {
+		if _, ok := excluded[sw]; !ok {
+			dst = append(dst, sw)
+		}
+	}
+	return dst
+}
+
