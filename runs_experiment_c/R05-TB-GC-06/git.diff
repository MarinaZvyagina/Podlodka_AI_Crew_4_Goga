@@ -79,3 +79,85 @@ scrape_configs:
     - targets:
         - localhost:8429`, true)
 }
+
+func TestScraperGroupMaxScrapeTargets(t *testing.T) {
+	f := func(cfgData string, jobName string, targetsCount, maxScrapeTargetsCfg, wantActive, wantExcluded int) {
+		t.Helper()
+		pushData := func(_ *auth.Token, _ *prompb.WriteRequest) {}
+		globalStopChan = make(chan struct{})
+		defer close(globalStopChan)
+
+		randName := rand.Int()
+		sg := newScraperGroup(fmt.Sprintf("static_configs_%d", randName), pushData, globalStopChan)
+		defer sg.stop()
+
+		var cfg Config
+		if err := cfg.parseData([]byte(cfgData), "test-scrape.yaml"); err != nil {
+			t.Fatalf("cannot parse config: %s", err)
+		}
+		sws := cfg.getStaticScrapeWork()
+		if len(sws) != targetsCount {
+			t.Fatalf("unexpected number of generated targets; got %d; want %d", len(sws), targetsCount)
+		}
+		for _, sw := range sws {
+			if sw.MaxScrapeTargets != maxScrapeTargetsCfg {
+				t.Fatalf("unexpected MaxScrapeTargets on ScrapeWork; got %d; want %d", sw.MaxScrapeTargets, maxScrapeTargetsCfg)
+			}
+		}
+
+		droppedBefore := droppedTargetsMap.getTotalTargets()
+		sg.update(sws)
+
+		if n := droppedTargetsMap.getTotalTargets() - droppedBefore; n != wantExcluded {
+			t.Fatalf("unexpected number of newly dropped targets in droppedTargetsMap; got %d; want %d", n, wantExcluded)
+		}
+		if n := int(sg.activeScrapers.Get()); n != wantActive {
+			t.Fatalf("unexpected number of active scrapers; got %d; want %d", n, wantActive)
+		}
+		if n := tsmGlobal.jobTargetsCount(jobName); n != wantActive {
+			t.Fatalf("unexpected number of registered targets for job=%q; got %d; want %d", jobName, n, wantActive)
+		}
+		if n := tsmGlobal.excludedCountForJob(jobName); n != wantExcluded {
+			t.Fatalf("unexpected number of excluded targets for job=%q; got %d; want %d", jobName, n, wantExcluded)
+		}
+	}
+
+	// A job under its configured max_scrape_targets cap must remain unaffected:
+	// all the discovered targets are scraped and none is reported as excluded.
+	f(`
+scrape_configs:
+- job_name: under-limit
+  max_scrape_targets: 5
+  static_configs:
+    - targets:
+        - localhost:8420
+        - localhost:8421
+        - localhost:8422`, "under-limit", 3, 5, 3, 0)
+
+	// A job over its configured max_scrape_targets cap must be truncated:
+	// only up to the cap is scraped, and the remaining targets are visible as excluded.
+	f(`
+scrape_configs:
+- job_name: over-limit
+  max_scrape_targets: 2
+  static_configs:
+    - targets:
+        - localhost:8420
+        - localhost:8421
+        - localhost:8422
+        - localhost:8423
+        - localhost:8424`, "over-limit", 5, 2, 2, 3)
+
+	// By default (no max_scrape_targets set), the cap is disabled and all discovered
+	// targets are scraped regardless of how many there are.
+	f(`
+scrape_configs:
+- job_name: unlimited
+  static_configs:
+    - targets:
+        - localhost:8420
+        - localhost:8421
+        - localhost:8422
+        - localhost:8423
+        - localhost:8424`, "unlimited", 5, 0, 5, 0)
+}
