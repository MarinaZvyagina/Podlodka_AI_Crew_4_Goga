 func (tsm *targetStatusMap) Register(sw *scrapeWork) {
+	tsm.mu.Lock()
+	tsm.registerLocked(sw)
+	tsm.mu.Unlock()
+}
+
+// TryRegister registers sw as an active target unless doing so would push the number
+// of active targets for its job_name above sw.Config.MaxScrapeTargets.
+// It returns false if the target was rejected because of the cap.
+//
+// The check-and-register is performed atomically, so this function can be safely called
+// concurrently for targets belonging to the same job but discovered by different service
+// discovery mechanisms.
+func (tsm *targetStatusMap) TryRegister(sw *scrapeWork) bool {
 	jobName := sw.Config.jobNameOriginal
+	maxTargets := sw.Config.MaxScrapeTargets
 
 	tsm.mu.Lock()
+	defer tsm.mu.Unlock()
+	if maxTargets > 0 && tsm.upByJob[jobName]+tsm.downByJob[jobName] >= maxTargets {
+		return false
+	}
+	tsm.registerLocked(sw)
+	return true
+}
+
+func (tsm *targetStatusMap) registerLocked(sw *scrapeWork) {
+	jobName := sw.Config.jobNameOriginal
 	tsm.m[sw] = &targetStatus{
 		sw: sw,
 	}
 	tsm.downByJob[jobName]++
+}
+
+// jobTargetsCount returns the current number of active (up+down) targets registered for jobName.
+func (tsm *targetStatusMap) jobTargetsCount(jobName string) int {
+	tsm.mu.Lock()
+	n := tsm.upByJob[jobName] + tsm.downByJob[jobName]
 	tsm.mu.Unlock()
+	return n
+}
