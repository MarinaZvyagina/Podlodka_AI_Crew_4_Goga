@@ -0,0 +1,57 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	sdc := &SDConfig{}
+	baseDir := "."
+	if _, err := newAPIConfig(sdc, baseDir); err == nil {
+		t.Fatalf("expecting non-nil error")
+	}
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		SecretKey: &promauth.Secret{
+			S: "foobar",
+		},
+	}
+	baseDir := "."
+	cfg, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	if cfg.zone != "fr-par-1" {
+		t.Fatalf("unexpected default zone; got %q; want %q", cfg.zone, "fr-par-1")
+	}
+	if cfg.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want %d", cfg.port, 80)
+	}
+	if cfg.secretKey != "foobar" {
+		t.Fatalf("unexpected secretKey; got %q; want %q", cfg.secretKey, "foobar")
+	}
+}
+
+func TestNewAPIConfig_QueryParams(t *testing.T) {
+	sdc := &SDConfig{
+		SecretKey: &promauth.Secret{
+			S: "foobar",
+		},
+		Project:    "my-project",
+		NameFilter: "web",
+		TagsFilter: []string{"foo", "bar"},
+	}
+	baseDir := "."
+	cfg, err := newAPIConfig(sdc, baseDir)
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	want := "name=web&project=my-project&tags=foo&tags=bar"
+	if cfg.listQueryParams != want {
+		t.Fatalf("unexpected listQueryParams; got %q; want %q", cfg.listQueryParams, want)
+	}
+}
diff --git a/lib/promscrape/discovery/scaleway/instance.go b/lib/promscrape/discovery/scaleway/instance.go
new file mode 100644
index 0000000..77a7cff
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/instance.go
@@ -0,0 +1,71 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+)
+
+// Instance represents a Scaleway Instance (server).
+//
+// See: https://www.scaleway.com/en/developers/api/instance/#path-instances-list-all-instances
+type Instance struct {
+	ID             string    `json:"id"`
+	Name           string    `json:"name"`
+	Organization   string    `json:"organization"`
+	Project        string    `json:"project"`
+	Tags           []string  `json:"tags"`
+	CommercialType string    `json:"commercial_type"`
+	State          string    `json:"state"`
+	Zone           string    `json:"zone"`
+	Hostname       string    `json:"hostname"`
+	Arch           string    `json:"arch"`
+	BootType       string    `json:"boot_type"`
+	PrivateIP      string    `json:"private_ip"`
+	PublicIP       *PublicIP `json:"public_ip"`
+}
+
+// PublicIP represents the public IP address attached to a Scaleway Instance.
+type PublicIP struct {
+	Address string `json:"address"`
+}
+
+// listServersResponse is the response structure of the Scaleway list servers API.
+type listServersResponse struct {
+	Servers    []Instance `json:"servers"`
+	TotalCount int        `json:"total_count"`
+}
+
+// getInstances retrieves instances from the Scaleway Instance HTTP API.
+func getInstances(cfg *apiConfig) ([]Instance, error) {
+	var instances []Instance
+
+	setAuthHeader := func(req *http.Request) {
+		// See: https://www.scaleway.com/en/developers/api/#authentication
+		req.Header.Set("X-Auth-Token", cfg.secretKey)
+	}
+
+	page := 1
+	for {
+		// See: https://www.scaleway.com/en/developers/api/instance/#path-instances-list-all-instances
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?%s&page=%d&per_page=100", cfg.zone, cfg.listQueryParams, page)
+		data, err := cfg.c.GetAPIResponseWithReqParams(path, setAuthHeader)
+		if err != nil {
+			return nil, fmt.Errorf("cannot get Scaleway response from %q: %w", path, err)
+		}
+
+		var resp listServersResponse
+		if err := json.Unmarshal(data, &resp); err != nil {
+			return nil, fmt.Errorf("cannot unmarshal listServersResponse obtained from %q: %w; response=%q", path, err, data)
+		}
+
+		instances = append(instances, resp.Servers...)
+
+		if len(resp.Servers) == 0 || len(instances) >= resp.TotalCount {
+			break
+		}
+		page++
+	}
+
+	return instances, nil
+}
