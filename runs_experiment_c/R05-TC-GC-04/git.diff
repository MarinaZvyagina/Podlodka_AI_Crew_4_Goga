+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+func TestGetInstances_Success(t *testing.T) {
+	s := newMockScalewayServer(func() []byte {
+		const resp = `{
+			"servers": [{
+				"id": "fake-id-07f7-4b68-88ac-fake-id",
+				"name": "scaleway-sd",
+				"commercial_type": "DEV1-S",
+				"state": "running",
+				"zone": "fr-par-1",
+				"hostname": "scaleway-sd",
+				"tags": ["mock tag"],
+				"public_ip": {"address": "51.15.0.1"},
+				"private_ip": "10.0.0.1"
+			}],
+			"total_count": 1
+		}`
+		return []byte(resp)
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:         client,
+		secretKey: "foobar",
+	}
+
+	servers, err := getInstances(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+
+	expectedServers := []Server{
+		{
+			ID:             "fake-id-07f7-4b68-88ac-fake-id",
+			Name:           "scaleway-sd",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Zone:           "fr-par-1",
+			Hostname:       "scaleway-sd",
+			Tags:           []string{"mock tag"},
+			PublicIP:       &ServerIP{Address: "51.15.0.1"},
+			PrivateIP:      "10.0.0.1",
+		},
+	}
+	if !reflect.DeepEqual(servers, expectedServers) {
+		t.Fatalf("unexpected result\ngot\n%#v\nwant\n%#v", servers, expectedServers)
+	}
+}
+
+func TestGetInstances_Failure(t *testing.T) {
+	s := newMockScalewayServer(func() []byte {
+		return []byte("some error")
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:         client,
+		secretKey: "foobar",
+	}
+
+	if _, err := getInstances(cfg); err == nil {
+		t.Fatalf("expecting non-nil error from getInstances()")
+	}
+}
+
+func TestGetInstances_Paging(t *testing.T) {
+	requestCount := 0
+	s := newMockScalewayServer(func() []byte {
+		if requestCount == 0 {
+			requestCount++
+			return []byte(mockListServersSuccessPage0Resp)
+		}
+		return []byte(mockListServersSuccessPage1Resp)
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:         client,
+		secretKey: "foobar",
+	}
+
+	servers, err := getInstances(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+	if !reflect.DeepEqual(expectSuccessPagingServers, servers) {
+		t.Fatalf("unexpected getInstances() result\ngot\n%#v\nwant\n%#v", servers, expectSuccessPagingServers)
