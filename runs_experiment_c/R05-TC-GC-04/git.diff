@@ -0,0 +1,43 @@
+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	f := func(sdc *SDConfig) {
+		t.Helper()
+		if _, err := newAPIConfig(sdc, "."); err == nil {
+			t.Fatalf("expecting non-nil error")
+		}
+	}
+
+	// missing secret_key
+	f(&SDConfig{
+		Project: "my-project",
+	})
+
+	// missing project and organization
+	f(&SDConfig{
+		SecretKey: &promauth.Secret{S: "foobar"},
+	})
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		SecretKey: &promauth.Secret{S: "foobar"},
+		Project:   "my-project",
+	}
+	cfg, err := newAPIConfig(sdc, ".")
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	if cfg.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want 80", cfg.port)
+	}
+	if cfg.listQueryParams != "project=my-project" {
+		t.Fatalf("unexpected listQueryParams; got %q; want %q", cfg.listQueryParams, "project=my-project")
+	}
+}
diff --git a/lib/promscrape/discovery/scaleway/instance.go b/lib/promscrape/discovery/scaleway/instance.go
new file mode 100644
index 0000000..5c33e33
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/instance.go
@@ -0,0 +1,70 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"strconv"
+)
+
+// perPage is the number of servers requested per page from the Scaleway API.
+const perPage = 100
+
+// ListServersResponse is the response structure of the Scaleway Instances List Servers API.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-instances-list-all-instances
+type ListServersResponse struct {
+	Servers    []Server `json:"servers"`
+	TotalCount int      `json:"total_count"`
+}
+
+// Server represents a Scaleway Instance.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-instances-list-all-instances
+type Server struct {
+	ID             string    `json:"id"`
+	Name           string    `json:"name"`
+	CommercialType string    `json:"commercial_type"`
+	State          string    `json:"state"`
+	Zone           string    `json:"zone"`
+	Hostname       string    `json:"hostname"`
+	Tags           []string  `json:"tags"`
+	PublicIP       *ServerIP `json:"public_ip"`
+	PrivateIP      string    `json:"private_ip"`
+}
+
+// ServerIP represents a Scaleway Instance public IP address.
+type ServerIP struct {
+	Address string `json:"address"`
+}
+
+// getInstances retrieves the list of Instances from the Scaleway API.
+func getInstances(cfg *apiConfig) ([]Server, error) {
+	var servers []Server
+
+	page := 1
+	for {
+		// See: https://www.scaleway.com/en/developers/api/instance/#path-instances-list-all-instances
+		path := "/servers?" + cfg.listQueryParams + "&per_page=" + strconv.Itoa(perPage) + "&page=" + strconv.Itoa(page)
+		data, err := cfg.c.GetAPIResponseWithReqParams(path, func(req *http.Request) {
+			req.Header.Set("X-Auth-Token", cfg.secretKey)
+		})
+		if err != nil {
+			return nil, fmt.Errorf("cannot get Scaleway response from %q: %w", path, err)
+		}
+
+		var resp ListServersResponse
+		if err := json.Unmarshal(data, &resp); err != nil {
+			return nil, fmt.Errorf("cannot unmarshal ListServersResponse obtained from %q: %w; response=%q", path, err, data)
+		}
+
+		servers = append(servers, resp.Servers...)
+
+		if len(resp.Servers) == 0 || len(servers) >= resp.TotalCount {
+			break
+		}
+		page++
+	}
+
+	return servers, nil
+}
