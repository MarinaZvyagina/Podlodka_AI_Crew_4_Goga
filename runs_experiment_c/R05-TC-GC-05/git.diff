diff --git a/lib/promscrape/discovery/scaleway/server.go b/lib/promscrape/discovery/scaleway/server.go
new file mode 100644
index 0000000..b000cf1
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/server.go
@@ -0,0 +1,77 @@
+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/url"
+	"strconv"
+)
+
+// serversPerPage is the maximum number of servers Scaleway API returns per page.
+const serversPerPage = 100
+
+// server represents Scaleway Instance.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type server struct {
+	ID             string      `json:"id"`
+	Name           string      `json:"name"`
+	Hostname       string      `json:"hostname"`
+	Organization   string      `json:"organization"`
+	Project        string      `json:"project"`
+	CommercialType string      `json:"commercial_type"`
+	State          string      `json:"state"`
+	Zone           string      `json:"zone"`
+	BootType       string      `json:"boot_type"`
+	PrivateIP      string      `json:"private_ip"`
+	PublicIP       *publicIP   `json:"public_ip"`
+	IPv6           *serverIPv6 `json:"ipv6"`
+	Tags           []string    `json:"tags"`
+}
+
+type publicIP struct {
+	Address string `json:"address"`
+}
+
+type serverIPv6 struct {
+	Address string `json:"address"`
+}
+
+// listServersResponse is the response of the Scaleway `list servers` API.
+type listServersResponse struct {
+	Servers []server `json:"servers"`
+}
+
+// getServers returns the list of Scaleway Instances for the given cfg.
+func getServers(cfg *apiConfig) ([]server, error) {
+	var servers []server
+	for page := 1; ; page++ {
+		qp := url.Values{}
+		if cfg.projectID != "" {
+			qp.Set("project", cfg.projectID)
+		}
+		if cfg.organizationID != "" {
+			qp.Set("organization", cfg.organizationID)
+		}
+		qp.Set("page", strconv.Itoa(page))
+		qp.Set("per_page", strconv.Itoa(serversPerPage))
+
+		path := fmt.Sprintf("/instance/v1/zones/%s/servers?%s", cfg.zone, qp.Encode())
+		data, err := cfg.client.GetAPIResponseWithReqParams(path, func(req *http.Request) {
+			req.Header.Set("X-Auth-Token", cfg.secretKey)
+		})
+		if err != nil {
+			return nil, fmt.Errorf("cannot query Scaleway instances API at %q: %w", path, err)
+		}
+		var resp listServersResponse
+		if err := json.Unmarshal(data, &resp); err != nil {
+			return nil, fmt.Errorf("cannot parse Scaleway instances API response from %q: %w; response=%q", path, err, data)
+		}
+		servers = append(servers, resp.Servers...)
+		if len(resp.Servers) < serversPerPage {
+			break
+		}
+	}
+	return servers, nil
+}
diff --git a/lib/promscrape/discovery/scaleway/server_test.go b/lib/promscrape/discovery/scaleway/server_test.go
new file mode 100644
index 0000000..05cd57a
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/server_test.go
@@ -0,0 +1,184 @@
+package scaleway
+
+import (
+	"net/http"
+	"reflect"
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+func TestGetServers_Success(t *testing.T) {
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		const resp = `{
+			"servers": [{
+				"id": "11111111-1111-1111-1111-111111111111",
+				"name": "web-01",
+				"hostname": "web-01",
+				"organization": "22222222-2222-2222-2222-222222222222",
+				"project": "33333333-3333-3333-3333-333333333333",
+				"commercial_type": "DEV1-S",
+				"state": "running",
+				"zone": "fr-par-1",
+				"boot_type": "local",
+				"private_ip": "10.0.0.1",
+				"public_ip": {"id": "44444444-4444-4444-4444-444444444444", "address": "51.15.0.1"},
+				"tags": ["prod", "web"]
+			}]
+		}`
+		return []byte(resp)
+	})
+	defer s.Close()
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		client:    client,
+		zone:      "fr-par-1",
+		projectID: "33333333-3333-3333-3333-333333333333",
+		secretKey: "secret",
+	}
+
+	servers, err := getServers(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getServers(): %s", err)
+	}
+
+	expectedServers := []server{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "web-01",
+			Hostname:       "web-01",
+			Organization:   "22222222-2222-2222-2222-222222222222",
+			Project:        "33333333-3333-3333-3333-333333333333",
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Zone:           "fr-par-1",
+			BootType:       "local",
+			PrivateIP:      "10.0.0.1",
+			PublicIP:       &publicIP{Address: "51.15.0.1"},
+			Tags:           []string{"prod", "web"},
+		},
+	}
+	if !reflect.DeepEqual(servers, expectedServers) {
+		t.Fatalf("unexpected result\ngot\n%#v\nwant\n%#v", servers, expectedServers)
+	}
+
+	if got := s.lastRequest.Header.Get("X-Auth-Token"); got != "secret" {
+		t.Fatalf("unexpected X-Auth-Token header; got %q; want %q", got, "secret")
+	}
+	if got := s.lastRequest.URL.Query().Get("project"); got != cfg.projectID {
+		t.Fatalf("unexpected project query param; got %q; want %q", got, cfg.projectID)
+	}
+}
+
+func TestGetServers_Failure(t *testing.T) {
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		return []byte("some error")
+	})
+	defer s.Close()
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		client: client,
+		zone:   "fr-par-1",
+	}
+
+	if _, err := getServers(cfg); err == nil {
+		t.Fatalf("expecting non-nil error from getServers()")
+	}
+}
+
+func TestGetServers_Paging(t *testing.T) {
+	requestCount := 0
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		requestCount++
+		if requestCount == 1 {
+			return []byte(mockServersPage0Resp)
+		}
+		return []byte(mockServersPage1Resp)
+	})
+	defer s.Close()
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		client: client,
+		zone:   "fr-par-1",
+	}
+
+	servers, err := getServers(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getServers(): %s", err)
+	}
+	if !reflect.DeepEqual(expectPagingServers, servers) {
+		t.Fatalf("unexpected getServers() result\ngot\n%#v\nwant\n%#v", servers, expectPagingServers)
+	}
+}
+
+func serversPage(id string) string {
+	return `{
+		"servers": [{
+			"id": "` + id + `",
+			"name": "web-01",
+			"state": "running",
+			"zone": "fr-par-1",
+			"private_ip": "10.0.0.1"
+		}]
+	}`
+}
+
+var (
+	mockServersPage0Resp = serversPageOf(serversPerPage)
+	mockServersPage1Resp = serversPage("2-fake-id")
+
+	expectPagingServers = buildExpectPagingServers()
+)
+
+// serversPageOf returns a mock response page containing n servers, so that pagination continues.
+func serversPageOf(n int) string {
+	resp := `{"servers": [`
+	for i := 0; i < n; i++ {
+		if i > 0 {
+			resp += ","
+		}
+		resp += `{
+			"id": "1-fake-id",
+			"name": "web-01",
+			"state": "running",
+			"zone": "fr-par-1",
+			"private_ip": "10.0.0.1"
+		}`
+	}
+	resp += `]}`
+	return resp
+}
+
+func buildExpectPagingServers() []server {
+	var servers []server
+	for i := 0; i < serversPerPage; i++ {
+		servers = append(servers, server{
+			ID:        "1-fake-id",
+			Name:      "web-01",
+			State:     "running",
+			Zone:      "fr-par-1",
+			PrivateIP: "10.0.0.1",
+		})
+	}
+	servers = append(servers, server{
+		ID:        "2-fake-id",
+		Name:      "web-01",
+		State:     "running",
+		Zone:      "fr-par-1",
+		PrivateIP: "10.0.0.1",
+	})
+	return servers
+}
