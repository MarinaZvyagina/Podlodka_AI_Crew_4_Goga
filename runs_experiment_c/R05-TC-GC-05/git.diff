+package scaleway
+
+import (
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+)
+
+func TestNewAPIConfig_Failure(t *testing.T) {
+	f := func(sdc *SDConfig) {
+		t.Helper()
+		if _, err := newAPIConfig(sdc, "."); err == nil {
+			t.Fatalf("expecting non-nil error for sdc=%+v", sdc)
+		}
+	}
+
+	// Missing secret_key
+	f(&SDConfig{
+		ProjectID: "some-project",
+	})
+
+	// Missing project_id and organization_id
+	f(&SDConfig{
+		SecretKey: &promauth.Secret{S: "some-secret"},
+	})
+
+	// Both project_id and organization_id are set
+	f(&SDConfig{
+		SecretKey:      &promauth.Secret{S: "some-secret"},
+		ProjectID:      "some-project",
+		OrganizationID: "some-org",
+	})
+}
+
+func TestNewAPIConfig_Success(t *testing.T) {
+	sdc := &SDConfig{
+		SecretKey: &promauth.Secret{S: "some-secret"},
+		ProjectID: "some-project",
+	}
+	cfg, err := newAPIConfig(sdc, ".")
+	if err != nil {
+		t.Fatalf("newAPIConfig failed with, err: %v", err)
+	}
+	if cfg.zone != defaultZone {
+		t.Fatalf("unexpected default zone; got %q; want %q", cfg.zone, defaultZone)
+	}
+	if cfg.port != 80 {
+		t.Fatalf("unexpected default port; got %d; want 80", cfg.port)
+	}
+}
