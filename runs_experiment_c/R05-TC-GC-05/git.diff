@@ -0,0 +1,26 @@
+package scaleway
+
+import (
+	"net/http"
+	"net/http/httptest"
+)
+
+type mockScalewayServer struct {
+	*httptest.Server
+	responseFunc func(req *http.Request) []byte
+
+	lastRequest *http.Request
+}
+
+func newMockScalewayServer(responseFunc func(req *http.Request) []byte) *mockScalewayServer {
+	var s mockScalewayServer
+	s.responseFunc = responseFunc
+	s.Server = httptest.NewServer(http.HandlerFunc(s.handler))
+	return &s
+}
+
+func (s *mockScalewayServer) handler(w http.ResponseWriter, r *http.Request) {
+	s.lastRequest = r
+	data := s.responseFunc(r)
+	w.Write(data)
+}
diff --git a/lib/promscrape/discovery/scaleway/scaleway.go b/lib/promscrape/discovery/scaleway/scaleway.go
new file mode 100644
index 0000000..9c6fff5
--- /dev/null
+++ b/lib/promscrape/discovery/scaleway/scaleway.go
@@ -0,0 +1,123 @@
+// Package scaleway provides Prometheus-compatible service discovery for Scaleway Instances.
+package scaleway
+
+import (
+	"flag"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promutil"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/proxy"
+)
+
+// SDCheckInterval defines interval for targets refresh.
+var SDCheckInterval = flag.Duration("promscrape.scalewaySDCheckInterval", 30*time.Second, "Interval for checking for changes in Scaleway API. "+
+	"This works only if scaleway_sd_configs is configured in '-promscrape.config' file. "+
+	"See https://docs.victoriametrics.com/victoriametrics/sd_configs/#scaleway_sd_configs for details")
+
+// SDConfig represents service discovery config for Scaleway Instances.
+//
+// See https://www.scaleway.com/en/developers/api/instance/#path-servers-list-servers
+type SDConfig struct {
+	// ProjectID is the id of the Scaleway project to discover instances from.
+	// Either ProjectID or OrganizationID must be set.
+	ProjectID string `yaml:"project_id,omitempty"`
+
+	// OrganizationID is the id of the Scaleway organization to discover instances from.
+	// Either ProjectID or OrganizationID must be set.
+	OrganizationID string `yaml:"organization_id,omitempty"`
+
+	// SecretKey is used for authenticating requests to the Scaleway API (mandatory).
+	// See https://www.scaleway.com/en/docs/identity-and-access-management/iam/how-to/create-api-keys/
+	SecretKey *promauth.Secret `yaml:"secret_key,omitempty"`
+
+	// APIURL is an optional Scaleway API url. By default, https://api.scaleway.com is used.
+	APIURL string `yaml:"api_url,omitempty"`
+
+	// Zone is the Scaleway zone to discover instances in. By default, fr-par-1 is used.
+	// See https://www.scaleway.com/en/docs/console/account/reference-content/products-availability/
+	Zone string `yaml:"zone,omitempty"`
+
+	// Port is the default port to scrape metrics from. By default, port 80 is used.
+	Port int `yaml:"port,omitempty"`
+
+	HTTPClientConfig  promauth.HTTPClientConfig  `yaml:",inline"`
+	ProxyURL          *proxy.URL                 `yaml:"proxy_url,omitempty"`
+	ProxyClientConfig promauth.ProxyClientConfig `yaml:",inline"`
+
+	// refresh_interval is obtained from `-promscrape.scalewaySDCheckInterval` command-line option.
+}
+
+var configMap = discoveryutil.NewConfigMap()
+
+// GetLabels returns Scaleway instance labels according to sdc.
+func (sdc *SDConfig) GetLabels(baseDir string) ([]*promutil.Labels, error) {
+	cfg, err := getAPIConfig(sdc, baseDir)
+	if err != nil {
+		return nil, fmt.Errorf("cannot get API config: %w", err)
+	}
+	servers, err := getServers(cfg)
+	if err != nil {
+		return nil, err
+	}
+	return addServerLabels(servers, cfg.port), nil
+}
+
+// MustStop stops further usage for sdc.
+func (sdc *SDConfig) MustStop() {
+	v := configMap.Delete(sdc)
+	if v != nil {
+		cfg := v.(*apiConfig)
+		cfg.client.Stop()
+	}
+}
+
+// addServerLabels returns labels for the given running Scaleway servers.
+func addServerLabels(servers []server, defaultPort int) []*promutil.Labels {
+	ms := make([]*promutil.Labels, 0, len(servers))
+	for _, srv := range servers {
+		// Only running instances expose scrapeable metrics endpoints.
+		if srv.State != "running" {
+			continue
+		}
+
+		var publicIPv4, publicIPv6 string
+		if srv.PublicIP != nil {
+			publicIPv4 = srv.PublicIP.Address
+		}
+		if srv.IPv6 != nil {
+			publicIPv6 = srv.IPv6.Address
+		}
+
+		addr := publicIPv4
+		if addr == "" {
+			addr = srv.PrivateIP
+		}
+		if addr == "" {
+			continue
+		}
+
+		m := promutil.NewLabels(16)
+		m.Add("__address__", discoveryutil.JoinHostPort(addr, defaultPort))
+		m.Add("__meta_scaleway_instance_id", srv.ID)
+		m.Add("__meta_scaleway_instance_name", srv.Name)
+		m.Add("__meta_scaleway_instance_hostname", srv.Hostname)
+		m.Add("__meta_scaleway_instance_status", srv.State)
+		m.Add("__meta_scaleway_instance_type", srv.CommercialType)
+		m.Add("__meta_scaleway_instance_zone", srv.Zone)
+		m.Add("__meta_scaleway_instance_boot_type", srv.BootType)
+		m.Add("__meta_scaleway_instance_organization_id", srv.Organization)
+		m.Add("__meta_scaleway_instance_project_id", srv.Project)
+		m.Add("__meta_scaleway_instance_private_ipv4", srv.PrivateIP)
+		m.Add("__meta_scaleway_instance_public_ipv4", publicIPv4)
+		m.Add("__meta_scaleway_instance_public_ipv6", publicIPv6)
+		if len(srv.Tags) > 0 {
+			m.Add("__meta_scaleway_instance_tags", ","+strings.Join(srv.Tags, ",")+",")
+		}
+		ms = append(ms, m)
+	}
+	return ms
+}
