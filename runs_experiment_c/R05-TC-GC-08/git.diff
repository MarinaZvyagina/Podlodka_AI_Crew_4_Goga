+
+func TestGetInstanceLabels(t *testing.T) {
+	privateIP := "10.0.0.1"
+
+	input := []Server{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "scaleway-sd",
+			Organization:   "22222222-2222-2222-2222-222222222222",
+			Project:        "33333333-3333-3333-3333-333333333333",
+			Tags:           []string{"foo", "bar"},
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Hostname:       "scaleway-sd",
+			BootType:       "local",
+			PrivateIP:      &privateIP,
+			PublicIP: &ServerIP{
+				ID:      "44444444-4444-4444-4444-444444444444",
+				Address: "51.15.0.1",
+			},
+			Image: &Image{
+				ID:   "55555555-5555-5555-5555-555555555555",
+				Name: "Ubuntu 22.04 Jammy Jellyfish",
+			},
+		},
+		{
+			// instance without a public IP falls back to the private IP for `__address__`
+			ID:             "66666666-6666-6666-6666-666666666666",
+			Name:           "scaleway-sd-private",
+			CommercialType: "DEV1-S",
+			State:          "stopped",
+			PrivateIP:      &privateIP,
+		},
+	}
+
+	expect := []*promutil.Labels{
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "51.15.0.1:8080",
+			"__meta_scaleway_instance_id":              "11111111-1111-1111-1111-111111111111",
+			"__meta_scaleway_instance_name":            "scaleway-sd",
+			"__meta_scaleway_instance_organization_id": "22222222-2222-2222-2222-222222222222",
+			"__meta_scaleway_instance_project_id":      "33333333-3333-3333-3333-333333333333",
+			"__meta_scaleway_instance_status":          "running",
+			"__meta_scaleway_instance_type":            "DEV1-S",
+			"__meta_scaleway_instance_hostname":        "scaleway-sd",
+			"__meta_scaleway_instance_boot_type":       "local",
+			"__meta_scaleway_instance_zone":            "fr-par-1",
+			"__meta_scaleway_instance_public_ipv4":     "51.15.0.1",
+			"__meta_scaleway_instance_private_ipv4":    "10.0.0.1",
+			"__meta_scaleway_instance_image_id":        "55555555-5555-5555-5555-555555555555",
+			"__meta_scaleway_instance_image_name":      "Ubuntu 22.04 Jammy Jellyfish",
+			"__meta_scaleway_instance_tags":            ",foo,bar,",
+		}),
+		promutil.NewLabelsFromMap(map[string]string{
+			"__address__":                              "10.0.0.1:8080",
+			"__meta_scaleway_instance_id":              "66666666-6666-6666-6666-666666666666",
+			"__meta_scaleway_instance_name":            "scaleway-sd-private",
+			"__meta_scaleway_instance_organization_id": "",
+			"__meta_scaleway_instance_project_id":      "",
+			"__meta_scaleway_instance_status":          "stopped",
+			"__meta_scaleway_instance_type":            "DEV1-S",
+			"__meta_scaleway_instance_hostname":        "",
+			"__meta_scaleway_instance_boot_type":       "",
+			"__meta_scaleway_instance_zone":            "fr-par-1",
+			"__meta_scaleway_instance_private_ipv4":    "10.0.0.1",
+		}),
+	}
+	labels := getInstanceLabels(input, "fr-par-1", 8080)
+	discoveryutil.TestEqualLabelss(t, labels, expect)
+}
