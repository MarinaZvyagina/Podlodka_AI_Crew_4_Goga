+package scaleway
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/url"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promauth"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/promscrape/discoveryutil"
+)
+
+func TestGetInstances_Success(t *testing.T) {
+	var gotPath string
+	var gotAuthHeader string
+
+	s := newMockScalewayServer(func(r *http.Request) []byte {
+		gotPath = r.URL.String()
+		gotAuthHeader = r.Header.Get("X-Auth-Token")
+
+		const resp = `{
+			"servers": [{
+				"id": "11111111-1111-1111-1111-111111111111",
+				"name": "scaleway-sd",
+				"organization": "22222222-2222-2222-2222-222222222222",
+				"project": "33333333-3333-3333-3333-333333333333",
+				"tags": ["foo", "bar"],
+				"commercial_type": "DEV1-S",
+				"state": "running",
+				"hostname": "scaleway-sd",
+				"boot_type": "local",
+				"private_ip": "10.0.0.1",
+				"public_ip": {
+					"id": "44444444-4444-4444-4444-444444444444",
+					"address": "51.15.0.1"
+				},
+				"image": {
+					"id": "55555555-5555-5555-5555-555555555555",
+					"name": "Ubuntu 22.04 Jammy Jellyfish"
+				}
+			}],
+			"total_count": 1
+		}`
+		return []byte(resp)
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:         client,
+		zone:      "fr-par-1",
+		secretKey: "secret-token",
+	}
+
+	instances, err := getInstances(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+
+	expectedInstances := []Server{
+		{
+			ID:             "11111111-1111-1111-1111-111111111111",
+			Name:           "scaleway-sd",
+			Organization:   "22222222-2222-2222-2222-222222222222",
+			Project:        "33333333-3333-3333-3333-333333333333",
+			Tags:           []string{"foo", "bar"},
+			CommercialType: "DEV1-S",
+			State:          "running",
+			Hostname:       "scaleway-sd",
+			BootType:       "local",
+			PrivateIP:      strPtr("10.0.0.1"),
+			PublicIP: &ServerIP{
+				ID:      "44444444-4444-4444-4444-444444444444",
+				Address: "51.15.0.1",
+			},
+			Image: &Image{
+				ID:   "55555555-5555-5555-5555-555555555555",
+				Name: "Ubuntu 22.04 Jammy Jellyfish",
+			},
+		},
+	}
+	if !reflect.DeepEqual(instances, expectedInstances) {
+		t.Fatalf("unexpected result\ngot\n%#v\nwant\n%#v", instances, expectedInstances)
+	}
+
+	if gotAuthHeader != "secret-token" {
+		t.Fatalf("unexpected X-Auth-Token header; got %q; want %q", gotAuthHeader, "secret-token")
+	}
+	if !strings.HasPrefix(gotPath, "/instance/v1/zones/fr-par-1/servers?") {
+		t.Fatalf("unexpected request path: %q", gotPath)
+	}
+	u, err := url.Parse(gotPath)
+	if err != nil {
+		t.Fatalf("cannot parse request path %q: %s", gotPath, err)
+	}
+	if got := u.Query().Get("page"); got != "1" {
+		t.Fatalf("unexpected page query param; got %q; want %q", got, "1")
+	}
+	if got := u.Query().Get("per_page"); got != fmt.Sprintf("%d", maxItemsPerPage) {
+		t.Fatalf("unexpected per_page query param; got %q; want %q", got, fmt.Sprintf("%d", maxItemsPerPage))
+	}
+}
+
+func TestGetInstances_Failure(t *testing.T) {
+	s := newMockScalewayServer(func(_ *http.Request) []byte {
+		return []byte("some error")
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:         client,
+		zone:      "fr-par-1",
+		secretKey: "secret-token",
+	}
+
+	if _, err := getInstances(cfg); err == nil {
+		t.Fatalf("expecting non-nil error from getInstances()")
+	}
+}
+
+func TestGetInstances_Paging(t *testing.T) {
+	page1Servers := make([]Server, maxItemsPerPage)
+	for i := range page1Servers {
+		page1Servers[i] = Server{
+			ID:   fmt.Sprintf("page1-%d", i),
+			Name: fmt.Sprintf("scaleway-sd-%d", i),
+			PublicIP: &ServerIP{
+				Address: "51.15.0.1",
+			},
+		}
+	}
+	page2Servers := []Server{
+		{
+			ID:   "page2-0",
+			Name: "scaleway-sd-last",
+			PublicIP: &ServerIP{
+				Address: "51.15.0.2",
+			},
+		},
+	}
+
+	page1Resp, err := json.Marshal(ListServersResponse{Servers: page1Servers, TotalCount: maxItemsPerPage + 1})
+	if err != nil {
+		t.Fatalf("unexpected error marshaling page1 response: %s", err)
+	}
+	page2Resp, err := json.Marshal(ListServersResponse{Servers: page2Servers, TotalCount: maxItemsPerPage + 1})
+	if err != nil {
+		t.Fatalf("unexpected error marshaling page2 response: %s", err)
+	}
+
+	s := newMockScalewayServer(func(r *http.Request) []byte {
+		page := r.URL.Query().Get("page")
+		if page == "1" {
+			return page1Resp
+		}
+		return page2Resp
+	})
+
+	client, err := discoveryutil.NewClient(s.URL, nil, nil, nil, &promauth.HTTPClientConfig{})
+	if err != nil {
+		t.Fatalf("unexpected error when creating http client: %s", err)
+	}
+	cfg := &apiConfig{
+		c:         client,
+		zone:      "fr-par-1",
+		secretKey: "secret-token",
+	}
+
+	instances, err := getInstances(cfg)
+	if err != nil {
+		t.Fatalf("unexpected error in getInstances(): %s", err)
+	}
+
+	expectedInstances := append(append([]Server{}, page1Servers...), page2Servers...)
+	if !reflect.DeepEqual(instances, expectedInstances) {
+		t.Fatalf("unexpected getInstances() result; got %d instances; want %d instances", len(instances), len(expectedInstances))
+	}
+}
+
+func strPtr(s string) *string {
+	return &s
+}
