+func TestStorageDroppedSeriesByCardinalityLimitTrackingMemoryBound(t *testing.T) {
+	defer testRemoveAll(t)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	tr := TimeRange{minTimestamp, maxTimestamp}
+
+	const maxNamesTracked = 3
+	opts := OpenOptions{
+		MaxHourlySeries:                      1,
+		TrackDroppedSeriesByCardinalityLimit: true,
+		MaxDroppedSeriesNamesTracked:         maxNamesTracked,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	s.AddRows(testGenerateMetricRowsForName(rng, "metric_admitted", 1, tr), defaultPrecisionBits)
+	s.DebugFlush()
+
+	const distinctDroppedNames = 50
+	for i := range distinctDroppedNames {
+		name := fmt.Sprintf("metric_dropped_%d", i)
+		s.AddRows(testGenerateMetricRowsForName(rng, name, 1, tr), defaultPrecisionBits)
+	}
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if got, want := m.HourlySeriesLimitRowsDropped, uint64(distinctDroppedNames); got != want {
+		t.Fatalf("unexpected HourlySeriesLimitRowsDropped: got %d, want %d", got, want)
+	}
+
+	stats := s.GetDroppedSeriesByCardinalityLimit(0)
+	if stats.TotalTrackedMetricNames != maxNamesTracked {
+		t.Fatalf("unexpected TotalTrackedMetricNames: got %d, want %d (the configured bound must be respected "+
+			"even though %d distinct metric names were dropped)", stats.TotalTrackedMetricNames, maxNamesTracked, distinctDroppedNames)
+	}
+	if stats.MaxTrackedMetricNames != maxNamesTracked {
+		t.Fatalf("unexpected MaxTrackedMetricNames: got %d, want %d", stats.MaxTrackedMetricNames, maxNamesTracked)
+	}
+	if len(stats.Records) != maxNamesTracked {
+		t.Fatalf("unexpected number of records: got %d, want %d", len(stats.Records), maxNamesTracked)
+	}
+}
