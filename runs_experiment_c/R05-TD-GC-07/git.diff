--- a/lib/storage/metric_name.go
+++ b/lib/storage/metric_name.go
@@ -521,6 +521,37 @@ func (mn *MetricName) UnmarshalRaw(src []byte) error {
 	return nil
 }
 
+// getMetricGroupFromRaw returns the value of the __name__ label from src,
+// which must be encoded with MarshalMetricNameRaw.
+//
+// Unlike MetricName.UnmarshalRaw, this doesn't allocate or decode the
+// remaining tags, so it is cheap enough to call on the hot series-cardinality
+// limiter path.
+//
+// The returned slice points into src and must be cloned before being
+// retained past the lifetime of src. nil is returned if src doesn't contain
+// the __name__ label or is malformed.
+func getMetricGroupFromRaw(src []byte) []byte {
+	for len(src) > 0 {
+		tail, key, err := unmarshalBytesFast(src)
+		if err != nil {
+			return nil
+		}
+		src = tail
+
+		tail, value, err := unmarshalBytesFast(src)
+		if err != nil {
+			return nil
+		}
+		src = tail
+
+		if len(key) == 0 {
+			return value
+		}
+	}
+	return nil
+}
+
 func marshalStringFast(dst []byte, s string) []byte {
 	if len(s) > math.MaxUint16 {
 		logger.Panicf("BUG: s len %d cannot exceed %d", len(s), math.MaxUint16)
