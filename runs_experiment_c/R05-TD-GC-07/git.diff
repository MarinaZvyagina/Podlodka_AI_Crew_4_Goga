+func TestStorageDroppedSeriesByCardinalityLimitTracking(t *testing.T) {
+	defer testRemoveAll(t)
+
+	rng := rand.New(rand.NewSource(1))
+	minTimestamp := time.Now().UnixMilli()
+	maxTimestamp := minTimestamp + 1000
+	tr := TimeRange{minTimestamp, maxTimestamp}
+
+	const maxHourlySeries = 3
+	opts := OpenOptions{
+		MaxHourlySeries:                      maxHourlySeries,
+		TrackDroppedSeriesByCardinalityLimit: true,
+		MaxDroppedSeriesNamesTracked:         100,
+	}
+	s := MustOpenStorage(t.Name(), opts)
+	defer s.MustClose()
+
+	// Fully admitted: exactly fills up the hourly series limiter, so nothing is dropped.
+	s.AddRows(testGenerateMetricRowsForName(rng, "metric_admitted", maxHourlySeries, tr), defaultPrecisionBits)
+	s.DebugFlush()
+
+	// The limiter is now full, so every series below - for both metric names - gets dropped.
+	s.AddRows(testGenerateMetricRowsForName(rng, "metric_b", 7, tr), defaultPrecisionBits)
+	s.AddRows(testGenerateMetricRowsForName(rng, "metric_c", 5, tr), defaultPrecisionBits)
+	s.DebugFlush()
+
+	var m Metrics
+	s.UpdateMetrics(&m)
+	if got, want := m.HourlySeriesLimitRowsDropped, uint64(12); got != want {
+		t.Fatalf("unexpected HourlySeriesLimitRowsDropped: got %d, want %d", got, want)
+	}
+
+	stats := s.GetDroppedSeriesByCardinalityLimit(0)
+	if stats.TotalTrackedMetricNames != 2 {
+		t.Fatalf("unexpected TotalTrackedMetricNames: got %d, want 2", stats.TotalTrackedMetricNames)
+	}
+	if len(stats.Records) != 2 {
+		t.Fatalf("unexpected number of records: got %d, want 2: %+v", len(stats.Records), stats.Records)
+	}
+	if stats.Records[0].MetricName != "metric_b" || stats.Records[0].DroppedRows != 7 {
+		t.Fatalf("unexpected top record: %+v", stats.Records[0])
+	}
+	if stats.Records[1].MetricName != "metric_c" || stats.Records[1].DroppedRows != 5 {
+		t.Fatalf("unexpected second record: %+v", stats.Records[1])
+	}
+
+	// topN must bound the returned records while leaving TotalTrackedMetricNames unaffected.
+	top1 := s.GetDroppedSeriesByCardinalityLimit(1)
+	if len(top1.Records) != 1 || top1.Records[0].MetricName != "metric_b" {
+		t.Fatalf("unexpected top1 records: %+v", top1.Records)
+	}
+	if top1.TotalTrackedMetricNames != 2 {
+		t.Fatalf("unexpected TotalTrackedMetricNames for top1: got %d, want 2", top1.TotalTrackedMetricNames)
+	}
+
+	s.ResetDroppedSeriesByCardinalityLimitStats()
+	afterReset := s.GetDroppedSeriesByCardinalityLimit(0)
+	if len(afterReset.Records) != 0 {
+		t.Fatalf("unexpected records after reset: %+v", afterReset.Records)
+	}
+}
