+// testGenerateMetricRowsForName is a test helper function that generates
+// seriesCount rows sharing the given metric name but with distinct series
+// (distinct `instance` tag values).
+func testGenerateMetricRowsForName(rng *rand.Rand, name string, seriesCount int, tr TimeRange) []MetricRow {
+	var mrs []MetricRow
+	var mn MetricName
+	mn.MetricGroup = []byte(name)
+	for i := range seriesCount {
+		mn.Tags = []Tag{
+			{Key: []byte("instance"), Value: fmt.Appendf(nil, "instance_%d", i)},
+		}
+		metricNameRaw := mn.marshalRaw(nil)
+		timestamp := rng.Int63n(tr.MaxTimestamp-tr.MinTimestamp) + tr.MinTimestamp
+		value := rng.NormFloat64() * 1e6
+
+		mrs = append(mrs, MetricRow{
+			MetricNameRaw: metricNameRaw,
+			Timestamp:     timestamp,
+			Value:         value,
+		})
+	}
+	return mrs
+}
