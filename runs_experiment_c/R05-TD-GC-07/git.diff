diff --git a/lib/storage/droppedseries/tracker.go b/lib/storage/droppedseries/tracker.go
new file mode 100644
index 0000000..0635946
--- /dev/null
+++ b/lib/storage/droppedseries/tracker.go
@@ -0,0 +1,152 @@
+// Package droppedseries tracks, per metric name, how many samples were
+// dropped because adding the corresponding series would have exceeded the
+// configured -storage.maxHourlySeries or -storage.maxDailySeries limit.
+//
+// The tracker is bounded: once the configured maximum number of distinct
+// metric names is reached, samples for metric names not seen before stop
+// being tracked, while counters for already tracked metric names keep
+// accumulating. This guarantees the tracker's memory usage cannot grow
+// without bound even when installations ingest millions of distinct metric
+// names.
+package droppedseries
+
+import (
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/fasttime"
+)
+
+// DefaultMaxTrackedMetricNames is used by NewTracker when maxTrackedMetricNames<=0 is passed to it.
+const DefaultMaxTrackedMetricNames = 1000
+
+// Tracker accumulates per-metric-name counters of samples dropped due to
+// exceeding a configured series cardinality limit.
+//
+// It is safe to call any method on a nil *Tracker - all of them become
+// no-ops. This allows disabling the feature with no runtime overhead.
+type Tracker struct {
+	maxTrackedMetricNames int
+
+	mu      sync.RWMutex
+	m       map[string]*atomic.Uint64
+	sinceTs uint64
+}
+
+// NewTracker creates a Tracker, which tracks drop counters for at most
+// maxTrackedMetricNames distinct metric names.
+//
+// If maxTrackedMetricNames<=0, then DefaultMaxTrackedMetricNames is used instead.
+func NewTracker(maxTrackedMetricNames int) *Tracker {
+	if maxTrackedMetricNames <= 0 {
+		maxTrackedMetricNames = DefaultMaxTrackedMetricNames
+	}
+	return &Tracker{
+		maxTrackedMetricNames: maxTrackedMetricNames,
+		m:                     make(map[string]*atomic.Uint64),
+		sinceTs:               fasttime.UnixTimestamp(),
+	}
+}
+
+// IncrementForMetricName increments the drop counter for the given metricName by 1.
+//
+// Calling this on a nil Tracker or with an empty metricName is a no-op.
+//
+// If the Tracker already tracks maxTrackedMetricNames distinct metric names
+// and metricName isn't one of them, then the call is silently ignored in
+// order to keep the Tracker's memory usage bounded.
+func (t *Tracker) IncrementForMetricName(metricName []byte) {
+	if t == nil || len(metricName) == 0 {
+		return
+	}
+
+	t.mu.RLock()
+	c, ok := t.m[string(metricName)]
+	t.mu.RUnlock()
+	if ok {
+		c.Add(1)
+		return
+	}
+
+	t.mu.Lock()
+	c, ok = t.m[string(metricName)]
+	if !ok {
+		if len(t.m) >= t.maxTrackedMetricNames {
+			t.mu.Unlock()
+			return
+		}
+		c = &atomic.Uint64{}
+		t.m[string(metricName)] = c
+	}
+	t.mu.Unlock()
+
+	c.Add(1)
+}
+
+// Record is a single metric name with its accumulated drop count.
+type Record struct {
+	MetricName  string
+	DroppedRows uint64
+}
+
+// Stats is the result returned by Tracker.GetTop.
+type Stats struct {
+	// SinceTs is the unix timestamp in seconds since which the counters were being collected.
+	SinceTs uint64
+
+	// MaxTrackedMetricNames is the configured limit on the number of distinct tracked metric names.
+	MaxTrackedMetricNames int
+
+	// TotalTrackedMetricNames is the number of distinct metric names currently tracked.
+	TotalTrackedMetricNames int
+
+	// Records holds up to topN entries requested from GetTop, sorted by DroppedRows in descending order.
+	Records []Record
+}
+
+// GetTop returns a Stats with up to topN metric names with the highest drop
+// counters, sorted by drop count in descending order.
+//
+// If topN<=0, then all the tracked records are returned.
+func (t *Tracker) GetTop(topN int) Stats {
+	var s Stats
+	if t == nil {
+		return s
+	}
+
+	t.mu.RLock()
+	s.SinceTs = t.sinceTs
+	s.MaxTrackedMetricNames = t.maxTrackedMetricNames
+	s.TotalTrackedMetricNames = len(t.m)
+	s.Records = make([]Record, 0, len(t.m))
+	for name, c := range t.m {
+		s.Records = append(s.Records, Record{
+			MetricName:  name,
+			DroppedRows: c.Load(),
+		})
+	}
+	t.mu.RUnlock()
+
+	sort.Slice(s.Records, func(i, j int) bool {
+		if s.Records[i].DroppedRows != s.Records[j].DroppedRows {
+			return s.Records[i].DroppedRows > s.Records[j].DroppedRows
+		}
+		return s.Records[i].MetricName < s.Records[j].MetricName
+	})
+	if topN > 0 && len(s.Records) > topN {
+		s.Records = s.Records[:topN]
+	}
+	return s
+}
+
+// Reset drops all the accumulated stats and restarts counting from the current time.
+func (t *Tracker) Reset() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.m = make(map[string]*atomic.Uint64)
+	t.sinceTs = fasttime.UnixTimestamp()
+	t.mu.Unlock()
+}
diff --git a/lib/storage/droppedseries/tracker_test.go b/lib/storage/droppedseries/tracker_test.go
new file mode 100644
index 0000000..8ddec89
--- /dev/null
+++ b/lib/storage/droppedseries/tracker_test.go
@@ -0,0 +1,178 @@
+package droppedseries
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestTracker_NilIsNoOp(t *testing.T) {
+	var tr *Tracker
+	tr.IncrementForMetricName([]byte("foo"))
+	tr.Reset()
+	s := tr.GetTop(10)
+	if len(s.Records) != 0 {
+		t.Fatalf("unexpected records for nil tracker: %v", s.Records)
+	}
+}
+
+func TestTracker_RecordsMultipleMetricNames(t *testing.T) {
+	tr := NewTracker(100)
+
+	tr.IncrementForMetricName([]byte("metric_a"))
+	tr.IncrementForMetricName([]byte("metric_a"))
+	tr.IncrementForMetricName([]byte("metric_a"))
+	tr.IncrementForMetricName([]byte("metric_b"))
+	tr.IncrementForMetricName([]byte("metric_c"))
+	tr.IncrementForMetricName([]byte("metric_c"))
+
+	// empty metric names must be ignored
+	tr.IncrementForMetricName(nil)
+	tr.IncrementForMetricName([]byte(""))
+
+	s := tr.GetTop(10)
+	if s.TotalTrackedMetricNames != 3 {
+		t.Fatalf("unexpected TotalTrackedMetricNames: got %d, want 3", s.TotalTrackedMetricNames)
+	}
+	want := map[string]uint64{
+		"metric_a": 3,
+		"metric_b": 1,
+		"metric_c": 2,
+	}
+	got := make(map[string]uint64, len(s.Records))
+	for _, r := range s.Records {
+		got[r.MetricName] = r.DroppedRows
+	}
+	if len(got) != len(want) {
+		t.Fatalf("unexpected records: got %v, want %v", got, want)
+	}
+	for name, count := range want {
+		if got[name] != count {
+			t.Fatalf("unexpected count for %q: got %d, want %d", name, got[name], count)
+		}
+	}
+}
+
+func TestTracker_GetTopOrderingAndLimit(t *testing.T) {
+	tr := NewTracker(100)
+
+	counts := map[string]int{
+		"metric_low":    1,
+		"metric_medium": 5,
+		"metric_high":   10,
+	}
+	for name, n := range counts {
+		for i := 0; i < n; i++ {
+			tr.IncrementForMetricName([]byte(name))
+		}
+	}
+
+	s := tr.GetTop(2)
+	if len(s.Records) != 2 {
+		t.Fatalf("unexpected number of records: got %d, want 2", len(s.Records))
+	}
+	if s.Records[0].MetricName != "metric_high" || s.Records[0].DroppedRows != 10 {
+		t.Fatalf("unexpected top record: %+v", s.Records[0])
+	}
+	if s.Records[1].MetricName != "metric_medium" || s.Records[1].DroppedRows != 5 {
+		t.Fatalf("unexpected second record: %+v", s.Records[1])
+	}
+	// TotalTrackedMetricNames must reflect all tracked names, not just the returned topN.
+	if s.TotalTrackedMetricNames != 3 {
+		t.Fatalf("unexpected TotalTrackedMetricNames: got %d, want 3", s.TotalTrackedMetricNames)
+	}
+
+	all := tr.GetTop(0)
+	if len(all.Records) != 3 {
+		t.Fatalf("unexpected number of records for topN<=0: got %d, want 3", len(all.Records))
+	}
+}
+
+func TestTracker_MemoryBoundIsRespected(t *testing.T) {
+	const maxNames = 10
+	tr := NewTracker(maxNames)
+
+	for i := 0; i < 1000; i++ {
+		name := fmt.Sprintf("metric_%d", i)
+		tr.IncrementForMetricName([]byte(name))
+	}
+
+	s := tr.GetTop(0)
+	if s.TotalTrackedMetricNames != maxNames {
+		t.Fatalf("unexpected TotalTrackedMetricNames: got %d, want %d", s.TotalTrackedMetricNames, maxNames)
+	}
+	if len(s.Records) != maxNames {
+		t.Fatalf("unexpected number of records: got %d, want %d", len(s.Records), maxNames)
+	}
+	if s.MaxTrackedMetricNames != maxNames {
+		t.Fatalf("unexpected MaxTrackedMetricNames: got %d, want %d", s.MaxTrackedMetricNames, maxNames)
+	}
+
+	// already tracked metric names must keep accumulating even after the bound is reached.
+	tr.IncrementForMetricName([]byte("metric_0"))
+	s = tr.GetTop(0)
+	if s.TotalTrackedMetricNames != maxNames {
+		t.Fatalf("unexpected TotalTrackedMetricNames after re-increment: got %d, want %d", s.TotalTrackedMetricNames, maxNames)
+	}
+}
+
+func TestTracker_DefaultMaxTrackedMetricNames(t *testing.T) {
+	tr := NewTracker(0)
+	if tr.maxTrackedMetricNames != DefaultMaxTrackedMetricNames {
+		t.Fatalf("unexpected default maxTrackedMetricNames: got %d, want %d", tr.maxTrackedMetricNames, DefaultMaxTrackedMetricNames)
+	}
+}
+
+func TestTracker_Reset(t *testing.T) {
+	tr := NewTracker(100)
+	tr.IncrementForMetricName([]byte("metric_a"))
+	tr.IncrementForMetricName([]byte("metric_b"))
+
+	s := tr.GetTop(0)
+	if s.TotalTrackedMetricNames != 2 {
+		t.Fatalf("unexpected TotalTrackedMetricNames before reset: got %d", s.TotalTrackedMetricNames)
+	}
+
+	tr.Reset()
+
+	s = tr.GetTop(0)
+	if s.TotalTrackedMetricNames != 0 {
+		t.Fatalf("unexpected TotalTrackedMetricNames after reset: got %d, want 0", s.TotalTrackedMetricNames)
+	}
+	if len(s.Records) != 0 {
+		t.Fatalf("unexpected records after reset: %v", s.Records)
+	}
+}
+
+func TestTracker_ConcurrentIncrement(t *testing.T) {
+	tr := NewTracker(50)
+
+	var wg sync.WaitGroup
+	const goroutines = 20
+	const incrementsPerName = 50
+	names := []string{"metric_a", "metric_b", "metric_c"}
+
+	for i := 0; i < goroutines; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for _, name := range names {
+				for j := 0; j < incrementsPerName; j++ {
+					tr.IncrementForMetricName([]byte(name))
+				}
+			}
+		}()
+	}
+	wg.Wait()
+
+	s := tr.GetTop(0)
+	want := uint64(goroutines * incrementsPerName)
+	for _, r := range s.Records {
+		if r.DroppedRows != want {
+			t.Fatalf("unexpected count for %q: got %d, want %d", r.MetricName, r.DroppedRows, want)
+		}
+	}
+	if len(s.Records) != len(names) {
+		t.Fatalf("unexpected number of records: got %d, want %d", len(s.Records), len(names))
+	}
+}
