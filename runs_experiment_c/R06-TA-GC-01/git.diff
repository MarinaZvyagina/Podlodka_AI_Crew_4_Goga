index fae37161d..8fb3d9640 100644
--- a/server/auth/store_test.go
+++ b/server/auth/store_test.go
@@ -174,6 +174,32 @@ func TestUserAdd(t *testing.T) {
 	require.Truef(t, ok, "user %s should be added but it doesn't exist in rangePermCache", userName)
 }
 
+func TestUserAddWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// adding a user with a blank password and no explicit no-password option must fail
+	ua := &pb.AuthUserAddRequest{Name: "blank-pass", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// same, but with the default (nil) options
+	ua = &pb.AuthUserAddRequest{Name: "blank-pass"}
+	_, err = as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// a user should not have been created
+	_, ok := as.rangePermCache["blank-pass"]
+	require.Falsef(t, ok, "user blank-pass should not have been added")
+
+	// explicitly opting into no-password mode with a blank password must still work
+	ua = &pb.AuthUserAddRequest{Name: "blank-pass-ok", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
