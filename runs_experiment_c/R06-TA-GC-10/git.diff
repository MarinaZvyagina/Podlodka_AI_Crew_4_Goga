+func TestUserChangePasswordToEmpty(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// changing a regular (non-passwordless) user's password to blank must fail
+	_, err := as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "foo"})
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// the existing password must still work
+	ctx := context.WithValue(context.WithValue(t.Context(), AuthenticateParamIndex{}, uint64(1)), AuthenticateParamSimpleTokenPrefix{}, "dummy")
+	_, err = as.Authenticate(ctx, "foo", "bar")
+	require.NoErrorf(t, err, "expected no error, got %v", err)
+
+	// a passwordless account must still be able to "change" its (absent) password
+	ua := &pb.AuthUserAddRequest{Name: "nopass-user", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	require.NoErrorf(t, err, "expected no error, got %v", err)
+
+	_, err = as.UserChangePassword(&pb.AuthUserChangePasswordRequest{Name: "nopass-user"})
+	require.NoErrorf(t, err, "expected no error, got %v", err)
+}
