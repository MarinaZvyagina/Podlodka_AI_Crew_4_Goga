index fae37161d..96e2dbf62 100644
--- a/server/auth/store_test.go
+++ b/server/auth/store_test.go
@@ -174,6 +174,25 @@ func TestUserAdd(t *testing.T) {
 	require.Truef(t, ok, "user %s should be added but it doesn't exist in rangePermCache", userName)
 }
 
+func TestUserAddWithEmptyPassword(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	// adding a user without a password (and without opting into NoPassword) must fail
+	ua := &pb.AuthUserAddRequest{Name: "no-password-user", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	// the user must not have been created
+	_, ok := as.rangePermCache["no-password-user"]
+	require.Falsef(t, ok, "user should not have been added with an empty password")
+
+	// an explicit NoPassword account must still be created successfully
+	ua = &pb.AuthUserAddRequest{Name: "no-password-user", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err = as.UserAdd(ua)
+	require.NoErrorf(t, err, "expected no error, got %v", err)
+}
+
 func TestRecover(t *testing.T) {
