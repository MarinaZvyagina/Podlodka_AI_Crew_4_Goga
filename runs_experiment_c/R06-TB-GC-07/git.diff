+	le.mu.RLock()
+	l := le.leaseMap[id]
+	maxKeysPerLease := le.maxKeysPerLease
+	le.mu.RUnlock()
+
+	if l == nil {
+		return ErrLeaseNotFound
+	}
+	if maxKeysPerLease <= 0 {
+		return nil
+	}
+
+	l.mu.RLock()
+	current := len(l.itemSet)
+	l.mu.RUnlock()
+
+	if int64(current+additionalKeys) > maxKeysPerLease {
+		return ErrTooManyKeys
+	}
+	return nil
