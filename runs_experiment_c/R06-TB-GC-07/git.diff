+// leaseAttachBudget tracks, for the duration of validating a single Put or
+// Txn request, how many new keys are pending attachment to each lease. This
+// lets every operation in the request be validated together against the
+// per-lease key limit before any of them are applied: several Put
+// operations in one Txn that each individually stay under the limit could
+// otherwise collectively push a lease over it.
+type leaseAttachBudget struct {
+	lessor  lease.Lessor
+	pending map[lease.LeaseID]map[string]struct{}
+}
+
+func newLeaseAttachBudget(lessor lease.Lessor) *leaseAttachBudget {
+	return &leaseAttachBudget{lessor: lessor, pending: make(map[lease.LeaseID]map[string]struct{})}
+}
+
+// reserve checks whether attaching key to leaseID is allowed: either the key
+// is already attached to leaseID (a no-op re-attach, always allowed), or
+// attaching it keeps the lease within its configured key limit. Keys that
+// pass the check are remembered so later reserve calls for the same request
+// see them.
+func (b *leaseAttachBudget) reserve(leaseID lease.LeaseID, key []byte) error {
+	if b.lessor.GetLease(lease.LeaseItem{Key: string(key)}) == leaseID {
+		return nil
+	}
+
+	ks := string(key)
+	if keys := b.pending[leaseID]; keys != nil {
+		if _, ok := keys[ks]; ok {
+			return nil
+		}
+	}
+
+	if err := b.lessor.CheckKeyLimit(leaseID, len(b.pending[leaseID])+1); err != nil {
+		return err
+	}
+
+	if b.pending[leaseID] == nil {
+		b.pending[leaseID] = make(map[string]struct{})
 	}
+	b.pending[leaseID][ks] = struct{}{}
 	return nil
 }
 
