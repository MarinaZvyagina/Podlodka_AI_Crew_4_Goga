+
+package v3rpc
+
+import (
+	"context"
+	"errors"
+	"sort"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/server/v3/auth"
+)
+
+type fakeAuthInfoProvider struct {
+	info *auth.AuthInfo
+	err  error
+}
+
+func (f fakeAuthInfoProvider) AuthInfoFromCtx(context.Context) (*auth.AuthInfo, error) {
+	return f.info, f.err
+}
+
+func TestAuditCallerIdentity(t *testing.T) {
+	tests := []struct {
+		name     string
+		provider fakeAuthInfoProvider
+		want     string
+	}{
+		{"auth disabled", fakeAuthInfoProvider{nil, nil}, "unauthenticated"},
+		{"lookup error", fakeAuthInfoProvider{nil, errors.New("boom")}, "unauthenticated"},
+		{"empty username", fakeAuthInfoProvider{&auth.AuthInfo{Username: ""}, nil}, "unauthenticated"},
+		{"authenticated", fakeAuthInfoProvider{&auth.AuthInfo{Username: "alice"}, nil}, "alice"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, auditCallerIdentity(context.Background(), tt.provider))
+		})
+	}
+}
+
+func TestAuditOperationKind(t *testing.T) {
+	tests := []struct {
+		method string
+		want   string
+	}{
+		{"/etcdserverpb.KV/Range", "read"},
+		{"/etcdserverpb.KV/Put", "write"},
+		{"/etcdserverpb.KV/DeleteRange", "delete"},
+		{"/etcdserverpb.KV/Txn", "transaction"},
+		{"/etcdserverpb.KV/SomeFutureRPC", "unknown"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.method, func(t *testing.T) {
+			assert.Equal(t, tt.want, auditOperationKind(tt.method))
+		})
+	}
+}
+
+func TestAuditKeyFields(t *testing.T) {
+	t.Run("range", func(t *testing.T) {
+		fields := auditKeyFields(&pb.RangeRequest{Key: []byte("a"), RangeEnd: []byte("z")})
+		assert.Len(t, fields, 2)
+	})
+	t.Run("put has no range end", func(t *testing.T) {
+		fields := auditKeyFields(&pb.PutRequest{Key: []byte("a")})
+		assert.Len(t, fields, 1)
+	})
+	t.Run("delete range without range end", func(t *testing.T) {
+		fields := auditKeyFields(&pb.DeleteRangeRequest{Key: []byte("a")})
+		assert.Len(t, fields, 1)
+	})
+	t.Run("unrecognized request has no key fields", func(t *testing.T) {
+		fields := auditKeyFields(&pb.CompactionRequest{})
+		assert.Nil(t, fields)
+	})
+}
+
+func TestAuditTxnKeys(t *testing.T) {
+	txn := &pb.TxnRequest{
+		Compare: []*pb.Compare{{Key: []byte("cmp")}},
+		Success: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte("put")}}},
+			{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+				Success: []*pb.RequestOp{
+					{Request: &pb.RequestOp_RequestDeleteRange{RequestDeleteRange: &pb.DeleteRangeRequest{Key: []byte("a"), RangeEnd: []byte("z")}}},
+				},
+			}}},
+		},
+		Failure: []*pb.RequestOp{
+			{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte("cmp")}}},
+		},
+	}
+
+	keys := auditTxnKeys(txn)
+	sort.Strings(keys)
+	assert.Equal(t, []string{"a..z", "cmp", "put"}, keys)
+}
