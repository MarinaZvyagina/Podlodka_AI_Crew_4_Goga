@@ -1,13 +1,28 @@
 package mihon.domain.extension.interactor
 
 import dev.zacsweers.metro.Inject
+import mihon.domain.extension.model.InvalidExtensionStoreUrlException
 import mihon.domain.extension.repository.ExtensionStoreRepository
+import java.net.URI
+import java.net.URISyntaxException
 
 @Inject
 class AddExtensionStore(
     private val repository: ExtensionStoreRepository,
 ) {
     suspend operator fun invoke(indexUrl: String): Result<Unit> {
+        if (!isValidIndexUrl(indexUrl)) {
+            return Result.failure(InvalidExtensionStoreUrlException())
+        }
         return repository.insert(indexUrl)
     }
+
+    private fun isValidIndexUrl(indexUrl: String): Boolean {
+        val scheme = try {
+            URI(indexUrl).scheme
+        } catch (_: URISyntaxException) {
+            return false
+        }
+        return scheme.equals("http", ignoreCase = true) || scheme.equals("https", ignoreCase = true)
+    }
 }
