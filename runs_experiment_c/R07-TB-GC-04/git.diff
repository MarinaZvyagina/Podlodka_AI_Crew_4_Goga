@@ -0,0 +1,18 @@
+package eu.kanade.domain.manga.interactor
+
+import dev.zacsweers.metro.Inject
+import tachiyomi.data.Database
+
+@Inject
+class SetMangaUpdatesSnooze(
+    private val database: Database,
+) {
+
+    suspend fun await(mangaId: Long, snoozedUntil: Long) {
+        database.updates_snoozesQueries.upsert(mangaId, snoozedUntil)
+    }
+
+    suspend fun clear(mangaId: Long) {
+        database.updates_snoozesQueries.remove(mangaId)
+    }
+}
diff --git a/app/src/main/java/eu/kanade/presentation/components/UpdatesSnoozeDialog.kt b/app/src/main/java/eu/kanade/presentation/components/UpdatesSnoozeDialog.kt
new file mode 100644
index 0000000..76f7a3b
--- /dev/null
+++ b/app/src/main/java/eu/kanade/presentation/components/UpdatesSnoozeDialog.kt
@@ -0,0 +1,124 @@
+package eu.kanade.presentation.components
+
+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.AlertDialog
+import androidx.compose.material3.DatePicker
+import androidx.compose.material3.SelectableDates
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.material3.rememberDatePickerState
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import dev.icerock.moko.resources.StringResource
+import tachiyomi.i18n.MR
+import tachiyomi.presentation.core.i18n.stringResource
+import kotlin.time.Clock
+import kotlin.time.Duration.Companion.days
+
+enum class UpdatesSnoozeDuration(val titleRes: StringResource) {
+    TOMORROW(MR.strings.updates_snooze_tomorrow) {
+        override fun untilMillis(): Long = (Clock.System.now() + 1.days).toEpochMilliseconds()
+    },
+    NEXT_WEEK(MR.strings.updates_snooze_next_week) {
+        override fun untilMillis(): Long = (Clock.System.now() + 7.days).toEpochMilliseconds()
+    },
+    ;
+
+    abstract fun untilMillis(): Long
+}
+
+@Composable
+fun UpdatesSnoozeDialog(
+    isSnoozed: Boolean,
+    onDismissRequest: () -> Unit,
+    onSnooze: (untilMillis: Long) -> Unit,
+    onClear: () -> Unit,
+) {
+    var showCustomDatePicker by remember { mutableStateOf(false) }
+
+    if (showCustomDatePicker) {
+        val pickerState = rememberDatePickerState(
+            initialSelectedDateMillis = (Clock.System.now() + 1.days).toEpochMilliseconds(),
+            selectableDates = object : SelectableDates {
+                override fun isSelectableDate(utcTimeMillis: Long): Boolean {
+                    return utcTimeMillis >= Clock.System.now().toEpochMilliseconds()
+                }
+            },
+        )
+        AlertDialog(
+            onDismissRequest = onDismissRequest,
+            title = { Text(text = stringResource(MR.strings.updates_snooze_custom_date)) },
+            text = { DatePicker(state = pickerState, title = null, headline = null, showModeToggle = false) },
+            dismissButton = {
+                TextButton(onClick = onDismissRequest) {
+                    Text(text = stringResource(MR.strings.action_cancel))
+                }
+            },
+            confirmButton = {
+                TextButton(
+                    onClick = {
+                        val millis = pickerState.selectedDateMillis
+                        if (millis != null) onSnooze(millis)
+                        onDismissRequest()
+                    },
+                ) {
+                    Text(text = stringResource(MR.strings.action_ok))
+                }
+            },
+        )
+        return
+    }
+
+    AlertDialog(
+        onDismissRequest = onDismissRequest,
+        title = { Text(text = stringResource(MR.strings.updates_snooze_title)) },
+        text = {
+            Column {
+                UpdatesSnoozeDuration.entries.forEach { duration ->
+                    Text(
+                        text = stringResource(duration.titleRes),
+                        modifier = Modifier
+                            .fillMaxWidth()
+                            .clickable {
+                                onSnooze(duration.untilMillis())
+                                onDismissRequest()
+                            }
+                            .padding(vertical = 12.dp),
+                    )
+                }
+                Text(
+                    text = stringResource(MR.strings.updates_snooze_custom_date),
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .clickable { showCustomDatePicker = true }
+                        .padding(vertical = 12.dp),
+                )
+            }
+        },
+        dismissButton = {
+            TextButton(onClick = onDismissRequest) {
+                Text(text = stringResource(MR.strings.action_cancel))
+            }
+        },
+        confirmButton = {
+            if (isSnoozed) {
+                TextButton(
+                    onClick = {
+                        onClear()
+                        onDismissRequest()
+                    },
+                ) {
+                    Text(text = stringResource(MR.strings.updates_snooze_clear))
+                }
+            }
+        },
+    )
+}
