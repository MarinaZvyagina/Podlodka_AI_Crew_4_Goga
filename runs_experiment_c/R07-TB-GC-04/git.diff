@@ -0,0 +1,25 @@
+package eu.kanade.domain.manga.interactor
+
+import app.cash.sqldelight.async.coroutines.awaitAsOneOrNull
+import dev.zacsweers.metro.Inject
+import kotlinx.coroutines.flow.Flow
+import tachiyomi.data.Database
+import tachiyomi.data.subscribeToOneOrNull
+
+@Inject
+class GetMangaUpdatesSnooze(
+    private val database: Database,
+) {
+
+    suspend fun await(mangaId: Long): Long? {
+        return database.updates_snoozesQueries
+            .getSnoozedUntilByMangaId(mangaId)
+            .awaitAsOneOrNull()
+    }
+
+    fun subscribe(mangaId: Long): Flow<Long?> {
+        return database.updates_snoozesQueries
+            .getSnoozedUntilByMangaId(mangaId)
+            .subscribeToOneOrNull()
+    }
+}
diff --git a/app/src/main/java/eu/kanade/domain/manga/interactor/SetMangaUpdatesSnooze.kt b/app/src/main/java/eu/kanade/domain/manga/interactor/SetMangaUpdatesSnooze.kt
