--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/updates/MangaSnoozeRepositoryImpl.kt
@@ -0,0 +1,34 @@
+package tachiyomi.data.updates
+
+import app.cash.sqldelight.async.coroutines.awaitAsOneOrNull
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.ContributesBinding
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import tachiyomi.data.Database
+import tachiyomi.domain.updates.repository.MangaSnoozeRepository
+
+@Inject
+@SingleIn(AppScope::class)
+@ContributesBinding(AppScope::class)
+class MangaSnoozeRepositoryImpl(
+    private val database: Database,
+) : MangaSnoozeRepository {
+
+    override suspend fun getSnoozedUntil(mangaId: Long): Long? {
+        return database.manga_snoozeQueries
+            .getSnoozedUntil(mangaId)
+            .awaitAsOneOrNull()
+    }
+
+    override suspend fun snooze(mangaId: Long, until: Long) {
+        database.manga_snoozeQueries.upsert(
+            mangaId = mangaId,
+            snoozedUntil = until,
+        )
+    }
+
+    override suspend fun clear(mangaId: Long) {
+        database.manga_snoozeQueries.clear(mangaId)
+    }
+}
