+package tachiyomi.domain.updates.interactor
+
+import dev.zacsweers.metro.Inject
+import tachiyomi.domain.updates.repository.MangaSnoozeRepository
+
+@Inject
+class SetMangaUpdatesSnooze(
+    private val repository: MangaSnoozeRepository,
+) {
+
+    suspend fun await(mangaId: Long, until: Long) {
+        repository.snooze(mangaId, until)
+    }
+
+    suspend fun awaitAll(mangaIds: Collection<Long>, until: Long) {
+        mangaIds.forEach { repository.snooze(it, until) }
+    }
+}
