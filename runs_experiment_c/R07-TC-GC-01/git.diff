+    val title: String,
+    @SerialName("cover_url")
+    val coverUrl: String? = null,
+    @SerialName("total_chapters")
+    val totalChapters: Long = 0,
+)
+
+@Serializable
+data class LRLibraryEntry(
+    @SerialName("library_id")
+    val libraryId: Long,
+    @SerialName("series_id")
+    val seriesId: Long,
+    val status: Long,
+    @SerialName("last_chapter_read")
+    val lastChapterRead: Double = 0.0,
+    @SerialName("total_chapters")
+    val totalChapters: Long = 0,
+)
+
+@Serializable
+data class LRUser(
+    val username: String,
+)
