@@ -0,0 +1,127 @@
+package eu.kanade.tachiyomi.data.track.librereader
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRLibraryEntry
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRSeries
+import eu.kanade.tachiyomi.data.track.librereader.dto.LRUser
+import eu.kanade.tachiyomi.network.DELETE
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.PUT
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.network.parseAs
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import okhttp3.Credentials
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import uy.kohesive.injekt.injectLazy
+
+class LibreReaderApi(
+    private val interceptor: LibreReaderInterceptor,
+    private val client: OkHttpClient,
+) {
+    private val json: Json by injectLazy()
+
+    private val authClient by lazy {
+        client.newBuilder()
+            .addInterceptor(interceptor)
+            .build()
+    }
+
+    suspend fun authenticate(apiUrl: String, username: String, password: String): LRUser {
+        val request = Request.Builder()
+            .url("$apiUrl/api/me")
+            .header("Authorization", Credentials.basic(username, password))
+            .build()
+
+        return with(json) {
+            client.newCall(request)
+                .awaitSuccess()
+                .parseAs<LRUser>()
+        }
+    }
+
+    suspend fun search(apiUrl: String, query: String): List<LRSeries> {
+        val url = "$apiUrl/api/series/search".toHttpUrl().newBuilder()
+            .addQueryParameter("query", query)
+            .build()
+
+        return with(json) {
+            authClient.newCall(GET(url.toString()))
+                .awaitSuccess()
+                .parseAs<List<LRSeries>>()
+        }
+    }
+
+    suspend fun findLibraryEntry(apiUrl: String, seriesId: Long): LRLibraryEntry? {
+        val url = "$apiUrl/api/library".toHttpUrl().newBuilder()
+            .addQueryParameter("series_id", seriesId.toString())
+            .build()
+
+        val entries = with(json) {
+            authClient.newCall(GET(url.toString()))
+                .awaitSuccess()
+                .parseAs<List<LRLibraryEntry>>()
+        }
+        return entries.firstOrNull()
+    }
+
+    suspend fun getLibraryEntry(apiUrl: String, libraryId: Long): LRLibraryEntry {
+        return with(json) {
+            authClient.newCall(GET("$apiUrl/api/library/$libraryId"))
+                .awaitSuccess()
+                .parseAs<LRLibraryEntry>()
+        }
+    }
+
+    suspend fun addLibraryEntry(apiUrl: String, track: Track): LRLibraryEntry {
+        return with(json) {
+            authClient.newCall(
+                POST(
+                    url = "$apiUrl/api/library",
+                    body = libraryEntryBody(track).toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<LRLibraryEntry>()
+        }
+    }
+
+    suspend fun updateLibraryEntry(apiUrl: String, track: Track): LRLibraryEntry {
+        return with(json) {
+            authClient.newCall(
+                PUT(
+                    url = "$apiUrl/api/library/${track.library_id}",
+                    body = libraryEntryBody(track).toRequestBody(CONTENT_TYPE),
+                ),
+            )
+                .awaitSuccess()
+                .parseAs<LRLibraryEntry>()
+        }
+    }
+
+    suspend fun deleteLibraryEntry(apiUrl: String, libraryId: Long) {
+        authClient.newCall(DELETE(url = "$apiUrl/api/library/$libraryId"))
+            .awaitSuccess()
+    }
+
+    private fun libraryEntryBody(track: Track): String {
+        return buildJsonObject {
+            put("series_id", track.remote_id)
+            put("status", track.status)
+            put("last_chapter_read", track.last_chapter_read)
+            if (track.score > 0.0) {
+                put("score", track.score)
+            }
+        }.toString()
+    }
+
+    companion object {
+        private val CONTENT_TYPE = "application/json".toMediaType()
+    }
+}
