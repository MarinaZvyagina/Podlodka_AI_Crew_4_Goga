+package eu.kanade.tachiyomi.data.track.librereader.dto
+
+import eu.kanade.tachiyomi.data.database.models.Track
+import eu.kanade.tachiyomi.data.track.model.TrackSearch
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class LRUser(
+    val username: String,
+)
+
+@Serializable
+data class LRSeries(
+    val id: Long,
+    val title: String,
+    val author: String = "",
+    val coverUrl: String = "",
+    val description: String = "",
+    val totalChapters: Long = 0,
+)
+
+@Serializable
+data class LRSearchResult(
+    val results: List<LRSeries> = emptyList(),
+)
+
+@Serializable
+data class LRLibraryEntry(
+    val id: Long,
+    val seriesId: Long,
+    val seriesTitle: String,
+    val status: Long,
+    val progress: Double,
+    val totalChapters: Long = 0,
+)
+
+fun parseSearchItem(series: LRSeries, trackerId: Long): TrackSearch {
+    return TrackSearch.create(trackerId).apply {
+        remote_id = series.id
+        title = series.title
+        total_chapters = series.totalChapters
+        summary = series.description
+        cover_url = series.coverUrl
+        authors = if (series.author.isNotBlank()) listOf(series.author) else emptyList()
+        tracking_url = ""
+    }
+}
+
+fun Track.copyFrom(entry: LRLibraryEntry): Track = apply {
+    library_id = entry.id
+    remote_id = entry.seriesId
+    title = entry.seriesTitle
+    last_chapter_read = entry.progress
+    total_chapters = entry.totalChapters
+    status = entry.status
+}
