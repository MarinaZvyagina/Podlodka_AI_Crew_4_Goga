+
+package org.thoughtcrime.securesms.database
+
+import android.app.Application
+import android.content.ContentValues
+import android.content.Context
+import androidx.test.core.app.ApplicationProvider
+import assertk.assertThat
+import assertk.assertions.isEqualTo
+import assertk.assertions.isFalse
+import assertk.assertions.isTrue
+import org.junit.Before
+import org.junit.BeforeClass
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.testutil.MockAppDependenciesRule
+import org.thoughtcrime.securesms.testutil.SignalDatabaseRule
+import org.thoughtcrime.securesms.testutil.SystemOutLogger
+import java.io.File
+import kotlin.time.Duration
+
+@Suppress("ClassName")
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class AttachmentTableTest_deleteAbandonedAttachmentFiles {
+
+  @get:Rule
+  val signalDatabaseRule = SignalDatabaseRule()
+
+  @get:Rule
+  val appDependencies = MockAppDependenciesRule()
+
+  private lateinit var partsDirectory: File
+
+  companion object {
+    @BeforeClass
+    @JvmStatic
+    fun setUpClass() {
+      Log.initialize(SystemOutLogger())
+    }
+  }
+
+  @Before
+  fun setUp() {
+    partsDirectory = ApplicationProvider.getApplicationContext<Context>().getDir("parts", Context.MODE_PRIVATE)
+  }
+
+  @Test
+  fun givenFileNotReferencedByAnyAttachment_whenDeletingAbandonedFiles_thenFileIsDeleted() {
+    val orphan = createPartFile("orphan1")
+
+    val result = SignalDatabase.attachments.deleteAbandonedAttachmentFiles(timeBudget = Duration.INFINITE)
+
+    assertThat(result.deletedCount).isEqualTo(1)
+    assertThat(result.hasMoreToDelete).isFalse()
+    assertThat(orphan.exists()).isFalse()
+  }
+
+  @Test
+  fun givenFileReferencedAsThumbnail_whenDeletingAbandonedFiles_thenFileIsPreserved() {
+    val thumbnail = createPartFile("thumb1")
+    val messageId = insertMessage()
+    insertAttachment(messageId = messageId, thumbnailFile = thumbnail.absolutePath)
+
+    val result = SignalDatabase.attachments.deleteAbandonedAttachmentFiles(timeBudget = Duration.INFINITE)
+
+    assertThat(result.deletedCount).isEqualTo(0)
+    assertThat(thumbnail.exists()).isTrue()
+  }
+
+  @Test
+  fun givenMoreOrphansThanTimeBudgetAllows_whenDeletingAbandonedFilesRepeatedly_thenLaterCallsMakeForwardProgress() {
+    val orphans = (1..5).map { createPartFile("orphan_batch_$it") }
+
+    // A zero time budget shouldn't delete anything, but should report there's more work to do.
+    val first = SignalDatabase.attachments.deleteAbandonedAttachmentFiles(timeBudget = Duration.ZERO)
+    assertThat(first.deletedCount).isEqualTo(0)
+    assertThat(first.hasMoreToDelete).isTrue()
+    orphans.forEach { assertThat(it.exists()).isTrue() }
+
+    // A later, unbounded call finishes the work the first one couldn't get to.
+    val second = SignalDatabase.attachments.deleteAbandonedAttachmentFiles(timeBudget = Duration.INFINITE)
+    assertThat(second.deletedCount).isEqualTo(5)
+    assertThat(second.hasMoreToDelete).isFalse()
+    orphans.forEach { assertThat(it.exists()).isFalse() }
+  }
+
+  // region helpers
+
+  private fun createPartFile(name: String): File {
+    val file = File(partsDirectory, name)
+    file.writeText("x")
+    return file
+  }
+
+  private fun insertMessage(): Long {
+    return TestSms.insert(signalDatabaseRule.writeableDatabase)
+  }
+
+  private fun insertAttachment(messageId: Long, thumbnailFile: String?): Long {
+    return SignalDatabase.writableDatabase.insert(
+      AttachmentTable.TABLE_NAME,
+      null,
+      ContentValues().apply {
+        put(AttachmentTable.MESSAGE_ID, messageId)
+        put(AttachmentTable.TRANSFER_STATE, AttachmentTable.TRANSFER_PROGRESS_DONE)
+        put(AttachmentTable.CONTENT_TYPE, "image/jpeg")
+        if (thumbnailFile != null) put(AttachmentTable.THUMBNAIL_FILE, thumbnailFile)
+      }
+    )
+  }
+
+  // endregion
+}
