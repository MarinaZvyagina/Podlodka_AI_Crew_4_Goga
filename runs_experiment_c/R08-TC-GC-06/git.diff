diff --git a/app/src/main/java/org/thoughtcrime/securesms/service/DeleteAbandonedAttachmentFilesRoutineListener.kt b/app/src/main/java/org/thoughtcrime/securesms/service/DeleteAbandonedAttachmentFilesRoutineListener.kt
