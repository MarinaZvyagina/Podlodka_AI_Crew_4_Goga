+package org.thoughtcrime.securesms.service
+
+import android.content.Context
+import org.thoughtcrime.securesms.jobs.DeleteAbandonedAttachmentFilesRoutineJob
+import org.thoughtcrime.securesms.keyvalue.SignalStore
+import org.thoughtcrime.securesms.util.toMillis
+import java.security.SecureRandom
+import java.time.LocalDateTime
+
+/**
+ * Schedules a periodic sweep for orphaned attachment/thumbnail cache files, roughly once a day. The job it
+ * enqueues, [DeleteAbandonedAttachmentFilesRoutineJob], is what actually does the work (and is safe to enqueue
+ * repeatedly, since it caps itself at a single running instance).
+ */
+class DeleteAbandonedAttachmentFilesRoutineListener : PersistentAlarmManagerListener() {
+  companion object {
+    @JvmStatic
+    fun schedule(context: Context?) {
+      DeleteAbandonedAttachmentFilesRoutineListener().onReceive(context, getScheduleIntent())
+    }
+  }
+
+  override fun getNextScheduledExecutionTime(context: Context): Long {
+    var nextTime = SignalStore.misc.nextAbandonedAttachmentFilesCleanupTime
+
+    if (nextTime == 0L) {
+      nextTime = getNextTime()
+      SignalStore.misc.nextAbandonedAttachmentFilesCleanupTime = nextTime
+    }
+
+    return nextTime
+  }
+
+  override fun onAlarm(context: Context, scheduledTime: Long): Long {
+    DeleteAbandonedAttachmentFilesRoutineJob.enqueue()
+
+    val nextTime = getNextTime()
+    SignalStore.misc.nextAbandonedAttachmentFilesCleanupTime = nextTime
+
+    return nextTime
+  }
+
+  private fun getNextTime(): Long {
+    val random = SecureRandom()
+    return LocalDateTime
+      .now()
+      .plusDays(1)
+      .withHour(1 + random.nextInt(4))
+      .withMinute(random.nextInt(60))
+      .withSecond(random.nextInt(60))
+      .toMillis()
+  }
+}
