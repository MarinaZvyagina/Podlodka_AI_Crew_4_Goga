+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.jobs
+
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.SignalDatabase.Companion.attachments
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.JsonJobData
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * Periodically sweeps attachment/thumbnail files that are no longer referenced by any attachment, sticker, or
+ * message and deletes them. Thumbnails live in the same on-disk pool as full attachment data (see
+ * [org.thoughtcrime.securesms.database.AttachmentTable]) and are only identifiable as orphaned by diffing that
+ * pool against the database, so this is what actually reclaims orphaned thumbnail/preview files left behind
+ * after their attachment or message is deleted.
+ *
+ * Unlike [DeleteAbandonedAttachmentsJob] (fired opportunistically right after operations likely to abandon a
+ * file), this job is scheduled on its own recurring cadence by
+ * [org.thoughtcrime.securesms.service.DeleteAbandonedAttachmentFilesRoutineListener], so orphaned files still get
+ * cleaned up even if a triggering event was missed. It only runs while not on an active call and while the
+ * battery isn't critically low, and at the lowest job priority so it never competes with user-facing work.
+ *
+ * A pass processes files in small batches, checkpointing the still-pending paths between batches, so a pass that
+ * gets killed partway through (e.g. the process dies) resumes with the remaining files on its next attempt
+ * instead of re-scanning the whole disk/database or losing its place entirely.
+ */
+class DeleteAbandonedAttachmentFilesRoutineJob private constructor(
+  parameters: Parameters,
+  private var pendingPaths: List<String>?
+) : Job(parameters) {
+
+  companion object {
+    private val TAG = Log.tag(DeleteAbandonedAttachmentFilesRoutineJob::class)
+    const val KEY = "DeleteAbandonedAttachmentFilesRoutineJob"
+
+    private const val KEY_PENDING_PATHS = "pending_paths"
+    private const val BATCH_SIZE = 200
+
+    @JvmStatic
+    fun enqueue() {
+      AppDependencies.jobManager.add(DeleteAbandonedAttachmentFilesRoutineJob())
+    }
+  }
+
+  constructor() : this(
+    parameters = Parameters.Builder()
+      .setMaxInstancesForFactory(1)
+      .setMaxAttempts(Parameters.UNLIMITED)
+      .setGlobalPriority(Parameters.PRIORITY_LOWER)
+      .addConstraint(NotInCallConstraint.KEY)
+      .addConstraint(BatteryNotLowConstraint.KEY)
+      .build(),
+    pendingPaths = null
+  )
+
+  override fun serialize(): ByteArray? {
+    val paths = pendingPaths ?: return null
+
+    return JsonJobData.Builder()
+      .putStringListAsArray(KEY_PENDING_PATHS, paths)
+      .build()
+      .serialize()
+  }
+
+  override fun getFactoryKey(): String = KEY
+
+  override fun onFailure() = Unit
+
+  override fun run(): Result {
+    val remaining = pendingPaths ?: attachments.findAbandonedAttachmentFiles()
+
+    if (remaining.isEmpty()) {
+      Log.i(TAG, "No abandoned attachment/thumbnail files found.")
+      return Result.success()
+    }
+
+    val batch = remaining.take(BATCH_SIZE)
+    val deleted = attachments.deleteAttachmentFiles(batch)
+    Log.i(TAG, "Deleted $deleted/${batch.size} abandoned attachment/thumbnail files this batch.")
+
+    val next = remaining.drop(batch.size)
+    if (next.isEmpty()) {
+      return Result.success()
+    }
+
+    pendingPaths = next
+    return Result.retry(1.seconds.inWholeMilliseconds)
+  }
+
+  class Factory : Job.Factory<DeleteAbandonedAttachmentFilesRoutineJob> {
+    override fun create(parameters: Parameters, serializedData: ByteArray?): DeleteAbandonedAttachmentFilesRoutineJob {
+      val data = JsonJobData.deserialize(serializedData)
+      val pendingPaths = if (data.hasStringArray(KEY_PENDING_PATHS)) data.getStringArrayAsList(KEY_PENDING_PATHS) else null
+
+      return DeleteAbandonedAttachmentFilesRoutineJob(parameters, pendingPaths)
+    }
+  }
+}
