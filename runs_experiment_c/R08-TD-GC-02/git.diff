--- /dev/null
+++ b/app/src/main/java/org/thoughtcrime/securesms/search/SearchResultCache.java
@@ -0,0 +1,26 @@
+package org.thoughtcrime.securesms.search;
+
+import androidx.annotation.NonNull;
+
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.function.Supplier;
+
+/**
+ * Thread-safe get-or-compute cache keyed by arbitrary equality. This class has no way to know
+ * when the data a cached value was computed from has changed, so callers own invalidation: call
+ * {@link #invalidateAll()} whenever that data may have changed.
+ */
+class SearchResultCache<K, V> {
+
+  private final Map<K, V> cache = new ConcurrentHashMap<>();
+
+  @NonNull
+  V getOrCompute(@NonNull K key, @NonNull Supplier<V> compute) {
+    return cache.computeIfAbsent(key, ignored -> compute.get());
+  }
+
+  void invalidateAll() {
+    cache.clear();
+  }
+}
