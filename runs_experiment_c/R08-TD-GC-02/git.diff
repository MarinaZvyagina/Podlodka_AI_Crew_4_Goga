+
+package org.thoughtcrime.securesms.search
+
+import assertk.assertThat
+import assertk.assertions.isEqualTo
+import assertk.assertions.isSameAs
+import org.junit.Test
+
+class SearchResultCacheTest {
+
+  @Test
+  fun getOrComputeOnlyInvokesSupplierOnceForRepeatedKey() {
+    val cache = SearchResultCache<String, String>()
+    var computeCount = 0
+
+    val first = cache.getOrCompute("hello") { computeCount++; "result" }
+    val second = cache.getOrCompute("hello") { computeCount++; "result" }
+
+    assertThat(computeCount).isEqualTo(1)
+    assertThat(first).isSameAs(second)
+  }
+
+  @Test
+  fun getOrComputeTreatsDifferentKeysIndependently() {
+    val cache = SearchResultCache<String, String>()
+    var computeCount = 0
+
+    val hello = cache.getOrCompute("hello") { computeCount++; "hello-result" }
+    val world = cache.getOrCompute("world") { computeCount++; "world-result" }
+
+    assertThat(computeCount).isEqualTo(2)
+    assertThat(hello).isEqualTo("hello-result")
+    assertThat(world).isEqualTo("world-result")
+  }
+
+  @Test
+  fun invalidateAllForcesRecomputeOnNextGet() {
+    val cache = SearchResultCache<String, String>()
+    var computeCount = 0
+
+    cache.getOrCompute("hello") { computeCount++; "result-$computeCount" }
+    cache.invalidateAll()
+    val afterInvalidate = cache.getOrCompute("hello") { computeCount++; "result-$computeCount" }
+
+    assertThat(computeCount).isEqualTo(2)
+    assertThat(afterInvalidate).isEqualTo("result-2")
+  }
+}
