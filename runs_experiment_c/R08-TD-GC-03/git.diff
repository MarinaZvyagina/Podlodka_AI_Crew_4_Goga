+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import android.app.Application
+import android.util.LruCache
+import assertk.assertThat
+import assertk.assertions.isFalse
+import assertk.assertions.isTrue
+import io.mockk.Runs
+import io.mockk.every
+import io.mockk.just
+import io.mockk.slot
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.thoughtcrime.securesms.database.DatabaseObserver
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.testutil.MockAppDependenciesRule
+import org.thoughtcrime.securesms.testutil.SignalDatabaseRule
+import java.util.concurrent.atomic.AtomicBoolean
+
+/**
+ * Covers the result cache added to [SearchRepository.queryThreadsSync] / [SearchRepository.queryMessagesSync]:
+ * repeating an identical search must skip the underlying query, distinct queries must not share an
+ * entry, and a relevant database change must force the next identical search to recompute.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class SearchRepositoryCacheTest {
+
+  @get:Rule
+  val appDependencies = MockAppDependenciesRule()
+
+  @get:Rule
+  val signalDatabaseRule = SignalDatabaseRule()
+
+  @Before
+  fun setUp() {
+    resetSearchRepositoryCacheState()
+  }
+
+  @Test
+  fun `identical search is served from cache until a relevant database change occurs`() {
+    val conversationListObserver = slot<DatabaseObserver.Observer>()
+    every { AppDependencies.databaseObserver.registerConversationListObserver(capture(conversationListObserver)) } just Runs
+    every { AppDependencies.databaseObserver.registerMessageUpdateObserver(any()) } just Runs
+
+    val repository = SearchRepository("Note to Self")
+
+    val first = repository.queryThreadsSync("alice", false)
+    val second = repository.queryThreadsSync("alice", false)
+    assertThat(second === first).isTrue()
+
+    val differentQuery = repository.queryThreadsSync("bob", false)
+    assertThat(differentQuery === first).isFalse()
+
+    conversationListObserver.captured.onChanged()
+
+    val afterInvalidation = repository.queryThreadsSync("alice", false)
+    assertThat(afterInvalidation === first).isFalse()
+  }
+
+  @Test
+  fun `identical message search is served from cache until a message changes`() {
+    val messageUpdateObserver = slot<DatabaseObserver.MessageObserver>()
+    every { AppDependencies.databaseObserver.registerConversationListObserver(any()) } just Runs
+    every { AppDependencies.databaseObserver.registerMessageUpdateObserver(capture(messageUpdateObserver)) } just Runs
+
+    val repository = SearchRepository("Note to Self")
+
+    val first = repository.queryMessagesSync("hello", SearchFilter.EMPTY)
+    val second = repository.queryMessagesSync("hello", SearchFilter.EMPTY)
+    assertThat(second === first).isTrue()
+
+    messageUpdateObserver.captured.onMessageChanged(org.thoughtcrime.securesms.database.model.MessageId(1))
+
+    val afterInvalidation = repository.queryMessagesSync("hello", SearchFilter.EMPTY)
+    assertThat(afterInvalidation === first).isFalse()
+  }
+
+  /**
+   * [SearchRepository]'s caches and its one-time [DatabaseObserver] registration are held in
+   * static fields scoped to the whole test process (like [AppDependencies] itself), so tests must
+   * reset them to avoid depending on ordering or leaking state between test methods.
+   */
+  private fun resetSearchRepositoryCacheState() {
+    val repositoryClass = SearchRepository::class.java
+
+    val registeredField = repositoryClass.getDeclaredField("cacheInvalidationRegistered")
+    registeredField.isAccessible = true
+    (registeredField.get(null) as AtomicBoolean).set(false)
+
+    listOf("threadSearchCache", "messageSearchCache").forEach { fieldName ->
+      val field = repositoryClass.getDeclaredField(fieldName)
+      field.isAccessible = true
+      (field.get(null) as LruCache<*, *>).evictAll()
+    }
+  }
+}
