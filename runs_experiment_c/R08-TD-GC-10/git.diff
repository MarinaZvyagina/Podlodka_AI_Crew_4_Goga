@@ -0,0 +1,97 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.search
+
+import android.app.Application
+import assertk.assertThat
+import assertk.assertions.hasSize
+import assertk.assertions.isNotSameInstanceAs
+import assertk.assertions.isSameInstanceAs
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.testutil.RecipientTestRule
+import java.util.UUID
+
+/**
+ * Verifies that [SearchRepository] caches repeated identical searches and invalidates that cache
+ * whenever the underlying data could have changed, using a real in-memory database so the FTS
+ * query path is exercised end to end.
+ *
+ * [AppDependencies.databaseObserver] is a relaxed mock in tests (see
+ * [org.thoughtcrime.securesms.dependencies.MockApplicationDependencyProvider]) and never actually
+ * dispatches to registered listeners, so invalidation is exercised via
+ * [SearchRepository.invalidateCachesForTests] -- the same code a real notification runs -- while a
+ * separate assertion confirms the repository actually registers with the observer.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class SearchRepositoryCacheTest {
+
+  @get:Rule
+  val recipients = RecipientTestRule()
+
+  private lateinit var repository: SearchRepository
+
+  @Before
+  fun setUp() {
+    SearchRepository.resetCacheStateForTests()
+    repository = SearchRepository("Note to Self")
+  }
+
+  @Test
+  fun `repeating an identical message search returns the cached result`() {
+    val term = uniqueTerm()
+    val recipientId = recipients.createRecipient("Cache Test One")
+    recipients.insertOutgoingMessage(recipientId, body = "$term first message")
+
+    val first = repository.queryMessagesSync(term, SearchFilter.EMPTY)
+    assertThat(first.results).hasSize(1)
+
+    val second = repository.queryMessagesSync(term, SearchFilter.EMPTY)
+    assertThat(second).isSameInstanceAs(first)
+  }
+
+  @Test
+  fun `different search terms are cached independently`() {
+    val termA = uniqueTerm()
+    val termB = uniqueTerm()
+    val recipientId = recipients.createRecipient("Cache Test Two")
+    recipients.insertOutgoingMessage(recipientId, body = "$termA alpha")
+    recipients.insertOutgoingMessage(recipientId, body = "$termB bravo")
+
+    val resultA = repository.queryMessagesSync(termA, SearchFilter.EMPTY)
+    val resultB = repository.queryMessagesSync(termB, SearchFilter.EMPTY)
+
+    assertThat(resultA.results).hasSize(1)
+    assertThat(resultB.results).hasSize(1)
+    assertThat(repository.queryMessagesSync(termA, SearchFilter.EMPTY)).isSameInstanceAs(resultA)
+    assertThat(repository.queryMessagesSync(termB, SearchFilter.EMPTY)).isSameInstanceAs(resultB)
+  }
+
+  @Test
+  fun `a data change invalidates the cached search once invalidation runs`() {
+    val term = uniqueTerm()
+    val recipientId = recipients.createRecipient("Cache Test Three")
+    recipients.insertOutgoingMessage(recipientId, body = "$term first message")
+
+    val first = repository.queryMessagesSync(term, SearchFilter.EMPTY)
+    assertThat(first.results).hasSize(1)
+
+    recipients.insertOutgoingMessage(recipientId, body = "$term second message")
+    SearchRepository.invalidateCachesForTests()
+
+    val refreshed = repository.queryMessagesSync(term, SearchFilter.EMPTY)
+    assertThat(refreshed).isNotSameInstanceAs(first)
+    assertThat(refreshed.results).hasSize(2)
+  }
+
+  private fun uniqueTerm(): String = "needle" + UUID.randomUUID().toString().replace("-", "")
+}
