             logger.log("Removing window data for UUID: \(uuid)", level: .info, category: .tabs)
             fileManager.removeFileAt(path: url)
         }
+
+        removeWindowDataBackups(forUUIDs: uuids)
+    }
+
+    private func removeWindowDataBackups(forUUIDs uuids: [WindowUUID]) {
+        guard let backupDirectoryURL = fileManager.windowDataDirectory(isBackup: true) else { return }
+
+        let backupFileURLs = fileManager.contentsOfDirectory(at: backupDirectoryURL)
+
+        for url in backupFileURLs {
+            guard let uuid = windowUUID(fromURL: url), uuids.contains(where: { $0 == uuid }) else { continue }
+            logger.log("Removing window data backup for UUID: \(uuid)", level: .info, category: .tabs)
+            fileManager.removeFileAt(path: url)
+        }
     }
 
