+    @MainActor
+    func testRemoveWindowData_removesPrimaryAndBackupFilesForMatchingUUIDs() async throws {
+        let subject = createSubject()
+        let uuidToRemove = defaultTestTabWindowUUID
+        let uuidToKeep = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        let primaryURLToRemove = URL(string: "some/directory1/window-\(uuidToRemove.uuidString)")!
+        let primaryURLToKeep = URL(string: "some/directory1/window-\(uuidToKeep.uuidString)")!
+        let backupURLToRemove = URL(string: "some/directory2/window-\(uuidToRemove.uuidString)")!
+        let backupURLToKeep = URL(string: "some/directory2/window-\(uuidToKeep.uuidString)")!
+        mockFileManager.pathContents = [primaryURLToRemove, primaryURLToKeep]
+        mockFileManager.backupPathContents = [backupURLToRemove, backupURLToKeep]
+
+        await subject.removeWindowData(forUUIDs: [uuidToRemove])
+
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(primaryURLToRemove))
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(backupURLToRemove))
+        XCTAssertFalse(mockFileManager.removedFileURLs.contains(primaryURLToKeep))
+        XCTAssertFalse(mockFileManager.removedFileURLs.contains(backupURLToKeep))
+    }
+
+    @MainActor
