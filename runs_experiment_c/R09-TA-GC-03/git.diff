+    // MARK: - Removing Data
+    @MainActor
+    func testRemoveWindowData_removesPrimaryAndBackupForMatchingUUID() async throws {
+        let subject = createSubject()
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.pathContents = [URL(string: "some/directory1/window-\(defaultTestTabWindowUUID.uuidString)")!]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertTrue(mockFileManager.removedPaths.contains(
+            URL(string: "some/directory1/window-\(defaultTestTabWindowUUID.uuidString)")!))
+        XCTAssertTrue(mockFileManager.removedPaths.contains(
+            URL(string: "some/directory2/window-\(defaultTestTabWindowUUID.uuidString)")!))
+    }
+
+    @MainActor
+    func testRemoveWindowData_leavesNonMatchingWindowsUntouched() async throws {
+        let subject = createSubject()
+        let uuidToKeep = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        mockFileManager.primaryDirectoryURL = URL(string: "some/directory1")
+        mockFileManager.backupDirectoryURL = URL(string: "some/directory2")
+        mockFileManager.pathContents = [
+            URL(string: "some/directory1/window-\(defaultTestTabWindowUUID.uuidString)")!,
+            URL(string: "some/directory1/window-\(uuidToKeep.uuidString)")!
+        ]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertFalse(mockFileManager.removedPaths.contains(
+            URL(string: "some/directory1/window-\(uuidToKeep.uuidString)")!))
+        XCTAssertFalse(mockFileManager.removedPaths.contains(
+            URL(string: "some/directory2/window-\(uuidToKeep.uuidString)")!))
+    }
+
+    @MainActor
+    func testRemoveWindowData_noWindowDataDirectory_returns() async throws {
+        let subject = createSubject()
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 0)
+    }
+
