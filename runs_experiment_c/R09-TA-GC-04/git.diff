+    @MainActor
+    func testRemoveWindowData_removesPrimaryAndBackupFile() async throws {
+        let subject = createSubject()
+        let uuidToRemove = defaultTestTabWindowUUID
+        let otherUUID = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        let primaryDirectoryURL = URL(string: "some/directory1")!
+        let backupDirectoryURL = URL(string: "some/directory2")!
+        mockFileManager.primaryDirectoryURL = primaryDirectoryURL
+        mockFileManager.backupDirectoryURL = backupDirectoryURL
+        mockFileManager.pathContents = [
+            primaryDirectoryURL.appendingPathComponent("window-\(uuidToRemove.uuidString)"),
+            primaryDirectoryURL.appendingPathComponent("window-\(otherUUID.uuidString)")
+        ]
+
+        await subject.removeWindowData(forUUIDs: [uuidToRemove])
+
+        let expectedPrimaryPath = primaryDirectoryURL.appendingPathComponent("window-\(uuidToRemove.uuidString)")
+        let expectedBackupPath = backupDirectoryURL.appendingPathComponent("window-\(uuidToRemove.uuidString)")
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertTrue(mockFileManager.removedFilePaths.contains(expectedPrimaryPath))
+        XCTAssertTrue(mockFileManager.removedFilePaths.contains(expectedBackupPath))
+        XCTAssertFalse(mockFileManager.removedFilePaths.contains(
+            primaryDirectoryURL.appendingPathComponent("window-\(otherUUID.uuidString)")))
+    }
+
