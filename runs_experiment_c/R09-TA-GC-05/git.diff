+    @MainActor
+    func testRemoveWindowData_removesPrimaryAndBackupFile() async throws {
+        let subject = createSubject()
+        let primaryDirectoryURL = URL(string: "some/directory1")!
+        let backupDirectoryURL = URL(string: "some/directory2")!
+        mockFileManager.primaryDirectoryURL = primaryDirectoryURL
+        mockFileManager.backupDirectoryURL = backupDirectoryURL
+        let primaryFileURL = primaryDirectoryURL.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        mockFileManager.pathContents = [primaryFileURL]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        let expectedBackupURL = backupDirectoryURL.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertTrue(mockFileManager.removedFilePaths.contains(primaryFileURL))
+        XCTAssertTrue(mockFileManager.removedFilePaths.contains(expectedBackupURL))
+    }
+
+    @MainActor
+    func testRemoveWindowData_leavesFilesForUUIDsNotInList() async throws {
+        let subject = createSubject()
+        let otherUUID = UUID(uuidString: "ABFF60DA-D1E7-407B-AA3B-130D48B31012")!
+        let primaryDirectoryURL = URL(string: "some/directory1")!
+        let backupDirectoryURL = URL(string: "some/directory2")!
+        mockFileManager.primaryDirectoryURL = primaryDirectoryURL
+        mockFileManager.backupDirectoryURL = backupDirectoryURL
+        let removedFileURL = primaryDirectoryURL.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        let untouchedFileURL = primaryDirectoryURL.appendingPathComponent("window-\(otherUUID.uuidString)")
+        mockFileManager.pathContents = [removedFileURL, untouchedFileURL]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        let untouchedBackupURL = backupDirectoryURL.appendingPathComponent("window-\(otherUUID.uuidString)")
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertFalse(mockFileManager.removedFilePaths.contains(untouchedFileURL))
+        XCTAssertFalse(mockFileManager.removedFilePaths.contains(untouchedBackupURL))
+    }
+
