+        let backupDirectoryURL = URL(string: "some/directory2")!
+        mockFileManager.primaryDirectoryURL = primaryDirectoryURL
+        mockFileManager.backupDirectoryURL = backupDirectoryURL
+        let fileURL = primaryDirectoryURL.appendingPathComponent("window-\(defaultTestTabWindowUUID.uuidString)")
+        mockFileManager.pathContents = [fileURL]
+
+        await subject.removeWindowData(forUUIDs: [defaultTestTabWindowUUID])
+
+        let expectedBackupURL = backupDirectoryURL.appendingPathComponent(
+            "window-\(defaultTestTabWindowUUID.uuidString)"
+        )
+        XCTAssertEqual(mockFileManager.removeFileAtPathCalledCount, 2)
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(fileURL))
+        XCTAssertTrue(mockFileManager.removedFileURLs.contains(expectedBackupURL))
+    }
