--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,64 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import AVFoundation
+
+/// A stand-in transcription engine used to A/B test an alternative speech-to-text pipeline.
+///
+/// Shares permission handling and microphone capture with the other `TranscriptionEngine`
+/// implementations via `AudioManagerProtocol`/`AuthorizeProvider`, so permission and audio-session
+/// errors behave identically to the default pipeline. Instead of running real speech recognition,
+/// it streams a canned transcript to simulate incremental results while audio is captured.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let simulatedTranscriptChunks: [String]
+    private let chunkDelayNanoseconds: UInt64
+
+    private var isRecording = false
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        simulatedTranscriptChunks: [String] = ["Testing", "Testing voice", "Testing voice search"],
+        chunkDelayNanoseconds: UInt64 = 400_000_000
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.simulatedTranscriptChunks = simulatedTranscriptChunks
+        self.chunkDelayNanoseconds = chunkDelayNanoseconds
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+        isRecording = true
+
+        for (index, chunk) in simulatedTranscriptChunks.enumerated() {
+            guard isRecording else { return }
+
+            let isFinal = index == simulatedTranscriptChunks.count - 1
+            continuation.yield(SpeechResult(text: chunk, isFinal: isFinal))
+
+            if isFinal {
+                continuation.finish()
+                return
+            }
+
+            try? await Task.sleep(nanoseconds: chunkDelayNanoseconds)
+        }
+    }
+
+    func stop() throws {
+        isRecording = false
+        try audioManager.stopEngine()
+    }
+}
