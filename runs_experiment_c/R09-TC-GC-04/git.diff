diff --git a/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeSpeechRecognizerEngine.swift b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeSpeechRecognizerEngine.swift
new file mode 100644
index 00000000..8610de17
--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeSpeechRecognizerEngine.swift
@@ -0,0 +1,66 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import Foundation
+
+/// A stand-in transcription engine representing an alternative, third-party speech-to-text pipeline.
+///
+/// It is used to A/B test transcription quality and latency against the default engine. It shares the
+/// same permission and audio session handling as the other engines so the recording lifecycle and error
+/// behaviour are identical from the caller's perspective; the recognition step itself is simulated until
+/// a production backend is wired in.
+@MainActor
+final class AlternativeSpeechRecognizerEngine: TranscriptionEngine {
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let simulatedWords: [String]
+    private let wordDelayNanoseconds: UInt64
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        simulatedWords: [String] = ["This", "is", "the", "alternative", "pipeline"],
+        wordDelayNanoseconds: UInt64 = 150_000_000
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.simulatedWords = simulatedWords
+        self.wordDelayNanoseconds = wordDelayNanoseconds
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        guard !simulatedWords.isEmpty else {
+            continuation.yield(SpeechResult(text: "", isFinal: true))
+            continuation.finish()
+            return
+        }
+
+        var accumulatedWords: [String] = []
+        for word in simulatedWords {
+            try Task.checkCancellation()
+            accumulatedWords.append(word)
+            let isFinal = accumulatedWords.count == simulatedWords.count
+            continuation.yield(SpeechResult(text: accumulatedWords.joined(separator: " "), isFinal: isFinal))
+
+            if isFinal {
+                continuation.finish()
+            } else {
+                try await Task.sleep(nanoseconds: wordDelayNanoseconds)
+            }
+        }
+    }
+
+    func stop() throws {
+        try audioManager.stopEngine()
+    }
+}
