+/// Identifies which speech-to-text pipeline transcribes voice search.
+///
+/// Selection is driven by a remotely-controlled flag so the alternative pipeline can be A/B tested
+/// against the default one; each variant gets its own `TranscriptionEngine` instance with no shared
+/// mutable state between users enrolled in different variants.
+public enum SpeechEngineVariant: Sendable, Equatable {
+    case standard
+    case alternative
+}
