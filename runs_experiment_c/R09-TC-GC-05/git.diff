+/// Identifies which speech-to-text pipeline backs a `DefaultQuickAnswersService` instance.
+///
+/// Used to A/B test transcription quality/latency against an alternative pipeline. Each
+/// variant is resolved into its own `TranscriptionEngine` instance with no shared mutable
+/// state, so enrolled and non-enrolled users can run side by side without interfering.
+public enum TranscriptionEngineVariant: String, Sendable {
+    /// The platform-appropriate pipeline (`SpeechAnalyzerEngine` on iOS 26+, `SFSpeechRecognizerEngine` otherwise).
+    case standard
+    /// The alternative pipeline under experiment.
+    case alternative
+}
