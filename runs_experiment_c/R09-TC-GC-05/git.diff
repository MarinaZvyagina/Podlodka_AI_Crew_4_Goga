diff --git a/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
new file mode 100644
index 0000000..8e364a5
--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,70 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import AVFoundation
+
+/// A stand-in for an alternative speech-to-text pipeline, used to A/B test transcription
+/// quality/latency against the default engine.
+///
+/// Shares the same permission and audio capture flow as `SFSpeechRecognizerEngine` so the
+/// feature is indistinguishable to the user, but replaces the actual recognizer with a scripted
+/// transcript rather than depending on a production-grade third-party engine.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    static let defaultScriptedWords = ["This", "is", "the", "alternative", "transcription", "pipeline."]
+
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let scriptedWords: [String]
+    private let wordInterval: Duration
+
+    private var transcriptionTask: Task<Void, Never>?
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        scriptedWords: [String] = AlternativeTranscriptionEngine.defaultScriptedWords,
+        wordInterval: Duration = .milliseconds(300)
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.scriptedWords = scriptedWords
+        self.wordInterval = wordInterval
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        transcriptionTask?.cancel()
+        transcriptionTask = Task { [scriptedWords, wordInterval] in
+            var transcript = ""
+            for (index, word) in scriptedWords.enumerated() {
+                guard !Task.isCancelled else { return }
+
+                transcript = transcript.isEmpty ? word : "\(transcript) \(word)"
+                let isFinal = index == scriptedWords.count - 1
+                continuation.yield(SpeechResult(text: transcript, isFinal: isFinal))
+
+                if isFinal {
+                    continuation.finish()
+                    return
+                }
+                try? await Task.sleep(for: wordInterval)
+            }
+        }
+    }
+
+    func stop() throws {
+        transcriptionTask?.cancel()
+        transcriptionTask = nil
+        try audioManager.stopEngine()
+    }
+}
