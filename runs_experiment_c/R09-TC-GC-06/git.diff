@@ -0,0 +1,66 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+/// A stand-in transcription engine used to A/B test an alternative speech-to-text pipeline.
+///
+/// Mirrors the audio session/engine lifecycle of the other `TranscriptionEngine` implementations so
+/// permission handling, and start/stop behavior stay identical from the caller's perspective, but
+/// simulates streamed transcription results instead of calling into a real third-party recognizer.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    static let defaultSimulatedWords = ["What", "is", "the", "weather", "today"]
+
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let simulatedWords: [String]
+    private let wordDelayNanoseconds: UInt64
+    private var simulationTask: Task<Void, Never>?
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        simulatedWords: [String] = AlternativeTranscriptionEngine.defaultSimulatedWords,
+        wordDelayNanoseconds: UInt64 = 250_000_000
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.simulatedWords = simulatedWords
+        self.wordDelayNanoseconds = wordDelayNanoseconds
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        simulationTask?.cancel()
+        simulationTask = Task { [simulatedWords, wordDelayNanoseconds] in
+            var transcript = ""
+            for (index, word) in simulatedWords.enumerated() {
+                guard !Task.isCancelled else { return }
+                try? await Task.sleep(nanoseconds: wordDelayNanoseconds)
+                guard !Task.isCancelled else { return }
+
+                transcript += transcript.isEmpty ? word : " \(word)"
+                let isFinal = index == simulatedWords.count - 1
+                continuation.yield(SpeechResult(text: transcript, isFinal: isFinal))
+
+                if isFinal {
+                    continuation.finish()
+                }
+            }
+        }
+    }
+
+    func stop() throws {
+        simulationTask?.cancel()
+        simulationTask = nil
+        try audioManager.stopEngine()
+    }
+}
