--- /dev/null
+++ b/BrowserKit/Sources/QuickAnswersKit/Backend/SpeechService/AlternativeTranscriptionEngine.swift
@@ -0,0 +1,67 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import AVFoundation
+import Foundation
+
+/// A stand-in transcription engine used to A/B test an alternative speech-to-text pipeline.
+///
+/// Shares the same permission and audio-session handling as `SFSpeechRecognizerEngine` so its
+/// behavior (recording, streaming, stopping, error handling) is indistinguishable to callers.
+/// Transcription itself is simulated rather than backed by a third-party engine.
+@MainActor
+final class AlternativeTranscriptionEngine: TranscriptionEngine {
+    private let audioManager: AudioManagerProtocol
+    private let authorizer: AuthorizeProvider
+    private let sampleWords: [String]
+    private let wordIntervalNanoseconds: UInt64
+
+    private var simulationTask: Task<Void, Never>?
+
+    init(
+        audioManager: AudioManagerProtocol,
+        authorizer: AuthorizeProvider,
+        sampleWords: [String] = ["testing", "the", "alternative", "transcription", "pipeline"],
+        wordIntervalNanoseconds: UInt64 = 250 * NSEC_PER_MSEC
+    ) {
+        self.audioManager = audioManager
+        self.authorizer = authorizer
+        self.sampleWords = sampleWords
+        self.wordIntervalNanoseconds = wordIntervalNanoseconds
+    }
+
+    func prepare() async throws {
+        try await authorizer.requestMicrophonePermission()
+        try await authorizer.requestSpeechPermission()
+        try audioManager.configureAudioSession()
+    }
+
+    func start(continuation: AsyncThrowingStream<SpeechResult, any Error>.Continuation) async throws {
+        try audioManager.startCapture(bufferSize: 4096) { _, _ in }
+        try audioManager.prepareAndStartEngine()
+
+        simulationTask?.cancel()
+        simulationTask = Task { [sampleWords, wordIntervalNanoseconds] in
+            var accumulated: [String] = []
+            for word in sampleWords {
+                guard !Task.isCancelled else { return }
+                accumulated.append(word)
+                let isFinal = accumulated.count == sampleWords.count
+                continuation.yield(SpeechResult(text: accumulated.joined(separator: " "), isFinal: isFinal))
+
+                if isFinal {
+                    continuation.finish()
+                    return
+                }
+                try? await Task.sleep(nanoseconds: wordIntervalNanoseconds)
+            }
+        }
+    }
+
+    func stop() throws {
+        simulationTask?.cancel()
+        simulationTask = nil
+        try audioManager.stopEngine()
+    }
+}
