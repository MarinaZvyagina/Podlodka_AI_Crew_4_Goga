--- /dev/null
+++ b/firefox-ios/firefox-ios-tests/Tests/ClientTests/Frontend/Browser/ToastTypeTests.swift
@@ -0,0 +1,20 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+import XCTest
+import Common
+import Shared
+
+@testable import Client
+
+final class ToastTypeTests: XCTestCase {
+    func testCopyURL_hasCopyURLConfirmMessageTitle() {
+        XCTAssertEqual(ToastType.copyURL.title, .CopyURLConfirmMessage)
+    }
+
+    func testCopyURL_hasNoReduxAction() {
+        let uuid: WindowUUID = .XCTestDefaultUUID
+        XCTAssertNil(ToastType.copyURL.reduxAction(for: uuid))
+    }
+}
