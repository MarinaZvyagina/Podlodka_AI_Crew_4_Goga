+
+    // MARK: - Message Retention Sweep
+
+    private enum RetentionSweepConstants {
+        static let secondsPerDay: TimeInterval = 24 * 60 * 60
+        static let minimumSweepInterval: TimeInterval = 24 * 60 * 60
+    }
+
+    /// Enqueues a bulk-delete job for every thread with messages older than
+    /// `retentionPeriodDays`. Applies immediately/retroactively; unconditional
+    /// (ignores any throttle), so callers that want throttling should use
+    /// ``sweepMessageRetentionIfNeeded(now:threadStore:tx:)`` instead.
+    public func sweepMessageRetention(
+        retentionPeriodDays: UInt32,
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        let cutoffDate = now.addingTimeInterval(-TimeInterval(retentionPeriodDays) * RetentionSweepConstants.secondsPerDay)
+        let cutoffTimestamp = cutoffDate.ows_millisecondsSince1970
+
+        try? threadStore.enumerateNonStoryThreads(tx: tx) { thread -> Bool in
+            guard
+                let anchorMessageRowId = InteractionFinder(threadUniqueId: thread.uniqueId)
+                    .rowIdOfNewestInteraction(receivedAtOrBefore: cutoffTimestamp, tx: tx)
+            else {
+                return true
+            }
+
+            self.addJob(
+                anchorMessageRowId: anchorMessageRowId,
+                isFullThreadDelete: false,
+                threadUniqueId: thread.uniqueId,
+                tx: tx,
+            )
+
+            return true
+        }
+    }
+
+    /// Throttled wrapper around ``sweepMessageRetention(retentionPeriodDays:now:threadStore:tx:)``
+    /// suitable for routine/automatic triggers (app launch, foreground).
+    /// No-ops if retention is disabled or a sweep already ran recently.
+    func sweepMessageRetentionIfNeeded(
+        now: Date,
+        threadStore: ThreadStore,
+        tx: DBWriteTransaction,
+    ) {
+        guard let retentionPeriodDays = SSKPreferences.messageRetentionPeriodDays(transaction: tx) else {
+            return
+        }
+
+        if
+            let lastSweptAt = SSKPreferences.lastMessageRetentionSweepAt(transaction: tx),
+            now.timeIntervalSince(lastSweptAt) < RetentionSweepConstants.minimumSweepInterval
+        {
+            return
+        }
+
+        sweepMessageRetention(retentionPeriodDays: retentionPeriodDays, now: now, threadStore: threadStore, tx: tx)
+        SSKPreferences.setLastMessageRetentionSweepAt(now, transaction: tx)
+    }
 }
 
