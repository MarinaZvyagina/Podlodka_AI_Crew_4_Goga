             maxsize=1000, ttl=timeframe_to_seconds(self._default_timeframe)
         )
 
+        # Very short-lived cache for current ticker/price lookups, keyed by pair.
+        # Avoids repeated round-trips to the exchange when e.g. a strategy's exit-decision
+        # and entry-confirmation logic both request the current price for the same pair
+        # moments apart. Kept short on purpose - callers should never see noticeably
+        # stale prices, so this is refreshed regularly rather than held indefinitely.
+        self.__ticker_cache = PeriodicCache(maxsize=1000, ttl=5)
+
         self.producers = self._config.get("external_message_consumer", {}).get("producers", [])
         self.external_data_enabled = len(self.producers) > 0
 
@@ -566,13 +573,20 @@ class DataProvider:
         """
         Return last ticker data from exchange
         Warning: Performs a network request - so use with common sense.
+        Repeated calls for the same pair within a few seconds reuse the previous
+        result instead of hitting the exchange again - see __ticker_cache.
         :param pair: Pair to get the data for
         :return: Ticker dict from exchange or empty dict if ticker is not available for the pair
         """
         if self._exchange is None:
             raise OperationalException(NO_EXCHANGE_EXCEPTION)
+        cached = self.__ticker_cache.get(pair)
+        if cached is not None:
+            return cached
         try:
-            return self._exchange.fetch_ticker(pair)
+            ticker = self._exchange.fetch_ticker(pair)
+            self.__ticker_cache[pair] = ticker
+            return ticker
         except ExchangeError:
             return {}
 
