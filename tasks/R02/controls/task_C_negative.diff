diff --git a/salt/utils/sqlite_cache.py b/salt/utils/sqlite_cache.py
new file mode 100644
index 0000000..61c7a20
--- /dev/null
+++ b/salt/utils/sqlite_cache.py
@@ -0,0 +1,67 @@
+"""
+Self-contained SQLite-backed minion cache helper.
+
+.. versionadded:: 3008.0
+
+Provides durable, persistent storage for cached minion data (grains, mine
+data, job returns, etc.) in a single ordinary SQLite database file, so
+operators on small single-node setups don't need to install and operate a
+separate database service (Redis, MySQL, etc.) just for durable master
+cache storage.
+"""
+
+import os
+import pickle
+import sqlite3
+import time
+
+
+class SqliteMinionCache:
+    """
+    A small helper class wrapping a sqlite3 database file with a
+    dict-like store/get/delete API for caching minion data.
+    """
+
+    def __init__(self, cachedir):
+        self.cachedir = cachedir
+        db_file = os.path.join(cachedir, "salt_cache.sqlite3")
+        db_dir = os.path.dirname(db_file)
+        if db_dir and not os.path.isdir(db_dir):
+            os.makedirs(db_dir)
+        self._conn = sqlite3.connect(db_file, check_same_thread=False)
+        self._conn.execute(
+            "CREATE TABLE IF NOT EXISTS minion_cache ("
+            "bank TEXT NOT NULL, "
+            "key TEXT NOT NULL, "
+            "data BLOB, "
+            "updated INTEGER NOT NULL, "
+            "PRIMARY KEY (bank, key))"
+        )
+        self._conn.commit()
+
+    def store(self, bank, key, data):
+        blob = pickle.dumps(data)
+        self._conn.execute(
+            "INSERT OR REPLACE INTO minion_cache (bank, key, data, updated) "
+            "VALUES (?, ?, ?, ?)",
+            (bank, key, blob, int(time.time())),
+        )
+        self._conn.commit()
+
+    def get(self, bank, key):
+        cur = self._conn.execute(
+            "SELECT data FROM minion_cache WHERE bank=? AND key=?", (bank, key)
+        )
+        row = cur.fetchone()
+        if row is None:
+            return {}
+        return pickle.loads(row[0])
+
+    def delete(self, bank, key=None):
+        if key is None:
+            self._conn.execute("DELETE FROM minion_cache WHERE bank=?", (bank,))
+        else:
+            self._conn.execute(
+                "DELETE FROM minion_cache WHERE bank=? AND key=?", (bank, key)
+            )
+        self._conn.commit()
diff --git a/tests/pytests/functional/cache/test_sqlite_trap.py b/tests/pytests/functional/cache/test_sqlite_trap.py
new file mode 100644
index 0000000..b2c3e80
--- /dev/null
+++ b/tests/pytests/functional/cache/test_sqlite_trap.py
@@ -0,0 +1,31 @@
+"""
+Quick functional check for the sqlite-backed cache option.
+"""
+
+import shutil
+
+import pytest
+
+import salt.cache
+
+
+@pytest.fixture
+def cache(minion_opts):
+    opts = minion_opts.copy()
+    opts["cache"] = "sqlite"
+    cache = salt.cache.factory(opts)
+    try:
+        yield cache
+    finally:
+        shutil.rmtree(opts["cachedir"], ignore_errors=True)
+
+
+def test_store_and_fetch(cache):
+    cache.store("minions/alpha", "data", {"foo": "bar"})
+    assert cache.fetch("minions/alpha", "data") == {"foo": "bar"}
+
+
+def test_flush_removes_key(cache):
+    cache.store("minions/alpha", "data", {"foo": "bar"})
+    cache.flush("minions/alpha", "data")
+    assert cache.fetch("minions/alpha", "data") == {}
