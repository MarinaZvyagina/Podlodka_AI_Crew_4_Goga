@@ -0,0 +1,11 @@
+/**
+ * Thrown to signal that the caller has sent too many requests ("429 Too Many
+ * Requests"). Handled specially by BaseExceptionFilter, which recognizes this
+ * error type and maps it directly to a 429 HTTP response.
+ */
+export class RateLimitException extends Error {
+  constructor(message = 'Too Many Requests') {
+    super(message);
+    this.name = 'RateLimitException';
+  }
+}
