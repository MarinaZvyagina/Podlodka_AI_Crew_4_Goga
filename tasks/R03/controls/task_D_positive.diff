@@ -0,0 +1,58 @@
+import {
+  CallHandler,
+  ExecutionContext,
+  Injectable,
+  NestInterceptor,
+} from '@nestjs/common';
+import { HttpAdapterHost } from '@nestjs/core';
+import { randomUUID } from 'node:crypto';
+import { Observable } from 'rxjs';
+import { requestIdStorage } from './request-id.storage.js';
+
+export const REQUEST_ID_HEADER = 'X-Request-Id';
+const INCOMING_REQUEST_ID_HEADER = 'x-request-id';
+
+/**
+ * Reads (or generates) a per-request correlation ID and:
+ *  - echoes it back on the response via the framework's platform-agnostic
+ *    `AbstractHttpAdapter#setHeader` (through `HttpAdapterHost`), never by
+ *    calling a raw `response.setHeader(...)`/`res.set(...)` directly, and
+ *    never by branching on which adapter/platform is active.
+ *  - exposes it to application code (e.g. route handlers, loggers) through
+ *    an AsyncLocalStorage-backed holder that does not assume any concrete
+ *    request/response shape either.
+ *
+ * Works unmodified under both `@nestjs/platform-express` and
+ * `@nestjs/platform-fastify` because it only ever touches:
+ *   - `request.headers[...]` (a plain object on both platforms), and
+ *   - `httpAdapter.setHeader(response, ...)` (dispatched through the
+ *     abstract adapter, realized differently per platform internally).
+ */
+@Injectable()
+export class RequestIdInterceptor implements NestInterceptor {
+  constructor(private readonly adapterHost: HttpAdapterHost) {}
+
+  intercept(context: ExecutionContext, next: CallHandler): Observable<any> {
+    const httpAdapter = this.adapterHost.httpAdapter;
+    const httpCtx = context.switchToHttp();
+    const request = httpCtx.getRequest();
+    const response = httpCtx.getResponse();
+
+    const incoming = request?.headers?.[INCOMING_REQUEST_ID_HEADER];
+    const incomingValue = Array.isArray(incoming) ? incoming[0] : incoming;
+    const requestId = incomingValue || randomUUID();
+
+    httpAdapter.setHeader(response, REQUEST_ID_HEADER, requestId);
+
+    return new Observable(subscriber => {
+      requestIdStorage.run(requestId, () => {
+        const subscription = next.handle().subscribe({
+          next: value => subscriber.next(value),
+          error: err => subscriber.error(err),
+          complete: () => subscriber.complete(),
+        });
+        return () => subscription.unsubscribe();
+      });
+    });
+  }
+}
