+import { Controller, Get } from '@nestjs/common';
+import { getRequestId } from './request-id.storage.js';
+
+@Controller()
+export class AppController {
+  @Get('hello')
+  getHello() {
+    // Value captured from *inside* the route handler, via the
+    // platform-neutral AsyncLocalStorage holder - not by parsing the
+    // outgoing response.
+    return { requestIdSeenInHandler: getRequestId() };
+  }
+}
