+import {
+  FastifyAdapter,
+  NestFastifyApplication,
+} from '@nestjs/platform-fastify';
+import { Test } from '@nestjs/testing';
+import { AppModule } from '../src/app.module.js';
+
+describe('Request ID (platform-fastify)', () => {
+  let app: NestFastifyApplication;
+
+  beforeEach(async () => {
+    const module = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+
+    app = module.createNestApplication<NestFastifyApplication>(
+      new FastifyAdapter(),
+    );
+    await app.init();
+  });
+
+  it('generates a well-formed X-Request-Id when none is supplied, matching the value seen inside the handler', async () => {
+    const res = await app.inject({ method: 'GET', url: '/hello' });
+
+    expect(res.statusCode).toBe(200);
+    const headerValue = res.headers['x-request-id'];
+    expect(headerValue).toBeTruthy();
+    expect(headerValue).toMatch(
+      /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i,
+    );
+    const body = JSON.parse(res.payload);
+    expect(body.requestIdSeenInHandler).toBe(headerValue);
+  });
+
+  it('echoes back an incoming X-Request-Id unchanged', async () => {
+    const incomingId = 'incoming-correlation-id-fastify-456';
+    const res = await app.inject({
+      method: 'GET',
+      url: '/hello',
+      headers: { 'x-request-id': incomingId },
+    });
+
+    expect(res.statusCode).toBe(200);
+    expect(res.headers['x-request-id']).toBe(incomingId);
+    const body = JSON.parse(res.payload);
+    expect(body.requestIdSeenInHandler).toBe(incomingId);
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+});
