new file mode 100644
index 0000000..a558ee7
--- /dev/null
+++ b/integration/_scratch-D/src/request-id.storage.ts
@@ -0,0 +1,16 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+
+/**
+ * Platform-neutral holder for the per-request correlation/request ID.
+ *
+ * Deliberately does NOT reach into any concrete request/response object
+ * shape (Express `req`/`res` vs Fastify `request`/`reply`) - it is a plain
+ * Node.js AsyncLocalStorage instance keyed by the async execution context of
+ * the request, so it works identically regardless of which HTTP adapter
+ * bootstrapped the application.
+ */
+export const requestIdStorage = new AsyncLocalStorage<string>();
+
+export function getRequestId(): string | undefined {
+  return requestIdStorage.getStore();
+}
