index 0000000..b4c62a3
--- /dev/null
+++ b/packages/excalidraw/data/filename.test.ts
@@ -0,0 +1,59 @@
+import { describe, it, expect } from "vitest";
+
+import { sanitizeFilename } from "./filename";
+
+describe("sanitizeFilename", () => {
+  it("strips reserved filesystem characters", () => {
+    const result = sanitizeFilename('my/plan:v2*final?.txt.');
+    expect(result).not.toMatch(/[\\/:*?"<>|]/);
+  });
+
+  it("strips reserved characters from a<b>c style input", () => {
+    expect(sanitizeFilename('a<b>c')).toBe("abc");
+  });
+
+  it("falls back to a non-empty default for an empty string", () => {
+    const result = sanitizeFilename("");
+    expect(result).toBeTruthy();
+    expect(result.length).toBeGreaterThan(0);
+  });
+
+  it("falls back to a non-empty default for a whitespace-only string", () => {
+    const result = sanitizeFilename("   ");
+    expect(result).toBeTruthy();
+    expect(result.length).toBeGreaterThan(0);
+  });
+
+  it("strips trailing dots", () => {
+    const result = sanitizeFilename("trailing.");
+    expect(result.endsWith(".")).toBe(false);
+    expect(result).not.toBe("");
+  });
+
+  it("strips trailing whitespace", () => {
+    const result = sanitizeFilename("trailing ");
+    expect(result.endsWith(" ")).toBe(false);
+    expect(result).not.toBe("");
+  });
+
+  it("never starts or ends with a dot or whitespace, and never contains reserved chars", () => {
+    const cases = [
+      'my/plan:v2*final?.txt.',
+      "",
+      "   ",
+      'a<b>c',
+      "trailing.",
+      "trailing ",
+      '"quoted"|pipe\\back/slash',
+      "...leading dots",
+      "control\x00char\x1f",
+    ];
+    for (const input of cases) {
+      const result = sanitizeFilename(input);
+      expect(result.length).toBeGreaterThan(0);
+      expect(/^[.\s]/.test(result)).toBe(false);
+      expect(/[.\s]$/.test(result)).toBe(false);
+      expect(/[\\/:*?"<>|\x00-\x1f]/.test(result)).toBe(false);
+    }
+  });
+});
