index 0000000..89b624c
--- /dev/null
+++ b/packages/excalidraw/data/filename.ts
@@ -0,0 +1,29 @@
+import { DEFAULT_FILENAME } from "@excalidraw/common";
+
+// Characters that are reserved/invalid in file names on common desktop
+// operating systems (Windows, macOS, Linux), plus ASCII control characters.
+const RESERVED_FILENAME_CHARS_REGEX = /[\\/:*?"<>|\x00-\x1f]/g;
+
+// Windows silently strips trailing dots/whitespace from file names, which can
+// desync what the user typed from what actually ends up on disk. We strip a
+// leading/trailing run of dots/whitespace ourselves so the sanitized name is
+// stable and predictable on every OS.
+const LEADING_OR_TRAILING_DOTS_OR_WHITESPACE_REGEX = /^[.\s]+|[.\s]+$/g;
+
+/**
+ * Sanitizes a user-supplied drawing/project name so it is always safe to use
+ * as a real file name when saving/exporting to disk on Windows, macOS, and
+ * Linux.
+ *
+ * This is the single source of truth for this rule — it should be imported
+ * wherever a name is committed (e.g. `actionChangeProjectName`) and/or
+ * consumed to actually write a file (`fileSave`), rather than re-implemented
+ * ad hoc at each call site.
+ */
+export const sanitizeFilename = (name: string): string => {
+  const sanitized = name
+    .replace(RESERVED_FILENAME_CHARS_REGEX, "")
+    .replace(LEADING_OR_TRAILING_DOTS_OR_WHITESPACE_REGEX, "");
+
+  return sanitized || DEFAULT_FILENAME;
+};
