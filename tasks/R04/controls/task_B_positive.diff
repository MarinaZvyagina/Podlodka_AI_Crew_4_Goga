+/**
+ * Returns the enclosed area of an element, in scene units, or `null` if the
+ * element doesn't enclose a meaningful region (e.g. an open line/arrow, or
+ * text).
+ *
+ * Reuses `getElementShape()` (the same per-element-type geometric dispatch
+ * used for hit-testing/collision) so this stays correct for rotated
+ * rectangles/diamonds/ellipses and for closed polygon-mode lines / closed
+ * freedraw shapes, whose area can't be derived from width*height alone.
+ */
+export const getElementArea = (
+  element: ExcalidrawElement,
+  elementsMap: ElementsMap,
+): number | null => {
+  if (
+    element.type !== "rectangle" &&
+    element.type !== "diamond" &&
+    element.type !== "ellipse" &&
+    element.type !== "line" &&
+    element.type !== "freedraw"
+  ) {
+    return null;
+  }
+
+  const shape = getElementShape<GlobalPoint>(element, elementsMap);
+
+  switch (shape.type) {
+    case "polygon":
+      // shoelace formula on the shape's actual (already-rotated) point
+      // data -- rotation-invariant by construction, and correct for
+      // non-rectangular closed outlines.
+      return polygonArea(shape.data);
+    case "ellipse":
+      // area of an ellipse doesn't depend on its rotation angle
+      return Math.PI * shape.data.halfWidth * shape.data.halfHeight;
+    default:
+      // open line/curve, freedraw that isn't a closed loop, etc. -- no
+      // meaningful enclosed area
+      return null;
+  }
+};
