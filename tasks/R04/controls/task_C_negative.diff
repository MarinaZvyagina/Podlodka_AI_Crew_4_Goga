+// quick fix: wired directly to setAppState rather than through a registered
+// action / actionManager.executeAction, since this is just a simple boolean
+// flip.
+export const PreferencesToggleCaptionsVisibilityItem = () => {
+  const { t } = useI18n();
+  const setAppState = useExcalidrawSetAppState();
+  const appState = useUIAppState();
+  return (
+    <DropdownMenuItemCheckbox
+      checked={appState.captionsHiddenEnabled}
+      data-testid="toggleCaptionsVisibility"
+      onSelect={(event) => {
+        setAppState({ captionsHiddenEnabled: !appState.captionsHiddenEnabled });
+        event.preventDefault();
+      }}
+    >
+      {t("labels.toggleCaptionsVisibility")}
+    </DropdownMenuItemCheckbox>
+  );
+};
