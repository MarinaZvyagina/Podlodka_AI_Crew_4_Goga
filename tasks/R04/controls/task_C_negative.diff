+  // quick fix: dedicated shortcut for the "hide captions" toggle, wired up
+  // directly rather than through the action registry/ActionManager.
+  private handleCaptionsHiddenKeydown = (event: KeyboardEvent) => {
+    if (
+      !event[KEYS.CTRL_OR_CMD] &&
+      event.altKey &&
+      !event.shiftKey &&
+      event.code === "KeyK"
+    ) {
+      this.setState((state) => ({
+        captionsHiddenEnabled: !state.captionsHiddenEnabled,
+      }));
+    }
+  };
+
   public async componentDidMount() {
     this.unmounted = false;
     this.api = this.createExcalidrawAPI();
 
+    window.addEventListener("keydown", this.handleCaptionsHiddenKeydown);
+
     this.excalidrawContainerValue.container =
       this.excalidrawContainerRef.current;
 
