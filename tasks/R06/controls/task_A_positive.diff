+func TestUserAddWithEmptyPasswordIsRejected(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	ua := &pb.AuthUserAddRequest{Name: "empty-password-user", Options: &authpb.UserAddOptions{NoPassword: false}}
+	_, err := as.UserAdd(ua)
+	require.ErrorIsf(t, err, ErrPasswordEmpty, "expected %v, got %v", ErrPasswordEmpty, err)
+
+	_, ok := as.rangePermCache["empty-password-user"]
+	require.Falsef(t, ok, "user with an empty password should not have been added")
+}
+
+func TestUserAddNoPasswordOptionWithEmptyPasswordSucceeds(t *testing.T) {
+	as, tearDown := setupAuthStore(t)
+	defer tearDown(t)
+
+	ua := &pb.AuthUserAddRequest{Name: "no-password-user", Options: &authpb.UserAddOptions{NoPassword: true}}
+	_, err := as.UserAdd(ua)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	_, ok := as.rangePermCache["no-password-user"]
+	require.Truef(t, ok, "no-password user should have been added")
+}
