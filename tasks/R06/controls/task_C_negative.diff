+// audit logs a compliance audit record (caller identity, operation kind, key,
+// duration, outcome) for a KV request. It is called individually from each of
+// the handlers below that need it.
+func audit(ctx context.Context, s *kvServer, op string, key []byte, start time.Time, err error) {
+	es, ok := s.kv.(*etcdserver.EtcdServer)
+	if !ok {
+		return
+	}
+	lg := es.Logger()
+	if lg == nil {
+		return
+	}
+	identity := "unauthenticated"
+	if authInfo, aerr := s.aa.ag.AuthInfoFromCtx(ctx); aerr == nil && authInfo != nil && authInfo.Username != "" {
+		identity = authInfo.Username
+	}
+	outcome := "success"
+	if err != nil {
+		outcome = "failure"
+	}
+	lg.Info("audit",
+		zap.String("caller", identity),
+		zap.String("operation", op),
+		zap.ByteString("key", key),
+		zap.Duration("duration", time.Since(start)),
+		zap.String("outcome", outcome),
+	)
+}
+
