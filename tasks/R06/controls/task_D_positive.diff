diff --git a/server/storage/mvcc/range_cache.go b/server/storage/mvcc/range_cache.go
new file mode 100644
index 0000000..7a3e49c
--- /dev/null
+++ b/server/storage/mvcc/range_cache.go
@@ -0,0 +1,183 @@
+// Copyright 2015 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package mvcc
+
+import (
+	"sync"
+
+	"go.etcd.io/etcd/api/v3/mvccpb"
+)
+
+// rangeCacheKey identifies a Range call by every parameter that can affect
+// its result, including the exact revision the result was/would be served
+// at. Baking the revision into the key (rather than only validating
+// against a "live" store-wide counter) is what keeps this cache compatible
+// with mvcc's snapshot-isolated concurrent reads: two read transactions
+// open at different revisions must be able to ask the identical (key, end,
+// options) question and legitimately get different answers, each stable
+// for the lifetime of its own transaction. Since data at a given revision
+// never changes once written (that's the point of a multi-version store),
+// a cache entry for a specific revision is valid forever -- with exactly
+// one exception: compaction, which physically discards old revisions. See
+// rangeCache.get/put for how that's handled.
+type rangeCacheKey struct {
+	key, end       string
+	limit          int64
+	rev            int64
+	countOnly      bool
+	fastKeysOnly   bool
+	withTotalCount bool
+}
+
+// resolveRev mirrors the "rev<=0 means current" convention rangeKeys()
+// itself uses, so requests for an explicit historical revision and
+// requests for "whatever is current right now" that happen to resolve to
+// the same revision share a cache entry.
+func resolveRev(ro RangeOptions, curRev int64) int64 {
+	if ro.Rev > 0 {
+		return ro.Rev
+	}
+	return curRev
+}
+
+func rangeCacheKeyOf(key, end []byte, ro RangeOptions, effectiveRev int64) rangeCacheKey {
+	return rangeCacheKey{
+		key:            string(key),
+		end:            string(end),
+		limit:          ro.Limit,
+		rev:            effectiveRev,
+		countOnly:      ro.CountOnly,
+		fastKeysOnly:   ro.FastKeysOnly,
+		withTotalCount: ro.WithTotalCount,
+	}
+}
+
+// maxRangeCacheEntries is a defensive cap on cache size: if it's exceeded
+// (e.g. compaction is disabled and a very large number of distinct
+// key/revision combinations get cached over a long process lifetime), the
+// whole cache is dropped rather than growing without bound. This never
+// produces incorrect results, only a missed caching opportunity.
+const maxRangeCacheEntries = 100_000
+
+// rangeCache is a small read-through cache for repeated, identical Range
+// lookups against the MVCC store, validated against store revision instead
+// of a wall-clock TTL. It must be invalidated (see clear) any time a
+// revision it may hold entries for could stop being valid to serve -- in
+// practice that is exactly compaction (kvstore_compaction.go /
+// updateCompactRev) and a full snapshot Restore, both of which call
+// store.setCompactMainRev / clear directly. Ordinary Put/DeleteRange/Txn
+// writes do *not* need to invalidate anything here: they only ever create
+// a *new* revision, they never change the answer for an already-cached
+// older revision.
+type rangeCache struct {
+	mu      sync.Mutex
+	entries map[rangeCacheKey]*RangeResult
+}
+
+func newRangeCache() *rangeCache {
+	return &rangeCache{entries: make(map[rangeCacheKey]*RangeResult)}
+}
+
+// get returns a cached result for (key, end, ro) at revision curRev, but
+// only if that revision has not since been compacted away (compactRev is
+// the store's current compactMainRev, read by the caller without a lock
+// via store.compactRevAtomic). A result whose revision has been compacted
+// is never served from the cache: the caller falls through to the real
+// read path, which independently (and correctly) returns ErrCompacted.
+func (c *rangeCache) get(key, end []byte, ro RangeOptions, curRev, compactRev int64) (*RangeResult, bool) {
+	if c == nil {
+		return nil, false
+	}
+	effRev := resolveRev(ro, curRev)
+	if effRev < compactRev {
+		return nil, false
+	}
+	k := rangeCacheKeyOf(key, end, ro, effRev)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	r, ok := c.entries[k]
+	if !ok {
+		return nil, false
+	}
+	return cloneRangeResult(r), true
+}
+
+// put records a fresh result for (key, end, ro) at revision curRev, unless
+// that revision has already been compacted away by the time we're storing
+// it (a compaction can race with the read that produced r).
+func (c *rangeCache) put(key, end []byte, ro RangeOptions, curRev, compactRev int64, r *RangeResult) {
+	if c == nil {
+		return
+	}
+	effRev := resolveRev(ro, curRev)
+	if effRev < compactRev {
+		return
+	}
+	k := rangeCacheKeyOf(key, end, ro, effRev)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if len(c.entries) >= maxRangeCacheEntries {
+		c.entries = make(map[rangeCacheKey]*RangeResult)
+	}
+	c.entries[k] = cloneRangeResult(r)
+}
+
+// clear drops every cached entry. Called whenever compactMainRev advances
+// (some entries may now be for compacted revisions) or the store is
+// restored from a fresh backend (old entries no longer describe the same
+// data at all).
+func (c *rangeCache) clear() {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.entries = make(map[rangeCacheKey]*RangeResult)
+}
+
+// cloneRangeResult returns a defensive copy of r so that cached data can
+// never be mutated by a caller after the fact (e.g. the gRPC layer nils
+// out Value for keys-only responses, and callers may filter/sort/reslice
+// KVs in place) and so mutations from one caller can never leak into the
+// result seen by another caller of the cache.
+func cloneRangeResult(r *RangeResult) *RangeResult {
+	if r == nil {
+		return nil
+	}
+	out := &RangeResult{Count: r.Count, Rev: r.Rev}
+	if r.KVs != nil {
+		out.KVs = make([]*mvccpb.KeyValue, len(r.KVs))
+		for i, kv := range r.KVs {
+			if kv == nil {
+				continue
+			}
+			// Copy fields explicitly rather than dereferencing *kv: the
+			// generated proto struct embeds a protoimpl.MessageState
+			// (which contains a sync.Mutex), and copying that by value
+			// is unsafe/vet-flagged.
+			out.KVs[i] = &mvccpb.KeyValue{
+				Key:            kv.Key,
+				CreateRevision: kv.CreateRevision,
+				ModRevision:    kv.ModRevision,
+				Version:        kv.Version,
+				Value:          kv.Value,
+				Lease:          kv.Lease,
+			}
+		}
+	}
+	return out
+}
diff --git a/tests/integration/v3_range_caching_check_test.go b/tests/integration/v3_range_caching_check_test.go
