+package eu.kanade.tachiyomi.data.sync
+
+import android.content.Context
+import android.content.SharedPreferences
+import eu.kanade.tachiyomi.network.POST
+import eu.kanade.tachiyomi.network.awaitSuccess
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import logcat.LogPriority
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.RequestBody.Companion.toRequestBody
+import tachiyomi.core.common.util.system.logcat
+
+/**
+ * Standalone helper that talks directly to a user's self-hosted reading-progress server.
+ *
+ * NOTE: this intentionally does NOT go through the app's Tracker/TrackerManager abstraction —
+ * it keeps its own login state (in a dedicated SharedPreferences file) and is called directly
+ * from the reader whenever a chapter is finished, instead of being registered as a tracker.
+ */
+class SelfHostedSyncManager(context: Context) {
+
+    private val prefs: SharedPreferences =
+        context.getSharedPreferences("self_hosted_sync_prefs", Context.MODE_PRIVATE)
+
+    private val client = OkHttpClient()
+    private val json = Json { ignoreUnknownKeys = true }
+
+    val isLoggedIn: Boolean
+        get() = !prefs.getString(KEY_TOKEN, null).isNullOrEmpty()
+
+    fun login(username: String, password: String) {
+        // A real implementation would call the server's auth endpoint and store the returned
+        // token; for now we just derive a placeholder token from the credentials.
+        prefs.edit()
+            .putString(KEY_USERNAME, username)
+            .putString(KEY_TOKEN, "$username:$password".hashCode().toString())
+            .apply()
+    }
+
+    fun logout() {
+        prefs.edit().clear().apply()
+    }
+
+    suspend fun markChapterRead(mangaId: Long, chapterNumber: Double) {
+        val token = prefs.getString(KEY_TOKEN, null) ?: return
+        try {
+            val payload = json.encodeToString(ChapterReadPayload(mangaId, chapterNumber, token))
+            client.newCall(
+                POST(
+                    "$BASE_URL/api/progress",
+                    body = payload.toRequestBody("application/json".toMediaType()),
+                ),
+            ).awaitSuccess()
+        } catch (e: Exception) {
+            logcat(LogPriority.WARN, e) { "Failed to push progress to self-hosted server" }
+        }
+    }
+
+    @Serializable
+    private data class ChapterReadPayload(
+        val mangaId: Long,
+        val chapterNumber: Double,
+        val token: String,
+    )
+
+    companion object {
+        private const val BASE_URL = "https://example-selfhosted-server.invalid"
+        private const val KEY_USERNAME = "username"
+        private const val KEY_TOKEN = "token"
+    }
+}
