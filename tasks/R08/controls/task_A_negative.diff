+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.blocked
+
+import android.app.Application
+import androidx.test.core.app.ApplicationProvider
+import org.junit.Assert.assertEquals
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.thoughtcrime.securesms.recipients.Recipient
+import org.thoughtcrime.securesms.testutil.RecipientTestRule
+
+/**
+ * R08 Phase 5 control-verification helper (NOT part of the original functional_check_command):
+ * demonstrates that BlockedUsersFragment.sortForDisplay(...) — the negative control's
+ * UI-layer sort — does produce an alphabetically-ordered visible list, i.e. the trap satisfies
+ * the ticket's product-visible acceptance criterion ("opening the screen shows entries in
+ * alphabetical order") even though it fails the stricter repository-level
+ * BlockedUsersRepositoryTest and the AC2 architecture check (sort logic in the wrong layer).
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class BlockedUsersFragmentSortTest {
+
+  @get:Rule
+  val recipientTestRule = RecipientTestRule()
+
+  @Test
+  fun givenUnsortedRecipientList_whenISortForDisplay_thenIExpectAlphabeticalOrder() {
+    val zoe = recipientTestRule.createRecipient("Zoe")
+    val amy = recipientTestRule.createRecipient("Amy")
+    val mike = recipientTestRule.createRecipient("Mike")
+
+    val unsorted = listOf(zoe, amy, mike).map { Recipient.resolved(it) }
+    val context = ApplicationProvider.getApplicationContext<Application>()
+
+    val sorted = BlockedUsersFragment.sortForDisplay(unsorted, context)
+
+    assertEquals(listOf("Amy", "Mike", "Zoe"), sorted.map { it.getDisplayName(context) })
+  }
+}
