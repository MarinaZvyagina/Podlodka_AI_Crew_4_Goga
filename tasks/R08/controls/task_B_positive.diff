+
+package org.thoughtcrime.securesms.mediasend.v3
+
+import android.app.Application
+import android.content.ContentValues
+import androidx.test.core.app.ApplicationProvider
+import assertk.assertThat
+import assertk.assertions.isFalse
+import assertk.assertions.isNotNull
+import assertk.assertions.isTrue
+import org.junit.BeforeClass
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.signal.core.models.database.AttachmentId
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.AttachmentTable
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.database.TestSms
+import org.thoughtcrime.securesms.testutil.MockAppDependenciesRule
+import org.thoughtcrime.securesms.testutil.SignalDatabaseRule
+import org.thoughtcrime.securesms.testutil.SystemOutLogger
+
+/**
+ * Verifies the positive-control wiring of the per-attachment "send at full quality" override:
+ *
+ * The choice made in the feature-module UI is threaded through the [org.signal.mediasend.preupload.PreUploadRepository]
+ * boundary and its app-side implementation [MediaSendV3PreUploadRepository], which sets the existing persisted
+ * [org.signal.core.models.media.TransformProperties.skipTransform] flag on the specific attachment via
+ * SignalDatabase/AttachmentTable.
+ *
+ * Note on scope: metadata_B.yaml's ideal functional_check is an androidTest that drives the whole multi-select Compose
+ * flow and simulates real Android process recreation. That requires an emulator/instrumentation, which is unavailable
+ * in this JVM environment. This is the closest feasible equivalent: it exercises the real app-side repository method
+ * against a real Robolectric-backed SQLite [SignalDatabase], and simulates process recreation by re-reading the value
+ * from a fresh DB query (the flag is persisted on the row, never held only in in-memory ViewModel state).
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class MediaSendV3PreUploadRepositoryFullQualityTest {
+
+  @get:Rule
+  val signalDatabaseRule = SignalDatabaseRule()
+
+  @get:Rule
+  val appDependencies = MockAppDependenciesRule()
+
+  companion object {
+    @BeforeClass
+    @JvmStatic
+    fun setUpClass() {
+      Log.initialize(SystemOutLogger())
+    }
+  }
+
+  @Test
+  fun givenMultiItemBatch_whenOneMarkedFullQuality_thenOnlyThatAttachmentSkipsTransform() {
+    // GIVEN a batch of two attachments (as pre-uploaded before the user confirms the send)
+    val context = ApplicationProvider.getApplicationContext<Application>()
+    val messageId = TestSms.insert(signalDatabaseRule.writeableDatabase)
+    val markedId = AttachmentId(insertAttachment(messageId))
+    val siblingId = AttachmentId(insertAttachment(messageId))
+
+    // WHEN the user marks exactly one of them as full quality, routed through the real app-side repository impl
+    MediaSendV3PreUploadRepository.setSendAtFullQuality(context, markedId.id, true)
+
+    // THEN only that attachment carries skipTransform == true; the sibling is still compressed as usual
+    assertThat(SignalDatabase.attachments.getAttachment(markedId)).isNotNull()
+    assertThat(SignalDatabase.attachments.getAttachment(markedId)!!.transformProperties!!.skipTransform).isTrue()
+    assertThat(SignalDatabase.attachments.getAttachment(siblingId)!!.transformProperties!!.skipTransform).isFalse()
+  }
+
+  @Test
+  fun givenFullQualityMarked_whenReReadFromDatabase_thenChoiceSurvivesProcessRecreation() {
+    // GIVEN an attachment marked full quality
+    val context = ApplicationProvider.getApplicationContext<Application>()
+    val messageId = TestSms.insert(signalDatabaseRule.writeableDatabase)
+    val markedId = AttachmentId(insertAttachment(messageId))
+
+    MediaSendV3PreUploadRepository.setSendAtFullQuality(context, markedId.id, true)
+
+    // WHEN we re-read straight from the persisted row (simulating a fresh process re-reading the same DB, with no
+    // surviving in-memory ViewModel/UI state)
+    val persisted = SignalDatabase.attachments.getTransformProperties(markedId)
+
+    // THEN the full-quality choice is still present
+    assertThat(persisted).isNotNull()
+    assertThat(persisted!!.skipTransform).isTrue()
+  }
+
+  @Test
+  fun givenFullQualityMarked_whenUnmarked_thenAttachmentIsCompressedAgain() {
+    val context = ApplicationProvider.getApplicationContext<Application>()
+    val messageId = TestSms.insert(signalDatabaseRule.writeableDatabase)
+    val attachmentId = AttachmentId(insertAttachment(messageId))
+
+    MediaSendV3PreUploadRepository.setSendAtFullQuality(context, attachmentId.id, true)
+    MediaSendV3PreUploadRepository.setSendAtFullQuality(context, attachmentId.id, false)
+
+    assertThat(SignalDatabase.attachments.getTransformProperties(attachmentId)!!.skipTransform).isFalse()
+  }
+
+  private fun insertAttachment(messageId: Long): Long {
+    return SignalDatabase.writableDatabase.insert(
+      AttachmentTable.TABLE_NAME,
+      null,
+      ContentValues().apply {
+        put(AttachmentTable.MESSAGE_ID, messageId)
+        put(AttachmentTable.TRANSFER_STATE, AttachmentTable.TRANSFER_PROGRESS_DONE)
+        put(AttachmentTable.CONTENT_TYPE, "image/jpeg")
+      }
+    )
+  }
+}
