+
+package org.thoughtcrime.securesms.cleanup
+
+import android.content.Context
+import android.os.BatteryManager
+import android.os.Handler
+import android.os.Looper
+import android.telephony.TelephonyManager
+import androidx.annotation.VisibleForTesting
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.SignalDatabase
+import java.io.File
+import java.util.concurrent.TimeUnit
+
+/**
+ * Periodically deletes orphaned thumbnail/preview cache files — files still on disk in the attachment
+ * "parts" directory that no longer correspond to any attachment/message in the database.
+ *
+ * NOTE: This is a bespoke, self-contained scheduling mechanism. It is started once from
+ * [org.thoughtcrime.securesms.ApplicationContext.onCreate], drives its own periodic loop with a raw
+ * [Handler.postDelayed], manually polls [TelephonyManager]/[BatteryManager] to decide whether it may
+ * run, and persists its "last file checked" cursor in [android.content.SharedPreferences]. It re-derives
+ * durability, retry, and device-condition gating by hand rather than going through the app's existing
+ * Job/Constraint framework.
+ */
+object ThumbnailCleanupManager {
+
+  private val TAG = Log.tag(ThumbnailCleanupManager::class.java)
+
+  private const val PREFS_NAME = "thumbnail_cleanup"
+  private const val KEY_LAST_CHECKED_FILE = "last_checked_file"
+  private const val PARTS_DIRECTORY = "parts"
+  private const val DEFAULT_BATCH_SIZE = 50
+  private const val CRITICAL_BATTERY_PERCENT = 15
+
+  private val INTERVAL_MS = TimeUnit.HOURS.toMillis(6)
+
+  private val handler by lazy { Handler(Looper.getMainLooper()) }
+
+  private var appContext: Context? = null
+
+  private val loop = object : Runnable {
+    override fun run() {
+      val context = appContext
+      if (context != null && conditionsMet(context)) {
+        runCleanupPass(context)
+      }
+      handler.postDelayed(this, INTERVAL_MS)
+    }
+  }
+
+  @JvmStatic
+  fun start(context: Context) {
+    appContext = context.applicationContext
+    handler.removeCallbacks(loop)
+    handler.postDelayed(loop, INTERVAL_MS)
+  }
+
+  /** Hand-rolled call/battery gating, duplicating NotInCallConstraint / BatteryNotLowConstraint. */
+  private fun conditionsMet(context: Context): Boolean {
+    val telephonyManager = context.getSystemService(Context.TELEPHONY_SERVICE) as TelephonyManager
+    val inCall = telephonyManager.callState != TelephonyManager.CALL_STATE_IDLE
+
+    val batteryManager = context.getSystemService(Context.BATTERY_SERVICE) as BatteryManager
+    val batteryLevel = batteryManager.getIntProperty(BatteryManager.BATTERY_PROPERTY_CAPACITY)
+    val batteryLow = batteryLevel in 0 until CRITICAL_BATTERY_PERCENT
+
+    return !inCall && !batteryLow
+  }
+
+  private fun runCleanupPass(context: Context) {
+    val prefs = context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+    val dir = context.getDir(PARTS_DIRECTORY, Context.MODE_PRIVATE)
+    val lastCheckedFile = prefs.getString(KEY_LAST_CHECKED_FILE, null)
+
+    val newCursor = cleanupBatch(
+      dir = dir,
+      isReferenced = { path -> SignalDatabase.attachments.isAttachmentFilePathReferenced(path) },
+      lastCheckedFile = lastCheckedFile
+    )
+
+    prefs.edit().putString(KEY_LAST_CHECKED_FILE, newCursor).apply()
+  }
+
+  /**
+   * Processes up to [batchSize] not-yet-checked cache files (sorted by name, skipping everything up to
+   * and including [lastCheckedFile]), deleting any that are no longer referenced. Returns the new cursor
+   * to persist: the name of the last file processed, or null once a full pass has completed (so the next
+   * pass restarts from the beginning).
+   */
+  @VisibleForTesting
+  internal fun cleanupBatch(
+    dir: File,
+    isReferenced: (String) -> Boolean,
+    lastCheckedFile: String?,
+    batchSize: Int = DEFAULT_BATCH_SIZE
+  ): String? {
+    val files: List<String> = (dir.listFiles() ?: emptyArray())
+      .filter { it.isFile }
+      .map { it.name }
+      .sorted()
+
+    if (files.isEmpty()) {
+      return null
+    }
+
+    val remaining = files.filter { lastCheckedFile == null || it > lastCheckedFile }
+    if (remaining.isEmpty()) {
+      return null
+    }
+
+    val batch = remaining.take(batchSize)
+    for (name in batch) {
+      val file = File(dir, name)
+      if (!isReferenced(file.absolutePath)) {
+        if (!file.delete()) {
+          Log.w(TAG, "Failed to delete orphaned thumbnail cache file: $name")
+        }
+      }
+    }
+
+    val newCursor = batch.last()
+    return if (newCursor == files.last()) null else newCursor
+  }
+}
