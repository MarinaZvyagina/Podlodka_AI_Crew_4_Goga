+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.cleanup
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+
+/**
+ * Functional check for the negative-control cleanup manager.
+ *
+ * NOTE: This is deliberately a *simpler* test than the positive control's Job round-trip test. The
+ * negative control is not a Job — it has no serialize()/Factory#create API — so we cannot exercise that
+ * contract. Instead we test the core [ThumbnailCleanupManager.cleanupBatch] scan logic in isolation:
+ * orphaned files get deleted, referenced files are kept, and a SharedPreferences-style cursor lets a
+ * later pass make forward progress instead of restarting.
+ */
+class ThumbnailCleanupManagerTest {
+
+  @get:Rule
+  val tempFolder = TemporaryFolder()
+
+  @Test
+  fun cleanupBatch_deletes_orphans_keeps_referenced_and_advances_cursor() {
+    val dir = tempFolder.newFolder("parts")
+    val orphanA = File(dir, "a.mms").apply { writeText("orphan") }
+    val referencedB = File(dir, "b.mms").apply { writeText("kept") }
+    val orphanC = File(dir, "c.mms").apply { writeText("orphan") }
+
+    val referenced: (String) -> Boolean = { path -> path == referencedB.absolutePath }
+
+    // Batch size 1 so each call processes exactly one file, like one periodic pass.
+    val cursor1 = ThumbnailCleanupManager.cleanupBatch(dir, referenced, lastCheckedFile = null, batchSize = 1)
+    assertEquals("a.mms", cursor1)
+    assertFalse("orphan a.mms deleted", orphanA.exists())
+    assertTrue("b.mms not touched yet", referencedB.exists())
+    assertTrue("c.mms not touched yet", orphanC.exists())
+
+    // Resume from persisted cursor: must advance to b.mms, not restart at a.mms.
+    val cursor2 = ThumbnailCleanupManager.cleanupBatch(dir, referenced, lastCheckedFile = cursor1, batchSize = 1)
+    assertEquals("b.mms", cursor2)
+    assertTrue("referenced b.mms kept", referencedB.exists())
+
+    // Final file: orphan c.mms deleted, cursor resets to null (full pass complete).
+    val cursor3 = ThumbnailCleanupManager.cleanupBatch(dir, referenced, lastCheckedFile = cursor2, batchSize = 1)
+    assertNull("cursor resets after full pass", cursor3)
+    assertFalse("orphan c.mms deleted", orphanC.exists())
+  }
+}
