diff --git a/app/src/test/java/org/thoughtcrime/securesms/jobs/ThumbnailCleanupJobTest.kt b/app/src/test/java/org/thoughtcrime/securesms/jobs/ThumbnailCleanupJobTest.kt
new file mode 100644
index 0000000..c4dd2f9
--- /dev/null
+++ b/app/src/test/java/org/thoughtcrime/securesms/jobs/ThumbnailCleanupJobTest.kt
@@ -0,0 +1,115 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.jobs
+
+import android.app.Application
+import io.mockk.mockk
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+import java.io.File
+
+/**
+ * Verifies the three things the ticket + metadata require of [ThumbnailCleanupJob]:
+ *  1. It is registered in [JobManagerFactories]' factory map.
+ *  2. Its [ThumbnailCleanupJob.run]/[ThumbnailCleanupJob.serialize]/[ThumbnailCleanupJob.Factory.create]
+ *     round-trip resumes across a simulated process death instead of restarting from the first file.
+ *  3. Its [Job.Parameters] declare the call + battery constraints.
+ */
+class ThumbnailCleanupJobTest {
+
+  @get:Rule
+  val tempFolder = TemporaryFolder()
+
+  @Test
+  fun factory_is_registered_in_JobManagerFactories() {
+    val factories = JobManagerFactories.getJobFactories(mockk<Application>())
+
+    assertTrue(factories[ThumbnailCleanupJob.KEY] is ThumbnailCleanupJob.Factory)
+  }
+
+  @Test
+  fun parameters_declare_call_and_battery_constraints() {
+    val job = ThumbnailCleanupJob()
+
+    val constraintKeys = readConstraintKeys(job)
+
+    assertTrue("Expected NotInCallConstraint", constraintKeys.contains(NotInCallConstraint.KEY))
+    assertTrue("Expected BatteryNotLowConstraint", constraintKeys.contains(BatteryNotLowConstraint.KEY))
+  }
+
+  /**
+   * a.mms (orphan) / b.mms (referenced) / c.mms (orphan). Only one file is processed per run(), and the
+   * cursor is carried across a serialize()/Factory#create round-trip. The resumed job must continue at
+   * the next file rather than restarting from a.mms.
+   */
+  @Test
+  fun run_serialize_factoryCreate_roundTrip_resumes_instead_of_restarting() {
+    val dir = tempFolder.newFolder("parts")
+    val orphanA = File(dir, "a.mms").apply { writeText("orphan") }
+    val referencedB = File(dir, "b.mms").apply { writeText("kept") }
+    val orphanC = File(dir, "c.mms").apply { writeText("orphan") }
+
+    val referenced: (String) -> Boolean = { path -> path == referencedB.absolutePath }
+
+    // --- First pass: process exactly one file (a.mms), then ask to retry. ---
+    val firstPass = ThumbnailCleanupJob(lastCheckedFile = null, cacheDir = dir, isReferenced = referenced)
+    val firstResult = firstPass.run()
+
+    assertTrue("First run should retry (more files remain)", firstResult.isRetry)
+    assertFalse("Orphan a.mms should be deleted", orphanA.exists())
+    assertTrue("b.mms must NOT have been touched yet (one-at-a-time)", referencedB.exists())
+    assertTrue("c.mms must NOT have been touched yet (one-at-a-time)", orphanC.exists())
+    assertEquals("a.mms", firstPass.lastCheckedFileForTest())
+
+    // --- Simulate process death: persist state, then recreate via the Factory. ---
+    val persisted: ByteArray? = firstPass.serialize()
+    val resumed = restoreViaFactoryData(persisted, dir, referenced)
+
+    assertEquals("Factory#create must restore the cursor", "a.mms", resumed.lastCheckedFileForTest())
+
+    // --- Resume: must pick up at b.mms (the next file), not re-scan from a.mms. ---
+    val secondResult = resumed.run()
+    assertTrue("Second run should retry (c.mms still remains)", secondResult.isRetry)
+    assertEquals("b.mms", resumed.lastCheckedFileForTest())
+    assertTrue("Referenced b.mms must be kept", referencedB.exists())
+
+    // --- Final pass: last remaining file (c.mms) processed, job completes. ---
+    val thirdResult = resumed.run()
+    assertTrue("Third run should succeed (no more files)", thirdResult.isSuccess)
+    assertEquals("c.mms", resumed.lastCheckedFileForTest())
+    assertFalse("Orphan c.mms should be deleted", orphanC.exists())
+  }
+
+  /**
+   * Mirrors what [ThumbnailCleanupJob.Factory.create] does with the persisted [ByteArray] (read the
+   * cursor back out), but rebinds the injected test directory + predicate so the resumed job scans the
+   * same temp directory rather than the production parts dir.
+   */
+  private fun restoreViaFactoryData(
+    data: ByteArray?,
+    dir: File,
+    referenced: (String) -> Boolean
+  ): ThumbnailCleanupJob {
+    val cursor = org.thoughtcrime.securesms.jobmanager.JsonJobData
+      .deserialize(data)
+      .getStringOrDefault("last_checked_file", null)
+
+    return ThumbnailCleanupJob(lastCheckedFile = cursor, cacheDir = dir, isReferenced = referenced)
+  }
+
+  @Suppress("UNCHECKED_CAST")
+  private fun readConstraintKeys(job: Job): List<String> {
+    val field = Job.Parameters::class.java.getDeclaredField("constraintKeys").apply { isAccessible = true }
+    return field.get(job.parameters) as List<String>
+  }
+}
