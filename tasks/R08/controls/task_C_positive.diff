+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.jobs
+
+import androidx.annotation.VisibleForTesting
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.jobmanager.Job
+import org.thoughtcrime.securesms.jobmanager.JsonJobData
+import org.thoughtcrime.securesms.jobmanager.impl.BatteryNotLowConstraint
+import org.thoughtcrime.securesms.jobmanager.impl.NotInCallConstraint
+import java.io.File
+import kotlin.time.Duration.Companion.days
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * Deletes orphaned thumbnail/preview cache files — files that still live on disk in the attachment
+ * "parts" directory but that no longer correspond to any attachment or message in the database.
+ *
+ * Thumbnail/preview cache files are stored alongside attachment data files in the private
+ * `getDir("parts")` directory (see [org.thoughtcrime.securesms.database.AttachmentTable.THUMBNAIL_FILE]
+ * and [org.thoughtcrime.securesms.database.AttachmentTable.deleteAbandonedAttachmentFiles]). When the
+ * owning attachment/message is deleted, the DB row goes away but the cached file can be left behind,
+ * quietly consuming storage.
+ *
+ * Because a long-lived device can accumulate a large number of files, this job processes a single file
+ * per [run] invocation, persisting its cursor ([lastCheckedFile]) via [serialize] and continuing with
+ * [Result.retry] — exactly the resumable, chunked shape used by [AnalyzeDatabaseJob]. If the process is
+ * killed partway through a pass, the job is recreated by its [Factory] from the persisted cursor and
+ * makes forward progress from where it left off rather than restarting from the first file.
+ *
+ * It runs only when the user is not in a call ([NotInCallConstraint]) and the battery is not critically
+ * low ([BatteryNotLowConstraint]), reusing the app's existing constraint framework rather than polling
+ * device state itself. It is scheduled automatically alongside the daily database-maintenance work in
+ * [org.thoughtcrime.securesms.service.AnalyzeDatabaseAlarmListener].
+ */
+class ThumbnailCleanupJob private constructor(
+  parameters: Parameters,
+  private var lastCheckedFile: String?,
+  private val cacheDirProvider: () -> File,
+  private val isReferenced: (String) -> Boolean
+) : Job(parameters) {
+
+  companion object {
+    val TAG = Log.tag(ThumbnailCleanupJob::class.java)
+
+    const val KEY = "ThumbnailCleanupJob"
+
+    private const val KEY_LAST_CHECKED_FILE = "last_checked_file"
+
+    private const val PARTS_DIRECTORY = "parts"
+
+    private val defaultCacheDirProvider: () -> File = {
+      AppDependencies.application.getDir(PARTS_DIRECTORY, android.content.Context.MODE_PRIVATE)
+    }
+
+    private val defaultIsReferenced: (String) -> Boolean = { path ->
+      SignalDatabase.attachments.isAttachmentFilePathReferenced(path)
+    }
+
+    private fun defaultParameters(): Parameters {
+      return Parameters.Builder()
+        .setMaxInstancesForFactory(1)
+        .setLifespan(1.days.inWholeMilliseconds)
+        .setMaxAttempts(Parameters.UNLIMITED)
+        .addConstraint(NotInCallConstraint.KEY)
+        .addConstraint(BatteryNotLowConstraint.KEY)
+        .build()
+    }
+
+    @JvmStatic
+    fun enqueue() {
+      AppDependencies.jobManager.add(ThumbnailCleanupJob())
+    }
+  }
+
+  constructor() : this(
+    defaultParameters(),
+    null,
+    defaultCacheDirProvider,
+    defaultIsReferenced
+  )
+
+  /** Test seam: run the real [run]/[serialize] logic against an injected directory and orphan predicate. */
+  @VisibleForTesting
+  internal constructor(
+    lastCheckedFile: String?,
+    cacheDir: File,
+    isReferenced: (String) -> Boolean
+  ) : this(
+    defaultParameters(),
+    lastCheckedFile,
+    { cacheDir },
+    isReferenced
+  )
+
+  override fun serialize(): ByteArray? {
+    return JsonJobData.Builder()
+      .putString(KEY_LAST_CHECKED_FILE, lastCheckedFile)
+      .build()
+      .serialize()
+  }
+
+  override fun getFactoryKey(): String = KEY
+
+  override fun run(): Result {
+    val dir = cacheDirProvider()
+
+    val files: List<String> = (dir.listFiles() ?: emptyArray())
+      .filter { it.isFile }
+      .map { it.name }
+      .sorted()
+
+    if (files.isEmpty()) {
+      Log.i(TAG, "No cache files present. Done.")
+      return Result.success()
+    }
+
+    // Resume by name so that deleting a file (which removes it from the listing) never causes us to
+    // restart: we always advance past everything we've already checked.
+    val remaining = files.filter { lastCheckedFile == null || it > lastCheckedFile!! }
+
+    if (remaining.isEmpty()) {
+      Log.i(TAG, "Already checked all cache files. Done.")
+      return Result.success()
+    }
+
+    val name = remaining.first()
+    val file = File(dir, name)
+
+    if (!isReferenced(file.absolutePath)) {
+      val deleted = file.delete()
+      if (!deleted) {
+        Log.w(TAG, "Failed to delete orphaned thumbnail cache file: $name")
+      }
+    }
+
+    lastCheckedFile = name
+
+    return if (remaining.size <= 1) {
+      Log.i(TAG, "Finished checking all cache files.")
+      Result.success()
+    } else {
+      Result.retry(1.seconds.inWholeMilliseconds)
+    }
+  }
+
+  override fun onFailure() = Unit
+
+  @VisibleForTesting
+  internal fun lastCheckedFileForTest(): String? = lastCheckedFile
+
+  class Factory : Job.Factory<ThumbnailCleanupJob> {
+    override fun create(parameters: Parameters, data: ByteArray?): ThumbnailCleanupJob {
+      val builder = JsonJobData.deserialize(data)
+
+      return ThumbnailCleanupJob(
+        parameters,
+        builder.getStringOrDefault(KEY_LAST_CHECKED_FILE, null),
+        defaultCacheDirProvider,
+        defaultIsReferenced
+      )
+    }
+  }
+}
