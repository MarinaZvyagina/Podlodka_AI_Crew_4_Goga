+    /// Quick fix: reaches straight into FileManager to delete the backup copy for a given window,
+    /// mirroring how DefaultTabFileManager builds the backup directory path, without going through
+    /// the TabFileManager abstraction (which doesn't expose a single-file "delete backup for UUID"
+    /// helper).
+    private func removeBackupFileDirectly(forUUID uuid: WindowUUID) {
+        guard let containerID = BrowserKitInformation.shared.sharedContainerIdentifier,
+              let containerURL = FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: containerID)
+        else { return }
+
+        let backupDirectoryURL = containerURL
+            .appendingPathComponent("profile.profile")
+            .appendingPathComponent("window-data-backup")
+        let backupFileURL = backupDirectoryURL.appendingPathComponent(filePrefix + uuid.uuidString)
+
+        try? FileManager.default.removeItem(at: backupFileURL)
+    }
+
